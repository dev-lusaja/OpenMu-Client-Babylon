182: async function readTextureElsewhere(
183:   fileName: string,
184:   headerSize: number,
185:   modelDir: string
186: ): Promise<Uint8Array | null> {
187:   const paths = indexTextures().get(fileName.toLowerCase());
188:   if (!paths?.length) return null;
