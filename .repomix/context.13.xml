171:   // out of shot before its time is up. It also sets the floor on how gently
172:   // a gust can die - a field cannot drain more slowly than its slowest leaf.
173:   life: [4.5, 7],
174:   size: [0.16, 0.24],
175:   angularSpeed: [-3, 3],
176:   colour: [WHITE, new Color4(0.92, 0.92, 0.9, 1)],
177:   // The ±0.8 u/tick² random walk.
178:   noise: v(1.2, 0.8, 1.2),
