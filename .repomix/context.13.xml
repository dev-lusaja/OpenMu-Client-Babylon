   1: import type { WeatherLayer } from './layer';
   2: import { DRAWN_SHAPES, type TrackShape } from './recipes';
   3: import {
   4:   Constants,
   5:   CreatePlane,
   6:   Matrix,
   7:   RawTexture,
   8:   ShaderMaterial,
   9:   Texture,
  10:   Vector2,
  11:   Vector3,
  12:   Vector4,
  13:   type Mesh,
  14:   type Scene,
  15: } from '../libs/babylon/exports';
  16: import { sunLightOf } from '../lighting/keyRig';
  17: import { linearBufferActive } from '../common/lightModel';
  18: 
  19: /**
  20:  * Footprints left on the ground: boot marks pressed into settled snow, or
  21:  * stamped in water onto dry stone.
  22:  *
  23:  * Nothing in the original does this - there is no decal system in the client
  24:  * at all - so the shape of it is ours. It is deliberately **not** a terrain
  25:  * overlay layer (`terrainOverlay.ts`): that mask is one texel per tile, which
  26:  * is about a person's whole stride, and a boot print is a tenth of a tile. So
  27:  * prints are geometry - flat quads drawn as **thin instances of one mesh**, so
  28:  * the whole trail is a single draw call, in a ring pool that bounds the cost
  29:  * and lets a long walk trail off behind you.
  30:  *
  31:  * ### Why this is a shader and not a painted sprite
  32:  *
  33:  * The first two cuts baked the shading into the texture and drew it with a
  34:  * `StandardMaterial`. Both read as a sticker lying on the snow rather than a
  35:  * hole in it, and the reason is that a painted print has no light direction.
  36:  *
  37:  * Baking one in is not an option either: the quad rotates to the walk heading,
  38:  * so a print baked as "lit from the left" is lit from the right the moment the
  39:  * hero turns round, and a trail that curves would have every print lit
  40:  * differently. That is what pushed the earlier cuts toward rotation-invariant
  41:  * ambient occlusion, and rotation-invariant is exactly what *flat* means.
  42:  *
  43:  * The way out is to bake a **normal map** rather than a shading, and rotate it
  44:  * into world space in the shader using the instance's own axes - which are
  45:  * sitting right there in the thin-instance matrix. Every print on the map is
  46:  * then lit from the same sun however it is turned: one wall of the hollow
  47:  * catches the light, the opposite wall falls into shadow, and that pairing is
  48:  * the cue that says *hole* instead of *smudge*.
  49:  *
  50:  * On top of that the lookup is **parallax-offset** by depth, so the far wall
  51:  * of the hollow comes into view and the near wall hides behind its own rim.
  52:  * That is the part that reads as the foot having gone down into the surface
  53:  * rather than sat on it.
  54:  *
  55:  * ### Why it multiplies
  56:  *
  57:  * The blend is `ALPHA_MULTIPLY` - `blendFunc(DST_COLOR, ZERO)` - so a fragment
  58:  * multiplies whatever the terrain already drew, and white means "leave it
  59:  * alone". That buys correctness for free: a print inside a building's shadow,
  60:  * or on ground the snow overlay has only half covered, darkens by the right
  61:  * *proportion* instead of compositing toward a fixed colour that assumed full
  62:  * sun.
  63:  *
  64:  * The one thing it cannot do is draw brighter than the ground, and that costs
  65:  * nothing here. Sunlit snow is already at the top of the range: an earlier cut
  66:  * drew a "bright" displaced-snow lip and measured it at 1.04x its
  67:  * surroundings, which is invisible. In snow, all of the readable signal is
  68:  * darkening.
  69:  */
  70: 
  71: // ---- 1. tuning -------------------------------------------------------------
  72: 
  73: /**
  74:  * The two ring pools every kind is split across, and why there are two.
  75:  *
  76:  * A pool is a ring: the oldest print is dropped to make room for the newest,
  77:  * so the number of slots IS how long a trail can be. The hero at a walking
  78:  * stride lays four prints a tile, which at 64 slots is about sixteen tiles of
  79:  * trail behind them - everything older is carried by the ploughed channel in
  80:  * `snowTrail.ts`, which is a depth map and does not run out.
  81:  *
  82:  * Once everything else in the world leaves prints too, one shared ring means
  83:  * a yeti crossing the square evicts the hero's own trail, and the trail that
  84:  * matters most is the one leading away from where you are standing. So the
  85:  * hero keeps a ring of their own at exactly the size they had, and everyone
  86:  * else shares a bigger one. Two meshes rather than one, therefore two draw
  87:  * calls per kind - the same price the drag marks were judged worth paying,
  88:  * and for a better reason.
  89:  */
  90: export type PrintLane = 'hero' | 'crowd';
  91: 
  92: const POOL: Record<PrintLane, number> = {
  93:   hero: 64,
  94:   /**
  95:    * Twice the hero's. Quadrupeds lay two prints a footfall and insects put
  96:    * them down every third of a tile, so a crowd drains a ring far faster
  97:    * than one walker does; the footprint system caps how many walkers are
  98:    * live at once (`MAX_WALKERS`), which is what actually bounds this.
  99:    */
 100:   crowd: 128,
 101: };
 102: 
 103: /**
 104:  * Tiles above the terrain the quad sits, to stay off the ground plane.
 105:  *
 106:  * Small, because the quad is now tilted onto the ground's own slope: a decal
 107:  * held flat while the terrain tilts under it has to be lifted far enough to
 108:  * clear the high side, and that lift is what reads as the print floating.
 109:  */
 110: const Z_LIFT = 0.012;
 111: 
 112: /**
 113:  * Every number that decides how a print looks, in one mutable object.
 114:  *
 115:  * These were tuned by round-tripping screenshots, which is a slow and
 116:  * imprecise way to find a look: one parameter per message, each change landing
 117:  * blind. So they are read rather than baked in, and exposed on
 118:  * `window.muFootprints` so they can be dialled live -
 119:  * `muFootprints.set({ length: 0.7, depth: 0.2 })` rebuilds the soles and the
 120:  * materials on the spot. Find the look in one session, then paste the numbers
 121:  * back here as the defaults.
 122:  *
 123:  * Sizes are in tiles, and they are the size of the **print** - the outline the
 124:  * boot leaves - not of the quad that carries it. The quad is larger, because
 125:  * the crest of shouldered snow sits outside the outline and the relief march
 126:  * needs margin to walk into; `SOLE_FILL` is the ratio and `quadWidth` /
 127:  * `quadLength` do the conversion.
 128:  *
 129:  * That distinction is not pedantry. These two numbers used to be the quad, and
 130:  * every size reported from this file was therefore wrong by the fill fraction:
 131:  * "0.85 x 0.5 tiles" was really a print of 0.61 x 0.20, a 3:1 sliver, which is
 132:  * exactly how it looked in play. A tuning value that does not mean what it
 133:  * says cannot be dialled by looking at the screen.
 134:  */
 135: export const FOOTPRINT_TUNING = {
 136:   /**
 137:    * Length of the print along the walk.
 138:    *
 139:    * Down from 0.55, and the reason is the gait rather than the shape. A walk
 140:    * alternates feet, so consecutive prints have to be further apart ALONG the
 141:    * track than a print is long - otherwise they overlap end to end, and two
 142:    * prints that overlap by nearly half their length stop reading as "left,
 143:    * then right" and start reading as a PAIR laid down together. At 0.55 with a
 144:    * stride of 0.34 the overlap was 0.23, which is exactly what that looked
 145:    * like.
 146:    *
 147:    * Shortening the print is the half of the fix that costs nothing: it also
 148:    * takes the outline from 2.06:1 to about 1.6:1, which is closer to the
 149:    * reference's proportions than it was. The other half is STRIDE.
 150:    */
 151:   length: 0.42,
 152:   /**
 153:    * Width of the print across it.
 154:    *
 155:    * A bounding width the waist never quite reaches: the superellipse's
 156:    * half-width is scaled by the arch modulation, which peaks around 0.92 at
 157:    * the ball and dips to 0.72 at the waist, so the outline this draws measures
 158:    * roughly 0.28 across against a length of 0.58 - about 2:1, which is the
 159:    * proportion the reference's prints have.
 160:    * Left as the bound rather than divided out, because the alternative is a
 161:    * number that means "width, after a correction factor" and is worse to
 162:    * reason about than one that means "width, before the boot shape".
 163:    */
 164:   width: 0.32,
 165:   /**
 166:    * How far the hollow goes down. Drives relief, parallax and occlusion.
 167:    *
 168:    * Set for a leg that went *in* rather than a sole that pressed down - in
 169:    * snow this deep the boot does not stamp a surface, it punches a shaft and
 170:    * the snow closes round the ankle.
 171:    */
 172:   depth: 0.34,
 173:   /**
 174:    * Where the cavity profile saturates. Low is a rigid sole - a broad flat
 175:    * floor with a wall round it; high is a soft dish ramping to a point. The
 176:    * flat floor is what gives a print weight, because occlusion needs area to
 177:    * act on: at 0.98 no amount of occlusion moved the mean by more than 0.01.
 178:    */
 179:   wallEdge: 0.5,
 180:   /**
 181:    * How much sky the floor of the cavity loses.
 182:    *
 183:    * The floor of a rigid sole is flat, so its normal matches the ground's and
 184:    * the lambert term cancels - this occlusion IS the darkening, and it is the
 185:    * only dial that reaches the middle of the print.
 186:    */
 187:   // Down from 0.55 against improved.jpg: the reference print floor is a pale
 188:   // blue-white, only ~0.75 of the snow beside it, and its depth is carried
 189:   // by the wall gradient and the rim, not by a dark floor.
 190:   // Up again for improved_2.jpg: with the field held at 0.86 instead of
 191:   // clipping white, the trench walls have to reach ~0.5 to read as depth.
 192:   // Down again for the reworked trail: the decal is now a faint pocket in
 193:   // the trench (walk print 0.28) and the trench carries the depth, so a
 194:   // 0.72 floor only put a dark ring inside the channel.
 195:   ao: 0.45,
 196:   /**
 197:    * Ambient light in the cavity. High, because snow is close to a perfect
 198:    * diffuser and a hollow's walls bounce light into each other. Dropping this
 199:    * is what turns prints into black holes.
 200:    */
 201:   // 0.52 → 0.7: with post-processing off there is no exposure lift, and the
 202:   // 0.52 print read as a dark oval with a dark ring (the "before" shot).
 203:   ambient: 0.7,
 204:   /**
 205:    * Light the crest may add on top of the snow beside it. Raised: the
 206:    * reference's prints are read mostly by a bright pushed-up lip on the
 207:    * sunward side, against a floor that is barely darker than the field.
 208:    */
 209:   rim: 0.8,
 210:   /**
 211:    * How far a character standing in snow this deep sinks, as a fraction of
 212:    * `depth`.
 213:    *
 214:    * Lives here rather than in the sink code so it cannot drift away from the
 215:    * hole it is standing in: the print is the evidence that the leg went down,
 216:    * and a character whose boots rest on the surface next to a 0.34-tile hole
 217:    * is visibly floating. Well under 1 because a boot compacts the snow under
 218:    * it rather than displacing all of it - and because the print's own depth is
 219:    * measured to its floor, which is under the sole, not under the ankle.
 220:    */
 221:   sink: 0.6,
 222:   /**
 223:    * Colour the hollow tends toward at full depth, as a surviving fraction.
 224:    *
 225:    * Devias' own blue. `DEVIAS_MOOD` grades the map at `shadowsHue: 232` and
 226:    * bakes the terrain at [1.02, 1.08, 1.18], so the map's shadows are already
 227:    * blue-violet - and a near-white [0.85, 0.92, 1] against that reads as a
 228:    * hole with the colour drained out rather than as shade. Matched to the
 229:    * terrain overlay's `CAVITY_TINT`, so a footprint's shadow and a drift's
 230:    * are the same colour on the same map.
 231:    */
 232:   //
 233:   // Then paled to match the overlay's new CAVITY_TINT (same hue, half the
 234:   // chroma): [0.42, 0.56, 0.88] is a saturated blue that depended on the
 235:   // grade's shadow desaturation to read as shade, and without
 236:   // post-processing it read as blue paint in the hole.
 237:   tint: [0.62, 0.66, 0.76] as [number, number, number],
 238: };
 239: 
 240: 
 241: /** Texture resolution of one sole. Enough to resolve the rim. */
 242: const TEX = 96;
 243: 
 244: /**
 245:  * How many different soles are generated per shape, laid out along the atlas
 246:  * row.
 247:  *
 248:  * Every print used to be the same texture, which at the size these are now is
 249:  * plainly visible - a row of identical stamps reads as a repeated decal
 250:  * however good any one of them is. Four is enough that a trail never shows the
 251:  * same shape twice in a row, and it fits an atlas that needs no extra vertex
 252:  * buffer: the per-instance colour already had two channels doing nothing (the
 253:  * tint written into rgb was the same value for every instance of a kind, so it
 254:  * belonged in a uniform), and those now carry the atlas offset.
 255:  */
 256: const VARIANTS = 4;
 257: 
 258: /**
 259:  * The atlas is a grid: **one column per variant, one row per `TrackShape`**.
 260:  *
 261:  * It started as a 2x2 of four boots. Monsters need silhouettes of their own -
 262:  * a paw is not a boot with noise on it - and a silhouette is exactly what the
 263:  * sole texture is, so a shape is a row and the per-instance atlas offset that
 264:  * already picked the variant now picks the pair. Nothing else about the
 265:  * instancing changes: still one mesh, one draw call, one texture per kind.
 266:  */
 267: const ATLAS_COLS = VARIANTS;
 268: 
 269: /** Rows this kind needs. Only the snow and wet soles vary by shape. */
 270: function atlasRows(kind: PrintKind): number {
 271:   return kind === 'drag' ? 1 : DRAWN_SHAPES.length;
 272: }
 273: 
 274: /** Which row of the atlas a shape is baked into; -1 for the ones never drawn. */
 275: function shapeRow(shape: TrackShape): number {
 276:   return (DRAWN_SHAPES as readonly TrackShape[]).indexOf(shape);
 277: }
 278: 
 279: /**
 280:  * How much of the atlas, per axis, one sole spans - 1/cols by 1/rows.
 281:  *
 282:  * Anything measured in texture space has to be scaled by this. The relief
 283:  * march is the one that matters: its reach is a depth expressed as a fraction
 284:  * of the quad, and the quad stopped covering the whole texture the moment the
 285:  * atlas went in. It is a `vec2` and no longer a single number, because the
 286:  * grid is no longer square.
 287:  */
 288: function atlasSpan(kind: PrintKind): [number, number] {
 289:   return [1 / ATLAS_COLS, 1 / atlasRows(kind)];
 290: }
 291: 
 292: /** Sub-rect origin of one cell, in atlas UV. */
 293: function cellOffset(
 294:   kind: PrintKind,
 295:   shape: TrackShape,
 296:   variant: number
 297: ): [number, number] {
 298:   const [su, sv] = atlasSpan(kind);
 299:   const row = kind === 'drag' ? 0 : Math.max(0, shapeRow(shape));
 300:   return [variant * su, row * sv];
 301: }
 302: 
 303: /**
 304:  * Fraction of the quad, per axis, that the sole's outline spans.
 305:  *
 306:  * The quad must be bigger than the print: the crest of shouldered snow lands
 307:  * outside the outline, and the relief march needs somewhere to walk. Equal on
 308:  * both axes on purpose - when `ru` and `rv` differed (0.2 against 0.36) the
 309:  * silhouette carried a 1.8:1 stretch of its own on top of whatever the quad's
 310:  * aspect was, and the two multiplied into a shape far thinner than either
 311:  * number suggested. The print's proportions now come from `FOOTPRINT_TUNING`
 312:  * alone, where they can be read.
 313:  */
 314: const SOLE_FILL = 0.62;
 315: 
 316: /**
 317:  * How wide each shape is against the tuned width, at the same length.
 318:  *
 319:  * The *proportions* of a print belong to its shape and the *size* belongs to
 320:  * the creature (`TrackRecipe.scale`, which scales both axes together). Keeping
 321:  * them apart is what lets one baked row serve every recipe that uses it: a
 322:  * yeti's foot and a hound's are the same pad at different sizes, so they share
 323:  * an atlas row, and a row can only be baked at one aspect.
 324:  *
 325:  * Length is never varied, and that is load-bearing: the relief march's reach
 326:  * is a single uniform expressed as a fraction of the quad's length (the axis
 327:  * the march mostly runs along), so a per-shape length would need a per-
 328:  * instance reach and there is no channel left to carry one.
 329:  */
 330: const SHAPE_ASPECT: Record<TrackShape, number> = {
 331:   /** The reference. A boot is much longer than it is wide. */
 332:   boot: 1,
 333:   /** Pad plus toes: near enough round. */
 334:   paw: 1.3,
 335:   /** Talons fan out sideways, so this is the widest of them. */
 336:   claw: 1.45,
 337:   /** Two crescents side by side - a shade narrower than a boot. */
 338:   hoof: 0.95,
 339:   /** A leg tip: a slot, not a print. */
 340:   chitin: 0.6,
 341:   /** A big round crushing foot. */
 342:   pad: 1.35,
 343:   /** Never drawn; a value only so the record is total. */
 344:   none: 1,
 345: };
 346: 
 347: /** World width of the quad carrying a print of this shape, in tiles. */
 348: function quadWidth(shape: TrackShape = 'boot'): number {
 349:   return (FOOTPRINT_TUNING.width * SHAPE_ASPECT[shape]) / SOLE_FILL;
 350: }
 351: 
 352: /** World length of the quad carrying a print of the tuned length, in tiles. */
 353: function quadLength(): number {
 354:   return FOOTPRINT_TUNING.length / SOLE_FILL;
 355: }
 356: 
 357: 
 358: /**
 359:  * `drag` is the shallow trough between two footfalls, where the boot swings
 360:  * forward without clearing the snow. It is what turns a row of separate holes
 361:  * into a **trail**, which is the difference between "someone stamped here" and
 362:  * "someone walked through".
 363:  */
 364: export type PrintKind = 'wet' | 'snow' | 'drag';
 365: 
 366: /** Prints at full strength after the last time the boots were in water. */
 367: export const FULL_STEPS = 6;
 368: 
 369: /** Prints over which a full boot dries to nothing after those. */
 370: export const FADE_STEPS = 10;
 371: 
 372: /**
 373:  * How much water the sole still has to give, by prints since it was last in
 374:  * water: full for the first `FULL_STEPS`, then dimming to nothing over the
 375:  * next `FADE_STEPS`.
 376:  *
 377:  * A boot does not dry by the clock, it dries by being walked on, which is why
 378:  * this counts prints and not seconds - standing still in a doorway leaves the
 379:  * sole exactly as wet as it was.
 380:  */
 381: export function bootStrength(stepsSinceWet: number): number {
 382:   if (stepsSinceWet <= FULL_STEPS) return 1;
 383:   return Math.max(0, 1 - (stepsSinceWet - FULL_STEPS) / FADE_STEPS);
 384: }
 385: 
 386: type Print = {
 387:   /** Seconds this print has been on the ground; -1 when the slot is free. */
 388:   age: number;
 389:   life: number;
 390:   /** 0…1 at birth, before ageing. */
 391:   strength: number;
 392:   kind: PrintKind;
 393:   /** Which silhouette it was pressed with; re-treading only merges its own. */
 394:   shape: TrackShape;
 395:   matrix: Matrix;
 396:   /** Which cell of the sole atlas this print draws from. */
 397:   atlasU: number;
 398:   atlasV: number;
 399:   /** Its own brightness, so a trail does not repeat its weight either. */
 400:   shade: number;
 401: };
 402: 
 403: /**
 404:  * Per-kind colour, carried on the instance and applied in proportion to depth.
 405:  *
 406:  * Snow is a *slight* blue: the only light reaching the bottom of a hole in
 407:  * snow is sky, so the hollow goes cold while the untouched rim stays neutral.
 408:  * Wet is the whole effect - water on stone has no relief to shade, just a
 409:  * darker, less saturated patch where the film fills the surface roughness.
 410:  */
 411: const TINT: Record<PrintKind, readonly [number, number, number]> = {
 412:   wet: [0.45, 0.48, 0.56],
 413:   // The walk trench: the same snow as the prints, so its floor takes the
 414:   // same cool tint - it is one channel with pockets in it, not two layers.
 415:   drag: [0.6, 0.64, 0.75],
 416:   // Barely tinted, strongly cool: it is a *proportion* of the snow that
 417:   // survives, per channel, so red losing a little where blue loses none is a
 418:   // shadow that goes icy rather than grey. Light, because the whole print is
 419:   // meant to be a suggestion at this depth.
 420:   snow: [0.85, 0.92, 1],
 421: };
 422: 
 423: /** How strongly a fresh print of this kind is applied. */
 424: const PEAK: Record<PrintKind, number> = {
 425:   wet: 0.85,
 426:   // Full: the walk trench IS the trail (improved_2.jpg), the prints are
 427:   // pockets in its floor. How much of it a gait lays is decided per gait in
 428:   // footprintSystem.ts (a run lays none), not here.
 429:   drag: 1,
 430:   // The relief and the AO carry snow, so a fresh print applies in full.
 431:   snow: 1,
 432: };
 433: 
 434: /** Seconds a print lasts before it has gone completely. */
 435: const LIFE: Record<PrintKind, number> = {
 436:   // Water on stone: gone in well under a minute.
 437:   wet: 22,
 438:   // Matches the prints it joins, so a trail fades as one thing.
 439:   drag: 55,
 440:   // A print in snow survives until the fall covers it again.
 441:   snow: 55,
 442: };
 443: 
 444: /** Fraction of its life a print spends fading out at the end. */
 445: const FADE_TAIL = 0.55;
 446: 
 447: /** Flat ground, for callers that have not worked out a slope. */
 448: const UP = { x: 0, y: 1, z: 0 };
 449: 
 450: /**
 451:  * One ring pool per kind, each with its own mesh.
 452:  *
 453:  * The kinds used to share a single mesh that swapped material, which was fine
 454:  * while only one could be on screen at a time. Drag marks broke that: a trail
 455:  * is prints **and** the troughs between them, both visible at once. Two meshes
 456:  * is two draw calls, which is a fair price for the trail reading as one thing.
 457:  */
 458: type Pool = {
 459:   mesh: Mesh;
 460:   matrixData: Float32Array;
 461:   colourData: Float32Array;
 462:   prints: Print[];
 463:   /** How many slots this pool has - the hero's ring is smaller (see `POOL`). */
 464:   size: number;
 465:   next: number;
 466:   dirty: boolean;
 467: };
 468: 
 469: // ---- 2. state + readers ----------------------------------------------------
 470: 
 471: /** Keyed by kind **and** lane: `snow|hero` and `snow|crowd` are two rings. */
 472: const pools = new Map<string, Pool>();
 473: 
 474: const poolKey = (kind: PrintKind, lane: PrintLane) => `${kind}|${lane}`;
 475: 
 476: /** Deterministic value noise, so a sole is the same every run. */
 477: function hash2(x: number, y: number): number {
 478:   const h = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
 479:   return h - Math.floor(h);
 480: }
 481: 
 482: function noise2(x: number, y: number): number {
 483:   const xi = Math.floor(x);
 484:   const yi = Math.floor(y);
 485:   let fx = x - xi;
 486:   let fy = y - yi;
 487:   fx = fx * fx * (3 - 2 * fx);
 488:   fy = fy * fy * (3 - 2 * fy);
 489: 
 490:   const a = hash2(xi, yi);
 491:   const b = hash2(xi + 1, yi);
 492:   const c = hash2(xi, yi + 1);
 493:   const d = hash2(xi + 1, yi + 1);
 494: 
 495:   return a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy;
 496: }
 497: 
 498: const smoothstep = (a: number, b: number, x: number) => {
 499:   const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
 500:   return t * t * (3 - 2 * t);
 501: };
 502: 
 503: /**
 504:  * The silhouette: **a waisted superellipse** - the outline of a boot sole.
 505:  *
 506:  * One connected shape, not a ball plus a separate heel: pressed into snow the
 507:  * whole sole bears down and the arch fills in, so the print has a waist rather
 508:  * than a gap. But it is emphatically not an ellipse either. An ellipse with
 509:  * angular wobble on it came out looking like a bird track, because the wobble
 510:  * has to be large before it stops reading as a curve, and by then the lobes
 511:  * are claws.
 512:  *
 513:  * A superellipse gets there without any wobble at all: exponent ~2.6 gives
 514:  * squared-off, rounded ends instead of points, which is the single strongest
 515:  * cue for "boot" as opposed to "animal". The waist and the wider ball do the
 516:  * rest.
 517:  *
 518:  * **v = 1 is the toe.** The chain that decides this is worth spelling out,
 519:  * because it is three conventions deep and an early cut had the prints walking
 520:  * backwards: `CreatePlane` puts v=0 at local y -0.5, the baked `rotation.x` of
 521:  * +90 deg sends local y -0.5 to z -0.5, and `addFootprint` lays the length
 522:  * axis (local +Z) along the direction of travel. So high v is forward, and the
 523:  * ball of the foot belongs there.
 524:  */
 525: const SOLE = {
 526:   cu: 0.5,
 527:   cv: 0.5,
 528:   /**
 529:    * Half-width and half-length of the sole in texture space.
 530:    *
 531:    * Equal, and derived rather than authored: the print's proportions are the
 532:    * quad's, set in `FOOTPRINT_TUNING`. See `SOLE_FILL`.
 533:    */
 534:   ru: SOLE_FILL / 2,
 535:   rv: SOLE_FILL / 2,
 536:   /**
 537:    * Superellipse exponent. 2 is an ellipse; higher squares off the ends.
 538:    *
 539:    * Down from 2.6, which was only ever survivable because `ru` and `rv`
 540:    * differed by 1.8:1 - the stretch disguised the squaring. With the radii
 541:    * equal, 2.6 draws a squircle, and that is exactly what it looked like: a
 542:    * rounded square pressed into the snow. Just over 2 keeps a trace of the
 543:    * flattened end without the corners, and the boot cue now comes from the
 544:    * waist and the ball, which is where it should have come from anyway.
 545:    */
 546:   power: 2.05,
 547:   /** How far the arch pulls in, as a fraction of the width. */
 548:   waist: 0.3,
 549:   /** Where the waist sits along the sole; negative is toward the heel. */
 550:   waistAt: -0.1,
 551:   /** Extra width at the ball of the foot, forward of the waist. */
 552:   ball: 0.1,
 553: };
 554: 
 555: /**
 556:  * Signed depth into the silhouette at (u, v): positive inside, negative out,
 557:  * roughly in units of "fraction of the way to the middle".
 558:  */
 559: /**
 560:  * Per-variant silhouette jitter.
 561:  *
 562:  * Deterministic in the variant index, so the four soles are stable across a
 563:  * rebuild and a test can assert on them. Kept small: these are four boots off
 564:  * the same last, not four different animals.
 565:  */
 566: function variantShape(seed: number) {
 567:   const j = (k: number) => hash2(seed * 7.3 + k * 3.1, seed * 2.9 + k * 5.7) - 0.5;
 568:   return {
 569:     power: SOLE.power + j(0) * 0.35,
 570:     waist: SOLE.waist + j(1) * 0.14,
 571:     ball: SOLE.ball + j(2) * 0.08,
 572:     waistAt: SOLE.waistAt + j(3) * 0.1,
 573:     /** Rolls the noise so no two variants share a crumb or a rim lump. */
 574:     nu: seed * 37.1,
 575:     nv: seed * 53.7,
 576:   };
 577: }
 578: 
 579: /**
 580:  * One superellipse lobe, in the normalised print space every shape works in:
 581:  * `(a, b)` is the offset from the lobe's centre divided by its own radii, so
 582:  * the outline is at length 1 and the answer is positive inside it, roughly in
 583:  * units of "fraction of the way to the middle".
 584:  *
 585:  * `power` is the corner: 2 is an ellipse, above it squares off toward a
 586:  * rounded rectangle, below it pinches toward a diamond - which is the whole
 587:  * difference between a boot, a pad and a leg tip.
 588:  */
 589: function lobe(a: number, b: number, power: number): number {
 590:   return (
 591:     1 -
 592:     Math.pow(
 593:       Math.pow(Math.abs(a), power) + Math.pow(Math.abs(b), power),
 594:       1 / power
 595:     )
 596:   );
 597: }
 598: 
 599: /**
 600:  * The silhouettes, in the space where the print's own outline is the unit
 601:  * circle-ish: `du` and `dv` run -1…1 across the print's width and length, and
 602:  * **+dv is forward** (see the `v = 1 is the toe` note on `SOLE`).
 603:  *
 604:  * Each returns the same signed depth `lobe` does, so a shape is a union of
 605:  * lobes taken with `Math.max` and everything downstream - the wall profile,
 606:  * the crest, the clods, the normals - is written once and works for all of
 607:  * them. Adding a shape is a case here, a row in `DRAWN_SHAPES` and an aspect
 608:  * in `SHAPE_ASPECT`; nothing else in the file needs to know.
 609:  */
 610: function shapeDepth(
 611:   shape: TrackShape,
 612:   du: number,
 613:   dv: number,
 614:   V: ReturnType<typeof variantShape>
 615: ): number {
 616:   switch (shape) {
 617:     case 'paw': {
 618:       // A pad and four toes. The pad narrows toward the heel, which is what
 619:       // makes it read as an animal's foot and not as a circle: a dog's, a
 620:       // wolf's and a yeti's are all this shape at different sizes.
 621:       const padW = 0.54 + 0.22 * smoothstep(-1, 0.2, dv);
 622:       let best = lobe(du / padW, (dv + 0.38) / 0.55, 2.5);
 623: 
 624:       for (let i = 0; i < 4; i++) {
 625:         // -1, -1/3, 1/3, 1 across the front of the pad.
 626:         const t = (i - 1.5) / 1.5;
 627:         // The outer toes sit back a little, so the four land on an arc.
 628:         const cv = 0.62 - Math.abs(t) * 0.13;
 629:         // Small, and spread wide enough to stay four. The first cut had them
 630:         // at 0.27 across on 0.4 centres, so every neighbour overlapped and
 631:         // the four came out as one bar across the front of the pad - which
 632:         // is the difference between an animal's foot and a shoe.
 633:         best = Math.max(best, lobe((du - t * 0.72) / 0.19, (dv - cv) / 0.25, 2.2));
 634:       }
 635: 
 636:       return best;
 637:     }
 638: 
 639:     case 'claw': {
 640:       // Three talons fanning off a small heel. Each is built in its own
 641:       // frame and tapers toward its tip, so the points splay outward
 642:       // instead of all pointing up the track.
 643:       let best = lobe(du / 0.4, (dv + 0.5) / 0.4, 2.4);
 644: 
 645:       for (let i = 0; i < 3; i++) {
 646:         const a = (i - 1) * 0.62;
 647:         const sa = Math.sin(a);
 648:         const ca = Math.cos(a);
 649:         const ou = du - sa * 0.68;
 650:         const ov = dv - (0.04 + ca * 0.5);
 651:         const along = ou * sa + ov * ca;
 652:         const across = ou * ca - ov * sa;
 653:         // Narrower the further out the talon goes: a claw, not a finger.
 654:         const w = 0.25 * (1 - 0.55 * smoothstep(-0.25, 0.55, along));
 655:         best = Math.max(best, lobe(across / w, along / 0.52, 2.1));
 656:       }
 657: 
 658:       return best;
 659:     }
 660: 
 661:     case 'hoof': {
 662:       // Two crescents with the cleft open between them. Each half swings
 663:       // outward toward the toe (the `b * b` lean), which is what stops the
 664:       // pair reading as two plain ovals side by side.
 665:       let best = -1;
 666: 
 667:       for (let s = -1; s <= 1; s += 2) {
 668:         const b = (dv - 0.02) / 0.86;
 669:         const a = (du - s * 0.46) / 0.38 + s * 0.28 * b * b;
 670:         best = Math.max(best, lobe(a, b, 2.6));
 671:       }
 672: 
 673:       return best;
 674:     }
 675: 
 676:     case 'chitin': {
 677:       // A leg tip, not a foot: one narrow slot with a point at each end
 678:       // (power under 2 pinches the ends), and the dew claw behind it. Small
 679:       // and deep is the read - an insect's weight goes through a needle, and
 680:       // the two marks have to stay two: at 0.78 long the slot ran back into
 681:       // the dew and the pair came out as one streak.
 682:       const tip = lobe(du / 0.42, (dv - 0.32) / 0.5, 1.7);
 683:       const dew = lobe(du / 0.22, (dv + 0.62) / 0.22, 2);
 684:       return Math.max(tip, dew);
 685:     }
 686: 
 687:     case 'pad': {
 688:       // A big round crushing foot, a shade wider at the front, with three
 689:       // blunt toe bulges on the leading edge. No arch and no waist: nothing
 690:       // this heavy has an instep.
 691:       const w = 0.9 + 0.1 * smoothstep(-1, 0.3, dv);
 692:       let best = lobe(du / (0.92 * w), dv / 0.95, 2.8);
 693: 
 694:       for (let i = 0; i < 3; i++) {
 695:         best = Math.max(
 696:           best,
 697:           lobe((du - (i - 1) * 0.5) / 0.26, (dv - 0.8) / 0.3, 2.4)
 698:         );
 699:       }
 700: 
 701:       return best;
 702:     }
 703: 
 704:     case 'boot':
 705:     default: {
 706:       // Width along the sole: pinched at the arch, widest at the ball.
 707:       const arch = (dv - V.waistAt) / 0.42;
 708:       const width =
 709:         1 - V.waist * Math.exp(-arch * arch) + V.ball * smoothstep(0, 0.75, dv);
 710: 
 711:       return lobe(du / width, dv, V.power);
 712:     }
 713:   }
 714: }
 715: 
 716: function soleDepth(
 717:   shape: TrackShape,
 718:   u: number,
 719:   v: number,
 720:   seed = 0
 721: ): number {
 722:   // Warp the sampling point before testing the ellipses. Roughening only the
 723:   // edge value leaves a shape that is still obviously two ovals; bending the
 724:   // domain underneath makes the outline itself wander, which is what a hole
 725:   // punched into loose snow actually looks like.
 726:   const V = variantShape(seed);
 727: 
 728:   // Domain warp, rolled per variant so no two soles wander the same way.
 729:   const wu = u + (noise2(u * 4 + 3.1 + V.nu, v * 4 + 1.7 + V.nv) - 0.5) * 0.11;
 730:   const wv = v + (noise2(u * 4 + 9.3 + V.nu, v * 4 + 5.2 + V.nv) - 0.5) * 0.11;
 731: 
 732:   const du = (wu - SOLE.cu) / SOLE.ru;
 733:   const dv = (wv - SOLE.cv) / SOLE.rv;
 734: 
 735:   const best = shapeDepth(shape, du, dv, V);
 736: 
 737:   // Grain on the outline. Enough to keep the rim off a drawn curve, small
 738:   // enough that the sole still reads as a sole -- a large wobble here is what
 739:   // turned the previous cut into a bird track.
 740:   const n =
 741:     noise2(u * 8 + V.nu, v * 8 + V.nv) * 0.6 +
 742:     noise2(u * 22 + V.nu, v * 22 + V.nv) * 0.4 -
 743:     0.5;
 744: 
 745:   return best + n * 0.15;
 746: }
 747: 
 748: /** Lattice the flung clods are scattered on. */
 749: const CELL = 20;
 750: 
 751: /** A clod of snow thrown clear of the print, or 0. */
 752: function clodAt(u: number, v: number, s: number, seed = 0): number {
 753:   // Only just outside the outline. Beyond about half a print-radius out the
 754:   // foot had no reach.
 755:   if (s >= -0.02 || s <= -0.5) return 0;
 756: 
 757:   const cx = Math.floor(u * CELL);
 758:   const cy = Math.floor(v * CELL);
 759: 
 760:   // Thrown forward off the toe, because that is the end that pushed off.
 761:   const forward = 0.5 + 0.5 * smoothstep(0.3, 0.95, v);
 762: 
 763:   if (hash2(cx * 3.7 + 11 + seed * 13.7, cy * 2.3 + 5 + seed * 9.1) >= 0.34 * forward) return 0;
 764: 
 765:   const gu = (cx + 0.5) / CELL;
 766:   const gv = (cy + 0.5) / CELL;
 767:   const gd = Math.sqrt((u - gu) * (u - gu) + (v - gv) * (v - gv)) * CELL;
 768: 
 769:   return Math.max(0, 1 - gd * 1.5);
 770: }
 771: 
 772: /**
 773:  * The sole as a height field, plus the coverage that goes with it.
 774:  *
 775:  * Height is in normalised units for both kinds: -1 is the floor of the hollow,
 776:  * positive is snow pushed up above the surrounding level.
 777:  */
 778: function soleHeight(
 779:   kind: PrintKind,
 780:   shape: TrackShape,
 781:   seed = 0
 782: ): {
 783:   height: Float32Array;
 784:   coverage: Float32Array;
 785: } {
 786:   const height = new Float32Array(TEX * TEX);
 787:   const coverage = new Float32Array(TEX * TEX);
 788: 
 789:   for (let y = 0; y < TEX; y++) {
 790:     for (let x = 0; x < TEX; x++) {
 791:       const i = y * TEX + x;
 792:       const u = (x + 0.5) / TEX;
 793:       const v = (y + 0.5) / TEX;
 794:       const s = soleDepth(shape, u, v, seed);
 795: 
 796:       if (kind === 'drag') {
 797:         // The ploughed trench of a walk through deep snow (improved_2.jpg):
 798:         // a broad flat-floored channel, walls that rise steeply to a broken,
 799:         // shouldered crest, tapering at both ends where it runs under the
 800:         // prints it joins so the trail flows into them rather than butting
 801:         // up against them.
 802:         // The walls WANDER along the run - a low-frequency drift of each
 803:         // edge, independently per side - and that is what stops the channel
 804:         // being a straight-sided rectangle. A separate, finer noise roughens
 805:         // the wall itself.
 806:         const side = u < 0.5 ? 0 : 1;
 807:         const wander =
 808:           (noise2(v * 2.2 + seed * 13.1 + side * 40, seed * 7.7 + side * 9) - 0.5) *
 809:           0.16;
 810:         const edge = 0.4 + wander;
 811:         const across = 1 - Math.abs(u - 0.5) / edge;
 812:         const groove =
 813:           across + (noise2(u * 9 + seed * 31.3, v * 5 + seed * 17.9) - 0.5) * 0.2;
 814: 
 815:         // The taper multiplies the finished profile rather than feeding into
 816:         // it. Folded in before the threshold, the ends slide down through the
 817:         // lip band on their way to zero and cap the trough with a bright rim
 818:         // exactly where it is supposed to be disappearing under a print.
 819:         // Short: pieces overlap by more than this, so the ends cross-fade
 820:         // inside the neighbour and the channel has no seams.
 821:         const taper = smoothstep(0, 0.22, v) * smoothstep(0, 0.22, 1 - v);
 822: 
 823:         // Steep wall, broad floor: saturates a third of the way in.
 824:         const cut = smoothstep(0.08, 0.36, groove) * taper;
 825:         // The crest is lumpy along its run - snow shouldered aside lands in
 826:         // heaps, not in a piped border.
 827:         const heap =
 828:           0.4 + 0.6 * noise2(u * 6 + seed * 41.3, v * 14 + seed * 23.7);
 829:         const lip =
 830:           Math.exp(-Math.pow((groove - 0.02) / 0.08, 2)) * taper * heap;
 831:         // Trodden floor: the pockets left by each boot merge into an uneven
 832:         // bottom rather than a machined channel.
 833:         // Churned: two octaves, the coarse one the clumps the boots turned
 834:         // over, the fine one the broken crust between them. Big enough to be
 835:         // the floor's texture, not a machined channel.
 836:         const trodden =
 837:           ((noise2(u * 5 + seed * 5.1, v * 7 + seed * 3.3) - 0.5) * 0.3 +
 838:             (noise2(u * 14 + seed * 2.7, v * 19 + seed * 8.9) - 0.5) * 0.14) *
 839:           cut;
 840: 
 841:         height[i] = -cut * 0.85 + lip * 0.4 + trodden;
 842:         coverage[i] = Math.min(1, cut + lip * 0.9);
 843:         continue;
 844:       }
 845: 
 846:       if (kind === 'wet') {
 847:         // A stain, not a dent - but NOT flat. The fragment derives
 848:         // everything from depth: the tint mix, the AO darkening, and
 849:         // through them the premultiplied alpha. At height 0, depth is 0,
 850:         // tint is white, keep is 1, and alpha comes out (1 - 1) x strength
 851:         // = ZERO - a perfectly flat wet sole rendered as nothing at all,
 852:         // which is why wet prints were never once seen in play. A shallow
 853:         // dish gives the film a depth for the tint and the occlusion to
 854:         // act on; the gentle rim gradient it adds reads as the wet edge.
 855:         const c = smoothstep(0, 0.16, s);
 856:         height[i] = -0.35 * c;
 857:         coverage[i] = c;
 858:         continue;
 859:       }
 860: 
 861:       // A dish, not a shaft. The wall ramps the whole way from the outline to
 862:       // the middle, so the floor is a continuous curve rather than a flat
 863:       // bottom with a lip round it - which is what stops the print reading as
 864:       // a cut-out and starts it reading as something pressed.
 865:       // Saturating part-way in is deliberate here: it gives a broad flat
 866:       // floor with a defined wall round it, which is what a **rigid sole**
 867:       // actually leaves. The earlier dish profile ramped the whole way to a
 868:       // point, and that is right for a soft impression but wrong for a boot -
 869:       // it also put most of the print's area at shallow depth, so occlusion
 870:       // had almost nothing to bite on and the print read flat however hard
 871:       // the shading was pushed. Swept over the wall edge with AO at 0.42:
 872:       // 0.45 -> mean 0.73x, 0.6 -> 0.76x, 0.8 -> 0.80x.
 873:       const hollow = smoothstep(-0.08, FOOTPRINT_TUNING.wallEdge, s);
 874: 
 875:       // The ridge of snow shouldered aside, just outside the outline -- and
 876:       // deliberately **lumpy**, not a smooth band. Its height is modulated by
 877:       // its own noise, so the rim is a broken run of mounds with gaps in it
 878:       // rather than a piped border, which is what a rim reads as when the
 879:       // amplitude is constant all the way round.
 880:       const crestT = (s + 0.07) / 0.075;
 881:       const crestBand = Math.exp(-crestT * crestT);
 882:       const lump =
 883:         0.35 +
 884:         0.65 *
 885:           (noise2(u * 13 + 2.5 + seed * 41.3, v * 13 + 6.5 + seed * 23.7) * 0.7 +
 886:             noise2(u * 31, v * 31) * 0.3);
 887:       const crest = crestBand * lump;
 888: 
 889:       // Clods of snow flung clear, on a coarse lattice so they land as
 890:       // clumps. These are the texture *around* the rim: without them the
 891:       // print stops dead at its own edge and the snow beyond is glass.
 892:       const clod = clodAt(u, v, s, seed);
 893: 
 894:       // Pressed snow underfoot: a slow undulation across the floor of the
 895:       // cavity, so the bottom is not a machined surface.
 896:       //
 897:       // It used to be 30 repeats at 0.11 amplitude, which at this print size
 898:       // is a feature every 0.02 tiles - and the floor's normal comes from the
 899:       // gradient of this, so a fine, tall wobble turns into hard speckle the
 900:       // moment there is any occlusion to shade it. That read as a TEXTURE
 901:       // pasted into the bottom of the hole rather than as packed snow. A third
 902:       // of the amplitude at a third of the frequency reads as the floor being
 903:       // uneven, which is all it was ever meant to say.
 904:       const packed = (noise2(u * 11, v * 11) - 0.5) * 0.035 * hollow;
 905:       // Grain along the crest, so the rim is not a clean drawn oval.
 906:       const rimGrain = (noise2(u * 24 + 5, v * 24 + 9) - 0.5) * 0.2 * crestBand;
 907: 
 908:       height[i] = -hollow + crest * 0.42 + clod * 0.26 + packed + rimGrain;
 909:       coverage[i] = Math.min(1, hollow + crest * 0.8 + clod * 0.9);
 910:     }
 911:   }
 912: 
 913:   return { height, coverage };
 914: }
 915: 
 916: /**
 917:  * The sole texture: **R** signed height, biased so 0.5 is the undisturbed
 918:  * surface - below it is the cavity (parallax and AO), above it is the snow the
 919:  * boot pushed up (the rim light and the subsurface term),
 920:  * **G** and **B** the tangent-space normal's x and z, **A** how much of this texel
 921:  * the boot disturbed at all.
 922:  *
 923:  * Generated rather than shipped as an asset - it is a handful of superellipses
 924:  * and some noise, and adding an OZT to the data folder for that would be silly.
 925:  *
 926:  * Every row at once. The **runtime does not use this**: it allocates the atlas
 927:  * empty and bakes a shape's row the first time something presses it
 928:  * (`ensureShape`), because a quarter of a million texels of value noise for
 929:  * silhouettes nothing in the world has is a stall for nothing. This is the
 930:  * whole-atlas form, for the tests that read the cells back.
 931:  */
 932: export function buildSole(kind: PrintKind): Uint8Array {
 933:   const data = new Uint8Array(atlasWidth() * atlasHeight(kind) * 4);
 934: 
 935:   for (const shape of DRAWN_SHAPES.slice(0, atlasRows(kind))) {
 936:     writeShape(data, kind, shape);
 937:   }
 938: 
 939:   return data;
 940: }
 941: 
 942: /** Width of the atlas in texels: one column per variant. */
 943: function atlasWidth(): number {
 944:   return TEX * ATLAS_COLS;
 945: }
 946: 
 947: /** Height of the atlas in texels: one row per shape this kind needs. */
 948: function atlasHeight(kind: PrintKind): number {
 949:   return TEX * atlasRows(kind);
 950: }
 951: 
 952: /**
 953:  * Bake one shape's whole row - all four variants - into the atlas buffer.
 954:  *
 955:  * A row at a time rather than the whole atlas, because rows are baked
 956:  * **lazily**: six shapes times four variants is a quarter of a million texels
 957:  * of value noise, and a session that only ever sees a hero and a yeti has no
 958:  * business paying for the spiders. `ensureShape` calls this the first time a
 959:  * shape is actually pressed into the ground and re-uploads the texture.
 960:  */
 961: function writeShape(
 962:   data: Uint8Array,
 963:   kind: PrintKind,
 964:   shape: TrackShape
 965: ): void {
 966:   const row = kind === 'drag' ? 0 : Math.max(0, shapeRow(shape));
 967: 
 968:   for (let v = 0; v < VARIANTS; v++) {
 969:     writeVariant(data, kind, shape, v, v * TEX, row * TEX);
 970:   }
 971: }
 972: 
 973: /** One sole, rendered into its cell of the atlas. */
 974: function writeVariant(
 975:   data: Uint8Array,
 976:   kind: PrintKind,
 977:   shape: TrackShape,
 978:   seed: number,
 979:   ox: number,
 980:   oy: number
 981: ): void {
 982:   const { height, coverage } = soleHeight(kind, shape, seed);
 983: 
 984:   // The two axes have different world scales, so the gradient is taken in
 985:   // tiles rather than in UV - otherwise the normals would come out stretched
 986:   // by however much longer the print is than it is wide.
 987:   const step = 1 / TEX;
 988:   const perX = FOOTPRINT_TUNING.depth / (2 * step * quadWidth(shape));
 989:   const perZ = FOOTPRINT_TUNING.depth / (2 * step * quadLength());
 990: 
 991:   const stride = atlasWidth();
 992: 
 993:   const at = (x: number, y: number) =>
 994:     height[
 995:       Math.min(TEX - 1, Math.max(0, y)) * TEX +
 996:         Math.min(TEX - 1, Math.max(0, x))
 997:     ];
 998: 
 999:   for (let y = 0; y < TEX; y++) {
1000:     for (let x = 0; x < TEX; x++) {
1001:       const i = y * TEX + x;
1002:       // Destination in the atlas, not in the sole.
1003:       const d = (oy + y) * stride + (ox + x);
1004: 
1005:       const dx = (at(x + 1, y) - at(x - 1, y)) * perX;
1006:       const dz = (at(x, y + 1) - at(x, y - 1)) * perZ;
1007: 
1008:       const len = Math.sqrt(dx * dx + 1 + dz * dz);
1009: 
1010:       const o = d * 4;
1011:       // Signed, biased to the middle. Storing bare depth clamped the crest's
1012:       // height away, which silently made the rim light impossible: `raised`
1013:       // was always zero and the lit ridge never fired.
1014:       data[o] = Math.round(
1015:         Math.min(1, Math.max(0, height[i] * 0.5 + 0.5)) * 255
1016:       );
1017:       data[o + 1] = Math.round((-dx / len) * 0.5 * 255 + 127.5);
1018:       data[o + 2] = Math.round((-dz / len) * 0.5 * 255 + 127.5);
1019:       data[o + 3] = Math.round(Math.min(1, coverage[i]) * 255);
1020:     }
1021:   }
1022: }
1023: 
1024: /** Atlas dimensions, for tests reading `buildSole`. */
1025: export const soleAtlasSize = (kind: PrintKind): [number, number] => [
1026:   atlasWidth(),
1027:   atlasHeight(kind),
1028: ];
1029: 
1030: /** Side of one sole within the atlas, and how the grid is laid out. */
1031: export const SOLE_TILE = TEX;
1032: export const SOLE_VARIANTS = VARIANTS;
1033: export const SOLE_SHAPES = DRAWN_SHAPES;
1034: 
1035: /** Peak strength a print of this kind is applied at, before its fade. */
1036: export function solePeak(kind: PrintKind): number {
1037:   return PEAK[kind];
1038: }
1039: 
1040: /** Colour a print of this kind is tinted toward at full depth. */
1041: export function soleTint(kind: PrintKind): readonly [number, number, number] {
1042:   return TINT[kind];
1043: }
1044: 
1045: const VERTEX = `
1046: precision highp float;
1047: 
1048: attribute vec3 position;
1049: attribute vec2 uv;
1050: 
1051: #ifdef INSTANCES
1052: attribute vec4 world0;
1053: attribute vec4 world1;
1054: attribute vec4 world2;
1055: attribute vec4 world3;
1056: #endif
1057: 
1058: // NOT "color". Babylon rewrites a thin-instance colour buffer to the kind
1059: // "instanceColor" on the way in (thinInstanceMesh.js: "color for instanced
1060: // mesh is ColorInstanceKind and not ColorKind because of native"), so a shader
1061: // declaring "color" binds nothing, gets the default (0,0,0,1), and draws every
1062: // print as an opaque black hole. Babylon's own default shader knows this,
1063: // which is why the StandardMaterial version did not show the bug.
1064: #ifdef INSTANCESCOLOR
1065: attribute vec4 instanceColor;
1066: #endif
1067: 
1068: uniform mat4 world;
1069: uniform mat4 viewProjection;
1070: uniform vec3 cameraPosition;
1071: // How much of the atlas one sole spans, per axis: 1/cols by 1/rows. The grid
1072: // is not square any more (four variants across, one row per track shape), so
1073: // this is a vec2 and not the single ATLAS_FILL it used to be.
1074: uniform vec2 atlasSpan;
1075: 
1076: varying vec2 vUV;
1077: varying vec4 vColor;
1078: // Origin of this print's quarter of the sole atlas. The relief march has to be
1079: // held inside it: an unclamped march walks straight into the neighbouring
1080: // sole, and a print would sample the toe of a different boot along its edge.
1081: varying vec2 vAtlas;
1082: varying vec3 vTan;
1083: varying vec3 vBit;
1084: varying vec3 vNrm;
1085: varying vec3 vView;
1086: 
1087: void main() {
1088: #ifdef INSTANCES
1089:   mat4 finalWorld = world * mat4(world0, world1, world2, world3);
1090: #else
1091:   mat4 finalWorld = world;
1092: #endif
1093: 
1094:   vec4 worldPos = finalWorld * vec4(position, 1.0);
1095: 
1096:   // instanceColor is (atlas u, atlas v, brightness jitter, alpha). It used to
1097:   // be (tint.rgb, alpha), but the tint was the same value for every instance
1098:   // of a kind - a uniform's job - which left two channels free for this.
1099: #ifdef INSTANCESCOLOR
1100:   vColor = instanceColor;
1101:   vAtlas = instanceColor.xy;
1102: #else
1103:   vColor = vec4(1.0);
1104:   vAtlas = vec2(0.0);
1105: #endif
1106: 
1107:   vUV = uv * atlasSpan + vAtlas;
1108: 
1109:   // The instance's own axes. Rotating the baked normal by these is what lets
1110:   // every print be lit from the same sun however it is turned.
1111:   vTan = normalize(finalWorld[0].xyz);
1112:   vBit = normalize(finalWorld[2].xyz);
1113:   // The quad is tilted onto the ground's slope, so "up" is its own Y column
1114:   // rather than the world's.
1115:   vNrm = normalize(finalWorld[1].xyz);
1116:   vView = cameraPosition - worldPos.xyz;
1117: 
1118:   gl_Position = viewProjection * worldPos;
1119: }
1120: `;
1121: 
1122: const FRAGMENT = `
1123: precision highp float;
1124: 
1125: varying vec2 vUV;
1126: varying vec4 vColor;
1127: varying vec2 vAtlas;
1128: varying vec3 vTan;
1129: varying vec3 vBit;
1130: varying vec3 vNrm;
1131: varying vec3 vView;
1132: 
1133: uniform sampler2D soleSampler;
1134: uniform vec3 sunDir;
1135: // Colour this kind of print tends toward at full depth. A uniform now: it was
1136: // per-instance, and it was the same for every instance of a kind.
1137: uniform vec3 soleTint;
1138: // x: relief reach in uv, y: ao strength, z: ambient, w: rim gain.
1139: // These are uniforms rather than GLSL constants so FOOTPRINT_TUNING can move
1140: // them live without recompiling the effect.
1141: uniform vec4 soleParams;
1142: // 1 when the frame buffer holds linear values, 0 when it holds display ones.
1143: // The blend multiplies whatever the terrain already wrote, so it has to know
1144: // which of the two that is. Same signal the terrain keys its own decode on.
1145: uniform float linearOut;
1146: 
1147: const int RELIEF_STEPS = 12;
1148: const int SHADOW_STEPS = 6;
1149: 
1150: /**
1151:  * How much of the atlas one sole spans, and half a texel of it - so a clamped
1152:  * fetch cannot bilinearly pick up the sole next door. Both are uniforms now:
1153:  * the atlas is a grid of variants by track shape and its size depends on how
1154:  * many shapes the kind has.
1155:  */
1156: uniform vec2 atlasSpan;
1157: uniform vec2 atlasEdge;
1158: 
1159: /**
1160:  * Longest march allowed, as a fraction of ONE CELL.
1161:  *
1162:  * Measured in cell space rather than atlas space on purpose: it is a limit on
1163:  * how far the ray may walk across the sole, and the sole is the cell.
1164:  */
1165: const float SWEEP_MAX = 0.45;
1166: 
1167: /** Hold a sample inside this print's own cell of the atlas. */
1168: vec2 soleUV(vec2 p) {
1169:   return clamp(p, vAtlas + atlasEdge, vAtlas + atlasSpan - atlasEdge);
1170: }
1171: 
1172: /** Cap a march in cell space, then take it into the atlas' own scale. */
1173: vec2 toAtlas(vec2 cell) {
1174:   float len = length(cell);
1175:   return (len > SWEEP_MAX ? cell * (SWEEP_MAX / len) : cell) * atlasSpan;
1176: }
1177: 
1178: void main() {
1179:   vec3 view = normalize(vView);
1180: 
1181:   // View in the print's own frame. The lateral part over the part along the
1182:   // surface normal is how far across the texture the eye travels per unit of
1183:   // depth.
1184:   vec2 viewT = vec2(dot(view, vTan), dot(view, vBit));
1185:   float viewUp = max(dot(view, vNrm), 0.08);
1186: 
1187:   // Cap it at what fits inside this sole.
1188:   //
1189:   // A march that leaves the sub-rect finds no sole out there, only the border
1190:   // soleUV() clamps it to - and the border is outside the outline, so it
1191:   // returns coverage 0 and the print silently disappears. That is a bad way to
1192:   // fail, and an especially bad one because the sweep length depends on the
1193:   // view angle and on the tilt of the ground under the print: it does not fail
1194:   // everywhere, it fails on some prints some of the time, which reads as them
1195:   // blinking in and out for no reason.
1196:   //
1197:   // Capping costs a little parallax at a grazing angle. That is the right
1198:   // trade against losing the print altogether.
1199:   vec2 sweep = toAtlas((viewT / viewUp) * soleParams.x);
1200: 
1201:   // Relief march: walk down through depth layers until the height field rises
1202:   // above the ray. A single offset only shifts the picture; this hides the
1203:   // near wall behind its own rim and brings the far wall into view.
1204:   float layerStep = 1.0 / float(RELIEF_STEPS);
1205:   vec2 uvStep = sweep * layerStep;
1206: 
1207:   // R is signed height biased to 0.5, so depth below the surface is
1208:   // (1 - 2R) and height above it is (2R - 1).
1209:   vec2 uv = vUV;
1210:   float rayDepth = 0.0;
1211:   float texDepth = max(0.0, 1.0 - 2.0 * texture2D(soleSampler, soleUV(uv)).r);
1212: 
1213:   for (int i = 0; i < RELIEF_STEPS; i++) {
1214:     if (rayDepth >= texDepth) break;
1215:     uv -= uvStep;
1216:     texDepth = max(0.0, 1.0 - 2.0 * texture2D(soleSampler, soleUV(uv)).r);
1217:     rayDepth += layerStep;
1218:   }
1219: 
1220:   // One linear refinement between the last two layers, so the wall does not
1221:   // come out in visible bands.
1222:   vec2 prevUV = uv + uvStep;
1223:   float after = texDepth - rayDepth;
1224:   float before =
1225:       max(0.0, 1.0 - 2.0 * texture2D(soleSampler, soleUV(prevUV)).r) -
1226:       (rayDepth - layerStep);
1227:   uv = soleUV(mix(uv, prevUV, clamp(after / (after - before + 1e-5), 0.0, 1.0)));
1228: 
1229:   vec4 sole = texture2D(soleSampler, uv);
1230:   float signedHeight = sole.r * 2.0 - 1.0;
1231:   float depth = max(0.0, -signedHeight);
1232:   float coverage = sole.a;
1233: 
1234:   float nx = sole.g * 2.0 - 1.0;
1235:   float nz = sole.b * 2.0 - 1.0;
1236:   float ny = sqrt(max(0.0, 1.0 - nx * nx - nz * nz));
1237:   vec3 normal = normalize(vTan * nx + vNrm * ny + vBit * nz);
1238: 
1239:   // Self-shadowing rim: march toward the sun and see whether the ridge the
1240:   // boot pushed up gets in the way, so the rim lays a real shadow across the
1241:   // inside of the print.
1242:   vec2 lightT = vec2(dot(sunDir, vTan), dot(sunDir, vBit));
1243:   float lightUp = max(dot(sunDir, vNrm), 0.08);
1244:   // Capped the same way the view march is. Uncapped it walks out of the cell
1245:   // at a grazing sun, and every sample then clamps to the border - which is
1246:   // outside the outline and so reads as flat, undisturbed snow. Against a ray
1247:   // that is below the surface that scores as fully blocked, so a print in a
1248:   // low sun went dark for a reason that was entirely an artefact of the atlas.
1249:   vec2 lightSweep = toAtlas((lightT / lightUp) * soleParams.x);
1250: 
1251:   float blocked = 0.0;
1252: 
1253:   for (int i = 1; i <= SHADOW_STEPS; i++) {
1254:     float t = float(i) / float(SHADOW_STEPS);
1255:     float alongRay = depth * (1.0 - t);
1256:     float here = max(
1257:       0.0,
1258:       1.0 - 2.0 * texture2D(soleSampler, soleUV(uv + lightSweep * t)).r
1259:     );
1260:     blocked = max(blocked, (alongRay - here) * (1.0 - t));
1261:   }
1262: 
1263:   // Smoothstepped and shallow: a hard cut here is what made the interior read
1264:   // as one solid blob instead of a gradient running down the wall.
1265:   float selfShadow = 1.0 - smoothstep(0.0, 1.0, blocked * 1.8) * 0.5;
1266: 
1267:   // Deliberately high. A print in snow is not a dark hole: snow is close to a
1268:   // perfect diffuser and a cavity's walls bounce light into each other, so
1269:   // even a wall turned right away from the sun keeps most of its brightness.
1270:   // Depth is read from the *pairing* of a lit rim against a mid-tone floor,
1271:   // which is why the rim below may add light. Dropping this is what turned an
1272:   // earlier cut into black ovals.
1273:   float ambient = soleParams.z;
1274: 
1275:   float lambert = max(dot(normal, sunDir), 0.0) * selfShadow;
1276:   float lit = ambient + (1.0 - ambient) * lambert;
1277:   float flatLit = ambient + (1.0 - ambient) * max(dot(vNrm, sunDir), 0.0);
1278: 
1279:   // How much of the ground survives, measured against what undisturbed snow
1280:   // beside it would have caught. 1 means untouched.
1281:   float keep = lit / max(0.08, flatLit) * (1.0 - soleParams.y * depth);
1282: 
1283:   // Snow the boot pushed up, above the original surface.
1284:   float raised = max(0.0, signedHeight);
1285: 
1286:   // Rim light: the crest is tilted up into the sun and catches it square on,
1287:   // which is the cue that says the snow was displaced rather than merely
1288:   // pressed. This is additive, so it can go brighter than the snow beside it.
1289:   float rim = raised * max(dot(normal, sunDir), 0.0) * soleParams.w;
1290: 
1291:   // Subsurface: snow is translucent, so light entering a thin displaced ridge
1292:   // scatters through and leaves the far side glowing instead of going flat
1293:   // dark. Keyed to the side facing away from the sun.
1294:   // Subsurface rides at a little over half the rim: it is the same displaced
1295:   // snow, seen from its unlit side.
1296:   float sss = raised * max(0.0, -dot(normal, sunDir)) * soleParams.w * 0.55;
1297: 
1298:   vec3 tint = mix(vec3(1.0), soleTint, depth);
1299: 
1300:   // vColor.z is this print's own brightness, a small wobble either side of 1.
1301:   // Four sole shapes stop a trail repeating its outline; this stops it
1302:   // repeating its *weight*, which is the other half of what gives away a
1303:   // stamped decal. Costs nothing - the channel was already there.
1304:   float strength = coverage * vColor.a * vColor.z;
1305: 
1306:   // Premultiplied blend: dst * (1 - a) + rgb. The (1 - a) half is a
1307:   // *proportional* darkening -- correct inside a shadow and on half-covered
1308:   // ground, exactly as the multiply blend was -- and the rgb half adds light
1309:   // on top, which multiply could never do. That is what buys the bright rim.
1310:   //
1311:   // There is only one alpha for three channels, and expressing a per-channel
1312:   // tint through it would need to know what the ground already drew, which a
1313:   // blend cannot tell us. So the *most* darkened channel goes through the
1314:   // alpha, and the other two are handed back the difference as light. That is
1315:   // exact where the ground is bright, which is the case this exists for (snow
1316:   // at ~0.93); on darker stone it over-corrects the hue slightly, which is a
1317:   // fair trade for one pass and no assumption about the surface.
1318:   float floorTint = min(tint.r, min(tint.g, tint.b));
1319:   float keepScalar = clamp(keep * floorTint, 0.0, 1.0);
1320: 
1321:   // How much of the ground survives, in DISPLAY space - the space every
1322:   // number above was tuned in, and the space the buffer is in only when
1323:   // post-processing is off.
1324:   float keepShown = 1.0 - (1.0 - keepScalar) * strength;
1325: 
1326:   // With image processing in post the terrain writes pow(colour, 2.2)
1327:   // (terrainMaterial's linearOut), so a factor applied there comes back as
1328:   // its own 1/2.2 root once the frame is gamma-encoded again: a print tuned
1329:   // to take a fifth off the snow took a tenth of it. That is the whole of
1330:   // "the prints are barely there with post-processing on". Raising the factor
1331:   // into the buffer's own domain is exact and needs nothing from the grade -
1332:   // exposure and contrast hit the print and the snow beside it alike, so they
1333:   // cancel out of the ratio.
1334:   float alpha = 1.0 - mix(keepShown, pow(keepShown, 2.2), linearOut);
1335: 
1336:   vec3 hue = keep * (tint - vec3(floorTint)) * strength;
1337: 
1338:   // The additive half goes in as authored either way. Its linear equivalent
1339:   // is the display add times the encode slope at the snow's own brightness
1340:   // (~2.0 at 0.93) over the mood exposure (~2.1), and those two cancel to
1341:   // within a few percent - unlike the multiply, which is out by a whole
1342:   // gamma.
1343:   vec3 add = hue + vec3(rim + sss) * strength;
1344: 
1345:   gl_FragColor = vec4(add, alpha);
1346: }
1347: `;
