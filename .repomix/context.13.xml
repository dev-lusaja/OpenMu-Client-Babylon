<file path="versions/v097d/ui/pregame/shipScene.ts">
  1: /**
  2:  * The 0.97d pre-game backdrop: a ship at sea under the MU wordmark, the sky
  3:  * and the water scrolling past it so the ship reads as sailing forever.
  4:  *
  5:  * Ported from the reference client, which still carries the scene behind
  6:  * `if (SceneFlag == LOG_IN_SCENE || SceneFlag == CHARACTER_SCENE)` - Season 4
  7:  * replaced the set piece with two real worlds and left the code. There is no
  8:  * login world in the 0.97d tree (`World1`..`World12` and nothing else) and
  9:  * none is needed: nothing here is anchored to a map, so the scene runs with
 10:  * `world.terrain` null and owns its models and its camera itself.
 11:  *
 12:  * | Piece | Model | Original |
 13:  * |---|---|---|
 14:  * | sky | `Logo/logo01.bmd` `MODEL_LOGO` | ZzzObject.cpp:4516 scale 0.044, BlendMesh 1, unlit; :3707 scrolls V |
 15:  * | water | `Logo/logo02.bmd` `MODEL_WAVEBYSHIP` | :4505 scale 0.8, BlendMesh 0, light 1/1/1; :3710 scrolls V |
 16:  * | ship | `Object1/Ship01.bmd` `MODEL_SHIP` | MapManager.cpp:1045 (the Lorencia object set); :4500 scale 0.8 |
 17:  * | wordmark | `Logo/Logo03.bmd` `MODEL_MUGAME` | :4511 scale 2.2, BlendMesh 1, unlit |
 18:  * | sun | `Logo/Logo04.bmd` `MODEL_LOGOSUN` | :4520 scale 3, light 0.5/0.5/0.5 |
 19:  *
 20:  * Camera: `LoginScene.cpp:61` `WALK_PATHS`, driven by `MoveCamera` (:241)
 21:  * through `MoveCharacterCamera(origin 0,0,0, position, angle)` at FOV 45.
 22:  */
 23: import type { ArcRotateCamera } from '../../../../src/libs/babylon/exports';
 24: import { Texture, Vector3 } from '../../../../src/libs/babylon/exports';
 25: import { ModelObject } from '../../../../src/common/modelObject';
 26: import { loadGLTF } from '../../../../src/common/modelLoader';
 27: import { toRadians } from '../../../../src/common/utils';
 28: import type { World } from '../../../../src/ecs/world';
 29: import type {
 30:   PregamePhase,
 31:   PregameScene,
 32: } from '../../../../src/version/uiContract';
 33: 
 34: const MU_SCALE = 100;
 35: 
 36: /** MU is Z-up, Babylon Y-up (`common/characterSelect.ts`). */
 37: function fromMu(x: number, y: number, z: number): Vector3 {
 38:   return new Vector3(x / MU_SCALE, z / MU_SCALE, y / MU_SCALE);
 39: }
 40: 
 41: /**
 42:  * `MoveCharacterCamera`: `CameraAngle` is (pitch, _, yaw) in degrees, the
 43:  * same convention `characterSelect.cameraForward` decodes.
 44:  */
 45: function forwardFromMuAngle(pitchDeg: number, yawDeg: number): Vector3 {
 46:   const pitch = toRadians(pitchDeg);
 47:   const yaw = toRadians(yawDeg);
 48: 
 49:   return new Vector3(
 50:     -Math.sin(pitch) * Math.sin(yaw),
 51:     -Math.cos(pitch),
 52:     -Math.sin(pitch) * Math.cos(yaw)
 53:   ).normalize();
 54: }
 55: 
 56: /** `LoginScene.cpp:61` - position (x, y, z) then angle (x, y, z). */
 57: const LOGIN_WAYPOINT = { pos: [0, -1000, 500], angle: [-80, 0, 0] } as const;
 58: const LOGIN_WAYPOINT_END = { pos: [0, -1100, 500], angle: [-80, 0, 0] } as const;
 59: const CHARACTER_WAYPOINT = {
 60:   pos: [200, -800, 250],
 61:   angle: [-87, 0, -10],
 62: } as const;
 63: 
 64: /** `CameraFOV = 45.f` (LoginScene.cpp:255). */
 65: const SCENE_FOV = toRadians(45);
 66: 
 67: /** How far along the look ray the camera's target is put. Framing only. */
 68: const TARGET_DISTANCE = 20;
 69: 
 70: /**
 71:  * `UpdateCameraWaypoint`: 128 ticks at the original's 25 Hz between the
 72:  * start waypoint and the four identical targets, so the visible result is a
 73:  * slow drift from -1000 to -1100 and then a hold.
 74:  */
 75: const DRIFT_SECONDS = 128 / 25;
 76: 
 77: type Piece = {
 78:   readonly file: string;
 79:   readonly scale: number;
 80:   readonly light: readonly [number, number, number];
 81:   /**
 82:    * Where the piece sits, in MU units. The sea and the sky are authored
 83:    * around the world origin the scene is built on; the ship, the wordmark
 84:    * and the sun are placed. The 0.97d client's own `CreateLogInScene` is not
 85:    * in the reference tree (Season 4 replaced it), so these three are framed
 86:    * to the original's camera rather than copied from it.
 87:    */
 88:   readonly at?: readonly [number, number, number];
 89:   /** Yaw in degrees. */
 90:   readonly yaw?: number;
 91:   /** Additive mesh index (`o->BlendMesh`); it is also the one that scrolls. */
 92:   readonly blendMesh?: number;
 93:   /** Mesh whose V coordinate scrolls (`o->BlendMeshTexCoordV`). */
 94:   readonly scrollMesh?: number;
 95:   /**
 96:    * `gLoadData.OpenTexture(MODEL_LOGO + i, L"Logo\\", GL_REPEAT, GL_LINEAR)`
 97:    * (ZzzOpenData.cpp:4883): the sky and sea quads carry UVs well outside
 98:    * 0..1 and tile their small sheets. Clamped, they smear the edge pixel
 99:    * into a flat wash over the whole horizon.
100:    */
101:   readonly repeat?: boolean;
102:   /** Drawn from inside: the sky shell needs both faces. */
103:   readonly doubleSided?: boolean;
104:   /** Drawn on the login screen only; character select is a closer framing. */
105:   readonly loginOnly?: boolean;
106: };
107: 
108: const PIECES: readonly Piece[] = [
109:   {
110:     file: 'Logo/logo01.glb',
111:     scale: 0.044,
112:     light: [1, 1, 1],
113:     scrollMesh: 1,
114:     repeat: true,
115:     doubleSided: true,
116:   },
117:   {
118:     file: 'Logo/logo02.glb',
119:     scale: 0.8,
120:     light: [1, 1, 1],
121:     scrollMesh: 0,
122:     repeat: true,
123:   },
124:   {
125:     file: 'Object1/Ship01.glb',
126:     scale: 0.8,
127:     light: [1, 1, 1],
128:     at: [420, 1500, -60],
129:     yaw: 28,
130:   },
131:   {
132:     file: 'Logo/Logo03.glb',
133:     scale: 1.5,
134:     light: [1, 1, 1],
135:     blendMesh: 1,
136:     at: [-560, 1560, 640],
137:     loginOnly: true,
138:   },
139:   {
140:     file: 'Logo/Logo04.glb',
141:     scale: 3,
142:     light: [0.5, 0.5, 0.5],
143:     blendMesh: 0,
144:     at: [980, 1620, 640],
145:   },
146: ];
147: 
148: /** `BlendMeshTexCoordV = -((int)WorldTime % 4000 * 0.00025f)` (ZzzObject.cpp:3705). */
149: function scrollV(elapsedMs: number): number {
150:   return -((elapsedMs % 4000) * 0.00025);
151: }
152: 
153: const ORIGIN = { x: 0, y: 0, z: 0 };
154: const NO_ROTATION = { x: 0, y: 0, z: 0 };
155: 
156: export function createShipScene(world: World): PregameScene {
157:   const scene = world.scene;
158: 
159:   const parts: { piece: Piece; object: ModelObject }[] = [];
160:   /** The sheets `BlendMeshTexCoordV` runs on: the clouds and the water. */
161:   const scrolling: Texture[] = [];
162:   let disposed = false;
163:   let elapsedMs = 0;
164: 
165:   for (const piece of PIECES) {
166:     const object = new ModelObject(scene);
167: 
168:     object.CastsShadow = false;
169:     if (piece.blendMesh !== undefined) object.BlendMesh = piece.blendMesh;
170: 
171:     parts.push({ piece, object });
172: 
173:     void loadGLTF(piece.file, world).then(gltf => {
174:       if (disposed) return;
175: 
176:       object.load(gltf);
177:       object.Light.set(piece.light[0], piece.light[1], piece.light[2]);
178:       object.updateLocation(
179:         piece.at ? fromMu(piece.at[0], piece.at[1], piece.at[2]) : ORIGIN,
180:         piece.scale,
181:         piece.yaw ? { x: 0, y: toRadians(piece.yaw), z: 0 } : NO_ROTATION
182:       );
183:       object.playAction(0, true);
184: 
185:       for (const mesh of object.getMeshes()) {
186:         // The sky shell wraps the camera, so its own bounding box never
187:         // enters the frustum test the way a map object's does; without this
188:         // the horizon quads are culled and the backdrop is black.
189:         mesh.alwaysSelectAsActiveMesh = true;
190: 
191:         if (piece.doubleSided && mesh.material) {
192:           mesh.material.backFaceCulling = false;
193:         }
194:       }
195: 
196:       // The shared item materials bind `metadata.diffuseTexture` per mesh, so
197:       // the sheet to tile and to scroll is the mesh's own, not the material's.
198:       for (const mesh of object.getMeshes()) {
199:         const texture = mesh.metadata?.diffuseTexture as Texture | undefined;
200:         if (!texture) continue;
201: 
202:         if (piece.repeat) {
203:           texture.wrapU = Texture.WRAP_ADDRESSMODE;
204:           texture.wrapV = Texture.WRAP_ADDRESSMODE;
205:         }
206:       }
207: 
208:       if (piece.scrollMesh !== undefined) {
209:         const texture = object.getMesh(piece.scrollMesh)?.metadata
210:           ?.diffuseTexture as Texture | undefined;
211: 
212:         if (texture) scrolling.push(texture);
213:       }
214:     });
215:   }
216: 
217:   const target = new Vector3(0, 0, 0);
218: 
219:   return {
220:     update(deltaTime: number, phase: PregamePhase) {
221:       elapsedMs += deltaTime * 1000;
222: 
223:       for (const { piece, object } of parts) {
224:         if (!object.Ready) continue;
225: 
226:         object.node.setEnabled(phase === 'login' || !piece.loginOnly);
227:       }
228: 
229:       for (const texture of scrolling) texture.vOffset = scrollV(elapsedMs);
230: 
231:       const camera = scene.activeCamera as ArcRotateCamera;
232:       if (!camera) return;
233: 
234:       const waypoint =
235:         phase === 'characters'
236:           ? CHARACTER_WAYPOINT
237:           : LOGIN_WAYPOINT_END;
238:       const from = phase === 'characters' ? CHARACTER_WAYPOINT : LOGIN_WAYPOINT;
239: 
240:       const t =
241:         phase === 'characters'
242:           ? 1
243:           : Math.min(elapsedMs / 1000 / DRIFT_SECONDS, 1);
244: 
245:       const position = fromMu(
246:         from.pos[0] + (waypoint.pos[0] - from.pos[0]) * t,
247:         from.pos[1] + (waypoint.pos[1] - from.pos[1]) * t,
248:         from.pos[2] + (waypoint.pos[2] - from.pos[2]) * t
249:       );
250: 
251:       const forward = forwardFromMuAngle(waypoint.angle[0], waypoint.angle[2]);
252: 
253:       target.copyFrom(position).addInPlace(forward.scale(TARGET_DISTANCE));
254: 
255:       camera.fov = SCENE_FOV;
256:       camera.setTarget(target);
257:       camera.setPosition(position);
258:     },
259: 
260:     dispose() {
261:       disposed = true;
262:       scrolling.length = 0;
263: 
264:       for (const { object } of parts) object.dispose();
265: 
266:       parts.length = 0;
267:     },
268:   };
269: }
</file>

