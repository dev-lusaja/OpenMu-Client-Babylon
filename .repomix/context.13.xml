1621: function place(
1622:   pool: Pool,
1623:   kind: PrintKind,
1624:   shape: TrackShape,
1625:   x: number,
1626:   y: number,
1627:   z: number,
1628:   angle: number,
1629:   width: number,
1630:   length: number,
1631:   strength: number,
1632:   up: { x: number; y: number; z: number }
1633: ): void {
1634:   if (deepenExisting(pool, kind, shape, x, z, strength)) return;
1635: 
1636:   const print = pool.prints[pool.next];
1637:   pool.next = (pool.next + 1) % pool.size;
1638: 
1639:   print.age = 0;
1640:   print.life = LIFE[kind];
1641:   print.strength = Math.min(1, strength);
1642:   print.kind = kind;
1643:   print.shape = shape;
1644: 
1645:   // Which of the four soles, and how heavily it fell. Random per print rather
1646:   // than cycling: a cycle of four is itself a pattern, and at this size the
1647:   // eye finds a repeating four-step rhythm about as fast as it finds one shape.
1648:   const variant = Math.floor(Math.random() * VARIANTS) % VARIANTS;
1649:   const [au, av] = cellOffset(kind, shape, variant);
1650:   print.atlasU = au;
1651:   print.atlasV = av;
1652:   print.shade = 0.86 + Math.random() * 0.28;
1653: 
1654:   // Nobody plants a foot exactly along their heading, and nobody's two feet
1655:   // land with the same weight. A few degrees of yaw and a few percent of size,
1656:   // independently per axis, so even the same sole twice running does not
1657:   // present the same outline.
1658:   // Not for the trench: its pieces overlap end to end into one channel, and
1659:   // a yaw or a width step between two pieces is a visible kink in it.
1660:   if (kind !== 'drag') {
1661:     angle += (Math.random() - 0.5) * 0.26;
1662:     width *= 0.93 + Math.random() * 0.14;
1663:     length *= 0.93 + Math.random() * 0.14;
1664:   }
1665: 
1666:   const nl = Math.hypot(up.x, up.y, up.z) || 1;
1667:   const ux = up.x / nl;
1668:   const uy = up.y / nl;
1669:   const uz = up.z / nl;
1670: 
1671:   // Walk direction, flattened onto the ground plane so the print lies in it.
1672:   let fx = Math.sin(angle);
1673:   let fy = 0;
1674:   let fz = Math.cos(angle);
1675:   const along = fx * ux + fy * uy + fz * uz;
1676:   fx -= ux * along;
1677:   fy -= uy * along;
1678:   fz -= uz * along;
1679:   const fl = Math.hypot(fx, fy, fz) || 1;
1680:   fx /= fl;
1681:   fy /= fl;
1682:   fz /= fl;
1683: 
1684:   // Right = up x forward, matching the flat case where X was (cos, 0, -sin).
1685:   const rx = uy * fz - uz * fy;
1686:   const ry = uz * fx - ux * fz;
1687:   const rz = ux * fy - uy * fx;
1688: 
1689:   const m = print.matrix.m as unknown as Float32Array;
1690:   m[0] = rx * width;
1691:   m[1] = ry * width;
1692:   m[2] = rz * width;
1693:   m[3] = 0;
1694:   m[4] = ux;
1695:   m[5] = uy;
1696:   m[6] = uz;
1697:   m[7] = 0;
1698:   m[8] = fx * length;
1699:   m[9] = fy * length;
1700:   m[10] = fz * length;
1701:   m[11] = 0;
1702:   // Lift along the ground's normal, not straight up, so the clearance is the
1703:   // same all the way round however the ground is tilted.
1704:   m[12] = x + ux * Z_LIFT;
1705:   m[13] = y + uy * Z_LIFT;
1706:   m[14] = z + uz * Z_LIFT;
1707:   m[15] = 1;
1708:   print.matrix.markAsUpdated();
1709: 
1710:   pool.dirty = true;
1711: }
1712: 
1713: /** Everything one print needs. An object because there are now eleven of them. */
1714: export interface FootprintSpec {
1715:   x: number;
1716:   y: number;
1717:   z: number;
1718:   /** Walk heading in radians about Y. */
1719:   angle: number;
1720:   kind: PrintKind;
1721:   /** Which silhouette to press - the creature's, from `recipes.ts`. */
1722:   shape: TrackShape;
1723:   /** How strongly it takes; where the drying boot enters (`footprintSystem`). */
1724:   strength: number;
1725:   /**
1726:    * How far the foot sank, and how big it is. Scales the quad **uniformly**,
1727:    * which is not just cosmetic: the relief march works in UV against a fixed
1728:    * reach, so a quad twice as wide is a hollow twice as deep in world terms as
1729:    * well. One number therefore gets both halves of "deeper snow, bigger and
1730:    * deeper print", and the same one gets "a bigger creature presses harder",
1731:    * without a second per-instance channel.
1732:    */
1733:   scale?: number;
1734:   /** The ground's own normal under the foot. */
1735:   up?: { x: number; y: number; z: number };
1736:   /** Which ring it goes in. The hero has one to itself - see `POOL`. */
1737:   lane?: PrintLane;
1738: }
1739: 
1740: /**
1741:  * Lay a print down.
1742:  *
1743:  * The shape's row of the sole atlas is baked here, on the first print that
1744:  * asks for it, so nothing is generated for a silhouette nothing in the world
1745:  * ever presses.
1746:  */
1747: export function addFootprint(scene: Scene, spec: FootprintSpec): void {
1748:   const { kind, shape, strength } = spec;
1749: 
1750:   if (strength <= 0 || shapeRow(shape) < 0) return;
1751: 
1752:   const scale = spec.scale ?? 1;
1753: 
1754:   ensureShape(atlasFor(scene, kind), kind, shape);
1755: 
1756:   place(
1757:     ensurePool(scene, kind, spec.lane ?? 'crowd'),
1758:     kind,
1759:     shape,
1760:     spec.x,
1761:     spec.y,
1762:     spec.z,
1763:     spec.angle,
1764:     quadWidth(shape) * scale,
1765:     quadLength() * scale,
1766:     strength,
1767:     spec.up ?? UP
1768:   );
1769: }
1770: 
1771: /**
1772:  * Default trough width in tiles, for callers that do not say. The walk gait
1773:  * in footprintSystem.ts passes its own: a trench wide enough to hold both
1774:  * feet and the snow shouldered out of it.
1775:  */
1776: const DRAG_WIDTH = 0.3;
1777: 
1778: /**
1779:  * Join two footfalls with a shallow trough.
1780:  *
1781:  * This is the difference between a row of separate holes and a trail: in snow
1782:  * deep enough to sink into, the boot does not clear the surface between steps,
1783:  * it ploughs through it. Called from the same stride that lays the print, with
1784:  * the previous footfall's position.
1785:  *
1786:  * Length is the gap plus a little, so each end runs under the print it joins
1787:  * instead of stopping short of it and leaving a visible seam.
1788:  */
1789: export function addDragMark(
1790:   scene: Scene,
1791:   fromX: number,
1792:   fromZ: number,
1793:   toX: number,
1794:   toZ: number,
1795:   y: number,
1796:   strength: number,
1797:   up: { x: number; y: number; z: number } = UP,
1798:   width: number = DRAG_WIDTH
1799: ): void {
1800:   if (strength <= 0 || width <= 0) return;
1801: 
1802:   const dx = toX - fromX;
1803:   const dz = toZ - fromZ;
1804:   const gap = Math.hypot(dx, dz);
1805: 
1806:   if (gap < 1e-3) return;
1807: 
1808:   ensureShape(atlasFor(scene, 'drag'), 'drag', 'boot');
1809: 
1810:   place(
1811:     ensurePool(scene, 'drag', 'hero'),
1812:     'drag',
1813:     'boot',
1814:     (fromX + toX) * 0.5,
1815:     y,
1816:     (fromZ + toZ) * 0.5,
1817:     Math.atan2(dx, dz),
1818:     width,
1819:     // Well over the gap, so every piece runs deep into both neighbours and
1820:     // the end tapers cross-fade rather than meeting.
1821:     gap * 1.7,
1822:     strength,
1823:     up
1824:   );
1825: }
1826: 
1827: /** Ages every print and pushes the instance buffers. Call once a frame. */
1828: export function updateFootprints(dt: number): void {
1829:   // The post-processing toggle moves the buffer between linear and display
1830:   // without rebuilding anything here, so the domain is re-read rather than
1831:   // bound once at material creation.
1832:   for (const atlas of materials.values()) {
1833:     atlas.material.setFloat(
1834:       'linearOut',
1835:       linearBufferActive(atlas.material.getScene()) ? 1 : 0
1836:     );
1837:   }
1838: 
1839:   for (const pool of pools.values()) {
1840:     const { prints, matrixData, colourData } = pool;
1841:     let live = 0;
1842: 
1843:     for (let i = 0; i < pool.size; i++) {
1844:       const print = prints[i];
1845:       const o = i * 4;
1846: 
1847:       if (print.age < 0) {
1848:         colourData[o + 3] = 0;
1849:         continue;
1850:       }
1851: 
1852:       print.age += dt;
1853: 
1854:       if (print.age >= print.life) {
1855:         print.age = -1;
1856:         colourData[o + 3] = 0;
1857:         pool.dirty = true;
1858:         continue;
1859:       }
1860: 
1861:       live++;
1862: 
1863:       const t = print.age / print.life;
1864:       // Flat for the first stretch, then out: a print does not start fading
1865:       // the instant it is made.
1866:       const remaining =
1867:         t <= 1 - FADE_TAIL ? 1 : Math.max(0, (1 - t) / FADE_TAIL);
1868: 
1869:       matrixData.set(print.matrix.asArray(), i * 16);
1870:       // (atlas u, atlas v, brightness, alpha). The tint that used to live in
1871:       // rgb was identical for every instance of a kind and is a uniform now.
1872:       colourData[o] = print.atlasU;
1873:       colourData[o + 1] = print.atlasV;
1874:       colourData[o + 2] = print.shade;
1875:       colourData[o + 3] = PEAK[print.kind] * print.strength * remaining;
1876: 
1877:       pool.dirty = true;
1878:     }
1879: 
1880:     pool.mesh.setEnabled(live > 0);
1881: 
1882:     if (!pool.dirty) continue;
1883:     pool.dirty = false;
1884: 
1885:     pool.mesh.thinInstanceBufferUpdated('matrix');
1886:     pool.mesh.thinInstanceBufferUpdated('color');
1887:   }
1888: }
1889: 
1890: /** Wipe the trail - a map change or a teardown. */
1891: export function resetFootprints(): void {
1892:   for (const pool of pools.values()) {
1893:     for (const print of pool.prints) print.age = -1;
1894:     pool.next = 0;
1895:     pool.colourData.fill(0);
1896:     pool.mesh.setEnabled(false);
1897:     pool.mesh.thinInstanceBufferUpdated('color');
1898:     pool.dirty = false;
1899:   }
1900: }
1901: 
1902: /**
1903:  * Rebuild everything from the current `FOOTPRINT_TUNING`.
1904:  *
1905:  * The soles are generated once into a texture and the materials bind their
1906:  * parameters once, so a change to the tuning has to throw both away. Prints
1907:  * already on the ground go with them - they were drawn with the old numbers
1908:  * and keeping them would show two looks at once.
1909:  */
1910: export function applyFootprintTuning(): void {
1911:   for (const pool of pools.values()) pool.mesh.dispose();
1912:   pools.clear();
1913: 
1914:   for (const atlas of materials.values()) atlas.material.dispose();
1915:   materials.clear();
1916: }
1917: 
1918: /**
1919:  * Dial the look live from the browser console:
1920:  *
1921:  *   muFootprints.get()                        // current numbers
1922:  *   muFootprints.set({ length: 0.7 })         // change some and rebuild
1923:  *   muFootprints.reset()                      // back to the defaults
1924:  *
1925:  * Registered unconditionally: it costs one property on `window`, and a look
1926:  * this fiddly is worth being able to find without a rebuild.
1927:  */
1928: const DEFAULTS = { ...FOOTPRINT_TUNING, tint: [...FOOTPRINT_TUNING.tint] };
1929: 
1930: if (typeof window !== 'undefined') {
1931:   (window as unknown as Record<string, unknown>).muFootprints = {
1932:     get: () => ({ ...FOOTPRINT_TUNING }),
1933:     set(next: Partial<typeof FOOTPRINT_TUNING>) {
1934:       Object.assign(FOOTPRINT_TUNING, next);
1935:       applyFootprintTuning();
1936:       return { ...FOOTPRINT_TUNING };
1937:     },
1938:     reset() {
1939:       Object.assign(FOOTPRINT_TUNING, DEFAULTS, {
1940:         tint: [...DEFAULTS.tint] as [number, number, number],
1941:       });
1942:       applyFootprintTuning();
1943:       return { ...FOOTPRINT_TUNING };
1944:     },
1945:   };
1946: }
1947: 
1948: /** Live print count across every pool. For tests. */
1949: export function footprintCount(): number {
1950:   let n = 0;
1951:   for (const pool of pools.values()) {
1952:     for (const print of pool.prints) if (print.age >= 0) n++;
1953:   }
1954:   return n;
1955: }
1956: 
1957: /**
1958:  * The layer (see layer.ts). Reset only: prints are laid by `FootprintSystem`
1959:  * from the hero's stride, and aged by `updateFootprints` from there, because
1960:  * they need the scene and the hero, which the weather tick does not have.
1961:  */
1962: // ---- 3. the layer ----------------------------------------------------------
1963: 
1964: export const footprintsLayer: WeatherLayer = {
1965:   name: 'footprints',
1966:   reset: resetFootprints,
1967: };
