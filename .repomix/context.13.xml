 31:   return new Promise<Buffer>((resolve, reject) => {
 32:     const bufs: Uint8Array[] = [];
 33:     png
 34:       .pack()
 35:       .on('data', d => {
 36:         bufs.push(d);
 37:       })
 38:       .on('end', () => {
 39:         const buffer = Buffer.concat(bufs);
