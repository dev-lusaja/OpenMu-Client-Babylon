105:               onClick={uiClick(() => {
106:                 Store.focusedChar = character.Name;
107:                 Store.focusCharacterRequest(character.Name);
108:               })}
109:             >
110:               <span>{character.Name}</span>
111:               <span className="v097d-characters-level">
112:                 {`Lv ${character.Level}`}
113:               </span>
114:             </button>
115:           ))}
116: 
117:           {deleting && (
118:             <MuSpriteFrame
