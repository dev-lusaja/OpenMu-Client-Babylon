135:         <MuSpriteFrame
136:           file={FOOT.file}
137:           width={FOOT.width}
138:           height={FOOT.height}
139:           style={{ position: 'absolute', left: 0, top: FOOT.top }}
140:         />
141: 
142:         <MuButton
143:           file={BUTTON.file}
144:           width={BUTTON.width}
145:           height={BUTTON.height}
