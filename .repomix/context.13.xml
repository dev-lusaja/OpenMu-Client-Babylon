1558: /**
1559:  * Claim the next slot in a pool and write its transform.
1560:  *
1561:  * `ux/uy/uz` is the ground's own normal. A decal held flat while the terrain
1562:  * tilts underneath has to be lifted far enough to clear its high side, and
1563:  * that lift is exactly what reads as the print hovering above the snow.
1564:  */
1565: /**
1566:  * How close two prints have to be, in tiles, before the second is taken as the
1567:  * same footfall rather than a new one.
1568:  *
1569:  * Under the width of a print, so two feet side by side (SIDE * 2, about 0.44
1570:  * apart) and two consecutive strides (STRIDE, 0.5) are never mistaken for each
1571:  * other. Only actually walking back over your own hole trips it.
1572:  */
1573: const MERGE_DIST = 0.22;
1574: 
1575: /**
1576:  * Deepen a print already in the ground, if this footfall landed on one.
1577:  *
1578:  * Pacing back and forth over the same line used to stack a fresh decal on top
1579:  * of every old one. With premultiplied blending that composites - each pass
1580:  * darkens again - so a patch anyone had crossed twice turned into a solid mess
1581:  * of overlapping holes instead of a path worn into the snow.
1582:  *
1583:  * Treading the same hole again does not make a second hole. It makes the one
1584:  * that is there deeper, and resets how long it has left. So that is what this
1585:  * does: the strength climbs toward full and the age goes back to zero, and the
1586:  * existing matrix is kept so the print does not jump as it is re-trodden.
1587:  */
1588: function deepenExisting(
1589:   pool: Pool,
1590:   kind: PrintKind,
1591:   shape: TrackShape,
1592:   x: number,
1593:   z: number,
1594:   strength: number
1595: ): boolean {
1596:   for (let i = 0; i < pool.size; i++) {
1597:     const print = pool.prints[i];
1598:     // Only a print of the same silhouette. A hound crossing the hero's trail
1599:     // treads *near* a boot mark, not into it, and deepening one shape with
1600:     // another would be the one place the two get confused.
1601:     if (print.age < 0 || print.kind !== kind || print.shape !== shape) continue;
1602: 
1603:     const m = print.matrix.m;
1604:     const dx = m[12] - x;
1605:     const dz = m[14] - z;
1606: 
1607:     if (dx * dx + dz * dz > MERGE_DIST * MERGE_DIST) continue;
1608: 
1609:     print.age = 0;
1610:     // Half, not all: the second pass through a hole does much less than the
1611:     // first did, because the snow it would have displaced is already gone.
1612:     print.strength = Math.min(1, print.strength + strength * 0.5);
1613:     pool.dirty = true;
1614: 
1615:     return true;
1616:   }
1617: 
1618:   return false;
1619: }
