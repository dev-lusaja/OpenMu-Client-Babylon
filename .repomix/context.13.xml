  1: import { ENUM_WORLD } from '../common/types';
  2: import type { WeatherLayer } from './layer';
  3: import { rainStrength, rainTarget } from './rainState';
  4: 
  5: /**
  6:  * How wet the ground is, 0…1, and how much of that has collected into
  7:  * standing water.
  8:  *
  9:  * The falling drops are particles (`RAIN`); this is what they leave behind.
 10:  * The original client has nothing like it; the roadmap lists
 11:  * `BITMAP_RAIN_CIRCLE` splashes as missing and they were never ground
 12:  * contact anyway - so this is our own, and like `snowCover` it is a
 13:  * *simulation* rather than a lookup: stone darkens while the shower falls and
 14:  * dries out slowly afterwards, which is the whole reason a passing shower
 15:  * leaves a mark on the map instead of switching a texture on and off.
 16:  *
 17:  * Two numbers come out of it because wet stone and standing water behave
 18:  * differently. Stone goes dark within seconds of the first drops and stays
 19:  * dark long after they stop; a puddle needs the rain to keep falling long
 20:  * enough to collect, and then sits there evaporating. `puddleCover` therefore
 21:  * lags `wetness` on the way up and outlives it on the way down.
 22:  */
 23: 
 24: /** Maps that get wet ground. Snow maps are excluded - Devias gets snow cover. */
 25: // ---- 1. tuning -------------------------------------------------------------
 26: 
 27: const WET_MAPS: ReadonlySet<ENUM_WORLD> = new Set([
 28:   ENUM_WORLD.WD_0LORENCIA,
 29:   ENUM_WORLD.WD_3NORIA,
 30: ]);
 31: 
 32: /** Seconds of full rain to soak dry ground. Stone darkens fast. */
 33: const WET_BUILD_SECONDS = 22;
 34: 
 35: /** Seconds for soaked ground to dry out once the sky clears. */
 36: const WET_DRY_SECONDS = 150;
 37: 
 38: /**
 39:  * How soaked ground gets, as a multiple of the rain's intensity.
 40:  *
 41:  * Without this, wetness only ever asked *is it raining* and crept to fully
 42:  * soaked either way, so a drizzle left the same black streets as a downpour
 43:  * if you waited long enough - and eventually crossed the puddle threshold,
 44:  * which is plainly wrong for rain you can barely see. Ground now approaches a
 45:  * ceiling set by the intensity instead. The packet tops out at 0.9
 46:  * (`variation` 15 x 6 / 100), so the gain is what lets real rain still reach
 47:  * a fully soaked 1.0, while a 1-of-15 drizzle settles at a tenth of that.
 48:  */
 49: const SOAK_GAIN = 1.6;
 50: 
 51: /** Ground has to be at least this wet before water starts standing on it. */
 52: // Down from 0.55. Wetness asymptotes to rain x SOAK_GAIN, so 0.55 needed
 53: // rain >= 0.34 - intensity 6 of 15 - before a single puddle could form, and
 54: // the proxy's showers start at 4/15. Everything short of a moderate shower
 55: // darkened the streets and never pooled. At 0.35 a 4/15 shower (0.24 x 1.6
 56: // = 0.38) just crosses it after its 22 s soak and pools slowly; a drizzle
 57: // under that still never does.
 58: const PUDDLE_THRESHOLD = 0.35;
 59: 
 60: /** Seconds of rain on already-soaked ground to fill the puddles. */
 61: const PUDDLE_BUILD_SECONDS = 45;
 62: 
 63: /** Seconds for full puddles to evaporate. Slower than the ground dries. */
 64: const PUDDLE_DRY_SECONDS = 210;
 65: 
 66: // ---- 2. state + readers ----------------------------------------------------
 67: 
 68: let wet = 0;
 69: let puddles = 0;
 70: let lastMap: ENUM_WORLD | null = null;
 71: 
 72: /**
 73:  * Advances both accumulators; call once a frame. Returns the ground wetness.
 74:  *
 75:  * Arriving on a map mid-shower seeds the wetness from the *packet's* target
 76:  * rather than from `rainStrength()`. `resetRain` deliberately zeroes the live
 77:  * ramp on a warp so the rain fades in instead of snapping, which means for the
 78:  * first few seconds after a gate `rainStrength()` says "dry" while the sky is
 79:  * plainly pouring. Seeding from the target avoids walking into a downpour over
 80:  * bone-dry stone.
 81:  */
 82: export function updateWetness(map: ENUM_WORLD, dt: number): number {
 83:   if (!WET_MAPS.has(map)) {
 84:     wet = 0;
 85:     puddles = 0;
 86:     lastMap = map;
 87:     return 0;
 88:   }
 89: 
 90:   if (map !== lastMap) {
 91:     lastMap = map;
 92:     const seed = rainTarget(map);
 93:     wet = seed;
 94:     puddles = seed > PUDDLE_THRESHOLD ? seed * 0.5 : 0;
 95:     return wet;
 96:   }
 97: 
 98:   const rain = rainStrength();
 99:   const soakTarget = Math.min(1, rain * SOAK_GAIN);
100: 
101:   if (wet < soakTarget) {
102:     wet = Math.min(soakTarget, wet + (rain * dt) / WET_BUILD_SECONDS);
103:   } else {
104:     // Also the path taken when the rain eases without stopping: ground that
105:     // was soaked by a downpour dries back to what a drizzle can hold.
106:     wet = Math.max(soakTarget, wet - dt / WET_DRY_SECONDS);
107:   }
108: 
109:   // Water only starts standing once the ground under it has given up
110:   // absorbing, and it can only ever be as deep as the ground is wet.
111:   const canPool = rain > 0 && wet >= PUDDLE_THRESHOLD;
112: 
113: 
114:   if (canPool) {
115:     puddles = Math.min(1, puddles + (rain * dt) / PUDDLE_BUILD_SECONDS);
116:   } else {
117:     puddles = Math.max(0, puddles - dt / PUDDLE_DRY_SECONDS);
118:   }
119: 
120:   puddles = Math.min(puddles, wet);
121: 
122:   return wet;
123: }
124: 
125: /** Ground wetness, 0…1 - the broad darkening. */
126: export function wetness(): number {
127:   return wet;
128: }
129: 
130: /** Standing water, 0…1 - the sharp-edged dark patches on flat ground. */
131: export function puddleCover(): number {
132:   return puddles;
133: }
134: 
135: /**
136:  * Whether the tile under a walker should be treated as standing water.
137:  *
138:  * Deliberately a single global test rather than a lookup into the puddle
139:  * noise field: the field lives in the shader, and mirroring it on the CPU
140:  * would mean keeping two copies of the same hash in step forever. Footprints
141:  * only need to know whether there is water about to be walked through, and
142:  * `puddleCover` above ~0.3 means a good share of the flat ground is under it.
143:  */
144: export function inPuddles(): boolean {
145:   return puddles > 0.3;
146: }
147: 
148: /** Drop both - a map change that is not to a wet map, or a teardown. */
149: export function resetWetness(): void {
150:   wet = 0;
151:   puddles = 0;
152:   lastMap = null;
153: }
154: 
155: /** The layer (see layer.ts). Must be stepped after `rainLayer`. */
156: // ---- 3. the layer ----------------------------------------------------------
157: 
158: export const wetnessLayer: WeatherLayer = {
159:   name: 'wetness',
160:   maps: WET_MAPS,
161:   update: updateWetness,
162:   reset: resetWetness,
163: };
</file>

