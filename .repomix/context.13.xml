  1: import type { WeatherLayer } from './layer';
  2: import {
  3:   Color4,
  4:   ParticleSystem,
  5:   Vector3,
  6:   type Scene,
  7: } from '../libs/babylon/exports';
  8: import { loadEffectTexture } from '../common/moveTargetEffect';
  9: import { GameOptions } from '../common/gameOptions';
 10: 
 11: /**
 12:  * The puff of loose snow a boot throws when it comes down.
 13:  *
 14:  * Paired with the footprint it belongs to (`footprintSystem` fires both from
 15:  * the same stride), and the reason the two are separate is that they solve
 16:  * different halves of the same moment: the print is what is left behind, this
 17:  * is the snow that had to go somewhere for the print to exist.
 18:  *
 19:  * One system, emitted **manually**. Every ambient recipe in
 20:  * `ambientParticles.ts` is a continuous emitter with a rate that ramps; this
 21:  * is the opposite shape - nothing at all, then eight particles in one frame,
 22:  * then nothing again - so it drives `manualEmitCount` directly rather than
 23:  * pretending to be a rate.
 24:  *
 25:  * Note what this can and cannot buy on Devias. Nothing drawn white reads
 26:  * against sunlit snow, so the spray is nearly invisible over open ground; what
 27:  * it does read against is the hero's own silhouette and the shadow they cast,
 28:  * which is exactly where the reference shows it. It is a detail around the
 29:  * feet, not a feature you see from across the square.
 30:  */
 31: 
 32: // ---- 1. tuning -------------------------------------------------------------
 33: 
 34: /** Flakes per step at full strength. */
 35: const PER_STEP = 9;
 36: 
 37: /** Ceiling on the pool: about six strides of overlapping bursts. */
 38: const CAPACITY = 160;
 39: 
 40: // ---- 2. state + readers ----------------------------------------------------
 41: 
 42: let system: ParticleSystem | null = null;
 43: let emitter: Vector3 | null = null;
 44: let ready = false;
 45: 
 46: function ensureSystem(scene: Scene): ParticleSystem {
 47:   if (system && system.getScene() === scene) {
 48:     return system;
 49:   }
 50: 
 51:   // A system built for another scene: dispose it, or its buffers outlive
 52:   // the scene that owned them.
 53:   if (system) resetSnowSpray();
 54: 
 55:   emitter = new Vector3();
 56: 
 57:   const ps = new ParticleSystem('snowSpray', CAPACITY, scene);
 58:   ps.emitter = emitter;
 59:   ps.isLocal = false;
 60:   ps.blendMode = ParticleSystem.BLENDMODE_STANDARD;
 61: 
 62:   // A tight cluster at the boot rather than a cloud around it.
 63:   ps.minEmitBox = new Vector3(-0.06, 0, -0.06);
 64:   ps.maxEmitBox = new Vector3(0.06, 0.05, 0.06);
 65: 
 66:   // Up and outward. The heading is applied by the caller rotating the
 67:   // direction cone would cost a system per angle, and kicked snow scatters
 68:   // more than it aims.
 69:   ps.direction1 = new Vector3(-0.6, 1, -0.6);
 70:   ps.direction2 = new Vector3(0.6, 1.6, 0.6);
 71:   ps.minEmitPower = 0.5;
 72:   ps.maxEmitPower = 1.6;
 73: 
 74:   // Falls back down well within its life, so the puff arcs instead of drifting.
 75:   ps.gravity = new Vector3(0, -7, 0);
 76: 
 77:   ps.minLifeTime = 0.3;
 78:   ps.maxLifeTime = 0.65;
 79:   ps.minSize = 0.045;
 80:   ps.maxSize = 0.1;
 81:   ps.minAngularSpeed = -4;
 82:   ps.maxAngularSpeed = 4;
 83: 
 84:   ps.color1 = new Color4(1, 1, 1, 0.9);
 85:   ps.color2 = new Color4(0.93, 0.96, 1, 0.75);
 86:   ps.colorDead = new Color4(0.93, 0.96, 1, 0);
 87: 
 88:   // Fade in over the first fifth and out over the last third: a flake that
 89:   // blinks out mid-arc is the same pop the ambient emitters were fixed for.
 90:   ps.addColorGradient(0, new Color4(1, 1, 1, 0));
 91:   ps.addColorGradient(0.2, new Color4(1, 1, 1, 0.9));
 92:   ps.addColorGradient(0.65, new Color4(0.95, 0.97, 1, 0.7));
 93:   ps.addColorGradient(1, new Color4(0.93, 0.96, 1, 0));
 94: 
 95:   ps.forceDepthWrite = false;
 96: 
 97:   // Nothing until a step asks for some.
 98:   ps.emitRate = 0;
 99:   ps.manualEmitCount = 0;
100: 
101:   void loadEffectTexture(scene, 'World3/leaf01.OZT').then(texture => {
102:     if (system === ps) {
103:       ps.particleTexture = texture;
104:       ready = true;
105:     }
106:   });
107: 
108:   ps.start();
109:   system = ps;
110: 
111:   return ps;
112: }
113: 
114: /**
115:  * Throw a puff of snow at a foot.
116:  *
117:  * `strength` is the same 0…1 the print is drawn at, so a boot scuffing thin
118:  * cover kicks up correspondingly little.
119:  */
120: export function snowSprayBurst(
121:   scene: Scene,
122:   x: number,
123:   y: number,
124:   z: number,
125:   strength: number
126: ): void {
127:   if (strength <= 0) return;
128:   if (!GameOptions.advancedEffects) return;
129: 
130:   const ps = ensureSystem(scene);
131: 
132:   // Before the texture lands a burst would draw as untextured white squares.
133:   if (!ready) return;
134: 
135:   emitter?.set(x, y, z);
136: 
137:   const count = Math.max(1, Math.round(PER_STEP * Math.min(1, strength)));
138: 
139:   // Additive rather than assigned: two feet landing in one frame should throw
140:   // two puffs, not have the second overwrite the first.
141:   ps.manualEmitCount = Math.max(0, ps.manualEmitCount) + count;
142: }
143: 
144: /** Drop the spray - a map change or a teardown. */
145: export function resetSnowSpray(): void {
146:   system?.dispose(false);
147:   system = null;
148:   emitter = null;
149:   ready = false;
150: }
151: 
152: // ---- 3. the layer ----------------------------------------------------------
153: 
154: /** The layer (see layer.ts). Reset only: bursts are fired by `FootprintSystem`. */
155: export const snowSprayLayer: WeatherLayer = {
156:   name: 'snowSpray',
157:   reset: resetSnowSpray,
158: };
</file>

