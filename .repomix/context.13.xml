<file path="tools/sqliteMigrate.ts">
 1: import { Database } from 'bun:sqlite';
 2: import { readdirSync, readFileSync } from 'node:fs';
 3: import { join } from 'node:path';
 4: 
 5: /**
 6:  * Apply the `.sql` files in a service's `migrations/` folder, in name order.
 7:  *
 8:  * The point is that the schema exists in exactly one place: a committed file
 9:  * an operator can run against the production database by hand, and the same
10:  * file the service applies on a fresh box. A `CREATE TABLE` written inline in
11:  * TypeScript works, but it is invisible to whoever has to reproduce it, which
12:  * is how a live database and a repository drift apart.
13:  *
14:  * What has been applied is recorded, so a re-run is cheap; the statements are
15:  * written to be idempotent anyway, so applying one by hand and letting the
16:  * service apply it too is harmless.
17:  */
18: export function migrate(db: Database, migrationsDir: string): string[] {
19:   db.run(`
20:     CREATE TABLE IF NOT EXISTS schema_migrations (
21:       name       TEXT PRIMARY KEY,
22:       applied_at INTEGER NOT NULL
23:     )
24:   `);
25: 
26:   const applied = new Set(
27:     db
28:       .query<{ name: string }, []>('SELECT name FROM schema_migrations')
29:       .all()
30:       .map(row => row.name)
31:   );
32: 
33:   const pending = readdirSync(migrationsDir)
34:     .filter(name => name.endsWith('.sql'))
35:     .sort()
36:     .filter(name => !applied.has(name));
37: 
38:   const record = db.query<unknown, [string, number]>(
39:     'INSERT INTO schema_migrations (name, applied_at) VALUES (?, ?)'
40:   );
41: 
42:   for (const name of pending) {
43:     const sql = readFileSync(join(migrationsDir, name), 'utf8');
44:     // One transaction per file: a half-applied migration is worse than none.
45:     db.transaction(() => {
46:       db.run(sql);
47:       record.run(name, Date.now());
48:     })();
49:   }
50: 
51:   return pending;
52: }
</file>

<file path="tools/texturePacker.ts">
  1: import json from './image_cache.json' assert { type: 'json' };
  2: import sharp from 'sharp';
  3: import { decodeTga } from '@lunapaint/tga-codec';
  4: import { PNG } from 'pngjs';
  5: import { DATA_FOLDER, OUTPUT_FOLDER } from './shared';
  6: 
  7: const DEFAULT_QUALITY = 90;
  8: 
  9: async function tga2png(file: Buffer) {
 10:   const tga = await decodeTga(new Uint8Array(file));
 11:   const png = new PNG({
 12:     width: tga.details.header.width,
 13:     height: tga.details.header.height,
 14:   });
 15:   png.data = Buffer.from(
 16:     tga.image.data.buffer as ArrayBuffer,
 17:     tga.image.data.byteOffset,
 18:     tga.image.data.byteLength
 19:   );
 20: 
 21:   return new Promise<Buffer>((resolve, reject) => {
 22:     const bufs: Uint8Array[] = [];
 23:     png
 24:       .pack()
 25:       .on('data', (d: Buffer) => {
 26:         bufs.push(new Uint8Array(d));
 27:       })
 28:       .on('end', () => {
 29:         const buffer = Buffer.concat(bufs);
 30:         resolve(buffer);
 31:       })
 32:       .on('error', reject);
 33:   });
 34: }
 35: 
 36: async function convertImageToWebP(image: Uint8Array): Promise<Uint8Array> {
 37:   if (image.length > 0 && image[0] === 0x00 && image[1] === 0x00) {
 38:     const inputBuffer = Buffer.from(image);
 39:     const outputBuffer = await tga2png(inputBuffer);
 40:     image = new Uint8Array(outputBuffer);
 41:   }
 42: 
 43:   const buffer = await sharp(image).toFormat('webp').toBuffer();
 44: 
 45:   return new Uint8Array(buffer);
 46: }
 47: 
 48: const folder = process.argv[2] ?? '';
 49: 
 50: if (!folder) {
 51:   console.log('Usage: bun texturePacker.ts <folder>');
 52:   process.exit(1);
 53: }
 54: 
 55: const images = Object.entries(json)
 56:   .filter(([key]) => key.startsWith(folder + '/'))
 57:   .map(([_key, l]) => ({ filePath: _key, ...l[0] }));
 58: 
 59: const OFFSET = 2;
 60: 
 61: function createAtlasData(
 62:   images: { filePath: string; width: number; height: number }[]
 63: ) {
 64:   const atlasData: {
 65:     filePath: string;
 66:     x: number;
 67:     y: number;
 68:     width: number;
 69:     height: number;
 70:   }[] = [];
 71: 
 72:   if (images.length === 0) {
 73:     return { width: 0, height: 0, atlasData };
 74:   }
 75: 
 76:   // Sort images by area (descending) for better packing
 77:   const sortedImages = [...images].sort(
 78:     (a, b) => b.width * b.height - a.width * a.height
 79:   );
 80: 
 81:   // Estimate initial atlas width based on total area
 82:   const totalArea = sortedImages.reduce(
 83:     (sum, img) => sum + img.width * img.height,
 84:     0
 85:   );
 86: 
 87:   const inefficiencyFactor = 1.1; // Factor to account for packing inefficiency
 88:   const estimatedWidth = Math.ceil(Math.sqrt(totalArea * inefficiencyFactor));
 89: 
 90:   let maxWidth = estimatedWidth;
 91:   let currentX = 0;
 92:   let currentY = 0;
 93:   let currentRowHeight = 0;
 94:   let totalHeight = 0;
 95: 
 96:   for (const image of sortedImages) {
 97:     // Check if image fits in current row
 98:     if (currentX + image.width > maxWidth && currentX > 0) {
 99:       // Move to new row
100:       currentX = 0;
101:       currentY += currentRowHeight + OFFSET;
102:       currentRowHeight = 0;
103:     }
104: 
105:     // Place image
106:     atlasData.push({
107:       filePath: image.filePath,
108:       x: currentX,
109:       y: currentY,
110:       width: image.width,
111:       height: image.height,
112:     });
113: 
114:     currentX += image.width + OFFSET;
115:     currentRowHeight = Math.max(currentRowHeight, image.height);
116: 
117:     // Update maximum width if needed
118:     maxWidth = Math.max(maxWidth, currentX);
119:   }
120: 
121:   // Add height of last row
122:   totalHeight = currentY + currentRowHeight;
123: 
124:   // Remove last offset from width
125:   const finalWidth = maxWidth > 0 ? maxWidth - OFFSET : 0;
126: 
127:   return { width: finalWidth, height: totalHeight, atlasData };
128: }
129: 
130: const atlas = createAtlasData(images);
131: 
132: async function packTextures(data: ReturnType<typeof createAtlasData>) {
133:   if (data.width === 0 || data.height === 0 || data.atlasData.length === 0) {
134:     console.log('No images to pack:', data);
135:     return;
136:   }
137: 
138:   console.log(
139:     `Creating atlas: ${data.width}x${data.height} with ${data.atlasData.length} images`
140:   );
141: 
142:   // Create base atlas image
143:   const atlasImage = sharp({
144:     create: {
145:       width: data.width,
146:       height: data.height,
147:       channels: 4,
148:       background: { r: 0, g: 0, b: 0, alpha: 0 },
149:     },
150:   });
151: 
152:   // Prepare composite operations
153:   const compositeOperations: sharp.OverlayOptions[] = [];
154: 
155:   for (const image of data.atlasData) {
156:     try {
157:       const bytes = await Bun.file(DATA_FOLDER + image.filePath).bytes();
158:       const webpBytes = await convertImageToWebP(bytes);
159: 
160:       compositeOperations.push({
161:         input: Buffer.from(webpBytes),
162:         left: image.x,
163:         top: image.y,
164:       });
165:     } catch (error) {
166:       console.error(`Failed to process image ${image.filePath}:`, error);
167:     }
168:   }
169: 
170:   // Composite all images at once
171:   const finalAtlas = atlasImage.composite(compositeOperations);
172: 
173:   // Generate output paths
174:   const outputDir = OUTPUT_FOLDER + 'atlases/';
175:   const atlasPath = outputDir + `${folder}_atlas.webp`;
176:   const jsonPath = outputDir + `${folder}_atlas.json`;
177: 
178:   // Save atlas metadata
179:   const atlasMetadata = {
180:     width: data.width,
181:     height: data.height,
182:     images: data.atlasData.map(img => ({
183:       path: img.filePath,
184:       x: img.x,
185:       y: img.y,
186:       width: img.width,
187:       height: img.height,
188:     })),
189:   };
190: 
191:   await Bun.write(jsonPath, JSON.stringify(atlasMetadata, null, 2), {
192:     createPath: true,
193:   });
194: 
195:   // Save atlas image
196:   await finalAtlas.webp({ quality: DEFAULT_QUALITY }).toFile(atlasPath);
197: 
198:   console.log(`Atlas saved to: ${atlasPath}`);
199:   console.log(`Metadata saved to: ${jsonPath}`);
200:   console.log(`Total images packed: ${data.atlasData.length}`);
201: }
202: 
203: // Execute the packing
204: await packTextures(atlas);
205: 
206: 
207: // sizes: 2 4 8 16 32 64 128 256 512 1024
208: //
209: // Shader
210: // w/h - 4bits(16) - 8bits
211: // x/y - 12bits(4096) - 24bits
212: // total: 8+24 = 32bits
</file>

<file path="tools/weatherStats.ts">
  1: /**
  2:  * What the proxy's weather schedule actually does, measured.
  3:  *
  4:  * `proxy/weather.ts` is a pure function of wall-clock time, so its climate is
  5:  * a thing you can measure rather than guess at: this sweeps a year of it at
  6:  * one-minute resolution and prints the numbers its tuning comments quote -
  7:  * how often it rains, how the days divide up, how long a shower lasts, and
  8:  * the odds that a player who logs in for half an hour sees any rain at all.
  9:  *
 10:  * Run it after touching `DRY_BELOW`, `MAX_SLOT_CHANCE` or `WETNESS_CURVE`;
 11:  * those three decide the whole climate and nothing else in the project will
 12:  * tell you when one of them has gone wrong.
 13:  *
 14:  *   bun run tools/weatherStats.ts [days] [sessionMinutes]
 15:  */
 16: import { weatherAt } from '../proxy/weather';
 17: 
 18: const DAYS = Number(process.argv[2] ?? 365);
 19: const SESSION_MINUTES = Number(process.argv[3] ?? 30);
 20: 
 21: /** Midnight UTC on 1 Jan 2026 - an arbitrary but fixed window to sweep. */
 22: const START = Date.UTC(2026, 0, 1);
 23: const MINUTE = 60_000;
 24: 
 25: const wetAt: boolean[] = [];
 26: const intensity: number[] = [];
 27: 
 28: for (let m = 0; m < DAYS * 1440; m++) {
 29:   const w = weatherAt(START + m * MINUTE);
 30:   wetAt.push(w.kind !== 0);
 31:   intensity.push(w.variation);
 32: }
 33: 
 34: const wetMinutes = wetAt.reduce((n, w) => n + (w ? 1 : 0), 0);
 35: 
 36: // Days, by how much of them was wet.
 37: let dry = 0;
 38: let showery = 0;
 39: let wet = 0;
 40: let soaked = 0;
 41: 
 42: for (let d = 0; d < DAYS; d++) {
 43:   let n = 0;
 44:   for (let m = 0; m < 1440; m++) if (wetAt[d * 1440 + m]) n++;
 45:   const share = n / 1440;
 46:   if (share < 0.005) dry++;
 47:   else if (share < 0.15) showery++;
 48:   else if (share < 0.4) wet++;
 49:   else soaked++;
 50: }
 51: 
 52: // Showers: a run of wet minutes, start to finish.
 53: const showers: number[] = [];
 54: let run = 0;
 55: for (const w of wetAt) {
 56:   if (w) run++;
 57:   else if (run > 0) {
 58:     showers.push(run);
 59:     run = 0;
 60:   }
 61: }
 62: if (run > 0) showers.push(run);
 63: 
 64: const median = (xs: readonly number[]) => {
 65:   const s = [...xs].sort((a, b) => a - b);
 66:   return s.length === 0 ? 0 : s[Math.floor(s.length / 2)];
 67: };
 68: 
 69: // The number that matters most: does a player who logs in at a random moment
 70: // for one session ever see rain? Every possible session start, not a sample.
 71: let sessionsWithRain = 0;
 72: const sessions = wetAt.length - SESSION_MINUTES;
 73: for (let m = 0; m < sessions; m++) {
 74:   for (let k = 0; k < SESSION_MINUTES; k++) {
 75:     if (wetAt[m + k]) {
 76:       sessionsWithRain++;
 77:       break;
 78:     }
 79:   }
 80: }
 81: 
 82: const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(1)} %`;
 83: const peaks = showers.length;
 84: 
 85: console.log(`weather schedule over ${DAYS} days`);
