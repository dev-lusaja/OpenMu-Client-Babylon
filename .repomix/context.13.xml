39:     emptyOutDir: true,
40:     rollupOptions: {
41:       output: {
42:         // Function form: assigns exactly these modules, nothing rides along.
43:         manualChunks(id: string) {
44:           // The generated packet classes are ~40 000 lines and were the bulk
45:           // of the app chunk (todo C9). They import only common/binaryUtils
46:           // and common/types, both engine-free, so they split cleanly; while
47:           // they still imported common/utils this dragged 2.4 MB of Babylon
48:           // into the chunk with them.
