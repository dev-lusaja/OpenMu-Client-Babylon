116: const TRACKS = {
117:   /** A shod biped: every player, every town NPC, most of the bestiary. */
118:   boot: {
119:     shape: 'boot',
120:     scale: 1,
121:     stride: 0.5,
122:     side: 0.14,
123:     feet: 2,
124:     reach: 0,
125:     press: 0.28,
126:     dragWidth: 1.0,
127:     drag: 1,
128:     spray: 1,
129:   },
130:   /**
131:    * Golems, giants, balrogs: a foot with no toes in it, twice the size, and
132:    * heavy enough that the channel behind it is a furrow.
133:    */
134:   stomp: {
135:     shape: 'pad',
136:     scale: 1.9,
137:     stride: 0.95,
138:     side: 0.26,
139:     feet: 2,
140:     reach: 0,
141:     press: 0.55,
142:     dragWidth: 1.7,
143:     drag: 1,
144:     spray: 1.6,
145:   },
146:   /** A barefoot biped with toes - yetis, forest monsters, the big and furry. */
147:   barefoot: {
148:     shape: 'paw',
149:     scale: 1.35,
150:     stride: 0.62,
151:     side: 0.18,
152:     feet: 2,
153:     reach: 0,
154:     press: 0.4,
155:     dragWidth: 1.2,
156:     drag: 0.9,
157:     spray: 1.1,
158:   },
159:   /**
160:    * A four-footed animal: hounds, wolves, werewolves. Small pads in two
161:    * pairs, and a narrow channel - a dog's chest clears snow that a man's legs
162:    * plough straight through.
163:    */
164:   paw: {
165:     shape: 'paw',
166:     scale: 0.85,
167:     stride: 0.55,
168:     side: 0.16,
169:     feet: 4,
170:     reach: 0.75,
171:     press: 0.45,
172:     dragWidth: 0.7,
173:     drag: 0.55,
174:     spray: 0.7,
175:   },
176:   /** A two-legged reptile: lizardmen, drakan, the smaller dragons. */
177:   claw: {
178:     shape: 'claw',
179:     scale: 1.1,
180:     stride: 0.6,
181:     side: 0.16,
182:     feet: 2,
183:     reach: 0,
184:     press: 0.45,
185:     dragWidth: 0.9,
186:     drag: 0.7,
187:     spray: 0.9,
188:   },
189:   /** A four-legged one, and bigger: bahamut, gorgon, the great beasts. */
190:   beast: {
191:     shape: 'claw',
192:     scale: 1.35,
193:     stride: 0.8,
194:     side: 0.22,
195:     feet: 4,
196:     reach: 1.0,
197:     press: 0.5,
198:     dragWidth: 1.3,
199:     drag: 0.85,
200:     spray: 1.2,
201:   },
202:   /** A cloven biped: bull fighters, devils. Two crescents, pressed hard. */
203:   cloven: {
204:     shape: 'hoof',
205:     scale: 1.0,
206:     stride: 0.58,
207:     side: 0.15,
208:     feet: 2,
209:     reach: 0,
210:     press: 0.6,
211:     dragWidth: 0.9,
212:     drag: 0.8,
213:     spray: 0.9,
214:   },
215:   /** On all fours: death cows, anything ridden. */
216:   hoof: {
217:     shape: 'hoof',
218:     scale: 0.95,
219:     stride: 0.62,
220:     side: 0.17,
221:     feet: 4,
222:     reach: 0.85,
223:     press: 0.6,
224:     dragWidth: 0.8,
225:     drag: 0.6,
226:     spray: 0.8,
227:   },
228:   /**
229:    * Spiders, scorpions, beetles: thin legs that punch small deep holes and a
230:    * body that never touches the snow, so there is no channel at all - which
231:    * is the whole point of it. A line of separate pricks with clean snow
232:    * between them reads as an insect and as nothing else.
233:    */
234:   chitin: {
235:     shape: 'chitin',
236:     scale: 0.7,
237:     stride: 0.34,
238:     side: 0.22,
239:     feet: 4,
240:     reach: 0.45,
241:     press: 0.8,
242:     dragWidth: 0,
243:     drag: 0,
244:     spray: 0.25,
245:   },
246:   /**
247:    * Worms, larvae, hydras, the rolling Iron Wheel: no feet, so no prints -
248:    * one unbroken groove and nothing else in it.
249:    */
250:   slide: {
251:     shape: 'none',
252:     scale: 1,
253:     stride: 0.5,
254:     side: 0,
255:     feet: 2,
256:     reach: 0,
257:     press: 0,
258:     dragWidth: 1.1,
259:     drag: 0.85,
260:     spray: 0.5,
261:   },
262:   /**
263:    * Off the ground: flyers, hovering things, wraiths with no feet to speak
264:    * of. Leaves the snow exactly as it found it.
265:    */
266:   none: {
267:     shape: 'none',
268:     scale: 1,
269:     stride: 1,
270:     side: 0,
271:     feet: 2,
272:     reach: 0,
273:     press: 0,
274:     dragWidth: 0,
275:     drag: 0,
276:     spray: 0,
277:   },
278: } as const satisfies Record<string, TrackRecipe>;
279: 
280: export type TrackName = keyof typeof TRACKS;
281: 
282: /**
283:  * Monster model type → the track it leaves.
284:  *
285:  * Ordered by model index so it can be read side by side with
286:  * `MONSTER_MODEL_TABLE`. Anything absent takes `boot`.
287:  *
288:  * ### `none` and `slide` are earned, not guessed
289:  *
290:  * The first cut of this table was written from monster *names*, and the two
291:  * silent recipes are exactly where that fails invisibly: a wrong `boot` on a
292:  * hound is a visible mistake somebody can report, and a wrong `none` is a
293:  * creature that quietly leaves nothing, which reads as the feature being
294:  * broken. Devias' **Worm** was the one that proved it - MU's name is a
295:  * mistranslation and the model is a striped, fanged quadruped, so a row
296:  * written from the word "worm" turned the map's most common monster into a
297:  * thing that left no prints at all. Its **Iron Wheel** does not roll either:
298:  * it is in `SAND_SMOKE_MODELS` (impactVisuals.ts), the list of monsters the
299:  * original drops a sand puff under *as they walk*, which is the client's own
300:  * evidence that they are on their feet.
301:  *
302:  * So a row here only says `none` when something proves the thing is off the
303:  * ground - the client lifting it (`HoverHeight`), or a model that is plainly a
304:  * floating shroud - and only says `slide` for a body with no legs in it. When
305:  * in doubt it walks, because walking is the mistake that can be seen.
306:  */
307: const MODEL_TRACKS: Readonly<Record<number, TrackName>> = {
308:   0: 'cloven', // Bull Fighter
