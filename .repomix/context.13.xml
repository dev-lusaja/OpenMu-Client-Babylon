  1: import { monsterModelTypeOf } from '../common/playSpeed';
  2: 
  3: /**
  4:  * **Who leaves what.** Pure data shared by the ground effects - the shape a
  5:  * thing presses into settled snow, how far apart it puts its feet down, how
  6:  * hard it presses and how wide a channel its body ploughs.
  7:  *
  8:  * Read by `footprints.ts` (which bakes one sole atlas row per `TrackShape`)
  9:  * and by `ecs/systems/footprintSystem.ts` (which walks the world and lays
 10:  * them). Neither owns the table: a boot and a paw differ in a dozen small
 11:  * numbers, and those numbers belong in one place where they can be compared
 12:  * against each other rather than scattered across the two files that use
 13:  * them.
 14:  *
 15:  * ### The two halves
 16:  *
 17:  *  - **`TrackShape`** is what the print *looks like* - the silhouette baked
 18:  *    into the sole atlas. There are six, and adding one costs an atlas row
 19:  *    and a case in `shapeDepth`.
 20:  *  - **`TrackRecipe`** is how a particular creature *uses* one: its size, its
 21:  *    stride, how wide it stands, whether it puts down two feet or four, and
 22:  *    how much of a trench it drags between footfalls. Several recipes share a
 23:  *    shape - a yeti and a hound both leave a pad with toes, but one is a
 24:  *    barefoot biped and the other a quadruped at half the size.
 25:  *
 26:  * ### Keyed by model, not by monster
 27:  *
 28:  * `MODEL_TRACKS` is keyed by the **monster model type** (`MONSTER_MODEL_*`,
 29:  * `MODEL_MONSTER01 + type`), which `monsterModelTypeOf(npcType)` reads from
 30:  * `MONSTER_MODEL_TABLE` - the same key `deathVisuals.ts` uses for its
 31:  * shatters, and for the same reason: what a thing leaves behind is decided by
 32:  * the body it has, and a few hundred `npcType` rows share a few dozen bodies.
 33:  * Golden, elite and event variants of a monster therefore inherit its track
 34:  * for free.
 35:  *
 36:  * The table is a first pass over the models the shipped tables name; anything
 37:  * not listed falls back to `boot`, because most of MU's bestiary is bipedal
 38:  * and shod. Devias is the only map with settled snow on the ground today
 39:  * (`SNOW_GROUND_MAPS`), so its own residents are the rows that can be checked
 40:  * by looking at the screen; the rest are waiting for their map to get snow.
 41:  */
 42: 
 43: // ---- 1. tuning -------------------------------------------------------------
 44: 
 45: /**
 46:  * The silhouettes. One atlas row each in `footprints.ts`, so this list is
 47:  * short on purpose - six shapes that read differently at a glance beat twenty
 48:  * that all read as "some kind of mark".
 49:  *
 50:  * `none` draws nothing: it is what a flyer, a wraith and a slitherer share.
 51:  * The slitherer still ploughs its channel - see `dragWidth`.
 52:  */
 53: export type TrackShape =
 54:   | 'boot'
 55:   | 'paw'
 56:   | 'claw'
 57:   | 'hoof'
 58:   | 'chitin'
 59:   | 'pad'
 60:   | 'none';
 61: 
 62: /** Every shape that is actually drawn, in atlas-row order. */
 63: export const DRAWN_SHAPES = [
 64:   'boot',
 65:   'paw',
 66:   'claw',
 67:   'hoof',
 68:   'chitin',
 69:   'pad',
 70: ] as const satisfies readonly TrackShape[];
 71: 
 72: export interface TrackRecipe {
 73:   /** The silhouette pressed into the ground. `none` presses nothing. */
 74:   readonly shape: TrackShape;
 75:   /**
 76:    * Size of one print, × the tuned print in `FOOTPRINT_TUNING`.
 77:    *
 78:    * Uniform, deliberately: the relief march works in UV against a fixed
 79:    * reach, so a quad scaled up is a hollow that much deeper in world terms as
 80:    * well. One number therefore gets "bigger foot, deeper hole" without a
 81:    * second per-instance channel. The print's *proportions* come from its
 82:    * shape (`SHAPE_ASPECT` in footprints.ts), never from here.
 83:    */
 84:   readonly scale: number;
 85:   /** Tiles walked between footfalls. */
 86:   readonly stride: number;
 87:   /** Tiles from the centre line out to a print: half the stance. */
 88:   readonly side: number;
 89:   /** 2 lays one print a footfall; 4 lays a hind and a fore on the same side. */
 90:   readonly feet: 2 | 4;
 91:   /** Tiles from the hind print to the fore one. `feet: 4` only. */
 92:   readonly reach: number;
 93:   /**
 94:    * How hard it presses, × the strength the snow itself allows.
 95:    *
 96:    * Well under 1 for anything that also ploughs a channel: the trench is what
 97:    * carries the depth there and the prints are only pockets in its floor (see
 98:    * `GAIT` in footprintSystem.ts). High for the light-footed, whose marks are
 99:    * separate punctures with untouched snow between them.
100:    */
101:   readonly press: number;
102:   /** Width of the channel the body ploughs, in tiles. 0 ploughs none. */
103:   readonly dragWidth: number;
104:   /** How deeply that channel cuts, × the print's own strength. */
105:   readonly drag: number;
106:   /** Snow thrown at each footfall, × the hero's. */
107:   readonly spray: number;
108: }
109: 
110: /**
111:  * The recipes. `boot` is the hero's and the default, and its numbers are the
112:  * ones the whole look was tuned against - the gait multipliers in
113:  * `footprintSystem.ts` are relative to it, so changing `boot` moves every
114:  * character in the game.
