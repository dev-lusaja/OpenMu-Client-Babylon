30: /** Quoted `<folder>/<name>.glb` literals in the client. */
31: function glbLiteralsInSource(): string[] {
32:   const found = new Set<string>();
33:   for (const file of filesUnder(SRC)) {
34:     if (!/\.tsx?$/.test(file)) continue;
35:     const text = readFileSync(join(SRC, file), 'utf8');
36:     for (const [, path] of text.matchAll(
