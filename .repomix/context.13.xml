642:   const file = REFERENCE_CANDIDATES.find(p => existsSync(p));
643:   if (!file) {
644:     console.error(
645:       'reference image not found. Put it at references/screenshots/todo/instruments_reference.png ' +
646:         '(beside the repo) or set INSTRUMENT_REFERENCE=<path>.'
647:     );
648:     process.exit(1);
649:   }
