<file path="tools/localPacks.ts">
  1: // Builds `Data/Local/<Folder>/` language packs from the name tables in
  2: // `tools/packs/<code>.json`.
  3: //
  4: // Webzen shipped one pack per language and this tree only has `Eng`, `Spn` and
  5: // `Por`. The other ten languages the client offers have no pack, so their item
  6: // and monster names fall back to English. This writes packs for them in the
  7: // original's own format, which means two things: the readers
  8: // (`src/libs/mu/itemNameFile.ts`, `npcNameFile.ts`, `moveReqFile.ts`) need no
  9: // special case, and a real Webzen pack can be dropped in later to replace ours
 10: // byte for byte with no code change.
 11: //
 12: // Only the names are written. Every other field is copied from the English
 13: // file, so an item keeps its slot, its stats and its requirements exactly.
 14: //
 15: // Run it with **node**, not bun: the single-byte code pages the Latin,
 16: // Cyrillic and Thai packs are written in (windows-1250 / 1251 / 874) need a
 17: // full-ICU `TextDecoder`, which node has and bun does not. Browsers have them
 18: // all, so only this build step is affected.
 19: //
 20: // Usage:
 21: //   node tools/localPacks.ts            build every pack in tools/packs/
 22: //   node tools/localPacks.ts --check    build in memory and report only
 23: //   node tools/localPacks.ts --only ger
 24: 
 25: import { readFileSync, writeFileSync, mkdirSync, readdirSync, existsSync } from 'fs';
 26: import { join, resolve, dirname } from 'path';
 27: import { fileURLToPath } from 'url';
 28: 
 29: const HERE = dirname(fileURLToPath(import.meta.url));
 30: const ROOT = resolve(HERE, '..');
 31: export const PACKS_DIR = join(HERE, 'packs');
 32: const LOCAL = join(ROOT, 'Data', 'Local');
 33: const ENG = join(LOCAL, 'Eng');
 34: 
 35: // ---- the original's two primitives -----------------------------------------
 36: 
 37: const BUX = [0xfc, 0xcf, 0xab];
 38: 
 39: /** `BuxConvert` - the 3-byte XOR, applied to one record at a time. */
 40: function bux(buffer: Uint8Array): void {
 41:   for (let i = 0; i < buffer.length; i++) buffer[i] ^= BUX[i % 3];
 42: }
 43: 
 44: /**
 45:  * `GenerateCheckSum2` (ZzzInfomation.h:102), over the *encrypted* body, which
 46:  * is the order the original reads a file in. Our readers do not verify it; it
 47:  * is written so the file is a drop-in for the original client too.
 48:  */
 49: export function checksum2(buffer: Uint8Array, key: number): number {
 50:   const view = new DataView(buffer.buffer, buffer.byteOffset, buffer.byteLength);
 51:   let result = (key << 9) >>> 0;
 52: 
 53:   for (let at = 0; at + 4 <= buffer.length; at += 4) {
 54:     const word = view.getUint32(at, true);
 55:     if ((at / 4 + key) % 2 === 0) result = (result ^ word) >>> 0;
 56:     else result = (result + word) >>> 0;
 57:     if (at % 16 === 0) result = (result ^ (((key + result) >>> 0) >>> ((at / 4) % 8 + 1))) >>> 0;
 58:   }
 59: 
 60:   return result >>> 0;
 61: }
 62: 
 63: // ---- code pages ------------------------------------------------------------
 64: 
 65: /**
 66:  * An encoder for one of the single-byte pages the packs are authored in.
 67:  * Node ships decoders only, so the table is built by decoding every byte once
 68:  * and inverting it - exact by construction, and the same mapping
 69:  * `decodeLocalText` reads the file back with.
 70:  *
 71:  * CJK packs are written UTF-8 instead (their layer declares no `encoding`):
 72:  * the multi-byte legacy pages have no encoder here, and a 30-byte name field
 73:  * holds ten CJK characters, which every name in those packs fits inside.
 74:  */
 75: export function encoderFor(label: string): (text: string) => Uint8Array {
 76:   if (/^utf-?8$/i.test(label)) {
 77:     const utf8 = new TextEncoder();
 78:     return text => utf8.encode(text);
 79:   }
 80: 
 81:   const decoder = new TextDecoder(label);
 82:   const toByte = new Map<string, number>();
 83:   const one = new Uint8Array(1);
 84: 
 85:   for (let byte = 0; byte < 256; byte++) {
 86:     one[0] = byte;
 87:     const char = decoder.decode(one);
 88:     if (char.length === 1 && !toByte.has(char)) toByte.set(char, byte);
 89:   }
 90: 
 91:   return text => {
 92:     const out = new Uint8Array(text.length);
 93:     for (let i = 0; i < text.length; i++) {
 94:       const byte = toByte.get(text[i]);
 95:       if (byte === undefined) {
 96:         throw new Error(`"${text}" has ${JSON.stringify(text[i])}, which ${label} cannot hold`);
 97:       }
 98:       out[i] = byte;
 99:     }
100:     return out;
101:   };
102: }
103: 
104: // ---- the source tables -----------------------------------------------------
105: 
106: export type PackSource = {
107:   /** Folder under `Data/Local/`, as the layer spells it (`Ger`). */
108:   folder: string;
109:   /** The tag in the file names, lower case (`ger`). */
110:   suffix: string;
111:   /** WHATWG label the names are written in; the layer must declare the same. */
112:   encoding: string;
113:   /** `"<group>/<index>"` -> item name. Missing entries keep the English one. */
114:   items: Record<string, string>;
115:   /** Monster / NPC type number -> name. */
116:   npcs: Record<string, string>;
117:   /** `MoveReq` row index -> the name shown in the warp window. */
118:   maps?: Record<string, string>;
119: };
120: 
121: const ITEM_RECORD = 84;
122: const ITEM_NAME = 30;
123: const ITEM_COUNT = 8192;
124: const ITEM_KEY = 0xe2f1;
125: const GROUP_STRIDE = 512;
126: 
127: const MOVE_RECORD = 84;
128: const MOVE_NAME = 32;
129: const MOVE_HEADER = 4;
130: 
131: /**
132:  * The name, NUL-padded inside its field. The whole field may be used with no
133:  * terminator - three of the English item names do exactly that - because the
134:  * readers stop at a NUL *or* at the end of the field (`decodeLocalText`), as
135:  * the original does.
136:  */
137: function putName(
138:   record: Uint8Array,
139:   offset: number,
140:   length: number,
141:   text: string,
142:   encode: (t: string) => Uint8Array,
143:   where: string,
144:   problems: string[]
145: ): void {
146:   const bytes = encode(text);
147:   if (bytes.length > length) {
148:     problems.push(`${where}: "${text}" is ${bytes.length} bytes, ${length} allowed`);
149:     return;
150:   }
151:   record.fill(0, offset, offset + length);
152:   record.set(bytes, offset);
153: }
154: 
155: export function buildItemPack(source: PackSource, problems: string[]): Uint8Array {
156:   const out = Uint8Array.from(readFileSync(join(ENG, 'item_eng.bmd')));
157:   const encode = encoderFor(source.encoding);
158: 
159:   for (const [key, name] of Object.entries(source.items)) {
160:     const [group, index] = key.split('/').map(Number);
161:     const record = group * GROUP_STRIDE + index;
162:     if (!Number.isInteger(group) || !Number.isInteger(index) || record < 0 || record >= ITEM_COUNT) {
163:       problems.push(`${source.folder}: item "${key}" is not a slot in the table`);
164:       continue;
165:     }
166: 
167:     const at = record * ITEM_RECORD;
168:     const bytes = out.subarray(at, at + ITEM_RECORD);
169:     bux(bytes);
170:     putName(bytes, 0, ITEM_NAME, name, encode, `${source.folder} item ${key}`, problems);
171:     bux(bytes);
172:   }
173: 
174:   const body = ITEM_COUNT * ITEM_RECORD;
175:   new DataView(out.buffer, out.byteOffset, out.byteLength)
176:     .setUint32(body, checksum2(out.subarray(0, body), ITEM_KEY), true);
177:   return out;
178: }
179: 
180: export function buildMovePack(source: PackSource, problems: string[]): Uint8Array | null {
181:   if (!source.maps) return null;
182: 
183:   const out = Uint8Array.from(readFileSync(join(ENG, 'MoveReq_eng.bmd')));
184:   const encode = encoderFor(source.encoding);
185:   const count = new DataView(out.buffer, out.byteOffset, out.byteLength).getInt32(0, true);
186: 
187:   for (const [key, name] of Object.entries(source.maps)) {
188:     const row = Number(key);
189:     if (!Number.isInteger(row) || row < 0 || row >= count) {
190:       problems.push(`${source.folder}: warp row "${key}" is not one of the ${count} rows`);
191:       continue;
192:     }
193: 
194:     const at = MOVE_HEADER + row * MOVE_RECORD;
195:     const bytes = out.subarray(at, at + MOVE_RECORD);
196:     bux(bytes);
197:     // `szMainMapName` sits after the `int index`. `szSubMapName` behind it is
198:     // the `/move` alias and stays English, because that is what the server
199:     // parses.
200:     putName(bytes, 4, MOVE_NAME, name, encode, `${source.folder} warp row ${key}`, problems);
201:     bux(bytes);
202:   }
203: 
204:   return out;
205: }
206: 
207: /** `id\tflag\t"Name"\t`, CRLF, with the English file's own flags. */
208: export function buildNpcNames(source: PackSource, problems: string[]): string {
209:   const english = readFileSync(join(ENG, 'NpcName_Eng.txt'), 'latin1');
210:   const encode = encoderFor(source.encoding);
211:   const lines: string[] = ['// MAX : 512\t\t\t'];
212: 
213:   for (const line of english.split(/\r?\n/)) {
214:     const hit = /^\s*(\d+)\s+(\d+)\s+"([^"]*)"/.exec(line);
215:     if (!hit) continue;
216: 
217:     const [, id, flag, englishName] = hit;
218:     const name = source.npcs[id] ?? englishName;
219:     try {
220:       encode(name);
221:     } catch (err) {
222:       problems.push(`${source.folder} npc ${id}: ${(err as Error).message}`);
223:       continue;
224:     }
225:     lines.push(`${id}\t${flag}\t"${name}"\t`);
226:   }
227: 
228:   return lines.join('\r\n') + '\r\n';
229: }
230: 
231: // ---- driving ---------------------------------------------------------------
232: 
233: function build(file: string, check: boolean): void {
234:   const source = JSON.parse(readFileSync(join(PACKS_DIR, file), 'utf8')) as PackSource;
235:   const problems: string[] = [];
236: 
237:   const items = buildItemPack(source, problems);
238:   const maps = buildMovePack(source, problems);
239:   const npcs = buildNpcNames(source, problems);
240: 
241:   const wrote: string[] = [];
242: 
243:   if (!check) {
244:     const dir = join(LOCAL, source.folder);
245:     mkdirSync(dir, { recursive: true });
246: 
247:     writeFileSync(join(dir, `item_${source.suffix}.bmd`), items);
248:     wrote.push(`item_${source.suffix}.bmd`);
249: 
250:     if (maps) {
251:       writeFileSync(join(dir, `MoveReq_${source.suffix}.bmd`), maps);
252:       wrote.push(`MoveReq_${source.suffix}.bmd`);
253:     }
254: 
255:     // The folder is capitalised in this one's file name, as the original has it.
256:     writeFileSync(
257:       join(dir, `NpcName_${source.folder}.txt`),
258:       encoderFor(source.encoding)(npcs)
259:     );
260:     wrote.push(`NpcName_${source.folder}.txt`);
261:   }
262: 
263:   const counts =
264:     `${Object.keys(source.items).length} items, ` +
265:     `${Object.keys(source.npcs).length} npcs, ` +
266:     `${Object.keys(source.maps ?? {}).length} warp rows`;
267: 
268:   console.log(`${source.folder.padEnd(4)} ${counts}${wrote.length ? ` -> ${wrote.join(', ')}` : ''}`);
269:   for (const problem of problems) console.log(`  ! ${problem}`);
270:   if (problems.length) process.exitCode = 1;
271: }
272: 
273: /** Only when run as a script; the builders above are imported by the test. */
274: if (process.argv[1] && fileURLToPath(import.meta.url) === resolve(process.argv[1])) {
275:   const check = process.argv.includes('--check');
276:   const onlyAt = process.argv.indexOf('--only');
277:   const only = onlyAt > 0 ? process.argv[onlyAt + 1] : null;
278: 
279:   if (!existsSync(PACKS_DIR)) {
280:     console.log(`no sources in ${PACKS_DIR}`);
281:   } else {
282:     for (const file of readdirSync(PACKS_DIR).filter(f => f.endsWith('.json')).sort()) {
283:       if (only && file !== `${only}.json`) continue;
284:       build(file, check);
285:     }
286:   }
287: }
</file>

<file path="tools/mapBanners.ps1">
  1: # Draws the map-name lettering with GDI+, which gets Uniscribe shaping for
  2: # Thai and the CJK faces for free. Reads a jobs JSON, writes raw BGRA so node
  3: # can composite it straight onto the ornament without a PNG decoder.
  4: param([string]$JobsPath)
  5: 
  6: Add-Type -AssemblyName System.Drawing
  7: 
  8: $jobs = Get-Content -LiteralPath $JobsPath -Raw -Encoding UTF8 | ConvertFrom-Json
  9: 
 10: foreach ($job in $jobs) {
 11:   $w = [int]$job.width
 12:   $h = [int]$job.height
 13:   $bmp = New-Object System.Drawing.Bitmap($w, $h, [System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
 14:   $g = [System.Drawing.Graphics]::FromImage($bmp)
 15:   $g.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
 16:   $g.TextRenderingHint = [System.Drawing.Text.TextRenderingHint]::AntiAlias
 17:   $g.Clear([System.Drawing.Color]::FromArgb(0, 0, 0, 0))
 18: 
 19:   $family = New-Object System.Drawing.FontFamily($job.font)
 20:   $style = [System.Drawing.FontStyle]$job.style
 21: 
 22:   # GetBounds measures the glyph outlines only. What actually lands on the
 23:   # plate is wider: half the rim on each side, and the shadow past the bottom
 24:   # right. Fit the inked box, not the path, or a long name touches the plate
 25:   # edge and a tall one runs into the flourish below.
 26:   $stroke = [float]$job.stroke
 27:   $shadowBy = 1.5
 28:   $padX = ($stroke / 2) + $shadowBy + 1
 29:   $padY = ($stroke / 2) + $shadowBy + 1
 30: 
 31:   $size = [float]$job.size
 32:   $maxW = $w - (2 * $padX)
 33:   $maxH = $h - (2 * $padY)
 34:   $path = $null
 35:   while ($size -gt 6) {
 36:     $try = New-Object System.Drawing.Drawing2D.GraphicsPath
 37:     $fmt = New-Object System.Drawing.StringFormat
 38:     $fmt.Alignment = [System.Drawing.StringAlignment]::Center
 39:     $try.AddString($job.text, $family, [int]$style, $size, (New-Object System.Drawing.PointF(($w / 2), 0)), $fmt)
 40:     $b = $try.GetBounds()
 41:     if ($b.Width -le $maxW -and $b.Height -le $maxH) { $path = $try; break }
 42:     $try.Dispose()
 43:     $size = $size - 0.5
 44:   }
 45:   if ($null -eq $path) { Write-Error "no fit: $($job.text)"; continue }
 46: 
 47:   # Centre what was actually drawn, then lift it by the shadow so the ink sits
 48:   # centred rather than the outlines.
 49:   $b = $path.GetBounds()
 50:   $shift = New-Object System.Drawing.Drawing2D.Matrix
 51:   $shift.Translate(
 52:     ($w / 2) - ($b.X + $b.Width / 2) - ($shadowBy / 2),
 53:     (($h - $b.Height) / 2) - $b.Y - ($shadowBy / 2))
 54:   $path.Transform($shift)
 55:   $b = $path.GetBounds()
 56: 
 57:   # The original is a silver bevel: bright top, grey waist, bright again. The
 58:   # battle-zone strip is the one plate lettered in rose instead.
 59:   $rect = New-Object System.Drawing.RectangleF($b.X, $b.Y, [Math]::Max($b.Width, 1), [Math]::Max($b.Height, 1))
 60:   $brush = New-Object System.Drawing.Drawing2D.LinearGradientBrush(
 61:     $rect,
 62:     [System.Drawing.Color]::White,
 63:     [System.Drawing.Color]::Gray,
 64:     [System.Drawing.Drawing2D.LinearGradientMode]::Vertical)
 65:   $blend = New-Object System.Drawing.Drawing2D.ColorBlend(4)
 66:   if ($job.palette -eq 'rose') {
 67:     $blend.Colors = @(
 68:       [System.Drawing.Color]::FromArgb(255, 252, 226, 228),
 69:       [System.Drawing.Color]::FromArgb(255, 244, 186, 192),
 70:       [System.Drawing.Color]::FromArgb(255, 196, 104, 116),
 71:       [System.Drawing.Color]::FromArgb(255, 232, 160, 170))
 72:   } else {
 73:     $blend.Colors = @(
 74:       [System.Drawing.Color]::FromArgb(255, 253, 253, 252),
 75:       [System.Drawing.Color]::FromArgb(255, 248, 247, 243),
 76:       [System.Drawing.Color]::FromArgb(255, 150, 148, 142),
 77:       [System.Drawing.Color]::FromArgb(255, 226, 224, 216))
 78:   }
 79:   $blend.Positions = @(0.0, 0.42, 0.72, 1.0)
 80:   $brush.InterpolationColors = $blend
 81: 
 82:   # Drop shadow first, then the black rim, then the fill.
 83:   $shadow = New-Object System.Drawing.Drawing2D.Matrix
 84:   $shadow.Translate(1.5, 1.5)
 85:   $ghost = $path.Clone()
 86:   $ghost.Transform($shadow)
 87:   $shadowBrush = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(150, 0, 0, 0))
 88:   $g.FillPath($shadowBrush, $ghost)
 89: 
 90:   $pen = New-Object System.Drawing.Pen([System.Drawing.Color]::FromArgb(255, 0, 0, 0), [float]$job.stroke)
 91:   $pen.LineJoin = [System.Drawing.Drawing2D.LineJoin]::Round
 92:   $g.DrawPath($pen, $path)
 93:   $g.FillPath($brush, $path)
 94: 
 95:   # Raw BGRA, top-down, for node.
 96:   $data = $bmp.LockBits(
 97:     (New-Object System.Drawing.Rectangle(0, 0, $w, $h)),
 98:     [System.Drawing.Imaging.ImageLockMode]::ReadOnly,
 99:     [System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
100:   $bytes = New-Object byte[] ($data.Stride * $h)
101:   [System.Runtime.InteropServices.Marshal]::Copy($data.Scan0, $bytes, 0, $bytes.Length)
102:   $bmp.UnlockBits($data)
103:   [System.IO.File]::WriteAllBytes($job.out, $bytes)
104: 
105:   $g.Dispose(); $bmp.Dispose(); $path.Dispose(); $ghost.Dispose()
106:   Write-Output "$($job.out) $($job.text) @ $size"
107: }
</file>

<file path="tools/mapBanners.ts">
  1: /**
  2:  * Writes `Data/Local/<pack>/ImgsMapName/*.OZT` for the generated language
  3:  * packs: the map name plate that fades in when you enter a map.
  4:  *
  5:  * Webzen drew the name into the bitmap rather than drawing it at runtime, and
  6:  * shipped one set per language, so translating a plate means redrawing it.
  7:  * Their own Spanish set says how: the descriptive names are translated
  8:  * (Blood Castle -> Castillo Sangriento) and the proper nouns are kept
  9:  * (Lorencia, Devias, Atlans), in a different face from the English set. The
 10:  * wording lives in `packs/banners.json`; this only draws it.
 11:  *
 12:  * The flourish under the name is decoration, not language, so it is kept: one
 13:  * clean band lifted from the English Lorencia plate and laid under every name
 14:  * (see `ornament` for why one band rather than each plate's own).
 15:  *
 16:  * ## Running it
 17:  *
 18:  * ```
 19:  * node tools/mapBanners.ts            # every language
 20:  * node tools/mapBanners.ts --only rus
 21:  * ```
 22:  *
 23:  * **Windows only, and node rather than bun** (the pack tool's constraint too).
 24:  * The lettering is rasterised by GDI+ through `mapBanners.ps1`, which is what
 25:  * gets the Thai mark positioning and the CJK faces right without shipping a
 26:  * shaping engine. The output is committed, so this is a tool you run when the
 27:  * wording changes, not part of the build.
 28:  *
 29:  * An OZT is a 4-byte header in front of an uncompressed 32-bit bottom-up TGA:
 30:  * `sprites.ts` reads them with `OZT_HEADER_SIZE` and the same assumption.
 31:  */
 32: 
 33: import { execFileSync } from 'child_process';
 34: import { existsSync, mkdirSync, readFileSync, writeFileSync, rmSync } from 'fs';
 35: import { dirname, resolve } from 'path';
 36: import { fileURLToPath } from 'url';
 37: import { tmpdir } from 'os';
 38: 
 39: const HERE = dirname(fileURLToPath(import.meta.url));
 40: const DATA = resolve(HERE, '..', 'Data', 'Local');
 41: const ENGLISH = resolve(DATA, 'Eng', 'ImgsMapName');
 42: 
 43: const OZT_HEADER = 4;
 44: const TGA_HEADER = 18;
 45: const TGA_FOOTER = 26;
 46: 
 47: /** Rows 0..TEXT_H-1 hold the name; the ornament owns the rest. */
 48: const TEXT_H = 45;
 49: 
 50: type Image = { w: number; h: number; rgba: Uint8Array };
 51: 
 52: /**
 53:  * Which face draws which language. `size` is the size a name is drawn at when
 54:  * it fits, and a ceiling when it does not: the rasteriser steps down from here
 55:  * until the word is inside the plate. Set it so a typical name lands near the
 56:  * 35-pixel cap height of the English plates and a long one shrinks - the same
 57:  * thing the original does, where short names are narrow and long names fill
 58:  * the width.
 59:  */
 60: type Face = { font: string; style: number; size: number };
 61: 
 62: const FACES: Record<string, Face> = {
 63:   // A slanted serif for the alphabets the original used one for. Palatino
 64:   // covers Cyrillic in the same face, so Russian and Bulgarian sit beside
 65:   // German without a visible change of voice.
 66:   ger: { font: 'Palatino Linotype', style: 3, size: 35 },
 67:   fre: { font: 'Palatino Linotype', style: 3, size: 35 },
 68:   ita: { font: 'Palatino Linotype', style: 3, size: 35 },
 69:   rom: { font: 'Palatino Linotype', style: 3, size: 35 },
 70:   rus: { font: 'Palatino Linotype', style: 3, size: 35 },
 71:   bul: { font: 'Palatino Linotype', style: 3, size: 35 },
 72:   // No italic serif reaches these scripts, so each takes the most book-like
 73:   // face Windows ships for it and stays upright. Slanting a CJK face
 74:   // synthetically only smears it.
 75:   chi: { font: 'SimSun', style: 1, size: 34 },
 76:   jpn: { font: 'Yu Gothic', style: 1, size: 32 },
 77:   kor: { font: 'Malgun Gothic', style: 1, size: 32 },
 78:   tha: { font: 'Leelawadee UI', style: 1, size: 30 },
 79: };
 80: 
 81: /** The folder each suffix writes into, spelled as on disk. */
 82: const FOLDERS: Record<string, string> = {
 83:   ger: 'Ger', fre: 'Fre', ita: 'Ita', rom: 'Rom', rus: 'Rus',
 84:   bul: 'Bul', chi: 'Chi', jpn: 'Jpn', kor: 'Kor', tha: 'Tha',
 85: };
 86: 
 87: export function readOzt(path: string): Image {
 88:   const t = new Uint8Array(readFileSync(path)).subarray(OZT_HEADER);
 89:   const head = new DataView(t.buffer, t.byteOffset, TGA_HEADER);
 90:   const w = head.getUint16(12, true);
 91:   const h = head.getUint16(14, true);
 92:   const src = t.subarray(TGA_HEADER, TGA_HEADER + w * h * 4);
 93:   const rgba = new Uint8Array(w * h * 4);
 94: 
 95:   for (let y = 0; y < h; y++) {
 96:     for (let x = 0; x < w; x++) {
 97:       const s = ((h - 1 - y) * w + x) * 4;     // TGA rows run bottom-up
 98:       const d = (y * w + x) * 4;
 99:       rgba[d] = src[s + 2];
100:       rgba[d + 1] = src[s + 1];
101:       rgba[d + 2] = src[s];
102:       rgba[d + 3] = src[s + 3];
103:     }
104:   }
105: 
106:   return { w, h, rgba };
107: }
108: 
109: export function writeOzt(path: string, { w, h, rgba }: Image): void {
110:   const out = new Uint8Array(OZT_HEADER + TGA_HEADER + w * h * 4 + TGA_FOOTER);
111:   const t = out.subarray(OZT_HEADER);
112:   const head = new DataView(t.buffer, t.byteOffset, TGA_HEADER);
113: 
114:   t[2] = 2;                                     // uncompressed true-colour
115:   head.setUint16(12, w, true);
116:   head.setUint16(14, h, true);
117:   t[16] = 32;
118:   t[17] = 8;                                    // 8 alpha bits, origin bottom-left
119: 
120:   for (let y = 0; y < h; y++) {
121:     for (let x = 0; x < w; x++) {
122:       const s = (y * w + x) * 4;
123:       const d = TGA_HEADER + ((h - 1 - y) * w + x) * 4;
124:       t[d] = rgba[s + 2];
125:       t[d + 1] = rgba[s + 1];
126:       t[d + 2] = rgba[s];
127:       t[d + 3] = rgba[s + 3];
128:     }
129:   }
130: 
131:   // The v2 footer, which is what marks the alpha as meant rather than padding.
132:   const footer = 'TRUEVISION-XFILE.';
133:   const at = TGA_HEADER + w * h * 4 + 8;
134:   for (let i = 0; i < footer.length; i++) t[at + i] = footer.charCodeAt(i);
135: 
136:   writeFileSync(path, out);
137: }
138: 
139: /**
140:  * The flourish under the name, taken once from the Lorencia plate.
141:  *
142:  * Every plate carries the same drawing, but not the same pixels: a descender
143:  * from a long name reaches down into those rows, and the whole block sits a
144:  * little higher or lower from plate to plate. Cutting each one's own band
145:  * would therefore copy its old lettering's tail under the new name. One clean
146:  * band, from a plate whose text stops well clear of it, avoids that and makes
147:  * the generated set more consistent than the original.
148:  */
149: function ornament(): Uint8Array {
150:   const src = readOzt(resolve(ENGLISH, 'lorencia.OZT'));
151:   return src.rgba.subarray(TEXT_H * src.w * 4);
152: }
153: 
154: /** A plate of `height` rows: the rasterised name, and the flourish under it. */
155: function plate(width: number, height: number, raw: Uint8Array): Image {
156:   const rgba = new Uint8Array(width * height * 4);
157: 
158:   const rows = Math.min(TEXT_H, height);
159:   for (let i = 0; i < rows * width; i++) {
160:     rgba[i * 4] = raw[i * 4 + 2];               // the rasteriser hands back BGRA
161:     rgba[i * 4 + 1] = raw[i * 4 + 1];
162:     rgba[i * 4 + 2] = raw[i * 4];
163:     rgba[i * 4 + 3] = raw[i * 4 + 3];
164:   }
165: 
166:   // The short strip (`MapNameAddStrife`, the battle-zone label) is lettering
167:   // only - there is no room for a flourish and the original draws none.
168:   if (height > TEXT_H) rgba.set(ornament(), TEXT_H * width * 4);
169: 
170:   return { w: width, h: height, rgba };
171: }
172: 
173: type Job = {
174:   text: string;
175:   font: string;
176:   style: number;
177:   size: number;
178:   stroke: number;
179:   palette: string;
180:   width: number;
181:   height: number;
182:   out: string;
183: };
184: 
185: /**
186:  * The battle-zone label is the one plate the original draws differently: a
187:  * 166x28 strip with no flourish, lettered in rose rather than silver.
188:  */
189: const ROSE = 'MapNameAddStrife.OZT';
190: 
191: export function buildBanners(only: string | null): void {
192:   const banners = JSON.parse(
193:     readFileSync(resolve(HERE, 'packs', 'banners.json'), 'utf8')
194:   ) as Record<string, Record<string, string>>;
195: 
196:   const files = Object.keys(banners).filter(k => k !== '_');
197:   const langs = Object.keys(FACES).filter(l => !only || l === only);
198:   if (only && !langs.length) throw new Error(`No face for '${only}'`);
199: 
200:   // One scratch folder for the whole run: the rasteriser hands back raw BGRA
201:   // rather than an image, so there is no decoder on this side.
202:   const scratch = resolve(tmpdir(), `mu-banners-${process.pid}`);
203:   mkdirSync(scratch, { recursive: true });
204: 
205:   try {
206:     for (const lang of langs) {
207:       const folder = FOLDERS[lang];
208:       const outDir = resolve(DATA, folder, 'ImgsMapName');
209:       mkdirSync(outDir, { recursive: true });
210: 
211:       const face = FACES[lang];
212:       const jobs: Job[] = [];
213:       const plates: { file: string; raw: string; w: number; h: number }[] = [];
214: 
215:       for (const file of files) {
216:         const text = banners[file][lang];
217:         // No entry means the English plate is right as it stands; the reader
218:         // falls back to it per file.
219:         if (!text) continue;
220: 
221:         const raw = resolve(scratch, `${lang}-${file}.raw`);
222:         const { w, h } = readOzt(resolve(ENGLISH, file));
223:         jobs.push({
224:           text,
225:           ...face,
226:           stroke: 2.4,
227:           palette: file === ROSE ? 'rose' : 'silver',
228:           width: w,
229:           height: Math.min(TEXT_H, h),
230:           out: raw,
231:         });
232:         plates.push({ file, raw, w, h });
233:       }
234: 
235:       const jobsPath = resolve(scratch, `${lang}.json`);
236:       writeFileSync(jobsPath, JSON.stringify(jobs), 'utf8');
237:       execFileSync(
238:         'powershell.exe',
239:         ['-NoProfile', '-ExecutionPolicy', 'Bypass', '-File',
240:           resolve(HERE, 'mapBanners.ps1'), jobsPath],
241:         { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }
242:       );
243: 
244:       for (const { file, raw, w, h } of plates) {
245:         if (!existsSync(raw)) throw new Error(`${lang}: ${file} did not rasterise`);
246:         writeOzt(resolve(outDir, file), plate(w, h, new Uint8Array(readFileSync(raw))));
247:       }
248: 
249:       console.log(`${folder}  ${plates.length} plates -> Local/${folder}/ImgsMapName`);
250:     }
251:   } finally {
252:     rmSync(scratch, { recursive: true, force: true });
253:   }
254: }
255: 
256: if (process.argv[1] && fileURLToPath(import.meta.url) === resolve(process.argv[1])) {
257:   const at = process.argv.indexOf('--only');
258:   buildBanners(at > 0 ? process.argv[at + 1] : null);
259: }
</file>

