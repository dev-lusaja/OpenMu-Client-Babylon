 1: /**
 2:  * Season 6 Episode 3 - the version this client was written against and the
 3:  * OpenMU default (`-version:season6`, `Persistence/Initialization/VersionSeasonSix`).
 4:  * Everything the base game did before the version seam existed lives here.
 5:  */
 6: import { asciiBytes, type GameVersion } from '../../src/version/contract';
 7: import { season6Data } from './data';
 8: 
 9: // The packet lists ride along in the version chunk; UI does not (it reaches
10: // app code and loads through the registry's loadUi, after this module).
11: export * as packets from './packets';
12: 
13: /** OpenMU `SimpleModulusEncryptor.DefaultClientKey` / `SimpleModulusDecryptor.DefaultClientKey`. */
14: const CLIENT_TO_SERVER_KEYS = [128079, 164742, 70235, 106898, 23489, 11911, 19816, 13647, 48413, 46165, 15171, 37433];
15: const SERVER_TO_CLIENT_KEYS = [73326, 109989, 98843, 171058, 18035, 30340, 24701, 11141, 62004, 64409, 35374, 64599];
16: 
17: /** OpenMU `Network/Xor/DefaultKeys.Xor32Key` (Season 6 GMO key). */
18: const XOR32_KEY = new Uint8Array([
19:   0xab, 0x11, 0xcd, 0xfe, 0x18, 0x23, 0xc5, 0xa3, 0xca, 0x33, 0xc1, 0xcc, 0x66, 0x67, 0x21, 0xf3,
20:   0x32, 0x12, 0x15, 0x35, 0x29, 0xff, 0xfe, 0x1d, 0x44, 0xef, 0xcd, 0x41, 0x26, 0x3c, 0x4e, 0x4d,
21: ]);
22: const XOR3_KEY = new Uint8Array([0xfc, 0xcf, 0xab]);
23: 
24: /**
25:  * Packets that share a code with no sub-code: prefer the classic S6 layout over
26:  * the `…075` / `…095` / `…097` and the `…Extended` (open-source client >= 106.3)
27:  * variants. The `097` case only makes explicit what the generated order was
28:  * already doing (`CharacterInformation` is emitted before its variants).
29:  */
30: function variantRank(name: string): number {
31:   if (/Extended$/.test(name)) return 2;
32:   if (/0(75|95|97)$/.test(name)) return 1;
33:   return 0;
34: }
35: 
36: export const gameVersion: GameVersion = {
37:   id: 'season6',
38:   label: 'Season 6 Episode 3',
39:   listTag: 'S6EP3',
40:   openMu: { season: 6, episode: 3, initializer: 'VersionSeasonSix', versionArg: 'season6' },
41:   clientVersionBytes: asciiBytes('10404'),
42:   serialBytes: asciiBytes('k1Pk2jcET48mxL3b'),
43:   protocol: {
44:     packetSet: 'season6',
45:     variantRank,
46:     encryption: {
47:       clientToServer: CLIENT_TO_SERVER_KEYS,
48:       serverToClient: SERVER_TO_CLIENT_KEYS,
49:       xor32Key: XOR32_KEY,
50:       xor3Key: XOR3_KEY,
51:     },
52:   },
53:   data: season6Data,
54:   features: {
55:     masterSkills: true,
56:     socketItems: true,
57:     ancientItems: true,
58:     harmonyJewel: true,
59:     darkLord: true,
60:     magicGladiator: true,
61:     summoner: true,
62:     rageFighter: true,
63:     muHelper: true,
