 1: import { describe, expect, it } from 'vitest';
 2: import { ChangeMapServerInfoPacket } from './mapServerMove';
 3: 
 4: function buildPacket(): DataView {
 5:   const bytes = new Uint8Array(40);
 6:   bytes[0] = 0xc1;
 7:   bytes[1] = 40;
 8:   bytes[2] = 0xb1;
 9:   bytes[3] = 0x00;
10:   const ip = '192.168.0.7';
11:   for (let i = 0; i < ip.length; i++) bytes[4 + i] = ip.charCodeAt(i);
12:   const view = new DataView(bytes.buffer);
13:   view.setUint16(20, 55902, true);
14:   view.setUint16(22, 3, true);
15:   view.setUint32(24, 0x11223344, true);
16:   view.setUint32(28, 0x55667788, true);
17:   view.setUint32(32, 0x99aabbcc, true);
18:   view.setUint32(36, 0xddeeff00, true);
19:   return view;
20: }
21: 
22: describe('ChangeMapServerInfoPacket', () => {
23:   it('parses the original C1 B1 00 layout', () => {
24:     const p = new ChangeMapServerInfoPacket(buildPacket());
25:     expect(p.IpAddress).toBe('192.168.0.7');
26:     expect(p.Port).toBe(55902);
27:     expect(p.ServerCode).toBe(3);
28:     expect(p.AuthCode1).toBe(0x11223344);
29:     expect(p.AuthCode2).toBe(0x55667788);
30:     expect(p.AuthCode3).toBe(0x99aabbcc);
31:     expect(p.AuthCode4).toBe(0xddeeff00);
32:   });
33: 
34:   it('stops the ip at the terminator and survives a full field', () => {
35:     const view = buildPacket();
36:     for (let i = 4; i < 20; i++) view.setUint8(i, 0x31);
37:     const p = new ChangeMapServerInfoPacket(view);
38:     expect(p.IpAddress).toBe('1111111111111111');
39:   });
40: });
</file>

<file path="versions/season6/packets/mapServerMove.ts">
 1: /**
 2:  * C1 B1 00 - `ReceiveChangeMapServerInfo` (WSclient.cpp:10328): the server
 3:  * moves the player to the game server hosting the destination map (split
 4:  * deployments; Kalima and friends). OpenMU's generated protocol has no packet
 5:  * for it, so this is hand-written from the original struct
 6:  * (`PHEADER_MAP_CHANGESERVER_INFO`: a 4-byte header, then `MapServerInfo`
 7:  * aligned to offset 4 - ip[16], port u16, server code u16, four join auth
 8:  * codes u32, all little-endian).
 9:  */
10: export class ChangeMapServerInfoPacket {
11:   buffer!: DataView;
12:   static readonly Name = 'ChangeMapServerInfo';
13:   static readonly HeaderType = 'C1HeaderWithSubCode';
14:   static readonly HeaderCode = 0xc1;
15:   static readonly Direction = 'ServerToClient';
16:   static readonly SentWhen = 'The player enters a map hosted by another game server.';
17:   static readonly CausedReaction = 'The client reconnects to that server and authenticates with the join codes.';
18:   static readonly Length = undefined;
19:   static readonly LengthSize = 1;
20:   static readonly DataOffset = 2;
21:   static readonly Code = 0xb1;
22:   static readonly SubCode = 0x00;
23: 
24:   /** The full wire size; shorter packets are dropped by the handler. */
25:   static readonly MinimumSize = 40;
26: 
27:   constructor(buffer?: DataView) {
28:     if (buffer) this.buffer = buffer;
29:   }
30: 
31:   get IpAddress() {
32:     let val = '';
33:     for (let i = 4; i < 20 && i < this.buffer.byteLength; i++) {
34:       const ch = this.buffer.getUint8(i);
35:       if (ch === 0) break;
36:       val += String.fromCharCode(ch);
37:     }
38:     return val;
39:   }
40:   get Port() {
41:     return this.buffer.getUint16(20, true);
42:   }
43:   get ServerCode() {
44:     return this.buffer.getUint16(22, true);
45:   }
46:   get AuthCode1() {
47:     return this.buffer.getUint32(24, true);
48:   }
49:   get AuthCode2() {
50:     return this.buffer.getUint32(28, true);
51:   }
52:   get AuthCode3() {
53:     return this.buffer.getUint32(32, true);
54:   }
55:   get AuthCode4() {
56:     return this.buffer.getUint32(36, true);
57:   }
58: }
</file>

