<file path="tools/instrumentSamples.ts">
  1: /**
  2:  * Fetches an instrument's notes for the band system.
  3:  *
  4:  *   bun run tools/instrumentSamples.ts guitar flute ocarina
  5:  *   bun run tools/instrumentSamples.ts --all
  6:  *   bun run tools/instrumentSamples.ts --test-midi
  7:  *
  8:  * The source is the MusyngKite soundfont as `gleitz/midi-js-soundfonts`
  9:  * publishes it on its gh-pages branch: one file per note per General MIDI
 10:  * instrument, already rendered. Nothing of MIDI.js itself is used - only
 11:  * those files, copied once, here, into the repo's own assets. The
 12:  * `<name>-ogg.js` bundle is a JS object of base64 OGGs (`MIDI.Soundfont.<name>
 13:  * = {"A0": "data:audio/ogg;base64,..."}`); the loose `<name>-mp3/<Note>.mp3`
 14:  * files are the fallback (`--mp3`). Point `--source <url>` at any other host
 15:  * laid out the same way.
 16:  *
 17:  * Output, per registry row (`src/common/instruments.ts`):
 18:  *   public/game-assets/Instrument/<id>/<Note>.ogg   every note the source has (A0..C8)
 19:  *   public/game-assets/Instrument/<id>.json         the bank manifest the sampler reads
 20:  *   public/game-assets/Instrument/LICENSE.txt       attribution (MusyngKite is CC BY-SA 3.0)
 21:  *
 22:  * The client fetches one instrument's folder on first use, so a bank's size
 23:  * is only paid by the players who hear it.
 24:  */
 25: import { mkdirSync, writeFileSync } from 'fs';
 26: import { INSTRUMENTS, type InstrumentId } from '../src/common/instruments';
 27: import { buildTestMidi } from '../src/common/band/testMidi';
 28: import { PROJECT_ROOT } from './shared';
 29: 
 30: const DEFAULT_SOURCE = 'https://gleitz.github.io/midi-js-soundfonts/MusyngKite';
 31: const OUT = `${PROJECT_ROOT}public/game-assets/Instrument/`;
 32: 
 33: /** Note names as the source spells them: flats, `A0`..`C8`. */
 34: const NAMES = ['C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab', 'A', 'Bb', 'B'];
 35: 
 36: function noteName(midi: number): string {
 37:   return `${NAMES[midi % 12]}${Math.floor(midi / 12) - 1}`;
 38: }
 39: 
 40: function midiOf(name: string): number | null {
 41:   const m = /^([A-G]b?)(-?\d)$/.exec(name);
 42:   if (!m) return null;
 43:   const i = NAMES.indexOf(m[1]);
 44:   if (i < 0) return null;
 45:   return (Number(m[2]) + 1) * 12 + i;
 46: }
 47: 
 48: export type BankManifest = {
 49:   instrument: InstrumentId;
 50:   /** MusyngKite instrument the notes came from. */
 51:   bank: string;
 52:   sustained: boolean;
 53:   /** Seconds. */
 54:   attack: number;
 55:   release: number;
 56:   /** MIDI note -> file under `Instrument/<id>/`. */
 57:   notes: Record<number, string>;
 58: };
 59: 
 60: const LICENSE = `Instrument samples for the band system.
 61: 
 62: Source: MusyngKite General MIDI soundfont, as rendered per note by
 63: gleitz/midi-js-soundfonts (https://github.com/gleitz/midi-js-soundfonts,
 64: gh-pages branch). MusyngKite is released under the Creative Commons
 65: Attribution-ShareAlike 3.0 license (CC BY-SA 3.0,
 66: https://creativecommons.org/licenses/by-sa/3.0/). The files in this folder
 67: are those renders, re-encoded only where the source offered no OGG; they
 68: stay under the same license.
 69: `;
 70: 
 71: const args = process.argv.slice(2);
 72: const flag = (name: string) => args.includes(`--${name}`);
 73: const option = (name: string): string | null => {
 74:   const i = args.indexOf(`--${name}`);
 75:   return i >= 0 && i + 1 < args.length ? args[i + 1] : null;
 76: };
 77: 
 78: const source = (option('source') ?? DEFAULT_SOURCE).replace(/\/+$/, '');
 79: const useMp3 = flag('mp3');
 80: 
 81: async function fetchBytes(url: string): Promise<Uint8Array> {
 82:   const res = await fetch(url, { headers: { 'user-agent': 'Mozilla/5.0' } });
 83:   if (!res.ok) throw new Error(`${res.status} ${url}`);
 84:   return new Uint8Array(await res.arrayBuffer());
 85: }
 86: 
 87: /**
 88:  * The `-ogg.js` bundle as `{ noteName: dataUri }`. It is a JS object literal,
 89:  * not JSON (trailing commas and the like), so the pairs are picked out by
 90:  * shape rather than parsed.
 91:  */
 92: async function fetchBundle(bank: string): Promise<Record<string, string>> {
 93:   const text = new TextDecoder().decode(await fetchBytes(`${source}/${bank}-ogg.js`));
 94:   const notes: Record<string, string> = {};
 95:   const pair = /"([A-G]b?-?\d)"\s*:\s*"(data:audio\/[^"]+)"/g;
 96:   for (let m = pair.exec(text); m; m = pair.exec(text)) notes[m[1]] = m[2];
 97:   if (Object.keys(notes).length === 0) throw new Error(`${bank}: bundle has no notes`);
 98:   return notes;
 99: }
100: 
101: function decodeDataUri(uri: string): { ext: 'ogg' | 'mp3'; bytes: Uint8Array } {
102:   const m = /^data:audio\/(ogg|mp3|mpeg);base64,(.*)$/s.exec(uri);
103:   if (!m) throw new Error(`unexpected note payload: ${uri.slice(0, 40)}`);
104:   const ext = m[1] === 'ogg' ? 'ogg' : 'mp3';
105:   return { ext, bytes: new Uint8Array(Buffer.from(m[2], 'base64')) };
106: }
107: 
108: async function fetchInstrument(id: InstrumentId): Promise<void> {
109:   const def = INSTRUMENTS.find(d => d.id === id);
110:   if (!def) throw new Error(`no registry row for ${id}`);
111: 
112:   const dir = `${OUT}${id}/`;
113:   mkdirSync(dir, { recursive: true });
114:   const notes: Record<number, string> = {};
115:   let bytes = 0;
116: 
117:   if (useMp3) {
118:     for (let midi = 21; midi <= 108; midi++) {
119:       const name = noteName(midi);
120:       try {
121:         const data = await fetchBytes(`${source}/${def.bank}-mp3/${name}.mp3`);
122:         writeFileSync(`${dir}${name}.mp3`, data);
123:         notes[midi] = `${name}.mp3`;
124:         bytes += data.length;
125:       } catch {
126:         // The source has no such note; the sampler pitches the nearest.
127:       }
128:     }
129:   } else {
130:     const bundle = await fetchBundle(def.bank);
131:     for (const [name, uri] of Object.entries(bundle)) {
132:       const midi = midiOf(name);
133:       if (midi === null) continue;
134:       const { ext, bytes: data } = decodeDataUri(uri);
135:       writeFileSync(`${dir}${name}.${ext}`, data);
136:       notes[midi] = `${name}.${ext}`;
137:       bytes += data.length;
138:     }
139:   }
140: 
141:   const count = Object.keys(notes).length;
142:   if (count === 0) throw new Error(`${id}: no notes fetched from ${source}`);
143: 
144:   const manifest: BankManifest = {
145:     instrument: id,
146:     bank: def.bank,
147:     sustained: def.sustained,
148:     attack: def.sustained ? 0.02 : 0.005,
149:     // A wind stops when the breath does; a plucked string is damped, not
150:     // cut, so its note-off is a slower fade over the render's own decay.
151:     release: def.sustained ? 0.12 : 0.5,
152:     notes,
153:   };
154:   writeFileSync(`${OUT}${id}.json`, JSON.stringify(manifest, null, 2) + '\n');
155:   writeFileSync(`${OUT}LICENSE.txt`, LICENSE);
156:   console.log(`${id}: ${count} notes, ${(bytes / 1024).toFixed(0)} KB -> ${dir}`);
157: }
158: 
159: async function main(): Promise<void> {
160:   if (flag('test-midi')) {
161:     const dir = `${PROJECT_ROOT}public/dev/band/`;
162:     mkdirSync(dir, { recursive: true });
163:     writeFileSync(`${dir}scale.mid`, buildTestMidi());
164:     console.log(`wrote ${dir}scale.mid`);
165:   }
166: 
167:   const wanted = flag('all')
168:     ? INSTRUMENTS.map(d => d.id)
169:     : (args.filter(a => !a.startsWith('--') && a !== option('source')) as InstrumentId[]);
170: 
171:   for (const id of wanted) {
172:     if (!INSTRUMENTS.some(d => d.id === id)) throw new Error(`unknown instrument ${id}`);
173:     await fetchInstrument(id);
174:   }
175: 
176:   if (wanted.length === 0 && !flag('test-midi')) {
177:     console.log('nothing to do: name instruments, or --all, or --test-midi');
178:   }
179: }
180: 
181: await main();
</file>

<file path="tools/itemIconFit.ts">
  1: /**
  2:  * Builds `src/common/itemIconFit.ts` from the pixels in `public/items` and the
  3:  * original's own icon scales (`src/common/itemIconScale.ts`).
  4:  *
  5:  *   bun run tools/itemIconFit.ts
  6:  *
  7:  * The pack renders every item at one world scale into a canvas sized by the
  8:  * item's inventory footprint, so a small item covers a small part of its own
  9:  * PNG - a jewel is 21 x 25 opaque pixels inside 120 x 126 - and fitting that
 10:  * whole canvas into the square left a few pixels of jewel.
 11:  *
 12:  * How big each item should be is not "as big as the square": the original
 13:  * hand-tunes `o->Scale` per item type in RenderObjectScreen, and a ring really
 14:  * is meant to be smaller than a jewel. Since the pack shares one world scale,
 15:  * the displayed size the original would give an item is its scale times a
 16:  * single constant, and the zoom that gets there is
 17:  *
 18:  *   zoom = SCALE_TO_ZOOM * o->Scale / containFit
 19:  *
 20:  * where `containFit` is what `max-width/height: 100%` already does to the
 21:  * canvas. The measured opaque box caps it so nothing can spill out of its
 22:  * square whatever the container's aspect.
 23:  *
 24:  * Re-run whenever files are added to or removed from `public/items`.
 25:  */
 26: import { readdirSync, readFileSync, writeFileSync } from 'fs';
 27: import { join } from 'path';
 28: import { PNG } from 'pngjs';
 29: import { ITEM_ICON_SCALE, ITEM_ICON_SCALE_DEFAULT } from '../src/common/itemIconScale';
 30: import items from '../src/common/items.json';
 31: 
 32: const ROOT = join(import.meta.dir, '..');
 33: const ITEMS_DIR = join(ROOT, 'public', 'items');
 34: const OUT = join(ROOT, 'src', 'common', 'itemIconFit.ts');
 35: 
 36: const FILE = /^item_(\d+)_(\d+)_(\d+)(_e|_a)?\.png$/;
 37: 
 38: /** Below this the pixel is the render's own anti-aliased fringe, not the item. */
 39: const ALPHA_FLOOR = 8;
 40: /** One inventory square, the unit both the grid and the icon canvases are cut to. */
 41: const SQUARE = 20;
 42: /**
 43:  * Turns the original's `o->Scale` into a zoom on the pack. Calibrated so the
 44:  * items that already looked right keep their size (armour, wings, jewels) and
 45:  * the ones the table says are small come back down (rings, scrolls).
 46:  */
 47: const SCALE_TO_ZOOM = 180;
 48: /** Leaves the item off the square's border when the cap binds. */
 49: const MARGIN = 0.92;
 50: /** Under this the zoom is not worth an entry. */
 51: const MIN_ZOOM = 1.05;
 52: 
 53: type Box = { zoom: number; dx: number; dy: number };
 54: 
 55: function opaqueBox(file: string) {
 56:   const png = PNG.sync.read(readFileSync(join(ITEMS_DIR, file)));
 57:   const { width, height, data } = png;
 58: 
 59:   let x0 = width;
 60:   let y0 = height;
 61:   let x1 = -1;
 62:   let y1 = -1;
 63: 
 64:   for (let y = 0; y < height; y++) {
 65:     for (let x = 0; x < width; x++) {
 66:       if (data[(y * width + x) * 4 + 3] < ALPHA_FLOOR) continue;
 67:       if (x < x0) x0 = x;
 68:       if (x > x1) x1 = x;
 69:       if (y < y0) y0 = y;
 70:       if (y > y1) y1 = y;
 71:     }
 72:   }
 73: 
 74:   if (x1 < 0) return null;
 75: 
 76:   return { width, height, x0, y0, x1, y1 };
 77: }
 78: 
 79: function fitOf(group: number, num: number, file: string): Box | null {
 80:   const measured = opaqueBox(file);
 81:   if (!measured) return null;
 82: 
 83:   const item = items.find(i => i.Group === group && i.Index === num);
 84:   if (!item) return null;
 85: 
 86:   const { width, height, x0, y0, x1, y1 } = measured;
 87:   const w = x1 - x0 + 1;
 88:   const h = y1 - y0 + 1;
 89: 
 90:   // What `max-width/height: 100%` does to the canvas inside the item's squares.
 91:   const contain = Math.min((item.X * SQUARE) / width, (item.Y * SQUARE) / height);
 92:   const scale = ITEM_ICON_SCALE[`${group}_${num}`] ?? ITEM_ICON_SCALE_DEFAULT;
 93:   const cap = Math.min(width / w, height / h) * MARGIN;
 94: 
 95:   return {
 96:     zoom: Math.min((SCALE_TO_ZOOM * scale) / contain, cap),
 97:     // The content is drawn centred, but only roughly; the zoom is about the
 98:     // canvas centre, so the drift has to come off first or it scales too.
 99:     dx: 0.5 - (x0 + x1 + 1) / 2 / width,
100:     dy: 0.5 - (y0 + y1 + 1) / 2 / height,
101:   };
102: }
103: 
104: /** The plain tints first: the `_e` aura would measure wider than the item. */
105: const RANK = (name: string) => (name.includes('_e.') ? 2 : name.includes('_a.') ? 1 : 0);
106: 
107: const candidates = new Map<string, { file: string; group: number; num: number }>();
108: 
109: for (const name of readdirSync(ITEMS_DIR)) {
110:   const m = FILE.exec(name);
111:   if (!m) continue;
112:   const key = `${m[1]}_${m[2]}`;
113:   const held = candidates.get(key);
114:   if (!held || RANK(name) < RANK(held.file)) {
115:     candidates.set(key, { file: name, group: Number(m[1]), num: Number(m[2]) });
116:   }
117: }
118: 
119: const fits = new Map<string, Box>();
120: 
121: for (const [key, { file, group, num }] of candidates) {
122:   const box = fitOf(group, num, file);
123:   if (!box || box.zoom < MIN_ZOOM) continue;
124:   fits.set(key, box);
125: }
126: 
127: const keys = [...fits.keys()].sort((a, b) => {
128:   const [ga, na] = a.split('_').map(Number);
129:   const [gb, nb] = b.split('_').map(Number);
130:   return ga - gb || na - nb;
131: });
132: 
133: const round = (n: number, places: number) => Number(n.toFixed(places));
134: 
135: const lines = keys.map(key => {
136:   const box = fits.get(key)!;
137:   return `  '${key}': [${round(box.zoom, 2)}, ${round(box.dx, 3)}, ${round(box.dy, 3)}],`;
138: });
139: 
140: const source = `// GENERATED by tools/itemIconFit.ts - do not edit.
141: // ${keys.length} of ${candidates.size} items.
142: //
143: // \`group_num\` → [zoom, dx, dy]: how far the icon has to be blown up to reach
144: // the size the original draws that item at, and the drift off centre that has
145: // to come off first. Consumed by ui/components/itemIcon.
146: export const ITEM_ICON_FIT: Readonly<Record<string, readonly [number, number, number]>> = {
147: ${lines.join('\n')}
148: };
149: `;
150: 
151: writeFileSync(OUT, source);
152: console.log(`wrote ${OUT}: ${keys.length} items`);
</file>

<file path="tools/instrumentModels.ts">
  1: /**
  2:  * Builds the band system's instrument models from the reference image.
  3:  *
  4:  *   bun run tools/instrumentModels.ts            (all three)
  5:  *   bun run tools/instrumentModels.ts guitar
  6:  *
  7:  * Low-poly primitives, textured with crops of
  8:  * `references/screenshots/todo/instruments_reference.png` (a guitar, a flute
  9:  * and an ocarina on a transparent background, top to bottom). The three are
 10:  * found by scanning the alpha channel for the three opaque bands, so the
 11:  * image can be re-exported at another size without touching this file.
 12:  *
 13:  * Written the way `bmdToGlb.ts` writes a static model: vertices in BMD space
 14:  * scaled by 0.01 (Z along the instrument, Y its thickness, centimetres),
 15:  * one node, `POSITION / NORMAL / TEXCOORD_0 / COLOR_0`, a PBR material with
 16:  * roughness 1 and an embedded PNG atlas. The atlas matters beyond looks: the
 17:  * loader only puts a GLB mesh on the item material - the one the map's
 18:  * lights reach - when it carries an albedo texture (`modelLoader.ts
 19:  * prepareMeshes`).
 20:  *
 21:  * Each model's origin is where the hand holds it; the registry's `link`
 22:  * places it on the bone.
 23:  */
 24: import { Document, NodeIO } from '@gltf-transform/core';
 25: import { existsSync } from 'fs';
 26: import { resolve } from 'path';
 27: import sharp from 'sharp';
 28: import { PROJECT_ROOT } from './shared';
 29: 
 30: const SCALE = 0.01;
 31: 
 32: const OUT = `${PROJECT_ROOT}public/game-assets/Item/`;
 33: 
 34: /** The image lives in the workspace beside the repo, not in the repo. */
 35: const REFERENCE_CANDIDATES = [
 36:   process.env.INSTRUMENT_REFERENCE,
 37:   resolve(PROJECT_ROOT, '../references/screenshots/todo/instruments_reference.png'),
 38:   resolve(PROJECT_ROOT, '../../references/screenshots/todo/instruments_reference.png'),
 39: ].filter((p): p is string => !!p);
 40: 
 41: // ---- geometry --------------------------------------------------------------
 42: 
 43: type V3 = [number, number, number];
 44: type UV = [number, number];
 45: 
 46: /** A rectangle on the atlas, in 0..1 with v down like glTF wants. */
 47: type Rect = { u: number; v: number; w: number; h: number };
 48: 
 49: class MeshBuilder {
 50:   positions: number[] = [];
 51:   normals: number[] = [];
 52:   uvs: number[] = [];
 53:   indices: number[] = [];
 54: 
 55:   private vertex(p: V3, n: V3, uv: UV): number {
 56:     const i = this.positions.length / 3;
 57:     this.positions.push(p[0] * SCALE, p[1] * SCALE, p[2] * SCALE);
 58:     this.normals.push(n[0], n[1], n[2]);
 59:     this.uvs.push(uv[0], uv[1]);
 60:     return i;
 61:   }
 62: 
 63:   /** A flat-shaded triangle; the normal comes from the winding. */
 64:   tri(a: V3, b: V3, c: V3, ua: UV, ub: UV, uc: UV): void {
 65:     const n = normalOf(a, b, c);
 66:     const i = this.vertex(a, n, ua);
 67:     const j = this.vertex(b, n, ub);
 68:     const k = this.vertex(c, n, uc);
 69:     this.indices.push(i, j, k);
 70:   }
 71: 
 72:   quad(a: V3, b: V3, c: V3, d: V3, ua: UV, ub: UV, uc: UV, ud: UV): void {
 73:     this.tri(a, b, c, ua, ub, uc);
 74:     this.tri(a, c, d, ua, uc, ud);
 75:   }
 76: 
 77:   get triangles(): number {
 78:     return this.indices.length / 3;
 79:   }
 80: 
 81:   /**
 82:    * Every triangle added since `from` must face away from `centre`: the
 83:    * normal comes from the winding, so a face wound the wrong way is a face
 84:    * the game culls from outside and shows from inside - the flute's wall,
 85:    * the guitar's top and the ocarina's body all shipped that way once.
 86:    * Closed convex shapes only; a flat disc checks its own normal.
 87:    */
 88:   assertOutward(from: number, centre: V3, what: string): void {
 89:     let inward = 0;
 90:     for (let t = from * 3; t < this.indices.length; t += 3) {
 91:       const n = this.normalAt(this.indices[t]);
 92:       const c = this.centreOf(t);
 93:       if ((c[0] - centre[0]) * n[0] + (c[1] - centre[1]) * n[1] + (c[2] - centre[2]) * n[2] <= 0) inward++;
 94:     }
 95:     if (inward) throw new Error(`${what}: ${inward} of ${this.triangles - from} triangles face inward`);
 96:   }
 97: 
 98:   private normalAt(vertex: number): V3 {
 99:     return [this.normals[vertex * 3], this.normals[vertex * 3 + 1], this.normals[vertex * 3 + 2]];
100:   }
101: 
102:   private centreOf(index: number): V3 {
103:     const c: V3 = [0, 0, 0];
104:     for (let k = 0; k < 3; k++) {
105:       const v = this.indices[index + k] * 3;
106:       c[0] += this.positions[v] / 3;
107:       c[1] += this.positions[v + 1] / 3;
108:       c[2] += this.positions[v + 2] / 3;
109:     }
110:     return [c[0] / SCALE, c[1] / SCALE, c[2] / SCALE];
111:   }
112: }
113: 
114: function normalOf(a: V3, b: V3, c: V3): V3 {
115:   const ux = b[0] - a[0], uy = b[1] - a[1], uz = b[2] - a[2];
116:   const vx = c[0] - a[0], vy = c[1] - a[1], vz = c[2] - a[2];
117:   const x = uy * vz - uz * vy;
118:   const y = uz * vx - ux * vz;
119:   const z = ux * vy - uy * vx;
120:   const len = Math.hypot(x, y, z) || 1;
121:   return [x / len, y / len, z / len];
122: }
123: 
124: function inRect(r: Rect, s: number, t: number): UV {
125:   return [r.u + s * r.w, r.v + t * r.h];
126: }
127: 
128: /** One texel: a solid patch on the atlas. */
129: function solid(r: Rect): UV {
130:   return [r.u + r.w / 2, r.v + r.h / 2];
131: }
132: 
133: /**
134:  * A box from `min` to `max` (cm). Faces along Z (the length) take `side`
135:  * with s along Z and t along the other axis; the two ends take `cap`.
136:  */
137: function box(m: MeshBuilder, min: V3, max: V3, side: Rect, cap: Rect = side): void {
138:   const [x0, y0, z0] = min;
139:   const [x1, y1, z1] = max;
140:   const from = m.triangles;
141:   const s = (z: number) => (z - z0) / (z1 - z0 || 1);
142:   const tx = (x: number) => (x - x0) / (x1 - x0 || 1);
143:   const ty = (y: number) => (y - y0) / (y1 - y0 || 1);
144:   // top (+Y) and bottom (-Y)
145:   m.quad([x0, y1, z0], [x0, y1, z1], [x1, y1, z1], [x1, y1, z0],
146:     inRect(side, s(z0), tx(x0)), inRect(side, s(z1), tx(x0)), inRect(side, s(z1), tx(x1)), inRect(side, s(z0), tx(x1)));
147:   m.quad([x0, y0, z0], [x1, y0, z0], [x1, y0, z1], [x0, y0, z1],
148:     inRect(side, s(z0), tx(x0)), inRect(side, s(z0), tx(x1)), inRect(side, s(z1), tx(x1)), inRect(side, s(z1), tx(x0)));
149:   // sides (+X, -X)
150:   m.quad([x1, y0, z0], [x1, y1, z0], [x1, y1, z1], [x1, y0, z1],
151:     inRect(side, s(z0), ty(y0)), inRect(side, s(z0), ty(y1)), inRect(side, s(z1), ty(y1)), inRect(side, s(z1), ty(y0)));
152:   m.quad([x0, y0, z0], [x0, y0, z1], [x0, y1, z1], [x0, y1, z0],
153:     inRect(side, s(z0), ty(y0)), inRect(side, s(z1), ty(y0)), inRect(side, s(z1), ty(y1)), inRect(side, s(z0), ty(y1)));
154:   // ends (+Z, -Z)
155:   m.quad([x0, y0, z1], [x1, y0, z1], [x1, y1, z1], [x0, y1, z1],
156:     inRect(cap, 0, 0), inRect(cap, 1, 0), inRect(cap, 1, 1), inRect(cap, 0, 1));
157:   m.quad([x0, y0, z0], [x0, y1, z0], [x1, y1, z0], [x1, y0, z0],
158:     inRect(cap, 0, 0), inRect(cap, 0, 1), inRect(cap, 1, 1), inRect(cap, 1, 0));
159:   m.assertOutward(from, [(x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2], 'box');
160: }
161: 
162: /**
163:  * A cylinder along Z from `z0` to `z1`, `segments` around. The wrap takes
164:  * `side` with s along Z and t around; the ends take `cap` as one texel.
165:  */
166: function cylinder(m: MeshBuilder, z0: number, z1: number, radius: number, segments: number, side: Rect, cap: Rect, ry = radius): void {
167:   const from = m.triangles;
168:   for (let i = 0; i < segments; i++) {
169:     const a0 = (i / segments) * Math.PI * 2;
170:     const a1 = ((i + 1) / segments) * Math.PI * 2;
171:     const p = (a: number, z: number): V3 => [Math.cos(a) * radius, Math.sin(a) * ry, z];
172:     // Around first, then along: with X = cos and Y = sin the other order
173:     // winds the wall inward.
174:     m.quad(p(a0, z0), p(a1, z0), p(a1, z1), p(a0, z1),
175:       inRect(side, 0, i / segments), inRect(side, 0, (i + 1) / segments), inRect(side, 1, (i + 1) / segments), inRect(side, 1, i / segments));
176:     m.tri([0, 0, z1], p(a0, z1), p(a1, z1), solid(cap), solid(cap), solid(cap));
177:     m.tri([0, 0, z0], p(a1, z0), p(a0, z0), solid(cap), solid(cap), solid(cap));
178:   }
179:   m.assertOutward(from, [0, 0, (z0 + z1) / 2], 'cylinder');
180: }
181: 
182: // ---- silhouettes -----------------------------------------------------------
183: 
184: /**
185:  * A column of an instrument's silhouette: an image column and the first and
186:  * last opaque rows in it. The reference is a photo on a transparent
187:  * background, so its alpha channel *is* the outline the player sees painted
188:  * on the model - tracing it and extruding that is what puts the model's own
189:  * edge under the photo's edge. The guitar body used to be two circles and the
190:  * ocarina an ellipsoid, and neither followed the picture.
191:  */
192: type Column = { px: number; lo: number; hi: number };
193: 
194: /** Alpha over this is the instrument; under it is the photo's soft fringe. */
195: const OPAQUE = 96;
196: 
197: function lerp(a: number, b: number, t: number): number {
198:   return a + (b - a) * t;
199: }
200: 
201: /** Every column of a band's silhouette, left to right. */
202: async function traceColumns(file: string, band: Band): Promise<Column[]> {
203:   const { data, info } = await sharp(file).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
204:   const { width, channels } = info;
205:   const columns: Column[] = [];
206:   for (let px = band.left; px <= band.right; px++) {
207:     let lo = Infinity;
208:     let hi = -Infinity;
209:     for (let py = band.top; py <= band.bottom; py++) {
210:       if (data[(py * width + px) * channels + 3] <= OPAQUE) continue;
211:       if (py < lo) lo = py;
212:       if (py > hi) hi = py;
213:     }
214:     if (hi > lo) columns.push({ px, lo, hi });
215:   }
216:   if (columns.length < 4) throw new Error('the silhouette has no width');
217:   return columns;
218: }
219: 
220: /**
221:  * The columns worth keeping: one stays when dropping it would move either
222:  * edge by more than `tol` pixels. The guitar's neck collapses to its two
223:  * ends and its bouts keep their curve - the triangles land where the outline
224:  * actually turns, and a step (the heel) keeps both of its sides.
225:  */
226: function decimate(columns: Column[], tol: number): Column[] {
227:   if (columns.length <= 2) return columns.slice();
228:   const kept = [columns[0]];
229:   let anchor = 0;
230:   for (let i = 2; i < columns.length; i++) {
231:     let straight = true;
232:     for (let j = anchor + 1; j < i && straight; j++) {
233:       const t = (columns[j].px - columns[anchor].px) / (columns[i].px - columns[anchor].px);
234:       straight =
235:         Math.abs(lerp(columns[anchor].lo, columns[i].lo, t) - columns[j].lo) <= tol &&
236:         Math.abs(lerp(columns[anchor].hi, columns[i].hi, t) - columns[j].hi) <= tol;
237:     }
238:     if (straight) continue;
239:     kept.push(columns[i - 1]);
240:     anchor = i - 1;
241:   }
242:   kept.push(columns[columns.length - 1]);
243:   return kept;
244: }
245: 
246: /**
247:  * How a band's pixels become model centimetres. An instrument is measured in
248:  * its own axes - `along` it, `across` it, and `through` its thickness - and
249:  * `orient` turns those into the model's, so a reshaped instrument still sits
250:  * in the hand the way the row's `link` was solved for.
251:  */
252: type Placement = {
253:   band: Band;
254:   /** Centimetres per image pixel. */
255:   cm: number;
256:   /** The image column the origin sits on, and the row its long axis runs down. */
257:   originPx: number;
258:   originPy: number;
259:   /** (across, through, along) -> model x/y/z. A rotation: the winding must hold. */
260:   orient: (p: V3) => V3;
261:   /** Where the band is painted on the atlas. */
262:   rect: Rect;
263: };
264: 
265: const alongCm = (p: Placement, px: number): number => (px - p.originPx) * p.cm;
266: const acrossCm = (p: Placement, py: number): number => (py - p.originPy) * p.cm;
267: 
268: /** A point of the silhouette, in model space. */
269: function point(p: Placement, px: number, py: number, through: number): V3 {
270:   return p.orient([acrossCm(p, py), through, alongCm(p, px)]);
271: }
272: 
273: /** The texel the photo has at that pixel; the map is 1:1, which is the whole point. */
274: function pixelUv(p: Placement, px: number, py: number): UV {
275:   return inRect(
276:     p.rect,
277:     (px - p.band.left) / (p.band.right - p.band.left),
278:     (py - p.band.top) / (p.band.bottom - p.band.top)
279:   );
280: }
281: 
282: /** The middle of a segment, for the outwardness check its four faces must pass. */
283: function segmentCentre(p: Placement, a: Column, b: Column, lo: number, hi: number): V3 {
284:   const px = (a.px + b.px) / 2;
285:   const py = (a.lo + a.hi + b.lo + b.hi) / 4;
286:   return point(p, px, py, (lo + hi) / 2);
287: }
288: 
289: /**
290:  * The silhouette as a slab with one flat face: the guitar, whose soundboard
291:  * and fretboard are the same plane and whose sides are a rim. `face` is where
292:  * that plane sits and `depth` how far the slab hangs under it at a column -
293:  * deep through the body, thin along the neck.
294:  */
295: function extrudeFlat(
296:   m: MeshBuilder,
297:   columns: Column[],
298:   p: Placement,
299:   face: number,
300:   depth: (px: number) => number,
301:   rim: Rect
302: ): void {
303:   const at = (px: number, py: number, through: number): V3 => point(p, px, py, through);
304:   const uv = (px: number, py: number): UV => pixelUv(p, px, py);
305:   const r = solid(rim);
306: 
307:   for (let i = 0; i + 1 < columns.length; i++) {
308:     const a = columns[i];
309:     const b = columns[i + 1];
310:     const ya = face - depth(a.px);
311:     const yb = face - depth(b.px);
312:     const from = m.triangles;
313:     // the face, the same photo the rest of the model is painted with
314:     m.quad(at(a.px, a.lo, face), at(b.px, b.lo, face), at(b.px, b.hi, face), at(a.px, a.hi, face),
315:       uv(a.px, a.lo), uv(b.px, b.lo), uv(b.px, b.hi), uv(a.px, a.hi));
316:     // the back, the same photo again: a guitar is never seen from behind for long
317:     m.quad(at(a.px, a.lo, ya), at(a.px, a.hi, ya), at(b.px, b.hi, yb), at(b.px, b.lo, yb),
318:       uv(a.px, a.lo), uv(a.px, a.hi), uv(b.px, b.hi), uv(b.px, b.lo));
319:     // the two rims, in the body's own colour
320:     m.quad(at(a.px, a.lo, face), at(a.px, a.lo, ya), at(b.px, b.lo, yb), at(b.px, b.lo, face), r, r, r, r);
321:     m.quad(at(a.px, a.hi, ya), at(a.px, a.hi, face), at(b.px, b.hi, face), at(b.px, b.hi, yb), r, r, r, r);
322:     m.assertOutward(from, segmentCentre(p, a, b, Math.min(ya, yb), face), 'slab segment');
323:   }
324: 
325:   const head = columns[0];
326:   const tail = columns[columns.length - 1];
327:   const caps = m.triangles;
328:   const yh = face - depth(head.px);
329:   const yt = face - depth(tail.px);
330:   m.quad(at(head.px, head.lo, face), at(head.px, head.hi, face), at(head.px, head.hi, yh), at(head.px, head.lo, yh), r, r, r, r);
331:   m.quad(at(tail.px, tail.lo, yt), at(tail.px, tail.hi, yt), at(tail.px, tail.hi, face), at(tail.px, tail.lo, face), r, r, r, r);
332:   m.assertOutward(caps, [0, 0, 0], 'slab ends');
333: }
334: 
335: /**
336:  * The silhouette puffed into a lens: the ocarina, a clay teardrop that is
337:  * thickest down its own middle and closes at its outline. `half` is half the
338:  * thickness at the ridge, from the column's width - so the body swells and
339:  * the mouthpiece stays a tube.
340:  */
341: function extrudeLens(m: MeshBuilder, columns: Column[], p: Placement, half: (span: number) => number): void {
342:   const at = (px: number, py: number, through: number): V3 => point(p, px, py, through);
343:   const uv = (px: number, py: number): UV => pixelUv(p, px, py);
344:   const ridge = (c: Column): number => (c.lo + c.hi) / 2;
345:   const halfOf = (c: Column): number => half(c.hi - c.lo);
346: 
347:   for (let i = 0; i + 1 < columns.length; i++) {
348:     const a = columns[i];
349:     const b = columns[i + 1];
350:     const ha = halfOf(a);
351:     const hb = halfOf(b);
352:     const ma = ridge(a);
353:     const mb = ridge(b);
354:     const from = m.triangles;
355:     m.quad(at(a.px, a.lo, 0), at(b.px, b.lo, 0), at(b.px, mb, hb), at(a.px, ma, ha),
356:       uv(a.px, a.lo), uv(b.px, b.lo), uv(b.px, mb), uv(a.px, ma));
357:     m.quad(at(a.px, ma, ha), at(b.px, mb, hb), at(b.px, b.hi, 0), at(a.px, a.hi, 0),
358:       uv(a.px, ma), uv(b.px, mb), uv(b.px, b.hi), uv(a.px, a.hi));
359:     m.quad(at(a.px, a.hi, 0), at(b.px, b.hi, 0), at(b.px, mb, -hb), at(a.px, ma, -ha),
360:       uv(a.px, a.hi), uv(b.px, b.hi), uv(b.px, mb), uv(a.px, ma));
361:     m.quad(at(a.px, ma, -ha), at(b.px, mb, -hb), at(b.px, b.lo, 0), at(a.px, a.lo, 0),
362:       uv(a.px, ma), uv(b.px, mb), uv(b.px, b.lo), uv(a.px, a.lo));
363:     m.assertOutward(from, segmentCentre(p, a, b, -Math.min(ha, hb), Math.min(ha, hb)), 'lens segment');
364:   }
365: 
366:   // The ends: the cross-section there is a diamond, closed flat.
367:   const head = columns[0];
368:   const tail = columns[columns.length - 1];
369:   const caps = m.triangles;
370:   for (const [c, front] of [[head, true], [tail, false]] as const) {
371:     const h = halfOf(c);
372:     const mid = ridge(c);
373:     const lo = at(c.px, c.lo, 0);
374:     const hi = at(c.px, c.hi, 0);
375:     const top = at(c.px, mid, h);
376:     const bottom = at(c.px, mid, -h);
377:     const uvLo = uv(c.px, c.lo);
378:     const uvHi = uv(c.px, c.hi);
379:     const uvMid = uv(c.px, mid);
380:     if (front) {
381:       m.tri(lo, top, hi, uvLo, uvMid, uvHi);
382:       m.tri(lo, hi, bottom, uvLo, uvHi, uvMid);
383:     } else {
384:       m.tri(lo, hi, top, uvLo, uvHi, uvMid);
385:       m.tri(lo, bottom, hi, uvLo, uvMid, uvHi);
386:     }
387:   }
388:   m.assertOutward(caps, [0, 0, 0], 'lens ends');
389: }
390: 
391: // ---- the three instruments -------------------------------------------------
392: 
393: type Atlas = {
394:   width: number;
395:   height: number;
396:   /** Named rectangles in atlas pixels, filled from crops or solid colours. */
397:   rects: Record<string, { x: number; y: number; w: number; h: number }>;
398: };
399: 
400: function rectOf(atlas: Atlas, name: string): Rect {
401:   const r = atlas.rects[name];
402:   return { u: r.x / atlas.width, v: r.y / atlas.height, w: r.w / atlas.width, h: r.h / atlas.height };
403: }
404: 
405: /**
406:  * Guitar: the photo's own outline, extruded. The soundboard, the fretboard
407:  * and the head are one flat face carrying the photo 1:1, so the painted
408:  * sound hole, rosette, bridge and strings land exactly where the geometry
409:  * puts them; the slab hangs deep under the body and thin under the neck.
410:  * Origin at the heel, where the body ends and the hand takes the neck.
411:  */
412: const GUITAR_LENGTH = 108;
413: const GUITAR_FACE = 4.5;
414: const GUITAR_BODY_DEPTH = 9;
415: const GUITAR_NECK_DEPTH = 2.4;
416: const GUITAR_HEAD_DEPTH = 3;
417: /** Pixels the traced outline may be simplified by (the band is 1257 wide). */
418: const GUITAR_TOLERANCE = 3;
419: 
420: /**
421:  * Where the neck is: the longest thin run of columns, between the body and
422:  * the head. The body's own leading tip is thin too, which is why it is the
423:  * longest run that counts and not the first.
424:  */
425: function neckRun(columns: Column[]): { start: number; end: number } {
426:   const span = columns.map(c => c.hi - c.lo);
427:   const thin = 0.3 * Math.max(...span);
428:   let start = -1;
429:   let end = -1;
430:   let best = 0;
431:   let run = -1;
432:   for (let i = 0; i <= span.length; i++) {
433:     if (i < span.length && span[i] < thin) {
434:       if (run < 0) run = i;
435:       continue;
436:     }
437:     if (run >= 0 && i - run > best) {
438:       best = i - run;
439:       start = run;
440:       end = i - 1;
441:     }
442:     run = -1;
443:   }
444:   if (start < 0) throw new Error('no neck in the guitar silhouette');
445:   return { start, end };
446: }
447: 
448: async function buildGuitar(atlas: Atlas, file: string, band: Band): Promise<MeshBuilder> {
449:   const columns = await traceColumns(file, band);
450:   const neck = neckRun(columns);
451:   const heel = columns[neck.start].px;
452:   const nut = columns[neck.end].px;
453:   const p: Placement = {
454:     band,
455:     cm: GUITAR_LENGTH / (band.right - band.left),
456:     originPx: heel,
457:     originPy: (band.top + band.bottom) / 2,
458:     orient: q => q,
459:     rect: rectOf(atlas, 'guitar'),
460:   };
461:   const m = new MeshBuilder();
462:   const depth = (px: number): number =>
463:     px < heel ? GUITAR_BODY_DEPTH : px <= nut ? GUITAR_NECK_DEPTH : GUITAR_HEAD_DEPTH;
464:   extrudeFlat(m, decimate(columns, GUITAR_TOLERANCE), p, GUITAR_FACE, depth, rectOf(atlas, 'rim'));
465:   return m;
466: }
467: 
468: /**
469:  * Flute: one cylinder, the strip wrapped around it; origin at the middle.
470:  * Thicker and longer than a real one: a 2 cm tube is a hairline at the
471:  * game's distance.
472:  */
473: function buildFlute(atlas: Atlas): MeshBuilder {
474:   const m = new MeshBuilder();
475:   cylinder(m, -36, 36, 2.2, 14, rectOf(atlas, 'flute'), rectOf(atlas, 'fluteEnd'));
476:   return m;
477: }
478: 
479: /**
480:  * Ocarina: the photo's teardrop and its mouthpiece, traced as one outline
481:  * and puffed into a lens - a clay ocarina is exactly that, thickest down its
482:  * middle and closing at its edge. The picture stands upright in the model's
483:  * Z-Y plane with its thickness across, so the mouthpiece points the way the
484:  * row's link already expects: up and back toward the lips.
485:  */
486: const OCARINA_LENGTH = 23;
487: const OCARINA_HALF = 4.8;
488: /** Pixels the traced outline may be simplified by (the band is 601 wide). */
489: const OCARINA_TOLERANCE = 2;
490: 
491: async function buildOcarina(atlas: Atlas, file: string, band: Band): Promise<MeshBuilder> {
492:   const columns = await traceColumns(file, band);
493:   const widest = Math.max(...columns.map(c => c.hi - c.lo));
494:   // The body is everything past the mouthpiece; it carries the size the
495:   // instrument had before, so the hand still holds it the same way.
496:   const body = columns.findIndex(c => c.hi - c.lo > 0.45 * widest);
497:   const tail = columns[columns.length - 1].px;
498:   const p: Placement = {
499:     band,
500:     cm: OCARINA_LENGTH / (tail - columns[body].px),
501:     originPx: (columns[body].px + tail) / 2,
502:     originPy: (band.top + band.bottom) / 2,
503:     orient: ([a, t, l]) => [t, -a, l],
504:     rect: rectOf(atlas, 'ocarina'),
505:   };
506:   const m = new MeshBuilder();
507:   extrudeLens(m, decimate(columns, OCARINA_TOLERANCE), p, span => OCARINA_HALF * Math.sqrt(span / widest));
508:   return m;
509: }
510: 
511: // ---- the image --------------------------------------------------------------
512: 
513: type Band = { top: number; bottom: number; left: number; right: number };
514: 
515: /** The opaque bands of the image, top to bottom. */
516: async function measureBands(file: string): Promise<{ bands: Band[]; width: number; height: number }> {
517:   const { data, info } = await sharp(file).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
518:   const { width, height, channels } = info;
519:   const rowHas = new Array<boolean>(height);
520:   for (let y = 0; y < height; y++) {
521:     let has = false;
522:     for (let x = 0; x < width && !has; x++) has = data[(y * width + x) * channels + 3] > 32;
523:     rowHas[y] = has;
524:   }
525:   const bands: Band[] = [];
526:   let y = 0;
527:   const GAP = 24;
528:   while (y < height) {
529:     while (y < height && !rowHas[y]) y++;
530:     if (y >= height) break;
531:     const top = y;
532:     let gap = 0;
533:     let bottom = y;
534:     while (y < height && gap < GAP) {
535:       if (rowHas[y]) {
536:         bottom = y;
537:         gap = 0;
538:       } else gap++;
539:       y++;
540:     }
541:     let left = width, right = 0;
542:     for (let yy = top; yy <= bottom; yy++) {
543:       for (let x = 0; x < width; x++) {
544:         if (data[(yy * width + x) * channels + 3] > 32) {
545:           if (x < left) left = x;
546:           if (x > right) right = x;
547:         }
548:       }
549:     }
550:     bands.push({ top, bottom, left, right });
551:   }
552:   return { bands, width, height };
553: }
554: 
555: type Crop = { left: number; top: number; width: number; height: number };
556: 
557: function sub(b: Band, x0: number, x1: number, y0: number, y1: number): Crop {
558:   const w = b.right - b.left + 1, h = b.bottom - b.top + 1;
559:   return {
560:     left: Math.round(b.left + w * x0),
561:     top: Math.round(b.top + h * y0),
562:     width: Math.max(1, Math.round(w * (x1 - x0))),
563:     height: Math.max(1, Math.round(h * (y1 - y0))),
564:   };
565: }
566: 
567: /** Average opaque colour of a crop - the background the crop is flattened onto. */
568: async function averageColour(file: string, c: Crop): Promise<{ r: number; g: number; b: number }> {
569:   const { data, info } = await sharp(file).extract(c).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
570:   let r = 0, g = 0, b = 0, n = 0;
571:   for (let i = 0; i < data.length; i += info.channels) {
572:     if (data[i + 3] < 128) continue;
573:     r += data[i]; g += data[i + 1]; b += data[i + 2]; n++;
574:   }
575:   if (n === 0) return { r: 96, g: 64, b: 32 };
576:   return { r: Math.round(r / n), g: Math.round(g / n), b: Math.round(b / n) };
577: }
578: 
579: type Fill = { kind: 'crop'; crop: Crop } | { kind: 'solid'; rgb: { r: number; g: number; b: number } };
580: 
581: async function paintAtlas(file: string, atlas: Atlas, fills: Record<string, Fill>): Promise<Buffer> {
582:   const layers: sharp.OverlayOptions[] = [];
583:   for (const [name, fill] of Object.entries(fills)) {
584:     const r = atlas.rects[name];
585:     if (fill.kind === 'solid') {
586:       layers.push({ input: { create: { width: r.w, height: r.h, channels: 4, background: { ...fill.rgb, alpha: 1 } } }, left: r.x, top: r.y });
587:       continue;
588:     }
589:     const bg = await averageColour(file, fill.crop);
590:     const input = await sharp(file)
591:       .extract(fill.crop)
592:       .flatten({ background: bg })
593:       .resize(r.w, r.h, { fit: 'fill' })
594:       .png()
595:       .toBuffer();
596:     layers.push({ input, left: r.x, top: r.y });
597:   }
598:   return sharp({ create: { width: atlas.width, height: atlas.height, channels: 4, background: { r: 80, g: 50, b: 30, alpha: 1 } } })
599:     .composite(layers)
600:     .png()
601:     .toBuffer();
602: }
