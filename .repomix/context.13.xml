 59: 
 60:     runInAction(() => {
 61:       Store.loadingCharactersList = false;
 62:       Store.charactersList = characters;
 63:       Store.creationUnlockFlags = p.UnlockFlags;
 64:     });
 65:   });
 66: 
 67:   useEventBus('CharacterFocused', bytes => {
