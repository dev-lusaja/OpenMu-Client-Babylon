<file path="versions/season6/packets/bandRelay.ts">
 1: /**
 2:  * C1 FA - a band frame relayed by the ws proxy (`proxy/band/hub.ts`): a
 3:  * performer in scope started, stopped, sent a batch of notes, or the band
 4:  * around them changed; or the proxy's own hello / refusal to this client.
 5:  * OpenMU has no such packet - the proxy originates these the way it does
 6:  * the weather - so this is hand-written like the map-server move.
 7:  *
 8:  * One class for every sub: `SubCode` and `Length` are left undefined so the
 9:  * dispatcher's last fallback matches any sub at any length, and
10:  * `src/common/bandProtocol.ts` reads the body. Per-sub classes would be
11:  * nine names, nine listeners and nine "unhandled packet" warnings.
12:  */
13: export class BandRelayPacket {
14:   buffer!: DataView;
15:   static readonly Name = 'BandRelay';
16:   static readonly HeaderType = 'C1Header';
17:   static readonly HeaderCode = 0xc1;
18:   static readonly Direction = 'ServerToClient';
19:   static readonly SentWhen = 'The proxy relays a live-band frame from a performer in scope, or answers this client.';
20:   static readonly CausedReaction = 'The band module plays, stops or re-routes the performer\'s instrument.';
21:   static readonly Length = undefined;
22:   static readonly LengthSize = 1;
23:   static readonly DataOffset = 2;
24:   static readonly Code = 0xfa;
25: 
26:   constructor(buffer?: DataView) {
27:     if (buffer) this.buffer = buffer;
28:   }
29: 
30:   get Sub() {
31:     return this.buffer.getUint8(3);
32:   }
33: 
34:   /** The performer's object id (masked), or the receiver's own for a notice, or 0 for hello. */
35:   get PerformerId() {
36:     return this.buffer.getUint16(4, false);
37:   }
38: 
39:   /** The whole frame, header included, for `decodeRelayFrame`. */
40:   get bytes(): Uint8Array {
41:     return new Uint8Array(this.buffer.buffer, this.buffer.byteOffset, this.buffer.byteLength);
42:   }
43: }
</file>

