 90:  * `flower7.jpg` against `Flower7.OZJ`. 316 lookups across the tree resolve
 91:  * only because Windows does not care. On a case-sensitive filesystem every one
 92:  * of them misses its own folder and falls through to the by-name search, which
 93:  * would hand the mesh another folder's art - a converter run on Linux would
 94:  * reskin models a Windows run gets right.
 95:  */
 96: const folderIndex = new Map<string, Map<string, string>>();
 97: 
 98: function indexFolder(folder: string): Map<string, string> {
 99:   const cached = folderIndex.get(folder);
100:   if (cached) return cached;
101: 
102:   const files = new Map<string, string>();
103: 
104:   try {
105:     for (const name of readdirSync(folder)) files.set(name.toLowerCase(), name);
106:   } catch {
107:     // A BMD naming a folder that is not in this tree: the by-name search
108:     // downstream is the answer, not a crash.
109:   }
