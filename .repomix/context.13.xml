 1: /**
 2:  * Where the 0.97d assets live.
 3:  *
 4:  * `folder` is the period `Data/` tree the client fetches directly (interface
 5:  * sprites, the logo, `Local/*.bmd`, gate.bmd, minimap tiles). It sits beside
 6:  * the Season 6 `Data/` at the repo root as `Data-v097d/`, served by `vite
 7:  * dev` the same way, and copied into `dist/Data-v097d` by the build
 8:  * (`tools/copyData.ts --src Data-v097d`).
 9:  *
10:  * `assets` is the converted model / terrain tree. Only the maps that have
11:  * been run through `tools/` land there; see the version's README note in the
12:  * PR for what is still to convert.
13:  *
14:  * 0.97d keeps its language tables directly under `Local/` (no `Eng/`
15:  * subfolder yet), so the locale is the empty string.
16:  */
17: import type { VersionData } from '../../../src/version/contract';
18: import { V097D_DATA_FILES } from './inventory';
19: 
20: function withTrailingSlash(url: string): string {
21:   return url.endsWith('/') ? url : `${url}/`;
22: }
23: 
24: export const v097dData: VersionData = {
25:   folder: withTrailingSlash(import.meta.env.VITE_DATA_URL_V097D || './Data-v097d/'),
