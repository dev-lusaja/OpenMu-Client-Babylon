<file path="tools/pack-textures.ts">
 1: #!/usr/bin/env bun
 2: 
 3: import json from './image_cache.json' assert { type: 'json' };
 4: 
 5: function getAvailableFolders() {
 6:   const folders = new Set<string>();
 7:   
 8:   Object.keys(json).forEach(path => {
 9:     const folder = path.split('/')[0];
10:     folders.add(folder);
11:   });
12:   
13:   return Array.from(folders).sort();
14: }
15: 
16: function getFolderStats(folder: string) {
17:   const images = Object.entries(json)
18:     .filter(([key]) => key.startsWith(folder + '/'))
19:     .map(([_key, l]) => ({ filePath: _key, ...l[0] }));
20:   
21:   const totalArea = images.reduce((sum, img) => sum + img.width * img.height, 0);
22:   const estimatedAtlasSize = Math.ceil(Math.sqrt(totalArea * 1.1));
23:   
24:   return {
25:     count: images.length,
26:     estimatedSize: `${estimatedAtlasSize}x${estimatedAtlasSize}`,
27:     totalPixels: totalArea
28:   };
29: }
30: 
31: function main() {
32:   const args = process.argv.slice(2);
33:   
34:   if (args.includes('--help') || args.includes('-h')) {
35:     console.log(`
36: Texture Packer Tool
37: 
38: Usage:
39:   bun run tools/texturePacker.ts [folder]     Pack textures from specific folder
40:   bun run tools/pack-textures.ts --list      List available folders
41:   bun run tools/pack-textures.ts --stats     Show statistics for all folders
42:   bun run tools/pack-textures.ts --help      Show this help
43: 
44: Examples:
45:   bun run tools/texturePacker.ts Item         Pack all Item textures
46:   bun run tools/texturePacker.ts Skill        Pack all Skill textures
47:   bun run tools/texturePacker.ts              Pack ALL textures (warning: very large!)
48: 
49: Output:
50:   Atlases are saved to: public/game-assets/atlases/
51:   Format: [folder]_atlas.webp + [folder]_atlas.json
52:     `);
53:     return;
54:   }
55:   
56:   if (args.includes('--list')) {
57:     console.log('\nAvailable folders:');
58:     const folders = getAvailableFolders();
59:     folders.forEach(folder => {
60:       console.log(`  ${folder}`);
61:     });
62:     console.log(`\nTotal: ${folders.length} folders`);
63:     return;
64:   }
65:   
66:   if (args.includes('--stats')) {
67:     console.log('\nFolder Statistics:');
68:     console.log('================');
69:     const folders = getAvailableFolders();
70:     
71:     folders.forEach(folder => {
72:       const stats = getFolderStats(folder);
73:       console.log(`${folder.padEnd(12)} : ${stats.count.toString().padStart(4)} images, ~${stats.estimatedSize.padEnd(12)} atlas`);
74:     });
75:     
76:     const totalImages = folders.reduce((sum, folder) => sum + getFolderStats(folder).count, 0);
77:     console.log(`\nTotal images: ${totalImages}`);
78:     return;
79:   }
80:   
81:   console.log('Use --help for usage information');
82: }
83: 
84: main();
</file>

<file path="tools/questWords.test.ts">
  1: /**
  2:  * The words writer against the client's own reader.
  3:  *
  4:  * `buildWordsPack` mirrors `readQuestWords` in `libs/mu/questFiles.ts`, and the
  5:  * thing that would quietly break is the Bux handling: the 6-byte header and the
  6:  * body are **two separate runs**, each restarting the key. One run across both
  7:  * decodes the header fine and turns every string to noise, so the test reads
  8:  * back through the same walk the client uses rather than trusting the writer.
  9:  */
 10: 
 11: import { describe, expect, it } from 'vitest';
 12: import { buildWordsPack, type WordRow } from './questWords.ts';
 13: 
 14: const BUX_KEY = [0xfc, 0xcf, 0xab];
 15: const HEADER_SIZE = 6;
 16: 
 17: function bux(buffer: Uint8Array): void {
 18:   for (let i = 0; i < buffer.length; i++) buffer[i] ^= BUX_KEY[i % 3];
 19: }
 20: 
 21: /** `readQuestWords`, transcribed. */
 22: function readBack(bytes: Uint8Array, encoding: string): Map<number, string> {
 23:   const decoder = new TextDecoder(encoding);
 24:   const words = new Map<number, string>();
 25:   let offset = 0;
 26: 
 27:   while (offset + HEADER_SIZE <= bytes.length) {
 28:     const header = bytes.slice(offset, offset + HEADER_SIZE);
 29:     bux(header);
 30:     const view = new DataView(header.buffer, header.byteOffset, header.byteLength);
 31:     const index = view.getInt32(0, true);
 32:     const length = view.getInt16(4, true);
 33:     offset += HEADER_SIZE;
 34: 
 35:     if (length < 0 || offset + length > bytes.length) break;
 36: 
 37:     const body = bytes.slice(offset, offset + length);
 38:     bux(body);
 39:     let end = body.indexOf(0);
 40:     if (end < 0) end = body.length;
 41:     words.set(index, decoder.decode(body.subarray(0, end)));
 42:     offset += length;
 43:   }
 44: 
 45:   return words;
 46: }
 47: 
 48: /** A row as `readEnglishWords` hands it over: bytes, terminator included. */
 49: function row(index: number, text: string): WordRow {
 50:   const body = new Uint8Array(text.length + 1);
 51:   for (let i = 0; i < text.length; i++) body[i] = text.charCodeAt(i);
 52:   return { index, body };
 53: }
 54: 
 55: describe('quest words pack', () => {
 56:   it('writes a translated row and reads it back at its own index', () => {
 57:     const problems: string[] = [];
 58:     const pack = buildWordsPack(
 59:       [row(1, 'Welcome.'), row(298, 'Accept a quest.')],
 60:       { 298: 'Eine Quest annehmen.' },
 61:       'windows-1252',
 62:       problems
 63:     );
 64: 
 65:     expect(problems).toEqual([]);
 66:     const back = readBack(pack, 'windows-1252');
 67:     expect(back.get(298)).toBe('Eine Quest annehmen.');
 68:     expect(back.size).toBe(2);
 69:   });
 70: 
 71:   it('leaves an untranslated row exactly as it came in', () => {
 72:     const problems: string[] = [];
 73:     const pack = buildWordsPack([row(1, 'Welcome.')], {}, 'windows-1251', problems);
 74: 
 75:     expect(problems).toEqual([]);
 76:     // ASCII survives every code page, which is why the pass-through is safe
 77:     // for the 2230 rows that have no translation.
 78:     expect(readBack(pack, 'windows-1251').get(1)).toBe('Welcome.');
 79:   });
 80: 
 81:   it('round-trips a code page the text actually needs', () => {
 82:     const problems: string[] = [];
 83:     const text = 'Зона битвы';
 84:     const pack = buildWordsPack([row(8, 'Battle zone')], { 8: text }, 'windows-1251', problems);
 85: 
 86:     expect(problems).toEqual([]);
 87:     expect(readBack(pack, 'windows-1251').get(8)).toBe(text);
 88:   });
 89: 
 90:   it('keeps the line breaks the window splits on', () => {
 91:     const problems: string[] = [];
 92:     const text = 'Willkommen in der Welt von MU.;Wir haben gewartet.';
 93:     const pack = buildWordsPack([row(1, 'x')], { 1: text }, 'windows-1252', problems);
 94: 
 95:     expect(problems).toEqual([]);
 96:     const back = readBack(pack, 'windows-1252').get(1);
 97:     expect(back).toBe(text);
 98:     expect(back?.split(';')).toHaveLength(2);
 99:   });
100: 
101:   it('reports a translation the code page cannot hold instead of mangling it', () => {
102:     const problems: string[] = [];
103:     // Cyrillic has no place in windows-1252.
104:     buildWordsPack([row(1, 'x')], { 1: 'Подземелье' }, 'windows-1252', problems);
105: 
106:     expect(problems).toHaveLength(1);
107:     expect(problems[0]).toContain('1:');
108:   });
109: 
110:   it('carries an untranslated non-ASCII row across as characters, not bytes', () => {
111:     const problems: string[] = [];
112:     // 0xa2 is `¢` in windows-1252: part of the CP949 mojibake the English
113:     // table already carries. Passed through as a raw byte it would be invalid
114:     // UTF-8; transcoded it stays the character English shows.
115:     const damaged: WordRow = { index: 5, body: new Uint8Array([0x61, 0xa2, 0x62, 0x00]) };
116:     const pack = buildWordsPack([damaged], {}, 'utf-8', problems);
117: 
118:     expect(problems).toEqual([]);
119:     expect(readBack(pack, 'utf-8').get(5)).toBe('a¢b');
120:   });
121: 
122:   it('substitutes rather than throws when a damaged row will not fit the page', () => {
123:     const problems: string[] = [];
124:     const damaged: WordRow = { index: 5, body: new Uint8Array([0x61, 0xa2, 0x62, 0x00]) };
125:     const pack = buildWordsPack([damaged], {}, 'windows-1251', problems);
126: 
127:     // windows-1251 has no `¢`; the row is already mojibake, so a question mark
128:     // is the right outcome and not a build failure.
129:     expect(problems).toEqual([]);
130:     expect(readBack(pack, 'windows-1251').get(5)).toBe('a?b');
131:   });
132: });
</file>

<file path="tools/questWords.ts">
  1: /**
  2:  * Writes `Data/Local/<pack>/QuestWords_<lang>.bmd` for the generated language
  3:  * packs: the lines every NPC speaks and every answer the player picks.
  4:  *
  5:  * `QuestWords` is one flat table of 2288 numbered strings. The Season 6 NPC
  6:  * talk window (`CNewUINPCDialogue`) does not use all of them - it shows the
  7:  * ones `NPCDialogue.bmd` points at, the NPC's line on each page and its
  8:  * answers, which is 58 entries. Those are translated, in
  9:  * `packs/questWords.json`. The remaining 2230 are quest-log prose (a quarter of
 10:  * a million characters of it) and are written out in English.
 11:  *
 12:  * **The whole table is written even so**, because `localDataCandidates` falls
 13:  * back *per file*: a pack that ships no `QuestWords_<lang>.bmd` reads the
 14:  * English one entire, so there is no way to translate part of it except to
 15:  * emit the file with English in the untranslated rows. Adding a translation
 16:  * later means adding it to the JSON and running this again.
 17:  *
 18:  * ## Running it
 19:  *
 20:  * ```
 21:  * node tools/questWords.ts             # every language
 22:  * node tools/questWords.ts --only rus
 23:  * ```
 24:  *
 25:  * node rather than bun, for the same reason `localPacks.ts` says: bun's
 26:  * `TextDecoder` has no windows-1250 or windows-1251.
 27:  *
 28:  * Record layout, matching `readQuestWords` in `libs/mu/questFiles.ts`:
 29:  * `{int32 index; int16 length}` then `length` bytes of text, each part
 30:  * XOR-ed with the 3-byte Bux key **restarting at each part** - the header and
 31:  * the body are two separate `BuxConvert` calls, not one across both.
 32:  */
 33: 
 34: import { mkdirSync, readFileSync, writeFileSync } from 'fs';
 35: import { dirname, resolve } from 'path';
 36: import { fileURLToPath } from 'url';
 37: import { encoderFor } from './localPacks.ts';
 38: 
 39: const HERE = dirname(fileURLToPath(import.meta.url));
 40: const DATA = resolve(HERE, '..', 'Data', 'Local');
 41: 
 42: const BUX_KEY = [0xfc, 0xcf, 0xab];
 43: const HEADER_SIZE = 6;
 44: 
 45: /** Folder, file suffix and code page per language, as the layers declare. */
 46: const PACKS: Record<string, { folder: string; encoding: string }> = {
 47:   ger: { folder: 'Ger', encoding: 'windows-1252' },
 48:   fre: { folder: 'Fre', encoding: 'windows-1252' },
 49:   ita: { folder: 'Ita', encoding: 'windows-1252' },
 50:   rom: { folder: 'Rom', encoding: 'windows-1250' },
 51:   rus: { folder: 'Rus', encoding: 'windows-1251' },
 52:   bul: { folder: 'Bul', encoding: 'windows-1251' },
 53:   chi: { folder: 'Chi', encoding: 'utf-8' },
 54:   jpn: { folder: 'Jpn', encoding: 'utf-8' },
 55:   kor: { folder: 'Kor', encoding: 'utf-8' },
 56:   tha: { folder: 'Tha', encoding: 'windows-874' },
 57: };
 58: 
 59: function bux(buffer: Uint8Array): void {
 60:   for (let i = 0; i < buffer.length; i++) buffer[i] ^= BUX_KEY[i % 3];
 61: }
 62: 
 63: /** One row of the shipped English table: its number and its decrypted bytes. */
 64: export type WordRow = { index: number; body: Uint8Array };
 65: 
 66: /**
 67:  * The English table in file order, each row's body kept as **bytes** rather
 68:  * than as a string.
 69:  *
 70:  * 78 of the 2288 rows carry CP949 double-byte text that was read as
 71:  * windows-1252 somewhere before this tree got it, so they are already mojibake
 72:  * in the English client ("Gens dispute¡¦?"). Decoding and re-encoding those
 73:  * into windows-1250 or windows-1251 fails outright - `¢` has no place in
 74:  * either. Carrying the bytes through means an untranslated row is byte for
 75:  * byte the row the English file holds, which renders exactly as the English
 76:  * client renders it and invents no new damage.
 77:  */
 78: export function readEnglishWords(): WordRow[] {
 79:   const buffer = new Uint8Array(
 80:     readFileSync(resolve(DATA, 'Eng', 'QuestWords_eng.bmd'))
 81:   );
 82:   const rows: WordRow[] = [];
 83:   let offset = 0;
 84: 
 85:   while (offset + HEADER_SIZE <= buffer.length) {
 86:     const header = buffer.slice(offset, offset + HEADER_SIZE);
 87:     bux(header);
 88:     const view = new DataView(header.buffer, header.byteOffset, header.byteLength);
 89:     const index = view.getInt32(0, true);
 90:     const length = view.getInt16(4, true);
 91:     offset += HEADER_SIZE;
 92: 
 93:     if (length < 0 || offset + length > buffer.length) break;
 94: 
 95:     const body = buffer.slice(offset, offset + length);
 96:     bux(body);
 97:     rows.push({ index, body });
 98:     offset += length;
 99:   }
100: 
101:   return rows;
102: }
103: 
104: const LATIN1 = new TextDecoder('windows-1252');
105: 
106: /**
107:  * One untranslated row's windows-1252 bytes, re-encoded for this pack.
108:  *
109:  * These 78 rows are CP949 read as windows-1252 before the tree got them, so
110:  * they are mojibake in English too ("Movement in the ¢Ø or ¢Ù direction").
111:  * Nothing here can recover the arrows they were; the goal is only that they
112:  * read no *worse* than in English. A character the pack's code page has no
113:  * room for becomes a question mark, which beats dropping the row or throwing
114:  * over text that was already damaged upstream.
115:  */
116: function transcode(bytes: Uint8Array, encode: (text: string) => Uint8Array): Uint8Array {
117:   let end = bytes.indexOf(0);
118:   if (end < 0) end = bytes.length;
119: 
120:   const out: number[] = [];
121:   for (const char of LATIN1.decode(bytes.subarray(0, end))) {
122:     try {
123:       out.push(...encode(char));
124:     } catch {
125:       out.push(0x3f);                    // '?'
126:     }
127:   }
128: 
129:   return new Uint8Array(out);
130: }
131: 
132: export function buildWordsPack(
133:   rows: WordRow[],
134:   translations: Record<string, string>,
135:   encoding: string,
136:   problems: string[]
137: ): Uint8Array {
138:   const encode = encoderFor(encoding);
139:   const parts: Uint8Array[] = [];
140: 
141:   for (const row of rows) {
142:     const text = translations[String(row.index)];
143: 
144:     // No translation: the English bytes ride through untouched, terminator
145:     // and all, so the row is identical to the one the English file holds.
146:     let body = row.body;
147:     let length = row.body.length;
148: 
149:     if (text !== undefined) {
150:       try {
151:         body = encode(text);
152:         // The reader takes `length` as the field width and stops at a NUL
153:         // inside it, so the terminator has to be counted in.
154:         length = body.length + 1;
155:       } catch (err) {
156:         problems.push(`${row.index}: ${(err as Error).message}`);
157:       }
158:     } else if (row.body.some(b => b > 0x7f)) {
159:       // An untranslated row with high bytes cannot ride through: those bytes
160:       // are windows-1252, and a pack read as UTF-8 turns every one of them
161:       // into a replacement character. Carry the characters instead of the
162:       // bytes, so the row reads the way the English client reads it.
163:       body = transcode(row.body, encode);
164:       length = body.length + 1;
165:     }
166: 
167:     const record = new Uint8Array(HEADER_SIZE + length);
168:     const header = record.subarray(0, HEADER_SIZE);
169:     const view = new DataView(header.buffer, header.byteOffset, HEADER_SIZE);
170: 
171:     view.setInt32(0, row.index, true);
172:     view.setInt16(4, length, true);
173:     bux(header);
174: 
175:     const payload = record.subarray(HEADER_SIZE);
176:     payload.set(body);
177:     bux(payload);                        // the body is its own Bux run
178: 
179:     parts.push(record);
180:   }
181: 
182:   const total = parts.reduce((n, p) => n + p.length, 0);
183:   const out = new Uint8Array(total);
184:   let at = 0;
185:   for (const p of parts) {
186:     out.set(p, at);
187:     at += p.length;
188:   }
189: 
190:   return out;
191: }
192: 
193: export function buildAll(only: string | null): void {
194:   const table = JSON.parse(
195:     readFileSync(resolve(HERE, 'packs', 'questWords.json'), 'utf8')
196:   ) as Record<string, Record<string, string>>;
197: 
198:   const rows = readEnglishWords();
199:   const langs = Object.keys(PACKS).filter(l => !only || l === only);
200:   if (only && !langs.length) throw new Error(`No pack for '${only}'`);
201: 
202:   for (const lang of langs) {
203:     const { folder, encoding } = PACKS[lang];
204:     const translations: Record<string, string> = {};
205: 
206:     for (const [index, row] of Object.entries(table)) {
207:       if (index === '_') continue;
208:       if (row[lang]) translations[index] = row[lang];
209:     }
210: 
211:     const problems: string[] = [];
212:     const bytes = buildWordsPack(rows, translations, encoding, problems);
213: 
214:     if (problems.length) {
215:       throw new Error(`${folder}:\n  ${problems.join('\n  ')}`);
216:     }
217: 
218:     const dir = resolve(DATA, folder);
219:     mkdirSync(dir, { recursive: true });
220:     writeFileSync(resolve(dir, `QuestWords_${lang}.bmd`), bytes);
221: 
222:     console.log(
223:       `${folder}  ${rows.length} entries, ${Object.keys(translations).length} translated ` +
224:         `-> QuestWords_${lang}.bmd`
225:     );
226:   }
227: }
228: 
229: if (process.argv[1] && fileURLToPath(import.meta.url) === resolve(process.argv[1])) {
230:   const at = process.argv.indexOf('--only');
231:   buildAll(at > 0 ? process.argv[at + 1] : null);
232: }
</file>

