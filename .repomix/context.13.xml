 43: const DELETE = { x: 142, y: FOOT.top + 36 };
 44: 
 45: const TEXT_COLOR = '#c8bfae';
 46: const ACTIVE_COLOR = '#ffffff';
 47: 
 48: export const V097dCharactersPage = observer(() => {
 49:   const [deleting, setDeleting] = useState(false);
 50:   const [code, setCode] = useState('');
 51: 
 52:   useEffect(() => {
 53:     Store.refreshCharactersListRequest();
 54:   }, []);
