 18: /**
 19:  * The weather layer: everything that falls from the sky or is left behind on
 20:  * the ground, behind one object. Copy `_template.ts` when adding to it.
 21:  *
 22:  * The game talks to `weather.update` once a frame and `weather.reset` on a
 23:  * map change; both fan out over `WEATHER_LAYERS` (`layers.ts`), which is the
 24:  * only list of effects in the codebase. The readers below are the facade's
 25:  * public surface for consumers that want the whole weather from one import;
 26:  * every effect file stays importable directly for anything that needs a
 27:  * single function.
 28:  */
 29: class Weather {
 30:   private readonly layers: WeatherLayer[] = [...WEATHER_LAYERS];
 31: 
 32:   /** Add an effect at runtime (tools, experiments). Returns the unregister. */
 33:   register(layer: WeatherLayer): () => void {
 34:     this.layers.push(layer);
 35:     return () => {
 36:       const i = this.layers.indexOf(layer);
 37:       if (i >= 0) this.layers.splice(i, 1);
 38:     };
 39:   }
 40: 
 41:   /** Every effect that exists on this map. */
 42:   layersFor(map: ENUM_WORLD): WeatherLayer[] {
 43:     return this.layers.filter(l => !l.maps || l.maps.has(map));
 44:   }
 45: 
 46:   /** Step every layer. Call once a frame, before anything reads the weather. */
 47:   update(map: ENUM_WORLD, dt: number): void {
 48:     for (const layer of this.layers) layer.update?.(map, dt);
 49:   }
 50: 
 51:   /** Drop every layer's state. Call when the map changes. */
 52:   reset(): void {
 53:     for (const layer of this.layers) layer.reset?.();
 54:   }
