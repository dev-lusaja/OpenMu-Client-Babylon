<file path="versions/v097d/ui/pregame/charactersPage.tsx">
  1: /**
  2:  * The 0.97d character screen: the `Logo/0New_Account01.OZT` plate with the
  3:  * `0New_Account02.OZT` foot under it, drawn over the ship scene.
  4:  *
  5:  * Deferred, and stated in the PR: the 3D actors on the deck, and character
  6:  * creation. The actors need `world.terrain`, which a set-piece backdrop does
  7:  * not have (`RenderSystem` and `ModelLoaderSystem` both bail on it), so the
  8:  * roster is the list rather than five figures to click; creation is the
  9:  * `Card01..04` / `Face01..04` carousel, a screen of its own.
 10:  */
 11: import { observer } from 'mobx-react-lite';
 12: import { useEffect, useState } from 'react';
 13: import { runInAction } from 'mobx';
 14: import { t } from '../../../../src/i18n';
 15: import { uiClick } from '../../../../src/libs/sfx';
