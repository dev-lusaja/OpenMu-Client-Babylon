131: /** Snowfall is slower to arrive and outstays a gust. */
132: const SNOW_SQUALLS: AmbientSchedule = {
133:   key: 'snowSquall',
134:   period: 90,
135:   chance: 0.8,
136:   duration: [55, 90],
137:   strength: [0.35, 1],
138:   ramp: 9,
