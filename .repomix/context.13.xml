176:   if (x0 < r.x0) r.x0 = x0;
177:   if (z0 < r.z0) r.z0 = z0;
178:   if (x1 > r.x1) r.x1 = x1;
179:   if (z1 > r.z1) r.z1 = z1;
180: };
181: 
182: /** A fire front: where it started, how far it has got, how much is left. */
183: type Fire = {
184:   x: number;
185:   z: number;
186:   /** Tiles from the centre the flame edge has reached. */
187:   radius: number;
188:   /** Tiles already burnt; the annulus between the two is what gets stamped. */
189:   burnt: number;
190:   vigour: number;
191:   sinceEmber: number;
192:   /** Phases of this fire's own lobes; see `reach`. */
193:   p1: number;
194:   p2: number;
195:   p3: number;
196: };
197: 
198: /**
199:  * How far this fire has got in a given direction, as a fraction of its radius.
200:  *
201:  * A fire does not spread as a circle. Ours did, so every scar was a disc and a
202:  * fight left a row of identical coins on the field - the one thing that says
203:  * "stamped" rather than "burned".
204:  *
205:  * Three harmonics with the fire's own phases: the second gives it a long axis,
206:  * the third and fifth break that up into lobes. Smooth, seamless at the wrap
207:  * because they are all periodic in the angle, and no texture or noise lookup -
208:  * the shape is three sines of a number the loop already has.
209:  */
210: function reach(fire: Fire, angle: number): number {
211:   return (
212:     1 +
213:     LOBE_2 * Math.sin(angle * 2 + fire.p1) +
214:     LOBE_3 * Math.sin(angle * 3 + fire.p2) +
215:     LOBE_5 * Math.sin(angle * 5 + fire.p3)
216:   );
217: }
