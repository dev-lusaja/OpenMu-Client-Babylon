 1: /**
 2:  * TEMPLATE - copy this file to `<name>.ts`, fill in the blanks, add the layer
 3:  * to `layers.ts`. Never imported; it only exists to be copied.
 4:  *
 5:  * Every effect file has the same three parts, in this order:
 6:  *
 7:  *   1. Tuning constants at the top, each with a comment saying what it is in
 8:  *      real units (seconds, tiles, 0…1) and why it has that value.
 9:  *   2. Module state + the functions that read it. State lives here, not in
10:  *      the facade, and readers are plain functions (`fooStrength()`).
11:  *   3. The exported `WeatherLayer` at the bottom, wiring `update` / `reset`.
12:  *
13:  * If the effect touches the ground, add a `TerrainOverlay` recipe in
14:  * `libs/mu/terrainOverlay.ts` whose `coverage` reads this file's reader.
15:  * If it falls from the sky, add an `AmbientRecipe` in `ambientWeather.ts`.
16:  * If it makes a sound, add a bed row in `../sound/ambientBeds.ts`.
17:  */
18: import { ENUM_WORLD } from '../common/types';
19: import type { WeatherLayer } from './layer';
20: 
21: // ---- 1. tuning -------------------------------------------------------------
22: 
23: /** Seconds from nothing to full strength. */
24: const BUILD_SECONDS = 30;
25: 
26: /** Seconds from full strength back to nothing once the cause stops. */
27: const FADE_SECONDS = 60;
28: 
29: /** Maps this exists on. */
30: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([ENUM_WORLD.WD_0LORENCIA]);
31: 
32: // ---- 2. state + readers ----------------------------------------------------
33: 
34: let strength = 0;
35: 
36: /** How much of the effect is present right now, 0…1. */
37: export function templateStrength(): number {
38:   return strength;
39: }
40: 
41: function update(map: ENUM_WORLD, dt: number): void {
42:   if (!MAPS.has(map)) {
43:     strength = 0;
44:     return;
45:   }
46: 
47:   // Replace with whatever drives this effect: a packet, a schedule, a map.
48:   const active = false;
49: 
50:   strength = active
51:     ? Math.min(1, strength + dt / BUILD_SECONDS)
52:     : Math.max(0, strength - dt / FADE_SECONDS);
53: }
54: 
55: function reset(): void {
56:   strength = 0;
57: }
58: 
59: // ---- 3. the layer ----------------------------------------------------------
60: 
61: export const templateLayer: WeatherLayer = {
62:   name: 'template',
63:   maps: MAPS,
64:   update,
65:   reset,
66: };
