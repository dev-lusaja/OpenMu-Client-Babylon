<file path="versions/registry.ts">
 1: /**
 2:  * THE REGISTRY of game versions this client ships. One build carries every
 3:  * entry; exactly one is active per page load, picked at runtime from the
 4:  * server-list entry (src/version/index.ts `loadGameVersion`).
 5:  *
 6:  * Entry metadata (`id`, `label`, `listTag`) is eager so the server picker
 7:  * can answer "can this client play that world?" without loading a version
 8:  * body; the bodies come in through the two dynamic imports, each its own
 9:  * chunk, so a version the player never touches is never fetched.
10:  *
11:  * Invariant: a version's `index.ts` (the `load()` module) must import only
12:  * the contract, generated packet files and its own data - never app code.
13:  * App modules read `gameVersion` at module scope, so they may evaluate only
14:  * after `load()` resolved; version UI reaches app code, which is why it
15:  * sits behind the separate `loadUi()`.
16:  */
17: import type { GameVersion, GameVersionId } from '../src/version/contract';
18: import type { VersionUi } from '../src/version/uiContract';
19: 
20: /**
21:  * The three packet lists a version exports. Typed against the season6 set
22:  * for now; step (b) widens these to a union of the shipped versions' lists
23:  * so the EventBus keeps literal packet-name keys for all of them.
24:  */
25: export type VersionPackets = {
26:   ServerToClientPackets: typeof import('./season6/packets')['ServerToClientPackets'];
27:   ClientToServerPackets: typeof import('./season6/packets')['ClientToServerPackets'];
28:   ConnectServerPackets: typeof import('./season6/packets')['ConnectServerPackets'];
29:   ChangeMapServerInfoPacket: typeof import('./season6/packets')['ChangeMapServerInfoPacket'];
30: };
31: 
32: /** What `versions/<id>/index.ts` exports. */
33: export type VersionModule = {
34:   gameVersion: GameVersion;
35:   packets: VersionPackets;
36: };
37: 
38: export type { VersionUi };
39: 
40: export type VersionEntry = {
41:   readonly id: GameVersionId;
42:   /** Human label for pickers and logs. Must match the module's `gameVersion.label`. */
43:   readonly label: string;
44:   /** The token a published server line leads with. Must match `gameVersion.listTag`. */
45:   readonly listTag: string;
46:   readonly load: () => Promise<VersionModule>;
47:   readonly loadUi: () => Promise<VersionUi>;
48: };
49: 
50: export const DEFAULT_VERSION_ID: GameVersionId = 'season6';
51: 
52: export const VERSION_REGISTRY: readonly VersionEntry[] = [
53:   {
54:     id: 'season6',
55:     label: 'Season 6 Episode 3',
56:     listTag: 'S6EP3',
57:     load: () => import('./season6'),
58:     loadUi: () => import('./season6/ui'),
59:   },
60:   {
61:     id: 'v097d',
62:     label: 'MU 0.97d',
63:     listTag: 'V097D',
64:     load: () => import('./v097d'),
65:     loadUi: () => import('./v097d/ui'),
66:   },
67: ];
</file>

