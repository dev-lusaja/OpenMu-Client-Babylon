 1: import { unlinkSync } from 'node:fs';
 2: import { Glob } from 'bun';
 3: import { DATA_FOLDER, JPG_EXT, OZJ_EXT } from './shared';
 4: 
 5: const glob = new Glob(`**/*{${OZJ_EXT.toUpperCase()},${OZJ_EXT}}`);
 6: 
 7: let counter = 0;
 8: for (const ozjFileName of glob.scanSync(DATA_FOLDER)) {
 9:   console.log(`Processing ${ozjFileName}`);
10: 
11:   const ozjFilePath = DATA_FOLDER + ozjFileName;
12: 
13:   const jpgFilePath =
14:     ozjFilePath.substring(0, ozjFilePath.length - 4) + JPG_EXT;
15: 
16:   const ozjFile = Bun.file(ozjFilePath);
17:   const buffer = new Uint8Array(await ozjFile.arrayBuffer());
18:   const jpegBuffer = buffer.slice(24); // remove first 24 bytes as it is a OZJ header
19: 
20:   try {
21:     //remove old file
22:     unlinkSync(jpgFilePath);
23:   } catch (e) {}
24: 
25:   const jpgFile = Bun.file(jpgFilePath);
26:   const writer = jpgFile.writer();
27:   writer.write(jpegBuffer);
28:   writer.end();
29:   counter++;
30: }
31: 
32: console.log(`Processed ${counter} files!`);
</file>

