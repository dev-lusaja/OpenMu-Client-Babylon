1500: function ensurePool(scene: Scene, kind: PrintKind, lane: PrintLane): Pool {
1501:   const key = poolKey(kind, lane);
1502:   const existing = pools.get(key);
1503:   if (existing && !existing.mesh.isDisposed() && existing.mesh.getScene() === scene) {
1504:     return existing;
1505:   }
1506: 
1507:   const size = POOL[lane];
1508:   const plane = CreatePlane(`_footprints_${kind}_${lane}`, { size: 1 }, scene);
1509:   // Babylon's plane faces +Z; the ground is the XZ plane, so tip it flat.
1510:   plane.rotation.x = Math.PI / 2;
1511:   plane.bakeCurrentTransformIntoVertices();
1512:   plane.isPickable = false;
1513:   plane.alwaysSelectAsActiveMesh = true;
1514:   plane.doNotSyncBoundingInfo = true;
1515: 
1516:   const matrixData = new Float32Array(size * 16);
1517:   const colourData = new Float32Array(size * 4);
1518: 
1519:   const prints: Print[] = [];
1520:   for (let i = 0; i < size; i++) {
1521:     prints.push({
1522:       age: -1,
1523:       life: 1,
1524:       strength: 0,
1525:       kind,
1526:       shape: 'boot',
1527:       matrix: Matrix.Identity(),
1528:       atlasU: 0,
1529:       atlasV: 0,
1530:       shade: 1,
1531:     });
1532:   }
1533: 
1534:   plane.thinInstanceSetBuffer('matrix', matrixData, 16, false);
1535:   plane.thinInstanceSetBuffer('color', colourData, 4, false);
1536:   plane.thinInstanceCount = size;
1537: 
1538:   // After the buffers: the material's defines are decided from what the mesh
1539:   // has, and INSTANCESCOLOR only appears once the colour buffer is registered.
1540:   plane.material = materialFor(scene, kind);
1541:   plane.setEnabled(false);
1542: 
1543:   const pool: Pool = {
1544:     mesh: plane,
1545:     matrixData,
1546:     colourData,
1547:     prints,
1548:     size,
1549:     next: 0,
1550:     dirty: true,
1551:   };
1552: 
1553:   pools.set(key, pool);
1554: 
1555:   return pool;
1556: }
