50:   id: '_template', // TODO: folder name
51:   label: 'TODO',
52:   // TODO: the token published server lines lead with, e.g. 'S6EP3'. Short,
53:   // unspaced and carrying a digit, or `serverList.ts` will not read it as one.
54:   listTag: 'V0.0',
55:   openMu: { season: 0, episode: 0, initializer: 'TODO', versionArg: 'TODO' },
56:   clientVersionBytes: asciiBytes('00000'), // TODO
57:   serialBytes: asciiBytes('0000000000000000'), // TODO
58:   protocol: {
59:     packetSet: 'season6', // TODO
60:     variantRank,
61:     encryption: {
62:       clientToServer: CLIENT_TO_SERVER_KEYS,
63:       serverToClient: SERVER_TO_CLIENT_KEYS,
64:       xor32Key: XOR32_KEY,
65:       xor3Key: XOR3_KEY,
66:     },
67:   },
68:   data: templateData,
69:   // TODO: one line per flag, with the season it appeared in as the reason.
70:   features: {
71:     masterSkills: false,
72:     socketItems: false,
73:     ancientItems: false,
74:     harmonyJewel: false,
75:     darkLord: false,
76:     magicGladiator: false,
