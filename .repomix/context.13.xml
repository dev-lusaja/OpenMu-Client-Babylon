 1: import {
 2:   MONSTER_MODEL_TABLE,
 3:   monsterModelFile,
 4: } from '../src/common/monsters/monsterModelTable';
 5: import {
 6:   NPC_MODEL_TABLE,
 7:   npcModelFile,
 8: } from '../src/common/npcs/npcModelTable';
 9: 
10: /**
11:  * The original `Data/` tree spells one model family three ways -
12:  * `Monster100.bmd`, `monster105.bmd`, `MONSTER158.bmd` - and the converter
13:  * used to carry the source spelling straight into `public/game-assets`. The
14:  * client builds its request from its own tables (`Monster/Monster105.glb`), so
15:  * every oddly spelled model 404s on a case-sensitive host and the loader
16:  * stands a magenta box in its place. Windows never showed it.
17:  *
18:  * Conversion runs every output path through `canonicalAssetPath`, so the file
19:  * on disk is spelled the way the client asks for it regardless of how the
20:  * source BMD was spelled.
21:  */
22: 
23: /** Paths the client builds from a table, keyed by their lower-case form. */
24: const FROM_TABLES = new Map<string, string>();
25: 
26: for (const entry of Object.values(MONSTER_MODEL_TABLE)) {
27:   const path = monsterModelFile(entry[0]);
28:   FROM_TABLES.set(path.toLowerCase(), path);
29: }
30: 
31: for (const entry of Object.values(NPC_MODEL_TABLE)) {
32:   const path = npcModelFile(entry[0]);
33:   FROM_TABLES.set(path.toLowerCase(), path);
34: }
35: 
36: /**
37:  * Families the client numbers by rule instead of listing: the map object
38:  * folders and files (`Object<world>/Object<nn>.glb`, mapTileObject.ts and
39:  * operateBoxObject.ts), the monster models, and the terrain folders.
40:  */
41: const NUMBERED = [/^object(\d+)$/, /^monster(\d+)$/, /^world(\d+)$/];
42: 
43: const CAPITALS: Record<string, string> = {
44:   object: 'Object',
45:   monster: 'Monster',
46:   world: 'World',
47: };
48: 
49: function canonicalSegment(segment: string): string {
50:   const dot = segment.lastIndexOf('.');
51:   const stem = dot > 0 ? segment.slice(0, dot) : segment;
52:   const ext = dot > 0 ? segment.slice(dot) : '';
53:   const lower = stem.toLowerCase();
54: 
55:   for (const rule of NUMBERED) {
56:     const match = lower.match(rule);
57:     if (match)
58:       return CAPITALS[lower.slice(0, -match[1].length)] + match[1] + ext;
59:   }
60: 
61:   return segment;
62: }
63: 
64: /** `rel` is relative to the asset root, with `/` separators. */
65: export function canonicalAssetPath(rel: string): string {
66:   const fromTable = FROM_TABLES.get(rel.toLowerCase());
67:   if (fromTable) return fromTable;
68: 
69:   return rel.split('/').map(canonicalSegment).join('/');
70: }
71: 
72: /** Every model path the client asks for, in the case it asks for it. */
73: export function expectedModelPaths(): string[] {
74:   return [...FROM_TABLES.values()].sort();
75: }
</file>

