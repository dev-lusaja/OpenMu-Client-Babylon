195:   const modelTop = modelDir.slice(0, modelDir.indexOf('/')).toLowerCase();
196:   const ordered = [...paths].sort((a, b) => {
197:     const ka = pickOrder(a, modelTop);
198:     const kb = pickOrder(b, modelTop);
199: 
200:     for (let i = 0; i < 3; i++) {
201:       if (ka[i] !== kb[i]) return (ka[i] as number) - (kb[i] as number);
202:     }
