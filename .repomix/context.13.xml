 22: import { MuSpriteFrame } from '../../../../src/ui/components/muSprite';
 23: import { MuButton } from '../../../../src/ui/components/muButton';
 24: import './style.less';
 25: 
 26: const PLATE = { file: 'Data/Logo/0New_Account01.OZT', width: 256, height: 256 };
 27: 
 28: const FOOT = {
 29:   file: 'Data/Logo/0New_Account02.OZT',
 30:   width: 256,
 31:   height: 77,
 32:   top: 256,
 33: };
 34: 
 35: const BUTTON = { file: 'Data/Logo/0On_Botton.OZJ', width: 70, height: 19 };
