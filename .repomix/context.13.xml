<file path="tools/addRageFighterColumn.ts">
  1: // Adds the `RF` class column to `src/common/items.json`.
  2: //
  3: // `Item.txt` carries six class columns - DW/SM, DK/BK, Elf/ME, MG, DL, SUM -
  4: // and no Rage Fighter one; its header and every data row line up at 29 fields,
  5: // so nothing was lost in conversion, the table simply predates the class.
  6: // Without a seventh column `classOf` had no index for him and `classCanUse`
  7: // refused him every class-gated item, orbs and scrolls included.
  8: //
  9: // The values come from the server this client talks to. Every item-creation
 10: // call in OpenMU's Season 6 initializers ends with the same class block in the
 11: // same order, one entry longer:
 12: //
 13: //   CreateWeapon(..., wizard, knight, elf, magicGladiator, darkLord, summoner, ragefighter)
 14: //
 15: // so the six we already have are the check: a row only takes the seventh value
 16: // when the other six agree exactly. Rows that disagree (this Item.txt is an
 17: // older Season 6 variant than OpenMU's data - mostly Summoner gear, where it
 18: // sets DW/SM as well) and rows OpenMU has no definition for keep `RF: 0`; none
 19: // of them carries a non-zero Rage Fighter level anyway, which the run reports.
 20: //
 21: // `CreateGloves` has no ragefighter parameter at all on the server
 22: // (ArmorInitializerBase.cs:234), so it can only ever answer 0 for group 10 -
 23: // even for the sets whose other four pieces are plainly his. Item.txt has no
 24: // Rage Fighter column either, so neither source can settle it, and the client
 25: // showed the Leather, Scale, Brass and Plate sets as four pieces out of five
 26: // for him (Ignies/OpenMu-Client-Babylon#204).
 27: //
 28: // One rule closes it, and only that one: a glove whose own helm, armour, pants
 29: // and boots the server all marks his at the same level is his at that level.
 30: // Nothing is invented for a set that does not already agree with itself, so
 31: // this moves exactly four rows and goes away on its own if the server ever
 32: // grows the parameter.
 33: //
 34: // Run after `convertItemTXTtoJson.ts`, which rewrites items.json from scratch
 35: // and would drop the column:
 36: //
 37: //   bun run tools/addRageFighterColumn.ts [--openmu <path>] [--dry]
 38: 
 39: const args = process.argv.slice(2);
 40: const flag = (name: string, fallback: string) => {
 41:   const i = args.indexOf(name);
 42:   return i >= 0 && args[i + 1] ? args[i + 1] : fallback;
 43: };
 44: const dry = args.includes('--dry');
 45: const openmuRoot = flag(
 46:   '--openmu',
 47:   '../OpenMU/OpenMU-master/src/Persistence/Initialization'
 48: );
 49: const itemsPath = 'src/common/items.json';
 50: 
 51: const SOURCES = [
 52:   'VersionSeasonSix/Items/Weapons.cs',
 53:   'VersionSeasonSix/Items/Armors.cs',
 54:   'VersionSeasonSix/Items/Wings.cs',
 55:   'VersionSeasonSix/Items/Orbs.cs',
 56:   'VersionSeasonSix/Items/Scrolls.cs',
 57: ];
 58: 
 59: /** Where each helper's class block starts, and how the row is addressed. */
 60: type Spec = {
 61:   argc: number;
 62:   group: (a: string[]) => number;
 63:   index: (a: string[]) => number;
 64:   classAt: number;
 65:   hasRf: boolean;
 66: };
 67: 
 68: const SPECS: Record<string, Spec[]> = {
 69:   CreateWeapon: [{ argc: 26, group: a => +a[0], index: a => +a[1], classAt: 19, hasRf: true }],
 70:   CreateShield: [{ argc: 23, group: () => 6, index: a => +a[0], classAt: 16, hasRf: true }],
 71:   // `slot` is the equipment slot; the item group is five higher (helm 2 -> 7).
 72:   CreateArmor: [{ argc: 21, group: a => +a[1] + 5, index: a => +a[0], classAt: 14, hasRf: true }],
 73:   CreateBoots: [{ argc: 19, group: () => 11, index: a => +a[0], classAt: 12, hasRf: true }],
 74:   CreateGloves: [{ argc: 15, group: () => 10, index: a => +a[0], classAt: 9, hasRf: false }],
 75:   CreateWing: [
 76:     { argc: 16, group: () => 12, index: a => +a[0], classAt: 8, hasRf: true },
 77:     { argc: 20, group: () => 12, index: a => +a[0], classAt: 8, hasRf: true },
 78:     { argc: 21, group: () => 12, index: a => +a[0], classAt: 8, hasRf: true },
 79:   ],
 80:   CreateOrb: [{ argc: 18, group: () => 12, index: a => +a[0], classAt: 11, hasRf: true }],
 81:   CreateScroll: [{ argc: 14, group: () => 15, index: a => +a[0], classAt: 7, hasRf: true }],
 82: };
 83: 
 84: const SIX = ['DW/SM', 'DK/BK', 'Elf/ME', 'MG', 'DL', 'SUM'] as const;
 85: const BACKSLASH = String.fromCharCode(92);
 86: 
 87: function splitArgs(s: string): string[] {
 88:   const out: string[] = [];
 89:   let depth = 0;
 90:   let cur = '';
 91:   let inStr = false;
 92:   for (let i = 0; i < s.length; i++) {
 93:     const c = s[i];
 94:     if (inStr) {
 95:       cur += c;
 96:       if (c === '"' && s[i - 1] !== BACKSLASH) inStr = false;
 97:       continue;
 98:     }
 99:     if (c === '"') { inStr = true; cur += c; continue; }
100:     if (c === '(' || c === '[') depth++;
101:     if (c === ')' || c === ']') depth--;
102:     if (c === ',' && depth === 0) { out.push(cur.trim()); cur = ''; continue; }
103:     cur += c;
104:   }
105:   if (cur.trim()) out.push(cur.trim());
106:   return out;
107: }
108: 
109: type Call = { helper: string; args: string[] };
110: 
111: function callsIn(text: string): Call[] {
112:   const out: Call[] = [];
113:   const re = /this\.(Create\w+)\s*\(/g;
114:   let m: RegExpExecArray | null;
115:   while ((m = re.exec(text))) {
116:     // Skip the "Replace by:" regex templates in the doc comments.
117:     const lineStart = text.lastIndexOf('\n', m.index) + 1;
118:     if (text.slice(lineStart, m.index).includes('///')) continue;
119: 
120:     let i = re.lastIndex;
121:     let depth = 1;
122:     let inStr = false;
123:     while (i < text.length && depth > 0) {
124:       const c = text[i];
125:       if (inStr) { if (c === '"' && text[i - 1] !== BACKSLASH) inStr = false; }
126:       else if (c === '"') inStr = true;
127:       else if (c === '(') depth++;
128:       else if (c === ')') depth--;
129:       i++;
130:     }
131:     out.push({ helper: m[1], args: splitArgs(text.slice(re.lastIndex, i - 1)) });
132:   }
133:   return out;
134: }
135: 
136: const items: Record<string, number | string>[] = await Bun.file(itemsPath).json();
137: const rowOf = (g: number, i: number) =>
138:   items.find(r => r.Group === g && r.Index === i);
139: 
140: const isInt = (s: string) => /^-?\d+$/.test(s);
141: const rf = new Map<string, number>();
142: let verified = 0;
143: const skipped: { name: string; why: string }[] = [];
144: 
145: for (const rel of SOURCES) {
146:   const file = Bun.file(`${openmuRoot}/${rel}`);
147:   if (!(await file.exists())) {
148:     console.error(`missing ${rel} - pass --openmu <path to OpenMU Initialization>`);
149:     process.exit(1);
150:   }
151:   for (const call of callsIn(await file.text())) {
152:     const spec = SPECS[call.helper]?.find(s => s.argc === call.args.length);
153:     if (!spec) continue;
154: 
155:     const name = (call.args.find(a => a.startsWith('"')) ?? '""').slice(1, -1);
156:     const row = rowOf(spec.group(call.args), spec.index(call.args));
157:     if (!row) { skipped.push({ name, why: 'no items.json row' }); continue; }
158: 
159:     const block = call.args.slice(spec.classAt, spec.classAt + (spec.hasRf ? 7 : 6));
160:     if (!block.every(isInt)) { skipped.push({ name, why: 'class block not numeric' }); continue; }
161: 
162:     const nums = block.map(Number);
163:     if (SIX.some((c, i) => (Number(row[c]) || 0) !== nums[i])) {
164:       skipped.push({ name, why: 'six columns disagree' });
165:       continue;
166:     }
167:     verified++;
168:     rf.set(`${row.Group}:${row.Index}`, spec.hasRf ? nums[6] : 0);
169:   }
170: }
171: 
172: /** Group 10, and the four pieces that make up the rest of an armour set. */
173: const GLOVES_GROUP = 10;
174: const SET_PIECES = [7, 8, 9, 11];
175: 
176: const borrowed: string[] = [];
177: for (const row of items) {
178:   if (row.Group !== GLOVES_GROUP) continue;
179: 
180:   const mates = SET_PIECES.map(g => rf.get(`${g}:${row.Index}`));
181:   const level = mates[0];
182:   if (!level || mates.some(m => m !== level)) continue;
183: 
184:   rf.set(`${row.Group}:${row.Index}`, level);
185:   borrowed.push(`${row.ItemName} (${level})`);
186: }
187: 
188: const carriesClassBlock = (row: Record<string, unknown>) => 'SUM' in row;
189: 
190: // Rebuild with RF straight after SUM, keeping the file's own shape.
191: const eol = (await Bun.file(itemsPath).text()).includes('\r\n') ? '\r\n' : '\n';
192: const rendered = items.map(row => {
193:   const entries: [string, unknown][] = [];
194:   for (const [k, v] of Object.entries(row)) {
195:     if (k === 'RF') continue; // rerunnable
196:     entries.push([k, v]);
197:     if (k === 'SUM') entries.push(['RF', rf.get(`${row.Group}:${row.Index}`) ?? 0]);
198:   }
199:   const body = entries
200:     .map(([k, v]) => `    ${JSON.stringify(k)}: ${JSON.stringify(v)}`)
201:     .join(`,${eol}`);
202:   return `  {${eol}${body}${eol}  }`;
203: });
204: 
205: const withColumn = items.filter(carriesClassBlock).length;
206: const nonZero = [...rf.values()].filter(v => v > 0).length;
207: console.log(`verified against the six existing columns: ${verified}`);
208: console.log(`rows carrying a class block: ${withColumn} (of ${items.length})`);
209: console.log(`rows with a Rage Fighter level: ${nonZero}`);
210: console.log(
211:   `gloves taken from their own set: ${borrowed.length}${
212:     borrowed.length ? ` - ${borrowed.join(', ')}` : ''
213:   }`
214: );
215: console.log(`not taken: ${skipped.length}`);
216: for (const s of skipped.slice(0, 5)) console.log(`  ${s.name} - ${s.why}`);
217: if (skipped.length > 5) console.log(`  ... and ${skipped.length - 5} more`);
218: 
219: if (dry) {
220:   console.log('--dry: items.json not written');
221: } else {
222:   await Bun.write(itemsPath, `[${eol}${rendered.join(`,${eol}`)}${eol}]${eol}`);
223:   console.log(`wrote ${itemsPath}`);
224: }
</file>

