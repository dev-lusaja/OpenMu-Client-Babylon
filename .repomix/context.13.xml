 1: /**
 2:  * Deterministic on/off schedule for ambient weather.
 3:  *
 4:  * Leaves and snow used to run at full rate for as long as you stood on the
 5:  * map, which reads as a machine rather than as weather. A schedule turns each
 6:  * recipe into *episodes* - a gust of leaves, a snow squall - separated by calm
 7:  * stretches, and derives every roll from `serverNow()` instead of
 8:  * `Math.random()`, so two clients on the same map see the same gust start at
 9:  * the same second with the same strength.
10:  *
11:  * Time is cut into fixed `period` slots. Each slot rolls once: does an episode
12:  * happen at all (`chance`), how long does it last (`duration`), when inside the
13:  * slot does it start, and how hard does it blow (`strength`). The episode is
14:  * clamped inside its own slot, so a strength lookup only ever has to hash the
15:  * current slot - no history, no state, correct the instant a client joins
16:  * mid-episode.
17:  */
18: 
19: export type AmbientSchedule = {
20:   /** Roll seed. Recipes sharing a key burst together (snow + big flakes). */
21:   readonly key: string;
22:   /** Slot length in seconds: at most one episode starts per slot. */
23:   readonly period: number;
24:   /** Odds a slot carries an episode at all (0.5 = weather about half the time). */
25:   readonly chance: number;
26:   /** Episode length range in seconds (clamped to `period`). */
27:   readonly duration: readonly [number, number];
28:   /** Peak strength range, as a multiplier on the recipe's emit rate. */
29:   readonly strength: readonly [number, number];
30:   /** Fade in / out at the episode edges, seconds. */
31:   readonly ramp: number;
32: };
33: 
34: function hashString(s: string): number {
35:   let h = 0x811c9dc5;
36:   for (let i = 0; i < s.length; i++) {
37:     h ^= s.charCodeAt(i);
38:     h = Math.imul(h, 0x01000193);
39:   }
40:   return h >>> 0;
41: }
42: 
43: /** One roll in [0, 1) from (seed, slot, salt) - the same everywhere. */
44: function roll(seed: number, slot: number, salt: number): number {
45:   let h = (seed ^ Math.imul(slot, 0x9e3779b1) ^ Math.imul(salt, 0x85ebca6b)) >>> 0;
46:   h = Math.imul(h ^ (h >>> 15), 0x2c1b3c6d);
47:   h = Math.imul(h ^ (h >>> 12), 0x297a2d39);
48:   h ^= h >>> 15;
49:   return (h >>> 0) / 0x100000000;
50: }
51: 
52: const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
53: 
54: /**
55:  * Smoothstep, used for the episode edges. A linear ramp is still a corner:
56:  * the rate changes slope in one frame at both ends, which is visible as the
57:  * moment the weather "switches on". Easing the ends removes it.
58:  */
59: const smooth = (t: number) => {
60:   const k = t <= 0 ? 0 : t >= 1 ? 1 : t;
61:   return k * k * (3 - 2 * k);
62: };
63: 
64: /**
65:  * Emit-rate multiplier for this schedule at `nowMs` on the shared clock.
66:  * `salt` separates otherwise identical recipes - pass the map index so the
67:  * same leaf recipe gusts independently in Lorencia, Noria and Atlans.
68:  * Returns 0 during the calm between episodes.
69:  */
70: export function ambientStrengthAt(
71:   schedule: AmbientSchedule,
72:   salt: number,
73:   nowMs: number
74: ): number {
75:   const t = nowMs / 1000;
76:   const slot = Math.floor(t / schedule.period);
77:   const seed = (hashString(schedule.key) ^ Math.imul(salt + 1, 0x27d4eb2f)) >>> 0;
78: 
79:   if (roll(seed, slot, 1) >= schedule.chance) return 0;
80: 
81:   const span = Math.min(
82:     schedule.period,
83:     lerp(schedule.duration[0], schedule.duration[1], roll(seed, slot, 2))
84:   );
85:   const start = slot * schedule.period + roll(seed, slot, 3) * (schedule.period - span);
86:   const into = t - start;
87:   if (into <= 0 || into >= span) return 0;
88: 
89:   const ramp = Math.min(schedule.ramp, span / 2);
90:   const envelope =
91:     ramp > 0 ? smooth(Math.min(1, into / ramp, (span - into) / ramp)) : 1;
92:   const peak = lerp(schedule.strength[0], schedule.strength[1], roll(seed, slot, 4));
93: 
94:   return peak * envelope;
95: }
