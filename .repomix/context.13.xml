 70: 
 71:   it('keeps the accented characters of the code page the pack declares', () => {
 72:     const problems: string[] = [];
 73:     // Cyrillic needs 1251: in UTF-8 it is two bytes a character and the long
 74:     // names would not fit the 30-byte field.
 75:     const pack = buildItemPack(
 76:       source({ encoding: 'windows-1251', items: { '0/0': 'Кинжал', '7/0': 'Бронзовый шлем' } }),
 77:       problems
