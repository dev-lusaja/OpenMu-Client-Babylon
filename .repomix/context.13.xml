<file path="src/weather/roomClip.ts">
  1: import {
  2:   ShaderStore,
  3:   type Effect,
  4:   type IParticleSystem,
  5:   type Scene,
  6: } from '../libs/babylon/exports';
  7: import type { RoomVolume } from '../lighting/profiles';
  8: 
  9: /**
 10:  * Sky weather seen from inside a room: the same rule the room mask draws by
 11:  * (`scenes/roomMask.ts`), applied to the weather's own particles.
 12:  *
 13:  * Standing in a room, the mask blacks every pixel except the room itself and
 14:  * whatever the line of sight reaches through a door or a window. Particles are
 15:  * transparent and write no depth, so the mask reads the surface *behind* a
 16:  * flake and cannot judge the flake: snow drawn over the floor read as the
 17:  * floor and stayed, which is snow falling indoors. That is why weather used to
 18:  * be switched off at the door - and switching it off takes it out of the
 19:  * doorway too, so an interior looked out on a still, dry world.
 20:  *
 21:  * The test here is the mask's, moved onto the particle: a flake is drawn iff
 22:  * the segment from the camera to the flake crosses the room's wall box (a
 23:  * clear line through an opening; a solid wall would have stopped it) and the
 24:  * flake is not inside the room volume. That discards
 25:  *
 26:  *  - flakes inside the room,
 27:  *  - flakes over the roof, and beside it, that project onto the room - the
 28:  *    segment to them stops short of the walls,
 29:  *
 30:  * and keeps the flakes past the room, in the sliver of world the mask leaves
 31:  * visible through the openings. Outdoors, and in a room the mask is not
 32:  * drawing (Classic tier), `roomClipCam.w` is 0 and nothing is discarded.
 33:  *
 34:  * The shader is Babylon's own particle fragment shader with the test injected,
 35:  * read out of the shader store rather than copied, so image processing, fog
 36:  * and the blend modes stay exactly as the engine wrote them. Both paths are
 37:  * covered: the CPU and GPU vertex shaders each hand the fragment stage a
 38:  * `vPositionW`.
 39:  */
 40: 
 41: const CPU_SHADER = 'muRoomClipParticle';
 42: const GPU_SHADER = 'muRoomClipGpuParticle';
 43: 
 44: const UNIFORMS = ['roomClipCam', 'roomClipXZ', 'roomClipY'];
 45: 
 46: /** The room the weather is being clipped to; null outdoors. */
 47: let clipped: RoomVolume | null = null;
 48: 
 49: /** Camera the test is run from, world space. */
 50: const eye = { x: 0, y: 0, z: 0 };
 51: 
 52: /**
 53:  * The active room and the eye it is judged from, set once a frame by the
 54:  * ambient particle system. Null turns the clip off (the uniform, not the
 55:  * shader: the systems keep the effect they were built with).
 56:  */
 57: export function setRoomWeatherClip(
 58:   volume: RoomVolume | null,
 59:   camera: { x: number; y: number; z: number }
 60: ): void {
 61:   clipped = volume;
 62:   eye.x = camera.x;
 63:   eye.y = camera.y;
 64:   eye.z = camera.z;
 65: }
 66: 
 67: const DECLARATIONS = `
 68: varying vec3 vPositionW;
 69: uniform vec4 roomClipCam;  // camera world position, w = the clip is on
 70: uniform vec4 roomClipXZ;   // minX, minZ, maxX, maxZ
 71: uniform vec3 roomClipY;    // floor, wall top, roof underside
 72: 
 73: // Segment from o to o + d against the box; true when any part is inside.
 74: bool roomClipCrosses(vec3 o, vec3 d, vec3 bmin, vec3 bmax) {
 75:   vec3 inv = 1.0 / (abs(d) + vec3(1e-6)) * sign(d + vec3(1e-9));
 76:   vec3 t0 = (bmin - o) * inv;
 77:   vec3 t1 = (bmax - o) * inv;
 78:   vec3 tn = min(t0, t1);
 79:   vec3 tf = max(t0, t1);
 80:   float tEnter = max(max(tn.x, tn.y), tn.z);
 81:   float tExit = min(min(tf.x, tf.y), tf.z);
 82:   return tExit >= max(tEnter, 0.0) && tEnter <= 1.0;
 83: }
 84: 
 85: bool roomClipHidden(vec3 p) {
 86:   vec3 volMin = vec3(roomClipXZ.x, roomClipY.x, roomClipXZ.y);
 87:   vec3 volMax = vec3(roomClipXZ.z, roomClipY.z, roomClipXZ.w);
 88:   vec3 wallMax = vec3(roomClipXZ.z, roomClipY.y, roomClipXZ.w);
 89: 
 90:   bool inside = all(greaterThanEqual(p, volMin)) && all(lessThanEqual(p, volMax));
 91: 
 92:   return inside || !roomClipCrosses(roomClipCam.xyz, p - roomClipCam.xyz, volMin, wallMax);
 93: }
 94: `;
 95: 
 96: const TEST = `
 97:   if (roomClipCam.w > 0.5 && roomClipHidden(vPositionW)) discard;
 98: `;
 99: 
100: /**
101:  * Babylon's shader with the declarations before `main` and the test as its
102:  * first statement. Anchored on `void main` rather than on the CUSTOM_ hooks:
103:  * only the CPU shader carries those.
104:  */
105: function withClip(source: string): string | null {
106:   const at = source.indexOf('void main');
107:   if (at < 0) return null;
108: 
109:   const open = source.indexOf('{', at);
110:   if (open < 0) return null;
111: 
112:   return (
113:     source.slice(0, at) +
114:     DECLARATIONS +
115:     source.slice(at, open + 1) +
116:     TEST +
117:     source.slice(open + 1)
118:   );
119: }
120: 
121: /**
122:  * A shader that would not compile, on any system. The weather then has no
123:  * clip, so the caller must keep it out of rooms the old way.
124:  */
125: let broken = false;
126: 
127: /**
128:  * Whether a room's weather can be clipped at all. False turns the rule back
129:  * into "no sky weather under a roof", which is the only honest fallback:
130:  * unclipped weather in a room is snow on the tavern floor.
131:  */
132: export function roomClipAvailable(): boolean {
133:   return !broken && registerShaders();
134: }
135: 
136: /** Registers both clipped shaders once; false if Babylon's own are not in the store. */
137: function registerShaders(): boolean {
138:   const store = ShaderStore.ShadersStore;
139: 
140:   if (store[`${CPU_SHADER}PixelShader`] && store[`${GPU_SHADER}PixelShader`]) {
141:     return true;
142:   }
143: 
144:   const cpu = withClip(store['particlesPixelShader'] ?? '');
145:   const gpu = withClip(store['gpuRenderParticlesPixelShader'] ?? '');
146:   if (!cpu || !gpu) return false;
147: 
148:   store[`${CPU_SHADER}PixelShader`] = cpu;
149:   store[`${GPU_SHADER}PixelShader`] = gpu;
150: 
151:   return true;
152: }
153: 
154: export type RoomClip = {
155:   /** Rebuilds the effect when the system's defines move under it (post on/off). */
156:   refresh(): void;
157:   dispose(): void;
158: };
159: 
160: /**
161:  * Puts the clip on one weather system. The effect is rebuilt whenever the
162:  * system's own defines change, because a custom effect is the one thing
163:  * Babylon will not recompile for you.
164:  */
165: export function clipToRoom(
166:   scene: Scene,
167:   system: IParticleSystem
168: ): RoomClip | null {
169:   if (!registerShaders()) return null;
170: 
171:   const engine = scene.getEngine();
172:   if (typeof engine.createEffectForParticles !== 'function') return null;
173: 
174:   const fragment =
175:     system.vertexShaderName === 'particles' ? CPU_SHADER : GPU_SHADER;
176: 
177:   let built = '';
178:   let failed = false;
179: 
180:   const binder = (effect: Effect | null) => {
181:     if (!effect) return;
182:     const on = clipped !== null;
183:     effect.setFloat4('roomClipCam', eye.x, eye.y, eye.z, on ? 1 : 0);
184:     if (!clipped) return;
185:     effect.setFloat4(
186:       'roomClipXZ',
187:       clipped.minX,
188:       clipped.minY,
189:       clipped.maxX,
190:       clipped.maxY
191:     );
192:     effect.setFloat3(
193:       'roomClipY',
194:       clipped.floorY,
195:       clipped.wallTop,
196:       clipped.roofY
197:     );
198:   };
199: 
200:   system.onBeforeDrawParticlesObservable.add(binder);
201: 
202:   const build = () => {
203:     const defines: string[] = [];
204:     system.fillDefines(defines, system.blendMode);
205:     const join = defines.join('\n');
206:     if (join === built) return;
207: 
208:     // A shader that will not compile must not take the weather with it: drop
209:     // back to the stock effect and stop trying.
210:     const effect = engine.createEffectForParticles(
211:       fragment,
212:       UNIFORMS,
213:       [],
214:       join,
215:       undefined,
216:       undefined,
217:       () => {
218:         failed = true;
219:         broken = true;
220:         system.setCustomEffect(null, 0);
221:       },
222:       system
223:     );
224: 
225:     built = join;
226:     system.setCustomEffect(effect, 0);
227:   };
228: 
229:   build();
230: 
231:   return {
232:     refresh: () => {
233:       if (!failed) build();
234:     },
235:     dispose: () => {
236:       system.onBeforeDrawParticlesObservable.removeCallback(binder);
237:     },
238:   };
239: }
</file>

<file path="src/weather/snowCaps.ts">
 1: import type { WeatherLayer } from './layer';
 2: import { GameOptions } from '../common/gameOptions';
 3: import { isTileOpen } from '../libs/mu/terrainMask';
 4: import { snowCover } from './snowCover';
 5: 
 6: /**
 7:  * Snow lying on the map's objects - barrels, signs, fences, rocks, roofs.
 8:  *
 9:  * The ground overlay whitens the terrain; without this the props standing
10:  * on it stay bare, and a bare barrel on a white field is the first thing the
11:  * eye finds wrong. Driven by the same `snowCover` as the ground, so caps and
12:  * drifts build and melt together, and by the roof mask, so nothing under a
13:  * ceiling gets a cap.
14:  *
15:  * Read by the shared item material (`common/itemMaterial.ts`), which whitens
16:  * every UP-facing fragment of a mesh flagged `metadata.snowCap` - the flag
17:  * is set by `MapTileObject` on `SNOW_GROUND_MAPS`, so characters, items and
18:  * effects never take one.
19:  */
20: 
21: // ---- 1. tuning ---------------------------------------------------------
22: 
23: /** Linear RGB of the cap at full depth. The ground overlay's white, unwarmed. */
24: export const SNOW_CAP_COLOUR: readonly [number, number, number] = [0.97, 0.975, 0.99];
25: 
26: /**
27:  * Surface normal Y where a cap starts (thin cover) and where it is complete
28:  * (full cover). Snow settles on anything facing up: at full cover a face
29:  * tilted 45° (Y 0.7) is white and a wall (Y 0) is bare; a light dusting
30:  * only reaches the near-flat tops.
31:  */
32: export const SNOW_CAP_KNEE_THIN = 0.85;
33: export const SNOW_CAP_KNEE_FULL = 0.45;
34: 
35: // ---- 2. state + readers -------------------------------------------------
36: 
37: /**
38:  * How much cap an object standing at tile (x, z) carries, 0…1. Zero under a
39:  * roof and with advanced effects off - checked here, because this is the
40:  * one reader the material binds and it is the material that pays.
41:  */
42: export function snowCapAt(x: number, z: number): number {
43:   const cover = snowCapCover();
44:   if (cover <= 0) return 0;
45:   return isTileOpen(x, z) ? cover : 0;
46: }
47: 
48: /**
49:  * The cap before the tile test: what a prop batch binds as its uniform, the
50:  * openness of each placement's tile riding in its instance attribute.
51:  */
52: export function snowCapCover(): number {
53:   if (!GameOptions.advancedEffects) return 0;
54:   return Math.max(0, snowCover());
55: }
56: 
57: // ---- 3. the layer -------------------------------------------------------
58: 
59: /** Nothing to advance or reset: the cover it reads is owned by `snowCoverLayer`. */
60: export const snowCapsLayer: WeatherLayer = { name: 'snowCaps' };
</file>

<file path="src/weather/snowCover.ts">
  1: import { ENUM_WORLD } from '../common/types';
  2: import type { WeatherLayer } from './layer';
  3: import { serverNow } from '../common/serverTime';
  4: import { ambientStrengthAt } from './ambientSchedule';
  5: import { DEVIAS_SNOW, SNOWFALL_MAPS } from './ambientWeather';
  6: import { maps } from '../maps';
  7: 
  8: /**
  9:  * How much settled snow is lying on the ground, 0…1.
 10:  *
 11:  * The falling flakes are particles (`DEVIAS_SNOW`); this is what they leave
 12:  * behind. The original client has no equivalent - `MoveEtcLeaf` settles a leaf
 13:  * on the terrain and fades it out, and that is as far as ground contact ever
 14:  * went ("leaves settling on terrain, and `BITMAP_RAIN_CIRCLE`
 15:  * splashes" are both listed as missing) - so this is our own, and it is
 16:  * deliberately a *simulation* rather than a lookup: cover builds while the
 17:  * squall blows and melts once it passes, which is the whole reason the ground
 18:  * reads as weather rather than as a texture swap.
 19:  *
 20:  * It reads the squall schedule directly rather than being handed the emitter's
 21:  * strength, because the emitter stops when the hero steps indoors and the snow
 22:  * outside plainly does not.
 23:  *
 24:  * Not shared across clients the way the schedule is: two players who arrived at
 25:  * different times can disagree on the exact depth for a minute or two after a
 26:  * squall starts. That is invisible at the thresholds this feeds, and the
 27:  * alternative - integrating the schedule analytically over all of history -
 28:  * buys nothing anyone can see.
 29:  */
 30: 
 31: // ---- 1. tuning -------------------------------------------------------------
 32: 
 33: /**
 34:  * Maps whose ground collects snow: the maps snow actually falls on
 35:  * (`SNOWFALL_MAPS`) where it also has a sky to fall out of. Cover is what a
 36:  * fall leaves behind, so it cannot reach a map nothing falls on - the ice
 37:  * fields declare a snow climate and no fall, and stay bare ice. The caps,
 38:  * the prints, the sink and the terrain's `SNOW_COVER` overlay all read this
 39:  * set, so nothing sitting on the settled snow can outrun the ground it
 40:  * claims to stand on. `snowCover()` is 0 off it.
 41:  */
 42: export const SNOW_GROUND_MAPS: ReadonlySet<ENUM_WORLD> = new Set(
 43:   [...SNOWFALL_MAPS].filter(world => maps.isOutdoor(world))
 44: );
 45: 
 46: /** Seconds of full-strength snowfall to go from bare ground to full cover. */
 47: const BUILD_SECONDS = 90;
 48: 
 49: /** Seconds to melt from full cover back to the base once the squall passes. */
 50: const MELT_SECONDS = 240;
 51: 
 52: /**
 53:  * The floor the cover never drops below on a snow map, 0…1.
 54:  *
 55:  * Devias is a snow world: its ground textures are painted snow and the
 56:  * reference frames show a field that is white edge to edge whether or not
 57:  * flakes are in the air. Before this the cover was seeded from the squall
 58:  * alone, so between squalls - and at any squall under full strength - the
 59:  * overlay was patchy and most of the ground was the bare tile texture, which
 60:  * under the blue bake reads as cyan ice. 0.85 with the overlay's headroom
 61:  * (1.25) is past the break-up noise's range, so the snow tiles are solid;
 62:  * the squall still adds the last of the depth on top.
 63:  */
 64: const BASE_COVER = 0.85;
 65: 
 66: // ---- 2. state + readers ----------------------------------------------------
 67: 
 68: let cover = 0;
 69: let lastMap: ENUM_WORLD | null = null;
 70: /**
 71:  * Advances the ground cover; call once a frame. Returns the new value.
 72:  *
 73:  * Arriving on a snow map seeds the cover from the squall rather than starting
 74:  * bare: walking into a blizzard over clean ground and waiting ninety seconds
 75:  * for it to whiten looks like a bug, not like weather.
 76:  */
 77: export function updateSnowCover(map: ENUM_WORLD, dt: number): number {
 78:   if (!SNOW_GROUND_MAPS.has(map)) {
 79:     cover = 0;
 80:     lastMap = map;
 81:     return 0;
 82:   }
 83: 
 84:   const schedule = DEVIAS_SNOW.schedule;
 85:   const strength = schedule ? ambientStrengthAt(schedule, map, serverNow()) : 0;
 86: 
 87:   if (map !== lastMap) {
 88:     lastMap = map;
 89:     cover = Math.max(BASE_COVER, Math.min(1, strength));
 90:     return cover;
 91:   }
 92: 
 93:   if (strength > 0) {
 94:     cover = Math.min(1, cover + (strength * dt) / BUILD_SECONDS);
 95:   } else {
 96:     cover = Math.max(BASE_COVER, cover - dt / MELT_SECONDS);
 97:   }
 98: 
 99:   return cover;
100: }
101: 
102: /** Settled snow on the ground, 0…1. */
103: export function snowCover(): number {
104:   return cover;
105: }
106: 
107: /** Drop the cover - a map change that is not to a snow map, or a teardown. */
108: export function resetSnowCover(): void {
109:   cover = 0;
110:   lastMap = null;
111: }
112: 
113: // ---- 3. the layer ----------------------------------------------------------
114: 
115: /** The layer (see layer.ts). */
116: export const snowCoverLayer: WeatherLayer = {
117:   name: 'snowCover',
118:   maps: SNOW_GROUND_MAPS,
119:   update: updateSnowCover,
120:   reset: resetSnowCover,
121: };
</file>

<file path="src/weather/snowMelt.ts">
  1: import type { ENUM_WORLD } from '../common/types';
  2: import type { WeatherLayer } from './layer';
  3: 
  4: /**
  5:  * Snow melted off the ground by fire - the patch a Fire Ball, a Meteorite or
  6:  * an Inferno leaves in a Devias snowfield.
  7:  *
  8:  * The original client has none of this: `snowCover.ts` already records that
  9:  * settled snow is our own invention, and nothing in `ZzzEffect.cpp` ever
 10:  * touches the terrain. What makes it worth having is that the snow is a
 11:  * *simulation* - it builds while the squall blows and melts once it passes -
 12:  * so a fireball that leaves the field untouched is the one thing on screen
 13:  * saying the white is a texture after all.
 14:  *
 15:  * ### Why spots and uniforms, and not another depth map
 16:  *
 17:  * The ploughed trail (`snowTrail.ts`) is a 4 MB world-space map because a
 18:  * trail is an arbitrary shape the hero draws over a whole session. A melt is
 19:  * not: it is a handful of round patches at a time, each alive for half a
 20:  * minute. So this keeps them as **at most `MELT_SPOTS` circles in a uniform
 21:  * array**, the way the water reflections already carry the torch pool
 22:  * (`ovLightPos` / `ovLightCol` in terrainOverlay.ts) - no texture, no upload,
 23:  * no second sampler.
 24:  *
 25:  * That last point is the deciding one. The terrain fragment shader's sampler
 26:  * list is brittle enough that both `terrainMaterial.ts` and
 27:  * `terrainDynamicLight.ts` carry warnings about it - a sampler declared but
 28:  * unbound, or two sampler types landing on one unit, is a GL draw error that
 29:  * makes the whole terrain vanish - and on the unpacked tile path the units
 30:  * are nearly spoken for already. A melt that costs zero of them cannot
 31:  * provoke any of that.
 32:  *
 33:  * ### It imports nothing from this folder, and must not
 34:  *
 35:  * `terrainOverlay.ts` reads this file, and `snowCover.ts` reads
 36:  * `terrainOverlay.ts` - so anything here that touched another weather module
 37:  * at *module scope* would sit inside that cycle and be initialised before the
 38:  * thing it read. Naming `SNOW_GROUND_MAPS` on the layer, which is what every
 39:  * other snow effect does, crashed the client on load with exactly that. So
 40:  * this file is a leaf, like `snowTrail.ts`: it owns a pool of patches and
 41:  * knows nothing about snow. Which layer they eat - and therefore which maps
 42:  * can show them - is `SNOW_COVER.melt`, decided at the other end.
 43:  *
 44:  * ### What reads it
 45:  *
 46:  *  - The terrain shader, through `SNOW_COVER.melt` - the spots divide the
 47:  *    layer's *target*, so the snow's coverage, depth, relief, drift lighting
 48:  *    and any trail ploughed through it all thin together, and the revealed
 49:  *    ground is damped down rather than left as bare cyan tile.
 50:  *  - `snowSink.snowUnderfoot`, on the CPU, through `snowMeltAt` - so a hero
 51:  *    standing in a melt neither sinks into snow that is not there nor stamps
 52:  *    a print into it. Same falloff on both sides, for the reason the bed
 53:  *    table is shared: what you stand in has to be what you see.
 54:  */
 55: 
 56: // ---- 1. tuning -------------------------------------------------------------
 57: 
 58: /**
 59:  * Patches alive at once.
 60:  *
 61:  * Eight, and that is Inferno's number: `CreateInferno` throws its bombs at
 62:  * 45° around a 2.2-tile ring, which is wider apart than the merge below can
 63:  * join, so anything less turns the one skill built out of eight ground hits
 64:  * into a ring with gaps in it. The fragment loop is a `length()` and a
 65:  * `smoothstep` per slot - a fraction of what the reflection pool's six
 66:  * lights cost - and nearby hits merge rather than each claiming a slot, so a
 67:  * sustained barrage widens one scar instead of exhausting the array.
 68:  */
 69: export const MELT_SPOTS = 8;
 70: 
 71: /** Seconds from the hit to bare ground. Fire is fast; this is nearly a cut. */
 72: const OPEN_SECONDS = 0.35;
 73: 
 74: /** Seconds the patch stays fully open before the snow starts closing it. */
 75: const HOLD_SECONDS = 5;
 76: 
 77: /**
 78:  * Seconds for the snow to take the patch back.
 79:  *
 80:  * Long enough that a fight leaves a readable mess on the field, short enough
 81:  * that a player walking back over their own tracks finds the map whole again.
 82:  * Deliberately faster than the trail's `FILL_SECONDS` (240): a channel is
 83:  * displaced snow that has to be snowed over, a melt is water that refreezes.
 84:  */
 85: const CLOSE_SECONDS = 28;
 86: 
 87: /**
 88:  * A new hit closer than this share of an existing patch's radius grows that
 89:  * patch instead of taking a slot of its own. Just inside the rim, so two
 90:  * blasts that visibly overlap become one scar.
 91:  */
 92: const MERGE_FRACTION = 0.8;
 93: 
 94: /** Tiles a merged hit adds to the patch it joined, and the ceiling on that. */
 95: const MERGE_GROWTH = 0.25;
 96: const MAX_RADIUS = 4;
 97: 
 98: /**
 99:  * Where the edge of a patch starts, as a share of the radius. The snow does
100:  * not stop at a line - it thins over the last half of the circle, which is
101:  * what makes it read as melted rather than as a stencil.
102:  */
103: export const MELT_EDGE = 0.45;
104: 
105: /**
106:  * How far a patch's edge departs from a circle, per harmonic of the bearing.
107:  *
108:  * A melt was a perfect disc, and a disc is the one shape that says "stamped"
109:  * rather than "melted" - a fire skill worked over a snowfield left a row of
110:  * identical coins. The second harmonic gives a patch a long axis and the third
111:  * and fifth break that into lobes.
112:  *
113:  * The phases come out of the spot's own position (see the GLSL in
114:  * `terrainOverlay.ts`), so a patch keeps its outline for as long as it lives
115:  * and no two are alike, without a byte more uniform: the shape is three sines
116:  * of a bearing the loop already has to compute the distance.
117:  */
118: export const MELT_LOBE_2 = 0.2;
119: export const MELT_LOBE_3 = 0.12;
120: export const MELT_LOBE_5 = 0.07;
121: 
122: // ---- 2. state + readers ----------------------------------------------------
123: 
124: type Spot = {
125:   x: number;
126:   z: number;
127:   radius: number;
128:   /** Seconds since the hit that opened (or last widened) this patch. */
129:   age: number;
130:   /** Dead slots carry 0 and are what `alloc` reuses. */
131:   strength: number;
132: };
133: 
134: const spots: Spot[] = Array.from({ length: MELT_SPOTS }, () => ({
135:   x: 0,
136:   z: 0,
137:   radius: 0,
138:   age: 0,
139:   strength: 0,
140: }));
141: 
142: /** `setArray4` wants a flat array and must not allocate one per frame. */
143: const uniform: number[] = new Array(MELT_SPOTS * 4).fill(0);
144: 
145: /**
146:  * How much of a patch's life is left, 1…0 - full until the snow starts
147:  * closing it, then down the fill ramp to nothing.
148:  *
149:  * Separate from `envelope` because the opening ramp is not a claim on the
150:  * slot. Scored by the envelope, a patch made this frame is worth 0 and the
151:  * allocator reads it as free: a volley that lands in one frame - Inferno's
152:  * eight bombs, a chain of fireballs - then piles every hit into the same slot
153:  * and only the last one is ever seen.
154:  */
155: function life(age: number): number {
156:   const closing = age - OPEN_SECONDS - HOLD_SECONDS;
157:   if (closing <= 0) return 1;
158:   return Math.max(0, 1 - closing / CLOSE_SECONDS);
159: }
160: 
161: /** How open a patch of this age is, 0…1: a quick rise, a hold, a slow close. */
162: function envelope(age: number): number {
163:   return age < OPEN_SECONDS ? age / OPEN_SECONDS : life(age);
164: }
165: 
166: /** `smoothstep(a, b, x)`, so the CPU falloff is the shader's to the letter. */
167: function smoothstep(a: number, b: number, x: number): number {
168:   const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
169:   return t * t * (3 - 2 * t);
170: }
171: 
172: /**
173:  * Melt a circle of snow at world (x, z). `radius` is in tiles, `strength`
174:  * 0…1 is how much of the snow the fire takes at the centre.
175:  *
176:  * Called by the fire rows of `common/skillVisuals.ts`. Free to call on a map
177:  * with no meltable layer: nothing samples the patches there, and the map
178:  * change clears them.
179:  */
180: export function meltSnow(
181:   x: number,
182:   z: number,
183:   radius: number,
184:   strength = 1
185: ): void {
186:   if (radius <= 0 || strength <= 0) return;
187: 
188:   // A hit inside an existing patch widens it and makes it young again, which
189:   // is what turns a barrage into one spreading scar instead of six circles.
190:   for (const s of spots) {
191:     if (s.strength <= 0) continue;
192:     const dx = x - s.x;
193:     const dz = z - s.z;
194:     if (Math.sqrt(dx * dx + dz * dz) > s.radius * MERGE_FRACTION) continue;
195: 
196:     s.radius = Math.min(MAX_RADIUS, Math.max(s.radius, radius) + MERGE_GROWTH);
197:     s.strength = Math.max(s.strength, strength);
198:     // Back to the end of the rise, not to zero: the ground here is already
199:     // bare, and restarting the ramp would make it flash white for a frame.
200:     s.age = Math.min(s.age, OPEN_SECONDS);
201:     return;
202:   }
203: 
204:   // Otherwise the emptiest slot: a free one (strength 0), else the patch
205:   // closest to healed. Scored on `life`, never on the envelope - see there.
206:   let slot = spots[0];
207:   let best = slot.strength * life(slot.age);
208:   for (const s of spots) {
209:     const score = s.strength * life(s.age);
210:     if (score < best) {
211:       slot = s;
212:       best = score;
213:     }
214:   }
215: 
216:   slot.x = x;
217:   slot.z = z;
218:   slot.radius = Math.min(MAX_RADIUS, radius);
219:   slot.strength = strength;
220:   slot.age = 0;
221: }
222: 
223: /**
224:  * How much of the snow at (x, z) has been melted away, 0…1. The shader's own
225:  * falloff, on the CPU, for the sink and the footprints.
226:  */
227: export function snowMeltAt(x: number, z: number): number {
228:   let melt = 0;
229: 
230:   for (const s of spots) {
231:     if (s.strength <= 0) continue;
232:     const dx = x - s.x;
233:     const dz = z - s.z;
234:     const d = Math.sqrt(dx * dx + dz * dz) / s.radius;
235:     if (d >= 1) continue;
236: 
237:     const here = s.strength * envelope(s.age) * (1 - smoothstep(MELT_EDGE, 1, d));
238:     if (here > melt) melt = here;
239:   }
240: 
241:   return melt;
242: }
243: 
244: /** Whether anything is melted anywhere - the shader's "no melt" fast path. */
245: export function snowMeltActive(): boolean {
246:   for (const s of spots) if (s.strength > 0) return true;
247:   return false;
248: }
249: 
250: /**
251:  * The patches as `vec4(x, z, radius, strength)` for `ovMeltSpot`. Healed and
252:  * unused slots carry strength 0, which the shader's `max` ignores, so the
253:  * loop never needs a branch. `on` is the draw-side effects switch: off, every
254:  * slot reads as empty and the layer is exactly the one it was before melting
255:  * existed.
256:  */
257: export function snowMeltUniform(on: boolean): number[] {
258:   for (let i = 0; i < MELT_SPOTS; i++) {
259:     const s = spots[i];
260:     const k = on ? s.strength * envelope(s.age) : 0;
261:     const o = i * 4;
262: 
263:     uniform[o] = s.x;
264:     uniform[o + 1] = s.z;
265:     uniform[o + 2] = s.radius;
266:     uniform[o + 3] = k > 0 ? k : 0;
267:   }
268: 
269:   return uniform;
270: }
271: 
272: function update(_map: ENUM_WORLD, dt: number): void {
273:   for (const s of spots) {
274:     if (s.strength <= 0) continue;
275:     s.age += dt;
276:     if (life(s.age) <= 0) s.strength = 0;
277:   }
278: }
279: 
280: function reset(): void {
281:   for (const s of spots) {
282:     s.strength = 0;
283:     s.radius = 0;
284:     s.age = 0;
285:   }
286: }
287: 
288: // ---- 3. the layer ----------------------------------------------------------
289: 
290: export const snowMeltLayer: WeatherLayer = {
291:   name: 'snowMelt',
292:   // No `maps`, for the same reason `snowTrailLayer` has none: which layer the
293:   // patches eat, and therefore which maps they can appear on, is the
294:   // overlay's declaration (`melt`), not this pool's.
295:   update,
296:   reset,
297: };
</file>

<file path="src/weather/snowSink.ts">
  1: import type { ENUM_WORLD } from '../common/types';
  2: import type { WeatherLayer } from './layer';
  3: import { GameOptions } from '../common/gameOptions';
  4: import { isTileOpen } from '../libs/mu/terrainMask';
  5: import type { TerrainLayers, World } from '../ecs/world';
  6: import { overlayBedShare, snowCoverFor } from '../libs/mu/terrainOverlay';
  7: import { SNOW_GROUND_MAPS, snowCover } from './snowCover';
  8: import { snowMeltAt } from './snowMelt';
  9: import { FOOTPRINT_TUNING } from './footprints';
 10: 
 11: /**
 12:  * How far something standing in settled snow sinks into it.
 13:  *
 14:  * A character whose boots rest on the surface beside a hole their own stride
 15:  * just punched is visibly floating - which is exactly what the trail makes
 16:  * obvious, because the print is the evidence that the leg went down. So the
 17:  * depth here is a fraction of the print's own depth (`FOOTPRINT_TUNING.sink`)
 18:  * rather than a number of its own: dial the hollow deeper through
 19:  * `muFootprints` and the wearer goes down with it.
 20:  *
 21:  * Applied to the RENDERED position only, in `renderSystem`, next to the
 22:  * dying-sink that already lowers a corpse. The logical `transform.pos` is
 23:  * untouched: it is what pathing, targeting and the server agree on, and a
 24:  * visual detail has no business moving it.
 25:  *
 26:  * And to characters only: `renderSystem` keeps the map's own props out of it
 27:  * (`ModelObject.IsMapObject`). A prop is placed at an authored height that
 28:  * already fits its neighbours, so a per-position depth pulls the segments of
 29:  * a fence run down by different amounts and the rail stops meeting itself.
 30:  *
 31:  * ### It has to be local, and the first cut was not
 32:  *
 33:  * A single map-wide depth sank characters through paving, through the boards
 34:  * of a bridge and through the floor of every interior - anywhere the snow was
 35:  * not actually lying but the map still said "Devias". Four things decide it
 36:  * now, and all four already existed for other reasons:
 37:  *
 38:  *  - **Standing on something.** A bridge, a dock, a floor: these are map
 39:  *    objects sitting above the terrain, and the terrain's snow is not what the
 40:  *    boots are on. Detected by comparing the entity's own y against the ground
 41:  *    under it, which needs no new data and covers every such object at once.
 42:  *  - **A roof overhead.** `isTileOpen` is the mask the ground overlays already
 43:  *    use to keep snow out of interiors; a room whose floor has no snow drawn
 44:  *    on it must not swallow anyone standing in it either.
 45:  *  - **What the tile is.** Devias' own tiles say where snow lies. The first
 46:  *    cut reused the original's *sound* test (`tile !== 3 && tile < 10`, the
 47:  *    `sound/footsteps` rule) and that was wrong for a print: the original plays
 48:  *    the snow footstep on the paving slabs of the square as readily as on a
 49:  *    drift, so heroes crossing swept stone left snow holes in it. What a
 50:  *    print needs is whether the ground is *drawn* as snow, and that is the
 51:  *    overlay's own business: `SNOW_COVER.bed` in terrainOverlay.ts says how
 52:  *    much snow each Devias tile texture holds, the terrain shader thins the
 53:  *    drawn layer by it, and this file reads the same table through the same
 54:  *    layer-1/layer-2 alpha mix. Paving gets a wash under the print
 55:  *    threshold; drifts get everything.
 56:  *  - **How much snow has fallen.** The weather accumulator, as before.
 57:  */
 58: 
 59: // ---- 1. tuning -------------------------------------------------------------
 60: 
 61: /**
 62:  * Cover below which nothing sinks, and cover at which the snow is as deep as
 63:  * it gets. The lower bound matches the footprint system's own threshold, for
 64:  * the same reason: a dusting is not something you stand *in*.
 65:  */
 66: const SINK_MIN = 0.12;
 67: const SINK_FULL = 0.55;
 68: 
 69: 
 70: /**
 71:  * Height above the ground past which an entity is taken to be standing on
 72:  * something rather than in the snow.
 73:  *
 74:  * Generous enough to survive the small disagreements between a model's origin
 75:  * and the interpolated terrain height under it, tight enough that the lowest
 76:  * boardwalk still counts as a floor.
 77:  */
 78: const ON_OBJECT = 0.35;
 79: 
 80: // ---- 2. state + readers ----------------------------------------------------
 81: 
 82: /** Scratch for the tile lookup; the sink allocates nothing per call. */
 83: const layers: TerrainLayers = { layer1: 0, layer2: 255, alpha: 0 };
 84: 
 85: /**
 86:  * How snowy this tile is *drawn*, 0…1: the overlay's own bed table
 87:  * (`SNOW_COVER.bed`), mixed across the two mapping layers by the same alpha
 88:  * the terrain shader mixes them with. One table, read by the shader for the
 89:  * snow you see and here for the snow you stand in, so the two cannot
 90:  * disagree.
 91:  */
 92: function snowTileShare(world: World, x: number, z: number): number {
 93:   world.getTerrainLayers(~~x, ~~z, layers);
 94:   const snow = snowCoverFor(world.mapIndex);
 95: 
 96:   const under = overlayBedShare(snow, layers.layer1);
 97:   if (layers.alpha <= 0) return under;
 98: 
 99:   const over = overlayBedShare(snow, layers.layer2);
100:   return under + (over - under) * layers.alpha;
101: }
102: 
103: /**
104:  * How snowy the ground is under a point, 0…1.
105:  *
106:  * Bilinear across the four tiles around it rather than a straight lookup, so
107:  * walking off a path onto open ground ramps over a tile instead of the
108:  * character dropping a step the instant a tile boundary is crossed.
109:  *
110:  * Also what the footprint system asks before laying a print. It used to test
111:  * only `isTileOpen`, which says whether there is sky overhead and nothing
112:  * about what is underfoot - so a hero crossing Devias' paved square stamped
113:  * snow prints into swept stone. One field answering for the sink and the
114:  * prints together is also the only way they can agree.
115:  */
116: export function snowUnderfoot(world: World, x: number, z: number): number {
117:   const fx = x - 0.5;
118:   const fz = z - 0.5;
119:   const x0 = Math.floor(fx);
120:   const z0 = Math.floor(fz);
121:   const tx = fx - x0;
122:   const tz = fz - z0;
123: 
124:   let acc = 0;
125: 
126:   for (let i = 0; i < 4; i++) {
127:     const cx = x0 + (i & 1);
128:     const cz = z0 + (i >> 1);
129: 
130:     const open = isTileOpen(cx + 0.5, cz + 0.5);
131:     const share = open ? snowTileShare(world, cx, cz) : 0;
132: 
133:     const w = ((i & 1) === 0 ? 1 - tx : tx) * ((i >> 1) === 0 ? 1 - tz : tz);
134:     acc += share * w;
135:   }
136: 
137:   // What fire has taken off the ground (weather/snowMelt.ts), with the
138:   // shader's own falloff - so a hero standing in a patch a fireball opened
139:   // neither sinks into snow that is no longer drawn there nor stamps a print
140:   // into it. Applied to the finished share rather than per corner: a melt is
141:   // a smooth field of its own and owes nothing to the tile grid.
142:   const melt = snowMeltAt(x, z);
143: 
144:   return melt > 0 ? acc * (1 - melt) : acc;
145: }
146: 
147: /**
148:  * Whether something at (x, y, z) is standing on the terrain rather than on
149:  * top of something built on it.
150:  *
151:  * A bridge, a dock, an interior floor: these are map objects sitting above the
152:  * terrain, and the terrain's snow is not what the boots are on. Detected by
153:  * comparing the entity's own y against the ground under it, which needs no new
154:  * data and covers every such object at once.
155:  *
156:  * Shared with the footprint system, which needs exactly the same answer for
157:  * exactly the same reason: a print is the evidence that a foot went into the
158:  * snow, and a boot standing on a bridge deck did not. It used to test only
159:  * `isTileOpen` - sky overhead - so the hero crossing Devias' bridges stamped
160:  * holes into the planks. The sink already refused to lower them there, which
161:  * is how the disagreement showed: the character stood proud of the deck beside
162:  * a hole in it.
163:  */
164: export function onSnowGround(
165:   world: World,
166:   x: number,
167:   y: number,
168:   z: number
169: ): boolean {
170:   const ground = world.getTerrainHeight(x, z);
171: 
172:   // -9999 until the height data lands, and a NoGround tile is -10000. Neither
173:   // is a floor anybody is standing on.
174:   if (ground <= -9000) return false;
175: 
176:   return y - ground <= ON_OBJECT;
177: }
178: 
179: /**
180:  * How far into the ground a model at this position should be drawn, in tiles.
181:  *
182:  * Zero unless the weather layers are on, there is enough settled snow to
183:  * stand in (`snowCover()` is 0 off `SNOW_GROUND_MAPS`), and the thing is
184:  * actually standing on the ground.
185:  */
186: export function snowSinkDepth(
187:   world: World,
188:   map: ENUM_WORLD,
189:   x: number,
190:   y: number,
191:   z: number
192: ): number {
193:   if (!GameOptions.weatherEffects || !GameOptions.advancedEffects) return 0;
194: 
195:   const cover = snowCover();
196:   if (cover <= SINK_MIN) return 0;
197: 
198:   // On a bridge, a dock, an interior floor: the terrain's snow is under the
199:   // structure, not under the boots.
200:   if (!onSnowGround(world, x, y, z)) return 0;
201: 
202:   const here = snowUnderfoot(world, x, z);
203:   if (here <= 0) return 0;
204: 
205:   const t = Math.min(1, (cover - SINK_MIN) / (SINK_FULL - SINK_MIN));
206: 
207:   return FOOTPRINT_TUNING.depth * FOOTPRINT_TUNING.sink * t * here;
208: }
209: 
210: // ---- 3. the layer ----------------------------------------------------------
211: 
212: /**
213:  * Nothing to advance or reset: the cover it reads is owned by
214:  * `snowCoverLayer`, the tile table by the overlay. Listed so
215:  * `weather.layersFor(map)` and the tooling know the effect exists.
216:  */
217: export const snowSinkLayer: WeatherLayer = {
218:   name: 'snowSink',
219:   maps: SNOW_GROUND_MAPS,
220: };
</file>

