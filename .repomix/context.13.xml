 9:   plugins: [],
10:   /**
11:    * The two services the UI talks to, each its own process. Proxied here so
12:    * they are same-origin in dev; in production the shop is published under
13:    * `/api` on the client host and the register service answers by name on
14:    * `register.<domain>` (see `serverServices.ts`).
15:    *
16:    * `/api/register` is listed first: vite takes the first rule that matches,
17:    * and `/api` matches it too.
18:    */
19:   server: {
20:     proxy: {
21:       '/api/register': {
22:         target: `http://127.0.0.1:${process.env.REGISTER_API_PORT ?? 3100}`,
23:         changeOrigin: false,
24:       },
25:       '/api/market': {
26:         target: `http://127.0.0.1:${process.env.MARKETPLACE_API_PORT ?? 3300}`,
27:         changeOrigin: false,
28:       },
29:       '/api': {
30:         target: `http://127.0.0.1:${process.env.CASHSHOP_API_PORT ?? 3200}`,
31:         changeOrigin: false,
