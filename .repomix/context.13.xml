<file path="versions/_template/index.ts">
 1: /**
 2:  * COPY-ME skeleton for a new game version. `cp -r versions/_template
 3:  * versions/<id>`, fill every `TODO`, then add the entry to
 4:  * `versions/registry.ts`. It compiles as-is so the base game can be
 5:  * typechecked against any version folder; it has no registry entry, so it
 6:  * is never selected (it would connect with all-zero bytes).
 7:  *
 8:  * Where each value comes from (OpenMU = c:\MuDev\OpenMU\src):
 9:  * - openMu.*            Persistence/Initialization/<Version075|Version095d|VersionSeasonSix>/DataInitialization.cs
10:  *                       (`CreateGameClientDefinition`: Season, Episode, Language, Version, Serial)
11:  *                       and the initializer's `Key` string = `-version:<arg>`
12:  * - clientVersionBytes  the 5 ASCII bytes of `GameClientDefinition.Version` ("07500", "09504", "10404")
13:  * - serialBytes         `GameClientDefinition.Serial` (16 ASCII bytes)
14:  * - encryption          Network/PlugIns/<…>NetworkEncryptionFactoryPlugIn.cs for the version:
15:  *                       Season6Episode3 (S6 keys), PreSeason6 (any older client: same
16:  *                       SimpleModulus keys, different Xor32 key), Version075 (own Enc1/Dec2 keys)
17:  * - packetSet           which XML variants `packets/` was generated from 
18:  * - features            what that server version implements (Persistence/Initialization/<ver>/*)
19:  */
20: import { asciiBytes, type GameVersion } from '../../src/version/contract';
21: import { templateData } from './data';
22: 
23: // Keep this export: the registry's load() hands the base game the packet
24: // lists through it. Never import app code from this file - it evaluates
25: // before the resolved version is assigned (versions/registry.ts).
26: export * as packets from './packets';
27: 
28: // TODO: SimpleModulus keys. Every version 0.95+ uses these S6 defaults
29: // (OpenMU PreSeason6NetworkEncryptionFactoryPlugIn remarks); 0.75 has its own.
30: const CLIENT_TO_SERVER_KEYS = [128079, 164742, 70235, 106898, 23489, 11911, 19816, 13647, 48413, 46165, 15171, 37433];
31: const SERVER_TO_CLIENT_KEYS = [73326, 109989, 98843, 171058, 18035, 30340, 24701, 11141, 62004, 64409, 35374, 64599];
32: 
33: // TODO: Xor32 key - OpenMU Network/Xor/DefaultKeys (S6) or
34: // PreSeason6NetworkEncryptionFactoryPlugIn.Xor32Key (every earlier client).
35: const XOR32_KEY = new Uint8Array(32);
36: const XOR3_KEY = new Uint8Array([0xfc, 0xcf, 0xab]);
37: 
38: /**
39:  * TODO: which generated variant wins when several packets share a code.
40:  * Lower rank wins. For a pre-S6 set generated from the `…095` / `…075`
41:  * entries, prefer those; for S6 prefer the un-suffixed names.
42:  */
43: function variantRank(name: string): number {
44:   if (/Extended$/.test(name)) return 2;
45:   if (/0(75|95)$/.test(name)) return 1;
46:   return 0;
47: }
48: 
