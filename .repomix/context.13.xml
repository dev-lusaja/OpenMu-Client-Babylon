408:         normalizeWeights: true,
409:         // quantize() runs its own dedup+prune when cleanup is on (the
410:         // default), and that pass is unrestricted: it deletes player.glb`s
411:         // skin outright, because that file is a rig with no meshes and so
412:         // nothing references it. Cleanup is done below instead, limited to
413:         // leaf resources.
414:         cleanup: false,
415:       }),
416:       // Accessors the pass above orphaned. Same restriction, same reason as
417:       // the dedup: TEXTURE and MATERIAL are not candidates here.
418:       //
419:       // The original note on this call still stands and is why the list is
420:       // explicit at all. Unrestricted, `prune()` drops whatever no Scene
421:       // references, and `player.glb` is a rig with **no meshes at all**:
422:       // nothing references its skin, so a default prune deletes all 61 joints
423:       // and the file silently stops skinning every character. (`modelLoader`
424:       // synthesises the Babylon skeleton from that node graph - the same area
425:       // as the bone-ordering regression fixed earlier.)
426:       // Nodes, skins and animations are never candidates either.
427:       prune({
428:         propertyTypes: [PropertyType.ACCESSOR],
429:         keepLeaves: true,
430:         keepAttributes: true,
431:       })
432:     );
433:   } catch (e) {
434:     // A model that will not quantize is written uncompressed rather than
435:     // dropped: a fatter GLB is a far better outcome than a missing one.
436:     console.warn(`${fileName}: quantization skipped (${e}); writing as-is`);
437:   }
438: }
439: 
440: async function convertBMDToGLTF(bmd: BMD, outputFilename: string) {
441:   const fileName = outputFilename.split('/').at(-1)!.split('.')[0];
442: 
443:   const doc = new Document();
444:   const webpExtension = doc
445:     .createExtension(EXTTextureWebP as any)
446:     .setRequired(true);
447: 
448:   const buffer = doc.createBuffer();
449:   const scene = doc.createScene('mainScene');
450: 
451:   const modelRoot = doc.createNode(`model_${fileName}`);
452:   scene.addChild(modelRoot);
453: 
454:   const isSingleFrame =
455:     bmd.Bones.length === 1 &&
456:     bmd.Actions.length === 1 &&
457:     bmd.Actions[0].NumAnimationKeys === 1;
458: 
459:   let skin: Skin | undefined;
460: 
461:   const modelPos = { x: 0, y: 0, z: 0 };
462:   const modelRot = { x: 0, y: 0, z: 0, w: 1 };
463: 
464:   const allBonesWithoutParent = bmd.Bones.every(b => b.Parent === -1);
465:   if (bmd.Bones.length > 1 && allBonesWithoutParent) {
466:   }
467: 
468:   if (!isSingleFrame) {
469:     const skinNodes: Node[] = [];
470: 
471:     const skinRoot = doc.createNode(`skin_${fileName}`);
472:     skin = doc.createSkin();
473:     skin.setSkeleton(skinRoot);
474:     skin.addJoint(skinRoot);
475: 
476:     scene.addChild(skinRoot);
477: 
478:     let boneIndex = 0;
479:     for (const bmdBone of bmd.Bones) {
480:       const node = doc.createNode(`bone_${boneIndex}_${bmdBone.Name}`);
481:       skin.addJoint(node);
482: 
483:       skinNodes.push(node);
484: 
485:       // A bone whose parent is itself / a later bone (e.g. Object1/StreetLight01
486:       // bone 0 "Dummy" with Parent=0) would make the node graph cyclic and the
487:       // glTF loader recurse forever; the original client treats it as a root.
488:       const parentIndex = bmdBone.Parent;
489:       if (parentIndex < 0 || parentIndex >= boneIndex) {
490:         if (parentIndex >= 0) {
491:           console.warn(
492:             `${fileName}: bone ${boneIndex} "${bmdBone.Name}" has invalid parent ${parentIndex}, treating as root`
493:           );
494:         }
495:         skinRoot.addChild(node);
496:       } else {
497:         const parentNode = skinNodes[parentIndex];
498:         parentNode.addChild(node);
499:       }
500: 
501:       boneIndex++;
502:     }
503: 
504:     const DEFAULT_FPS = 24;
505: 
506:     for (let actionIndex = 0; actionIndex < bmd.Actions.length; actionIndex++) {
507:       const action = bmd.Actions[actionIndex];
508: 
509:       if (action.NumAnimationKeys === 0) continue;
510: 
511:       const animation = doc.createAnimation(
512:         `${fileName}_action_${actionIndex}`
513:       );
514: 
515:       const times: number[] = [];
516:       const dt =
517:         1 /
518:         (action.PlaySpeed && action.PlaySpeed > 0
519:           ? action.PlaySpeed * DEFAULT_FPS
520:           : DEFAULT_FPS);
521: 
522:       // How many of the authored keys the clip may actually reach - the
523:       // original's `Key` in PlayAnimation (ZzzBMD.cpp:415-421). A
524:       // LockPositions action wraps at `NumAnimationKeys - 1`, every other
525:       // action at `NumAnimationKeys`, so the last key of a locked action is
526:       // never displayed: it is a loop-closing duplicate of key 0 (measurably
527:       // so - across Player.bmd's walk/run actions the key N-1 -> key 0 delta
528:       // is ~0.1 against ~5 for every real interval). Emitting it as a real key
529:       // adds one motionless interval to every cycle: the legs hold while the
530:       // character keeps sliding, and the cycle runs 1/(N-1) too long.
531:       const keyCount =
532:         action.LockPositions && action.NumAnimationKeys > 1
533:           ? action.NumAnimationKeys - 1
534:           : action.NumAnimationKeys;
535: 
536:       for (let k = 0; k < keyCount; k++) {
537:         times.push(k * dt);
538:       }
539: 
540:       const isLongAnimation = keyCount > 1;
541: 
542:       // The wrap segment the original interpolates through: last key -> key 0.
543:       if (isLongAnimation) {
544:         times.push(keyCount * dt);
545:       }
546: 
547:       const inputAccessor = doc
548:         .createAccessor(`anim_${actionIndex}_input`)
549:         .setType('SCALAR')
550:         .setArray(new Float32Array(times))
551:         .setBuffer(buffer);
552: 
553:       const lockPositions = action.LockPositions;
554: 
555:       for (let boneIndex = 0; boneIndex < bmd.Bones.length; boneIndex++) {
556:         const bone = bmd.Bones[boneIndex];
557:         if (bone === BMDTextureBone.Dummy) continue;
558: 
559:         const boneMatrix = bone.Matrixes[actionIndex];
560: 
561:         if (
562:           boneMatrix.Position &&
563:           boneMatrix.Position.length === action.NumAnimationKeys
564:         ) {
565:           const posArray: number[] = [];
566:           for (let k = 0; k < keyCount; k++) {
567:             const cp = convertVec3(boneMatrix.Position[k]);
568:             posArray.push(
569:               cp.x * SCALE_MULTIPLIER,
570:               cp.y * SCALE_MULTIPLIER,
571:               cp.z * SCALE_MULTIPLIER
572:             );
573:           }
574: 
575:           if (boneIndex === 0 && lockPositions && posArray.length > 0) {
576:             for (let i = 3; i < posArray.length; i += 3) {
577:               posArray[i + 0] = posArray[0];
578:               posArray[i + 1] = posArray[1];
579:             }
580:           }
581: 
582:           if (isLongAnimation) {
583:             posArray.push(posArray[0], posArray[1], posArray[2]);
584:           }
585: 
586:           const posAccessor = doc
587:             .createAccessor(`anim_${actionIndex}_bone_${boneIndex}_T`)
588:             .setType('VEC3')
589:             .setArray(new Float32Array(posArray))
590:             .setBuffer(buffer);
591: 
592:           const sampler = doc
593:             .createAnimationSampler()
594:             .setInput(inputAccessor)
595:             .setOutput(posAccessor)
596:             .setInterpolation('LINEAR');
597: 
598:           const channel = doc
599:             .createAnimationChannel()
600:             .setTargetNode(skinNodes[boneIndex])
601:             .setTargetPath('translation')
602:             .setSampler(sampler);
603: 
604:           animation.addSampler(sampler).addChannel(channel);
605:         }
606: 
607:         if (
608:           boneMatrix.Quaternion &&
609:           boneMatrix.Quaternion.length === action.NumAnimationKeys
610:         ) {
611:           const rotArray: number[] = [];
612:           for (let k = 0; k < keyCount; k++) {
613:             const cq = convertQuaternion(boneMatrix.Quaternion[k]);
614:             rotArray.push(cq.x, cq.y, cq.z, cq.w);
615:           }
616: 
617:           if (isLongAnimation) {
618:             rotArray.push(rotArray[0], rotArray[1], rotArray[2], rotArray[3]);
619:           }
620: 
621:           const rotAccessor = doc
622:             .createAccessor(`anim_${actionIndex}_bone_${boneIndex}_R`)
623:             .setType('VEC4')
624:             .setArray(new Float32Array(rotArray))
625:             .setBuffer(buffer);
626: 
627:           const samplerR = doc
628:             .createAnimationSampler()
629:             .setInput(inputAccessor)
630:             .setOutput(rotAccessor)
631:             .setInterpolation('LINEAR');
632: 
633:           const channelR = doc
634:             .createAnimationChannel()
635:             .setTargetNode(skinNodes[boneIndex])
636:             .setTargetPath('rotation')
637:             .setSampler(samplerR);
638: 
639:           animation.addSampler(samplerR).addChannel(channelR);
640:         }
641:       }
642:     }
643:   } else {
644:     const bone = bmd.Bones[0];
645: 
646:     const boneMatrix = bone.Matrixes[0];
647: 
648:     const pos = boneMatrix.Position[0];
649:     const rot = boneMatrix.Quaternion[0];
650: 
651:     modelPos.x = pos.x * SCALE_MULTIPLIER;
652:     modelPos.y = pos.y * SCALE_MULTIPLIER;
653:     modelPos.z = pos.z * SCALE_MULTIPLIER;
654: 
655:     modelRot.x = rot.x;
656:     modelRot.y = rot.y;
657:     modelRot.z = rot.z;
658:     modelRot.w = rot.w;
659:   }
660: 
661:   let meshIndex = 0;
662:   const uniqueBonesPerMesh = new Set<number>();
663:   for (const bmdMesh of bmd.Meshes) {
664:     uniqueBonesPerMesh.clear();
665: 
666:     const node = doc.createNode(`node_${meshIndex}`);
667:     meshIndex++;
668:     modelRoot.addChild(node);
669: 
670:     if (skin) {
671:       node.setSkin(skin);
672:     } else {
673:       node.setTranslation([modelPos.x, modelPos.y, modelPos.z]);
674:       node.setRotation([modelRot.x, modelRot.y, modelRot.z, modelRot.w]);
675:     }
676: 
677:     const positionArray: number[] = [];
678:     const indicesArray: number[] = [];
679:     const texcoordArray: number[] = [];
680:     const normalsArray: number[] = [];
681:     const colorsArray: number[] = [];
682:     const boneIndexArray: number[] = [];
683:     const weightsArray: number[] = [];
684: 
685:     let pi = 0;
686: 
687:     const mesh = doc.createMesh(`mesh_${meshIndex}`);
688:     node.setMesh(mesh);
689: 
690:     for (let i = 0; i < bmdMesh.Triangles.length; i++) {
691:       const triangle = bmdMesh.Triangles[i];
692: 
693:       if (triangle.Polygon !== 3) throw new Error('Triangle is not a triangle');
694: 
695:       for (let j = 0; j < triangle.Polygon; j++) {
696:         const vertexIndex = triangle.VertexIndex[j];
697:         const vertex = bmdMesh.Vertices[vertexIndex];
698: 
699:         const normalIndex = triangle.NormalIndex[j];
700:         const normal = bmdMesh.Normals[normalIndex].Normal;
701:         const coordIndex = triangle.TexCoordIndex[j];
702:         const texCoord = bmdMesh.TexCoords[coordIndex];
703: 
704:         const pos = vertex.Position;
705:         const convPos = convertVec3(pos);
706: 
707:         positionArray.push(
708:           convPos.x * SCALE_MULTIPLIER,
709:           convPos.y * SCALE_MULTIPLIER,
710:           convPos.z * SCALE_MULTIPLIER
711:         );
712:         const convNormal = convertVec3(normal);
713:         normalsArray.push(convNormal.x, convNormal.y, convNormal.z);
714:         texcoordArray.push(texCoord.U, texCoord.V);
715:         colorsArray.push(1, 1, 1, 1);
716: 
717:         uniqueBonesPerMesh.add(vertex.Node + 1);
718: 
719:         if (!isSingleFrame) {
720:           boneIndexArray.push(vertex.Node + 1, 0, 0, 0);
721:           weightsArray.push(1, 0, 0, 0);
722:         }
723:       }
724: 
725:       const vInd0 = pi++;
726:       const vInd1 = pi++;
727:       const vInd2 = pi++;
728: 
729:       indicesArray.push(vInd0);
730:       indicesArray.push(vInd1);
731:       indicesArray.push(vInd2);
732:     }
733: 
734:     const indices = doc
735:       .createAccessor()
736:       .setArray(new Uint16Array(indicesArray))
737:       .setType('SCALAR')
738:       .setBuffer(buffer);
739:     const position = doc
740:       .createAccessor()
741:       .setArray(new Float32Array(positionArray))
742:       .setType('VEC3')
743:       .setBuffer(buffer);
744:     const texcoord = doc
745:       .createAccessor()
746:       .setArray(new Float32Array(texcoordArray))
747:       .setType('VEC2')
748:       .setBuffer(buffer);
749:     const normal = doc
750:       .createAccessor()
751:       .setArray(new Float32Array(normalsArray))
752:       .setType('VEC3')
753:       .setBuffer(buffer);
754:     const color = doc
755:       .createAccessor()
756:       .setArray(new Float32Array(colorsArray))
757:       .setType('VEC4')
758:       .setBuffer(buffer);
759: 
760:     const isTransparent = bmdMesh.TexturePath.endsWith('.tga');
761:     const texPath = DATA_FOLDER + bmd.Dir + bmdMesh.TexturePath;
762: 
763:     const texture = doc.createTexture(
764:       bmd.Dir + bmdMesh.TexturePath.split('.')[0]
765:     );
766:     let texSuccess = false;
767: 
768:     try {
769:       const bytes = await readTextureBytes(texPath, bmd.Dir);
770:       const webpBytes = await convertImageToWebP(bytes);
771:       texture.setImage(webpBytes);
772:       texture.setMimeType(`image/webp`);
773:       texSuccess = true;
774:     } catch (e) {
775:       texFailures.push(`${texPath}: ${(e as Error).message}`);
776:       // A Texture left in the document with no image makes gltf-transform's
777:       // GLB writer throw (`json.bufferViews[json.images[i].bufferView]` is
778:       // undefined) *after* `Bun.write(outputFilename, '')` has already
779:       // truncated the target: every 0-byte GLB in public/game-assets was a
780:       // model with one unresolvable texture. Drop the empty texture so the
781:       // mesh is written untextured instead of not at all.
782:       texture.dispose();
783:     }
784: 
785:     const material = doc
786:       .createMaterial()
787:       .setRoughnessFactor(1)
788:       .setMetallicFactor(0);
789: 
790:     material.setAlphaMode(isTransparent ? 'BLEND' : 'OPAQUE');
791: 
792:     if (texSuccess) {
793:       material.setBaseColorTexture(texture);
794:     }
795: 
796:     const prim = doc
797:       .createPrimitive()
798:       .setMaterial(material)
799:       .setIndices(indices)
800:       .setAttribute('POSITION', position)
801:       .setAttribute('TEXCOORD_0', texcoord)
802:       .setAttribute('NORMAL', normal)
803:       .setAttribute('COLOR_0', color);
804: 
805:     if (!isSingleFrame) {
806:       const boneIndex = doc
807:         .createAccessor()
808:         .setArray(new Uint8Array(boneIndexArray))
809:         .setType('VEC4')
810:         .setBuffer(buffer);
811:       const weights = doc
812:         .createAccessor()
813:         .setArray(new Float32Array(weightsArray))
814:         .setType('VEC4')
815:         .setBuffer(buffer);
816: 
817:       prim
818:         .setAttribute('JOINTS_0', boneIndex)
819:         .setAttribute('WEIGHTS_0', weights);
820:     }
821: 
822:     mesh.addPrimitive(prim);
823:   }
824: 
825:   await compress(doc, fileName);
826: 
827:   if (USE_MESHOPT) {
828:     const meshopt = doc.createExtension(EXTMeshoptCompression as any) as any;
829:     meshopt.setRequired(true).setEncoderOptions({
830:       method: (EXTMeshoptCompression as any).EncoderMethod.QUANTIZE,
831:     });
832:   }
833: 
834:   const io = new NodeIO();
835:   io.registerExtensions([
836:     EXTTextureWebP as any,
837:     KHRMeshQuantization as any,
838:     EXTMeshoptCompression as any,
839:   ]);
840:   io.registerDependencies({ 'meshopt.encoder': MeshoptEncoder });
841:   await Bun.write(outputFilename, '', { createPath: true });
842:   await io.write(outputFilename, doc);
843: }
844: 
845: if (USE_MESHOPT) await MeshoptEncoder.ready;
846: 
847: const reader = new BMDReader();
848: 
849: const folderFilters = process.argv.slice(2).map(f => f.replace(/[/\\]+$/, ''));
850: 
851: const files = [...glob.scanSync(DATA_FOLDER)].filter(file => {
852:   if (folderFilters.length === 0) return true;
853: 
854:   const normalized = file.replace(/\\/g, '/').toLowerCase();
855: 
856:   // Filters are folders ("Object1") or single files ("Object1/StreetLight01.bmd").
857:   return folderFilters.some(
858:     filter =>
859:       normalized.startsWith(filter.toLowerCase() + '/') ||
860:       normalized === filter.toLowerCase()
861:   );
862: });
863: 
864: if (folderFilters.length > 0) {
865:   console.log(
866:     `Filtering to [${folderFilters.join(', ')}]: ${files.length} models`
867:   );
868: }
869: 
870: async function processFile(rawRelInputFilePath: string) {
871:   const relInputFilePath = rawRelInputFilePath.replace(/\\/g, '/');
872: 
873:   const inputFileName = relInputFilePath.split('/').at(-1)!;
874: 
875:   const absInputFilePath = DATA_FOLDER + relInputFilePath;
876:   const inputFolder = relInputFilePath.replace(inputFileName, '');
877:   // Spelled the way the client asks for it, not the way Data/ spells it -
878:   // see tools/assetCase.ts.
879:   const outputFileName =
880:     OUTPUT_FOLDER +
881:     canonicalAssetPath(relInputFilePath.replace(BMD_EXT, '.glb'));
882: 
883:   for (const ignoreFile of IGNORE_FILES) {
884:     if (ignoreFile === inputFileName) {
885:       return;
886:     }
887:   }
888: 
889:   const buffer = await Bun.file(absInputFilePath).bytes();
890: 
891:   try {
892:     const bmd = reader.read(buffer, inputFolder);
893: 
894:     // Some BMDs legitimately contain no geometry, and their GLBs carry bones
895:     // and animations only. Verified byte-exact against the sources (an
896:     // independent layout walk consumes the whole file with a mesh count of 0
897:     // in the header): Player/player.bmd
898:     // and the NPC/Girl01|Man01|Female01 rigs, whose geometry ships in the
899:     // *Head/*Upper/*Lower part files and is composed at runtime (see
900:     // src/common/npcs/lumen.ts), plus animation-only companions such as
901:     // NPC/songkoani.bmd (for songko.bmd) or Monster/condra_7_cone_left.bmd.
902:     // Logged so a 0-mesh GLB is never again mistaken for a converter bug -
903:     // but a *new* name appearing in this list is worth a look.
904:     if (bmd.Meshes.length === 0) {
905:       console.log(
906:         `${relInputFilePath}: rig-only BMD (mesh count 0 in source) - GLB carries bones+animations only`
907:       );
908:     }
909: 
910:     await convertBMDToGLTF(bmd, outputFileName);
911:   } catch (e) {
912:     console.error(`Error converting ${absInputFilePath}:`, e);
913:   }
914: }
915: 
916: await Promise.all(files.map(processFile));
917: 
918: console.log(`Processed ${files.length} files!`);
919: 
920: if (texPicks.length > 0) {
921:   console.warn(
922:     `\n${texPicks.length} textures were taken from another folder whose copies differ:`
923:   );
924:   for (const pick of texPicks.sort()) console.warn(`  ${pick}`);
925: }
926: 
927: if (texFailures.length > 0) {
928:   console.warn(`\n${texFailures.length} textures could not be resolved:`);
929:   for (const failure of texFailures.slice(0, 20)) {
930:     console.warn(`  ${failure}`);
931:   }
932:   if (texFailures.length > 20) {
933:     console.warn(`  ...and ${texFailures.length - 20} more`);
934:   }
935: } else {
936:   console.log('All referenced textures resolved.');
937: }
