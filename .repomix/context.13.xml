164: /** A texel rectangle, inclusive; `x0 > x1` means empty. */
165: type Rect = { x0: number; z0: number; x1: number; z1: number };
166: 
167: const emptyRect = (r: Rect): Rect => {
168:   r.x0 = BURN_SIZE;
169:   r.z0 = BURN_SIZE;
170:   r.x1 = -1;
171:   r.z1 = -1;
172:   return r;
173: };
174: const rectEmpty = (r: Rect): boolean => r.x1 < r.x0 || r.z1 < r.z0;
