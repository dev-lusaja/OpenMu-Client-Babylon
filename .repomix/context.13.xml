256:   for (const [container, headerSize] of containers) {
257:     const found = inFolder(folder, base + container);
258: 
259:     if (found) return (await Bun.file(found).bytes()).slice(headerSize);
260:   }
261: 
262:   // Not in the model's folder - look for it by name in the rest of the tree.
263:   // Both spellings of a container are one entry in that index, so the two
264:   // cases collapse to one lookup per container.
265:   const fileName = base.slice(base.lastIndexOf('/') + 1);
