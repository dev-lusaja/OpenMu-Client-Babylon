152: export const LORENCIA_LEAVES: AmbientRecipe = {
153:   name: 'lorenciaLeaves',
154:   texture: 'World1/leaf01.OZT',
155:   blend: 'alpha',
156:   // 80 leaves alive at a time in the original. Count is rate x life, so the
157:   // longer life below is paid for by a proportionally lower rate: 14/s over
158:   // ~5.75 s is the same ~80 leaves in the air.
159:   rate: 14,
