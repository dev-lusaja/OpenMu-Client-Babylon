141: /** Sort key: the model's own folder first, then FOLDER_ORDER, then shallowest. */
142: function pickOrder(
143:   path: string,
144:   modelTop: string
145: ): [number, number, number, string] {
146:   const relative = path.slice(DATA_FOLDER.length);
147:   const top = relative.slice(0, relative.indexOf('/')).toLowerCase();
