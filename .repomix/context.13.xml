<file path="versions/v097d/index.ts">
  1: /**
  2:  * MU 0.97d - the second version this client carries, and the proving ground
  3:  * for the runtime version seam (Phase 7 step b).
  4:  *
  5:  * OpenMU coverage is partial and that shapes several values below:
  6:  * `Persistence/Initialization/Version097d/` holds only `Items/Jewels.cs`
  7:  * (Version095d's jewels plus the Jewel of Creation) and no
  8:  * `DataInitialization`, so `-version:` accepts season6 / 0.75 / 0.95d only.
  9:  * A 0.97d world is therefore seeded from `0.95d` today. The protocol side is
 10:  * real: OpenMU carries `MinimumClient(0, 97)` view and message plug-ins, so
 11:  * a client that logs in as ClientVersion(0, 97) is answered with a distinct
 12:  * packet mix (see variantRank).
 13:  */
 14: import { asciiBytes, type GameVersion } from '../../src/version/contract';
 15: import { v097dData } from './data';
 16: 
 17: // The packet lists ride along in the version chunk; UI does not (it reaches
 18: // app code and loads through the registry's loadUi, after this module).
 19: export * as packets from './packets';
 20: 
 21: /**
 22:  * Identical to Season 6. Proven, not assumed: the reference client's own
 23:  * Webzen `Data/Enc1.dat` / `Data/Dec2.dat` (2003) decode with OpenMU's
 24:  * `SimpleModulusKeySerializer` to exactly these 4+4+4 values - which is what
 25:  * `PreSeason6NetworkEncryptionFactoryPlugIn` says ("the simple modulus keys
 26:  * were never changed").
 27:  */
 28: const CLIENT_TO_SERVER_KEYS = [128079, 164742, 70235, 106898, 23489, 11911, 19816, 13647, 48413, 46165, 15171, 37433];
 29: const SERVER_TO_CLIENT_KEYS = [73326, 109989, 98843, 171058, 18035, 30340, 24701, 11141, 62004, 64409, 35374, 64599];
 30: 
 31: /** OpenMU `PreSeason6NetworkEncryptionFactoryPlugIn.Xor32Key` - every client before Season 6. */
 32: const XOR32_KEY = new Uint8Array([
 33:   0xe7, 0x6d, 0x3a, 0x89, 0xbc, 0xb2, 0x9f, 0x73, 0x23, 0xa8, 0xfe, 0xb6, 0x49, 0x5d, 0x39, 0x5d,
 34:   0x8a, 0xcb, 0x63, 0x8d, 0xea, 0x7d, 0x2b, 0x5f, 0xc3, 0xb1, 0xe9, 0x83, 0x29, 0x51, 0xe8, 0x56,
 35: ]);
 36: 
 37: /** Unchanged since 0.75; the three bytes also sit verbatim in the reference client's binary. */
 38: const XOR3_KEY = new Uint8Array([0xfc, 0xcf, 0xab]);
 39: 
 40: /**
 41:  * Families where OpenMU still answers a 0.97d client with the 0.75 layout:
 42:  * the newer plug-in for that view demands `MinimumClient(1, 0)` or higher, or
 43:  * no other variant exists at all.
 44:  */
 45: const PREFERRED_075 = new Set([
 46:   // NewPlayersInScopePlugIn095 sends the 075 packet for transformed players.
 47:   'AddTransformedCharactersToScope075',
 48:   // NpcDialogClosedPlugIn075, MaximumClient(0, 99).
 49:   'CraftingDialogClosed075',
 50:   // MapChangePlugIn / TeleportPlugIn are MinimumClient(1, 0).
 51:   'MapChanged075',
 52:   // ObjectMovedPlugIn is MinimumClient(1, 0).
 53:   'ObjectWalked075',
 54:   // SkillListViewPlugIn095 inherits the full-list send from the 075 plug-in.
 55:   'SkillListUpdate075',
 56: ]);
 57: 
 58: /**
 59:  * Which generated variant wins when several packets share a code, mirroring
 60:  * how OpenMU's `ViewPlugInContainer` resolves plug-ins for a client at
 61:  * ClientVersion(0, 97): the suitable plug-in with the highest
 62:  * `MinimumClient` wins, and a `MaximumClient` below 0.97 rules one out.
 63:  *
 64:  * So: `…097` first, then `…095`, then the handful of `…075` layouts OpenMU
 65:  * has nothing newer for, then the classic layout (its 075 sibling is capped
 66:  * at `MaximumClient(0, 89)`), and never `…Extended` (client >= 106.3).
 67:  */
 68: function variantRank(name: string): number {
 69:   if (/097$/.test(name)) return 0;
 70:   if (/095$/.test(name)) return 1;
 71:   if (PREFERRED_075.has(name)) return 2;
 72:   if (/075$/.test(name)) return 4;
 73:   if (/Extended$/.test(name)) return 5;
 74: 
 75:   return 3;
 76: }
 77: 
 78: export const gameVersion: GameVersion = {
 79:   id: 'v097d',
 80:   label: 'MU 0.97d',
 81:   listTag: 'V097D',
 82:   openMu: {
 83:     // ClientVersion(0, 97), the value OpenMU's MinimumClient(0, 97) plug-ins
 84:     // compare against.
 85:     season: 0,
 86:     episode: 97,
 87:     // OpenMU has no 0.97d DataInitialization; Version097d is an item overlay
 88:     // on Version095d, which is what actually seeds a 0.97d world.
 89:     initializer: 'Version095d',
 90:     versionArg: '0.95d',
 91:   },
 92:   /**
 93:    * The five bytes the reference 0.97d client puts on the wire. They are
 94:    * stored mangled in the binary, exactly the way Webzen wrote the array in
 95:    * source (`{'0'+1, '9'+2, '7'+3, '0'+4, '4'+5}` - the same idiom the S6
 96:    * reference client still carries commented out in `WSclient.cpp`), so the
 97:    * version reads "09704", in line with OpenMU's "09504" for 0.95d.
 98:    * OpenMU seeds no `GameClientDefinition` for 0.97d: an operator has to add
 99:    * one with these bytes, or the server falls back to its default version.
100:    */
101:   clientVersionBytes: [0x31, 0x3b, 0x3a, 0x34, 0x39],
102:   /**
103:    * The reference client's serial. OpenMU never reads the serial
104:    * (`LogInHandlerPlugIn` resolves the client from the version bytes alone),
105:    * and this build is a private server's, so it is the one real 0.97d serial
106:    * available rather than a Webzen original.
107:    */
108:   serialBytes: asciiBytes('St0n3agemu97d99i'),
109:   protocol: {
110:     packetSet: '0.97d',
111:     variantRank,
112:     encryption: {
113:       clientToServer: CLIENT_TO_SERVER_KEYS,
114:       serverToClient: SERVER_TO_CLIENT_KEYS,
115:       xor32Key: XOR32_KEY,
116:       xor3Key: XOR3_KEY,
117:     },
118:   },
119:   data: v097dData,
120:   features: {
121:     // Master level arrived in Season 3.
122:     masterSkills: false,
123:     // Sockets are Season 4.
124:     socketItems: false,
125:     // Version095d's option types are Option / Luck / Excellent only, and the
126:     // client ships no ItemSetOption.bmd.
127:     ancientItems: false,
128:     // Harmony and refine stones are Season 3.
129:     harmonyJewel: false,
130:     // OpenMU's ShowCharacterListPlugIn095: "0.95 doesn't support dark lord
131:     // (number 16) and newer classes yet".
132:     darkLord: false,
133:     // Version095d's CharacterClassInitialization creates it, and class 12
134:     // fits the 095 character-list layout.
135:     magicGladiator: true,
136:     // Summoner is Season 3, Rage Fighter Season 5.
137:     summoner: false,
138:     rageFighter: false,
139:     // MU Helper is Season 6 Episode 3.
140:     muHelper: false,
141:     // The consumable belt row and the cash shop are Season 6; the 0.97d
142:     // client's 97-file Interface set has neither.
143:     itemHotkeys: false,
144:     cashShop: false,
145:     // Devil Square: the client has World10, OpenMU Version095d runs
146:     // DevilSquareInitializer. Blood Castle has the map (World12) but no
147:     // server side yet; Chaos Castle does not exist in 0.97d.
148:     events: true,
149:     // The flag means the Season 6 quest windows (Quest_eng.bmd). 0.97d has
150:     // the legacy chain instead (Local/Quest.bmd, OpenMU NpcWindow.LegacyQuest).
151:     questDialogs: false,
152:   },
153: };
</file>

<file path="versions/v097d/variantRank.test.ts">
 1: import { describe, expect, it } from 'vitest';
 2: import { gameVersion } from './index';
 3: 
 4: const rank = gameVersion.protocol.variantRank;
 5: 
 6: /** The variant a 0.97d client must win with, per family that shares a code. */
 7: const WINNERS: [winner: string, losers: string[]][] = [
 8:   // UpdateCharacterStatsPlugIn097, MinimumClient(0, 97).
 9:   ['CharacterInformation097', ['CharacterInformation', 'CharacterInformation075', 'CharacterInformationExtended']],
10:   // The …095 view plug-ins outrank their 075 siblings at 0.97.
11:   ['AddCharactersToScope095', ['AddCharactersToScope', 'AddCharactersToScope075', 'AddCharacterToScopeExtended']],
12:   ['AddNpcsToScope095', ['AddNpcsToScope', 'AddNpcsToScope075']],
13:   ['AddSummonedMonstersToScope095', ['AddSummonedMonstersToScope', 'AddSummonedMonstersToScope075']],
14:   ['AreaSkillAnimation095', ['AreaSkillAnimation', 'AreaSkillAnimation075']],
15:   ['SkillAnimation095', ['SkillAnimation', 'SkillAnimation075']],
16:   ['CharacterList095', ['CharacterList', 'CharacterList075', 'CharacterListExtended']],
17:   ['RespawnAfterDeath095', ['RespawnAfterDeath', 'RespawnAfterDeath075', 'RespawnAfterDeathExtended']],
18:   ['SkillAdded095', ['SkillAdded', 'SkillAdded075']],
19:   ['SkillRemoved095', ['SkillRemoved', 'SkillRemoved075']],
20:   // Nothing newer is suitable: MapChangePlugIn / ObjectMovedPlugIn are
21:   // MinimumClient(1, 0), and the others have no 095 sibling at all.
22:   ['MapChanged075', ['MapChanged']],
23:   ['ObjectWalked075', ['ObjectWalked', 'ObjectWalkedExtended']],
24:   ['AddTransformedCharactersToScope075', ['AddTransformedCharactersToScope']],
25:   ['SkillListUpdate075', ['SkillListUpdate']],
26:   // The classic layout wins where OpenMU caps the 075 plug-in at 0.89.
27:   ['MoneyDropped', ['MoneyDropped075', 'MoneyDroppedExtended']],
28:   ['PartyList', ['PartyList075']],
29:   ['GuildList', ['GuildList075']],
30:   ['MagicEffectCancelled', ['MagicEffectCancelled075']],
31:   ['AssignCharacterToGuild', ['AssignCharacterToGuild075']],
32: ];
33: 
34: describe('0.97d variant rank', () => {
35:   it.each(WINNERS)('prefers %s', (winner, losers) => {
36:     for (const loser of losers) {
37:       expect(rank(winner)).toBeLessThan(rank(loser));
38:     }
39:   });
40: 
41:   it('never picks an Extended (client >= 106.3) layout', () => {
42:     expect(rank('CharacterInformationExtended')).toBeGreaterThan(rank('CharacterInformation'));
43:     expect(rank('MoneyDroppedExtended')).toBeGreaterThan(rank('MoneyDropped'));
44:   });
45: });
46: 
47: describe('0.97d contract', () => {
48:   it('uses the pre-Season-6 Xor32 key and the shared SimpleModulus keys', () => {
49:     const { encryption } = gameVersion.protocol;
50:     expect([...encryption.xor32Key.slice(0, 4)]).toEqual([0xe7, 0x6d, 0x3a, 0x89]);
51:     expect(encryption.xor32Key.length).toBe(32);
52:     expect([...encryption.xor3Key]).toEqual([0xfc, 0xcf, 0xab]);
53:     expect(encryption.clientToServer[0]).toBe(128079);
54:     expect(encryption.serverToClient[0]).toBe(73326);
55:   });
56: 
57:   it('sends the five version bytes of the 0.97d client', () => {
58:     expect([...gameVersion.clientVersionBytes]).toEqual([0x31, 0x3b, 0x3a, 0x34, 0x39]);
59:     // The same bytes unmangled ('0'+1, '9'+2, '7'+3, '0'+4, '4'+5).
60:     const plain = gameVersion.clientVersionBytes.map((b, i) => b - (i + 1));
61:     expect(String.fromCharCode(...plain)).toBe('09704');
62:     expect(gameVersion.serialBytes.length).toBe(16);
63:   });
64: });
