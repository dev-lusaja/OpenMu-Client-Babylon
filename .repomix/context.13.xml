1349: /** World-space direction toward the sun, from the key rig. */
1350: function sunDirection(scene: Scene): Vector3 {
1351:   // The rig creates it pointing (0.4, -1, 0.6); we want the other way.
1352:   const d = sunLightOf(scene)?.direction ?? new Vector3(0.4, -1, 0.6);
1353:   return new Vector3(-d.x, -d.y, -d.z).normalize();
1354: }
1355: 
1356: /**
1357:  * One material per kind, built on demand.
1358:  *
1359:  * Only ever one is in use: a map is either a snow map or a wet map, never
1360:  * both, so the mesh swaps its material rather than paying for a second draw
1361:  * call. A map change clears the pool, so no print ever outlives its own sole.
1362:  */
1363: /**
1364:  * A kind's material, its sole atlas, and which rows of that atlas have
1365:  * actually been baked.
1366:  *
1367:  * The rows are baked lazily (`ensureShape`). Six silhouettes times four
1368:  * variants is about a quarter of a million texels of value noise, and most
1369:  * sessions press two or three shapes into the ground; paying for the spiders
1370:  * and the hooves the first time it snows is a stall for nothing. An unbaked
1371:  * row is all zeroes, which is coverage 0 - a print drawn from it would be
1372:  * invisible rather than wrong, and `ensureShape` runs before any print can
1373:  * claim a cell in it.
1374:  */
1375: type SoleAtlas = {
1376:   material: ShaderMaterial;
1377:   texture: RawTexture;
1378:   data: Uint8Array;
1379:   baked: Set<TrackShape>;
1380: };
1381: 
1382: const materials = new Map<PrintKind, SoleAtlas>();
1383: 
1384: /**
1385:  * Bake this shape's row if it has not been baked, and push the atlas.
1386:  *
1387:  * The whole texture goes up rather than the row's sub-rectangle: it happens
1388:  * at most six times per kind per map, and a `texSubImage2D` with the cell
1389:  * arithmetic done wrong fails as prints that are silently invisible, which is
1390:  * the worst way for this to break. `RawTexture.update` cannot get it wrong.
1391:  */
1392: function ensureShape(atlas: SoleAtlas, kind: PrintKind, shape: TrackShape): void {
1393:   if (atlas.baked.has(shape) || shapeRow(shape) < 0) return;
1394: 
1395:   atlas.baked.add(shape);
1396:   writeShape(atlas.data, kind, shape);
1397:   atlas.texture.update(atlas.data);
1398: }
1399: 
1400: function materialFor(scene: Scene, kind: PrintKind): ShaderMaterial {
1401:   return atlasFor(scene, kind).material;
1402: }
1403: 
1404: function atlasFor(scene: Scene, kind: PrintKind): SoleAtlas {
1405:   const existing = materials.get(kind);
1406:   if (existing && existing.material.getScene() === scene) return existing;
1407: 
1408:   const material = new ShaderMaterial(
1409:     `_footprints_${kind}`,
1410:     scene,
1411:     { vertexSource: VERTEX, fragmentSource: FRAGMENT },
1412:     {
1413:       // Just the mesh's own. Babylon appends world0..3 and instanceColor
1414:       // itself once it sees the mesh has thin instances with a colour buffer.
1415:       attributes: ['position', 'uv'],
1416:       uniforms: [
1417:         'world',
1418:         'viewProjection',
1419:         'cameraPosition',
1420:         'sunDir',
1421:         'soleParams',
1422:         'soleTint',
1423:         'atlasSpan',
1424:         'atlasEdge',
1425:         'linearOut',
1426:       ],
1427:       samplers: ['soleSampler'],
1428:       needAlphaBlending: true,
1429:     }
1430:   );
1431: 
1432:   const width = atlasWidth();
1433:   const height = atlasHeight(kind);
1434: 
1435:   // Empty: every row is baked on demand by `ensureShape`.
1436:   const data = new Uint8Array(width * height * 4);
1437: 
1438:   const texture = RawTexture.CreateRGBATexture(
1439:     data,
1440:     width,
1441:     height,
1442:     scene,
1443:     false,
1444:     false,
1445:     Texture.BILINEAR_SAMPLINGMODE
1446:   );
1447:   texture.name = `footprintSole_${kind}`;
1448:   texture.wrapU = Texture.CLAMP_ADDRESSMODE;
1449:   texture.wrapV = Texture.CLAMP_ADDRESSMODE;
1450: 
1451:   material.setTexture('soleSampler', texture);
1452:   material.setVector3('sunDir', sunDirection(scene));
1453:   material.setFloat('linearOut', linearBufferActive(scene) ? 1 : 0);
1454:   const tint = TINT[kind];
1455:   material.setVector3('soleTint', new Vector3(tint[0], tint[1], tint[2]));
1456: 
1457:   const [spanU, spanV] = atlasSpan(kind);
1458:   material.setVector2('atlasSpan', new Vector2(spanU, spanV));
1459:   // Half a texel in, so a bilinear fetch at the edge of a cell cannot pick up
1460:   // the sole next door.
1461:   material.setVector2('atlasEdge', new Vector2(0.5 / width, 0.5 / height));
1462: 
1463:   material.setVector4(
1464:     'soleParams',
1465:     new Vector4(
1466:       // Relief reach in CELL uv: the hollow's depth as a fraction of the
1467:       // quad's own length, which is the axis the march mostly runs along. The
1468:       // shader takes it into atlas scale itself (`toAtlas`), because that
1469:       // scale is now a vec2 - the grid is variants across by shapes down and
1470:       // is no longer square.
1471:       //
1472:       // Getting this scale wrong is what made every print vanish when the
1473:       // atlas first went in: a reach measured against the whole texture
1474:       // overshot the cell on the first march step, soleUV() clamped it to the
1475:       // border, and the border is outside the outline - coverage 0, alpha 0,
1476:       // nothing drawn. The clamp was doing its job; it was being handed a ray
1477:       // that had no business leaving.
1478:       FOOTPRINT_TUNING.depth / quadLength(),
1479:       FOOTPRINT_TUNING.ao,
1480:       FOOTPRINT_TUNING.ambient,
1481:       FOOTPRINT_TUNING.rim
1482:     )
1483:   );
1484: 
1485:   material.backFaceCulling = false;
1486:   material.alphaMode = Constants.ALPHA_PREMULTIPLIED;
1487:   material.disableDepthWrite = true;
1488:   // Pull the decal toward the camera in depth so it wins against the terrain
1489:   // it is lying on without needing a bigger Z_LIFT.
1490:   material.zOffset = -8;
1491: 
1492:   material.onDisposeObservable.addOnce(() => texture.dispose());
1493: 
1494:   const atlas: SoleAtlas = { material, texture, data, baked: new Set() };
1495:   materials.set(kind, atlas);
1496: 
1497:   return atlas;
1498: }
