 56:     const names = itemNames(
 57:       buildItemPack(
 58:         source({ items: { '0/0': 'Dolch', '7/0': 'Bronzehelm', '12/15': 'Chaos-Juwel' } }),
 59:         problems
 60:       )
 61:     );
 62: 
 63:     expect(problems).toEqual([]);
 64:     expect(names.get(0)).toBe('Dolch');
 65:     expect(names.get(7 * 512 + 0)).toBe('Bronzehelm');
 66:     expect(names.get(12 * 512 + 15)).toBe('Chaos-Juwel');
