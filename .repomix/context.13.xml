13: 
14: /**
15:  * THE list. Every weather effect in the game is one entry here, and adding an
16:  * effect is adding one line. Nothing else in the codebase enumerates them.
17:  *
18:  * Order is update order and it matters: an effect that reads another must
19:  * come after it. Today that is only wetness → rain.
20:  */
21: export const WEATHER_LAYERS: readonly WeatherLayer[] = [
22:   rainLayer,
23:   snowCoverLayer, // reads the squall schedule, not rain - order-free
24:   wetnessLayer, // reads rainLayer
25:   footprintsLayer, // reset only; laid down by FootprintSystem
26:   snowSprayLayer, // reset only; fired by FootprintSystem
27:   snowCapsLayer, // reads snowCoverLayer; bound by the item material
28:   snowTrailLayer, // ploughed by FootprintSystem; sampled by the terrain shader
29:   snowMeltLayer, // patched by the fire skills; read by snowSinkLayer below and the shader
30:   snowSinkLayer, // reads snowCoverLayer + the overlay bed table + snowMeltLayer; asked by renderSystem
31:   grassBurnLayer, // lit by the fire skills; sampled by the grass shader
32:   puddleUnderfootLayer, // reads wetnessLayer; asked by FootprintSystem
33: ];
</file>

<file path="src/weather/puddleUnderfoot.ts">
 1: import type { WeatherLayer } from './layer';
 2: import { isTileOpen } from '../libs/mu/terrainMask';
 3: import {
 4:   PUDDLES,
 5:   WET_GROUND,
 6:   overlayAmountAt,
 7: } from '../libs/mu/terrainOverlay';
 8: import type { World } from '../ecs/world';
 9: 
10: /**
11:  * Whether there is standing water under a point - the CPU's view of the
12:  * `PUDDLES` terrain layer, for the footprints.
13:  *
14:  * The wet-boot mechanic (`footprintSystem.ts`) is: step in a puddle, the
15:  * sole is charged; each print spends some of it; the trail dims and stops.
16:  * Its first cut asked `puddleCover() > 0.3` - *are there puddles on this
17:  * map* - so once the streets had pooled the boot recharged on every outdoor
18:  * step and never dried. A puddle is a patch, not a state, and this asks
19:  * about the patch: the same break-up noise, slope test and threshold the
20:  * shader paints with, so the boot gets wet where the eye sees water.
21:  *
22:  * Owned here, read through `weather.puddleUnderfoot`.
23:  */
24: 
25: // ---- 1. tuning ---------------------------------------------------------
26: 
27: /** How far either side of the point the ground slope is measured, in tiles. */
28: const SLOPE_SPAN = 0.5;
29: 
30: /**
31:  * How much of a puddle's charge wet-but-not-pooled ground gives the boot.
32:  * Under the 0.5 that `footprintSystem` treats as a full soak, so wet ground
33:  * only ever part-charges: prints at about half strength, gone in ~5 steps.
34:  */
35: const DAMP_SHARE = 0.45;
36: 
37: // ---- 2. readers --------------------------------------------------------
38: 
39: /**
40:  * How much puddle is drawn under world (x, z), 0…1. Zero indoors, on a
41:  * slope, before the rain has pooled, and outside the noise patches.
42:  */
43: export function puddleUnderfoot(world: World, x: number, z: number): number {
44:   const open = isTileOpen(x, z);
45:   if (!open) return 0;
46: 
47:   // The ground's normal Y from four height samples, standing in for the
48:   // per-tile facet normal the shader tests. The layer only holds within a
49:   // few degrees of level, so this only has to tell "flat" from "not".
50:   const hx0 = world.getTerrainHeight(x - SLOPE_SPAN, z);
51:   const hx1 = world.getTerrainHeight(x + SLOPE_SPAN, z);
52:   const hz0 = world.getTerrainHeight(x, z - SLOPE_SPAN);
53:   const hz1 = world.getTerrainHeight(x, z + SLOPE_SPAN);
54: 
55:   if (hx0 <= -9000 || hx1 <= -9000 || hz0 <= -9000 || hz1 <= -9000) return 0;
56: 
57:   const gx = (hx1 - hx0) / (2 * SLOPE_SPAN);
58:   const gz = (hz1 - hz0) / (2 * SLOPE_SPAN);
59:   const normalY = 1 / Math.sqrt(1 + gx * gx + gz * gz);
60: 
61:   // A puddle soaks the boot. Rain-darkened ground short of a puddle only
62:   // dampens it: the trail is there in the rain, dimmer, and dries sooner.
63:   // Without this the streets had to pool before a single print showed -
64:   // and the pooling is slow, patchy, and absent from the bridge, where
65:   // "characters leave no footprints" was reported.
66:   return Math.max(
67:     overlayAmountAt(PUDDLES, x, z, normalY, true),
68:     overlayAmountAt(WET_GROUND, x, z, normalY, true) * DAMP_SHARE
69:   );
70: }
71: 
72: // ---- 3. the layer ------------------------------------------------------
73: 
74: /** Nothing to advance or reset: the cover it reads is owned by `wetnessLayer`. */
75: export const puddleUnderfootLayer: WeatherLayer = { name: 'puddleUnderfoot' };
</file>

<file path="src/weather/rainState.ts">
  1: import { ENUM_WORLD } from '../common/types';
  2: import type { WeatherLayer } from './layer';
  3: import { Store } from '../store';
  4: import { CHAOS_CASTLE_WORLDS, DEVIL_SQUARE_WORLDS } from '../common/worldAssets';
  5: 
  6: /**
  7:  * Rain strength, ported from `RainTarget` / `RainCurrent`
  8:  * (ZzzEffectFireLeave.cpp:27-28, 422-452).
  9:  *
 10:  * The weather byte's meaning is no longer an assumption - `ReceiveWeather`
 11:  * (WSclient.cpp:6716) reads it as:
 12:  *
 13:  * ```cpp
 14:  * int Weather = (Data->Value >> 4);
 15:  * if (Weather == 0)      RainTarget = 0;
 16:  * else if (Weather == 1) RainTarget = (Data->Value & 15) * 6;
 17:  * ```
 18:  *
 19:  * So the high nibble is the kind (**0 clear, 1 rain - confirmed**, and no
 20:  * other value does anything: snow is a property of the map, never of this
 21:  * packet) and the low nibble is the **intensity**, which the clone was
 22:  * discarding. `RainTarget` lands in 0…90, `Rainly = RainCurrent * MAX_LEAVES
 23:  * / 100` with `MAX_LEAVES = 200` (_define.h:443), so `RainCurrent / 100` is
 24:  * the share of the full particle budget - that is the number below.
 25:  *
 26:  * `RainCurrent` chases `RainTarget` by one unit per reference frame rather
 27:  * than snapping, which is what stops a weather packet from switching a
 28:  * downpour on between two frames. At 25 Hz that is 0.25 of full strength per
 29:  * second, a ~4 s ramp across the whole range - and four seconds is where the
 30:  * port stops being useful, because a shower that arrives in four seconds
 31:  * reads as a switch. See `RAMP_UP_SECONDS`.
 32:  */
 33: 
 34: // ---- 1. tuning -------------------------------------------------------------
 35: 
 36: /** Server weather kind 1 = rain (`ReceiveWeather`, WSclient.cpp:6722). */
 37: export const WEATHER_RAIN = 1;
 38: 
 39: /**
 40:  * How long a shower takes to arrive, and how long it takes to leave.
 41:  *
 42:  * **This is a deliberate divergence from the port.** The original's chase is
 43:  * one `RainTarget` unit per 25 Hz frame - 0.25 of the full range per second,
 44:  * so ~4 s from clear to a downpour and 4 s back. On screen that is not a
 45:  * shower, it is a switch with a short delay on it: the rain is either there
 46:  * or not, and because a drop only lives about a second the *field* follows
 47:  * the rate almost without lag, so there is nothing else in the chain to hide
 48:  * the corner.
 49:  *
 50:  * A shower is a thing with a shape. It starts as a few small slow drops,
 51:  * fills in, sits, and thins out again - and the thinning takes longer than
 52:  * the filling, because a cloud runs out of its heaviest rain before it runs
 53:  * out of rain. Hence the asymmetry: half a minute in, three quarters of a
 54:  * minute out.
 55:  *
 56:  * This is only one of three stages that smooth the sky, and it is worth
 57:  * knowing where each acts, because a change here will be invisible if the
 58:  * wrong one is dominating:
 59:  *
 60:  *  1. the proxy eases its own intensity with a smoothstep between slot
 61:  *     centres, over minutes - the weather itself changing its mind;
 62:  *  2. this ramp, over tens of seconds - the shower arriving and leaving;
 63:  *  3. the emitter's own rate slew (`AmbientRecipe.ramp`, 2.5 s for rain) -
 64:  *     the last corner off the emit rate.
 65:  *
 66:  * Under `WEATHER_FORCE` the first stage is bypassed, so what a test sees is
 67:  * exactly the number below.
 68:  */
 69: const RAMP_UP_SECONDS = 26;
 70: const RAMP_DOWN_SECONDS = 45;
 71: 
 72: /** Full range per second, each way. */
 73: const RAMP_UP_PER_SECOND = 1 / RAMP_UP_SECONDS;
 74: const RAMP_DOWN_PER_SECOND = 1 / RAMP_DOWN_SECONDS;
 75: 
 76: /**
 77:  * Maps that rain constantly and ignore the server. `MoveLeaves` overwrites
 78:  * `RainTarget` every frame for Icarus (`MAX_LEAVES / 2` = 100, full
 79:  * strength; ZzzEffectFireLeave.cpp:424-426), for Devil Square
 80:  * (`CreateDevilSquareRain`, the full `MAX_LEAVES` budget, :422) and for
 81:  * Chaos Castle (`InChaosCastle()` takes the same branch, :428-436).
 82:  */
 83: const ALWAYS_RAINING: ReadonlySet<ENUM_WORLD> = new Set([
 84:   ENUM_WORLD.WD_10ICARUS,
 85:   ...DEVIL_SQUARE_WORLDS,
 86:   ...CHAOS_CASTLE_WORLDS,
 87: ]);
 88: 
 89: // ---- 2. state + readers ----------------------------------------------------
 90: 
 91: let current = 0;
 92: /** False until the first `updateRain` after a reset - see `resetRain`. */
 93: let seeded = false;
 94: 
 95: /** The target the packet (or the map) asks for, in 0…1. */
 96: export function rainTarget(map: ENUM_WORLD): number {
 97:   if (ALWAYS_RAINING.has(map)) return 1;
 98: 
 99:   const { weather, variation } = Store.weather;
100: 
101:   if (weather !== WEATHER_RAIN) return 0;
102: 
103:   // `(Value & 15) * 6` over the 100 that `Rainly` divides by.
104:   return Math.min(1, (variation * 6) / 100);
105: }
106: 
107: /** Advances `RainCurrent` toward the target; call once a frame. */
108: export function updateRain(map: ENUM_WORLD, dt: number): number {
109:   const target = rainTarget(map);
110: 
111:   // First frame on a new map: the shower on the other side of the gate is
112:   // already falling at this strength, so start there rather than ramping up
113:   // to it. See `resetRain`.
114:   if (!seeded) {
115:     seeded = true;
116:     current = target;
117:     return current;
118:   }
119: 
120:   if (current < target) {
121:     current = Math.min(target, current + RAMP_UP_PER_SECOND * dt);
122:   } else if (current > target) {
123:     current = Math.max(target, current - RAMP_DOWN_PER_SECOND * dt);
124:   }
125: 
126:   return current;
127: }
128: 
129: /** `RainCurrent`, 0…1. Zero means no rain is falling *right now*. */
130: export function rainStrength(): number {
131:   return current;
132: }
133: 
134: /**
135:  * A map change re-seeds the rain rather than re-ramping it.
136:  *
137:  * This deliberately does **not** clear `Store.weather`. The sky is global -
138:  * one schedule in the proxy for every client - so the shower is genuinely
139:  * still falling on the other side of the gate, and the player should walk out
140:  * into the rain it was already raining.
141:  *
142:  * It used to zero `current` and let the ~4 s ramp fade the rain back in,
143:  * which was a fair trade at four seconds and is not one at
144:  * `RAMP_UP_SECONDS`: half a minute of near-clear sky after every gate, on a
145:  * map where the ground is already wet, because `wetness` seeds itself from
146:  * the *target*. So the next `updateRain` takes the target whole.
147:  *
148:  * Nothing snaps on screen, because a warp disposes the emitters anyway
149:  * (`ambientParticleSystem`'s one hard cut) and a fresh one still opens its
150:  * rate over its own `ramp`. That 2.5 s is the arrival, and it is the right
151:  * length for one: the shower is not starting, the player is.
152:  *
153:  * Maps that must never rain (indoor, or snow maps) are excluded by the rain
154:  * slot itself.
155:  */
156: export function resetRain(): void {
157:   current = 0;
158:   seeded = false;
159: }
160: 
161: // ---- 3. the layer ----------------------------------------------------------
162: 
163: /** The layer (see layer.ts). Every map: rain is a server packet, not a map. */
164: export const rainLayer: WeatherLayer = {
165:   name: 'rain',
166:   update: updateRain,
167:   reset: resetRain,
168: };
</file>

