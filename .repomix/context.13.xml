<file path="versions/v097d/data/inventory.test.ts">
 1: import { readdirSync } from 'fs';
 2: import { join, resolve } from 'path';
 3: import { describe, expect, it } from 'vitest';
 4: import { V097D_DATA_FILES } from './inventory';
 5: 
 6: /**
 7:  * The inventory is what tells base code a file is absent instead of broken,
 8:  * so it must be the tree and not somebody's memory of it. Regenerate with
 9:  * the command in `inventory.ts` when `Data-v097d/` changes.
10:  */
11: const ROOT = resolve(__dirname, '../../../Data-v097d');
12: 
13: function walk(dir: string, prefix = ''): string[] {
14:   const out: string[] = [];
15: 
16:   for (const entry of readdirSync(dir, { withFileTypes: true })) {
17:     const rel = prefix ? `${prefix}/${entry.name}` : entry.name;
18: 
19:     if (entry.isDirectory()) out.push(...walk(join(dir, entry.name), rel));
20:     else out.push(rel.toLowerCase());
21:   }
22: 
23:   return out;
24: }
25: 
26: describe('v097d data inventory', () => {
27:   it('lists exactly what Data-v097d contains', () => {
28:     expect([...V097D_DATA_FILES].sort()).toEqual(walk(ROOT).sort());
29:   });
30: 
31:   it('knows the period files the login screen draws', () => {
32:     for (const file of [
33:       'logo/0account.ozt',
34:       'logo/0text_box.ozj',
35:       'logo/0on_botton.ozj',
36:       'logo/0new_account01.ozt',
37:       'logo/0new_account02.ozt',
38:       'logo/mulogo_01.ozj',
39:     ]) {
40:       expect(V097D_DATA_FILES).toContain(file);
41:     }
42:   });
43: 
44:   it('does not claim the Season 6 sheets it never shipped', () => {
45:     for (const file of [
46:       'interface/login_back.ozt',
47:       'interface/newui_menu01.ozj',
48:       'effect/cursorpin01.ozj',
49:       'effect/empact01.ozj',
50:       'effect/firehik_mono03.ozj',
51:     ]) {
52:       expect(V097D_DATA_FILES).not.toContain(file);
53:     }
54:   });
55: });
</file>

