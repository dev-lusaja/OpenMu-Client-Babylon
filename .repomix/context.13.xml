  1: import type { WeatherLayer } from './layer';
  2: import { RawTexture, Texture, type Scene } from '../libs/babylon/exports';
  3: import type { ThinEngine } from '@babylonjs/core/Engines/thinEngine';
  4: 
  5: /**
  6:  * The trail ploughed through settled snow: one continuous channel behind the
  7:  * hero, with the snow heaped along its rims and churned on its floor.
  8:  *
  9:  * This used to be decals - a chain of `drag` quads from `footprints.ts`, one
 10:  * per stride. It cannot be. Each quad is its own little height field with its
 11:  * own ends, so where one piece's floor rises back to the surface there is a
 12:  * wall across the channel, and however far the pieces overlap the eye reads
 13:  * a ladder of rungs. A trail is ONE surface, so it is kept as one surface: a
 14:  * world-space depth map, painted on every footfall, that the terrain shader
 15:  * folds into the snow's own relief. The walls, the lit and shaded faces, the
 16:  * heaped rims and the churned floor then all come out of the same gradient
 17:  * the drifts already use - the trench is a shape in the snow, not a picture
 18:  * laid on it.
 19:  *
 20:  * The map is 2048² (4 MB). It is allocated the first time a boot ploughs it,
 21:  * and every pass over it is bounded by a dirty rectangle: the plough marks
 22:  * the texels it wrote, the decay only walks the rectangle that has ever been
 23:  * painted, and the upload is a `texSubImage2D` of the union rather than the
 24:  * whole 4 MB each footfall.
 25:  *
 26:  * Owned here, read by `libs/mu/terrainOverlay.ts` (the `ovTrail` sampler).
 27:  * Stamped by `ecs/systems/footprintSystem.ts` from the hero's stride.
 28:  */
 29: 
 30: // ---- 1. tuning -------------------------------------------------------------
 31: 
 32: /** Texels per tile. Eight resolves a 0.1-tile rim; the map is 256 tiles. */
 33: export const TRAIL_RES = 8;
 34: 
 35: /** Side of the depth map in texels. */
 36: export const TRAIL_SIZE = 256 * TRAIL_RES;
 37: 
 38: /**
 39:  * Seconds for a full-depth channel to fill back in to nothing. Long: a walked
 40:  * path should still be there when the hero turns round, and the snowfall is
 41:  * what closes it, not the clock. Bounded only so a long session does not end
 42:  * with the whole field trodden flat.
 43:  */
 44: const FILL_SECONDS = 240;
 45: 
 46: /** Seconds between decay passes; each walks the painted rectangle. */
 47: const DECAY_EVERY = 2;
 48: 
 49: /** Stable 0..1 hash of an integer pair (Hoskins' hash21, as the shader's). */
 50: function hash2(x: number, y: number): number {
 51:   let px = (x * 0.1031) % 1;
 52:   let py = (y * 0.1031) % 1;
 53:   let pz = (x * 0.0973) % 1;
 54:   if (px < 0) px += 1;
 55:   if (py < 0) py += 1;
 56:   if (pz < 0) pz += 1;
 57:   const d = px * (py + 33.33) + py * (pz + 33.33) + pz * (px + 33.33);
 58:   px += d;
 59:   py += d;
 60:   pz += d;
 61:   const r = ((px + py) * pz) % 1;
 62:   return r < 0 ? r + 1 : r;
 63: }
 64: 
 65: // ---- 2. state + readers -------------------------------------------------
 66: 
 67: /** A texel rectangle, inclusive; `x0 > x1` means empty. */
 68: type Rect = { x0: number; z0: number; x1: number; z1: number };
 69: 
 70: const emptyRect = (r: Rect): Rect => {
 71:   r.x0 = TRAIL_SIZE;
 72:   r.z0 = TRAIL_SIZE;
 73:   r.x1 = -1;
 74:   r.z1 = -1;
 75:   return r;
 76: };
 77: const rectEmpty = (r: Rect): boolean => r.x1 < r.x0 || r.z1 < r.z0;
 78: const growRect = (r: Rect, x0: number, z0: number, x1: number, z1: number) => {
 79:   if (x0 < r.x0) r.x0 = x0;
 80:   if (z0 < r.z0) r.z0 = z0;
 81:   if (x1 > r.x1) r.x1 = x1;
 82:   if (z1 > r.z1) r.z1 = z1;
 83: };
 84: 
 85: /** The depth map; allocated on the first plough. */
 86: let data: Uint8Array | null = null;
 87: 
 88: /** Scratch for the sub-rect upload, grown to the largest rect seen. */
 89: let upload: Uint8Array = new Uint8Array(0);
 90: 
 91: let texture: RawTexture | null = null;
 92: let sinceDecay = 0;
 93: 
 94: /** Texels written since the last upload. */
 95: const dirty: Rect = emptyRect({ x0: 0, z0: 0, x1: 0, z1: 0 });
 96: /** Every texel that may be non-zero; what the decay walks. */
 97: const painted: Rect = emptyRect({ x0: 0, z0: 0, x1: 0, z1: 0 });
 98: 
 99: function ensureData(): Uint8Array {
100:   if (!data) data = new Uint8Array(TRAIL_SIZE * TRAIL_SIZE);
101:   return data;
102: }
103: 
104: /** The depth map as a texture, created on first use for this scene. */
105: export function snowTrailTexture(scene: Scene): RawTexture {
106:   if (texture && texture.getScene() === scene) return texture;
107: 
108:   // `data` may still be null: a texture built from no data is all zero,
109:   // which is exactly the untrodden map. The first plough uploads its rect.
110:   texture = RawTexture.CreateRTexture(
111:     data,
112:     TRAIL_SIZE,
113:     TRAIL_SIZE,
114:     scene,
115:     false,
116:     false,
117:     Texture.BILINEAR_SAMPLINGMODE
118:   );
119:   texture.name = 'snowTrail';
120:   texture.wrapU = Texture.CLAMP_ADDRESSMODE;
121:   texture.wrapV = Texture.CLAMP_ADDRESSMODE;
122:   texture.onDisposeObservable.addOnce(() => {
123:     texture = null;
124:   });
125: 
126:   // A fresh texture holds nothing: whatever is painted must go up whole.
127:   if (!rectEmpty(painted)) {
128:     growRect(dirty, painted.x0, painted.z0, painted.x1, painted.z1);
129:   }
130: 
131:   return texture;
132: }
133: 
134: /**
135:  * Plough a channel from (x0, z0) to (x1, z1), in tiles. `width` is the full
136:  * width of the channel at the surface; `depth` is 0…1 at the centre.
137:  *
138:  * A capsule stamp: full depth over the middle half of the width, ramping to
139:  * nothing over the outer quarter on each side, so the rim the shader raises
140:  * (see the `ovTrail` block) sits on a slope and not on a cliff. Written with
141:  * `max`, so re-treading a channel deepens it and never stacks.
142:  */
143: export function ploughSnowTrail(
144:   x0: number,
145:   z0: number,
146:   x1: number,
147:   z1: number,
148:   width: number,
149:   depth: number
150: ): void {
151:   if (depth <= 0 || width <= 0) return;
152: 
153:   const map = ensureData();
154: 
155:   const half = width * 0.5 * TRAIL_RES;
156:   const ax = (x0 + 0.5) * TRAIL_RES;
157:   const az = (z0 + 0.5) * TRAIL_RES;
158:   const bx = (x1 + 0.5) * TRAIL_RES;
159:   const bz = (z1 + 0.5) * TRAIL_RES;
160: 
161:   const dx = bx - ax;
162:   const dz = bz - az;
163:   const len2 = dx * dx + dz * dz;
164: 
165:   const minX = Math.max(0, Math.floor(Math.min(ax, bx) - half));
166:   const maxX = Math.min(TRAIL_SIZE - 1, Math.ceil(Math.max(ax, bx) + half));
167:   const minZ = Math.max(0, Math.floor(Math.min(az, bz) - half));
168:   const maxZ = Math.min(TRAIL_SIZE - 1, Math.ceil(Math.max(az, bz) + half));
169:   if (maxX < minX || maxZ < minZ) return;
170: 
171:   let wrote = false;
172: 
173:   for (let ty = minZ; ty <= maxZ; ty++) {
174:     for (let tx = minX; tx <= maxX; tx++) {
175:       const px = tx + 0.5;
176:       const pz = ty + 0.5;
177: 
178:       let t = len2 > 0 ? ((px - ax) * dx + (pz - az) * dz) / len2 : 0;
179:       t = t < 0 ? 0 : t > 1 ? 1 : t;
180: 
181:       const cx = ax + dx * t - px;
182:       const cz = az + dz * t - pz;
183:       // The edge wanders: a hash of where this texel sits on the map, so
184:       // the wall is broken and shouldered (improved_2.jpg) rather than one
185:       // clean capsule outline. Position-stable, so re-treading the same
186:       // ground finds the same edge instead of widening it.
187:       const jit = hash2(Math.floor(px * 0.5), Math.floor(pz * 0.5));
188:       const edge = 0.86 + jit * 0.28;
189:       const d = Math.sqrt(cx * cx + cz * cz) / (half * edge);
190: 
191:       if (d >= 1) continue;
192: 
193:       // Full depth over most of the width, then a short ramp to 0 at the
194:       // edge. The shader turns the ramp into the wall (ovTrailShape), so
195:       // the shorter it is the more vertical the wall.
196:       const s = d <= 0.68 ? 1 : 1 - (d - 0.68) / 0.32;
197:       const e = s * s * (3 - 2 * s);
198:       const v = Math.round(e * depth * 255);
199: 
200:       const i = ty * TRAIL_SIZE + tx;
201:       if (v > map[i]) {
202:         map[i] = v;
203:         wrote = true;
204:       }
205:     }
206:   }
207: 
208:   if (!wrote) return;
209:   growRect(dirty, minX, minZ, maxX, maxZ);
210:   growRect(painted, minX, minZ, maxX, maxZ);
211: }
212: 
213: /** Whether there is any trail to draw at all. */
214: export function snowTrailPainted(): boolean {
215:   return !rectEmpty(painted);
216: }
217: 
218: /**
219:  * Fill the channels back in by `amount` (of 255) over the painted rectangle,
220:  * then shrink the rectangle to what is still non-zero.
221:  */
222: function decay(amount: number): void {
223:   if (!data || rectEmpty(painted)) return;
224: 
225:   const { x0, z0, x1, z1 } = painted;
226:   growRect(dirty, x0, z0, x1, z1);
227: 
228:   let nx0 = TRAIL_SIZE;
229:   let nz0 = TRAIL_SIZE;
230:   let nx1 = -1;
231:   let nz1 = -1;
232: 
233:   for (let ty = z0; ty <= z1; ty++) {
234:     const row = ty * TRAIL_SIZE;
235:     for (let tx = x0; tx <= x1; tx++) {
236:       const i = row + tx;
237:       const v = data[i];
238:       if (v === 0) continue;
239:       const n = v > amount ? v - amount : 0;
240:       data[i] = n;
241:       if (n === 0) continue;
242:       if (tx < nx0) nx0 = tx;
243:       if (tx > nx1) nx1 = tx;
244:       if (ty < nz0) nz0 = ty;
245:       if (ty > nz1) nz1 = ty;
246:     }
247:   }
248: 
249:   painted.x0 = nx0;
250:   painted.z0 = nz0;
251:   painted.x1 = nx1;
252:   painted.z1 = nz1;
253: }
254: 
255: /** `texSubImage2D` of the dirty rectangle only. */
256: function flush(): void {
257:   if (rectEmpty(dirty) || !texture || !data) return;
258: 
259:   const internal = texture.getInternalTexture();
260:   const engine = texture.getScene()?.getEngine() as ThinEngine | undefined;
261:   if (!internal || !engine || !internal.isReady) return;
262: 
263:   const { x0, z0, x1, z1 } = dirty;
264:   const w = x1 - x0 + 1;
265:   const h = z1 - z0 + 1;
266: 
267:   if (upload.length < w * h) upload = new Uint8Array(w * h);
268:   for (let ty = 0; ty < h; ty++) {
269:     const src = (z0 + ty) * TRAIL_SIZE + x0;
270:     upload.set(data.subarray(src, src + w), ty * w);
271:   }
272: 
273:   engine.updateTextureData(
274:     internal,
275:     upload.subarray(0, w * h),
276:     x0,
277:     z0,
278:     w,
279:     h
280:   );
281: 
282:   emptyRect(dirty);
283: }
284: 
285: function update(dt: number): void {
286:   if (!rectEmpty(painted)) {
287:     sinceDecay += dt;
288:     if (sinceDecay >= DECAY_EVERY) {
289:       decay(Math.max(1, Math.round((255 * sinceDecay) / FILL_SECONDS)));
290:       sinceDecay = 0;
291:     }
292:   }
293: 
294:   flush();
295: }
296: 
297: /** Wipe the trail: a map change or a teardown. */
298: export function resetSnowTrail(): void {
299:   if (data && !rectEmpty(painted)) {
300:     // Only the painted rectangle can hold anything, so only it is zeroed
301:     // and only it goes back up.
302:     for (let ty = painted.z0; ty <= painted.z1; ty++) {
303:       const row = ty * TRAIL_SIZE;
304:       data.fill(0, row + painted.x0, row + painted.x1 + 1);
305:     }
306:     growRect(dirty, painted.x0, painted.z0, painted.x1, painted.z1);
307:   }
308:   emptyRect(painted);
309:   sinceDecay = 0;
310:   flush();
311: }
312: 
313: // ---- 3. the layer -------------------------------------------------------
314: 
315: export const snowTrailLayer: WeatherLayer = {
316:   name: 'snowTrail',
317:   update: (_map, dt) => update(dt),
318:   reset: resetSnowTrail,
319: };
</file>

