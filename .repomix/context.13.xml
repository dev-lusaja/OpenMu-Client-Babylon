606: async function writeGlb(name: string, m: MeshBuilder, png: Buffer): Promise<void> {
607:   const doc = new Document();
608:   const buffer = doc.createBuffer();
609:   const scene = doc.createScene('mainScene');
610:   const root = doc.createNode(`model_${name}`);
611:   scene.addChild(root);
612:   const node = doc.createNode('node_0');
613:   root.addChild(node);
614: 
615:   const texture = doc.createTexture('atlas').setImage(new Uint8Array(png)).setMimeType('image/png');
616:   const material = doc
617:     .createMaterial()
618:     .setRoughnessFactor(1)
619:     .setMetallicFactor(0)
620:     .setAlphaMode('OPAQUE')
621:     .setBaseColorTexture(texture);
622: 
623:   const count = m.positions.length / 3;
624:   const colours = new Float32Array(count * 4).fill(1);
625:   const prim = doc
626:     .createPrimitive()
627:     .setMaterial(material)
628:     .setIndices(doc.createAccessor().setArray(new Uint16Array(m.indices)).setType('SCALAR').setBuffer(buffer))
629:     .setAttribute('POSITION', doc.createAccessor().setArray(new Float32Array(m.positions)).setType('VEC3').setBuffer(buffer))
630:     .setAttribute('NORMAL', doc.createAccessor().setArray(new Float32Array(m.normals)).setType('VEC3').setBuffer(buffer))
631:     .setAttribute('TEXCOORD_0', doc.createAccessor().setArray(new Float32Array(m.uvs)).setType('VEC2').setBuffer(buffer))
632:     .setAttribute('COLOR_0', doc.createAccessor().setArray(colours).setType('VEC4').setBuffer(buffer));
633:   node.setMesh(doc.createMesh('mesh_1').addPrimitive(prim));
634: 
635:   const out = `${OUT}${name}.glb`;
636:   await Bun.write(out, '', { createPath: true });
637:   await new NodeIO().write(out, doc);
638:   console.log(`${name}: ${m.triangles} tris, ${count} verts, atlas ${(png.length / 1024).toFixed(0)} KB -> ${out}`);
639: }
