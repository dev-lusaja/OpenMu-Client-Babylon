161:   // Wider than the original's ±800 MU so the field has some depth to it: a
162:   // leaf that spawns 14 tiles upwind is still crossing the screen when it
163:   // reaches the hero, instead of blinking into existence beside them.
164:   box: [v(-14, 0.5, -10), v(14, 4, 12)],
165:   // −6.4…−12.7 u/tick along −x, ±1.6 sideways / vertical.
166:   direction: [v(-1, -0.25, -0.25), v(-1, 0.25, 0.25)],
167:   power: [1.6, 3.2],
168:   // The original's ~2 s killed a leaf in open air after nine tiles of travel,
