174:             Store.deleteCharacterRequest(selected.Name, code);
175:             setDeleting(false);
176:             setCode('');
177:           }}
178:           style={{ position: 'absolute', left: DELETE.x, top: DELETE.y }}
179:         />
180:       </div>
181:     </div>
182:   );
183: });
