 1: import type { ENUM_WORLD } from '../common/types';
 2: 
 3: /**
 4:  * The contract every weather effect implements. One file per effect, one
 5:  * exported `WeatherLayer` per file, listed once in `layers.ts`. Copy `_template.ts` for the recipe.
 6:  *
 7:  * Keep it small on purpose: an effect that needs more than this (a terrain
 8:  * overlay, a particle recipe, a sound) declares it in its own file and the
 9:  * consumer that draws it imports it from there. The layer is only the
10:  * *lifecycle* - what happens each frame and what happens on a map change.
11:  */
12: export interface WeatherLayer {
13:   /** Unique, kebab-free camelCase, same as the file name. */
14:   readonly name: string;
15: 
16:   /**
17:    * Maps this effect exists on. Omit for "every map" (the effect then has to
18:    * decide per map inside `update`). Purely informational for the facade
19:    * today; used by `weather.layersFor(map)` and tooling.
20:    */
21:   readonly maps?: ReadonlySet<ENUM_WORLD>;
22: 
23:   /**
24:    * Stepped once a frame, in `layers.ts` order, before anything reads the
25:    * weather. `dt` is seconds. Must be cheap: no allocation, no scene walk.
26:    */
27:   update?(map: ENUM_WORLD, dt: number): void;
28: 
29:   /**
30:    * The map changed. Drop everything belonging to the world just left -
31:    * accumulators, pools, particle systems. Called before the new map's
32:    * terrain material binds, so anything a shader samples must be zeroed here.
33:    */
34:   reset?(): void;
35: }
