273: /** The scar as a texture, created on first use for this scene. */
274: export function grassBurnTexture(scene: Scene): RawTexture {
275:   if (texture && texture.getScene() === scene) return texture;
276: 
277:   // Allocated here rather than left null until the first fire.
278:   //
279:   // `snowTrail` gets away with a null-backed texture because nothing asks it
280:   // for one until something has been ploughed. This one is bound by the
281:   // terrain and the grass on the very first frame, so it would be created
282:   // empty, and a texture Babylon was given no storage for is not one that a
283:   // later `updateTextureData` can fill: every burn wrote into the CPU array,
284:   // the uploads all reported success, and the shader sampled zero for ever.
285:   // One megabyte of zeroes on a map that has grass, against that.
286:   texture = RawTexture.CreateRTexture(
287:     ensureData(),
288:     BURN_SIZE,
289:     BURN_SIZE,
290:     scene,
291:     false,
292:     false,
293:     Texture.BILINEAR_SAMPLINGMODE,
294:     // The type, and it has to be said.
295:     //
296:     // `CreateRTexture` defaults to `TEXTURETYPE_FLOAT`, so a texture handed a
297:     // `Uint8Array` is allocated as float and every byte written into it goes
298:     // nowhere - silently. Everything else looked right the whole time: the CPU
299:     // scar had 1.0 in it, `terrainBurnOn` bound as 1, the sampler bound the
300:     // right texture by name, `updateTextureData` returned without complaint,
301:     // and reading the texture back gave 1048576 zeroes. Only the embers ever
302:     // showed, because the embers are the one part of this that does not read
303:     // the map.
304:     Constants.TEXTURETYPE_UNSIGNED_INT
305:   );
306:   texture.name = 'grassBurn';
307:   texture.wrapU = Texture.CLAMP_ADDRESSMODE;
308:   texture.wrapV = Texture.CLAMP_ADDRESSMODE;
309:   texture.onDisposeObservable.addOnce(() => {
310:     texture = null;
311:   });
312: 
313:   // A fresh texture holds nothing: whatever is painted must go up whole.
314:   if (!rectEmpty(painted)) {
315:     growRect(dirty, painted.x0, painted.z0, painted.x1, painted.z1);
316:   }
317: 
318:   return texture;
319: }
320: 
321: /** Whether anything is burnt or burning, so the shader can skip the fetch. */
322: export function grassBurnActive(): boolean {
323:   return !rectEmpty(painted) || fires.length > 0;
324: }
325: 
326: /** How burnt this point is, 0..1. The CPU's copy of what the shader reads. */
327: export function grassBurnAt(x: number, z: number): number {
328:   if (!data) return 0;
329: 
330:   const tx = Math.floor(x * BURN_RES);
331:   const tz = Math.floor(z * BURN_RES);
332: 
333:   if (tx < 0 || tz < 0 || tx >= BURN_SIZE || tz >= BURN_SIZE) return 0;
334: 
335:   return data[tz * BURN_SIZE + tx] / 255;
336: }
337: 
338: // ---- 3. burning ------------------------------------------------------------
339: 
340: /**
341:  * Stamp the annulus between `from` and `to` tiles of a fire's centre.
342:  *
343:  * The annulus and not the disc: the inside is already burnt, and re-stamping
344:  * it would keep resetting its regrowth clock, so a fire that spread for four
345:  * seconds would leave a scar that recovers all at once instead of from the
346:  * outside in.
347:  */
348: function stamp(fire: Fire, from: number, to: number): void {
349:   const map = ensureData();
350: 
351:   // The box has to hold the longest lobe, not the nominal radius, or the
352:   // shape is quietly cropped back to a square-cornered circle.
353:   const span = to * MAX_REACH;
354:   const x0 = Math.max(0, Math.floor((fire.x - span) * BURN_RES));
355:   const x1 = Math.min(BURN_SIZE - 1, Math.ceil((fire.x + span) * BURN_RES));
356:   const z0 = Math.max(0, Math.floor((fire.z - span) * BURN_RES));
357:   const z1 = Math.min(BURN_SIZE - 1, Math.ceil((fire.z + span) * BURN_RES));
358: 
359:   if (x1 < x0 || z1 < z0) return;
360: 
361:   let touched = false;
362: 
363:   for (let tz = z0; tz <= z1; tz++) {
364:     const wz = (tz + 0.5) / BURN_RES;
365:     const dz = wz - fire.z;
366:     const row = tz * BURN_SIZE;
367: 
368:     for (let tx = x0; tx <= x1; tx++) {
369:       const wx = (tx + 0.5) / BURN_RES;
370:       const dx = wx - fire.x;
371:       const d2 = dx * dx + dz * dz;
372: 
373:       // The front's own reach in this direction, not a radius. Both ends of
374:       // the annulus take it, so the burnt inside and the advancing edge are
375:       // the same shape and the ring does not cross itself as the fire grows.
376:       const k = reach(fire, Math.atan2(dz, dx));
377:       const inner = (from * k) ** 2;
378:       const outer = (to * k) ** 2;
379: 
380:       if (d2 < inner || d2 > outer) continue;
381:       if (!hasFuel(wx, wz)) continue;
382: 
383:       const i = row + tx;
384: 
385:       // Written with `max`, so a second fire over the same ground does not
386:       // stack past black and does not shorten what is already there.
387:       if (map[i] >= CHAR) continue;
388: 
389:       map[i] = CHAR;
390:       touched = true;
391:     }
392:   }
393: 
394:   if (!touched) return;
395: 
396:   growRect(dirty, x0, z0, x1, z1);
397:   growRect(painted, x0, z0, x1, z1);
398: }
399: 
400: /** Is there anything left to burn around this ring? */
401: function ringHasFuel(fire: Fire): boolean {
402:   for (let i = 0; i < FUEL_SAMPLES; i++) {
403:     const a = (i / FUEL_SAMPLES) * Math.PI * 2;
404: 
405:     const r = fire.radius * reach(fire, a);
406: 
407:     if (hasFuel(fire.x + Math.cos(a) * r, fire.z + Math.sin(a) * r)) {
408:       return true;
409:     }
410:   }
411: 
412:   return false;
413: }
414: 
415: /**
416:  * Set the grass alight. `radius` in tiles is the hit itself; the fire spreads
417:  * from there under its own vigour.
418:  *
419:  * Called by the fire rows of `common/skillVisuals.ts` through the same step
420:  * list that melts snow, so every fire skill in the game reaches it and any
421:  * added later does too.
422:  */
423: export function burnGrass(
424:   scene: Scene,
425:   x: number,
426:   z: number,
427:   radius: number,
428:   strength = 1
429: ): void {
430:   if (!GameOptions.advancedEffects) return;
431:   if (!hasFuel(x, z)) return;
432: 
433:   emberScene = scene;
434: 
435:   // A hit inside a fire that is already going feeds it rather than starting a
436:   // second one on top - otherwise a channelled spell stacks six fronts on one
437:   // spot and they all spread together as a wall.
438:   for (const f of fires) {
439:     if (Math.hypot(f.x - x, f.z - z) <= f.radius) {
440:       f.vigour = Math.max(f.vigour, strength);
441:       return;
442:     }
443:   }
444: 
445:   const fire: Fire = {
446:     x,
447:     z,
448:     radius,
449:     burnt: 0,
450:     vigour: strength,
451:     sinceEmber: 0,
452:     // Its own shape. Rolled once, so a fire keeps the outline it started with
453:     // as it grows rather than writhing.
454:     p1: Math.random() * Math.PI * 2,
455:     p2: Math.random() * Math.PI * 2,
456:     p3: Math.random() * Math.PI * 2,
457:   };
458: 
459:   // Full: the one with least left to give makes way.
460:   if (fires.length >= MAX_FIRES) {
461:     let worst = 0;
462:     for (let i = 1; i < fires.length; i++) {
463:       if (fires[i].vigour < fires[worst].vigour) worst = i;
464:     }
465:     fires.splice(worst, 1);
466:   }
467: 
468:   stamp(fire, 0, radius);
469:   fire.burnt = radius;
470:   fires.push(fire);
471: }
472: 
473: /** Embers off the flame edge, where the fire actually is. */
474: function embers(fire: Fire, dt: number): void {
475:   const scene = emberScene;
476: 
477:   if (!scene) return;
478: 
479:   fire.sinceEmber += dt;
480: 
481:   if (fire.sinceEmber < EMBER_EVERY) return;
482: 
483:   fire.sinceEmber = 0;
484: 
485:   // All the way round the rim, and only the rim.
486:   //
487:   // This took one random bearing a burst, which is not a fire front - it is a
488:   // flame that jumps about the edge, and early on, while the radius is still
489:   // small, every one of those lands in nearly the same place and they pile
490:   // into a single white-hot ball sitting in the middle of the scar. What is
491:   // burning is the whole advancing edge, so the whole advancing edge is what
492:   // emits.
493:   //
494:   // The bearings are stratified rather than rolled - one per equal slice of
495:   // the circle, jittered inside its own slice - so the ring is covered every
496:   // burst instead of clumping wherever the dice fell.
497:   for (let i = 0; i < RIM_POINTS; i++) {
498:     const a = ((i + Math.random()) / RIM_POINTS) * Math.PI * 2;
499:     const r = fire.radius * reach(fire, a);
500:     const x = fire.x + Math.cos(a) * r;
501:     const z = fire.z + Math.sin(a) * r;
502: 
503:     // Nothing to burn here, so nothing burns here: the fire's edge goes dark
504:     // where it has run up against stone, which is the same rule that stopped
505:     // it spreading there.
506:     if (!hasFuel(x, z)) continue;
507: 
508:     const at = new Vector3(x, groundAt(x, z), z);
509: 
510:     // Only the ember. The flame itself is drawn on the blades that are
511:     // burning (see the vBurn block in terrainGrass.ts) rather than thrown as
512:     // a sprite over them: a billboard is a picture of a fire standing near
513:     // some grass, and at any size it hangs over the field instead of being
514:     // the grass alight. What a sprite is still good for is the part that
515:     // leaves the leaf and rides the air, which is this.
516:     effects.spawn('particles', scene, at, {
517:       recipe: GRASS_EMBERS,
518:       count: EMBER_SPARKS,
519:     });
520:   }
521: }
522: 
523: // ---- 4. the clock ----------------------------------------------------------
524: 
525: /**
526:  * Grow the scar back by `amount` (of 255) over the painted rectangle, then
527:  * shrink the rectangle to what is still burnt.
528:  */
529: function decay(amount: number): void {
530:   if (!data || rectEmpty(painted)) return;
531: 
532:   const { x0, z0, x1, z1 } = painted;
533:   growRect(dirty, x0, z0, x1, z1);
534: 
535:   let nx0 = BURN_SIZE;
536:   let nz0 = BURN_SIZE;
537:   let nx1 = -1;
538:   let nz1 = -1;
539: 
540:   for (let tz = z0; tz <= z1; tz++) {
541:     const row = tz * BURN_SIZE;
542:     for (let tx = x0; tx <= x1; tx++) {
543:       const i = row + tx;
544:       const v = data[i];
545:       if (v === 0) continue;
546:       const n = v > amount ? v - amount : 0;
547:       data[i] = n;
548:       if (n === 0) continue;
549:       if (tx < nx0) nx0 = tx;
550:       if (tx > nx1) nx1 = tx;
551:       if (tz < nz0) nz0 = tz;
552:       if (tz > nz1) nz1 = tz;
553:     }
554:   }
555: 
556:   painted.x0 = nx0;
557:   painted.z0 = nz0;
558:   painted.x1 = nx1;
559:   painted.z1 = nz1;
560: }
561: 
562: /** `texSubImage2D` of the dirty rectangle only. */
563: function flush(): void {
564:   if (rectEmpty(dirty) || !texture || !data) return;
565: 
566:   const internal = texture.getInternalTexture();
567:   const engine = texture.getScene()?.getEngine() as ThinEngine | undefined;
568:   if (!internal || !engine || !internal.isReady) return;
569: 
570:   const { x0, z0, x1, z1 } = dirty;
571:   const w = x1 - x0 + 1;
572:   const h = z1 - z0 + 1;
573: 
574:   if (upload.length < w * h) upload = new Uint8Array(w * h);
575:   for (let tz = 0; tz < h; tz++) {
576:     const src = (z0 + tz) * BURN_SIZE + x0;
577:     upload.set(data.subarray(src, src + w), tz * w);
578:   }
579: 
580:   engine.updateTextureData(internal, upload.subarray(0, w * h), x0, z0, w, h);
581: 
582:   emptyRect(dirty);
583: }
584: 
585: function update(dt: number): void {
586:   for (let i = fires.length - 1; i >= 0; i--) {
587:     const f = fires[i];
588: 
589:     f.radius += SPREAD_RATE * f.vigour * dt;
590: 
591:     // The whole of "it dies down the more it spreads". Distance travelled is
592:     // what costs the fire, so it slows as it goes and then stops.
593:     f.vigour -= (dt * f.radius) / VIGOUR_SPAN;
594: 
595:     // And it goes out where there is nothing left to take.
596:     if (!ringHasFuel(f)) f.vigour -= dt * STARVE_RATE;
597: 
598:     if (f.radius > f.burnt) {
599:       stamp(f, f.burnt, f.radius);
600:       f.burnt = f.radius;
601:     }
602: 
603:     embers(f, dt);
604: 
605:     if (f.vigour <= 0 || f.radius >= FIRE_MAX_RADIUS) fires.splice(i, 1);
606:   }
607: 
608:   if (!rectEmpty(painted)) {
609:     sinceDecay += dt;
610: 
611:     if (sinceDecay >= DECAY_EVERY) {
612:       // The fraction is carried rather than rounded away. A pass every two
613:       // seconds owes 255 * 2 / 300 = 1.7 of a byte, and rounding that to 2
614:       // regrows the field in 255 seconds instead of 300 - measured at 239,
615:       // against an ask that said five minutes at the least. Carrying the
616:       // remainder spends exactly what the clock owes.
617:       owed += (255 * sinceDecay) / REGROW_SECONDS;
618:       sinceDecay = 0;
619: 
620:       const amount = Math.floor(owed);
621: 
622:       if (amount >= 1) {
623:         decay(amount);
624:         owed -= amount;
625:       }
626:     }
627:   }
628: 
629:   flush();
630: }
631: 
632: /** Put every fire out and wipe the scar: a map change or a teardown. */
633: export function resetGrassBurn(): void {
634:   fires.length = 0;
635:   emberScene = null;
636: 
637:   if (data && !rectEmpty(painted)) {
638:     // Only the painted rectangle can hold anything, so only it is zeroed and
639:     // only it goes back up.
640:     for (let tz = painted.z0; tz <= painted.z1; tz++) {
641:       const row = tz * BURN_SIZE;
642:       data.fill(0, row + painted.x0, row + painted.x1 + 1);
643:     }
644:     growRect(dirty, painted.x0, painted.z0, painted.x1, painted.z1);
645:   }
646: 
647:   emptyRect(painted);
648:   owed = 0;
649:   sinceDecay = 0;
650:   flush();
651: }
652: 
653: // ---- 5. the layer ----------------------------------------------------------
654: 
655: export const grassBurnLayer: WeatherLayer = {
656:   name: 'grassBurn',
657:   update: (_map, dt) => update(dt),
658:   reset: resetGrassBurn,
659: };
</file>

