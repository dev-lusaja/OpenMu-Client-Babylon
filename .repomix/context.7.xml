381: /** The rows for a map object type on a world, or nothing. */
382: export function lightEmittersFor(
383:   world: ENUM_WORLD,
384:   type: number
385: ): readonly LightEmitter[] | undefined {
386:   return LIGHTS_BY_WORLD[world]?.[type];
387: }
388: 
389: /**
390:  * The adapter from a table row to the framework's recipe. Null when the row
391:  * has no `terrain` block - a bare flare (Icarus type 10) lights nothing.
392:  */
393: export function recipeFromEmitter(emitter: LightEmitter): LightRecipe | null {
394:   const terrain = emitter.terrain;
395: 
396:   if (!terrain) return null;
397: 
398:   // Sprite pulses used to drive the terrain luminosity too when the row had
399:   // no flicker (the login-scene orb): keep that.
400:   const pulse = terrain.flicker ? undefined : emitter.sprite?.pulse;
401: 
402:   return {
403:     color: terrain.color,
404:     range: terrain.range,
405:     pointRange: emitter.pointRange ?? terrain.range,
406:     gain: emitter.pointGain,
407:     floorGain: terrain.floorGain,
408:     falloff: terrain.falloff,
409:     flicker: terrain.flicker,
410:     flickerSmoothing: TORCH_FLICKER_SMOOTHING,
411:     pulse,
412:     wander: emitter.wander,
413:     heightOffset:
414:       emitter.pointDrop ?? (emitter.offset ? 0 : undefined),
415:     priority: PRIORITY_TORCH,
416:     instant: false,
417:   };
418: }
419: 
420: // ---- 2. state + readers ----------------------------------------------------
421: 
422: const sources = new Set<LightSource>();
423: 
424: /**
425:  * Command: light a map object's row at a resolved world position. The
426:  * position is held by reference - a host whose flame moves (the candelabra
427:  * wicks) mutates it. Returns null when the row has no light. The host owns
428:  * the handle and `dispose()`s it with the object; `update` forgets the dead.
429:  */
430: export function lightMapObject(
431:   scene: Scene,
432:   emitter: LightEmitter,
433:   position: { x: number; y: number; z: number }
434: ): LightSource | null {
435:   const recipe = recipeFromEmitter(emitter);
436: 
437:   if (!recipe) return null;
438: 
439:   return lightMapObjectWith(scene, recipe, position);
440: }
441: 
442: /** Same, from a recipe the host built itself (`tarkanGlowLamp`). */
443: export function lightMapObjectWith(
444:   scene: Scene,
445:   recipe: LightRecipe,
446:   position: { x: number; y: number; z: number }
447: ): LightSource {
448:   const source = LightSource.attach(scene, recipe, { position });
449: 
450:   sources.add(source);
451: 
452:   return source;
453: }
454: 
455: function update(): void {
456:   for (const source of sources) if (!source.alive) sources.delete(source);
457: }
458: 
459: function reset(): void {
460:   sources.clear();
461: }
462: 
463: function emitters(): readonly LightSource[] {
464:   return Array.from(sources);
465: }
466: 
467: // ---- 3. the layer ----------------------------------------------------------
468: 
469: export const mapObjectLightsLayer: LightingLayer = {
470:   name: 'mapObjectLights',
471:   update,
472:   reset,
473:   emitters,
474: };
</file>

<file path="src/lighting/objectEffects.ts">
  1: import type { Scene } from '../libs/babylon/exports';
  2: import type { ENUM_WORLD } from '../common/types';
  3: import type { Entity } from '../ecs/world';
  4: import type { Events } from '../libs/eventBus/events';
  5: import type { LightingLayer } from './layer';
  6: import { LightSource, type LightRecipe } from './lightSource';
  7: 
  8: /**
  9:  * Server-driven object effects as light sources.
 10:  *
 11:  * What it is: the flash under a level-up, a shield potion, a lost shield or
 12:  * a swirl - the bursts in `effects/burstEffects.ts`, lit. Driven by the
 13:  * `objectEffect` event, through `ObjectEffectSystem` calling the command
 14:  * below. The light follows the body, so a level-up mid-walk keeps its glow
 15:  * under the feet.
 16:  *
 17:  * The original lights none of these (`ReceiveLevelUp` spawns flare joints,
 18:  * which carry no `AddTerrainLight`), so the colours follow the burst's
 19:  * particle tint and the values are ours.
 20:  */
 21: 
 22: // ---- 1. tuning -------------------------------------------------------------
 23: 
 24: type ObjectEffect = Events['objectEffect']['effect'];
 25: 
 26: /** Tiles above the feet for a whole-body effect: chest height. */
 27: const BODY_HEIGHT = 0.8;
 28: 
 29: /** Tiles above the feet for a swirl, which sits lower. */
 30: const SWIRL_HEIGHT = 0.6;
 31: 
 32: /** Keyed by the event's effect name. */
 33: export const OBJECT_EFFECT_LIGHTS: Record<ObjectEffect, LightRecipe> = {
 34:   levelUp: {
 35:     color: [1, 0.85, 0.4],
 36:     range: 3,
 37:     seconds: 1.6,
 38:     attack: 0.12,
 39:     release: 0.7,
 40:     heightOffset: BODY_HEIGHT,
 41:   },
 42:   shieldPotion: {
 43:     color: [0.4, 0.7, 1],
 44:     range: 2,
 45:     seconds: 0.8,
 46:     heightOffset: BODY_HEIGHT,
 47:   },
 48:   shieldLost: {
 49:     color: [0.8, 0.3, 0.3],
 50:     range: 2,
 51:     seconds: 0.8,
 52:     heightOffset: BODY_HEIGHT,
 53:   },
 54:   swirl: {
 55:     color: [1, 1, 1],
 56:     range: 2,
 57:     seconds: 1.0,
 58:     heightOffset: SWIRL_HEIGHT,
 59:   },
 60: };
 61: 
 62: // ---- 2. state + readers ----------------------------------------------------
 63: 
 64: const sources = new Set<LightSource>();
 65: 
 66: /** Command: light an object effect on an entity. */
 67: export function lightObjectEffect(
 68:   scene: Scene,
 69:   entity: Entity,
 70:   effect: ObjectEffect
 71: ): void {
 72:   const transform = entity.transform;
 73:   if (!transform) return;
 74: 
 75:   const recipe = OBJECT_EFFECT_LIGHTS[effect];
 76:   // The body height rides in the anchor so the terrain footprint stays at
 77:   // the feet; the point light then needs no extra offset.
 78:   const height = recipe.heightOffset ?? 0;
 79: 
 80:   const follow = (out: { x: number; y: number; z: number }) => {
 81:     out.x = transform.pos.x + (transform.posOffset?.x ?? 0);
 82:     out.y = transform.pos.y + height;
 83:     out.z = transform.pos.z + (transform.posOffset?.z ?? 0);
 84:   };
 85: 
 86:   const position = { x: 0, y: 0, z: 0 };
 87:   follow(position);
 88: 
 89:   sources.add(
 90:     LightSource.attach(scene, { ...recipe, heightOffset: 0 }, { position, follow })
 91:   );
 92: }
 93: 
 94: function update(): void {
 95:   for (const source of sources) if (!source.alive) sources.delete(source);
 96: }
 97: 
 98: function reset(): void {
 99:   sources.clear();
100: }
101: 
102: function emitters(): readonly LightSource[] {
103:   return Array.from(sources);
104: }
105: 
106: // ---- 3. the layer ----------------------------------------------------------
107: 
108: /** Every map: the event decides, not the world. */
109: export const objectEffectsLayer: LightingLayer = {
110:   name: 'objectEffects',
111:   update: (_map: ENUM_WORLD) => update(),
112:   reset,
113:   emitters,
114: };
</file>

