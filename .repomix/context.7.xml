387:    *
388:    * A pure function of the position and never of which side is asking, so the
389:    * two sides that meet at a corner - and every pair of neighbouring
390:    * segments - put their shared edge in exactly the same place, and the ring
391:    * has no cracks in it.
392:    *
393:    * Water on any border tile touching the vertex pulls it down to that
394:    * water's own surface: that is the shore, and the apron above covers the
395:    * drop. Everywhere else the ground simply carries on at its own height.
396:    */
397:   private fillLevelAt(x: number, z: number): number {
398:     const ground = this.heightAt(x, z);
399:     let water = Infinity;
400: 
401:     for (const [tx, tz] of [
402:       [x - 1, z - 1],
403:       [x, z - 1],
404:       [x - 1, z],
405:       [x, z],
406:     ]) {
407:       const cx = clampTile(tx);
408:       const cz = clampTile(tz);
409: 
410:       if (!onBorder(cx, cz)) continue;
411: 
412:       const tile = TERRAIN_INDEX(cx, cz);
413:       if (this.isWater(tile)) water = Math.min(water, this.buffers.height[tile]);
414:     }
415: 
416:     return water === Infinity ? ground : Math.min(water, ground);
417:   }
418: 
419:   /** Whether a boundary vertex is standing in water rather than on ground. */
420:   private isShore(x: number, z: number): boolean {
421:     for (const [tx, tz] of [
422:       [x - 1, z - 1],
423:       [x, z - 1],
424:       [x - 1, z],
425:       [x, z],
426:     ]) {
427:       const cx = clampTile(tx);
428:       const cz = clampTile(tz);
429: 
430:       if (onBorder(cx, cz) && this.isWater(TERRAIN_INDEX(cx, cz))) return true;
431:     }
432: 
433:     return false;
434:   }
435: 
436:   /**
437:    * The fill's height at one ring boundary. Pure in (position, boundary), so
438:    * neighbouring cells and neighbouring rings agree on every shared vertex.
439:    *
440:    * Open water stays dead level - a lake with a wobble in it is a lake with a
441:    * bug in it. Ground takes a small seeded wobble that grows with distance,
442:    * so the plain outside the map is not a mirror of the last row of tiles
443:    * stretched to the horizon. It fades to nothing towards a corner, which is
444:    * what lets the corner squares stay flat and still meet both sides.
445:    */
446:   private fillHeight(side: Side, along: number, edge: number): number {
447:     const [x, z] = side.vertex(along);
448:     const base = this.fillLevelAt(x, z);
449: 
450:     if (this.isShore(x, z)) return base;
451: 
452:     const toCorner = Math.min(along, TERRAIN_SIZE - along);
453:     const fade = smoothstep(toCorner / CORNER_FADE) * settledAt(edge);
454: 
455:     // Value noise along the border rather than per tile: a fresh number every
456:     // tile is static, not ground.
457:     const cell = along / WOBBLE_SPAN;
458:     const at = Math.floor(cell);
459:     const wobble = mix(
460:       hash3(at, edge, 5),
461:       hash3(at + 1, edge, 5),
462:       smoothstep(cell - at)
463:     );
464: 
465:     return base + (wobble - 0.5) * 2 * JITTER_TILES * fade;
466:   }
467: 
468:   private fillTexture(tile: number): number {
469:     return this.isWater(tile) ? WATER_TILE : this.opaqueTextureOf(tile);
470:   }
471: 
472:   /**
473:    * The fill's colour: the tile it grew from at the map's edge, the open
474:    * field's own by the time it has settled. Carrying the border tile's bake
475:    * the whole way out draws every step in the border row as a stripe running
476:    * to the horizon; starting from the settled value instead puts a hard line
477:    * along the boundary. Easing between them has neither.
478:    */
479:   private fillLight(tile: number, settled: number): Rgb {
480:     if (this.isWater(tile)) return this.seaLight();
481: 
482:     return mixRgb(this.lightOf(tile), this.landLight(), settled);
483:   }
484: 
485:   /**
486:    * `addTile`'s own rule (customGroundMesh.ts): a tile covered everywhere by
487:    * its second layer draws that layer, otherwise the first.
488:    */
489:   private opaqueTextureOf(tile: number): number {
490:     const a = tile < this.buffers.alpha.length ? this.buffers.alpha[tile] : 0;
491: 
492:     return a === 255 ? this.buffers.layer2[tile] : this.buffers.layer1[tile];
493:   }
494: 
495:   private lightOf(tile: number): Rgb {
496:     const { light, ambient } = this.buffers;
497:     const source = tile < light.length ? light[tile] : null;
498:     const r = source ? source.x : 0;
499:     const g = source ? source.y : 0;
500:     const b = source ? source.z : 0;
501: 
502:     return [
503:       ambient.x + r * (1 - ambient.x),
504:       ambient.y + g * (1 - ambient.y),
505:       ambient.z + b * (1 - ambient.z),
506:     ];
507:   }
508: 
509:   /** The tile the open field is made of: the commonest dry one on the border. */
510:   private openGround(): number {
511:     if (this.openGroundCache !== null) return this.openGroundCache;
512: 
513:     const counts = new Map<number, number>();
514:     let best = 0;
515:     let bestCount = -1;
516: 
517:     for (const tile of borderTiles()) {
518:       if (this.isWater(tile)) continue;
519: 
520:       const next = (counts.get(tile) ?? 0) + 1;
521:       counts.set(tile, next);
522: 
523:       if (next > bestCount) {
524:         best = tile;
525:         bestCount = next;
526:       }
527:     }
528: 
529:     this.openGroundCache = best;
530: 
531:     return best;
532:   }
533: 
534:   /**
535:    * What open water settles to: the mean bake over the water on the border
536:    * rows. The map's water as a whole is the wrong average - an inland river
537:    * runs under trees and through shadow, and the open sea does not.
538:    */
539:   private seaLight(): Rgb {
540:     this.seaLightCache ??= this.meanLightOver(
541:       borderTiles().filter(tile => this.isWater(tile))
542:     );
543: 
544:     return this.seaLightCache;
545:   }
546: 
547:   /** What open ground settles to: the mean bake over the dry border tiles. */
548:   private landLight(): Rgb {
549:     this.landLightCache ??= this.meanLightOver(
550:       borderTiles().filter(tile => !this.isWater(tile))
551:     );
552: 
553:     return this.landLightCache;
554:   }
555: 
556:   private meanLightOver(tiles: readonly number[]): Rgb {
557:     if (tiles.length === 0) return this.lightOf(tileAt(0, 0));
558: 
559:     let r = 0;
560:     let g = 0;
561:     let b = 0;
562: 
563:     for (const tile of tiles) {
564:       const [lr, lg, lb] = this.lightOf(tile);
565:       r += lr;
566:       g += lg;
567:       b += lb;
568:     }
569: 
570:     return [r / tiles.length, g / tiles.length, b / tiles.length];
571:   }
572: 
573:   /** `a` and `b` are the quad's inner edge, `c` and `d` its outer one. */
574:   private quad(
575:     a: Corner,
576:     b: Corner,
577:     c: Corner,
578:     d: Corner,
579:     texture: number,
580:     inner: Rgb,
581:     outer: Rgb,
582:     flip: boolean
583:   ): void {
584:     const base = this.positions.length / 3;
585:     const lights = [inner, inner, outer, outer];
586: 
587:     for (const [at, corner] of [a, b, c, d].entries()) {
588:       const [x, y, z] = corner;
589:       const uvX = corner.length === 5 ? corner[3] : x;
590:       const uvZ = corner.length === 5 ? corner[4] : z;
591:       const [lr, lg, lb] = lights[at];
592: 
593:       this.positions.push(x, y, z);
594:       this.uvs.push(uvX / TERRAIN_SIZE, uvZ / TERRAIN_SIZE);
595:       this.textures.push(texture, -1);
596:       this.colors.push(lr, lg, lb, 1);
597:       this.alphaColors.push(lr, lg, lb, 0);
598:     }
599: 
600:     if (flip) {
601:       this.indices.push(base, base + 2, base + 1, base, base + 3, base + 2);
602:     } else {
603:       this.indices.push(base, base + 1, base + 2, base, base + 2, base + 3);
604:     }
605:   }
606: }
</file>

<file path="src/libs/mu/terrainGrassCards.ts">
  1: import { RawTexture, Texture, type Scene } from '../babylon/exports';
  2: import { decodeTGA } from './tga';
  3: import { fetchTerrainFile } from './prefetchWorld';
  4: 
  5: /**
  6:  * The map's own grass art, and the answer to which tiles grow anything.
  7:  *
  8:  * The original draws its grass pass from a *separate* texture set -
  9:  * `TileGrass01/02/03.OZT`, alpha cards of grass tufts - indexed by the tile's
 10:  * first splat layer: `BITMAP_MAPGRASS + TerrainMappingLayer1[...]`
 11:  * (ZzzLodTerrain.cpp:1620). Then:
 12:  *
 13:  * ```cpp
 14:  * BITMAP_t* pBitmap = Bitmaps.FindTexture(Texture);
 15:  * if (pBitmap) { ...draw the card... }
 16:  * ```
 17:  *
 18:  * **That null check is the whole per-map rule**, and it is why the first cut
 19:  * of this layer put grass in the Dungeon and on Devias' ice. Slot 0 is named
 20:  * `TileGrass01`, but the name is a filename convention, not a statement about
 21:  * what the texture depicts: `World2/TileGrass01.jpg` is dungeon flagstone and
 22:  * `World3/TileGrass01.jpg` is ice. What actually decides is whether the world
 23:  * folder ships the matching *card*:
 24:  *
 25:  * | World | Grass01 | Grass02 | Grass03 |
 26:  * | --- | --- | --- | --- |
 27:  * | 1 Lorencia | card | card | card |
 28:  * | 2 Dungeon | - | - | - |
 29:  * | 3 Devias | - | card | - |
 30:  * | 4 Lost Tower | card | - | card |
 31:  * | 8 Tarkan | - | - | - |
 32:  *
 33:  * So the Dungeon grows nothing, and Devias grows grass only where its splat
 34:  * says layer 1 - on the ice, which is right: Devias' card is *frosted* grass,
 35:  * pale blue-white, authored for exactly that.
 36:  *
 37:  * Which is also why the blade takes its colour from here and not from the
 38:  * ground tile it stands on. The ground tile is ice; the grass is frost-white
 39:  * grass. One is the floor, the other is the plant, and the original always
 40:  * kept them as two different textures.
 41:  */
 42: 
 43: /** `BITMAP_MAPGRASS + layer1` reaches these three, and no more. */
 44: export const GRASS_CARD_SLOTS = 3;
 45: 
 46: /** Rows in the ramp, per slot. The cards are 64 tall. */
 47: const RAMP_ROWS = 64;
 48: 
 49: /**
 50:  * A texel this transparent is a gap between tufts, not grass; letting it into
 51:  * the average pulls the whole ramp toward whatever the card's dead space
 52:  * happens to be.
 53:  */
 54: const ALPHA_FLOOR = 8;
 55: 
 56: export type GrassCards = {
 57:   /** Splat layer-1 values that grow grass on this map. Empty = none. */
 58:   readonly slots: ReadonlySet<number>;
 59:   /**
 60:    * `GRASS_CARD_SLOTS` wide, `RAMP_ROWS` tall: the card's alpha-weighted mean
 61:    * colour per row, so x picks the slot and y is the height up the blade.
 62:    * Null when the map has no cards at all.
 63:    */
 64:   readonly ramp: Texture | null;
 65: };
 66: 
 67: export const NO_GRASS_CARDS: GrassCards = { slots: new Set(), ramp: null };
 68: 
 69: /**
 70:  * The card reduced to one colour per row.
 71:  *
 72:  * Sampling the card directly would be closer to the original still, but a
 73:  * blade is one to three pixels wide and the card is mostly gaps: a strip
 74:  * through it lands in dead space as often as on a tuft. The alpha-weighted
 75:  * row mean is the colour the eye reads off that row of the card anyway, and
 76:  * it carries the authored root-to-tip gradient, which is the part that
 77:  * matters.
 78:  */
 79: function rampRows(pixels: Uint8ClampedArray, width: number, height: number) {
 80:   // Every source row first, with the weight that produced it.
 81:   const srcWeight = new Float32Array(height);
 82:   const src = new Float32Array(height * 3);
 83: 
 84:   for (let y = 0; y < height; y++) {
 85:     let weight = 0;
 86:     let sr = 0;
 87:     let sg = 0;
 88:     let sb = 0;
 89: 
 90:     for (let x = 0; x < width; x++) {
 91:       const i = (y * width + x) * 4;
 92:       const a = pixels[i + 3];
 93: 
 94:       if (a < ALPHA_FLOOR) continue;
 95: 
 96:       const w = a / 255;
 97:       weight += w;
 98:       sr += pixels[i] * w;
 99:       sg += pixels[i + 1] * w;
100:       sb += pixels[i + 2] * w;
101:     }
102: 
103:     srcWeight[y] = weight;
104: 
105:     if (weight > 0) {
106:       src[y * 3] = sr / weight;
107:       src[y * 3 + 1] = sg / weight;
108:       src[y * 3 + 2] = sb / weight;
109:     }
110:   }
111: 
112:   // The tufts do not fill the card: the top rows of every one of these
113:   // textures are empty, and sampling the full height straight through gave
114:   // every blade a black tip - invisible against Lorencia's dark olive grass
115:   // and a black streak against Devias' snow. The blade's 0..1 is stretched
116:   // over the band the art actually occupies instead.
117:   let top = 0;
118:   let bottom = height - 1;
119: 
120:   while (top < height && srcWeight[top] <= 0) top++;
121:   while (bottom > top && srcWeight[bottom] <= 0) bottom--;
122: 
123:   const rows = new Float32Array(RAMP_ROWS * 3);
124: 
125:   if (top >= height) return rows;
126: 
127:   for (let r = 0; r < RAMP_ROWS; r++) {
128:     // v = 0 is the blade's root, which is the *bottom* of the card.
129:     const t = r / (RAMP_ROWS - 1);
130:     const y = Math.round(bottom - t * (bottom - top));
131: 
132:     rows[r * 3] = src[y * 3];
133:     rows[r * 3 + 1] = src[y * 3 + 1];
134:     rows[r * 3 + 2] = src[y * 3 + 2];
135:   }
136: 
137:   return rows;
138: }
139: 
140: /**
141:  * Fetch and reduce whatever cards this world ships. A slot whose file is
142:  * missing is simply absent from `slots` - the same answer the original's
143:  * `FindTexture` null gives, reached the same way.
144:  */
145: export async function loadGrassCards(
146:   scene: Scene,
147:   worldNum: number
148: ): Promise<GrassCards> {
149:   const slots = new Set<number>();
150:   const bytes = new Uint8Array(GRASS_CARD_SLOTS * RAMP_ROWS * 4);
151: 
152:   await Promise.all(
153:     Array.from({ length: GRASS_CARD_SLOTS }, async (_, slot) => {
154:       const name = `World${worldNum}/TileGrass0${slot + 1}.OZT`;
155: 
156:       let rows: Float32Array;
157: 
158:       try {
159:         // OZT is a TGA behind a 4-byte header, like everywhere else.
160:         const file = await fetchTerrainFile(name);
161:         const card = decodeTGA(name, file.slice(4));
162: 
163:         rows = rampRows(card.pixels, card.width, card.height);
164:       } catch {
165:         // No card: this slot grows nothing on this map. Not an error - it is
166:         // how the original says "no grass here" (Dungeon says it three times).
167:         return;
168:       }
169: 
170:       slots.add(slot);
171: 
172:       for (let r = 0; r < RAMP_ROWS; r++) {
173:         const i = (r * GRASS_CARD_SLOTS + slot) * 4;
174: 
175:         bytes[i] = rows[r * 3];
176:         bytes[i + 1] = rows[r * 3 + 1];
177:         bytes[i + 2] = rows[r * 3 + 2];
178:         bytes[i + 3] = 255;
179:       }
180:     })
181:   );
182: 
183:   if (!slots.size) return NO_GRASS_CARDS;
184: 
185:   const ramp = RawTexture.CreateRGBATexture(
186:     bytes,
187:     GRASS_CARD_SLOTS,
188:     RAMP_ROWS,
189:     scene,
190:     false,
191:     false,
192:     Texture.BILINEAR_SAMPLINGMODE
193:   );
194: 
195:   ramp.name = 'terrainGrassRamp';
196:   ramp.wrapU = Texture.CLAMP_ADDRESSMODE;
197:   ramp.wrapV = Texture.CLAMP_ADDRESSMODE;
198: 
199:   return { slots, ramp };
200: }
</file>

<file path="src/libs/mu/terrainHeightMap.ts">
 1: import { RawTexture, Texture, type Scene } from '../babylon/exports';
 2: import { TERRAIN_SIZE } from '../../common/terrain/consts';
 3: 
 4: export const TERRAIN_HEIGHT_SCALE = (1.5 / 100) * 255;
 5: 
 6: let heightMap: Texture | null = null;
 7: 
 8: export function updateTerrainHeightMap(
 9:   scene: Scene,
10:   heights: Float32Array
11: ): Texture {
12:   heightMap?.dispose();
13: 
14:   const pixels = new Uint8Array(TERRAIN_SIZE * TERRAIN_SIZE * 4);
15: 
16:   for (let i = 0; i < heights.length; i++) {
17:     const raw = Math.round((heights[i] / TERRAIN_HEIGHT_SCALE) * 255);
18:     const byte = raw < 0 ? 0 : raw > 255 ? 255 : raw;
19: 
20:     pixels[i * 4] = byte;
21:     pixels[i * 4 + 3] = 255;
22:   }
23: 
24:   heightMap = RawTexture.CreateRGBATexture(
25:     pixels,
26:     TERRAIN_SIZE,
27:     TERRAIN_SIZE,
28:     scene,
29:     false,
30:     false,
31:     Texture.BILINEAR_SAMPLINGMODE
32:   );
33: 
34:   heightMap.name = 'terrainHeightMap';
35:   heightMap.wrapU = Texture.CLAMP_ADDRESSMODE;
36:   heightMap.wrapV = Texture.CLAMP_ADDRESSMODE;
37: 
38:   return heightMap;
39: }
40: 
41: export function getTerrainHeightMap(): Texture | null {
42:   return heightMap;
43: }
</file>

<file path="src/libs/mu/terrainMask.ts">
  1: import { TERRAIN_SIZE } from '../../common/terrain/consts';
  2: import { TERRAIN_INDEX } from '../../common/terrain/utils';
  3: import { writeTerrainOpenness } from '../../common/terrainDynamicLight';
  4: 
  5: /**
  6:  * A 256x256 per-tile openness mask, for the terrain shader effects that need
  7:  * to know *where* they are allowed to appear - settled snow and rain wetness
  8:  * today, Atlans' caustics later.
  9:  *
 10:  * The plane lives here; the GPU copy rides in the **alpha channel of the
 11:  * terrain dynamic-light texture** (`writeTerrainOpenness`), which the terrain
 12:  * fragment shader already samples at exactly this UV. That is deliberate: the
 13:  * shader's own comments record twice that its sampler list is brittle, so the
 14:  * mask buys its way onto the GPU without adding a sampler, a texture unit or
 15:  * a per-frame upload.
 16:  *
 17:  * Layout matches the light texture: texel `(x, y)` is world tile `(x, z)`,
 18:  * read at `(worldXZ + 0.5) / 256`.
 19:  *
 20:  * ### Why the roofs are measured rather than read
 21:  *
 22:  * The obvious source is the terrain attribute file - the original has a
 23:  * `TW_HEIGHT` flag that raises building floors to `g_fSpecialHeight`
 24:  * (ZzzLodTerrain.cpp:1723) and lifts the camera for them
 25:  * (CameraUtility.cpp:169), which reads exactly like "this tile is indoors".
 26:  * It is not usable: decoding the shipped `.att` files shows Lorencia uses only
 27:  * `SafeZone`, `Character` and `NoMove`, with **zero** `Height` tiles in all
 28:  * 65 536, and Devias adds only `NoGround`. Nothing in the data marks an
 29:  * interior floor, so it has to come from the geometry.
 30:  *
 31:  * Two sources, painted together:
 32:  *
 33:  *  - **Roof slabs.** The same test `CeilingHideSystem` uses to find the
 34:  *    ceiling over the hero - a mesh whose world AABB is a thin slab sitting
 35:  *    above head height - applied to the whole map instead of a radius around
 36:  *    the player. This is what covers the buildings nobody has enumerated.
 37:  *  - **Known interiors.** The room boxes the dust recipes already use. These
 38:  *    are painted unconditionally at map load because the roof scan has one
 39:  *    blind spot it cannot fix: the Lorencia pub's roof is *lifted 100 units
 40:  *    out of view* while the hero is inside it (`loadMapIntoScene`), so a
 41:  *    player who logs in standing in the tavern would have no slab to find.
 42:  *
 43:  * Painting is **additive** - a tile that has ever been seen as roofed stays
 44:  * roofed for the life of the map. That is what makes the pub's disappearing
 45:  * roof harmless: it is measured once on the way in and never un-measured.
 46:  */
 47: 
 48: /** Byte value for a tile with open sky above it. */
 49: const OPEN = 255;
 50: 
 51: export type MaskBox = {
 52:   readonly minX: number;
 53:   readonly maxX: number;
 54:   readonly minZ: number;
 55:   readonly maxZ: number;
 56: };
 57: 
 58: /** One byte per tile, 255 open / 0 roofed. Uploaded as the light texture's alpha. */
 59: let openness: Uint8Array | null = null;
 60: 
 61: function ensureBytes(): Uint8Array {
 62:   if (!openness) {
 63:     openness = new Uint8Array(TERRAIN_SIZE * TERRAIN_SIZE);
 64:     openness.fill(OPEN);
 65:   }
 66:   return openness;
 67: }
 68: 
 69: /** Everything open to the sky again. Called when a map starts loading. */
 70: export function resetTerrainMask(): void {
 71:   ensureBytes().fill(OPEN);
 72: }
 73: 
 74: /** Slab bottom this far (tiles) above the ground under it. Clears a head. */
 75: const ROOF_ABOVE_GROUND = 1.6;
 76: 
 77: /** Thicker boxes are tree crowns, towers and cliffs, not ceilings. */
 78: const ROOF_MAX_THICKNESS = 2.5;
 79: 
 80: /** A roof more than this far up is a spire, and shelters nothing below it. */
 81: const ROOF_MAX_HEIGHT = 6;
 82: 
 83: /**
 84:  * Whether a mesh's world box (`minY..maxY`) over ground at `ground` is a
 85:  * roof: a thin slab sitting above head height. The one test both the object
 86:  * scan (`TerrainMaskSystem`) and the prop batches run.
 87:  */
 88: export function isRoofSlab(minY: number, maxY: number, ground: number): boolean {
 89:   if (maxY - minY > ROOF_MAX_THICKNESS) return false;
 90: 
 91:   const clearance = minY - ground;
 92: 
 93:   return clearance >= ROOF_ABOVE_GROUND && clearance <= ROOF_MAX_HEIGHT;
 94: }
 95: 
 96: /** Bumped whenever a paint changes a tile; readers that cache openness poll it. */
 97: let maskVersion = 0;
 98: 
 99: export function terrainMaskVersion(): number {
100:   return maskVersion;
101: }
102: 
103: /**
104:  * Mark an axis-aligned world footprint as roofed. Coordinates are in tiles and
105:  * need not be integers - the box is expanded to whole tiles, because a roof
106:  * covering any part of a tile keeps the weather off all of it.
107:  *
108:  * Additive: this only ever closes tiles, never re-opens them.
109:  */
110: export function paintRoof(box: MaskBox): boolean {
111:   const b = ensureBytes();
112: 
113:   const x0 = Math.max(0, Math.floor(box.minX));
114:   const x1 = Math.min(TERRAIN_SIZE - 1, Math.ceil(box.maxX));
115:   const z0 = Math.max(0, Math.floor(box.minZ));
116:   const z1 = Math.min(TERRAIN_SIZE - 1, Math.ceil(box.maxZ));
117: 
118:   let changed = false;
119: 
120:   for (let z = z0; z <= z1; z++) {
121:     for (let x = x0; x <= x1; x++) {
122:       const o = TERRAIN_INDEX(x, z);
123:       if (b[o] !== 0) {
124:         b[o] = 0;
125:         changed = true;
126:       }
127:     }
128:   }
129: 
130:   if (changed) maskVersion++;
131: 
132:   return changed;
133: }
