<file path="src/lighting/_template.ts">
 1: /**
 2:  * TEMPLATE - copy this file to `<name>.ts`, fill in the blanks, add the layer
 3:  * to `layers.ts`. Never imported; it only exists to be copied.
 4:  *
 5:  * Every entry file has the same three parts, in this order:
 6:  *
 7:  *   1. Tuning constants at the top, each with a comment saying what it is in
 8:  *      real units (tiles, seconds, linear RGB) and why it has that value. The
 9:  *      entry's recipe table lives here too - it is data.
10:  *   2. Module state + the functions that read or command it. State lives
11:  *      here, not in the facade. A light is made with `LightSource.attach`;
12:  *      keep the handle so `emitters()` can report it.
13:  *   3. The exported `LightingLayer` at the bottom, wiring `update` / `reset` /
14:  *      `emitters`.
15:  *
16:  * Whatever *triggers* the light stays where it happens (an ECS system, a
17:  * packet handler, a map object class) and calls this file's command - or the
18:  * facade's wrapper of it when more than one consumer needs it.
19:  */
20: import type { Scene } from '../libs/babylon/exports';
21: import { ENUM_WORLD } from '../common/types';
22: import type { LightingLayer } from './layer';
23: import { LightSource, type LightRecipe } from './lightSource';
24: import { flame } from './recipes';
25: 
26: // ---- 1. tuning -------------------------------------------------------------
27: 
28: /** Maps this exists on. Data - never `if (map === …)` inside logic. */
29: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([ENUM_WORLD.WD_0LORENCIA]);
30: 
31: /** Tiles above the anchor where the point light hangs. */
32: const HEIGHT = 0.5;
33: 
34: /** The recipe table: replace the key with whatever identifies a thing here. */
35: const RECIPES: Partial<Record<number, LightRecipe>> = {
36:   0: { ...flame(3, 1.0), heightOffset: HEIGHT },
37: };
38: 
39: // ---- 2. state + readers ----------------------------------------------------
40: 
41: const sources = new Set<LightSource>();
42: 
43: /** Command: light thing `kind` at a point. */
44: export function lightTemplate(
45:   scene: Scene,
46:   kind: number,
47:   at: { x: number; y: number; z: number }
48: ): void {
49:   const recipe = RECIPES[kind];
50:   if (!recipe) return;
51: 
52:   sources.add(LightSource.attach(scene, recipe, { position: { ...at } }));
53: }
54: 
55: function update(_map: ENUM_WORLD, _dt: number): void {
56:   for (const source of sources) if (!source.alive) sources.delete(source);
57: }
58: 
59: function reset(): void {
60:   sources.clear();
61: }
62: 
63: function emitters(): readonly LightSource[] {
64:   return Array.from(sources);
65: }
66: 
67: // ---- 3. the layer ----------------------------------------------------------
68: 
69: export const templateLayer: LightingLayer = {
70:   name: 'template',
71:   maps: MAPS,
72:   update,
73:   reset,
74:   emitters,
75: };
</file>

<file path="src/lighting/characters.ts">
  1: import type { Scene } from '../libs/babylon/exports';
  2: import type { ENUM_WORLD } from '../common/types';
  3: import type { Entity } from '../ecs/world';
  4: import { lightingTier } from '../common/lightingQuality';
  5: import type { LightingLayer } from './layer';
  6: import { LightSource, type LightRecipe } from './lightSource';
  7: 
  8: /**
  9:  * Characters as light sources.
 10:  *
 11:  * What it is: the light an NPC or monster carries for as long as it is in
 12:  * scope, following its body. Driven by `CharacterLightSystem`
 13:  * (ecs/systems), which walks the entities with an `npcType` and calls the
 14:  * two commands below. The original's `MoveCharacterVisual`
 15:  * (ZzzCharacter.cpp:5790-6005) does this per frame under a handful of
 16:  * models; `heightOffset` is where on the body the point light hangs.
 17:  *
 18:  * Player-worn gear is not this - `ecs/systems/itemGlowSystem.ts` grades it
 19:  * by item tier .
 20:  *
 21:  * The rows marked `improvedOnly` are not the original's: they are the floor
 22:  * light under a monster that only *carries* a glow there (Bahamut's lure,
 23:  * the Lost Tower Shadow's body - `effects/monsterGlow.ts` draws the cards).
 24:  * They breathe on the same curve the cards do, and Classic withholds them so
 25:  * that tier stays as shipped.
 26:  *
 27:  * Not carried over: the negative light under Bloody Wolf and Tantallos
 28:  * (`Vector(-1.3, -1.3, -1.3)`, range 3) - sources only add, and the terrain
 29:  * delta texture has no sign bit. it is recorded as an open
 30:  * decision.
 31:  */
 32: 
 33: // ---- 1. tuning -------------------------------------------------------------
 34: 
 35: /** Tiles above the feet where a forge/brazier light hangs: waist height. */
 36: const BODY_HEIGHT = 0.7;
 37: 
 38: /** Pool priority: a lit NPC ranks with the torches, below any player's gear. */
 39: const PRIORITY_CHARACTER = 0;
 40: 
 41: /** The blacksmith's forge roll, `Luminosity` 0.6…1.0 in five steps. */
 42: const FORGE_FLICKER = { min: 0.6, max: 1, steps: 5 };
 43: 
 44: /**
 45:  * `RenderLight`'s breath (ZzzCharacter.cpp:8249) as a `LightPulse`:
 46:  * `sinf(WorldTime * 0.002f) * 0.3f + 0.7f` is `(sin + 1) * 0.3 + 0.1`, so the
 47:  * floor swells with the card the monster is carrying rather than beside it.
 48:  */
 49: const CARRIED_GLOW_PULSE = { speed: 0.002, amount: 0.3, base: 0.1 };
 50: 
 51: /** `RenderLight`'s colour at full luminosity: `(L, 0.6L, 0.4L)` (:8250). */
 52: const CARRIED_GLOW_RGB = [1, 0.6, 0.4] as const;
 53: 
 54: /**
 55:  * The colour of a hand that holds `BITMAP_LIGHTNING + 1`: `lightning2` is a
 56:  * cyan burst, and the card on the bone reads cyan-white whatever
 57:  * `RenderLight`'s amber says. The pool on the floor is the light in the
 58:  * hand, so it takes the card's colour - the reviewer caught the Vepar's blue
 59:  * hands pooling orange on the Atlans sand.
 60:  */
 61: const LIGHTNING_GLOW_RGB = [0.35, 0.8, 1] as const;
 62: 
 63: type CharacterLight = LightRecipe & {
 64:   /**
 65:    * Ours, not the original's: the monster carries a glow but throws no
 66:    * `AddTerrainLight`. Withheld on Classic, which is the original look.
 67:    */
 68:   readonly improvedOnly?: boolean;
 69: };
 70: 
 71: /** A monster lit by the glow it carries (`effects/monsterGlow.ts`). */
 72: function carried(
 73:   range: number,
 74:   heightOffset: number,
 75:   color: readonly [number, number, number] = CARRIED_GLOW_RGB,
 76:   pulse: typeof CARRIED_GLOW_PULSE | undefined = CARRIED_GLOW_PULSE
 77: ): CharacterLight {
 78:   return {
 79:     color,
 80:     range,
 81:     pointRange: range + 2,
 82:     heightOffset,
 83:     pulse,
 84:     priority: PRIORITY_CHARACTER,
 85:     improvedOnly: true,
 86:   };
 87: }
 88: 
 89: /** Keyed by NPC/monster type number (`MonstersDatabase`). */
 90: export const CHARACTER_LIGHTS: Partial<Record<number, CharacterLight>> = {
 91:   // 251 Hanzo the Blacksmith (MODEL_SMITH): (L, 0.4L, 0), range 3, :5970-5971.
 92:   251: {
 93:     color: [1, 0.4, 0],
 94:     range: 3,
 95:     pointRange: 5,
 96:     heightOffset: BODY_HEIGHT,
 97:     flicker: FORGE_FLICKER,
 98:     priority: PRIORITY_CHARACTER,
 99:   },
100:   // 231 Devias trader (MODEL_DEVIAS_TRADER): (0.5L, 0.3L, 0), range 3, :5999-6000.
101:   231: {
102:     color: [0.5, 0.3, 0],
103:     range: 3,
104:     pointRange: 5,
105:     heightOffset: BODY_HEIGHT,
106:     flicker: FORGE_FLICKER,
107:     priority: PRIORITY_CHARACTER,
108:   },
109:   // 35 Death Gorgon (MODEL_GORGON, `c->Level == 2`): the one monster in the
110:   // classic set that lights the floor itself - (0.8, 0.16, 0), range 2
111:   // (ZzzCharacter.cpp:5956-5957). Every tier: this one is the original's.
112:   35: {
113:     color: [0.8, 0.16, 0],
114:     range: 2,
115:     pointRange: 4,
116:     heightOffset: BODY_HEIGHT,
117:     flicker: FORGE_FLICKER,
118:     priority: PRIORITY_CHARACTER,
119:   },
120: 
121:   // ---- carried glows: ours, Enhanced/Ultra only ----------------------------
122: 
123:   // 45 Bahamut / 51 Great Bahamut: the lure hangs off the head of a fish
124:   // lying on the seabed, so the pool sits low.
125:   45: carried(3, 0.35),
126:   51: carried(3, 0.5),
127:   // 46 Vepar / 80 Golden Vepar: one `lightning2` light in each hand.
128:   46: carried(3, 0.8, LIGHTNING_GLOW_RGB),
129:   80: carried(3, 0.8, LIGHTNING_GLOW_RGB),
130:   // 48 Lizard King / 81 Golden Lizard King: four burning spikes.
131:   48: carried(3, 0.9),
132:   81: carried(3, 0.9),
133:   // 49 Hydra: the big `lightning2` flare over the head of a boss.
134:   49: carried(4, 1.2, LIGHTNING_GLOW_RGB),
135:   // 36 Shadow has no row on purpose: its body cards are `SubType 1`,
136:   // `dst * (1 - src)` - it removes light rather than adding it, and a
137:   // negative source is the one thing the two sinks cannot carry (see above).
138:   // 39 Poison Shadow: the same body, but additive, in `Vector(0.2, 0.7, 0.1)`.
139:   39: carried(3, BODY_HEIGHT, [0.2, 0.7, 0.1], undefined),
140:   // 27 Scorpion: the tail lamp, `Luminosity` 0.8 flat (:6037).
141:   27: carried(2, 0.25, [0.8, 0.32, 0.16], undefined),
142:   // 235 Priest Sevina, 238 Chaos Goblin: a held flare.
143:   235: carried(3, 0.9),
144:   238: carried(2, BODY_HEIGHT),
145: };
146: 
147: // ---- 2. state + readers ----------------------------------------------------
148: 
149: const sources = new Map<Entity, LightSource>();
150: 
151: /**
152:  * The recipe a character type carries, if any. Classic gets the original's
153:  * own lights only; the rows we added for a carried glow need a tier that
154:  * lights the floor dynamically in the first place.
155:  */
156: export function characterLightFor(npcType: number): LightRecipe | undefined {
157:   const row = CHARACTER_LIGHTS[npcType];
158: 
159:   if (row?.improvedOnly && !lightingTier()) return undefined;
160: 
161:   return row;
162: }
163: 
164: /** Whether this entity holds a live light right now. */
165: export function characterIsLit(e: Entity): boolean {
166:   return sources.get(e)?.alive === true;
167: }
168: 
169: /** Command: attach the entity's light (replacing a dead one). */
170: export function lightCharacter(scene: Scene, e: Entity): void {
171:   const recipe = e.npcType !== undefined ? characterLightFor(e.npcType) : null;
172:   const transform = e.transform;
173: 
174:   if (!recipe || !transform) return;
175: 
176:   snuffCharacter(e);
177: 
178:   sources.set(
179:     e,
180:     LightSource.attach(scene, recipe, {
181:       position: { x: transform.pos.x, y: transform.pos.y, z: transform.pos.z },
182:       follow: out => {
183:         out.x = transform.pos.x + (transform.posOffset?.x ?? 0);
184:         out.y = transform.pos.y + (transform.posOffset?.y ?? 0);
185:         out.z = transform.pos.z + (transform.posOffset?.z ?? 0);
186:       },
187:     })
188:   );
189: }
190: 
191: /** Command: drop the entity's light. */
192: export function snuffCharacter(e: Entity): void {
193:   sources.get(e)?.dispose();
194:   sources.delete(e);
195: }
196: 
197: function reset(): void {
198:   // The facade already disposed every source; only the handles remain.
199:   sources.clear();
200: }
201: 
202: function emitters(): readonly LightSource[] {
203:   return Array.from(sources.values());
204: }
205: 
206: // ---- 3. the layer ----------------------------------------------------------
207: 
208: /** Every map: the table decides who is lit, not the world. */
209: export const charactersLayer: LightingLayer = {
210:   name: 'characters',
211:   update: (_map: ENUM_WORLD) => {},
212:   reset,
213:   emitters,
214: };
</file>

<file path="src/lighting/clouds.ts">
  1: import {
  2:   Constants,
  3:   RawTexture,
  4:   Texture,
  5:   type Effect,
  6:   type Scene,
  7: } from '../libs/babylon/exports';
  8: import { GameOptions } from '../common/gameOptions';
  9: import { devQueryNumber } from '../common/devSeams';
 10: import { lightingTier, tierIndex } from '../common/lightingQuality';
 11: import { serverNow } from '../common/serverTime';
 12: 
 13: /**
 14:  * The cloud field (sky_atmospherics ARCHITECTURE §4): one producer, read by
 15:  * the sky dome, the terrain and the item materials.
 16:  *
 17:  * One tiling value-noise texture generated once from a fixed seed carries the
 18:  * shape; coverage and wind are pure functions of `serverNow()`. The dome
 19:  * draws the field and the sun receivers sample the same field along the sun
 20:  * ray, so a shadow on the ground always has the cloud that casts it overhead,
 21:  * and two clients on the same map at the same second see the same sky.
 22:  *
 23:  * No render pass: the shadow is two texture fetches on a fragment that was
 24:  * already shading.
 25:  */
 26: 
 27: /**
 28:  * The field's resolution. It has to be high enough that one texel is a couple
 29:  * of pixels where the deck is drawn: the coverage threshold turns a smooth
 30:  * field into a contour, and a contour through 25-pixel texels kinks along the
 31:  * texel grid and reads as rectangles.
 32:  */
 33: const NOISE_SIZE = 512;
 34: 
 35: /**
 36:  * Altitude of the cloud deck and its thickness, in tiles.
 37:  *
 38:  * The thickness is what the light march walks, so it has to be of a size with
 39:  * the clouds themselves or the march samples the same value at both ends and
 40:  * every cloud shades flat. One cell of the shape octave is about 70 tiles
 41:  * across; a deck 20 thick under clouds that wide is a sheet, and read as one.
 42:  */
 43: export const CLOUD_ALT = 60;
 44: export const CLOUD_THICK = 70;
 45: 
 46: /**
 47:  * Tiles a second the deck drifts. One wrap of the shape octave is about 95
 48:  * tiles and the visible sky is roughly one wrap across, so this is a cloud
 49:  * crossing the sky in about a minute: read as moving without pulling the eye.
 50:  */
 51: const WIND = [1.6, 0.95] as const;
 52: 
 53: /** How much faster the detail octave rides, so the deck evolves as it drifts. */
 54: const DETAIL_WIND = 1.15;
 55: 
 56: /** What the detail octave adds to the shape octave, either way. */
 57: const CLOUD_DETAIL = 0.45;
 58: 
 59: /** How wide the coverage threshold's soft edge is. */
 60: const CLOUD_SOFT = 0.3;
 61: 
 62: /**
 63:  * Slow drift around the map's base coverage, and the slot it is rolled in.
 64:  * Proportionate to the coverages the maps author: a fair-weather sky sits near
 65:  * 0.16, so a swing of 0.18 either way was the difference between a clear sky
 66:  * and an overcast one.
 67:  */
 68: const DRIFT = 0.07;
 69: const DRIFT_PERIOD_MS = 300_000;
 70: 
 71: /**
 72:  * What a fully covered sky removes from the sun. High enough that a cloud
 73:  * crossing overhead reads on the ground as it passes: at 0.55 it was a change
 74:  * you had to be told to look for.
 75:  */
 76: const SHADOW_STRENGTH = 0.85;
 77: 
 78: export const CLOUD_NOISE_SAMPLER = 'muCloudNoise';
 79: 
 80: const coverDev = devQueryNumber('clouds');
 81: const cloudDev = devQueryNumber('cloudShadow');
 82: /** Forces the volumetric march back on, for measuring its replacement. */
 83: const volumeDev = devQueryNumber('volumetricClouds');
 84: 
 85: /** Uniform names the readers declare and `bindClouds` writes. */
 86: export const CLOUD_UNIFORMS = ['muCloudA', 'muCloudB', 'muCloudC'] as const;
 87: 
 88: /**
 89:  * UV per world tile, per octave: one wrap of the shape octave is `1 / 0.0035`
 90:  * tiles, about 285.
 91:  *
 92:  * It was three times finer, and a sky is seen out to hundreds of tiles, so the
 93:  * field wrapped several times across one view: a regular mackerel pattern with
 94:  * the repeat plainly visible. A cloud has to be a good fraction of the sky it
 95:  * is in before it reads as one object rather than as texture.
 96:  */
 97: const OCTAVE_SCALE = [0.0035, 0.0125] as const;
 98: 
 99: /**
100:  * How much finer than the authored scale the volumetric tier reads the field.
101:  *
102:  * The scale above is right for a sky and wrong for a floor, and the reason is
103:  * geometry: the dome shows hundreds of tiles of the deck at once, the ground
104:  * shows about forty. At one period per 285 tiles the ground sees a seventh of
105:  * a single cloud, so what lands on it is not a shadow but a uniform tint that
106:  * changes over minutes - measured against clouds-off, the whole visible field
107:  * moved together by one part in 140, with no edge anywhere in it.
108:  *
109:  * At 2.2 a cloud is about 130 tiles across, so one or two shadows are in view
110:  * and cross it in about a minute at the existing wind. The repeat that made
111:  * the coarse scale necessary is answered by the domain warp below rather than
112:  * by giving up resolution.
113:  *
114:  * It was 3, which is finer than the march can read: near the horizon a ray
115:  * steps about fifteen tiles, and asked for detail below that the march drew
116:  * the beat between the two as a corrugated stipple across the whole sky. The
117:  * detail argument on the field functions is the general answer and this is
118:  * the headroom left over it.
119:  *
120:  * 1 on every other tier, which is the sky Enhanced has always drawn, to the
121:  * texel.
122:  */
123: const VOLUME_SCALE = 2.2;
124: 
125: /** The warp that lets the finer field tile without showing it. */
126: const WARP_SCALE = 0.22;
127: const WARP_AMOUNT = 0.06;
128: 
129: /**
130:  * The vertical profile: rounded for the first `BASE_ROUND` of the deck's
131:  * depth, flattening over the last `1 - TOP_FLAT`. A cumulus sits on a flat
132:  * base and piles up above it.
133:  */
134: const BASE_ROUND = 0.35;
135: const TOP_FLAT = 0.55;
136: 
137: /** The erosion bite: scale, how far it drifts, how it climbs, how deep it cuts. */
138: const EROSION_SCALE = 2.6;
139: const EROSION_DRIFT = 1.7;
140: const EROSION_RISE = 0.03;
141: const EROSION_BITE = 0.35;
142: 
143: /** Wrapped into [0, 1): a scroll of epoch seconds is millions of UV units, and
144:  * a float there has no fractional resolution left, which quantises the whole
145:  * texture read into blocks. Wrapping is exact in a double and costs nothing. */
146: const wrapUv = (v: number): number => ((v % 1) + 1) % 1;
147: 
148: let noise: RawTexture | null = null;
149: let noiseScene: Scene | null = null;
150: 
151: /** The same integer hash the ambient weather schedule rolls from. */
152: function hash(x: number, y: number, seed: number): number {
153:   let h = (Math.imul(x, 0x9e3779b1) ^ Math.imul(y, 0x85ebca6b) ^ seed) >>> 0;
154:   h = Math.imul(h ^ (h >>> 15), 0x2c1b3c6d);
155:   h = Math.imul(h ^ (h >>> 12), 0x297a2d39);
156:   h ^= h >>> 15;
157:   return (h >>> 0) / 0x100000000;
158: }
159: 
160: const smooth = (t: number) => t * t * (3 - 2 * t);
161: 
162: /** One octave of tiling value noise at `cells` cells across the texture. */
163: function octave(data: Float32Array, cells: number, weight: number, seed: number): void {
164:   const step = NOISE_SIZE / cells;
165: 
166:   for (let y = 0; y < NOISE_SIZE; y++) {
167:     const gy = y / step;
168:     const y0 = Math.floor(gy);
169:     const fy = smooth(gy - y0);
170: 
171:     for (let x = 0; x < NOISE_SIZE; x++) {
172:       const gx = x / step;
173:       const x0 = Math.floor(gx);
174:       const fx = smooth(gx - x0);
175: 
176:       // Wrapped corners, so the texture tiles in both directions.
177:       const a = hash(x0 % cells, y0 % cells, seed);
178:       const b = hash((x0 + 1) % cells, y0 % cells, seed);
179:       const c = hash(x0 % cells, (y0 + 1) % cells, seed);
180:       const d = hash((x0 + 1) % cells, (y0 + 1) % cells, seed);
181: 
182:       const top = a + (b - a) * fx;
183:       const bottom = c + (d - c) * fx;
184: 
185:       data[y * NOISE_SIZE + x] += (top + (bottom - top) * fy) * weight;
186:     }
187:   }
188: }
189: 
190: /**
191:  * The field texture: four octaves, RGBA, 1 MB. Built once and
192:  * kept for the session; it is the same on every client because every value
193:  * comes from the hash above and nothing from `Math.random`.
194:  */
195: function cloudNoise(scene: Scene): RawTexture {
196:   if (noise && noiseScene === scene) return noise;
197: 
198:   const acc = new Float32Array(NOISE_SIZE * NOISE_SIZE);
199: 
200:   octave(acc, 4, 0.50, 0x1a2b3c4d);
201:   octave(acc, 8, 0.27, 0x5e6f7a8b);
202:   octave(acc, 16, 0.15, 0x9cadbecf);
203:   octave(acc, 32, 0.08, 0xd0e1f203);
204: 
205:   // Averaged octaves of value noise pile up around the middle whatever range
206:   // they are stretched onto, and a coverage threshold read against that
207:   // distribution has almost no travel: at 0.4 only the rare peaks clear the
208:   // line and the sky is a field of specks, by 0.85 the whole field is over it
209:   // and the sky is a white blanket. Nothing in between is a cloud.
210:   //
211:   // Flattening the histogram is what makes `coverage` mean the share of sky it
212:   // says it is. The map is monotone, so it moves no shape - every texel keeps
213:   // its rank, and only the values between them are respaced.
214:   let lo = Infinity;
215:   let hi = -Infinity;
216:   for (const v of acc) {
217:     if (v < lo) lo = v;
218:     if (v > hi) hi = v;
219:   }
220:   const span = hi - lo || 1;
221: 
222:   const BINS = 4096;
223:   const histogram = new Uint32Array(BINS);
224:   const binOf = (v: number): number =>
225:     Math.min(BINS - 1, Math.floor(((v - lo) / span) * BINS));
226: 
227:   for (const v of acc) histogram[binOf(v)]++;
228: 
229:   // The CDF: a texel's new value is the share of the field below it.
230:   const cdf = new Float32Array(BINS);
231:   let below = 0;
232:   for (let i = 0; i < BINS; i++) {
233:     below += histogram[i];
234:     cdf[i] = below / acc.length;
235:   }
236: 
237:   const bytes = new Uint8Array(NOISE_SIZE * NOISE_SIZE * 4);
238:   for (let i = 0; i < acc.length; i++) {
239:     const v = Math.round(cdf[binOf(acc[i])] * 255);
240:     bytes[i * 4] = v;
241:     bytes[i * 4 + 1] = v;
242:     bytes[i * 4 + 2] = v;
243:     bytes[i * 4 + 3] = 255;
244:   }
245: 
246:   // No mip chain on purpose. A view ray meets the cloud plane at a distance
247:   // that changes fast across the screen, so the UV derivatives are enormous
248:   // and the hardware picks a mip a few texels wide; thresholding a bilinear
249:   // read of that is what turned the deck into axis-aligned squares. The field
250:   // is low frequency (a cell is about 60 tiles), so level 0 does not alias.
251:   const texture = RawTexture.CreateRGBATexture(
252:     bytes,
253:     NOISE_SIZE,
254:     NOISE_SIZE,
255:     scene,
256:     false,
257:     false,
258:     Texture.BILINEAR_SAMPLINGMODE
259:   );
260: 
261:   texture.wrapU = Constants.TEXTURE_WRAP_ADDRESSMODE;
262:   texture.wrapV = Constants.TEXTURE_WRAP_ADDRESSMODE;
263:   texture.name = 'cloudNoise';
264: 
265:   noise = texture;
266:   noiseScene = scene;
267: 
268:   return texture;
269: }
270: 
271: export function disposeClouds(): void {
272:   noise?.dispose();
273:   noise = null;
274:   noiseScene = null;
275: }
276: 
277: /** True while the option, the tier and the map all want a cloud deck. */
278: /**
279:  * Ultra marches the deck; every other tier draws the flat slab it always has.
280:  * The tier picks which sky, not how much of one.
281:  */
282: export function volumetricClouds(): boolean {
283:   if (tierIndex() < 2 || !GameOptions.clouds) return false;
284: 
285:   // Held back until the field under the march is a volume.
286:   //
287:   // The march itself is sound; what it walks is not. The field is a 2D noise
288:   // texture read as a cover map, and a cloud's ceiling is read from that same
289:   // cover, so every dimension of the deck is a function of two coordinates.
290:   // An oblique ray can predict its entire chord from where it entered and
291:   // integrates one value the whole way, which draws each cloud as a stroke
292:   // pointing along the view direction - over the whole sky, and worse the
293:   // more the camera looks up, which is to say in the view a player actually
294:   // uses.
295:   //
296:   // Measured at 0.39 coherence on the structure tensor looking up, and none
297:   // of per-cloud domes, wind shear or a vertical slice moved it: reshaping a
298:   // height field does not make it a volume
299:   // (documentation/volumetric_clouds/ARCHITECTURE.md). Ultra draws the slab
300:   // Enhanced draws until a 3D field lands, which is a sky with less contrast
301:   // and no streaks.
302:   //
303:   // The march stays reachable so the fix can be measured against it.
304:   return volumeDev !== null && volumeDev > 0;
305: }
306: 
307: export function cloudsActive(base: number | null): boolean {
308:   if (base === null || !lightingTier() || !GameOptions.clouds) return false;
309: 
310:   return coverage(base) > 0.01;
311: }
312: 
313: /** A smoothed hash walk over five-minute slots; the same on every client. */
314: function drift(nowMs: number): number {
315:   const slot = Math.floor(nowMs / DRIFT_PERIOD_MS);
316:   const t = smooth((nowMs % DRIFT_PERIOD_MS) / DRIFT_PERIOD_MS);
317:   const a = hash(slot, 0, 0xc10d5eed) * 2 - 1;
318:   const b = hash(slot + 1, 0, 0xc10d5eed) * 2 - 1;
319: 
320:   return a + (b - a) * t;
321: }
322: 
323: export function coverage(base: number): number {
324:   if (coverDev !== null) return Math.max(0, Math.min(1, coverDev));
325: 
326:   return Math.max(0, Math.min(0.95, base + DRIFT * drift(serverNow())));
327: }
328: 
329: function shadowStrength(sunElevationDeg: number): number {
330:   if (cloudDev !== null) return Math.max(0, cloudDev);
331: 
332:   // A grazing sun throws long, faint cloud shadows; a high one throws the
333:   // deck's own silhouette.
334:   const lift = Math.sin(Math.max(0, sunElevationDeg) * (Math.PI / 180));
335: 
336:   return SHADOW_STRENGTH * (0.35 + 0.65 * lift);
337: }
338: 
339: /**
340:  * What every reader binds. `muCloudA` is (wind x, wind z, coverage, shadow
341:  * strength) and `muCloudB` is (sun step x, sun step z, altitude, thickness):
342:  * the step is the horizontal distance the sun ray covers per unit of height,
343:  * so a receiver walks straight up it to the deck.
344:  */
345: export function bindClouds(
346:   effect: Effect,
347:   scene: Scene,
348:   look: {
349:     base: number | null;
350:     sunDirection: readonly [number, number, number];
351:     sunElevationDeg: number;
352:   }
353: ): void {
354:   effect.setTexture(CLOUD_NOISE_SAMPLER, cloudNoise(scene));
355: 
356:   const live = cloudsActive(look.base);
357:   const cover = live ? coverage(look.base ?? 0) : 0;
358:   const t = serverNow() / 1000;
359: 
360:   // Both octaves ride the same wind, so the deck drifts as one; the detail
361:   // rides it slightly faster, so it also changes shape on the way. Each offset
362:   // is handed over already in UV units and already wrapped - `WIND` is tiles a
363:   // second and a UV unit is `1 / OCTAVE_SCALE` tiles.
364:   effect.setFloat4(
365:     'muCloudA',
366:     wrapUv(WIND[0] * t * OCTAVE_SCALE[0]),
367:     wrapUv(WIND[1] * t * OCTAVE_SCALE[0]),
368:     cover,
369:     live ? shadowStrength(look.sunElevationDeg) : 0
370:   );
371: 
372:   effect.setFloat4(
373:     'muCloudC',
374:     wrapUv(WIND[0] * DETAIL_WIND * t * OCTAVE_SCALE[1]),
375:     wrapUv(WIND[1] * DETAIL_WIND * t * OCTAVE_SCALE[1]),
376:     // How finely this tier reads the field. Enhanced reads it exactly as it
377:     // always has; a uniform that never binds is 0, and the field guards
378:     // against that by treating anything at or below 1 as the authored scale.
379:     volumetricClouds() ? VOLUME_SCALE : 1,
380:     0
381:   );
382: 
383:   // The light travels along `sunDirection`, so a point walks against it to
384:   // reach the deck. A near-horizontal sun would send the step to infinity;
385:   // it is capped at the deck's own width.
386:   const d = look.sunDirection;
387:   const down = Math.max(0.15, -d[1]);
388: 
389:   effect.setFloat4(
390:     'muCloudB',
391:     -d[0] / down,
392:     -d[2] / down,
393:     CLOUD_ALT,
394:     CLOUD_THICK
395:   );
396: }
397: 
398: /**
399:  * The field and the shadow, shared verbatim by the sky and by every sun
400:  * receiver so the two can never disagree. `declare` is false where the host
401:  * already emits the uniforms itself (the item materials do, through
402:  * `AddUniform`), or the fragment declares them twice and will not compile.
403:  * receiver so the two can never disagree. Two scrolls at two scales are what
404:  * make one tile read as a moving, evolving sky.
405:  */
406: export function cloudFieldGlsl(declare = true): string {
407:   return `
408: ${
409:   declare
410:     ? `  uniform sampler2D ${CLOUD_NOISE_SAMPLER};
411:   uniform vec4 muCloudA;   // octave 1 scroll uv, coverage, shadow strength
412:   uniform vec4 muCloudB;   // sun step x, sun step z, altitude, thickness
413:   uniform vec4 muCloudC;   // octave 2 scroll uv`
414:     : ''
415: }
416: 
417:   /**
418:    * Bilinear filtering reconstructs a texture as a bilinear patch per texel,
419:    * and thresholding that leaves the patch edges visible: the deck came out
420:    * as axis-aligned squares wherever a texel was more than a few pixels
421:    * wide, which up at the cloud plane it always is. Easing the fractional
422:    * part before the fetch makes the reconstruction smooth, at no extra
423:    * sample.
424:    */
425:   vec2 muSmoothUV(vec2 uv) {
426:     vec2 t = uv * ${NOISE_SIZE}.0 + 0.5;
427:     vec2 i = floor(t);
428:     vec2 f = fract(t);
429: 
430:     return (i + f * f * (3.0 - 2.0 * f) - 0.5) / ${NOISE_SIZE}.0;
431:   }
432: 
433:   /**
434:    * The shape octave's values are flat across [0, 1] (the field's histogram is
435:    * equalised when it is built), so a threshold on it cuts the share of sky it
436:    * promises. The detail octave only pushes that value either way to break the
437:    * edges up: averaging the two would pile the sum back around the middle,
438:    * which is the one thing the threshold cannot work against.
439:    */
440:   /**
441:    * muCloudC.z is how much finer than the authored scale this tier reads the
442:    * field. Position and scroll offset are scaled together - the offset is
443:    * already in UV units, so scaling only the position would leave the deck
444:    * drifting at the wrong rate. 1 is the sky the Enhanced tier has always
445:    * drawn, to the texel.
446:    */
447:   float muCloudFieldLod(vec2 p, float detail) {
448:     // A uniform that never binds reads 0, and 0 would collapse the field to
449:     // one texel. Anything at or below 1 means the authored scale.
450:     float k = max(muCloudC.z, 1.0);
451: 
452:     // A low-frequency offset of the sample position, which breaks the repeat
453:     // that a finer field would otherwise show without costing an octave. Only
454:     // the tier that goes finer pays for it.
455:     vec2 w = vec2(0.0);
456:     if (k > 1.001) {
457:       float wx = texture2D(${CLOUD_NOISE_SAMPLER}, muSmoothUV(fract((p * ${OCTAVE_SCALE[0]} + muCloudA.xy) * ${WARP_SCALE.toFixed(2)}))).r;
458:       float wy = texture2D(${CLOUD_NOISE_SAMPLER}, muSmoothUV(fract((p * ${OCTAVE_SCALE[0]} + muCloudA.yx + vec2(0.37, 0.11)) * ${WARP_SCALE.toFixed(2)}))).r;
459:       w = (vec2(wx, wy) - 0.5) * ${WARP_AMOUNT.toFixed(3)};
460:     }
461: 
462:     float a = texture2D(${CLOUD_NOISE_SAMPLER}, muSmoothUV(fract((p * ${OCTAVE_SCALE[0]} + muCloudA.xy) * k + w))).r;
463:     float b = texture2D(${CLOUD_NOISE_SAMPLER}, muSmoothUV(fract((p * ${OCTAVE_SCALE[1]} + muCloudC.xy) * k + w))).r;
464: 
465:     return clamp(a + (b - 0.5) * ${CLOUD_DETAIL.toFixed(3)} * detail, 0.0, 1.0);
466:   }
467: 
468:   /** The field at full detail: the sky slab and the ground shadow both read this. */
469:   float muCloudField(vec2 p) {
470:     return muCloudFieldLod(p, 1.0);
471:   }
472: 
473:   float muCloudCoverLod(vec2 p, float detail) {
474:     float edge = 1.0 - muCloudA.z;
475: 
476:     return smoothstep(edge, edge + ${CLOUD_SOFT.toFixed(3)}, muCloudFieldLod(p, detail));
477:   }
478: 
479:   float muCloudCover(vec2 p) {
480:     return muCloudCoverLod(p, 1.0);
481:   }
482: 
483:   /**
484:    * Density inside the deck: the same horizontal shape the sky and the ground
485:    * both read, given a body by a vertical profile and bitten into at the
486:    * edges.
487:    *
488:    * h is 0 at the deck's base and 1 at its top. The profile is rounded
489:    * underneath and flatter on top - a cumulus sits on its own flat bottom -
490:    * and the erosion is a higher-frequency bite taken only where the cloud is
491:    * already thin, which is what makes an edge torn rather than smooth.
492:    *
493:    * detail is how much of the fine structure this sample is allowed to see,
494:    * and the caller sets it from how far apart its samples are. A march near
495:    * the horizon crosses the deck at an angle and steps something like fifteen
496:    * tiles at a time, which is wider than the erosion's own period: asked for
497:    * detail it cannot resolve, it drew the beat between the two as a corrugated
498:    * stipple across the whole sky. Fading the fine terms out as the step grows
499:    * is the same bargain a mip level makes, and the shape octave - which the
500:    * step can still resolve - carries the cloud on its own out there.
501:    */
502:   float muCloudDensity(vec3 wp, float h, float detail) {
503:     float cover = muCloudCoverLod(wp.xz, detail);
504:     if (cover <= 0.0) return 0.0;
505: 
506:     float shape = smoothstep(0.0, ${BASE_ROUND.toFixed(2)}, h)
507:                 * (1.0 - smoothstep(${TOP_FLAT.toFixed(2)}, 1.0, h));
508: 
509:     float d = cover * shape;
510: 
511:     // Erosion rides its own scale and a vertical scroll, so the cloud boils
512:     // as it drifts rather than sliding rigidly.
513:     float e = texture2D(${CLOUD_NOISE_SAMPLER}, muSmoothUV(fract(
514:       (wp.xz * ${OCTAVE_SCALE[1]} + muCloudC.xy * ${EROSION_DRIFT.toFixed(2)}) * ${EROSION_SCALE.toFixed(2)}
515:       + vec2(h * ${EROSION_RISE.toFixed(2)}, 0.0)))).r;
516: 
517:     return max(d - (1.0 - d) * e * ${EROSION_BITE.toFixed(2)} * detail, 0.0);
518:   }
519: 
520:   /** 1 in the open, less under a cloud. Identity while the strength is 0. */
521:   float muCloudShadow(vec3 worldPos) {
522:     if (muCloudA.w <= 0.0) return 1.0;
523: 
524:     float rise = max(muCloudB.z - worldPos.y, 0.0);
525:     vec2 p = worldPos.xz + muCloudB.xy * rise;
526: 
527:     return 1.0 - muCloudA.w * muCloudCover(p);
528:   }
529: `;
530: }
</file>

<file path="src/lighting/horizon.ts">
  1: import {
  2:   Constants,
  3:   Mesh,
  4:   ShaderMaterial,
  5:   ShaderStore,
  6:   Texture,
  7:   VertexData,
  8:   type Scene,
  9: } from '../libs/babylon/exports';
 10: import { linearBufferActive } from '../common/lightModel';
 11: import { lookDirector, type LookDirector, type LookState } from './director';
 12: import { profileFor, toLinear, type Rgb, type SkylineLook } from './profiles';
 13: 
 14: /**
 15:  * The skyline: sole writer of the horizon backdrop mesh. A map that has art
 16:  * for its far scenery wraps that strip around the camera, past everything the
 17:  * map draws and inside the sky dome, so the ground does not simply stop at the
 18:  * haze - there is a country out there.
 19:  *
 20:  * It is scenery, not light. The strip is drawn unlit, takes no exposure and
 21:  * no key, and is pulled toward the sky's own horizon colour so it belongs to
 22:  * whatever sky the map is running (§4.6: the horizon colour is both the
 23:  * dome's bottom and the haze). Classic draws no dome and draws none of this.
 24:  */
 25: 
 26: /** Ring segments around the camera: 96 keeps a 3.75 degree facet off the eye. */
 27: const SEGMENTS = 96;
 28: 
 29: /**
 30:  * Band radius in tiles. Only the ordering matters - the mesh rides the camera,
 31:  * so the strip is at the same angle wherever the hero stands - and this sits
 32:  * inside the dome's 2000 so it draws in front of the sky and behind the map,
 33:  * which clears the depth after the sky's group.
 34:  */
 35: const RADIUS = 1500;
 36: 
 37: /**
 38:  * Mirrored copies of the strip around the circle.
 39:  *
 40:  * Two is the whole trick: the art is a panorama with two unrelated ends, and
 41:  * wrapping it once puts that join on one heading for the player to find. At
 42:  * two mirrored copies both joins fall on a mirror line, where the texture
 43:  * meets itself, and there is no seam at any heading. It doubles the texels
 44:  * per degree as a side effect; more copies than that and a single frame can
 45:  * hold a whole mirrored pair, which is the one way the repeat shows.
 46:  */
 47: const WRAPS = 2;
 48: 
 49: const SHADER = 'muSkyline';
 50: 
 51: const DEG = Math.PI / 180;
 52: 
 53: type Band = {
 54:   scene: Scene;
 55:   mesh: Mesh;
 56:   material: ShaderMaterial;
 57:   texture: Texture;
 58:   art: string;
 59:   /** The geometry's angles, so a profile that only moves colour keeps it. */
 60:   rise: number;
 61:   drop: number;
 62: };
 63: 
 64: let band: Band | null = null;
 65: 
 66: let bandScene: Scene | null = null;
 67: 
 68: let observed: LookDirector | null = null;
 69: 
 70: /**
 71:  * Called by the director beside `syncSkyDome`: binds the scene and subscribes
 72:  * to the published look, which carries the map, the tier and the room.
 73:  */
 74: export function syncSkyline(scene: Scene): void {
 75:   bandScene = scene;
 76: 
 77:   const director = lookDirector();
 78:   if (!director || director === observed) return;
 79: 
 80:   observed = director;
 81:   director.onChange.add(syncBand);
 82: }
 83: 
 84: export function disposeSkyline(): void {
 85:   if (!band) return;
 86: 
 87:   band.texture.dispose();
 88:   band.mesh.dispose(false, true);
 89:   band = null;
 90: }
 91: 
 92: function syncBand(state: Readonly<LookState>): void {
 93:   const scene = bandScene;
 94: 
 95:   // A room owns the frame and nothing past its walls is drawn, the skyline
 96:   // included; Classic has no dome for it to stand against.
 97:   const sky =
 98:     scene && state.tier > 0 && !state.area ? profileFor(state.world).sky : null;
 99:   const look = sky?.skyline;
100: 
101:   if (!scene || !sky || !look) {
102:     disposeSkyline();
103:     return;
104:   }
105: 
106:   if (
107:     band &&
108:     (band.scene !== scene ||
109:       band.mesh.isDisposed() ||
110:       band.art !== look.art ||
111:       band.rise !== look.riseDeg ||
112:       band.drop !== look.dropDeg)
113:   ) {
114:     disposeSkyline();
115:   }
116: 
117:   band ??= createBand(scene, look);
118: 
119:   const linear = linearBufferActive(scene);
120:   const horizon: Rgb = linear ? toLinear(sky.horizon) : sky.horizon;
121: 
122:   band.material.setArray3('haze', [horizon[0], horizon[1], horizon[2]]);
123:   band.material.setArray3('params', [look.haze, look.fade, linear ? 1 : 0]);
124: }
125: 
126: function createBand(scene: Scene, look: SkylineLook): Band {
127:   registerShader();
128: 
129:   const mesh = new Mesh('skyline', scene);
130: 
131:   bandVertexData(look.riseDeg, look.dropDeg).applyToMesh(mesh);
132: 
133:   const texture = new Texture(look.art, scene);
134:   texture.wrapU = Texture.MIRROR_ADDRESSMODE;
135:   texture.wrapV = Texture.CLAMP_ADDRESSMODE;
136:   texture.anisotropicFilteringLevel = 4;
137:   texture.hasAlpha = true;
138:   texture.isBlocking = false;
139: 
140:   const material = new ShaderMaterial('skyline', scene, SHADER, {
141:     attributes: ['position', 'uv'],
142:     uniforms: ['worldViewProjection', 'haze', 'params'],
143:     samplers: ['art'],
144:     needAlphaBlending: true,
145:   });
146: 
147:   material.setTexture('art', texture);
148:   material.alphaMode = Constants.ALPHA_COMBINE;
149:   material.backFaceCulling = false;
150:   // The strip is the only transparent thing in the sky's group; writing depth
151:   // would only hide the dome from itself on the next frame's clear.
152:   material.disableDepthWrite = true;
153: 
154:   mesh.material = material;
155: 
156:   // Rides with the camera, with the sky and behind everything else. No
157:   // metadata: the G-buffer, the effect mask and the cascades admit meshes by
158:   // their flags, so the strip is in none of them and the haze leaves it alone
159:   // - it takes its own, below.
160:   mesh.infiniteDistance = true;
161:   mesh.alwaysSelectAsActiveMesh = true;
162:   mesh.renderingGroupId = 0;
163:   mesh.isPickable = false;
164:   mesh.receiveShadows = false;
165:   mesh.doNotSyncBoundingInfo = true;
166: 
167:   return {
168:     scene,
169:     mesh,
170:     material,
171:     texture,
172:     art: look.art,
173:     rise: look.riseDeg,
174:     drop: look.dropDeg,
175:   };
176: }
177: 
178: /**
179:  * The band: one ring of quads, open at both ends, with the strip's top edge
180:  * `riseDeg` above the eye and its bottom `dropDeg` below it. The seam vertex
181:  * is duplicated so `u` can run the whole way to `WRAPS` instead of wrapping
182:  * back to 0 across the last facet.
183:  */
184: function bandVertexData(riseDeg: number, dropDeg: number): VertexData {
185:   const top = RADIUS * Math.tan(riseDeg * DEG);
186:   const bottom = -RADIUS * Math.tan(dropDeg * DEG);
187: 
188:   const positions: number[] = [];
189:   const uvs: number[] = [];
190:   const indices: number[] = [];
191: 
192:   for (let i = 0; i <= SEGMENTS; i++) {
193:     const a = (i / SEGMENTS) * Math.PI * 2;
194:     const x = Math.sin(a) * RADIUS;
195:     const z = Math.cos(a) * RADIUS;
196:     const u = (i / SEGMENTS) * WRAPS;
197: 
198:     positions.push(x, top, z, x, bottom, z);
199:     uvs.push(u, 1, u, 0);
200: 
201:     if (i < SEGMENTS) {
202:       const v = i * 2;
203:       indices.push(v, v + 1, v + 2, v + 1, v + 3, v + 2);
204:     }
205:   }
206: 
207:   const data = new VertexData();
208:   data.positions = positions;
209:   data.uvs = uvs;
210:   data.indices = indices;
211: 
212:   return data;
213: }
214: 
215: function registerShader(): void {
216:   if (ShaderStore.ShadersStore[`${SHADER}VertexShader`]) return;
217: 
218:   ShaderStore.ShadersStore[`${SHADER}VertexShader`] = `
219:   precision highp float;
220:   attribute vec3 position;
221:   attribute vec2 uv;
222:   uniform mat4 worldViewProjection;
223:   varying vec2 vUV;
224: 
225:   void main(void) {
226:     vUV = uv;
227:     gl_Position = worldViewProjection * vec4(position, 1.0);
228:   }
229:   `;
230: 
231:   ShaderStore.ShadersStore[`${SHADER}FragmentShader`] = `
232:   precision highp float;
233:   uniform sampler2D art;
234: 
235:   /** The sky's horizon, in the buffer's space. */
236:   uniform vec3 haze;
237: 
238:   /** x: pull toward the haze, y: the bottom fade's span in v, z: buffer is linear. */
239:   uniform vec3 params;
240: 
241:   varying vec2 vUV;
242: 
243:   void main(void) {
244:     vec4 texel = texture2D(art, vUV);
245: 
246:     if (texel.a <= 0.004) discard;
247: 
248:     // Display-authored art in a linear buffer, decoded the once, like the
249:     // clear colour and the dome (§13 F4). Nothing lights it and no exposure
250:     // follows it, so it lands where it was painted.
251:     vec3 c = mix(texel.rgb, pow(max(texel.rgb, vec3(0.0)), vec3(2.2)), params.z);
252: 
253:     // The air between here and there. The strip is outside the G-buffer so
254:     // the distance haze never reaches it, and the art was painted under its
255:     // own sky rather than this map's.
256:     c = mix(c, haze, params.x);
257: 
258:     // The bottom edge is a cut across a painted plain, and below it is the
259:     // void in the horizon colour. Dissolving the last of the strip into that
260:     // colour is the same fade, from the same air.
261:     float fade = smoothstep(0.0, params.y, vUV.y);
262: 
263:     gl_FragColor = vec4(c, texel.a * fade);
264:   }
265:   `;
266: }
