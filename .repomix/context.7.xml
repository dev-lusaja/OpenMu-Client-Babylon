120: export const transformCoordinatesWithClippingToRef = (
121:   v: Vector3,
122:   transformation: Matrix,
123:   ref: Vector3
124: ) => {
125:   const m = transformation.m;
126:   let rx = v.x * m[0] + v.y * m[4] + v.z * m[8] + m[12];
127:   let ry = v.x * m[1] + v.y * m[5] + v.z * m[9] + m[13];
128:   let rz = v.x * m[2] + v.y * m[6] + v.z * m[10] + m[14];
129:   let rw = v.x * m[3] + v.y * m[7] + v.z * m[11] + m[15];
130: 
131:   if (rx < -rw) rx = -rw;
132:   if (rx > rw) rx = rw;
133:   if (ry < -rw) ry = -rw;
134:   if (ry > rw) ry = rw;
135:   if (rz < -rw) rz = -rw;
136:   if (rz > rw) rz = rw;
137:   if (rw < 0) {
138:     rw = 0;
139:   }
140: 
141:   ref.x = rx / rw;
142:   ref.y = ry / rw;
143:   ref.z = rz / rw;
144: 
145:   return ref;
146: };
