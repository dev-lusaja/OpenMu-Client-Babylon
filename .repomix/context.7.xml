 518: /**
 519:  * World-space direction *toward* the sun.
 520:  *
 521:  * Cached per scene: this is read on every material bind, and `getLightByName`
 522:  * is a linear scan of the scene's lights behind a string compare.
 523:  */
 524: let sunScene: Scene | null = null;
 525: let sunDir = new Vector3(-0.4, 1, -0.6).normalize();
 526: 
 527: function sunDirection(scene: Scene): Vector3 {
 528:   if (scene === sunScene) return sunDir;
 529: 
 530:   const sun = sunLightOf(scene);
 531:   if (!sun) return sunDir;
 532: 
 533:   const d = sun.direction;
 534:   sunScene = scene;
 535:   sunDir = new Vector3(-d.x, -d.y, -d.z).normalize();
 536: 
 537:   return sunDir;
 538: }
 539: 
 540: /** CPU mirror of the shader's `overlayHash` (Hoskins' hash21). */
 541: function overlayHash21(x: number, y: number): number {
 542:   const fr = (v: number) => v - Math.floor(v);
 543:   let px = fr(x * 0.1031);
 544:   let py = fr(y * 0.1031);
 545:   let pz = fr(x * 0.1031);
 546:   const d = px * (py + 33.33) + py * (pz + 33.33) + pz * (px + 33.33);
 547:   px += d;
 548:   py += d;
 549:   pz += d;
 550:   return fr((px + py) * pz);
 551: }
 552: 
 553: /** CPU mirror of the shader's `overlayNoise`: value noise, 0…1. */
 554: function overlayNoiseAt(x: number, y: number): number {
 555:   const ix = Math.floor(x);
 556:   const iy = Math.floor(y);
 557:   let fx = x - ix;
 558:   let fy = y - iy;
 559:   fx = fx * fx * (3 - 2 * fx);
 560:   fy = fy * fy * (3 - 2 * fy);
 561:   const a = overlayHash21(ix, iy);
 562:   const b = overlayHash21(ix + 1, iy);
 563:   const c = overlayHash21(ix, iy + 1);
 564:   const d = overlayHash21(ix + 1, iy + 1);
 565:   return (a + (b - a) * fx) * (1 - fy) + (c + (d - c) * fx) * fy;
 566: }
 567: 
 568: /**
 569:  * How much of layer `o` the shader draws at world (x, z), 0…1, given the
 570:  * ground's normal Y there and whether the sky is open - the same break-up
 571:  * noise, threshold and slope test the GLSL block runs, so the CPU can ask
 572:  * "is there a puddle under this boot" and get the answer the eye sees.
 573:  * Bed share is the caller's (see `overlayBedShare`).
 574:  */
 575: export function overlayAmountAt(
 576:   o: TerrainOverlay,
 577:   x: number,
 578:   z: number,
 579:   normalY: number,
 580:   open: boolean
 581: ): number {
 582:   const coverage = o.coverage();
 583:   if (coverage <= 0) return 0;
 584:   if (o.outdoorOnly && !open) return 0;
 585: 
 586:   const px = x * o.patchScale;
 587:   const pz = z * o.patchScale;
 588:   const breakup =
 589:     overlayNoiseAt(px, pz) * 0.65 + overlayNoiseAt(px * 2.7, pz * 2.7) * 0.35;
 590: 
 591:   const knee = o.slopeKnee;
 592:   const top = o.slopeTop ?? 1;
 593:   let flat = (Math.min(1, Math.max(0, normalY)) - knee) / (top - knee);
 594:   flat = Math.min(1, Math.max(0, flat));
 595:   flat = flat * flat * (3 - 2 * flat);
 596: 
 597:   const target = Math.min(1, coverage) * (1 + (o.headroom ?? 0)) * flat;
 598: 
 599:   const lo = breakup - o.softness;
 600:   const hi = breakup + o.softness;
 601:   let t = (target - lo) / (hi - lo);
 602:   t = Math.min(1, Math.max(0, t));
 603:   return t * t * (3 - 2 * t);
 604: }
 605: 
 606: /**
 607:  * How much of `o` this tile texture holds, per `bed`. 1 for a layer with no
 608:  * bed table - such a layer lies on every tile alike.
 609:  */
 610: export function overlayBedShare(o: TerrainOverlay, tile: number): number {
 611:   if (!o.bed) return 1;
 612:   return o.bed[tile] ?? o.bedDefault ?? 1;
 613: }
