 889: 
 890:       float tongue = smoothstep(
 891:         -${FLAME_LEN.toFixed(3)} * flick, 0.0, past) * vHeat;
 892: 
 893:       // White at the cut through orange below it: a flame is hottest where it
 894:       // is eating the leaf. Over 1 so the bloom has something to take.
 895:       f = mix(f, mix(
 896:         vec3(${FLAME_LOW[0].toFixed(2)}, ${FLAME_LOW[1].toFixed(2)}, ${FLAME_LOW[2].toFixed(2)}),
 897:         vec3(${FLAME_HIGH[0].toFixed(2)}, ${FLAME_HIGH[1].toFixed(2)}, ${FLAME_HIGH[2].toFixed(2)}),
