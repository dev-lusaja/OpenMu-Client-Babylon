107:   function reportDecrypt(kept: boolean, reason: string, wire: Uint8Array) {
108:     decryptReports++;
109:     if (decryptReports > 3 && decryptReports % 50 !== 0) return;
110:     const hex = Array.from(wire.subarray(0, 32), byteToString).join(' ');
111:     const line = `${LOG_PREFIX}${kept ? 'decrypt resync' : "can't decrypt packet"} #${decryptReports}: ${reason}; wire(${wire.length}): ${hex}${wire.length > 32 ? ' …' : ''}`;
