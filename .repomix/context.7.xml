408:   function RequestTerrainHeight(xf: number, yf: number) {
409:     if (xf < 0 || yf < 0) return 0;
410: 
411: const xi = ~~xf;
412:     const yi = ~~yf;
413: 
414:     const index = GetTerrainIndex(xi, yi);
415: 
416: const xd = xf - xi;
417:     const yd = yf - yi;
418: 
419:     const x1 = xi & TERRAIN_SIZE_MASK,
420:       y1 = yi & TERRAIN_SIZE_MASK;
421:     const x2 = (xi + 1) & TERRAIN_SIZE_MASK,
422:       y2 = (yi + 1) & TERRAIN_SIZE_MASK;
423: 
424:     const i1 = y1 * TERRAIN_SIZE + x1;
425:     const i2 = y1 * TERRAIN_SIZE + x2;
426:     const i3 = y2 * TERRAIN_SIZE + x2;
427:     const i4 = y2 * TERRAIN_SIZE + x1;
428: 
429:     const h1 = terrainHeight[i1];
430:     const h2 = terrainHeight[i2];
431:     const h3 = terrainHeight[i3];
432:     const h4 = terrainHeight[i4];
433: 
434:     return (
435:       (1 - xd) * (1 - yd) * h1 +
436:       xd * (1 - yd) * h2 +
437:       xd * yd * h3 +
438:       (1 - xd) * yd * h4
439:     );
440:   }
441: 
442:   function IsWalkable(x: number, y: number) {
443:     const terrainFlag = RequestTerrainFlag(x, y);
444:     return (
445:       !isFlagInBinaryMask(terrainFlag, TWFlags.NoMove) &&
446:       !isFlagInBinaryMask(terrainFlag, TWFlags.NoGround)
447:     );
448:   }
