 916: const TRAIL_LIP = 0.7;
 917: const TRAIL_CHURN = 0.22;
 918: const TRAIL_STEP = 0.04;
 919: /** How much sky the channel floor loses, on top of the tint the troughs get. */
 920: const TRAIL_AO = 0.18;
 921: /**
 922:  * Slope gain for the trench, in place of `SNOW_SHADE.relief`. The two were
