61:     );
62: 
63:     // By the time a slot is reused (3 spawns later) the wave is gone.
64:     const reuse = 3 * AMBIENT_WAVE_INTERVAL;
65:     const stale =
66:       waterSurfaceHeight(AMBIENT_WAVE_SPEED * reuse, 0, reuse, [ring]) -
67:       waterSurfaceHeight(AMBIENT_WAVE_SPEED * reuse, 0, reuse);
68:     expect(Math.abs(stale)).toBeLessThan(0.001);
69:   });
