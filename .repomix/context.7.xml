<file path="src/libs/loginMusic.ts">
 1: import { reaction } from 'mobx';
 2: import { Store, UIState } from '../store';
 3: import { sound } from '../sound';
 4: 
 5: /**
 6:  * `MUSIC_LOGIN_THEME`: `LoginScene::Init` starts `login_theme.mp3`
 7:  * (Scenes/LoginScene.cpp:300) and `LoadingScene` stops it on the way into
 8:  * the world (LoadingScene.cpp:83). The server list, the login window and the
 9:  * character select all sit in that one scene, so the theme spans the three
10:  * pages; the per-map music takes over once the world loads
11:  * (`sound/music.ts`).
12:  *
13:  * The browser only unlocks audio on the first gesture, so the theme is asked
14:  * for again on a short timer until `sound.unlocked` is true.
15:  *
16:  * A consumer of the sound layer, kept beside the UI state it reacts to.
17:  */
18: 
19: const LOGIN_THEME = 'Music/login_theme';
20: /** How often to retry while the audio context is still locked. */
21: const RETRY_MS = 500;
22: 
23: const MENU_STATES = new Set([UIState.Servers, UIState.Login, UIState.Characters]);
24: 
25: let retry: number | null = null;
26: 
27: function stopRetry(): void {
28:   if (retry !== null) window.clearInterval(retry);
29:   retry = null;
30: }
31: 
32: function tryPlay(): void {
33:   if (!MENU_STATES.has(Store.uiState)) {
34:     stopRetry();
35:     return;
36:   }
37:   if (!sound.unlocked) return;
38:   sound.playMusic(LOGIN_THEME);
39:   stopRetry();
40: }
41: 
42: /** Call once from main.tsx after `sound.init`. */
43: export function installLoginMusic(): void {
44:   reaction(
45:     () => Store.uiState,
46:     state => {
47:       if (MENU_STATES.has(state)) {
48:         stopRetry();
49:         tryPlay();
50:         if (retry === null && !sound.unlocked) {
51:           retry = window.setInterval(tryPlay, RETRY_MS);
52:         }
53:       } else {
54:         stopRetry();
55:         if (sound.currentMusic === LOGIN_THEME) sound.stopMusic();
56:       }
57:     },
58:     { fireImmediately: true }
59:   );
60: }
</file>

<file path="src/libs/pathfinding.ts">
  1: import type { IVector2Like } from './babylon/exports';
  2: import { Graph, type GridNode, astar } from './astar';
  3: 
  4: type Grid = number[][];
  5: 
  6: type MapInfo = {
  7:   width: number;
  8:   height: number;
  9: };
 10: 
 11: export type Pathfinding<TValue> = {
 12:   graph: Graph;
 13:   mapInfo: MapInfo;
 14:   posToIndex: (pos: IVector2Like) => [number, number];
 15:   indexToPos: (ind: [number, number]) => IVector2Like;
 16:   search: (
 17:     from: IVector2Like,
 18:     to: IVector2Like,
 19:     options?: Parameters<(typeof astar)['search']>[3]
 20:   ) => IVector2Like[];
 21:   findNode: (point: IVector2Like) => GridNode<TValue> | undefined;
 22:   getNode: (i: number, j: number) => GridNode<TValue> | undefined;
 23:   parseString: (str: string) => void;
 24:   generateString: () => string;
 25:   idToIndex: (id: number, ref?: [number, number]) => [number, number];
 26:   indexToId: (i: number, j: number) => number;
 27:   applyOpenedPatch: (ids: number[]) => void;
 28:   applyClosedPatch: (ids: number[]) => void;
 29:   clear: () => void;
 30: };
 31: 
 32: export function createPathfinding<TValue = number>(
 33:   mapInfo: MapInfo
 34: ): Pathfinding<TValue> {
 35:   const grid: Grid = [];
 36: 
 37:   for (let i = 0; i < mapInfo.width; i++) {
 38:     grid[i] = [];
 39:     for (let j = 0; j < mapInfo.height; j++) {
 40:       grid[i][j] = 1;
 41:     }
 42:   }
 43:   //TODO handle cell size
 44: 
 45:   const graph = new Graph(grid, { diagonal: true });
 46: 
 47:   /**
 48:    * Tile under a world point. Clamped to the map: a click that lands past
 49:    * the edge (the camera sees beyond tile 255) becomes a walk to the edge
 50:    * tile instead of an out-of-range read that threw.
 51:    */
 52:   function posToIndex(v3: IVector2Like): [number, number] {
 53:     let { x, y } = v3;
 54:     x += 0.5;
 55:     y += 0.5;
 56:     const i = Math.min(Math.max(Math.floor(x), 0), mapInfo.width - 1);
 57:     const j = Math.min(Math.max(Math.floor(y), 0), mapInfo.height - 1);
 58:     return [i, j];
 59:   }
 60: 
 61:   function indexToV3(ind: [number, number]): IVector2Like {
 62:     return { x: ind[0], y: ind[1] };
 63:   }
 64: 
 65:   const getNode = (i: number, j: number): GridNode<TValue> | undefined => {
 66:     const a = graph.grid[i];
 67:     if (a == null) return undefined;
 68: 
 69:     return a[j] as GridNode<TValue>;
 70:   };
 71: 
 72:   function indexToId(i: number, j: number): number {
 73:     return i * mapInfo.height + j;
 74:   }
 75: 
 76:   return {
 77:     mapInfo,
 78:     graph,
 79:     posToIndex: posToIndex,
 80:     indexToPos: indexToV3,
 81:     search: (from, to, options) => {
 82:       const startPoint = posToIndex(from);
 83:       const finishPoint = posToIndex(to);
 84:       const start = graph.grid[startPoint[0]][startPoint[1]];
 85:       const finish = graph.grid[finishPoint[0]][finishPoint[1]];
 86:       // `closest`: a click on (or walled off from) an unwalkable tile still
 87:       // walks the hero as far toward it as the map allows, the way the
 88:       // original's `PathFinding2` does, instead of ignoring the click.
 89:       const result = astar.search(graph, start, finish, {
 90:         closest: true,
 91:         ...options,
 92:       });
 93: 
 94:       return [
 95:         indexToV3(startPoint),
 96:         ...result.map(node => {
 97:           return indexToV3([node.x, node.y]);
 98:         }),
 99:       ];
100:     },
101:     getNode,
102:     findNode: point => {
103:       const startPoint = posToIndex(point);
104:       return getNode(startPoint[0], startPoint[1]);
105:     },
106:     generateString: () => {
107:       const s: number[] = new Array(mapInfo.height * mapInfo.width);
108:       graph.grid.forEach(r => {
109:         s.push(...r.map(node => node.weight));
110:       });
111:       return s.join('');
112:     },
113:     parseString: (str: string) => {
114:       graph.grid.forEach((row, i) => {
115:         row.forEach((_, j) => {
116:           graph.grid[i][j].weight = str[indexToId(i, j)] === '0' ? 0 : 1;
117:         });
118:       });
119:     },
120:     idToIndex: (id, ref) => {
121:       const x = Math.floor(id / mapInfo.height);
122:       const z = id % mapInfo.height;
123:       if (ref !== undefined) {
124:         ref[0] = x;
125:         ref[1] = z;
126:         return ref;
127:       }
128:       return [x, z];
129:     },
130:     indexToId,
131:     applyOpenedPatch: (ids: number[]) => {
132:       ids.forEach(id => {
133:         const x = Math.floor(id / mapInfo.height);
134:         const z = id % mapInfo.height;
135: 
136:         const row = graph.grid[x];
137:         if (row == null) return;
138:         const col = row[z];
139:         if (col == null) return;
140: 
141:         col.weight = 1;
142:       });
143:     },
144:     applyClosedPatch: (ids: number[]) => {
145:       if (!ids || !Array.isArray(ids)) return;
146: 
147:       ids.forEach(id => {
148:         const x = Math.floor(id / mapInfo.height);
149:         const z = id % mapInfo.height;
150: 
151:         const row = graph.grid[x];
152:         if (row == null) return;
153:         const col = row[z];
154:         if (col == null) return;
155: 
156:         col.weight = 0;
157:       });
158:     },
159:     clear: () => {
160:       graph.grid.forEach(row => {
161:         row.forEach(node => {
162:           node.weight = 1;
163:         });
164:       });
165:     },
166:   };
167: }
</file>

<file path="src/libs/perfOverlay.ts">
  1: import type { Scene } from './babylon/exports';
  2: import { propBatchStats } from '../common/propBatches';
  3: 
  4: /**
  5:  * Render-budget overlay. Shift+Ctrl+Alt+P toggles it.
  6:  *
  7:  * Nothing here runs while it is hidden: `record` is a no-op, the sampler is
  8:  * not installed, and no per-frame allocation happens. The point is to be able
  9:  * to answer "what did that change actually cost" without guessing - the
 10:  * per-system column is usually the surprise.
 11:  */
 12: 
 13: let visible = false;
 14: 
 15: /** Rolling average of each ECS system's update, in milliseconds. */
 16: const systemMs = new Map<string, number>();
 17: 
 18: /** Weight of the newest sample in the rolling average. */
 19: const SMOOTHING = 0.1;
 20: 
 21: export function perfOverlayVisible(): boolean {
 22:   return visible;
 23: }
 24: 
 25: export function recordSystemTime(name: string, ms: number): void {
 26:   const previous = systemMs.get(name);
 27:   systemMs.set(
 28:     name,
 29:     previous === undefined ? ms : previous + (ms - previous) * SMOOTHING
 30:   );
 31: }
 32: 
 33: let frameMs = 0;
 34: let updateMs = 0;
 35: 
 36: export function recordFrame(totalUpdateMs: number, deltaMs: number): void {
 37:   updateMs += (totalUpdateMs - updateMs) * SMOOTHING;
 38:   frameMs += (deltaMs - frameMs) * SMOOTHING;
 39: }
 40: 
 41: let element: HTMLPreElement | null = null;
 42: 
 43: function ensureElement(): HTMLPreElement {
 44:   if (element) return element;
 45: 
 46:   element = document.createElement('pre');
 47:   element.style.cssText = [
 48:     'position:fixed',
 49:     'top:8px',
 50:     'right:8px',
 51:     'z-index:9999',
 52:     'margin:0',
 53:     'padding:8px 10px',
 54:     'background:rgba(0,0,0,0.72)',
 55:     'color:#b9f6c9',
 56:     'font:11px/1.35 ui-monospace,Consolas,monospace',
 57:     'white-space:pre',
 58:     'pointer-events:none',
 59:     'border:1px solid rgba(255,255,255,0.15)',
 60:     'border-radius:3px',
 61:   ].join(';');
 62: 
 63:   document.body.appendChild(element);
 64: 
 65:   return element;
 66: }
 67: 
 68: function pad(label: string, width: number): string {
 69:   return label.length >= width ? label : label + ' '.repeat(width - label.length);
 70: }
 71: 
 72: function countPlayingAnimations(scene: Scene): number {
 73:   let playing = 0;
 74:   for (const group of scene.animationGroups) if (group.isPlaying) playing++;
 75:   return playing;
 76: }
 77: 
 78: function countEnabledMeshes(scene: Scene): number {
 79:   let enabled = 0;
 80:   for (const mesh of scene.meshes) if (mesh.isEnabled(false)) enabled++;
 81:   return enabled;
 82: }
 83: 
 84: const SYSTEM_ROWS = 8;
 85: 
 86: function propLine(): string {
 87:   const s = propBatchStats();
 88:   if (!s) return 'props      none batched';
 89:   return `props      ${s.instances} in ${s.meshes} meshes / ${s.types} types${
 90:     s.pending ? ` (${s.pending} loading)` : ''
 91:   }, ${s.excluded.size} types per object`;
 92: }
 93: 
 94: function render(scene: Scene): void {
 95:   const engine = scene.getEngine();
 96: 
 97:   // `_drawCalls` is internal but always counted; fall back quietly.
 98:   const drawCalls =
 99:     (engine as unknown as { _drawCalls?: { current: number } })._drawCalls
100:       ?.current ?? -1;
101: 
102:   const slowest = [...systemMs.entries()]
103:     .sort((a, b) => b[1] - a[1])
104:     .slice(0, SYSTEM_ROWS);
105: 
106:   const lines = [
107:     `fps        ${engine.getFps().toFixed(0)}`,
108:     `frame      ${frameMs.toFixed(2)} ms`,
109:     `ecs        ${updateMs.toFixed(2)} ms`,
110:     `draw calls ${drawCalls < 0 ? '?' : drawCalls}`,
111:     `meshes     ${scene.getActiveMeshes().length} act / ${
112:       countEnabledMeshes(scene)
113:     } on / ${scene.meshes.length} total`,
114:     `tris       ${(scene.getActiveIndices() / 3) | 0}`,
115:     `anims      ${countPlayingAnimations(scene)} playing / ${
116:       scene.animationGroups.length
117:     }`,
118:     `particles  ${scene.particleSystems.length}`,
119:     `lights     ${scene.lights.length}`,
120:     propLine(),
121:     `materials  ${scene.materials.length}   textures ${scene.textures.length}`,
122:     '',
123:     'slowest systems',
124:     ...slowest.map(([name, ms]) => `  ${pad(name, 26)}${ms.toFixed(2)}`),
125:   ];
126: 
127:   ensureElement().textContent = lines.join('\n');
128: }
129: 
130: /**
131:  * Installs the toggle and the once-per-frame refresh. Safe to call once at
132:  * startup; the overlay stays dormant until the chord is pressed.
133:  */
134: export function installPerfOverlay(scene: Scene): void {
135:   window.addEventListener('keydown', ev => {
136:     // Shift+Ctrl+Alt+P - same shape as the Babylon inspector chord.
137:     if (!ev.shiftKey || !ev.ctrlKey || !ev.altKey) return;
138:     if (ev.code !== 'KeyP') return;
139: 
140:     ev.preventDefault();
141: 
142:     visible = !visible;
143: 
144:     if (element) element.style.display = visible ? 'block' : 'none';
145: 
146:     if (visible) {
147:       systemMs.clear();
148:       ensureElement().style.display = 'block';
149:     }
150:   });
151: 
152:   let sinceRefresh = 0;
153: 
154:   scene.onAfterRenderObservable.add(() => {
155:     if (!visible) return;
156: 
157:     // The readout is for reading, not for animating: 5 Hz is plenty and keeps
158:     // the overlay's own cost (two scene walks) off the frame budget.
159:     sinceRefresh += scene.getEngine().getDeltaTime();
160:     if (sinceRefresh < 200) return;
161:     sinceRefresh = 0;
162: 
163:     render(scene);
164:   });
165: }
</file>

<file path="src/libs/screenPositionBus.ts">
 1: import type { IVector2Like } from './babylon/exports';
 2: import type { Entity } from '../ecs/world';
 3: 
 4: /**
 5:  * Per-entity dispatch for projected screen positions.
 6:  *
 7:  * This used to ride on the global `EventBus`: `CalculateScreenPositionSystem`
 8:  * emitted once per tracked entity per frame, and every mounted name tag,
 9:  * guild mark and damage label subscribed to the same global event and threw
10:  * away everything that was not its own entity. With n entities and n overlay
11:  * components that is n² handler calls a frame - 900 of them for 30 characters
12:  * on screen, before any DOM work.
13:  *
14:  * Here a listener is registered against one entity and only ever hears about
15:  * that entity.
16:  */
17: 
18: export type ScreenPositionListener = (screenPosition: IVector2Like) => void;
19: 
20: const listeners = new Map<Entity, Set<ScreenPositionListener>>();
21: 
22: export function onScreenPosition(
23:   entity: Entity,
24:   listener: ScreenPositionListener
25: ): () => void {
26:   let forEntity = listeners.get(entity);
27: 
28:   if (!forEntity) {
29:     forEntity = new Set();
30:     listeners.set(entity, forEntity);
31:   }
32: 
33:   forEntity.add(listener);
34: 
35:   return () => {
36:     const current = listeners.get(entity);
37:     if (!current) return;
38: 
39:     current.delete(listener);
40:     if (current.size === 0) listeners.delete(entity);
41:   };
42: }
43: 
44: export type AnyScreenPositionListener = (
45:   entity: Entity,
46:   screenPosition: IVector2Like
47: ) => void;
48: 
49: const anyListeners = new Set<AnyScreenPositionListener>();
50: 
51: /**
52:  * For the handful of consumers that genuinely want every entity - the name
53:  * tag layout pass keeps one slot table for all of them, so a per-entity
54:  * subscription would just be the old n² pattern wearing a new hat.
55:  */
56: export function onAnyScreenPosition(
57:   listener: AnyScreenPositionListener
58: ): () => void {
59:   anyListeners.add(listener);
60:   return () => anyListeners.delete(listener);
61: }
62: 
63: /** True when anything is listening - lets the producer skip the projection. */
64: export function hasScreenPositionListener(entity: Entity): boolean {
65:   return listeners.has(entity) || anyListeners.size > 0;
66: }
67: 
68: export function emitScreenPosition(
69:   entity: Entity,
70:   screenPosition: IVector2Like
71: ): void {
72:   const forEntity = listeners.get(entity);
73: 
74:   if (forEntity) {
75:     for (const listener of forEntity) listener(screenPosition);
76:   }
77: 
78:   for (const listener of anyListeners) listener(entity, screenPosition);
79: }
80: 
81: /** Drops every listener for an entity that is going away. */
82: export function clearScreenPositionListeners(entity: Entity): void {
83:   listeners.delete(entity);
84: }
</file>

<file path="src/libs/sfx.ts">
 1: // Migrated to `src/sound/`: positioned one-shots live in
 2: // `sound/listener.ts`, interface sounds in `sound/ui.ts`. Kept as a re-export
