1257:   /** Nearest point of a block to the camera, in tiles. */
1258:   function blockDistance(key: number): number {
1259:     const bx = (key % BLOCKS_PER_SIDE) * BLOCK_TILES;
1260:     const bz = Math.floor(key / BLOCKS_PER_SIDE) * BLOCK_TILES;
