 77: 
 78: export function createSocket({ wsAddress, tcpIP, tcpPort }: Options) {
 79:   const LOG_PREFIX = `[${tcpIP}:${tcpPort}]`;
 80: 
 81:   const decryptor = new SimpleModulusDecryptor();
 82:   decryptor.decryptionKeys = SERVER_TO_CLIENT_KEYS;
 83: 
 84:   // `&session=`: the page's nonce (src/common/sessionNonce.ts), so the proxy
 85:   // can put the login it reads off this socket to the cash shop's ticket
 86:   // route. Only the sockets built here carry it, because they are the ones a
 87:   // login travels on. `chatRoomSocket.ts` builds the same URL and does not: a
 88:   // chat socket never logs in, so the nonce would name nothing there and only
 89:   // be one more place a credential travels. `serverProbe.ts` must not: it
 90:   // dials other people's proxies two at a time, and a nonce handed to a
 91:   // stranger's proxy is a name their presence server gets to claim.
 92:   const socket = new WebSocket(
