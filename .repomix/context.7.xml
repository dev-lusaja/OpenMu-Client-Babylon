135: /**
136:  * Copy the plane into the light texture's alpha.
137:  *
138:  * Unconditional rather than dirty-tracked: the light texture reallocates its
139:  * bytes on every map load (`initTerrainDynamicLight`), so a mask that skipped
140:  * the write because nothing had changed would leave the new buffer holding
141:  * someone else's roofs. 64 KB twice a second is not worth the bookkeeping.
142:  */
143: export function flushTerrainMask(): void {
144:   writeTerrainOpenness(ensureBytes());
145: }
146: 
147: /** Whether a tile is open to the sky. For tests and debug overlays. */
148: export function isTileOpen(x: number, z: number): boolean {
149:   const b = ensureBytes();
150:   const xi = Math.floor(x);
151:   const zi = Math.floor(z);
152: 
153:   if (xi < 0 || zi < 0 || xi >= TERRAIN_SIZE || zi >= TERRAIN_SIZE) return true;
154: 
155:   return b[TERRAIN_INDEX(xi, zi)] !== 0;
156: }
157: 
158: /** Share of the map currently marked roofed - a one-line sanity check. */
159: export function roofedTileCount(): number {
160:   const b = ensureBytes();
161:   let n = 0;
162:   for (let i = 0; i < TERRAIN_SIZE * TERRAIN_SIZE; i++) {
163:     if (b[i] === 0) n++;
164:   }
165:   return n;
166: }
