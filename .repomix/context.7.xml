190:           : (packet.getUint8(1) << 8) | packet.getUint8(2);
191: 
192:       const packetsByCode = packetsCacheByCode[packetCode] ?? [];
193: 
194:       const pDef =
195:         packetsByCode.find(
196:           p => subCodeOf(p) === subCode && lengthOf(p) === decodedLength
197:         ) ??
198:         packetsByCode.find(
199:           p => subCodeOf(p) === subCode && lengthOf(p) == null
200:         ) ??
201:         packetsByCode.find(
202:           p => subCodeOf(p) == null && lengthOf(p) === decodedLength
203:         ) ??
204:         packetsByCode.find(p => subCodeOf(p) == null);
205: 
206:       if (pDef) {
207:         INFO_LOG && console.log(
208:           `${LOG_PREFIX}[${pDef.name}][${pDef.HeaderType}]0x${byteToString(pDef.Code)}${subCodeOf(pDef) != null ? `(0x${byteToString(subCodeOf(pDef)!)})` : ""
209:           } lng:${length}`
210:         );
211: 
212:         if (!EventBus.all.get(pDef.Name)?.length && !unhandledReported.has(pDef.Name)) {
213:           // Netcode audit: a packet we can parse but nobody listens to.
214:           unhandledReported.add(pDef.Name);
215:           console.warn(`${LOG_PREFIX}unhandled packet ${pDef.Name} (0x${byteToString(pDef.Code)}${subCodeOf(pDef) != null ? `/0x${byteToString(subCodeOf(pDef)!)}` : ''})`);
216:         }
217: 
218:         // A throwing handler must not jam the queue: consume the packet regardless.
219:         try {
220:           EventBus.emit(pDef.Name, packet);
221:         } catch (e) {
222:           console.error(`${LOG_PREFIX}handler for ${pDef.Name} threw:`, e);
223:         }
224:       } else {
225:         console.error(`${LOG_PREFIX}no packet: 0x` + byteToString(packetCode));
226:       }
227: 
228:       bytes = bytes.subarray(length);
229:     }
230:   }
231: 
232:   socket.addEventListener("message", (event) => {
233:     const buffer = event.data as ArrayBuffer;
234: 
235:     const newBytes = new Uint8Array(buffer);
236:     DEBUG_LOG && console.log(`${LOG_PREFIX}received ${newBytes.length} bytes:`, newBytes);
237: 
238:     if (bytes.length === 0) {
239:       bytes = newBytes;
240:     } else {
241:       const combined = new Uint8Array(bytes.length + newBytes.length);
242:       combined.set(bytes);
243:       combined.set(newBytes, bytes.length);
244:       bytes = combined;
245:     }
246: 
247:     handlePacketsQueue();
248:   });
249: 
250:   socket.addEventListener("open", (event) => {
251:     console.log(`${LOG_PREFIX}opened:`, event);
252:     EventBus.emit('wsOpened', { socket });
253:   });
254: 
255:   socket.addEventListener("close", (event) => {
256:     console.log(`${LOG_PREFIX}closed:`, event);
257:     EventBus.emit('wsClosed', { socket });
258:   });
259: 
260:   socket.addEventListener("error", (event) => {
261:     console.log(`${LOG_PREFIX}error:`, event);
262:     EventBus.emit('wsError', { socket, error: (event as ErrorEvent).error });
263:   });
264: 
265: return { socket } as const;
266: }
</file>

