1545: 
1546:   if (!grassAllowed(map)) return;
1547: 
1548:   installed = {
1549:     scene,
1550:     src: { ...src, cutout: maps.cutoutTileFor(map) },
1551:     field: null,
1552:     density: grassDensity(),
1553:     blade: bladeKind(),
1554:   };
