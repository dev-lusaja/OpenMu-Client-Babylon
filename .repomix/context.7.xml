 1: import type { LookProfile } from './profiles';
 2: import { sunDirectionOf } from './profiles';
 3: import { DEFAULT_SUN_DIRECTION } from './keyRig';
 4: 
 5: /**
 6:  * The one shadow rule (ARCHITECTURE §3.2, §4.4): a shadow removes the sun, so
 7:  * a shadowed surface keeps the sky share of the key. Three receivers read it -
 8:  * the CSM (`darkness` 0: the sun is cut whole, the sky untouched), the terrain
 9:  * hook (bake floor `1 - strength` in linear) and the Classic blobs (their own
10:  * 0.65 alpha, unchanged).
11:  */
12: export type ShadowPolicy = {
13:   /** Unit direction the light travels. */
14:   readonly direction: readonly [number, number, number];
15:   /** What a shadow cuts, 0..1: the sun share of the key. */
16:   readonly strength: number;
17:   /** PCF kernel scale (1) or the PCSS light size in shadow-map UV (Ultra). */
18:   readonly softness: number;
19:   /**
20:    * Who enters the shadow map (§13 F1). The lightmap already bakes every
21:    * static object's shadow, so `dynamic` keeps the map objects out and admits
22:    * only what moves; `all` is for a room, where the bake is flat.
23:    */
24:   readonly casters: 'dynamic' | 'all';
25: };
26: 
27: export type ShadowCasters = ShadowPolicy['casters'];
28: 
29: /**
30:  * Babylon's 0.1 default blurs a figure's shadow to twice the PCF width,
31:  * which put Ultra 6 % off Enhanced on p5/p50 for the same frame.
32:  */
33: const PCSS_LIGHT_SIZE = 0.04;
34: 
35: function unit(d: readonly [number, number, number]): [number, number, number] {
36:   const n = 1 / Math.hypot(d[0], d[1], d[2]);
37: 
38:   return [d[0] * n, d[1] * n, d[2] * n];
39: }
40: 
41: /** Classic: the rig never moves, so the blobs keep the lean they always had. */
42: export const CLASSIC_SHADOW_POLICY: ShadowPolicy = {
43:   direction: unit(DEFAULT_SUN_DIRECTION),
44:   strength: 0,
45:   softness: 1,
46:   casters: 'all',
47: };
48: 
49: export function shadowPolicyFor(
50:   profile: LookProfile,
51:   pcss: boolean,
52:   casters: ShadowCasters
53: ): ShadowPolicy {
54:   return {
55:     direction: unit(sunDirectionOf(profile.sun)),
56:     strength: profile.sun.share,
57:     softness: pcss ? PCSS_LIGHT_SIZE : 1,
58:     casters,
59:   };
60: }
</file>

<file path="src/lighting/skills.ts">
  1: import type { Scene } from '../libs/babylon/exports';
  2: import type { ENUM_WORLD } from '../common/types';
  3: import type { Entity } from '../ecs/world';
  4: import { skillDefinition } from '../common/skillsDatabase';
  5: import { MODEL } from '../effects/recipes';
  6: import type { LightingLayer } from './layer';
  7: import { LightSource, type LightRecipe } from './lightSource';
  8: import { tierIndex } from '../common/lightingQuality';
  9: import { arc, ember, flame, frost, holy, shade, spark, tide, venom } from './recipes';
 10: 
 11: /**
 12:  * Skills as light sources.
 13:  *
 14:  * What it is: the light a skill throws - at the caster's hands as the clip
 15:  * starts, riding the projectile to the target, at the target on impact, or
 16:  * on the ground point of an area skill. Driven by the two commands below,
 17:  * which `common/skillVisuals.ts` calls from the skill packets. Read by nobody
 18:  * but the sinks; `emitters()` reports what is live.
 19:  *
 20:  * Ranges are the original's `AddTerrainLight` radii per effect
 21:  * (ZzzEffect.cpp line cited per row); colours follow the effect's sprite
 22:  * tint. Where the original has no light the row says so and the values are
 23:  * ours. A skill with no row still gets `DEFAULT_WIZARDRY_CAST` if it is
 24:  * wizardry, so no spell is cast in the dark before its recipe exists.
 25:  */
 26: 
 27: // ---- 1. tuning -------------------------------------------------------------
 28: 
 29: /** Tiles above the caster's feet where a cast light sits: the hands. */
 30: const CAST_HEIGHT = 1.1;
 31: 
 32: /** Tiles above a target's feet where an impact light sits: the chest. */
 33: const IMPACT_HEIGHT = 0.9;
 34: 
 35: /** Energy Ball's projectile speed in tiles/s, matching effects/energyBall.ts. */
 36: const BOLT_SPEED = 7;
 37: 
 38: /** Arrows are faster than magic bolts: 70 cm a tick, like `common/skillVisuals.ts`. */
 39: const ARROW_SPEED = 17.5;
 40: 
 41: /**
 42:  * Seconds an arrow light lives if nothing ends it. An arrow crosses the
 43:  * elf's six tiles in about a third of a second and `lightArrow`'s host stops
 44:  * the source the moment the shot lands, so this only catches a projectile
 45:  * that never reports back - it is the effects layer's own give-up time.
 46:  */
 47: const ARROW_SECONDS = 4;
 48: 
 49: /**
 50:  * One skill, in up to four moments. Each is optional; a skill with only
 51:  * `cast` flashes at the caster and nothing else.
 52:  *
 53:  *  - `cast`: at the caster's hands as the clip starts.
 54:  *  - `travel`: rides from the caster to the target at `speed` tiles/s and
 55:  *    ends on arrival; then `impact` fires at the target.
 56:  *  - `impact`: at the target - on arrival if there is a `travel`, at once
 57:  *    otherwise.
 58:  *  - `area`: at the ground point of an area skill.
 59:  */
 60: export type SkillLight = {
 61:   readonly cast?: LightRecipe;
 62:   readonly travel?: LightRecipe & { readonly speed: number };
 63:   readonly impact?: LightRecipe;
 64:   readonly area?: LightRecipe;
 65:   /**
 66:    * `trail`: one light per moving body the effect spawns, riding it. The
 67:    * effects layer owns those paths, so it hands a `follow` over per body and
 68:    * this layer decides whether the tier can carry them.
 69:    */
 70:   readonly trail?: LightRecipe;
 71:   /**
 72:    * `arrow`: what this skill's arrows carry while they fly, overriding the
 73:    * launcher-model row in `ARROW_LIGHTS`. For the skills this client draws
 74:    * with a tinted arrow where the original fires the plain one.
 75:    */
 76:   readonly arrow?: LightRecipe;
 77: };
 78: 
 79: /** Lighting tier that carries per-body effect lights. */
 80: const ULTRA_TIER = 2;
 81: 
 82: /** Keyed by skill number (common/skillsDatabase.ts). */
 83: export const SKILL_LIGHTS: Partial<Record<number, SkillLight>> = {
 84:   // MODEL_POISON: AddTerrainLight range 2 (ZzzEffect.cpp:9752).
 85:   1: { travel: { ...venom(2, 3), speed: BOLT_SPEED }, impact: venom(2, 0.6) },
 86:   // Meteorite: a falling fire model - warm impact (BITMAP_FIRE+1 range 2, :8092).
 87:   2: { cast: ember(1, 0.3), impact: flame(2, 0.5) },
 88:   // BITMAP_LIGHTNING: range 6 on the strike (ZzzEffectParticle.cpp:4298).
 89:   // 0.4 s is the clip: the bolt is `ticks(10)` in skillVisuals, and a light
 90:   // that ends before its effect leaves the ground dark under a live bolt.
 91:   3: { impact: arc(6, 0.4, { gain: 1.4 }) },
 92:   // Fire Ball: BITMAP_FIRE+1 range 2 in flight (:8092).
 93:   4: { travel: { ...ember(2, 3), speed: BOLT_SPEED }, impact: flame(2, 0.45) },
 94:   // Flame: BITMAP_FLAME range 3 while the column burns (:8649).
 95:   5: { area: flame(3, 1.5, { release: 0.5 }) },
 96:   // Ice: MODEL_ICE range 2 (:12182).
 97:   7: { travel: { ...frost(2, 3), speed: BOLT_SPEED }, impact: frost(2, 0.5) },
 98:   // Twister: MODEL_STORM range 5 (:10480).
 99:   8: { area: { color: [0.75, 0.8, 0.9], range: 5, seconds: 1.4 } },
100:   // Evil Spirit: the original lights nothing here; a violet wash is ours.
101:   9: { area: shade(3, 1.2), trail: { ...shade(2.4, 49 / 25), gain: 1.3, floorGain: 1.2, release: 0.4 } },
102:   // Hellfire: BITMAP_FLAME range 3, as Flame, brighter.
103:   10: { area: flame(4, 1.5, { gain: 1.4, floorGain: 1.3 }) },
104:   // Power Wave: MODEL_WAVE range 5 (:9610).
105:   11: { travel: { ...tide(5, 3), speed: BOLT_SPEED }, impact: tide(3, 0.3) },
106:   // Aqua Beam: MODEL_WATER_WAVE range 3 (:11644).
107:   12: { area: tide(4, 1.0) },
108:   // Cometfall: MODEL_GROUND_STONE2 range 4 (:13710).
109:   13: { area: flame(4, 1.0, { attack: 0.15 }) },
110:   // Inferno: BITMAP_FLAME range 3 (:8695), wide.
111:   14: { area: flame(4, 1.5, { gain: 1.6, floorGain: 1.5 }) },
112:   // BITMAP_ENERGY: range 2 in flight (:8820).
113:   17: { travel: { ...spark(2, 3), speed: BOLT_SPEED }, impact: spark(2, 0.3) },
114:   // Heal: MODEL_MAGIC_CIRCLE1 range 3 (:9705).
115:   26: { impact: holy(3, 1.0) },
116:   // Greater Defense / Greater Damage: the same magic circle.
117:   27: { impact: holy(3, 1.0) },
118:   28: { impact: { ...holy(3, 1.0), color: [1, 0.75, 0.55] } },
119:   // Ice Storm: MODEL_ICE range 4 on the storm's core (:12423).
120:   39: { area: frost(5, 1.6) },
121:   // Nova: the original lights nothing; a fire ring of range 6 is ours.
122:   40: { area: flame(6, 0.8, { gain: 1.8, floorGain: 1.4, release: 0.6 }) },
123:   // Twisting Slash: MODEL_SKILL_WHEEL2 range 3 (:9798).
124:   41: { area: spark(3, 0.6) },
125:   // Starfall: MODEL_ARROW_IMPACT lights nothing in the original (:14596);
126:   // the holy wash riding the shot down is ours.
127:   46: { arrow: { ...holy(2, ARROW_SECONDS), release: 0.2 } },
128:   // Fire Breath: BITMAP_FIRE+1 range 2.
129:   49: { impact: flame(2, 0.5) },
130:   // Ice Arrow: MODEL_ARROW range 2 (:11777). The bolt light rides the same
131:   // path the arrow does and fires the impact on arrival, so it keeps it.
132:   51: { travel: { ...frost(2, 3), speed: ARROW_SPEED }, impact: frost(2, 0.4) },
133:   // Penetration: the original fires the launcher arrow (MODEL_ARROW_STEEL on
134:   // a crossbow, which lights nothing); this client draws it charged
135:   // blue-white, so the arc is ours.
136:   52: { arrow: { ...arc(2, ARROW_SECONDS), release: 0.2 } },
137:   // Fire Slash / Flame Strike: BITMAP_JOINT_FIRE range 2 (ZzzEffectJoint.cpp:4612).
138:   55: { area: flame(3, 0.7) },
139:   236: { area: flame(3, 0.8, { gain: 1.3 }) },
140:   // Fire Burst / Fire Blast / Fire Scream: BITMAP_FLAME range 3.
141:   61: { impact: flame(3, 0.6) },
142:   74: { impact: flame(3, 0.6, { gain: 1.3 }) },
143:   78: { area: flame(4, 0.9, { gain: 1.3 }) },
144:   // Electric Spark / Lightning Shock / Chain Lightning: BITMAP_LIGHTNING+1 range 2-4.
145:   65: { area: arc(4, 0.5) },
146:   215: { impact: arc(4, 0.45) },
147:   230: { area: arc(5, 0.6, { gain: 1.4 }) },
148:   // Drain Life: MODEL_DARK_ELF_SKILL range 3 (:10423).
149:   214: { impact: shade(3, 0.8) },
150: };
151: 
152: /**
153:  * One arrow's light: the original's range 2 in the colour of the row,
154:  * rolling on `Luminosity`. The tail is short because an arrow ends where it
155:  * lands - a long one leaves a glow hanging in the air behind the shot.
156:  */
157: function arrowLight(color: readonly [number, number, number]): LightRecipe {
158:   return {
159:     color,
160:     range: 2,
161:     seconds: ARROW_SECONDS,
162:     release: 0.2,
163:     flicker: { min: 0.7, max: 1, steps: 4 },
164:   };
165: }
166: 
167: /**
168:  * What an arrow throws on the ground while it flies, by the launcher's
169:  * arrow model.
170:  *
171:  * The original lights the arrow body itself, every frame it is alive:
172:  * `AddTerrainLight(..., range 2)` in the colour below, from MoveEffect's
173:  * arrow cases in ZzzEffect.cpp (line cited per row). `Luminosity` there is
174:  * `(rand() % 4 + 7) * 0.1` rolled per effect per frame (:6764), which is the
175:  * flicker every row carries. Range 2 is the whole reason a volley reads at
176:  * night: the arrow is a tile off the ground, so the pool it drags along is
177:  * what the grass and the shooter are lit by.
178:  *
179:  * The metal bolts fall through the original's chain without a light and have
180:  * no row here either: MODEL_ARROW_STEEL, _THUNDER, _LASER, _V, _SAW, _SPARK
181:  * and _DARKSTINGER fly dark.
182:  */
183: export const ARROW_LIGHTS: Partial<Record<string, LightRecipe>> = {
184:   // MODEL_ARROW (:11776) - the plain wooden arrow every bow but the Elven,
185:   // Chaos Nature and Celestial fires, and what Triple Shot, Multi-Shot and
186:   // Ice Arrow draw here.
187:   [MODEL.arrow]: arrowLight([0.8, 0.5, 0.2]),
188:   // MODEL_ARROW_NATURE sub1, the Poison Arrow shot (:11833).
189:   [MODEL.arrowNature]: arrowLight([0.2, 0.8, 0.2]),
190:   // MODEL_LACEARROW, Arrow Viper Bow (:11885).
191:   [MODEL.laceArrow]: arrowLight([0.6, 0.2, 0.8]),
192:   // MODEL_ARROW_WING, Bluewing Crossbow (:11900).
193:   [MODEL.arrowWing]: arrowLight([0.6, 0.8, 0.8]),
194:   // MODEL_ARROW_BOMB, Aquagold Crossbow (:12056).
195:   [MODEL.arrowBomb]: arrowLight([0.6, 0.8, 0.8]),
196:   // MODEL_ARROW_RING, Albatross Bow (:12023).
197:   [MODEL.arrowRing]: arrowLight([0.6, 0.2, 0.8]),
198:   // MODEL_ARROW_GAMBLE, Air Lyn Bow (:12125).
199:   [MODEL.arrowGamble]: arrowLight([0.2, 0.8, 0.5]),
200:   // MODEL_ARROW_DOUBLE, Saint Crossbow (:11738).
201:   [MODEL.arrowDouble]: arrowLight([0.2, 0.4, 1]),
202:   // MODEL_ARROW_BEST_CROSSBOW, Divine Crossbow of Archangel (:11730).
203:   [MODEL.arrowBestCrossbow]: arrowLight([1, 0.4, 0.2]),
204:   // MODEL_ARROW_DRILL, Great Reign Crossbow (:12846).
205:   [MODEL.arrowDrill]: arrowLight([1, 0.4, 0.2]),
206: };
207: 
208: /**
209:  * Any wizardry skill without a row: a short pale flash at the caster's
210:  * hands - the MODEL_MAGIC2 cast glow (range 3, :10437), kept to 2 tiles so it
211:  * never out-lights a skill that has a real recipe.
212:  */
213: export const DEFAULT_WIZARDRY_CAST: LightRecipe = {
214:   color: [0.8, 0.85, 1],
215:   range: 2,
216:   seconds: 0.4,
217:   release: 0.3,
218: };
219: 
220: // ---- 2. state + readers ----------------------------------------------------
221: 
222: const sources = new Set<LightSource>();
223: 
224: function attach(
225:   scene: Scene,
226:   recipe: LightRecipe,
227:   anchor: Parameters<typeof LightSource.attach>[2]
228: ): LightSource {
229:   const source = LightSource.attach(scene, recipe, anchor);
230:   sources.add(source);
231:   return source;
232: }
233: 
234: function entityPos(e: Entity, height: number) {
235:   const t = e.transform!;
236:   return {
237:     x: t.pos.x + (t.posOffset?.x ?? 0),
238:     y: t.pos.y + height,
239:     z: t.pos.z + (t.posOffset?.z ?? 0),
240:   };
241: }
242: 
243: function followEntity(e: Entity, height: number) {
244:   return (out: { x: number; y: number; z: number }) => {
245:     const t = e.transform;
246:     if (!t) return;
247:     out.x = t.pos.x + (t.posOffset?.x ?? 0);
248:     out.y = t.pos.y + height;
249:     out.z = t.pos.z + (t.posOffset?.z ?? 0);
250:   };
251: }
252: 
253: function castRecipeFor(skill: number): LightRecipe | null {
254:   const row = SKILL_LIGHTS[skill];
255: 
256:   if (row?.cast) return row.cast;
257:   // A skill with a recipe keeps its hands dark unless it asked for a cast
258:   // flash; only unknown wizardry gets the fallback.
259:   if (row) return null;
260: 
261:   return skillDefinition(skill)?.damageType === 'Wizardry'
262:     ? DEFAULT_WIZARDRY_CAST
263:     : null;
264: }
265: 
266: /** Command: a targeted skill - cast flash, then projectile or direct impact. */
267: export function lightTargetedSkill(
268:   scene: Scene,
269:   skill: number,
270:   caster: Entity,
271:   target: Entity | null
272: ): void {
273:   if (!caster.transform) return;
274: 
275:   const row = SKILL_LIGHTS[skill];
276:   const cast = castRecipeFor(skill);
277: 
278:   if (cast) {
279:     attach(scene, cast, {
280:       position: entityPos(caster, CAST_HEIGHT),
281:       follow: followEntity(caster, CAST_HEIGHT),
282:     });
283:   }
284: 
285:   if (!row || !target?.transform) return;
286: 
287:   const impact = () => {
288:     if (!row.impact || !target.transform) return;
289: 
290:     attach(scene, row.impact, {
291:       position: entityPos(target, IMPACT_HEIGHT),
292:       follow: followEntity(target, IMPACT_HEIGHT),
293:     });
294:   };
295: 
296:   if (row.travel) {
297:     const { speed, ...recipe } = row.travel;
298: 
299:     attach(scene, recipe, {
300:       position: entityPos(caster, CAST_HEIGHT),
301:       travel: { to: entityPos(target, IMPACT_HEIGHT), speed, onArrive: impact },
302:     });
303:   } else {
304:     impact();
305:   }
306: }
307: 
308: /** Command: an area skill - cast flash, then the ground light at `at`. */
309: export function lightAreaSkill(
310:   scene: Scene,
311:   skill: number,
312:   caster: Entity,
313:   at: { x: number; y: number; z: number }
314: ): void {
315:   const row = SKILL_LIGHTS[skill];
316:   const cast = castRecipeFor(skill);
317: 
318:   if (cast && caster.transform) {
319:     attach(scene, cast, {
320:       position: entityPos(caster, CAST_HEIGHT),
321:       follow: followEntity(caster, CAST_HEIGHT),
322:     });
323:   }
324: 
325:   const area = row?.area ?? row?.impact;
326: 
327:   if (area) attach(scene, area, { position: { ...at } });
328: }
329: 
330: /**
331:  * Command: a light riding one of a skill's moving bodies - Evil Spirit's four
332:  * spirits, each carrying its own violet. Ultra only: four of these is half the
333:  * point-light pool, and Ultra is the tier that budgets for that. Returns null
334:  * when the row has no `trail` or the tier will not carry it, so the caller can
335:  * skip its own bookkeeping.
336:  */
337: export function lightSkillTrail(
338:   scene: Scene,
339:   skill: number,
340:   follow: (out: { x: number; y: number; z: number }) => void
341: ): LightSource | null {
342:   const recipe = SKILL_LIGHTS[skill]?.trail;
343: 
344:   if (!recipe || tierIndex() < ULTRA_TIER) return null;
345: 
346:   const position = { x: 0, y: 0, z: 0 };
347:   follow(position);
348: 
349:   return attach(scene, recipe, { position, follow });
350: }
351: 
352: /**
353:  * Command: the light an arrow carries while it flies. `skill` is 0 for a
354:  * plain bow shot and the base skill number for a skill volley; `model` is
355:  * the arrow model the launcher picked. Null when neither the skill nor the
356:  * model has a row, so the caller can skip its own bookkeeping.
357:  *
358:  * Not tier-gated, unlike `lightSkillTrail`: an arrow is one light per shot,
359:  * and where there is no point-light pool the terrain delta still carries it
360:  * - which is all the original ever had.
361:  *
362:  * A row with its own `travel` bolt keeps it and gets nothing here: the two
363:  * ride the same path, and the bolt is the one that fires the impact flash
364:  * when it lands.
365:  */
366: export function lightArrow(
367:   scene: Scene,
368:   skill: number,
369:   model: string,
370:   follow: (out: { x: number; y: number; z: number }) => void
371: ): LightSource | null {
372:   const row = SKILL_LIGHTS[skill];
373: 
374:   if (row?.travel) return null;
375: 
376:   const recipe = row?.arrow ?? ARROW_LIGHTS[model];
377: 
378:   if (!recipe) return null;
379: 
380:   const position = { x: 0, y: 0, z: 0 };
381: 
382:   follow(position);
383: 
384:   return attach(scene, recipe, { position, follow });
385: }
386: 
387: function update(): void {
388:   for (const source of sources) if (!source.alive) sources.delete(source);
389: }
390: 
391: function reset(): void {
392:   sources.clear();
393: }
394: 
395: function emitters(): readonly LightSource[] {
396:   return Array.from(sources);
397: }
398: 
399: // ---- 3. the layer ----------------------------------------------------------
400: 
401: /** Every map: a skill lights wherever it is cast. */
402: export const skillsLayer: LightingLayer = {
403:   name: 'skills',
404:   update: (_map: ENUM_WORLD) => update(),
405:   reset,
406:   emitters,
407: };
</file>

<file path="src/lighting/sky.ts">
  1: /**
  2:  * Sky lights: the Icarus thunder flash. `MoveHeavenThunder`
  3:  * (ZzzObject.cpp:4204) rolls a strike over the hero every ~2 s and, for one
  4:  * frame, `AddTerrainLight(pos, (L*0.3, L*0.3, L*0.081), 2, …)` with
  5:  * `L = (rand()%4 + 4) * 0.05`. The timing and the sparkles stay in
  6:  * `maps/icarus/sky.ts`, which calls `strikeThunder` when a strike is due.
  7:  */
  8: import type { Scene } from '../libs/babylon/exports';
  9: import { ENUM_WORLD } from '../common/types';
 10: import type { LightingLayer } from './layer';
 11: import { LightSource, type LightRecipe } from './lightSource';
 12: 
 13: // ---- 1. tuning -------------------------------------------------------------
 14: 
 15: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([ENUM_WORLD.WD_10ICARUS]);
 16: 
 17: /** `Luminosity = (rand()%4 + 4) * 0.05f` - 0.20, 0.25, 0.30 or 0.35. */
 18: const THUNDER_LUMI_MIN = 0.2;
 19: const THUNDER_LUMI_STEP = 0.05;
 20: const THUNDER_LUMI_STEPS = 4;
 21: 
 22: /** `Light = (Luminosity*0.3f, Luminosity*0.3f, Luminosity*0.081f)`. */
 23: const THUNDER_R = 0.3;
 24: const THUNDER_G = 0.3;
 25: const THUNDER_B = 0.081;
 26: 
 27: /** `AddTerrainLight(…, 2, PrimaryTerrainLight)` - moot, Icarus draws no terrain. */
 28: const THUNDER_TERRAIN_RANGE = 2;
 29: 
 30: /**
 31:  * How long a strike takes to die away, in seconds.
 32:  *
 33:  * The original's flash is a single frame of `AddTerrainLight` plus a
 34:  * `MODEL_CLOUD` plane with `LifeTime` 2 - two frames at the 25-30 fps it was
 35:  * written for, so ~70 ms. Reproducing that literally at 60-144 fps gives a
 36:  * flash one or two frames long, which reads as a dropped frame rather than as
 37:  * lightning, so the pulse is held to a fixed wall-clock decay instead of a
 38:  * frame count. Instant on, linear out - the recipe's release is the whole
 39:  * life.
 40:  */
 41: const THUNDER_DECAY = 0.22;
 42: 
 43: /**
 44:  * Tiles the flash reaches, and how hard it is pushed.
 45:  *
 46:  * Neither number is in the original, because in the original this light does
 47:  * not have to carry the effect on its own: what the player sees is the
 48:  * additive `MODEL_CLOUD` plane at `Scale` 10 hanging over the hero. That is
 49:  * not reproduced, Icarus draws no terrain (`MainScene.cpp:402`), and objects
 50:  * read the *baked* lightmap rather than the dynamic delta - so the pulse is a
 51:  * point light sized to wash the islands the hero is standing on: `Light`
 52:  * peaks at 0.105, and the pool turns that into `0.105 × 3 × gain`.
 53:  */
 54: const THUNDER_RANGE = 14;
 55: const THUNDER_GAIN = 12;
 56: 
 57: function thunderRecipe(lumi: number): LightRecipe {
 58:   return {
 59:     color: [lumi * THUNDER_R, lumi * THUNDER_G, lumi * THUNDER_B],
 60:     range: THUNDER_TERRAIN_RANGE,
 61:     pointRange: THUNDER_RANGE,
 62:     gain: THUNDER_GAIN,
 63:     // Directly overhead; every shadow in Icarus is off anyway.
 64:     heightOffset: 0,
 65:     seconds: THUNDER_DECAY,
 66:     release: THUNDER_DECAY,
 67:   };
 68: }
 69: 
 70: // ---- 2. state + readers ----------------------------------------------------
 71: 
 72: const strikes = new Set<LightSource>();
 73: 
 74: /**
 75:  * Command: a strike at `at` (the hero's position with the original's ±150 MU
 76:  * x jitter already applied by the caller). Rolls the luminosity itself and
 77:  * returns it, for anything that wants to match the flash.
 78:  */
 79: export function strikeThunder(
 80:   scene: Scene,
 81:   at: { x: number; y: number; z: number }
 82: ): number {
 83:   const lumi =
 84:     THUNDER_LUMI_MIN +
 85:     Math.floor(Math.random() * THUNDER_LUMI_STEPS) * THUNDER_LUMI_STEP;
 86: 
 87:   strikes.add(LightSource.attach(scene, thunderRecipe(lumi), { position: { ...at } }));
 88: 
 89:   return lumi;
 90: }
 91: 
 92: function update(): void {
 93:   for (const strike of strikes) if (!strike.alive) strikes.delete(strike);
 94: }
 95: 
 96: function reset(): void {
 97:   strikes.clear();
 98: }
 99: 
100: function emitters(): readonly LightSource[] {
101:   return Array.from(strikes);
102: }
103: 
104: // ---- 3. the layer ----------------------------------------------------------
105: 
106: export const skyLayer: LightingLayer = {
