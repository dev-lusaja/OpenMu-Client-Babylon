  1: import type { Scene } from '../libs/babylon/exports';
  2: import { devQueryNumber } from '../common/devSeams';
  3: import { registerPointLightEmitter } from '../common/pointLightPool';
  4: import {
  5:   registerTerrainLight,
  6:   type TerrainLightColor,
  7: } from '../common/terrainDynamicLight';
  8: 
  9: /**
 10:  * The one registration - shared by every entry in this folder.
 11:  *
 12:  * Everything that emits light goes through the same two sinks: the terrain
 13:  * delta texture (`common/terrainDynamicLight.ts`, MU's `AddTerrainLight`)
 14:  * and the pooled per-pixel `PointLight`s (`common/pointLightPool.ts`). A
 15:  * `LightSource` is that pair registered once, driven by a `LightRecipe`
 16:  * (plain data) and an anchor (a position the host mutates, a `follow`
 17:  * callback, or a `travel` target), with an envelope, flicker or pulse, tile
 18:  * re-registration while it moves, and its own removal when it ends.
 19:  *
 20:  * Entries own sources; the facade ticks them (`tickLightSources`) and drops
 21:  * them on a map change (`disposeAllLightSources`). Nothing else registers
 22:  * into the sinks - lighting is a
 23:  * layer".
 24:  *
 25:  * What the original does, for reference: ZzzEffect.cpp lights the ground
 26:  * under 70-odd effects every frame they exist (BITMAP_FLAME range 3,
 27:  * BITMAP_LIGHTNING 6, MODEL_WAVE 5, MODEL_FISSURE 10, every arrow type 2),
 28:  * ZzzCharacter.cpp under the blacksmith's forge and the Devias trader's
 29:  * brazier, and each light dies with its effect. Those need three things the
 30:  * static map-object path lacks: a lifetime with an envelope, a position that
 31:  * moves, and an instant start - the pool's 0.35 s fade-in turns a lightning
 32:  * strike into a swell.
 33:  *
 34:  * Governing rule unchanged: sources only *add*. The original's negative
 35:  * lights (Bloody Wolf / Tantallos `Vector(-1.3, -1.3, -1.3)`) have no
 36:  * equivalent .
 37:  */
 38: 
 39: export type LightFlicker = { min: number; max: number; steps: number };
 40: 
 41: export type LightPulse = {
 42:   speed: number;
 43:   amount: number;
 44:   base: number;
 45:   /** Milliseconds added to the clock - lamps that pulse out of step. */
 46:   phase?: number;
 47: };
 48: 
 49: /**
 50:  * A colour that is not a constant: the callback writes the current linear
 51:  * RGB into `out` every tick. For hosts whose colour is animated elsewhere
 52:  * (item tiers breathe on the item-glow clock). The envelope still scales it.
 53:  */
 54: export type LightColorFn = (out: TerrainLightColor) => TerrainLightColor;
 55: 
 56: /**
 57:  * A light, as data. Every field but `color` and `range` has a default, so a
 58:  * recipe can be as short as `{ color: [1, 0.6, 0.3], range: 3 }`.
 59:  */
 60: export type LightRecipe = {
 61:   /** Peak colour, linear RGB, or a callback that writes it. The envelope scales it. */
 62:   readonly color: readonly [number, number, number] | LightColorFn;
 63:   /** Terrain footprint radius in tiles - MU's `AddTerrainLight` range. */
 64:   readonly range: number;
 65:   /** Point-light radius in tiles; defaults to `range + POINT_RANGE_EXTRA`. */
 66:   readonly pointRange?: number;
 67:   /** Point-light intensity multiplier (`LightEmitter.pointGain`). */
 68:   readonly gain?: number;
 69:   /** Terrain floor multiplier (`LightEmitter.terrain.floorGain`). */
 70:   readonly floorGain?: number;
 71:   /** Terrain falloff exponent (`LightEmitter.terrain.falloff`). */
 72:   readonly falloff?: number;
 73:   /** Random flicker - MU's `Luminosity` roll. Wins over `pulse`. */
 74:   readonly flicker?: LightFlicker;
 75:   /**
 76:    * Flicker chase per tick, 0…1. Defaults to FLICKER_SMOOTHING (0.25, event
 77:    * lights). Map torches pass TORCH_FLICKER_SMOOTHING (0.12): slower, so a
 78:    * hundred of them do not all twitch at once.
 79:    */
 80:   readonly flickerSmoothing?: number;
 81:   /** Smooth sine on the luminosity: `(sin(ms * speed) + 1) * amount + base`. */
 82:   readonly pulse?: LightPulse;
 83:   /** Random jitter of the point light's position, in tiles. */
 84:   readonly wander?: number;
 85:   /** Height of the point light above the anchor, in tiles. */
 86:   readonly heightOffset?: number;
 87:   /** Pool priority: hero gear 2, players 1, torches 0. Defaults to PRIORITY_EFFECT. */
 88:   readonly priority?: number;
 89:   /**
 90:    * Skip the pool's 0.35 s fade-in when taking a slot. Defaults to true -
 91:    * an event light must be on the frame it is asked for. Torches and lamps
 92:    * that exist for the whole map pass false and keep the cross-fade.
 93:    */
 94:   readonly instant?: boolean;
 95:   /** Life in seconds. Omitted or `Infinity`: lives until `stop()`. */
 96:   readonly seconds?: number;
 97:   /** Seconds to reach the peak from zero. 0 = instant (default). */
 98:   readonly attack?: number;
 99:   /** Seconds of tail at the end. Defaults to 40 % of `seconds`, 0.3 s if endless. */
100:   readonly release?: number;
101: };
102: 
103: export type LightAnchor = {
104:   /** Start position. Held by reference - the host may mutate it to move. */
105:   readonly position: { x: number; y: number; z: number };
106:   /** Called every tick; write the current position into `out`. */
107:   readonly follow?: (out: { x: number; y: number; z: number }) => void;
108:   /**
109:    * Straight-line travel to `to` at `speed` tiles/second. The light ends on
110:    * arrival and `onArrive` fires - an impact flash belongs there.
111:    */
112:   readonly travel?: {
113:     readonly to: { x: number; y: number; z: number };
114:     readonly speed: number;
115:     readonly onArrive?: () => void;
116:   };
117: };
118: 
119: // ---- tuning ----------------------------------------------------------------
120: 
121: /**
122:  * Pool priority for event lights, above hero gear (2): a skill flash lasts
123:  * under two seconds and is the brightest thing in frame while it does - it
124:  * must never wait for a slot.
125:  */
126: export const PRIORITY_EFFECT = 3;
127: 
128: /** Pool priority for lights that belong to the map: torches, lamps, drops. */
129: export const PRIORITY_TORCH = 0;
130: 
131: /**
132:  * What an event light's point term is worth against a torch's.
133:  *
134:  * The pool is authored for map lights, which hang on a wall or stand in a
135:  * corner: by the time one reaches a body it has fallen off. An event light is
136:  * *inside* the scene - a bolt lands a tile from the grass tufts, a spirit
137:  * passes through them - and at a torch's strength it arrives so far over what
138:  * a surface can hold that the diffuse term saturates and the prop comes back
139:  * in the light's colour instead of its own. That is a wash, not a pool.
140:  *
141:  * Recipes' own `gain` multiplies this, so the relative tuning between skills
142:  * is unchanged. Dev seam: `?fxgain=`.
143:  */
144: const EVENT_POINT_GAIN = 0.35;
145: 
146: const eventGainDev = devQueryNumber('fxgain');
147: 
148: function eventPointGain(priority: number): number {
149:   if (priority < PRIORITY_EFFECT) return 1;
150: 
151:   return eventGainDev !== null ? Math.max(0, eventGainDev) : EVENT_POINT_GAIN;
152: }
153: 
154: /**
155:  * Tiles the point light reaches past the terrain footprint. The floor pool
156:  * is a tile cone; the walls and bodies around it are lit per pixel and read
157:  * further out.
158:  */
159: const POINT_RANGE_EXTRA = 2;
160: 
161: /**
162:  * Flicker chase per tick, 0…1. Higher than `effectLights`' 0.12 because event
163:  * lights are short and a lazy chase never reaches the roll before they end.
164:  */
165: const FLICKER_SMOOTHING = 0.25;
166: 
167: /** The map-object chase the old `effectLights` used; torch recipes opt in. */
168: export const TORCH_FLICKER_SMOOTHING = 0.12;
169: 
170: /** Share of a finite life spent in the release tail when none is given. */
171: const DEFAULT_RELEASE_SHARE = 0.4;
172: 
173: /** Seconds of tail for an endless source that is `stop()`ped. */
174: const ENDLESS_RELEASE = 0.3;
175: 
176: /** Tiles within which a travelling light is considered arrived. */
177: const ARRIVE_EPSILON = 0.05;
178: 
179: // ---- state -----------------------------------------------------------------
180: 
181: const live = new Set<LightSource>();
182: 
183: export class LightSource {
184:   readonly position: { x: number; y: number; z: number };
185: 
186:   readonly recipe: LightRecipe;
187: 
188:   #anchor: LightAnchor;
189: 
190:   #age = 0;
191: 
192:   /** Age at which `stop()` was called, or null while running. */
193:   #stoppedAt: number | null = null;
194: 
195:   #lumi: number;
196: 
197:   #color: TerrainLightColor = { r: 0, g: 0, b: 0 };
198: 
199:   #offTerrain: () => void = () => {};
200: 
201:   #offPoint: () => void = () => {};
202: 
203:   #dead = false;
204: 
205:   /**
206:    * Attach a light. It is on screen this frame and removes itself when its
207:    * envelope ends; an endless recipe must be `stop()`ped or `dispose()`d by
208:    * its host. `scene` is accepted for symmetry with every other spawn call
209:    * and for hosts that key pools by scene; the tick is the facade's.
210:    */
211:   static attach(
212:     _scene: Scene,
213:     recipe: LightRecipe,
214:     anchor: LightAnchor
215:   ): LightSource {
216:     const source = new LightSource(recipe, anchor);
217: 
218:     source.#register();
219:     live.add(source);
220: 
221:     return source;
222:   }
223: 
224:   private constructor(recipe: LightRecipe, anchor: LightAnchor) {
225:     this.recipe = recipe;
226:     this.#anchor = anchor;
227:     this.position = anchor.position;
228:     this.#lumi = recipe.flicker
229:       ? (recipe.flicker.min + recipe.flicker.max) / 2
230:       : recipe.pulse
231:         ? recipe.pulse.base + recipe.pulse.amount
232:         : 1;
233: 
234:     // First frame at the attack's starting value, so a zero-attack flash is
235:     // on screen the frame it is asked for rather than one tick later.
236:     this.#write((recipe.attack ?? 0) > 0 ? 0 : 1);
237:   }
238: 
239:   /** The current colour, as fed to both sinks. */
240:   get color(): TerrainLightColor {
241:     return this.#color;
242:   }
243: 
244:   get alive(): boolean {
245:     return !this.#dead;
246:   }
247: 
248:   /** Begin the release tail now. */
249:   stop(): void {
250:     if (this.#stoppedAt === null) this.#stoppedAt = this.#age;
251:   }
252: 
253:   /** Cut it dead - no tail. */
254:   dispose(): void {
255:     if (this.#dead) return;
256:     this.#dead = true;
257:     this.#offTerrain();
258:     this.#offPoint();
259:     live.delete(this);
260:   }
261: 
262:   /** Both sinks hold `position` by reference and read it every frame. */
263:   #register(): void {
264:     const { recipe, position } = this;
265: 
266:     const terrain = {
267:       position,
268:       range: recipe.range,
269:       falloff: recipe.falloff,
270:       floorGain: recipe.floorGain,
271:       color: () => this.#color,
272:     };
273: 
274:     this.#offTerrain = registerTerrainLight(terrain);
275: 
276:     this.#offPoint = registerPointLightEmitter({
277:       position,
278:       terrain,
279:       heightOffset: recipe.heightOffset,
280:       range: recipe.pointRange ?? recipe.range + POINT_RANGE_EXTRA,
281:       gain: (recipe.gain ?? 1) * eventPointGain(recipe.priority ?? PRIORITY_EFFECT),
282:       wander: recipe.wander,
283:       priority: recipe.priority ?? PRIORITY_EFFECT,
284:       instant: recipe.instant ?? true,
285:       color: () => this.#color,
286:     });
287:   }
288: 
289:   #envelope(): number {
290:     const { recipe } = this;
291:     const seconds = recipe.seconds ?? Infinity;
292:     const attack = recipe.attack ?? 0;
293:     const release =
294:       recipe.release ??
295:       (Number.isFinite(seconds)
296:         ? seconds * DEFAULT_RELEASE_SHARE
297:         : ENDLESS_RELEASE);
298: 
299:     let e = attack > 0 ? Math.min(1, this.#age / attack) : 1;
300: 
301:     const tailStart = Number.isFinite(seconds)
302:       ? Math.max(0, seconds - release)
303:       : Infinity;
304:     const from = Math.min(tailStart, this.#stoppedAt ?? Infinity);
305: 
306:     if (this.#age >= from) {
307:       e *= release > 0 ? Math.max(0, 1 - (this.#age - from) / release) : 0;
308:     }
309: 
310:     return e;
311:   }
312: 
313:   #write(e: number): void {
314:     const { color } = this.recipe;
315:     const k = e * this.#lumi;
316: 
317:     if (typeof color === 'function') {
318:       const c = color(this.#color);
319: 
320:       c.r *= k;
321:       c.g *= k;
322:       c.b *= k;
323: 
324:       return;
325:     }
326: 
327:     this.#color.r = color[0] * k;
328:     this.#color.g = color[1] * k;
329:     this.#color.b = color[2] * k;
330:   }
331: 
332:   /** @internal Driven by `tickLightSources`. */
333:   tick(dt: number): void {
334:     if (this.#dead) return;
335: 
336:     const { recipe, position } = this;
337:     const anchor = this.#anchor;
338: 
339:     this.#age += dt;
340: 
341:     if (anchor.travel) {
342:       const { to, speed } = anchor.travel;
343:       const dx = to.x - position.x;
344:       const dy = to.y - position.y;
345:       const dz = to.z - position.z;
346:       const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
347:       const step = speed * dt;
348: 
349:       if (dist <= Math.max(step, ARRIVE_EPSILON)) {
350:         position.x = to.x;
351:         position.y = to.y;
352:         position.z = to.z;
353: 
354:         if (this.#stoppedAt === null) {
355:           this.#stoppedAt = this.#age;
356:           anchor.travel.onArrive?.();
357:         }
358:       } else {
359:         const k = step / dist;
360: 
361:         position.x += dx * k;
362:         position.y += dy * k;
363:         position.z += dz * k;
364:       }
365:     } else if (anchor.follow) {
366:       anchor.follow(position);
367:     }
368: 
369:     if (recipe.flicker) {
370:       const f = recipe.flicker;
371:       const step = Math.floor(Math.random() * f.steps);
372:       const target =
373:         f.min + (step * (f.max - f.min)) / Math.max(1, f.steps - 1);
374: 
375:       this.#lumi +=
376:         (target - this.#lumi) * (recipe.flickerSmoothing ?? FLICKER_SMOOTHING);
377:     } else if (recipe.pulse) {
378:       const p = recipe.pulse;
379: 
380:       this.#lumi =
381:         (Math.sin((this.#age * 1000 + (p.phase ?? 0)) * p.speed) + 1) *
382:           p.amount +
383:         p.base;
384:     }
385: 
386:     const e = this.#envelope();
387: 
388:     this.#write(e);
389: 
390:     const seconds = recipe.seconds ?? Infinity;
391:     const ended =
392:       (Number.isFinite(seconds) && this.#age >= seconds) ||
393:       (this.#stoppedAt !== null && e <= 0);
394: 
395:     if (ended) this.dispose();
396:   }
397: }
398: 
399: // ---- readers / lifecycle (called by the facade) ----------------------------
400: 
401: /** Every source alive right now, across all entries. */
402: export function liveLightSources(): ReadonlySet<LightSource> {
403:   return live;
404: }
405: 
406: /** Step every source. The facade calls this before the entries' `update`. */
407: export function tickLightSources(dt: number): void {
408:   for (const source of live) source.tick(dt);
409: }
410: 
411: /**
412:  * Everything, now. A map load rebuilds the terrain light field underneath
413:  * every registration; sources must not outlive the field they registered in.
414:  */
415: export function disposeAllLightSources(): void {
416:   for (const source of Array.from(live)) source.dispose();
417:   live.clear();
418: }
</file>

<file path="src/lighting/lightTint.ts">
 1: import { devQueryNumber } from '../common/devSeams';
 2: import { lightingTier } from '../common/lightingQuality';
 3: 
 4: /**
 5:  * Coloured light bleeding into what it touches (sky_atmospherics
 6:  * ARCHITECTURE §2). A pure multiply moves level, not hue: a torch beside a
 7:  * blue tile reads as nothing. This pulls a lit surface toward the
 8:  * illuminant's hue at its luminance, so the stone by a fire goes warm and
 9:  * the fire's colour is in the scene rather than only in the sprite.
10:  *
11:  * Three properties keep it off every level gate and out of Classic:
12:  * a neutral light has no chroma so it tints nothing (the key is neutral by
13:  * lighting_polish §4 principle 4, which makes the weight the coloured
14:  * emitters' share of the sum without a second term); the result carries the
15:  * input's luma exactly; and the strength is one scalar that is 0 on Classic.
16:  */
17: 
18: /** Rec709 luma, the one place the weights are written. */
19: export const LUMA_GLSL = 'vec3(0.2126, 0.7152, 0.0722)';
20: 
21: /** How wide in chroma a light must be to earn the full weight (1/1.6 = 0.63). */
22: const TINT_CHROMA = 1.6;
23: 
24: /** The pull at full chroma. A MU torch is about 0.45 wide, so it takes 0.72 of it. */
25: const TINT_STRENGTH = 0.35;
26: 
27: export const LIGHT_TINT_UNIFORM = 'muTint';
28: 
29: const tintDev = devQueryNumber('tint');
30: 
31: /** 0 on Classic and with the seam off: the shader function returns its argument. */
32: export function lightTintStrength(): number {
33:   if (tintDev !== null) return Math.max(0, tintDev);
34: 
35:   return lightingTier() ? TINT_STRENGTH : 0;
36: }
37: 
38: /**
39:  * `vec3 muLightTint(vec3 lit, vec3 light)` plus the uniform it reads. The
40:  * caller declares `${LIGHT_TINT_UNIFORM}` itself: the terrain lists it among
41:  * its uniforms, the item materials add it through `AddUniform`.
42:  */
43: export function lightTintGlsl(): string {
44:   return `
45:   vec3 muLightTint(vec3 lit, vec3 light) {
46:     float lum = dot(light, ${LUMA_GLSL});
47:     if (${LIGHT_TINT_UNIFORM} <= 0.0 || lum <= 1e-4) return lit;
48: 
49:     vec3 hue = light / lum;
50:     float chroma = max(hue.r, max(hue.g, hue.b)) - min(hue.r, min(hue.g, hue.b));
51:     float w = min(chroma * ${TINT_CHROMA.toFixed(2)}, 1.0) * ${LIGHT_TINT_UNIFORM};
52: 
53:     return mix(lit, dot(lit, ${LUMA_GLSL}) * hue, w);
54:   }
55: `;
56: }
</file>

