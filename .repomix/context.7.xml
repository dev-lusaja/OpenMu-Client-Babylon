 846: /** The per-frame uniforms the overlay path adds: one coverage float per layer. */
 847: export function terrainOverlayUniforms(
 848:   overlays: readonly TerrainOverlay[]
 849: ): string[] {
 850:   const names = overlays.map((_, i) => `ovCoverage${i}`);
 851: 
 852:   // The fire skills' melt patches. Not under `hasRelief`: melting is about a
 853:   // layer's coverage, and a flat layer that declared it would need it too.
 854:   if (hasMelt(overlays)) names.push('ovMeltSpot');
 855: 
 856:   // Only when something actually has a surface. A map with no relief layer
 857:   // keeps the uniform list it had, which keeps the promise at the top of this
 858:   // file that an unchanged map gets an unchanged shader.
 859:   //
 860:   // `cameraPosition` is on the list because ShaderMaterial binds it only if
 861:   // it is asked for by name; the sheen term needs a view direction.
 862:   if (hasRelief(overlays)) {
 863:     names.push('ovSunDir', 'ovShade', 'ovGrain', 'cameraPosition');
 864:     if (hasTrail(overlays)) names.push('ovTrailOn');
 865:   }
 866: 
 867:   // Standing water: the same sun and camera, plus the sky colour, the
 868:   // ripple strength and the torch pool.
 869:   if (hasReflect(overlays)) {
 870:     if (!hasRelief(overlays)) names.push('ovSunDir', 'cameraPosition');
 871:     names.push(
 872:       'ovSky',
 873:       'ovSkyHi',
 874:       'ovRipple',
 875:       'ovRain',
 876:       'ovLightPos',
 877:       'ovLightCol'
 878:     );
 879:   }
 880: 
 881:   return names;
 882: }
