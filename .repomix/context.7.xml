100: function createObjects(world: World, objs: MapObjectRecord[]) {
101:   const batching = propBatchingActive();
102: 
103:   for (const data of objs) {
104:     // CreateObject (ZzzObject.cpp:4433-4435) discards records outside the
105:     // 16×16 block grid (1600 MU units per block).
106:     const blockX = Math.floor(data.pos.x / 1600);
107:     const blockY = Math.floor(data.pos.y / 1600);
108:     if (blockX < 0 || blockX >= 16 || blockY < 0 || blockY >= 16) continue;
109:     // NaN coordinates (two Devias gate records) pass the range test above and
110:     // would otherwise become entities with a NaN position.
111:     if (!Number.isFinite(blockX) || !Number.isFinite(blockY)) continue;
112: 
113:     // AngleMatrix is Rz·Ry·Rx in a Z-up right-handed frame; our model-root
114:     // mirror means every axis is negated on the way in. Pitch/roll are
115:     // negated here, yaw stays MU-positive and is flipped by toRenderAngles
116:     // (see common/renderAngles.ts). Previously only yaw was negated, which
117:     // mirrored every tilted object (fences, signs, rocks, ramps).
118:     const angles = new Vector3(
119:       -toRadians(data.rot.x),
120:       toRadians(data.rot.z),
121:       -toRadians(data.rot.y)
122:     );
123: 
124:     const pos = new Vector3(
125:       data.pos.x / world.terrainScale,
126:       data.pos.z / world.terrainScale,
127:       data.pos.y / world.terrainScale
128:     );
129: 
130:     const modelFactory = world.terrain!.MapTileObjects[data.id] || MapTileObject;
131: 
132:     // Scenery the batches can draw gets no model factory and no visibility
133:     // radius: the per-object systems never see it (common/propBatches.ts).
134:     if (batching && propBatchExclusion(world, data.id, modelFactory) === null) {
135:       // A lit type keeps the per-object path for its light alone: a
136:       // `LightCarrier` (no model) under the same radius and loader, so the
137:       // lamp comes and goes with the hero exactly as it did.
138:       const carrier = propTypeCarriesLight(world, data.id)
139:         ? {
140:             modelFactory: LightCarrier,
141:             visibility: {
142:               state: 'hidden' as const,
143:               lastChecked: Math.random() * 0.2,
144:             },
145:           }
146:         : {};
147: 
148:       const entity = world.add({
149:         worldIndex: world.mapIndex,
150:         transform: {
151:           pos,
152:           rot: angles,
153:           scale: data.scale,
154:         },
155:         modelId: data.id,
156:         propBatch: { type: data.id, chunk: 0 },
157:         ...carrier,
158:       });
159: 
160:       addPropToBatch(world, entity, modelFactory);
161:       continue;
162:     }
163: 
164:     world.add({
165:       worldIndex: world.mapIndex,
166:       transform: {
167:         pos,
168:         rot: angles,
169:         scale: data.scale,
170:       },
171:       modelId: data.id,
172:       modelFactory,
173:       visibility: {
174:         state: 'hidden',
175:         // Spread over the first 0.2 s so the 9 000 distance checks - and the
176:         // model instantiations they trigger - do not all land in one frame,
177:         // and stay staggered afterwards (CalculateVisibilitySystem re-arms
178:         // each entity relative to its own check).
179:         lastChecked: Math.random() * 0.2,
180:       },
181:     });
182:   }
183: }
