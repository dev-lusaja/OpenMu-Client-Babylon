391: /** A lit interior inside a map: what it changes over the map's own profile. */
392: export type AreaLook = {
393:   /**
394:    * The room's level in key units, where 1.0 is the bake at its authored
395:    * value (§13 F14). It scales the rig, the ground bake and the room's
396:    * emitters together, so the room keeps the bake's own colour under its
397:    * candles instead of drowning in the delta at the map's outdoor level.
398:    */
399:   readonly keyLevel: number;
400:   readonly whiteBalance: Rgb;
401:   /** How much more than the room's own level its emitters get; 1 is Classic. */
402:   readonly candles: number;
403:   /** The room's key direction: near vertical, a low share, contact grounding only. */
404:   readonly sun: SunSpec;
405: };
406: 
407: /** A room's floor in tiles, between the inner wall faces: the mask's frame and the roof lift's seed. */
408: export type AreaRect = {
409:   readonly minX: number;
410:   readonly minY: number;
411:   readonly maxX: number;
412:   readonly maxY: number;
413: };
414: 
415: /** The floor with its heights: what the room mask draws inside of (§13 F8). */
416: export type RoomVolume = AreaRect & {
417:   /** Height the walls stand at. */
418:   readonly floorY: number;
419:   /** Top of the walls: a ray through the wall box below this height sees through an opening. */
420:   readonly wallTop: number;
421:   /** Underside of the roof: the room volume's ceiling. */
422:   readonly roofY: number;
423: };
424: 
425: export function roomVolumeOf(
426:   min: { x: number; y: number },
427:   max: { x: number; y: number },
428:   heights: { floorY: number; wallHeight: number; roofHeight: number }
429: ): RoomVolume {
430:   return {
431:     minX: min.x,
432:     minY: min.y,
433:     maxX: max.x,
434:     maxY: max.y,
435:     floorY: heights.floorY,
436:     wallTop: heights.floorY + heights.wallHeight,
437:     roofY: heights.floorY + heights.roofHeight,
438:   };
439: }
440: 
441: /**
442:  * The room's key is cast from near vertical so the furniture's shadow is
443:  * contact grounding, at a share the eye reads as occlusion rather than a sun
444:  * (§13 F14).
445:  */
446: const ROOM_SUN = sun(0, 80, 0.3);
447: 
448: const WARM_ROOM: Rgb = [1.03, 1.0, 0.96];
449: 
450: const room = (keyLevel: number, candles: number): AreaLook => ({
451:   keyLevel,
452:   whiteBalance: WARM_ROOM,
453:   candles,
454:   sun: ROOM_SUN,
455: });
