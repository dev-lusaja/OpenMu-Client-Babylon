407:     return s.isPlaying;
408:   }
409: 
410:   /** Whether a music key was created looping and is sounding. */
411:   static isLooping(key: Sounds): boolean {
412:     const s = sounds.get(key);
413:     return !!s && s.isPlaying && s.loop;
414:   }
415: 
416:   /**
417:    * The two track gains, 0…1, master already folded in (`sound/buses.ts`).
418:    * The one writer of `SoundTrack.setVolume`; `sound/index.ts` calls it
419:    * whenever an option changes, and nothing else may.
420:    */
421:   static setTrackGains(music: number, effects: number) {
422:     this.musicVolume = music;
423:     this.effectsVolume = effects;
424:     this.syncTrackGains();
425:   }
426: 
427:   /**
428:    * The page went away or came back. Ramps both tracks rather than cutting
429:    * them, and never unlocks audio on its own: a tab that was never clicked
