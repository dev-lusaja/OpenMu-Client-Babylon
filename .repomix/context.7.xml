 44: /** Bumped per warp request; a load whose serial is stale abandons its work. */
 45: let warpSerial = 0;
 46: 
 47: /**
 48:  * A warp the server ordered has already moved the character on its side, so a
 49:  * load that fails cannot simply be dropped: the client would keep standing on
 50:  * the map it was told to leave while every object the server sends belongs to
 51:  * the new one. Leaving Chaos Castle is the case that shows it - the arena has
 52:  * collapsed by then, so what is left on screen is an empty floor. These are
 53:  * the delays before each further attempt.
 54:  */
 55: const WARP_RETRY_DELAYS_MS = [400, 1200, 3000] as const;
 56: 
 57: /**
 58:  * The map whose terrain and entities are actually in the scene - the map the
 59:  * next load has to tear down. `world.mapIndex` is the newest destination and
 60:  * runs ahead of this while a load is in flight.
 61:  */
 62: let sceneMap = ENUM_WORLD.WD_55LOGINSCENE;
 63: 
 64: /**
 65:  * Loads run strictly one at a time. Two warps used to run concurrently (a
 66:  * second `MapChanged` while the first was still downloading): the second
 67:  * computed its "old map" from the optimistic `world.mapIndex`, so the map
 68:  * really on screen was never unloaded, and the first load finished anyway,
 69:  * overwriting the terrain and tagging its objects with the wrong map.
 70:  */
 71: let loadQueue: Promise<void> = Promise.resolve();
 72: 
 73: /** The records of the map on screen, kept for `reloadMapObjects`. */
 74: let sceneObjects: MapObjectRecord[] = [];
 75: let sceneWorld: World | null = null;
 76: 
 77: type MapObjectRecord = {
 78:   id: number;
 79:   pos: IVector3Like;
 80:   rot: IVector3Like;
 81:   scale: number;
 82: };
 83: 
 84: /**
 85:  * The map's own setup: the look director takes the map (its profile, and
 86:  * with it the clear colour - `SetWorldClearColor` bytes on Classic,
 87:  * SceneManager.cpp:336-365), then the entry's `create` - which binds the
 88:  * map's object classes into `MapTileObjects` and adds whatever entities the
 89:  * map owns. Every per-map decision lives on the entry
 90:  * (`src/maps/<name>/index.ts`); nothing here tests the world number.
 91:  */
 92: async function loadWorld(world: World) {
 93:   if (!world.terrain) return;
 94: 
 95:   lookDirector()?.setMap(world.mapIndex);
 96: 
 97:   await maps.create(world);
 98: }
