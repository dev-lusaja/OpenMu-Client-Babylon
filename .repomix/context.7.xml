1055: 
1056: 
1057:   /**
1058:    * How much of this tile is drawn as grass, and which slot the blades take
1059:    * their colour from.
1060:    *
1061:    * The two have to be decided together. Picking the weight from either
1062:    * layer and the slot from the layer the *mesh* happens to draw as its base
1063:    * gives a tile whose grass is painted over sand a blade tinted sand - the
1064:    * blade is standing there precisely because of the other layer. So the
1065:    * slot is whichever grass layer put most of the weight there.
1066:    */
1067:   function grassAt(
1068:     x: number,
1069:     y: number,
1070:     out: { weight: number; slot: number }
1071:   ): void {
1072:     out.weight = 0;
1073:     out.slot = 0;
1074: 
1075:     // Before any of the original's rules: is there ground here at all?
1076:     //
1077:     // `CreateGroundFromHeightMap` drops a `NoGround` tile's four corners to
1078:     // -10000, which takes the quad out of sight; the height *array* it reads
1079:     // is untouched. Sampling that array, as `heightAt` does, put blades at
1080:     // the nominal height of tiles whose ground had been taken away - grass
1081:     // hanging in the air over Devias' precipices. Same flag, same index, same
1082:     // answer as the mesh (customGroundMesh.ts:96).
1083:     if (isFlagInBinaryMask(src.attributes[TERRAIN_INDEX(x, y)], TWFlags.NoGround)) {
1084:       return;
1085:     }
1086: 
1087:     // The same question of the tile mapping. A map with an `AlphaTile*` slot
1088:     // has its ground cut out wherever layer 1 names that slot
1089:     // (`MapLayer.cutoutTile`), and the original grows grass there all the
1090:     // same: its grass pass reads `TerrainMappingLayer1` and never asks what
1091:     // the tile drew (ZzzLodTerrain.cpp:1611-1625). On Elbeland that is 298
1092:     // tiles of bridge span, and blades standing in the gap between the planks
1093:     // are the same mistake as blades over a precipice.
1094:     if (src.cutout !== null && src.layer1[TERRAIN_INDEX(x, y)] === src.cutout) {
1095:       return;
1096:     }
1097: 
1098:     // The original's rule, in its own order (ZzzLodTerrain.cpp:1611-1625).
1099:     //
1100:     // 1. Any alpha painted on any of the four corners and the tile is skipped
1101:     //    outright - grass grows only on a tile that is one layer all the way
1102:     //    through, so a blend is where it stops. Not a fade: a hard edge, and
1103:     //    that is what the original looks like.
1104:     const i = TERRAIN_INDEX(x, y);
1105: 
1106:     if (
1107:       src.alpha[i] > 0 ||
1108:       src.alpha[TERRAIN_INDEX(x + 1, y)] > 0 ||
1109:       src.alpha[TERRAIN_INDEX(x, y + 1)] > 0 ||
1110:       src.alpha[TERRAIN_INDEX(x + 1, y + 1)] > 0
1111:     ) {
1112:       return;
1113:     }
1114: 
1115:     // 2. Layer 1 - never layer 2 - indexes the card set, and the card has to
1116:     //    exist. `cards.slots` is that `FindTexture` null check.
1117:     const slot = src.layer1[i];
1118: 
1119:     if (!src.cards.slots.has(slot)) return;
1120: 
1121:     out.weight = 1;
1122:     out.slot = slot;
1123:   }
1124: 
1125:   function heightAt(fx: number, fz: number): number {
1126:     const xi = Math.floor(fx);
1127:     const zi = Math.floor(fz);
1128:     const dx = fx - xi;
1129:     const dz = fz - zi;
1130: 
1131:     const h1 = src.height[TERRAIN_INDEX(xi, zi)];
1132:     const h2 = src.height[TERRAIN_INDEX(xi + 1, zi)];
1133:     const h3 = src.height[TERRAIN_INDEX(xi, zi + 1)];
1134:     const h4 = src.height[TERRAIN_INDEX(xi + 1, zi + 1)];
1135: 
1136:     return (
1137:       h1 * (1 - dx) * (1 - dz) +
1138:       h2 * dx * (1 - dz) +
1139:       h3 * (1 - dx) * dz +
1140:       h4 * dx * dz
1141:     );
1142:   }
1143: 
1144:   /**
1145:    * The blade's bake, from the same array the ground mesh's own vertex
1146:    * colours come from (`unpackTerrainLight`) - one source, sampled twice,
1147:    * rather than a second opinion about what the bake says.
1148:    */
1149:   function bakeAt(x: number, y: number, out: [number, number, number]): void {
1150:     const c = src.light[TERRAIN_INDEX(x, y)];
1151: 
1152:     out[0] = c.x;
1153:     out[1] = c.y;
1154:     out[2] = c.z;
