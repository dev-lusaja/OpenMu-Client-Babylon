120:   function handlePacketsQueue() {
121:     while (bytes.length > 0) {
122:       const packetType = bytes[0];
123: 
124:       if (!HEADERS.has(packetType)) {
125:         // Not a header byte: drop it and rescan, so garbage can't jam the queue.
126:         console.error(`${LOG_PREFIX}NOT_MU_PACKET: 0x${byteToString(packetType)}`);
127:         bytes = bytes.subarray(1);
128:         continue;
129:       }
130: 
131:       const packetHeaderSize = getSizeOfPacketType(packetType);
132: 
133:       // Wait for the full header, then the full packet, before parsing.
134:       if (bytes.length < packetHeaderSize + 1) return;
135: 
136:       const length = getPacketSize(bytes);
137: 
138:       if (length < packetHeaderSize + 1) {
139:         console.error(`${LOG_PREFIX}bad packet length ${length}, resyncing`);
140:         bytes = bytes.subarray(1);
141:         continue;
142:       }
143: 
144:       if (bytes.length < length) return;
145: 
146:       // Copy: generated packet classes slice the raw buffer with view-relative
147:       // indices, so their DataView must start at byteOffset 0.
148:       let packet = new DataView(
149:         bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + length)
150:       );
151:       DEBUG_LOG && console.log(`${LOG_PREFIX}Try to find packet 0x${byteToString(packetType)}, lng: ${length}`);
