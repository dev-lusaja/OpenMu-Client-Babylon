1324:         actorSlots[i] = x;
1325:         actorSlots[i + 1] = z;
1326:         actorSlots[i + 2] = flying ? FLIER_RADIUS : ACTOR_RADIUS;
1327:         actorSlots[i + 3] = (flying ? -FLIER_PUSH : TRAMPLE_PUSH) * strength;
