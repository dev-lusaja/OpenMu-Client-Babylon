255:       //    plus the 0.72 one at 238.5/194.5) already have the mass at full
256:       //    size, so one a tick is enough and the second only burned fill
257:       //    rate. They spend it on wider, more frequent smoke instead -
258:       //    that is what reads at distance against snow.
259:       emissions: scale =>
260:         scale < DEVIAS_HEARTH_SCALE
261:           ? [
262:               { kinds: ['fire0', 'fire0b'], every: 1, count: 2, jitter: 10 },
263:               { kinds: ['smoke0'], every: 5, jitter: 10, scale: 1.4 },
264:             ]
265:           : [
266:               { kinds: ['fire0', 'fire0b'], every: 1, count: 1, jitter: 16 },
267:               { kinds: ['smoke0'], every: 3, jitter: 18, scale: 1.9 },
268:             ],
269:     },
