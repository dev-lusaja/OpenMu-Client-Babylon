501: /** The map's profile with an area laid over it: no sky, no haze, its own balance and key direction; the map's ev stays. */
502: export function applyArea(base: LookProfile, area: AreaLook): LookProfile {
503:   return {
504:     ...base,
505:     whiteBalance: area.whiteBalance,
506:     sky: null,
507:     fog: NO_FOG,
508:     sun: area.sun,
509:   };
510: }
511: 
512: const DEG = Math.PI / 180;
513: 
514: /** Unit direction the light travels, Babylon Y-up, from azimuth / elevation. */
515: export function sunDirectionOf(sun: LookProfile['sun']): [number, number, number] {
516:   const az = sun.azimuthDeg * DEG;
517:   const el = sun.elevationDeg * DEG;
518:   const c = Math.cos(el);
519: 
520:   return [-Math.sin(az) * c, -Math.sin(el), -Math.cos(az) * c];
521: }
522: 
523: /** sRGB display value to linear, per channel. */
524: export function toLinear(c: Rgb): [number, number, number] {
525:   return [c[0] ** 2.2, c[1] ** 2.2, c[2] ** 2.2];
526: }
527: 
528: /**
529:  * An event's modifier over whatever map and area are already resolved. An
530:  * area *replaces* a profile (`applyArea`); an omen only scales it, so the two
531:  * compose instead of fighting and the map keeps its own look underneath.
532:  */
533: export type OmenLook = {
534:   /** Multiplier on the lit scene's level (`LookState.key.sceneGain`). */
535:   readonly dim: number;
536:   /** Composed over the map's balance, then clamped back into range. */
537:   readonly whiteBalance: Rgb;
538: };
539: 
540: export const NO_OMEN: OmenLook = { dim: 1, whiteBalance: [1, 1, 1] };
541: 
542: /**
543:  * A dragon invasion. The original subtracts `(0.3, 0.3, 0.2)` from the terrain
544:  * light in a 16-tile disc around the hero for as long as the event is lit
545:  * (GOBoid.cpp:1221-1222): on a mid bake of 0.75 that leaves 0.6 of the level,
546:  * and it takes more red and green than blue, so what is left is colder than
547:  * what went in. Both numbers are that subtraction, expressed as a scale
548:  * because the clone's light has one.
549:  */
550: const INVASION: OmenLook = {
551:   dim: 0.6,
552:   whiteBalance: [0.97, 0.99, 1.05],
553: };
554: 
555: const OMENS = {
556:   invasion: INVASION,
557: } satisfies Record<string, OmenLook>;
558: 
559: export type OmenLookName = keyof typeof OMENS;
560: 
561: export function omenProfile(name: OmenLookName): OmenLook {
562:   return OMENS[name];
563: }
564: 
565: /** The balance range the profile type promises, per channel. */
566: const BALANCE_MIN = 0.94;
567: const BALANCE_MAX = 1.06;
568: 
569: /** The map's balance with an omen's laid over it, kept inside the range. */
570: export function composeBalance(base: Rgb, omen: Rgb): Rgb {
571:   return [
572:     Math.min(BALANCE_MAX, Math.max(BALANCE_MIN, base[0] * omen[0])),
573:     Math.min(BALANCE_MAX, Math.max(BALANCE_MIN, base[1] * omen[1])),
574:     Math.min(BALANCE_MAX, Math.max(BALANCE_MIN, base[2] * omen[2])),
575:   ];
576: }
