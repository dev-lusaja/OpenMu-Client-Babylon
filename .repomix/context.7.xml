 985: /**
 986:  * The one hash. `sin`-based rather than a bit mixer because the same value
 987:  * has to be reproducible in the vertex shader from the fraction stored in
 988:  * `iRoot.w`, and because it only has to look unstructured, not be uniform.
 989:  */
 990: function hash01(x: number, y: number, i: number): number {
 991:   const s = Math.sin(x * 127.1 + y * 311.7 + i * 74.7) * 43758.5453;
 992: 
 993:   return s - Math.floor(s);
 994: }
