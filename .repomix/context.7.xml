168:     if (this.effectsTrack) {
169:       this.effectsTrack.dispose();
170:     }
171:     this.effectsTrack = new SoundTrack(scene, { volume: this.effectsVolume });
172:     this.syncTrackGains();
173: 
174:     if (
175:       Engine.audioEngine &&
176:       Engine.audioEngine.onAudioUnlockedObservable &&
177:       !this.pageInteracted
