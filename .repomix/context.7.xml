  2: import { ConnectServerPackets, ServerToClientPackets, SimpleModulusDecryptor, SimpleModulusKeys } from "../../common";
  3: import { gameVersion } from "../../version";
  4: import { byteToString, getPacketSize, getSizeOfPacketType } from "../../common/utils";
  5: import { sessionNonce } from "../../common/sessionNonce";
  6: 
  7: type Options = {
  8:   wsAddress: string;
  9:   tcpIP: string;
 10:   tcpPort: number;
 11: };
 12: 
 13: const STCPackets = [...ConnectServerPackets, ...ServerToClientPackets].filter(p => p.Direction === 'ServerToClient');
 14: 
 15: const packetsCacheByCode: (typeof STCPackets)[] = [];
 16: 
 17: STCPackets.forEach(p => {
 18:   const code = p.Code;
 19: 
 20:   if (packetsCacheByCode[code] == null) {
 21:     packetsCacheByCode[code] = [p];
 22:   } else {
 23:     packetsCacheByCode[code].push(p);
 24:   }
 25: });
 26: 
 27: /**
 28:  * Several packets share a code with no sub-code and a variable length (e.g.
 29:  * 0x12 AddCharactersToScope / …075 / …095 / AddCharacterToScopeExtended), so
 30:  * they cannot be told apart from the header. The server picks the variant by
 31:  * the client version we log in with (OpenMU `MinimumClient`): the classic
 32:  * Season 6 layout. Prefer it over the old-version (075/095) and the
 33:  * "extended" (client >= 106.3) variants, whatever the generated order.
 34:  */
 35: function variantRank(p: (typeof STCPackets)[number]): number {
 36:   // The rank is the game version's (`gameVersion.protocol.variantRank`).
 37:   return gameVersion.protocol.variantRank(p.Name);
 38: }
 39: 
 40: /** Server → client SimpleModulus keys of the game version we speak. */
 41: const SERVER_TO_CLIENT_KEYS = SimpleModulusKeys.CreateDecryptionKeys([
 42:   ...gameVersion.protocol.encryption.serverToClient,
 43: ]);
 44: 
 45: packetsCacheByCode.forEach(list => {
 46:   list?.sort((a, b) => variantRank(a) - variantRank(b));
 47: });
 48: 
 49: /**
 50:  * ChatMessage (C1, code 0x00) keeps its `ChatMessageType` in the code byte
 51:  * itself (field index 2): OpenMU writes `Whisper` = 0x02 there
 52:  * (`ChatMessageRef.Type`, GameServer/RemoteView/ChatViewPlugIn.cs), so an
 53:  * inbound whisper arrives as "code 0x02", which no generated class claims.
 54:  * Route it to the same parser; logic.ts reads `p.Type` off that byte and
 55:  * colours the line as a whisper. OpenMU emits only Normal (0x00) and Whisper
 56:  * (0x02) - party / guild / alliance lines are Normal with a text prefix.
 57:  */
 58: const WHISPER_CHAT_CODE = 0x02;
 59: const chatMessageDef = STCPackets.find(p => p.Name === 'ChatMessage');
 60: if (
 61:   chatMessageDef &&
 62:   !packetsCacheByCode[WHISPER_CHAT_CODE]?.some(p => p.Name === 'ChatMessage')
 63: ) {
 64:   // In front: the ConnectServer's PatchVersionOkay is also code 0x02 with no
 65:   // sub-code, and the dispatcher's last fallback takes the first such entry.
 66:   // On the game server a 0x02 is always the whisper.
 67:   (packetsCacheByCode[WHISPER_CHAT_CODE] ??= []).unshift(chatMessageDef);
 68: }
 69: 
 70: const HEADERS = new Set<number>([0xc1, 0xc2, 0xc3, 0xc4]);
 71: 
 72: const DEBUG_LOG = false;
 73: const INFO_LOG = false;
