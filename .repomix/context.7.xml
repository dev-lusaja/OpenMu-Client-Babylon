 1: import type { ENUM_WORLD } from '../common/types';
 2: import type { LightSource } from './lightSource';
 3: 
 4: /**
 5:  * The contract every lighting entry implements. One file per entry, one
 6:  * exported `LightingLayer` per file, listed once in `layers.ts`. Copy `_template.ts` for the recipe.
 7:  *
 8:  * The common core (`name`, `maps?`, `update?`, `reset?`) is spelled exactly as
 9:  * in every other system . Lighting adds one reader:
10:  * `emitters?(map)` - the light sources the entry currently has alive, so the
11:  * facade, the perf overlay and tooling can see what is lighting the map from
12:  * one call. Registration into the two sinks (the terrain delta texture and
13:  * the point-light pool) is done by `LightSource` itself; entries never talk
14:  * to the sinks directly.
15:  */
16: export interface LightingLayer {
17:   /** Unique camelCase, identical to the file name. */
18:   readonly name: string;
19: 
20:   /**
21:    * Maps this entry exists on. Omit for "every map". Informational for the
22:    * facade today; used by `lighting.layersFor(map)` and tooling.
23:    */
24:   readonly maps?: ReadonlySet<ENUM_WORLD>;
25: 
26:   /**
27:    * Once a frame, in `layers.ts` order, before anything reads the lighting.
28:    * `dt` is seconds. Must be cheap: no allocation, no scene walk. The shared
29:    * `LightSource` tick (envelopes, travel, tile re-registration) runs before
30:    * the entries, from the facade.
31:    */
32:   update?(map: ENUM_WORLD, dt: number): void;
33: 
34:   /**
35:    * The map changed. Drop everything belonging to the world just left -
36:    * every source this entry attached is already disposed by the facade
37:    * (`disposeAllLightSources`), so this only has to forget its handles.
38:    */
39:   reset?(): void;
40: 
41:   /** What this entry is lighting right now. Read-only; do not mutate. */
42:   emitters?(map: ENUM_WORLD): readonly LightSource[];
43: }
</file>

