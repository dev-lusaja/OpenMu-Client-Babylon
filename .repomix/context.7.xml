192: export async function getTerrainData(
193:   world: World,
194:   map: ENUM_WORLD,
195:   prepared?: PreparedTerrain
196: ) {
197:   const scene = world.scene;
198:   const {
199:     worldNum,
200:     bulk,
201:     terrainLight,
202:     terrainTextures,
203:     tileArray,
204:     waterSpec,
205:     waterFrames,
206:     grassCards,
207:   } = prepared ?? (await prepareTerrain(scene, map));
208: 
209:   const terrainHeight = bulk.height;
210:   const terrainAttrs = bulk.attributes;
211:   const terrainMapping = {
212:     layer1: bulk.layer1,
213:     layer2: bulk.layer2,
214:     alpha: bulk.alpha,
215:   };
216:   const objects = bulk.objects;
217: 
218:   updateTerrainHeightMap(scene, terrainHeight);
219: 
220:   const terrain = CreateGroundFromHeightMap(
221:     '_world_' + worldNum,
222:     scene,
223:     terrainHeight,
224:     terrainMapping.layer1,
225:     terrainMapping.layer2,
226:     terrainMapping.alpha,
227:     terrainLight,
228:     terrainAttrs,
229:     Vector3.One().setAll(TERRAIN_AMBIENT)
230:   );
231:   terrain.isPickable = true;
232: 
233:   // Click-to-move, the cursor sampler and the right-click ground pick all
234:   // ray-cast against this mesh, several times a second while a button is
235:   // held. Without an octree `Mesh.intersects` walks every one of its 131 072
236:   // triangles per pick; with one it descends to a handful of blocks.
237:   terrain.createOrUpdateSubmeshesOctree(64, 4);
238: 
239:   terrain.metadata = {
240:     terrain: true,
241:   };
242: 
243:   const texturesData = terrainTextures.map(texture => {
244:     const size = texture.getSize().height;
245:     let scale = size;
246:     if (scale === 256) {
247:       scale /= 4;
248:     }
249:     return { texture, scale };
250:   });
251: 
252:   terrain.material = createTerrainMaterial(
253:     scene,
254:     { name: 'TerrainMaterial' },
255:     {
256:       texturesData,
257:       tileArray,
258:       // Ground-contact weather for this map: wet stone and puddles on
259:       // Lorencia and Noria, settled snow on Devias. Empty everywhere else,
260:       // and the shader is then exactly what it always was.
261:       overlays: terrainOverlaysFor(map),
262:       // The `AlphaTile*` slot, where this map has one: those tiles are a hole
263:       // in the ground, not a texture. Null everywhere else, and the shader is
264:       // then exactly what it always was.
265:       cutout: maps.cutoutTileFor(map),
266:       // Animated water: Atlans' wave deformation and caustics flipbook.
267:       water: waterSpec
268:         ? createTerrainWaterRuntime(waterSpec, waterFrames)
269:         : null,
270:     }
271:   );
272: 
273:   // The world's outer frame: the ground carried past the last tile row, so
274:   // the map ends in a coast instead of a cut (terrainEdge.ts). It shares this
275:   // material, which is what keeps the sea outside the map in step with the
276:   // sea inside it. Classic draws none of it, the way it draws no sky dome.
277:   if (lightingTier()) {
278:     const edge = createTerrainEdge('_worldEdge_' + worldNum, scene, {
279:       height: terrainHeight,
280:       layer1: terrainMapping.layer1,
281:       layer2: terrainMapping.layer2,
282:       alpha: terrainMapping.alpha,
283:       light: terrainLight,
284:       ambient: Vector3.One().setAll(TERRAIN_AMBIENT),
285:     });
286: 
287:     if (edge) {
288:       edge.material = terrain.material;
289:       edge.renderingGroupId = terrain.renderingGroupId;
290:       // Goes with the ground it frames. Its own dispose leaves the material
291:       // alone: the two share one, and the teardown already disposes it.
292:       terrain.onDisposeObservable.addOnce(() => edge.dispose(false, false));
293:     }
294:   }
295: 
296:   // The grass layer stands on this ground and is lit by it (terrainGrass.ts).
297:   // Built from the same arrays the mesh above was: the splat says which tiles
298:   // grow anything, the height array where the roots sit, `terrainLight` what
299:   // the bake says, and the cards which slots have grass at all and what
300:   // colour it is. A map that ships no card builds nothing, and neither does
301:   // density 0.
302:   installGrassField(scene, map, {
303:     layer1: terrainMapping.layer1,
304:     layer2: terrainMapping.layer2,
305:     alpha: terrainMapping.alpha,
306:     attributes: terrainAttrs,
307:     height: terrainHeight,
308:     light: terrainLight,
309:     cards: grassCards,
310:   });
311: 
312:   if (DEBUG_SHOW_TERRAIN_ATTRIBUTES) {
313:     const plane = CreatePlane('_terrainPlane', { size: 256 }, scene);
314:     plane.isPickable = false;
315:     plane.position.set(128 + 0.5, 128 - 0.5, 1.68);
316:     plane.rotationQuaternion = null;
317:     plane.rotation.y = Math.PI;
318:     const planeMat = new StandardMaterial('_terrainPlaneMat', scene);
319:     planeMat.disableLighting = true;
320:     planeMat.specularColor.set(0, 0, 0);
321:     plane.material = planeMat;
322:     const pixels = new Uint8Array(256 * 256 * 4);
323:     for (let i = 0; i < TERRAIN_SIZE; i++) {
324:       for (let j = 0; j < TERRAIN_SIZE; j++) {
325:         const ind = i * TERRAIN_SIZE + j;
326: 
327:         const index =
328:           ((TERRAIN_SIZE - i) * TERRAIN_SIZE + (TERRAIN_SIZE - j)) * 4;
329: 
330:         const attr = terrainAttrs[ind];
331:         pixels[index + 0] = attr & TWFlags.NoMove ? 255 : 0;
332:         pixels[index + 1] = attr & TWFlags.SafeZone ? 255 : 0;
333:       }
334:     }
335: 
336:     planeMat.transparencyMode = 2;
337:     planeMat.alpha = 0.5;
338:     planeMat.emissiveTexture = RawTexture.CreateRGBATexture(
339:       pixels,
340:       256,
341:       256,
342:       scene,
343:       false,
344:       false,
345:       Texture.NEAREST_NEAREST
346:     );
347:   }
348: 
349:   // Off the 256×256 grid there is no ground: `x >= 256` used to read the next
350:   // row and `y >= 256` read `undefined` (a walkable 0), so paths could leave
351:   // the map. The original clamps the caller; the clone answers a wall.
352:   const OFF_MAP_FLAGS = TWFlags.NoMove | TWFlags.NoGround;
353: 
354:   function RequestTerrainFlag(xf: number, yf: number) {
355:     if (xf < 0 || yf < 0 || xf >= TERRAIN_SIZE || yf >= TERRAIN_SIZE) {
356:       return OFF_MAP_FLAGS;
357:     }
358: 
359:     const xi = ~~xf;
360:     const yi = ~~yf;
361: 
362:     return terrainAttrs[GetTerrainIndex(xi, yi)];
363:   }
364: 
365:   /**
366:    * `AddTerrainAttributeRange` (ZzzOpenData.cpp): set or clear one flag over a
367:    * `w`×`h` block of tiles. The Chaos Castle arena closes its rings and the
368:    * Blood Castle gate opens its pit through this, and so does the server's
369:    * `ChangeTerrainAttributes` packet (terrainAttributeUpdates.ts).
370:    */
371:   function SetTerrainFlags(
372:     x: number,
373:     y: number,
374:     w: number,
375:     h: number,
376:     flag: number,
377:     set: boolean
378:   ) {
379:     const openedIds: number[] = [];
380:     const closedIds: number[] = [];
381: 
382:     for (let yi = y; yi < y + h; yi++) {
383:       if (yi < 0 || yi >= TERRAIN_SIZE) continue;
384:       for (let xi = x; xi < x + w; xi++) {
385:         if (xi < 0 || xi >= TERRAIN_SIZE) continue;
386:         const i = GetTerrainIndex(xi, yi);
387:         terrainAttrs[i] = set ? terrainAttrs[i] | flag : terrainAttrs[i] & ~flag;
388: 
389:         if (world.pathfinder) {
390:           const id = xi * TERRAIN_SIZE + yi;
391:           if (IsWalkable(xi, yi)) {
392:             openedIds.push(id);
393:           } else {
394:             closedIds.push(id);
395:           }
396:         }
397:       }
398:     }
399: 
400:     if (openedIds.length > 0) {
401:       world.pathfinder.applyOpenedPatch(openedIds);
402:     }
403:     if (closedIds.length > 0) {
404:       world.pathfinder.applyClosedPatch(closedIds);
405:     }
406:   }
