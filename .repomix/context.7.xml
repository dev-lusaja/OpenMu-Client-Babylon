1035: export function createGrassField(
1036:   scene: Scene,
1037:   src: GrassSource
1038: ): GrassField | null {
1039:   const perTile = BLADES_PER_TILE[Math.min(src.density, 9)] ?? 0;
1040: 
1041:   // No card, no grass, and no material either: the Dungeon and Tarkan ship
1042:   // none at all, and the original draws nothing there (terrainGrassCards.ts).
1043:   if (perTile <= 0 || !src.cards.slots.size || !src.cards.ramp) return null;
1044: 
1045:   const material = createGrassMaterial(scene, src.cards, src.blade);
1046:   const blade = bladeVertexData(src.blade);
1047: 
1048:   const blocks = new Map<number, Mesh | null>();
1049: 
1050:   let centerX = 0;
1051:   let centerZ = 0;
1052: 
1053:   /** Live presses, oldest-faintest first out. Never reallocated per frame. */
