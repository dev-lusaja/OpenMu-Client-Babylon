 28: /**
 29:  * The sky (ARCHITECTURE §4.6): sole writer of `scene.clearColor` and of the
 30:  * sky dome mesh. Open maps on tiers >= 1 draw an inverted hemisphere past the
 31:  * map with the profile's zenith-to-horizon gradient, unlit and untouched by
 32:  * the haze; it gives the void beyond the map edge the colour the far terrain
 33:  * is fading to, so the edge dissolves instead of standing as a silhouette.
 34:  * Classic and skyless maps keep the clear colour alone.
 35:  */
 36: 
 37: export type ClearLook = {
 38:   /**
 39:    * The profile's horizon, display sRGB, or null to keep the map's authored
 40:    * bytes. Nothing lights the sky and no exposure follows it (the level lives
 41:    * in the key, §13 F4), so the decoded value lands where it was authored.
 42:    */
 43:   readonly horizon: Rgb | null;
 44:   /** The buffer is linear: decode the horizon once, here. */
 45:   readonly linear: boolean;
 46:   /** `SetWorldClearColor` bytes, or undefined for black. */
 47:   readonly bytes: readonly [number, number, number] | undefined;
 48:   /** A room is active: nothing past its walls is drawn, the void included. */
 49:   readonly black: boolean;
 50: };
 51: 
 52: /**
 53:  * Dome radius in tiles: past any corner of a 256-tile map from any camera,
 54:  * inside the camera's far plane (Babylon's default 10000), and far beyond
 55:  * the shadow and AO ranges, so the depth it writes is always the last thing
 56:  * behind the map.
 57:  */
 58: const DOME_RADIUS = 2000;
 59: 
 60: /** Dev seam, shared with the fog it belongs to (`scenes/heightFog.ts`). */
 61: const uwDev = devQueryNumber('uw');
 62: 
 63: const DOME_SEGMENTS = 24;
 64: 
 65: const DOME_SHADER = 'muSkyDome';
 66: 
 67: /**
 68:  * The disc in linear, above the bloom threshold (scene white) so the pass and
 69:  * nothing else gives it its glare.
 70:  */
 71: const DISC_GAIN = 8;
 72: 
 73: /** The sun's angular radius and the soft edge around it, degrees. */
 74: const DISC_RADIUS_DEG = 0.55;
 75: const DISC_EDGE_DEG = 0.35;
 76: 
 77: /**
 78:  * Samples taken up the sun ray to shade a cloud. They are what the depth is
 79:  * made of, and they are all the marching there is: the shape itself is read
 80:  * once (see `muCloudSlab`).
 81:  */
 82: const CLOUD_LIGHT_STEPS = 4;
 83: 
 84: /**
 85:  * The slab's tonal range, which is the whole of whether a cloud reads as a
 86:  * body or as a stain on the dome.
 87:  *
 88:  * `LIT_GAIN` lifts a sunlit top above the sky it sits in - a cloud that is not
 89:  * brighter than the sky behind it is a smudge - and `BASE_SHADE` is what the
 90:  * underside keeps, lit by the sky beneath it rather than by the sun.
 91:  * `SELF_SHADOW` is how hard the deck standing overhead cuts the sun on the way
 92:  * down, so the shading follows the shape instead of a fixed gradient.
 93:  */
 94: const CLOUD_LIT_GAIN = 1.35;
 95: const CLOUD_BASE_SHADE = 0.5;
 96: const CLOUD_SELF_SHADOW = 3.2;
 97: 
 98: /** Optical depth a fully covered ray gathers: how solid a thick cloud reads. */
 99: const CLOUD_DENSITY = 5;
100: 
101: /**
102:  * The volumetric march: steps along the view ray, steps up the sun ray for
103:  * each of them, and the transmittance at which the walk gives up because
104:  * nothing behind it could show.
105:  */
106: const VOLUME_STEPS = 32;
107: const VOLUME_LIGHT_STEPS = 4;
108: const VOLUME_CUTOFF = 0.02;
109: 
110: /**
111:  * Step sizes, in tiles, between which the fine structure is faded out.
112:  *
113:  * A ray overhead crosses the deck in about a hundred tiles and a ray near the
114:  * horizon in four hundred, so with a fixed step count the step itself varies
115:  * by four. Past the erosion's own period the march cannot resolve what it is
116:  * sampling and draws the beat instead - see `muCloudDensity`.
117:  */
118: const VOLUME_DETAIL_FULL = 4;
119: const VOLUME_DETAIL_NONE = 11;
120: 
121: /** Tiles of deck a single ray will walk before it stops. A ray near the
122:  * horizon crosses hundreds and is haze long before that. */
123: const VOLUME_MAX_SPAN = 900;
124: 
125: /** Extinction per tile of density, and how hard the deck shades itself. */
126: const VOLUME_DENSITY = 0.085;
127: const VOLUME_SELF_SHADOW = 4.5;
128: 
129: /**
130:  * Curvature the deck is bent onto, in tiles: the radius of the shell the view
131:  * ray is intersected against.
132:  *
133:  * A flat deck meets a level ray at infinity, which is why the layer used to be
134:  * cut off at a fixed distance and faded out below 17 degrees - and in first
135:  * person, where the horizon sits mid-screen, that fade band is half the sky
136:  * and the deck read as a ceiling ending in mid-air. A shell has a horizon of
137:  * its own instead: the same deck is about 95 tiles away overhead and about
138:  * 1050 at eye level, so the clouds compress into a band as they recede and the
139:  * layer ends where the ground does.
140:  *
141:  * The value is not a planet's radius, which would put the deck's horizon
142:  * further out than the map is wide and leave the compression invisible. It is
143:  * picked for the 11:1 spread between the overhead and horizon distances, which
144:  * is what the compression is made of.
145:  */
146: const CLOUD_PLANET_RADIUS = 6000;
147: 
148: /**
149:  * Aerial perspective on the deck, in tiles: where the air starts taking the
150:  * clouds, how fast it takes them, and how much it can take.
151:  *
152:  * The dome is outside the G-buffer so the distance haze never touches it, and
153:  * without this a cloud on the skyline is drawn with the same body and contrast
154:  * as one overhead - the layer reads as a flat texture rather than as a deck
155:  * receding. Fading toward the sky already computed for that pixel is what the
156:  * haze does to the far terrain, with the same colour, since the profile's
157:  * horizon is both.
158:  *
159:  * It also stands in for a mip chain: the field is sampled with none (see
160:  * `clouds.ts`), and the horizon is where a cell is thinnest on screen, which
161:  * is exactly where this leaves the least contrast to alias.
162:  */
163: const CLOUD_AERIAL_START = 150;
164: const CLOUD_AERIAL_SCALE = 450;
165: const CLOUD_AERIAL_MAX = 0.92;
