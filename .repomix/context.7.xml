  1: // javascript-astar 0.4.1
  2: // http://github.com/bgrins/javascript-astar
  3: // Freely distributable under the MIT License.
  4: // Implements the astar search algorithm in javascript using a Binary Heap.
  5: // Includes Binary Heap (with modifications) from Marijn Haverbeke.
  6: // http://eloquentjavascript.net/appendix2.html
  7: //
  8: // Changes for the MU grid (an 8-connected 256×256 tile map, the original's
  9: // `PathFinding2`):
 10: //  - the default heuristic is octile (admissible for diagonal moves at
 11: //    √2; manhattan over-estimated and made the hero zig-zag),
 12: //  - a diagonal step is only offered when both tiles it cuts past are
 13: //    walkable, so a path never squeezes between two blocked corners (the
 14: //    server refuses that step and rubber-bands the walker),
 15: //  - the search stops after `maxExpansions` closed nodes and returns the
 16: //    path to the closest node seen so far, so a click into a walled-off
 17: //    region costs a bounded amount and still walks the hero toward it.
 18: 
 19: type Pos = { x: number; y: number };
 20: 
 21: /** `sqrt(2) - 1`: the extra a diagonal step costs over two orthogonal ones. */
 22: const OCTILE_D2 = Math.SQRT2 - 1;
 23: 
 24: /**
 25:  * Closed nodes a single search may expand before it gives up and returns the
 26:  * closest node found. Every tile of the map is 65 536; a realistic click is a
 27:  * few hundred, and the original's `PathFinding2` bounds itself to a similar
 28:  * window around the walker.
 29:  */
 30: const DEFAULT_MAX_EXPANSIONS = 8192;
 31: 
 32: function pathTo(node: GridNode) {
 33:   let curr = node;
 34:   const path: GridNode[] = [];
 35:   while (curr.parent) {
 36:     path.unshift(curr);
 37:     curr = curr.parent;
 38:   }
 39:   return path;
 40: }
 41: 
 42: function getHeap() {
 43:   return new BinaryHeap(node => node.f);
 44: }
 45: 
 46: export type AStarOptions = {
 47:   /**
 48:    * Return the path to the closest node when the target is unreachable (or
 49:    * the expansion cap is hit) instead of an empty path.
 50:    */
 51:   closest?: boolean;
 52:   /** Heuristic (see `astar.heuristics`); octile by default. */
 53:   heuristic?: (a: Pos, b: Pos) => number;
 54:   /** Closed-node cap for this search; `DEFAULT_MAX_EXPANSIONS` by default. */
 55:   maxExpansions?: number;
 56: };
 57: 
 58: const astar = {
 59:   /**
 60:    * Perform an A* Search on a graph given a start and end node.
 61:    */
 62:   search(
 63:     graph: Graph,
 64:     start: GridNode,
 65:     end: GridNode,
 66:     options: AStarOptions = {}
 67:   ) {
 68:     graph.cleanDirty();
 69:     const heuristic = options.heuristic || astar.heuristics.octile;
 70:     const closest = options.closest || false;
 71:     const maxExpansions = options.maxExpansions ?? DEFAULT_MAX_EXPANSIONS;
 72: 
 73:     const openHeap = getHeap();
 74:     let closestNode = start; // set the start node to be the closest if required
 75: 
 76:     start.h = heuristic(start, end);
 77:     graph.markDirty(start);
 78: 
 79:     openHeap.push(start);
 80: 
 81:     let expansions = 0;
 82: 
 83:     while (openHeap.size() > 0) {
 84:       // Grab the lowest f(x) to process next.  Heap keeps this sorted for us.
 85:       const currentNode = openHeap.pop();
 86: 
 87:       // End case -- result has been found, return the traced path.
 88:       if (currentNode === end) {
 89:         return pathTo(currentNode);
 90:       }
 91: 
 92:       if (++expansions > maxExpansions) break;
 93: 
 94:       // Normal case -- move currentNode from open to closed, process each of its neighbors.
 95:       currentNode.closed = true;
 96: 
 97:       // Find all neighbors for the current node.
 98:       const neighbors = graph.neighbors(currentNode);
 99: 
100:       for (let i = 0, il = neighbors.length; i < il; ++i) {
101:         const neighbor = neighbors[i];
102: 
103:         if (neighbor.closed || neighbor.isWall()) {
104:           // Not a valid node to process, skip to next neighbor.
105:           continue;
106:         }
107: 
108:         // The g score is the shortest distance from start to current node.
109:         // We need to check if the path we have arrived at this neighbor is the shortest one we have seen yet.
110:         const gScore = currentNode.g + neighbor.getCost(currentNode);
111:         const beenVisited = neighbor.visited;
112: 
113:         if (!beenVisited || gScore < neighbor.g) {
114:           // Found an optimal (so far) path to this node.  Take score for node to see how good it is.
115:           neighbor.visited = true;
116:           neighbor.parent = currentNode;
117:           neighbor.h = neighbor.h || heuristic(neighbor, end);
118:           neighbor.g = gScore;
119:           neighbor.f = neighbor.g + neighbor.h;
120:           graph.markDirty(neighbor);
121:           if (closest) {
122:             // If the neighbour is closer than the current closestNode or if it's equally close but has
123:             // a cheaper path than the current closest node then it becomes the closest node
124:             if (
125:               neighbor.h < closestNode.h ||
126:               (neighbor.h === closestNode.h && neighbor.g < closestNode.g)
127:             ) {
128:               closestNode = neighbor;
129:             }
130:           }
131: 
132:           if (!beenVisited) {
133:             // Pushing to heap will put it in proper place based on the 'f' value.
134:             openHeap.push(neighbor);
135:           } else {
136:             // Already seen the node, but since it has been rescored we need to reorder it in the heap
137:             openHeap.rescoreElement(neighbor);
138:           }
139:         }
140:       }
141:     }
142: 
143:     if (closest) {
144:       return pathTo(closestNode);
145:     }
146: 
147:     // No result was found - empty array signifies failure to find path.
148:     return [];
149:   },
150:   // See list of heuristics: http://theory.stanford.edu/~amitp/GameProgramming/Heuristics.html
151:   heuristics: {
152:     manhattan(pos0: Pos, pos1: Pos) {
153:       const d1 = Math.abs(pos1.x - pos0.x);
154:       const d2 = Math.abs(pos1.y - pos0.y);
155:       return d1 + d2;
156:     },
157:     /**
158:      * Exact distance on an 8-connected grid with diagonals at √2:
159:      * `max + (√2 − 1)·min` - the `min` diagonal steps cost √2 each and the
160:      * remaining `max − min` are straight. (`d1 + d2 + …` over-estimated and
161:      * made A* inadmissible.)
162:      */
163:     octile(pos0: Pos, pos1: Pos) {
164:       const d1 = Math.abs(pos1.x - pos0.x);
165:       const d2 = Math.abs(pos1.y - pos0.y);
166:       return Math.max(d1, d2) + OCTILE_D2 * Math.min(d1, d2);
167:     },
168:     /** Kept under its old name; identical to `octile`. */
169:     diagonal(pos0: Pos, pos1: Pos) {
170:       return astar.heuristics.octile(pos0, pos1);
171:     },
172:   },
173:   cleanNode(node: GridNode) {
174:     node.f = 0;
175:     node.g = 0;
176:     node.h = 0;
177:     node.visited = false;
178:     node.closed = false;
179:     node.parent = null;
180:   },
181: };
182: 
183: /**
184:  * A graph memory structure
185:  * @param {Array} gridIn 2D array of input weights
186:  * @param {Object} [options]
187:  * @param {bool} [options.diagonal] Specifies whether diagonal moves are allowed
188:  */
189: class Graph {
190:   readonly diagonal: boolean;
191:   readonly nodes: GridNode[] = [];
192:   readonly grid: GridNode[][] = [];
193: 
194:   private dirtyNodes: GridNode[] = [];
195:   /** Scratch for `neighbors`: at most 8 entries, reused between calls. */
196:   private readonly neighborScratch: GridNode[] = [];
197: 
198:   constructor(gridIn: number[][], options: { diagonal?: boolean } = {}) {
199:     this.diagonal = !!options.diagonal;
200: 
201:     for (let x = 0; x < gridIn.length; x++) {
202:       this.grid[x] = [];
203: 
204:       for (let y = 0, row = gridIn[x]; y < row.length; y++) {
205:         const node = new GridNode(x, y, row[y]);
206:         this.grid[x][y] = node;
207:         this.nodes.push(node);
208:       }
209:     }
210:     this.init();
211:   }
212: 
213:   private init(): void {
214:     this.dirtyNodes = [];
215:     for (let i = 0; i < this.nodes.length; i++) {
216:       astar.cleanNode(this.nodes[i]);
217:     }
218:   }
219: 
220:   cleanDirty() {
221:     for (let i = 0; i < this.dirtyNodes.length; i++) {
222:       astar.cleanNode(this.dirtyNodes[i]);
223:     }
224:     this.dirtyNodes = [];
225:   }
226: 
227:   markDirty(node: GridNode): void {
228:     this.dirtyNodes.push(node);
229:   }
230: 
231:   /**
232:    * The walkable-or-not tiles around `node`. Diagonals are offered only when
233:    * neither tile they cut between is a wall (`PathFinding2`'s rule; the
234:    * server walks the same way). The returned array is scratch, valid until
235:    * the next call.
236:    */
237:   neighbors(node: GridNode) {
238:     const ret = this.neighborScratch;
239:     ret.length = 0;
240:     const x = node.x;
241:     const y = node.y;
242:     const grid = this.grid;
243: 
244:     const colW = grid[x - 1];
245:     const colE = grid[x + 1];
246:     const col = grid[x];
247: 
248:     const west = colW ? colW[y] : undefined;
249:     const east = colE ? colE[y] : undefined;
250:     const south = col ? col[y - 1] : undefined;
251:     const north = col ? col[y + 1] : undefined;
252: 
253:     if (west) ret.push(west);
254:     if (east) ret.push(east);
255:     if (south) ret.push(south);
256:     if (north) ret.push(north);
257: 
258:     if (this.diagonal) {
259:       const openW = !!west && !west.isWall();
260:       const openE = !!east && !east.isWall();
261:       const openS = !!south && !south.isWall();
262:       const openN = !!north && !north.isWall();
263: 
264:       // Southwest
265:       if (openW && openS && colW[y - 1]) ret.push(colW[y - 1]);
266:       // Southeast
267:       if (openE && openS && colE[y - 1]) ret.push(colE[y - 1]);
268:       // Northwest
269:       if (openW && openN && colW[y + 1]) ret.push(colW[y + 1]);
270:       // Northeast
271:       if (openE && openN && colE[y + 1]) ret.push(colE[y + 1]);
272:     }
273: 
274:     return ret;
275:   }
276: 
277:   toString() {
278:     const graphString = [];
279:     const nodes = this.grid;
280:     for (let x = 0; x < nodes.length; x++) {
281:       const rowDebug = [];
282:       const row = nodes[x];
283:       for (let y = 0; y < row.length; y++) {
284:         rowDebug.push(row[y].weight);
285:       }
286:       graphString.push(rowDebug.join(' '));
287:     }
288:     return graphString.join('\n');
289:   }
290: }
291: 
292: class GridNode<TValue = number> {
293:   f = 0;
294:   g = 0;
295:   h = 0;
296:   visited = false;
297:   closed = false;
298:   parent: GridNode<TValue> | null = null;
299: 
300:   constructor(readonly x: number, readonly y: number, public weight: TValue) {}
301: 
302:   toString() {
303:     return '[' + this.x + ' ' + this.y + ']';
304:   }
305: 
306:   getCost(fromNeighbor?: GridNode) {
307:     const weight = this.weight as unknown as number;
308:     // Take diagonal weight into consideration.
309:     if (fromNeighbor && fromNeighbor.x != this.x && fromNeighbor.y != this.y) {
310:       return weight * Math.SQRT2;
311:     }
312:     return weight;
313:   }
314: 
315:   isWall() {
316:     return this.weight === 0;
317:   }
318: }
319: 
320: class BinaryHeap {
321:   readonly content: GridNode[] = [];
322: 
323:   constructor(readonly scoreFunction: (node: GridNode) => number) {}
324: 
325:   push(element: GridNode) {
326:     // Add the new element to the end of the array.
327:     this.content.push(element);
328: 
329:     // Allow it to sink down.
330:     this.sinkDown(this.content.length - 1);
331:   }
332: 
333:   pop() {
334:     // Store the first element so we can return it later.
335:     const result = this.content[0];
336:     // Get the element at the end of the array.
337:     const end = this.content.pop();
338: 
339:     if (end == null) throw new Error();
340: 
341:     // If there are any elements left, put the end element at the
342:     // start, and let it bubble up.
343:     if (this.content.length > 0) {
344:       this.content[0] = end;
345:       this.bubbleUp(0);
346:     }
347:     return result;
348:   }
349: 
350:   remove(node: GridNode) {
351:     const i = this.content.indexOf(node);
352: 
353:     // When it is found, the process seen in 'pop' is repeated
354:     // to fill up the hole.
355:     const end = this.content.pop();
356: 
357:     if (end == null) throw new Error();
358: 
359:     if (i !== this.content.length - 1) {
360:       this.content[i] = end;
361: 
362:       if (this.scoreFunction(end) < this.scoreFunction(node)) {
363:         this.sinkDown(i);
364:       } else {
365:         this.bubbleUp(i);
366:       }
367:     }
368:   }
369: 
370:   size() {
371:     return this.content.length;
372:   }
373: 
374:   rescoreElement(node: GridNode) {
375:     this.sinkDown(this.content.indexOf(node));
376:   }
377: 
378:   sinkDown(n: number) {
379:     // Fetch the element that has to be sunk.
380:     const element = this.content[n];
381: 
382:     // When at 0, an element can not sink any further.
383:     while (n > 0) {
384:       // Compute the parent element's index, and fetch it.
385:       const parentN = ((n + 1) >> 1) - 1;
386:       const parent = this.content[parentN];
387:       // Swap the elements if the parent is greater.
388:       if (this.scoreFunction(element) < this.scoreFunction(parent)) {
389:         this.content[parentN] = element;
390:         this.content[n] = parent;
391:         // Update 'n' to continue at the new position.
392:         n = parentN;
393:       }
394:       // Found a parent that is less, no need to sink any further.
395:       else {
396:         break;
397:       }
398:     }
399:   }
400: 
401:   bubbleUp(n: number) {
402:     // Look up the target element and its score.
403:     const length = this.content.length;
404:     const element = this.content[n];
405:     const elemScore = this.scoreFunction(element);
406: 
407:     while (true) {
408:       // Compute the indices of the child elements.
409:       const child2N = (n + 1) << 1;
410:       const child1N = child2N - 1;
411:       // This is used to store the new position of the element, if any.
412:       let swap = null;
413:       let child1Score: number | undefined;
414:       // If the first child exists (is inside the array)...
415:       if (child1N < length) {
416:         // Look it up and compute its score.
417:         const child1 = this.content[child1N];
418:         child1Score = this.scoreFunction(child1);
419: 
420:         // If the score is less than our element's, we need to swap.
421:         if (child1Score < elemScore) {
422:           swap = child1N;
423:         }
424:       }
425: 
426:       // Do the same checks for the other child.
427:       if (child2N < length) {
428:         const child2 = this.content[child2N];
429:         const child2Score = this.scoreFunction(child2);
430:         if (child2Score < (swap === null ? elemScore : child1Score!)) {
431:           swap = child2N;
432:         }
433:       }
434: 
435:       // If the element needs to be moved, swap it, and continue.
436:       if (swap !== null) {
437:         this.content[n] = this.content[swap];
438:         this.content[swap] = element;
439:         n = swap;
440:       }
441:       // Otherwise, we are done.
442:       else {
443:         break;
444:       }
445:     }
446:   }
447: }
448: 
449: export { astar, Graph, GridNode };
</file>

<file path="src/libs/attributeSystem.ts">
  1: import { assertNotImplemented } from './utils';
  2: 
  3: enum InputOperator {
  4:   Multiply,
  5:   Add,
  6:   Exponentiate,
  7: }
  8: 
  9: enum AggregationType {
 10:   AddRaw,
 11:   Multiple,
 12:   AddFinal,
 13: }
 14: 
 15: interface IElement {
 16:   getValue: () => number;
 17: }
 18: 
 19: interface IStatElement extends IElement {
 20:   setValue: (val: number) => void;
 21: }
 22: 
 23: const OPERATOR_FUNC = {
 24:   [InputOperator.Multiply]: (operand: number, oldValue: number) =>
 25:     operand * oldValue,
 26:   [InputOperator.Add]: (operand: number, oldValue: number) =>
 27:     operand + oldValue,
 28:   [InputOperator.Exponentiate]: (operand: number, oldValue: number) =>
 29:     Math.pow(oldValue, operand),
 30: } as const;
 31: 
 32: const EPSILON = 0.00001;
 33: 
 34: class Connection {
 35:   constructor(
 36:     private readonly input: Element,
 37:     private readonly output: Element,
 38:     private readonly operator: InputOperator,
 39:     public value: number,
 40:     readonly aggregationType: AggregationType
 41:   ) {}
 42: 
 43:   getValue(): number {
 44:     return OPERATOR_FUNC[this.operator](this.value, this.input.getValue());
 45:   }
 46: 
 47:   onChange(): void {
 48:     this.output.onInputValueChanged();
 49:   }
 50: 
 51:   setValue(newValue: number): void {
 52:     this.value = newValue;
 53:   }
 54: }
 55: 
 56: class Element implements IStatElement {
 57:   inputs: Connection[] = [];
 58:   outputs: Connection[] = [];
 59:   private _value: number | null = null;
 60:   connectedConnectionValues: Connection[] = [];
 61: 
 62:   private _computeNewValue(): number {
 63:     let raw = 0;
 64:     let multiply = 1;
 65:     let final = 0;
 66:     this.inputs.forEach(connection => {
 67:       switch (connection.aggregationType) {
 68:         case AggregationType.AddRaw:
 69:           raw += connection.getValue();
 70:           break;
 71:         case AggregationType.Multiple:
 72:           multiply *= connection.getValue();
 73:           break;
 74:         case AggregationType.AddFinal:
 75:           final += connection.getValue();
 76:           break;
 77:         default:
 78:           assertNotImplemented(connection.aggregationType);
 79:       }
 80:     });
 81: 
 82:     return raw * multiply + final;
 83:   }
 84: 
 85:   onInputValueChanged(): void {
 86:     const newValue = this._computeNewValue();
 87:     this._setValue(newValue);
 88:   }
 89: 
 90:   getValue(): number {
 91:     if (this._value === null) {
 92:       this.onInputValueChanged();
 93:     }
 94: 
 95:     return this._value!;
 96:   }
 97: 
 98:   setValue(val: number): void {
 99:     if (this.inputs.length > 0) throw new Error(`can't set value with inputs`);
100: 
101:     // almost equal values
102:     if (this._value !== null && Math.abs(this._value - val) < EPSILON) {
103:       return;
104:     }
105: 
106:     this._setValue(val);
107:   }
108: 
109:   private _setValue(val: number): void {
110:     this._value = val;
111:     this.outputs.forEach(o => o.onChange());
112: 
113:     this.connectedConnectionValues.forEach(c => {
114:       c.setValue(val);
115:       c.onChange();
116:     });
117:   }
118: }
119: 
120: class AttributeSystem<
121:   TStatAttributes extends string,
122:   TAttributes extends string,
123:   TAll extends TStatAttributes | TAttributes = TStatAttributes | TAttributes
124: > {
125:   _elements = new Map<TAll, Element>();
126: 
127:   _relationships: {
128:     targetAtt: TAttributes;
129:     inputAtt: TAll;
130:     operator: InputOperator;
131:     value: number;
132:     operandAtt?: TAll;
133:   }[] = [];
134: 
135:   get zeroElement() {
136:     return this._getOrCreateElement('__zero__' as any);
137:   }
138: 
139:   constructor() {
140:     this.zeroElement.setValue(0);
141:   }
142: 
143:   createRelationship(
144:     targetAtt: TAttributes,
145:     inputAtt: TAll,
146:     operator: InputOperator,
147:     value: number,
148:     aggregationType = AggregationType.AddRaw,
149:     operandAtt?: TAll
150:   ) {
151:     const r = {
152:       targetAtt,
153:       inputAtt,
154:       operator,
155:       value,
156:       operandAtt,
157:     } as const;
158: 
159:     const outputElement = this._getOrCreateElement(targetAtt as any);
160:     const inputElement = this._getOrCreateElement(inputAtt as any);
161:     const connection = new Connection(
162:       inputElement,
163:       outputElement,
164:       operator,
165:       value,
166:       aggregationType
167:     );
168:     if (operandAtt != null) {
169:       const operandElement = this._getOrCreateElement(operandAtt);
170:       operandElement.connectedConnectionValues.push(connection);
171:     }
172: 
173:     inputElement.outputs.push(connection);
174:     outputElement.inputs.push(connection);
175: 
176:     this._relationships.push(r);
177: 
178:     if (operandAtt != null) {
179:       const operandElement = this._getOrCreateElement(operandAtt);
180:       connection.setValue(operandElement.getValue());
181:       connection.onChange();
182:     }
183: 
184:     return r;
185:   }
186: 
187:   private _getOrCreateElement(att: TAll) {
188:     const exists = this._elements.get(att);
189: 
190:     if (exists !== undefined) {
191:       return exists;
192:     }
193: 
194:     const newElement = new Element();
195: 
196:     this._elements.set(att, newElement);
197: 
198:     return newElement;
199:   }
200: 
201:   private _getValue(att: TAll): number {
202:     return this._getOrCreateElement(att).getValue();
203:   }
204: 
205:   hasAttribute(att: TAll): boolean {
206:     return this._elements.has(att);
207:   }
208: 
209:   addMultiplyRelationship(
210:     targetAtt: TAttributes,
211:     inputAtt: TAll,
212:     value: number = 1
213:   ) {
214:     this.createRelationship(targetAtt, inputAtt, InputOperator.Multiply, value);
215: 
216:     return this;
217:   }
218: 
219:   addConditionalRelationship(
220:     targetAtt: TAttributes,
221:     inputAtt: TAll,
222:     operandAtt: TAll
223:   ) {
224:     this.createRelationship(
225:       targetAtt,
226:       inputAtt,
227:       InputOperator.Multiply,
228:       1,
229:       AggregationType.AddRaw,
230:       operandAtt
231:     );
232: 
233:     return this;
234:   }
235: 
236:   createConditionalAttribute(att: TAttributes, dependsOn: TAll) {
237:     this.addValueElement(att, 1, AggregationType.AddFinal);
238:     this.addValueElement(att, -1, AggregationType.AddRaw);
239: 
240:     return this.createRelationship(
241:       att,
242:       '__zero__' as any,
243:       InputOperator.Exponentiate,
244:       0,
245:       AggregationType.Multiple,
246:       dependsOn
247:     );
248:   }
249: 
250:   addValueElement(
251:     targetAtt: TAttributes,
252:     value: number,
253:     aggregationType: AggregationType
254:   ) {
255:     const outputElement = this._getOrCreateElement(targetAtt as any);
256: 
257:     const inputElement = new Element();
258: 
259:     const connection = new Connection(
260:       inputElement,
261:       outputElement,
262:       InputOperator.Multiply,
263:       1,
264:       aggregationType
265:     );
266: 
267:     inputElement.outputs.push(connection);
268:     outputElement.inputs.push(connection);
269: 
270:     // IMPORTANT: after connection to trigger onChange event
271:     inputElement.setValue(value);
272: 
273:     // dispose element
274:     const dispose = (): void => {
275:       outputElement.inputs = outputElement.inputs.filter(i => i !== connection); //TODO performance hit?
276:       inputElement.outputs.length = 0;
277:       outputElement.onInputValueChanged();
278:     };
279: 
280:     return { dispose, element: inputElement as IStatElement } as const;
281:   }
282: 
283:   setValue(att: TStatAttributes, val: number) {
284:     const element = this._getOrCreateElement(att as any);
285:     element.setValue(val);
286:   }
287: 
288:   addValue(att: TStatAttributes, val: number, max?: number) {
289:     const element = this._getOrCreateElement(att as any);
290:     let newValue = element.getValue() + val;
291:     if (max !== undefined) {
292:       newValue = Math.min(max, newValue);
293:     }
294:     element.setValue(newValue);
295:     return newValue;
296:   }
297: 
298:   getValue(att: TAll): number {
299:     return this._getValue(att);
300:   }
301: 
302:   isAboveZero(att: TAll): boolean {
303:     return this._getValue(att) > 0;
304:   }
305: }
306: 
307: type GAttributesKeys =
308:   | 'isFemale'
309:   | 'isFlying'
310:   | 'isSwimming'
311:   | 'currentMana'
312:   | 'currentHealth'
313:   | 'maxMana'
314:   | 'maxHealth'
315:   | 'playerNetClass'
316:   | 'totalMovementSpeed'
317:   | 'inSafeZone'
318:   | 'isSpearEquipped'
319:   /** 1 while weapons are bound to the back bone (safe zone / social action / swim). */
320:   | 'weaponsOnBack'
321:   /** Derived combat speeds (agility / class divisor); drive the attack/cast clip rate. */
322:   | 'attackSpeed'
323:   | 'magicSpeed';
324: 
325: type Stats = GAttributesKeys;
326: type Others = GAttributesKeys;
327: 
328: export type MUAttributeSystem = AttributeSystem<Stats, Others>;
329: 
330: export function createAttributeSystem(): MUAttributeSystem {
331:   return new AttributeSystem<Stats, Others>();
332: }
