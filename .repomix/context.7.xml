127:     readonly sceneGain: number;
128:     /**
129:      * The key's share of the map's level inside a room (`AreaLook.keyLevel /
130:      * keyGain`, §13 F14): the rig, the ground bake and the emitters all take
131:      * it. 1 outside a room and on Classic.
132:      */
133:     readonly roomShare: number;
134:   };
135:   readonly shadow: ShadowPolicy;
136:   /** Stops over unity after the player's brightness trim; 0 on Classic. */
137:   readonly ev: number;
138:   /**
139:    * `2^(profile ev)`: the level of the light (§13 F4). Every lit path
140:    * multiplies by it once - key rig, ground light sum, point-light pool -
141:    * and emissive art never does. 1 on Classic.
142:    */
143:   readonly keyGain: number;
144:   /** The frame's effective level, `keyGain x post exposure`. */
145:   readonly exposure: number;
146:   readonly toneMapper: ToneMapperName;
147:   /** The rendering style in force: 0 Classic (and every style on tier 0), 1 cel, 2 anime. */
148:   readonly style: number;
149:   readonly fogColorLinear: Rgb;
150:   /** Names of the live post passes, chain order. */
151:   readonly passes: readonly string[];
152: };
153: 
154: export interface LookDirector {
155:   setMap(world: ENUM_WORLD): void;
156:   setArea(name: AreaLookName | null, rect?: AreaRect | RoomVolume): void;
157:   /** An event's modifier over the map and area already resolved; null clears it. */
158:   setOmen(name: OmenLookName | null): void;
159:   tick(dt: number): void;
160:   state(): Readonly<LookState>;
161:   readonly onChange: Observable<Readonly<LookState>>;
162: }
163: 
164: let active: LookDirector | null = null;
165: 
166: /** The scene's director, for the readers (terrain, water, area hand-off). */
167: export function lookDirector(): LookDirector | null {
168:   return active;
169: }
170: 
171: type Blendable = {
172:   ev: number;
173:   /** Gain on the room's emitters (`AreaLook.candles`); 1 outside. */
174:   candles: number;
175:   /** The key's share of the map's level (`AreaLook.keyLevel / 2^ev`); 1 outside. */
176:   roomShare: number;
177:   whiteBalance: [number, number, number];
178:   fog: {
179:     start: number;
180:     density: number;
181:     cap: number;
182:     height: number;
183:     color: [number, number, number] | null;
184:   };
185: };
186: 
187: const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
188: 
189: function blendable(p: LookProfile, candles = 1, roomShare = 1): Blendable {
190:   return {
191:     ev: p.ev,
192:     candles,
193:     roomShare,
194:     whiteBalance: [...p.whiteBalance],
195:     fog: { ...p.fog, color: p.fog.color ? [...p.fog.color] : null },
196:   };
197: }
198: 
199: function lerpBlendable(a: Blendable, b: Blendable, t: number): Blendable {
200:   // A haze fading in keeps the colour of the side that has one.
201:   const color = b.fog.density > 0 ? b.fog.color : a.fog.color;
202: 
203:   return {
204:     ev: lerp(a.ev, b.ev, t),
205:     candles: lerp(a.candles, b.candles, t),
206:     roomShare: lerp(a.roomShare, b.roomShare, t),
207:     whiteBalance: [
208:       lerp(a.whiteBalance[0], b.whiteBalance[0], t),
209:       lerp(a.whiteBalance[1], b.whiteBalance[1], t),
210:       lerp(a.whiteBalance[2], b.whiteBalance[2], t),
211:     ],
212:     fog: {
213:       start: lerp(a.fog.start, b.fog.start, t),
214:       density: lerp(a.fog.density, b.fog.density, t),
215:       cap: lerp(a.fog.cap, b.fog.cap, t),
216:       height: lerp(a.fog.height, b.fog.height, t),
217:       color: color ? [...color] : null,
218:     },
219:   };
220: }
221: 
222: export function createLookDirector(
223:   scene: Scene,
224:   camera: ArcRotateCamera
225: ): LookDirector {
226:   const postChain: PostChain = createPostChain(scene, camera);
227:   const onChange = new Observable<Readonly<LookState>>();
228: 
229:   // Dev seams: `?ev=` adds stops, `?wb=r,g,b` replaces the balance, `?tm=0..3`
230:   // the mapper, `?candles=` the room's emitter gain, `?roomKey=` the room's
231:   // key level in key units.
232:   const evDev = devQueryNumber('ev') ?? 0;
233:   const candlesDev = devQueryNumber('candles');
234:   const roomKeyDev = devQueryNumber('roomKey');
235:   const wbDev = devQueryNumbers('wb', 3) as Rgb | null;
236:   const tmDev = devQueryNumber('tm');
237: 
238:   let world = ENUM_WORLD.WD_0LORENCIA;
239:   let area: LookArea | null = null;
240:   let base: LookProfile = profileFor(world);
241:   let target: LookProfile = base;
242: 
243:   // The omen asked for, the row it is ramping from or to (the last one named,
244:   // so clearing it fades out of that row rather than snapping), and the ramp.
245:   let omen: OmenLookName | null = null;
246:   let omenLook: OmenLook = NO_OMEN;
247:   let omenBlend = 0;
248: 
249:   let targetCandles = 1;
250:   let targetShare = 1;
251:   let from = blendable(base);
252:   let shown = blendable(base);
253:   let blend = 1;
254: 
255:   let state: LookState | null = null;
256:   let signature = '';
257:   let mapReady = true;
258: 
259:   const retarget = (): void => {
260:     const look = area ? areaProfile(area.name) : null;
261:     const next = look ? applyArea(base, look) : base;
262:     if (next === target) return;
263: 
264:     from = shown;
265:     target = next;
266:     targetCandles = look?.candles ?? 1;
267:     targetShare = look ? (roomKeyDev ?? look.keyLevel) / 2 ** base.ev : 1;
268:     blend = 0;
269:   };
270: 
271:   const tick = (dt: number): void => {
272:     // The snapshot the item materials bind this frame.
273:     syncRenderingStyle(scene.getEngine().getRenderHeight());
274: 
275:     const omenTo = omen ? 1 : 0;
276: 
277:     if (omenBlend !== omenTo) {
278:       const step = dt / BLEND_SECONDS;
279: 
280:       omenBlend +=
281:         Math.sign(omenTo - omenBlend) *
282:         Math.min(step, Math.abs(omenTo - omenBlend));
283:     }
284: 
285:     const omenT = omenBlend * omenBlend * (3 - 2 * omenBlend);
286:     const dim = 1 + (omenLook.dim - 1) * omenT;
287:     const omenBalance: Rgb = [
288:       1 + (omenLook.whiteBalance[0] - 1) * omenT,
289:       1 + (omenLook.whiteBalance[1] - 1) * omenT,
290:       1 + (omenLook.whiteBalance[2] - 1) * omenT,
291:     ];
292: 
293:     if (blend < 1) {
294:       blend = Math.min(1, blend + dt / BLEND_SECONDS);
295:       const t = blend * blend * (3 - 2 * blend);
296:       shown = lerpBlendable(from, blendable(target, targetCandles, targetShare), t);
297:     }
298: 
299:     const tier = tierIndex() as 0 | 1 | 2;
300:     const lightTier = lightingTier();
301:     const shaped = lightTier !== null;
302:     const post = GameOptions.postProcessing;
303:     const room = shaped ? area : null;
304: 
305:     // The style lives on tiers >= 1 only; null below them. The ink lines are
306:     // one pixel wide and read the G-buffer, so it runs at full resolution
307:     // while they are on and at the tier's ratio otherwise.
308:     const style = renderingStyle();
309:     const inkWanted = style !== null && style.outline && post;
310:     const gbufferRatio = lightTier
311:       ? Math.max(lightTier.ssaoRatio, inkWanted ? 1 : 0)
312:       : 1;
313: 
314:     const profile: LookProfile = {
315:       ...target,
316:       ev: shown.ev,
317:       whiteBalance: wbDev ?? composeBalance(shown.whiteBalance, omenBalance),
318:       fog: shown.fog,
319:     };
320: 
321:     // 1. key. Inside a room the rig and the ground bake take the room's share
322:     // of the map's level (F14); the emitters stay at the map's level and
323:     // carry the room.
324:     const keyGain = shaped ? 2 ** (profile.ev + evDev) : 1;
325:     const roomShare = shaped ? shown.roomShare : 1;
326:     // The emitters take the room's share as well. Leaving them at the map's
327:     // level put the pub floor at 94 % torch delta against Classic's half and
328:     // half: the bake's own colour vanished under a uniform orange, which is
329:     // what "the light no longer reads on the objects" looks like on a floor.
330:     // `candles` is then what it says, how much more than the room's own level
331:     // its emitters get, and 1 is Classic.
332:     const emitterGain = shaped ? (candlesDev ?? shown.candles) * roomShare : 1;
333:     // The event dim rides on the light, not the grade, so every lit path takes
334:     // it and the emissive art does not.
335:     const sceneGain = keyGain * dim;
336:     const sunShare = shaped ? profile.sun.share : 0;
337:     const skyIntensity = shaped ? 1 - sunShare : 1;
338:     const skyGround: Rgb = shaped
339:       ? [SKY_GROUND, SKY_GROUND, SKY_GROUND]
340:       : WHITE;
341: 
342:     setKey(scene, {
343:       skyIntensity: skyIntensity * sceneGain * roomShare,
344:       skyDiffuse: WHITE,
345:       skyGround: shaped ? skyGround : null,
346:       sunIntensity: sunShare * sceneGain * roomShare * directLightGain(),
347:       sunDiffuse: WHITE,
348:     });
349: 
350:     // 2. shadow policy. Classic never moves the rig: the blobs and the snow
351:     // relief read its direction and keep the lean they always had.
352:     const shadow = lightTier
353:       ? shadowPolicyFor(profile, lightTier.pcss, room ? 'all' : 'dynamic')
354:       : CLASSIC_SHADOW_POLICY;
355: 
356:     setSunDirection(scene, shaped ? shadow.direction : DEFAULT_SUN_DIRECTION);
357:     syncSpecular(scene, pbrMaterialsOn() ? specularLightScale() : 0);
358: 
359:     // 3. shadows (CSM + terrain hook + the blobs' re-park)
360:     syncShadows(scene, lightTier, shadow);
361:     // The ground and the grass take the style's defines the way they take
362:     // the cascades'.
363:     syncTerrainDefines();
364: 
365:     // 4. sky. The map's own horizon, not the area's: a tavern has no sky of
366:     // its own but the doorway still shows the one outside - unless the room
367:     // owns the frame and nothing past its walls is drawn.
368:     syncSkyDome(scene, {
369:       horizon: shaped ? base.sky?.horizon ?? null : null,
370:       linear: linearBufferActive(scene),
371:       bytes: maps.clearColorFor(world),
372:       black: room !== null,
373:     });
374: 
375:     // The far scenery standing against it, for a map that has any.
376:     syncSkyline(scene);
377: 
378:     // 5. haze and AO
379:     const fogSource = profile.fog.color ?? base.sky?.horizon ?? null;
380:     const fogColorLinear: Rgb = fogSource ? toLinear(fogSource) : [0, 0, 0];
381: 
382:     let reordered = syncAmbientOcclusion(
383:       scene,
384:       camera,
385:       lightTier,
386:       post,
387:       gbufferRatio
388:     );
389: 
390:     // The ink lines: after the AO, before the haze so they fade with it.
391:     reordered =
392:       syncInkOutline(scene, camera, lightTier, tier, style, post, reordered) ||
393:       reordered;
394: 
395:     reordered =
396:       syncHeightFog(
397:         scene,
398:         camera,
399:         shaped ? profile.fog : { ...profile.fog, density: 0 },
400:         fogColorLinear,
401:         post,
402:         // The map's own, not the area's: a room owns the frame and shows
403:         // nothing past its walls, and a room has no holes in its floor.
404:         shaped && !room ? base.underworld ?? null : null,
405:         reordered
406:       ) ||
407:       reordered;
408:     updateHeightFog(camera, dt);
409: 
410:     // The room mask (F8): after the haze, before the post chain.
411:     const roomMask = syncRoomMask(scene, camera, lightTier, room?.volume ?? null, reordered);
412:     reordered = roomMask.changed || reordered;
413: 
414:     // The shafts are scene light, so they run before the curve. The map's own
415:     // sky, not the area's: a room owns the frame and shows none.
416:     const shaftSky = room ? null : base.sky;
417:     reordered =
418:       syncSunShafts(
419:         scene,
420:         camera,
421:         lightTier,
422:         tier,
423:         {
424:           sunColor: shaftSky
425:             ? toLinear(
426:                 shaftSky.sun === null ? shaftSky.zenith : shaftSky.sun ?? SKY_SUN_DEFAULT
427:               )
428:             : null,
429:           direction: shadow.direction,
430:         },
431:         post,
432:         reordered
433:       ) || reordered;
434: 
435:     // 6. post: the viewer's brightness only; the map's level is in the key.
436:     const brightness = shaped ? GameOptions.brightness / 10 : 0;
437:     const postExposure = 2 ** brightness;
438:     const toneMapperIndex =
439:       shaped && post
440:         ? Math.max(0, Math.min(3, Math.round(tmDev ?? GameOptions.toneMapper)))
441:         : 0;
442: 
443:     // The MU curve is what `toneMapper` 1 selects; it is the last scene-light
444:     // pass, so it runs after the haze and the mask and before the chain.
445:     reordered =
446:       syncToneMap(
447:         scene,
448:         camera,
449:         toneMapperIndex === 1,
450:         postExposure,
451:         reordered
452:       ) || reordered;
453: 
454:     // Bloom reads whatever the buffer holds, so a single aliased fragment can
455:     // be drawn as a pool of light. The guard bounds a pixel against its
456:     // neighbours ahead of the chain; the MU curve already bounds the whole
457:     // buffer, so the two are never live at once.
458:     reordered =
459:       syncFireflyGuard(
460:         scene,
461:         camera,
462:         shaped && post && GameOptions.bloom > 0 && toneMapperIndex !== 1,
463:         reordered
464:       ) || reordered;
465: 
466:     if (reordered) postChain.moveToEnd();
467: 
468:     postChain.set({
469:       shaped,
470:       exposure: postExposure,
471:       toneMapper: toneMapperIndex,
472:       whiteBalance: profile.whiteBalance,
473:     });
474: 
475:     // 7. publish
476:     const passes = [
477:       ...(shaped && post ? ['ssao'] : []),
478:       ...(inkOutlineLive() ? ['ink'] : []),
479:       ...(shaped && post && profile.fog.density > 0 ? ['haze'] : []),
480:       ...(roomMask.live ? ['roomMask'] : []),
481:       ...(sunShaftsLive() ? ['sunShafts'] : []),
482:       ...postChain.passes(),
483:     ];
484: 
485:     const ev = shaped ? profile.ev + evDev + brightness : 0;
486: 
487:     state = {
488:       engine: 'polish',
489:       tier,
490:       world,
491:       area: room,
492:       profile,
493:       key: {
494:         skyIntensity,
495:         skyColor: WHITE,
496:         skyGround: shaped ? [skyGround[0] * skyIntensity, skyGround[1] * skyIntensity, skyGround[2] * skyIntensity] : WHITE,
497:         sunIntensity: sunShare,
498:         direction: shadow.direction,
499:         emitterGain,
500:         sceneGain,
501:         roomShare,
502:       },
503:       shadow,
504:       ev,
505:       keyGain,
506:       exposure: keyGain * postExposure,
507:       toneMapper: TONE_MAPPER_NAMES[toneMapperIndex],
508:       style: style ? styleIndex() : 0,
509:       fogColorLinear,
510:       passes,
511:     };
512: 
513:     const next = [
514:       tier,
515:       world,
516:       areaKey(room),
517:       ev.toFixed(3),
518:       dim.toFixed(3),
519:       roomShare.toFixed(3),
520:       shadow.casters,
521:       toneMapperIndex,
522:       style ? styleIndex() : 0,
523:       profile.whiteBalance.map(v => v.toFixed(3)).join(),
524:       profile.fog.density.toFixed(4),
525:       passes.join(),
526:     ].join('|');
527: 
528:     if (next !== signature) {
529:       signature = next;
530:       onChange.notifyObservers(state);
531:     }
532: 
533:     if (!mapReady) {
534:       mapReady = true;
535:       EventBus.emit('look.mapReady', { world });
536:     }
537:   };
538: 
539:   const director: LookDirector = {
540:     setMap(next) {
541:       world = next;
542:       area = null;
543:       base = profileFor(next);
544:       target = base;
545:       from = shown = blendable(base);
546:       blend = 1;
547:       mapReady = false;
548:     },
549:     setOmen(name) {
550:       if (name === omen) return;
551:       omen = name;
552:       if (name) omenLook = omenProfile(name);
553:     },
554:     setArea(name, rect) {
555:       const next: LookArea | null = name
556:         ? {
557:             name,
558:             rect: rect ?? WHOLE_MAP,
559:             volume: rect && 'floorY' in rect ? rect : null,
560:           }
561:         : null;
562:       // A new frame under the same name is a new room.
563:       if (areaKey(next) === areaKey(area)) return;
564:       area = next;
565:       retarget();
566:       EventBus.emit('look.areaChanged', { name });
567:     },
568:     tick,
569:     state() {
570:       if (!state) tick(0);
571:       return state!;
572:     },
573:     onChange,
574:   };
575: 
576:   active = director;
577:   (globalThis as { __lighting?: unknown }).__lighting = director;
578: 
579:   return director;
580: }
