 17:  *
 18:  * MU's ground textures are 64 to 128 pixels over several tiles, which the
 19:  * ported camera never has a problem with - it looks down from twelve tiles up
 20:  * and no texel is ever more than a couple of pixels across. The first-person
 21:  * step put the eye 1.6 tiles off the ground, where the same texel covers a
 22:  * tenth of the screen and the ground under the player dissolves into a smear.
 23:  * Nothing can put resolution back into the art, but the ground does not have
 24:  * to be smooth while it is missing.
 25:  *
 26:  * It is a luminance modulation on the art, applied before the light: the
 27:  * ground keeps its own colour and its own brightness, and only gains a grain
 28:  * to hold the eye at close range. Identity on Classic, and with the material
 29:  * detail slider at 0.
 30:  */
 31: 
 32: /** Texels across the tiling grain. */
 33: const SIZE = 256;
 34: 
 35: /** Wraps of the grain per world tile. */
 36: const DETAIL_SCALE = 0.75;
 37: 
 38: /**
 39:  * View depth the grain fades over, in tiles. The ported camera sits twelve
 40:  * tiles up and the ground under the hero is fifteen to twenty away, so the
 41:  * whole effect is already gone at every ported zoom level; this is the eye's
 42:  * own.
 43:  */
 44: const DETAIL_NEAR = 4;
 45: const DETAIL_FAR = 14;
 46: 
 47: /** The most the grain moves the art, at the top of the detail slider. */
 48: const DETAIL_STRENGTH = 0.4;
 49: 
 50: /**
 51:  * Mip bias on the fetch.
 52:  *
 53:  * The ground at eye height is seen at a grazing angle, which is the case the
 54:  * mip chain exists to blur: at zero bias the hardware picks a level several
 55:  * texels wide and every fetch comes back at the field's mean, which is exactly
 56:  * the flat ground this is here to break up. Two levels of bias holds the grain
 57:  * over the range it is drawn in, and the fade above keeps it from reaching the
 58:  * distance where it would crawl.
 59:  */
 60: const DETAIL_LOD_BIAS = -2;
 61: 
 62: export const TERRAIN_DETAIL_SAMPLER = 'muGroundGrainMap';
 63: export const TERRAIN_DETAIL_UNIFORM = 'muGroundGrainStrength';
 64: 
 65: let grain: RawTexture | null = null;
 66: let grainScene: Scene | null = null;
 67: 
 68: /** The same integer hash the cloud field is built from. */
 69: function hash(x: number, y: number, seed: number): number {
 70:   let h = (Math.imul(x, 0x9e3779b1) ^ Math.imul(y, 0x85ebca6b) ^ seed) >>> 0;
 71:   h = Math.imul(h ^ (h >>> 15), 0x2c1b3c6d);
 72:   h = Math.imul(h ^ (h >>> 12), 0x297a2d39);
 73:   h ^= h >>> 15;
 74:   return (h >>> 0) / 0x100000000;
 75: }
 76: 
 77: const smooth = (t: number) => t * t * (3 - 2 * t);
 78: 
 79: /** One octave of tiling value noise at `cells` cells across the texture. */
 80: function octave(data: Float32Array, cells: number, weight: number, seed: number): void {
 81:   const step = SIZE / cells;
 82: 
 83:   for (let y = 0; y < SIZE; y++) {
 84:     const gy = y / step;
 85:     const y0 = Math.floor(gy);
 86:     const fy = smooth(gy - y0);
 87: 
 88:     for (let x = 0; x < SIZE; x++) {
 89:       const gx = x / step;
 90:       const x0 = Math.floor(gx);
 91:       const fx = smooth(gx - x0);
 92: 
 93:       const a = hash(x0 % cells, y0 % cells, seed);
 94:       const b = hash((x0 + 1) % cells, y0 % cells, seed);
 95:       const c = hash(x0 % cells, (y0 + 1) % cells, seed);
 96:       const d = hash((x0 + 1) % cells, (y0 + 1) % cells, seed);
 97: 
 98:       const top = a + (b - a) * fx;
 99:       const bottom = c + (d - c) * fx;
100: 
101:       data[y * SIZE + x] += (top + (bottom - top) * fy) * weight;
102:     }
103:   }
104: }
105: 
106: /**
107:  * Four octaves, the finest at one texel per cell, normalised so the mean sits
108:  * at 0.5 and the modulation is as often up as down.
109:  *
110:  * Mips, unlike the cloud field: this one is read across the whole depth range
111:  * at a grazing angle, which is the case the hardware's trilinear and
112:  * anisotropy exist for, and without them the grain crawls.
113:  */
114: function grainTexture(scene: Scene): RawTexture {
115:   if (grain && grainScene === scene) return grain;
116: 
117:   // A new scene: the old one's texture goes with it.
118:   grain?.dispose();
119: 
120:   const acc = new Float32Array(SIZE * SIZE);
121: 
122:   octave(acc, 16, 0.42, 0x37a1b2c3);
123:   octave(acc, 32, 0.28, 0x48b2c3d4);
124:   octave(acc, 64, 0.19, 0x59c3d4e5);
125:   octave(acc, 128, 0.11, 0x6ad4e5f6);
126: 
127:   let lo = Infinity;
128:   let hi = -Infinity;
129:   for (const v of acc) {
130:     if (v < lo) lo = v;
131:     if (v > hi) hi = v;
132:   }
133:   const span = hi - lo || 1;
134: 
135:   const bytes = new Uint8Array(SIZE * SIZE * 4);
136:   for (let i = 0; i < acc.length; i++) {
137:     const v = Math.round(((acc[i] - lo) / span) * 255);
138:     bytes[i * 4] = v;
139:     bytes[i * 4 + 1] = v;
140:     bytes[i * 4 + 2] = v;
141:     bytes[i * 4 + 3] = 255;
142:   }
143: 
144:   const { sampling, anisotropy } = textureFiltering();
145: 
146:   const texture = RawTexture.CreateRGBATexture(
147:     bytes,
148:     SIZE,
149:     SIZE,
150:     scene,
151:     true,
152:     false,
153:     sampling
154:   );
155: 
156:   texture.wrapU = Constants.TEXTURE_WRAP_ADDRESSMODE;
157:   texture.wrapV = Constants.TEXTURE_WRAP_ADDRESSMODE;
158:   texture.anisotropicFilteringLevel = anisotropy;
159:   texture.name = 'groundGrain';
160: 
161:   grain = texture;
162:   grainScene = scene;
163: 
164:   return texture;
165: }
166: 
167: 
168: /** 0 on Classic and with the detail slider down, which compiles to identity. */
169: function strength(): number {
170:   if (!materialQuality()) return 0;
171: 
172:   return DETAIL_STRENGTH * pbrDetailStrength();
173: }
174: 
175: export function bindTerrainDetail(effect: Effect, scene: Scene): void {
176:   effect.setTexture(TERRAIN_DETAIL_SAMPLER, grainTexture(scene));
177:   effect.setFloat(TERRAIN_DETAIL_UNIFORM, strength());
178: }
179: 
180: /** What the ground multiplies its art by. 1 while the strength is 0. */
181: export function terrainDetailGlsl(): string {
182:   return `
183:   uniform sampler2D ${TERRAIN_DETAIL_SAMPLER};
184:   uniform float ${TERRAIN_DETAIL_UNIFORM};
185: 
186:   float muGroundGrain(vec2 worldXZ, float viewZ) {
187:     if (${TERRAIN_DETAIL_UNIFORM} <= 0.0) return 1.0;
188: 
189:     float w = ${TERRAIN_DETAIL_UNIFORM} * (1.0 - smoothstep(
190:       ${DETAIL_NEAR.toFixed(1)},
191:       ${DETAIL_FAR.toFixed(1)},
192:       viewZ
193:     ));
194: 
195:     if (w <= 0.0) return 1.0;
196: 
197:     float n = texture2D(
198:       ${TERRAIN_DETAIL_SAMPLER},
199:       worldXZ * ${DETAIL_SCALE},
200:       ${DETAIL_LOD_BIAS.toFixed(1)}
201:     ).r;
202: 
203:     return 1.0 + (n - 0.5) * w;
204:   }
205: `;
206: }
