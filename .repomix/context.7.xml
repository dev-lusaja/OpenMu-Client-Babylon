1365:         // Full: drop the faintest, and among equally faint ones the furthest
1366:         // away - so a fresh press near the camera never loses to a stale one
1367:         // at the edge of the field.
1368:         if (presses.length >= TRAIL_SLOTS) {
1369:           let worst = 0;
1370: 
1371:           for (let i = 1; i < presses.length; i++) {
1372:             const p = presses[i];
1373:             const q = presses[worst];
1374: 
1375:             if (p.life < q.life - 0.01) {
1376:               worst = i;
1377:             } else if (p.life < q.life + 0.01) {
1378:               const dp = (p.x - centerX) ** 2 + (p.z - centerZ) ** 2;
1379:               const dq = (q.x - centerX) ** 2 + (q.z - centerZ) ** 2;
1380:               if (dp > dq) worst = i;
1381:             }
1382:           }
1383: 
1384:           presses.splice(worst, 1);
1385:         }
1386: 
1387:         presses.push({ x: a.x, z: a.z, life: 1, flying });
1388:       }
1389: 
1390:       for (const p of presses) {
