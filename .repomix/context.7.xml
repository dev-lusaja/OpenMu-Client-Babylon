 901:       // the front has gone by, which is what a burnt patch cools through.
 902:       f = mix(f, vec3(${EMBER_COLOUR[0].toFixed(2)}, ${EMBER_COLOUR[1].toFixed(2)}, ${EMBER_COLOUR[2].toFixed(2)}),
