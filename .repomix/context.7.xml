223: /**
224:  * A warp whose terrain cannot be loaded (a missing world folder, a corrupt
225:  * file, the dev server answering HTML) leaves the client on the map it was
226:  * on, out of the loading screen, with the failure logged - not on a loading
227:  * screen forever with a half-torn scene behind it. That is where it waits,
228:  * never where it stops: the destination is retried on a short backoff so the
229:  * client ends up where the server has already put the character.
230:  */
231: function failWarp(
232:   world: World,
233:   map: ENUM_WORLD,
234:   oldMap: ENUM_WORLD,
235:   error: unknown,
236:   pos?: { x: number; y: number },
237:   attempt = 0
238: ) {
239:   console.error(`Could not load world ${map}; staying on ${oldMap}:`, error);
240:   world.mapIndex = oldMap;
241:   setShadowWorld(oldMap);
242:   Store.setSceneLoading(false);
243:   EventBus.emit('warpFailed', { map, error });
244: 
245:   const delay = WARP_RETRY_DELAYS_MS[attempt];
246:   if (delay === undefined) return;
247: 
248:   setTimeout(() => {
249:     // A warp of its own since, or the map arrived some other way: that one
250:     // owns the scene now.
251:     if (world.mapIndex !== oldMap || sceneMap === map) return;
252:     loadMapIntoScene(world, map, pos, attempt + 1);
253:   }, delay);
254: }
255: 
256: /**
257:  * Rebuild the map's objects in place - every record back through
258:  * `createObjects` under the current options. The scenery batching toggle
259:  * changes which path a record takes, and that is decided at creation.
260:  */
261: export function reloadMapObjects(): Promise<void> {
262:   loadQueue = loadQueue.then(() => {
263:     const world = sceneWorld;
264:     if (!world || !world.terrain || world.mapIndex !== sceneMap) return;
265: 
266:     // A copy: `world.remove` mutates the live query while it is iterated.
267:     for (const e of [...world.with('modelId', 'worldIndex')]) {
268:       if (e.worldIndex !== sceneMap) continue;
269:       world.remove(e);
270:       e.modelObject?.dispose();
271:     }
272: 
273:     disposePropBatches();
274: 
275:     createObjects(world, sceneObjects);
276:   });
277: 
278:   return loadQueue;
279: }
280: 
281: export function loadMapIntoScene(
282:   world: World,
283:   map: ENUM_WORLD,
284:   pos?: { x: number; y: number },
285:   attempt = 0
286: ): Promise<void> {
287:   const serial = ++warpSerial;
288: 
289:   // Here, not in `runLoad`: the load is queued behind a microtask, while the
290:   // packet the warp came from is dispatched in a loop that drains the whole
291:   // received frame first. Everything the server puts in scope in that frame -
292:   // the players and NPCs already standing on the map we are being placed on -
293:   // would otherwise be stamped with the map we are leaving, and swept by this
294:   // load's `unloadMap`. The scene teardown keys off `sceneMap`, not this, so
295:   // running ahead is what this field is for.
296:   world.mapIndex = map;
297: 
298:   loadQueue = loadQueue
299:     .then(() => runLoad(world, map, pos, serial, attempt))
300:     // Unexpected failures (a map entry's `create`, object creation) used to
301:     // be unhandled rejections that also left the loading screen up: same
302:     // recovery as a failed terrain build.
303:     .catch(error => failWarp(world, map, sceneMap, error, pos, attempt));
304:   return loadQueue;
305: }
306: 
307: async function runLoad(
308:   world: World,
309:   map: ENUM_WORLD,
310:   pos: { x: number; y: number } | undefined,
311:   serial: number,
312:   attempt: number
313: ) {
314:   // Superseded while queued: the newest request does the whole job itself,
315:   // and already owns `world.mapIndex`.
316:   if (serial !== warpSerial) return;
317: 
318:   const oldMap = sceneMap;
319: 
320:   // Before anything loads: a shadowless world (Icarus) must not build blob
321:   // clones for the objects it is about to create.
322:   setShadowWorld(map);
323: 
324:   if (oldMap !== map) {
325:     // Download and parse first, while the old map is still whole: every
326:     // failure that can be recovered from happens here.
327:     let prepared: PreparedTerrain;
328:     try {
329:       prepared = await prepareTerrain(world.scene, map);
330:     } catch (error) {
331:       if (serial === warpSerial) failWarp(world, map, oldMap, error, pos, attempt);
332:       return;
333:     }
334: 
335:     // Another warp was requested while this one downloaded; it owns the
336:     // scene now.
337:     if (serial !== warpSerial) {
338:       disposePreparedTerrain(prepared);
339:       return;
340:     }
341: 
342:     unloadMap(world, oldMap, map);
343: 
344:     // Weather is global - the proxy computes one sky for every client, and the
345:     // packet is not re-sent on warp - so `Store.weather` deliberately carries
346:     // across the gate: the same shower really is still falling on the far side.
347:     // What is reset is only `RainCurrent`, so the rain fades back in over its
348:     // ramp instead of being at full strength in the first frame of a map the
349:     // player has not seen yet. Whether it may fall here at all is the rain
350:     // slot's business (`maps.isOutdoor` / `SNOW_MAPS`), not this line's.
351:     weather.reset();
352:     // Every light source registered against the old terrain light field;
353:     // the field is rebuilt from the new bake and nothing may outlive it.
354:     lighting.reset();
355:     // Every live skill effect and pooled card belongs to the old scene graph.
356:     effects.reset();
357:     // Every event window, clock and result box belongs to the map just left.
358:     events.reset();
359:     // Re-use delays belong to the world just left; buff stamps are rebased.
360:     skills.reset();
361:     // Swing latch, Nova charge, Dark Side follow-ups: all aimed at the old map.
362:     combat.reset();
363:     // The NPC quest dialogs belong to the NPC just walked away from; quest
364:     // states are the character's and survive.
365:     quests.reset();
366:     // The old map's ambient beds, the footstep latch, the listener pin.
367:     sound.reset();
368:     // Whatever a map entry kept for the world just left.
369:     maps.reset();
370:     // Before the new map's terrain material binds the mask: otherwise the
371:     // first frames of a snow map would be masked by the last map's roofs.
372:     resetTerrainMask();
373: 
374:     let built: Awaited<ReturnType<typeof getTerrainData>>;
375:     try {
376:       built = await getTerrainData(world, map, prepared);
377:     } catch (error) {
378:       // The old map is already gone; the client is at least out of the
379:       // loading screen and can be warped again.
380:       failWarp(world, map, oldMap, error, pos, attempt);
381:       return;
382:     }
383: 
384:     // Superseded during the terrain build: nothing of this map has reached
385:     // the world yet, so only the build's own mesh has to go. The newer load
386:     // starts from the already torn-down scene.
387:     if (serial !== warpSerial) {
388:       built.terrain.material?.dispose(true, true);
389:       built.terrain.dispose(false, true);
390:       return;
391:     }
392: 
393:     const {
394:       objects,
395:       terrain,
396:       RequestTerrainHeight,
397:       IsWalkable,
398:       RequestTerrainFlag,
399:       SetTerrainFlags,
400:       GetTerrainTile,
401:       GetTerrainLayers,
402:       RequestTerrainLight,
403:     } = built;
404: 
405:     world.getTerrainHeight = RequestTerrainHeight;
406:     world.isWalkable = IsWalkable;
407:     world.getTerrainFlag = RequestTerrainFlag;
408:     world.setTerrainFlags = SetTerrainFlags;
409:     world.getTerrainTile = GetTerrainTile;
410:     world.getTerrainLayers = GetTerrainLayers;
411:     world.getTerrainLight = RequestTerrainLight;
412: 
413:     // `CNewUIMiniMap::LoadImages` runs on map change. The 4 MB mini_map.ozt
414:     // is only fetched into the HTTP cache here; the TGA decode (a long task
415:     // on the warp's critical path) waits for the first TAB, and the maps
416:     // left behind release theirs.
417:     evictWorldMinimaps(map);
418:     prefetchWorldMinimap(map);
419: 
420:     // `RenderTerrain` is skipped outright for the sky map (MainScene.cpp:402):
421:     // the mesh exists for its height field only.
422:     if (map === ENUM_WORLD.WD_10ICARUS) {
423:       terrain.isVisible = false;
424:     }
425: 
426:     world.terrain = {
427:       mesh: terrain,
428:       MapTileObjects: new Array(256).fill(MapTileObject),
429:       extraHeight: 0,
430:     };
431: 
432:     await loadWorld(world);
433: 
434:     const filteredObjects = objects;
435: 
436:     applyMapObjectFixups(map, filteredObjects);
437: 
438:     sceneObjects = filteredObjects;
439:     sceneWorld = world;
440: 
441:     if (!DISABLE_OBJECTS_LOADING) createObjects(world, filteredObjects);
442:   }
443: 
444:   sceneMap = map;
445: 
446:   // A newer warp was requested while this map's own setup ran: it owns the
447:   // hero's position and the ready handshake, and tears this scene down once
448:   // its files are in. Saying the warp completed here would send the server's
449:   // `ClientReadyAfterMapChange` for the wrong map.
450:   if (serial !== warpSerial) return;
451: 
452:   if (world.playerEntity) {
453:     world.playerEntity.worldIndex = map;
454:     const playerPos = world.playerEntity.transform.pos;
455: 
456:     if (pos) {
457:       playerPos.x = pos.x;
458:       playerPos.z = pos.y;
459:     } else {
460:       const spawn = maps.spawn(map);
461: 
462:       if (spawn) {
463:         playerPos.x = spawn.x;
464:         playerPos.z = spawn.y;
465:       }
466:     }
467: 
468:     playerPos.y = world.getTerrainHeight(playerPos.x, playerPos.z);
469: 
470:     const { pathfinding } = world.playerEntity;
471:     pathfinding.path = null;
472:     pathfinding.from = { x: playerPos.x, y: playerPos.z };
473:     pathfinding.to = { x: playerPos.x, y: playerPos.z };
474: 
475:     Store.syncPlayerAppearance();
476:   }
477: 
478:   EventBus.emit('warpCompleted', { map });
479: }
</file>

<file path="src/libs/mu/preloadSprites.ts">
 1: import { clearSpriteCache, loadInterfaceSprite } from './sprites';
 2: import { loadVersionUi } from '../../version';
 3: 
 4: /**
 5:  * Decoding the interface sheets up front, in two waves: the pre-game screens
 6:  * before the start menu paints, the world sheets on entry (without them each
 7:  * window decoded its own on first open - an empty first paint per
 8:  * `MuSpriteFrame`, one state update each).
 9:  *
10:  * *Which* files is the active version's answer (`versions/<id>/ui/preload.ts`):
11:  * a period `Data/Interface/` and the Season 6 one share almost no names.
12:  * When and how stays here.
13:  */
14: 
15: let pending: Promise<void> | null = null;
16: 
17: export function preloadPregameSprites(
18:   onProgress?: (done: number, total: number) => void
19: ): Promise<void> {
20:   if (pending) return pending;
21: 
22:   pending = loadVersionUi().then(async ({ preload }) => {
23:     const files = preload.pregameSprites;
24:     const total = files.length;
25:     let done = 0;
26: 
27:     for (const file of files) {
28:       try {
29:         await loadInterfaceSprite(file);
30:       } catch (err) {
31:         console.error(`Could not preload ${file}:`, err);
32:       } finally {
33:         onProgress?.(++done, total);
34:       }
35:       // Yield to the browser main loop between image decodes to keep frames smooth
36:       await new Promise(resolve => setTimeout(resolve, 0));
37:     }
38:   });
39: 
40:   return pending;
41: }
42: 
43: let worldPending: Promise<void> | null = null;
44: let worldKeys: ReadonlySet<string> = new Set();
45: 
46: export function preloadWorldSprites(): Promise<void> {
47:   if (worldPending) return worldPending;
48: 
49:   worldPending = loadVersionUi().then(async ({ preload }) => {
50:     const files = preload.worldSprites;
51: 
52:     worldKeys = new Set(
53:       files.map(file => `interface/${file}`.toLowerCase())
54:     );
55: 
56:     for (const file of files) {
57:       try {
58:         await loadInterfaceSprite(file);
59:       } catch (err) {
60:         console.error(`Could not preload ${file}:`, err);
61:       }
62:       await new Promise(resolve => setTimeout(resolve, 0));
63:     }
64:   });
65: 
66:   return worldPending;
67: }
68: 
69: /**
70:  * Drop the world sprites (blob URLs revoked) when the hero leaves the
71:  * world; the pregame sheets stay, the login / character screens still show
72:  * them. `preloadWorldSprites` runs again on the next entry.
73:  */
74: export function clearWorldSprites(): void {
75:   clearSpriteCache(key => worldKeys.has(key));
76:   worldPending = null;
77: }
</file>

<file path="src/libs/mu/terrainMaterial.ts">
  1: import { type Scene, ShaderMaterial, type Texture } from '../babylon/exports';
  2: import {
  3:   bindTerrainOverlays,
  4:   terrainOverlayDeclarationsGlsl,
  5:   terrainOverlayGlsl,
  6:   terrainOverlayLitGlsl,
  7:   terrainOverlayReflectGlsl,
  8:   terrainOverlayUniforms,
  9:   hasTrail,
 10:   type TerrainOverlay,
 11: } from './terrainOverlay';
 12: import type { TileTextureArray } from './tileTextureArray';
 13: import {
 14:   bindTerrainDetail,
 15:   terrainDetailGlsl,
 16:   TERRAIN_DETAIL_SAMPLER,
 17:   TERRAIN_DETAIL_UNIFORM,
 18: } from './terrainDetail';
 19: import {
 20:   CLOUD_UNIFORMS,
 21:   TERRAIN_CSM_SAMPLERS,
 22:   TERRAIN_LIGHT_UNIFORMS,
 23:   bindTerrainLight,
 24:   startTerrainClock,
 25:   terrainClock,
 26:   terrainGroundLightGlsl,
 27:   terrainLightDeclarationsGlsl,
 28:   terrainLightDefines,
 29:   terrainLightSamplers,
 30:   terrainSkyLightGlsl,
 31: } from './terrainLighting';
 32: import { registerTerrainMaterial } from '../../scenes/shadows';
 33: import { grassBurnActive, grassBurnTexture } from '../../weather/grassBurn';
 34: import {
 35:   bindTerrainWater,
 36:   disposeTerrainWaterFrames,
 37:   terrainWaterAlphaSkipGlsl,
 38:   terrainWaterCausticsGlsl,
 39:   terrainWaterGrassWindGlsl,
 40:   terrainWaterSamplers,
 41:   terrainWaterUniforms,
 42:   terrainWaterVertexDeclarationsGlsl,
 43:   terrainWaterVertexGlsl,
 44:   type TerrainWaterRuntime,
 45: } from './terrainWater';
 46: 
 47: /**
 48:  * What the ground keeps where the fire has been over it. A multiplier, so a
 49:  * scar still takes the sun and the torches rather than sitting on the map as
 50:  * a flat decal - and not zero, because ash is dark, not a hole.
 51:  */
 52: const BURN_GROUND = [0.13, 0.11, 0.10] as const;
 53: 
 54: const FINAL_COLOR_VAR_NAME = `finalColor`;
 55: 
 56: /**
 57:  * Index of the animated water tile in `getTilesList` - the one layer whose UV
 58:  * scrolls. Kept as the same magic 5 the branch chain used.
 59:  */
 60: const WATER_LAYER = 5;
 61: 
 62: /**
 63:  * Flip to false to go back to the per-texture `if` chain (one `sampler2D`
 64:  * array, 2N conditional fetches per pixel). Kept so the two can be measured
 65:  * against each other, and as a one-line escape hatch if the packed array
 66:  * turns out to sample differently on some driver.
 67:  */
 68: const USE_TILE_TEXTURE_ARRAY = true;
 69: 
 70: /**
 71:  * The old path: `textures[i]` cannot be indexed by a per-fragment value in
 72:  * GLSL, so every layer got its own guarded `texture2D`, twice.
 73:  */
 74: function branchChainGlsl(
 75:   texturesData: { texture: Texture; scale: number }[]
 76: ): string {
 77:   return texturesData
 78:     .map((textureData, i) => {
 79:       const uv = `vUV * ${textureData.scale.toFixed(1)}${
 80:         i === WATER_LAYER ? ` + vec2(WaterMove,GrassWind)` : ''
 81:       }`;
 82: 
 83:       return `
 84:   if (m1 >= ${i}.0 && m1 < ${i}.5) {
 85:       opaqueColor = texture2D(textures[${i}], ${uv}).rgb;
 86:   }
 87:   if (m2 >= ${i}.0 && m2 < ${i}.5) {
 88:       alphaColor = texture2D(textures[${i}], ${uv}).rgb;
 89:       alphaRendered = true;
 90:   }
 91:   `;
 92:     })
 93:     .join('');
 94: }
 95: 
 96: /**
 97:  * The packed path: two array fetches, layer picked by the splat index.
 98:  *
 99:  * The `valid` tests reproduce what the branch chain did by omission - a tile
100:  * index the map references but the world has no texture for matched no branch
101:  * and left the colour black. Here the same index would read past
102:  * `tileScales`, which is undefined behaviour, so it is tested rather than
103:  * clamped. `vAlphaTexture` is -1 when a tile has no second layer.
104:  */
105: function textureArrayGlsl(layers: number): string {
106:   return `
107:   int layer1 = int(m1);
108:   int layer2 = int(m2);
109: 
110:   bool valid1 = layer1 >= 0 && layer1 < ${layers};
111:   bool valid2 = vAlphaTexture >= 0.0 && layer2 >= 0 && layer2 < ${layers};
112: 
113:   int index1 = valid1 ? layer1 : 0;
114:   int index2 = valid2 ? layer2 : 0;
115: 
116:   vec2 uv1 = vUV * tileScales[index1];
117:   vec2 uv2 = vUV * tileScales[index2];
118: 
119:   if (index1 == ${WATER_LAYER}) uv1 += vec2(WaterMove, GrassWind);
120:   if (index2 == ${WATER_LAYER}) uv2 += vec2(WaterMove, GrassWind);
121: 
122:   // Flat tones read the art with a mip bias, so the grain of a texel never
123:   // makes it to the levels (renderingStyle.ts).
124:   #ifdef MU_TOON_FLAT
125:   if (valid1) {
126:       opaqueColor = texture2D(tileTextures, vec3(uv1, float(index1)), muToonFilter.x).rgb;
127:   }
128: 
129:   if (valid2) {
130:       alphaColor = texture2D(tileTextures, vec3(uv2, float(index2)), muToonFilter.x).rgb;
131:       alphaRendered = true;
132:   }
133:   #else
134:   if (valid1) {
135:       opaqueColor = texture2D(tileTextures, vec3(uv1, float(index1))).rgb;
136:   }
137: 
138:   if (valid2) {
139:       alphaColor = texture2D(tileTextures, vec3(uv2, float(index2))).rgb;
140:       alphaRendered = true;
141:   }
142:   #endif
143:   `;
144: }
145: 
146: /**
147:  * The `AlphaTile*` slot: a hole in the ground, not a texture.
148:  *
149:  * `RenderFace` (ZzzLodTerrain.cpp:1394-1435) draws that one slot through
150:  * `EnableAlphaTest` and every other through `DisableAlphaBlend`, and every
151:  * `AlphaTile*.Tga` in the data set is zero in every byte, so the face
152:  * contributes nothing (`MapLayer.cutoutTile`).
153:  *
154:  * The tile whose second layer covers it fully never gets here: the mesh
155:  * already puts layer 2 in `vOpaqueTexture` for those, which is the same rule
156:  * `RenderTerrainFace` picks its base texture by (customGroundMesh.ts:161).
157:  * Under that the original alpha-tests the base away and blends layer 2 over
158:  * the void at the vertex alpha; one opaque pass can only test, so a partial
159:  * second layer takes a 0.5 cut - 11 tiles of the 309 on Elbeland, the only
160:  * map that declares a cutout today.
161:  *
162:  * Emitted only for a map that has one, so every other terrain shader keeps
163:  * its early-Z.
164:  */
165: function cutoutGlsl(slot: number): string {
166:   return `
167:     if (int(m1) == ${slot}) {
168:       if (!alphaRendered || vAlphaColor.a < 0.5) discard;
169:       opaqueColor = alphaColor;
170:     }
171:   `;
172: }
173: 
174: export function createTerrainMaterial(
175:   scene: Scene,
176:   { name }: { name: string },
177:   config: {
178:     texturesData: { texture: Texture; scale: number }[];
179:     /** Packed layers; when present the shader takes the array path. */
180:     tileArray?: TileTextureArray | null;
181:     /** Ground-contact weather layers for this map; empty = shader unchanged. */
182:     overlays?: readonly TerrainOverlay[];
183:     /** Animated water for this map (terrainWater.ts); null = shader unchanged. */
184:     water?: TerrainWaterRuntime | null;
185:     /** The map's `AlphaTile*` slot (`MapLayer.cutoutTile`); null = no cutout. */
186:     cutout?: number | null;
187:   }
188: ) {
189:   const tileArray = USE_TILE_TEXTURE_ARRAY ? config.tileArray ?? null : null;
190:   const water = config.water ?? null;
191:   const cutout = config.cutout ?? null;
192:   // The ploughed-trail map is one more sampler, and the per-tile fallback
193:   // path already spends every one of WebGL's guaranteed 16 fragment units
194:   // (13 tiles + the light map + two cascades). On that path the trail is
195:   // dropped rather than the whole terrain failing to link.
196:   const overlays = (config.overlays ?? []).map(o =>
197:     o.trail && !tileArray ? { ...o, trail: false } : o
198:   );
199: 
200:   const finalColorStr = tileArray
201:     ? textureArrayGlsl(tileArray.layers)
202:     : branchChainGlsl(config.texturesData);
203: 
204:   const terrainMaterial = new ShaderMaterial(
205:     'SplatTerrainMaterial' + name,
206:     scene,
207:     {
208:       vertexSource: `
209:   precision highp float;
210:   attribute vec3 position;
211:   attribute vec3 normal;
212:   attribute vec2 uv;
213:   attribute vec2 uv2;
214:   attribute vec4 color;
215:   attribute vec4 matricesWeights; // used for alpha blending
216:   uniform mat4 viewProjection;
217:   uniform mat4 view;
218:   uniform mat4 world;
219:   varying vec2 vUV;
220:   flat varying float vOpaqueTexture;
221:   flat varying float vAlphaTexture;
222:   varying vec4 vColor;
223:   varying vec4 vAlphaColor;
224:   varying vec2 vWorldXZ;
225:   varying vec3 vWorldPos;
226:   varying vec3 vNormal;
227:   varying float vViewZ;
228: 
229: ${water ? terrainWaterVertexDeclarationsGlsl() : ''}
230: 
231:   void main() {
232:       vec4 p = vec4(position, 1.);
233:       vec4 worldPosition = world * p;
234: ${water ? terrainWaterVertexGlsl(water.spec) : ''}
235:       vUV = uv;
236:       vOpaqueTexture = uv2.x;
237:       vAlphaTexture = uv2.y;
238:       vColor = color;
239:       vAlphaColor = matricesWeights;
240:       vWorldXZ = worldPosition.xz;
241:       vWorldPos = worldPosition.xyz;
242:       // Guarded: ComputeNormals leaves a zero normal on any degenerate quad,
243:       // and normalize(vec3(0)) is a NaN that the overlay's slope test would
244:       // carry straight into gl_FragColor as a black fragment.
245:       vec3 n = (world * vec4(normal, 0.0)).xyz;
246:       vNormal = dot(n, n) > 0.0 ? normalize(n) : vec3(0.0, 1.0, 0.0);
247:       vViewZ = (view * worldPosition).z;
248:       gl_Position = viewProjection * worldPosition;
249:   }
250:   `,
251:       fragmentSource: `
252:   precision highp float;
253: ${
254:   tileArray
255:     ? `  uniform highp sampler2DArray tileTextures;
256:   uniform float tileScales[${tileArray.layers}];
257:   uniform sampler2D terrainBurn;
258:   uniform float terrainBurnOn;`
259:     : `  uniform sampler2D textures[${config.texturesData.length}];`
260: }
261: ${water && water.frames.length ? `  uniform sampler2D waterFlip;` : ''}
262:   varying vec2 vUV;
263:   flat varying float vOpaqueTexture;
264:   flat varying float vAlphaTexture;
265:   varying vec4 vColor;
266:   varying vec4 vAlphaColor;
267:   varying vec2 vWorldXZ;
268:   varying vec3 vWorldPos;
269:   varying vec3 vNormal;
270:   varying float vViewZ;
271: 
272: ${terrainLightDeclarationsGlsl(!!tileArray)}
273: ${terrainOverlayDeclarationsGlsl(overlays)}
274: ${tileArray ? terrainDetailGlsl() : ''}
275: 
276:   void main()
277:   {
278:     float m1 = vOpaqueTexture + 0.1;
279:     float m2 = vAlphaTexture + 0.1;
280:     bool alphaRendered = false;
281: 
282:     float WaterMove = float(int(time*50.0) % 20000) * 0.0005;
283:     float WindSpeed = float(int(time*200.0) % 72000) * 0.004;
284:     float GrassWind = ${water ? terrainWaterGrassWindGlsl() : '0.0'};
285: 
286:     vec4 ${FINAL_COLOR_VAR_NAME} = vec4(0.0);
287: 
288:     vec3 opaqueColor = vec3(0.0);
289:     vec3 alphaColor = vec3(0.0);
290: 
291:     ${finalColorStr}
292: ${water ? terrainWaterAlphaSkipGlsl(water) : ''}
293: ${cutout === null ? '' : cutoutGlsl(cutout)}
294:     ${FINAL_COLOR_VAR_NAME} = vec4(opaqueColor, 1.0);
295: 
296:     if(alphaRendered){
297:       ${FINAL_COLOR_VAR_NAME} *= (1.0 - vAlphaColor.a);
298:       ${FINAL_COLOR_VAR_NAME} += vec4(alphaColor, 1.0) * vAlphaColor.a;
299:     }
300: 
301:     // On the art, before any light touches it: the ground keeps its colour and
302:     // its level and only gains a grain to hold the eye at close range. Packed
303:     // path only, like the cloud field - the per-tile fallback has no sampler
304:     // unit left to spend.
305: ${
306:   tileArray
307:     ? `
308:   #ifndef MU_TOON_FLAT
309:     ${FINAL_COLOR_VAR_NAME}.rgb *= muGroundGrain(vWorldXZ, vViewZ);
310:   #endif`
311:     : ''
312: }
313: 
314:     // Flat tones on the ground's art, before any light touches it, like the
315:     // models' (renderingStyle.ts). The grain above has no place in them.
316:   #ifdef MU_TOON_FLAT
317:     ${FINAL_COLOR_VAR_NAME}.rgb = muToonFlat(${FINAL_COLOR_VAR_NAME}.rgb, muToonFilter.y);
318:   #endif
319: 
320: ${terrainSkyLightGlsl()}
321: 
322:     ${terrainOverlayGlsl(overlays, FINAL_COLOR_VAR_NAME, 'skyOpen')}
323: 
324: ${terrainGroundLightGlsl({ bake: 'vColor.rgb', clouds: !!tileArray })}
325:     // A ground overlay that is its own material (snow) takes over its share
326:     // of this term - see terrainOverlayLitGlsl.
327: ${terrainOverlayLitGlsl(
328:   overlays,
329:   'lit',
330:   'groundLit',
331:   'vColor',
332:   'sunShadow',
333:   'extraLit'
334: )}
335:     vec3 f = ${FINAL_COLOR_VAR_NAME}.rgb * max(lit, 0.0);
336: 
337:     // A torch does not only brighten the stone beside it, it colours it. The
338:     // light the texel was multiplied by is handed back in, so both arguments
339:     // are in one space and a neutral bake tints nothing.
340:     f = muLightTint(f, max(lit, 0.0));
341: 
342:     // Standing water reflects the sky and the torches - light the ground
343:     // under it never had, so it is added after the lighting.
344: ${terrainOverlayReflectGlsl(overlays, 'f', 'sunShadow')}
345: ${water ? terrainWaterCausticsGlsl(water, 'f') : ''}
346: 
347: ${
348:   tileArray
349:     ? `
350:     // Ground the fire has been over (weather/grassBurn.ts). The grass above
351:     // it dissolves blade by blade, and on its own that reads as nothing: a
352:     // field with fewer blades in it is still a green field, and what a burnt
353:     // patch actually is on screen is *dark ground*. So the same scar the
354:     // blades read darkens what they stand on.
355:     //
356:     // Multiplied, not mixed to a colour: burnt ground still takes the sun, the
357:     // torches and the cascades, and a scar that ignored them would be a decal
358:     // lying on the map rather than part of it.
359:     //
360:     // Packed path only, like the detail grain and the cloud field above it -
361:     // the per-tile fallback has already spent every one of WebGL's guaranteed
362:     // sixteen fragment units, and a seventeenth is a draw error that takes the
363:     // terrain with it.
364:     float burnt = texture2D(terrainBurn, vWorldXZ / 256.0).r * terrainBurnOn;
365:     f *= mix(vec3(1.0), vec3(${BURN_GROUND[0].toFixed(3)}, ${BURN_GROUND[1].toFixed(3)}, ${BURN_GROUND[2].toFixed(3)}), burnt);`
366:     : ''
367: }
368: 
369:     // When image processing runs in post the buffer is linear, and
370:     // Babylon's Standard fragment ends with toLinearSpace(color) - the same
371:     // pow(2.2). linearOut is 0 whenever the objects skip the decode too.
372:     f = mix(f, pow(max(f, vec3(0.0)), vec3(2.2)), linearOut);
373: 
374:     gl_FragColor = vec4(f, 1.0);
375:   }
376:   `,
377:     },
378:     {
379:       attributes: [
380:         'position',
381:         'normal',
382:         'uv',
383:         'uv2',
384:         'color',
385:         'matricesWeights',
386:       ],
387:       uniforms: [
388:         'view',
389:         'world',
390:         'viewProjection',
391:         ...TERRAIN_LIGHT_UNIFORMS,
392:         ...(tileArray ? CLOUD_UNIFORMS : []),
393:         ...(tileArray ? [TERRAIN_DETAIL_UNIFORM] : []),
394:         ...(tileArray ? ['tileScales', 'terrainBurnOn'] : []),
395:         ...terrainOverlayUniforms(overlays),
396:         ...(water ? terrainWaterUniforms() : []),
397:       ],
398:       // `textures[N]` is expanded to N consecutive units starting at its own
399:       // slot; if it comes first, the shadow-map array samplers land on units
400:       // the 2D array already uses - two sampler types on one unit is a GL
401:       // draw error and the terrain renders flat. Keep the array last. The
402:       // packed path has no sampler array at all, but the ordering rule costs
403:       // nothing to keep.
404:       samplers: [
405:         ...terrainLightSamplers(!!tileArray),
406:         // The grain rides the packed path only, like the cloud field: the
407:         // per-tile fallback already spends every one of WebGL's guaranteed
408:         // 16 fragment units.
409:         ...(tileArray ? [TERRAIN_DETAIL_SAMPLER] : []),
410:         ...(hasTrail(overlays) ? ['ovTrail'] : []),
411:         ...(tileArray ? ['terrainBurn'] : []),
412:         ...(water ? terrainWaterSamplers(water) : []),
413:         ...TERRAIN_CSM_SAMPLERS,
414:         ...(tileArray ? ['tileTextures'] : ['textures']),
415:       ],
416:       defines: terrainLightDefines(),
417:       needAlphaBlending: false,
418:       needAlphaTesting: false,
419:     }
420:   ) as ShaderMaterial;
421: 
422:   terrainMaterial.fogEnabled = false;
423:   terrainMaterial.backFaceCulling = true;
424:   terrainMaterial.transparencyMode = 0;
425: 
426:   // The clock the grass rooted in this ground shares (terrainLighting.ts).
427:   startTerrainClock();
428: 
429:   const textures = config.texturesData.map(t => t.texture);
430: 
431:   terrainMaterial.onBindObservable.add(m => {
432:     const effect = m.material?.getEffect();
433: 
434:     if (!effect) return;
435: 
436:     bindTerrainLight(effect, scene, !!tileArray);
437: 
438:     if (tileArray) {
439:       effect.setTexture('tileTextures', tileArray.texture);
440:       effect.setFloatArray('tileScales', tileArray.scales);
441:       bindTerrainDetail(effect, scene);
442:       // Always bound, burnt or not: an unbound sampler here is a draw error
443:       // and it takes the whole terrain with it. A map nothing has burned on
444:       // holds a zero texture, and `terrainBurnOn` is what saves the fetch.
445:       effect.setTexture('terrainBurn', grassBurnTexture(scene));
446:       effect.setFloat('terrainBurnOn', grassBurnActive() ? 1 : 0);
447:     } else {
448:       effect.setTextureArray('textures', textures);
449:     }
450:     bindTerrainOverlays(effect, overlays, scene);
451:     if (water) bindTerrainWater(effect, water, terrainClock(), scene);
452:   });
453: 
454:   registerTerrainMaterial(terrainMaterial);
455: 
456:   terrainMaterial.freeze();
457: 
458:   terrainMaterial.onDisposeObservable.addOnce(() => {
459:     textures.forEach(t => {
460:       t.dispose();
461:     });
462:     tileArray?.texture.dispose();
463:     if (water) disposeTerrainWaterFrames(water.frames);
464:   });
465: 
466:   return terrainMaterial;
467: }
