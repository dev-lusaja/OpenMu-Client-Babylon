1206:           if (y < minY) minY = y;
1207:           if (y + height > maxY) maxY = y + height;
1208:         }
1209:       }
1210:     }
1211: 
1212:     if (!roots.length) {
1213:       // Nothing grows here. Recorded so residency does not retry it every
1214:       // frame for as long as the player stands nearby.
1215:       blocks.set(key, null);
1216:       return;
1217:     }
1218: 
1219:     const mesh = new Mesh(`_grass_${key}`, scene);
1220:     blade.applyToMesh(mesh, false);
1221: 
1222:     mesh.material = material;
1223:     mesh.isPickable = false;
1224:     mesh.doNotSyncBoundingInfo = true;
1225:     mesh.alwaysSelectAsActiveMesh = false;
1226: 
1227:     mesh.thinInstanceSetBuffer('iRoot', new Float32Array(roots), 4, true);
1228:     mesh.thinInstanceSetBuffer('iTint', new Float32Array(tints), 4, true);
1229: 
1230:     // `forcedInstanceCount`, not `thinInstanceCount`: the latter's setter
1231:     // sizes itself against the *matrix* buffer and silently ignores any
1232:     // count when there is none (thinInstanceMesh.js:75-81), and this layer
1233:     // carries no matrices - a 4x4 per blade would be 64 bytes to hold a yaw
1234:     // the vertex shader rebuilds from `iRoot.w` in two instructions. Both
1235:     // satisfy `hasThinInstances` and both drive the instanced draw
1236:     // (mesh.js:205, :1542).
1237:     mesh.forcedInstanceCount = roots.length / 4;
1238: 
1239:     // Set by hand: `thinInstanceRefreshBoundingInfo` derives bounds from a
1240:     // matrix buffer this layer deliberately does not carry, and the block
1241:     // already knows its own footprint. The bend can push a tip a blade's
1242:     // height past the tile edge, hence the margin.
1243:     mesh.setBoundingInfo(
1244:       new BoundingInfo(
1245:         new Vector3(bx - BLADE_MAX_H, minY, bz - BLADE_MAX_H),
1246:         new Vector3(
1247:           bx + BLOCK_TILES + BLADE_MAX_H,
1248:           maxY,
1249:           bz + BLOCK_TILES + BLADE_MAX_H
1250:         )
1251:       )
1252:     );
1253: 
1254:     blocks.set(key, mesh);
1255:   }
