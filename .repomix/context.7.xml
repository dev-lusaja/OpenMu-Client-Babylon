 712:       // Trodden or blown, the blade bows from the root, so the same v*v the
 713:       // wind uses - the base stays where it grew.
 714:       world.xz += shove * (v * v * height);
 715:       world.y -= min(trodden, 1.0) * v * height * 0.25;`
 716:     : ''
 717: }
 718: 
 719:       vWorldXZ = world.xz;
 720:       vWorldPos = world;
 721:       vViewZ = (view * vec4(world, 1.0)).z;
 722:       vBake = iTint.rgb;
 723:       vV = v;
 724:       vU = uv.x;
