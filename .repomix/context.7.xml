  1: import { Texture, type Effect, type Scene } from '../babylon/exports';
  2: import { ENUM_WORLD } from '../../common/types';
  3: import { GameOptions } from '../../common/gameOptions';
  4: import { createOZJTexture } from '../../common/utils';
  5: import { downloadDataFile } from './dataFolder';
  6: 
  7: /**
  8:  * Animated water terrain (gap 5.1): the CSWaterTerrain.cpp wave motion on the
  9:  * maps the original animates, run in the terrain material's vertex stage as a
 10:  * pure function of the `time` uniform, plus Atlans' additive 32-frame caustics
 11:  * flipbook (ZzzLodTerrain.cpp:1591-1596) in the fragment.
 12:  *
 13:  * Same shape as terrainOverlay.ts: a registry keyed by ENUM_WORLD, read at
 14:  * map load; the chunks compile in only where a map has them, so every other
 15:  * map keeps the shader it always had, byte for byte. The `animatedWater`
 16:  * option gates the registry the way `advancedEffects` gates the overlays.
 17:  */
 18: 
 19: export type TerrainWaterSpec = {
 20:   /** Water tile slot in getTilesList order - 5 everywhere. */
 21:   readonly layer: number;
 22:   /** Wave height multiplier; 1 = the CSWaterTerrain amplitudes as ported. */
 23:   readonly scale: number;
 24:   /** Draw the Object8 wt00..wt31 caustics flipbook over the water tiles. */
 25:   readonly flipbook: boolean;
 26: };
 27: 
 28: const WATER_BY_WORLD: Partial<Record<ENUM_WORLD, TerrainWaterSpec>> = {
 29:   // The one map the original gives the water treatment on its terrain.
 30:   // Doppelganger 3 reuses Atlans' art and takes one more line here when it
 31:   // lands; Hellas' dedicated surface plane could opt in the same way.
 32:   [ENUM_WORLD.WD_7ATLANSE]: { layer: 5, scale: 1, flipbook: true },
 33: };
 34: 
 35: /** Read at map load, like `terrainOverlaysFor`: off = the old shader. */
 36: export function terrainWaterFor(map: ENUM_WORLD): TerrainWaterSpec | null {
 37:   if (!GameOptions.animatedWater) return null;
 38:   return WATER_BY_WORLD[map] ?? null;
 39: }
 40: 
 41: /** SceneManager.cpp:305 - 32 frames, one per 25 Hz reference tick. */
 42: const FLIP_FRAMES = 32;
 43: const FLIP_FPS = 25;
 44: 
 45: /** SpawnAmbientWave: one ambient wave every 40/25 s = 1600 ms. */
 46: export const AMBIENT_WAVE_INTERVAL = 1.6;
 47: /** calcWave propagates one half-tile cell per 25 Hz tick = 12.5 tiles/s. */
 48: export const AMBIENT_WAVE_SPEED = 12.5;
 49: /** `newh -= newh >> 4` per tick: 0.9375^25 = e^-1.61 per second. */
 50: export const AMBIENT_WAVE_DAMPING = 1.61;
 51: /** addSineWave height 2000 -> ~250 units, x0.5 surface weight, /100 tiles. */
 52: export const AMBIENT_WAVE_AMPLITUDE = 1.25;
 53: 
 54: const RING_SLOTS = 3;
 55: 
 56: export type TerrainWaterRuntime = {
 57:   readonly spec: TerrainWaterSpec;
 58:   /** wt00..wt31 in frame order; empty when the flipbook is unavailable. */
 59:   readonly frames: readonly Texture[];
 60:   /** vec4 per slot: center x, center z (tiles), spawn time (s), active. */
 61:   readonly rings: number[];
 62:   lastSpawnIndex: number;
 63: };
 64: 
 65: export function createTerrainWaterRuntime(
 66:   spec: TerrainWaterSpec,
 67:   frames: readonly Texture[]
 68: ): TerrainWaterRuntime {
 69:   return { spec, frames, rings: new Array(RING_SLOTS * 4).fill(0), lastSpawnIndex: 0 };
 70: }
 71: 
 72: /**
 73:  * MapManager.cpp:117-140 loads Object8/wt00..wt31 for Atlans whatever world
 74:  * folder is active, so the path is fixed. A failure is not fatal: the waves
 75:  * still run, only the caustics layer is dropped.
 76:  */
 77: export async function loadTerrainWaterFlipbook(
 78:   scene: Scene,
 79:   spec: TerrainWaterSpec
 80: ): Promise<Texture[]> {
 81:   if (!spec.flipbook) return [];
 82: 
 83:   const results = await Promise.allSettled(
 84:     Array.from({ length: FLIP_FRAMES }, (_, i) => {
 85:       const name = `Object8/wt${String(i).padStart(2, '0')}.OZJ`;
 86:       return downloadDataFile(name).then(bytes =>
 87:         createOZJTexture(scene, name, bytes)
 88:       );
 89:     })
 90:   );
 91: 
 92:   const frames = results
 93:     .filter((r): r is PromiseFulfilledResult<Texture> => r.status === 'fulfilled')
 94:     .map(r => r.value);
 95: 
 96:   if (frames.length !== FLIP_FRAMES) {
 97:     for (const t of frames) t.dispose();
 98:     console.warn('Water flipbook unavailable, caustics disabled');
 99:     return [];
100:   }
101: 
102:   // The original binds these GL_LINEAR (MapManager.cpp:133); the OZJ helper
103:   // defaults to nearest for the splat tiles.
104:   for (const t of frames) {
105:     t.updateSamplingMode(Texture.BILINEAR_SAMPLINGMODE);
106:   }
107: 
108:   return frames;
109: }
110: 
111: export function disposeTerrainWaterFrames(frames: readonly Texture[]): void {
112:   for (const t of frames) t.dispose();
113: }
114: 
115: /**
116:  * FaceTexture with Scale=true (ZzzLodTerrain.cpp:1499): 16 texels per tile,
117:  * i.e. one repeat every width/16 tiles. vUV is x/256, so the multiplier is
118:  * 256 / (width / 16).
119:  */
120: export function terrainWaterFlipUvScale(frames: readonly Texture[]): number {
121:   const width = frames[0]?.getSize().width || 256;
122:   return 4096 / width;
123: }
124: 
125: function f(n: number): string {
126:   return Number.isInteger(n) ? `${n}.0` : `${n}`;
127: }
128: 
129: /**
130:  * The wave field, GLSL. All constants are CSWaterTerrain.cpp with units
131:  * converted: time seconds (WorldTime is ms), positions in tiles on the
132:  * half-tile grid (i = 2z, j = 2x), heights original / 100, base sines
133:  * weighted 0.25 and the ripple page 0.5 (CreateTerrain :129-134).
134:  *
135:  * calcBaseWave :288-293:
136:  *   wave2 = sin(T*.005 + i*.1 + j*.1)*50 - sin(T*.003 + j*.1 + i*.5)*50
137:  *   wave3 = sin(T*.001 + i*.5 + j*.5)*25 - sin(T*.002 + j*1. + i*.3)*25
138:  *
139:  * The ambient rings replace the two-page automaton with the analytic wave it
140:  * produces: a front expanding at AMBIENT_WAVE_SPEED, damped by
141:  * AMBIENT_WAVE_DAMPING, spreading cylindrically.
142:  */
143: export function terrainWaterVertexDeclarationsGlsl(): string {
144:   return `
145:   uniform float time;
146:   uniform vec4 muWaterWaves[${RING_SLOTS}];
147: 
148:   float muWaterWave(vec2 p, float t) {
149:     float h = 0.125 * sin(t * 5.0 + p.y * 0.2 + p.x * 0.2)
150:             - 0.125 * sin(t * 3.0 + p.x * 0.2 + p.y)
151:             + 0.0625 * sin(t + p.y + p.x)
152:             - 0.0625 * sin(t * 2.0 + p.x * 2.0 + p.y * 0.6);
153:     for (int i = 0; i < ${RING_SLOTS}; i++) {
154:       vec4 w = muWaterWaves[i];
155:       float age = t - w.z;
156:       if (w.w > 0.5 && age > 0.0) {
157:         float d = distance(p, w.xy);
158:         float front = ${f(AMBIENT_WAVE_SPEED)} * age;
159:         float band = (d - front) / 1.5;
160:         h += ${f(AMBIENT_WAVE_AMPLITUDE)} * exp(-${f(AMBIENT_WAVE_DAMPING)} * age)
161:            * inversesqrt(max(front, 1.0))
162:            * exp(-band * band) * cos(3.0 * (d - front));
163:       }
164:     }
165:     return h;
166:   }
167:   `;
168: }
169: 
170: /**
171:  * The displacement, emitted after `worldPosition` is computed. Weight: 1 on
172:  * a tile drawn as opaque water, the vertex's own blend alpha where water is
173:  * layered over ground - coincident corners of adjacent tiles carry the same
174:  * alpha, so the surface stays crack-free and dies out at the authored
175:  * shoreline fade.
176:  */
177: export function terrainWaterVertexGlsl(spec: TerrainWaterSpec): string {
178:   const lo = f(spec.layer - 0.5);
179:   const hi = f(spec.layer + 0.5);
180:   return `
181:   float muWaterW = 0.0;
182:   if (uv2.x > ${lo} && uv2.x < ${hi}) muWaterW = 1.0;
183:   else if (uv2.y > ${lo} && uv2.y < ${hi}) muWaterW = matricesWeights.a;
184:   if (muWaterW > 0.0) {
185:     worldPosition.y += muWaterWave(worldPosition.xz, time) * muWaterW * ${f(spec.scale)};
186:   }
187:   `;
188: }
189: 
190: /**
191:  * FaceTexture :1540-1552: the water texture's V wobbles per vertex by
192:  * TerrainGrassWind[x] * 0.002, TerrainGrassWind = sin(WindSpeed + x*5) * 10
193:  * (:2430), WindSpeed = T*0.002 (:2386) - continuous form for the GrassWind
194:  * slot the shader already feeds into the water UV.
195:  */
196: export function terrainWaterGrassWindGlsl(): string {
197:   return `0.02 * sin(time * 2.0 + vWorldXZ.x * 5.0)`;
198: }
199: 
200: /**
201:  * ZzzLodTerrain.cpp:1591-1596: on Atlans a tile whose layer 2 is the water
202:  * slot skips the normal alpha pass; the flipbook replaces it.
203:  */
204: export function terrainWaterAlphaSkipGlsl(
205:   runtime: TerrainWaterRuntime
206: ): string {
207:   if (!runtime.frames.length) return '';
208:   const lo = f(runtime.spec.layer - 0.5);
209:   const hi = f(runtime.spec.layer + 0.5);
210:   return `
211:     if (vAlphaTexture > ${lo} && vAlphaTexture < ${hi}) alphaRendered = false;
212:   `;
213: }
214: 
215: /**
216:  * The additive caustics pass over `colorVar`, after the lighting multiply -
217:  * the original's RenderFaceBlend is unlit, coloured only by the tile alpha
218:  * (VertexBlend* :1348-1353).
219:  */
220: export function terrainWaterCausticsGlsl(
221:   runtime: TerrainWaterRuntime,
222:   colorVar: string
223: ): string {
224:   if (!runtime.frames.length) return '';
225:   const lo = f(runtime.spec.layer - 0.5);
226:   const hi = f(runtime.spec.layer + 0.5);
227:   return `
228:     float muCausticW = 0.0;
229:     if (vOpaqueTexture > ${lo} && vOpaqueTexture < ${hi}) muCausticW = 1.0;
230:     else if (vAlphaTexture > ${lo} && vAlphaTexture < ${hi}) muCausticW = vAlphaColor.a;
231:     if (muCausticW > 0.0) {
232:       ${colorVar} += texture2D(waterFlip, vUV * ${f(
233:         terrainWaterFlipUvScale(runtime.frames)
234:       )}).rgb * muCausticW;
235:     }
236:   `;
237: }
238: 
239: export function terrainWaterUniforms(): string[] {
240:   return ['muWaterWaves'];
241: }
242: 
243: export function terrainWaterSamplers(runtime: TerrainWaterRuntime): string[] {
244:   return runtime.frames.length ? ['waterFlip'] : [];
245: }
246: 
247: /** Deterministic stand-in for the original's Random::RangeInt spawn jitter. */
248: function hash01(n: number): number {
249:   const s = Math.sin(n * 127.1 + 311.7) * 43758.5453;
250:   return s - Math.floor(s);
251: }
252: 
253: /**
254:  * SpawnAmbientWave :98-110: every 1600 ms a wave lands near the hero -
255:  * x = heroX*2 + rand(-15,14), y = heroY*2 + 25, in half-tiles. The anchor
256:  * here is the camera target (the hero, in play); spawn times sit on the
257:  * material's own clock so the wave shape stays a pure function of the time
258:  * uniform and the slot values.
259:  */
260: function updateAmbientRings(
261:   runtime: TerrainWaterRuntime,
262:   et: number,
263:   scene: Scene
264: ): void {
265:   const k = Math.floor(et / AMBIENT_WAVE_INTERVAL);
266:   if (k <= runtime.lastSpawnIndex) return;
267: 
268:   const cam = scene.activeCamera as unknown as {
269:     target?: { x: number; z: number };
270:     position?: { x: number; z: number };
271:   } | null;
272:   const anchor = cam?.target ?? cam?.position ?? { x: 128, z: 128 };
273: 
274:   for (let s = Math.max(runtime.lastSpawnIndex + 1, k - RING_SLOTS + 1); s <= k; s++) {
275:     const at = (s % RING_SLOTS) * 4;
276:     runtime.rings[at + 0] = anchor.x - 7.5 + hash01(s) * 14.5;
277:     runtime.rings[at + 1] = anchor.z + 12.5;
278:     runtime.rings[at + 2] = s * AMBIENT_WAVE_INTERVAL;
279:     runtime.rings[at + 3] = 1;
280:   }
281:   runtime.lastSpawnIndex = k;
282: }
283: 
284: export function bindTerrainWater(
285:   effect: Effect,
286:   runtime: TerrainWaterRuntime,
287:   et: number,
288:   scene: Scene
289: ): void {
290:   updateAmbientRings(runtime, et, scene);
291:   effect.setArray4('muWaterWaves', runtime.rings);
292: 
293:   if (runtime.frames.length) {
294:     const frame = Math.floor(et * FLIP_FPS) % runtime.frames.length;
295:     effect.setTexture('waterFlip', runtime.frames[frame]);
296:   }
297: }
298: 
299: export type AmbientRing = {
300:   readonly x: number;
301:   readonly z: number;
302:   readonly spawnTime: number;
303: };
304: 
305: /**
306:  * CPU mirror of the shader field - GetWaterTerrain's role, and what the unit
307:  * test pins the ported constants through. Same input, same surface.
308:  */
309: export function waterSurfaceHeight(
310:   x: number,
311:   z: number,
312:   t: number,
313:   rings: readonly AmbientRing[] = []
314: ): number {
315:   let h =
316:     0.125 * Math.sin(t * 5 + z * 0.2 + x * 0.2) -
317:     0.125 * Math.sin(t * 3 + x * 0.2 + z) +
318:     0.0625 * Math.sin(t + z + x) -
319:     0.0625 * Math.sin(t * 2 + x * 2 + z * 0.6);
320: 
321:   for (const w of rings) {
322:     const age = t - w.spawnTime;
323:     if (age <= 0) continue;
324:     const d = Math.hypot(x - w.x, z - w.z);
325:     const front = AMBIENT_WAVE_SPEED * age;
326:     const band = (d - front) / 1.5;
327:     h +=
328:       (AMBIENT_WAVE_AMPLITUDE *
329:         Math.exp(-AMBIENT_WAVE_DAMPING * age) *
330:         Math.exp(-band * band) *
331:         Math.cos(3 * (d - front))) /
332:       Math.sqrt(Math.max(front, 1));
333:   }
334: 
335:   return h;
336: }
</file>

<file path="src/libs/mu/tga.ts">
 1: const TGA_HEADER_SIZE = 18;
 2: const TGA_UNCOMPRESSED_TRUE_COLOR = 2;
 3: const TGA_TOP_LEFT_ORIGIN = 0x20;
 4: 
 5: export type DecodedTGA = {
 6:   width: number;
 7:   height: number;
 8:   pixels: Uint8ClampedArray;
 9: };
10: 
11: export function decodeTGA(name: string, tga: Uint8Array): DecodedTGA {
12:   if (tga.length < TGA_HEADER_SIZE) {
13:     throw new Error(`${name} is too small to be a TGA`);
14:   }
15: 
16:   const view = new DataView(tga.buffer, tga.byteOffset, tga.byteLength);
17: 
18:   const idLength = tga[0];
19:   const colorMapType = tga[1];
20:   const imageType = tga[2];
21:   const width = view.getUint16(12, true);
22:   const height = view.getUint16(14, true);
23:   const pixelDepth = tga[16];
24:   const descriptor = tga[17];
25: 
26:   if (imageType !== TGA_UNCOMPRESSED_TRUE_COLOR || colorMapType !== 0) {
27:     throw new Error(
28:       `${name} is an unsupported TGA (type ${imageType}, colour map ${colorMapType})`
29:     );
30:   }
31: 
32:   if (pixelDepth !== 32 && pixelDepth !== 24) {
33:     throw new Error(`${name} has an unsupported depth of ${pixelDepth}bpp`);
34:   }
35: 
36:   const bytesPerPixel = pixelDepth / 8;
37:   const start = TGA_HEADER_SIZE + idLength;
38:   const expected = width * height * bytesPerPixel;
39: 
40:   if (tga.length - start < expected) {
41:     throw new Error(
42:       `${name} is truncated: expected ${expected} bytes of pixels, got ${
43:         tga.length - start
44:       }`
45:     );
46:   }
47: 
48:   const topDown = (descriptor & TGA_TOP_LEFT_ORIGIN) !== 0;
49:   const pixels = new Uint8ClampedArray(width * height * 4);
50: 
51:   for (let y = 0; y < height; y++) {
52:     const srcRow = topDown ? y : height - 1 - y;
53:     let src = start + srcRow * width * bytesPerPixel;
54:     let dst = y * width * 4;
55: 
56:     for (let x = 0; x < width; x++) {
57:       pixels[dst] = tga[src + 2];
58:       pixels[dst + 1] = tga[src + 1];
59:       pixels[dst + 2] = tga[src];
60:       pixels[dst + 3] = bytesPerPixel === 4 ? tga[src + 3] : 255;
61: 
62:       src += bytesPerPixel;
63:       dst += 4;
64:     }
65:   }
66: 
67:   return { width, height, pixels };
68: }
</file>

<file path="src/libs/mu/tileTextureArray.ts">
  1: import {
  2:   Constants,
  3:   RawTexture2DArray,
  4:   Texture,
  5:   type Scene,
  6: } from '../babylon/exports';
  7: import { onGameOptionsChanged } from '../../common/gameOptions';
  8: import { textureFiltering } from '../../common/materialQuality';
  9: 
 10: /**
 11:  * Packs a map's tile textures into one `sampler2DArray`.
 12:  *
 13:  * The splat shader used to be generated as a chain of
 14:  * `if (m1 >= i && m1 < i+0.5) { texture2D(textures[i], …) }` over every tile
 15:  * texture - twice, once for the opaque layer and once for the alpha layer. A
 16:  * GLSL sampler array cannot be indexed by a value that varies per fragment,
 17:  * which is why it was written that way; with a 2D array the layer *is* just a
 18:  * coordinate, so 18-20 conditional fetches per pixel of a full-screen,
 19:  * never-culled mesh collapse into two.
 20:  *
 21:  * Tiles come in mixed sizes (256² and 128² in the shipped worlds), so the
 22:  * smaller ones are upscaled to the largest. The upscale follows the sampler:
 23:  * Classic samples `NEAREST_NEAREST` with no mip chain, which is what the
 24:  * original does, and an integer nearest upscale is exact under it - the same
 25:  * texel is fetched either way. Tiers >= 1 filter trilinear with anisotropy
 26:  * (`textureFiltering`), and there the upscale is bilinear: a nearest 2x
 27:  * upscale leaves 2x2 plateaus that the linear sampler ramps between, so a
 28:  * magnified 128² tile still read as soft-edged blocks.
 29:  *
 30:  * The mip chain is built either way. It is a third of the array's memory and
 31:  * nothing samples it in Classic, but having it there is what lets the sampler
 32:  * flip be a live `updateSamplingMode` call. The blit flip is one `update` of
 33:  * the array from the decoded tiles kept beside it, not a map reload.
 34:  *
 35:  * Per-layer filtering is safe on a `sampler2DArray`: layers are independent
 36:  * for filtering and mip generation, so no tile can bleed into its neighbour
 37:  * in the array the way it would in an atlas.
 38:  */
 39: 
 40: type LiveArray = {
 41:   texture: RawTexture2DArray;
 42:   tiles: TilePixels[];
 43:   size: number;
 44:   /** Whether the layers were packed with the bilinear upscale. */
 45:   linear: boolean;
 46: };
 47: 
 48: /** Every live tile array, so a quality flip can re-resolve all of them. */
 49: const liveArrays = new Map<RawTexture2DArray, LiveArray>();
 50: 
 51: function syncTileFiltering(): void {
 52:   const { sampling, anisotropy } = textureFiltering();
 53:   const linear = sampling !== Texture.NEAREST_NEAREST;
 54: 
 55:   for (const live of liveArrays.values()) {
 56:     live.texture.updateSamplingMode(sampling);
 57:     live.texture.anisotropicFilteringLevel = anisotropy;
 58: 
 59:     if (live.linear !== linear) {
 60:       live.linear = linear;
 61:       live.texture.update(packLayers(live.tiles, live.size, linear));
 62:     }
 63:   }
 64: }
 65: 
 66: onGameOptionsChanged(syncTileFiltering);
 67: 
 68: export type TileTextureArray = {
 69:   readonly texture: RawTexture2DArray;
 70:   /** Per-layer UV multiplier, in the layer order handed to `createTileTextureArray`. */
 71:   readonly scales: Float32Array;
 72:   readonly layers: number;
 73: };
 74: 
 75: /** Decoded RGBA of one tile, top row first. */
 76: type TilePixels = {
 77:   data: Uint8ClampedArray;
 78:   width: number;
 79:   height: number;
 80: };
 81: 
 82: /**
 83:  * Decodes a JPEG to top-down RGBA. Deliberately not `Texture.readPixels()`:
 84:  * that reads back from the GPU bottom-up, and a silently vertically flipped
 85:  * noise tile is exactly the kind of mistake that survives review.
 86:  */
 87: async function decodeJpeg(bytes: Uint8Array): Promise<TilePixels> {
 88:   const blob = new Blob([bytes], { type: 'image/jpeg' });
 89:   const bitmap = await createImageBitmap(blob);
 90:   // A closed ImageBitmap reports 0 x 0, so the size is taken first.
 91:   const { width, height } = bitmap;
 92: 
 93:   const canvas = document.createElement('canvas');
 94:   canvas.width = width;
 95:   canvas.height = height;
 96: 
 97:   const context = canvas.getContext('2d', { willReadFrequently: true })!;
 98:   context.drawImage(bitmap, 0, 0);
 99: 
100:   const image = context.getImageData(0, 0, width, height);
101: 
102:   bitmap.close();
103: 
104:   return { data: image.data, width, height };
105: }
106: 
107: /** Nearest-neighbour resample of RGBA into a `size × size` block of `out`. */
108: function blitNearest(
109:   tile: TilePixels,
110:   out: Uint8Array,
111:   layer: number,
112:   size: number
113: ): void {
114:   const base = layer * size * size * 4;
115: 
116:   for (let y = 0; y < size; y++) {
117:     const sy = ((y * tile.height) / size) | 0;
118:     const sourceRow = sy * tile.width * 4;
119:     const targetRow = base + y * size * 4;
120: 
121:     for (let x = 0; x < size; x++) {
122:       const sx = ((x * tile.width) / size) | 0;
123:       const s = sourceRow + sx * 4;
124:       const t = targetRow + x * 4;
125: 
126:       out[t] = tile.data[s];
127:       out[t + 1] = tile.data[s + 1];
128:       out[t + 2] = tile.data[s + 2];
129:       out[t + 3] = tile.data[s + 3];
130:     }
131:   }
132: }
133: 
134: /**
135:  * Bilinear resample of RGBA into a `size × size` block of `out`, sampling at
136:  * texel centres and wrapping at the edges (the tiles repeat). A tile already
137:  * at `size` copies through unchanged.
138:  */
139: function blitLinear(
140:   tile: TilePixels,
141:   out: Uint8Array,
142:   layer: number,
143:   size: number
144: ): void {
145:   const base = layer * size * size * 4;
146:   const { width, height, data } = tile;
147: 
148:   for (let y = 0; y < size; y++) {
149:     const sy = ((y + 0.5) * height) / size - 0.5;
150:     const y0 = Math.floor(sy);
151:     const fy = sy - y0;
152:     const row0 = (((y0 % height) + height) % height) * width * 4;
153:     const row1 = ((((y0 + 1) % height) + height) % height) * width * 4;
154:     const targetRow = base + y * size * 4;
155: 
156:     for (let x = 0; x < size; x++) {
157:       const sx = ((x + 0.5) * width) / size - 0.5;
158:       const x0 = Math.floor(sx);
159:       const fx = sx - x0;
160:       const c0 = (((x0 % width) + width) % width) * 4;
161:       const c1 = ((((x0 + 1) % width) + width) % width) * 4;
162:       const t = targetRow + x * 4;
163: 
164:       for (let c = 0; c < 4; c++) {
165:         const top = data[row0 + c0 + c] * (1 - fx) + data[row0 + c1 + c] * fx;
166:         const bottom =
167:           data[row1 + c0 + c] * (1 - fx) + data[row1 + c1 + c] * fx;
168:         out[t + c] = Math.round(top * (1 - fy) + bottom * fy);
169:       }
170:     }
171:   }
172: }
173: 
174: function packLayers(
175:   tiles: readonly TilePixels[],
176:   size: number,
177:   linear: boolean
178: ): Uint8Array {
179:   const data = new Uint8Array(size * size * 4 * tiles.length);
180:   const blit = linear ? blitLinear : blitNearest;
181: 
182:   for (let layer = 0; layer < tiles.length; layer++) {
183:     blit(tiles[layer], data, layer, size);
184:   }
185: 
186:   return data;
187: }
188: 
189: /**
190:  * `scale` mirrors what `getTerrainData` computed per texture: a 256² tile
191:  * repeats every 64 terrain tiles, everything else every `size` of them. It
192:  * has to stay keyed on the tile's *own* size, not the array's, so upscaling
193:  * a 128² tile does not change how often it repeats.
194:  */
195: function uvScaleFor(size: number): number {
196:   return size === 256 ? size / 4 : size;
197: }
198: 
199: export async function createTileTextureArray(
200:   scene: Scene,
201:   jpegs: readonly Uint8Array[]
202: ): Promise<TileTextureArray | null> {
203:   if (jpegs.length === 0) return null;
204: 
205:   // `sampler2DArray` is WebGL2 only; WebGL1 keeps the per-tile sampler chain.
206:   const engine = scene.getEngine() as { webGLVersion?: number };
207:   if ((engine.webGLVersion ?? 2) < 2) return null;
208: 
209:   const tiles = await Promise.all(jpegs.map(decodeJpeg));
210: 
211:   let size = 0;
212:   for (const tile of tiles) size = Math.max(size, tile.width, tile.height);
213: 
214:   if (size === 0) return null;
215: 
216:   const layers = tiles.length;
217:   const scales = new Float32Array(layers);
218: 
219:   for (let layer = 0; layer < layers; layer++) {
220:     scales[layer] = uvScaleFor(tiles[layer].height);
221:   }
222: 
223:   const { sampling, anisotropy } = textureFiltering();
224:   const linear = sampling !== Texture.NEAREST_NEAREST;
225:   const data = packLayers(tiles, size, linear);
226: 
227:   const texture = new RawTexture2DArray(
228:     data,
229:     size,
230:     size,
231:     layers,
232:     Constants.TEXTUREFORMAT_RGBA,
233:     scene,
234:     // generateMipMaps: built in both modes so the Classic/Enhanced flip is a
235:     // sampling-mode change rather than a map reload.
236:     true,
237:     // Rows are top-down, which is the orientation the individual `Texture`s
238:     // were uploaded with (invertY false in readOJZBufferAsJPEGBuffer).
239:     false,
240:     sampling
241:   );
242: 
243:   texture.name = 'terrainTileArray';
244:   texture.wrapU = Texture.WRAP_ADDRESSMODE;
245:   texture.wrapV = Texture.WRAP_ADDRESSMODE;
246:   texture.anisotropicFilteringLevel = anisotropy;
247: 
248:   // A map change disposes the old array; without this the map would pin it
249:   // and the next quality flip would touch a dead texture.
250:   liveArrays.set(texture, { texture, tiles, size, linear });
251:   texture.onDisposeObservable.add(() => liveArrays.delete(texture));
252: 
253:   return { texture, scales, layers };
254: }
255: 
256: /** Diagnostics: the live terrain tile arrays, for `window.muMat()`. */
257: export function liveTileArrays(): RawTexture2DArray[] {
258:   return [...liveArrays.keys()];
259: }
</file>

