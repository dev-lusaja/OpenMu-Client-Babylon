153:       if (packetType >= 0xc3) {
154:         // `length` is the encrypted wire size (11-byte blocks); the queue is
155:         // advanced by it below. The decrypted packet is shorter (8-byte
156:         // blocks, minus the counter byte) and carries its own length header,
157:         // which is what the parsers read.
158:         const wire = new Uint8Array(bytes.buffer, bytes.byteOffset, length);
159:         let ok = false;
160:         let decryptedPacket: Uint8Array = wire;
161:         try {
162:           [ok, decryptedPacket] = decryptor.Decrypt(wire);
163:         } catch (e) {
164:           // Never let a decoder throw escape: it would leave `bytes` untouched
165:           // and every later frame would re-hit the same packet forever.
166:           decryptor.lastError = `threw ${e instanceof Error ? e.message : String(e)}`;
167:         }
168: 
169:         if (decryptor.lastError != null) {
170:           reportDecrypt(ok, decryptor.lastError, wire);
171:         }
172: 
173:         if (!ok) {
174:           bytes = bytes.subarray(length);
175:           continue;
176:         }
177:         packet = new DataView(decryptedPacket.buffer as ArrayBuffer);
178:         DEBUG_LOG && console.log(`${LOG_PREFIX}Decrypted packet 0x${byteToString(packetType)}, lng: ${length}:`, decryptedPacket);
