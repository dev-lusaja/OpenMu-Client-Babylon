<file path="src/libs/mu/skillNameFile.ts">
 1: /**
 2:  * `Data/Local/<pack>/skill_<lang>.bmd` - the skill names in the language the
 3:  * player picked.
 4:  *
 5:  * `SKILL_ATTRIBUTE_FILE_LEGACY` (`GameData/SkillData/SkillStructs.h`): 650
 6:  * fixed records of 88 bytes with a 32-byte name in front, no count, a 4-byte
 7:  * checksum after, each record XOR-ed with the 3-byte Bux key restarting at
 8:  * every record. The record index is the wire skill number, so it lines up with
 9:  * `skillsDatabase.ts` without a table in between.
10:  *
11:  * An overlay, like `itemNameFile`: `SKILL_DEFINITIONS` keeps the English name
12:  * as the identity everything else keys on, and only what the player reads goes
13:  * through here.
14:  */
15: 
16: import { observable, runInAction } from 'mobx';
17: import { convertBux } from '../../common/terrain/mapFileEncryption';
18: import { i18n, onLanguageChanged } from '../../i18n';
19: import {
20:   checkPackText,
21:   decodeLocalText,
22:   downloadPackDataFile,
23:   repairPackText,
24: } from './localData';
25: 
26: const FILE = 'skill';
27: const RECORD_SIZE = 88;
28: const NAME_LENGTH = 32;
29: 
30: const names = observable.box<ReadonlyMap<number, string>>(new Map(), {
31:   deep: false,
32: });
33: 
34: let pending: Promise<void> | null = null;
35: 
36: function set(map: ReadonlyMap<number, string>): void {
37:   runInAction(() => names.set(map));
38: }
39: 
40: /** Skill number -> name. Exported so the record layout can be tested without a fetch. */
41: export function parseSkillNames(bytes: Uint8Array): Map<number, string> {
42:   const out = new Map<number, string>();
43:   const count = Math.floor(bytes.length / RECORD_SIZE);
44: 
45:   for (let i = 0; i < count; i++) {
46:     const offset = i * RECORD_SIZE;
47:     convertBux(bytes.subarray(offset, offset + RECORD_SIZE), RECORD_SIZE);
48: 
49:     const name = repairPackText(decodeLocalText(bytes, offset, NAME_LENGTH));
50:     if (name) out.set(i, name);
51:   }
52: 
53:   return out;
54: }
55: 
56: /** Load the overlay for the active language; a no-op without a pack. */
57: export function loadSkillNames(): Promise<void> {
58:   if (pending) return pending;
59: 
60:   const pack = i18n.dataPack;
61:   if (!pack || pack.folder === 'Eng') {
62:     set(new Map());
63:     pending = Promise.resolve();
64:     return pending;
65:   }
66: 
67:   const wanted = i18n.language;
68: 
69:   pending = downloadPackDataFile(FILE)
70:     .then(bytes => {
71:       if (i18n.language !== wanted || !bytes.length) return;
72:       const parsed = parseSkillNames(bytes);
73:       checkPackText(FILE, parsed.values());
74:       set(parsed);
75:     })
76:     .catch(err => {
77:       console.warn(`Skill names for ${pack.folder} are missing:`, err);
78:       if (i18n.language === wanted) set(new Map());
79:     });
80: 
81:   return pending;
82: }
83: 
84: /** The localised name for a skill number, or undefined for the English one. */
85: export function localisedSkillName(number: number): string | undefined {
86:   return names.get().get(number);
87: }
88: 
89: onLanguageChanged(() => {
90:   pending = null;
91:   set(new Map());
92:   void loadSkillNames();
93: });
94: 
95: // Deferred past module evaluation, like `itemNameFile`: this module can run
96: // before `i18n/index.ts` has, and reading `dataPack` then loads nothing.
97: queueMicrotask(() => void loadSkillNames());
</file>

<file path="src/libs/mu/snowArtMatch.test.ts">
  1: import { describe, expect, it } from 'vitest';
  2: import { SNOW_ART, artMatch } from './artMatch';
  3: 
  4: /**
  5:  * Mean sRGB of the tile textures the maps actually ship
  6:  * (`Data/World<n>/Tile*.OZJ`, every 4th texel), by slot in `FULL_TILES`
  7:  * order. These are the numbers `SNOW_ART` was set against, so a change to
  8:  * either ramp has to be argued against the real art here rather than
  9:  * eyeballed on one screenshot.
 10:  */
 11: const TILES: Record<string, Record<number, readonly [number, number, number]>> =
 12:   {
 13:     // Devias (World3): snow painted into the grass and the rock, a neutral
 14:     // grey field ground, dark boards and rocks.
 15:     devias: {
 16:       0: [216, 229, 232], // TileGrass01 - painted snow
 17:       1: [220, 231, 234], // TileGrass02 - painted snow
 18:       2: [114, 114, 118], // TileGround01 - the open field's grey ground
 19:       3: [60, 46, 36], // TileGround02 - boards
 20:       4: [153, 153, 149], // TileGround03 - cobbles
 21:       5: [87, 117, 120], // TileWater01
 22:       6: [114, 140, 149], // TileWood01 - frosted blue stone
 23:       7: [181, 210, 219], // TileRock01 - painted snow
 24:       8: [66, 73, 75], // TileRock02 - dark rock
 25:     },
 26:     // Santa Town (World63): a snow village drawn over DARK ground. The layer
 27:     // is what whitens it, so none of its ground may be read as already snow.
 28:     santaTown: {
 29:       0: [68, 83, 71], // TileGrass01 - dark grass
 30:       1: [51, 65, 58], // TileGrass02 - dark grass
 31:       2: [38, 43, 47], // TileGround01 - dark ground
 32:       3: [205, 224, 229], // TileGround02 - painted snow
 33:       4: [59, 22, 1], // TileGround03 - embers
 34:       5: [97, 185, 219], // TileWater01 - bright, but blue
 35:       7: [188, 203, 213], // TileRock01 - painted snow
 36:     },
 37:     // The ice fields (World58). They draw no layer at all now
 38:     // (`snowfall: false`), but their art is the clearest case of the two
 39:     // things the ramps have to tell apart: white ice and blue ice.
 40:     laCleon: {
 41:       0: [197, 215, 226], // TileGrass01 - white ice
 42:       2: [33, 131, 166], // TileGround01 - deep blue ice
 43:       5: [97, 185, 219], // TileWater01 - blue ice
 44:       7: [210, 230, 243], // TileRock01 - white ice
 45:       8: [125, 207, 222], // TileRock02 - blue ice
 46:     },
 47:   };
 48: 
 49: const match = (rgb: readonly [number, number, number]) =>
 50:   artMatch(SNOW_ART, rgb[0] / 255, rgb[1] / 255, rgb[2] / 255);
 51: 
 52: /** Tiles the layer must stand aside on: the art is already snow. */
 53: const DEFERS: readonly (readonly [string, number])[] = [
 54:   ['devias', 0],
 55:   ['devias', 1],
 56:   ['devias', 7],
 57:   ['santaTown', 3],
 58:   ['santaTown', 7],
 59:   ['laCleon', 0],
 60:   ['laCleon', 7],
 61: ];
 62: 
 63: /** Tiles the layer must still cover: no snow is painted into them. */
 64: const COVERS: readonly (readonly [string, number])[] = [
 65:   ['devias', 2],
 66:   ['devias', 3],
 67:   ['devias', 4],
 68:   ['devias', 5],
 69:   ['devias', 6],
 70:   ['devias', 8],
 71:   ['santaTown', 0],
 72:   ['santaTown', 1],
 73:   ['santaTown', 2],
 74:   ['santaTown', 4],
 75:   ['santaTown', 5],
 76:   ['laCleon', 2],
 77:   ['laCleon', 5],
 78:   ['laCleon', 8],
 79: ];
 80: 
 81: describe('settled snow defers to the map art', () => {
 82:   it.each(DEFERS)('stands aside on %s tile %i', (map, slot) => {
 83:     expect(match(TILES[map][slot])).toBeGreaterThan(0.7);
 84:   });
 85: 
 86:   it.each(COVERS)('still covers %s tile %i', (map, slot) => {
 87:     expect(match(TILES[map][slot])).toBeLessThan(0.1);
 88:   });
 89: 
 90:   it('keeps Santa Town coverable: the village is snow over dark ground', () => {
 91:     // The regression this guards: widening the luminance ramp downward to
 92:     // catch one grey tile on another map would stop Santa Town whitening at
 93:     // all, and it has no painted snow of its own to fall back on.
 94:     for (const slot of [0, 1, 2]) {
 95:       expect(match(TILES.santaTown[slot])).toBe(0);
 96:     }
 97:   });
 98: 
 99:   it('separates white ice from blue ice on brightness alone', () => {
100:     // Both are bright. Only the chroma ramp tells them apart, which is why
101:     // luminance on its own is not enough to read a map's art.
102:     expect(match(TILES.laCleon[7])).toBeGreaterThan(0.7);
103:     expect(match(TILES.laCleon[8])).toBe(0);
104:     expect(match(TILES.laCleon[5])).toBe(0);
105:   });
106: 
107:   it('is monotonic in brightness for a neutral colour', () => {
108:     let last = -1;
109:     for (let v = 0; v <= 255; v += 5) {
110:       const here = match([v, v, v]);
111:       expect(here).toBeGreaterThanOrEqual(last);
112:       last = here;
113:     }
114:     expect(match([255, 255, 255])).toBe(1);
115:     expect(match([0, 0, 0])).toBe(0);
116:   });
117: });
</file>

<file path="src/libs/mu/sprites.ts">
  1: import { downloadDataFile, hasDataFile } from './dataFolder';
  2: import { decodeTGA } from './tga';
  3: 
  4: /**
  5:  * What a path the active version's tree does not contain decodes to: a 1x1
  6:  * transparent pixel, so a frame drawn from it is empty rather than an error
  7:  * per paint. A data URL and not a blob, so `clearSpriteCache` has nothing to
  8:  * revoke. See `hasDataFile`.
  9:  */
 10: const ABSENT_SPRITE: MuSprite = {
 11:   url: 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7',
 12:   width: 1,
 13:   height: 1,
 14: };
 15: 
 16: const OZJ_HEADER_SIZE = 24;
 17: const OZT_HEADER_SIZE = 4;
 18: 
 19: export type MuSprite = {
 20:   url: string;
 21:   width: number;
 22:   height: number;
 23: };
 24: 
 25: const cache = new Map<string, Promise<MuSprite>>();
 26: /** Resolved sprites, for the synchronous `peekSprite` read. */
 27: const ready = new Map<string, MuSprite>();
 28: 
 29: export function loadMuSprite(path: string): Promise<MuSprite> {
 30:   const key = path.toLowerCase();
 31: 
 32:   let sprite = cache.get(key);
 33: 
 34:   if (!sprite) {
 35:     sprite = loadSprite(path).then(
 36:       loaded => {
 37:         ready.set(key, loaded);
 38:         return loaded;
 39:       },
 40:       err => {
 41:         cache.delete(key);
 42:         throw err;
 43:       }
 44:     );
 45:     cache.set(key, sprite);
 46:   }
 47: 
 48:   return sprite;
 49: }
 50: 
 51: export function loadInterfaceSprite(fileName: string): Promise<MuSprite> {
 52:   return loadMuSprite(`Interface/${fileName}`);
 53: }
 54: 
 55: /**
 56:  * The sprite if it has already been decoded, without waiting. Lets a React
 57:  * component mount with its background in place (no empty first paint, no
 58:  * state update per square) once the preloader has run.
 59:  */
 60: export function peekMuSprite(path: string): MuSprite | null {
 61:   return ready.get(path.toLowerCase()) ?? null;
 62: }
 63: 
 64: export function peekInterfaceSprite(fileName: string): MuSprite | null {
 65:   return peekMuSprite(`Interface/${fileName}`);
 66: }
 67: 
 68: /**
 69:  * Drop every decoded sprite (or only those the filter accepts) and revoke
 70:  * their blob URLs. Called when the world is left so the ~120 window sprites
 71:  * do not stay pinned across a logout.
 72:  */
 73: export function clearSpriteCache(filter?: (path: string) => boolean): void {
 74:   for (const [key, pending] of cache) {
 75:     if (filter && !filter(key)) continue;
 76:     cache.delete(key);
 77:     ready.delete(key);
 78:     pending.then(
 79:       sprite => URL.revokeObjectURL(sprite.url),
 80:       () => {}
 81:     );
 82:   }
 83: }
 84: 
 85: async function loadSprite(path: string): Promise<MuSprite> {
 86:   if (!hasDataFile(path)) return ABSENT_SPRITE;
 87: 
 88:   const buffer = await downloadDataFile(path);
 89:   const ext = path.split('.').pop()?.toLowerCase();
 90: 
 91:   switch (ext) {
 92:     case 'ozj':
 93:       return spriteFromJPEG(path, buffer);
 94:     case 'ozt':
 95:       return spriteFromTGA(path, buffer);
 96:     default:
 97:       throw new Error(`Unsupported sprite format for ${path}`);
 98:   }
 99: }
100: 
101: /**
102:  * Width / height from the JPEG's first frame header (SOF0..SOF15, minus the
103:  * DHT/JPG/DAC markers that share the range). Reading it costs a few byte
104:  * compares; the alternative - `createImageBitmap` - decodes the whole image
105:  * a second time just to measure it, and the browser decodes it again anyway
106:  * when the blob URL is painted.
107:  */
108: function jpegSize(jpeg: Uint8Array): { width: number; height: number } | null {
109:   let i = 2; // past FFD8
110:   while (i + 9 < jpeg.length) {
111:     if (jpeg[i] !== 0xff) {
112:       i++;
113:       continue;
114:     }
115:     const marker = jpeg[i + 1];
116:     // Padding / RST markers carry no length.
117:     if (marker === 0xff) {
118:       i++;
119:       continue;
120:     }
121:     if (marker === 0x01 || (marker >= 0xd0 && marker <= 0xd8)) {
122:       i += 2;
123:       continue;
124:     }
125:     const length = (jpeg[i + 2] << 8) | jpeg[i + 3];
126:     const isSOF =
127:       marker >= 0xc0 &&
128:       marker <= 0xcf &&
129:       marker !== 0xc4 &&
130:       marker !== 0xc8 &&
131:       marker !== 0xcc;
132:     if (isSOF) {
133:       const height = (jpeg[i + 5] << 8) | jpeg[i + 6];
134:       const width = (jpeg[i + 7] << 8) | jpeg[i + 8];
135:       return width > 0 && height > 0 ? { width, height } : null;
136:     }
137:     if (marker === 0xda || marker === 0xd9) return null; // SOS / EOI: no SOF seen
138:     i += 2 + length;
139:   }
140:   return null;
141: }
142: 
143: async function spriteFromJPEG(
144:   path: string,
145:   buffer: Uint8Array
146: ): Promise<MuSprite> {
147:   if (buffer.length <= OZJ_HEADER_SIZE) {
148:     throw new Error(`${path} is too small to be an OZJ`);
149:   }
150: 
151:   const jpeg = buffer.slice(OZJ_HEADER_SIZE);
152: 
153:   if (jpeg[0] !== 0xff || jpeg[1] !== 0xd8) {
154:     throw new Error(`${path} has no JPEG marker at offset ${OZJ_HEADER_SIZE}`);
155:   }
156: 
157:   const blob = new Blob([jpeg], { type: 'image/jpeg' });
158:   const size = jpegSize(jpeg);
159: 
160:   if (size) {
161:     return { url: URL.createObjectURL(blob), ...size };
162:   }
163: 
164:   // A header the scanner did not understand: measure the slow way.
165:   const bitmap = await createImageBitmap(blob);
166:   try {
167:     return {
168:       url: URL.createObjectURL(blob),
169:       width: bitmap.width,
170:       height: bitmap.height,
171:     };
172:   } finally {
173:     bitmap.close();
174:   }
175: }
176: 
177: async function spriteFromTGA(
178:   path: string,
179:   buffer: Uint8Array
180: ): Promise<MuSprite> {
181:   const { width, height, pixels } = decodeTGA(
182:     path,
183:     buffer.slice(OZT_HEADER_SIZE)
184:   );
185: 
186:   const canvas = document.createElement('canvas');
187:   canvas.width = width;
188:   canvas.height = height;
189: 
190:   const ctx = canvas.getContext('2d');
191: 
192:   if (!ctx) {
193:     throw new Error(`Could not get a 2d context to decode ${path}`);
194:   }
195: 
196:   ctx.putImageData(new ImageData(pixels, width, height), 0, 0);
197: 
198:   const blob = await new Promise<Blob | null>(resolve =>
199:     canvas.toBlob(resolve, 'image/png')
200:   );
201: 
202:   if (!blob) {
203:     throw new Error(`Could not encode ${path} as PNG`);
204:   }
205: 
206:   return { url: URL.createObjectURL(blob), width, height };
207: }
</file>

<file path="src/libs/mu/terrainAttributeUpdates.ts">
 1: import { ChangeTerrainAttributesPacket } from '../../common/packets/ServerToClientPackets';
 2: import { EventBus } from '../eventBus';
 3: import { Store } from '../../store';
 4: 
 5: /**
 6:  * `ReceiveSetAttribute` (WSclient.cpp:8320-8345): the server rewrites terrain
 7:  * attributes at runtime - the Blood Castle pit opening, the Chaos Castle
 8:  * strips closing, Crywolf's gates. OpenMU sends it as `ChangeTerrainAttributes`
 9:  * (C1 46): one flag, set or clear, over a list of tile rectangles.
10:  *
11:  * The write goes through `world.setTerrainFlags` on whatever map is loaded;
12:  * a map module that wants to *react* (the Blood Castle gate) polls the flag it
13:  * cares about rather than listening here, so this file stays a one-line port
14:  * and no map has to unregister anything.
15:  *
16:  * Imported for its side effect by `loadMapIntoScene`.
17:  */
18: EventBus.on('ChangeTerrainAttributes', packet => {
19:   const world = Store.world;
20:   if (!world) return;
21: 
22:   const p = new ChangeTerrainAttributesPacket(packet);
23:   const set = !p.RemoveAttribute;
24: 
25:   for (const a of p.getAreas()) {
26:     world.setTerrainFlags(
27:       a.StartX,
28:       a.StartY,
29:       a.EndX - a.StartX + 1,
30:       a.EndY - a.StartY + 1,
31:       p.Attribute as number,
32:       set
33:     );
34:   }
35: });
</file>

