  1: import type { ENUM_WORLD } from '../common/types';
  2: import type { Scene } from '../libs/babylon/exports';
  3: import type { Entity } from '../ecs/world';
  4: import type { Events } from '../libs/eventBus/events';
  5: import type { LightingLayer } from './layer';
  6: import { LIGHTING_LAYERS } from './layers';
  7: import {
  8:   LightSource,
  9:   disposeAllLightSources,
 10:   liveLightSources,
 11:   tickLightSources,
 12:   type LightAnchor,
 13:   type LightRecipe,
 14: } from './lightSource';
 15: import { lightAreaSkill, lightArrow, lightSkillTrail, lightTargetedSkill } from './skills';
 16: import { lightCharacter, snuffCharacter, characterIsLit } from './characters';
 17: import { lightObjectEffect } from './objectEffects';
 18: import { lookDirector, type LookState } from './director';
 19: import type { OmenLookName } from './profiles';
 20: 
 21: export type { LightingLayer } from './layer';
 22: export type { LightRecipe, LightAnchor } from './lightSource';
 23: 
 24: /**
 25:  * The lighting layer: everything that throws light onto the map, behind one
 26:  * object. Copy `_template.ts` when adding to it.
 27:  *
 28:  * The game talks to `lighting.update` once a frame and `lighting.reset` on a
 29:  * map change; both fan out over `LIGHTING_LAYERS` (`layers.ts`), the only
 30:  * list of entries in the codebase. The commands below are the facade's
 31:  * public surface for consumers; every entry file stays importable directly
 32:  * for anything that needs a single function.
 33:  *
 34:  * The two sinks - `common/terrainDynamicLight.ts` and
 35:  * `common/pointLightPool.ts` - are consumers of this folder: `LightSource`
 36:  * registers into them, `TerrainLightSystem` steps them after `update`.
 37:  */
 38: class Lighting {
 39:   private readonly layers: LightingLayer[] = [...LIGHTING_LAYERS];
 40: 
 41:   /** Add an entry at runtime (tools, experiments). Returns the unregister. */
 42:   register(layer: LightingLayer): () => void {
 43:     this.layers.push(layer);
 44:     return () => {
 45:       const i = this.layers.indexOf(layer);
 46:       if (i >= 0) this.layers.splice(i, 1);
 47:     };
 48:   }
 49: 
 50:   /** Every entry that exists on this map. */
 51:   layersFor(map: ENUM_WORLD): LightingLayer[] {
 52:     return this.layers.filter(l => !l.maps || l.maps.has(map));
 53:   }
 54: 
 55:   /**
 56:    * Step every source, then every entry. Call once a frame, before the sinks
 57:    * are updated (`TerrainLightSystem`).
 58:    */
 59:   update(map: ENUM_WORLD, dt: number): void {
 60:     tickLightSources(dt);
 61:     for (const layer of this.layers) layer.update?.(map, dt);
 62:   }
 63: 
 64:   /**
 65:    * Drop everything. Call when the map changes - the terrain light field is
 66:    * rebuilt from the new bake and no registration may outlive it.
 67:    */
 68:   reset(): void {
 69:     disposeAllLightSources();
 70:     for (const layer of this.layers) layer.reset?.();
 71:   }
 72: 
 73:   // ---- readers -----------------------------------------------------------
 74: 
 75:   /** What is lighting this map right now, across every entry. */
 76:   emitters(map: ENUM_WORLD): LightSource[] {
 77:     const out: LightSource[] = [];
 78:     for (const layer of this.layersFor(map)) {
 79:       const e = layer.emitters?.(map);
 80:       if (e) out.push(...e);
 81:     }
 82:     return out;
 83:   }
 84: 
 85:   /** Every live source, entries and ad-hoc flashes alike. */
 86:   get liveCount(): number {
 87:     return liveLightSources().size;
 88:   }
 89: 
 90:   /** Whether an NPC/monster entity currently carries its light. */
 91:   characterIsLit(e: Entity): boolean {
 92:     return characterIsLit(e);
 93:   }
 94: 
 95:   /**
 96:    * The look the director composed this frame - key, shadow policy,
 97:    * exposure, haze colour (`lighting/director.ts`). Null before the scene
 98:    * exists.
 99:    */
100:   look(): Readonly<LookState> | null {
101:     return lookDirector()?.state() ?? null;
102:   }
103: 
104:   // ---- commands ----------------------------------------------------------
105: 
106:   /**
107:    * An event's modifier over the map's look - a dragon invasion darkening the
108:    * world. Composes with the map and the area instead of replacing them;
109:    * null clears it.
110:    */
111:   omen(name: OmenLookName | null): void {
112:     lookDirector()?.setOmen(name);
113:   }
114: 
115:   /** Light a targeted skill: cast flash, projectile, impact. */
116:   skillTargeted(scene: Scene, skill: number, caster: Entity, target: Entity | null): void {
117:     lightTargetedSkill(scene, skill, caster, target);
118:   }
119: 
120:   /** Light an area skill at a ground point. */
121:   skillArea(
122:     scene: Scene,
123:     skill: number,
124:     caster: Entity,
125:     at: { x: number; y: number; z: number }
126:   ): void {
127:     lightAreaSkill(scene, skill, caster, at);
128:   }
129: 
130:   /**
131:    * Light one of a skill's moving bodies - a spirit, a wisp - for as long as
132:    * the effect drives it. Null when the tier will not carry per-body lights.
133:    */
134:   skillTrail(
135:     scene: Scene,
136:     skill: number,
137:     follow: (out: { x: number; y: number; z: number }) => void
138:   ): LightSource | null {
139:     return lightSkillTrail(scene, skill, follow);
140:   }
141: 
142:   /**
143:    * Light an arrow for the length of its flight - the original lights the
144:    * arrow body itself every frame it is alive. `skill` is 0 for a plain bow
145:    * shot. Null when that arrow flies dark, so the caller skips the rest.
146:    */
147:   arrow(
148:     scene: Scene,
149:     skill: number,
150:     model: string,
151:     follow: (out: { x: number; y: number; z: number }) => void
152:   ): LightSource | null {
153:     return lightArrow(scene, skill, model, follow);
154:   }
155: 
156:   /** Light a server object effect (level-up, shields, swirl) on an entity. */
157:   objectEffect(scene: Scene, entity: Entity, effect: Events['objectEffect']['effect']): void {
158:     lightObjectEffect(scene, entity, effect);
159:   }
160: 
161:   /** Attach / drop an NPC or monster's carried light (CHARACTER_LIGHTS). */
162:   lightCharacter(scene: Scene, e: Entity): void {
163:     lightCharacter(scene, e);
164:   }
165: 
166:   snuffCharacter(e: Entity): void {
167:     snuffCharacter(e);
168:   }
169: 
170:   /**
171:    * An ad-hoc light from any recipe - for a host that is not an entry (a
172:    * map object class, a test). Prefer a row in an entry's table.
173:    */
174:   flash(scene: Scene, recipe: LightRecipe, anchor: LightAnchor): LightSource {
175:     return LightSource.attach(scene, recipe, anchor);
176:   }
177: }
178: 
179: export const lighting = new Lighting();
180: 
181: // A hot update that reaches this module must reload the page: Vite would
182: // otherwise re-execute it and hand later-loaded importers a second instance
183: // of this singleton (same guard as store.ts).
184: const hot = (import.meta as { hot?: { decline(): void } }).hot;
185: if (hot) hot.decline();
</file>

<file path="src/lighting/items.ts">
  1: /**
  2:  * Items as lights : in the improved look, +9…+15 gear lights
  3:  * the wearer's surroundings - one point light and a terrain stain per
  4:  * character, following the body - and a dropped +9…+15 item does the same,
  5:  * static. The colour is the item tier's, breathing on the item-glow clock so
  6:  * floor and blade agree (`common/itemVisualTier.ts`).
  7:  *
  8:  * What triggers a lamp stays in `ecs/systems/itemGlowSystem.ts`: it knows
  9:  * which entity wears what, stamps the meshes, and owns the auras and
 10:  * crackles; it asks this entry for the light and writes the wearer's
 11:  * `SelfLight` from `itemSelfLight`.
 12:  */
 13: import type { Scene } from '../libs/babylon/exports';
 14: import type { TerrainLightColor } from '../common/terrainDynamicLight';
 15: import {
 16:   itemGlowClock,
 17:   itemLightColorAt,
 18:   type ItemVisualTier,
 19: } from '../common/itemVisualTier';
 20: import type { LightingLayer } from './layer';
 21: import { LightSource, PRIORITY_TORCH, type LightRecipe } from './lightSource';
 22: 
 23: // ---- 1. tuning -------------------------------------------------------------
 24: 
 25: /** Light hovers at chest height on a character; drops sit on the floor. */
 26: const CHARACTER_LIGHT_HEIGHT = 0.9;
 27: const DROP_LIGHT_HEIGHT = 0.35;
 28: 
 29: /** Fraction of the light colour fed back into the wearer's own body light. */
 30: const SELF_LIGHT = 0.35;
 31: 
 32: /** Terrain-stain floor gain: softer than a torch, it's jewellery not fire. */
 33: const FLOOR_GAIN = 0.7;
 34: 
 35: /** Pool priority: hero > other players > drops / torches, then distance. */
 36: const PRIORITY_HERO = 2;
 37: const PRIORITY_PLAYER = 1;
 38: const PRIORITY_DROP = PRIORITY_TORCH;
 39: 
 40: export type ItemLampKind = 'hero' | 'player' | 'drop';
 41: 
 42: function itemRecipe(tier: ItemVisualTier, kind: ItemLampKind): LightRecipe {
 43:   return {
 44:     color: out => itemLightColorAt(tier, itemGlowClock(), out),
 45:     range: tier.terrainRange,
 46:     pointRange: tier.lightRange,
 47:     floorGain: FLOOR_GAIN,
 48:     heightOffset: kind === 'drop' ? DROP_LIGHT_HEIGHT : CHARACTER_LIGHT_HEIGHT,
 49:     priority:
 50:       kind === 'hero'
 51:         ? PRIORITY_HERO
 52:         : kind === 'player'
 53:           ? PRIORITY_PLAYER
 54:           : PRIORITY_DROP,
 55:     // Gear is worn for the whole map; the pool's cross-fade is right for it.
 56:     instant: false,
 57:   };
 58: }
 59: 
 60: // ---- 2. state + readers ----------------------------------------------------
 61: 
 62: const lamps = new Set<LightSource>();
 63: 
 64: /**
 65:  * Command: a lamp for an item tier at `position`, which is held by reference
 66:  * - the caller moves it with the wearer. Null for tiers that throw no light
 67:  * (`lightGain` 0). The caller keeps the handle and `dispose()`s it when the
 68:  * gear changes; a map change disposes it underneath (the facade's reset),
 69:  * after which `alive` is false and the caller rebuilds.
 70:  */
 71: export function lightItem(
 72:   scene: Scene,
 73:   tier: ItemVisualTier,
 74:   kind: ItemLampKind,
 75:   position: { x: number; y: number; z: number }
 76: ): LightSource | null {
 77:   if (tier.lightGain <= 0) return null;
 78: 
 79:   const lamp = LightSource.attach(scene, itemRecipe(tier, kind), { position });
 80: 
 81:   lamps.add(lamp);
 82: 
 83:   return lamp;
 84: }
 85: 
 86: /**
 87:  * Reader: what the wearer's own body gets back from their gear - the
 88:  * original adds `o->Light` to the character it belongs to.
 89:  */
 90: export function itemSelfLight(
 91:   lamp: LightSource,
 92:   out: TerrainLightColor
 93: ): TerrainLightColor {
 94:   const c = lamp.color;
 95: 
 96:   out.r = c.r * SELF_LIGHT;
 97:   out.g = c.g * SELF_LIGHT;
 98:   out.b = c.b * SELF_LIGHT;
 99: 
100:   return out;
101: }
102: 
103: function update(): void {
104:   for (const lamp of lamps) if (!lamp.alive) lamps.delete(lamp);
105: }
106: 
107: function reset(): void {
108:   lamps.clear();
109: }
110: 
111: function emitters(): readonly LightSource[] {
112:   return Array.from(lamps);
113: }
114: 
115: // ---- 3. the layer ----------------------------------------------------------
116: 
117: export const itemsLayer: LightingLayer = {
118:   name: 'items',
119:   update,
120:   reset,
121:   emitters,
122: };
</file>

<file path="src/lighting/keyRig.ts">
  1: import {
  2:   Color3,
  3:   DirectionalLight,
  4:   HemisphericLight,
  5:   Vector3,
  6:   type Scene,
  7: } from '../libs/babylon/exports';
  8: 
  9: /**
 10:  * The key-light rig: single owner of the two scene-wide key lights, the
 11:  * hemispheric sky and the directional sun (ARCHITECTURE §4.1).
 12:  *
 13:  * Contracts:
 14:  *  - `lighting/director.ts` is the only caller of `setKey` /
 15:  *    `setSunDirection` / `syncSpecular`.
 16:  *  - Everyone else (CSM, blob shadows, footprints, terrain overlay) *reads*
 17:  *    the rig via `sunLightOf` / `skyLightOf` and never writes it.
 18:  */
 19: 
 20: /** The authored sun direction: azimuth as before, elevation 48 deg. */
 21: export const DEFAULT_SUN_DIRECTION: readonly [number, number, number] = [
 22:   0.5, -1, 0.75,
 23: ];
 24: 
 25: const rigs = new WeakMap<
 26:   Scene,
 27:   { sky: HemisphericLight; sun: DirectionalLight }
 28: >();
 29: 
 30: /** Creates the rig for a scene. Call once, from the scene bootstrap. */
 31: export function createKeyRig(scene: Scene): void {
 32:   const sky = new HemisphericLight('skyLight', new Vector3(0, 1, 0), scene);
 33:   sky.specular = Color3.Black();
 34: 
 35:   const sun = new DirectionalLight(
 36:     'sunLight',
 37:     new Vector3(...DEFAULT_SUN_DIRECTION),
 38:     scene
 39:   );
 40:   sun.specular = Color3.Black();
 41: 
 42:   rigs.set(scene, { sky, sun });
 43: }
 44: 
 45: export function skyLightOf(scene: Scene): HemisphericLight | null {
 46:   return rigs.get(scene)?.sky ?? null;
 47: }
 48: 
 49: export function sunLightOf(scene: Scene): DirectionalLight | null {
 50:   return rigs.get(scene)?.sun ?? null;
 51: }
 52: 
 53: /**
 54:  * The key values, written by the director only. `skyGround = null`
 55:  * collapses the hemisphere (ground = sky), which is the Classic flat look.
 56:  */
 57: export function setKey(
 58:   scene: Scene,
 59:   params: {
 60:     skyIntensity: number;
 61:     skyDiffuse: readonly [number, number, number];
 62:     skyGround: readonly [number, number, number] | null;
 63:     sunIntensity: number;
 64:     sunDiffuse: readonly [number, number, number];
 65:   }
 66: ): void {
 67:   const rig = rigs.get(scene);
 68:   if (!rig) return;
 69: 
 70:   const { sky, sun } = rig;
 71: 
 72:   sky.intensity = params.skyIntensity;
 73:   sky.diffuse.set(...params.skyDiffuse);
 74:   if (params.skyGround) {
 75:     sky.groundColor.set(...params.skyGround);
 76:   } else {
 77:     sky.groundColor.copyFrom(sky.diffuse);
 78:   }
 79: 
 80:   sun.intensity = params.sunIntensity;
 81:   sun.diffuse.set(...params.sunDiffuse);
 82: }
 83: 
 84: /** The direction the sun travels; the profile's, via the director. */
 85: export function setSunDirection(
 86:   scene: Scene,
 87:   direction: readonly [number, number, number]
 88: ): void {
 89:   const sun = rigs.get(scene)?.sun;
 90:   if (!sun) return;
 91: 
 92:   sun.direction.set(direction[0], direction[1], direction[2]);
 93: }
 94: 
 95: /**
 96:  * The sun's highlight strength: the sun is the only key light that throws a
 97:  * specular (the PBR material reads it, the Standard one ignores it). 0 turns
 98:  * it off.
 99:  */
100: export function syncSpecular(scene: Scene, scale: number): void {
101:   const sun = rigs.get(scene)?.sun;
102:   if (!sun) return;
103: 
104:   if (scale > 0) {
105:     sun.specular.copyFrom(sun.diffuse).scaleInPlace(scale);
106:   } else {
107:     sun.specular.set(0, 0, 0);
108:   }
109: }
</file>

