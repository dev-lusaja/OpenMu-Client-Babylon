  1: import { ENUM_WORLD } from '../common/types';
  2: import { maps } from '../maps';
  3: 
  4: export type Rgb = readonly [number, number, number];
  5: 
  6: /**
  7:  * A map's look: the whole per-map surface (lighting_polish ARCHITECTURE §4.2).
  8:  * Pure data; the director composes it, nothing here touches Babylon.
  9:  */
 10: export type LookProfile = {
 11:   /** Exposure in stops over unity. Classic ignores it. */
 12:   readonly ev: number;
 13:   /** Per-channel multiplier, each within [0.94, 1.06]. Applied luma-neutral. */
 14:   readonly whiteBalance: Rgb;
 15:   /** The sky the dome draws and the haze reads (sky_atmospherics §3). Null = enclosed. */
 16:   readonly sky: SkyLook | null;
 17:   /**
 18:    * Distance-gated haze (§4.8): `cap x (1 - exp(-density x max(0, dist - start)))`,
 19:    * in tiles; 0 density = no pass. `height` is the small extra density at
 20:    * ground level that thins upward; `color` overrides the horizon for maps
 21:    * with no sky (Atlans).
 22:    */
 23:   readonly fog: {
 24:     readonly start: number;
 25:     readonly density: number;
 26:     readonly cap: number;
 27:     readonly height: number;
 28:     readonly color: Rgb | null;
 29:   };
 30:   /**
 31:    * The fog that fills the bottom of the world, under `top` and thickening
 32:    * downward - what a map with holes in its ground is standing over.
 33:    *
 34:    * Devias' ravines are `NoGround` tiles, which the ground mesh sends past the
 35:    * far plane, so what shows through them is the sky dome: panes of pale blue
 36:    * lying across the snow field, brighter than the snow they are cut out of.
 37:    * A ray down one of those never meets anything, so it collects this the
 38:    * whole way and ends black; a ray that stops on the cliff face a few tiles
 39:    * down collects a few tiles of it and comes back half there. That is the
 40:    * difference between a fog and a cut-out, and it is why this is integrated
 41:    * along the ray rather than keyed off the height the ray happened to end
 42:    * at: the same wall reads differently near and far, and nothing anywhere
 43:    * has an edge.
 44:    *
 45:    * `top` belongs under the map's lowest walkable ground, or the field itself
 46:    * is standing in it. Omit for a map whose ground has no holes in it.
 47:    */
 48:   readonly underworld?: {
 49:     /** World height the fog starts under. */
 50:     readonly top: number;
 51:     /** Density at `top`, per tile of ray travelled. */
 52:     readonly density: number;
 53:     /** How fast it thickens below that: e-folds per tile of descent. */
 54:     readonly falloff: number;
 55:     /** What a ray that never comes out of it ends up. */
 56:     readonly color: Rgb;
 57:   };
 58:   /**
 59:    * Sun direction for the shaped key and its share of the key total; the sky
 60:    * takes the rest, and a shadow removes exactly the share (§3.2).
 61:    */
 62:   readonly sun: SunSpec;
 63: };
 64: 
 65: export type SunSpec = {
 66:   readonly azimuthDeg: number;
 67:   readonly elevationDeg: number;
 68:   readonly share: number;
 69: };
 70: 
 71: /**
 72:  * A map's sky (sky_atmospherics ARCHITECTURE §3). `horizon` is also the haze
 73:  * colour, so moving a graded map's pair moves its whole far field: the five
 74:  * maps that were graded on their pair keep it and take only the new terms.
 75:  */
 76: export type SkyLook = {
 77:   readonly zenith: Rgb;
 78:   readonly horizon: Rgb;
 79:   /** Horizon-to-zenith exponent. 1 is the flat linear ramp; above it the horizon band tightens. */
 80:   readonly curve?: number;
 81:   /** The sun disc and its halo, display sRGB; null for an overcast map with no disc. */
 82:   readonly sun?: Rgb | null;
 83:   /** Halo strength around the sun. */
 84:   readonly halo?: number;
 85:   /** Base cloud coverage, 0..1. */
 86:   readonly clouds?: number;
 87:   /** Far scenery on the skyline; omit for a map whose ground is all there is. */
 88:   readonly skyline?: SkylineLook;
 89: };
 90: 
 91: /**
 92:  * A painted horizon (sky_atmospherics §10): a panorama strip wrapped around
 93:  * the camera past everything the map draws, so the ground reads as ending in
 94:  * a country rather than in the haze. Nothing the original client had.
 95:  *
 96:  * The angles place the strip's two edges against the eye line, so the art's
 97:  * own skyline lands where its split says it does - Lorencia's sits 52% down
 98:  * the strip, so 6.8 up against 6.2 down puts it on the eye.
 99:  */
100: export type SkylineLook = {
101:   /** The strip, served from `public/`. */
102:   readonly art: string;
103:   /** Degrees its top edge stands above the eye line. */
104:   readonly riseDeg: number;
105:   /** Degrees its bottom edge sits below the eye line. */
106:   readonly dropDeg: number;
107:   /** How far the art is pulled toward this sky's horizon colour, 0..1. */
108:   readonly haze: number;
109:   /** Fraction of the strip's height its bottom edge dissolves over. */
110:   readonly fade: number;
111: };
