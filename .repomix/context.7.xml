186: export function disposePreparedTerrain(prepared: PreparedTerrain): void {
187:   for (const texture of prepared.terrainTextures) texture.dispose();
188:   prepared.tileArray?.texture.dispose();
189:   disposeTerrainWaterFrames(prepared.waterFrames);
190: }
