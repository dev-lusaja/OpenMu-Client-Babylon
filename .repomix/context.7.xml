<file path="src/libs/mu/artMatch.ts">
 1: /**
 2:  * Reading a map's own tile art: how much a fragment of ground ALREADY is the
 3:  * substance a terrain overlay draws.
 4:  *
 5:  * A leaf module on purpose. The numbers below were set against the textures
 6:  * the maps ship, and `snowArtMatch.test.ts` pins them to those measurements -
 7:  * which only works if the test can import this without dragging the store,
 8:  * the scene and the weather clock in behind it.
 9:  */
10: 
11: /**
12:  * What a layer's substance looks like in tile art, as two ramps over the
13:  * resolved splat albedo. `lum` is `[start, full]` on luminance and `chroma`
14:  * is `[start, gone]` on saturation, so the match climbs with brightness and
15:  * falls away with colour.
16:  */
17: export type ArtMatch = {
18:   readonly lum: readonly [number, number];
19:   readonly chroma: readonly [number, number];
20: };
21: 
22: /** GLSL's smoothstep. */
23: function smoothstep(edge0: number, edge1: number, x: number): number {
24:   const t = Math.min(1, Math.max(0, (x - edge0) / (edge1 - edge0)));
25:   return t * t * (3 - 2 * t);
26: }
27: 
28: /**
29:  * How much this albedo already IS the substance, 0…1. The CPU twin of the
30:  * shader's `ovArtMatch`; both read the colour in the tile textures' own
31:  * space, which is where the overlay body runs - the linear decode is the last
32:  * line of the terrain fragment, long after it.
33:  */
34: export function artMatch(
35:   spec: ArtMatch,
36:   r: number,
37:   g: number,
38:   b: number
39: ): number {
40:   const mx = Math.max(r, Math.max(g, b));
41:   const mn = Math.min(r, Math.min(g, b));
42:   const chroma = mx > 0 ? (mx - mn) / mx : 0;
43:   const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
44:   return (
45:     smoothstep(spec.lum[0], spec.lum[1], lum) *
46:     (1 - smoothstep(spec.chroma[0], spec.chroma[1], chroma))
47:   );
48: }
49: 
50: /**
51:  * Snow as the maps paint it, measured off the shipped tiles
52:  * (`Data/World<n>/Tile*.OZJ`, mean sRGB).
53:  *
54:  * Devias' snow grass sits at 0.89 luminance and 0.07 chroma and its snow rock
55:  * at 0.80 / 0.17, so both are read as snow and the settled layer leaves them
56:  * alone. Its grey field ground (0.45) and its cobbles (0.60) are under the
57:  * ramp and take the layer as before, which is what keeps the field
58:  * continuous. Santa Town's dark grass (0.31) takes it too - a snow village
59:  * over dark ground is exactly what the layer is for.
60:  *
61:  * Chroma is not a refinement, it is half the test: Santa Town's water and the
62:  * ice fields' blue ice are as bright as a drift (0.66, 0.75) and nothing like
63:  * as grey, and luminance alone would call all three snow.
64:  */
65: export const SNOW_ART: ArtMatch = {
66:   lum: [0.62, 0.85],
67:   chroma: [0.16, 0.34],
68: };
</file>

<file path="src/libs/mu/buffNameFile.ts">
  1: /**
  2:  * `Data/Local/<pack>/BuffEffect_<lang>.bmd` - the buff and debuff names in the
  3:  * language the player picked.
  4:  *
  5:  * `_BUFFINFO` (`w_BuffScriptLoader.h`), read the way `BuffScriptLoader::Load`
  6:  * reads it: an `int` record count, then that many 158-byte records each XOR-ed
  7:  * with the 3-byte Bux key restarting at every record, then a 4-byte checksum.
  8:  *
  9:  * ```
 10:  * short s_BuffIndex;        // 0  - eBuffState, == OpenMU MagicEffectNumber
 11:  * BYTE  s_BuffEffectType;   // 2
 12:  * BYTE  s_ItemType;         // 3
 13:  * BYTE  s_ItemIndex;        // 4
 14:  * char  s_BuffName[50];     // 5
 15:  * BYTE  s_BuffClassType;    // 55 - 0 buff, 1 debuff
 16:  * BYTE  s_NoticeType;       // 56
 17:  * BYTE  s_ClearType;        // 57
 18:  * char  s_BuffDescript[100];// 58
 19:  * ```
 20:  *
 21:  * Only the name is read. `skills/recipes.ts` keeps the buff / debuff split and
 22:  * the durations, because those drive the bar rather than the label, and the
 23:  * catalogue still wins for the effects it names - see `buffRecipe`.
 24:  */
 25: 
 26: import { observable, runInAction } from 'mobx';
 27: import { convertBux } from '../../common/terrain/mapFileEncryption';
 28: import { i18n, onLanguageChanged } from '../../i18n';
 29: import {
 30:   checkPackText,
 31:   decodeLocalText,
 32:   downloadPackDataFile,
 33:   repairPackText,
 34: } from './localData';
 35: 
 36: const FILE = 'BuffEffect';
 37: const HEADER_SIZE = 4;
 38: const RECORD_SIZE = 158;
 39: const NAME_OFFSET = 5;
 40: const NAME_LENGTH = 50;
 41: 
 42: const names = observable.box<ReadonlyMap<number, string>>(new Map(), {
 43:   deep: false,
 44: });
 45: 
 46: let pending: Promise<void> | null = null;
 47: 
 48: function set(map: ReadonlyMap<number, string>): void {
 49:   runInAction(() => names.set(map));
 50: }
 51: 
 52: /** Effect id -> name. Exported so the record layout can be tested without a fetch. */
 53: export function parseBuffNames(bytes: Uint8Array): Map<number, string> {
 54:   const out = new Map<number, string>();
 55:   if (bytes.length < HEADER_SIZE) return out;
 56: 
 57:   const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
 58:   const declared = view.getInt32(0, true);
 59:   const fit = Math.floor((bytes.length - HEADER_SIZE) / RECORD_SIZE);
 60:   const count = Math.max(0, Math.min(declared, fit));
 61: 
 62:   for (let i = 0; i < count; i++) {
 63:     const offset = HEADER_SIZE + i * RECORD_SIZE;
 64:     convertBux(bytes.subarray(offset, offset + RECORD_SIZE), RECORD_SIZE);
 65: 
 66:     const id = view.getInt16(offset, true);
 67:     const name = repairPackText(
 68:       decodeLocalText(bytes, offset + NAME_OFFSET, NAME_LENGTH)
 69:     );
 70:     if (id > 0 && name) out.set(id, name);
 71:   }
 72: 
 73:   return out;
 74: }
 75: 
 76: /** Load the overlay for the active language; a no-op without a pack. */
 77: export function loadBuffNames(): Promise<void> {
 78:   if (pending) return pending;
 79: 
 80:   const pack = i18n.dataPack;
 81:   if (!pack || pack.folder === 'Eng') {
 82:     set(new Map());
 83:     pending = Promise.resolve();
 84:     return pending;
 85:   }
 86: 
 87:   const wanted = i18n.language;
 88: 
 89:   pending = downloadPackDataFile(FILE)
 90:     .then(bytes => {
 91:       if (i18n.language !== wanted || !bytes.length) return;
 92:       const parsed = parseBuffNames(bytes);
 93:       checkPackText(FILE, parsed.values());
 94:       set(parsed);
 95:     })
 96:     .catch(err => {
 97:       console.warn(`Buff names for ${pack.folder} are missing:`, err);
 98:       if (i18n.language === wanted) set(new Map());
 99:     });
100: 
101:   return pending;
102: }
103: 
104: /** The localised name for an effect id, or undefined for the English one. */
105: export function localisedBuffName(effectId: number): string | undefined {
106:   return names.get().get(effectId);
107: }
108: 
109: onLanguageChanged(() => {
110:   pending = null;
111:   set(new Map());
112:   void loadBuffNames();
113: });
114: 
115: // Deferred past module evaluation, like `itemNameFile`: this module can run
116: // before `i18n/index.ts` has, and reading `dataPack` then loads nothing.
117: queueMicrotask(() => void loadBuffNames());
</file>

<file path="src/libs/mu/cameraWalkScript.ts">
 1: import { downloadDataBytesBuffer } from '../../common/utils';
 2: 
 3: const CWS_SIGNATURE = 0x00535743;
 4: const HEADER_SIZE = 8;
 5: const WAYPOINT_SIZE = 28;
 6: 
 7: const MU_SCALE = 100;
 8: 
 9: export type CameraWaypoint = {
10:   x: number;
11:   y: number;
12:   height: number;
13:   delay: number;
14:   moveAccel: number;
15:   distanceLevel: number;
16: };
17: 
18: export function parseCameraWalkScript(
19:   name: string,
20:   buffer: Uint8Array
21: ): CameraWaypoint[] {
22:   if (buffer.length < HEADER_SIZE) {
23:     throw new Error(`${name} is too small to be a camera walk script`);
24:   }
25: 
26:   const view = new DataView(
27:     buffer.buffer,
28:     buffer.byteOffset,
29:     buffer.byteLength
30:   );
31: 
32:   const signature = view.getUint32(0, true);
33: 
34:   if (signature !== CWS_SIGNATURE) {
35:     throw new Error(
36:       `${name} is not a camera walk script (signature 0x${signature.toString(16)})`
37:     );
38:   }
39: 
40:   const count = view.getUint32(4, true);
41:   const expected = HEADER_SIZE + count * WAYPOINT_SIZE;
42: 
43:   if (buffer.length < expected) {
44:     throw new Error(
45:       `${name} is truncated: ${count} waypoints need ${expected} bytes, got ${buffer.length}`
46:     );
47:   }
48: 
49:   const waypoints: CameraWaypoint[] = [];
50: 
51:   for (let i = 0; i < count; i++) {
52:     const o = HEADER_SIZE + i * WAYPOINT_SIZE;
53: 
54:     waypoints.push({
55:       x: view.getFloat32(o + 4, true) / MU_SCALE,
56:       y: view.getFloat32(o + 8, true) / MU_SCALE,
57:       height: view.getFloat32(o + 12, true),
58:       delay: view.getInt32(o + 16, true),
59:       moveAccel: view.getFloat32(o + 20, true),
60:       distanceLevel: view.getFloat32(o + 24, true),
61:     });
62:   }
63: 
64:   return waypoints;
65: }
66: 
67: export async function loadCameraWalkScript(
68:   worldNum: number
69: ): Promise<CameraWaypoint[] | null> {
70:   const name = `World${worldNum}/CWScript${worldNum}.cws`;
71: 
72:   try {
73:     const buffer = await downloadDataBytesBuffer(name);
74: 
75:     return parseCameraWalkScript(name, buffer);
76:   } catch {
77:     return null;
78:   }
79: }
</file>

<file path="src/libs/mu/customGroundMesh.ts">
  1: import { TERRAIN_SIZE, TWFlags } from '../../common/terrain/consts';
  2: import { TERRAIN_INDEX } from '../../common/terrain/utils';
  3: import { isFlagInBinaryMask } from '../../common/utils';
  4: import {
  5:   type Scene,
  6:   VertexData,
  7:   Mesh,
  8:   Scalar,
  9:   IVector2Like,
 10:   IVector3Like,
 11:   Vector3,
 12: } from '../babylon/exports';
 13: 
 14: function clamp(n: number) {
 15:   return n >= TERRAIN_SIZE ? TERRAIN_SIZE - 1 : n;
 16: }
 17: 
 18: function getTerrainIndex(x: number, y: number) {
 19:   return TERRAIN_INDEX(clamp(x), clamp(y));
 20: }
 21: 
 22: const tilesCountPerSide = 256;
 23: const v3Temp = Vector3.Zero();
 24: 
 25: export function CreateGroundFromHeightMap(
 26:   name: string,
 27:   scene: Scene,
 28:   heightBuffer: Float32Array,
 29:   layer1: Uint8Array,
 30:   layer2: Uint8Array,
 31:   alpha: Uint8Array,
 32:   backTerrainLight: IVector3Like[],
 33:   terrainFlags: Uint16Array,
 34:   ambientLight: Vector3
 35: ): Mesh {
 36:   const ground = new Mesh(name, scene);
 37: 
 38:   const indices: number[] = [];
 39:   const positions: number[] = [];
 40:   const normals: number[] = [];
 41:   const uvs: number[] = [];
 42:   const textures: number[] = [];
 43:   const colors: number[] = [];
 44:   const alphaColors: number[] = [];
 45: 
 46:   function buildVertexLight(index: number, pos?: IVector2Like) {
 47:     const count = backTerrainLight.length;
 48:     const color = v3Temp;
 49: 
 50:     if (index < count) {
 51:       color.copyFrom(backTerrainLight[index] as any);
 52:     }
 53: 
 54:     color.x = ambientLight.x + color.x * (1 - ambientLight.x);
 55:     color.y = ambientLight.y + color.y * (1 - ambientLight.y);
 56:     color.z = ambientLight.z + color.z * (1 - ambientLight.z);
 57: 
 58: return color.asArray();
 59:   }
 60: 
 61:   function applyAlphaToLights(a1: number, a2: number, a3: number, a4: number) {
 62:     let index = alphaColors.length - 4 * 4;
 63: 
 64:     a1 = a1 / 255;
 65:     a2 = a2 / 255;
 66:     a3 = a3 / 255;
 67:     a4 = a4 / 255;
 68: 
 69:     alphaColors[index++] *= a1;
 70:     alphaColors[index++] *= a1;
 71:     alphaColors[index++] *= a1;
 72:     alphaColors[index++] = a1;
 73:     alphaColors[index++] *= a2;
 74:     alphaColors[index++] *= a2;
 75:     alphaColors[index++] *= a2;
 76:     alphaColors[index++] = a2;
 77:     alphaColors[index++] *= a3;
 78:     alphaColors[index++] *= a3;
 79:     alphaColors[index++] *= a3;
 80:     alphaColors[index++] = a3;
 81:     alphaColors[index++] *= a4;
 82:     alphaColors[index++] *= a4;
 83:     alphaColors[index++] *= a4;
 84:     alphaColors[index++] = a4;
 85:   }
 86: 
 87:   function prepareVertices(
 88:     x: number,
 89:     y: number,
 90:     idx1: number,
 91:     idx2: number,
 92:     idx3: number,
 93:     idx4: number
 94:   ) {
 95:     const flag = terrainFlags[getTerrainIndex(x, y)];
 96:     const noGround = isFlagInBinaryMask(flag, TWFlags.NoGround);
 97: 
 98:     const h1 = noGround ? -10000 : heightBuffer[idx1];
 99:     const h2 = noGround ? -10000 : heightBuffer[idx2];
100:     const h3 = noGround ? -10000 : heightBuffer[idx3];
101:     const h4 = noGround ? -10000 : heightBuffer[idx4];
102: 
103:     positions.push(x, h1, y);
104:     positions.push(x + 1, h2, y);
105:     positions.push(x + 1, h3, y + 1);
106:     positions.push(x, h4, y + 1);
107: 
108:     normals.push(0, 0, 0);
109:     normals.push(0, 0, 0);
110:     normals.push(0, 0, 0);
111:     normals.push(0, 0, 0);
112:   }
113: 
114:   function prepareLights(
115:     x: number,
116:     y: number,
117:     idx1: number,
118:     idx2: number,
119:     idx3: number,
120:     idx4: number
121:   ) {
122:     colors.push(...buildVertexLight(idx1), 1);
123:     colors.push(...buildVertexLight(idx2), 1);
124:     colors.push(...buildVertexLight(idx3), 1);
125:     colors.push(...buildVertexLight(idx4), 1);
126: 
127:     alphaColors.push(...buildVertexLight(idx1), 0);
128:     alphaColors.push(...buildVertexLight(idx2), 0);
129:     alphaColors.push(...buildVertexLight(idx3), 0);
130:     alphaColors.push(...buildVertexLight(idx4), 0);
131:   }
132: 
133:   function prepareUVs(x: number, y: number) {
134:     x = x < 0 ? 0 : x;
135:     y = y < 0 ? 0 : y;
136: 
137:     uvs.push(x / tilesCountPerSide, y / tilesCountPerSide);
138:     uvs.push((x + 1) / tilesCountPerSide, y / tilesCountPerSide);
139:     uvs.push((x + 1) / tilesCountPerSide, (y + 1) / tilesCountPerSide);
140:     uvs.push(x / tilesCountPerSide, (y + 1) / tilesCountPerSide);
141:   }
142: 
143:   function addTile(x: number, y: number) {
144:     const idx = getTerrainIndex(x, y);
145:     const idx2 = getTerrainIndex(x + 1, y);
146:     const idx3 = getTerrainIndex(x + 1, y + 1);
147:     const idx4 = getTerrainIndex(x, y + 1);
148: 
149:     prepareVertices(x, y, idx, idx2, idx3, idx4);
150:     prepareLights(x, y, idx, idx2, idx3, idx4);
151:     prepareUVs(x, y);
152: 
153:     const a1 = idx < alpha.length ? alpha[idx] : 0;
154:     const a2 = idx2 < alpha.length ? alpha[idx2] : 0;
155:     const a3 = idx3 < alpha.length ? alpha[idx3] : 0;
156:     const a4 = idx4 < alpha.length ? alpha[idx4] : 0;
157: 
158:     const isOpaque = (a1 & a2 & a3 & a4) === 255;
159:     const hasAlpha = (a1 | a2 | a3 | a4) !== 0;
160: 
161:     const opaqueTexture = isOpaque ? layer2[idx] : layer1[idx];
162:     const alphaTexture = !isOpaque && hasAlpha ? layer2[idx] : -1;
163: 
164:     textures.push(opaqueTexture, alphaTexture);
165:     textures.push(opaqueTexture, alphaTexture);
166:     textures.push(opaqueTexture, alphaTexture);
167:     textures.push(opaqueTexture, alphaTexture);
168: 
169:     if (!isOpaque && hasAlpha) {
170:       applyAlphaToLights(a1, a2, a3, a4);
171:     }
172: 
173:     if (isOpaque) {
174:     } else {
175:     }
176:   }
177: 
178:   for (let y = 0; y < tilesCountPerSide; y++) {
179:     for (let x = 0; x < tilesCountPerSide; x++) {
180:       addTile(x, y);
181: 
182:       const idxOffset = (y * tilesCountPerSide + x) * 4;
183:       const idx1 = idxOffset + 0;
184:       const idx2 = idxOffset + 1;
185:       const idx3 = idxOffset + 2;
186:       const idx4 = idxOffset + 3;
187: 
188:       indices.push(idx1);
189:       indices.push(idx2);
190:       indices.push(idx3);
191: 
192:       indices.push(idx4);
193:       indices.push(idx1);
194:       indices.push(idx3);
195:     }
196:   }
197: 
198:   VertexData.ComputeNormals(positions, indices, normals);
199: 
200:   const vertexData = new VertexData();
201: 
202:   vertexData.indices = indices;
203:   vertexData.positions = positions;
204:   vertexData.normals = normals;
205:   vertexData.uvs = uvs;
206:   vertexData.uvs2 = textures;
207:   vertexData.colors = colors;
208:   vertexData.matricesWeights = alphaColors;
209: 
210:   vertexData.applyToMesh(ground, true);
211: 
212:   return ground;
213: }
</file>

<file path="src/libs/mu/dataFolder.ts">
 1: import { downloadBytesBuffer } from '../../common/utils';
 2: import { gameVersion } from '../../version';
 3: 
 4: /**
 5:  * Base URL of the *original* `Data/` tree (sprites, effect textures, Local
 6:  * tables, gate.bmd). Kept separate from `resolveUrlToDataFolder`, which points
 7:  * at the converted `public/game-assets`.
 8:  *
 9:  * `vite dev` serves the `client/Data` junction at `/Data/` with no config, so
10:  * the default `./Data/` works there. For a production build the subset the
11:  * client actually fetches is copied into `dist/Data` by
12:  * [tools/copyData.ts](../../../tools/copyData.ts) (run from `bun run build`),
13:  * so the same default works from `dist/`. A deployment that hosts the data
14:  * elsewhere (CDN, another origin) sets `VITE_DATA_URL` at build time; a
15:  * trailing slash is added if missing. Both are decided by the selected game
16:  * version (`versions/<id>/data`), since each version has its own tree.
17:  */
18: export const DATA_FOLDER = gameVersion.data.folder;
19: 
20: export function resolveDataUrl(path: string): string {
21:   return DATA_FOLDER + path.replace(/^[./]+/, '');
22: }
23: 
24: export function downloadDataFile(path: string): Promise<Uint8Array> {
25:   return downloadBytesBuffer(resolveDataUrl(path));
26: }
27: 
28: /**
29:  * Does the active version's `Data/` tree contain this path? A version that
30:  * declares no inventory (Season 6) answers yes to everything, so nothing
31:  * about it changes; a period tree answers no for the Season 6 chrome and the
32:  * post-0.97 effect textures it never shipped, and its loaders draw nothing
33:  * instead of fetching a 404 per frame (`versions/<id>/data/inventory.ts`).
34:  */
35: export function hasDataFile(path: string): boolean {
36:   const inventory = gameVersion.data.inventory;
37: 
38:   if (!inventory) return true;
39: 
40:   return inventory.has(path.replace(/^[./]+/, '').toLowerCase());
41: }
</file>

<file path="src/libs/mu/gates.ts">
 1: import { convertBux } from '../../common/terrain/mapFileEncryption';
 2: import { downloadDataFile } from './dataFolder';
 3: 
 4: const MAX_GATES = 512;
 5: const GATE_RECORD_SIZE = 14;
 6: 
 7: export const GateFlag = {
 8:   Entrance: 1,
 9:   Exit: 2,
10: } as const;
11: 
12: export type Gate = {
13:   index: number;
14:   flag: number;
15:   map: number;
16:   x1: number;
17:   y1: number;
18:   x2: number;
19:   y2: number;
20:   target: number;
21:   angle: number;
22:   level: number;
23:   maxLevel: number;
24: };
25: 
26: let pending: Promise<Gate[]> | null = null;
27: 
28: export function loadGates(): Promise<Gate[]> {
29:   if (!pending) {
30:     pending = readGates().catch(err => {
31:       pending = null;
32:       throw err;
33:     });
34:   }
35: 
36:   return pending;
37: }
38: 
39: async function readGates(): Promise<Gate[]> {
40:   const buffer = await downloadDataFile('gate.bmd');
41:   const expected = MAX_GATES * GATE_RECORD_SIZE;
42: 
43:   if (buffer.length < expected) {
44:     throw new Error(
45:       `gate.bmd is truncated: expected ${expected} bytes, got ${buffer.length}`
46:     );
47:   }
48: 
49:   const gates: Gate[] = [];
50: 
51:   for (let i = 0; i < MAX_GATES; i++) {
52:     const record = buffer.slice(
53:       i * GATE_RECORD_SIZE,
54:       (i + 1) * GATE_RECORD_SIZE
55:     );
56: 
57:     convertBux(record, GATE_RECORD_SIZE);
58: 
59:     const view = new DataView(
60:       record.buffer,
61:       record.byteOffset,
62:       record.byteLength
63:     );
64: 
65:     gates.push({
66:       index: i,
67:       flag: record[0],
68:       map: record[1],
69:       x1: record[2],
70:       y1: record[3],
71:       x2: record[4],
72:       y2: record[5],
73:       target: view.getUint16(6, true),
74:       angle: record[8],
75:       level: view.getUint16(10, true),
76:       maxLevel: view.getUint16(12, true),
77:     });
78:   }
79: 
80:   return gates;
81: }
82: 
83: export function findEntranceGateAt(
84:   gates: readonly Gate[],
85:   map: number,
86:   x: number,
87:   y: number
88: ): Gate | undefined {
89:   return gates.find(
90:     gate =>
91:       gate.flag === GateFlag.Entrance &&
92:       gate.map === map &&
93:       x >= gate.x1 &&
94:       x <= gate.x2 &&
95:       y >= gate.y1 &&
96:       y <= gate.y2
97:   );
98: }
</file>

<file path="src/libs/mu/itemNameFile.ts">
  1: /**
  2:  * `Data/Local/<pack>/item_<lang>.bmd` - the item names in the language the
  3:  * player picked.
  4:  *
  5:  * `ITEM_ATTRIBUTE_FILE` (`GameData/ItemData/ItemStructs.h`) with the legacy
  6:  * 30-byte name the Season 6 tree ships: 8192 fixed records of 84 bytes, no
  7:  * count in front, a 4-byte checksum after (which the client does not verify),
  8:  * each record XOR-ed with the 3-byte Bux key **restarting at every record** -
  9:  * one `BuxConvert(pSeek, structsize)` per record, the same as `MoveReq` and
 10:  * the quest tables. The record index is the item code: `group * 512 + index`.
 11:  *
 12:  * Only the name is read. Everything else about an item still comes from
 13:  * `items.json`, which is what the server keys on and what `muHelper` matches
 14:  * behaviour against, so this is an **overlay**: empty until a pack is loaded,
 15:  * consulted first by `itemBaseName`, English underneath.
 16:  */
 17: 
 18: import { observable, runInAction } from 'mobx';
 19: import { convertBux } from '../../common/terrain/mapFileEncryption';
 20: import { GameOptions } from '../../common/gameOptions';
 21: import { i18n, onLanguageChanged } from '../../i18n';
 22: import {
 23:   checkPackText,
 24:   decodeLocalText,
 25:   downloadPackDataFile,
 26:   repairPackText,
 27: } from './localData';
 28: 
 29: const FILE = 'item';
 30: const RECORD_SIZE = 84;
 31: const NAME_LENGTH = 30;
 32: /** `MAX_SUBTYPE` - the stride between two groups in the flat record array. */
 33: const GROUP_STRIDE = 512;
 34: 
 35: const names = observable.box<ReadonlyMap<number, string>>(new Map(), {
 36:   deep: false,
 37: });
 38: 
 39: let pending: Promise<void> | null = null;
 40: 
 41: function set(map: ReadonlyMap<number, string>): void {
 42:   runInAction(() => names.set(map));
 43: }
 44: 
 45: /** Item code -> name. Exported so the record layout can be tested without a fetch. */
 46: export function parseItemNames(bytes: Uint8Array): Map<number, string> {
 47:   const out = new Map<number, string>();
 48:   const count = Math.floor(bytes.length / RECORD_SIZE);
 49: 
 50:   for (let i = 0; i < count; i++) {
 51:     const offset = i * RECORD_SIZE;
 52:     convertBux(bytes.subarray(offset, offset + RECORD_SIZE), RECORD_SIZE);
 53: 
 54:     const name = repairPackText(decodeLocalText(bytes, offset, NAME_LENGTH));
 55:     if (name) out.set(i, name);
 56:   }
 57: 
 58:   return out;
 59: }
 60: 
 61: /**
 62:  * Load the overlay for the active language. A no-op for a language with no
 63:  * pack, and for English - `items.json` already holds those names.
 64:  */
 65: export function loadItemNames(): Promise<void> {
 66:   if (pending) return pending;
 67: 
 68:   const pack = i18n.dataPack;
 69:   if (!pack || pack.folder === 'Eng') {
 70:     set(new Map());
 71:     pending = Promise.resolve();
 72:     return pending;
 73:   }
 74: 
 75:   const wanted = i18n.language;
 76: 
 77:   pending = downloadPackDataFile(FILE)
 78:     .then(bytes => {
 79:       // Two changes in quick succession: the slower fetch must not land on
 80:       // top of the language that is current by the time it answers.
 81:       if (i18n.language !== wanted || !bytes.length) return;
 82:       const parsed = parseItemNames(bytes);
 83:       checkPackText(FILE, parsed.values());
 84:       set(parsed);
 85:     })
 86:     .catch(err => {
 87:       console.warn(`Item names for ${pack.folder} are missing:`, err);
 88:       if (i18n.language === wanted) set(new Map());
 89:     });
 90: 
 91:   return pending;
 92: }
 93: 
 94: /** The localised name for an item code, or undefined to use `items.json`. */
 95: export function localisedItemName(
 96:   group: number,
 97:   index: number
 98: ): string | undefined {
 99:   // The one option that turns a whole table off: a trader who wants to match
100:   // a price list reads `items.json` instead, with the rest of the interface
101:   // still in their own language. Observable, so every open window redraws the
102:   // moment it is switched.
103:   if (GameOptions.englishItemNames) return undefined;
104:   // A name the pack itself gets wrong, replaced before the table is read.
105:   return (
106:     i18n.itemNameFixes?.[`${group}/${index}`] ??
107:     names.get().get(group * GROUP_STRIDE + index)
108:   );
109: }
110: 
111: onLanguageChanged(() => {
112:   pending = null;
113:   set(new Map());
114:   void loadItemNames();
115: });
116: 
117: // Kicked off once the module graph has finished evaluating, never from a
118: // render: `loadItemNames` reads `i18n.dataPack`, and this module can be
119: // evaluated before `i18n/index.ts` has run its own body - a straight call here
120: // would quietly load nothing. It must not run inside a render either, because
121: // the no-pack path writes the observable synchronously.
122: queueMicrotask(() => void loadItemNames());
</file>

<file path="src/libs/mu/localData.ts">
  1: /**
  2:  * `Data/Local/<pack>/…` - the original client's own localisation.
  3:  *
  4:  * Webzen shipped one folder per language under `Data/Local/`, with the language
  5:  * tag in every file name: `Eng/Quest_eng.bmd`, `Spn/Quest_spn.bmd`,
  6:  * `Por/Quest_por.bmd`. That is where the quest names, the NPC dialogue scripts,
  7:  * the warp list and the master-skill tooltips live - text the client does not
  8:  * write itself and so is not in `i18n/recipes.ts`.
  9:  *
 10:  * This resolves one of those files for the active language and falls back to
 11:  * English **per file**, so a pack that is only half there still gives its half.
 12:  * The packs are not consistent about the case of the base name (`MoveReq_por`
 13:  * but `movereq_spn`, `Text_spn` but `text_por`), so each candidate is tried in
 14:  * the spelling asked for and all lower case; NTFS does not care, a static host
 15:  * usually does.
 16:  *
 17:  * Which pack a language uses is `dataPack` on its `LanguageLayer`; a language
 18:  * without one reads English here and is still fully translated everywhere
 19:  * `t()` reaches.
 20:  */
 21: 
 22: import { i18n } from '../../i18n';
 23: import { downloadDataFile } from './dataFolder';
 24: 
 25: /** Empty means "not there" everywhere below - the readers all tolerate it. */
 26: const MISSING = new Uint8Array(0);
 27: 
 28: /** One decoder per code page; `TextDecoder` construction is not free. */
 29: const decoders = new Map<string, TextDecoder>();
 30: 
 31: /**
 32:  * A NUL-terminated string out of one of these tables, in the code page the
 33:  * active pack declares. English is ASCII, so it reads the same either way; the
 34:  * Latin packs are windows-1252 and would come back as replacement characters
 35:  * through a UTF-8 decoder ("Evid�ncia" instead of "Evidência").
 36:  */
 37: export function decodeLocalText(
 38:   bytes: Uint8Array,
 39:   offset: number,
 40:   length: number
 41: ): string {
 42:   let end = offset;
 43:   const stop = Math.min(bytes.length, offset + length);
 44:   while (end < stop && bytes[end] !== 0) end++;
 45: 
 46:   const label = i18n.dataEncoding;
 47:   let decoder = decoders.get(label);
 48:   if (!decoder) {
 49:     // An unknown label throws; fall back rather than lose the whole table.
 50:     try {
 51:       decoder = new TextDecoder(label);
 52:     } catch {
 53:       decoder = new TextDecoder('utf-8');
 54:     }
 55:     decoders.set(label, decoder);
 56:   }
 57: 
 58:   return decoder.decode(bytes.subarray(offset, end));
 59: }
 60: 
 61: /**
 62:  * The paths to try for one localised table, best first: the active pack, then
 63:  * English, then any language-less sibling in `Local/` the caller names.
 64:  *
 65:  * @param base file name without the `_<lang>` tag or the extension
 66:  *             (`Quest`, `MoveReq`, `MasterSkillTooltip`)
 67:  * @param neutral optional language-less fallback (`Local/Quest.bmd`)
 68:  */
 69: export function localDataCandidates(base: string, neutral?: string): string[] {
 70:   const paths: string[] = [];
 71:   const pack = i18n.dataPack;
 72: 
 73:   const push = (folder: string, suffix: string) => {
 74:     paths.push(`Local/${folder}/${base}_${suffix}.bmd`);
 75:     const lower = base.toLowerCase();
 76:     if (lower !== base) paths.push(`Local/${folder}/${lower}_${suffix}.bmd`);
 77:   };
 78: 
 79:   if (pack) push(pack.folder, pack.suffix);
 80:   push('Eng', 'eng');
 81:   if (neutral) paths.push(neutral);
 82: 
 83:   return paths;
 84: }
 85: 
 86: /** One optional file; empty when it is not on the server. */
 87: async function optional(path: string): Promise<Uint8Array> {
 88:   try {
 89:     return await downloadDataFile(path);
 90:   } catch {
 91:     return MISSING;
 92:   }
 93: }
 94: 
 95: /**
 96:  * Splits a line the way `packRepairs.ts` keys it: on whitespace and `;`, then
 97:  * a token into leading punctuation / core / trailing punctuation. `?` counts
 98:  * as part of the core, because in these files it is as often a lost accent as
 99:  * a question mark.
100:  */
101: const TOKEN_SPLIT = /([\s;]+)/;
102: const LEADING = /^[^A-Za-zÀ-ÿ0-9?]+/;
103: const TRAILING = /[^A-Za-zÀ-ÿ0-9?]+$/;
104: 
105: /**
106:  * Put the accents back into a line from a damaged pack. A no-op for a pack
107:  * with no `repairs`, which is every pack but the two Latin ones.
108:  */
109: export function repairPackText(text: string): string {
110:   const repairs = i18n.dataRepairs;
111:   if (!repairs || !text) return text;
112: 
113:   // The ambiguous forms first: they need the words around them.
114:   let out = text;
115:   for (const [from, to] of repairs.phrases) out = out.split(from).join(to);
116: 
117:   return out
118:     .split(TOKEN_SPLIT)
119:     .map(part => {
120:       if (!part || !part.includes('?')) return part;
121: 
122:       const lead = LEADING.exec(part)?.[0] ?? '';
123:       const rest = part.slice(lead.length);
124:       const trail = TRAILING.exec(rest)?.[0] ?? '';
125:       const core = rest.slice(0, rest.length - trail.length);
126: 
127:       const fixed = repairs.tokens[core];
128:       return fixed === undefined ? part : lead + fixed + trail;
129:     })
130:     .join('');
131: }
132: 
133: /**
134:  * Dev-only sanity check on a table that has just been decoded.
135:  *
136:  * Some copies of the language packs in the wild were run through a lossy
137:  * conversion before they were shipped: a UTF-8 decoder read the code-page
138:  * bytes, and every accented character came back as `?` - taking the byte after
139:  * it with it ("héroe" → "h?oe", "próxima" → "pr?ima"). The text stays readable
140:  * but the accents are gone from the *file*, so no decoder can bring them back.
141:  * Say so once, loudly, rather than let it look like a bug here.
142:  *
143:  * A healthy Latin pack has far more accented characters than question marks;
144:  * a gutted one inverts that.
145:  */
146: export function checkPackText(base: string, samples: Iterable<string>): void {
147:   if (!import.meta.env?.DEV) return;
148: 
149:   const pack = i18n.dataPack;
150:   if (!pack || !/^windows-125[0-9]$/.test(pack.encoding ?? '')) return;
151: 
152:   let accents = 0;
153:   let questions = 0;
154: 
155:   for (const text of samples) {
156:     for (const ch of text) {
157:       const c = ch.codePointAt(0)!;
158:       if (c === 0x3f) questions++;
159:       else if (c > 0x7f) accents++;
160:     }
161:   }
162: 
163:   if (questions > accents * 2 && questions > 50) {
164:     console.warn(
165:       `[i18n] Local/${pack.folder}/${base}_${pack.suffix}.bmd lost its accents ` +
166:         `before it was shipped (${questions} "?" against ${accents} accented ` +
167:         `characters). The text is the pack's; replacing that one file with an ` +
168:         `undamaged copy fixes it - every other table is read per file.`
169:     );
170:   }
171: }
172: 
173: /**
174:  * One table **from the active pack only**, or empty when that pack does not
175:  * ship it.
176:  *
177:  * This is what the overlay readers (`itemNameFile`, `skillNameFile`,
178:  * `buffNameFile`) use, and the English fallback in `downloadLocalDataFile`
179:  * is exactly what they must not have: an overlay sits *on top of* the English
180:  * the client already carries, so loading `Eng` into it would replace a
181:  * language's own names with English ones it was falling back to anyway. A pack
182:  * that ships item names but no buff names then gets its item names, and its
183:  * buff names still come from the catalogue.
184:  */
185: export async function downloadPackDataFile(base: string): Promise<Uint8Array> {
186:   const pack = i18n.dataPack;
187:   if (!pack || pack.folder === 'Eng') return MISSING;
188: 
189:   const lower = base.toLowerCase();
190:   const paths = [`Local/${pack.folder}/${base}_${pack.suffix}.bmd`];
191:   if (lower !== base) paths.push(`Local/${pack.folder}/${lower}_${pack.suffix}.bmd`);
192: 
193:   for (const path of paths) {
194:     const bytes = await optional(path);
195:     if (bytes.length) return bytes;
196:   }
197: 
198:   return MISSING;
199: }
200: 
201: /**
202:  * The first of `localDataCandidates` that is actually there, or empty. Nothing
203:  * is cached: the tables that use this hold their own decoded copy and re-read
204:  * it when the language changes.
205:  */
206: export async function downloadLocalDataFile(
207:   base: string,
208:   neutral?: string
209: ): Promise<Uint8Array> {
210:   for (const path of localDataCandidates(base, neutral)) {
211:     const bytes = await optional(path);
212:     if (bytes.length) return bytes;
213:   }
214: 
215:   console.warn(`Local table ${base} is missing in every language.`);
216:   return MISSING;
217: }
</file>

<file path="src/libs/mu/localNames.test.ts">
 1: import { beforeEach, describe, expect, it } from 'vitest';
 2: import { i18n } from '../../i18n';
 3: import { parseBuffNames } from './buffNameFile';
 4: import { parseItemNames } from './itemNameFile';
 5: import { parseSkillNames } from './skillNameFile';
 6: 
 7: /**
 8:  * The record layouts of the three name tables in `Data/Local/<pack>/`.
 9:  *
10:  * The real files cannot be read here - they are fetched over HTTP by the
11:  * readers - so each test builds one the way the original writer would have,
12:  * then reads it back. What that pins down is the part that can actually be
13:  * wrong: the stride, where the name sits inside a record, and that the Bux key
14:  * restarts at every record rather than running through the file.
15:  */
16: 
17: const BUX = [0xfc, 0xcf, 0xab];
18: 
19: /** One record, name at `nameOffset`, XOR-ed with the key from its own start. */
20: function record(size: number, nameOffset: number, name: string): Uint8Array {
21:   const out = new Uint8Array(size);
22:   for (let i = 0; i < name.length; i++) out[nameOffset + i] = name.charCodeAt(i);
23:   for (let i = 0; i < size; i++) out[i] ^= BUX[i % 3];
24:   return out;
25: }
26: 
27: /** `_BUFFINFO`: short index at 0, the 50-byte name at 5, 158 bytes a record. */
28: function buffRecord(id: number, name: string): Uint8Array {
29:   const out = new Uint8Array(158);
30:   new DataView(out.buffer).setInt16(0, id, true);
31:   for (let i = 0; i < name.length; i++) out[5 + i] = name.charCodeAt(i);
32:   for (let i = 0; i < out.length; i++) out[i] ^= BUX[i % 3];
33:   return out;
34: }
35: 
36: /** The `int` record count the buff file opens with; not encrypted. */
37: function buffCount(count: number): Uint8Array {
38:   const out = new Uint8Array(4);
39:   new DataView(out.buffer).setInt32(0, count, true);
40:   return out;
41: }
42: 
43: function concat(parts: Uint8Array[]): Uint8Array {
44:   const total = parts.reduce((sum, p) => sum + p.length, 0);
45:   const out = new Uint8Array(total);
46:   let at = 0;
47:   for (const part of parts) {
48:     out.set(part, at);
49:     at += part.length;
50:   }
51:   return out;
52: }
53: 
54: describe('local name tables', () => {
55:   beforeEach(() => {
56:     // The decoder follows the active pack's code page; English is ASCII.
57:     i18n.setLanguage('en');
58:   });
59: 
60:   it('reads item names at 84 bytes a record, keyed by group * 512 + index', () => {
61:     // Record 0 is item 0/0, record 513 is item 1/1.
62:     const rows = [record(84, 0, 'Kris')];
63:     for (let i = 1; i < 513; i++) rows.push(record(84, 0, ''));
64:     rows.push(record(84, 0, 'Short Sword'));
65: 
66:     const names = parseItemNames(concat(rows));
67: 
68:     expect(names.get(0)).toBe('Kris');
69:     expect(names.get(1 * 512 + 1)).toBe('Short Sword');
70:     // Blank slots are left out rather than stored as empty strings.
71:     expect(names.has(1)).toBe(false);
72:   });
73: 
74:   it('reads skill names at 88 bytes a record, keyed by skill number', () => {
75:     // 88 % 3 is 1, so the key phase shifts a byte every record: reading the
76:     // file with one continuous key only lines up on every third name.
77:     const rows = [record(88, 0, ''), record(88, 0, 'Poison'), record(88, 0, 'Meteorite')];
78: 
79:     const names = parseSkillNames(concat(rows));
80: 
81:     expect(names.get(1)).toBe('Poison');
82:     expect(names.get(2)).toBe('Meteorite');
83:   });
84: 
85:   it('reads buff names after the count, by the index inside the record', () => {
86:     const names = parseBuffNames(concat([buffCount(2), buffRecord(2, 'Increase Defense')]));
87: 
88:     expect(names.get(2)).toBe('Increase Defense');
89:   });
90: 
91:   it('stops at the count the buff file declares', () => {
92:     // One record on disk, ninety-nine claimed: read the one that is there.
93:     const names = parseBuffNames(concat([buffCount(99), buffRecord(7, 'Soul Barrier')]));
94: 
95:     expect(names.get(7)).toBe('Soul Barrier');
96:     expect(names.size).toBe(1);
97:   });
98: });
</file>

<file path="src/libs/mu/mapObjectFixups.ts">
 1: import { ENUM_WORLD } from '../../common';
 2: import { MODEL_CANDLE, MODEL_FURNITURE01 } from '../../common/objects/enum';
 3: 
 4: export interface MapObjectFixup {
 5:   type: number;
 6:   x: number;
 7:   y: number;
 8:   z: number;
 9: }
10: 
11: const MATCH_EPSILON = 1;
12: 
13: const MAP_OBJECT_FIXUPS: Partial<Record<ENUM_WORLD, MapObjectFixup[]>> = {
14:   [ENUM_WORLD.WD_0LORENCIA]: [
15:     { type: MODEL_FURNITURE01 + 3, x: 12494.65, y: 12235.38, z: 165 },
16:     { type: MODEL_FURNITURE01 + 3, x: 12483.23, y: 12235.69, z: 165 },
17: 
18:     { type: MODEL_CANDLE, x: 12531.0, y: 12253.23, z: 250 },
19:   ],
20: };
21: 
22: export function applyMapObjectFixups(
23:   map: ENUM_WORLD,
24:   objs: { id: number; pos: { x: number; y: number; z: number } }[]
25: ): void {
26:   const fixups = MAP_OBJECT_FIXUPS[map];
27:   if (!fixups) return;
28: 
29:   for (const fixup of fixups) {
30:     let target: (typeof objs)[number] | undefined;
31:     let bestDistance = MATCH_EPSILON;
32: 
33:     for (const o of objs) {
34:       if (o.id !== fixup.type) continue;
35: 
36:       const distance = Math.hypot(o.pos.x - fixup.x, o.pos.y - fixup.y);
37:       if (distance < bestDistance) {
38:         bestDistance = distance;
39:         target = o;
40:       }
41:     }
42: 
43:     if (!target) {
44:       console.warn(
45:         `[mapObjectFixups] no object ${fixup.type} near (${fixup.x}, ${fixup.y}) on map ${map}`
46:       );
47:       continue;
48:     }
49: 
50:     target.pos.z = fixup.z;
51:   }
52: }
</file>

