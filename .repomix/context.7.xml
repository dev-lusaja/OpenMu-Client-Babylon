 69: export async function prepareTerrain(scene: Scene, map: ENUM_WORLD) {
 70:   // Blood / Chaos Castle instances all read one folder (worldAssets.ts).
 71:   const worldNum = assetWorldNum(map);
 72:   const textureNames = getTilesList(map);
 73: 
 74:   // The five terrain files and the tiles go out together; a prefetch started
 75:   // on the gate trigger / warp request is the same promise (prefetchWorld.ts).
 76:   const [
 77:     terrainAttributeBytes,
 78:     terrainHeightBytes,
 79:     terrainMappingBytes,
 80:     terrainLightBytes,
 81:     objsBuffer,
 82:     ...tileBytes
 83:   ] = await Promise.all(terrainFilesFor(map).map(consumeTerrainFile));
 84: 
 85:   // Height, attributes, tile mapping and the object list are pure typed-array
 86:   // work - no engine, no DOM - so they run in a worker (todo C8) instead of
 87:   // blocking the frame for the length of a map change. The client falls back
 88:   // to running them inline if the worker is unavailable.
 89:   const bulk = await parseTerrainBulk(
 90:     map,
 91:     terrainHeightBytes,
 92:     terrainAttributeBytes,
 93:     terrainMappingBytes,
 94:     objsBuffer
 95:   );
 96: 
 97:   // The lightmap decode has to stay here: it goes through the engine's
 98:   // texture path. Only the normal/luminosity pass over the result is
 99:   // offloaded. The per-tile textures only need the GPU copy (no readback):
100:   // `createOZJTexture`.
101:   const [lightTextureData, terrainTextures] = await Promise.all([
102:     readOJZBufferAsJPEGBuffer(
103:       scene,
104:       `World${worldNum}/TerrainLight.OZJ`,
105:       terrainLightBytes
106:     ),
107:     // `allSettled`, not `all`: one bad tile used to leave every texture that
108:     // did decode on the GPU with nothing left holding it.
109:     Promise.allSettled(
110:       textureNames.map((t, i) =>
111:         createOZJTexture(
112:           scene,
113:           `World${worldNum}/${t}.OZJ`.replace('.', `_${i}.`),
114:           tileBytes[i]
115:         )
116:       )
117:     ).then(results => {
118:       const made = results.flatMap(r =>
119:         r.status === 'fulfilled' ? [r.value] : []
120:       );
121:       const failed = results.find(r => r.status === 'rejected');
122:       if (failed) {
123:         for (const texture of made) texture.dispose();
124:         throw failed.reason;
125:       }
126:       return made;
127:     }),
128:   ]);
129:   lightTextureData.Texture.dispose();
130: 
131:   try {
132:     // The bake's border vignette comes off on the tiers that can frame it
133:     // (`common/terrain/borderVignette.ts`); Classic keeps the original's fade.
134:     const terrainLight = unpackTerrainLight(
135:       await parseTerrainLightOffThread(
136:         lightTextureData.BufferFloat,
137:         bulk.height,
138:         lightingTier() !== null
139:       )
140:     );
141: 
142:     // Packs the same tiles into one sampler2DArray so the splat shader does two
143:     // fetches per pixel instead of a guarded one per layer (tileTextureArray.ts).
144:     // OZJ is a JPEG behind a 24-byte header. A failure here is not fatal: the
145:     // material falls back to the per-tile sampler chain.
146:     const tileArray = await createTileTextureArray(
147:       scene,
148:       tileBytes.map(bytes => bytes.slice(24))
149:     ).catch((error: unknown) => {
150:       console.warn(
151:         'Tile texture array unavailable, using per-tile samplers:',
152:         error
153:       );
154:       return null;
155:     });
156: 
157:     // Animated water (terrainWater.ts): the option and the registry are read
158:     // here, at load, so a map without water - or the option off - hands the
159:     // material nothing and the shader compiles exactly as before.
160:     const waterSpec = terrainWaterFor(map);
161:     const waterFrames = waterSpec
162:       ? await loadTerrainWaterFlipbook(scene, waterSpec)
163:       : [];
164: 
165:     // The grass cards: which layer-1 slots grow anything here, and what colour.
166:     // Deliberately not in `terrainFilesFor` - that list is destructured
167:     // positionally above, and these are optional files besides.
168:     const grassCards = await loadGrassCards(scene, worldNum);
169: 
170:     return {
171:       worldNum,
172:       bulk,
173:       terrainLight,
174:       terrainTextures,
175:       tileArray,
176:       waterSpec,
177:       waterFrames,
178:       grassCards,
179:     };
180:   } catch (error) {
181:     for (const texture of terrainTextures) texture.dispose();
182:     throw error;
183:   }
184: }
