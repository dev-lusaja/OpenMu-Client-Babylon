150: export function projectWorldPositionToScreenRef(
151:   scene: Scene,
152:   pos: Vector3,
153:   viewport: Viewport,
154:   ref: Vector3
155: ) {
156:   const projMatrix = scene.getTransformMatrix();
157:   const projected = transformCoordinatesWithClippingToRef(pos, projMatrix, ref);
158:   const viewportMatrix = TmpMatrix;
159: 
160:   Matrix.FromValuesToRef(
161:     viewport.width / 2.0,
162:     0,
163:     0,
164:     0,
165:     0,
166:     -viewport.height / 2.0,
167:     0,
168:     0,
169:     0,
170:     0,
171:     0.5,
172:     0,
173:     viewport.x + viewport.width / 2.0,
174:     viewport.height / 2.0 + viewport.y,
175:     0.5,
176:     1,
177:     viewportMatrix
178:   );
179: 
180:   Vector3.TransformCoordinatesToRef(projected, viewportMatrix, ref);
