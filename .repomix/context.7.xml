1305:       // camera is looking at, lost all ten of them to whichever monsters the
1306:       // query happened to yield first, and the grass pressed itself down
1307:       // around bodies fifteen tiles away while the player walked through an
1308:       // untouched field. The budget is deliberately below the slot count so
1309:       // there is room left for the trail these actors leave behind them.
1310:       const near = nearest(actors, centerX, centerZ, ACTOR_BUDGET);
1311: 
1312:       actorSlots.fill(0);
1313: 
1314:       let slot = 0;
1315: 
1316:       function write(
1317:         x: number,
1318:         z: number,
1319:         flying: boolean,
1320:         strength: number
1321:       ): void {
