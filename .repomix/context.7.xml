 715: /** Tiles per second the deck slides. Slow - this is weather, not a conveyor. */
 716: const CLOUD_DRIFT = 0.6;
 717: /** Noise window the cloud breaks open in, and how much brighter a break is. */
 718: const CLOUD_LO = 0.44;
 719: const CLOUD_HI = 0.74;
 720: const CLOUD_LIT = 1.55;
