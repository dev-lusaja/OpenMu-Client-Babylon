185: function unloadMap(world: World, oldMap: ENUM_WORLD, newMap: ENUM_WORLD) {
186:   // A copy: `world.remove` mutates the live query while it is iterated,
187:   // which skipped every other entity of the map just left.
188:   const entities = [...world.with('worldIndex')];
189: 
190:   for (const e of entities) {
191:     if (e === world.playerEntity) continue;
192:     if (e.worldIndex === oldMap) {
193:       world.remove(e);
194:       e.onDispose?.();
195:       e.modelObject?.dispose();
196:     }
197:   }
198: 
199:   // Before the prototypes' folder is evicted below: the chunks share their
200:   // geometry.
201:   disposePropBatches();
202: 
203:   if (world.terrain) {
204:     // Before the ground it stands on: the field holds the tile array the old
205:     // material is about to dispose.
206:     disposeGrassField();
207:     world.terrain.mesh.material?.dispose(true, true);
208:     world.terrain.mesh.dispose(false, true);
209:     world.terrain = null;
210:   }
211: 
212:   // The old map's own GLBs (`Object<n>/`) have no user left; shared folders
213:   // (`Player/`, `Item/`, `Npc/`) are not touched. Blood Castle floors share
214:   // one folder, so a same-folder warp keeps everything.
215:   const oldAssets = assetWorldNum(oldMap);
216:   if (oldAssets !== assetWorldNum(newMap)) {
217:     // Keys are `./game-assets/Object4/Object40.glb`; the leading slash keeps
218:     // `Object4/` from matching `Object14/`.
219:     evictContainers(`/Object${oldAssets}/`);
220:   }
221: }
