 2: import {
 3:   AMBIENT_WAVE_AMPLITUDE,
 4:   AMBIENT_WAVE_DAMPING,
 5:   AMBIENT_WAVE_INTERVAL,
 6:   AMBIENT_WAVE_SPEED,
 7:   waterSurfaceHeight,
 8: } from './terrainWater';
 9: 
10: describe('terrainWater surface', () => {
11:   it('is a pure function of time and position', () => {
12:     const a = waterSurfaceHeight(37.25, 224.5, 12.8);
13:     const b = waterSurfaceHeight(37.25, 224.5, 12.8);
14:     expect(a).toBe(b);
15:     expect(a).not.toBe(waterSurfaceHeight(37.25, 224.5, 12.9));
16:   });
17: 
18:   it('carries the CSWaterTerrain base-wave constants', () => {
19:     // calcBaseWave with T ms, i = 2z, j = 2x, amplitudes 50/25, surface
20:     // weight 0.25, heights /100 - computed by hand for x=10, z=20, t=3.
21:     const x = 10;
22:     const z = 20;
23:     const t = 3;
24:     const expected =
25:       0.125 * Math.sin(t * 5 + z * 0.2 + x * 0.2) -
26:       0.125 * Math.sin(t * 3 + x * 0.2 + z) +
27:       0.0625 * Math.sin(t + z + x) -
28:       0.0625 * Math.sin(t * 2 + x * 2 + z * 0.6);
29:     expect(waterSurfaceHeight(x, z, t)).toBeCloseTo(expected, 12);
30:   });
31: 
32:   it('stays inside the ported amplitude bound', () => {
33:     // 0.125 + 0.125 + 0.0625 + 0.0625 tiles = 37.5 original units.
34:     for (let i = 0; i < 500; i++) {
35:       const h = waterSurfaceHeight(i * 0.37, i * 0.73, i * 0.11);
36:       expect(Math.abs(h)).toBeLessThanOrEqual(0.375);
37:     }
38:   });
39: 
40:   it('ambient ring expands at the automaton speed and damps out', () => {
41:     const ring = { x: 0, z: 0, spawnTime: 0 };
42:     const t = 0.8;
43:     const front = AMBIENT_WAVE_SPEED * t;
44: 
45:     const onFront =
46:       waterSurfaceHeight(front, 0, t, [ring]) - waterSurfaceHeight(front, 0, t);
47:     const offFront =
48:       waterSurfaceHeight(front + 6, 0, t, [ring]) -
49:       waterSurfaceHeight(front + 6, 0, t);
50:     expect(Math.abs(onFront)).toBeGreaterThan(Math.abs(offFront));
51: 
52:     // Peak at the front: amplitude x damping x cylindrical spreading.
53:     const peak =
54:       (AMBIENT_WAVE_AMPLITUDE * Math.exp(-AMBIENT_WAVE_DAMPING * t)) /
55:       Math.sqrt(front);
56:     expect(onFront).toBeCloseTo(peak, 12);
57: 
58:     // Before its spawn a ring contributes nothing.
