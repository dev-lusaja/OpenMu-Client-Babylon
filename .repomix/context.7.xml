 33: 
 34: /**
 35:  * How the ground is lit, in one place.
 36:  *
 37:  * This was the middle of `terrainMaterial.ts` until something else had to
 38:  * stand on the ground and be lit the same way (`terrainGrass.ts`). A grass
 39:  * blade rooted in a tile has to take that tile's bake, that tile's torches,
 40:  * that tile's cascade and that tile's roof, or the two disagree - and a
 41:  * blade that is a shade off the ground it grows from is more obviously wrong
 42:  * than either would be alone.
 43:  *
 44:  * The alternative was to copy the composite into the grass shader. It would
 45:  * work today and drift the first time the lighting moves, which is the
 46:  * stacking this project has already decided not to do again. So: one writer
 47:  * of the ground's light, two callers.
 48:  *
 49:  * ## The contract
 50:  *
 51:  * A caller emits `terrainLightDeclarationsGlsl` once at fragment scope, then
 52:  * `terrainSkyLightGlsl` and `terrainGroundLightGlsl` inside `main`, and lists
 53:  * `TERRAIN_LIGHT_UNIFORMS` / `terrainLightSamplers` / `terrainLightDefines`
 54:  * in its `ShaderMaterial` options and `bindTerrainLight` in its bind. Its
 55:  * vertex stage must hand the fragment three varyings under these names:
 56:  *
 57:  * - `vWorldXZ`  - world xz, the dynamic-light and mask lookup.
 58:  * - `vWorldPos` - world xyz, the cascade lookup.
 59:  * - `vViewZ`    - view-space z, which cascade.
 60:  *
 61:  * Nothing here is terrain-mesh specific beyond those three.
 62:  */
 63: 
 64: /**
 65:  * The hue-preserving soft ceiling on the ground light sum, tiers >= 1
 66:  * (ARCHITECTURE §4.5): linear below the knee, bent toward the asymptote
 67:  * above it, so a torch core keeps its hue where the original's per-channel
 68:  * clamp would have gone white.
 69:  */
 70: const GROUND_CEIL_KNEE = 0.85;
 71: const GROUND_CEIL_ASYMPTOTE = 1.1;
 72: 
 73: /**
 74:  * Ground lights bound per frame: the point-light pool's slots. The pool is
 75:  * this many at most; an empty slot binds range 0 and adds nothing.
 76:  */
 77: export const GROUND_POINT_LIGHTS = 8;
 78: 
 79: export const TERRAIN_LIGHT_UNIFORMS = [
 80:   'time',
 81:   'linearOut',
 82:   'linearLight',
 83:   'keyGain',
 84:   'roomParams',
 85:   'groundLightPos',
 86:   'groundLightCol',
 87:   LIGHT_TINT_UNIFORM,
 88:   TOON_FILTER_UNIFORM,
 89:   ...TERRAIN_CSM_UNIFORMS,
 90: ] as const;
 91: 
 92: /**
 93:  * Split in two because sampler order is load-bearing: `textures[N]` expands
 94:  * to N consecutive units from its own slot, so a sampler array declared
 95:  * before the cascades puts them on units it already uses, and two sampler
 96:  * types on one unit is a GL draw error that renders the surface flat. A
 97:  * caller lists these, then its own samplers, then `TERRAIN_CSM_SAMPLERS`,
 98:  * then any sampler array last.
 99:  *
100:  * The cloud field rides the packed-tile path only: the terrain's per-tile
101:  * fallback already spends every one of WebGL's guaranteed 16 fragment units.
102:  */
103: export function terrainLightSamplers(clouds: boolean): string[] {
104:   return ['dynamicLight', ...(clouds ? [CLOUD_NOISE_SAMPLER] : [])];
105: }
106: 
107: export const TERRAIN_CSM_SAMPLERS = ['csmShadowMap', 'csmShadowMapF'];
108: 
109: /** The cascades' defines and the style's; `shadows.ts` recompiles on the same pair. */
110: export function terrainLightDefines(): string[] {
111:   return [...terrainCsmDefines(), ...toonTerrainDefines()];
112: }
113: 
114: /** Uniform declarations, the tint helper, the cloud field and `csmShadow`. */
115: export function terrainLightDeclarationsGlsl(clouds: boolean): string {
116:   return `
117:   uniform float time;
118:   uniform float linearOut;
119:   uniform float linearLight;
120:   uniform float keyGain;
121:   uniform float ${LIGHT_TINT_UNIFORM};
122:   uniform vec3 roomParams; // x: a room is the active area, y: gain on the delta (AreaLook.candles), z: the room's share of the key on the bake
123:   uniform sampler2D dynamicLight;
124:   // The pool's slots on the ground: xy the tile position, z the footprint
125:   // radius (0: empty slot), w the falloff exponent; the colour carries the
126:   // floor gain, the fade and the dynamic gain.
127:   uniform vec4 groundLightPos[${GROUND_POINT_LIGHTS}];
128:   uniform vec4 groundLightCol[${GROUND_POINT_LIGHTS}];
129:   uniform vec4 ${TOON_FILTER_UNIFORM}; // x mip bias, y tone levels, z grass outline darkness, w its width in pixels
130: 
131:   const float GROUND_CEIL_KNEE = ${GROUND_CEIL_KNEE.toFixed(3)};
132:   const float GROUND_CEIL_ROOM = ${(GROUND_CEIL_ASYMPTOTE - GROUND_CEIL_KNEE).toFixed(3)};
133: 
134: ${lightTintGlsl()}
135: ${toonFunctionsGlsl()}
136: ${clouds ? cloudFieldGlsl() : ''}
137: 
138:   ${terrainCsmGlsl()}
139: `;
140: }
141: 
142: /**
143:  * `dynLight` and `skyOpen`, in scope for whatever the caller puts between
144:  * this and the ground light (the terrain runs its weather overlays there).
145:  */
146: export function terrainSkyLightGlsl(): string {
147:   return `
148:     // One fetch, two jobs: rgb is the torches' radial light, and alpha is the
149:     // roof mask the ground overlays need (terrainMask.ts). Sampled before the
150:     // overlay so skyOpen is in scope for it.
151:     vec4 dynSample = texture2D(dynamicLight, (vWorldXZ + 0.5) / 256.0);
152:     vec3 dynLight = dynSample.rgb * 2.0 * roomParams.y;
153:     float skyOpen = dynSample.a;
154: 
155:     // Tiers >= 1: the lights the pool holds, per pixel, with the same
156:     // footprint the tile map would have stamped for them - the stamp is one
157:     // texel a tile, and on a dark floor its bilinear skirt read as tile
158:     // squares. The tile map above carries only what the pool does not hold.
159:     for (int i = 0; i < ${GROUND_POINT_LIGHTS}; i++) {
160:       vec4 gl = groundLightPos[i];
161:       float gd = length(vWorldXZ - gl.xy);
162:       float gf = max(0.0, (gl.z - gd) / max(gl.z, 0.001));
163:       dynLight += groundLightCol[i].rgb * pow(gf, gl.w) * linearLight * roomParams.y;
164:     }
165: `;
166: }
167: 
168: /**
169:  * The composite: `sunShadow`, `bakeShadow`, and the multipliers a surface
170:  * standing on this tile is lit by - `groundLit` for its own albedo and
171:  * `extraLit` for anything layered over it.
172:  *
173:  * `bake` is the expression holding the tile's authored light: the terrain
174:  * mesh carries it in `vColor.rgb`, the grass in a varying its vertex stage
175:  * fetched per instance. Same array either way (`unpackTerrainLight`).
176:  */
177: export function terrainGroundLightGlsl(o: {
178:   bake: string;
179:   clouds: boolean;
180: }): string {
181:   return `
182:     // The sun's cascaded shadow, weighted by the openness mask: both
183:     // interiors take their roof *out* of the shadow map on purpose so the
184:     // camera can see in (Lorencia lifts HOUSE_WALL05/06 past the caster
185:     // range, Devias fades its ceiling), so under a roof the cascades are not
186:     // the authority and the bake keeps the room it was authored for - until
187:     // the room itself is the active area (roomShadow): then its furniture
188:     // and figures cast on the floor under the roof as well.
189:     float sunShadow = mix(1.0, csmShadow(vWorldPos, vViewZ), max(skyOpen, roomParams.x));
190: 
191:     // A cloud takes the sun and leaves the sky share, the same one rule, on
192:     // the same openness mask the cascades use: a floor under a roof takes no
193:     // cloud shadow.
194: ${o.clouds ? '    sunShadow *= mix(1.0, muCloudShadow(vWorldPos), skyOpen);' : ''}
195: 
196:     // The one shadow rule: a shadow removes the sun and leaves the sky share
197:     // (csmParams.y, the policy floor). 1 while Classic (no cascades).
198:     float bakeShadow = mix(csmParams.y, 1.0, sunShadow);
199: 
200:     // The ground light sum. Tiers >= 1 (linearLight): lin(bake) + delta, the
201:     // delta linear-authored and added after the decode. Classic: the
202:     // original's gamma-space bake + delta (ZzzLodTerrain.cpp:481-505),
203:     // untouched. The bake is the ground's key: inside a room it takes the
204:     // room's share of the level and the delta, the candles, does not (§13 F14).
205:     vec3 bake = max(${o.bake}, vec3(0.0));
206:     vec3 bakeLit = mix(bake, pow(bake, vec3(2.2)), linearLight) * roomParams.z;
207:     vec3 groundLight = max(bakeLit + dynLight, vec3(0.0));
208: 
209:     // The original clamps glColor at 1.0 per channel; tiers >= 1 bend the
210:     // sum toward the asymptote above the knee so a torch core keeps its hue.
211:     float peak = max(groundLight.r, max(groundLight.g, groundLight.b));
212:     float bent = peak > GROUND_CEIL_KNEE
213:       ? GROUND_CEIL_KNEE + GROUND_CEIL_ROOM * (1.0 - exp(-(peak - GROUND_CEIL_KNEE) / GROUND_CEIL_ROOM))
214:       : peak;
215:     vec3 softCeil = peak > 0.0 ? groundLight * (bent / peak) : groundLight;
216:     groundLight = mix(min(groundLight, vec3(1.0)), softCeil, linearLight);
217: 
218:     // The cascades cut the ceiled sum, not the bake under it (§13 F15): on
219:     // open ground the ceiling compresses lit and shadowed alike, so a factor
220:     // applied before it left a fraction of the policy's ratio. 1 on Classic.
221:     groundLight *= bakeShadow;
222: 
223:     // The map's level (2^ev) is the light's, applied after the clamps so
224:     // they keep the original's units; 1.0 on Classic.
225:     groundLight *= keyGain;
226: 
227:     // The overlays and the reflections below work in the art's display
228:     // space; the linear sum is re-encoded for them and the final decode
229:     // lands the product exactly at lin(texel) x groundLight.
230:     vec3 groundLit = mix(groundLight, pow(groundLight, vec3(1.0 / 2.2)), linearLight);
231:     vec3 extraLit = mix(dynLight, pow(dynLight * keyGain, vec3(1.0 / 2.2)), linearLight);
232: `;
233: }
234: 
235: /**
236:  * The clock the ground and everything rooted in it share, restarted per map
237:  * load by `createTerrainMaterial` (which is where the terrain's own `time`
238:  * has always restarted). The grass material is created after it and reads
239:  * the same epoch, so the two wind terms agree on which gust is where instead
240:  * of drifting apart by however long the map took to build.
241:  */
242: let clockEpoch = Date.now();
243: 
244: export function startTerrainClock(): void {
245:   clockEpoch = Date.now();
246: }
247: 
248: export function terrainClock(): number {
249:   return (Date.now() - clockEpoch) / 1000;
250: }
251: 
252: /** Everything `terrainLightDeclarationsGlsl` declared, per bind. */
253: export function bindTerrainLight(
254:   effect: Effect,
255:   scene: Scene,
256:   clouds: boolean
257: ): void {
258:   effect.setFloat('time', terrainClock());
259:   effect.setFloat('linearOut', linearBufferActive(scene) ? 1 : 0);
260:   effect.setFloat('linearLight', linearLightActive(scene) ? 1 : 0);
261: 
262:   const look = lookDirector()?.state();
263: 
264:   // `sceneGain`, not `keyGain`: the ground is lit scene and takes an event's
265:   // dim; the effect cards drawn over it do not.
266:   effect.setFloat('keyGain', look?.key.sceneGain ?? 1);
267:   effect.setFloat3(
268:     'roomParams',
269:     look?.area ? 1 : 0,
270:     look?.key.emitterGain ?? 1,
271:     look?.key.roomShare ?? 1
272:   );
273:   effect.setFloat(LIGHT_TINT_UNIFORM, lightTintStrength());
274:   bindToonFilter(effect);
275: 
276:   if (clouds) {
277:     bindClouds(effect, scene, {
278:       // Null while the map has no sky, and inside a room, where `applyArea`
279:       // clears it: the deck is not overhead, so it casts nothing.
280:       base: look?.profile.sky
281:         ? look.profile.sky.clouds ?? SKY_CLOUDS_DEFAULT
282:         : null,
283:       sunDirection: look?.key.direction ?? [0, -1, 0],
284:       sunElevationDeg: look?.profile.sun.elevationDeg ?? 45,
285:     });
286:   }
287: 
288:   effect.setTexture('dynamicLight', getTerrainLightTexture(scene));
289: 
290:   const lights = pointLightPoolGroundLights();
291: 
292:   for (let i = 0; i < GROUND_POINT_LIGHTS; i++) {
293:     const l = lights[i];
294:     const o = i * 4;
295: 
296:     groundPos[o] = l ? l.x : 0;
297:     groundPos[o + 1] = l ? l.z : 0;
298:     groundPos[o + 2] = l ? l.range : 0;
299:     groundPos[o + 3] = l ? l.falloff : 1;
300:     groundCol[o] = l ? l.r : 0;
301:     groundCol[o + 1] = l ? l.g : 0;
302:     groundCol[o + 2] = l ? l.b : 0;
303:     groundCol[o + 3] = 0;
304:   }
305: 
306:   effect.setArray4('groundLightPos', groundPos);
307:   effect.setArray4('groundLightCol', groundCol);
308:   bindTerrainCsm(effect);
309: }
310: 
311: const groundPos: number[] = new Array(GROUND_POINT_LIGHTS * 4).fill(0);
312: const groundCol: number[] = new Array(GROUND_POINT_LIGHTS * 4).fill(0);
313: 
314: export { CLOUD_UNIFORMS };
</file>

