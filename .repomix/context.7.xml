 4: 
 5: /**
 6:  * `Local/<lang>/MoveReq_<lang>.bmd` - the rows of the Move (warp) command window,
 7:  * decoded the way `CMoveCommandData::Create` (MoveCommandData.cpp:37) does:
 8:  * an `int count`, then `count` records of `MOVEREQINFO_FILE`, each XOR-ed
 9:  * with the 3-byte Bux key **restarting at every record** (one `BuxConvert`
10:  * per `fread`), like `gate.bmd` and the quest tables.
11:  *
12:  * ```
13:  * #pragma pack(1)
14:  * int  index;              // WarpInfo index the server is asked for
15:  * char szMainMapName[32];  // shown in the window
16:  * char szSubMapName[32];   // the /move alias (`Elbeland`, `Raklion`, …)
17:  * int  iReqLevel;          // greyed below this level (× 2/3 for MG / DL / RF)
18:  * int  m_iReqMaxLevel;     // 400 except Atlans (220) / Kanturu ruins (350); the S6 window never reads it
19:  * int  iReqZen;
20:  * int  iGateNum;           // the gate the server lands the hero on (informational here)
21:  * ```
22:  * = 84 bytes. The shipped file is 4204 bytes = 4 + 50 × 84 with `count` = 37,
23:  * i.e. padded to fifty slots; only `count` rows are read.
24:  *
25:  * The root `Local/Movereq.bmd` is the Korean/JP sibling (38 rows, the main
26:  * names in a legacy code page) and is not used.
27:  */
28: 
29: const FILE = 'MoveReq';
30: const RECORD_SIZE = 84;
31: const NAME_LENGTH = 32;
32: 
33: export type MoveReqEntry = {
34:   /** `MOVEREQINFO.index` - what `WarpCommandRequest.WarpInfoIndex` carries. */
35:   index: number;
36:   /** `szMainMapName`: the name printed in the window. */
37:   name: string;
38:   /** `szSubMapName`: the `/move` alias. */
39:   alias: string;
40:   /** `iReqLevel`, before the class reduction. */
41:   reqLevel: number;
42:   /** `m_iReqMaxLevel`: kept for completeness; neither the S6 window nor OpenMU enforces it. */
43:   reqMaxLevel: number;
44:   /** `iReqZen`. */
45:   zen: number;
46:   /** `iGateNum`. */
47:   gate: number;
48: };
49: 
50: let pending: Promise<readonly MoveReqEntry[]> | null = null;
51: 
52: function readName(bytes: Uint8Array, offset: number): string {
53:   return decodeLocalText(bytes, offset, NAME_LENGTH);
54: }
55: 
56: function parse(bytes: Uint8Array): MoveReqEntry[] {
57:   const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
58:   const count = view.getInt32(0, true);
59:   const entries: MoveReqEntry[] = [];
60: 
61:   for (let i = 0; i < count; i++) {
62:     const offset = 4 + i * RECORD_SIZE;
63:     if (offset + RECORD_SIZE > bytes.length) break;
64: 
65:     const record = bytes.subarray(offset, offset + RECORD_SIZE);
66:     convertBux(record, RECORD_SIZE);
67: 
68:     entries.push({
69:       index: view.getInt32(offset, true),
70:       name: readName(bytes, offset + 4),
71:       alias: readName(bytes, offset + 4 + NAME_LENGTH),
72:       reqLevel: view.getInt32(offset + 68, true),
73:       reqMaxLevel: view.getInt32(offset + 72, true),
74:       zen: view.getInt32(offset + 76, true),
75:       gate: view.getInt32(offset + 80, true),
76:     });
77:   }
78: 
79:   return entries;
80: }
81: 
82: /** The move list, in file order (the order the window shows). Cached after the first call. */
83: export function loadMoveReqList(): Promise<readonly MoveReqEntry[]> {
84:   if (!pending) {
85:     pending = downloadLocalDataFile(FILE).then(parse, err => {
86:       pending = null;
87:       throw err;
88:     });
89:   }
90:   return pending;
91: }
92: 
93: // The map names come out of the language pack, so a language change has to
94: // drop the cache; the window re-reads on its next open.
95: onLanguageChanged(() => {
96:   pending = null;
97: });
</file>

<file path="src/libs/mu/npcNameFile.ts">
  1: /**
  2:  * `Data/Local/<lang>/NpcName_<Lang>.txt` - the monster and NPC names, in the
  3:  * language the player picked.
  4:  *
  5:  * The original ships this as a plain tab-separated text file rather than a
  6:  * `.bmd`, one row per type number:
  7:  *
  8:  * ```
  9:  * // MAX : 512
 10:  * //<a Korean section comment>
 11:  * 84	1	"Chief Skeleton Warrior"
 12:  * 89	1	"Magic Skeleton"
 13:  * ```
 14:  *
 15:  * `//` lines are comments, the middle column is a flag the client does not
 16:  * read here, and the name is quoted. Every language pack has one, English
 17:  * included: `Eng/NpcName_Eng.txt` is 532 rows covering types 0 to 585 and is
 18:  * this client version's own table, where `monsters.json` is an older
 19:  * version's - 220 types are missing from it entirely and 168 of the names it
 20:  * does have belong to other monsters ("King Orc" for type 84, which is the
 21:  * Chief Skeleton Warrior). So the file is the base table for every language
 22:  * and the JSON is only the fallback under it.
 23:  *
 24:  * Read through `monsterDisplayName()` in `common/monstersDatabase.ts`.
 25:  */
 26: 
 27: import { observable, runInAction } from 'mobx';
 28: import { i18n, onLanguageChanged } from '../../i18n';
 29: import { resolveDataUrl } from './dataFolder';
 30: import { decodeLocalText } from './localData';
 31: 
 32: /** `84\t1\t"Chief Skeleton Warrior"` - id, flag, quoted name. */
 33: const ROW = /^\s*(\d+)\s+\d+\s+"([^"]*)"/;
 34: 
 35: /**
 36:  * Type number → localised name, empty until a pack is loaded.
 37:  *
 38:  * An observable *ref* (the map is swapped whole, never mutated), because the
 39:  * names are read straight out of React renders and the Babylon name tags: a
 40:  * plain variable would load the new language and leave every name already on
 41:  * screen showing the old one until the world was rebuilt.
 42:  */
 43: const names = observable.box<ReadonlyMap<number, string>>(new Map(), {
 44:   deep: false,
 45: });
 46: 
 47: let pending: Promise<void> | null = null;
 48: 
 49: function parse(text: string): Map<number, string> {
 50:   const out = new Map<number, string>();
 51: 
 52:   for (const line of text.split(/\r?\n/)) {
 53:     if (!line || line.startsWith('//')) continue;
 54:     const hit = ROW.exec(line);
 55:     if (hit) out.set(Number(hit[1]), hit[2]);
 56:   }
 57: 
 58:   return out;
 59: }
 60: 
 61: /**
 62:  * Load the table for the active language. A no-op only for a language with no
 63:  * pack at all, which falls back to `monsters.json`.
 64:  */
 65: export function loadNpcNames(): Promise<void> {
 66:   if (pending) return pending;
 67: 
 68:   const pack = i18n.dataPack;
 69:   if (!pack) {
 70:     set(new Map());
 71:     pending = Promise.resolve();
 72:     return pending;
 73:   }
 74: 
 75:   // `NpcName_Spn.txt` - the folder is capitalised in the file name too.
 76:   const url = resolveDataUrl(`Local/${pack.folder}/NpcName_${pack.folder}.txt`);
 77:   const wanted = i18n.language;
 78: 
 79:   pending = fetch(url)
 80:     .then(r => (r.ok ? r.arrayBuffer() : Promise.reject(new Error(String(r.status)))))
 81:     .then(buffer => {
 82:       // Two changes in quick succession: the slower fetch must not land on
 83:       // top of the language that is current by the time it answers.
 84:       if (i18n.language !== wanted) return;
 85:       const bytes = new Uint8Array(buffer);
 86:       set(parse(decodeLocalText(bytes, 0, bytes.length)));
 87:     })
 88:     .catch(err => {
 89:       console.warn(`NPC names for ${pack.folder} are missing:`, err);
 90:       if (i18n.language === wanted) set(new Map());
 91:     });
 92: 
 93:   return pending;
 94: }
 95: 
 96: function set(map: ReadonlyMap<number, string>): void {
 97:   runInAction(() => names.set(map));
 98:   for (const listener of listeners) listener();
 99: }
100: 
101: /** The localised name for a type number, or undefined to use `monsters.json`. */
102: export function localisedNpcName(type: number): string | undefined {
103:   return names.get().get(type);
104: }
105: 
106: const listeners = new Set<() => void>();
107: 
108: /**
109:  * Called every time the table changes: a pack finished loading, or the
110:  * language changed and cleared it. Names already snapshotted onto entities
111:  * (`objectNameInWorld`) have to be walked again on each of those.
112:  */
113: export function onNpcNamesChanged(listener: () => void): void {
114:   listeners.add(listener);
115: }
116: 
117: onLanguageChanged(() => {
118:   pending = null;
119:   set(new Map());
120:   void loadNpcNames();
121: });
</file>

<file path="src/libs/mu/prefetchWorld.ts">
 1: import { ENUM_WORLD } from '../../common';
 2: import { downloadDataBytesBuffer } from '../../common/utils';
 3: import { getTilesList } from '../../common/terrain/getTilesList';
 4: import { assetWorldNum } from '../../common/worldAssets';
 5: 
 6: /**
 7:  * One in-memory promise per terrain file URL, shared by `prefetchWorldTerrain`
 8:  * and `getTerrainData`: a prefetch started on the gate trigger / warp request
 9:  * is the very same promise the loader later awaits, so the download is never
10:  * paid twice. Entries are consumed (deleted) by the loader, which keeps the
11:  * map bounded to whatever was prefetched but never loaded.
12:  */
13: const pending = new Map<string, Promise<Uint8Array>>();
14: 
15: /** Fetch a `Data/` file through the shared cache (`World4/EncTerrain4.att`). */
16: export function fetchTerrainFile(url: string): Promise<Uint8Array> {
17:   let p = pending.get(url);
18:   if (!p) {
19:     p = downloadDataBytesBuffer(url);
20:     p.catch(() => pending.delete(url));
21:     pending.set(url, p);
22:   }
23:   return p;
24: }
25: 
26: /** Same as `fetchTerrainFile`, but the entry leaves the cache with the caller. */
27: export function consumeTerrainFile(url: string): Promise<Uint8Array> {
28:   const p = fetchTerrainFile(url);
29:   pending.delete(url);
30:   return p;
31: }
32: 
33: /** The five terrain files and the tile textures of one world, in load order. */
34: export function terrainFilesFor(map: ENUM_WORLD): string[] {
35:   const worldNum = assetWorldNum(map);
36:   const folder = `World${worldNum}/`;
37: 
38:   return [
39:     `${folder}EncTerrain${worldNum}.att`,
40:     `${folder}TerrainHeight.OZB`,
41:     `${folder}EncTerrain${worldNum}.map`,
42:     `${folder}TerrainLight.OZJ`,
43:     `${folder}EncTerrain${worldNum}.obj`,
44:     ...getTilesList(map).map(tile => `${folder}${tile}.OZJ`),
45:   ];
46: }
47: 
48: export function prefetchWorldTerrain(map: ENUM_WORLD): void {
49:   for (const file of terrainFilesFor(map)) {
50:     fetchTerrainFile(file).catch(() => {});
51:   }
52: }
</file>

<file path="src/libs/mu/questFiles.ts">
  1: import { onLanguageChanged } from '../../i18n';
  2: import { convertBux } from '../../common/terrain/mapFileEncryption';
  3: import { downloadDataFile } from './dataFolder';
  4: import {
  5:   checkPackText,
  6:   decodeLocalText,
  7:   downloadLocalDataFile,
  8:   repairPackText,
  9: } from './localData';
 10: 
 11: /**
 12:  * The four quest tables, decoded the way the original does: every record is
 13:  * XOR-ed with the 3-byte Bux key **restarting at each record** (`BuxConvert`
 14:  * per `fread`), exactly like `gate.bmd`. Sizes below were verified against
 15:  * the shipped files, not only against the C++ structs:
 16:  *
 17:  * | file | record | C++ |
 18:  * |---|---|---|
 19:  * | `Local/<lang>/Quest_<lang>.bmd` | 200 × 744 B | `QuestAttributeFile` (CSQuest.cpp:115) |
 20:  * | `Local/<lang>/Dialog_<lang>.bmd` | 200 × 1024 B | `DIALOG_SCRIPT` (_struct.h:139) |
 21:  * | `Local/QuestProgress.bmd` | n × 41 B | `DWORD` + packed `SQuestProgress` (QuestMng.h:19) |
 22:  * | `Local/<lang>/QuestWords_<lang>.bmd` | `{int index; short len}` + `len` UTF-8 bytes | `LoadQuestWordsScript` |
 23:  * | `Local/NPCDialogue.bmd` | n × 88 B | `DWORD` + `SNPCDialogue` (QuestMng.h:12), `LoadNPCDialogueScript` |
 24:  *
 25:  * `QuestAttributeFile` is `{short cond; short req; WORD npc; char name[32]}`
 26:  * = 38 bytes, then `QUEST_CLASS_ACT[16]` at 38 - 24 bytes each because
 27:  * `byRequestClass[MAX_CLASS = 7]` plus one pad byte aligns the four
 28:  * `shQuestStartText` shorts - then `QUEST_CLASS_REQUEST[16]` at 424 (the
 29:  * act array ends at 422, padded to the DWORD `dwZen` alignment), 20 bytes
 30:  * each with `wRequestStrength` at +8, `dwZen` at +12 and `shErrorText` at
 31:  * +16. 38 + 384 + 2 + 320 = 744, which is what 148800 / 200 gives.
 32:  */
 33: 
 34: // ---- Quest.bmd -------------------------------------------------------------
 35: 
 36: /** `MAX_QUESTS` (_define.h:576). */
 37: export const MAX_QUESTS = 200;
 38: /** `MAX_QUEST_CONDITION` / `MAX_QUEST_REQUEST` (_define.h:577-578). */
 39: const MAX_QUEST_CONDITION = 16;
 40: const MAX_QUEST_REQUEST = 16;
 41: /** `MAX_CLASS` (_define.h:394): one byte per base class in every act. */
 42: export const QUEST_CLASS_COUNT = 7;
 43: 
 44: const QUEST_RECORD_SIZE = 744;
 45: const QUEST_ACT_OFFSET = 38;
 46: const QUEST_ACT_SIZE = 24;
 47: const QUEST_REQUEST_OFFSET = 424;
 48: const QUEST_REQUEST_SIZE = 20;
 49: const QUEST_NAME_LENGTH = 32;
 50: 
 51: /** `QUEST_CLASS_ACT.byQuestType`: what the act asks the hero to bring. */
 52: export const QuestActKind = {
 53:   /** `QUEST_ITEM`: `itemNum` of item `group/index` (+`itemLevel`) in the bag. */
 54:   Item: 1,
 55:   /** `QUEST_MONSTER`: `itemNum` kills of monster `itemType`. */
 56:   Monster: 2,
 57: } as const;
 58: 
 59: /** `QUEST_CLASS_ACT` - one thing a class has to do for this quest. */
 60: export type QuestAct = {
 61:   live: number;
 62:   kind: number;
 63:   /** Item group (or monster type for a `Monster` act). */
 64:   itemType: number;
 65:   itemSubType: number;
 66:   itemLevel: number;
 67:   itemNum: number;
 68:   /** Which `QuestRequest.type` rows apply while this act is the active one. */
 69:   requestType: number;
 70:   /** Per base class (`BaseClass` order): 0 = not for this class, ≥1 applies. */
 71:   requestClass: number[];
 72:   /**
 73:    * Dialog script indexes: [0] start (state NO), [1] in progress,
 74:    * [2] all items brought, [3] finished (`FindQuestContext`).
 75:    */
 76:   startText: number[];
 77: };
 78: 
 79: /** `QUEST_CLASS_REQUEST` - a precondition the server also checks. */
 80: export type QuestRequest = {
 81:   live: number;
 82:   /** Matches `QuestAct.requestType`; 255 = applies to every act. */
 83:   type: number;
 84:   /** Quest that must be finished first; 65535 = none. */
 85:   completeQuestIndex: number;
 86:   levelMin: number;
 87:   levelMax: number;
 88:   requestStrength: number;
 89:   zen: number;
 90:   /** Dialog script index shown when the check fails. */
 91:   errorText: number;
 92: };
 93: 
 94: /** `QUEST_ATTRIBUTE` - one legacy quest. */
 95: export type QuestDefinition = {
 96:   index: number;
 97:   conditionCount: number;
 98:   requestCount: number;
 99:   /** Monster type of the NPC that gives the quest. */
100:   npcType: number;
101:   name: string;
102:   acts: QuestAct[];
103:   requests: QuestRequest[];
104: };
105: 
106: // ---- Dialog.bmd ------------------------------------------------------------
107: 
108: /** `MAX_DIALOG` (_define.h:318). */
109: export const MAX_DIALOG = 200;
110: const DIALOG_RECORD_SIZE = 1024;
111: const DIALOG_TEXT_LENGTH = 300;
112: const DIALOG_MAX_ANSWERS = 10;
113: const DIALOG_ANSWER_LENGTH = 64;
114: 
115: /** `DIALOG_SCRIPT` - a page of NPC speech plus its numbered answers. */
116: export type DialogScript = {
117:   text: string;
118:   answers: {
119:     text: string;
120:     /** Next dialog page after picking this; ≤ 0 = stay. */
121:     link: number;
122:     /** `m_iReturnForAnswer`: -1 none, 1 next progress, 2 close, 3 set state. */
123:     action: number;
124:   }[];
125: };
126: 
127: // ---- QuestProgress.bmd -----------------------------------------------------
128: 
129: const PROGRESS_RECORD_SIZE = 41;
130: /** `QM_MAX_ANSWER` (QuestMng.h:9). */
131: const PROGRESS_MAX_ANSWERS = 5;
132: 
133: /** `SQuestProgress` - one S6 quest step, keyed by `(number << 16) | group`. */
134: export type QuestProgressEntry = {
135:   key: number;
136:   /** 0 = NPC-words window (`CNewUIQuestProgress`), 1 = the "etc" variant. */
137:   uiType: number;
138:   npcWords: number;
139:   playerWords: number;
140:   /** Words indexes of the up-to-five answers; 0 = unused. */
141:   answers: number[];
142:   subject: number;
143:   summary: number;
144: };
145: 
146: // ---- NPCDialogue.bmd -------------------------------------------------------
147: 
148: /** `sizeof(DWORD) + sizeof(SNPCDialogue)`: key + words + 10 × (answer, result). */
149: const NPC_DIALOGUE_RECORD_SIZE = 4 + 4 + 10 * 2 * 4;
150: /** `QM_MAX_ND_ANSWER` (QuestMng.h:8). */
151: const NPC_DIALOGUE_MAX_ANSWERS = 10;
152: 
153: /**
154:  * `SNPCDialogue` - one page of a Season 6 NPC's talk, keyed
155:  * `npcIndex * 0x10000 + dialogState` (`GetNPCDlgNPCWords`). Each answer is a
156:  * QuestWords index and a *result*: ≤ 900 the next page, 901 quest list,
157:  * 902 NPC buff, 903 / 904 join Gens Duprian / Vanert, 905 leave, 906 / 907
158:  * Gens reward (`ProcessSelTextResult`).
159:  */
160: export type NpcDialogueEntry = {
161:   key: number;
162:   npcWords: number;
163:   answers: { words: number; result: number }[];
164: };
165: 
166: function readNpcDialogue(buffer: Uint8Array): Map<number, NpcDialogueEntry> {
167:   const entries = new Map<number, NpcDialogueEntry>();
168:   const count = Math.floor(buffer.length / NPC_DIALOGUE_RECORD_SIZE);
169: 
170:   for (let i = 0; i < count; i++) {
171:     const { view } = decodedRecord(buffer, i * NPC_DIALOGUE_RECORD_SIZE, NPC_DIALOGUE_RECORD_SIZE);
172:     const key = view.getUint32(0, true);
173:     const answers: NpcDialogueEntry['answers'] = [];
174:     for (let a = 0; a < NPC_DIALOGUE_MAX_ANSWERS; a++) {
175:       const words = view.getInt32(8 + a * 8, true);
176:       if (words === 0) break; // `GetNPCDlgAnswer`: the first 0 ends the list
177:       answers.push({ words, result: view.getInt32(12 + a * 8, true) });
178:     }
179:     entries.set(key, { key, npcWords: view.getInt32(4, true), answers });
180:   }
181: 
182:   return entries;
183: }
184: 
185: // ---- QuestWords.bmd --------------------------------------------------------
186: 
187: const WORDS_HEADER_SIZE = 6;
188: 
189: // ---- loaders ---------------------------------------------------------------
190: 
191: /** In the code page of the pack the tables came from (`localData.ts`). */
192: function cString(bytes: Uint8Array, offset: number, length: number): string {
193:   return decodeLocalText(bytes, offset, length);
194: }
195: 
196: function decodedRecord(buffer: Uint8Array, offset: number, size: number) {
197:   const record = buffer.slice(offset, offset + size);
198:   convertBux(record, size);
199:   return {
200:     bytes: record,
201:     view: new DataView(record.buffer, record.byteOffset, record.byteLength),
202:   };
203: }
204: 
205: function readQuestDefinitions(buffer: Uint8Array): QuestDefinition[] {
206:   const count = Math.min(MAX_QUESTS, Math.floor(buffer.length / QUEST_RECORD_SIZE));
207:   const quests: QuestDefinition[] = [];
208: 
209:   for (let i = 0; i < count; i++) {
210:     const { bytes, view } = decodedRecord(buffer, i * QUEST_RECORD_SIZE, QUEST_RECORD_SIZE);
211: 
212:     const conditionCount = Math.max(0, Math.min(MAX_QUEST_CONDITION, view.getInt16(0, true)));
213:     const requestCount = Math.max(0, Math.min(MAX_QUEST_REQUEST, view.getInt16(2, true)));
214: 
215:     const acts: QuestAct[] = [];
216:     for (let a = 0; a < MAX_QUEST_CONDITION; a++) {
217:       const o = QUEST_ACT_OFFSET + a * QUEST_ACT_SIZE;
218:       const requestClass: number[] = [];
219:       for (let c = 0; c < QUEST_CLASS_COUNT; c++) requestClass.push(bytes[o + 8 + c]);
220:       acts.push({
221:         live: bytes[o],
222:         kind: bytes[o + 1],
223:         itemType: view.getUint16(o + 2, true),
224:         itemSubType: bytes[o + 4],
225:         itemLevel: bytes[o + 5],
226:         itemNum: bytes[o + 6],
227:         requestType: bytes[o + 7],
228:         requestClass,
229:         startText: [0, 1, 2, 3].map(k => view.getInt16(o + 16 + k * 2, true)),
230:       });
231:     }
232: 
233:     const requests: QuestRequest[] = [];
234:     for (let r = 0; r < MAX_QUEST_REQUEST; r++) {
235:       const o = QUEST_REQUEST_OFFSET + r * QUEST_REQUEST_SIZE;
236:       requests.push({
237:         live: bytes[o],
238:         type: bytes[o + 1],
239:         completeQuestIndex: view.getUint16(o + 2, true),
240:         levelMin: view.getUint16(o + 4, true),
241:         levelMax: view.getUint16(o + 6, true),
242:         requestStrength: view.getUint16(o + 8, true),
243:         zen: view.getUint32(o + 12, true),
244:         errorText: view.getInt16(o + 16, true),
245:       });
246:     }
247: 
248:     quests.push({
249:       index: i,
250:       conditionCount,
251:       requestCount,
252:       npcType: view.getUint16(4, true),
253:       name: cString(bytes, 6, QUEST_NAME_LENGTH),
254:       acts,
255:       requests,
256:     });
257:   }
258: 
259:   return quests;
260: }
261: 
262: function readDialogScripts(buffer: Uint8Array): DialogScript[] {
263:   const count = Math.min(MAX_DIALOG, Math.floor(buffer.length / DIALOG_RECORD_SIZE));
264:   const scripts: DialogScript[] = [];
265: 
266:   for (let i = 0; i < count; i++) {
267:     const { bytes, view } = decodedRecord(buffer, i * DIALOG_RECORD_SIZE, DIALOG_RECORD_SIZE);
268:     const answerCount = Math.max(0, Math.min(DIALOG_MAX_ANSWERS, view.getInt32(DIALOG_TEXT_LENGTH, true)));
269:     const answers: DialogScript['answers'] = [];
270: 
271:     for (let a = 0; a < answerCount; a++) {
272:       answers.push({
273:         link: view.getInt32(DIALOG_TEXT_LENGTH + 4 + a * 4, true),
274:         action: view.getInt32(DIALOG_TEXT_LENGTH + 4 + DIALOG_MAX_ANSWERS * 4 + a * 4, true),
275:         text: cString(
276:           bytes,
277:           DIALOG_TEXT_LENGTH + 4 + DIALOG_MAX_ANSWERS * 8 + a * DIALOG_ANSWER_LENGTH,
278:           DIALOG_ANSWER_LENGTH
279:         ),
280:       });
281:     }
282: 
283:     scripts.push({ text: cString(bytes, 0, DIALOG_TEXT_LENGTH), answers });
284:   }
285: 
286:   return scripts;
287: }
288: 
289: function readQuestProgress(buffer: Uint8Array): Map<number, QuestProgressEntry> {
290:   const entries = new Map<number, QuestProgressEntry>();
291:   const count = Math.floor(buffer.length / PROGRESS_RECORD_SIZE);
292: 
293:   for (let i = 0; i < count; i++) {
294:     const { bytes, view } = decodedRecord(buffer, i * PROGRESS_RECORD_SIZE, PROGRESS_RECORD_SIZE);
295:     const answers: number[] = [];
296:     for (let a = 0; a < PROGRESS_MAX_ANSWERS; a++) answers.push(view.getInt32(13 + a * 4, true));
297: 
298:     const key = view.getUint32(0, true);
299:     entries.set(key, {
300:       key,
301:       uiType: bytes[4],
302:       npcWords: view.getInt32(5, true),
303:       playerWords: view.getInt32(9, true),
304:       answers,
305:       subject: view.getInt32(33, true),
306:       summary: view.getInt32(37, true),
307:     });
308:   }
309: 
310:   return entries;
311: }
312: 
313: function readQuestWords(buffer: Uint8Array): Map<number, string> {
314:   const words = new Map<number, string>();
315:   let offset = 0;
316: 
317:   while (offset + WORDS_HEADER_SIZE <= buffer.length) {
318:     const { view } = decodedRecord(buffer, offset, WORDS_HEADER_SIZE);
319:     const index = view.getInt32(0, true);
320:     const length = view.getInt16(4, true);
321:     offset += WORDS_HEADER_SIZE;
322: 
323:     if (length < 0 || offset + length > buffer.length) break;
324: 
325:     const body = buffer.slice(offset, offset + length);
326:     convertBux(body, length);
327:     words.set(index, repairPackText(cString(body, 0, length)));
328:     offset += length;
329:   }
330: 
331:   checkPackText('QuestWords', words.values());
332: 
333:   return words;
334: }
335: 
336: /** Everything the quest tables hold, loaded once. */
337: export type QuestTables = {
338:   quests: QuestDefinition[];
339:   dialogs: DialogScript[];
340:   progress: Map<number, QuestProgressEntry>;
341:   words: Map<number, string>;
342:   /** `m_mapNPCDialogue`, keyed `npcIndex * 0x10000 + state`. */
343:   npcDialogues: Map<number, NpcDialogueEntry>;
344: };
345: 
346: let pending: Promise<QuestTables> | null = null;
347: 
348: /** Loads all four tables, once; a failure lets the next call retry. */
349: export function loadQuestTables(): Promise<QuestTables> {
350:   if (!pending) {
351:     pending = readQuestTables().catch(err => {
352:       pending = null;
353:       throw err;
354:     });
355:   }
356:   return pending;
357: }
358: 
359: // All four files are `_<lang>`-tagged, so the memo above only holds for the
360: // language it was read in. Dropping it is what makes the reload `questData.ts`
361: // asks for actually go back to the server: without this the next call hands
362: // back the promise of the *old* language, the tables come back identical, and
363: // the windows redraw in the language the player just left.
364: onLanguageChanged(() => {
365:   pending = null;
366: });
367: 
368: async function optional(path: string): Promise<Uint8Array> {
369:   try {
370:     return await downloadDataFile(path);
371:   } catch (err) {
372:     console.warn(`Quest table ${path} is missing:`, err);
373:     return new Uint8Array(0);
374:   }
375: }
376: 
377: async function readQuestTables(): Promise<QuestTables> {
378:   // `g_strSelectedML` in the original: the folder of the language the player
379:   // picked, English where that language has no pack. `Quest.bmd` /
380:   // `QuestWords.bmd` in the root are the language-less siblings, same layout.
381:   const [questsRaw, dialogsRaw, progressRaw, wordsRaw, npcDialogueRaw] = await Promise.all([
382:     downloadLocalDataFile('Quest', 'Local/Quest.bmd'),
383:     downloadLocalDataFile('Dialog'),
384:     optional('Local/QuestProgress.bmd'),
385:     downloadLocalDataFile('QuestWords', 'Local/QuestWords.bmd'),
386:     optional('Local/NPCDialogue.bmd'),
387:   ]);
388: 
389:   return {
390:     quests: readQuestDefinitions(questsRaw),
391:     dialogs: readDialogScripts(dialogsRaw),
392:     progress: readQuestProgress(progressRaw),
393:     words: readQuestWords(wordsRaw),
394:     npcDialogues: readNpcDialogue(npcDialogueRaw),
395:   };
396: }
</file>

