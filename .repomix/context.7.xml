 60: /**
 61:  * Everything `getTerrainData` needs that can fail - the downloads, the worker
 62:  * parse (incl. the anti-tamper probe), the JPEG decodes - gathered *before*
 63:  * the current map is torn down, so a failed warp leaves the old map standing
 64:  * (`loadMapIntoScene`). Holds GPU textures: `disposePreparedTerrain` if the
 65:  * build never happens.
 66:  */
 67: export type PreparedTerrain = Awaited<ReturnType<typeof prepareTerrain>>;
