  1: import { assetWorldNum } from '../../common/worldAssets';
  2: import type { ENUM_WORLD } from '../../common';
  3: import {
  4:   MinimapMarkerKind,
  5:   parseMinimapData,
  6:   type MinimapMarker,
  7: } from '../../common/minimapData';
  8: import { i18n, onLanguageChanged } from '../../i18n';
  9: import { resolveDataUrl } from './dataFolder';
 10: import { clearSpriteCache, loadMuSprite, type MuSprite } from './sprites';
 11: import { fetchAssetBytes, prefetchAsset } from '../../common/compressedAssets';
 12: 
 13: /**
 14:  * The minimap assets of one world, the way `CNewUIMiniMap::LoadImages` finds
 15:  * them: `Data/World{n}/mini_map.ozt` is the map picture (its absence means
 16:  * "this map has no minimap" - `m_bSuccess = false`, TAB does nothing), and the
 17:  * markers come from the localised `Data/Local/{lang}/Minimap/Minimap_World{n}_{lang}.bmd`.
 18:  * This Data folder also carries the older per-world `World{n}/Minimap.bmd`,
 19:  * whose names are Shift-JIS; it is the fallback when no localised file exists.
 20:  *
 21:  * Loading is in two steps: `prefetchWorldMinimap` on warp warms the browser's
 22:  * HTTP cache for the 4 MB picture (no decode, nothing held), and
 23:  * `loadWorldMinimap` decodes it on the first TAB. One decoded map is kept -
 24:  * the current one - `evictWorldMinimaps` on warp drops the others.
 25:  */
 26: 
 27: export type WorldMinimap = {
 28:   image: MuSprite;
 29:   markers: MinimapMarker[];
 30: };
 31: 
 32: const cache = new Map<ENUM_WORLD, Promise<WorldMinimap | null>>();
 33: 
 34: /**
 35:  * The marker files to try for one world, best first: the active language's
 36:  * pack, then English. `Local/Por/Minimap/` ships both `_por` and `_eng` files,
 37:  * so the fallback is decided per world rather than per language.
 38:  *
 39:  * The Latin packs are windows-1252, not the UTF-8 the English file is
 40:  * (`i18n.dataEncoding` says which) - read as UTF-8 they come back as
 41:  * "Guardi<28>n de Seguridad".
 42:  */
 43: function markerFiles(worldNum: number): { path: string; encoding: string }[] {
 44:   const files: { path: string; encoding: string }[] = [];
 45:   const pack = i18n.dataPack;
 46: 
 47:   const push = (folder: string, suffix: string, encoding: string) =>
 48:     files.push({
 49:       path: `Local/${folder}/Minimap/Minimap_World${worldNum}_${suffix}.bmd`,
 50:       encoding,
 51:     });
 52: 
 53:   if (pack && pack.folder !== 'Eng') push(pack.folder, pack.suffix, i18n.dataEncoding);
 54:   push('Eng', 'eng', 'utf-8');
 55: 
 56:   return files;
 57: }
 58: 
 59: // The marker names come out of the pack; the picture does not, and
 60: // `loadMuSprite` keeps its own cache, so re-reading a map after a language
 61: // change costs the marker file and nothing else.
 62: onLanguageChanged(() => {
 63:   cache.clear();
 64: });
 65: 
 66: function minimapImagePath(map: ENUM_WORLD): string {
 67:   return `World${assetWorldNum(map)}/mini_map.OZT`;
 68: }
 69: 
 70: export function loadWorldMinimap(map: ENUM_WORLD): Promise<WorldMinimap | null> {
 71:   let pending = cache.get(map);
 72: 
 73:   if (!pending) {
 74:     pending = readWorldMinimap(map).catch(err => {
 75:       cache.delete(map);
 76:       throw err;
 77:     });
 78:     cache.set(map, pending);
 79:   }
 80: 
 81:   return pending;
 82: }
 83: 
 84: /** Warm the HTTP cache for the picture; the TGA decode waits for the first TAB. */
 85: export function prefetchWorldMinimap(map: ENUM_WORLD): void {
 86:   if (cache.has(map)) return;
 87:   void prefetchAsset(resolveDataUrl(minimapImagePath(map)));
 88: }
 89: 
 90: /** Drop every decoded minimap but `keep`'s (their blob URLs with them). */
 91: export function evictWorldMinimaps(keep: ENUM_WORLD): void {
 92:   for (const map of [...cache.keys()]) {
 93:     if (map === keep) continue;
 94:     cache.delete(map);
 95:     const key = minimapImagePath(map).toLowerCase();
 96:     clearSpriteCache(path => path === key);
 97:   }
 98: }
 99: 
100: /** The localised marker tables: absent for most worlds, so a miss is normal. */
101: async function fetchDataBytes(path: string): Promise<Uint8Array | null> {
102:   try {
103:     return await fetchAssetBytes(resolveDataUrl(path));
104:   } catch {
105:     return null;
106:   }
107: }
108: 
109: async function readWorldMinimap(map: ENUM_WORLD): Promise<WorldMinimap | null> {
110:   const worldNum = assetWorldNum(map);
111: 
112:   let image: MuSprite;
113:   try {
114:     image = await loadMuSprite(minimapImagePath(map));
115:   } catch {
116:     return null;
117:   }
118: 
119:   return { image, markers: await readMarkers(worldNum) };
120: }
121: 
122: /**
123:  * The localised English files dropped the portal rows of a few worlds
124:  * (Lorencia's four, Icecity's safe-zone one) that the Japanese per-world
125:  * files still carry; those are merged back in with their names translated.
126:  */
127: const PORTAL_NAME_TRANSLATIONS: Record<string, string> = {
128:   ダンジョン: 'Dungeon',
129:   デビアス: 'Devias',
130:   ノリア: 'Noria',
131:   ロレン峡谷: 'Valley of Loren',
132:   ロレンシア: 'Lorencia',
133:   安全地帯: 'Safe Zone',
134: };
135: 
136: function translatePortalName(name: string): string {
137:   return PORTAL_NAME_TRANSLATIONS[name] ?? name;
138: }
139: 
140: async function readMarkers(worldNum: number): Promise<MinimapMarker[]> {
141:   const legacy = await fetchDataBytes(`World${worldNum}/Minimap.bmd`);
142:   const legacyMarkers = legacy ? parseMinimapData(legacy, 'shift_jis') : [];
143: 
144:   for (const { path, encoding } of markerFiles(worldNum)) {
145:     const bytes = await fetchDataBytes(path);
146:     if (!bytes) continue;
147: 
148:     const markers = parseMinimapData(bytes, encoding);
149:     const missingPortals = legacyMarkers.filter(
150:       marker =>
151:         marker.kind === MinimapMarkerKind.Portal &&
152:         !markers.some(
153:           m => m.kind === MinimapMarkerKind.Portal && m.x === marker.x && m.y === marker.y
154:         )
155:     );
156: 
157:     return markers.concat(
158:       missingPortals.map(marker => ({
159:         ...marker,
160:         name: translatePortalName(marker.name),
161:       }))
162:     );
163:   }
164: 
165:   return legacyMarkers.map(marker => ({
166:     ...marker,
167:     name: translatePortalName(marker.name),
168:   }));
169: }
</file>

