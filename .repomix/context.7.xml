457: /**
458:  * Lorencia rooms (map ev 1.8): the pub with candelabra on every table, the
459:  * cabin across the river. The room's share now scales the emitters as well as
460:  * the bake, so the level is one number again: 1.4 lands the pub at p50 0.196
461:  * against Classic's 0.200 with tex 0.203 against 0.162 (`w3_v2_pub_1.4`).
462:  */
463: const LORENCIA_ROOM = room(1.4, 1);
464: 
465: /**
466:  * Devias rooms (map ev 0.8): the tavern's hearth and door candelabra, the
467:  * reading room's desk candelabra, the hearth houses, the guard room. The map
468:  * sits 1.0 ev under Lorencia, so the same room level is a smaller share.
469:  */
470: const DEVIAS_ROOM = room(1.3, 1);
471: 
472: /**
473:  * The two castle halls: twenty tiles across with a colonnade down each side
474:  * and a handful of wall candelabra, so the candles reach far less of the room
475:  * than a tavern's do and its own level carries more of the picture.
476:  *
477:  * Not gated against Classic the way F14's rooms are, and it cannot be:
478:  * Classic never opens this roof (only the slabs within the hero's fill lift,
479:  * F11), so almost no interior surface is comparable between the tiers. On the
480:  * one that is - the banner wall over the cutaway, same camera - the hall reads
481:  * 0.81x Classic's mean, a little under. This is the knob if it wants raising.
482:  */
483: const DEVIAS_CASTLE_HALL = room(1.45, 1);
484: 
485: const AREAS = {
486:   lorenciaTavern: LORENCIA_ROOM,
487:   lorenciaCabin: LORENCIA_ROOM,
488:   deviasTavern: DEVIAS_ROOM,
489:   deviasReadingRoom: DEVIAS_ROOM,
490:   deviasHearthHouse: DEVIAS_ROOM,
491:   deviasGuardRoom: DEVIAS_ROOM,
492:   deviasCastleHall: DEVIAS_CASTLE_HALL,
493: } satisfies Record<string, AreaLook>;
494: 
495: export type AreaLookName = keyof typeof AREAS;
496: 
497: export function areaProfile(name: AreaLookName): AreaLook {
498:   return AREAS[name];
499: }
