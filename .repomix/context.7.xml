167: type Dome = {
168:   scene: Scene;
169:   mesh: Mesh;
170:   material: ShaderMaterial;
171: };
172: 
173: let dome: Dome | null = null;
174: 
175: /**
176:  * The other half of the sky: the inverted dome under the world, for a map
177:  * whose ground has holes in it (`LookProfile.underworld`).
178:  *
179:  * Devias' ravines are `NoGround` tiles, which the ground mesh sends past the
180:  * far plane, so nothing at all is drawn where they are and the pixel is the
181:  * scene's clear colour - the same pale blue as the sky, which is why the
182:  * ravines came out as panes lying *brighter* than the snow they are cut out
183:  * of. The clear colour cannot simply be darkened: on a camera looking down it
184:  * is also what fills the top of the frame, where the dome above does not
185:  * reach.
186:  *
187:  * So: geometry, not a mask over the frame. A ray down a hole meets this and a
188:  * ray to the sky does not, which is a distinction the renderer can make and a
189:  * post pass cannot - depth 0 is a card against the sky and a hole in the
190:  * ground alike, and the three cuts of this that tried to tell them apart in
191:  * screen space all ended up blacking out grass cards on the rim. Drawn like
192:  * the dome above - riding the camera, first group, out of every buffer - so
193:  * everything in the world draws over it and occludes it without being asked.
194:  */
195: let floor: Dome | null = null;
196: 
197: let domeScene: Scene | null = null;
198: 
199: let observed: LookDirector | null = null;
200: 
201: export function syncSkyDome(scene: Scene, look: ClearLook): void {
202:   domeScene = scene;
203:   watchDome();
204: 
205:   if (look.black) {
206:     scene.clearColor.set(0, 0, 0, 1);
207:     return;
208:   }
209: 
210:   if (look.horizon) {
211:     const c = look.linear ? toLinear(look.horizon) : look.horizon;
212:     scene.clearColor.set(c[0], c[1], c[2], 1);
213:     return;
214:   }
215: 
216:   const bytes = look.bytes;
217: 
218:   if (bytes) {
219:     // Display-authored like the horizon (SetWorldClearColor bytes): one decode
220:     // for the linear buffer, so the void lands where the map put it.
221:     const c: Rgb = [bytes[0] / 256, bytes[1] / 256, bytes[2] / 256];
222:     const lin = look.linear ? toLinear(c) : c;
223:     scene.clearColor.set(lin[0], lin[1], lin[2], 1);
224:   } else {
225:     scene.clearColor.set(0, 0, 0, 1);
226:   }
227: }
228: 
229: /**
230:  * The dome follows the published look: it needs the map's zenith as well as
231:  * the horizon the clear colour is handed, and the tier and the room, all of
232:  * which are in `LookState` and in its change signature.
233:  */
234: function watchDome(): void {
235:   const director = lookDirector();
236:   if (!director || director === observed) return;
237: 
238:   observed = director;
239:   director.onChange.add(syncDomeMesh);
240: }
241: 
242: const DEG = Math.PI / 180;
243: 
244: function syncDomeMesh(state: Readonly<LookState>): void {
245:   const scene = domeScene;
246:   const sky =
247:     scene && state.tier > 0 && !state.area ? profileFor(state.world).sky : null;
248: 
249:   if (!sky || !scene) {
250:     disposeSkyDome();
251:     return;
252:   }
253: 
254:   if (dome && (dome.scene !== scene || dome.mesh.isDisposed())) {
255:     disposeSkyDome();
256:   }
257: 
258:   dome ??= createDome(scene);
259: 
260:   const linear = linearBufferActive(scene);
261:   const decode = (c: Rgb): Rgb => (linear ? toLinear(c) : c);
262: 
263:   const zenith = decode(sky.zenith);
264:   const horizon = decode(sky.horizon);
265:   // A map with no disc (overcast, snowfall) keeps the halo off too; the
266:   // colour still feeds the cloud lighting, so it falls back to the zenith.
267:   const disc = sky.sun === null ? null : decode(sky.sun ?? SKY_SUN_DEFAULT);
268: 
269:   dome.material.setArray3('zenith', [zenith[0], zenith[1], zenith[2]]);
270:   dome.material.setArray3('horizon', [horizon[0], horizon[1], horizon[2]]);
271:   dome.material.setArray3(
272:     'sunColor',
273:     disc ? [disc[0], disc[1], disc[2]] : [zenith[0], zenith[1], zenith[2]]
274:   );
275: 
276:   const d = state.key.direction;
277:   const norm = 1 / (Math.hypot(d[0], d[1], d[2]) || 1);
278:   dome.material.setArray3('sunDir', [d[0] * norm, d[1] * norm, d[2] * norm]);
279: 
280:   const outer = Math.cos((DISC_RADIUS_DEG + DISC_EDGE_DEG) * DEG);
281:   const inner = Math.cos(DISC_RADIUS_DEG * DEG);
282: 
283:   dome.material.setArray4('skyParams', [
284:     sky.curve ?? SKY_CURVE_DEFAULT,
285:     disc ? sky.halo ?? SKY_HALO_DEFAULT : 0,
286:     disc ? outer : 2,
287:     disc ? inner : 2,
288:   ]);
289: 
290:   domeSky = sky;
291: 
292:   syncFloorMesh(scene, state, horizon);
293: }
294: 
295: /**
296:  * Where the floor stops being the sky and starts being the underworld, as the
297:  * sine of the angle under the horizon.
298:  *
299:  * It has to hold the horizon's own colour right under the line, or the map
300:  * ends in a dark band ruled across the frame at eye level. By 27 degrees down
301:  * it is all underworld, which every camera that can see into a ravine is past:
302:  * the ported one looks down 48.5.
303:  */
304: const FLOOR_NEAR = 0.02;
305: const FLOOR_FAR = 0.45;
306: 
307: function syncFloorMesh(
308:   scene: Scene,
309:   state: Readonly<LookState>,
310:   horizon: Rgb
311: ): void {
312:   // `?uw=0` takes the floor down with the fog it belongs to, so the A/B is
313:   // the whole feature and not half of it.
314:   const under = uwDev === 0 ? undefined : profileFor(state.world).underworld;
315: 
316:   if (!under) {
317:     disposeSkyFloor();
318:     return;
319:   }
320: 
321:   if (floor && (floor.scene !== scene || floor.mesh.isDisposed())) {
322:     disposeSkyFloor();
323:   }
324: 
325:   floor ??= createFloor(scene);
326: 
327:   const c = linearBufferActive(scene) ? toLinear(under.color) : under.color;
328: 
329:   floor.material.setArray3('horizon', [horizon[0], horizon[1], horizon[2]]);
330:   floor.material.setArray3('deep', [c[0], c[1], c[2]]);
331:   floor.material.setArray2('floorBand', [FLOOR_NEAR, FLOOR_FAR]);
332: }
333: 
334: /** The sky the dome is drawing, for the per-frame cloud binding. */
335: let domeSky: SkyLook | null = null;
336: 
337: /**
338:  * The cloud field moves every frame while the profile does not, so it is
339:  * bound per draw rather than on the director's change signature.
340:  */
341: function bindDomeClouds(scene: Scene, state: Readonly<LookState> | null): void {
342:   const effect = dome?.material.getEffect();
343: 
344:   if (!effect || !domeSky || !state) return;
345: 
346:   bindClouds(effect, scene, {
347:     base: domeSky.clouds ?? SKY_CLOUDS_DEFAULT,
348:     sunDirection: state.key.direction,
349:     sunElevationDeg: state.profile.sun.elevationDeg,
350:   });
351: }
352: 
353: export function disposeSkyDome(): void {
354:   disposeSkyFloor();
355: 
356:   if (!dome) return;
357: 
358:   dome.mesh.dispose(false, true);
359:   dome = null;
360: }
361: 
362: function disposeSkyFloor(): void {
363:   if (!floor) return;
364: 
365:   floor.mesh.dispose(false, true);
366:   floor = null;
367: }
368: 
369: const FLOOR_SHADER = 'muSkyFloor';
370: 
371: function registerFloorShader(): void {
372:   if (ShaderStore.ShadersStore[`${FLOOR_SHADER}VertexShader`]) return;
373: 
374:   ShaderStore.ShadersStore[`${FLOOR_SHADER}VertexShader`] = `
375:   precision highp float;
376:   attribute vec3 position;
377:   uniform mat4 worldViewProjection;
378:   varying vec3 vDir;
379: 
380:   void main(void) {
381:     vDir = position;
382:     gl_Position = worldViewProjection * vec4(position, 1.0);
383:   }
384:   `;
385: 
386:   ShaderStore.ShadersStore[`${FLOOR_SHADER}FragmentShader`] = `
387:   precision highp float;
388:   varying vec3 vDir;
389:   uniform vec3 horizon;
390:   uniform vec3 deep;
391:   uniform vec2 floorBand;
392: 
393:   void main(void) {
394:     float down = clamp(-normalize(vDir).y, 0.0, 1.0);
395: 
396:     gl_FragColor = vec4(
397:       mix(horizon, deep, smoothstep(floorBand.x, floorBand.y, down)),
398:       1.0);
399:   }
400:   `;
401: }
402: 
403: function createFloor(scene: Scene): Dome {
404:   registerFloorShader();
405: 
406:   const mesh = new Mesh('skyFloor', scene);
407: 
408:   // The same half sphere the dome is, turned over in its *vertices* rather
409:   // than by rotating the node: the shader reads the direction off the raw
410:   // attribute, the way the dome's does, and a rotation on the node would
411:   // leave it reading the half it was built as. `backFaceCulling` is off, so
412:   // the winding the flip inverts does not matter.
413:   const data = CreateSphereVertexData({
414:     segments: DOME_SEGMENTS,
415:     diameter: DOME_RADIUS * 2,
416:     slice: 0.5,
417:     sideOrientation: Mesh.BACKSIDE,
418:   });
419: 
420:   if (data.positions) {
421:     for (let i = 1; i < data.positions.length; i += 3) {
422:       data.positions[i] = -data.positions[i];
423:     }
424:   }
425: 
426:   data.applyToMesh(mesh);
427: 
428:   const material = new ShaderMaterial('skyFloor', scene, FLOOR_SHADER, {
429:     attributes: ['position'],
430:     uniforms: ['worldViewProjection', 'horizon', 'deep', 'floorBand'],
431:   });
432: 
433:   material.backFaceCulling = false;
434:   mesh.material = material;
435: 
436:   // The dome's rules, for the dome's reasons: rides with the camera, always in
437:   // view, first group, and no metadata - the G-buffer, the effect mask and the
438:   // cascades all admit meshes by their flags, so this is in none of them and
439:   // neither the haze nor the AO ever touches it.
440:   mesh.infiniteDistance = true;
441:   mesh.alwaysSelectAsActiveMesh = true;
442:   mesh.renderingGroupId = 0;
443:   mesh.isPickable = false;
444:   mesh.receiveShadows = false;
445:   mesh.doNotSyncBoundingInfo = true;
446: 
447:   return { scene, mesh, material };
448: }
449: 
450: function registerDomeShader(): void {
451:   if (ShaderStore.ShadersStore[`${DOME_SHADER}VertexShader`]) return;
452: 
453:   ShaderStore.ShadersStore[`${DOME_SHADER}VertexShader`] = `
454:   precision highp float;
455:   attribute vec3 position;
456:   uniform mat4 worldViewProjection;
457:   varying vec3 vDir;
458: 
459:   void main(void) {
460:     // The dome rides the camera (infiniteDistance) and has no rotation of its
461:     // own, so its local position normalised is the world view direction.
462:     vDir = normalize(position);
463:     gl_Position = worldViewProjection * vec4(position, 1.0);
464:   }
465:   `;
466: 
467:   ShaderStore.ShadersStore[`${DOME_SHADER}FragmentShader`] = `
468:   precision highp float;
469:   varying vec3 vDir;
470:   uniform vec3 zenith;
471:   uniform vec3 horizon;
472:   uniform vec3 sunColor;
473:   uniform vec3 sunDir;
474:   uniform vec4 skyParams;   // curve, halo strength, disc cos outer, disc cos inner
475:   uniform vec3 cameraPosition;
476: 
477: ${cloudFieldGlsl()}
478: 
479:   const int CLOUD_LIGHT_STEPS = ${CLOUD_LIGHT_STEPS};
480:   const float CLOUD_R = ${CLOUD_PLANET_RADIUS.toFixed(1)};
481: 
482:   /**
483:    * A cloud's shape is read **once**, where the ray meets the middle of the
484:    * deck. Marching the shape through the slab instead drew the same field at
485:    * several different distances, and at anything but straight up those
486:    * intersections land far apart: what it produced was five offset copies of
487:    * one cloud, fanning out into the vertical streaks that made the sky look
488:    * like a stack of transparencies.
489:    *
490:    * The depth comes from the light march. Samples are stepped up the *sun*
491:    * ray from the cloud's base toward its top, which is how much of the deck
492:    * stands between this point and the sun. Those offsets are small and all in
493:    * one direction, so they shade the body rather than duplicating it: a face
494:    * turned to the sun comes out bright, a deep interior dark, and the edges
495:    * stay thin.
496:    *
497:    * Sky pixels only.
498:    */
499:   /** Distance along rd to the shell of radius CLOUD_R + h. Same root as below. */
500:   float muShellHit(vec3 rd, float h) {
501:     float rise = max(h - cameraPosition.y, 1.0);
502:     float k = rise * (2.0 * CLOUD_R + h + cameraPosition.y);
503:     float b = (CLOUD_R + cameraPosition.y) * rd.y;
504: 
505:     return k / (b + sqrt(b * b + k));
506:   }
507: 
508:   /**
509:    * The deck as a body rather than a sheet: the view ray is walked between the
510:    * shells at the deck's base and top, gathering density, and each sample is
511:    * lit by a short march up the sun ray through the same field.
512:    *
513:    * Front to back, so the accumulated transmittance can stop the walk once
514:    * nothing behind would show. Ultra only - every other tier takes the slab
515:    * below, unchanged.
516:    */
517:   vec4 muCloudVolume(vec3 rd, vec3 sunLit, vec3 base) {
518:     if (muCloudA.z <= 0.01) return vec4(0.0);
519: 
520:     float tBase = muShellHit(rd, muCloudB.z);
521:     float tTop = muShellHit(rd, muCloudB.z + muCloudB.w);
522: 
523:     float tIn = min(tBase, tTop);
524:     float tOut = max(tBase, tTop);
525: 
526:     if (tOut <= 0.0) return vec4(0.0);
527: 
528:     tIn = max(tIn, 0.0);
529: 
530:     // A ray near the horizon crosses far more deck than one overhead. Capping
531:     // the walked length keeps the step count honest and the far deck is haze
532:     // by then anyway.
533:     float span = min(tOut - tIn, ${VOLUME_MAX_SPAN.toFixed(1)});
534:     float step = span / ${VOLUME_STEPS}.0;
535: 
536:     // How much of the fine structure this ray's step can resolve.
537:     float detail = clamp(
538:       (${VOLUME_DETAIL_NONE.toFixed(1)} - step)
539:         / ${(VOLUME_DETAIL_NONE - VOLUME_DETAIL_FULL).toFixed(1)},
540:       0.0,
541:       1.0
542:     );
543: 
544:     // Start the walk a fraction of a step in, by pixel. Every ray sampling at
545:     // the same offsets puts the residual error in the same place on every one
546:     // of them, and a shared error is a visible band; scattered, it is noise
547:     // the eye reads as the deck's own texture.
548:     float jitter = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
549: 
550:     vec3 lit = vec3(0.0);
551:     float trans = 1.0;
552: 
553:     for (int i = 0; i < ${VOLUME_STEPS}; i++) {
554:       if (trans < ${VOLUME_CUTOFF.toFixed(3)}) break;
555: 
556:       float t = tIn + (float(i) + jitter) * step;
557:       vec3 wp = cameraPosition + rd * t;
558: 
559:       float h = clamp((wp.y - muCloudB.z) / muCloudB.w, 0.0, 1.0);
560:       float d = muCloudDensity(wp, h, detail);
561: 
562:       if (d <= 0.0) continue;
563: 
564:       // Up the sun ray, through the deck the light had to cross to get here.
565:       float shade = 0.0;
566: 
567:       for (int j = 1; j <= ${VOLUME_LIGHT_STEPS}; j++) {
568:         float f = float(j) / ${VOLUME_LIGHT_STEPS}.0;
569:         vec3 lp = wp + vec3(muCloudB.x, 1.0, muCloudB.y) * muCloudB.w * f;
570:         float lh = clamp((lp.y - muCloudB.z) / muCloudB.w, 0.0, 1.0);
571: 
572:         shade += muCloudDensity(lp, lh, detail);
573:       }
574: 
575:       float sun = exp(-${VOLUME_SELF_SHADOW.toFixed(2)} * shade / ${VOLUME_LIGHT_STEPS}.0);
576: 
577:       vec3 body = mix(base * ${CLOUD_BASE_SHADE.toFixed(2)}, sunLit * ${CLOUD_LIT_GAIN.toFixed(2)}, sun);
578: 
579:       float take = 1.0 - exp(-d * ${VOLUME_DENSITY.toFixed(2)} * step);
580: 
581:       lit += body * take * trans;
582:       trans *= 1.0 - take;
583:     }
584: 
585:     float alpha = 1.0 - trans;
586:     if (alpha <= 0.001) return vec4(0.0);
587: 
588:     vec3 colour = lit / max(alpha, 0.001);
589: 
590:     float aerial = 1.0 - exp(
591:       -max(tIn - ${CLOUD_AERIAL_START.toFixed(1)}, 0.0) / ${CLOUD_AERIAL_SCALE.toFixed(1)}
592:     );
593: 
594:     return vec4(mix(colour, base, aerial * ${CLOUD_AERIAL_MAX.toFixed(2)}), alpha);
595:   }
596: 
597:   vec4 muCloudSlab(vec3 rd, vec3 sunLit, vec3 base) {
598:     if (muCloudA.z <= 0.01) return vec4(0.0);
599: 
600:     // Where the ray leaves a shell of radius CLOUD_R + h, the eye standing at
601:     // CLOUD_R + cameraPosition.y. Written as k / (b + sqrt(b * b + k)) and not
602:     // as -b + sqrt(b * b + k): same root, but the second subtracts two numbers
603:     // around 6000 to arrive at a distance of 95 and spends the mantissa doing
604:     // it.
605:     float h = muCloudB.z + muCloudB.w * 0.5;
606:     float rise = max(h - cameraPosition.y, 1.0);
607:     float k = rise * (2.0 * CLOUD_R + h + cameraPosition.y);
608:     float b = (CLOUD_R + cameraPosition.y) * rd.y;
609:     float t = k / (b + sqrt(b * b + k));
610:     vec2 p = cameraPosition.xz + rd.xz * t;
611: 
612:     float d = muCloudCover(p);
613:     if (d <= 0.0) return vec4(0.0);
614: 
615:     float shadow = 0.0;
616: 
617:     for (int i = 1; i <= CLOUD_LIGHT_STEPS; i++) {
618:       float f = float(i) / float(CLOUD_LIGHT_STEPS);
619:       shadow += muCloudCover(p + muCloudB.xy * muCloudB.w * f);
620:     }
621: 
622:     float lit = exp(-${CLOUD_SELF_SHADOW.toFixed(2)} * shadow / float(CLOUD_LIGHT_STEPS));
623: 
624:     vec3 body = mix(
625:       base * ${CLOUD_BASE_SHADE.toFixed(2)},
626:       sunLit * ${CLOUD_LIT_GAIN.toFixed(2)},
627:       lit
628:     );
629: 
630:     float alpha = 1.0 - exp(-${CLOUD_DENSITY.toFixed(2)} * d);
631: 
632:     // The dome is outside the G-buffer, so the distance haze never reaches it
633:     // and the deck has to take its own. Fading a far cloud into the sky drawn
634:     // behind it is what the haze does to the terrain below it, in the same
635:     // colour: the profile's horizon is both.
636:     float aerial = 1.0 - exp(
637:       -max(t - ${CLOUD_AERIAL_START.toFixed(1)}, 0.0) / ${CLOUD_AERIAL_SCALE.toFixed(1)}
638:     );
639: 
640:     return vec4(mix(body, base, aerial * ${CLOUD_AERIAL_MAX.toFixed(2)}), alpha);
641:   }
642: 
643:   void main(void) {
644:     vec3 rd = normalize(vDir);
645:     float up = clamp(rd.y, 0.0, 1.0);
646: 
647:     vec3 sky = mix(horizon, zenith, pow(up, skyParams.x));
648: 
649:     float sd = dot(rd, -sunDir);
650: 
651:     // One forward lobe for the glow and a hard disc inside it. The disc is
652:     // above scene white so bloom, and nothing else, gives it its glare.
653:     sky += sunColor * skyParams.y * pow(max(sd, 0.0), 120.0);
654:     sky += sunColor * ${DISC_GAIN.toFixed(1)} * smoothstep(skyParams.z, skyParams.w, sd);
655: 
656:     // muCloudC.z is the tier's field scale, and it is above 1 only where the
657:     // deck is marched. One flag, no define, no second material.
658:     vec4 clouds = muCloudC.z > 1.001
659:       ? muCloudVolume(rd, sunColor, sky)
660:       : muCloudSlab(rd, sunColor, sky);
661:     sky = mix(sky, clouds.rgb, clouds.a);
662: 
663:     gl_FragColor = vec4(sky, 1.0);
664:   }
665:   `;
666: }
667: 
668: function createDome(scene: Scene): Dome {
669:   registerDomeShader();
670: 
671:   const mesh = new Mesh('skyDome', scene);
672: 
673:   CreateSphereVertexData({
674:     segments: DOME_SEGMENTS,
675:     diameter: DOME_RADIUS * 2,
676:     slice: 0.5,
677:     sideOrientation: Mesh.BACKSIDE,
678:   }).applyToMesh(mesh);
679: 
680:   const material = new ShaderMaterial('skyDome', scene, DOME_SHADER, {
681:     attributes: ['position'],
682:     uniforms: [
683:       'worldViewProjection',
684:       'cameraPosition',
685:       'zenith',
686:       'horizon',
687:       'sunColor',
688:       'sunDir',
689:       'skyParams',
690:       ...CLOUD_UNIFORMS,
691:     ],
692:     samplers: [CLOUD_NOISE_SAMPLER],
693:   });
694: 
695:   material.backFaceCulling = false;
696:   mesh.material = material;
697: 
698:   material.onBindObservable.add(() => {
699:     bindDomeClouds(scene, lookDirector()?.state() ?? null);
700:   });
701: 
702:   // Rides with the camera, always in view, first group. No metadata on
703:   // purpose: the G-buffer, the effect mask and the cascades admit meshes by
704:   // their flags, so the sky is in none of them and the haze leaves it alone.
705:   mesh.infiniteDistance = true;
706:   mesh.alwaysSelectAsActiveMesh = true;
707:   mesh.renderingGroupId = 0;
708:   mesh.isPickable = false;
709:   mesh.receiveShadows = false;
710:   mesh.doNotSyncBoundingInfo = true;
711: 
712:   return { scene, mesh, material };
713: }
