 858:       // left standing is the stub, and a field of uneven black stubs is what
 859:       // burnt grass looks like.
 860:       float take = ${DISSOLVE_MIN.toFixed(2)}
 861:         + fract(vSeed * 91.71) * ${DISSOLVE_SPAN.toFixed(2)};
 862:       float edge = 1.0 - vBurn * take + wobble;
 863:       float past = vV - edge;
 864: 
 865:       if (past > 0.0) discard;
 866: 
 867:       // The char, just under the cut.
 868:       f = mix(f, vec3(${CHAR_COLOUR[0].toFixed(3)}, ${CHAR_COLOUR[1].toFixed(3)}, ${CHAR_COLOUR[2].toFixed(3)}),
