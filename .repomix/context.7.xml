 1: import { Vector3 } from '../babylon/exports';
 2: import { TERRAIN_SIZE } from '../../common/terrain/consts';
 3: 
 4: /**
 5:  * Expands the packed baked light (3 floats per texel) into the per-texel
 6:  * vectors the ground builder and the light sampler index.
 7:  *
 8:  * These have to be real `Vector3` instances, not plain `{x, y, z}` objects,
 9:  * even though every signature involved is typed `IVector3Like`:
10:  * `CreateGroundFromHeightMap` copies each entry with `Vector3.copyFrom`
11:  * (customGroundMesh.ts:51), and Babylon's `copyFrom` reads the *private*
12:  * backing fields - `source._x`, not `source.x` (math.vector.js:1753). Handing
13:  * it a plain object silently writes `undefined` into every terrain vertex
14:  * colour: no error, no exception, just flat unlit ground.
15:  *
16:  * Deliberately a separate module from `parseTerrainLight`: that one stays
17:  * free of Babylon so the terrain worker can import it without pulling the
18:  * engine into its chunk (todo C8).
19:  */
20: export function unpackTerrainLight(packed: Float32Array): Vector3[] {
21:   const out = new Array<Vector3>(TERRAIN_SIZE * TERRAIN_SIZE);
22: 
23:   for (let i = 0; i < TERRAIN_SIZE * TERRAIN_SIZE; i++) {
24:     const o = i * 3;
25:     out[i] = new Vector3(packed[o], packed[o + 1], packed[o + 2]);
26:   }
27: 
28:   return out;
29: }
</file>

<file path="src/libs/sockets/chatRoomSocket.ts">
  1: import { wsAddress } from '../../common/serverConfig';
  2: import { Xor32Encryptor } from '../../common/encryption/xor32';
  3: import {
  4:   ChatFrameSplitter,
  5:   decodeChatServerFrame,
  6:   encodeAuthenticate,
  7:   encodeChatMessage,
  8:   encodeKeepAlive,
  9:   encodeLeave,
 10:   type ChatServerEvent,
 11: } from '../../common/chatRoomProtocol';
 12: 
 13: /**
 14:  * One connection to the OpenMU ChatServer, carried over the same ws proxy the
 15:  * game sockets use (`?host=&port=`). Deliberately separate from
 16:  * `createSocket`: the chat server speaks its own small protocol - plain
 17:  * C1/C2 frames in, Xor32 on every frame out (the reference client opens this
 18:  * connection with `isEncrypted=true`, UIWindows.cpp ConnectToChatServer),
 19:  * no SimpleModulus in either direction.
 20:  */
 21: 
 22: /** `CHATCONNECT_TIMER`: the original pings every open room each 15 s. */
 23: const KEEP_ALIVE_MS = 15_000;
 24: 
 25: export type ChatRoomSocketOptions = {
 26:   host: string;
 27:   port: number;
 28:   roomId: number;
 29:   token: number;
 30:   onEvent: (event: ChatServerEvent) => void;
 31:   /** Fired once, whether the connect failed or an open socket died. */
 32:   onClose: (everOpened: boolean) => void;
 33: };
 34: 
 35: export type ChatRoomSocket = {
 36:   readonly isOpen: boolean;
 37:   sendMessage(text: string): void;
 38:   /** SendLeaveChatRoom + close; onClose is not fired for a deliberate leave. */
 39:   leave(): void;
 40: };
 41: 
 42: export function openChatRoomSocket(options: ChatRoomSocketOptions): ChatRoomSocket {
 43:   const { host, port, roomId, token } = options;
 44:   // The chat server always uses OpenMU's default Xor32 key, whatever game
 45:   // version the login went through.
 46:   const xor32 = new Xor32Encryptor();
 47:   const splitter = new ChatFrameSplitter();
 48: 
 49:   let opened = false;
 50:   let finished = false;
 51:   let keepAlive: ReturnType<typeof setInterval> | null = null;
 52: 
 53:   const socket = new WebSocket(`${wsAddress()}?host=${host}&port=${port}`);
 54:   socket.binaryType = 'arraybuffer';
 55: 
 56:   function send(frame: Uint8Array): void {
 57:     if (socket.readyState === WebSocket.OPEN) socket.send(xor32.Encrypt(frame));
 58:   }
 59: 
 60:   function finish(deliberate: boolean): void {
 61:     if (finished) return;
 62:     finished = true;
 63:     if (keepAlive !== null) clearInterval(keepAlive);
 64:     keepAlive = null;
 65:     if (!deliberate) options.onClose(opened);
 66:   }
 67: 
 68:   socket.addEventListener('open', () => {
 69:     opened = true;
 70:     send(encodeAuthenticate(roomId, token));
 71:     keepAlive = setInterval(() => send(encodeKeepAlive()), KEEP_ALIVE_MS);
 72:   });
 73: 
 74:   socket.addEventListener('message', event => {
 75:     if (finished) return;
 76:     for (const frame of splitter.push(new Uint8Array(event.data as ArrayBuffer))) {
 77:       const decoded = decodeChatServerFrame(frame);
 78:       if (decoded) options.onEvent(decoded);
 79:     }
 80:   });
 81: 
 82:   // The proxy closes the ws when its TCP connect fails, so a bad chat server
 83:   // address lands here too.
 84:   socket.addEventListener('close', () => finish(false));
 85:   socket.addEventListener('error', () => finish(false));
 86: 
 87:   return {
 88:     get isOpen() {
 89:       return opened && !finished && socket.readyState === WebSocket.OPEN;
 90:     },
 91:     sendMessage(text: string) {
 92:       // The original always sends index 0; the server stamps the real one.
 93:       send(encodeChatMessage(0, text));
 94:     },
 95:     leave() {
 96:       send(encodeLeave());
 97:       finish(true);
 98:       socket.close();
 99:     },
100:   };
101: }
</file>

