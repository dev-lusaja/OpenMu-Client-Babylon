431:    */
432:   static setBackgrounded(backgrounded: boolean) {
433:     if (this.backgrounded === backgrounded) return;
434:     this.backgrounded = backgrounded;
435: 
436:     fadeFrom = backgroundMix;
437:     fadeStart = performance.now();
438:     if (fading) return;
439: 
440:     fading = true;
441:     stepBackgroundFade();
442:   }
443: 
444:   static stopAllMusic() {
445:     this.fadeOutMusic();
446:   }
447: }
