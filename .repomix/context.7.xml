450:   function GetTerrainTile(x: number, y: number) {
451:     if (x < 0 || y < 0 || x >= TERRAIN_SIZE || y >= TERRAIN_SIZE) return 0;
452: 
453:     const xi = ~~x;
454:     const yi = ~~y;
455: 
456:     return terrainMapping.layer1[GetTerrainIndex(xi, yi)];
457:   }
