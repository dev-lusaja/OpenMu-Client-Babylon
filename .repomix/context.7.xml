  1: import {
  2:   Mesh,
  3:   ShaderMaterial,
  4:   ShaderStore,
  5:   type Scene,
  6: } from '../libs/babylon/exports';
  7: import { CreateSphereVertexData } from '@babylonjs/core/Meshes/Builders/sphereBuilder';
  8: import { linearBufferActive } from '../common/lightModel';
  9: import { devQueryNumber } from '../common/devSeams';
 10: import { lookDirector, type LookDirector, type LookState } from './director';
 11: import {
 12:   bindClouds,
 13:   cloudFieldGlsl,
 14:   CLOUD_NOISE_SAMPLER,
 15:   CLOUD_UNIFORMS,
 16: } from './clouds';
 17: import {
 18:   profileFor,
 19:   toLinear,
 20:   SKY_CLOUDS_DEFAULT,
 21:   SKY_CURVE_DEFAULT,
 22:   SKY_HALO_DEFAULT,
 23:   SKY_SUN_DEFAULT,
 24:   type Rgb,
