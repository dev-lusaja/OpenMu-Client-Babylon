1157:   function buildBlock(key: number): void {
1158:     const bx = (key % BLOCKS_PER_SIDE) * BLOCK_TILES;
1159:     const bz = Math.floor(key / BLOCKS_PER_SIDE) * BLOCK_TILES;
1160: 
1161:     const roots: number[] = [];
1162:     const tints: number[] = [];
1163:     const bake: [number, number, number] = [0, 0, 0];
1164:     const tile = { weight: 0, slot: 0 };
1165: 
1166:     let minY = Infinity;
1167:     let maxY = -Infinity;
1168: 
1169:     for (let z = bz; z < bz + BLOCK_TILES; z++) {
1170:       for (let x = bx; x < bx + BLOCK_TILES; x++) {
1171:         // The last row and column have no far corner to interpolate to.
1172:         if (x >= TERRAIN_SIZE - 1 || z >= TERRAIN_SIZE - 1) continue;
1173: 
1174:         grassAt(x, z, tile);
1175: 
1176:         if (tile.weight <= 0) continue;
1177: 
1178:         const slot = tile.slot;
1179:         const count = Math.round(tile.weight * perTile);
1180: 
1181:         bakeAt(x, z, bake);
1182: 
1183:         for (let b = 0; b < count; b++) {
1184:           const hx = hash01(x, z, b * 3);
1185:           const hz = hash01(x, z, b * 3 + 1);
1186:           const hh = hash01(x, z, b * 3 + 2);
1187: 
1188:           // Grass grows in tufts, not on a Poisson disc. Each blade joins one
1189:           // of a few clumps in the tile and jitters around its centre, which
1190:           // is most of the difference between a field and a lawn.
1191:           const clump = b % CLUMPS_PER_TILE;
1192:           const cx = hash01(x, z, 901 + clump * 2);
1193:           const cz = hash01(x, z, 902 + clump * 2);
1194: 
1195:           const fx = x + clamp01(cx + (hx - 0.5) * CLUMP_SPREAD);
1196:           const fz = z + clamp01(cz + (hz - 0.5) * CLUMP_SPREAD);
1197:           const y = heightAt(fx, fz);
1198:           const height = BLADE_MIN_H + hh * (BLADE_MAX_H - BLADE_MIN_H);
1199: 
1200:           // The slot rides in the integer part and the hash in the fraction:
1201:           // one attribute carries which tile texture tints the blade and
1202:           // every per-blade random the vertex shader needs.
1203:           roots.push(fx, y, fz, slot + Math.min(hh, 0.999999));
1204:           tints.push(bake[0], bake[1], bake[2], height);
