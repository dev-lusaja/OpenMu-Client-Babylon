459:   /**
460:    * Both mapping layers and their blend, as the ground mesh draws them
461:    * (`customGroundMesh.addTile`): a tile whose alpha is full everywhere is
462:    * drawn as layer 2 alone, otherwise layer 2 is mixed over layer 1 by the
463:    * per-vertex alpha. The tile's own corner alpha stands in for the mesh's
464:    * interpolation here.
465:    */
466:   function GetTerrainLayers(x: number, y: number, out: TerrainLayers) {
467:     if (x < 0 || y < 0 || x >= TERRAIN_SIZE || y >= TERRAIN_SIZE) {
468:       out.layer1 = 0;
469:       out.layer2 = 255;
470:       out.alpha = 0;
471:       return;
472:     }
473: 
474:     const i = GetTerrainIndex(~~x, ~~y);
475:     const layer2 = terrainMapping.layer2[i];
476: 
477:     out.layer1 = terrainMapping.layer1[i];
478:     out.layer2 = layer2;
479:     out.alpha = layer2 === 255 ? 0 : terrainMapping.alpha[i] / 255;
480:   }
481: 
482:   initTerrainDynamicLight(
483:     packBakedTerrainLight(terrainLight, TERRAIN_AMBIENT)
484:   );
485: 
486:   const lightScratch = new Vector3();
487: 
488:   function RequestTerrainLight(x: number, y: number): IVector3Like {
489:     if (x < 0 || y < 0 || x >= TERRAIN_SIZE || y >= TERRAIN_SIZE) {
490:       return Vector3.OneReadOnly;
491:     }
492: 
493:     // Classic: PrimaryTerrainLight (bake + delta), the original's BodyLight.
494:     // Tiers >= 1: the bake alone - the pool lights reach the figure per pixel.
495:     const lit = lightingTier()
496:       ? requestBakedTerrainLight(x, y, lightScratch)
497:       : requestTerrainLight(x, y, lightScratch);
498: 
499:     if (lit) return lightScratch;
500: 
501:     const light = terrainLight[GetTerrainIndex(~~x, ~~y)];
502: 
503:     if (!light) return Vector3.OneReadOnly;
504: 
505:     return lightScratch.set(
506:       TERRAIN_AMBIENT + light.x * (1 - TERRAIN_AMBIENT),
507:       TERRAIN_AMBIENT + light.y * (1 - TERRAIN_AMBIENT),
508:       TERRAIN_AMBIENT + light.z * (1 - TERRAIN_AMBIENT)
509:     );
510:   }
511: 
512:   return {
513:     objects,
514:     terrain,
515:     terrainHeight,
516:     RequestTerrainHeight,
517:     IsWalkable,
518:     RequestTerrainFlag,
519:     SetTerrainFlags,
520:     GetTerrainTile,
521:     GetTerrainLayers,
522:     RequestTerrainLight,
523:   };
524: }
</file>

