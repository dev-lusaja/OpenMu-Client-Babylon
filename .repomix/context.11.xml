<file path="src/ui/pages/loginPage/style.less">
  1: @import (reference) '../../components/muText/style.less';
  2: .login-page {
  3:   position: absolute;
  4:   inset: 0;
  5: 
  6:   // `UIMng.cpp:226` places the window at
  7:   //   x = (screenWidth  - 329) / 2
  8:   //   y = (screenHeight - 245) * 2 / 3
  9:   // i.e. horizontally centred and two thirds of the way down, which is where
 10:   // MU actually puts it - not dead centre.
 11:   .login-win {
 12:     position: absolute;
 13:     left: 50%;
 14:     top: calc((100% - 245px) * 2 / 3);
 15:     transform: translateX(-50%);
 16: 
 17:     // MU's UI is authored at fixed pixel sizes; the window must be positioned,
 18:     // never stretched or reflowed.
 19:     flex: none;
 20: 
 21:     .mu-font();
 22:     user-select: none;
 23:   }
 24: 
 25:   form {
 26:     position: absolute;
 27:     inset: 0;
 28:     pointer-events: none;
 29:   }
 30: 
 31:   .login-label {
 32:     position: absolute;
 33:     color: #ffffff;
 34:     font-size: 11px;
 35:     line-height: 1;
 36:     text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
 37:     white-space: nowrap;
 38:   }
 39: 
 40:   // `RenderText(baseX + 111, baseY + 80, szServerName)` in `g_hFixFont`.
 41:   .login-server-line {
 42:     position: absolute;
 43:     text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
 44:   }
 45: 
 46:   .login-remember {
 47:     pointer-events: auto;
 48:     cursor: pointer;
 49:   }
 50: 
 51:   // Same type as the labels around it; the colour is what marks it clickable,
 52:   // since MU has no underlined link anywhere in its interface.
 53:   .login-register {
 54:     position: absolute;
 55:     pointer-events: auto;
 56:     cursor: pointer;
 57:     color: #b3b3b3;
 58:     font-size: 11px;
 59:     line-height: 1;
 60:     text-decoration: none;
 61:     text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
 62:     white-space: nowrap;
 63: 
 64:     &:hover {
 65:       color: #ffffff;
 66:     }
 67:   }
 68: 
 69:   // The box art is the input's background, so the field itself is invisible
 70:   // chrome sitting exactly on top of it.
 71:   .login-input {
 72:     position: absolute;
 73:     inset: 0;
 74:     width: 100%;
 75:     height: 100%;
 76:     box-sizing: border-box;
 77:     pointer-events: auto;
 78: 
 79:     background: transparent;
 80:     border: none;
 81:     outline: none;
 82: 
 83:     color: #ffffff;
 84:     font-family: inherit;
 85:     font-size: 12px;
 86:     line-height: 1;
 87:   }
 88: 
 89:   .login-submit {
 90:     position: absolute;
 91:     width: 0;
 92:     height: 0;
 93:     padding: 0;
 94:     border: none;
 95:     opacity: 0;
 96:   }
 97: 
 98:   .login-error,
 99:   .login-notice,
100:   .login-signup-message {
101:     position: absolute;
102:     left: 0;
103:     right: 0;
104:     top: 205px;
105:     margin: 0;
106:     text-align: center;
107:     font-size: 11px;
108:     text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
109:   }
110: 
111:   .login-error {
112:     color: #ff5a5a;
113:   }
114: 
115:   // `g_pRenderText->SetBgColor`: MU paints a box behind text that would
116:   // otherwise land on the frame's art, and the band under the buttons is
117:   // dragons. Shrink-wrapped to the line, so the box is the text's and not
118:   // the window's.
119:   .login-notice,
120:   .login-signup-message {
121:     width: fit-content;
122:     max-width: 290px;
123:     margin: 0 auto;
124:     padding: 1px 6px;
125:     background: rgba(0, 0, 0, 0.65);
126:     line-height: 1.3;
127:   }
128: 
129:   // "Account created" - the one thing this screen says that is good news.
130:   .login-notice {
131:     color: #7dff7d;
132:   }
133: 
134:   // The register window has a row where the login one has its checkbox, so
135:   // its message goes above the buttons instead of across them.
136:   .login-signup-message {
137:     top: 162px;
138:     color: #ff5a5a;
139:   }
140: 
141:   .login-signup-title {
142:     left: 0;
143:     right: 0;
144:     text-align: center;
145:   }
146: }
