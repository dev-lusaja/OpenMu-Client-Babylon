<file path="src/ui/pages/preloaderPage/accountTab.tsx">
  1: import { uiClick } from '../../../libs/sfx';
  2: import { observer } from 'mobx-react-lite';
  3: import { MuSpriteFrame } from '../../components/muSprite';
  4: import { MuButton } from '../../components/muButton';
  5: import { MuText } from '../../components/muText';
  6: import { TEXT_COLOR } from '../serversPage/layout';
  7: import { t } from '../../../i18n';
  8: import { MAX_PASSWORD_LENGTH, MAX_USERNAME_LENGTH } from '../../../consts';
  9: import { ServerConfig, type ServerProfile } from '../../../common/serverConfig';
 10: import { ServerAccounts } from '../../../common/serverAccounts';
 11: import { Field } from './frame';
 12: import {
 13:   ACCOUNT_ROWS,
 14:   ADD_X,
 15:   BTN_HEIGHT,
 16:   BTN_WIDTH,
 17:   CHECK_SIZE,
 18:   CONTENT_TOP,
 19:   DELETE_X,
 20:   FIELD_STEP,
 21:   FIELD_TOP,
 22:   FIELD_X,
 23:   LIST_ROW_HEIGHT,
 24:   LIST_ROW_WIDTH,
 25:   LIST_X,
 26:   SPRITE,
 27:   accountMetrics,
 28: } from './layout';
 29: 
 30: /**
 31:  * The accounts this player uses on the chosen world, saved against that world.
 32:  *
 33:  * One client plays every world, so one saved login was always wrong: the name
 34:  * that works on one server means nothing on another, and the pre-rework client
 35:  * handed whatever it had to whichever world was entered next. And one per world
 36:  * is the same mistake a size smaller - a main and a mule on the same server is
 37:  * ordinary, so this is a list. The row in gold is the one the login window will
 38:  * be holding when Enter opens it.
 39:  *
 40:  * The note at the bottom is not decoration. These fields go to this browser's
 41:  * localStorage in plain text, which is what the client has always done with the
 42:  * one account it kept - saying so is the only honest way to offer the box.
 43:  */
 44: 
 45: export const AccountTab = observer(({ world }: { world: ServerProfile }) => {
 46:   const metrics = accountMetrics();
 47:   const rows = ServerAccounts.list(world.id);
 48:   const account = ServerAccounts.of(world.id);
 49:   const activeId = ServerAccounts.activeId(world.id);
 50: 
 51:   // Nothing to save against: the URL profile is gone next launch, and the
 52:   // placeholder world is not a world at all.
 53:   const readOnly = ServerConfig.lockedByUrl || ServerConfig.isEmpty;
 54:   // A world with no account yet has empty fields and nothing to type into:
 55:   // Add is the way in, exactly as it is on the setup tab.
 56:   const editable = !readOnly && !!account.id;
 57: 
 58:   const set = (patch: Parameters<typeof ServerAccounts.update>[2]) =>
 59:     ServerAccounts.update(world.id, account.id, patch);
 60: 
 61:   const toggleRemember = () => {
 62:     if (editable) set({ remember: !account.remember });
 63:   };
 64: 
 65:   return (
 66:     <>
 67:       <span className="setup-label" style={{ left: LIST_X, top: CONTENT_TOP }}>
 68:         {t('account.list', {
 69:           world: world.name.trim() || t('server.unnamed'),
 70:         })}
 71:       </span>
 72: 
 73:       {/* The empty slots are drawn as well, so the column reads as a list
 74:           rather than a button or two floating over stone. */}
 75:       {Array.from({ length: ACCOUNT_ROWS }, (_, i) => (
 76:         <MuSpriteFrame
 77:           key={`slot-${i}`}
 78:           file={SPRITE.menuButton}
 79:           width={LIST_ROW_WIDTH}
 80:           height={LIST_ROW_HEIGHT}
 81:           style={{
 82:             position: 'absolute',
 83:             left: LIST_X,
 84:             top: metrics.listTop + LIST_ROW_HEIGHT * i,
 85:             opacity: 0.45,
 86:           }}
 87:         />
 88:       ))}
 89: 
 90:       {rows.slice(0, ACCOUNT_ROWS).map((row, i) => (
 91:         <MuButton
 92:           key={row.id}
 93:           file={SPRITE.menuButton}
 94:           width={LIST_ROW_WIDTH}
 95:           height={LIST_ROW_HEIGHT}
 96:           frames={{ up: 0, active: 1, down: 2 }}
 97:           color={
 98:             row.id === activeId ? TEXT_COLOR.brightYellow : TEXT_COLOR.brightGray
 99:           }
100:           activeColor={TEXT_COLOR.white}
101:           label={row.username || t('account.unnamed')}
102:           onClick={() => ServerAccounts.select(world.id, row.id)}
103:           style={{
104:             position: 'absolute',
105:             left: LIST_X,
106:             top: metrics.listTop + LIST_ROW_HEIGHT * i,
107:           }}
108:           labelStyle={{ fontSize: 11 }}
109:         >
110:           {/* No password kept on this row: the name is remembered and the
111:               secret is typed each time, which is what the box below means. */}
112:           {!row.remember && (
113:             <span className="setup-row-tag">{t('account.notKept')}</span>
114:           )}
115:         </MuButton>
116:       ))}
117: 
118:       <MuButton
119:         file={SPRITE.button}
120:         width={BTN_WIDTH}
121:         height={BTN_HEIGHT}
122:         frames={{ up: 0, active: 1, down: 2 }}
123:         color={TEXT_COLOR.brightGray}
124:         activeColor={TEXT_COLOR.white}
125:         label={t('server.add')}
126:         disabled={readOnly || !ServerAccounts.canAdd(world.id)}
127:         onClick={() => ServerAccounts.add(world.id)}
128:         style={{ position: 'absolute', left: ADD_X, top: metrics.buttonsY }}
129:         labelStyle={{ fontSize: 11 }}
130:       />
131:       <MuButton
132:         file={SPRITE.button}
133:         width={BTN_WIDTH}
134:         height={BTN_HEIGHT}
135:         frames={{ up: 0, active: 1, down: 2 }}
136:         color={TEXT_COLOR.brightGray}
137:         activeColor={TEXT_COLOR.white}
138:         label={t('server.delete')}
139:         disabled={!editable}
140:         onClick={() => ServerAccounts.forget(world.id, account.id)}
141:         style={{ position: 'absolute', left: DELETE_X, top: metrics.buttonsY }}
142:         labelStyle={{ fontSize: 11 }}
143:       />
144: 
145:       <Field
146:         label={t('login.id')}
147:         value={account.username}
148:         top={FIELD_TOP}
149:         disabled={!editable}
150:         maxLength={MAX_USERNAME_LENGTH}
151:         placeholder={editable ? '' : t('account.addFirst')}
152:         onChange={username => set({ username })}
153:       />
154:       <Field
155:         label={t('login.password')}
156:         value={account.password}
157:         top={FIELD_TOP + FIELD_STEP}
158:         disabled={!editable || !account.remember}
159:         password
160:         maxLength={MAX_PASSWORD_LENGTH}
161:         onChange={password => set({ password })}
162:       />
163: 
164:       {/* A row exists because the player put it there, so this is about the
165:           secret rather than the row: off keeps the name and forgets the
166:           password. Delete is how a row goes away. */}
167:       <MuSpriteFrame
168:         file={SPRITE.check}
169:         y={account.remember ? CHECK_SIZE : 0}
170:         width={CHECK_SIZE}
171:         height={CHECK_SIZE}
172:         style={{
173:           position: 'absolute',
174:           left: FIELD_X,
175:           top: metrics.checkY,
176:           cursor: editable ? 'pointer' : 'default',
177:           pointerEvents: editable ? 'auto' : 'none',
178:           opacity: editable ? 1 : 0.5,
179:         }}
180:         onClick={uiClick(toggleRemember)}
181:       />
182:       <span
183:         className="setup-label setup-check-label"
184:         style={{
185:           left: FIELD_X + CHECK_SIZE + 6,
186:           top: metrics.checkY + 2,
187:           color: editable ? undefined : '#a0a0a0',
188:         }}
189:         onClick={uiClick(toggleRemember)}
190:       >
191:         {t('account.keepPassword')}
192:       </span>
193: 
194:       <MuText
195:         className="setup-line"
196:         color={TEXT_COLOR.brightGray}
197:         style={{ top: metrics.noteY }}
198:         text={readOnly ? t('account.cannotSave') : t('account.storedLocally')}
199:       />
200:       <MuText
201:         className="setup-line"
202:         color={TEXT_COLOR.yellow}
203:         style={{ top: metrics.noteY + 13 }}
204:         text={
205:           rows.length
206:             ? t('account.entersAs', {
207:                 name: account.username || t('account.unnamed'),
208:               })
209:             : t('account.needSignup')
210:         }
211:       />
212:     </>
213:   );
214: });
</file>

<file path="src/ui/pages/preloaderPage/frame.tsx">
  1: import type { CSSProperties, ReactNode } from 'react';
  2: import { MuSpriteFrame } from '../../components/muSprite';
  3: import {
  4:   BOTTOM_PLAIN_END,
  5:   FIELD_HEIGHT,
  6:   FIELD_LABEL_H,
  7:   FIELD_WIDTH,
  8:   FIELD_X,
  9:   SETUP_ART_WIDTH,
 10:   SETUP_BOTTOM_HEIGHT,
 11:   SETUP_TOP_HEIGHT,
 12:   SETUP_WIN_WIDTH,
 13:   SPRITE,
 14: } from './layout';
 15: 
 16: /**
 17:  * The Option window's frame at whatever height it is asked for, and the sunken
 18:  * plate MU puts under a text field. Both used to be copied into each screen
 19:  * that wanted them; they are here so the server window's tabs share one frame
 20:  * rather than each drawing their own slightly different one.
 21:  */
 22: 
 23: /**
 24:  * One band of the frame: the art, and the same art mirrored beside it.
 25:  *
 26:  * Given a `plainEnd`, the band is closed across the middle instead. The mirror
 27:  * puts the figure at the art's inner end against its own reflection, which
 28:  * reads as a join in the frame rather than as decoration - so each half stops
 29:  * where the art is still a plain edge and a slice of that edge bridges what is
 30:  * left, cut from the columns just inside the figure. What closes the band is
 31:  * the band.
 32:  */
 33: const Band = ({
 34:   file,
 35:   height,
 36:   plainEnd = SETUP_ART_WIDTH,
 37:   edge,
 38: }: {
 39:   file: string;
 40:   height: number;
 41:   plainEnd?: number;
 42:   /** Which way up this band hangs. */
 43:   edge: 'top' | 'bottom';
 44: }) => {
 45:   const bridge = SETUP_WIN_WIDTH - plainEnd * 2;
 46: 
 47:   return (
 48:     <>
 49:       {[false, true].map(mirrored => (
 50:         <MuSpriteFrame
 51:           key={`${edge}-${mirrored}`}
 52:           file={file}
 53:           width={plainEnd}
 54:           height={height}
 55:           style={{
 56:             position: 'absolute',
 57:             left: mirrored ? SETUP_WIN_WIDTH - plainEnd : 0,
 58:             [edge]: 0,
 59:             ...(mirrored && { transform: 'scaleX(-1)' }),
 60:           }}
 61:         />
 62:       ))}
 63:       {bridge > 0 && (
 64:         <MuSpriteFrame
 65:           file={file}
 66:           x={plainEnd - bridge}
 67:           width={bridge}
 68:           height={height}
 69:           style={{ position: 'absolute', left: plainEnd, [edge]: 0 }}
 70:         />
 71:       )}
 72:     </>
 73:   );
 74: };
 75: 
 76: /** Stone fill, side rails, and the top and bottom bands. */
 77: export const SetupFrame = ({ height }: { height: number }) => (
 78:   <>
 79:     <MuSpriteFrame
 80:       file={SPRITE.optionFill}
 81:       width={SETUP_WIN_WIDTH - 6}
 82:       height={height - 6}
 83:       style={{
 84:         position: 'absolute',
 85:         left: 3,
 86:         top: 3,
 87:         backgroundRepeat: 'repeat',
 88:       }}
 89:     />
 90:     <MuSpriteFrame
 91:       file={SPRITE.optionRailLeft}
 92:       width={5}
 93:       height={height - SETUP_TOP_HEIGHT - SETUP_BOTTOM_HEIGHT}
 94:       style={{
 95:         position: 'absolute',
 96:         left: 0,
 97:         top: SETUP_TOP_HEIGHT,
 98:         backgroundRepeat: 'repeat-y',
 99:       }}
100:     />
101:     <MuSpriteFrame
102:       file={SPRITE.optionRailRight}
103:       width={5}
104:       height={height - SETUP_TOP_HEIGHT - SETUP_BOTTOM_HEIGHT}
105:       style={{
106:         position: 'absolute',
107:         right: 0,
108:         top: SETUP_TOP_HEIGHT,
109:         backgroundRepeat: 'repeat-y',
110:       }}
111:     />
112:     <Band file={SPRITE.optionTop} height={SETUP_TOP_HEIGHT} edge="top" />
113:     <Band
114:       file={SPRITE.optionBottom}
115:       height={SETUP_BOTTOM_HEIGHT}
116:       plainEnd={BOTTOM_PLAIN_END}
117:       edge="bottom"
118:     />
119:   </>
120: );
121: 
122: /** The plate on its own, for a field that writes its own label (or none). */
123: export const Plate = ({
124:   width,
125:   height = FIELD_HEIGHT,
126:   left,
127:   top,
128:   children,
129:   style,
130: }: {
131:   width: number;
132:   height?: number;
133:   left: number;
134:   top: number;
135:   children?: ReactNode;
136:   style?: CSSProperties;
137: }) => (
138:   <MuSpriteFrame
139:     file={SPRITE.input}
140:     width={width}
141:     height={height}
142:     style={{
143:       position: 'absolute',
144:       left,
145:       top,
146:       // The plate art is 156×23; stretching rather than cropping is what lets
147:       // one piece of art back a 300px search box and a 70px port field alike.
148:       backgroundSize: '100% 100%',
149:       ...style,
150:     }}
151:   >
152:     {children}
153:   </MuSpriteFrame>
154: );
155: 
156: export type FieldProps = {
157:   label: string;
158:   value: string;
159:   width?: number;
160:   top: number;
161:   left?: number;
162:   disabled?: boolean;
163:   numeric?: boolean;
164:   password?: boolean;
165:   maxLength?: number;
166:   placeholder?: string;
167:   onChange: (value: string) => void;
168: };
169: 
170: /** A labelled field: the label, then the plate, then the input on top of it. */
171: export const Field = ({
172:   label,
173:   value,
174:   width = FIELD_WIDTH,
175:   top,
176:   left = FIELD_X,
177:   disabled,
178:   numeric,
179:   password,
180:   maxLength,
181:   placeholder,
182:   onChange,
183: }: FieldProps) => (
184:   <>
185:     <span className="setup-label" style={{ left, top }}>
186:       {label}
187:     </span>
188:     <Plate width={width} left={left} top={top + FIELD_LABEL_H}>
189:       <input
190:         className="setup-input"
191:         type={password ? 'password' : numeric ? 'number' : 'text'}
192:         value={value}
193:         placeholder={placeholder}
194:         disabled={disabled}
195:         maxLength={maxLength}
196:         onChange={e => onChange(e.target.value)}
197:       />
198:     </Plate>
199:   </>
200: );
</file>

<file path="src/ui/pages/preloaderPage/index.tsx">
  1: import './style.less';
  2: import { useState } from 'react';
  3: import { observer } from 'mobx-react-lite';
  4: import { Store } from '../../../store';
  5: import { ENUM_WORLD } from '../../../common';
  6: import { displayAddress, ServerConfig } from '../../../common/serverConfig';
  7: import { ServerList } from '../../../common/serverList';
  8: import { useEventBus } from '../../../hooks/useEventBus';
  9: import { MuSpriteFrame } from '../../components/muSprite';
 10: import { MuButton } from '../../components/muButton';
 11: import { MuText } from '../../components/muText';
 12: import { MuLogo } from '../../components/muLogo';
 13: import { LoadingArt, useSheetSizes } from '../../components/loadingScreen/art';
 14: import { TEXT_COLOR } from '../serversPage/layout';
 15: import { t } from '../../../i18n';
 16: import { ServerWindow } from './serverWindow';
 17: import {
 18:   MENU_BTN_HEIGHT,
 19:   MENU_BTN_STEP,
 20:   MENU_BTN_WIDTH,
 21:   MENU_BTN_X,
 22:   MENU_ENDPOINT_LINE_Y,
 23:   MENU_SERVER_LINE_Y,
 24:   MENU_WIN_HEIGHT,
 25:   MENU_WIN_WIDTH,
 26:   menuButtonsTop,
 27:   SPRITE,
 28: } from './layout';
 29: 
 30: /** The menu, or the tabbed server window Worlds opens. */
 31: type View = 'menu' | 'worlds';
 32: 
 33: /**
 34:  * The start menu: MU's login window frame over the login scene the original
 35:  * opens on (`WD_73NEW_LOGIN_SCENE` - `loginSceneSystem` warps to it for this
 36:  * state too, so the camera is already touring the map behind this window).
 37:  *
 38:  * The scene needs a moment to load, and a black screen is not what MU shows
 39:  * while a map loads - its loading artwork is. So that art is the backdrop
 40:  * until the warp completes, then it fades off the camera tour.
 41:  */
 42: export const PreloaderPage = observer(() => {
 43:   const [view, setView] = useState<View>('menu');
 44:   const [sceneReady, setSceneReady] = useState(false);
 45:   const { contain, cover } = useSheetSizes();
 46: 
 47:   useEventBus('warpCompleted', () => {
 48:     if (Store.world?.mapIndex === ENUM_WORLD.WD_73NEW_LOGIN_SCENE) {
 49:       setSceneReady(true);
 50:     }
 51:   });
 52: 
 53:   const profile = ServerConfig.active;
 54: 
 55:   // Nothing is drawn before the interface sprites are decoded: every frame of
 56:   // this page is a piece of MU art, and unstyled text over the map is not a
 57:   // loading state anyone would recognise. Black, then the artwork, then the
 58:   // scene - the order the original boots in.
 59:   const artReady = !Store.spritesLoading;
 60:   const backGone = artReady && sceneReady;
 61: 
 62:   // Two entries. Picking a world and entering it is one act, so both live on
 63:   // the Worlds screen - which is also where a server the published list does
 64:   // not carry gets typed in - and the menu keeps only the two ways in.
 65:   const buttons = [
 66:     { key: 'worlds', label: t('preloader.worlds'), onClick: () => setView('worlds') },
 67:     { key: 'offline', label: t('preloader.playOffline'), onClick: () => Store.playOffline() },
 68:   ];
 69:   const buttonsTop = menuButtonsTop(buttons.length);
 70: 
 71:   return (
 72:     <div className="preloader-page">
 73:       {/* The loading artwork, fading out once the 3D scene behind is up. */}
 74:       <div className={`preloader-back${backGone ? ' preloader-back-gone' : ''}`}>
 75:         {artReady && (
 76:           <>
 77:             <LoadingArt size={cover} className="loading-art loading-art-blur" />
 78:             <LoadingArt size={contain} className="loading-art" />
 79:           </>
 80:         )}
 81:       </div>
 82: 
 83:       {!artReady ? null : view === 'worlds' ? (
 84:         <ServerWindow
 85:           onPlay={() => Store.playOnline()}
 86:           onClose={() => setView('menu')}
 87:         />
 88:       ) : (
 89:         <>
 90:           <MuLogo />
 91: 
 92:           <MuSpriteFrame
 93:             file={SPRITE.menuWindow}
 94:             width={MENU_WIN_WIDTH}
 95:             height={MENU_WIN_HEIGHT}
 96:             className="preloader-win"
 97:           >
 98:             {buttons.map((button, i) => (
 99:               <MuButton
100:                 key={button.key}
101:                 file={SPRITE.menuButton}
102:                 width={MENU_BTN_WIDTH}
103:                 height={MENU_BTN_HEIGHT}
104:                 frames={{ up: 0, active: 1, down: 2 }}
105:                 color={TEXT_COLOR.brightGray}
106:                 activeColor={TEXT_COLOR.white}
107:                 label={button.label}
108:                 onClick={button.onClick}
109:                 style={{
110:                   position: 'absolute',
111:                   left: MENU_BTN_X,
112:                   top: buttonsTop + MENU_BTN_STEP * i,
113:                 }}
114:                 labelStyle={{ fontSize: 12 }}
115:               />
116:             ))}
117: 
118:             {/* Which server the next click connects to, and where that is -
119:                 or, with nothing to name yet, what the list is doing. */}
120:             {ServerConfig.isEmpty ? (
121:               <MuText
122:                 className="preloader-line"
123:                 color={TEXT_COLOR.brightGray}
124:                 style={{ top: MENU_SERVER_LINE_Y }}
125:                 text={
126:                   ServerList.state === 'error'
127:                     ? t('server.listOffline')
128:                     : ServerList.state === 'ok'
129:                       ? t('worlds.empty')
130:                       : t('servers.loading')
131:                 }
132:               />
133:             ) : (
134:               <>
135:                 <MuText
136:                   face="fix"
137:                   className="preloader-line"
138:                   color={TEXT_COLOR.brightYellow}
139:                   style={{ top: MENU_SERVER_LINE_Y }}
140:                   text={profile.name.trim() || t('server.unnamed')}
141:                 />
142:                 <MuText
143:                   className="preloader-line"
144:                   color={TEXT_COLOR.brightGray}
145:                   style={{ top: MENU_ENDPOINT_LINE_Y }}
146:                   text={displayAddress(profile)}
147:                 />
148:               </>
149:             )}
150:           </MuSpriteFrame>
151:         </>
152:       )}
153:     </div>
154:   );
155: });
</file>

<file path="src/ui/pages/preloaderPage/infoTab.tsx">
  1: import { observer } from 'mobx-react-lite';
  2: import { MuText } from '../../components/muText';
  3: import { TEXT_COLOR } from '../serversPage/layout';
  4: import { t } from '../../../i18n';
  5: import {
  6:   displayAddress,
  7:   effective,
  8:   playableHere,
  9:   ServerConfig,
 10:   type ServerProfile,
 11: } from '../../../common/serverConfig';
 12: import { ServerAccounts } from '../../../common/serverAccounts';
 13: import { ServerProbe } from '../../../common/serverProbe';
 14: import { versionTags } from '../../../version';
 15: import { CardArt, CardStone, REACH_TEXT } from './worldsTab';
 16: import {
 17:   CONTENT_WIDTH,
 18:   CONTENT_X,
 19:   INFO_ART_HEIGHT,
 20:   INFO_ART_WIDTH,
 21:   INFO_FACTS_X,
 22:   INFO_FACT_STEP,
 23:   INFO_SERVER_ROWS,
 24:   INFO_SERVER_STEP,
 25:   infoMetrics,
 26: } from './layout';
 27: 
 28: /**
 29:  * What the chosen world says about itself, before a single packet is sent.
 30:  *
 31:  * The published list carries more than a card has room for - the world's own
 32:  * blurb, the client it wants, the domain everything else about it hangs off,
 33:  * and the names it gave its game servers and their channels. That last part
 34:  * exists nowhere else: the connect server's `ServerListResponse` is ids and
 35:  * load percentages with no text in it at all, so without this tab a player
 36:  * cannot know what they are about to pick until they are already connected.
 37:  *
 38:  * The account line is here for the same reason. One client plays every world,
 39:  * so "do I have a character over there" is a question about this world and not
 40:  * about the client, and it is the question that decides whether Enter leads to
 41:  * a login or to a signup.
 42:  */
 43: 
 44: const FACT_WIDTH = CONTENT_WIDTH - INFO_ART_WIDTH - 4;
 45: 
 46: const Fact = ({
 47:   label,
 48:   value,
 49:   top,
 50:   color = TEXT_COLOR.brightGray,
 51:   face,
 52: }: {
 53:   label?: string;
 54:   value: string;
 55:   top: number;
 56:   color?: string;
 57:   face?: 'fix';
 58: }) => (
 59:   // The column is 193 wide and a proxy URL is not, so the value is clipped and
 60:   // the whole of it hangs off the row as a tooltip.
 61:   <div
 62:     className="info-fact"
 63:     style={{ left: INFO_FACTS_X, top, width: FACT_WIDTH }}
 64:     title={label ? `${label}: ${value}` : value}
 65:   >
 66:     {label && <span className="info-fact-label">{label}</span>}
 67:     <MuText face={face} color={color} className="info-fact-value" text={value} />
 68:   </div>
 69: );
 70: 
 71: /** `Valhalla - Peaceful, Hard`, or the numbered default for an unnamed group. */
 72: function serverLine(server: { id: number; name: string; channels: { name: string }[] }) {
 73:   const name = server.name || t('servers.serverName', { number: server.id });
 74:   const channels = server.channels.map(c => c.name).join(', ');
 75: 
 76:   return channels ? `${name} - ${channels}` : name;
 77: }
 78: 
 79: export const InfoTab = observer(({ world }: { world: ServerProfile }) => {
 80:   const metrics = infoMetrics();
 81:   const live = effective(world);
 82:   const account = ServerAccounts.of(world.id);
 83:   const reach = ServerProbe.of(world.id);
 84:   const playable = playableHere(world);
 85:   const servers = world.servers ?? [];
 86:   // The overflow line costs a row of its own, so it only ever replaces the
 87:   // last world that would have fitted rather than being squeezed in after it.
 88:   const shown =
 89:     servers.length > INFO_SERVER_ROWS
 90:       ? servers.slice(0, INFO_SERVER_ROWS - 1)
 91:       : servers;
 92:   const hidden = servers.length - shown.length;
 93: 
 94:   const facts: { label?: string; value: string; color?: string; face?: 'fix' }[] = [
 95:     {
 96:       value: world.name.trim() || t('server.unnamed'),
 97:       color: TEXT_COLOR.brightYellow,
 98:     },
 99:     {
100:       label: t('info.client'),
101:       value: playable
102:         ? world.version || t('info.anyClient')
103:         : t('worlds.needsClient', {
104:             world: world.version ?? '',
105:             client: versionTags().join(', '),
106:           }),
107:       color: playable ? TEXT_COLOR.brightGray : '#ff6a6a',
108:     },
109:     {
110:       label: t('info.address'),
111:       value: displayAddress(world),
112:       face: 'fix',
113:     },
114:     {
115:       label: t('info.route'),
116:       value: `${live.wsUrl} → ${live.csHost}:${live.csPort}`,
117:       face: 'fix',
118:     },
119:     {
120:       label: t('info.status'),
121:       value: reach === 'unknown' ? t('info.notChecked') : t(REACH_TEXT[reach]),
122:       color:
123:         reach === 'up'
124:           ? '#8ad48a'
125:           : reach === 'down'
126:             ? '#ff6a6a'
127:             : TEXT_COLOR.brightGray,
128:     },
129:     {
130:       label: t('info.account'),
131:       value: account.username || t('info.noAccount'),
132:       color: account.username ? TEXT_COLOR.brightYellow : TEXT_COLOR.brightGray,
133:     },
134:     {
135:       label: t('info.lastLogin'),
136:       value: account.lastLoginAt
137:         ? new Date(account.lastLoginAt).toLocaleDateString()
138:         : world.id === ServerConfig.lastPlayedId
139:           ? t('worlds.lastPlayed')
140:           : t('info.never'),
141:     },
142:   ];
143: 
144:   return (
145:     <>
146:       <div
147:         className="info-art"
148:         style={{ left: CONTENT_X, top: metrics.factsTop - 2 }}
149:       >
150:         {world.image ? (
151:           <CardArt
152:             key={world.image}
153:             src={world.image}
154:             width={INFO_ART_WIDTH}
155:             height={INFO_ART_HEIGHT}
156:           />
157:         ) : (
158:           <CardStone width={INFO_ART_WIDTH} height={INFO_ART_HEIGHT} />
159:         )}
160:       </div>
161: 
162:       {facts.map((fact, i) => (
163:         <Fact
164:           key={fact.label ?? 'name'}
165:           {...fact}
166:           top={metrics.factsTop + INFO_FACT_STEP * i}
167:         />
168:       ))}
169: 
170:       {/* The world's own blurb, under both columns and given two lines: it is
171:           the one field on this tab written for a player to read rather than
172:           for the client to dial. */}
173:       <div
174:         className="info-desc"
175:         style={{ left: CONTENT_X, top: metrics.descY, width: CONTENT_WIDTH }}
176:       >
177:         {world.description || t('info.noDescription')}
178:       </div>
179: 
180:       <span
181:         className="setup-label"
182:         style={{ left: CONTENT_X, top: metrics.serversLabelY }}
183:       >
184:         {t('info.gameServers')}
185:       </span>
186: 
187:       {servers.length ? (
188:         <>
189:           {shown.map((server, i) => (
190:             <div
191:               key={server.id}
192:               className="info-server"
193:               style={{
194:                 left: CONTENT_X,
195:                 top: metrics.serversTop + INFO_SERVER_STEP * i,
196:                 width: CONTENT_WIDTH,
197:               }}
198:             >
199:               {serverLine(server)}
200:             </div>
201:           ))}
202:           {hidden > 0 && (
203:             <div
204:               className="info-server info-server-more"
205:               style={{
206:                 left: CONTENT_X,
207:                 top: metrics.serversTop + INFO_SERVER_STEP * shown.length,
208:                 width: CONTENT_WIDTH,
209:               }}
210:             >
211:               {t('info.moreServers', { count: hidden })}
212:             </div>
213:           )}
214:         </>
215:       ) : (
216:         <div
217:           className="info-server info-server-more"
218:           style={{
219:             left: CONTENT_X,
220:             top: metrics.serversTop,
221:             width: CONTENT_WIDTH,
222:           }}
223:         >
224:           {t('info.noGameServers')}
225:         </div>
226:       )}
227:     </>
228:   );
229: });
</file>

<file path="src/ui/pages/preloaderPage/layout.ts">
  1: /**
  2:  * The start menu and the server window, in the original's 640×480 units.
  3:  *
  4:  * Two pieces of MU chrome are reused rather than invented: the menu is the
  5:  * login window's own frame (`login_back.OZT`, the one with the MU ONLINE plate
  6:  * and the dragon corners), and the server window is the Option window's frame -
  7:  * a mirrored top and bottom band over a stone fill, which is what MU uses for
  8:  * anything with settings in it.
  9:  *
 10:  * The server window is one frame with four tabs in it (`serverWindow.tsx`), so
 11:  * everything below `CONTENT_TOP` is a tab's own business and everything the
 12:  * `windowRows` helper places is shared by all of them.
 13:  */
 14: 
 15: export const SPRITE = {
 16:   /** 329×245 window with the MU ONLINE plate - the login window's frame. */
 17:   menuWindow: 'login_back.OZT',
 18:   /** 193×26, three frames: idle, hover, pressed. The server-list row art. */
 19:   menuButton: 'server_b2_all.OZT',
 20:   /** 108×30, four frames: idle, hover, pressed, selected (gold). */
 21:   button: 'op1_b_all.OZT',
 22:   /** 213×65 top band, mirrored to make the full window width. */
 23:   optionTop: 'op2_back1.OZT',
 24:   /** 213×43 bottom band, mirrored the same way. */
 25:   optionBottom: 'op1_back2.OZT',
 26:   optionFill: 'op1_stone.OZJ',
 27:   optionRailLeft: 'op1_back3.OZJ',
 28:   optionRailRight: 'op1_back4.OZJ',
 29:   /** 156×23 sunken plate; the text input sits on top of it. */
 30:   input: 'login_me.OZT',
 31:   /** 16×16 per frame: unchecked, checked. */
 32:   check: 'op2_ch.OZT',
 33: } as const;
 34: 
 35: // ---- start menu --------------------------------------------------------
 36: 
 37: export const MENU_WIN_WIDTH = 329;
 38: export const MENU_WIN_HEIGHT = 245;
 39: 
 40: export const MENU_BTN_WIDTH = 193;
 41: export const MENU_BTN_HEIGHT = 26;
 42: export const MENU_BTN_X = Math.floor((MENU_WIN_WIDTH - MENU_BTN_WIDTH) / 2);
 43: /** One row per 30, below the frame's title plate. */
 44: export const MENU_BTN_STEP = 30;
 45: 
 46: /** The band the frame leaves free: under the title plate, above the two lines. */
 47: const MENU_BTN_AREA_TOP = 70;
 48: const MENU_BTN_AREA_BOTTOM = 190;
 49: 
 50: /**
 51:  * The buttons centred in that band rather than hung from its top. The menu is
 52:  * two entries now - online play and the server fields both live behind
 53:  * Worlds - and two buttons pinned under the plate leave the stone below them
 54:  * looking
 55:  * like the rest of the menu failed to draw.
 56:  */
 57: export function menuButtonsTop(count: number) {
 58:   const block = MENU_BTN_HEIGHT + MENU_BTN_STEP * (count - 1);
 59:   const free = MENU_BTN_AREA_BOTTOM - MENU_BTN_AREA_TOP - block;
 60:   return Math.round(MENU_BTN_AREA_TOP + Math.max(0, free) / 2);
 61: }
 62: 
 63: /** The two lines under the buttons: the chosen server, then its endpoints. */
 64: export const MENU_SERVER_LINE_Y = 198;
 65: export const MENU_ENDPOINT_LINE_Y = 212;
 66: 
 67: // ---- the server window and its tabs -------------------------------------
 68: 
 69: const ART_WIDTH = 213;
 70: 
 71: export const SETUP_WIN_WIDTH = ART_WIDTH * 2;
 72: 
 73: export const SETUP_TOP_HEIGHT = 65;
 74: export const SETUP_BOTTOM_HEIGHT = 43;
 75: export const SETUP_ART_WIDTH = ART_WIDTH;
 76: 
 77: /**
 78:  * Where the bottom band stops being a plain rule and becomes its inner figure.
 79:  *
 80:  * A band is 213 wide and the window is two of them, so the second is mirrored -
 81:  * which stands that figure against its own reflection in the middle of the
 82:  * window, where it reads as a join in the frame rather than as decoration. So
 83:  * each half is cut here, and `SetupFrame` bridges what is left with a slice of
 84:  * the same plain rule: the frame closes with nothing meeting in it.
 85:  *
 86:  * Measured off `op1_back2.OZT`: a 5px rule that runs plain from x=53 to x=160,
 87:  * corner figure to its left and inner figure to its right. 107 columns, and the
 88:  * bridge needs 106 of them, so the band closes itself with one to spare. The
 89:  * rule is a noisy texture rather than a gradient, which is why a slice of it
 90:  * joins without a seam of its own.
 91:  *
 92:  * The top band is left whole. Its plain run is shorter than the gap it would
 93:  * have to bridge, and its figure is under the tab strip anyway.
 94:  */
 95: export const BOTTOM_PLAIN_END = 160;
 96: 
 97: export const SETUP_TITLE_Y = 12;
 98: 
 99: /** Enter and Close, and every other button in this window. */
100: export const BTN_WIDTH = 108;
101: export const BTN_HEIGHT = 30;
102: 
103: /** The margin both columns of every tab are set in from. */
104: export const CONTENT_X = 18;
105: export const CONTENT_WIDTH = SETUP_WIN_WIDTH - CONTENT_X * 2;
106: 
107: /**
108:  * Two strips, because the window holds two kinds of thing: the worlds you might
109:  * go to, and the addresses this client dials. The pair sits on the top band
110:  * itself, over the seam where its two mirrored halves meet - the frame's own
111:  * ornament curls together there and reads as a join rather than as decoration,
112:  * so the strip covers it instead of hanging below it.
113:  *
114:  * Under Worlds, the second strip: the grid, what the chosen world says about
115:  * itself, and the accounts kept for it. Three views of one choice, which is why
116:  * they are tabs of it rather than dialogs that close each other.
117:  */
118: export const TAB_STRIP_Y = 33;
119: export const TAB_HEIGHT = 22;
120: /** Two wide tabs, centred: the seam they cover is in the middle of the band. */
121: export const TAB_STRIP_WIDTH = 260;
122: export const TAB_STRIP_X = Math.round((SETUP_WIN_WIDTH - TAB_STRIP_WIDTH) / 2);
123: 
124: export const SUBTAB_STRIP_Y = SETUP_TOP_HEIGHT + 2;
125: export const SUBTAB_HEIGHT = 18;
126: 
127: /** Where every tab's own content starts. */
128: export const CONTENT_TOP = SUBTAB_STRIP_Y + SUBTAB_HEIGHT + 8;
129: 
130: /**
131:  * The rows the window hangs off its bottom edge: two lines about the chosen
132:  * world, then the button row. Measured up from the bottom so every tab puts
133:  * them in the same place whatever its content is worth.
134:  */
135: export function windowRows(height: number) {
136:   const buttonsY = height - SETUP_BOTTOM_HEIGHT - 10 - BTN_HEIGHT;
137:   const addressY = buttonsY - 20;
138:   const descY = addressY - 16;
139: 
140:   return { descY, addressY, buttonsY };
141: }
142: 
143: /** The band `windowRows` claims, from the first shared line to the frame's foot. */
144: const SHARED_ROWS = 16 + 20 + BTN_HEIGHT + 10 + SETUP_BOTTOM_HEIGHT;
145: 
146: /** Air between the last thing a tab draws and the first shared line under it. */
147: const CONTENT_GAP = 8;
148: 
149: /**
150:  * A tab's own content bottom, turned into the window height that fits it. Every
151:  * tab goes through this, so a tab that grows pushes the shared rows down rather
152:  * than printing its last line on top of them.
153:  */
154: export function heightFor(contentBottom: number): number {
155:   return contentBottom + CONTENT_GAP + SHARED_ROWS;
156: }
157: 
158: /** Left column: the saved servers and the buttons that add or remove one. */
159: export const LIST_X = CONTENT_X;
160: export const LIST_ROW_WIDTH = MENU_BTN_WIDTH;
161: export const LIST_ROW_HEIGHT = MENU_BTN_HEIGHT;
162: export const LIST_TOP = CONTENT_TOP + 16;
163: /**
164:  * Six rows, which is a list rather than a shortlist now that the published
165:  * servers share the column with the saved ones. More than six pages.
166:  */
167: export const LIST_MAX = 6;
168: 
169: export const LIST_BUTTONS_Y = LIST_TOP + LIST_ROW_HEIGHT * LIST_MAX + 6;
170: export const ADD_X = LIST_X;
171: export const DELETE_X = LIST_X + BTN_WIDTH + 6;
172: 
173: /** Paging arrows, on the list's header line (`server_deco_all.OZT`). */
174: export const PAGE_ARROW = { width: 23, height: 29 };
175: export const PAGE_PREV_X = LIST_X + LIST_ROW_WIDTH - PAGE_ARROW.width * 2 - 4;
176: export const PAGE_NEXT_X = LIST_X + LIST_ROW_WIDTH - PAGE_ARROW.width;
177: export const PAGE_ARROW_Y = CONTENT_TOP - 8;
178: 
179: /** Right column: the fields of the selected server. */
180: export const FIELD_X = 246;
181: export const FIELD_WIDTH = 162;
182: export const FIELD_HEIGHT = 23;
183: export const PORT_WIDTH = 70;
184: 
185: /** label, then the plate under it; one field per 40. */
186: export const FIELD_LABEL_H = 13;
187: export const FIELD_STEP = 40;
188: export const FIELD_TOP = CONTENT_TOP;
189: 
190: export const CHECK_SIZE = 16;
191: 
192: /**
193:  * The rows under the setup tab's two columns, and the height that tab needs.
194:  * Derived rather than pinned, so moving a row above them does not leave the
195:  * lines below floating at a constant that no longer holds.
196:  */
197: export function setupMetrics() {
198:   const contentBottom = LIST_BUTTONS_Y + BTN_HEIGHT;
199: 
200:   const checkY = contentBottom + 10;
201:   const previewY = checkY + 26;
202:   const noteY = previewY + 16;
203: 
204:   return {
205:     /** Left, under both columns: the sentence needs the full width. */
206:     checkX: LIST_X,
207:     checkY,
208:     previewY,
209:     noteY,
210:     height: heightFor(noteY + 13),
211:   };
212: }
213: 
214: // ---- the info tab -------------------------------------------------------
215: 
216: /**
217:  * What the chosen world says about itself, before anything is dialled: its
218:  * banner on the left, the facts that decide whether to enter on the right, and
219:  * underneath, the game servers and channels the published list named for it.
220:  * The connect server's protocol carries ids and load percentages and no text,
221:  * so this is the only place those names can come from before logging in.
222:  */
223: export const INFO_ART_WIDTH = MENU_BTN_WIDTH;
224: export const INFO_ART_HEIGHT = Math.round(MENU_BTN_WIDTH / 1.6);
225: 
226: export const INFO_FACTS_X = CONTENT_X + INFO_ART_WIDTH + 4;
227: export const INFO_FACT_STEP = 16;
228: 
229: /** Rows of game servers the tab draws before it starts saying "and more". */
230: export const INFO_SERVER_ROWS = 5;
231: export const INFO_SERVER_STEP = 15;
232: 
233: export function infoMetrics() {
234:   const factsTop = CONTENT_TOP + 2;
235:   const descY = CONTENT_TOP + INFO_ART_HEIGHT + 8;
236:   const serversLabelY = descY + 32;
237:   const serversTop = serversLabelY + 16;
238:   const contentBottom = serversTop + INFO_SERVER_STEP * INFO_SERVER_ROWS;
239: 
240:   return {
241:     factsTop,
242:     descY,
243:     serversLabelY,
244:     serversTop,
245:     height: heightFor(contentBottom),
246:   };
247: }
248: 
249: // ---- the accounts tab ---------------------------------------------------
250: 
251: /**
252:  * The accounts saved on the chosen world, in the same two columns the setup tab
253:  * uses for its servers: the rows on the left, the chosen one's fields on the
254:  * right. A main and a mule on one server is the ordinary case in MU, so this is
255:  * a list and not a pair of boxes.
256:  */
257: export const ACCOUNT_ROWS = 5;
258: 
259: export function accountMetrics() {
260:   const listTop = CONTENT_TOP + 16;
261:   const listBottom = listTop + LIST_ROW_HEIGHT * ACCOUNT_ROWS;
262:   const buttonsY = listBottom + 6;
263:   const checkY = FIELD_TOP + FIELD_LABEL_H + FIELD_STEP * 2 - 4;
264:   const noteY = Math.max(buttonsY + BTN_HEIGHT, checkY + 22) + 12;
265:   const contentBottom = noteY + 13 * 2;
266: 
267:   return {
268:     listTop,
269:     buttonsY,
270:     checkY,
271:     noteY,
272:     height: heightFor(contentBottom),
273:   };
274: }
275: 
276: // ---- the worlds tab -----------------------------------------------------
277: 
278: /**
279:  * The worlds tab: the published servers as a grid of cards.
280:  *
281:  * A card is a banner with the server-list row art bolted under it, which is
282:  * where its name, its language tag and its hover and selected states come
283:  * from. Two columns of 193 fit the 426 frame exactly: 18 + 193 + 4 + 193 + 18.
284:  */
285: export const WORLD_CARD_WIDTH = MENU_BTN_WIDTH;
286: /**
287:  * 16:10 of the card's width, which is the shape these banners are drawn in -
288:  * the same ratio the info tab crops its own copy to. At the 2:1 this used to
289:  * be, `object-fit: cover` was quietly taking a fifth off the top and bottom of
290:  * every published banner, which is where a server tends to put its name.
291:  */
292: export const WORLD_CARD_ART_HEIGHT = Math.round(MENU_BTN_WIDTH / 1.6);
293: export const WORLD_CARD_BAR_HEIGHT = MENU_BTN_HEIGHT;
294: export const WORLD_CARD_HEIGHT = WORLD_CARD_ART_HEIGHT + WORLD_CARD_BAR_HEIGHT;
295: 
296: export const WORLD_COLS = 2;
297: 
298: /**
299:  * How many rows of cards the window may hold, and how tall a window that is.
300:  *
301:  * The card is 193 wide because that is the row art's own width - `MuSpriteFrame`
302:  * crops rather than scales, so a narrower card would cut the button's right
303:  * bevel off. Two columns is therefore fixed, and depth is the only axis density
304:  * can be had on: three rows where the viewport allows it, two where it does not.
305:  */
306: /**
307:  * One row is a poor grid, but it is what a 500px-tall browser window has room
308:  * for now that a card is 146 tall. Two rows there would put the window's own
309:  * buttons off the bottom of the screen, and a picker you cannot press Enter on
310:  * is worse than a picker that pages twice as often.
311:  */
312: export const WORLD_ROWS_MIN = 1;
313: export const WORLD_ROWS_MAX = 3;
314: 
315: export const WORLD_GRID_X = CONTENT_X;
316: export const WORLD_COL_STEP = WORLD_CARD_WIDTH + 4;
317: export const WORLD_ROW_STEP = WORLD_CARD_HEIGHT + 12;
318: 
319: /**
320:  * Two head rows above the grid: the search plate with the refresh link beside
321:  * it, then the language chips with the count of what survived both.
322:  *
323:  * Search is a row of its own rather than a chip on the filter line because it
324:  * is the filter that scales - a list with more worlds in it than a filter chip
325:  * per language can express is exactly the list you cannot page through.
326:  */
327: export const WORLD_SEARCH_Y = CONTENT_TOP;
328: export const WORLD_SEARCH_HEIGHT = 21;
329: export const WORLD_SEARCH_WIDTH = 300;
330: export const WORLD_HEAD_X = WORLD_GRID_X;
331: export const WORLD_FILTER_Y = WORLD_SEARCH_Y + WORLD_SEARCH_HEIGHT + 5;
332: export const WORLD_GRID_TOP = WORLD_FILTER_Y + 22;
333: 
334: /** Everything but the grid, so a row count can be turned into a window height. */
335: const WORLD_CHROME =
336:   WORLD_GRID_TOP + 16 + 20 + BTN_HEIGHT + 10 + SETUP_BOTTOM_HEIGHT;
337: 
338: export function worldRowsFor(viewportHeight: number): number {
339:   const rows = Math.floor((viewportHeight - WORLD_CHROME) / WORLD_ROW_STEP);
340: 
341:   return Math.max(WORLD_ROWS_MIN, Math.min(WORLD_ROWS_MAX, rows));
342: }
343: 
344: export const WORLD_STATUS_SIZE = 9;
345: 
346: /** Enter and Close: one centred pair, on every tab. */
347: const WORLD_BTN_GAP = 6;
348: const WORLD_BTN_ROW = BTN_WIDTH * 2 + WORLD_BTN_GAP;
349: 
350: export const WORLD_PLAY_X = Math.floor((SETUP_WIN_WIDTH - WORLD_BTN_ROW) / 2);
351: export const WORLD_BACK_X = WORLD_PLAY_X + BTN_WIDTH + WORLD_BTN_GAP;
352: 
353: /**
354:  * The height the grid alone would like. The window takes the tallest of its
355:  * tabs rather than this, so the strip does not jump under the cursor that just
356:  * clicked it - but a grid that fits in one short row still asks for a short
357:  * window, and on a tall viewport it is the tab that decides.
358:  */
359: export function worldHeight(rowCount: number): number {
360:   const rows = Math.max(1, Math.min(rowCount, WORLD_ROWS_MAX));
361:   const gridBottom = WORLD_GRID_TOP + WORLD_ROW_STEP * rows - 12;
362: 
363:   return heightFor(gridBottom + 4);
364: }
365: 
366: /**
367:  * Paging arrows flank the button row rather than sitting up on the title: the
368:  * top band is already carrying an ornament there, and a 23px arrow drawn over
369:  * a curl of the frame reads as part of the frame.
370:  */
371: export const WORLD_PAGE_PREV_X = WORLD_PLAY_X - PAGE_ARROW.width - 6;
372: export const WORLD_PAGE_NEXT_X = WORLD_BACK_X + BTN_WIDTH + 6;
</file>

<file path="src/ui/pages/preloaderPage/serverWindow.tsx">
  1: import { uiClick } from '../../../libs/sfx';
  2: import { useEffect, useMemo, useState } from 'react';
  3: import { observer } from 'mobx-react-lite';
  4: import { MuButton } from '../../components/muButton';
  5: import { MuText } from '../../components/muText';
  6: import { TEXT_COLOR } from '../serversPage/layout';
  7: import { t, type TextKey } from '../../../i18n';
  8: import {
  9:   displayAddress,
 10:   matchesSearch,
 11:   playableHere,
 12:   ServerConfig,
 13: } from '../../../common/serverConfig';
 14: import { ServerList } from '../../../common/serverList';
 15: import { versionTags } from '../../../version';
 16: import { SetupFrame } from './frame';
 17: import { AccountTab } from './accountTab';
 18: import { InfoTab } from './infoTab';
 19: import { SetupTab } from './setupTab';
 20: import { useWorldRows, WorldsTab } from './worldsTab';
 21: import {
 22:   BTN_HEIGHT,
 23:   BTN_WIDTH,
 24:   CONTENT_X,
 25:   SETUP_TITLE_Y,
 26:   SETUP_WIN_WIDTH,
 27:   SPRITE,
 28:   SUBTAB_HEIGHT,
 29:   SUBTAB_STRIP_Y,
 30:   TAB_HEIGHT,
 31:   TAB_STRIP_WIDTH,
 32:   TAB_STRIP_X,
 33:   TAB_STRIP_Y,
 34:   WORLD_BACK_X,
 35:   WORLD_COLS,
 36:   WORLD_PLAY_X,
 37:   accountMetrics,
 38:   infoMetrics,
 39:   setupMetrics,
 40:   windowRows,
 41:   worldHeight,
 42:   worldRowsFor,
 43: } from './layout';
 44: 
 45: /**
 46:  * The server window: one frame, two strips of tabs, and the two buttons they
 47:  * all share.
 48:  *
 49:  * The top strip splits the window the way the player thinks about it. Worlds
 50:  * are places to go; Setup is the addresses this client dials, which most
 51:  * players never open. Under Worlds, the second strip: the grid, what the chosen
 52:  * world says about itself, and the accounts kept for it - three views of one
 53:  * choice, where the grid alone used to be a window that had to close itself to
 54:  * show anything else.
 55:  *
 56:  * The window is sized to the tallest of its tabs rather than to each in turn,
 57:  * so a strip never moves under the cursor that just clicked it.
 58:  *
 59:  * The filters live here rather than in the worlds tab because the selection
 60:  * outlives the tab: search for a world, read its details, come back, and the
 61:  * search is still what it was.
 62:  */
 63: 
 64: /** The top strip: somewhere to go, or the addresses this client dials. */
 65: type Section = 'worlds' | 'setup';
 66: 
 67: /** The second strip, under Worlds. */
 68: type WorldsTabKey = 'list' | 'info' | 'account';
 69: 
 70: const SECTIONS: { key: Section; label: TextKey }[] = [
 71:   { key: 'worlds', label: 'worlds.tabWorlds' },
 72:   { key: 'setup', label: 'worlds.tabSetup' },
 73: ];
 74: 
 75: const WORLD_TABS: { key: WorldsTabKey; label: TextKey }[] = [
 76:   { key: 'list', label: 'worlds.tabList' },
 77:   { key: 'info', label: 'worlds.tabInfo' },
 78:   { key: 'account', label: 'worlds.tabAccount' },
 79: ];
 80: 
 81: /** The filter's "no filter" row, kept out of the language codes it sits with. */
 82: const ALL = '';
 83: 
 84: export const ServerWindow = observer(
 85:   ({ onPlay, onClose }: { onPlay: () => void; onClose: () => void }) => {
 86:     const [section, setSection] = useState<Section>('worlds');
 87:     const [tab, setTab] = useState<WorldsTabKey>('list');
 88:     const [page, setPage] = useState(0);
 89:     const [language, setLanguage] = useState(ALL);
 90:     const [search, setSearch] = useState('');
 91:     const rows = useWorldRows(worldRowsFor);
 92:     const pageSize = WORLD_COLS * rows;
 93: 
 94:     const all = ServerConfig.all;
 95:     const selected = ServerConfig.active;
 96: 
 97:     // A saved world carries no language, so it belongs to no tag but `All` -
 98:     // where it is always the first thing in the grid anyway.
 99:     const worlds = useMemo(
100:       () =>
101:         all.filter(
102:           w =>
103:             (language === ALL || w.language?.toLowerCase() === language) &&
104:             matchesSearch(w, search)
105:         ),
106:       [all, language, search]
107:     );
108: 
109:     const pages = Math.max(1, Math.ceil(worlds.length / pageSize));
110:     const current = Math.min(page, pages - 1);
111: 
112:     // Memoised so the page is one object for as long as it is the same page:
113:     // the probe effect keys off it, and a fresh slice every render would
114:     // re-dial the grid on every hover.
115:     const visible = useMemo(
116:       () => worlds.slice(current * pageSize, current * pageSize + pageSize),
117:       [worlds, current, pageSize]
118:     );
119: 
120:     // One height for every tab, so the strip stays where it was clicked. The
121:     // grid asks for what its rows need and the fixed tabs for what their
122:     // content needs; the window takes whichever is more.
123:     const height = Math.max(
124:       worldHeight(Math.min(rows, Math.ceil(worlds.length / WORLD_COLS)) || 1),
125:       infoMetrics().height,
126:       accountMetrics().height,
127:       setupMetrics().height
128:     );
129:     const { descY, addressY, buttonsY } = windowRows(height);
130: 
131:     /** The grid is showing: the paging, the count and the blurb are all its. */
132:     const onList = section === 'worlds' && tab === 'list';
133: 
134:     const playable = playableHere(selected);
135: 
136:     /**
137:      * Entering is refused for a world built against another client rather than
138:      * merely discouraged: this build carries one version's packets, so the
139:      * connect would succeed and then come apart mid-handshake, which reads as
140:      * a broken client rather than the wrong one.
141:      */
142:     const enter = (id = selected.id) => {
143:       // Nothing to enter: `active` is the placeholder, and connecting with it
144:       // would dial the build defaults at a world nobody published.
145:       if (ServerConfig.isEmpty) return;
146: 
147:       const world = ServerConfig.all.find(w => w.id === id);
148: 
149:       if (world && !playableHere(world)) return;
150: 
151:       ServerConfig.select(id);
152:       ServerConfig.markPlayed(id);
153:       onPlay();
154:     };
155: 
156:     /**
157:      * The grid, from the keyboard: the arrows walk the whole filtered list, not
158:      * the page, so running off the last card of one page lands on the first of
159:      * the next and the page follows the selection rather than the other way
160:      * round.
161:      *
162:      * A field has the keys first, and keeps them. Arrows move a caret, so a
163:      * search box that lost them to the grid behind it would be a box nobody
164:      * could edit - and Enter in a server address or a password is not a request
165:      * to connect, which is what it used to do here. Escape leaves the field
166:      * first and closes the window on the second press.
167:      */
168:     useEffect(() => {
169:       const onKey = (e: KeyboardEvent) => {
170:         const target = e.target as HTMLElement | null;
171:         const typing =
172:           target?.tagName === 'INPUT' || target?.tagName === 'TEXTAREA';
173:         // The one field Enter belongs to: searching for a world and pressing
174:         // Enter means entering the one the search settled on.
175:         const searching = !!target?.classList.contains('world-search');
176: 
177:         const step: Record<string, number> = {
178:           ArrowLeft: -1,
179:           ArrowRight: 1,
180:           ArrowUp: -WORLD_COLS,
181:           ArrowDown: WORLD_COLS,
182:           PageUp: -pageSize,
183:           PageDown: pageSize,
184:         };
185: 
186:         if (e.key === 'Escape') {
187:           if (typing) {
188:             target?.blur();
189:           } else {
190:             onClose();
191:           }
192:         } else if (e.key === 'Enter' && (!typing || searching)) {
193:           enter();
194:         } else if (
195:           !typing &&
196:           section === 'worlds' &&
197:           tab === 'list' &&
198:           e.key in step &&
199:           worlds.length
200:         ) {
201:           const at = worlds.findIndex(w => w.id === selected.id);
202:           const next = Math.max(
203:             0,
204:             Math.min(worlds.length - 1, (at < 0 ? 0 : at) + step[e.key])
205:           );
206: 
207:           ServerConfig.select(worlds[next].id);
208:           setPage(Math.floor(next / pageSize));
209:         } else {
210:           return;
211:         }
212: 
213:         e.preventDefault();
214:       };
215: 
216:       window.addEventListener('keydown', onKey);
217: 
218:       return () => window.removeEventListener('keydown', onKey);
219:     });
220: 
221:     // One line under the tab: what this world says about itself, or why the
222:     // grid is thin - a search that matched nothing and a list that could not be
223:     // read are both worth saying out loud here, where the player is looking for
224:     // somewhere to play, and with the reason attached.
225:     const blurb = !worlds.length
226:       ? search
227:         ? t('worlds.noMatch', { text: search.trim() })
228:         : t('worlds.empty')
229:       : !playable
230:         ? t('worlds.needsClient', {
231:             world: selected.version ?? '',
232:             client: versionTags().join(', '),
233:           })
234:         : selected.description ||
235:           (ServerList.state === 'loading'
236:             ? t('common.loading')
237:             : t('worlds.hint'));
238: 
239:     const listError =
240:       ServerList.state === 'error'
241:         ? `${t('server.listOffline')}${ServerList.error ? ` (${ServerList.error})` : ''}`
242:         : '';
243: 
244:     return (
245:       <div
246:         className="setup-win world-win"
247:         style={{ width: SETUP_WIN_WIDTH, height }}
248:       >
249:         <SetupFrame height={height} />
250: 
251:         <div className="setup-title" style={{ top: SETUP_TITLE_Y }}>
252:           {t('worlds.title')}
253:           {onList && pages > 1 && ` ${current + 1}/${pages}`}
254:         </div>
255: 
256:         {/* The top strip, over the seam in the frame's own top band. */}
257:         <div
258:           className="setup-tabs setup-tabs-top"
259:           style={{
260:             top: TAB_STRIP_Y,
261:             left: TAB_STRIP_X,
262:             width: TAB_STRIP_WIDTH,
263:             height: TAB_HEIGHT,
264:           }}
265:         >
266:           {SECTIONS.map(entry => (
267:             <span
268:               key={entry.key}
269:               className={`setup-tab${section === entry.key ? ' setup-tab-on' : ''}`}
270:               onClick={uiClick(() => setSection(entry.key))}
271:             >
272:               {t(entry.label)}
273:             </span>
274:           ))}
275:         </div>
276: 
277:         {section === 'worlds' && (
278:           <div
279:             className="setup-tabs"
280:             style={{
281:               top: SUBTAB_STRIP_Y,
282:               left: CONTENT_X,
283:               right: CONTENT_X,
284:               height: SUBTAB_HEIGHT,
285:             }}
286:           >
287:             {WORLD_TABS.map(entry => (
288:               <span
289:                 key={entry.key}
290:                 className={`setup-tab${tab === entry.key ? ' setup-tab-on' : ''}`}
291:                 onClick={uiClick(() => setTab(entry.key))}
292:               >
293:                 {t(entry.label)}
294:               </span>
295:             ))}
296:           </div>
297:         )}
298: 
299:         {section === 'setup' ? (
300:           <SetupTab />
301:         ) : tab === 'list' ? (
302:           <WorldsTab
303:             worlds={worlds}
304:             visible={visible}
305:             total={all.length}
306:             search={search}
307:             onSearch={text => {
308:               setSearch(text);
309:               setPage(0);
310:             }}
311:             language={language}
312:             onLanguage={tag => {
313:               setLanguage(tag);
314:               setPage(0);
315:             }}
316:             pages={pages}
317:             page={current}
318:             onPage={setPage}
319:             arrowsY={buttonsY}
320:             onEnter={enter}
321:           />
322:         ) : tab === 'info' ? (
323:           <InfoTab world={selected} />
324:         ) : (
325:           <AccountTab world={selected} />
326:         )}
327: 
328:         {onList && (
329:           <MuText
