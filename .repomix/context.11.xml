<file path="src/ui/pages/preloaderPage/setupTab.tsx">
  1: import { uiClick } from '../../../libs/sfx';
  2: import { useState } from 'react';
  3: import { observer } from 'mobx-react-lite';
  4: import { MuSpriteFrame } from '../../components/muSprite';
  5: import { MuButton } from '../../components/muButton';
  6: import { MuText } from '../../components/muText';
  7: import { DECO, SPRITE as SERVERS_SPRITE, TEXT_COLOR } from '../serversPage/layout';
  8: import { t } from '../../../i18n';
  9: import {
 10:   effective,
 11:   isInsecureWsUrl,
 12:   ServerConfig,
 13:   type ServerProfile,
 14: } from '../../../common/serverConfig';
 15: import { ServerList } from '../../../common/serverList';
 16: import { Field } from './frame';
 17: import {
 18:   ADD_X,
 19:   BTN_HEIGHT,
 20:   BTN_WIDTH,
 21:   CHECK_SIZE,
 22:   CONTENT_TOP,
 23:   DELETE_X,
 24:   FIELD_STEP,
 25:   FIELD_TOP,
 26:   LIST_BUTTONS_Y,
 27:   LIST_MAX,
 28:   LIST_ROW_HEIGHT,
 29:   LIST_ROW_WIDTH,
 30:   LIST_TOP,
 31:   LIST_X,
 32:   PAGE_ARROW,
 33:   PAGE_ARROW_Y,
 34:   PAGE_NEXT_X,
 35:   PAGE_PREV_X,
 36:   PORT_WIDTH,
 37:   SPRITE,
 38:   setupMetrics,
 39: } from './layout';
 40: 
 41: /**
 42:  * Where the client connects, in MU's own settings chrome - the server-list row
 43:  * art for the saved servers, and the login window's sunken plate under every
 44:  * field.
 45:  *
 46:  * The ws proxy is a field of its own rather than something derived from the
 47:  * server host because it is a different machine's job: a browser cannot open a
 48:  * TCP socket, so `proxy/main.ts` - yours, or one hosted beside the server - is
 49:  * what dials `csHost:csPort` and then the game server.
 50:  */
 51: 
 52: export const SetupTab = observer(() => {
 53:   const [page, setPage] = useState(0);
 54: 
 55:   const profile: ServerProfile = ServerConfig.active;
 56:   const locked = ServerConfig.lockedByUrl;
 57:   const listed = ServerConfig.activeIsListed;
 58:   const readOnly = ServerConfig.readOnly;
 59:   const live = effective(profile);
 60:   const insecure = isInsecureWsUrl(live.wsUrl);
 61: 
 62:   const metrics = setupMetrics();
 63: 
 64:   // Saved servers only: the published list belongs to the worlds tab, and a row
 65:   // here is something the player can edit or delete.
 66:   const rows = locked ? [profile] : ServerConfig.profiles;
 67:   const pages = Math.max(1, Math.ceil(rows.length / LIST_MAX));
 68:   const current = Math.min(page, pages - 1);
 69:   const visible = rows.slice(current * LIST_MAX, current * LIST_MAX + LIST_MAX);
 70: 
 71:   const set = (patch: Partial<ServerProfile>) =>
 72:     ServerConfig.update(profile.id, patch);
 73: 
 74:   // One line under the fields, in order of what the player most needs to know:
 75:   // why the fields are locked, why the proxy will not connect, what this
 76:   // server says about itself, and otherwise where the address comes from.
 77:   const note = locked
 78:     ? { text: t('server.lockedByUrl'), color: TEXT_COLOR.yellow }
 79:     : insecure
 80:       ? { text: t('server.insecure'), color: '#ff6a6a' }
 81:       : listed
 82:         ? {
 83:             // The world's own blurb belongs to the info tab; here the only
 84:             // thing worth saying is that this is not a row you can edit.
 85:             text: t('server.listedHint'),
 86:             color: TEXT_COLOR.yellow,
 87:           }
 88:         : ServerList.state === 'error'
 89:           ? { text: t('server.listOffline'), color: TEXT_COLOR.yellow }
 90:           : { text: t('server.proxyHint'), color: TEXT_COLOR.brightGray };
 91: 
 92:   return (
 93:     <>
 94:       {/* The servers: what the player saved, then what the published list
 95:           carries. The selected one is named in gold, as the original marks the
 96:           chosen row of a list. */}
 97:       <span className="setup-label" style={{ left: LIST_X, top: CONTENT_TOP }}>
 98:         {t('server.list')}
 99:         {pages > 1 && ` ${current + 1}/${pages}`}
100:       </span>
101: 
102:       {/* Paging, in the server-list screen's own arrows - only once there is
103:           more than a page to turn. */}
104:       {pages > 1 &&
105:         (
106:           [
107:             { key: 'prev', rect: DECO.arrowLeft, x: PAGE_PREV_X, step: -1 },
108:             { key: 'next', rect: DECO.arrowRight, x: PAGE_NEXT_X, step: 1 },
109:           ] as const
110:         ).map(arrow => (
111:           <MuSpriteFrame
112:             key={arrow.key}
113:             file={SERVERS_SPRITE.deco}
114:             {...arrow.rect}
115:             style={{
116:               position: 'absolute',
117:               left: arrow.x,
118:               top: PAGE_ARROW_Y,
119:               width: PAGE_ARROW.width,
120:               height: PAGE_ARROW.height,
121:               cursor: 'pointer',
122:               pointerEvents: 'auto',
123:             }}
124:             onClick={uiClick(() =>
125:               setPage((current + arrow.step + pages) % pages)
126:             )}
127:           />
128:         ))}
129: 
130:       {/* The empty slots are drawn as well, so the column reads as a list
131:           rather than a button or two floating over stone. */}
132:       {Array.from({ length: LIST_MAX }, (_, i) => (
133:         <MuSpriteFrame
134:           key={`slot-${i}`}
135:           file={SPRITE.menuButton}
136:           width={LIST_ROW_WIDTH}
137:           height={LIST_ROW_HEIGHT}
138:           style={{
139:             position: 'absolute',
140:             left: LIST_X,
141:             top: LIST_TOP + LIST_ROW_HEIGHT * i,
142:             opacity: 0.45,
143:           }}
144:         />
145:       ))}
146: 
147:       {visible.map((p, i) => {
148:         const selected = p.id === profile.id;
149: 
150:         return (
151:           <MuButton
152:             key={p.id}
153:             file={SPRITE.menuButton}
154:             width={LIST_ROW_WIDTH}
155:             height={LIST_ROW_HEIGHT}
156:             frames={{ up: 0, active: 1, down: 2 }}
157:             color={selected ? TEXT_COLOR.brightYellow : TEXT_COLOR.brightGray}
158:             activeColor={TEXT_COLOR.white}
159:             label={p.name.trim() || t('server.unnamed')}
160:             onClick={() => ServerConfig.select(p.id)}
161:             style={{
162:               position: 'absolute',
163:               left: LIST_X,
164:               top: LIST_TOP + LIST_ROW_HEIGHT * i,
165:             }}
166:             labelStyle={{ fontSize: 11 }}
167:           >
168:             {/* A published row wears its language tag on the right, which is
169:                 also what tells it apart from a saved one. */}
170:             {p.language && (
171:               <span className="setup-row-tag">{p.language.toUpperCase()}</span>
172:             )}
173:           </MuButton>
174:         );
175:       })}
176: 
177:       <MuButton
178:         file={SPRITE.button}
179:         width={BTN_WIDTH}
180:         height={BTN_HEIGHT}
181:         frames={{ up: 0, active: 1, down: 2 }}
182:         color={TEXT_COLOR.brightGray}
183:         activeColor={TEXT_COLOR.white}
184:         disabled={locked}
185:         // On a published server this is how you take a copy you can edit; on a
186:         // saved one it is a new blank server.
187:         label={listed ? t('server.copy') : t('server.add')}
188:         onClick={() =>
189:           ServerConfig.add(listed ? {} : { name: t('server.newServer') })
190:         }
191:         style={{ position: 'absolute', left: ADD_X, top: LIST_BUTTONS_Y }}
192:         labelStyle={{ fontSize: 11 }}
193:       />
194:       <MuButton
195:         file={SPRITE.button}
196:         width={BTN_WIDTH}
197:         height={BTN_HEIGHT}
198:         frames={{ up: 0, active: 1, down: 2 }}
199:         color={TEXT_COLOR.brightGray}
200:         activeColor={TEXT_COLOR.white}
201:         disabled={readOnly || ServerConfig.profiles.length < 2}
202:         label={t('server.delete')}
203:         onClick={() => ServerConfig.remove(ServerConfig.activeId)}
204:         style={{ position: 'absolute', left: DELETE_X, top: LIST_BUTTONS_Y }}
205:         labelStyle={{ fontSize: 11 }}
206:       />
207: 
208:       {/* The selected server's fields. */}
209:       <Field
210:         label={t('server.name')}
211:         value={profile.name}
212:         top={FIELD_TOP}
213:         disabled={readOnly}
214:         onChange={name => set({ name })}
215:       />
216:       <Field
217:         label={t('server.connectServer')}
218:         value={profile.csHost}
219:         top={FIELD_TOP + FIELD_STEP}
220:         disabled={readOnly}
221:         placeholder="play.example.com"
222:         onChange={csHost => set({ csHost })}
223:       />
224:       <Field
225:         label={t('server.port')}
226:         value={profile.csPort ? String(profile.csPort) : ''}
227:         width={PORT_WIDTH}
228:         top={FIELD_TOP + FIELD_STEP * 2}
229:         disabled={readOnly}
230:         numeric
231:         placeholder="44405"
232:         onChange={port => set({ csPort: Number(port) })}
233:       />
234:       <Field
235:         label={t('server.proxy')}
236:         value={profile.wsUrl}
237:         top={FIELD_TOP + FIELD_STEP * 3}
238:         disabled={readOnly}
239:         placeholder="ws://localhost:3000"
240:         onChange={wsUrl => set({ wsUrl })}
241:       />
242: 
243:       {/* `auto` vs `csHost`: one checkbox, because the second option is just
244:           "do not". The retry that makes `auto` safe lives in the store. */}
245:       <MuSpriteFrame
246:         file={SPRITE.check}
247:         y={profile.gsAddress === 'auto' ? CHECK_SIZE : 0}
248:         width={CHECK_SIZE}
249:         height={CHECK_SIZE}
250:         style={{
251:           position: 'absolute',
252:           left: metrics.checkX,
253:           top: metrics.checkY,
254:           cursor: readOnly ? 'default' : 'pointer',
255:           pointerEvents: readOnly ? 'none' : 'auto',
256:           opacity: readOnly ? 0.5 : 1,
257:         }}
258:         onClick={uiClick(() =>
259:           set({ gsAddress: profile.gsAddress === 'auto' ? 'csHost' : 'auto' })
260:         )}
261:       />
262:       <span
263:         className="setup-label setup-check-label"
264:         style={{
265:           left: metrics.checkX + CHECK_SIZE + 6,
266:           top: metrics.checkY + 2,
267:           color: readOnly ? '#a0a0a0' : undefined,
268:         }}
269:         onClick={uiClick(() => {
270:           if (!readOnly) {
271:             set({
272:               gsAddress: profile.gsAddress === 'auto' ? 'csHost' : 'auto',
273:             });
274:           }
275:         })}
276:       >
277:         {t('server.trustAddress')}
278:       </span>
279: 
280:       {/* What will actually be dialled, and why it might not work. */}
281:       <MuText
282:         face="fix"
283:         className="setup-line"
284:         color={TEXT_COLOR.brightYellow}
285:         style={{ top: metrics.previewY }}
286:         text={`${live.wsUrl}  →  ${live.csHost}:${live.csPort}`}
287:       />
288:       <MuText
289:         className="setup-line"
290:         color={note.color}
291:         style={{ top: metrics.noteY }}
292:         text={note.text}
293:       />
294:     </>
295:   );
296: });
