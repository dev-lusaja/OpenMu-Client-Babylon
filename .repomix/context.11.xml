<file path="src/ui/pages/loginPage/registerWindow.tsx">
  1: import { useState } from 'react';
  2: import { observer } from 'mobx-react-lite';
  3: import { t } from '../../../i18n';
  4: import { registerApiUrl } from '../../../common/serverServices';
  5: import {
  6:   MAX_ACCOUNT_LENGTH,
  7:   MAX_ACCOUNT_PASSWORD_LENGTH,
  8:   MIN_ACCOUNT_LENGTH,
  9:   MIN_ACCOUNT_PASSWORD_LENGTH,
 10:   validateSignup,
 11:   type SignupProblem,
 12: } from '../../../common/registerRules';
 13: import { MuSpriteFrame } from '../../components/muSprite';
 14: import { MuButton } from '../../components/muButton';
 15: import { TEXT_COLOR } from '../serversPage/layout';
 16: 
 17: /**
 18:  * Account creation, in the login window's place.
 19:  *
 20:  * The same `login_back.OZT` frame, because a signup form is the login form
 21:  * with one more row - and because swapping one window for another leaves the
 22:  * logo, the scene and the music exactly where they were. That is the whole
 23:  * point of it being here rather than on a page of its own: the player never
 24:  * leaves the screen they waited for.
 25:  *
 26:  * Everything is absolutely positioned against the art, as the rest of MU's UI
 27:  * is, and must never reflow.
 28:  */
 29: 
 30: const WIN_WIDTH = 329;
 31: const WIN_HEIGHT = 245;
 32: 
 33: const INPUT_WIDTH = 156;
 34: const INPUT_HEIGHT = 23;
 35: const INPUT_X = 109;
 36: const LABEL_X = 30;
 37: 
 38: /**
 39:  * The layout, against the frame art rather than against arithmetic. Only the
 40:  * middle of `login_back.OZT` is flat: the top bar is the MU ONLINE plate with
 41:  * a dragon's head reaching down at the right, and the bottom band is two more
 42:  * of them. So the rows sit clear of both, the buttons take the bottom band the
 43:  * way the login window's do - they are opaque sprites and cover it - and the
 44:  * message goes between them, on a box of its own (see `login-signup-message`).
 45:  */
 46: const TITLE_Y = 60;
 47: const FIRST_ROW_Y = 88;
 48: const ROW_STEP = 24;
 49: 
 50: /** The label sits a few px below the input's top edge to look centred. */
 51: const LABEL_OFFSET_Y = 7;
 52: 
 53: const TEXT_INSET_X = 6;
 54: const TEXT_INSET_Y = 6;
 55: 
 56: const BUTTON_WIDTH = 54;
 57: const BUTTON_HEIGHT = 30;
 58: const BUTTON_Y = 196;
 59: const OK_X = 150;
 60: const CANCEL_X = 211;
 61: 
 62: const ROWS = [
 63:   { key: 'username', label: 'register.id', type: 'text' },
 64:   { key: 'password', label: 'register.password', type: 'password' },
 65:   { key: 'confirm', label: 'register.confirm', type: 'password' },
 66: ] as const;
 67: 
 68: type Field = (typeof ROWS)[number]['key'];
 69: 
 70: const EMPTY: Record<Field, string> = {
 71:   username: '',
 72:   password: '',
 73:   confirm: '',
 74: };
 75: 
 76: const MAX_LENGTH: Record<Field, number> = {
 77:   username: MAX_ACCOUNT_LENGTH,
 78:   password: MAX_ACCOUNT_PASSWORD_LENGTH,
 79:   confirm: MAX_ACCOUNT_PASSWORD_LENGTH,
 80: };
 81: 
 82: /** The shared rules' reasons, said in the player's language. */
 83: function problemText(problem: SignupProblem): string {
 84:   switch (problem) {
 85:     case 'empty':
 86:       return t('register.fillEveryField');
 87:     case 'idShort':
 88:       return t('register.idTooShort', { min: MIN_ACCOUNT_LENGTH });
 89:     case 'idChars':
 90:       return t('register.idChars');
 91:     case 'passwordShort':
 92:       return t('register.passwordTooShort', {
 93:         min: MIN_ACCOUNT_PASSWORD_LENGTH,
 94:       });
 95:     case 'passwordChars':
 96:       return t('register.passwordChars');
 97:     case 'mismatch':
 98:       return t('register.mismatch');
 99:   }
100: }
101: 
102: type RegisterWindowProps = {
103:   /** The account exists; the login window takes it from here. */
104:   onCreated: (username: string) => void;
105:   onCancel: () => void;
106: };
107: 
108: // `observer` for the language selector: every label here is a `t()`, and the
109: // login page's own render does not read one while this window is up.
110: export const RegisterWindow = observer(({ onCreated, onCancel }: RegisterWindowProps) => {
111:   const [values, setValues] = useState<Record<Field, string>>(EMPTY);
112:   const [error, setError] = useState<string>('');
113:   const [sending, setSending] = useState(false);
114: 
115:   const set = (field: Field, value: string) =>
116:     setValues(current => ({ ...current, [field]: value }));
117: 
118:   const submit = async () => {
119:     if (sending) return;
120: 
121:     const problem = validateSignup(values);
122: 
123:     if (problem) {
124:       setError(problemText(problem));
125:       return;
126:     }
127: 
128:     setError('');
129:     setSending(true);
130: 
131:     try {
132:       const response = await fetch(registerApiUrl(), {
133:         method: 'POST',
134:         headers: { 'Content-Type': 'application/json' },
135:         body: JSON.stringify({
136:           username: values.username,
137:           password: values.password,
138:         }),
139:       });
140: 
141:       const body = (await response.json().catch(() => ({}))) as {
142:         error?: string;
143:       };
144: 
145:       if (!response.ok) {
146:         // The service's own words: it is the one that knows the ID is taken or
147:         // that this network has had its account for today, and it says so in
148:         // English because it has no idea who is asking.
149:         setError(body.error || t('register.failed', { status: response.status }));
150:         setSending(false);
151:         return;
152:       }
153: 
154:       onCreated(values.username);
155:     } catch {
156:       // Offline, DNS, CORS - none of which the player can act on beyond
157:       // trying again.
158:       setError(t('register.unreachable'));
159:       setSending(false);
160:     }
161:   };
162: 
163:   return (
164:     <MuSpriteFrame
165:       file="login_back.OZT"
166:       width={WIN_WIDTH}
167:       height={WIN_HEIGHT}
168:       className="login-win"
169:     >
170:       <span className="login-label login-signup-title" style={{ top: TITLE_Y }}>
171:         {t('login.createAccount')}
172:       </span>
173: 
174:       <form
175:         onSubmit={e => {
176:           e.preventDefault();
