<file path="src/ui/pages/charactersPage/style.less">
  1: @import (reference) '../../components/muText/style.less';
  2: .characters-page {
  3:   position: absolute;
  4:   inset: 0;
  5:   .mu-font();
  6:   user-select: none;
  7: }
  8: 
  9: // `UIMng.cpp:264` places it at x = 22 and
 10: //   y = (567 / 600) * screenHeight - height - 11
 11: // which measured from the bottom is (33 / 600) * screenHeight + 11.
 12: .char-sel-bar {
 13:   position: absolute;
 14:   left: 22px;
 15:   right: 22px;
 16:   bottom: calc(5.5% + 11px);
 17: }
 18: 
 19: .char-sel-info {
 20:   position: absolute;
 21:   display: flex;
 22:   align-items: center;
 23:   justify-content: center;
 24: 
 25:   color: #ffffff;
 26:   font-size: 11px;
 27:   letter-spacing: 0.02em;
 28:   text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
 29:   white-space: nowrap;
 30:   overflow: hidden;
 31: }
 32: 
 33: // `CCharMakeWin`. `UIMng.cpp:269` puts it at
 34: //   ((screenWidth - 454) / 2, (screenHeight - 406) / 2)
 35: // i.e. dead centre. Everything inside is absolutely positioned from the
 36: // window's top-left, exactly as `SetPosition` does it - MU's UI is authored at
 37: // fixed pixel sizes and must never reflow.
 38: .char-make-win {
 39:   position: absolute;
 40:   left: 50%;
 41:   top: 50%;
 42:   transform: translate(-50%, -50%);
 43:   z-index: 20;
 44:   pointer-events: auto;
 45: }
 46: 
 47: // The 410x335 hole `RenderCreateCharacter` draws the class model into. It has
 48: // no background of its own; it only has to not swallow clicks meant for the
 49: // scene behind it.
 50: .char-make-preview {
 51:   position: absolute;
 52:   left: 0;
 53:   top: 0;
 54:   pointer-events: none;
 55: }
 56: 
 57: // `m_asprBack[CMW_SPR_STAT]` and `[CMW_SPR_DESC]`: untextured quads, black at
 58: // alpha 143/255, drawn by the sprite pipeline with no border or gradient.
 59: .char-make-panel {
 60:   position: absolute;
 61:   pointer-events: none;
 62: }
 63: 
 64: // `RenderControls` switches to `g_hFixFont` for the stats and the description,
 65: // so both are monospaced in the original.
 66: .char-make-stat,
 67: .char-make-desc {
 68:   position: absolute;
 69:   color: #ffffff;
 70:   font-family: 'Courier New', Consolas, monospace;
 71:   font-size: 11px;
 72:   line-height: 1;
 73:   white-space: nowrap;
 74:   text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
 75:   pointer-events: none;
 76: }
 77: 
 78: // `CLRDW_ORANGE` = ARGB(255, 255, 180, 0) (`UIBaseDef.h:16`).
 79: .char-make-stat-value {
 80:   color: #ffb400;
 81: }
 82: 
 83: // The `cha_id` plate is the field's background, so the input itself is
 84: // invisible chrome sitting on top of it, sized to `InputTextWidth`.
 85: .char-make-input {
 86:   position: absolute;
 87:   height: 14px;
 88:   padding: 0;
 89:   box-sizing: border-box;
 90:   pointer-events: auto;
