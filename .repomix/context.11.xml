 41:  * The signup text, on the checkbox row and left of it. That band is the only
 42:  * flat art left in the window - the frame's dragons take both bottom corners,
 43:  * so the space beside the buttons is not the empty half it looks like - and
 44:  * text rather than a button keeps it what it is: the way out of this window,
 45:  * not another thing to press before logging in.
 46:  *
 47:  * It leaves about 85px before the checkbox, which is what caps how long the
 48:  * translations of it may be.
 49:  */
 50: const REGISTER = { x: 22, y: CHECK_Y + 3 };
 51: 
 52: /** `CLoginWin::Render`: the server line in `g_hFixFont` at (111, 80). */
 53: const SERVER_LINE = { x: 111, y: 80 };
 54: 
 55: export const LoginPage = observer(() => {
 56:   const [registering, setRegistering] = useState(false);
 57:   /** "Account created" - shown where the login error would be, in green. */
 58:   const [notice, setNotice] = useState('');
 59: 
 60:   // The world being logged into, not the build: a client plays any world, and
 61:   // each one has its own signup service.
 62:   const signupApi = registerApiUrl();
 63:   // Only for a build that named a page but no endpoint. Then this window
 64:   // cannot create the account itself and links out, as it always did.
 65:   const signupPage = signupApi ? '' : registerUrl();
 66: 
 67:   const openRegister = () => {
 68:     setNotice('');
 69:     Store.loginError = undefined;
 70:     setRegistering(true);
 71:   };
 72: 
 73:   const onLoginClicked = () => {
 74:     if (Store.loginProcessing) return;
 75: 
 76:     setNotice('');
 77: 
 78:     if (!Store.username || !Store.password) {
 79:       Store.loginError = t('login.enterCredentials');
 80:       return;
 81:     }
 82: 
 83:     Store.loginError = undefined;
 84:     Store.loginProcessing = true;
 85: 
 86:     Store.loginRequest(Store.username, Store.password);
 87:   };
 88: 
 89:   // One window swapped for another: the logo, the scene behind it and the
 90:   // music are outside this and never notice.
 91:   if (registering) {
 92:     return (
 93:       <div className="login-page">
 94:         <MuLogo />
 95: 
 96:         <RegisterWindow
 97:           onCreated={username => {
 98:             Store.username = username;
 99:             Store.password = '';
100:             Store.loginError = undefined;
101:             setNotice(t('register.created'));
102:             setRegistering(false);
103:           }}
104:           onCancel={() => setRegistering(false)}
105:         />
106:       </div>
107:     );
108:   }
109: 
110:   return (
111:     <div className="login-page">
112:       <MuLogo />
113: 
114:       <MuSpriteFrame
115:         file="login_back.OZT"
116:         width={WIN_WIDTH}
117:         height={WIN_HEIGHT}
118:         className="login-win"
119:       >
120:         {/* GlobalText 460: "%s Server %d" - the server picked on the list. */}
121:         {Store.selectedServer && (
122:           <MuText
123:             face="fix"
124:             className="login-server-line"
125:             style={{ left: SERVER_LINE.x, top: SERVER_LINE.y }}
126:             text={
127:               Store.selectedServer.channelName
128:                 ? `${Store.selectedServer.name} - ${Store.selectedServer.channelName}`
129:                 : `${Store.selectedServer.name} Ch. ${Store.selectedServer.channel}`
130:             }
131:           />
132:         )}
133:         <form
134:           onSubmit={e => {
135:             e.preventDefault();
136:             onLoginClicked();
137:           }}
138:         >
139:           <span className="login-label" style={{ left: LABEL_X, top: 113 }}>
140:             {t('login.id')}
141:           </span>
142:           <span className="login-label" style={{ left: LABEL_X, top: 139 }}>
143:             {t('login.password')}
144:           </span>
145: 
146:           <MuSpriteFrame
147:             file="login_me.OZT"
148:             width={INPUT_WIDTH}
149:             height={INPUT_HEIGHT}
150:             style={{ position: 'absolute', left: INPUT_X, top: ACCOUNT_Y }}
151:           >
152:             {/* An ID is already there after a signup, or after "remember me":
153:                 the field still to fill is the password. */}
154:             <input
155:               className="login-input"
156:               type="text"
157:               autoFocus={!Store.username}
158:               value={Store.username}
159:               onChange={e => {
160:                 Store.username = e.target.value;
161:               }}
162:               maxLength={MAX_USERNAME_LENGTH}
163:               style={{ paddingLeft: TEXT_INSET_X, paddingTop: TEXT_INSET_Y }}
164:             />
165:           </MuSpriteFrame>
166: 
167:           <MuSpriteFrame
168:             file="login_me.OZT"
169:             width={INPUT_WIDTH}
170:             height={INPUT_HEIGHT}
171:             style={{ position: 'absolute', left: INPUT_X, top: PASSWORD_Y }}
172:           >
173:             <input
174:               className="login-input"
175:               type="password"
176:               autoFocus={!!Store.username}
177:               value={Store.password}
178:               onChange={e => {
179:                 Store.password = e.target.value;
180:               }}
181:               maxLength={MAX_PASSWORD_LENGTH}
182:               style={{ paddingLeft: TEXT_INSET_X, paddingTop: TEXT_INSET_Y }}
183:             />
184:           </MuSpriteFrame>
185: 
186:           {}
187:           <MuSpriteFrame
188:             file="op2_ch.OZT"
189:             y={Store.rememberLogin ? CHECK_SIZE : 0}
190:             width={CHECK_SIZE}
191:             height={CHECK_SIZE}
192:             style={{
193:               position: 'absolute',
194:               left: CHECK_X,
195:               top: CHECK_Y,
196:               cursor: 'pointer',
197:               pointerEvents: 'auto',
198:             }}
199:             onClick={uiClick(() => (Store.rememberLogin = !Store.rememberLogin))}
200:           />
201:           <span
202:             className="login-label login-remember"
203:             style={{ left: 130, top: 159 }}
204:             onClick={uiClick(() => (Store.rememberLogin = !Store.rememberLogin))}
205:           >
206:             {t('login.rememberMe')}
207:           </span>
208: 
209:           <MuButton
210:             file="message_ok_b_all.OZT"
211:             width={BUTTON_WIDTH}
212:             height={BUTTON_HEIGHT}
213:             frames={{ up: 0, active: 1, down: 2 }}
214:             color={TEXT_COLOR.brightGray}
215:             activeColor={TEXT_COLOR.white}
216:             disabled={Store.loginProcessing}
217:             onClick={onLoginClicked}
218:             style={{ position: 'absolute', left: OK_X, top: BUTTON_Y }}
219:           />
220:           <MuButton
221:             file="loding_cancel_b_all.OZT"
222:             width={BUTTON_WIDTH}
223:             height={BUTTON_HEIGHT}
224:             frames={{ up: 0, active: 1, down: 2 }}
225:             color={TEXT_COLOR.brightGray}
226:             activeColor={TEXT_COLOR.white}
227:             onClick={() => {
228:               Store.username = '';
229:               Store.password = '';
230:             }}
231:             style={{ position: 'absolute', left: CANCEL_X, top: BUTTON_Y }}
232:           />
233: 
234:           {/* Swaps this window for the register one. Nothing navigates: the
235:               scene behind stays where it is, which is the point. */}
236:           {!!signupApi && (
237:             <span
238:               className="login-register"
239:               style={{ left: REGISTER.x, top: REGISTER.y }}
240:               onClick={uiClick(openRegister)}
241:             >
242:               {t('login.createAccount')}
243:             </span>
244:           )}
245: 
246:           {/* A build that knows a signup page but no endpoint. A new tab, not
247:               this one: leaving would cost the scene the player waited for. */}
248:           {!!signupPage && (
249:             <a
250:               className="login-register"
251:               href={signupPage}
252:               target="_blank"
253:               rel="noopener noreferrer"
254:               style={{ left: REGISTER.x, top: REGISTER.y }}
255:               onClick={uiClick()}
256:             >
257:               {t('login.createAccount')}
258:             </a>
259:           )}
260: 
261:           {}
262:           <button type="submit" className="login-submit" tabIndex={-1} />
263:         </form>
264: 
265:         {!!Store.loginError && (
266:           <p className="login-error">{Store.loginError}</p>
267:         )}
268: 
269:         {!Store.loginError && !!notice && <p className="login-notice">{notice}</p>}
270:       </MuSpriteFrame>
271:     </div>
272:   );
273: });
