<file path="src/ui/pages/charactersPage/classPreview.ts">
  1: import {
  2:   UniversalCamera,
  3:   Vector3,
  4:   Viewport,
  5:   type Camera,
  6:   type CustomMaterial,
  7: } from '../../../libs/babylon/exports';
  8: import { loadGLTF, getMaterial } from '../../../common/modelLoader';
  9: import type { BlendState } from '../../../common/objects/enum';
 10: import { ModelObject } from '../../../common/modelObject';
 11: import { toRadians } from '../../../common/utils';
 12: import type { World } from '../../../ecs/world';
 13: import {
 14:   CLASS_RENDER_PARAMETERS,
 15:   DEFAULT_RENDER_PARAMETERS,
 16:   PREVIEW_CAMERA_FOV,
 17:   PREVIEW_CAMERA_OFFSET,
 18:   PREVIEW_IDLE_ACTION,
 19:   PREVIEW_INTRO_ACTION,
 20:   PREVIEW_PLAY_SPEED,
 21:   previewModelFile,
 22:   type ClassRenderParameters,
 23: } from './layout';
 24: 
 25: const PREVIEW_LAYER_MASK = 0x10000000;
 26: 
 27: const PREVIEW_ORIGIN = new Vector3(0, -100, 0);
 28: 
 29: const MU_SCALE = 100;
 30: 
 31: const CAMERA_NEAR = 0.1;
 32: const CAMERA_FAR = 100;
 33: 
 34: export type ClassPreview = {
 35:   setClass: (classType: number) => void;
 36:   dispose: () => void;
 37: };
 38: 
 39: function parametersFor(classType: number): ClassRenderParameters {
 40:   return CLASS_RENDER_PARAMETERS[classType] ?? DEFAULT_RENDER_PARAMETERS;
 41: }
 42: 
 43: export function createClassPreview(
 44:   world: World,
 45:   getRect: () => DOMRect | null
 46: ): ClassPreview {
 47:   const scene = world.scene;
 48:   const engine = scene.getEngine();
 49: 
 50:   const worldCamera = scene.activeCamera ?? scene.defaultCamera;
 51: 
 52:   const camera = new UniversalCamera(
 53:     'charMakePreview',
 54:     PREVIEW_ORIGIN.clone(),
 55:     scene
 56:   );
 57: 
 58:   if (scene.activeCamera !== worldCamera) scene.activeCamera = worldCamera;
 59: 
 60:   camera.layerMask = PREVIEW_LAYER_MASK;
 61:   camera.fov = toRadians(PREVIEW_CAMERA_FOV);
 62:   camera.minZ = CAMERA_NEAR;
 63:   camera.maxZ = CAMERA_FAR;
 64: 
 65:   camera.rotation.set(0, 0, 0);
 66: 
 67:   camera.position.set(
 68:     PREVIEW_ORIGIN.x + PREVIEW_CAMERA_OFFSET.x / MU_SCALE,
 69:     PREVIEW_ORIGIN.y + PREVIEW_CAMERA_OFFSET.z / MU_SCALE,
 70:     PREVIEW_ORIGIN.z + PREVIEW_CAMERA_OFFSET.y / MU_SCALE
 71:   );
 72: 
 73:   camera.viewport = new Viewport(0, 0, 0, 0);
 74: 
 75:   const stickyAngle = { x: 0, y: 0, z: 0 };
 76: 
 77:   const modelPosition = PREVIEW_ORIGIN.clone();
 78:   const modelRotation = Vector3.Zero();
 79: 
 80:   let model: ModelObject | null = null;
 81:   let currentClass = -1;
 82: 
 83:   const applyParameters = (object: ModelObject, classType: number) => {
 84:     const params = parametersFor(classType);
 85: 
 86:     if (params.overrideAngle) {
 87:       stickyAngle.x = params.angleX;
 88:       stickyAngle.y = params.angleY;
 89:       stickyAngle.z = params.angleZ;
 90:     }
 91: 
 92:     modelRotation.set(
 93:       -toRadians(stickyAngle.x),
 94:       -toRadians(stickyAngle.z),
 95:       -toRadians(stickyAngle.y)
 96:     );
 97: 
 98:     modelPosition.set(
 99:       PREVIEW_ORIGIN.x + params.positionOffsetX / MU_SCALE,
100:       PREVIEW_ORIGIN.y + params.positionOffsetZ / MU_SCALE,
101:       PREVIEW_ORIGIN.z
102:     );
103: 
104:     object.updateLocation(modelPosition, params.scale, modelRotation);
105:   };
106: 
107:   const setClass = (classType: number) => {
108:     if (classType === currentClass) return;
109:     currentClass = classType;
110: 
111:     model?.dispose();
112: 
113:     const object = new ModelObject(scene);
114:     object.CastsShadow = false;
115:     object.AnimationSpeed = PREVIEW_PLAY_SPEED;
116: 
117:     model = object;
118: 
119:     loadGLTF(previewModelFile(classType), world)
120:       .then(gltf => {
121:         object.load(gltf);
122: 
123:         if (model !== object) {
124:           object.dispose();
125:           return;
126:         }
127: 
128:         for (const mesh of gltf.mesh.getChildMeshes(false)) {
129:           mesh.layerMask = PREVIEW_LAYER_MASK;
130: 
131:           const source = mesh.material as CustomMaterial | null;
132: 
133:           if (source && !mesh.metadata?.brightMesh) {
134:             mesh.material = getMaterial(
135:               scene,
136:               source.backFaceCulling,
137:               source.transparencyMode ?? 0,
138:               source.alphaMode as BlendState,
139:               false,
140:               true
141:             );
142:           }
143:         }
144:         gltf.mesh.layerMask = PREVIEW_LAYER_MASK;
145: 
146:         applyParameters(object, classType);
147: 
148:         object.playAction(PREVIEW_INTRO_ACTION, false);
149: 
150:         gltf.animationGroups[PREVIEW_INTRO_ACTION]?.onAnimationGroupEndObservable.addOnce(
151:           () => {
152:             if (model !== object) return;
153:             object.playAction(PREVIEW_IDLE_ACTION, true);
154:           }
155:         );
156:       })
157:       .catch(error => {
158:         console.error(
159:           `Could not load the class preview for class type ${classType}:`,
160:           error
161:         );
162:       });
163:   };
164: 
165:   const updateViewport = (): boolean => {
166:     const canvas = engine.getRenderingCanvas();
167:     const rect = getRect();
168: 
169:     if (!canvas || !rect || rect.width <= 0 || rect.height <= 0) return false;
170: 
171:     const bounds = canvas.getBoundingClientRect();
172:     if (bounds.width <= 0 || bounds.height <= 0) return false;
173: 
174:     camera.viewport.x = (rect.left - bounds.left) / bounds.width;
175:     camera.viewport.y = 1 - (rect.bottom - bounds.top) / bounds.height;
176:     camera.viewport.width = rect.width / bounds.width;
177:     camera.viewport.height = rect.height / bounds.height;
178: 
179:     return true;
180:   };
181: 
182:   let cameras: Camera[] = [];
183: 
184:   const setCameras = (next: Camera[]) => {
185:     if (cameras.length === next.length && cameras[0] === next[0]) return;
186:     cameras = next;
187:     scene.activeCameras = next;
188:   };
189: 
190:   const beforeRender = scene.onBeforeRenderObservable.add(() => {
191:     setCameras(updateViewport() ? [worldCamera, camera] : [worldCamera]);
192:   });
193: 
194:   const afterRender = scene.onAfterRenderObservable.add(() => {
195:     if (scene.activeCamera !== worldCamera) scene.activeCamera = worldCamera;
196:   });
197: 
198:   const suppressed: { isEnabled: boolean }[] = [];
199: 
200:   const beforeCamera = scene.onBeforeCameraRenderObservable.add(active => {
201:     if (active !== camera) return;
202: 
203:     for (const layer of scene.effectLayers) {
204:       if (!layer.isEnabled) continue;
205:       layer.isEnabled = false;
206:       suppressed.push(layer);
207:     }
208:   });
209: 
210:   const afterCamera = scene.onAfterCameraRenderObservable.add(active => {
211:     if (active !== camera) return;
212: 
213:     for (const layer of suppressed) layer.isEnabled = true;
214:     suppressed.length = 0;
215:   });
216: 
217:   return {
218:     setClass,
219: 
220:     dispose: () => {
221:       scene.onBeforeRenderObservable.remove(beforeRender);
222:       scene.onAfterRenderObservable.remove(afterRender);
223:       scene.onBeforeCameraRenderObservable.remove(beforeCamera);
224:       scene.onAfterCameraRenderObservable.remove(afterCamera);
225: 
226:       for (const layer of suppressed) layer.isEnabled = true;
227:       suppressed.length = 0;
228: 
229:       scene.activeCameras = [];
230:       scene.activeCamera = worldCamera;
231: 
232:       model?.dispose();
233:       model = null;
234: 
235:       camera.dispose();
236:     },
237:   };
238: }
</file>

