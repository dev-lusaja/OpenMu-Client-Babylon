<file path="src/ui/pages/preloaderPage/worldsTab.tsx">
  1: import { uiClick } from '../../../libs/sfx';
  2: import { useEffect, useState } from 'react';
  3: import { observer } from 'mobx-react-lite';
  4: import { MuSpriteFrame } from '../../components/muSprite';
  5: import { MuButton } from '../../components/muButton';
  6: import { DECO, SPRITE as SERVERS_SPRITE, TEXT_COLOR } from '../serversPage/layout';
  7: import { t, type TextKey } from '../../../i18n';
  8: import { playableHere, ServerConfig, type ServerProfile } from '../../../common/serverConfig';
  9: import { ServerAccounts } from '../../../common/serverAccounts';
 10: import { refreshServerList, ServerList } from '../../../common/serverList';
 11: import { ServerProbe, type Reach } from '../../../common/serverProbe';
 12: import { Plate } from './frame';
 13: import {
 14:   PAGE_ARROW,
 15:   SPRITE,
 16:   WORLD_CARD_ART_HEIGHT,
 17:   WORLD_CARD_BAR_HEIGHT,
 18:   WORLD_CARD_WIDTH,
 19:   WORLD_COLS,
 20:   WORLD_COL_STEP,
 21:   WORLD_FILTER_Y,
 22:   WORLD_GRID_TOP,
 23:   WORLD_GRID_X,
 24:   WORLD_HEAD_X,
 25:   WORLD_PAGE_NEXT_X,
 26:   WORLD_PAGE_PREV_X,
 27:   WORLD_ROW_STEP,
 28:   WORLD_SEARCH_HEIGHT,
 29:   WORLD_SEARCH_WIDTH,
 30:   WORLD_SEARCH_Y,
 31: } from './layout';
 32: 
 33: /**
 34:  * The worlds: every server the client knows of, as a grid of cards.
 35:  *
 36:  * A card is the world's own banner with the server-list row art under it - MU's
 37:  * list rows already carry the hover and pressed states a card wants, and the
 38:  * name and language tag sit on them the way a server name sits on the server
 39:  * screen. A world with no banner of its own gets the MU mark on stone rather
 40:  * than a hole in the grid.
 41:  *
 42:  * Four things the grid says beyond the name. Whether the world answers, which
 43:  * `serverProbe` finds out by dialling it the way the game would. Whether it is
 44:  * the player's own or somebody's published row, because the two sit in one list
 45:  * and only the tag tells them apart. Which one they last played, which
 46:  * `ServerConfig.all` floats to the front. And whether they have an account
 47:  * saved on it, because with one list holding a dozen strangers' worlds that is
 48:  * the difference between entering and signing up.
 49:  */
 50: 
 51: const LOGO_SPRITE = 'Data/Logo/MU-logo.OZT';
 52: 
 53: /** What the dot means, as its tooltip. `unknown` draws no dot at all. */
 54: export const REACH_TEXT: Record<Exclude<Reach, 'unknown'>, TextKey> = {
 55:   checking: 'worlds.checking',
 56:   up: 'worlds.answering',
 57:   down: 'worlds.noAnswer',
 58: };
 59: 
 60: /**
 61:  * The stone-and-mark tile a card falls back to. It is what a world with no
 62:  * banner of its own gets, and - since a published banner is somebody else's
 63:  * URL on somebody else's host - what a banner that fails to load gets too. A
 64:  * browser's broken-image glyph in the middle of a grid of MU art is worse than
 65:  * no banner at all.
 66:  */
 67: export const CardStone = ({
 68:   width = WORLD_CARD_WIDTH,
 69:   height = WORLD_CARD_ART_HEIGHT,
 70: }: {
 71:   width?: number;
 72:   height?: number;
 73: }) => (
 74:   <MuSpriteFrame
 75:     file={SPRITE.optionFill}
 76:     width={width}
 77:     height={height}
 78:     className="world-card-art"
 79:     style={{ backgroundRepeat: 'repeat' }}
 80:   >
 81:     <MuSpriteFrame
 82:       file={LOGO_SPRITE}
 83:       style={{
 84:         position: 'absolute',
 85:         inset: 0,
 86:         backgroundSize: '60% auto',
 87:         backgroundPosition: 'center',
 88:         opacity: 0.55,
 89:       }}
 90:     />
 91:   </MuSpriteFrame>
 92: );
 93: 
 94: /**
 95:  * A published banner, faded up once its bytes are in. Mounted under its own URL
 96:  * as a key, so a world whose banner changes gets a fresh one of these rather
 97:  * than an effect resetting the old one's state.
 98:  */
 99: export const CardArt = ({
100:   src,
101:   width = WORLD_CARD_WIDTH,
102:   height = WORLD_CARD_ART_HEIGHT,
103: }: {
104:   src: string;
105:   width?: number;
106:   height?: number;
107: }) => {
108:   const [broken, setBroken] = useState(false);
109:   const [loaded, setLoaded] = useState(false);
110: 
111:   if (broken) return <CardStone width={width} height={height} />;
112: 
113:   return (
114:     <img
115:       className={`world-card-art${loaded ? ' world-card-art-in' : ''}`}
116:       src={src}
117:       alt=""
118:       style={{ width, height }}
119:       // A banner already in the cache has loaded before React can attach
120:       // `onLoad`, so the ref catches the ones the event would miss.
121:       ref={img => {
122:         if (img?.complete && img.naturalWidth) setLoaded(true);
123:       }}
124:       onLoad={() => setLoaded(true)}
125:       onError={() => setBroken(true)}
126:     />
127:   );
128: };
129: 
130: const WorldCard = ({
131:   world,
132:   selected,
133:   lastPlayed,
134:   hasAccount,
135:   playable,
136:   reach,
137:   left,
138:   top,
139:   onSelect,
140:   onEnter,
141: }: {
142:   world: ServerProfile;
143:   selected: boolean;
144:   lastPlayed: boolean;
145:   hasAccount: boolean;
146:   playable: boolean;
147:   reach: Reach;
148:   left: number;
149:   top: number;
150:   onSelect: () => void;
151:   onEnter: () => void;
152: }) => {
153:   return (
154:     <div
155:       className={`world-card${selected ? ' world-card-on' : ''}${
156:         playable ? '' : ' world-card-off'
157:       }`}
158:       style={{ left, top, width: WORLD_CARD_WIDTH }}
159:       onClick={uiClick(onSelect)}
160:       onDoubleClick={onEnter}
161:     >
162:       {world.image ? (
163:         <CardArt key={world.image} src={world.image} />
164:       ) : (
165:         <CardStone />
166:       )}
167: 
168:       {/* The world last entered, marked where it is floated to: first in the
169:           grid for a reason the player can see rather than guess at. */}
170:       {lastPlayed && (
171:         <span className="world-last" title={t('worlds.lastPlayed')} />
172:       )}
173: 
174:       {/* Which client the world is published for. It is the first thing its
175:           line says, and with more than one version in the client it is the
176:           thing that decides what the player is about to load - so it is on
177:           every card that names one, and only turns red when this client does
178:           not carry it. */}
179:       {world.version && (
180:         <span className={`world-version${playable ? '' : ' world-version-off'}`}>
181:           {world.version}
182:         </span>
183:       )}
184: 
185:       {/* An account is saved here. Beside the version rather than in a corner
186:           of its own: both are about what happens after Enter is pressed. */}
187:       {hasAccount && (
188:         <span className="world-account" title={t('worlds.hasAccount')}>
189:           {t('worlds.accountMark')}
190:         </span>
191:       )}
192: 
193:       {/* Whether it answers, on the banner rather than the name row: the row is
194:           already carrying a tag on that side, and this belongs to the world. */}
195:       {reach !== 'unknown' && (
196:         <span
197:           className={`world-dot world-dot-${reach}`}
198:           title={t(REACH_TEXT[reach])}
199:         />
200:       )}
201: 
202:       <MuButton
203:         file={SPRITE.menuButton}
204:         width={WORLD_CARD_WIDTH}
205:         height={WORLD_CARD_BAR_HEIGHT}
206:         frames={{ up: 0, active: 1, down: 2 }}
207:         color={selected ? TEXT_COLOR.brightYellow : TEXT_COLOR.brightGray}
208:         activeColor={TEXT_COLOR.white}
209:         label={world.name.trim() || t('server.unnamed')}
210:         onClick={onSelect}
211:         style={{ position: 'absolute', left: 0, top: WORLD_CARD_ART_HEIGHT }}
212:         labelStyle={{ fontSize: 11 }}
213:       >
214:         {/* Published rows wear their language; the player's own wear the mark
215:             that says the fields behind the setup tab are theirs to edit. */}
216:         <span className={`setup-row-tag${world.listed ? '' : ' world-tag-mine'}`}>
217:           {world.listed
218:             ? (world.language ?? '').toUpperCase()
219:             : t('worlds.yours')}
220:         </span>
221:       </MuButton>
222:     </div>
223:   );
224: };
225: 
226: /** Rows of cards this viewport has room for, remeasured when it changes. */
227: export function useWorldRows(rowsFor: (height: number) => number): number {
228:   const [rows, setRows] = useState(() => rowsFor(window.innerHeight));
229: 
230:   useEffect(() => {
231:     const onResize = () => setRows(rowsFor(window.innerHeight));
232: 
233:     window.addEventListener('resize', onResize);
234:     onResize();
235: 
236:     return () => window.removeEventListener('resize', onResize);
237:   }, [rowsFor]);
238: 
239:   return rows;
240: }
241: 
242: export const WorldsTab = observer(
243:   ({
244:     worlds,
245:     visible,
246:     total,
247:     search,
248:     onSearch,
249:     language,
250:     onLanguage,
251:     pages,
252:     page,
253:     onPage,
254:     arrowsY,
255:     onEnter,
256:   }: {
257:     /** Everything that survived both filters, for the count line. */
258:     worlds: ServerProfile[];
259:     /** The page of it that is on screen. */
260:     visible: ServerProfile[];
261:     /** Worlds before either filter, so the count can say "3 of 12". */
262:     total: number;
263:     search: string;
264:     onSearch: (text: string) => void;
265:     language: string;
266:     onLanguage: (tag: string) => void;
267:     pages: number;
268:     page: number;
269:     onPage: (page: number) => void;
270:     /** The button row the paging arrows flank. */
271:     arrowsY: number;
272:     onEnter: (id: string) => void;
273:   }) => {
274:     const selected = ServerConfig.active;
275: 
276:     // Only what is on screen is dialled, and only once it is: a grid that
277:     // probes every published world at launch is a port scanner with a banner.
278:     useEffect(() => {
279:       void ServerProbe.check(visible);
280:     }, [visible]);
281: 
282:     const refresh = () => {
283:       ServerProbe.forget();
284:       void refreshServerList();
285:     };
286: 
287:     return (
288:       <>
289:         {/* The search box, with the refresh link on its right. */}
290:         <Plate
291:           width={WORLD_SEARCH_WIDTH}
292:           height={WORLD_SEARCH_HEIGHT}
293:           left={WORLD_HEAD_X}
294:           top={WORLD_SEARCH_Y}
295:         >
296:           <input
297:             className="setup-input world-search"
298:             type="text"
299:             value={search}
300:             placeholder={t('worlds.search')}
301:             onChange={e => onSearch(e.target.value)}
302:           />
303:         </Plate>
304:         {!!search && (
305:           <span
306:             className="world-search-clear"
307:             title={t('worlds.clearSearch')}
308:             style={{
309:               left: WORLD_HEAD_X + WORLD_SEARCH_WIDTH - 16,
310:               top: WORLD_SEARCH_Y + 4,
311:             }}
312:             onClick={uiClick(() => onSearch(''))}
313:           >
314:             ×
315:           </span>
316:         )}
317:         <div
318:           className="world-head"
319:           style={{
320:             top: WORLD_SEARCH_Y + 3,
321:             left: WORLD_HEAD_X + WORLD_SEARCH_WIDTH + 8,
322:             right: WORLD_HEAD_X,
323:           }}
324:         >
325:           <span
326:             className={`world-chip${ServerList.state === 'loading' ? ' world-chip-busy' : ''}`}
327:             onClick={uiClick(refresh)}
328:           >
329:             {t('worlds.refresh')}
330:           </span>
331:         </div>
332: 
333:         {/* The language chips, with what the two filters left on the right. */}
334:         <div
335:           className="world-head"
336:           style={{ top: WORLD_FILTER_Y, left: WORLD_HEAD_X, right: WORLD_HEAD_X }}
337:         >
338:           <div className="world-filter">
339:             {ServerConfig.languages.length > 1 &&
340:               ['', ...ServerConfig.languages].map(tag => (
341:                 <span
342:                   key={tag || 'all'}
343:                   className={`world-chip${tag === language ? ' world-chip-on' : ''}`}
344:                   onClick={uiClick(() => onLanguage(tag))}
345:                 >
346:                   {tag ? tag.toUpperCase() : t('worlds.filterAll')}
347:                 </span>
348:               ))}
349:           </div>
350:           {worlds.length < total && (
351:             <span className="world-count">
352:               {t('worlds.count', { shown: worlds.length, total })}
353:             </span>
354:           )}
355:         </div>
356: 
357:         {pages > 1 &&
358:           (
359:             [
360:               { key: 'prev', rect: DECO.arrowLeft, x: WORLD_PAGE_PREV_X, step: -1 },
361:               { key: 'next', rect: DECO.arrowRight, x: WORLD_PAGE_NEXT_X, step: 1 },
362:             ] as const
363:           ).map(arrow => (
364:             <MuSpriteFrame
365:               key={arrow.key}
366:               file={SERVERS_SPRITE.deco}
367:               {...arrow.rect}
368:               style={{
369:                 position: 'absolute',
370:                 left: arrow.x,
371:                 top: arrowsY + 1,
372:                 width: PAGE_ARROW.width,
373:                 height: PAGE_ARROW.height,
374:                 cursor: 'pointer',
375:                 pointerEvents: 'auto',
376:               }}
377:               onClick={uiClick(() => onPage((page + arrow.step + pages) % pages))}
378:             />
379:           ))}
380: 
381:         {visible.map((world, i) => (
382:           <WorldCard
383:             key={world.id}
384:             world={world}
385:             selected={world.id === selected.id}
386:             lastPlayed={world.id === ServerConfig.lastPlayedId}
387:             hasAccount={ServerAccounts.has(world.id)}
388:             playable={playableHere(world)}
389:             reach={ServerProbe.of(world.id)}
390:             left={WORLD_GRID_X + WORLD_COL_STEP * (i % WORLD_COLS)}
391:             top={WORLD_GRID_TOP + WORLD_ROW_STEP * Math.floor(i / WORLD_COLS)}
392:             onSelect={() => ServerConfig.select(world.id)}
393:             onEnter={() => onEnter(world.id)}
394:           />
395:         ))}
396:       </>
397:     );
398:   }
399: );
</file>

