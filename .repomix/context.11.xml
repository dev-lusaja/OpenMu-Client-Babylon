233: export function separateTextIntoLines(
234:   text: string,
235:   maxLines: number,
236:   lineSize: number
237: ): string[] {
238:   const lines: string[] = [];
239:   let line = '';
240:   let lastSpace = -1;
241: 
242:   for (let i = 0; i < text.length; i++) {
243:     if (1 + line.length >= lineSize) {
244:       if (lastSpace >= 0 && line.length - lastSpace - 1 < Math.min(10, lineSize / 2)) {
245:         i -= line.length - lastSpace - 1;
246:         line = line.slice(0, lastSpace);
247:       }
248: 
249:       lines.push(line);
250:       if (lines.length >= maxLines) return lines;
251: 
252:       line = '';
253:       lastSpace = -1;
254:     }
255: 
256:     if (text[i] === ' ') lastSpace = line.length;
257:     line += text[i];
258:   }
259: 
260:   lines.push(line);
261: 
262:   return lines;
263: }
