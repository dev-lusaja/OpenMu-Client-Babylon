  4: import { observer } from 'mobx-react-lite';
  5: import { Store } from '../../../store';
  6: import { ConnectionInfoRequestPacket } from '../../../common/packets/ConnectServerPackets';
  7: import {
  8:   ServerConfig,
  9:   type PublishedGameServer,
 10: } from '../../../common/serverConfig';
 11: import { MuButton } from '../../components/muButton';
 12: import { MuSpriteFrame } from '../../components/muSprite';
 13: import { ServerItem } from './ServerItem';
 14: import { DescriptionBar } from './DescriptionBar';
 15: import {
 16:   CENTER_GROUP_X,
 17:   CENTER_GROUP_Y,
 18:   DECO,
 19:   GROUP_BASE_Y,
 20:   GROUP_BTN_HEIGHT,
 21:   GROUP_BTN_WIDTH,
 22:   LEFT_GROUP_MAX,
 23:   LEFT_GROUP_X,
 24:   RIGHT_GROUP_MAX,
 25:   RIGHT_GROUP_X,
 26:   SERVER_BTN_HEIGHT,
 27:   SERVER_BTN_X,
 28:   SERVER_MAX,
 29:   SPRITE,
 30:   TEXT_COLOR,
 31:   WIN_HEIGHT,
 32:   WIN_WIDTH,
 33:   serverListTop,
 34: } from './layout';
 35: 
 36: type Server = { ServerId: number; LoadPercentage: number };
 37: 
 38: /** `name` only when the world published one; the row numbers itself if not. */
 39: type Channel = Server & { name?: string };
 40: 
 41: type ServerGroup = {
 42:   id: number;
 43:   name: string;
 44:   servers: Channel[];
 45: };
 46: 
 47: /**
 48:  * The connect server sends ids and load and no text at all, so every label on
 49:  * this screen is either a name the world published (`serverlist.md`, carried
 50:  * on the profile) or the numbered default the original client used.
 51:  */
 52: function groupServers(
 53:   servers: Server[],
 54:   published: PublishedGameServer[]
 55: ): ServerGroup[] {
 56:   const byGroup = new Map<number, Server[]>();
 57: 
 58:   for (const server of servers) {
 59:     const groupId = server.ServerId >> 8;
 60:     const existing = byGroup.get(groupId);
 61: 
 62:     if (existing) existing.push(server);
 63:     else byGroup.set(groupId, [server]);
 64:   }
 65: 
 66:   return [...byGroup.entries()]
 67:     .sort((a, b) => a[0] - b[0])
 68:     .map(([id, list]) => {
 69:       const named = published.find(entry => entry.id === id);
 70: 
 71:       return {
 72:         id,
 73:         name: named?.name || t('servers.serverName', { number: id + 1 }),
 74:         servers: list
 75:           .sort((a, b) => a.ServerId - b.ServerId)
 76:           .map(server => ({
 77:             ...server,
 78:             name: named?.channels.find(c => c.id === (server.ServerId & 0xff))
 79:               ?.name,
 80:           })),
 81:       };
 82:     });
 83: }
 84: 
 85: export const ServersPage = observer(() => {
 86:   const [selectedGroup, setSelectedGroup] = useState<number | null>(null);
 87: 
 88:   // The names the selected world published, which is nothing at all for an
 89:   // address the player typed in themselves.
 90:   const published = ServerConfig.active.servers;
 91: 
 92:   const groups = useMemo(
 93:     () => groupServers(Store.serverList, published ?? []),
 94:     [Store.serverList, published]
 95:   );
 96: 
 97:   const activeGroup =
 98:     groups.find(g => g.id === selectedGroup) ?? (groups.length ? groups[0] : null);
 99: 
100:   const onConnectClick = async (serverId: number) => {
101:     // `SetSelectServer`: what the login window prints under its title.
102:     const group = groups.find(g => g.servers.some(s => s.ServerId === serverId));
103:     const channel = group?.servers.find(s => s.ServerId === serverId);
104:     Store.selectedServer = {
105:       name:
106:         group?.name ??
107:         t('servers.serverName', { number: (serverId >> 8) + 1 }),
108:       channel: (group?.servers.findIndex(s => s.ServerId === serverId) ?? 0) + 1,
109:       // A named channel replaces the "Ch. 2" the login line falls back to.
110:       channelName: channel?.name,
111:     };
112:     const packet = ConnectionInfoRequestPacket.createPacket();
113:     packet.ServerId = serverId;
114: 
115:     Store.sendToCS(packet.buffer);
116:   };
117: 
118: const leftGroups = groups.slice(0, LEFT_GROUP_MAX);
119:   const rightGroups = groups.slice(
120:     LEFT_GROUP_MAX,
121:     LEFT_GROUP_MAX + RIGHT_GROUP_MAX
122:   );
123: 
124:   const listTop = serverListTop(activeGroup?.servers.length ?? 0);
125: 
126:   const renderGroup = (group: ServerGroup, x: number, index: number) => (
127:     <MuButton
128:       key={group.id}
129:       file={SPRITE.groupButton}
130:       width={GROUP_BTN_WIDTH}
131:       height={GROUP_BTN_HEIGHT}
132:       frames={{ up: 0, active: 1, down: 2, check: 3 }}
133:       color={TEXT_COLOR.brightGray}
134:       activeColor={TEXT_COLOR.white}
135:       checked={activeGroup?.id === group.id}
136:       label={group.name}
137:       onClick={() => setSelectedGroup(group.id)}
138:       style={{
139:         position: 'absolute',
140:         left: x,
141:         top: GROUP_BASE_Y + GROUP_BTN_HEIGHT * index,
142:       }}
143:       labelStyle={{
144:         fontSize: 11,
145:         textShadow: '1px 1px 0 rgba(0, 0, 0, 0.85)',
146:       }}
147:     />
148:   );
149: 
150:   const selectedIndex = activeGroup
151:     ? groups.findIndex(g => g.id === activeGroup.id)
152:     : -1;
153: 
154:   const arrow =
155:     selectedIndex < 0
156:       ? null
157:       : selectedIndex < LEFT_GROUP_MAX
158:         ? {
159:             rect: DECO.arrowLeft,
160:             left: LEFT_GROUP_X + GROUP_BTN_WIDTH,
161:             top: GROUP_BASE_Y + GROUP_BTN_HEIGHT * selectedIndex,
162:           }
163:         : {
164:             rect: DECO.arrowRight,
165:             left: RIGHT_GROUP_X - DECO.arrowRight.width,
166:             top:
167:               GROUP_BASE_Y +
168:               GROUP_BTN_HEIGHT * (selectedIndex - LEFT_GROUP_MAX),
169:           };
170: 
171:   return (
172:     <div className="servers-page">
173:       <div className="server-sel-win" style={{ width: WIN_WIDTH, height: WIN_HEIGHT }}>
174:         {Store.connectionLost && (
175:           <div className="servers-notice">{t('servers.connectionLost')}</div>
176:         )}
177:         {groups.length === 0 ? (
178:           <div className="servers-loading">{t('servers.loading')}</div>
179:         ) : (
180:           <>
181:             {}
182:             {leftGroups.length > 0 && (
183:               <MuSpriteFrame
184:                 file={SPRITE.deco}
185:                 {...DECO.left}
186:                 style={{
187:                   position: 'absolute',
188:                   left: LEFT_GROUP_X,
189:                   top: GROUP_BASE_Y,
190:                   pointerEvents: 'none',
191:                 }}
192:               />
193:             )}
194:             {rightGroups.length > 0 && (
195:               <MuSpriteFrame
196:                 file={SPRITE.deco}
197:                 {...DECO.right}
198:                 style={{
199:                   position: 'absolute',
200:                   left: RIGHT_GROUP_X + GROUP_BTN_WIDTH - DECO.right.width,
201:                   top: GROUP_BASE_Y,
202:                   pointerEvents: 'none',
203:                 }}
204:               />
205:             )}
206: 
207:             {leftGroups.map((group, i) => renderGroup(group, LEFT_GROUP_X, i))}
208:             {rightGroups.map((group, i) =>
209:               renderGroup(group, RIGHT_GROUP_X, i)
210:             )}
211: 
212:             {arrow && (
213:               <MuSpriteFrame
214:                 file={SPRITE.deco}
215:                 {...arrow.rect}
216:                 style={{
217:                   position: 'absolute',
218:                   left: arrow.left,
219:                   top: arrow.top,
220:                   pointerEvents: 'none',
221:                 }}
222:               />
223:             )}
224: 
225:             <div
226:               style={{
227:                 position: 'absolute',
228:                 left: SERVER_BTN_X,
229:                 top: listTop,
230:                 width: 0,
231:                 height: 0,
232:               }}
233:             >
234:               {activeGroup?.servers.slice(0, SERVER_MAX).map((server, i) => (
235:                 <ServerItem
236:                   key={server.ServerId}
237:                   name={
238:                     server.name ||
239:                     t('servers.serverName', {
240:                       number: (server.ServerId & 0xff) + 1,
241:                     })
242:                   }
243:                   load={server.LoadPercentage}
244:                   top={SERVER_BTN_HEIGHT * i}
245:                   onClick={() => onConnectClick(server.ServerId)}
246:                 />
247:               ))}
248:             </div>
249: 
250:             <DescriptionBar
251:               text={
252:                 activeGroup
253:                   ? `${activeGroup.name} - ${activeGroup.servers.length} channel${
254:                       activeGroup.servers.length === 1 ? '' : 's'
255:                     }`
256:                   : undefined
257:               }
258:             />
259:           </>
260:         )}
261:       </div>
262:     </div>
263:   );
264: });
265: 
266: export const TEST_SERVER_SLOT = { x: CENTER_GROUP_X, y: CENTER_GROUP_Y };
</file>

