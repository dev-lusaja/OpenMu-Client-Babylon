<file path="src/ui/pages/worldPage/components/minimap/corner.tsx">
  1: import './style.less';
  2: import { useLayoutEffect, useRef, useState } from 'react';
  3: import { observer } from 'mobx-react-lite';
  4: import { Store } from '../../../../../store';
  5: import { GameOptions, uiScaleFactor } from '../../../../../common/gameOptions';
  6: import type { MinimapMarker } from '../../../../../common/minimapData';
  7: import { MuTipText } from '../../../../components/muText';
  8: import {
  9:   CenterButton,
 10:   Frame,
 11:   HERO_SIZE,
 12:   HERO_SPRITE,
 13:   isPanned,
 14:   MAP_ROTATION,
 15:   MARKER_SIZE,
 16:   MARKER_SPRITE,
 17:   NO_PAN,
 18:   NPC_SIZE,
 19:   NPC_SPRITE,
 20:   Sprite,
 21:   TERRAIN_SIZE,
 22:   useMapDrag,
 23:   usePartyMarkers,
 24:   useWorldMinimap,
 25:   type MapPan,
 26: } from './shared';
 27: 
 28: /**
 29:  * The corner minimap: ours. The original's one map is the TAB sheet
 30:  * (`CNewUIMiniMap`, `sheet.tsx`); later clients keep a small copy of it in
 31:  * the top right corner of the play area, and this is that - the same
 32:  * `mini_map.ozt`, the same 45° spin about the hero, the same marker files,
 33:  * drawn small and left on screen. TAB still opens the sheet, over it;
 34:  * the panel steps aside while the sheet is up.
 35:  *
 36:  * Laid out in the sheet's art units (its 35 px corners, 15 / 30 px markers)
 37:  * and scaled as one element, so the frame and the markers keep the sheet's
 38:  * proportions at any interface size. The bar under it (the coordinates, and
 39:  * the Center button while the map is dragged off the hero) is scaled back
 40:  * up to the interface size, so its text and plate match every other button.
 41:  *
 42:  * The hero moves every frame and nothing here re-renders for it: the
 43:  * markers and the hero are children of the map picture at their own tile,
 44:  * and one frame loop slides the picture under the fixed centre and writes
 45:  * the hero's place and the coordinates.
 46:  */
 47: 
 48: const PANEL = 240;
 49: /** Art units to CSS pixels at interface size 100%. */
 50: const PANEL_SCALE = 0.75;
 51: 
 52: /** Map edge length per zoom step, in art units; the sheet draws 800. */
 53: const ZOOM_LEVELS = [512, 640, 768, 1024, 1280];
 54: const DEFAULT_ZOOM = 2;
 55: 
 56: const MapMarker = ({ marker, mapSize }: { marker: MinimapMarker; mapSize: number }) => {
 57:   const [hovered, setHovered] = useState(false);
 58:   const size = MARKER_SIZE[marker.kind] ?? NPC_SIZE;
 59: 
 60:   // Its tile on the picture: U along tile Y, V along tile X, as the sheet.
 61:   // Upright again inside the spun picture; the sprite then turns by its own
 62:   // yaw, which leaves the tip box upright too.
 63:   return (
 64:     <div
 65:       className="minimap-corner-marker"
 66:       style={{
 67:         left: (marker.y / TERRAIN_SIZE) * mapSize - size / 2,
 68:         top: (marker.x / TERRAIN_SIZE) * mapSize - size / 2,
 69:         width: size,
 70:         height: size,
 71:         transform: `rotate(${-MAP_ROTATION}deg)`,
 72:       }}
 73:       onMouseEnter={() => setHovered(true)}
 74:       onMouseLeave={() => setHovered(false)}
 75:     >
 76:       <Sprite
 77:         file={MARKER_SPRITE[marker.kind] ?? NPC_SPRITE}
 78:         size={size}
 79:         style={{ transform: `rotate(${marker.rotation}deg)` }}
 80:       />
 81:       {hovered && (
 82:         <MuTipText
 83:           text={marker.name}
 84:           background="rgba(0,0,0,0.7)"
 85:           className="minimap-corner-tip"
 86:         />
 87:       )}
 88:     </div>
 89:   );
 90: };
 91: 
 92: export const MinimapCorner = observer(() => {
 93:   const world = Store.world;
 94:   // Under the sheet it would only be a dimmed ghost of the same map.
 95:   const shown = !!world && !Store.minimapEnabled;
 96:   // `mapIndex` is a plain field: the frame loop below carries a warp over.
 97:   const [map, setMap] = useState<number | undefined>(undefined);
 98:   const minimap = useWorldMinimap(shown ? map : undefined);
 99:   const partyMarkers = usePartyMarkers(shown, map);
100:   const [zoom, setZoom] = useState(DEFAULT_ZOOM);
101:   const [pan, setPan] = useState<MapPan>(NO_PAN);
102:   const pictureRef = useRef<HTMLDivElement>(null);
103:   const heroRef = useRef<HTMLDivElement>(null);
104:   const coordsRef = useRef<HTMLDivElement>(null);
105:   const scale = PANEL_SCALE * uiScaleFactor(GameOptions.uiScale);
106:   const mapSize = ZOOM_LEVELS[zoom];
107:   const { dragging, handlers } = useMapDrag(mapSize, scale, setPan);
108: 
109:   // Before paint, so the picture never shows its top-left corner for a frame.
110:   useLayoutEffect(() => {
111:     if (!shown) return;
112: 
113:     let frame = 0;
114:     let lastMap = map;
115:     let lastX = NaN;
116:     let lastY = NaN;
117: 
118:     const tick = () => {
119:       frame = requestAnimationFrame(tick);
120: 
121:       const current = Store.world;
122:       if (!current) return;
123:       if (current.mapIndex !== lastMap) {
124:         lastMap = current.mapIndex;
125:         setMap(lastMap);
126:         // A warp: back on the hero.
127:         setPan(NO_PAN);
128:       }
129: 
130:       const pos = current.playerEntity?.transform?.pos;
131:       const picture = pictureRef.current;
132:       if (!pos || !picture || (pos.x === lastX && pos.z === lastY)) return;
133:       lastX = pos.x;
134:       lastY = pos.z;
135: 
136:       const heroTx = (pos.z / TERRAIN_SIZE) * mapSize;
137:       const heroTy = (pos.x / TERRAIN_SIZE) * mapSize;
138:       const tx = heroTx + (pan.u / TERRAIN_SIZE) * mapSize;
139:       const ty = heroTy + (pan.v / TERRAIN_SIZE) * mapSize;
140:       picture.style.transform = `translate(${-tx}px, ${-ty}px)`;
141:       const hero = heroRef.current;
142:       if (hero) {
143:         hero.style.left = `${heroTx - HERO_SIZE / 2}px`;
144:         hero.style.top = `${heroTy - HERO_SIZE / 2}px`;
145:       }
146:       if (coordsRef.current) {
147:         coordsRef.current.textContent = `${Math.floor(pos.x)}, ${Math.floor(pos.z)}`;
148:       }
149:     };
150: 
151:     tick();
152:     return () => cancelAnimationFrame(frame);
153:   }, [shown, map, mapSize, minimap, pan]);
154: 
155:   if (!shown || !minimap) return null;
156: 
157:   const onWheel = (event: React.WheelEvent) => {
158:     setZoom(z =>
159:       Math.max(0, Math.min(ZOOM_LEVELS.length - 1, z + (event.deltaY < 0 ? 1 : -1)))
160:     );
161:   };
162: 
163:   return (
164:     <div
165:       className="minimap-corner-panel"
166:       style={{ width: PANEL, height: PANEL, transform: `scale(${scale})` }}
167:       onWheel={onWheel}
168:       onContextMenu={e => e.preventDefault()}
169:     >
170:       <div className={`minimap-corner-clip${dragging ? ' is-dragging' : ''}`} {...handlers}>
171:         <div
172:           className="minimap-corner-spin"
173:           style={{ transform: `rotate(${MAP_ROTATION}deg)` }}
174:         >
175:           <div
176:             ref={pictureRef}
177:             className="minimap-corner-map"
178:             style={{
179:               width: mapSize,
180:               height: mapSize,
181:               backgroundImage: `url(${minimap.image.url})`,
182:             }}
183:           >
184:             {minimap.markers.map((marker, i) => (
185:               <MapMarker key={i} marker={marker} mapSize={mapSize} />
186:             ))}
187:             {partyMarkers.map((marker, i) => (
