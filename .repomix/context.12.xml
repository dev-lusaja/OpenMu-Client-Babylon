459:     // Right button puts the hammer down.
460:     if (Store.repairMode) {
461:       Store.toggleRepairMode();
462:       return;
463:     }
464: 
465:     if (picked) {
466:       Store.cancelPickedItem();
467:       return;
468:     }
469: 
470:     const square = squareAt(event.clientX, event.clientY);
471:     if (square < 0) return;
472: 
473:     const entry = squares[square];
474:     if (!entry) return;
475: 
476:     // `ProcessMyInvenItemAutoMove` (NewUIStorageInventory.cpp:400): with a
477:     // storage window open the right click shuttles the item into it instead
478:     // of equipping or drinking it.
479:     const target = Economy.autoMoveTarget;
480:     if (target !== null) {
481:       Store.autoMoveItem(StorageKind.Inventory, entry.slot, target);
482:       return;
483:     }
484: 
485:     // Event tickets ask the server for the opening state instead of being
486:     // drunk (NewUIMyInventory.cpp: SendMiniGameOpeningStateRequest).
487:     if (events.useTicket(entry.slot, entry.item)) return;
488: 
489:     // Orbs, scrolls and crystals are read, not drunk
490:     // (NewUIMyInventory.cpp:1865): the skill is learned when the hero
491:     // qualifies, otherwise the reason is said.
492:     if (Store.learnSkillItem(entry.slot)) return;
493: 
494:     if (isConsumable(entry.item)) {
495:       Store.consumeItemRequest(entry.slot);
496:       return;
497:     }
498: 
499:     const destination = equipDestination(entry.item, playerData.items);
500:     if (destination < 0) return;
501: 
502:     Store.pickInventoryItem(entry.slot);
503:     Store.placePickedItem(destination);
504:   };
505: 
506:   return (
507:     <MuItemWindow
508:       id={WINDOW_ID}
509:       className={`inventory${Store.repairMode ? ' repair-mode' : ''}`}
510:       column={Store.characterInfoEnabled ? 1 : 0}
