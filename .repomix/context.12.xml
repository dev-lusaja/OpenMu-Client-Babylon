324:       file={CENTER_SPRITE}
325:       width={CENTER_BUTTON.width}
326:       height={CENTER_BUTTON.height}
327:       frames={{ up: 0, active: 1, down: 2 }}
328:       label={t('minimap.center')}
329:       labelStyle={{ fontWeight: 'bold', fontSize: 11 }}
330:       onClick={onClick}
331:     />
