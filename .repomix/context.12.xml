  3: import { useEffect, useState } from 'react';
  4: import { runInAction } from 'mobx';
  5: import { Store } from '../../../../../store';
  6: import { SessionStats } from '../../../../../common/sessionStats';
  7: import { formatDuration } from '../../../../../common/hudFormat';
  8: import { isKey } from '../../../../../common/keyBindings';
  9: import { useEventBus } from '../../../../../hooks/useEventBus';
 10: import { uiClick } from '../../../../../libs/sfx';
 11: import { MuText } from '../../../../components/muText';
 12: import { useWindowChrome } from '../../../../components/muWindow/useWindowChrome';
 13: import { t } from '../../../../../i18n';
 14: 
 15: /**
 16:  * The session panel: what this sitting has been worth, and what the rates
 17:  * say about the next level. No original analog - the C++ client has no such
 18:  * window - so it is drawn in the same black plate the move list uses rather
 19:  * than pretending to be a ported sheet.
 20:  */
 21: 
 22: const WINDOW_ID = 'session-stats';
 23: const HOT_KEY = 'sessionStats';
 24: 
 25: const WIDTH = 132;
 26: const ROW_HEIGHT = 12;
 27: const TITLE_Y = 4;
 28: const FIRST_ROW = 20;
 29: const ROWS = 5;
 30: const HEIGHT = FIRST_ROW + ROWS * ROW_HEIGHT + 16;
 31: const LABEL_X = 6;
 32: const VALUE_X = WIDTH - 6;
 33: const CLOSE_HEIGHT = 12;
 34: 
 35: const TITLE_COLOR = 'rgb(255, 204, 26)';
 36: const LABEL_COLOR = 'rgb(127, 178, 255)';
 37: const VALUE_COLOR = '#fff';
 38: 
 39: /** 1 234 567 -> "1.23M": the panel is 132 px wide, the numbers are not. */
 40: function compact(value: number): string {
 41:   const n = Math.floor(value);
 42:   if (n >= 1_000_000_000) return `${(n / 1_000_000_000).toFixed(2)}B`;
 43:   if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(2)}M`;
 44:   if (n >= 10_000) return `${(n / 1000).toFixed(1)}K`;
 45:   return n.toLocaleString('en-US');
 46: }
 47: 
 48: const Row = ({ label, value, top }: { label: string; value: string; top: number }) => (
 49:   <>
 50:     <MuText className="session-label" color={LABEL_COLOR} style={{ left: LABEL_X, top }} text={label} />
 51:     <MuText className="session-value" color={VALUE_COLOR} style={{ left: VALUE_X, top }} text={value} />
 52:   </>
 53: );
 54: 
 55: export const SessionStatsWindow = observer(() => {
 56:   const open = Store.sessionStatsEnabled;
 57:   const chrome = useWindowChrome(WINDOW_ID, {
 58:     width: WIDTH,
 59:     height: HEIGHT,
 60:     onClose: () => runInAction(() => (Store.sessionStatsEnabled = false)),
 61:   });
 62: 
 63:   useEventBus('keyPressed', key => {
 64:     if (!Store.world?.playerEntity) return;
 65:     if (isKey(HOT_KEY, key)) {
 66:       runInAction(() => (Store.sessionStatsEnabled = !Store.sessionStatsEnabled));
 67:     }
 68:   });
 69: 
 70:   // The counters listen from the first open; the clock only runs while the
 71:   // panel is up, so a closed tracker costs nothing per frame.
 72:   const [, setTick] = useState(0);
 73:   useEffect(() => {
 74:     if (!open) return;
 75:     SessionStats.watch();
 76:     const id = setInterval(() => {
 77:       SessionStats.tick();
 78:       setTick(v => v + 1);
 79:     }, 1000);
 80:     return () => clearInterval(id);
 81:   }, [open]);
 82: 
 83:   if (!open) return null;
 84: 
 85:   const rate = (value: number) => (value > 0 ? `${compact(value)}/h` : '-');
 86:   const toLevel = SessionStats.msToLevel;
 87: 
 88:   return (
 89:     <div
 90:       ref={chrome.ref as React.Ref<HTMLDivElement>}
 91:       role="dialog"
 92:       aria-label={t('session.title')}
 93:       className="session-window"
 94:       onPointerDown={chrome.onPointerDown}
 95:       style={{ width: WIDTH, height: HEIGHT, ...chrome.style, transformOrigin: '0 0' }}
 96:     >
 97:       <MuText
 98:         face="bold"
 99:         className="session-title"
100:         color={TITLE_COLOR}
101:         style={{ left: WIDTH / 2, top: TITLE_Y }}
102:         text={t('session.title')}
103:       />
104: 
105:       <Row
106:         label={t('session.time')}
107:         value={formatDuration(SessionStats.elapsedMs)}
108:         top={FIRST_ROW}
109:       />
110:       <Row
111:         label={t('session.exp')}
112:         value={rate(SessionStats.experiencePerHour)}
113:         top={FIRST_ROW + ROW_HEIGHT}
114:       />
115:       <Row
116:         label={t('session.kills')}
117:         value={`${SessionStats.kills} (${rate(SessionStats.killsPerHour)})`}
118:         top={FIRST_ROW + ROW_HEIGHT * 2}
119:       />
120:       <Row
121:         label={t('session.zen')}
122:         value={rate(SessionStats.zenPerHour)}
123:         top={FIRST_ROW + ROW_HEIGHT * 3}
124:       />
125:       <Row
126:         label={t('session.toLevel')}
127:         value={toLevel === null ? '-' : formatDuration(toLevel)}
128:         top={FIRST_ROW + ROW_HEIGHT * 4}
129:       />
130: 
131:       <div
132:         className="session-reset"
133:         data-no-drag="true"
134:         style={{ top: HEIGHT - CLOSE_HEIGHT - 2, height: CLOSE_HEIGHT, lineHeight: `${CLOSE_HEIGHT}px` }}
135:         onClick={uiClick(() => SessionStats.reset())}
136:       >
137:         <MuText text={t('session.reset')} />
138:       </div>
139:     </div>
140:   );
141: });
</file>

