292: /**
293:  * Which hot-key slot each of the five boxes shows, per page
294:  * (`iStartSkillIndex`, with 10 folded back to 0). The slot index *is* the
295:  * digit that fires it - which is why the bar art has 1..5 printed on it -
296:  * so the second page is 6..9 and 0, and nothing here is off by one.
297:  */
298: const BAR_PAGES: readonly (readonly number[])[] = [
299:   [1, 2, 3, 4, 5],
300:   [6, 7, 8, 9, 0],
301: ];
302: /** Every slot in bar order, for the drag-to-bind strip. */
303: const ALL_SLOTS: readonly number[] = [1, 2, 3, 4, 5, 6, 7, 8, 9, 0];
304: /** The drop strip that appears over the slots while a skill is dragged. */
305: const HOTKEY_STRIP_X = SKILL_SLOT_X - 14;
306: const HOTKEY_STRIP_Y = SKILL_SLOT_Y - 16;
307: const HOTKEY_STRIP_STEP = 19;
308: const HOTKEY_STRIP_SIZE = 16;
309: /** Pixels the pointer must travel before a press becomes a drag, not a click. */
310: const DRAG_THRESHOLD = 4;
311: /** RenderSkillDelay: red at half alpha rising from the slot's floor. */
312: const DELAY_TINT = 'rgba(255, 128, 128, 0.5)';
313: /** Drop targets: a digit slot is 0..9; the current-skill box; nothing. */
314: const DROP_CURRENT = -2;
315: const DROP_NONE = -1;
316: 
317: /**
318:  * The learned-skill fan (`m_bSkillList`, NewUIMainFrameWindow.cpp:1546):
319:  * 32×38 boxes at y 390 spreading out from the current-skill box, right,
320:  * left, right…; boxes 15..18 continue leftward and everything past 18
321:  * climbs one row.
322:  */
323: const FAN_Y = local(390);
324: const FAN_WRAP = 18;
325: 
326: function fanPosition(count: number): { left: number; top: number } {
327:   const w = SKILL_SLOT_WIDTH;
328:   const top = count >= FAN_WRAP ? FAN_Y - SKILL_SLOT_HEIGHT : FAN_Y;
329:   let left: number;
330:   if (count < 14) {
331:     const half = Math.floor(count / 2);
332:     left = count % 2 === 0 ? CURRENT_SKILL_X + half * w : CURRENT_SKILL_X - (half + 1) * w;
333:   } else if (count < FAN_WRAP) {
334:     left = CURRENT_SKILL_X - 8 * w - (count - 14) * w;
335:   } else {
336:     left = CURRENT_SKILL_X - 12 * w + (count - 17) * w;
337:   }
338:   return { left, top };
339: }
340: 
341: type SkillDrag = { number: number; x: number; y: number; moved: boolean; fromFan: boolean };
342: 
343: /**
344:  * The ghost icon under the cursor while a skill is dragged off the bar
345:  * (CNewUIPickedItem-style, portalled so the bar's scale does not apply).
346:  */
347: const SkillDragGhost = ({ drag }: { drag: SkillDrag }) =>
348:   createPortal(
349:     <div
350:       className="skill-drag-ghost"
351:       style={{
352:         left: drag.x - SKILL_ICON_WIDTH / 2,
353:         top: drag.y - SKILL_ICON_HEIGHT / 2,
354:       }}
355:     >
356:       <SkillIcon number={drag.number} />
357:     </div>,
358:     document.body
359:   );
360: 
361: /**
362:  * CNewUISkillList: the five bar slots are hot keys 1..5 or 6..9,0 - the page
363:  * holding the current skill (`IsArrayUp`), the mouse wheel flips it, and the
364:  * slot index is the digit that fires it, so box one really is key 1.
365:  *
366:  * A click on a bound slot makes it the current skill; a click on an *empty*
367:  * slot (and a right click on a bound one) opens the fan of every learned
368:  * skill (`m_bSkillList`) as a picker for that slot - the box after the last
369:  * skill clears it. A click on the current-skill box opens the same fan to
370:  * select rather than bind, and a right click there goes back to the plain
371:  * attack. Ctrl+digit over an icon binds that key (`SetHotKey`), as does
372:  * dropping a dragged skill on the digit strip; dropping one on the
373:  * current-skill box selects it. Icons the hero cannot use are greyed
374:  * (bCantSkill), a running delay sweeps the slot red from the bottom
375:  * (RenderSkillDelay), and hovering shows RenderSkillInfo.
376:  */
377: const SkillSlots = observer(() => {
378:   const [listOpen, setListOpen] = useState(false);
379:   /** The slot the open fan is picking for; -1 = it is only browsing. */
380:   const [assignSlot, setAssignSlot] = useState(-1);
381:   // The wheel's choice of page; the current skill's page wins while it has one.
382:   const [pageOverride, setPageOverride] = useState<boolean | null>(null);
383:   const [hovered, setHovered] = useState(-1);
384:   const [tip, setTip] = useState<{ number: number; x: number; y: number } | null>(null);
385:   const [drag, setDrag] = useState<SkillDrag | null>(null);
386:   const [dropSlot, setDropSlot] = useState(DROP_NONE);
387:   const skillList = Store.skills;
388: 
389:   const closeList = () => {
390:     setListOpen(false);
391:     setAssignSlot(-1);
392:   };
393:   useWindowStackEntry(SKILL_FAN_ID, listOpen, () => {
394:     closeList();
395:     return true;
396:   });
397:   /** Open the fan as the picker for one hot key. */
398:   const openPicker = (slot: number) => {
399:     setTip(null);
400:     setAssignSlot(slot);
401:     setListOpen(true);
402:   };
403:   // RenderSkillDelay: the sweep's height is written straight to the element
404:   // on the cooldown layer's tick, so a running delay renders nothing. The
405:   // observable map only changes when a delay starts / ends (slot re-render).
406:   const delayRefs = useRef<(HTMLDivElement | null)[]>([]);
407:   const secondsRefs = useRef<(HTMLDivElement | null)[]>([]);
408:   const slotNumbers = useRef<number[]>([]);
409:   useEffect(() => {
410:     const sweep = () => {
411:       const numbers = slotNumbers.current;
412:       for (let i = 0; i < numbers.length; i++) {
413:         const el = delayRefs.current[i];
414:         if (!el) continue;
415:         const delay = numbers[i] >= 0 ? skills.cooldown(numbers[i]) : null;
416:         const css = delay ? Math.round(delay.fraction * SKILL_SLOT_HEIGHT) + 'px' : '0px';
417:         if (el.style.height !== css) el.style.height = css;
418:         const seconds = secondsRefs.current[i];
419:         if (!seconds) continue;
420:         // Whole seconds under 10, one decimal above nothing: the same
421:         // reading a player counts under their breath.
422:         const text = delay
423:           ? delay.remaining >= 1
424:             ? String(Math.ceil(delay.remaining))
425:             : delay.remaining.toFixed(1)
426:           : '';
427:         if (seconds.textContent !== text) seconds.textContent = text;
428:       }
429:     };
430:     sweep();
431:     return onCooldownTick(sweep);
432:   });
433:   // Which slot holds the current skill, or -1 - guarded, because with no
434:   // current skill `indexOf(-1)` would answer with the first *empty* slot.
435:   const currentIdx =
436:     Store.currentSkill >= 0 ? Store.skillHotkeys.indexOf(Store.currentSkill) : -1;
437:   useEffect(() => setPageOverride(null), [currentIdx]);
438:   const pageUp = pageOverride ?? BAR_PAGES[1].includes(currentIdx);
439:   const page = BAR_PAGES[pageUp ? 1 : 0];
440:   const fanSkills = skillList.map(s => s.number).filter(isHotbarSkill);
441: 
442:   useEventBus('keyPressed', code => {
443:     const m = /^(?:Digit|Numpad)(\d)$/.exec(code);
444:     if (!m) return;
445:     const slot = +m[1];
446:     const keys = Store.world?.keyboardInput.pressedKeys;
447:     const ctrl = !!keys && (keys.has('ControlLeft') || keys.has('ControlRight'));
448:     // Ctrl+digit over a slot, or a digit while dragging, binds the key.
449:     const bind = drag?.number ?? (ctrl ? hovered : -1);
450:     if (bind >= 0) {
451:       Store.assignSkillHotkey(slot, bind);
452:       return;
453:     }
454:     const number = Store.skillHotkeys[slot];
455:     if (number >= 0) Store.selectSkill(number);
456:   });
457: 
458:   // The drag lives on the window: the pointer leaves the bar at once.
459:   useEffect(() => {
460:     if (!drag) return;
461:     const onMove = (e: PointerEvent) =>
462:       setDrag(d => {
463:         if (!d) return d;
464:         const moved = d.moved || Math.hypot(e.clientX - d.x, e.clientY - d.y) > DRAG_THRESHOLD;
465:         return { ...d, x: e.clientX, y: e.clientY, moved };
466:       });
467:     const onUp = () => {
468:       if (!drag.moved) {
469:         // A click in the fan binds while the fan is a picker and otherwise
470:         // selects; either way it closes (NewUIMainFrameWindow.cpp:1636).
471:         if (drag.fromFan && assignSlot >= 0) Store.assignSkillHotkey(assignSlot, drag.number);
472:         else Store.selectSkill(drag.number);
473:         if (drag.fromFan) {
474:           setListOpen(false);
475:           setAssignSlot(-1);
476:         }
477:       } else if (dropSlot >= 0) {
478:         Store.assignSkillHotkey(dropSlot, drag.number);
479:       } else if (dropSlot === DROP_CURRENT) {
480:         Store.selectSkill(drag.number);
481:       }
482:       setDrag(null);
483:       setDropSlot(DROP_NONE);
484:     };
485:     window.addEventListener('pointermove', onMove);
486:     window.addEventListener('pointerup', onUp);
487:     return () => {
488:       window.removeEventListener('pointermove', onMove);
489:       window.removeEventListener('pointerup', onUp);
490:     };
491:   }, [drag, dropSlot, assignSlot]);
492: 
493:   const hotkeyOf = (number: number) => {
494:     const i = Store.skillHotkeys.indexOf(number);
495:     return i < 0 ? '' : String(i);
496:   };
497: 
498:   const dragging = !!drag?.moved;
499:   const leaveDrop = (slot: number) => setDropSlot(s => (s === slot ? DROP_NONE : s));
500: 
501:   /** Pointer handlers shared by the bar slots and the fan boxes. */
502:   const boxEvents = (number: number, fromFan: boolean) => ({
503:     onPointerDown: (e: React.PointerEvent) => {
504:       if (e.button !== 0 || number < 0) return;
505:       e.stopPropagation();
506:       uiClick(() => {})();
507:       setTip(null);
508:       setDrag({ number, x: e.clientX, y: e.clientY, moved: false, fromFan });
509:     },
510:     onPointerEnter: () => setHovered(number),
511:     onPointerMove: (e: React.PointerEvent) => {
512:       if (number >= 0 && !drag) setTip({ number, x: e.clientX, y: e.clientY });
513:     },
514:     onPointerLeave: () => {
515:       setHovered(h => (h === number ? -1 : h));
516:       setTip(t => (t?.number === number ? null : t));
517:     },
518:   });
519: 
520:   /** IMAGE_SKILLBOX / IMAGE_SKILLBOX_USE: the box under a fan or lit slot. */
521:   const boxArt = (lit: boolean) => (
522:     <MuSpriteFrame
523:       file={lit ? SKILLBOX_USE_SPRITE : SKILLBOX_SPRITE}
524:       className="skill-box-art"
525:       width={SKILL_SLOT_WIDTH}
526:       height={SKILL_SLOT_HEIGHT}
527:     />
528:   );
529: 
530:   return (
531:     <>
532:       {page.map((slot, i) => {
533:         const number = Store.skillHotkeys[slot] ?? -1;
534:         const state = number >= 0 ? skills.usability(number) : null;
535:         const usable = !!state?.requirementsMet;
536:         const shortOn =
537:           usable && state
538:             ? state.blocks.find(block => block === 'mana' || block === 'ag')
539:             : undefined;
540:         // Tracked: a delay starting or ending re-renders the slot (the sweep itself is not React).
541:         const cooling = number >= 0 && skillCooldowns.has(number);
542:         const selected = number >= 0 && number === Store.currentSkill;
543:         const picking = listOpen && assignSlot === slot;
544:         const name = skillDefinition(number)?.name ?? `#${number}`;
545:         slotNumbers.current[i] = number;
546:         const classes = ['skill-slot'];
547:         if (selected) classes.push('selected');
548:         if (number >= 0 && !usable) classes.push('unusable');
549:         if (shortOn) classes.push(shortOn === 'mana' ? 'no-mana' : 'no-ag');
550:         if (number < 0) classes.push('empty');
551:         if (picking) classes.push('picking');
552:         const events = boxEvents(number, false);
553:         return (
554:           <div
555:             key={slot}
556:             className={classes.join(' ')}
557:             title={
558:               number >= 0
559:                 ? t('bottomBar.boundSlot', { name, key: slot })
560:                 : t('bottomBar.pickSkill', { key: slot })
561:             }
562:             style={{
563:               left: SKILL_SLOT_X + i * SKILL_SLOT_WIDTH,
564:               top: SKILL_SLOT_Y,
565:               width: SKILL_SLOT_WIDTH,
566:               height: SKILL_SLOT_HEIGHT,
567:             }}
568:             {...events}
569:             onPointerDown={e => {
570:               // An empty box is the "choose a skill" button; a bound one drags.
571:               if (e.button === 0 && number < 0) {
572:                 e.stopPropagation();
573:                 uiClick(() => openPicker(slot))();
574:                 return;
575:               }
576:               events.onPointerDown(e);
577:             }}
578:             onContextMenu={e => {
579:               e.preventDefault();
580:               e.stopPropagation();
581:               uiClick(() => openPicker(slot))();
582:             }}
583:             onWheel={() => setPageOverride(!pageUp)}
584:           >
585:             {selected && boxArt(true)}
586:             {number >= 0 && (
587:               <div className="skill-icon" style={{ left: SKILL_ICON_INSET_X, top: SKILL_ICON_INSET_Y }}>
588:                 <SkillIcon number={number} disabled={!usable} />
589:               </div>
590:             )}
591:             {cooling && (
592:               <>
593:                 <div
594:                   ref={el => (delayRefs.current[i] = el)}
595:                   className="skill-delay"
596:                   style={{ height: 0, background: DELAY_TINT }}
597:                 />
598:                 <div ref={el => (secondsRefs.current[i] = el)} className="skill-delay-left" />
599:               </>
600:             )}
601:             {number >= 0 && <div className="skill-hotkey">{slot}</div>}
602:           </div>
603:         );
604:       })}
605:       <div
606:         className={[
607:           'skill-slot current',
608:           Store.currentSkill >= 0 ? 'selected' : '',
609:           dragging && dropSlot === DROP_CURRENT ? 'drop-target' : '',
610:         ]
611:           .filter(Boolean)
612:           .join(' ')}
613:         title={
614:           dragging
615:             ? undefined
616:             : (skillDefinition(Store.currentSkill)?.name ??
617:                 t('bottomBar.noSkill')) + t('bottomBar.skillHint')
618:         }
619:         style={{
620:           left: CURRENT_SKILL_X,
621:           top: SKILL_SLOT_Y,
622:           width: SKILL_SLOT_WIDTH,
623:           height: SKILL_SLOT_HEIGHT,
624:         }}
625:         onClick={uiClick(() => {
626:           if (listOpen) closeList();
627:           else {
628:             setAssignSlot(-1);
629:             setListOpen(true);
630:           }
631:         })}
632:         onContextMenu={e => {
633:           e.preventDefault();
634:           uiClick(() => Store.selectSkill(-1))();
635:         }}
636:         onPointerEnter={() => dragging && setDropSlot(DROP_CURRENT)}
637:         onPointerLeave={() => leaveDrop(DROP_CURRENT)}
638:       >
639:         {Store.currentSkill >= 0 && (
640:           <div className="skill-icon" style={{ left: SKILL_ICON_INSET_X, top: SKILL_ICON_INSET_Y }}>
641:             <SkillIcon
642:               number={Store.currentSkill}
643:               disabled={!skills.requirementsMet(Store.currentSkill)}
644:             />
645:           </div>
646:         )}
647:       </div>
648:       {listOpen &&
649:         fanSkills.map((number, count) => {
650:           const { left, top } = fanPosition(count);
651:           const usable = skills.requirementsMet(number);
652:           const key = hotkeyOf(number);
653:           const selected = number === Store.currentSkill;
654:           const classes = ['skill-slot', 'fan'];
655:           if (selected) classes.push('selected');
656:           if (!usable) classes.push('unusable');
657:           return (
658:             <div
659:               key={number}
660:               className={classes.join(' ')}
661:               style={{ left, top, width: SKILL_SLOT_WIDTH, height: SKILL_SLOT_HEIGHT }}
662:               {...boxEvents(number, true)}
663:             >
664:               {boxArt(selected)}
665:               <div className="skill-icon" style={{ left: SKILL_ICON_INSET_X, top: SKILL_ICON_INSET_Y }}>
666:                 <SkillIcon number={number} disabled={!usable} />
667:               </div>
668:               {key && <div className="skill-hotkey">{key}</div>}
669:             </div>
670:           );
671:         })}
672:       {listOpen && assignSlot >= 0 && (
673:         <div
674:           className="skill-slot fan clear"
675:           title={t('bottomBar.clearSlot', { key: assignSlot })}
676:           style={{
677:             ...fanPosition(fanSkills.length),
678:             width: SKILL_SLOT_WIDTH,
679:             height: SKILL_SLOT_HEIGHT,
680:           }}
681:           onClick={uiClick(() => {
682:             Store.assignSkillHotkey(assignSlot, -1);
683:             closeList();
684:           })}
685:         >
686:           {boxArt(false)}
687:           <span>&times;</span>
688:         </div>
689:       )}
690:       {dragging &&
691:         ALL_SLOTS.map((slot, i) => (
692:           <div
693:             key={slot}
694:             className={dropSlot === slot ? 'skill-hotkey-target drop-target' : 'skill-hotkey-target'}
695:             style={{
696:               left: HOTKEY_STRIP_X + i * HOTKEY_STRIP_STEP,
697:               top: HOTKEY_STRIP_Y,
698:               width: HOTKEY_STRIP_SIZE,
699:               height: HOTKEY_STRIP_SIZE,
700:             }}
701:             onPointerEnter={() => setDropSlot(slot)}
702:             onPointerLeave={() => leaveDrop(slot)}
703:           >
704:             {slot}
705:           </div>
706:         ))}
707:       {dragging && drag && <SkillDragGhost drag={drag} />}
708:       {tip && !dragging && (
709:         <SkillTooltip
710:           number={tip.number}
711:           level={skillList.find(s => s.number === tip.number)?.level ?? 0}
712:           x={tip.x}
713:           y={tip.y}
714:         />
715:       )}
716:     </>
717:   );
718: });
