 81: function slotOf(column: number, row: number): number {
 82:   return column + row * COLUMNS + FIRST_SLOT;
 83: }
 84: 
 85: function itemSize(item: Item): { w: number; h: number } {
 86:   const config = ItemsDatabase.getItem(item.group, item.num);
 87:   return { w: config?.X ?? 1, h: config?.Y ?? 1 };
 88: }
