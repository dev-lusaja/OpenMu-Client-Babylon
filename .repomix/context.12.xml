 205: /** The catalogue laid out on the grid, each entry taking its real footprint. */
 206: type Placed = {
 207:   product: Product;
 208:   item: Item;
 209:   slot: number;
 210:   column: number;
 211:   row: number;
 212:   w: number;
 213:   h: number;
 214: };
 215: 
 216: /**
 217:  * First fit, left to right and top to bottom, exactly as a merchant's stock is
 218:  * packed. Items keep their real size, so a 5x3 pair of wings looks as big here
 219:  * as it will in the bag.
 220:  */
 221: function layOut(products: Product[]): { squares: (Placed | null)[]; placed: Placed[] } {
 222:   const squares: (Placed | null)[] = new Array(SQUARES).fill(null);
 223:   const placed: Placed[] = [];
 224: 
 225:   const fits = (column: number, row: number, w: number, h: number) => {
 226:     if (column + w > COLUMNS || row + h > ROWS) return false;
 227: 
 228:     for (let y = 0; y < h; y++) {
 229:       for (let x = 0; x < w; x++) {
 230:         if (squares[(row + y) * COLUMNS + column + x]) return false;
 231:       }
 232:     }
 233: 
 234:     return true;
 235:   };
 236: 
 237:   for (const product of products) {
 238:     if (product.group === null || product.number === null) continue;
 239: 
 240:     const w = Math.max(1, product.width);
 241:     const h = Math.max(1, product.height);
 242: 
 243:     let found = -1;
 244: 
 245:     for (let slot = 0; slot < SQUARES && found < 0; slot++) {
 246:       const column = slot % COLUMNS;
 247:       const row = (slot - column) / COLUMNS;
 248:       if (fits(column, row, w, h)) found = slot;
 249:     }
 250: 
 251:     if (found < 0) continue;
 252: 
 253:     const column = found % COLUMNS;
 254:     const row = (found - column) / COLUMNS;
 255:     const entry: Placed = {
 256:       product,
 257:       item: { group: product.group, num: product.number, lvl: product.level },
 258:       slot: found,
 259:       column,
 260:       row,
 261:       w,
 262:       h,
 263:     };
 264: 
 265:     placed.push(entry);
 266: 
 267:     for (let y = 0; y < h; y++) {
 268:       for (let x = 0; x < w; x++) squares[(row + y) * COLUMNS + column + x] = entry;
 269:     }
 270:   }
 271: 
 272:   return { squares, placed };
 273: }
