110: /** `CDuelMsgBoxLayout`: Enter accepts, Escape refuses. */
111: const DuelPrompt = observer(() => {
112:   const request = duelRequest();
113:   const text = request ? t('duel.request', { name: request.requesterName }) : '';
114: 
115:   useEffect(() => {
116:     if (!text) return;
117:     const handler = (e: KeyboardEvent) => {
118:       if (e.key === 'Enter') events.answerDuelRequest(true);
119:       else if (e.key === 'Escape') events.answerDuelRequest(false);
120:       else return;
121:       e.preventDefault();
122:     };
123:     window.addEventListener('keydown', handler);
124:     return () => window.removeEventListener('keydown', handler);
125:   });
126: 
127:   if (!text) return null;
128: 
129:   return (
130:     <div className="duel-prompt-layer">
131:       <MuSpriteFrame
132:         file={MSG_BACK_SPRITE}
133:         width={MSG_WIDTH}
134:         height={MSG_HEIGHT}
135:         className="duel-prompt"
136:       >
137:         <div className="duel-prompt-text">{text}</div>
138:         <MuButton
139:           file={OK_SPRITE}
140:           width={MSG_BTN_WIDTH}
141:           height={MSG_BTN_HEIGHT}
142:           frames={{ up: 0, active: 1, down: 2 }}
143:           color={TEXT_COLOR.brightGray}
144:           activeColor={TEXT_COLOR.white}
145:           onClick={() => events.answerDuelRequest(true)}
146:           style={{ position: 'absolute', left: BTN_BOTH_OK_X, top: MSG_BTN_Y }}
147:         />
148:         <MuButton
149:           file={CANCEL_SPRITE}
150:           width={MSG_BTN_WIDTH}
151:           height={MSG_BTN_HEIGHT}
152:           frames={{ up: 0, active: 1, down: 2 }}
153:           color={TEXT_COLOR.brightGray}
154:           activeColor={TEXT_COLOR.white}
155:           onClick={() => events.answerDuelRequest(false)}
156:           style={{ position: 'absolute', left: BTN_BOTH_CANCEL_X, top: MSG_BTN_Y }}
157:         />
158:       </MuSpriteFrame>
159:     </div>
160:   );
161: });
