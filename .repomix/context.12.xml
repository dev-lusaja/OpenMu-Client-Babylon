 1: import './style.less';
 2: import { useEffect } from 'react';
 3: import { observer } from 'mobx-react-lite';
 4: import { Store } from '../../../../../store';
 5: import { GameOptions } from '../../../../../common/gameOptions';
 6: import {
 7:   NO_WARNING,
 8:   vitalWarning,
 9:   type VitalWarning,
10: } from '../../../../../common/lowVitals';
11: import { playSfx } from '../../../../../libs/sfx';
12: import { SoundsManager } from '../../../../../libs/soundsManager';
13: 
14: /**
15:  * The screen-edge warning: a soft red gradient round the frame once health
16:  * drops under the player's threshold, beating like a heart near death, and
17:  * the same in blue for mana. The original client flashed the whole screen red
18:  * on a hit; this holds that colour for as long as the danger does, because
19:  * the life orb sits in a corner nobody watches mid-fight.
20:  *
21:  * Drawn over the world and under every window, `pointer-events: none`, and
22:  * rendered outside the HUD so the hide-interface key cannot take a warning
23:  * away. The strength is a CSS custom property and the beat a CSS animation,
24:  * so a change costs one style write and nothing per frame.
25:  */
26: 
27: /** SOUND_HEART, the sample the original plays while poisoned. */
28: const HEARTBEAT = 'Sound/pHeartBeat';
29: 
30: const Edge = ({
31:   kind,
32:   warning,
33: }: {
34:   kind: 'health' | 'mana';
35:   warning: VitalWarning;
36: }) => (
37:   <div
38:     className={`low-vital-edge is-${kind}`}
39:     style={
40:       {
41:         '--low-vital-strength': warning.strength,
42:         '--low-vital-beat': `${warning.beatSeconds}s`,
43:       } as React.CSSProperties
44:     }
45:   >
46:     <div
47:       className={`low-vital-glow${warning.beatSeconds > 0 ? ' is-beating' : ''}`}
48:     />
49:   </div>
50: );
51: 
52: export const LowHealthOverlay = observer(() => {
53:   const health = GameOptions.lowHealthWarning
54:     ? vitalWarning(Store.playerData.hpPercent, GameOptions.lowHealthPercent)
55:     : NO_WARNING;
56: 
57:   const mana = GameOptions.lowManaWarning
58:     ? vitalWarning(Store.playerData.mpPercent, GameOptions.lowManaPercent)
59:     : NO_WARNING;
60: 
61:   // One timer, restarted only when the beat changes step: the sound rides the
62:   // pulse rather than the health value.
63:   const beatMs = Math.round(health.beatSeconds * 1000);
64: 
65:   useEffect(() => {
66:     if (beatMs <= 0) return;
67: 
68:     const id = setInterval(() => {
69:       if (SoundsManager.effectsVolume <= 0) return;
70:       playSfx(HEARTBEAT);
71:     }, beatMs);
72: 
73:     return () => clearInterval(id);
74:   }, [beatMs]);
75: 
76:   return (
77:     <div className="low-vitals">
78:       <Edge kind="mana" warning={mana} />
79:       <Edge kind="health" warning={health} />
80:     </div>
81:   );
82: });
</file>

<file path="src/ui/pages/worldPage/components/lowHealthOverlay/style.less">
 1: // The low health / low mana edge. Two stacked layers, both inert: the outer
 2: // one holds the strength the reaction writes and fades it in, the inner one
 3: // carries the gradient and the beat, so the fade and the pulse never fight
 4: // over the same opacity.
 5: 
 6: .low-vitals {
 7:   position: absolute;
 8:   inset: 0;
 9:   pointer-events: none;
10:   overflow: hidden;
11: }
12: 
13: .low-vital-edge {
14:   position: absolute;
15:   inset: 0;
16:   opacity: var(--low-vital-strength, 0);
17:   transition: opacity 0.5s ease-out;
18: }
19: 
20: .low-vital-glow {
21:   position: absolute;
22:   inset: 0;
23: }
24: 
25: // The original's hit flash red, held at the frame instead of over the scene.
26: // The ellipse is smaller than the viewport on purpose: its last stop has to
27: // land inside the frame, or the edges only ever get a part of the colour.
28: .low-vital-edge.is-health .low-vital-glow {
29:   background: radial-gradient(
30:     ellipse 52% 48% at 50% 50%,
31:     rgba(176, 6, 6, 0) 52%,
32:     rgba(186, 10, 10, 0.4) 80%,
33:     rgba(132, 0, 0, 0.88) 100%
34:   );
35: }
36: 
37: // Quieter than the red: running out of mana is a problem, not a death.
38: .low-vital-edge.is-mana .low-vital-glow {
39:   background: radial-gradient(
40:     ellipse 52% 48% at 50% 50%,
41:     rgba(30, 70, 220, 0) 54%,
42:     rgba(38, 84, 226, 0.26) 82%,
43:     rgba(18, 46, 168, 0.6) 100%
44:   );
45: }
46: 
47: .low-vital-glow.is-beating {
48:   animation: low-vital-beat var(--low-vital-beat, 1s) ease-in-out infinite;
49: }
50: 
51: // Two thumps and a rest, the shape of a heartbeat.
52: @keyframes low-vital-beat {
53:   0% {
54:     opacity: 0.6;
55:   }
56:   9% {
57:     opacity: 1;
58:   }
59:   20% {
60:     opacity: 0.66;
61:   }
62:   30% {
63:     opacity: 0.94;
64:   }
65:   46% {
66:     opacity: 0.58;
67:   }
68:   100% {
69:     opacity: 0.6;
70:   }
71: }
72: 
73: // A pulsing red frame is exactly what this setting is about; the warning
74: // itself stays, only the beating stops.
75: @media (prefers-reduced-motion: reduce) {
76:   .low-vital-glow.is-beating {
77:     animation: none;
78:   }
79: }
</file>

<file path="src/ui/pages/worldPage/components/mapNameBanner/index.tsx">
  1: import './style.less';
  2: import { useEffect, useRef, useState } from 'react';
  3: import { i18n } from '../../../../../i18n';
  4: import { Store } from '../../../../../store';
  5: import { useEventBus } from '../../../../../hooks/useEventBus';
  6: import { useMuSprite } from '../../../../components/muSprite';
  7: import { useUiStageScale } from '../../../../components/uiStage';
  8: 
  9: /**
 10:  * `CUIMapName` (UIMapName.cpp): entering a map fades in that map's name
 11:  * picture (`Local/<lang>/ImgsMapName/*.OZT`, the 166x90 top-left corner of a
 12:  * 256x128 texture), holds it 5 s and fades it out. Centred horizontally. The
 13:  * original puts it at line 220 of the 480-line virtual screen; here it sits
 14:  * near the top instead, just under the buff row. A world with no entry in
 15:  * `InitImgPathMap` (the GM area, Crywolf 2nd) shows nothing.
 16:  */
 17: 
 18: const SHOW_TIME = 5000;
 19: // UIMN_ALPHA_VARIATION is per rendered frame; the original runs at 60 fps.
 20: const ALPHA_PER_SECOND = 0.015 * 60;
 21: const START_ALPHA = 0.2;
 22: 
 23: const IMG_WIDTH = 166;
 24: const IMG_HEIGHT = 90;
 25: // 640x480 UI space: at the top, clearing the buff row at y 15..48.
 26: const IMG_TOP = 50;
 27: 
 28: const FADE_IN_MS = ((1 - START_ALPHA) / ALPHA_PER_SECOND) * 1000;
 29: const FADE_OUT_MS = (1 / ALPHA_PER_SECOND) * 1000;
 30: 
 31: /**
 32:  * The picture to try, best first. Webzen drew the map name into the bitmap,
 33:  * so this is art, not a string: the pack that ships `ImgsMapName/` has the
 34:  * name in its own language and its own lettering, and there is nothing to
 35:  * translate at runtime. Only `Eng`, `Spn` and `Por` have the folder - the
 36:  * generated packs write tables, not art - so everything else falls back to
 37:  * the English picture instead of showing no banner at all.
 38:  */
 39: function bannerPaths(file: string): string[] {
 40:   const folder = i18n.dataPack?.folder ?? 'Eng';
 41:   const paths = [`Data/Local/${folder}/ImgsMapName/${file}`];
 42:   if (folder !== 'Eng') paths.push(`Data/Local/Eng/ImgsMapName/${file}`);
 43:   return paths;
 44: }
 45: 
 46: // `InitImgPathMap`, file names as shipped in Data/Local/<lang>/ImgsMapName.
 47: const MAP_IMAGES: Record<number, string> = {
 48:   0: 'lorencia.OZT',
 49:   1: 'dungeun.OZT',
 50:   2: 'devias.OZT',
 51:   3: 'noria.OZT',
 52:   4: 'losttower.OZT',
 53:   6: 'stadium.OZT',
 54:   7: 'atlans.OZT',
 55:   8: 'tarcan.OZT',
 56:   9: 'devilsquare.OZT',
 57:   10: 'Icarus.OZT',
 58:   30: 'loren.OZT',
 59:   31: 'ordeal.OZT',
 60:   // Devil Square 5-7: `LoadWorld` folds map 32 into WD_9DEVILSQUARE.
 61:   32: 'devilsquare.OZT',
 62:   33: 'aida.OZT',
 63:   34: 'crywolffortress.OZT',
 64:   36: 'lostkalima.OZT',
 65:   41: 'BalgasBarrack.OZT',
 66:   42: 'BalgasRefuge.OZT',
 67:   51: 'Elbeland.OZT',
 68:   52: 'bloodcastle.OZT',
 69:   53: 'chaoscastle.OZT',
 70:   56: 'SwampOfCalmness.OZT',
 71:   57: 'mapname_raklion.OZT',
 72:   58: 'mapname_raklionboss.OZT',
 73:   62: 'santatown.OZT',
 74:   63: 'pkfield.OZT',
 75:   64: 'duelarena.OZT',
 76:   79: 'MapName_MarketRolen.OZT',
 77: };
 78: 
 79: function bannerImage(map: number): string | null {
 80:   if (map >= 11 && map <= 17) return 'bloodcastle.OZT';
 81:   if (map >= 18 && map <= 23) return 'chaoscastle.OZT';
 82:   if (map >= 24 && map <= 29) return 'Kalima.OZT';
 83:   if (map >= 37 && map <= 39) return 'kantru.OZT';
 84:   if (map >= 45 && map <= 50) return 'IllusionTemple.OZT';
 85:   if (map >= 65 && map <= 68) return 'Doppelganger.OZT';
 86:   if (map >= 69 && map <= 72) return 'EmpireGuardian.OZT';
 87:   if (map === 80 || map === 81) return 'mapname_karutan.ozt';
 88:   return MAP_IMAGES[map] ?? null;
 89: }
 90: 
 91: type Shown = { map: number; at: number };
 92: 
 93: export const MapNameBanner = () => {
 94:   const [shown, setShown] = useState<Shown | null>(null);
 95:   const ref = useRef<HTMLDivElement>(null);
 96:   const scale = useUiStageScale();
 97: 
 98:   useEventBus('warpCompleted', ({ map }) => {
 99:     // `ShowMapName` restarts the fade on every entry, same map included.
100:     setShown({ map, at: Date.now() });
101:   });
102: 
103:   const file = shown ? bannerImage(shown.map) : null;
104:   const sprite = useMuSprite(file ? bannerPaths(file) : undefined);
105: 
106:   // The original steps the alpha only once the bitmap is in; the clock
107:   // starts when the sprite is decoded, not at warpCompleted.
108:   useEffect(() => {
109:     if (!shown || !sprite) return;
110: 
111:     let start = -1;
112:     let frame = 0;
113: 
114:     const tick = (now: number) => {
115:       // The original's load blocks the frame loop; here the loading screen
116:       // still covers the world, so the clock waits for it.
117:       if (start < 0) {
118:         if (Store.sceneLoading) {
119:           frame = requestAnimationFrame(tick);
120:           return;
121:         }
122:         start = now;
123:       }
124: 
125:       const t = now - start;
126:       let alpha: number;
127: 
128:       if (t < FADE_IN_MS) {
129:         alpha = START_ALPHA + (ALPHA_PER_SECOND * t) / 1000;
130:       } else if (t < FADE_IN_MS + SHOW_TIME) {
131:         alpha = 1;
132:       } else if (t < FADE_IN_MS + SHOW_TIME + FADE_OUT_MS) {
133:         alpha = 1 - (ALPHA_PER_SECOND * (t - FADE_IN_MS - SHOW_TIME)) / 1000;
134:       } else {
135:         setShown(current => (current === shown ? null : current));
136:         return;
137:       }
138: 
139:       if (ref.current) ref.current.style.opacity = alpha.toFixed(3);
140:       frame = requestAnimationFrame(tick);
141:     };
142: 
143:     frame = requestAnimationFrame(tick);
144:     return () => cancelAnimationFrame(frame);
145:   }, [shown, sprite]);
146: 
147:   if (!shown || !file || !sprite) return null;
148: 
149:   return (
150:     <div
151:       ref={ref}
152:       className="map-name-banner"
153:       style={{
154:         width: IMG_WIDTH * scale,
155:         height: IMG_HEIGHT * scale,
156:         marginLeft: (-IMG_WIDTH * scale) / 2,
157:         top: IMG_TOP * scale,
158:         // The original draws the 166x90 top-left corner of a 256x128 texture;
159:         // this Data folder ships the images already cropped to 166x90. Sizing
160:         // by the decoded picture keeps both layouts right.
161:         backgroundImage: `url(${sprite.url})`,
162:         backgroundSize: `${sprite.width * scale}px ${sprite.height * scale}px`,
163:         opacity: START_ALPHA,
164:       }}
165:     />
166:   );
167: };
</file>

