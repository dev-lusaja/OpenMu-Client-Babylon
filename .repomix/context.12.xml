 367:   // A gacha carries no roll until its order is delivered, so there is no item
 368:   // to name and none may be guessed at: the queue says what it is - a sealed
 369:   // roll - rather than naming the box the player bought.
 370:   if (!roll) return order.line === 'gacha' ? t('cashShop.sealedRoll') : order.productName;
 371: 
 372:   const name = roll.excellent ? t('item.excellentPrefix', { name: roll.name }) : roll.name;
 373:   return roll.level > 0 ? `${name} +${roll.level}` : name;
 374: }
