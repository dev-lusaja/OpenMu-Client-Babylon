778: /** The Job change tab: the legacy chain's current quest and its state (`RenderJobChangeContents/State`). */
779: const JobChangeTab = observer(() => {
780:   const index = legacyQuestCurrentIndex();
781:   const state = legacyQuestState(index);
782:   const quest = questDefinition(index);
783:   const lines = quest
784:     ? wrapDialogText(
785:         t(
786:           state === LegacyQuestState.InProgress
787:             ? 'quest.talkToContinue'
788:             : 'quest.talkToStart',
789:           { npc: monsterName(quest.npcType) }
790:         ),
791:         3,
792:         S6_LINE_CHARS
793:       )
794:     : [];
795:   const stateText =
796:     state === LegacyQuestState.Finished
797:       ? t('quest.completed')
798:       : state === LegacyQuestState.InProgress
799:         ? t('quest.inProgress')
800:         : t('quest.notStarted');
801: 
802:   return (
803:     <>
804:       <Line y={MQ_JOB_TITLE_Y} text={legacyQuestWindowTitle() || quest?.name || ''} bold color={COLOR.subject} />
805:       {lines.map((line, i) => (
806:         <Line key={i} y={MQ_JOB_TEXT_Y + i * 16} text={line} color={COLOR.tabOn} />
807:       ))}
808:       <Separator y={182} />
809:       <Line y={MQ_JOB_STATE_Y} left={23} text={stateText} bold color={COLOR.yellow} />
810:     </>
811:   );
