648: 
649:   useEffect(() => {
650:     if (!open) return;
651:     const handler = (e: KeyboardEvent) => {
652:       if (e.key === 'Enter') Social.guildMasterAnswer(true);
653:       else if (e.key === 'Escape') Social.guildMasterAnswer(false);
654:       else return;
655:       e.preventDefault();
656:     };
657:     window.addEventListener('keydown', handler);
658:     return () => window.removeEventListener('keydown', handler);
659:   }, [open]);
