 26: /**
 27:  * When the three events OpenMU runs next open, as three lines under the
 28:  * corner minimap's slot. Ours: the original only ever answered the question
 29:  * at the NPC or on a ticket, one notice at a time.
 30:  *
 31:  * No chrome of its own - the lines are the small HUD font the in-event timer
 32:  * figure and the match notices draw in, in their colours. The rows keep the
 33:  * slot's place whether the minimap panel is drawn in it or not, so nothing
 34:  * below them moves when that option is toggled.
 35:  *
 36:  * Reads `events/schedule.ts` and writes nothing.
 37:  */
 38: 
 39: const LABEL: Readonly<Record<EventScheduleKey, () => string>> = {
 40:   bloodCastle: () => EVENT_TEXT.bloodCastle,
 41:   devilSquare: () => EVENT_TEXT.devilSquare,
 42:   chaosCastle: () => EVENT_TEXT.chaosCastle,
 43: };
 44: 
 45: /** Open the entry the event already has, or ask the server again. */
 46: function clickRow(row: EventScheduleRow): void {
 47:   if (!row.open) {
 48:     refreshEventSchedule(row.key);
 49:     return;
 50:   }
 51:   if (row.key === 'bloodCastle') events.openBloodCastle();
 52:   else if (row.key === 'devilSquare') events.openDevilSquare();
 53:   else events.askChaosCastleOpening();
 54: }
 55: 
 56: const Row = observer(({ row }: { row: EventScheduleRow }) => {
 57:   // Grey is for silence only: a row the server answered reads in the timer's
 58:   // own colour even when all it said was that the wait is a long one.
 59:   const color = row.open
 60:     ? EVENT_ROW_COLOR_OPEN
 61:     : row.seconds === null && !row.far
 62:       ? EVENT_ROW_COLOR_UNKNOWN
 63:       : EVENT_ROW_COLOR;
 64:   const value = rowText(row);
 65: 
 66:   return (
 67:     <div
 68:       className="event-row"
 69:       style={{ height: EVENT_ROW_HEIGHT, lineHeight: `${EVENT_ROW_HEIGHT}px` }}
 70:       onClick={() => clickRow(row)}
 71:     >
 72:       <MuText
 73:         className="event-row-label"
 74:         text={LABEL[row.key]()}
 75:         color={color}
 76:         style={{ width: EVENT_ROW_LABEL_WIDTH }}
 77:       />
 78:       <MuText
 79:         className="event-row-clock"
 80:         text={value}
 81:         color={color}
 82:         style={{ width: EVENT_ROW_CLOCK_WIDTH }}
 83:       />
 84:     </div>
 85:   );
 86: });
 87: 
 88: export const EventTimers = observer(() => {
 89:   const rows = eventSchedule();
 90:   if (!GameOptions.eventTimers || !Store.world) return null;
 91: 
 92:   const scale = uiScaleFactor(GameOptions.uiScale);
 93: 
 94:   return (
 95:     <div
 96:       className="event-timers"
 97:       style={{
 98:         top: MINIMAP_SLOT_TOP + (MINIMAP_SLOT_HEIGHT + EVENT_ROW_GAP) * scale,
 99:         transform: `scale(${scale})`,
100:       }}
101:     >
102:       {rows.map(row => (
103:         <Row key={row.key} row={row} />
104:       ))}
105:     </div>
106:   );
107: });
</file>

