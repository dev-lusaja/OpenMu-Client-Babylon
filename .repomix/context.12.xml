  7: import { GuildRelationshipTypeEnum } from '../../../../../common/packets/ClientToServerPackets';
  8: import { MuButton } from '../../../../components/muButton';
  9: import { MuSpriteFrame } from '../../../../components/muSprite';
 10: import { TEXT_COLOR } from '../../../../pages/serversPage/layout';
 11: import {
 12:   BACK_SPRITE,
 13:   BTN_BOTH_CANCEL_X,
 14:   BTN_BOTH_OK_X,
 15:   BTN_HEIGHT,
 16:   BTN_WIDTH,
 17:   BTN_Y,
 18:   CANCEL_SPRITE,
 19:   OK_SPRITE,
 20:   WIN_HEIGHT,
 21:   WIN_WIDTH,
 22: } from '../../../../components/msgWindow/layout';
 23: 
 24: /** GlobalText 1295 / 1321 wording, by relationship and join/leave. */
 25: function relationText(request: {
 26:   senderName: string;
 27:   relationship: GuildRelationshipTypeEnum;
 28:   join: boolean;
 29: }): string {
 30:   const alliance = request.relationship === GuildRelationshipTypeEnum.Alliance;
 31:   const name = request.senderName;
 32:   if (alliance) {
 33:     return request.join
 34:       ? t('social.allianceOffer', { name })
 35:       : t('social.allianceLeave', { name });
 36:   }
 37:   return request.join
 38:     ? t('social.hostilityDeclare', { name })
 39:     : t('social.hostilityEnd', { name });
 40: }
 41: 
 42: /**
 43:  * The yes/no boxes another player's request pops up: `CPartyMsgBoxLayout`,
 44:  * `CGuildMsgBoxLayout`, `CGuildWar_MsgBoxLayout`
 45:  * (NewUICommonMessageBox.cpp:1418), the guild alliance / hostility offer and
 46:  * the friend request. Enter accepts, Escape refuses; only one box is up at a
 47:  * time, in the order below.
 48:  */
 49: export const SocialPrompts = observer(() => {
 50:   const party = Social.partyRequest;
 51:   const guild = !party ? Social.guildJoinRequest : null;
 52:   const war = !party && !guild ? Social.guildWarRequest : null;
 53:   const relation = !party && !guild && !war ? Social.guildRelationRequest : null;
 54:   const friend =
 55:     !party && !guild && !war && !relation ? Messenger.friendRequest : null;
 56: 
 57:   const answer = (accepted: boolean) => {
 58:     if (party) Social.partyRespond(accepted);
 59:     else if (guild) Social.guildJoinRespond(accepted);
 60:     else if (war) Social.guildWarRespond(accepted);
 61:     else if (relation) Social.guildRelationRespond(accepted);
 62:     else if (friend) Messenger.respondToFriendRequest(accepted);
 63:   };
 64: 
 65:   const text = party
 66:     ? t('social.partyInvite', { name: party.requesterName })
 67:     : guild
 68:       ? t('social.guildJoin', { name: guild.requesterName })
 69:       : war
 70:         ? war.soccer
 71:           ? t('social.battleSoccer', { name: war.guildName })
 72:           : t('social.guildWar', { name: war.guildName })
 73:         : relation
 74:           ? relationText(relation)
 75:           : friend
 76:             ? t('social.friendRequest', { name: friend.name })
 77:             : '';
 78: 
 79:   useEffect(() => {
 80:     if (!text) return;
 81:     const handler = (e: KeyboardEvent) => {
 82:       if (e.key === 'Enter') answer(true);
 83:       else if (e.key === 'Escape') answer(false);
 84:       else return;
 85:       e.preventDefault();
 86:     };
 87:     window.addEventListener('keydown', handler);
 88:     return () => window.removeEventListener('keydown', handler);
 89:   });
 90: 
 91:   if (!text) return null;
 92: 
 93:   return (
 94:     <div className="social-prompt-layer">
 95:       <MuSpriteFrame
 96:         file={BACK_SPRITE}
 97:         width={WIN_WIDTH}
 98:         height={WIN_HEIGHT}
 99:         className="social-prompt"
100:       >
101:         <div className="social-prompt-text">{text}</div>
102:         <MuButton
103:           file={OK_SPRITE}
104:           width={BTN_WIDTH}
105:           height={BTN_HEIGHT}
106:           frames={{ up: 0, active: 1, down: 2 }}
107:           color={TEXT_COLOR.brightGray}
108:           activeColor={TEXT_COLOR.white}
109:           onClick={() => answer(true)}
110:           style={{ position: 'absolute', left: BTN_BOTH_OK_X, top: BTN_Y }}
111:         />
112:         <MuButton
113:           file={CANCEL_SPRITE}
114:           width={BTN_WIDTH}
115:           height={BTN_HEIGHT}
116:           frames={{ up: 0, active: 1, down: 2 }}
117:           color={TEXT_COLOR.brightGray}
118:           activeColor={TEXT_COLOR.white}
119:           onClick={() => answer(false)}
120:           style={{ position: 'absolute', left: BTN_BOTH_CANCEL_X, top: BTN_Y }}
121:         />
122:       </MuSpriteFrame>
123:     </div>
124:   );
125: });
</file>

