<file path="src/ui/pages/worldPage/components/cashShop/style.less">
   1: @import (reference) '../../../../components/muText/style.less';
   2: // `CNewUICashShop` renders at absolute coordinates inside the 190x429 item
   3: // frame, like the NPC shop and the inventory; the numbers live in layout.ts,
   4: // this file only says how each piece behaves.
   5: //
   6: // Everything is under `.cash-shop` except the two things that are not inside
   7: // the window: the purchase question and the light the gacha throws past the
   8: // frame, both portalled to the body. Every stylesheet here is bundled into one
   9: // global sheet, so a bare name is a collision waiting to happen.
  10: .cash-shop {
  11:   font-size: 11px;
  12: 
  13:   .cash-title {
  14:     position: absolute;
  15:     left: 0;
  16:     right: 0;
  17:     text-align: center;
  18:     font-weight: bold;
  19:     color: #dcdcdc;
  20:     text-shadow: 1px 1px 0 #000;
  21:   }
  22: 
  23:   // The X painted into the frame art. Without a hotspot it starts a drag.
  24:   .head-close {
  25:     position: absolute;
  26:     cursor: pointer;
  27:   }
  28: 
  29:   // Catalogue loading / failed. It sits inside the grid rect and the grid or
  30:   // the stage paints over it once there is one, which is the point: it is
  31:   // the catalogue's line, never a roll's.
  32:   .cash-note {
  33:     position: absolute;
  34:     left: 15px;
  35:     top: 120px;
  36:     width: 160px;
  37:     margin: 0;
  38:     text-align: center;
  39:     color: #b9ad94;
  40:     text-shadow: 1px 1px 0 #000;
  41: 
  42:     &.is-bad {
  43:       color: #ff8080;
  44:     }
  45:   }
  46: 
  47:   // ---- tabs ----
  48: 
  49:   .cash-tabs {
  50:     position: absolute;
  51:     height: 22px;
  52:   }
  53: 
  54:   // A label is clipped inside its own 33px rather than drawn over the next
  55:   // tab: MuButton centres it in the plate and clips nothing.
  56:   .cash-tab {
  57:     position: absolute;
  58:     top: 0;
  59:     overflow: hidden;
  60:     white-space: nowrap;
  61:     text-shadow: 1px 1px 0 #000;
  62:   }
  63: 
  64:   // How many delivered rolls are still owed their opening. In the corner of
  65:   // the plate rather than in the label: MuButton fills the plate with an
  66:   // `inset: 0` flex row, which is this element's containing block, so the
  67:   // count floats over the label instead of pushing it off centre - and a
  68:   // digit is the same width in all thirteen languages the 41px has to hold.
  69:   .cash-tab-badge {
  70:     position: absolute;
  71:     right: 3px;
  72:     top: 2px;
  73:     box-sizing: border-box;
  74:     min-width: 11px;
  75:     height: 11px;
  76:     padding: 0 2px;
  77:     border-radius: 6px;
  78:     background: #ffd88a;
  79:     color: #2a2318;
  80:     font-size: 8px;
  81:     line-height: 11px;
  82:     text-align: center;
  83:     text-shadow: none;
  84:   }
  85: 
  86:   // ---- the stock grid ----
  87: 
  88:   // Same gapless 20px pitch as the inventory; the hit-test maths assume it.
  89:   .cash-grid {
  90:     position: absolute;
  91:     cursor: pointer;
  92:   }
  93: 
  94:   // `GridSquares` gives every square its left/top inline, which does nothing
  95:   // until the square is taken out of flow. Without this they stack vertically
  96:   // and spill out of the window.
  97:   .cash-square {
  98:     position: absolute;
  99: 
 100:     &.used::after {
 101:       content: '';
 102:       position: absolute;
 103:       left: 0;
 104:       top: 0;
 105:       width: 20px;
 106:       height: 20px;
 107:       background-color: #4d808099;
 108:     }
 109: 
 110:     &.hovered::after {
 111:       background-color: #80b3ff99;
 112:     }
 113:   }
 114: 
 115:   .cash-item {
 116:     position: absolute;
 117:     display: grid;
 118:     place-items: center;
 119:     pointer-events: none;
 120: 
 121:     .item-icon {
 122:       max-width: 100%;
 123:       max-height: 100%;
 124:     }
 125:   }
 126: 
 127:   // The chosen item, in the tab colour, over its own squares.
 128:   .cash-selected {
 129:     position: absolute;
 130:     box-sizing: border-box;
 131:     border: 1px solid #ffd88a;
 132:     box-shadow: inset 0 0 6px #ffd88a80;
 133:     pointer-events: none;
 134:   }
 135: 
 136:   // ---- jewels ----
 137: 
 138:   .cash-jewel {
 139:     display: inline-flex;
 140:     align-items: center;
 141:     gap: 3px;
 142:     color: #dcdcdc;
 143:     text-shadow: 1px 1px 0 #000;
 144: 
 145:     &.is-short {
 146:       color: #ff8080;
 147:     }
 148: 
 149:     // On a button plate and in the queue, where 20px is too much icon.
 150:     &.is-small {
 151:       gap: 2px;
 152:       font-size: 9px;
 153: 
 154:       .cash-jewel-icon {
 155:         width: 14px;
 156:         height: 14px;
 157:       }
 158:     }
 159:   }
 160: 
 161:   // The icon pack pads every file by a constant 80x84 plus 40x42 per grid
 162:   // cell, so a 1x1 jewel is 21 opaque pixels in a 120px frame and renders as a
 163:   // speck. That is right inside the stock grid, where the squares carry the
 164:   // scale and the inventory does exactly the same - but the money bar is
 165:   // chrome, and a balance has to be readable. The Jewel of Chaos file
 166:   // measures the same 120x126 as the Bless and Soul ones did, so the clipped
 167:   // zoom is unchanged, and it scales with the box it is in.
 168:   .cash-jewel-icon {
 169:     display: grid;
 170:     place-items: center;
 171:     width: 20px;
 172:     height: 20px;
 173:     overflow: hidden;
 174: 
 175:     .item-icon {
 176:       max-width: 100%;
 177:       max-height: 100%;
 178:       transform: scale(4.2);
 179:     }
 180:   }
 181: 
 182:   .cash-wallet {
 183:     position: absolute;
 184:     height: 24px;
 185:     display: flex;
 186:     align-items: center;
 187:     justify-content: space-around;
 188:     pointer-events: none;
 189:   }
 190: 
 191:   .cash-wallet-held {
 192:     font-size: 9px;
 193:     color: #9c8f78;
 194:     text-shadow: 1px 1px 0 #000;
 195:   }
 196: 
 197:   // ---- the selection band ----
 198: 
 199:   // Between the grid and the money bar: the item under the pointer or the
 200:   // one picked, its price, and on the second line what stands between the
 201:   // player and it. Two lines of 10px in 31px; anything longer is clipped
 202:   // rather than pushed into the bar.
 203:   .cash-selection {
 204:     position: absolute;
 205:     display: flex;
 206:     flex-direction: column;
 207:     align-items: center;
 208:     justify-content: center;
 209:     gap: 2px;
 210:     overflow: hidden;
 211:     color: #dcdcdc;
 212:     font-size: 10px;
 213:     text-shadow: 1px 1px 0 #000;
 214:   }
 215: 
 216:   .cash-selection-line {
 217:     display: flex;
 218:     align-items: center;
 219:     gap: 6px;
 220:     max-width: 100%;
 221:     white-space: nowrap;
 222: 
 223:     &.is-dim {
 224:       color: #9c8f78;
 225:     }
 226: 
 227:     &.is-bad {
 228:       color: #ff8080;
 229:     }
 230: 
 231:     &.is-good {
 232:       color: #80ff80;
 233:     }
 234:   }
 235: 
 236:   .cash-selection-name {
 237:     overflow: hidden;
 238:     text-overflow: ellipsis;
 239:   }
 240: 
 241:   // ---- the delivery queue ----
 242: 
 243:   .cash-orders {
 244:     position: absolute;
 245:     box-sizing: border-box;
 246:     padding: 4px 4px 0;
 247:     overflow-x: hidden;
 248:     overflow-y: auto;
 249:     scrollbar-width: thin;
 250:     color: #b9ad94;
 251:     font-size: 9px;
 252:     text-shadow: 1px 1px 0 #000;
 253:   }
 254: 
 255:   .cash-orders-title {
 256:     margin-bottom: 3px;
 257:     text-align: center;
 258:     font-size: 10px;
 259:     font-weight: bold;
 260:     color: #ffd88a;
 261:   }
 262: 
 263:   .cash-orders-why {
 264:     margin: 0 0 6px;
 265:     line-height: 1.3;
 266:     color: #9c8f78;
 267:   }
 268: 
 269:   .cash-orders-note {
 270:     margin: 0;
 271:     text-align: center;
 272: 
 273:     &.is-bad {
 274:       color: #ff8080;
 275:     }
 276:   }
 277: 
 278:   .cash-order-list {
 279:     margin: 0;
 280:     padding: 0;
 281:     list-style: none;
 282:   }
 283: 
 284:   .cash-order {
 285:     padding: 4px 0;
 286:     border-top: 1px solid #3a3227;
 287: 
 288:     &.is-delivered {
 289:       opacity: 0.55;
 290:     }
 291: 
 292:     &.is-failed .cash-order-badge {
 293:       color: #ff8080;
 294:     }
 295: 
 296:     // The one row in the queue worth pressing: a roll that is paid for, in
 297:     // the bag, and still owed its opening. Undims the delivered rule above -
 298:     // same specificity, later wins - because this one is not finished
 299:     // business.
 300:     &.is-waiting {
 301:       padding-left: 4px;
 302:       border-left: 2px solid #ffd88a;
 303:       opacity: 1;
 304:       cursor: pointer;
 305:     }
 306: 
 307:     &.is-waiting:hover .cash-order-open {
 308:       color: #fff;
 309:     }
 310:   }
 311: 
 312:   .cash-order-open {
 313:     color: #ffd88a;
 314:   }
 315: 
 316:   .cash-order-head {
 317:     display: flex;
 318:     align-items: center;
 319:     justify-content: space-between;
 320:     gap: 4px;
 321:     color: #dcdcdc;
 322:   }
 323: 
 324:   .cash-order-name {
 325:     overflow: hidden;
 326:     white-space: nowrap;
 327:     text-overflow: ellipsis;
 328:   }
 329: 
 330:   .cash-order-state {
 331:     display: flex;
 332:     align-items: center;
 333:     justify-content: space-between;
 334:     margin-top: 1px;
 335:   }
 336: 
 337:   .cash-order-badge {
 338:     color: #9fd3ff;
 339:   }
 340: 
 341:   .cash-order-cancel {
 342:     padding: 0;
 343:     border: none;
 344:     background: none;
 345:     font: inherit;
 346:     color: #9c8f78;
 347:     text-shadow: inherit;
 348:     cursor: pointer;
 349: 
 350:     &:hover {
 351:       color: #ff8080;
 352:     }
 353:   }
 354: 
 355:   .cash-order-reason {
 356:     line-height: 1.3;
 357:     color: #9c8f78;
 358:   }
 359: 
 360:   // ---- the gacha stage ----
 361: 
 362:   // The stage is the grid rect with the grid taken away. `overflow: hidden`
 363:   // is the only clip in the window: the box enters from behind the frame art
 364:   // and the shockwaves reach past the edges because of it. The tier colour
 365:   // and every per-tier number arrive inline from TIERS; nothing here knows a
 366:   // tier by name except the drop light, which has no stage to read from.
 367:   //
 368:   // It is drawn in two halves, and only the second one knows the roll. Until
 369:   // the order is delivered the service does not send it (gacha.ts), so
 370:   // `--tier` is the neutral `--sealed` for the whole sealed half and every
 371:   // rule below `.phase-seam` is what the tier is allowed to touch.
 372:   .cash-gacha {
 373:     position: absolute;
 374:     overflow: hidden;
 375:     --tier: #79a9d8;
 376:     transition: filter 120ms linear;
 377: 
 378:     // The slam: one filter kills box, shafts and aura in the same frame.
 379:     &.phase-slam,
 380:     &.phase-hush {
 381:       filter: brightness(0.4) saturate(0.55);
 382:     }
 383:   }
 384: 
 385:   .cash-gacha-status {
 386:     position: absolute;
 387:     left: 0;
 388:     right: 0;
 389:     bottom: 8px;
 390:     margin: 0;
 391:     text-align: center;
 392:     color: #9c8f78;
 393:     font-size: 10px;
 394:     text-shadow: 1px 1px 0 #000;
 395: 
 396:     &.is-bad {
 397:       color: #ff8080;
 398:     }
 399:   }
 400: 
 401:   // The box. Placed with left/top and never a transform, so reduced motion's
 402:   // `transform: none` leaves it on its mark.
 403:   .cash-box {
 404:     position: absolute;
 405:     transform-origin: 50% 100%;
 406:     will-change: transform;
 407:   }
 408: 
 409:   // 14/11 is a 1x1 item: the pack pads it to a 120x126 frame around a 40x42
 410:   // cell, a third of the frame each way. Scaled to fill the box element the
 411:   // cell alone would be 25px, so the icon is zoomed 3x inside a clipped box -
 412:   // the money bar's own trick, tuned for a box rather than a jewel's smaller
 413:   // silhouette. It is drawn twice, clipped at the seam into a lid and a body,
 414:   // which is what lets the lid lift, knock and slam while the body sits.
 415:   .cash-box-face {
 416:     position: absolute;
 417:     inset: 0;
 418:     display: grid;
 419:     place-items: center;
 420:     overflow: hidden;
 421: 
 422:     .item-icon {
 423:       max-width: 100%;
 424:       max-height: 100%;
 425:       transform: scale(3);
 426:     }
 427:   }
 428: 
 429:   .cash-box-body {
 430:     clip-path: inset(var(--seam) 0 0 0);
 431:   }
 432: 
 433:   .cash-box-lid {
 434:     clip-path: inset(0 0 calc(100% - var(--seam)) 0);
 435:     transform-origin: 50% var(--seam);
 436: 
 437:     // The knock rides on the lid, not the box, so it composes with the
 438:     // rattle instead of fighting its keyframes. The name comes inline and
 439:     // alternates between two identical sets: an animation only restarts when
 440:     // its name changes, and remounting the lid would re-decode the icon.
 441:     &.is-knock {
 442:       animation-duration: 90ms;
 443:       animation-timing-function: ease-out;
 444:     }
 445:   }
 446: 
 447:   .cash-box-seam {
 448:     position: absolute;
 449:     left: 6%;
 450:     right: 6%;
 451:     height: 2px;
 452:     transform: scaleX(0);
 453:     background: linear-gradient(90deg, transparent, var(--tier) 20%, #fff 50%, var(--tier) 80%, transparent);
 454:     box-shadow: 0 0 12px 3px var(--tier);
 455:     filter: blur(0.4px);
 456:     transition:
 457:       transform 240ms ease-out,
 458:       height 200ms,
 459:       opacity 200ms,
 460:       box-shadow 200ms;
 461:   }
 462: 
 463:   .cash-box-shaft {
 464:     position: absolute;
 465:     left: 50%;
 466:     width: 34px;
 467:     height: 70px;
 468:     margin-left: -17px;
 469:     clip-path: polygon(46% 0, 54% 0, 100% 100%, 0 100%);
 470:     background: linear-gradient(to bottom, var(--tier), transparent);
 471:     mix-blend-mode: screen;
 472:     transform-origin: 50% 0;
 473:     transform: rotate(calc(var(--i) * 360deg / var(--n))) scaleY(0);
 474:     opacity: 0;
 475:     transition:
 476:       transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
 477:       opacity 200ms;
 478:     transition-delay: calc(var(--i) * 24ms);
 479:   }
 480: 
 481:   .cash-box-aura {
 482:     position: absolute;
 483:     inset: -40%;
 484:     background: radial-gradient(circle, var(--tier) 0%, transparent 68%);
 485:     filter: blur(6px);
 486:     opacity: 0;
 487:     transition: opacity 240ms;
 488:   }
 489: 
 490:   // The fall ends hanging 4px off the floor with its fill; the landing does
 491:   // the last 4px, so a slow answer reads as held breath, not a stall.
 492:   .phase-falling .cash-box {
 493:     animation: cash-fall 240ms cubic-bezier(0.55, 0.05, 0.9, 0.25) both;
 494:   }
 495: 
 496:   .phase-landed .cash-box {
 497:     animation: cash-squash 180ms cubic-bezier(0.3, 1.5, 0.5, 1) both;
 498:   }
 499: 
 500:   .phase-rattling .cash-box,
 501:   .phase-seam .cash-box,
 502:   .phase-strain .cash-box {
 503:     animation: cash-rattle var(--rattle) linear infinite;
 504:   }
 505: 
 506:   // The swallow: the jewel goes in and the box pops bright for a frame.
 507:   .phase-rattling .cash-box-face {
 508:     animation: cash-swallow 120ms;
 509:   }
 510: 
 511:   // ---- the seal ----
 512: 
 513:   // Where the sealed half ends, and everything a player is shown before their
 514:   // jewels have actually been taken. Every rule here paints in `--sealed` and
 515:   // runs to a fixed beat from SEAL: a hue, a duration or a particle that
 516:   // moved with the tier would be enough to shop for an outcome, because a
 517:   // player who disliked the tell could spend their jewels, fail the delivery,
 518:   // and get the daily-cap slot back to roll again. gacha.ts has the whole of
 519:   // it.
 520:   .cash-box-clasp {
 521:     position: absolute;
 522:     left: 50%;
 523:     box-sizing: border-box;
 524:     width: 12px;
 525:     height: 8px;
 526:     margin-left: -6px;
 527:     border: 1px solid var(--sealed);
 528:     border-radius: 2px;
 529:     background: linear-gradient(#00000066, #000000cc);
 530:     box-shadow: 0 0 3px #000000aa;
 531:   }
 532: 
 533:   // The lid coming down, on the `repair` chime state.ts plays with it.
 534:   .phase-sealing {
 535:     .cash-box {
 536:       animation: cash-seal-shut 200ms cubic-bezier(0.7, 0, 0.4, 1.4) both;
 537:     }
 538: 
 539:     .cash-box-clasp {
 540:       animation: cash-clasp-snap 200ms cubic-bezier(0.2, 1.6, 0.4, 1) both;
 541:     }
 542:   }
 543: 
 544:   // Shut, and plainly so: a clasp on the front and the seam down to a thread
 545:   // of neutral light, which is the one thing the box is allowed to say - that
 546:   // there is something in it.
 547:   .phase-sealing,
 548:   .phase-sealed {
 549:     .cash-box-seam {
 550:       transform: scaleX(0.62);
 551:       opacity: 0.4;
 552:       box-shadow: 0 0 7px 1px var(--sealed);
 553:     }
 554:   }
 555: 
 556:   // A box left standing on the stage for however long it takes the player to
 557:   // log out. It breathes so the stage is not a still frame, on the same slow
 558:   // ember the hush uses - infinite and unfilled, so nothing is stranded when
 559:   // the phase moves on.
 560:   .phase-sealed {
 561:     .cash-box {
 562:       animation: cash-breathe 2800ms ease-in-out infinite;
 563:     }
 564: 
 565:     .cash-box-seam {
 566:       animation: cash-ember 2800ms ease-in-out infinite;
 567:     }
 568:   }
 569: 
 570:   // The opening starts on the box the player watched lock, so it is the clasp
 571:   // breaking off it that says this one is being opened - never a second box
 572:   // arriving. The seam takes the tier's colour on the same frame, growing out
 573:   // of the thread that was already there.
 574:   .phase-seam,
 575:   .phase-strain,
 576:   .phase-slam,
 577:   .phase-hush,
 578:   .phase-burst {
 579:     .cash-box-clasp {
 580:       opacity: 0;
 581:       transform: translateY(-7px) scale(1.5) rotate(-12deg);
 582:       transition:
 583:         opacity 180ms ease-out,
 584:         transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
 585:     }
 586:   }
 587: 
 588:   // The dust the lid knocks off the floor. `cash-thud` is the drop's, white
 589:   // and thrown wide; this one is the seal's own colour and stays close to the
 590:   // box, because it is a lid coming down rather than a box coming down.
 591:   .cash-seal-dust {
 592:     position: absolute;
 593:     left: 50%;
 594:     width: 10px;
 595:     height: 18px;
 596:     border: 1px solid var(--sealed);
 597:     border-radius: 50%;
 598:     transform: translate(-50%, -50%) scaleY(0.3);
 599:     // Inside the 260ms `sealing` runs for (SEAL.shut to SEAL.sealed), so the
 600:     // ring is spent rather than cut off when the phase takes it away.
 601:     animation: cash-seal-dust 240ms ease-out forwards;
 602:   }
 603: 
 604:   // ---- the opening ----
 605: 
 606:   .phase-seam,
 607:   .phase-strain {
 608:     .cash-box-seam {
 609:       transform: scaleX(1);
 610:     }
 611: 
 612:     .cash-box-shaft {
 613:       transform: rotate(calc(var(--i) * 360deg / var(--n))) scaleY(1);
 614:       opacity: 0.75;
 615:     }
 616:   }
 617: 
 618:   .phase-seam .cash-box-aura {
 619:     opacity: var(--aura);
 620:   }
 621: 
 622:   .phase-strain {
 623:     .cash-box-lid {
 624:       transform: translateY(-3px);
 625:       transition: transform 200ms ease-out;
 626:     }
 627: 
 628:     .cash-box-seam {
 629:       height: 4px;
 630:       box-shadow: 0 0 24px 6px var(--tier);
 631:     }
 632: 
 633:     .cash-box-aura {
 634:       opacity: calc(var(--aura) * 1.5);
 635:       animation: cash-pulse 280ms ease-in-out infinite;
 636:     }
 637:   }
 638: 
 639:   .phase-slam,
 640:   .phase-hush {
 641:     .cash-box-lid {
 642:       transform: none;
 643:       transition: transform 90ms cubic-bezier(0.7, 0, 1, 0.6);
 644:     }
 645: 
 646:     .cash-box-seam {
 647:       transform: scaleX(0.15);
 648:       box-shadow: none;
 649:     }
 650: 
 651:     .cash-box-aura {
 652:       opacity: 0.05;
 653:     }
 654:   }
 655: 
 656:   // A 1px ember in the closed seam. The length of the silence is the tier.
 657:   .phase-hush .cash-box-seam {
 658:     opacity: 0.12;
 659:     animation: cash-ember var(--hush) ease-in-out infinite;
 660:   }
 661: 
 662:   .phase-burst .cash-box {
 663:     animation: cash-shatter 140ms ease-in forwards;
 664:   }
 665: 
 666:   .phase-refused .cash-box {
 667:     animation: cash-yank 180ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
 668:   }
 669: 
 670:   // The dust ring along the floor on landing.
 671:   .cash-thud {
 672:     position: absolute;
 673:     left: 50%;
 674:     width: 8px;
 675:     height: 20px;
 676:     border: 1px solid rgba(255, 255, 255, 0.55);
 677:     border-radius: 50%;
 678:     transform: translate(-50%, -50%) scaleY(0.35);
 679:     animation: cash-thud 260ms ease-out forwards;
 680:   }
 681: 
 682:   // ---- the reveal ----
 683: 
 684:   // Mounted at the burst and keyed on the seed; every delay below counts from
 685:   // that frame and arrives inline from OPEN (`--after-*`, `--option-step`),
 686:   // so the sounds in state.ts and the drawing here keep the one timeline.
 687:   .cash-reveal {
 688:     position: absolute;
 689:     inset: 0;
 690:     display: grid;
 691:     place-items: center;
 692:     align-content: center;
 693:     gap: 4px;
 694:     pointer-events: none;
 695:   }
 696: 
 697:   .cash-shock {
 698:     position: absolute;
 699:     left: 50%;
 700:     top: 50%;
 701:     width: 20px;
 702:     height: 20px;
 703:     transform: translate(-50%, -50%);
 704:     border: 2px solid var(--tier);
 705:     border-radius: 50%;
 706:     animation: cash-shock 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
 707:     animation-delay: calc(var(--i) * 90ms);
 708:   }
 709: 
 710:   .cash-ray {
 711:     position: absolute;
 712:     left: calc(50% - 1px);
 713:     bottom: 50%;
 714:     width: 2px;
 715:     height: 0;
 716:     background: linear-gradient(to top, transparent, var(--tier));
 717:     transform-origin: 50% 100%;
 718:     transform: rotate(calc(var(--i) * 360deg / var(--n)));
 719:     opacity: 0;
 720:     animation: cash-ray 850ms ease-out forwards;
 721:   }
 722: 
 723:   // Legendary only: a slow conic halo behind the settled prize, until the
 724:   // next roll. Prefixed like everything else here - the bare `.ring` names
 725:   // once matched the emote menu's SVG wedges.
 726:   .cash-halo {
 727:     position: absolute;
 728:     left: 50%;
 729:     top: 50%;
 730:     width: 150px;
 731:     height: 150px;
 732:     margin: -75px;
 733:     border-radius: 50%;
 734:     background: conic-gradient(from 0deg, transparent, var(--tier) 25%, transparent 45%, transparent 55%, var(--tier) 75%, transparent);
 735:     mask: radial-gradient(circle, transparent 54%, #000 58%, #000 70%, transparent 74%);
 736:     opacity: 0.5;
 737:     animation: cash-spin 9s linear infinite;
 738:   }
 739: 
 740:   // Clipped and rounded so the shine sweeps inside the icon's box; safe for
 741:   // the glow because the pack pads the silhouette ~20px inside at this zoom.
 742:   .cash-prize {
 743:     position: relative;
 744:     display: grid;
 745:     place-items: center;
 746:     overflow: hidden;
 747:     border-radius: 6px;
 748:     animation: cash-prize-in 650ms cubic-bezier(0.2, 1.4, 0.4, 1) var(--after-prize) both;
 749: 
 750:     .item-icon {
 751:       max-width: 100%;
 752:       max-height: 100%;
 753:       filter: drop-shadow(0 0 var(--glow) var(--tier));
 754:     }
 755:   }
 756: 
 757:   .phase-settled .cash-prize .item-icon {
 758:     animation: cash-idle-glow 3.4s ease-in-out infinite;
 759:   }
 760: 
 761:   // The excellent gloss: once for rare and epic, twice for legendary, never
 762:   // for common - `--shimmer` is the iteration count.
 763:   .cash-shine {
 764:     position: absolute;
 765:     inset: 0;
 766:     background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.85) 50%, transparent 58%);
 767:     mix-blend-mode: screen;
 768:     transform: translateX(-140%);
 769:     animation: cash-shine 620ms ease-in-out var(--after-shine) var(--shimmer, 0) forwards;
 770:   }
 771: 
 772:   // Always drawn, at every tier and in every motion setting: the floor is a
 773:   // noun, not a hue.
 774:   .cash-prize-tier {
 775:     font-size: 8px;
 776:     letter-spacing: 1px;
 777:     text-transform: uppercase;
 778:     color: var(--tier);
 779:     text-shadow: 1px 1px 0 #000;
 780:     border-bottom: 1px solid color-mix(in srgb, var(--tier) 45%, transparent);
 781:     animation: cash-fade-up 380ms ease-out var(--after-name) both;
 782:   }
 783: 
 784:   // Name colour per nameColor (itemTooltip.ts:105): excellent green, +7 and
 785:   // up yellow, else white.
 786:   .cash-prize-name {
 787:     max-width: 100%;
 788:     text-align: center;
 789:     color: #dcdcdc;
 790:     font-size: 10px;
 791:     text-shadow: 1px 1px 0 #000;
 792:     animation: cash-fade-up 380ms ease-out var(--after-name) both;
 793: 
 794:     &.is-green {
 795:       color: #80ff80;
 796:     }
 797: 
 798:     &.is-yellow {
 799:       color: #ffd88a;
 800:     }
 801:   }
 802: 
 803:   .cash-prize-level {
 804:     color: var(--tier);
 805:   }
 806: 
 807:   // Each option writes itself in left to right, one step apart - the step
 808:   // the iButtonMove ticks in state.ts are spaced by. A common has no
 809:   // options, so the list is empty by construction rather than hidden.
 810:   .cash-prize-options {
 811:     margin: 0;
 812:     padding: 0;
 813:     list-style: none;
 814:     text-align: center;
 815: 
 816:     li {
 817:       color: #9fd3ff;
 818:       font-size: 9px;
 819:       line-height: 1.4;
 820:       text-shadow: 1px 1px 0 #000;
 821:       clip-path: inset(0 100% 0 0);
 822:       animation: cash-write 260ms ease-out both;
 823:       animation-delay: calc(var(--after-option) + var(--i) * var(--option-step));
 824:     }
 825:   }
 826: 
 827:   // A reveal that mounted already settled: the prize as it stands after the
 828:   // ceremony, with none of the entrances. The rings, rays and shine are not
 829:   // rendered at all in that case (index.tsx), so only what stays is here.
 830:   .cash-reveal.is-rest {
 831:     .cash-prize,
 832:     .cash-prize-tier,
 833:     .cash-prize-name {
 834:       animation: none;
 835:     }
 836: 
 837:     .cash-prize-options li {
 838:       clip-path: none;
 839:       animation: none;
 840:     }
 841:   }
 842: 
 843:   // ---- window level ----
 844: 
 845:   // The fee: a Jewel of Chaos peeling off the wallet bar and arcing into the
 846:   // seam. Not inside the stage, which clips anything below y 240; the rise
 847:   // comes inline from layout.ts so the arc lands on the seam it was
 848:   // measured against.
 849:   .cash-fee {
 850:     position: absolute;
 851:     width: 20px;
 852:     height: 20px;
 853:     pointer-events: none;
 854:     animation: cash-fee-arc 360ms ease-in both;
 855:   }
 856: 
 857:   // The whole 190x429 frame lit in the tier colour at the burst, for epic
 858:   // and legendary: the cabinet lighting up, without touching the transform
 859:   // useWindowChrome puts on the root.
 860:   .cash-frame-flash {
 861:     position: absolute;
 862:     inset: 0;
 863:     pointer-events: none;
 864:     animation: cash-frame-flash 420ms ease-out forwards;
 865:   }
 866: }
 867: 
 868: // ---- the purchase question ----
 869: 
 870: // The message box the social prompts use, on the body: the window is drawn
 871: // under `transform: scale()`, so anything fixed inside it is fixed to the
 872: // window. The layer lets clicks through; only the box catches them.
 873: .cash-confirm-layer {
 874:   position: fixed;
 875:   inset: 0;
 876:   z-index: 600; // WINDOW_Z_MODAL: over the windows and the sheets
 877:   pointer-events: none;
 878:   .mu-font();
 879:   user-select: none;
 880: }
 881: 
 882: .cash-confirm {
 883:   position: absolute;
 884:   left: 50%;
 885:   top: 50%;
 886:   transform: translate(-50%, -50%);
 887:   pointer-events: auto;
 888:   flex: none;
 889: }
 890: 
 891: .cash-confirm-text {
 892:   position: absolute;
 893:   display: flex;
 894:   flex-direction: column;
 895:   align-items: center;
 896:   justify-content: center;
 897:   text-align: center;
 898:   color: #ffffff;
 899:   font-size: 11px;
 900:   text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
 901: 
 902:   .cash-confirm-note {
 903:     font-size: 10px;
 904:     color: #c8bca8;
 905:   }
 906: }
 907: 
 908: // ---- the light that leaves the window ----
 909: 
 910: // Portalled to the body and positioned against the viewport; `--cx`, `--cy`
 911: // and `--scale` are written every frame by the stage's anchor loop. Only the
 912: // glow and one shockwave live here, nothing the player can click.
 913: .cash-drop-light {
 914:   position: fixed;
 915:   inset: 0;
 916:   pointer-events: none;
 917:   contain: layout paint;
 918:   --scale: 1.5;
 919:   --cx: 50vw;
 920:   --cy: 50vh;
 921: 
 922:   &::before {
 923:     content: '';
 924:     position: absolute;
 925:     inset: 0;
 926:     background: radial-gradient(circle at var(--cx) var(--cy), var(--tier) 0, transparent calc(var(--scale) * 260px));
 927:     opacity: 0;
 928:     transition: opacity 200ms ease-out;
 929:   }
 930: 
 931:   &.phase-strain::before {
 932:     opacity: 0.22;
 933:   }
 934: 
 935:   &.phase-slam::before,
 936:   &.phase-hush::before {
 937:     opacity: 0.04;
 938:   }
 939: 
 940:   &.phase-burst::before,
 941:   &.phase-prize::before {
 942:     opacity: 0.5;
 943:     animation: cash-light-fall 900ms ease-out forwards;
 944:   }
 945: 
 946:   &::after {
 947:     content: '';
 948:     position: absolute;
 949:     left: var(--cx);
 950:     top: var(--cy);
 951:     width: calc(var(--scale) * 40px);
 952:     height: calc(var(--scale) * 40px);
 953:     transform: translate(-50%, -50%);
 954:     border: 2px solid var(--tier);
 955:     border-radius: 50%;
 956:     opacity: 0;
 957:   }
 958: 
 959:   &.phase-burst::after,
 960:   &.phase-prize::after {
 961:     animation: cash-light-shock 700ms ease-out forwards;
 962:   }
 963: 
 964:   // The one white viewport flash: legendary, once, 140ms, inside WCAG 2.3.1
 965:   // by construction.
 966:   &.tier-legendary.phase-burst {
 967:     animation: cash-flash 140ms ease-out;
 968:   }
 969: }
