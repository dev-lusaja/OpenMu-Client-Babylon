758:           height={OPEN_BUTTON.height}
759:           frames={SMALL_BUTTON_FRAMES}
760:           disabled={!selected}
761:           onClick={openSelectedQuest}
762:         />
763:       </div>
764:       <div className="quest-button" data-no-drag="true" style={{ left: GIVEUP_BUTTON.x, top: GIVEUP_BUTTON.y }}>
765:         <MuButton
766:           file={GIVEUP_BUTTON_SPRITE}
767:           width={GIVEUP_BUTTON.width}
768:           height={GIVEUP_BUTTON.height}
769:           frames={SMALL_BUTTON_FRAMES}
770:           disabled={!selected}
771:           onClick={() => cancelQuest(selected)}
772:         />
773:       </div>
774:     </>
775:   );
776: });
