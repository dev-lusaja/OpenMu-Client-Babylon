 633:         {/* The clasp's own dust, in the neutral colour: a lock, not a tier. */}
 634:         {phase === 'sealing' && <span className="cash-seal-dust" style={{ top: BOX_REST_Y + BOX_SIZE }} />}
 635: 
 636:         {REVEALED.has(phase) && roll && <Reveal key={roll.seed} roll={roll} look={look} phase={phase} />}
 637: 
 638:         {phase === 'idle' && rollError && <p className="cash-gacha-status is-bad">{rollError}</p>}
 639:         {phase === 'idle' && !rollError && blocked && <p className="cash-gacha-status">{blocked}</p>}
 640:         {phase === 'idle' && !rollError && !blocked && (
 641:           <p className="cash-gacha-status">{t('cashShop.gachaHint', { count: product?.chaos ?? 0 })}</p>
 642:         )}
 643:         {/*
