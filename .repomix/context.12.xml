396: 
397:     const column = Math.floor(point.x / SQUARE);
398:     const row = Math.floor(point.y / SQUARE);
399: 
400:     if (column < 0 || column >= COLUMNS || row < 0 || row >= ROWS) return -1;
401:     return row * COLUMNS + column;
402:   };
