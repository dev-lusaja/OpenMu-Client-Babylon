825: /** `CNewUIMyQuestInfoWindow` (T): the quest log with its three tabs. */
826: const MyQuestInfoWindow = observer(() => {
827:   useEventBus('keyPressed', key => {
828:     if (isKey(HOT_KEY, key) && Store.world?.playerEntity) quests.toggleLog();
829:     if (key === 'Escape' && quests.anyWindowOpen) quests.closeAll();
830:   });
831: 
832:   if (!myQuestWindowOpen()) return null;
833: 
834:   const tab = myQuestTab();
835: 
836:   return (
837:     <MuItemWindow id={MY_QUEST_WINDOW_ID} className="quest-window" column={2}>
