 720: 
 721:   const { windowOpen, tab, catalogue, lines, status, error, buying, buyError, phase, roll, calm, unopened } =
 722:     CashShopState;
 723: 
 724:   const shown = useMemo(() => catalogue.filter(product => product.line === tab), [catalogue, tab]);
 725:   const { squares, placed } = useMemo(() => layOut(shown), [shown]);
 726:   const used = useMemo(() => usedMask(squares), [squares]);
