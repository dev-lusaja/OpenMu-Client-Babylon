 13: /**
 14:  * `CNewUIQuickCommandWindow` (NewUIQuickCommandWindow.cpp): the menu a right
 15:  * click on another player pops at the cursor - the player's name in green
 16:  * over a column of commands, each one an entry of the "D" command window run
 17:  * straight away instead of armed for a second click. Hovering a row turns it
 18:  * yellow and puts the two little arrows around it; a click runs it and
 19:  * closes the menu, and so do Escape, a click outside, and the target dying,
 20:  * leaving scope or walking off.
 21:  *
 22:  * The original opens on Alt + right click and lists five commands (GlobalText
 23:  * 943, 1124, 944, 948, 949). Alt is the pick-order modifier here
 24:  * (pointerInputSystem), so the menu takes the plain right click, and whisper
 25:  * and attack are appended to the five - the frame is a tiled middle band, so
 26:  * the art carries any number of rows.
 27:  */
 28: 
 29: /** `RenderFrame`: the panel is 112 wide and its two caps are 45 tall each. */
 30: const WIDTH = 112;
 31: const CAP_HEIGHT = 45;
 32: /** The middle band is drawn as 15 px tiles. */
 33: const MIDDLE_TILE = 15;
 34: /** `RenderContents`: one row per 19 px. */
 35: const ROW_HEIGHT = 19;
 36: /** `RenderText(m_Pos.x, m_Pos.y + 14, m_strID, 112, 0, RT3_SORT_CENTER)`. */
 37: const TITLE_Y = 14;
 38: /**
 39:  * A row: `CheckMouseIn(m_Pos.x, m_Pos.y + 38 + i * 19, 112, 19)` is the box,
 40:  * `RenderText(..., m_Pos.y + 14 + 30 + i * 19)` the label sitting 6 px into
 41:  * it, and `RenderArrow` the two markers a pixel above that. The rule at the
 42:  * bottom of the box (`m_Pos.y + 55 + i * 19`) is the divider to the next.
 43:  */
 44: const ROW_Y = 38;
 45: const LABEL_DY = 6;
 46: const ARROW_DY = 5;
 47: const LINE_DY = 17;
 48: /** `RenderImage(IMAGE_QUICKCOMMAND_LINE, m_Pos.x + 15, ..., 82, 2)`. */
 49: const LINE = { x: 15, width: 82, height: 2 };
 50: /** `RenderArrow`: 6x9 at `m_Pos.x + 16` and `m_Pos.x + 90`. */
 51: const ARROW = { width: 6, height: 9, left: 16, right: 90 };
 52: 
 53: const BACK_SPRITE = 'newui_msgbox_back.OZJ';
 54: const FRAME_UP_SPRITE = 'newui_commamd04.OZT';
 55: const FRAME_MIDDLE_SPRITE = 'newui_commamd02.OZT';
 56: const FRAME_DOWN_SPRITE = 'newui_commamd03.OZT';
 57: const LINE_SPRITE = 'newui_commamd_Line.OZJ';
 58: const ARROW_L_SPRITE = 'newui_arrow(L).OZT';
 59: const ARROW_R_SPRITE = 'newui_arrow(R).OZT';
 60: 
 61: /** `SetTextColor` on the title and on the rows. */
 62: const TITLE_COLOR = 'rgb(0, 255, 0)';
 63: const ROW_COLOR = '#fff';
 64: const ROW_SELECTED_COLOR = 'rgb(255, 255, 0)';
 65: 
 66: const WINDOW_ID = 'quick-command-window';
 67: 
 68: /** How often the menu re-checks that its target is still there (`Update`). */
 69: const TICK_MS = 100;
 70: 
 71: /**
 72:  * GlobalText 943, 1124, 944, 948, 949 - the original's five - with whisper
 73:  * (945) in the command window's place after party, and attack last.
 74:  */
 75: const ENTRIES: { kind: CommandKind; labelKey: TextKey }[] = [
 76:   { kind: 'trade', labelKey: 'command.trade' },
 77:   { kind: 'purchase', labelKey: 'command.purchase' },
 78:   { kind: 'party', labelKey: 'command.party' },
 79:   { kind: 'whisper', labelKey: 'command.whisper' },
 80:   { kind: 'follow', labelKey: 'command.follow' },
 81:   { kind: 'battle', labelKey: 'command.battle' },
 82:   { kind: 'attack', labelKey: 'command.attack' },
 83: ];
 84: 
 85: const HEIGHT = CAP_HEIGHT + ROW_HEIGHT * ENTRIES.length;
 86: const MIDDLE_HEIGHT = HEIGHT - CAP_HEIGHT * 2;
 87: 
 88: export const QuickCommandWindow = observer(() => {
 89:   const [selected, setSelected] = useState(-1);
 90:   // The markers mount only on the hovered row, so they are decoded up front:
 91:   // loaded on the hover itself they paint a frame or two after the yellow.
 92:   useMuSprite(ARROW_L_SPRITE);
 93:   useMuSprite(ARROW_R_SPRITE);
 94:   const target = Commands.quickTarget;
 95:   const open = target !== null;
 96: 
 97:   useWindowStackEntry(WINDOW_ID, open, () => {
 98:     Commands.closeQuick();
 99:     playUiSound('click');
100:   });
101: 
102:   useEffect(() => {
103:     if (!open) return;
104:     setSelected(-1);
105:     const tick = window.setInterval(() => Commands.quickTick(), TICK_MS);
106:     // `UpdateMouseEvent`: a **left release** outside the panel closes it.
107:     // The release, not the press, and the left button only - the right
108:     // release of the very click that opened the menu is still to come, and
109:     // it bubbles to a listener added during its own press.
110:     const onUp = (e: PointerEvent) => {
111:       if (e.button !== 0) return;
112:       const el = e.target as HTMLElement | null;
113:       if (!el?.closest(`.${WINDOW_ID}`)) Commands.closeQuick();
114:     };
115:     window.addEventListener('pointerup', onUp);
116:     return () => {
117:       window.clearInterval(tick);
118:       window.removeEventListener('pointerup', onUp);
119:     };
120:   }, [open]);
121: 
122:   if (!target) return null;
123: 
124:   const scale = uiScaleFactor(GameOptions.uiScale);
125:   // `y = MouseY - 50` is clamped to the top by `OpenQuickCommand`; the right
126:   // and bottom edges are ours, the menu being scaled by the interface size.
127:   const left = Math.min(Commands.quickPos.x, window.innerWidth - WIDTH * scale);
128:   const top = Math.min(Commands.quickPos.y, window.innerHeight - HEIGHT * scale);
129: 
130:   const run = (kind: CommandKind) => {
131:     const entity = target;
132:     Commands.closeQuick();
133:     Commands.run(kind, entity);
134:   };
135: 
136:   return (
137:     <div
138:       className={WINDOW_ID}
139:       style={{
140:         left: Math.max(0, left),
141:         top: Math.max(0, top),
142:         width: WIDTH,
143:         height: HEIGHT,
144:         transform: `scale(${scale})`,
145:       }}
146:       onPointerLeave={() => setSelected(-1)}
147:     >
148:       <MuSpriteFrame
149:         file={BACK_SPRITE}
150:         width={WIDTH}
151:         height={HEIGHT}
152:         className="quick-command-art"
153:         style={{ left: 0, top: 0, backgroundSize: '100% 100%' }}
154:       />
155:       <MuSpriteFrame
156:         file={FRAME_UP_SPRITE}
157:         width={WIDTH}
158:         height={CAP_HEIGHT}
159:         className="quick-command-art"
160:         style={{ left: 0, top: 0, backgroundSize: '100% 100%' }}
161:       />
162:       <MuSpriteFrame
163:         file={FRAME_MIDDLE_SPRITE}
164:         width={WIDTH}
165:         height={MIDDLE_HEIGHT}
166:         className="quick-command-art"
167:         style={{
168:           left: 0,
169:           top: CAP_HEIGHT,
170:           backgroundSize: `100% ${MIDDLE_TILE}px`,
171:           backgroundRepeat: 'repeat-y',
172:         }}
173:       />
174:       <MuSpriteFrame
175:         file={FRAME_DOWN_SPRITE}
176:         width={WIDTH}
177:         height={CAP_HEIGHT}
178:         className="quick-command-art"
179:         style={{ left: 0, top: HEIGHT - CAP_HEIGHT, backgroundSize: '100% 100%' }}
180:       />
181: 
182:       {/* `m_strID` in `g_hFontBold`, green, centred over the panel. */}
183:       <MuText
184:         face="bold"
185:         align="center"
186:         className="quick-command-title"
187:         color={TITLE_COLOR}
188:         style={{ top: TITLE_Y, width: WIDTH }}
189:         text={target.objectNameInWorld ?? ''}
190:       />
191: 
192:       {ENTRIES.map((entry, i) => (
193:         <div
194:           key={entry.kind}
195:           className="quick-command-row"
196:           style={{ top: ROW_Y + i * ROW_HEIGHT, width: WIDTH, height: ROW_HEIGHT }}
197:           onPointerEnter={() => setSelected(i)}
198:           onClick={uiClick(() => run(entry.kind))}
199:         >
200:           <MuText
201:             align="center"
202:             className="quick-command-label"
203:             color={selected === i ? ROW_SELECTED_COLOR : ROW_COLOR}
204:             style={{ top: LABEL_DY, width: WIDTH }}
205:             text={t(entry.labelKey)}
206:           />
207:           {selected === i && (
208:             <>
209:               <MuSpriteFrame
210:                 file={ARROW_L_SPRITE}
211:                 width={ARROW.width}
212:                 height={ARROW.height}
213:                 className="quick-command-arrow"
214:                 style={{ left: ARROW.left, top: ARROW_DY, backgroundSize: '100% 100%' }}
215:               />
216:               <MuSpriteFrame
217:                 file={ARROW_R_SPRITE}
218:                 width={ARROW.width}
219:                 height={ARROW.height}
220:                 className="quick-command-arrow"
221:                 style={{ left: ARROW.right, top: ARROW_DY, backgroundSize: '100% 100%' }}
222:               />
223:             </>
224:           )}
225:           {i < ENTRIES.length - 1 && (
226:             <MuSpriteFrame
227:               file={LINE_SPRITE}
228:               width={LINE.width}
229:               height={LINE.height}
230:               className="quick-command-art"
231:               style={{ left: LINE.x, top: LINE_DY, backgroundSize: '100% 100%' }}
232:             />
233:           )}
234:         </div>
235:       ))}
236:     </div>
237:   );
238: });
</file>

