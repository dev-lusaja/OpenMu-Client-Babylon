288: /** IMAGE_SKILLBOX / IMAGE_SKILLBOX_USE: the empty box, and the lit copy. */
289: const SKILLBOX_SPRITE = 'newui_skillbox.OZJ';
290: const SKILLBOX_USE_SPRITE = 'newui_skillbox2.OZJ';
