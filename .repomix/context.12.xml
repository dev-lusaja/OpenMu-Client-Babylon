<file path="src/ui/pages/worldPage/components/nearbyPlayers.ts">
 1: import { useEffect, useState } from 'react';
 2: import { Store } from '../../../../store';
 3: import { INVITE_RANGE_TILES } from '../../../../social';
 4: import type { GuildMemberRoleEnum } from '../../../../common/packets/ServerToClientPackets';
 5: 
 6: export type NearbyPlayer = {
 7:   netId: number;
 8:   name: string;
 9:   guildId: number | undefined;
10:   guildRole: GuildMemberRoleEnum | undefined;
11: };
12: 
13: /**
14:  * The players a party invite / guild join can reach: the original's command
15:  * window works on the character under the cursor and refuses anyone farther
16:  * than one tile (`abs(dx) <= 1 && abs(dy) <= 1`, ZzzInterface.cpp:4410).
17:  * Without a command window we offer the same set as a list.
18:  */
19: export function nearbyPlayers(range = INVITE_RANGE_TILES): NearbyPlayer[] {
20:   const world = Store.world;
21:   const hero = world?.playerEntity;
22:   if (!world || !hero) return [];
23: 
24:   // transform.pos is (tileX, height, tileY).
25:   const hx = Math.floor(hero.transform.pos.x);
26:   const hy = Math.floor(hero.transform.pos.z);
27: 
28:   const result: NearbyPlayer[] = [];
29:   for (const e of world.playersQuery.entities) {
30:     if (e.localPlayer || e.netId === undefined || e.dying) continue;
31:     const x = Math.floor(e.transform.pos.x);
32:     const y = Math.floor(e.transform.pos.z);
33:     if (Math.abs(x - hx) > range || Math.abs(y - hy) > range) continue;
34:     result.push({
35:       netId: e.netId,
36:       name: e.objectNameInWorld ?? `#${e.netId}`,
37:       guildId: e.guild?.id,
38:       guildRole: e.guild?.role,
39:     });
40:   }
41:   return result;
42: }
43: 
44: /** Re-samples the nearby list a few times a second while mounted. */
45: export function useNearbyPlayers(range?: number): NearbyPlayer[] {
46:   const [players, setPlayers] = useState<NearbyPlayer[]>(() =>
47:     nearbyPlayers(range)
48:   );
49: 
50:   useEffect(() => {
51:     const id = window.setInterval(() => {
52:       const next = nearbyPlayers(range);
53:       setPlayers(prev =>
54:         prev.length === next.length &&
55:         prev.every((p, i) => p.netId === next[i].netId && p.name === next[i].name)
56:           ? prev
57:           : next
58:       );
59:     }, 400);
60:     return () => window.clearInterval(id);
61:   }, [range]);
62: 
63:   return players;
64: }
</file>

