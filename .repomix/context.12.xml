  4: import { Store } from '../../../../../store';
  5: import { skills } from '../../../../../skills';
  6: import { onCooldownTick } from '../../../../../skills/cooldowns';
  7: import { isHotbarSkill } from '../../../../../common/skillCasting';
  8: import { skillDefinition } from '../../../../../common/skillsDatabase';
  9: import { MobileSkillSlots, MOBILE_SKILL_SLOTS } from '../../../../../common/mobileSkillSlots';
 10: import { isAttackableEntity } from '../../../../../ecs/systems/attackSystem';
 11: import { SkillIcon } from '../../../../components/skillIcon';
 12: import { MobileButton, ScaledFrame } from './mobileButton';
 13: import {
 14:   BOX_HEIGHT,
 15:   BOX_WIDTH,
 16:   SKILLBOX_SPRITE,
 17:   SKILLBOX_USE_SPRITE,
 18:   SLOT_SCALE,
 19: } from './consts';
 20: 
 21: const SLOT_HEIGHT = BOX_HEIGHT * SLOT_SCALE;
 22: 
 23: /**
 24:  * Fire the linked skill at whatever is targeted.
 25:  *
 26:  * This writes the one seam the right mouse button writes and stops there:
 27:  * `SkillCastSystem` owns range, the walk into it, mana and AG, the re-use
 28:  * delay, the clip and the packet. No combat rule is duplicated here.
 29:  *
 30:  * The point falls back to the hero's own tile with nothing targeted, which is
 31:  * what a self-cast (Swell Life, the summons) or an area skill dropped where
 32:  * you stand wants. A tap on the ground clears the request again
 33:  * (`playerControllerSystem`) - the touch stand-in for letting the button go.
 34:  */
 35: function castSkill(number: number): void {
 36:   const world = Store.world;
 37:   const hero = world?.playerEntity;
 38:   if (!world || !hero || hero.dying) return;
 39: 
 40:   Store.selectSkill(number);
 41: 
 42:   const picked = world.attackTarget;
 43:   const target = picked && isAttackableEntity(world, picked) ? picked : null;
 44:   const pos = target?.transform?.pos;
 45: 
 46:   world.castRequest = {
 47:     target,
 48:     point: pos
 49:       ? { x: pos.x, y: pos.z }
 50:       : { x: hero.transform.pos.x, y: hero.transform.pos.z },
 51:     forced: false,
 52:   };
 53: }
 54: 
 55: /** The name of the held target, polled a frame at a time like the health bar. */
 56: const TargetLabel = () => {
 57:   const [name, setName] = useState('');
 58: 
 59:   useEffect(() => {
 60:     let frame = 0;
 61:     let shown = '';
 62:     const poll = () => {
 63:       frame = requestAnimationFrame(poll);
 64:       const world = Store.world;
 65:       const target = world?.attackTarget;
 66:       const next =
 67:         target && !target.dying && world && isAttackableEntity(world, target)
 68:           ? (target.objectNameInWorld ?? '')
 69:           : '';
 70:       if (next === shown) return;
 71:       shown = next;
 72:       setName(next);
 73:     };
 74:     frame = requestAnimationFrame(poll);
 75:     return () => cancelAnimationFrame(frame);
 76:   }, []);
 77: 
 78:   if (!name) return null;
 79: 
 80:   return <div className="mobile-target-label">{name}</div>;
 81: };
 82: 
 83: /** One pad slot: the icon, the greyed state and the delay sweep of a bar slot. */
 84: const PadSlot = observer(({ slot, onPick }: { slot: number; onPick: (slot: number) => void }) => {
 85:   const number = MobileSkillSlots.slots[slot] ?? -1;
 86:   const usable = number >= 0 && skills.requirementsMet(number);
 87:   const selected = number >= 0 && number === Store.currentSkill;
 88:   const sweep = useRef<HTMLDivElement>(null);
 89: 
 90:   // RenderSkillDelay: the sweep is written straight to the element on the
 91:   // cooldown layer's tick, so a running delay never re-renders React.
 92:   useEffect(() => {
 93:     const tick = () => {
 94:       const el = sweep.current;
 95:       if (!el) return;
 96:       const delay = number >= 0 ? skills.cooldown(number) : null;
 97:       const css = delay ? `${Math.round(delay.fraction * SLOT_HEIGHT)}px` : '0px';
 98:       if (el.style.height !== css) el.style.height = css;
 99:     };
100:     tick();
101:     return onCooldownTick(tick);
102:   }, [number]);
103: 
104:   return (
105:     <MobileButton
106:       className="mobile-skill-slot"
107:       title={number >= 0 ? (skillDefinition(number)?.name ?? '') : t('skills.title')}
108:       onTap={() => (number >= 0 ? castSkill(number) : onPick(slot))}
109:       onLongPress={() => onPick(slot)}
110:     >
111:       {pressed => (
112:         <ScaledFrame
113:           file={pressed || selected ? SKILLBOX_USE_SPRITE : SKILLBOX_SPRITE}
114:           width={BOX_WIDTH}
115:           height={BOX_HEIGHT}
116:           scale={SLOT_SCALE}
117:         >
118:           {number >= 0 && (
119:             <div className="mobile-skill-art">
120:               <SkillIcon number={number} disabled={!usable} />
121:             </div>
122:           )}
123:           <div ref={sweep} className="mobile-skill-delay" />
124:         </ScaledFrame>
125:       )}
126:     </MobileButton>
127:   );
128: });
129: 
130: /** Every learned skill that can sit on a bar, plus the entry that clears the slot. */
131: const SkillPicker = observer(({ slot, onClose }: { slot: number; onClose: () => void }) => {
132:   const learned = Store.skills.map(s => s.number).filter(isHotbarSkill);
133: 
134:   return (
135:     <div className="mobile-skill-picker" onPointerDown={onClose}>
136:       <div className="mobile-picker-panel" onPointerDown={e => e.stopPropagation()}>
137:         <div className="mobile-picker-title">{t('skills.title')}</div>
138: 
139:         {learned.length === 0 ? (
140:           <div className="mobile-picker-empty">{t('skills.empty')}</div>
141:         ) : (
142:           <div className="mobile-picker-grid">
143:             {learned.map(number => (
144:               <MobileButton
145:                 key={number}
146:                 className="mobile-picker-slot"
147:                 title={skillDefinition(number)?.name ?? ''}
148:                 onTap={() => {
149:                   MobileSkillSlots.assign(slot, number);
150:                   onClose();
151:                 }}
152:               >
153:                 {pressed => (
154:                   <ScaledFrame
155:                     file={pressed ? SKILLBOX_USE_SPRITE : SKILLBOX_SPRITE}
156:                     width={BOX_WIDTH}
157:                     height={BOX_HEIGHT}
158:                     scale={SLOT_SCALE}
159:                   >
160:                     <div className="mobile-skill-art">
161:                       <SkillIcon number={number} disabled={!skills.requirementsMet(number)} />
162:                     </div>
163:                   </ScaledFrame>
164:                 )}
165:               </MobileButton>
166:             ))}
167:           </div>
168:         )}
169: 
170:         <div className="mobile-picker-actions">
171:           <MobileButton
172:             className="mobile-picker-action"
173:             onTap={() => {
174:               MobileSkillSlots.assign(slot, -1);
175:               onClose();
176:             }}
177:           >
178:             {() => <span>{t('common.none')}</span>}
179:           </MobileButton>
180:           <MobileButton className="mobile-picker-action" onTap={onClose}>
181:             {() => <span>{t('common.close')}</span>}
182:           </MobileButton>
183:         </div>
184:       </div>
185:     </div>
186:   );
187: });
188: 
189: /**
190:  * Three skills within thumb reach, above the bar. A tap on a filled slot
191:  * casts; a tap on an empty one, or a long press on a filled one, opens the
192:  * picker. The link is remembered per character in the browser
193:  * (`mobileSkillSlots`) and never touches the ten server-saved digit keys.
194:  */
195: export const SkillPad = observer(() => {
196:   const [picking, setPicking] = useState(-1);
197:   const character = Store.playerData.name;
198:   const learned = Store.skills;
199: 
200:   useEffect(() => {
201:     if (character) MobileSkillSlots.use(character);
202:   }, [character]);
203: 
204:   useEffect(() => {
205:     MobileSkillSlots.prune(learned.map(s => s.number));
206:   }, [learned]);
207: 
208:   return (
209:     <>
210:       <div className="mobile-skill-pad">
211:         <TargetLabel />
212:         <div className="mobile-skill-slots">
213:           {Array.from({ length: MOBILE_SKILL_SLOTS }, (_, slot) => (
214:             <PadSlot key={slot} slot={slot} onPick={setPicking} />
215:           ))}
216:         </div>
217:       </div>
218: 
219:       {picking >= 0 && <SkillPicker slot={picking} onClose={() => setPicking(-1)} />}
220:     </>
221:   );
222: });
</file>

<file path="src/ui/pages/worldPage/components/mobileControls/style.less">
