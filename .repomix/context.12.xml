  1: import './style.less';
  2: import { t } from '../../../../../i18n';
  3: import { useEffect, useRef, useState, type WheelEvent } from 'react';
  4: import { observer } from 'mobx-react-lite';
  5: import { runInAction } from 'mobx';
  6: import { Store } from '../../../../../store';
  7: import { isKey } from '../../../../../common/keyBindings';
  8: import { BaseClass, getBaseClass } from '../../../../../common/characterStats';
  9: import { PVP_MURDERER1 } from '../../../../../common/nameTags';
 10: import { useEventBus } from '../../../../../hooks/useEventBus';
 11: import { EventBus } from '../../../../../libs/eventBus';
 12: import { ENUM_WORLD } from '../../../../../common';
 13: import { playUiSound, uiClick } from '../../../../../libs/sfx';
 14: import { loadMoveReqList, type MoveReqEntry } from '../../../../../libs/mu/moveReqFile';
 15: import { WarpFavourites } from '../../../../../common/warpFavourites';
 16: import { MuSpriteFrame } from '../../../../components/muSprite';
 17: import { MuText } from '../../../../components/muText';
 18: import { useWindowChrome } from '../../../../components/muWindow/useWindowChrome';
 19: 
 20: /**
 21:  * `CNewUIMoveCommandWindow` (NewUIMoveCommandWindow.cpp): the "M" window -
 22:  * the rows of `MoveReq_eng.bmd` on a black panel in the top-left corner
 23:  * (`Create(m_pNewUIMng, 1, 1)`), map / required level / zen in three
 24:  * centred columns, white when the hero can go and dark red when not, with
 25:  * the failing number in bright red (`SettingCanMoveMap` / `Render`). A click
 26:  * on a white row sends `WarpCommandRequest` with the row's index and hides
 27:  * the window; the server answers with `MapChanged` (logic.ts) or a blue
 28:  * message. Escape and the red bar at the bottom close it.
 29:  *
 30:  * Rules kept from `SettingCanMoveMap`: level (2/3 for MG / DL / RF, never
 31:  * for a 400 requirement), zen, and `Hero->PK < PVP_MURDERER1`. Dropped: the
 32:  * Icarus wing / Dinorant / Fenrir and the Uniria-in-Lorencia mount checks
 33:  * (the server refuses those with a message anyway), and the gens-only
 34:  * (`_bStrife`) block on Vulcanus - OpenMU has no gens influence, so the row
 35:  * stays clickable and the server decides.
 36:  *
 37:  * Offline, a click warps locally through `requestWarp` for the maps this
 38:  * client stages, so the window is still usable without a server.
 39:  */
 40: 
 41: const WINDOW_ID = 'move-window';
 42: const HOT_KEY = 'warpList';
 43: 
 44: /** `MOVECOMMAND_MAX_RENDER_TEXTLINE`. */
 45: const MAX_LINES = 31;
 46: /**
 47:  * `m_iRealFontHeight` = 12 + 2 at 640 wide. That makes the panel 494 px
 48:  * tall - taller than the 480 stage - so rows are 13 px here: 60 + 31 × 13 =
 49:  * 463 keeps the close bar on screen.
 50:  */
 51: const ROW_HEIGHT = 13;
 52: /** `m_MapNameUISize.x` at 640 (220) + 10. */
 53: const WIDTH = 230;
 54: /** `m_MapNameUISize.y`. */
 55: const HEIGHT = 60 + ROW_HEIGHT * MAX_LINES;
 56: /** `m_StartUISubjectName`: the title, centred at width/2, y 4. */
 57: const TITLE_Y = 4;
 58: /** The column headers sit 20 px under the title. */
 59: const HEADER_Y = TITLE_Y + 20;
 60: /** `m_StartMapNamePos`: the first row. */
 61: const ROWS = { x: 2, y: 38 };
 62: /** The three column centres at 640 (`SetPos`). */
 63: const COL = { map: 62, level: 119, zen: 159 };
 64: /** Rows are hit-tested `m_MapNameUISize.x - 22` wide. */
 65: const ROW_WIDTH = WIDTH - 22;
 66: 
 67: /** `m_ScrollBarPos` = right edge - 14, top = first row - 3. */
 68: const SCROLLBAR = { x: WIDTH - 14, y: ROWS.y - 3, width: 7 };
 69: const SCROLLBAR_CAP = 3;
 70: const SCROLLBAR_HEIGHT = MAX_LINES * ROW_HEIGHT;
 71: /** `MOVECOMMAND_SCROLLBTN_*`: the thumb, 4 px left of the track so it is centred on it. */
 72: const THUMB = { width: 15, height: 30 };
 73: const THUMB_X = SCROLLBAR.x - (THUMB.width / 2 - SCROLLBAR.width / 2);
 74: 
 75: /** `RenderColor(m_StartMapNamePos.x, h - font - 6, w - 5, font)`. */
 76: const CLOSE_BAR = { x: ROWS.x, y: HEIGHT - ROW_HEIGHT - 6, width: WIDTH - 5, height: ROW_HEIGHT };
 77: 
 78: const SCROLL_TOP_SPRITE = 'newui_scrollbar_up.OZT';
 79: const SCROLL_MIDDLE_SPRITE = 'newui_scrollbar_m.OZT';
 80: const SCROLL_BOTTOM_SPRITE = 'newui_scrollbar_down.OZT';
 81: const THUMB_ON_SPRITE = 'newui_scroll_on.OZT';
 82: const THUMB_OFF_SPRITE = 'newui_scroll_off.OZT';
 83: 
 84: // `RenderFrame` / `Render` colours.
 85: const TITLE_COLOR = 'rgb(255, 204, 26)';
 86: const HEADER_COLOR = 'rgb(127, 178, 255)';
 87: const CAN_MOVE_COLOR = '#fff';
 88: const CANNOT_MOVE_COLOR = 'rgb(164, 39, 17)';
 89: const FAILING_COLOR = 'rgb(255, 51, 26)';
 90: /** The star on a favourite row. */
 91: const STAR_COLOR = 'rgb(255, 204, 26)';
 92: 
 93: /**
 94:  * `CharacterExtensions.GetEffectiveMoveLevelRequirement` (OpenMU):
 95:  * `LevelWarpRequirementReductionPercent` = ceil(100 / 3) = 34 on MG, DL and
 96:  * RF - the original's `CLASS_DARK` (the gladiator) / `CLASS_DARK_LORD` /
 97:  * `CLASS_RAGEFIGHTER` × 2/3. The server's integer arithmetic is used so the
 98:  * greying agrees with what it accepts (140 → 92, where the client's
 99:  * `int(140 * 2.f / 3.f)` says 93).
100:  */
101: const LEVEL_REDUCTION_PERCENT = 34;
102: const REDUCED_CLASSES: ReadonlySet<BaseClass> = new Set([
103:   BaseClass.MagicGladiator,
104:   BaseClass.DarkLord,
105:   BaseClass.RageFighter,
106: ]);
107: 
108: export function effectiveMoveLevel(reqLevel: number, cls: BaseClass): number {
109:   if (reqLevel === 400 || !REDUCED_CLASSES.has(cls)) return reqLevel;
110:   return Math.trunc((reqLevel * (100 - LEVEL_REDUCTION_PERCENT)) / 100);
111: }
112: 
113: /**
114:  * `MoveReq_eng.bmd` index → OpenMU `WarpInfo.Index` where the two disagree.
115:  * The Season 6 `Gates.cs` warp list numbers every row the same as the file
116:  * (1 Arena, 2 Lorencia, 3 Noria, 4 Devias, 31 Elveland, 23 Icarus, …)
117:  * except Vulcanus, which the file calls 42 (the original's gens `anStrifeIndex`)
118:  * and OpenMU seeds as 37. OpenMU's 44 LorenMarket / 48 LaCleon have no row in
119:  * the Eng file (34 LaCleon maps to OpenMU's 34 "Raklion", the same gate).
120:  */
121: const SERVER_INDEX: Readonly<Record<number, number>> = {
122:   42: 37,
123: };
124: 
125: /** The staged maps an offline click can still land on, by the file's `index`. */
126: const OFFLINE_MAPS: Readonly<Record<number, ENUM_WORLD>> = {
127:   2: ENUM_WORLD.WD_0LORENCIA,
128:   3: ENUM_WORLD.WD_3NORIA,
129:   4: ENUM_WORLD.WD_2DEVIAS,
130:   8: ENUM_WORLD.WD_1DUNGEON,
131:   11: ENUM_WORLD.WD_7ATLANSE,
132:   14: ENUM_WORLD.WD_4LOSTTOWER,
133:   21: ENUM_WORLD.WD_8TARKAN,
134:   23: ENUM_WORLD.WD_10ICARUS,
135: };
136: 
137: type RowState = {
138:   entry: MoveReqEntry;
139:   reqLevel: number;
140:   levelOk: boolean;
141:   zenOk: boolean;
142:   canMove: boolean;
143: };
144: 
145: /** `SettingCanMoveMap` for one row. */
146: function rowState(entry: MoveReqEntry, level: number, zen: number, cls: BaseClass, pk: number): RowState {
147:   const reqLevel = effectiveMoveLevel(entry.reqLevel, cls);
148:   const levelOk = level >= reqLevel;
149:   const zenOk = zen >= entry.zen;
150:   return { entry, reqLevel, levelOk, zenOk, canMove: levelOk && zenOk && pk < PVP_MURDERER1 };
151: }
152: 
153: export function openMoveWindow(): void {
154:   runInAction(() => {
155:     Store.warpWindowEnabled = true;
156:   });
157: }
158: 
159: export function closeMoveWindow(): void {
160:   runInAction(() => {
161:     Store.warpWindowEnabled = false;
162:   });
163: }
164: 
165: const Row = observer(({
166:   row,
167:   y,
168:   onClick,
169: }: {
170:   row: RowState;
171:   y: number;
172:   onClick: () => void;
173: }) => {
174:   const base = row.canMove ? CAN_MOVE_COLOR : CANNOT_MOVE_COLOR;
175:   const failing = (ok: boolean) => (row.canMove || ok ? base : FAILING_COLOR);
176:   const starred = WarpFavourites.has(row.entry.index);
177:   return (
178:     <div
179:       className={`move-row${row.canMove ? ' can-move' : ''}`}
180:       data-no-drag="true"
