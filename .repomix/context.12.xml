 71: const ENTRIES: RadialEntry[] = [
 72:   ...EMOTES.map(
 73:     (emote): RadialEntry => ({
 74:       kind: 'emote',
 75:       id: `emote_${emote.id}`,
 76:       glyph: emote.glyph,
 77:       emote,
 78:     })
 79:   ),
 80:   ...EMOJI_BUBBLES.map(
 81:     (emoji): RadialEntry => ({
 82:       kind: 'emoji',
 83:       id: `emoji_${emoji.id}`,
 84:       glyph: emoji.glyph,
 85:       emoji,
 86:     })
 87:   ),
 88:   ...INSTRUMENTS.map(
 89:     (instrument): RadialEntry => ({
