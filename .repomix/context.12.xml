280: /** `CNewUIDuelWatchMainFrameWindow`: names, score pips, HP/SD gauges, exit. */
281: const DuelSpectatorBar = observer(() => {
282:   const duel = duelScoreboard();
283:   const bars = duelBars();
284:   const stage = useStage();
285:   if (!duel || !duel.watching) return null;
