 275: /** The square under the pointer, with the window's scale folded out. */
 276: function squareAt(grid: HTMLElement, clientX: number, clientY: number): number {
 277:   const rect = grid.getBoundingClientRect();
 278:   const scale = rect.width / (COLUMNS * SQUARE);
 279:   const column = Math.floor((clientX - rect.left) / scale / SQUARE);
 280:   const row = Math.floor((clientY - rect.top) / scale / SQUARE);
 281:   const inside = column >= 0 && column < COLUMNS && row >= 0 && row < ROWS;
 282: 
 283:   return inside ? row * COLUMNS + column : -1;
 284: }
