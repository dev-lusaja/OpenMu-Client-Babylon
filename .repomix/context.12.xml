760: /** ShowGuildCreationDialog: name (8 chars) and the 8x8 emblem editor. */
761: export const GuildCreationDialog = observer(() => {
762:   const open = Social.guildCreationDialog;
763:   const pending = Social.guildCreationPending;
764:   const [name, setName] = useState('');
765:   const [pixels, setPixels] = useState<number[]>(() => new Array(PIXELS).fill(0));
766:   const [color, setColor] = useState(1);
767: 
768:   useEffect(() => {
769:     if (!open) return;
770:     setName('');
771:     setPixels(new Array(PIXELS).fill(0));
772:     setColor(1);
773:   }, [open]);
774: 
775:   if (!open) return null;
776: 
777:   const paint = (i: number) =>
778:     setPixels(prev => {
779:       const next = prev.slice();
780:       next[i] = color;
781:       return next;
782:     });
783: 
784:   const create = () => {
785:     if (pending) return;
786:     if (!Social.guildCreate(name, packGuildMark(pixels))) return;
787:     playUiSound('click');
788:   };
789: 
790:   return (
791:     <div className="guild-dialog-layer">
792:       <div className="guild-create">
793:         <div className="guild-create-title">{t('guild.found')}</div>
794:         <label className="guild-create-name">
795:           {t('guild.createName')}
796:           <input
797:             autoFocus
798:             maxLength={8}
799:             value={name}
800:             spellCheck={false}
801:             onChange={e => setName(e.target.value.replace(/[^A-Za-z0-9]/g, ''))}
802:             onKeyDown={e => {
803:               if (e.key === 'Enter') create();
804:               else if (e.key === 'Escape') Social.cancelGuildCreation();
805:             }}
806:           />
807:         </label>
808:         <div className="guild-create-editor">
809:           <div
810:             className="guild-create-grid"
811:             style={{ width: CELL * GUILD_MARK_SIZE, height: CELL * GUILD_MARK_SIZE }}
812:           >
813:             {pixels.map((p, i) => (
814:               <div
815:                 key={i}
816:                 className="guild-create-cell"
817:                 style={{ width: CELL, height: CELL, backgroundColor: GUILD_MARK_PALETTE[p] }}
818:                 onMouseDown={() => paint(i)}
819:                 onMouseEnter={e => {
820:                   if (e.buttons & 1) paint(i);
821:                 }}
822:               />
823:             ))}
824:           </div>
825:           <div className="guild-create-palette">
826:             {GUILD_MARK_PALETTE.map((c, i) => (
827:               <div
828:                 key={i}
829:                 className={`guild-create-swatch${color === i ? ' active' : ''}`}
830:                 title={
831:                   i === 0 ? t('guild.markErase') : t('guild.markColour', { index: i })
832:                 }
833:                 style={{ backgroundColor: c }}
834:                 onClick={() => setColor(i)}
835:               />
836:             ))}
837:           </div>
838:           <img
839:             className="guild-create-preview"
840:             alt=""
841:             width={MARK_PX}
842:             height={MARK_PX}
843:             style={{ width: MARK_PX, height: MARK_PX }}
844:             src={guildMarkDataUrl(packGuildMark(pixels))}
845:           />
846:         </div>
847:         <div className="guild-create-buttons">
848:           <button type="button" disabled={pending || !name} onClick={uiClick(create)}>
849:             {pending ? t('common.creating') : t('common.create')}
850:           </button>
851:           <button type="button" onClick={uiClick(() => Social.cancelGuildCreation())}>
852:             {t('common.cancel')}
853:           </button>
854:         </div>
855:       </div>
856:     </div>
857:   );
858: });
