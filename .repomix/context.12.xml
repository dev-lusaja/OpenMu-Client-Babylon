 71:     align-items: flex-start;
 72:   }
 73: }
 74: 
 75: // ---- the skill pad, bottom right above the bar -----------------------------
 76: 
 77: .mobile-skill-pad {
 78:   position: absolute;
 79:   right: @edge-gap;
 80:   bottom: @bar-clearance;
 81:   display: flex;
 82:   flex-direction: column;
 83:   align-items: flex-end;
 84:   gap: 4px;
 85: 
 86:   .mobile-skill-slots {
 87:     display: flex;
 88:     flex-direction: row;
 89:     gap: @button-gap;
 90:   }
 91: }
 92: 
 93: // What a skill is about to hit, so the pad is not fired blind.
 94: .mobile-target-label {
