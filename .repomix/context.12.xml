<file path="src/version/contract.ts">
  1: /**
  2:  * THE CONTRACT for a game version - the one object the base game (`src/`)
  3:  * reads to learn which MU / OpenMU version it is talking to. One folder per
  4:  * version under `versions/<id>/` exports it as `gameVersion` from `index.ts`,
  5:  * listed in `versions/registry.ts` and loaded at runtime by the bootstrap
  6:  * (src/main.tsx -> src/version/index.ts `loadGameVersion`).
  7:  *
  8:  * Base code never says `if (version === ...)`: it reads `features.*` and the
  9:  * protocol / data fields below. Everything a version can differ in must be a
 10:  * field here, or a module under the version folder (`packets/`, `tables/`,
 11:  * `data/`, `ui/`) that the base reaches through the resolved handles in
 12:  * `src/version/index.ts`.
 13:  */
 14: 
 15: /** Folder name under `versions/`; the registry entry's `id`. */
 16: export type GameVersionId = string;
 17: 
 18: /** The 12-number list `SimpleModulusKeys.Create*Keys` takes: 4 modulus, 4 crypt, 4 xor. */
 19: export type SimpleModulusKeyList = readonly number[];
 20: 
 21: export interface VersionEncryption {
 22:   /**
 23:    * Client → server SimpleModulus (C3/C4 packets). OpenMU: the "default client
 24:    * key" of `PipelinedSimpleModulusEncryptor` - unchanged from 0.95 to S6;
 25:    * only the 0.75 plug-in ships its own Enc1/Dec2 keys.
 26:    */
 27:   readonly clientToServer: SimpleModulusKeyList;
 28:   /** Server → client SimpleModulus (the decryptor's "default client key"). */
 29:   readonly serverToClient: SimpleModulusKeyList;
 30:   /**
 31:    * The 32-byte Xor32 key applied to every client → server packet after
 32:    * SimpleModulus. Webzen rotated it during Season 6; OpenMU keeps one key
 33:    * for S6 (`Network/Xor/DefaultKeys`) and one for every earlier client
 34:    * (`PreSeason6NetworkEncryptionFactoryPlugIn`).
 35:    */
 36:   readonly xor32Key: Uint8Array;
 37:   /** The 3-byte key the login name / password are xor'ed with (`Xor3Byte`). */
 38:   readonly xor3Key: Uint8Array;
 39: }
 40: 
 41: export interface VersionProtocol {
 42:   /**
 43:    * Which OpenMU packet XML flavour `versions/<id>/packets/` was generated
 44:    * from. `season6` = the un-suffixed definitions; older sets use the
 45:    * `…075` / `…095` variants OpenMU keeps beside them.
 46:    */
 47:   readonly packetSet: 'season6' | '0.97d' | '0.95' | '0.75';
 48:   /**
 49:    * Name-suffix rank the dispatcher should prefer when several generated
 50:    * packets share a code (`AddCharactersToScope` / `…075` / `…095` /
 51:    * `…Extended`): lower wins. `createSocket.ts` owns the sort today (Lane E);
 52:    * this is the value it should read.
 53:    */
 54:   variantRank(packetName: string): number;
 55:   readonly encryption: VersionEncryption;
 56: }
 57: 
 58: export interface VersionData {
 59:   /** Base URL of the original `Data/` tree (sprites, Local/*.bmd, gate.bmd). Trailing slash. */
 60:   readonly folder: string;
 61:   /** Base URL of the converted models / terrain / sounds (`public/game-assets`). Trailing slash. */
 62:   readonly assets: string;
 63:   /** `Data/Local/<locale>/` subfolder used for language tables. */
 64:   readonly locale: string;
 65:   /**
 66:    * Every path `folder` contains, lower-cased and relative to it. A period
 67:    * tree is a subset of the Season 6 one, so base code routinely asks it for
 68:    * files it never shipped - Season 6 window chrome, post-0.97 effect
 69:    * textures. That is a feature the version does not have, not a fault, so
 70:    * `hasDataFile` answers from this list and the sprite / effect loaders draw
 71:    * nothing rather than logging a miss per frame.
 72:    *
 73:    * Omit it and every path is attempted, which is what Season 6 does and has
 74:    * always done.
 75:    */
 76:   readonly inventory?: ReadonlySet<string>;
 77: }
 78: 
 79: /**
 80:  * Feature flags: what the *server* of this version knows about. Checked by
 81:  * the consumer that would render or send it, never by an accumulator
 82:  *.
 83:  */
 84: export interface VersionFeatures {
 85:   /** Master level + master skill tree (S3+). */
 86:   readonly masterSkills: boolean;
 87:   /** Socket items / seeds & spheres (S4+). */
 88:   readonly socketItems: boolean;
 89:   /** Ancient sets (0.97+). */
 90:   readonly ancientItems: boolean;
 91:   /** Harmony jewel + refine stones (S3+). */
 92:   readonly harmonyJewel: boolean;
 93:   /** Dark Lord / Magic Gladiator character classes (0.97 / 0.99+). */
 94:   readonly darkLord: boolean;
 95:   readonly magicGladiator: boolean;
 96:   /** Summoner / Rage Fighter (S3 / S5+). */
 97:   readonly summoner: boolean;
 98:   readonly rageFighter: boolean;
 99:   /** MU Helper (S6 E3, OpenMU `MuHelper`). */
100:   readonly muHelper: boolean;
101:   /** Item hotkeys / consumable belt row (S6). */
102:   readonly itemHotkeys: boolean;
103:   /** Cash shop / in-game shop banner (S6). */
104:   readonly cashShop: boolean;
105:   /** Blood Castle / Devil Square / Chaos Castle event windows. */
106:   readonly events: boolean;
107:   /** Quest system with the S6 NPC dialogue windows (`Quest_eng.bmd`). */
108:   readonly questDialogs: boolean;
109: }
110: 
111: export interface GameVersion {
112:   readonly id: GameVersionId;
113:   /** Human label for the title bar / login page. */
114:   readonly label: string;
115:   /**
116:    * The token a published server line puts first to say which client it wants
117:    * (`[S6EP3:Name:…](…)`) - see `common/serverList.ts`. A field rather than
118:    * something derived from `openMu`, because a version that is not a season
119:    * and an episode still has to name itself in one short word.
120:    *
121:    * This is what tells the picker a world is playable: a world asking for a
122:    * tag no registry entry carries is a world this client cannot enter. Must
123:    * match the `versions/registry.ts` entry's `listTag`.
124:    */
125:   readonly listTag: string;
126:   /** How OpenMU identifies this client (`GameClientDefinition`). */
127:   readonly openMu: {
128:     readonly season: number;
129:     readonly episode: number;
130:     /** `Persistence/Initialization/<folder>` that seeds this version. */
131:     readonly initializer: string;
132:     /** `-version:<arg>` for `MUnique.OpenMU.Startup`. */
133:     readonly versionArg: string;
134:   };
135:   /** 5 ASCII bytes sent in `LoginShortPassword.ClientVersion` (e.g. "10404"). */
136:   readonly clientVersionBytes: readonly number[];
137:   /** 16 ASCII bytes sent in `LoginShortPassword.ClientSerial`. */
138:   readonly serialBytes: readonly number[];
139:   readonly protocol: VersionProtocol;
140:   readonly data: VersionData;
141:   readonly features: VersionFeatures;
142: }
143: 
144: export function asciiBytes(s: string): number[] {
145:   return Array.from(s, ch => ch.charCodeAt(0));
146: }
</file>

<file path="src/version/index.ts">
  1: /**
  2:  * The resolved game version - the runtime end of `versions/registry.ts`.
  3:  *
  4:  * `main.tsx` awaits `loadGameVersion` before importing the app (`boot.tsx`),
  5:  * so every module in the app graph - including the ones that read
  6:  * `gameVersion` at module scope - evaluates after these bindings are
  7:  * assigned. Base code keeps importing `gameVersion` from here and only ever
  8:  * sees the `GameVersion` contract (`./contract.ts`).
  9:  *
 10:  * Switching to a world of another carried version is a page reload
 11:  * (`ensureActiveVersion`): module-scope captures of the version exist
 12:  * throughout the app, and a reload into the persisted selection is the
 13:  * clean swap.
 14:  */
 15: import {
 16:   DEFAULT_VERSION_ID,
 17:   VERSION_REGISTRY,
 18:   type VersionEntry,
 19:   type VersionPackets,
 20:   type VersionUi,
 21: } from '../../versions/registry';
 22: import type { GameVersion } from './contract';
 23: 
 24: export let gameVersion: GameVersion;
 25: export let versionPackets: VersionPackets;
 26: 
 27: /**
 28:  * The version a published server line asked for (`listTag`, e.g. `S6EP3`),
 29:  * or null when this client does not carry it. Case-insensitive: the tag is
 30:  * somebody's markdown, not an identifier. Registry metadata only - asking
 31:  * never loads a version body.
 32:  */
 33: export function versionByTag(tag: string): VersionEntry | null {
 34:   const wanted = tag.trim().toLowerCase();
 35: 
 36:   return (
 37:     VERSION_REGISTRY.find(v => v.listTag.toLowerCase() === wanted) ?? null
 38:   );
 39: }
 40: 
 41: /** The tags this client can be asked for, for a message that has to list them. */
 42: export function versionTags(): string[] {
 43:   return VERSION_REGISTRY.map(v => v.listTag);
 44: }
 45: 
 46: /**
 47:  * Registry id for a server profile's `version` tag. No tag (a typed-in
 48:  * address, an old list line) and an uncarried tag both mean the default:
 49:  * the world is entered with what this client picks.
 50:  */
 51: export function versionIdForTag(tag: string | undefined): string {
 52:   if (!tag) return DEFAULT_VERSION_ID;
 53: 
 54:   return versionByTag(tag)?.id ?? DEFAULT_VERSION_ID;
 55: }
 56: 
 57: /** Loads a version's core (contract data + packet lists). No app code runs here. */
 58: export async function loadGameVersion(id: string): Promise<void> {
 59:   const entry =
 60:     VERSION_REGISTRY.find(v => v.id === id) ??
 61:     VERSION_REGISTRY.find(v => v.id === DEFAULT_VERSION_ID)!;
 62:   const mod = await entry.load();
 63: 
 64:   gameVersion = mod.gameVersion;
 65:   versionPackets = mod.packets;
 66: }
 67: 
 68: let uiPromise: Promise<VersionUi> | null = null;
 69: let ui: VersionUi | null = null;
 70: 
 71: /**
 72:  * The active version's UI module, loaded on first use (React.lazy in
 73:  * worldPage, the sprite preloader, the login-scene system). Never before
 74:  * boot: version UI re-exports app components, and evaluating those ahead of
 75:  * the app graph reorders module init.
 76:  */
 77: export function loadVersionUi(): Promise<VersionUi> {
 78:   uiPromise ??= VERSION_REGISTRY.find(v => v.id === gameVersion.id)!
 79:     .loadUi()
 80:     .then(loaded => (ui = loaded));
 81: 
 82:   return uiPromise;
 83: }
 84: 
 85: /**
 86:  * The UI module if it is already there, for callers that run every frame and
 87:  * cannot await (the login-scene system) or that render before it lands (the
 88:  * shared pre-game chrome). Null until `loadVersionUi` resolves; `boot.tsx`
 89:  * starts that load as soon as the app graph is up.
 90:  */
 91: export function versionUi(): VersionUi | null {
 92:   return ui;
 93: }
 94: 
 95: /**
 96:  * Connect-time guard: true when the active world is played by the loaded
 97:  * version. Otherwise reloads into it - the selection is already persisted,
 98:  * and boot resolves the version from the same tag through `versionIdForTag`,
 99:  * so the reload cannot loop.
100:  */
101: export function ensureActiveVersion(tag: string | undefined): boolean {
102:   if (versionIdForTag(tag) === gameVersion.id) return true;
103: 
104:   location.reload();
105: 
106:   return false;
107: }
108: 
109: export type {
110:   GameVersion,
111:   GameVersionId,
112:   VersionData,
113:   VersionEncryption,
114:   VersionFeatures,
115:   VersionProtocol,
116: } from './contract';
</file>

