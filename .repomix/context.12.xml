656: export const MuHelperWindow = observer(() => {
657:   const open = MuHelperState.windowOpen;
658:   const [tab, setTab] = useState(0);
659:   const [picker, setPicker] = useState<PickerTarget | null>(null);
660: 
661:   useEventBus('keyPressed', key => {
662:     if (!gameVersion.features.muHelper) return;
663:     if (isKey('muHelperConfig', key) && Store.world?.playerEntity) {
664:       toggleMuHelperWindow();
665:     }
666:   });
667: 
668:   useEffect(() => {
669:     if (open) ensureMuHelperWatching();
670:     if (!open) setPicker(null);
671:   }, [open]);
672: 
673:   if (!gameVersion.features.muHelper || !open) return null;
674: 
675:   const close = () => toggleMuHelperWindow(false);
676: 
677:   return (
678:     <MuItemWindow
679:       id={WINDOW_ID}
680:       className="mu-helper-window"
681:       column={1}
682:       label={t('muHelper.title')}
683:       onClose={close}
684:     >
685:       <div className="helper-title">{t('muHelper.title')}</div>
686: 
687:       {[t('muHelper.tabHunt'), t('muHelper.tabObtain')].map((name, i) => (
688:         <div
689:           key={name}
690:           data-no-drag="true"
691:           style={{
692:             position: 'absolute',
693:             left: TAB.x + i * TAB.width,
694:             top: TAB.y,
695:           }}
696:         >
697:           <MuButton
698:             file={TAB_SPRITE}
699:             width={TAB.width}
700:             height={TAB.height}
701:             frames={{ up: 0, down: 1, check: 1 }}
702:             checked={tab === i}
703:             label={name}
704:             labelStyle={{ fontSize: 10 }}
705:             onClick={() => {
706:               setTab(i);
707:               setPicker(null);
708:             }}
709:           />
710:         </div>
711:       ))}
712: 
713:       <div className="helper-body" data-no-drag="true">
714:         {tab === 0 ? <HuntTab onPick={setPicker} /> : <ObtainTab />}
715:       </div>
716: 
717:       {picker && (
718:         <SkillPicker target={picker} onDone={() => setPicker(null)} />
719:       )}
720: 
721:       <div className="helper-actions" data-no-drag="true">
722:         <button type="button" onClick={uiClick(resetMuHelperDraft)}>
723:           {t('muHelper.init')}
724:         </button>
725:         <button type="button" onClick={uiClick(saveMuHelperConfig)}>
726:           {t('muHelper.save')}
727:         </button>
728:       </div>
729: 
730:       <div
731:         data-no-drag="true"
732:         style={{ position: 'absolute', left: EXIT_BUTTON.x, top: EXIT_BUTTON.y }}
733:       >
734:         <MuButton
735:           file={EXIT_SPRITE}
736:           width={EXIT_BUTTON.width}
737:           height={EXIT_BUTTON.height}
738:           frames={{ up: 0, down: 1 }}
739:           onClick={close}
740:         />
741:       </div>
742:     </MuItemWindow>
743:   );
744: });
