 597:             '--glow': `${look.glow}px`,
 598:             '--shimmer': look.shimmer,
 599:             '--rattle': `${phase === 'seam' || phase === 'strain' ? RATTLE_MS.split : RATTLE_MS.shut}ms`,
 600:             '--fall': `${BOX_FALL_FROM}px`,
 601:             '--hang': `${-BOX_HANG}px`,
 602:             '--seam': `${SEAM_Y}px`,
