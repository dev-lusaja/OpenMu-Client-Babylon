 537: const GachaStage = observer(({ product, blocked }: { product: Product | null; blocked: string | null }) => {
 538:   const { phase, roll, order, rollError, knock } = CashShopState;
 539:   // The one gate on everything the roll decides. `roll` is null for the whole
 540:   // sealed half anyway (state.ts), so this is the second lock on the same
 541:   // door rather than the only one.
 542:   const tier: Tier | null = isOpening(phase) && roll ? roll.tier : null;
 543:   const look = TIERS[tier ?? 'common'];
 544:   const stage = useRef<HTMLDivElement>(null);
 545: 
 546:   // Warm every buffer and all four box tints on mount: nothing in this repo
 547:   // preloads sounds (SOUND_KEYS has no consumer), evictStale() drops them
 548:   // after two map changes, and an <img> swapped at the seam beat would decode
 549:   // a frame late - the frame the whole tell hangs on.
 550:   useEffect(() => {
 551:     for (const key of GACHA_SOUNDS) SoundsManager.loadSound(UI_SOUNDS[key]);
 552:     prefetchItemIcons([
 553:       CHAOS_JEWEL,
 554:       boxItem(SEALED_TINT),
 555:       ...TIER_KEYS.map(key => boxItem(TIERS[key].tint)),
 556:     ]);
 557:   }, []);
 558: 
 559:   // The counter in the state only ever climbs, so knocks are counted from
 560:   // the press or a fresh box would knock on the way down. The knock has to
 561:   // restart on a lid that stays mounted - remounting would re-decode the
 562:   // icon - so two identical keyframe sets take turns.
 563:   //
 564:   // Both knocks are scored inside the rattle (SEAL.knockA/knockB), and the
 565:   // name is dropped with it: an inline `animation-name` outranks the
 566:   // stylesheet, so a name left on the lid would be played by the seal's own
 567:   // slam instead of its keyframes.
 568:   const knockBase = useRef(knock);
 569:   useEffect(() => {
 570:     if (phase === 'falling') knockBase.current = knock;
 571:   }, [phase, knock]);
 572:   const knocks = phase === 'rattling' ? knock - knockBase.current : 0;
 573:   const knockStyle: CSSProperties | undefined = knocks > 0
 574:     ? { animationName: knocks % 2 ? 'cash-knock' : 'cash-knock-b' }
 575:     : undefined;
 576: 
 577:   return (
 578:     <>
 579:       <div
 580:         ref={stage}
 581:         data-no-drag="true"
 582:         className={`cash-gacha phase-${phase}${tier ? ` tier-${tier}` : ''}`}
 583:         style={
 584:           {
 585:             left: STAGE_X,
 586:             top: STAGE_Y,
 587:             width: STAGE_WIDTH,
 588:             height: STAGE_HEIGHT,
 589:             // A shut box is the same box whatever is in it, so until the
 590:             // opening the stage's one colour is the neutral one and every
 591:             // rule that paints in `--tier` paints in that instead.
 592:             '--tier': tier ? look.colour : SEALED_COLOUR,
 593:             '--sealed': SEALED_COLOUR,
 594:             '--aura': look.aura,
 595:             '--hush': `${look.hold}ms`,
