 67: function itemSize(item: Item): { w: number; h: number } {
 68:   const config = ItemsDatabase.getItem(item.group, item.num);
 69:   return { w: config?.X ?? 1, h: config?.Y ?? 1 };
 70: }
 71: 
 72: type Placed = {
 73:   slot: number;
 74:   item: Item;
 75:   column: number;
 76:   row: number;
 77:   w: number;
 78:   h: number;
 79: };
 80: 
 81: /** Which square belongs to which stock entry (`m_pdwItemCheckBox`). */
 82: function buildOccupancy(items: (Item | null)[]) {
 83:   const squares: (Placed | null)[] = new Array(SQUARES).fill(null);
 84:   const placed: Placed[] = [];
 85: 
 86:   for (let slot = 0; slot < SQUARES; slot++) {
 87:     const item = items[slot];
 88:     if (!item) continue;
 89: 
 90:     const column = slot % COLUMNS;
 91:     const row = (slot - column) / COLUMNS;
 92:     const { w, h } = itemSize(item);
 93: 
 94:     const entry: Placed = { slot, item, column, row, w, h };
 95:     placed.push(entry);
 96: 
 97:     for (let y = 0; y < h; y++) {
 98:       for (let x = 0; x < w; x++) {
 99:         if (column + x >= COLUMNS || row + y >= ROWS) continue;
100:         squares[slot + y * COLUMNS + x] = entry;
101:       }
102:     }
103:   }
104: 
105:   return { squares, placed };
106: }
107: 
108: type HoverInfo = { entry: Placed; x: number; y: number };
109: 
110: /**
111:  * `CNewUINPCShop`: the merchant's stock beside the inventory. A click on a
112:  * stock item buys it; the carried inventory item dropped on the grid is
113:  * sold; at a smith the two bottom buttons toggle repair mode / repair all.
114:  */
115: export const NpcShop = observer(() => {
116:   const shop = Store.npcShop;
117:   const search = useItemSearch();
118:   const gridRef = useRef<HTMLDivElement>(null);
119:   const [hover, setHover] = useState<HoverInfo | null>(null);
120: 
121:   const picked = Store.pickedItem;
122:   const items = shop?.items ?? null;
123:   const stamp = items ? occupancyStamp(items, 0, SQUARES) : '';
124:   const { squares, placed } = useMemo(
125:     () => buildOccupancy(items ?? []),
126:     // `stamp` stands in for the item contents.
127:     // eslint-disable-next-line react-hooks/exhaustive-deps
128:     [items, stamp]
129:   );
130:   const used = useMemo(() => usedMask(squares), [squares]);
131:   // Re-resolve by square: a stock refresh rebuilds the entries.
132:   const hoveredEntry = hover ? squares[hover.entry.slot] ?? null : null;
133:   const hovered = useMemo(
134:     () => hoveredMask(squares, picked ? null : hoveredEntry),
135:     [squares, hoveredEntry, picked]
136:   );
137: 
138:   if (!shop) return null;
139: 
140:   const squareAt = (clientX: number, clientY: number) => {
141:     const rect = gridRef.current?.getBoundingClientRect();
142:     if (!rect) return -1;
143: 
144:     const scale = rect.width / (COLUMNS * SQUARE);
145:     if (!scale) return -1;
146: 
147:     const column = Math.floor((clientX - rect.left) / scale / SQUARE);
148:     const row = Math.floor((clientY - rect.top) / scale / SQUARE);
149: 
150:     if (column < 0 || column >= COLUMNS || row < 0 || row >= ROWS) return -1;
151:     return row * COLUMNS + column;
152:   };
153: 
154:   const onGridPointerDown = (event: React.PointerEvent) => {
155:     if (event.button !== 0) return;
156: 
157:     // `InventoryProcess`: the carried item lands here → sold.
158:     if (picked) {
159:       QuickItemActions.sellPickedItem();
160:       return;
161:     }
162: 
163:     const square = squareAt(event.clientX, event.clientY);
164:     if (square < 0) return;
165: 
166:     const entry = squares[square];
167:     if (!entry) return;
168: 
169:     if (event.ctrlKey) {
170:       QuickItemActions.promptBuy(entry.slot);
171:       return;
172:     }
173: 
174:     Store.buyItemFromNpc(entry.slot);
175:   };
176: 
177:   const sellingBanned = !!picked && isSellingBanned(picked.item);
178: 
179:   const gridClass = [
180:     'shop-items',
181:     Store.shopBuyPending || Store.pendingItemMove ? 'busy' : '',
182:     picked ? 'selling' : '',
183:     sellingBanned ? 'selling-banned' : '',
184:   ]
185:     .filter(Boolean)
186:     .join(' ');
187: 
188:   // The original parks the shop left of the inventory (and of the character
189:   // window when that is open too): `SetPos(640 - 190 * 3, 0)`.
190:   const column = Store.characterInfoEnabled ? 2 : 1;
191: 
192:   return (
193:     <MuItemWindow
194:       id={WINDOW_ID}
195:       className="npc-shop"
196:       column={column}
197:       onClose={() => Store.closeNpcShop()}
198:     >
199:       <div className="window-title" style={{ top: TITLE_Y }}>
200:         {t(TITLE)}
201:       </div>
202:       {shop.taxRate > 0 && (
203:         <div className="shop-tax" style={{ top: TAX_Y }}>
204:           {t(TAX, { rate: shop.taxRate })}
205:         </div>
206:       )}
207: 
208:       <div
209:         className="head-close"
210:         data-no-drag="true"
211:         style={{
212:           left: HEAD_CLOSE_X,
213:           top: HEAD_CLOSE_Y,
214:           width: HEAD_CLOSE_WIDTH,
215:           height: HEAD_CLOSE_HEIGHT,
216:         }}
217:         onClick={() => Store.closeNpcShop()}
218:       />
219: 
220:       <ItemSearchBox search={search} left={SEARCH_X} top={SEARCH_Y} width={SEARCH_WIDTH} />
221: 
222:       <MuTableFrame
223:         left={GRID_FRAME_X}
224:         top={GRID_FRAME_Y}
225:         width={GRID_FRAME_WIDTH}
226:         height={GRID_FRAME_HEIGHT}
227:       />
228: 
229:       <div
230:         ref={gridRef}
231:         className={gridClass}
232:         data-no-drag="true"
233:         style={{
234:           left: GRID_X,
235:           top: GRID_Y,
236:           width: COLUMNS * SQUARE,
237:           height: ROWS * SQUARE,
238:         }}
239:         onPointerDown={onGridPointerDown}
240:         onContextMenu={event => event.preventDefault()}
241:         onPointerMove={event => {
242:           // State only moves when the hovered *item* changes, not per event.
243:           const square = squareAt(event.clientX, event.clientY);
244:           const entry = square >= 0 ? squares[square] : null;
245:           setHover(current => {
246:             if (!entry) return current === null ? current : null;
247:             if (current && current.entry === entry) return current;
248:             return { entry, x: event.clientX, y: event.clientY };
249:           });
250:         }}
251:         onPointerLeave={() => setHover(null)}
252:       >
253:         <GridSquares
254:           columns={COLUMNS}
255:           rows={ROWS}
256:           used={used}
257:           hovered={hovered}
258:           squareClass="shop-square"
259:         />
260: 
261:         {placed.map(entry => (
262:           <div
263:             key={entry.slot}
264:             className={
265:               search.active && !search.matches(entry.item)
266:                 ? 'shop-item dimmed'
267:                 : 'shop-item'
268:             }
269:             style={{
270:               left: entry.column * SQUARE,
271:               top: entry.row * SQUARE,
272:               width: entry.w * SQUARE,
273:               height: entry.h * SQUARE,
274:             }}
275:           >
276:             <ItemIcon item={entry.item} />
277:           </div>
278:         ))}
279:       </div>
280: 
281:       {!picked && !!hoveredEntry && !!hover && (
282:         <ItemTooltip item={hoveredEntry.item} x={hover.x} y={hover.y} context="shop" />
283:       )}
284: 
285:       {shop.repairShop && (
286:         <>
287:           <MuSpriteFrame
288:             file={REPAIR_MONEY_SPRITE}
289:             width={REPAIR_MONEY_WIDTH}
290:             height={REPAIR_MONEY_HEIGHT}
291:             style={{
292:               position: 'absolute',
293:               left: REPAIR_MONEY_X,
294:               top: REPAIR_MONEY_Y,
295:             }}
296:           />
297:           <div
298:             className="shop-repair-label"
299:             style={{ left: REPAIR_LABEL_X, top: REPAIR_TEXT_Y }}
300:           >
301:             {t(REPAIR_LABEL)}
302:           </div>
303:           <div
304:             className="shop-repair-money"
305:             style={{
306:               left: REPAIR_TEXT_X,
307:               top: REPAIR_TEXT_Y,
308:               color: goldColor(Store.repairAllPrice),
309:             }}
310:           >
311:             {Store.repairAllPrice.toLocaleString('en-US')}
312:           </div>
313: 
314:           <div
315:             className="window-button"
316:             data-no-drag="true"
317:             style={{ left: REPAIR_BUTTON_X, top: BUTTON_Y }}
318:           >
319:             <MuButton
320:               file={REPAIR_SPRITE}
321:               width={BUTTON_WIDTH}
322:               height={BUTTON_HEIGHT}
323:               frames={BUTTON_FRAMES}
324:               checked={Store.repairMode}
325:               onClick={() => Store.toggleRepairMode()}
326:             >
327:               <span className="button-tooltip">{t(REPAIR_TOOLTIP)}</span>
328:             </MuButton>
329:           </div>
330:           <div
331:             className="window-button"
332:             data-no-drag="true"
333:             style={{ left: REPAIR_ALL_BUTTON_X, top: BUTTON_Y }}
334:           >
335:             <MuButton
336:               file={REPAIR_SPRITE}
337:               width={BUTTON_WIDTH}
338:               height={BUTTON_HEIGHT}
339:               frames={BUTTON_FRAMES}
340:               disabled={Store.repairAllPrice <= 0}
341:               onClick={() => Store.repairAllRequest()}
342:             >
343:               <span className="button-tooltip">{t(REPAIR_ALL_TOOLTIP)}</span>
344:             </MuButton>
345:           </div>
346:         </>
347:       )}
