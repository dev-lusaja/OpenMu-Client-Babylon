 769:   // The second line of the band, for the entry it is about: the service's
 770:   // refusal, then the order it just took, then why it would refuse, and
 771:   // otherwise today's count against the cap. A hovered entry that is not the
 772:   // selected one only ever gets the count - its verdict is asked for by
 773:   // clicking it.
 774:   const verdict = (entry: Placed): { text: string; tone: 'is-bad' | 'is-good' | 'is-dim' } => {
 775:     if (entry === selectedEntry) {
