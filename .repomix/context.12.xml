 74: /** Left of the X, in its band. */
 75: const CENTER_BUTTON_POS = { x: CLOSE_BUTTON.x - CENTER_BUTTON.width - 6, y: 4 };
 76: 
 77: const Marker = ({
 78:   marker,
 79:   center,
 80:   mapSize,
 81:   onHover,
 82: }: {
 83:   marker: MinimapMarker;
 84:   center: MapPoint;
 85:   mapSize: number;
 86:   onHover: (marker: MinimapMarker | null) => void;
 87: }) => {
 88:   const size = MARKER_SIZE[marker.kind] ?? NPC_SIZE;
 89:   // Offset from the view's centre in map pixels, before the 45° spin.
 90:   const dx = ((marker.y - center.y) / TERRAIN_SIZE) * mapSize;
 91:   const dy = ((marker.x - center.x) / TERRAIN_SIZE) * mapSize;
 92: 
 93:   return (
 94:     <Sprite
 95:       file={MARKER_SPRITE[marker.kind] ?? NPC_SPRITE}
 96:       size={size}
 97:       style={{
 98:         position: 'absolute',
 99:         left: CENTER_X - size / 2,
100:         top: CENTER_Y - size / 2,
101:         transform: `rotate(${MAP_ROTATION}deg) translate(${dx}px, ${dy}px) rotate(${marker.rotation - MAP_ROTATION}deg)`,
102:         pointerEvents: 'auto',
103:       }}
104:     >
105:       <div
106:         className="minimap-marker-hit"
107:         onMouseEnter={() => onHover(marker)}
108:         onMouseLeave={() => onHover(null)}
109:       />
110:     </Sprite>
111:   );
112: };
113: 
114: const MarkerTip = ({
115:   marker,
116:   center,
117:   mapSize,
118: }: {
119:   marker: MinimapMarker;
120:   center: MapPoint;
121:   mapSize: number;
122: }) => {
123:   const size = MARKER_SIZE[marker.kind] ?? NPC_SIZE;
124:   const dx = ((marker.y - center.y) / TERRAIN_SIZE) * mapSize;
125:   const dy = ((marker.x - center.x) / TERRAIN_SIZE) * mapSize;
126:   const rad = (MAP_ROTATION * Math.PI) / 180;
127:   const sx = CENTER_X + dx * Math.cos(rad) - dy * Math.sin(rad);
128:   const sy = CENTER_Y + dx * Math.sin(rad) + dy * Math.cos(rad);
129: 
130:   // `Check_Btn`: white on black(180), centred above the marker.
131:   return (
132:     <MuTipText
133:       text={marker.name}
134:       background="rgba(0,0,0,0.7)"
135:       style={{
136:         position: 'absolute',
137:         left: sx,
138:         top: sy - size / 2 - 2,
139:         transform: 'translate(-50%, -100%)',
140:         whiteSpace: 'nowrap',
141:       }}
142:     />
143:   );
144: };
145: 
146: const CloseButton = ({ onClick }: { onClick: () => void }) => {
147:   const sprite = useMuSprite(CLOSE_SPRITE);
148:   const [pressed, setPressed] = useState(false);
149:   const scaleX = CLOSE_BUTTON.width / CLOSE_FRAME.width;
150:   const scaleY = CLOSE_BUTTON.height / CLOSE_FRAME.height;
151: 
152:   return (
153:     <div
154:       className="minimap-close"
155:       title={t('common.close')}
156:       style={{
157:         left: CLOSE_BUTTON.x,
158:         top: CLOSE_BUTTON.y,
159:         width: CLOSE_BUTTON.width,
160:         height: CLOSE_BUTTON.height,
161:         backgroundImage: sprite ? `url(${sprite.url})` : undefined,
162:         backgroundSize: `${CLOSE_FRAME.width * scaleX}px ${sprite ? sprite.height * scaleY : 0}px`,
163:         backgroundPosition: `0 ${pressed ? -CLOSE_FRAME.height * scaleY : 0}px`,
164:       }}
165:       onMouseDown={() => setPressed(true)}
166:       onMouseUp={() => setPressed(false)}
167:       onMouseLeave={() => setPressed(false)}
168:       onClick={uiClick(onClick)}
169:     />
170:   );
171: };
172: 
173: /**
174:  * The open sheet. Mounted with it and gone with it, so the pan and the
175:  * hovered marker start clean every time; the zoom lives outside, across
176:  * opens.
177:  */
178: const SheetView = ({
179:   minimap,
180:   map,
181:   zoom,
182:   onWheel,
183:   close,
184: }: {
185:   minimap: WorldMinimap;
186:   map: number;
187:   zoom: number;
188:   onWheel: (event: React.WheelEvent) => void;
189:   close: () => void;
190: }) => {
191:   const hero = useHeroTile(true);
192:   const partyMarkers = usePartyMarkers(true, map);
193:   const [hovered, setHovered] = useState<MinimapMarker | null>(null);
194:   const [pan, setPan] = useState<MapPan>(NO_PAN);
195:   const scale = useUiStageScale();
196:   const mapSize = ZOOM_LEVELS[zoom];
197:   const { dragging, handlers } = useMapDrag(mapSize, scale, setPan);
198: 
199:   const center: MapPoint = { x: hero.x + pan.v, y: hero.y + pan.u };
200:   const tx = (center.y / TERRAIN_SIZE) * mapSize;
201:   const ty = (center.x / TERRAIN_SIZE) * mapSize;
202:   // The hero sits off the centre by the pan, upright as the original draws it.
203:   const heroDx = (-pan.u / TERRAIN_SIZE) * mapSize;
204:   const heroDy = (-pan.v / TERRAIN_SIZE) * mapSize;
205: 
206:   return (
207:     <div
208:       className="minimap-overlay"
209:       style={{ background: `rgba(0,0,0,${SHEET_ALPHA})` }}
210:       onWheel={onWheel}
211:       onContextMenu={e => e.preventDefault()}
212:     >
213:       <div
214:         className="minimap-stage"
215:         style={{
216:           width: SHEET_WIDTH,
217:           height: SHEET_HEIGHT,
218:           // Centred by half the *scaled* width: the stage scales from its
219:           // top-left corner, so an unscaled margin left it off to the right.
220:           marginLeft: (-SHEET_WIDTH / 2) * scale,
221:           transform: `scale(${scale})`,
222:         }}
223:       >
224:         <div className={`minimap-clip${dragging ? ' is-dragging' : ''}`} {...handlers}>
225:           <div
226:             className="minimap-map"
227:             style={{
228:               width: mapSize,
229:               height: mapSize,
230:               left: CENTER_X - tx,
231:               top: CENTER_Y - ty,
232:               transformOrigin: `${tx}px ${ty}px`,
233:               transform: `rotate(${MAP_ROTATION}deg)`,
234:               backgroundImage: `url(${minimap.image.url})`,
235:             }}
236:           />
237:           {minimap.markers.map((marker, i) => (
238:             <Marker
239:               key={i}
240:               marker={marker}
241:               center={center}
242:               mapSize={mapSize}
243:               onHover={setHovered}
244:             />
245:           ))}
246:           {partyMarkers.map((marker, i) => (
247:             <Marker
248:               key={`party-${i}`}
249:               marker={marker}
250:               center={center}
251:               mapSize={mapSize}
252:               onHover={setHovered}
253:             />
254:           ))}
255:           <Sprite
256:             file={HERO_SPRITE}
257:             size={HERO_SIZE}
258:             style={{
259:               position: 'absolute',
260:               left: CENTER_X - HERO_SIZE / 2,
261:               top: CENTER_Y - HERO_SIZE / 2,
262:               transform: `rotate(${MAP_ROTATION}deg) translate(${heroDx}px, ${heroDy}px) rotate(${-MAP_ROTATION}deg)`,
263:             }}
264:           />
265:           {hovered && <MarkerTip marker={hovered} center={center} mapSize={mapSize} />}
266:         </div>
267:         <Frame width={SHEET_WIDTH} height={SHEET_HEIGHT} />
268:         {isPanned(pan) && (
269:           <CenterButton
270:             onClick={() => setPan(NO_PAN)}
271:             style={{ position: 'absolute', left: CENTER_BUTTON_POS.x, top: CENTER_BUTTON_POS.y }}
272:           />
273:         )}
274:         <CloseButton onClick={close} />
275:       </div>
276:     </div>
277:   );
278: };
279: 
280: export const MinimapSheet = observer(() => {
281:   const open = Store.minimapEnabled;
282:   const world = Store.world;
283:   const map = open ? world?.mapIndex : undefined;
284:   const minimap = useWorldMinimap(map);
285:   const [zoom, setZoom] = useState(0);
286: 
287:   // `m_bSuccess == false`: a world without mini_map.ozt has no map to show.
288:   // An effect, not a render-time write: the store only changes in an action.
289:   useEffect(() => {
290:     if (open && minimap === null) {
291:       runInAction(() => {
292:         Store.minimapEnabled = false;
293:       });
294:     }
295:   }, [open, minimap]);
296: 
297:   if (!open || !minimap || map === undefined) return null;
298: 
299:   const close = () => {
300:     runInAction(() => {
301:       Store.minimapEnabled = false;
302:     });
303:   };
304: 
305:   const onWheel = (event: React.WheelEvent) => {
306:     setZoom(z =>
307:       Math.max(0, Math.min(ZOOM_LEVELS.length - 1, z + (event.deltaY < 0 ? 1 : -1)))
308:     );
309:   };
310: 
311:   return <SheetView minimap={minimap} map={map} zoom={zoom} onWheel={onWheel} close={close} />;
312: });
</file>

