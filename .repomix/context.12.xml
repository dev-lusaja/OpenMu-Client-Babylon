160:   const stats = derived(pet, info);
161:   const life = Math.min(info.health, PET_MAX_LIFE);
162:   // `int iHP = (min(life, 255) * 147) / 255` - filled pixels, not a ratio.
163:   const filled = Math.trunc((life * LIFE_FILL.width) / PET_MAX_LIFE);
164: 
165:   const row = (top: number, text: string, className = 'pet-row') => (
166:     <div
167:       className={className}
168:       style={{ left: BOX.x, top: BOX.y + top, width: BOX.width }}
169:     >
