 40: export const MARKER_SIZE: Record<number, number> = {
 41:   [MinimapMarkerKind.Npc]: NPC_SIZE,
 42:   [MinimapMarkerKind.Portal]: PORTAL_SIZE,
 43:   [PARTY_KIND]: PARTY_SIZE,
 44: };
 45: 
