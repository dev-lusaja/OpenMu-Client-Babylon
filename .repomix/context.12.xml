404:   const onGridPointerDown = (event: React.PointerEvent) => {
405:     if (event.button !== 0) return;
406: 
407:     if (picked && pickedSize) {
408:       // ApplyJewels (NewUIMyInventory.cpp:2055): a carried jewel clicked on
