102: const RINGS = [...EMOTE_RINGS, EMOJI_BUBBLES.length, INSTRUMENTS.length];
103: 
104: type Wedge = {
105:   entry: RadialEntry;
106:   path: string;
107:   labelX: number;
108:   labelY: number;
109:   ring: number;
110: };
111: 
112: function polar(radius: number, deg: number): [number, number] {
113:   const rad = (deg * Math.PI) / 180;
114:   return [CENTER + radius * Math.cos(rad), CENTER + radius * Math.sin(rad)];
115: }
116: 
117: function wedgePath(
118:   inner: number,
119:   outer: number,
120:   startDeg: number,
121:   endDeg: number
122: ): string {
123:   const [x1, y1] = polar(outer, startDeg);
124:   const [x2, y2] = polar(outer, endDeg);
125:   const [x3, y3] = polar(inner, endDeg);
126:   const [x4, y4] = polar(inner, startDeg);
127:   const large = endDeg - startDeg > 180 ? 1 : 0;
128: 
129:   return [
130:     `M ${x1} ${y1}`,
131:     `A ${outer} ${outer} 0 ${large} 1 ${x2} ${y2}`,
132:     `L ${x3} ${y3}`,
133:     `A ${inner} ${inner} 0 ${large} 0 ${x4} ${y4}`,
134:     'Z',
135:   ].join(' ');
