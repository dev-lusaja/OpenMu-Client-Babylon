710:       ) : (
711:         <div
712:           className="quest-list"
713:           data-no-drag="true"
714:           style={{ left: 14, top: MQ_LIST_Y + 4, width: 163, height: MQ_LIST_HEIGHT - 8 }}
715:         >
716:           {active.map((key, i) => (
