  3: // CNewUIMiniMap. Every coordinate lives in the original's 640×480 UI space on
  4: // the `.minimap-stage`; the overlay itself darkens the whole viewport. The
  5: // corner panel (`.minimap-corner-panel`) reuses the frame and sprite rules at
  6: // the same art sizes and scales itself as a whole.
  7: @edge-width: 35px;
  8: @edge-height: 6px;
  9: @corner-size: 35px;
 10: 
 11: .minimap-overlay {
 12:   position: absolute;
 13:   inset: 0;
 14:   pointer-events: auto;
 15:   user-select: none;
 16:   overflow: hidden;
 17:   z-index: 500; // WINDOW_Z_SHEETS: a full-screen sheet over every window
 18: }
 19: 
 20: .minimap-stage {
 21:   position: absolute;
 22:   left: 50%;
 23:   top: 0;
 24:   transform-origin: 0 0;
 25:   // `scale()` and the centring margin are applied inline, from the same
 26:   // scale.
 27: }
 28: 
 29: // The map area of either view: click and drag slides the map (ours).
 30: .minimap-clip,
 31: .minimap-corner-clip {
 32:   position: absolute;
 33:   inset: 0;
 34:   overflow: hidden;
 35:   cursor: grab;
 36:   touch-action: none;
 37: 
 38:   &.is-dragging {
 39:     cursor: grabbing;
 40:   }
 41: }
 42: 
 43: .minimap-map {
 44:   position: absolute;
 45:   background-size: 100% 100%;
 46:   // The map picture is a 1024² painting scaled down: smooth it, unlike the
 47:   // pixel-art widgets.
 48:   image-rendering: auto;
 49:   pointer-events: none;
 50: }
 51: 
 52: .minimap-sprite {
 53:   background-size: 100% 100%;
 54:   background-repeat: no-repeat;
 55:   pointer-events: none;
 56: }
 57: 
 58: .minimap-marker-hit {
 59:   position: absolute;
 60:   inset: 0;
 61:   cursor: pointer;
 62: }
 63: 
 64: .minimap-edge {
 65:   position: absolute;
 66:   background-repeat: repeat;
 67:   pointer-events: none;
 68: }
 69: 
 70: .minimap-edge-top {
 71:   left: 0;
 72:   top: 0;
 73:   width: 100%;
 74:   height: @edge-height;
 75:   // `RenderImage(..., 0.f, 1.f, uvxy, -uvxy_Line)`: the top strip is drawn
 76:   // upside down.
 77:   transform: scaleY(-1);
 78: }
 79: 
 80: .minimap-edge-bottom {
 81:   left: 0;
 82:   bottom: 0;
 83:   width: 100%;
 84:   height: @edge-height;
 85: }
 86: 
 87: // The side strips are the top strip turned 90° about its top-left corner
 88: // (`RenderBitmapRotate(..., ±90.f, ...)`); their length is set inline.
