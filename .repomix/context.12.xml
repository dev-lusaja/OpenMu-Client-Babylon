636: // ---- CNewUIMyQuestInfoWindow ------------------------------------------------
637: 
638: /**
639:  * The tab art is fixed at 48 / 72 px, so a translated label - `Job change`
640:  * is already wider than the small tab - has to be shrunk to fit; below
641:  * `TAB_LABEL_MIN_FONT_PX` the CSS ellipsis cuts it.
642:  */
643: function tabFontSize(label: string, width: number): number {
644:   const fits = (width - TAB_LABEL_PADDING) / (label.length * TAB_LABEL_ADVANCE);
645:   return Math.max(TAB_LABEL_MIN_FONT_PX, Math.min(TAB_LABEL_FONT_PX, Math.floor(fits)));
646: }
647: 
648: /** The label of one tab, shrunk to fit its sprite. */
649: const TabLabel = observer(({ tab }: { tab: (typeof TABS)[number] }) => {
650:   const label = t(tab.labelKey);
651:   return (
652:     <span style={{ top: TAB_LABEL_Y - TAB.y - 1, fontSize: tabFontSize(label, tab.width) }}>
653:       {label}
654:     </span>
655:   );
656: });
