142: /**
143:  * Everything the events layer draws : the NPC
144:  * entry windows, the Chaos Castle prompt, the match timer on the event
145:  * maps, the 30 s countdown line and the result boxes. This folder only
146:  * reads the entry files and calls `events.*` commands; it owns no state.
147:  */
148: 
149: /** `SeparateTextIntoLines(GlobalText[832], …, MAX_LENGTH_CMB)`: wrap at ~30 chars. */
150: const BLOOD_INTRO_CHARS = 30;
151: 
152: /** The intro font at the window's 640-stage size. */
153: const INTRO_FONT_PX = 11;
154: /** Smallest the intro font shrinks to before a line is cut with an ellipsis. */
155: const INTRO_FONT_MIN_PX = 8;
156: /** Average glyph advance of the UI font, in px per px of font size. */
157: const INTRO_GLYPH_ADVANCE = 0.52;
158: 
159: /**
160:  * The original draws every intro line on its own fixed 15 / 20 px row and
161:  * lets a long line spill past the frame. Here a row is the same fixed
162:  * height - a wrapped line never grew the row, so it drew over the next one -
163:  * and a line wider than the 190 px frame shrinks its font to fit, down to
164:  * `INTRO_FONT_MIN_PX`; past that the CSS ellipsis cuts it.
165:  */
166: function introFontSize(line: string): number {
167:   const fits = INTRO_WIDTH / (line.length * INTRO_GLYPH_ADVANCE);
168:   return Math.max(INTRO_FONT_MIN_PX, Math.min(INTRO_FONT_PX, Math.floor(fits)));
169: }
170: 
171: function wrapLines(text: string, max: number): string[] {
172:   const lines: string[] = [];
173:   let line = '';
174:   for (const word of text.split(' ')) {
175:     const next = line ? `${line} ${word}` : word;
176:     if (next.length > max && line) {
177:       lines.push(line);
178:       line = word;
179:     } else {
180:       line = next;
181:     }
182:   }
183:   if (line) lines.push(line);
184:   return lines;
185: }
186: 
187: /** `L" %.2d:%.2d:%.2d"` minus the wall-clock seconds the original appends. */
188: function clock(seconds: number): string {
189:   const s = Math.max(0, Math.floor(seconds));
190:   const m = Math.floor(s / 60);
191:   return `${String(m).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
192: }
