<file path="src/ui/pages/worldPage/components/chatRoom/index.tsx">
  1: import './style.less';
  2: import { useEffect, useRef, useState } from 'react';
  3: import { observer } from 'mobx-react-lite';
  4: import { t } from '../../../../../i18n';
  5: import { ChatRooms, type ChatRoom } from '../../../../../chatRooms';
  6: import { Messenger } from '../../../../../messenger';
  7: import { isFriendOnline } from '../../../../../common/messenger';
  8: import { Store } from '../../../../../store';
  9: import { uiClick } from '../../../../../libs/sfx';
 10: import { useWindowChrome } from '../../../../components/muWindow/useWindowChrome';
 11: 
 12: /**
 13:  * `CUIChatWindow`, folded into one window with a tab per room the way the
 14:  * original's `CUIChatRoomListTabWindow` lists them. Talking happens on the
 15:  * chat server connection held by chatRooms.ts; this component only renders
 16:  * its state.
 17:  */
 18: 
 19: const WINDOW_ID = 'chat-room-window';
 20: const WIDTH = 340;
 21: const HEIGHT = 300;
 22: /** `MAX_CHATROOM_TEXT_LENGTH - 1`: the original's input limit. */
 23: const MAX_INPUT = 149;
 24: 
 25: const RoomBody = observer(({ room }: { room: ChatRoom }) => {
 26:   const [draft, setDraft] = useState('');
 27:   const [inviting, setInviting] = useState(false);
 28:   const listRef = useRef<HTMLDivElement>(null);
 29: 
 30:   useEffect(() => {
 31:     const el = listRef.current;
 32:     if (el) el.scrollTop = el.scrollHeight;
 33:   }, [room.lines.length, room.key]);
 34: 
 35:   useEffect(() => {
 36:     setDraft('');
 37:     setInviting(false);
 38:   }, [room.key]);
 39: 
 40:   const send = () => {
 41:     if (ChatRooms.sendMessage(draft)) setDraft('');
 42:   };
 43: 
 44:   const others = room.clients.filter(c => c.name !== Store.playerData.name);
 45:   const invitable = Messenger.friends.filter(
 46:     f => isFriendOnline(f) && !room.clients.some(c => c.name === f.name)
 47:   );
 48: 
 49:   return (
 50:     <>
 51:       <div className="chat-room-members">
 52:         {room.state === 'connecting' && t('chatRoom.connecting')}
 53:         {room.state === 'closed' && t('chatRoom.closed')}
 54:         {room.state === 'open' &&
 55:           (others.length === 0
 56:             ? t('chatRoom.waiting', { name: room.friendName })
 57:             : `${t('chatRoom.members', { count: room.clients.length })}: ${room.clients
 58:                 .map(c => c.name)
 59:                 .join(', ')}`)}
 60:       </div>
 61: 
 62:       <div className="chat-room-lines" ref={listRef} data-no-drag="true">
 63:         {room.lines.map((line, i) =>
 64:           line.system ? (
 65:             <div key={i} className="chat-room-line system">
 66:               {line.text}
 67:             </div>
 68:           ) : (
 69:             <div key={i} className="chat-room-line">
 70:               <span className="sender">{line.sender}:</span> {line.text}
 71:             </div>
 72:           )
 73:         )}
 74:       </div>
 75: 
 76:       {inviting && (
 77:         <div className="chat-room-invite-list" data-no-drag="true">
 78:           {invitable.length === 0 && (
 79:             <div className="chat-room-invite-empty">{t('chatRoom.inviteEmpty')}</div>
 80:           )}
 81:           {invitable.map(f => (
 82:             <div
 83:               key={f.name}
 84:               className="chat-room-invite-row"
 85:               onClick={uiClick(() => {
 86:                 ChatRooms.inviteFriend(f.name);
 87:                 setInviting(false);
 88:               })}
 89:             >
 90:               {f.name}
 91:             </div>
 92:           ))}
 93:         </div>
 94:       )}
 95: 
 96:       <div className="chat-room-input" data-no-drag="true">
 97:         <input
 98:           value={draft}
 99:           maxLength={MAX_INPUT}
100:           spellCheck={false}
101:           placeholder={t('chatRoom.inputPlaceholder')}
102:           disabled={room.state !== 'open'}
103:           onChange={e => setDraft(e.target.value)}
104:           onKeyDown={e => {
105:             if (e.key === 'Enter') send();
106:             e.stopPropagation();
107:           }}
108:         />
109:         <button
110:           type="button"
111:           disabled={room.state !== 'open'}
112:           onClick={uiClick(() => setInviting(v => !v))}
113:         >
114:           {t('chatRoom.invite')}
115:         </button>
116:         <button type="button" onClick={uiClick(() => ChatRooms.leaveRoom(room.key))}>
117:           {t('chatRoom.leave')}
118:         </button>
119:       </div>
120:     </>
121:   );
122: });
123: 
124: export const ChatRoomWindow = observer(() => {
125:   const chrome = useWindowChrome(WINDOW_ID, {
126:     width: WIDTH,
127:     height: HEIGHT,
128:     onClose: () => ChatRooms.closeWindow(),
129:   });
130: 
131:   if (!ChatRooms.windowEnabled) return null;
132:   const room = ChatRooms.activeRoom;
133:   if (!room) return null;
134: 
135:   return (
136:     <div
137:       ref={chrome.ref as React.Ref<HTMLDivElement>}
138:       role="dialog"
139:       aria-label={t('chatRoom.title')}
140:       className="chat-room-window"
141:       onPointerDown={chrome.onPointerDown}
142:       style={{ ...chrome.style, transformOrigin: '0 0' }}
143:     >
144:       <div className="chat-room-tabs">
145:         {ChatRooms.rooms.map(r => (
146:           <div
147:             key={r.key}
148:             className={`chat-room-tab${r.key === room.key ? ' active' : ''}${
149:               r.unread ? ' unread' : ''
150:             }`}
151:             data-no-drag="true"
152:             onClick={uiClick(() => ChatRooms.setActiveRoom(r.key))}
153:           >
154:             {r.friendName}
155:           </div>
156:         ))}
157:         <div
158:           className="chat-room-close"
159:           data-no-drag="true"
160:           onClick={uiClick(() => ChatRooms.closeWindow())}
161:         >
162:           ×
163:         </div>
164:       </div>
165: 
166:       <RoomBody room={room} />
167:     </div>
168:   );
169: });
</file>

