<file path="src/ui/pages/worldPage/components/npcShop/style.less">
  1: // `CNewUINPCShop` renders at absolute coordinates inside the 190×429 item
  2: // frame, like the inventory; the numbers live in layout.ts, this file only
  3: // says how each piece behaves.
  4: .npc-shop {
  5:   font-size: 11px;
  6: 
  7:   .window-title {
  8:     position: absolute;
  9:     left: 0;
 10:     right: 0;
 11:     text-align: center;
 12:     font-weight: bold;
 13:     color: #dcdcdc;
 14:     text-shadow: 1px 1px 0 #000;
 15:   }
 16: 
 17:   .shop-tax {
 18:     position: absolute;
 19:     left: 0;
 20:     right: 0;
 21:     text-align: center;
 22:     font-weight: bold;
 23:     color: #dcdcdc;
 24:     font-size: 10px;
 25:     text-shadow: 1px 1px 0 #000;
 26:   }
 27: 
 28:   .head-close {
 29:     position: absolute;
 30:     cursor: pointer;
 31:   }
 32: 
 33:   // Same gapless 20px pitch as the inventory; the hit-test maths assume it.
 34:   .shop-items {
 35:     position: absolute;
 36: 
 37:     &.busy {
 38:       pointer-events: none;
 39:       opacity: 0.6;
 40:     }
 41: 
 42:     // `SetSquareColorNormal(0.1, 0.4, 0.8)`: the grid turns blue under a
 43:     // carried item - drop it here to sell - and red when it cannot be sold.
 44:     &.selling::after {
 45:       content: '';
 46:       position: absolute;
 47:       inset: 0;
 48:       background-color: #1a66cc66;
 49:       pointer-events: none;
 50:     }
 51: 
 52:     &.selling-banned::after {
 53:       background-color: #ff000066;
 54:     }
 55:   }
 56: 
 57:   .shop-square {
 58:     position: absolute;
 59: 
 60:     &.used::after {
 61:       content: '';
 62:       position: absolute;
 63:       left: 0;
 64:       top: 0;
 65:       width: 20px;
 66:       height: 20px;
 67:       background-color: #4d808099;
 68:     }
 69: 
 70:     &.hovered::after {
 71:       background-color: #80b3ff99;
 72:     }
 73:   }
 74: 
 75:   .shop-item {
 76:   &.dimmed {
 77:     opacity: 0.25;
 78:   }
 79: 
 80:     position: absolute;
 81:     pointer-events: none;
 82:     display: flex;
 83:     align-items: center;
 84:     justify-content: center;
 85: 
 86:     .item-icon {
 87:       max-width: 100%;
 88:       max-height: 100%;
 89:       user-select: none;
 90:     }
 91:   }
 92: 
 93:   // `RenderRepairMoney`: "Repair all" in bold on the money well, the amount
 94:   // in gold-coloured text (`getGoldColor`).
 95:   .shop-repair-label,
 96:   .shop-repair-money {
 97:     position: absolute;
 98:     font-weight: bold;
 99:     color: #ffdc96;
100:     text-shadow: 1px 1px 0 #000;
101:     white-space: nowrap;
102:   }
103: 
104:   .window-button {
105:     position: absolute;
106: 
107:     .button-tooltip {
108:       display: none;
109:       position: absolute;
110:       top: 100%;
111:       left: 50%;
112:       transform: translateX(-50%);
113:       margin-top: 2px;
114:       padding: 1px 4px;
115:       background-color: #000000cc;
116:       border: 1px solid #6a6a6a;
