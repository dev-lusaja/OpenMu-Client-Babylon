370: export const EconomyPrompts = observer(() => {
371:   const prompt = Economy.prompt;
372: 
373:   const [amount, setAmount] = useState('');
374:   const [pin, setPin] = useState('');
375:   const [password, setPassword] = useState('');
376: 
377:   useEffect(() => {
378:     setAmount('');
379:     setPin('');
380:     setPassword('');
381:   }, [prompt?.kind, prompt && 'slot' in prompt ? prompt.slot : -1]);
382: 
383:   if (!prompt) return null;
384: 
385:   const spec = specOf(prompt);
386:   const value = Number(amount || '0');
387: 
388:   const confirm = () => {
389:     switch (prompt.kind) {
390:       case 'vault-deposit':
391:         Economy.moveVaultMoney(value, true);
392:         break;
393:       case 'vault-withdraw':
394:         Economy.moveVaultMoney(value, false);
395:         break;
396:       case 'vault-unlock':
397:         Economy.unlockVault(Number(pin || '0'));
398:         break;
399:       case 'vault-set-pin':
400:         Economy.setVaultPin(Number(pin || '0'), password);
401:         break;
402:       case 'vault-remove-pin':
403:         Economy.removeVaultPin(password);
404:         break;
405:       case 'trade-money':
406:         Economy.setTradeMoney(value);
407:         break;
408:       case 'shop-price':
409:         Economy.setItemPrice(prompt.slot, value);
410:         break;
411:       case 'shop-buy':
412:         Economy.buyFromShop(prompt.slot);
413:         break;
414:       case 'npc-buy-many':
415:         QuickItemActions.startBuyRun(prompt.slot, value);
416:         break;
417:     }
418: 
419:     Economy.closePrompt();
420:   };
421: 
422:   const cancel = () => Economy.closePrompt();
423: 
424:   const okDisabled =
425:     (spec.field === 'amount' && (value <= 0 || (spec.max !== undefined && value > spec.max))) ||
426:     (spec.field === 'pin' && pin.length < 4) ||
427:     (spec.field === 'pin+password' && (pin.length < 4 || !password)) ||
428:     (spec.field === 'password' && !password);
429: 
430:   const onKeyDown = (event: ReactKeyboardEvent) => {
431:     if (event.key === 'Enter' && !okDisabled) confirm();
432:     else if (event.key === 'Escape') cancel();
433:     event.stopPropagation();
434:   };
435: 
436:   if (spec.field === 'pin+password') {
437:     return (
438:       <div className="economy-prompt-layer" onKeyDown={onKeyDown}>
439:         <TallBox>
440:           <PromptText
441:             title={spec.title}
442:             hint={spec.hint}
443:             inset={TALL_TEXT_INSET_X}
444:             top={TALL_TEXT_TOP}
445:             lineHeight={TALL_TEXT_LINE_HEIGHT}
446:             lines={TALL_TEXT_LINES}
447:             wrapHint
448:           />
449: 
450:           <div className="economy-prompt-label" style={labelStyle(TALL_FIELD_ONE_LABEL_Y)}>
451:             {t('prompt.pin')}
452:           </div>
453:           <PromptInput
454:             label={t('prompt.pin')}
455:             value={pin}
456:             onChange={next => setPin(digitsOnly(next))}
457:             left={TALL_INPUT_X}
458:             top={TALL_FIELD_ONE_INPUT_Y}
459:             autoFocus
460:             numeric
461:             maxLength={5}
462:           />
463: 
464:           <div className="economy-prompt-label" style={labelStyle(TALL_FIELD_TWO_LABEL_Y)}>
465:             {t('prompt.password')}
466:           </div>
467:           <PromptInput
468:             label={t('prompt.password')}
469:             value={password}
470:             onChange={setPassword}
471:             left={TALL_INPUT_X}
472:             top={TALL_FIELD_TWO_INPUT_Y}
473:             password
474:             maxLength={20}
475:           />
476: 
477:           <PromptButtons
478:             okX={TALL_BTN_OK_X}
479:             cancelX={TALL_BTN_CANCEL_X}
480:             top={TALL_BTN_Y}
481:             okDisabled={okDisabled}
482:             onOk={confirm}
483:             onCancel={cancel}
484:           />
485:         </TallBox>
486:       </div>
487:     );
488:   }
489: 
490:   const hasField = spec.field !== 'none';
491: 
492:   return (
493:     <div className="economy-prompt-layer" onKeyDown={onKeyDown}>
494:       <SmallBox>
495:         <PromptText
496:           title={spec.title}
497:           hint={spec.hint}
498:           inset={TEXT_INSET_X}
499:           top={TEXT_TOP}
500:           lineHeight={TEXT_LINE_HEIGHT}
501:           lines={TEXT_LINES}
502:         />
503: 
504:         {spec.field === 'amount' && (
505:           <PromptInput
506:             label={spec.amountLabel ?? t('common.zen')}
507:             value={amount}
508:             onChange={next => setAmount(digitsOnly(next).slice(0, 10))}
509:             left={INPUT_X}
510:             top={INPUT_Y}
511:             autoFocus
512:             numeric
513:           />
514:         )}
515: 
516:         {spec.field === 'pin' && (
517:           <PromptInput
518:             label={t('prompt.pin')}
519:             value={pin}
520:             onChange={next => setPin(digitsOnly(next))}
521:             left={INPUT_X}
522:             top={INPUT_Y}
523:             autoFocus
524:             numeric
525:             maxLength={5}
526:           />
527:         )}
528: 
529:         {spec.field === 'password' && (
530:           <PromptInput
531:             label={t('prompt.password')}
532:             value={password}
533:             onChange={setPassword}
534:             left={INPUT_X}
535:             top={INPUT_Y}
536:             autoFocus
537:             password
538:             maxLength={20}
539:           />
540:         )}
541: 
542:         <PromptButtons
543:           okX={hasField ? BTN_INPUT_OK_X : BTN_BOTH_OK_X}
544:           cancelX={hasField ? BTN_INPUT_CANCEL_X : BTN_BOTH_CANCEL_X}
545:           top={BTN_Y}
546:           okDisabled={okDisabled}
547:           onOk={confirm}
548:           onCancel={cancel}
549:         />
550:       </SmallBox>
551:     </div>
552:   );
553: });
