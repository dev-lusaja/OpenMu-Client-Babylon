  1: import { useRef, useState, type CSSProperties, type ReactNode } from 'react';
  2: import { MuSpriteFrame } from '../../../../components/muSprite';
  3: import { uiClick } from '../../../../../libs/sfx';
  4: 
  5: /**
  6:  * A touch button. `MuButton` cannot serve here: its hover and pressed frames
  7:  * come from `onMouseEnter` / `onMouseDown`, which a browser only synthesises
  8:  * after the finger has already left the glass, so on a phone it never looks
  9:  * pressed. This drives the same frame swap from pointer events, and adds the
 10:  * long press the skill pad needs.
 11:  */
 12: 
 13: /** Held this long (ms) without moving, a press is a long press, not a tap. */
 14: const LONG_PRESS_MS = 400;
 15: /** Pixels the finger may wander before the press stops counting as either. */
 16: const SLOP = 12;
 17: 
 18: type MobileButtonProps = {
 19:   onTap?: () => void;
 20:   onLongPress?: () => void;
 21:   className?: string;
 22:   style?: CSSProperties;
 23:   title?: string;
 24:   /** Rendered with `pressed` so the caller can swap its own art. */
 25:   children: (pressed: boolean) => ReactNode;
 26: };
 27: 
 28: export const MobileButton = ({
 29:   onTap,
 30:   onLongPress,
 31:   className,
 32:   style,
 33:   title,
 34:   children,
 35: }: MobileButtonProps) => {
 36:   const [pressed, setPressed] = useState(false);
 37:   const press = useRef<{ x: number; y: number; timer: number; long: boolean } | null>(null);
 38: 
 39:   const end = () => {
 40:     const held = press.current;
 41:     press.current = null;
 42:     setPressed(false);
 43:     if (held) window.clearTimeout(held.timer);
 44:     return held;
 45:   };
 46: 
 47:   return (
 48:     <div
 49:       className={className}
 50:       title={title}
 51:       style={style}
 52:       onPointerDown={e => {
 53:         e.stopPropagation();
 54:         (e.target as HTMLElement).setPointerCapture?.(e.pointerId);
 55:         setPressed(true);
 56:         const timer = window.setTimeout(() => {
 57:           if (!press.current) return;
 58:           press.current.long = true;
 59:           setPressed(false);
 60:           uiClick(onLongPress)();
 61:         }, LONG_PRESS_MS);
 62:         press.current = { x: e.clientX, y: e.clientY, timer, long: false };
 63:       }}
 64:       onPointerMove={e => {
 65:         const held = press.current;
 66:         if (!held) return;
 67:         if (Math.hypot(e.clientX - held.x, e.clientY - held.y) > SLOP) end();
 68:       }}
 69:       onPointerUp={e => {
 70:         e.stopPropagation();
 71:         const held = end();
 72:         if (held && !held.long) uiClick(onTap)();
 73:       }}
 74:       onPointerCancel={end}
 75:       // The world reads the raw pointer stream off the canvas; a press that
 76:       // started on a button is never also a click on the ground behind it.
 77:       onContextMenu={e => e.preventDefault()}
 78:     >
 79:       {children(pressed)}
 80:     </div>
 81:   );
 82: };
 83: 
 84: /**
 85:  * A sprite cell drawn larger than its own pixels. The sheets are 30x41 and
 86:  * 32x38 - thumb targets have to be about half again that - and `transform`
 87:  * keeps the nearest-neighbour look the rest of the UI has.
 88:  */
 89: export const ScaledFrame = ({
 90:   file,
 91:   x = 0,
 92:   y = 0,
 93:   width,
 94:   height,
 95:   scale,
 96:   style,
 97:   children,
 98: }: {
 99:   file: string;
100:   x?: number;
101:   y?: number;
102:   width: number;
103:   height: number;
104:   scale: number;
105:   style?: CSSProperties;
106:   children?: ReactNode;
107: }) => (
108:   <div
109:     className="mobile-scaled"
110:     style={{ width: width * scale, height: height * scale, ...style }}
111:   >
112:     <MuSpriteFrame
113:       file={file}
114:       x={x}
115:       y={y}
116:       width={width}
117:       height={height}
118:       style={{
119:         position: 'absolute',
120:         left: 0,
121:         top: 0,
122:         transform: `scale(${scale})`,
123:         transformOrigin: '0 0',
124:       }}
125:     />
126:     {/* Outside the scaled frame on purpose: what sits on the box (an icon, a
127:         cooldown sweep) is sized in final screen pixels, not sheet pixels. */}
128:     {children}
129:   </div>
130: );
</file>

