<file path="src/ui/pages/worldPage/components/marketplace/layout.ts">
 1: /**
 2:  * Where everything sits on the frame art (`public/ui/marketplace_frame.png`).
 3:  *
 4:  * The art is chrome only - awnings, gold frame, a title plaque and the rail
 5:  * divider - so it gives the window three regions and draws no controls of its
 6:  * own. Everything inside those regions is drawn by the stylesheet.
 7:  *
 8:  * Every number is a pixel measured off the source image; `pctX` / `pctY` turn
 9:  * them into percentages so the window scales as one piece.
10:  */
11: export const FRAME_SRC = '/ui/marketplace_frame.png';
12: 
13: /** The art's own size. The window keeps this aspect ratio at every scale. */
14: export const FRAME_W = 1595;
15: export const FRAME_H = 986;
16: 
17: export const pctX = (px: number): string => `${(px / FRAME_W) * 100}%`;
18: export const pctY = (px: number): string => `${(px / FRAME_H) * 100}%`;
19: 
20: /** Left/top/width/height in image pixels, as a positioned CSS box. */
21: export const box = (l: number, t: number, r: number, b: number) => ({
22:   left: pctX(l),
23:   top: pctY(t),
24:   width: pctX(r - l),
25:   height: pctY(b - t),
26: });
27: 
28: /**
29:  * The shaped bar across the top. It ends in an arrow point at x 869-878, so
30:  * the usable run stops short of that.
31:  */
32: export const PLAQUE = box(118, 192, 864, 242);
33: 
34: /** The sidebar, inside the gold rail at x 101-334. */
35: export const RAIL = box(110, 266, 330, 924);
36: 
37: /** The main area, inside the gold rail at x 359-1498. */
38: export const CONTENT = box(368, 266, 1492, 924);
</file>

<file path="src/ui/pages/worldPage/components/marketplace/style.less">
   1: @import (reference) '../../../../components/muText/style.less';
   2: 
   3: // The frame art carries the chrome, so nothing here draws a panel, a border or
   4: // a background of its own. Fills exist only where text needs to stay legible.
   5: @mp-ink: #d9dfe9;
   6: @mp-dim: #8d96ac;
   7: @mp-gold: #e0bc6a;
   8: @mp-good: #8fd79a;
   9: @mp-bad: #dd8a7f;
  10: 
  11: // Every region is positioned to a slot the art draws, so padding has to stay
  12: // inside the box it was given. Without this the app's default content-box adds
  13: // padding on top of each region's measured size and everything drifts.
  14: .mp-window,
  15: .mp-window * {
  16:   box-sizing: border-box;
  17: }
  18: 
  19: .mp-window {
  20:   .mu-font();
  21:   position: absolute;
  22:   right: 0;
  23:   bottom: 0;
  24:   color: @mp-ink;
  25:   font-size: 12px;
  26:   background-repeat: no-repeat;
  27:   // The art is the window: it stretches as one piece, so every region below
  28:   // can be a percentage of it and nothing drifts when the window is scaled.
  29:   background-size: 100% 100%;
  30:   pointer-events: auto;
  31:   outline: none;
  32: 
  33:   // Font and cursor only, deliberately. A descendant selector here outranks
  34:   // the single-class rules below it, so anything else this set - colour,
  35:   // background, border - would silently beat `.mp-chip.is-on` and friends and
  36:   // paint light text on gold. Every button class declares its own chrome.
  37:   button {
  38:     .mu-font();
  39:     cursor: pointer;
  40:   }
  41: 
  42:   // Everything the art already draws a slot for sits on it absolutely.
  43:   > * {
  44:     position: absolute;
  45:   }
  46: 
  47:   img {
  48:     width: auto;
  49:     height: auto;
  50:   }
  51: }
  52: 
