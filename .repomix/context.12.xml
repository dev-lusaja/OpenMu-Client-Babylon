215: export const MoveCommandWindow = observer(() => {
216:   const [entries, setEntries] = useState<readonly MoveReqEntry[]>([]);
217:   const [first, setFirst] = useState(0);
218:   const dragging = useRef<{ pointerId: number; startY: number; startFirst: number } | null>(null);
219:   const open = Store.warpWindowEnabled;
220:   const chrome = useWindowChrome(WINDOW_ID, {
221:     width: WIDTH,
222:     height: HEIGHT,
223:     // `UpdateKeyEvent`: Escape closes it with SOUND_CLICK01.
224:     onClose: () => {
225:       closeMoveWindow();
226:       playUiSound('click');
227:     },
228:   });
229:   // Fit-capped by the window state, so the close bar always stays on screen.
230:   const scale = chrome.scale;
231: 
232:   useEventBus('keyPressed', key => {
233:     if (!Store.world?.playerEntity) return;
234:     if (isKey(HOT_KEY, key)) {
235:       if (Store.warpWindowEnabled) closeMoveWindow();
236:       else openMoveWindow();
237:     }
238:   });
239: 
240:   useEffect(() => {
241:     if (!open) return;
242:     // `OpenningProcess`: back to the top every time it opens.
243:     setFirst(0);
244:     let cancelled = false;
245:     loadMoveReqList().then(
246:       list => {
247:         if (!cancelled) setEntries(list);
248:       },
249:       err => console.error('Could not load MoveReq_eng.bmd:', err)
250:     );
251:     return () => {
252:       cancelled = true;
253:     };
254:   }, [open]);
255: 
256:   if (!open) return null;
257: 
258:   const { level, money, charClass } = Store.playerData;
259:   const cls = getBaseClass(charClass);
260:   const pk = Store.world?.playerEntity?.heroState ?? 3;
261: 
262:   const ordered = entries.some(entry => WarpFavourites.has(entry.index))
263:     ? [
264:         ...entries.filter(entry => WarpFavourites.has(entry.index)),
265:         ...entries.filter(entry => !WarpFavourites.has(entry.index)),
266:       ]
267:     : entries;
268: 
269:   const total = ordered.length;
270:   const maxFirst = Math.max(0, total - MAX_LINES);
271:   const start = Math.min(first, maxFirst);
272:   const visible = ordered.slice(start, start + MAX_LINES);
273:   const scrollable = maxFirst > 0;
274:   /** `m_iTotalMoveScrBtnPixel`: the thumb travels the track less its own height. */
275:   const thumbTravel = SCROLLBAR_HEIGHT - THUMB.height;
276:   const thumbY = SCROLLBAR.y + (scrollable ? Math.round((start / maxFirst) * thumbTravel) : 0);
277: 
278:   const scrollBy = (rows: number) => setFirst(f => Math.max(0, Math.min(maxFirst, f + rows)));
279: 
280:   const onWheel = (e: WheelEvent) => {
281:     if (!scrollable) return;
282:     scrollBy(e.deltaY > 0 ? 1 : -1);
283:   };
284: 
285:   const onThumbDown = (e: React.PointerEvent) => {
286:     if (!scrollable || e.button !== 0) return;
287:     dragging.current = { pointerId: e.pointerId, startY: e.clientY, startFirst: start };
288:     (e.currentTarget as HTMLElement).setPointerCapture(e.pointerId);
289:     e.stopPropagation();
290:   };
291:   const onThumbMove = (e: React.PointerEvent) => {
292:     const drag = dragging.current;
293:     if (!drag || drag.pointerId !== e.pointerId) return;
294:     const dy = (e.clientY - drag.startY) / scale;
295:     setFirst(Math.max(0, Math.min(maxFirst, Math.round(drag.startFirst + (dy / thumbTravel) * maxFirst))));
296:   };
297:   const onThumbUp = (e: React.PointerEvent) => {
298:     if (dragging.current?.pointerId === e.pointerId) dragging.current = null;
299:   };
300: 
301:   const warpTo = (entry: MoveReqEntry) => {
302:     closeMoveWindow();
303:     if (Store.isOffline) {
304:       const map = OFFLINE_MAPS[entry.index];
305:       if (map !== undefined) EventBus.emit('requestWarp', { map });
306:       return;
307:     }
308:     Store.warpCommandRequest(SERVER_INDEX[entry.index] ?? entry.index);
309:   };
310: 
311:   return (
312:     <div
313:       ref={chrome.ref as React.Ref<HTMLDivElement>}
314:       role="dialog"
315:       aria-label={t('moveList.title')}
316:       tabIndex={-1}
317:       className="move-window"
318:       onPointerDown={chrome.onPointerDown}
319:       onWheel={onWheel}
320:       style={{
321:         width: WIDTH,
322:         height: HEIGHT,
323:         ...chrome.style,
324:         transform: `scale(${scale})`,
325:         // Anchored at the stage's top-left (1,1): scale from that corner, not
326:         // from the bottom-right the chrome assumes for bar-anchored windows.
327:         transformOrigin: '0 0',
328:       }}
329:     >
330:       {/* GlobalText 933 in g_hFontBold (255, 204, 26). */}
331:       <MuText
332:         face="bold"
333:         className="move-label"
334:         color={TITLE_COLOR}
335:         style={{ left: WIDTH / 2, top: TITLE_Y }}
336:         text={t('warp.title')}
337:       />
338:       {/* GlobalText 934 / 935 / 936 in (127, 178, 255). */}
339:       <MuText className="move-label" color={HEADER_COLOR} style={{ left: COL.map, top: HEADER_Y }} text={t('warp.map')} />
340:       <MuText className="move-label" color={HEADER_COLOR} style={{ left: COL.level, top: HEADER_Y }} text={t('warp.minLevel')} />
341:       <MuText className="move-label" color={HEADER_COLOR} style={{ left: COL.zen, top: HEADER_Y }} text={t('warp.cost')} />
342: 
343:       {visible.map((entry, i) => (
344:         <Row
345:           key={entry.index}
346:           row={rowState(entry, level, money, cls, pk)}
347:           y={ROWS.y + i * ROW_HEIGHT}
348:           onClick={() => warpTo(entry)}
349:         />
350:       ))}
351: 
352:       {/* The chat-log scrollbar: up cap, stretched middle, down cap, and the 15x30 thumb. */}
353:       <MuSpriteFrame
354:         file={SCROLL_TOP_SPRITE}
355:         width={SCROLLBAR.width}
356:         height={SCROLLBAR_CAP}
357:         className="move-scrollbar"
358:         style={{ left: SCROLLBAR.x, top: SCROLLBAR.y }}
359:       />
360:       <MuSpriteFrame
361:         file={SCROLL_MIDDLE_SPRITE}
362:         width={SCROLLBAR.width}
363:         height={SCROLLBAR_HEIGHT - SCROLLBAR_CAP * 2}
364:         className="move-scrollbar"
365:         style={{ left: SCROLLBAR.x, top: SCROLLBAR.y + SCROLLBAR_CAP, backgroundSize: '100% 100%' }}
366:       />
367:       <MuSpriteFrame
368:         file={SCROLL_BOTTOM_SPRITE}
369:         width={SCROLLBAR.width}
370:         height={SCROLLBAR_CAP}
371:         className="move-scrollbar"
372:         style={{ left: SCROLLBAR.x, top: SCROLLBAR.y + SCROLLBAR_HEIGHT - SCROLLBAR_CAP }}
373:       />
374:       <div
375:         className="move-scroll-thumb"
376:         data-no-drag="true"
377:         style={{ left: THUMB_X, top: thumbY, width: THUMB.width, height: THUMB.height }}
378:         onPointerDown={onThumbDown}
379:         onPointerMove={onThumbMove}
380:         onPointerUp={onThumbUp}
381:         onPointerCancel={onThumbUp}
382:       >
383:         <MuSpriteFrame
384:           file={scrollable ? THUMB_ON_SPRITE : THUMB_OFF_SPRITE}
385:           width={THUMB.width}
386:           height={THUMB.height}
387:         />
388:       </div>
389: 
390:       {/* GlobalText 1002 on the red bar. */}
391:       <div
392:         className="move-close"
393:         data-no-drag="true"
394:         style={{ left: CLOSE_BAR.x, top: CLOSE_BAR.y, width: CLOSE_BAR.width, height: CLOSE_BAR.height, lineHeight: `${CLOSE_BAR.height}px` }}
395:         onClick={uiClick(closeMoveWindow)}
396:       >
397:         <MuText text={t('common.close')} />
398:       </div>
399:     </div>
400:   );
401: });
</file>

