141: const StatRow = observer(
142:   ({
143:     label,
144:     value,
145:     y,
146:     stat,
147:     details,
148:     detailX = DETAIL_X,
149:     firstDy = DETAIL_FIRST_DY,
150:   }: {
151:     label: string;
152:     value: number;
153:     y: number;
154:     stat: StatType;
155:     details: DetailLine[];
156:     detailX?: number;
157:     firstDy?: number;
158:   }) => {
159:     const points = Store.playerData.points;
160:     const hasPoints = points > 0;
161:     const amounts = GameOptions.statPointAmounts;
162: 
163:     const run = StatAllocation.run;
164:     const mine = run !== null && run.stat === stat;
165:     const elsewhere = run !== null && !mine;
166: 
167:     const [amount, setAmount] = useState('');
168:     // MuButton hands its handler no event, and the modifier is only known at
169:     // the press.
170:     const held = useRef({ shift: false, ctrl: false });
171: 
172:     const press = () => {
173:       if (!amounts) {
174:         Store.increaseStatRequest(stat);
175:         return;
176:       }
177:       if (mine) {
178:         StatAllocation.cancel();
179:         return;
180:       }
181:       if (elsewhere) return;
182:       // A second press while the question is up must not start a second run.
183:       if (asking()) return;
184: 
185:       const { shift, ctrl } = held.current;
186:       const typed = Number(amount || '1');
187:       const wanted = clampAmount(
188:         ctrl ? points : shift ? SHIFT_AMOUNT : typed,
189:         points
190:       );
191:       if (wanted <= 0) return;
192: 
193:       // Points cannot be taken back, so a big run is asked about first.
194:       if (needsConfirm(wanted)) askToAdd(stat, wanted);
195:       else StatAllocation.start(stat, wanted);
196:     };
