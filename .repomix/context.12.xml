559: /** `RenderMatchTimes` of both castle systems: the figure while a match runs. */
560: const EventTimer = observer(() => {
561:   // Subscribe to the observable timers *before* the map check: `mapIndex` is
562:   // a plain field of `World` (only `Store.world` itself is observable), so a
563:   // render that returned on it alone was never re-run when a match started
564:   // on the castle map (B11 - the figure never mounted live).
565:   const bc = bloodCastleTimer();
566:   const cc = chaosCastleTimer();
567:   const map = Store.world?.mapIndex;
568:   const stage = useStage();
569:   if (map === undefined) return null;
