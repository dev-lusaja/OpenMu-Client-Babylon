  1: import './style.less';
  2: import { useRef, type CSSProperties } from 'react';
  3: import { observer } from 'mobx-react-lite';
  4: import { t } from '../../../../../i18n';
  5: import { Store } from '../../../../../store';
  6: import {
  7:   Band,
  8:   instrumentById,
  9:   joinBand,
 10:   leaveBand,
 11:   loadMidiFile,
 12:   pauseSong,
 13:   playSong,
 14:   putAwayInstrument,
 15:   remotePerformers,
 16:   setLoop,
 17:   stopPlaying,
 18:   toggleInstrumentWindow,
 19: } from '../../../../../common/band';
 20: import { PERCUSSION_CHANNEL } from '../../../../../common/band/bandState';
 21: import { uiClick } from '../../../../../libs/sfx';
 22: import { MuButton } from '../../../../components/muButton';
 23: import { MuSpriteFrame } from '../../../../components/muSprite';
 24: import { MuItemWindow, MuTableFrame } from '../../../../components/muWindow';
 25: 
 26: /**
 27:  * The Instrument window: what the player does with the instrument in hand,
 28:  * in the original's item-window frame like the party and friend windows. A
 29:  * song to load and run, its channels, the band around the player, and the
 30:  * way to put the instrument away. Opens when an instrument is taken out;
 31:  * Escape, the X and the exit button close it, the instrument stays out.
 32:  *
 33:  * The song's position is drawn with the party window's life bar: the
 34:  * original has no progress bar, and that trough is the one it draws for a
 35:  * number out of a whole.
 36:  */
 37: 
 38: const WINDOW_ID = 'instrument-window';
 39: 
 40: const TITLE_Y = 12;
 41: /** The X in the frame art. `left`/`top`, not `x`/`y`: those are not CSS on a div. */
 42: const HEAD_CLOSE = { left: 169, top: 7, width: 13, height: 12 };
 43: const SONG = { x: 12, y: 34, width: 166, height: 98 };
 44: const CHANNELS = { x: 12, y: 138, width: 166, height: 112 };
 45: const BAND = { x: 12, y: 256, width: 166, height: 114 };
 46: const STATUS_Y = 374;
 47: const EXIT_BUTTON = { x: 13, y: 392, width: 36, height: 29 };
 48: const PUT_AWAY = { left: 58, top: 398 };
 49: /** Inset of a table's content from its frame. */
 50: const PAD = 8;
 51: 
 52: /** Tiles within which another performer can be joined. */
 53: const JOIN_RANGE = 10;
 54: 
 55: const EXIT_SPRITE = 'newui_exit_00.OZT';
 56: /** `newui_party_lifebar01/02`: the 151x8 trough, the 147x4 fill inset by two pixels. */
 57: const BAR_BACK_SPRITE = 'newui_Party_Lifebar01.OZJ';
 58: const BAR_FILL_SPRITE = 'newui_Party_Lifebar02.OZJ';
 59: const BAR = { width: 151, height: 8 };
 60: const BAR_FILL = { width: 147, height: 4, insetX: 2, insetY: 2 };
 61: 
 62: // Hoisted: `MuSpriteFrame` is memoised on its props.
 63: const BAR_STYLE: CSSProperties = { backgroundSize: '100% 100%' };
 64: const BAR_FILL_STYLE: CSSProperties = { left: BAR_FILL.insetX, top: BAR_FILL.insetY, backgroundSize: '100% 100%' };
 65: 
 66: type Box = { x: number; y: number; width: number; height: number };
 67: 
 68: function mmss(ms: number): string {
 69:   const s = Math.floor(ms / 1000);
 70:   return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
 71: }
 72: 
 73: function nameOf(netId: number): string {
 74:   return Store.world?.getByNetId(netId)?.objectNameInWorld ?? `#${netId}`;
 75: }
 76: 
 77: type Nearby = { netId: number; name: string; instrument: string };
 78: 
 79: function nearbyPerformers(): Nearby[] {
 80:   const world = Store.world;
 81:   const hero = world?.playerEntity;
 82:   if (!world || !hero) return [];
 83:   const out: Nearby[] = [];
 84:   // The band's own list of who performs here: it includes a player drawn
 85:   // under a monster skin, whom the player query does not carry.
 86:   for (const { netId, instrument } of remotePerformers()) {
 87:     const e = world.getByNetId(netId);
 88:     if (!e || e === hero || e.objOutOfScope) continue;
 89:     const dx = Math.abs(e.transform.pos.x - hero.transform.pos.x);
 90:     const dz = Math.abs(e.transform.pos.z - hero.transform.pos.z);
 91:     if (Math.max(dx, dz) > JOIN_RANGE) continue;
 92:     out.push({ netId, name: nameOf(netId), instrument: t(instrumentById(instrument).labelKey) });
 93:   }
 94:   return out;
 95: }
 96: 
 97: /** A table's dark fill and its frame. */
 98: const Table = ({ box }: { box: Box }) => (
 99:   <>
100:     <div className="table-fill" style={{ left: box.x, top: box.y, width: box.width, height: box.height }} />
101:     <MuTableFrame left={box.x} top={box.y} width={box.width} height={box.height} />
102:   </>
103: );
104: 
105: /** A table's content area, inset from the frame; every control in here opts out of the drag. */
106: const Content = ({ box, children }: { box: Box; children: React.ReactNode }) => (
107:   <div
108:     className="band-table"
109:     data-no-drag="true"
110:     style={{ left: box.x + PAD, top: box.y + PAD, width: box.width - 2 * PAD, height: box.height - 2 * PAD }}
111:   >
112:     {children}
113:   </div>
114: );
115: 
116: const SongTable = observer(() => {
117:   const fileInput = useRef<HTMLInputElement>(null);
118:   const song = Band.song;
119:   const playing = Band.phase === 'playing';
120:   const paused = Band.phase === 'paused';
121:   const member = Band.role === 'member';
122:   // `int iHP = (currHP * 147) / maxHP` - an integer number of filled pixels.
123:   const filled =
124:     song && song.durationMs > 0
125:       ? Math.max(0, Math.min(BAR_FILL.width, Math.trunc((BAR_FILL.width * Band.positionMs) / song.durationMs)))
126:       : 0;
127: 
128:   return (
129:     <Content box={SONG}>
130:       <div className="band-line">
131:         <span className="band-file" title={Band.fileName}>
132:           {song ? Band.fileName : t('instrument.noFile')}
133:         </span>
134:         <button type="button" disabled={member} onClick={uiClick(() => fileInput.current?.click())}>
135:           {t('instrument.load')}
136:         </button>
137:         <input
138:           ref={fileInput}
139:           type="file"
140:           accept=".mid,.midi,audio/midi"
141:           hidden
142:           onChange={e => {
143:             const file = e.target.files?.[0];
144:             if (file) void loadMidiFile(file);
145:             e.target.value = '';
146:           }}
147:         />
148:       </div>
149:       <MuSpriteFrame file={BAR_BACK_SPRITE} width={BAR.width} height={BAR.height} className="band-bar" style={BAR_STYLE}>
150:         {filled > 0 && (
151:           <MuSpriteFrame
152:             file={BAR_FILL_SPRITE}
153:             width={filled}
154:             height={BAR_FILL.height}
155:             className="band-bar-fill"
156:             style={BAR_FILL_STYLE}
157:           />
158:         )}
159:       </MuSpriteFrame>
160:       <div className="band-time">{song ? `${mmss(Band.positionMs)} / ${mmss(song.durationMs)}` : '0:00 / 0:00'}</div>
161:       <div className="band-line band-transport">
162:         <button
163:           type="button"
164:           disabled={!song || member || playing || Band.bankLoading}
165:           onClick={uiClick(() => void playSong())}
166:         >
167:           {t('instrument.play')}
168:         </button>
169:         <button type="button" disabled={!playing} onClick={uiClick(pauseSong)}>
170:           {t('instrument.pause')}
171:         </button>
172:         <button type="button" disabled={!playing && !paused} onClick={uiClick(stopPlaying)}>
173:           {t('instrument.stop')}
174:         </button>
175:         <button type="button" className={Band.loop ? 'on' : undefined} onClick={uiClick(() => setLoop(!Band.loop))}>
176:           {t('instrument.loop')}
177:         </button>
178:       </div>
179:     </Content>
180:   );
181: });
182: 
183: const ChannelsTable = observer(({ percussion }: { percussion: boolean }) => {
184:   const song = Band.song;
185:   const rows = song ? song.channels.map((c, i) => ({ ...c, index: i })).filter(c => c.used) : [];
186: 
187:   return (
188:     <Content box={CHANNELS}>
189:       <div className="band-head">{t('instrument.channels')}</div>
190:       <div className="band-list">
191:         {rows.length === 0 && <div className="band-empty">{t('instrument.noFile')}</div>}
192:         {rows.map(c => {
193:           const silent = c.index === PERCUSSION_CHANNEL && !percussion;
194:           return (
195:             <div key={c.index} className={`band-channel${silent ? ' silent' : ''}`} title={c.name}>
196:               <span className="band-ch">{c.index + 1}</span>
197:               <span className="band-name">{c.name}</span>
198:               <span className="band-notes">{c.noteCount}</span>
199:             </div>
200:           );
201:         })}
202:       </div>
203:     </Content>
204:   );
205: });
206: 
207: /**
208:  * The band: as a member, the master and the way out; as a master, who
209:  * doubles the song; otherwise the performers close enough to join. A band
210:  * doubles its master's song, every channel, on each member's instrument.
211:  */
212: const BandTable = observer(() => {
213:   const band = Band.band;
214:   const busy = Band.phase === 'playing' || Band.phase === 'paused';
215:   const nearby = Band.role === 'solo' ? nearbyPerformers() : [];
216: 
217:   return (
218:     <Content box={BAND}>
219:       <div className="band-head">{t('instrument.band')}</div>
220:       <div className="band-list">
221:         {Band.role === 'member' && band ? (
222:           <div className="band-line">
223:             <span className="band-name">{nameOf(band.masterId)}</span>
224:             <button type="button" onClick={uiClick(leaveBand)}>
225:               {t('instrument.leave')}
226:             </button>
227:           </div>
228:         ) : Band.role === 'master' && band ? (
229:           band.members.map(m => (
230:             <div key={m.netId} className="band-line">
231:               <span className="band-name">{nameOf(m.netId)}</span>
232:               <span className="band-notes">{t(instrumentById(m.instrument).labelKey)}</span>
233:             </div>
234:           ))
235:         ) : nearby.length === 0 ? (
236:           <div className="band-empty">{t('instrument.none')}</div>
237:         ) : (
238:           <>
239:             <div className="band-sub">{t('instrument.nearby')}</div>
240:             {nearby.map(p => (
241:               <div key={p.netId} className="band-line">
242:                 <span className="band-name">{`${p.name} - ${p.instrument}`}</span>
243:                 <button type="button" disabled={busy} onClick={uiClick(() => joinBand(p.netId))}>
244:                   {t('instrument.join')}
245:                 </button>
246:               </div>
247:             ))}
248:           </>
249:         )}
250:       </div>
251:     </Content>
252:   );
253: });
254: 
255: export const InstrumentWindow = observer(() => {
256:   const close = () => toggleInstrumentWindow(false);
257: 
258:   if (!Band.windowOpen || !Band.instrument) return null;
259: 
260:   const def = instrumentById(Band.instrument);
261:   const status = Band.bankLoading
262:     ? t('instrument.loading')
263:     : Band.error
264:       ? t(Band.error)
265:       : !Band.available && !Store.isOffline
266:         ? t('instrument.unavailable')
267:         : '';
268: 
269:   return (
270:     <MuItemWindow id={WINDOW_ID} className="instrument-window" column={1} label={t('instrument.title')} onClose={close}>
271:       <div className="band-title" style={{ top: TITLE_Y }}>
272:         {`${t('instrument.title')} - ${t(def.labelKey)}`}
273:       </div>
274:       <div className="head-close" data-no-drag="true" style={HEAD_CLOSE} onClick={close} />
275: 
276:       <Table box={SONG} />
277:       <Table box={CHANNELS} />
278:       <Table box={BAND} />
279:       <SongTable />
280:       <ChannelsTable percussion={def.percussion === true} />
281:       <BandTable />
282: 
283:       {status && (
284:         <div className={`band-status${Band.error && !Band.bankLoading ? ' error' : ''}`} style={{ top: STATUS_Y }}>
285:           {status}
286:         </div>
287:       )}
288: 
289:       <div data-no-drag="true" style={{ position: 'absolute', left: EXIT_BUTTON.x, top: EXIT_BUTTON.y }}>
290:         <MuButton
291:           file={EXIT_SPRITE}
292:           width={EXIT_BUTTON.width}
293:           height={EXIT_BUTTON.height}
294:           frames={{ up: 0, down: 1 }}
295:           onClick={close}
296:         />
297:       </div>
298:       <div className="band-put-away" data-no-drag="true" style={PUT_AWAY}>
299:         <button type="button" onClick={uiClick(putAwayInstrument)}>
300:           {t('instrument.putAway')}
301:         </button>
302:       </div>
303:     </MuItemWindow>
304:   );
305: });
