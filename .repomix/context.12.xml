661:   if (!open) return null;
662: 
663:   return (
664:     <div className="guild-dialog-layer">
665:       <MuSpriteFrame file={BACK_SPRITE} width={WIN_WIDTH} height={WIN_HEIGHT} className="guild-dialog">
666:         <div className="guild-dialog-text">
667:           {t('guild.foundQuestion')}
668:           <br />
669:           {t('guild.foundCost')}
670:         </div>
671:         <MuButton
672:           file={OK_SPRITE}
