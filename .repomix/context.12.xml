 93: /** The gacha stage replaces the grid, in the same rectangle. */
 94: export const STAGE_X = GRID_X;
 95: export const STAGE_Y = GRID_Y;
 96: export const STAGE_WIDTH = COLUMNS * SQUARE;
 97: export const STAGE_HEIGHT = ROWS * SQUARE;
