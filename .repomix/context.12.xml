536:           {...info}
537:           item={playerData.items[info.slot] ?? null}
538:           onHover={setHover}
539:         />
540:       ))}
541: 
542:       <MuTableFrame
543:         left={GRID_FRAME_X}
544:         top={GRID_FRAME_Y}
545:         width={GRID_FRAME_WIDTH}
546:         height={GRID_FRAME_HEIGHT}
