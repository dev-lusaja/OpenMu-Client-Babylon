<file path="src/ui/pages/worldPage/components/quests/tracker.tsx">
  1: /**
  2:  * The quest tracker: the running quests and their counts, on the HUD.
  3:  *
  4:  * The original has no such panel - the counts live in `CNewUIQuestProgress`
  5:  * and the quest tab of `CNewUIMyQuestInfoWindow`, both behind T - so this is
  6:  * ours, drawn with the quest windows' own pieces: their font, their subject
  7:  * colour for a title, their white for a line, and the green they pick a row
  8:  * out with for a quest that is done.
  9:  *
 10:  * It reads the quest layer and writes nothing back: the Season 6 log owns the
 11:  * progress records, `killCounters.ts` owns the legacy chain's kills, and the
 12:  * only state here is which rows the player folded (`trackerCollapse.ts`).
 13:  */
 14: import { observer } from 'mobx-react-lite';
 15: import { t } from '../../../../../i18n';
 16: import { GameOptions, uiScaleFactor } from '../../../../../common/gameOptions';
 17: import { devQueryNumber } from '../../../../../common/devSeams';
 18: import { uiClick } from '../../../../../libs/sfx';
 19: import { MuText } from '../../../../components/muText';
 20: import { objectiveDone, objectiveText, type QuestObjective } from '../../../../../quests/objectives';
 21: import { activeQuests, questProgressOf, questSubject } from '../../../../../quests/questLog';
 22: import { legacyQuestObjectives, legacyQuestsInProgress } from '../../../../../quests/legacyQuests';
 23: import { questDefinition } from '../../../../../quests/questData';
 24: import { COLOR } from './layout';
 25: import { toggleTrackerFold, trackerFolded } from './trackerCollapse';
 26: 
 27: /** `.minimap-corner-panel`: 10 px in from the corner of the play area. */
 28: const CORNER_INSET = 10;
 29: 
 30: /**
 31:  * What the corner minimap takes when it is on: its 240 unit square at the
 32:  * panel's own 0.75, plus the coordinate bar under it. Kept here rather than
 33:  * imported so the two panels only agree on a number, not on a module.
 34:  */
 35: const MINIMAP_SLOT = (240 + 22) * 0.75;
 36: 
 37: /**
 38:  * Left clear under the minimap slot for the event countdown rows, which sit
 39:  * in the same corner and know nothing about this panel.
 40:  */
 41: const EVENT_ROW_BAND = 60;
 42: 
 43: /** The corner minimap's drawn width, so the two line up. */
 44: const WIDTH = 240 * 0.75;
 45: 
 46: /** One quest on the tracker. */
 47: type TrackerRow = {
 48:   /** Stable across reloads: the fold is stored under it. */
 49:   id: string;
 50:   title: string;
 51:   objectives: QuestObjective[];
 52:   complete: boolean;
 53: };
 54: 
 55: /** The Season 6 log's running quests, then the legacy chain's. */
 56: function trackerRows(): TrackerRow[] {
 57:   const rows: TrackerRow[] = [];
 58: 
 59:   for (const key of activeQuests()) {
 60:     const progress = questProgressOf(key);
 61:     rows.push({
 62:       id: `s${key}`,
 63:       title: questSubject(key),
 64:       objectives: progress?.objectives ?? [],
 65:       complete: progress?.complete ?? false,
 66:     });
 67:   }
 68: 
 69:   for (const index of legacyQuestsInProgress()) {
 70:     const objectives = legacyQuestObjectives(index);
 71:     rows.push({
 72:       id: `l${index}`,
 73:       title: questDefinition(index)?.name ?? '',
 74:       objectives,
 75:       complete: objectives.length > 0 && objectives.every(objectiveDone),
 76:     });
 77:   }
 78: 
 79:   return rows;
 80: }
 81: 
 82: const TrackerQuest = observer(({ row, folded }: { row: TrackerRow; folded: boolean }) => (
 83:   <div className="quest-tracker-quest">
 84:     <div className="quest-tracker-title" onClick={uiClick(() => toggleTrackerFold(row.id))}>
 85:       <MuText face="bold" color={row.complete ? COLOR.complete : COLOR.subject} text={row.title} />
 86:     </div>
 87:     {!folded &&
 88:       row.objectives.map((objective, i) => {
 89:         const line = objectiveText(objective);
 90:         return line === null ? null : (
 91:           <MuText key={i} className="quest-tracker-objective" color={COLOR.tabOn} text={line} />
 92:         );
 93:       })}
 94:     {!folded && row.complete && (
 95:       <MuText
 96:         className="quest-tracker-objective"
 97:         color={COLOR.complete}
 98:         text={t('quest.tracker.returnToNpc')}
 99:       />
100:     )}
101:   </div>
102: ));
103: 
104: export const QuestTracker = observer(() => {
105:   if (!GameOptions.questTracker) return null;
106: 
107:   const rows = trackerRows();
108:   if (rows.length === 0) return null;
109: 
110:   const scale = uiScaleFactor(GameOptions.uiScale);
111:   const top = CORNER_INSET + (GameOptions.minimapCorner ? MINIMAP_SLOT * scale : 0) + EVENT_ROW_BAND;
112:   // Dev seam: start the first N rows folded, for a screenshot of both states.
113:   const devFolded = devQueryNumber('trackerCollapsed') ?? 0;
114: 
115:   return (
116:     <div className="quest-tracker" style={{ top, width: WIDTH, transform: `scale(${scale})` }}>
117:       {rows.map((row, i) => (
118:         <TrackerQuest key={row.id} row={row} folded={trackerFolded(row.id) || i < devFolded} />
119:       ))}
120:     </div>
121:   );
122: });
</file>

<file path="src/ui/pages/worldPage/components/quests/trackerCollapse.ts">
 1: /**
 2:  * Which tracker rows the player has folded, per character. The hot keys are
 3:  * kept the same way (`common/keyBindings.ts`): the character's own entry if it
 4:  * has one, the shared entry otherwise, so a new character starts from what the
 5:  * last one left.
 6:  *
 7:  * The only writer of that state; the tracker reads it and toggles it.
 8:  */
 9: import { observable, reaction, runInAction } from 'mobx';
10: import { LocalStorage } from '../../../../../libs/localStorage';
11: import { Store } from '../../../../../store';
12: 
13: const STORAGE_KEY = 'mu_quest_tracker';
14: 
15: const folded = observable.set<string>();
16: 
17: /** Whose folds are live: a character name, or '' for the shared set. */
18: let profile = '';
19: 
20: function storageKeyOf(name: string): string {
21:   return name ? `${STORAGE_KEY}:${name}` : STORAGE_KEY;
22: }
23: 
24: function read(name: string): string[] {
25:   const stored = LocalStorage.load(storageKeyOf(name));
26:   if (!stored) return [];
27:   try {
28:     const parsed: unknown = JSON.parse(stored);
29:     return Array.isArray(parsed) ? parsed.filter((id): id is string => typeof id === 'string') : [];
30:   } catch {
31:     return [];
32:   }
33: }
34: 
35: function loadProfile(name: string): void {
36:   profile = name;
37:   const ids = name ? read(name) : [];
38:   runInAction(() => folded.replace(ids.length ? ids : read('')));
39: }
40: 
41: reaction(
42:   () => Store.playerData.name,
43:   name => loadProfile(name),
44:   { fireImmediately: true }
45: );
46: 
47: /** Whether this quest's objectives are folded away. */
48: export function trackerFolded(id: string): boolean {
49:   return folded.has(id);
50: }
51: 
52: /** The click on a quest title. */
53: export function toggleTrackerFold(id: string): void {
54:   runInAction(() => {
55:     if (folded.has(id)) folded.delete(id);
56:     else folded.add(id);
57:   });
58:   LocalStorage.save(storageKeyOf(profile), JSON.stringify([...folded]));
59: }
</file>

