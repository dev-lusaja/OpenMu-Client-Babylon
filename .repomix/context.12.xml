111: function fruitProbability(used: number, max: number): number {
112:   if (used <= 10) return 100;
113: 
114:   const ratio = max === 0 ? 0 : Math.trunc((used * 100) / max);
115: 
116:   if (ratio <= 10) return 70;
117:   if (ratio <= 30) return 60;
118:   if (ratio <= 50) return 50;
119:   return 40;
120: }
