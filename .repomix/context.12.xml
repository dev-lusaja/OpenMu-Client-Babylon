514: // ---- CNewUINPCDialogue ------------------------------------------------------
515: 
516: /**
517:  * `CNewUINPCDialogue`: the Season 6 NPC's talk. The NPC's words are paged
518:  * seven lines at a time above the separator; below it the answers (or, after
519:  * "Accept a quest.", the NPC's quest list) are paged eleven lines at a time,
520:  * each answer a block that lights up under the mouse (`RenderSelTextBlock`).
521:  */
522: const NpcDialogueWindow = observer(() => {
523:   const [npcPage, setNpcPage] = useState(0);
524:   const [selPage, setSelPage] = useState(0);
525: 
526:   if (!npcDialogueOpen()) return null;
527: 
528:   const npcLines = npcDialogueLines().flatMap(l => wrapDialogText(l, 99, ND_LINE_CHARS));
529:   const maxNpcPage = Math.max(0, Math.ceil(npcLines.length / ND_NPC_LINES_PER_PAGE) - 1);
530:   const shownNpcPage = Math.min(npcPage, maxNpcPage);
531:   const pageLines = npcLines.slice(shownNpcPage * ND_NPC_LINES_PER_PAGE, (shownNpcPage + 1) * ND_NPC_LINES_PER_PAGE);
532:   // `SetCurNPCWords`: the answers stay hidden until the last page of the words.
533:   const showAnswers = shownNpcPage === maxNpcPage;
534: 
535:   // `SetCurSelTexts` / `CalculateSelTextMaxPage`: two lines an answer, eleven a page.
536:   const answers = npcDialogueAnswers().map((a, index) => ({ index, lines: wrapDialogText(a.text, 2, ND_LINE_CHARS) }));
537:   const pages: (typeof answers)[] = [[]];
538:   let used = 0;
539:   for (const answer of answers) {
540:     if (used + answer.lines.length > ND_SEL_LINES_PER_PAGE && pages[pages.length - 1].length > 0) {
541:       pages.push([]);
542:       used = 0;
543:     }
544:     pages[pages.length - 1].push(answer);
545:     used += answer.lines.length;
546:   }
547:   const maxSelPage = pages.length - 1;
548:   const shownSelPage = Math.min(selPage, maxSelPage);
549:   const busy = npcDialogueBusy();
550:   const contribution = npcDialogueContribution();
551: 
552:   let blockY = ND_SEL_BLOCK_Y;
553:   const answerBlocks = pages[shownSelPage].map(answer => {
554:     const top = blockY;
555:     blockY += answer.lines.length * ND_TEXT_GAP;
556:     return { ...answer, top };
557:   });
558: 
559:   return (
560:     <MuItemWindow id={NPC_DIALOGUE_WINDOW_ID} className="quest-window" column={1}>
561:       <Line y={ND_NAME_Y} text={npcDialogueNpcName()} bold color={COLOR.npcName} />
562:       <div className="head-close" data-no-drag="true" style={HEAD_CLOSE} onClick={closeNpcDialogue} />
563: 
564:       {contribution !== null && (
565:         <>
566:           <div
567:             className="table-fill"
568:             style={{ left: ND_CONTRIBUTE_BOX.x, top: ND_CONTRIBUTE_BOX.y, width: ND_CONTRIBUTE_BOX.width, height: ND_CONTRIBUTE_BOX.height }}
569:           />
570:           <Line
571:             y={ND_CONTRIBUTE_Y}
572:             text={t('quest.contribution', { value: contribution.toLocaleString() })}
573:             color={COLOR.text}
574:           />
575:         </>
576:       )}
577: 
578:       {pageLines.map((line, i) => (
579:         <Line key={i} y={ND_NPC_TEXT_Y + i * ND_TEXT_GAP} left={ND_TEXT_X} text={line} color={COLOR.text} />
580:       ))}
581: 
582:       {shownNpcPage > 0 && (
583:         <div className="quest-button" data-no-drag="true" style={{ left: ND_PAGE_L_X, top: ND_NPC_PAGE_Y }}>
584:           <MuButton file={PAGE_BUTTON_L} width={PAGE_BUTTON.width} height={PAGE_BUTTON.height} frames={PAGE_BUTTON_FRAMES} onClick={() => setNpcPage(shownNpcPage - 1)} />
585:         </div>
586:       )}
587:       {shownNpcPage < maxNpcPage && (
588:         <div className="quest-button" data-no-drag="true" style={{ left: ND_PAGE_R_X, top: ND_NPC_PAGE_Y }}>
589:           <MuButton file={PAGE_BUTTON_R} width={PAGE_BUTTON.width} height={PAGE_BUTTON.height} frames={PAGE_BUTTON_FRAMES} onClick={() => setNpcPage(shownNpcPage + 1)} />
590:         </div>
591:       )}
592: 
593:       <Separator y={ND_LINE_Y} />
594: 
595:       {showAnswers &&
596:         answerBlocks.map(answer => (
597:           <div
598:             key={answer.index}
599:             className={`quest-answer block${busy ? ' disabled' : ''}`}
600:             data-no-drag="true"
601:             style={{
602:               top: answer.top,
603:               left: ND_SEL_X,
604:               width: ND_SEL_WIDTH,
605:               height: answer.lines.length * ND_TEXT_GAP,
606:               color: COLOR.text,
607:               textAlign: 'left',
608:               fontWeight: 'normal',
609:             }}
610:             onClick={() => answerNpcDialogue(answer.index)}
611:           >
612:             {answer.lines.map((line, i) => (
613:               <div key={i} style={{ position: 'absolute', left: ND_TEXT_X - ND_SEL_X, top: ND_SEL_TEXT_Y - ND_SEL_BLOCK_Y + i * ND_TEXT_GAP, whiteSpace: 'nowrap' }}>
614:                 {line}
615:               </div>
616:             ))}
617:           </div>
618:         ))}
619: 
620:       {showAnswers && shownSelPage > 0 && (
621:         <div className="quest-button" data-no-drag="true" style={{ left: ND_PAGE_L_X, top: ND_SEL_PAGE_Y }}>
622:           <MuButton file={PAGE_BUTTON_L} width={PAGE_BUTTON.width} height={PAGE_BUTTON.height} frames={PAGE_BUTTON_FRAMES} onClick={() => setSelPage(shownSelPage - 1)} />
623:         </div>
624:       )}
625:       {showAnswers && shownSelPage < maxSelPage && (
626:         <div className="quest-button" data-no-drag="true" style={{ left: ND_PAGE_R_X, top: ND_SEL_PAGE_Y }}>
627:           <MuButton file={PAGE_BUTTON_R} width={PAGE_BUTTON.width} height={PAGE_BUTTON.height} frames={PAGE_BUTTON_FRAMES} onClick={() => setSelPage(shownSelPage + 1)} />
628:         </div>
629:       )}
630: 
631:       <ExitButton onClick={closeNpcDialogue} />
632:     </MuItemWindow>
633:   );
634: });
