287:   const gauge = (
288:     box: { left?: number; right?: number; width: number; y: number; height: number },
289:     percent: number,
290:     color: string
291:   ) => {
292:     const width = (box.width * Math.max(0, Math.min(100, percent))) / 100;
293:     const left = box.right !== undefined ? box.right - width : (box.left ?? 0);
294:     return (
295:       <div
296:         className="duel-bar-gauge"
297:         style={{ left, top: box.y, width, height: box.height, background: color }}
298:       />
299:     );
300:   };
301: 
302:   return (
303:     <div className="duel-bar" style={stage.at(0, BAR_Y)}>
304:       {BAR_BACK.map(part => (
305:         <MuSpriteFrame
306:           key={part.sprite}
307:           file={part.sprite}
308:           width={part.width}
309:           height={51}
310:           className="duel-bar-back"
311:           style={{ left: part.x }}
312:         />
313:       ))}
314: 
315:       {bars && (
316:         <>
317:           {gauge(HP1, bars.hp1, HP_COLOR)}
318:           {gauge(HP2, bars.hp2, HP_COLOR)}
319:           {gauge(SD1, bars.sd1, SD_COLOR)}
320:           {gauge(SD2, bars.sd2, SD_COLOR)}
321:         </>
322:       )}
323: 
324:       {Array.from({ length: duel.score1 }, (_, i) => (
325:         <MuSpriteFrame
326:           key={`p1-${i}`}
327:           file={PIP_SPRITE}
328:           width={PIP.width}
329:           height={PIP.height}
330:           className="duel-bar-back"
331:           style={{ left: PIP1_X + i * PIP_STEP, top: PIP.y }}
332:         />
333:       ))}
334:       {Array.from({ length: duel.score2 }, (_, i) => (
335:         <MuSpriteFrame
336:           key={`p2-${i}`}
337:           file={PIP_SPRITE}
338:           width={PIP.width}
339:           height={PIP.height}
340:           className="duel-bar-back"
341:           style={{ left: PIP2_X - i * PIP_STEP, top: PIP.y }}
342:         />
343:       ))}
344: 
345:       <div
346:         className="duel-bar-name"
347:         style={{ left: BAR_NAME1_X, top: BAR_NAME_Y, width: BAR_NAME_WIDTH }}
348:       >
349:         {duel.side1.name}
350:       </div>
351:       <div
352:         className="duel-bar-name"
353:         style={{ left: BAR_NAME2_X, top: BAR_NAME_Y, width: BAR_NAME_WIDTH }}
354:       >
355:         {duel.side2.name}
356:       </div>
357: 
358:       <div
359:         className="duel-bar-exit"
360:         style={{ left: BAR_EXIT.x, top: BAR_EXIT.y - BAR_Y }}
361:         title={t('duel.leaveWatch')}
362:       >
363:         <MuButton
364:           file={BAR_EXIT_SPRITE}
365:           width={BAR_EXIT.width}
366:           height={BAR_EXIT.height}
367:           frames={{ up: 0, active: 1, down: 2 }}
368:           onClick={() => events.quitDuelChannel()}
369:         />
370:       </div>
371:     </div>
372:   );
373: });
374: 
375: /** `CNewUIDuelWatchUserListWindow`: name rows stacked upward. */
376: const DuelSpectatorList = observer(() => {
377:   const duel = duelScoreboard();
378:   const spectators = duelSpectators();
379:   const stage = useStage();
380:   if (!duel || !duel.watching || spectators.length === 0) return null;
381: 
382:   return (
383:     <div className="duel-spectators" style={stage.at(SPECTATOR_LIST_X, 0)}>
384:       {spectators.map((name, i) => (
385:         <div
386:           key={name}
387:           className="duel-spectator-row"
388:           style={{
389:             left: 0,
390:             top: SPECTATOR_LIST_BOTTOM - (SPECTATOR_ROW.height + 1) * (i + 1),
391:             width: SPECTATOR_ROW.width,
392:             height: SPECTATOR_ROW.height,
393:             lineHeight: `${SPECTATOR_ROW.height}px`,
394:           }}
395:         >
396:           {name}
397:         </div>
398:       ))}
399:     </div>
400:   );
401: });
402: 
403: // ---- the winner box ---------------------------------------------------------
404: 
405: /** `CDuelResultMsgBox`: one line, self-clearing (events/duel.ts counts). */
406: const DuelResultBox = observer(() => {
407:   const result = duelResult();
408:   const stage = useStage();
409:   if (!result) return null;
410:   return (
411:     <div
412:       className="duel-result"
413:       style={{
414:         ...stage.at(UI_STAGE_WIDTH / 2, 150),
415:         transform: `${stage.at(0, 0).transform} translateX(-50%)`,
416:       }}
417:     >
418:       {t('duel.wins', { winner: result.winner, loser: result.loser })}
419:     </div>
420:   );
421: });
422: 
423: // ---- the one line the world page mounts -------------------------------------
424: 
425: export const DuelWindows = observer(() => (
426:   <>
427:     <DuelPrompt />
