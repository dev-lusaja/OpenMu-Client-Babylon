132: /** The question in front of a big run: Yes starts it, No changes nothing. */
133: function askToAdd(stat: StatType, wanted: number): void {
134:   Store.popUpMsgWin(
135:     MsgWinCode.ConfirmAddPoints,
136:     { count: wanted, stat: getStatName(stat) },
137:     () => StatAllocation.start(stat, wanted)
138:   );
139: }
