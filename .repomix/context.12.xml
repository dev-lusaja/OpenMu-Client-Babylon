194: /** Places a 640×480-stage rectangle on the window, scaled like the sheets. */
195: function useStage() {
196:   const scale = useUiStageScale();
197:   const offsetX = (window.innerWidth - UI_STAGE_WIDTH * scale) / 2;
198:   const offsetY = (window.innerHeight - UI_STAGE_HEIGHT * scale) / 2;
199:   return {
200:     scale,
201:     at: (x: number, y: number) => ({
202:       left: offsetX + x * scale,
203:       top: offsetY + y * scale,
204:       transform: `scale(${scale})`,
205:     }),
206:   };
207: }
