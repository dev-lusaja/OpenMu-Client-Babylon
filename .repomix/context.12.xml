 9: 
10: /**
11:  * `CNewUISkillList::RenderPetSkill` + `giPetManager::SendPetCommand`: the four
12:  * Dark Raven command boxes at (353, 352) on the 640×480 screen, drawn only
13:  * while a raven sits in the left hand (`Hero->m_pPet`). A click sends the
14:  * command straight away (the original selects it and fires on right click);
15:  * Target takes the hero's current attack target. The lit box is the mode the
16:  * server confirmed with `PetMode` (`IMAGE_SKILLBOX_USE`).
17:  */
18: 
19: /** `x = 353, y = 352, width = 32, height = 38` (NewUIMainFrameWindow.cpp:2071). */
20: const PET_BAR_X = 353;
21: const PET_BAR_Y = 352;
22: const BOX_WIDTH = 32;
23: const BOX_HEIGHT = 38;
24: /** `newui_skillbox.jpg`: the plain box; `newui_skillbox2` the lit one. */
25: const BOX_SPRITE = 'newui_skillbox.OZJ';
26: const BOX_USE_SPRITE = 'newui_skillbox2.OZJ';
27: /** Dark Raven: group 13 index 5, worn in the left hand. */
28: const DARK_RAVEN_INDEX = 5;
29: /** `kInvalidTargetKey`. */
30: const NO_TARGET = 0xffff;
31: 
32: /** `AT_PET_COMMAND_DEFAULT..TARGET` in bar order, with the packet mode of each. */
33: const COMMANDS: readonly {
34:   mode: PetCommandModeEnum;
35:   labelKey: TextKey;
36:   tipKey: TextKey;
37: }[] = [
38:   { mode: PetCommandModeEnum.Normal, labelKey: 'bottomBar.pet.normal', tipKey: 'bottomBar.pet.normalTip' },
39:   { mode: PetCommandModeEnum.AttackRandom, labelKey: 'bottomBar.pet.random', tipKey: 'bottomBar.pet.randomTip' },
40:   { mode: PetCommandModeEnum.AttackWithOwner, labelKey: 'bottomBar.pet.owner', tipKey: 'bottomBar.pet.ownerTip' },
41:   { mode: PetCommandModeEnum.AttackTarget, labelKey: 'bottomBar.pet.target', tipKey: 'bottomBar.pet.targetTip' },
42: ];
43: 
44: /** The bottom bar's local Y of a 640×480 screen Y. */
45: const BAR_TOP = 480 - 51;
46: 
47: export function ravenEquipped(): boolean {
48:   const item = Store.playerData.items[InventoryConstants.LeftHandSlot];
49:   return !!item && item.group === PET_GROUP && item.num === DARK_RAVEN_INDEX;
50: }
51: 
52: /** Shared with the pet info window's command boxes. */
53: export function sendRavenCommand(mode: PetCommandModeEnum): void {
54:   let target = NO_TARGET;
55:   if (mode === PetCommandModeEnum.AttackTarget) {
56:     target = Store.world?.attackTarget?.netId ?? NO_TARGET;
57:     if (target === NO_TARGET) {
58:       Store.addNotification(t('bottomBar.pet.needTarget'), 'error');
59:       return;
60:     }
61:   }
62:   Store.sendPetCommand(mode, target);
63: }
64: 
65: export const PetCommandBar = observer(() => {
66:   if (!ravenEquipped()) return null;
67:   const current = Store.petMode;
68: 
69:   return (
70:     <>
71:       {COMMANDS.map((command, i) => (
72:         <div
73:           key={command.mode}
74:           className={`pet-command${current === command.mode ? ' selected' : ''}`}
75:           title={t(command.tipKey)}
76:           style={{
77:             left: PET_BAR_X + i * BOX_WIDTH,
78:             top: PET_BAR_Y - BAR_TOP,
79:             width: BOX_WIDTH,
80:             height: BOX_HEIGHT,
81:           }}
82:           onPointerDown={e => e.stopPropagation()}
83:           onClick={uiClick(() => sendRavenCommand(command.mode))}
84:         >
85:           <MuSpriteFrame
86:             file={current === command.mode ? BOX_USE_SPRITE : BOX_SPRITE}
87:             width={BOX_WIDTH}
88:             height={BOX_HEIGHT}
89:             style={{ position: 'absolute', left: 0, top: 0 }}
90:           />
91:           <span>{t(command.labelKey)}</span>
92:         </div>
93:       ))}
94:     </>
95:   );
96: });
