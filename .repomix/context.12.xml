 94:       id={WINDOW_ID}
 95:       className="skill-list-window"
 96:       column={column}
 97:       label={t('skills.title')}
 98:       onClose={() =>
 99:         runInAction(() => {
100:           Store.skillListEnabled = false;
101:         })
102:       }
103:     >
104:       <div className="window-title" style={{ top: TITLE_Y }}>
105:         {t('skills.title')}
106:       </div>
107:       <MuTableFrame left={LIST.x} top={LIST.y} width={LIST.width} height={LIST.height} />
108:       <div
109:         className="skill-list"
110:         style={{ left: LIST.x + 6, top: LIST.y + 6, width: LIST.width - 12, height: LIST.height - 12 }}
111:       >
112:         {Store.skills.length === 0 && (
113:           <div className="skill-list-empty">{t('skills.empty')}</div>
114:         )}
115:         {Store.skills.map(s => (
116:           <SkillRow key={s.number} number={s.number} level={s.level} />
117:         ))}
118:       </div>
119:       <div className="skill-list-master" style={{ left: MASTER_BUTTON.x, top: MASTER_BUTTON.y }}>
120:         <MuButton
121:           file={OK_SPRITE}
122:           width={BTN_WIDTH}
123:           height={BTN_HEIGHT}
124:           frames={{ up: 0, active: 1, down: 2 }}
125:           label={t('skills.master')}
126:           onClick={() => toggleMasterSkillsWindow()}
127:         />
128:       </div>
129:     </MuItemWindow>
