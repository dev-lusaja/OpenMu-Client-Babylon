658: const TabStrip = observer(() => {
659:   const current = myQuestTab();
660:   return (
661:     <>
662:       <MuSpriteFrame
663:         file={TAB_STRIP_SPRITE}
664:         width={TAB.width}
665:         height={TAB.height}
666:         style={{ position: 'absolute', left: TAB.x, top: TAB.y }}
667:       />
668:       {TABS.map(tab => (
669:         <div
670:           key={tab.key}
671:           className="quest-tab"
672:           data-no-drag="true"
673:           style={{
674:             left: tab.x,
675:             top: TAB.y,
676:             width: tab.width,
677:             height: TAB.height,
678:             color: current === tab.key ? COLOR.tabOn : COLOR.tabOff,
679:           }}
680:           onClick={uiClick(() => selectMyQuestTab(tab.key as MyQuestTab))}
681:         >
682:           {current === tab.key && (
683:             <MuSpriteFrame
684:               file={tab.width > 48 ? TAB_BIG_SPRITE : TAB_SMALL_SPRITE}
685:               width={tab.width}
686:               height={TAB.height}
687:               style={{ position: 'absolute', left: 0, top: 0 }}
688:             />
689:           )}
690:           <TabLabel tab={tab} />
691:         </div>
692:       ))}
693:     </>
694:   );
695: });
