 76: type Spec = {
 77:   title: string;
 78:   /** The line under the title; the amount / pin field sits below it. */
 79:   hint: string;
 80:   field: 'amount' | 'pin' | 'pin+password' | 'password' | 'none';
 81:   max?: number;
 82:   /** What the number box counts; Zen unless something else is. */
 83:   amountLabel?: string;
 84: };
 85: 
 86: /**
 87:  * `CZenReceiptMsgBoxLayout`, `CZenPaymentMsgBoxLayout`,
 88:  * `CStorageLockKeyPadMsgBoxLayout`, `CStorageUnlockMsgBoxLayout`,
 89:  * `CTradeZenMsgBoxLayout` and `CPersonalShopItemValueMsgBoxLayout`: one
 90:  * modal at a time, exactly like the original's message-box stack.
 91:  */
 92: function specOf(prompt: EconomyPrompt): Spec {
 93:   switch (prompt.kind) {
 94:     case 'vault-deposit':
 95:       return {
 96:         title: t('prompt.storeZen'),
 97:         hint: t('prompt.carrying', { amount: zen(Store.playerData.money) }),
 98:         field: 'amount',
 99:         max: Store.playerData.money,
100:       };
101:     case 'vault-withdraw':
102:       return {
103:         title: t('prompt.takeZen'),
104:         hint: t('prompt.vaultHolds', { amount: zen(Economy.vaultMoney) }),
105:         field: 'amount',
106:         max: Economy.vaultMoney,
107:       };
108:     case 'vault-unlock':
109:       return {
110:         title: t('prompt.unlockVault'),
111:         hint: t('prompt.enterPin'),
112:         field: 'pin',
113:       };
114:     case 'vault-set-pin':
115:       return {
116:         title: t('prompt.setPin'),
117:         hint: t('prompt.newPinHint'),
118:         field: 'pin+password',
119:       };
120:     case 'vault-remove-pin':
121:       return {
122:         title: t('prompt.removePin'),
123:         hint: t('prompt.removePinHint'),
124:         field: 'password',
125:       };
126:     case 'trade-money':
127:       return {
128:         title: t('prompt.offerZen'),
129:         hint: t('prompt.carrying', {
130:           amount: zen(Store.playerData.money + Economy.myTradeMoney),
131:         }),
132:         field: 'amount',
133:         max: Store.playerData.money + Economy.myTradeMoney,
134:       };
135:     case 'shop-price': {
136:       const item = Economy.myShopItems[prompt.slot];
137:       const name = item ? itemDisplayName(item) : undefined;
138:       return {
139:         title: t('prompt.setPrice'),
140:         hint: name
141:           ? t('prompt.askingPriceFor', { name })
142:           : t('prompt.askingPrice'),
143:         field: 'amount',
144:         max: 2000000000,
145:       };
146:     }
147:     case 'shop-buy': {
148:       const entry = Economy.browsing?.items[prompt.slot];
149:       const name = entry ? itemDisplayName(entry.item) : undefined;
150:       return {
151:         title: t('prompt.buy'),
152:         hint: entry
153:           ? t('prompt.itemCosts', {
154:               name: name ?? t('prompt.thisItem'),
155:               price: zen(entry.price),
156:             })
157:           : t('prompt.itemGone'),
158:         field: 'none',
159:       };
160:     }
161:     case 'npc-buy-many': {
162:       const item = Store.npcShop?.items[prompt.slot] ?? null;
163:       return {
164:         title: t('prompt.buy'),
165:         hint: item
166:           ? t('prompt.buyHowMany', {
167:               name: itemDisplayName(item),
168:               price: zen(itemValue(item, 0)),
169:             })
170:           : t('prompt.itemGone'),
171:         field: 'amount',
172:         max: MAX_BULK_BUY,
173:         amountLabel: t('prompt.quantity'),
174:       };
175:     }
176:   }
177: }
