391: // ---- CNewUIQuestProgress ----------------------------------------------------
392: 
393: /**
394:  * `CNewUIQuestProgress`: the NPC's words paged seven lines at a time, then
395:  * the hero's answers, or - once the quest runs - the requirement / reward
396:  * list with the Complete button.
397:  */
398: const QuestProgressWindow = observer(() => {
399:   const [page, setPage] = useState(0);
400: 
401:   if (!questProgressOpen()) return null;
402: 
403:   const key = questProgressKey();
404:   const mode = questProgressMode();
405:   const npcLines = questProgressNpcLines().flatMap(l => wrapDialogText(l, 99, S6_LINE_CHARS));
406:   const maxPage = Math.max(0, Math.ceil(npcLines.length / QP_LINES_PER_PAGE) - 1);
407:   const shownPage = Math.min(page, maxPage);
408:   const pageLines = npcLines.slice(shownPage * QP_LINES_PER_PAGE, (shownPage + 1) * QP_LINES_PER_PAGE);
409:   const playerLines = questProgressPlayerLines()
410:     .flatMap(l => wrapDialogText(l, 2, S6_LINE_CHARS))
411:     .slice(0, 2);
412:   const answers = questProgressAnswers();
413:   const busy = questProgressBusy();
414:   const progress = questProgressOf(key);
415:   const npcName = questListNpcNumber()
416:     ? monsterName(questListNpcNumber())
417:     : t('quest.npc');
418: 
419:   const right = () => {
420:     if (shownPage < maxPage) setPage(shownPage + 1);
421:     else advanceQuestWords();
422:   };
423: 
424:   return (
425:     <MuItemWindow id={PROGRESS_WINDOW_ID} className="quest-window" column={1}>
426:       <div className="window-title" style={{ top: TITLE_Y, color: COLOR.title }}>
427:         {t('quest.tab.quest')}
428:       </div>
429:       <Line y={QP_SUBJECT_Y} text={questSubject(key)} bold color={COLOR.subject} />
430:       <Line y={QP_NPC_NAME_Y} left={QP_TEXT_X} text={npcName} bold color={COLOR.s6NpcName} />
431:       <div className="head-close" data-no-drag="true" style={HEAD_CLOSE} onClick={uiClick(closeQuestProgress)} />
432: 
433:       {pageLines.map((line, i) => (
434:         <Line key={i} y={QP_NPC_TEXT_Y + i * QP_TEXT_GAP} left={QP_TEXT_X} text={line} color={COLOR.text} />
435:       ))}
436: 
437:       {shownPage > 0 && (
438:         <div className="quest-button" data-no-drag="true" style={{ left: PAGE_BUTTON_L_X, top: PAGE_BUTTON_Y }}>
439:           <MuButton
440:             file={PAGE_BUTTON_L}
441:             width={PAGE_BUTTON.width}
442:             height={PAGE_BUTTON.height}
443:             frames={PAGE_BUTTON_FRAMES}
444:             onClick={() => setPage(shownPage - 1)}
445:           />
446:         </div>
447:       )}
448:       {(shownPage < maxPage || mode === 'npcWords') && (
449:         <div className="quest-button" data-no-drag="true" style={{ left: PAGE_BUTTON_R_X, top: PAGE_BUTTON_Y }}>
450:           <MuButton
451:             file={PAGE_BUTTON_R}
452:             width={PAGE_BUTTON.width}
453:             height={PAGE_BUTTON.height}
454:             frames={PAGE_BUTTON_FRAMES}
455:             onClick={right}
456:           />
457:         </div>
458:       )}
459: 
460:       <Separator y={QP_LINE_Y} />
461: 
462:       {mode !== 'requestReward' && (
463:         <Line y={QP_PLAYER_NAME_Y} left={QP_TEXT_X} text={Store.playerData.name} bold color={COLOR.heroName} />
464:       )}
465: 
466:       {mode === 'playerWords' && (
467:         <>
468:           {playerLines.map((line, i) => (
469:             <Line key={i} y={QP_PLAYER_TEXT_Y + i * QP_TEXT_GAP} left={QP_TEXT_X} text={line} color={COLOR.text} />
470:           ))}
471:           {answers.map((answer, i) => (
472:             <div
473:               key={i}
474:               className={`quest-answer block${busy ? ' disabled' : ''}`}
475:               data-no-drag="true"
476:               style={{
477:                 top: QP_ANSWERS_Y + i * QP_TEXT_GAP,
478:                 left: 11,
479:                 width: QP_ANSWER_WIDTH,
480:                 color: COLOR.text,
481:                 textAlign: 'left',
482:                 fontWeight: 'normal',
483:               }}
484:               onClick={() => answerQuestStep(i)}
485:             >
486:               {answer}
487:             </div>
488:           ))}
489:         </>
490:       )}
491: 
492:       {mode === 'requestReward' && (
493:         <>
494:           <RequirementList lines={progress?.lines ?? []} top={QP_LIST_Y} height={QP_LIST_HEIGHT} />
495:           <div className="quest-button" data-no-drag="true" style={{ left: COMPLETE_BUTTON.x, top: COMPLETE_BUTTON.y }}>
496:             <MuButton
497:               file={EMPTY_BUTTON_SPRITE}
498:               width={EMPTY_BUTTON.width}
499:               height={EMPTY_BUTTON.height}
500:               frames={EMPTY_BUTTON_FRAMES}
501:               label={t('quest.complete')}
502:               color={COLOR.text}
503:               disabled={!progress?.complete || busy}
504:               onClick={() => completeQuest(key)}
505:               labelStyle={{ fontSize: 10, fontWeight: 'bold' }}
506:             />
507:           </div>
508:         </>
509:       )}
510:     </MuItemWindow>
511:   );
512: });
