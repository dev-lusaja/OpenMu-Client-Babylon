723: /** Which number sheet an altar's packed state byte gets, or null for none. */
724: function altarSprite(packed: number): string | null {
725:   const contracted = (packed & 0xf0) >> 4 === 1;
726:   const grade = packed & 0x0f;
727:   if (contracted) {
728:     return CW_SPRITES.numberContracted[grade === 1 ? 0 : grade === 2 ? 1 : 2];
729:   }
730:   if (grade === 1) return CW_SPRITES.number[0];
731:   if (grade === 2) return CW_SPRITES.number[1];
732:   return null;
733: }
