 96:   padding: 1px 5px;
 97:   font-size: 12px;
 98:   line-height: 16px;
 99:   white-space: nowrap;
100:   overflow: hidden;
101:   text-overflow: ellipsis;
102:   color: #fff;
103:   background: rgba(0, 0, 0, 0.55);
104: }
105: 
106: .mobile-skill-slot,
107: .mobile-picker-slot {
108:   // `RenderSkillIcon(…, x + 6, y + 6)`: the icon inside the box.
109:   .mobile-skill-art {
110:     position: absolute;
111:     left: 50%;
112:     top: 50%;
113:     transform: translate(-50%, -50%) scale(1.5);
