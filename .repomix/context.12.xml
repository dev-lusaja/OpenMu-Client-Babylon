 90: type Placed = {
 91:   slot: number;
 92:   item: Item;
 93:   column: number;
 94:   row: number;
 95:   w: number;
 96:   h: number;
 97: };
 98: 
 99: function buildOccupancy(items: (Item | null)[]) {
100:   const squares: (Placed | null)[] = new Array(SQUARES).fill(null);
101:   const placed: Placed[] = [];
102: 
103:   for (let square = 0; square < SQUARES; square++) {
104:     const slot = FIRST_SLOT + square;
105:     const item = items[slot];
106:     if (!item) continue;
107: 
108:     const column = square % COLUMNS;
109:     const row = (square - column) / COLUMNS;
110:     const { w, h } = itemSize(item);
111: 
112:     const entry: Placed = { slot, item, column, row, w, h };
113:     placed.push(entry);
114: 
115:     for (let y = 0; y < h; y++) {
116:       for (let x = 0; x < w; x++) {
117:         if (column + x >= COLUMNS || row + y >= ROWS) continue;
118:         squares[square + y * COLUMNS + x] = entry;
119:       }
120:     }
121:   }
122: 
123:   return { squares, placed };
124: }
125: 
126: function canPlace(
127:   squares: (Placed | null)[],
128:   column: number,
129:   row: number,
130:   w: number,
131:   h: number
132: ): boolean {
133:   if (column < 0 || row < 0) return false;
134:   if (column + w > COLUMNS || row + h > ROWS) return false;
135: 
136:   for (let y = 0; y < h; y++) {
137:     for (let x = 0; x < w; x++) {
138:       if (squares[(row + y) * COLUMNS + column + x]) return false;
139:     }
140:   }
141: 
142:   return true;
143: }
144: 
145: function targetSquareAt(
146:   offsetX: number,
147:   offsetY: number,
148:   w: number,
149:   h: number
150: ): { column: number; row: number } {
151:   const x = offsetX - ((w - 1) * SQUARE) / 2;
152:   const y = offsetY - ((h - 1) * SQUARE) / 2;
153: 
154:   return { column: Math.floor(x / SQUARE), row: Math.floor(y / SQUARE) };
155: }
