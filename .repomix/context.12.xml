<file path="src/ui/pages/worldPage/components/inventory/style.less">
  1: // `CNewUIMyInventory` draws every piece at an absolute coordinate inside the
  2: // window, so the layout here is absolute positioning too - the component
  3: // supplies the original's numbers and this file only says how a piece behaves.
  4: .inventory {
  5:   font-size: 11px;
  6: 
  7:   .window-title {
  8:     position: absolute;
  9:     left: 0;
 10:     right: 0;
 11:     text-align: center;
 12:     font-weight: bold;
 13:     text-shadow: 1px 1px 0 #000;
 14:   }
 15: 
 16:   .head-close {
 17:     position: absolute;
 18:     cursor: pointer;
 19:   }
 20: 
 21:   .equipment-slot {
 22:     position: absolute;
 23:     cursor: pointer;
 24:     pointer-events: auto;
 25: 
 26:     // The silhouette the original always draws under the socket.
 27:     .equipment-slot-back {
 28:       position: absolute;
 29:       inset: 0;
 30:     }
 31: 
 32:     .equipment-slot-item {
 33:       position: absolute;
 34:       inset: 0;
 35:       display: flex;
 36:       align-items: center;
 37:       justify-content: center;
 38: 
 39:       .item-icon {
 40:         max-width: 100%;
 41:         max-height: 100%;
 42:         pointer-events: none;
 43:         user-select: none;
 44:       }
 45:     }
 46: 
 47:     // `glColor4f(0.9f, 0.1f, 0.1f, 0.4f)` over a socket the held item cannot
 48:     // go into (`NewUIMyInventory.cpp:1294`); the green is ours, marking the one
 49:     // it can.
 50:     &.can-equip::after,
 51:     &.blocked::after {
 52:       content: '';
 53:       position: absolute;
 54:       left: 1px;
 55:       top: 0;
 56:       right: 3px;
 57:       bottom: 4px;
 58:     }
 59: 
 60:     &.can-equip::after {
 61:       background-color: #33cc3366;
 62:     }
 63: 
 64:     &.blocked::after {
 65:       background-color: #e61a1a66;
 66:     }
 67:   }
 68: 
 69:   // The squares are laid out by absolute position rather than by a CSS grid:
 70:   // the pixel maths that decides where a carried item lands is ported straight
 71:   // from `CNewUIInventoryCtrl`, and it assumes a gapless pitch of exactly one
 72:   // square. A `gap` would silently put every calculation half a cell out.
 73:   .inventory-items {
 74:     position: absolute;
 75: 
 76:     // Blocked while a move is in flight to the server, so a second request
 77:     // cannot race the first.
 78:     &.busy {
 79:       pointer-events: none;
 80:       opacity: 0.6;
 81:     }
 82:   }
 83: 
 84:   // 21x21 art on a 20px pitch, so each socket overlaps its neighbour by a
 85:   // pixel - which is how the original's grid gets a single shared edge.
 86:   .inventory-square {
 87:     position: absolute;
 88: 
 89:     // `m_pdwItemCheckBox[i] > 1` tints every square an item covers, not just
 90:     // the one it is anchored to (`NewUIInventoryCtrl.cpp:891-934`), with
 91:     // `glColor4f(0.3f, 0.5f, 0.5f, 0.6f)`.
 92:     &.used::after {
 93:       content: '';
 94:       position: absolute;
 95:       left: 0;
 96:       top: 0;
 97:       width: 20px;
 98:       height: 20px;
 99:       background-color: #4d808099;
100:     }
101:   }
102: 
103:   .inventory-item {
104:     position: absolute;
105:     // The squares underneath are the click targets; hit-testing is done from
106:     // pixel coordinates, so the icons must not intercept anything.
107:     pointer-events: none;
108:     display: flex;
109:     align-items: center;
110:     justify-content: center;
111: 
112:     .item-icon {
113:       max-width: 100%;
114:       max-height: 100%;
115:       user-select: none;
116:     }
117: 
118:     .stack {
119:       position: absolute;
120:       right: 1px;
121:       bottom: 0;
122:       font-size: 10px;
123:       line-height: 10px;
124:       color: #ffd700;
125:       text-shadow: 1px 1px 0 #000;
126:     }
127:   }
128: 
129:   // The green/red rectangle the original draws under a carried item to show
130:   // whether it would fit (`NewUIInventoryCtrl.cpp:1019-1033`).
131:   .drop-target {
132:     position: absolute;
133:     pointer-events: none;
134:     background-color: #33cc3366;
135: 
136:     &.warning {
137:       background-color: #ff333366;
138:     }
139:   }
140: 
141:   // `ConvertGold` - the amount, in the well the money sprite paints.
142:   .inventory-money {
143:     position: absolute;
144:     font-weight: bold;
145:     text-shadow: 1px 1px 0 #000;
146:   }
147: 
148:   // REPAIR_MODE_ON: the squares under worn items answer to the hammer
149:   // cursor; a faint tint says the window is in that mode.
150:   &.repair-mode .inventory-items,
151:   &.repair-mode .equipment-slot {
152:     cursor: inherit;
153:   }
154: 
155:   &.repair-mode .inventory-square.used::after {
156:     background-color: #b3803399;
157:   }
158: 
159:   .window-button {
160:     position: absolute;
161: 
162:     // `ChangeToolTipText` on every one of these buttons; the original renders
163:     // it below the cursor, this hangs it under the button.
164:     .button-tooltip {
165:       display: none;
166:       position: absolute;
167:       top: 100%;
168:       left: 50%;
169:       transform: translateX(-50%);
170:       margin-top: 2px;
171:       padding: 1px 4px;
172:       background-color: #000000cc;
173:       border: 1px solid #6a6a6a;
174:       color: #fff;
175:       font-size: 10px;
176:       white-space: nowrap;
177:       pointer-events: none;
178:     }
179: 
180:     &:hover .button-tooltip {
181:       display: block;
182:     }
183:   }
184: 
