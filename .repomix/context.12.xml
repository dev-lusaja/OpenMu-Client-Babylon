288:                 ? legacyKillCount(act.itemType) >= act.itemNum
289:                 : legacyQuestDialogState() === DIALOG_STATE_ITEM;
290:             const label =
291:               act.kind === QuestActKind.Monster
292:                 ? `${monsterName(act.itemType)}  ${Math.min(legacyKillCount(act.itemType), act.itemNum)} / ${act.itemNum}`
293:                 : t('quest.reward.item', {
294:                     name:
295:                       itemBaseName(act.itemType, act.itemSubType) ||
296:                       t('quest.itemFallback', {
297:                         id: act.itemType * MAX_ITEM_INDEX + act.itemSubType,
298:                       }),
299:                     count: act.itemNum,
300:                   });
301:             return (
302:               <Line
303:                 key={i}
304:                 y={NPC_ITEM_TEXT_Y + i * NPC_LINE_STEP}
305:                 left={50}
306:                 text={label}
307:                 bold
308:                 color={done ? COLOR.done : COLOR.missing}
309:               />
310:             );
311:           })}
312:         </>
313:       )}
314: 
315:       {answers.map((answer, i) => (
316:         <div
317:           key={i}
318:           className="quest-answer"
319:           data-no-drag="true"
320:           style={{ top: answersTop + i * NPC_LINE_STEP, color: COLOR.answer }}
321:           onClick={() => answerLegacyQuest(i)}
322:         >
323:           {answer.text}
324:         </div>
325:       ))}
326: 
