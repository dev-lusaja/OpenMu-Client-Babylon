 94: function equippedSlotOf(pet: PetTypeEnum): number | null {
 95:   const slot =
 96:     pet === PetTypeEnum.DarkHorse
 97:       ? InventoryConstants.PetSlot
 98:       : InventoryConstants.LeftHandSlot;
 99:   const num = pet === PetTypeEnum.DarkHorse ? DARK_HORSE : DARK_RAVEN;
100:   const item = Store.playerData.items[slot];
101:   return item && item.group === PET_GROUP && item.num === num ? slot : null;
102: }
103: 
104: /**
105:  * `giPetManager::CalcPetInfo`: the lines the server does not send, derived
106:  * from the pet's level and the hero's stats. Charisma is the Dark Lord's
107:  * leadership. The original also folds Earthshake's skill damage (horse) and
108:  * the scepter's rise percent (raven) into the damage line; those two bonuses
109:  * are left out here.
110:  */
111: function derived(pet: PetTypeEnum, info: PetInfo) {
112:   const charisma = Store.playerData.leadership;
113:   const strength = Store.playerData.str;
114:   const level = info.level;
115:   const next = level + 1;
116: 
117:   const expNext = (10 + next) * next * next * next * 100;
118:   const speed = 20 + Math.trunc((level * 4) / 5) + Math.trunc(charisma / 50);
119:   const rate = 1000 + level + level * 15;
120: 
121:   if (pet === PetTypeEnum.DarkRaven) {
122:     return {
123:       expNext,
124:       speed,
125:       rate,
126:       damageMin: 180 + level * 15 + Math.trunc(charisma / 8),
127:       damageMax: 200 + level * 15 + Math.trunc(charisma / 4),
128:       defense: 185 + level * 15,
129:     };
130:   }
131: 
132:   const damageMin =
133:     Math.trunc(strength / 10) + Math.trunc(charisma / 10) + level * 5;
134:   return {
135:     expNext,
136:     speed,
137:     rate,
138:     damageMin,
139:     damageMax: damageMin + Math.trunc(damageMin / 2),
140:     defense: null,
141:   };
142: }
