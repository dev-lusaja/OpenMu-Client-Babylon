 713: export const CashShop = observer(() => {
 714:   const [hover, setHover] = useState<{ slot: number; x: number; y: number } | null>(null);
 715:   const [selectedId, setSelectedId] = useState<string | null>(null);
 716:   const [ordersOpen, setOrdersOpen] = useState(false);
 717:   const [asking, setAsking] = useState<Product | null>(null);
 718:   /** The product whose order was just taken, so its band says so once. */
