 658: /**
 659:  * The light that leaves the window.
 660:  *
 661:  * `.mu-item-window` carries `transform: scale()` (useWindowChrome.tsx:128),
 662:  * so it is the containing block for every `position: fixed` descendant AND
 663:  * its own stacking context - nothing written inside the window can paint
 664:  * over the window stacked next to it, whatever is done to `overflow`. The
 665:  * item tooltip has exactly this problem and solves it exactly this way
 666:  * (itemTooltip/index.tsx:264): portal to the body, position against the
 667:  * viewport. Only the ambient glow escapes; the box, the shafts and the prize
 668:  * stay inside the stage under its `overflow: hidden`, so drag, Exit and the
 669:  * window's place in the stack are untouched. Holds nothing interactive.
 670:  */
 671: const DropLight = observer(
 672:   ({ stage, phase, tier }: { stage: RefObject<HTMLDivElement>; phase: Phase; tier: Tier | null }) => {
 673:     const ref = useRef<HTMLDivElement>(null);
 674:     const lit = tier !== null && TIERS[tier].escape && LIT.has(phase) && !CashShopState.calm;
 675: 
 676:     useLayoutEffect(() => {
 677:       if (!lit) return;
 678:       let frame = 0;
 679:       // Re-read every frame for the ~1.4s this lives: the player can drag or
 680:       // rescale the window while the box is opening, and one rect read a
 681:       // frame is cheaper than a glow tearing off its window.
 682:       const follow = () => {
 683:         const box = stage.current;
 684:         const el = ref.current;
 685:         if (box && el) {
 686:           const rect = box.getBoundingClientRect();
 687:           el.style.setProperty('--cx', `${rect.left + rect.width / 2}px`);
 688:           el.style.setProperty('--cy', `${rect.top + rect.height / 2}px`);
 689:           el.style.setProperty('--scale', `${MuWindows.scaleOf(WINDOW_ID)}`);
 690:         }
 691:         frame = requestAnimationFrame(follow);
 692:       };
 693:       follow();
 694:       return () => cancelAnimationFrame(frame);
 695:     }, [lit, stage]);
 696: 
 697:     if (!lit || tier === null) return null;
 698: 
 699:     return createPortal(
 700:       <div
 701:         ref={ref}
 702:         className={`cash-drop-light tier-${tier} phase-${phase}`}
 703:         style={{ zIndex: DROP_LIGHT_Z, '--tier': TIERS[tier].colour } as CSSProperties}
 704:         aria-hidden="true"
 705:       />,
 706:       document.body
 707:     );
 708:   }
 709: );
