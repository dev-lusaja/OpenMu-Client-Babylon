  5:   position: absolute;
  6:   inset: 0;
  7:   display: grid;
  8:   place-content: center;
  9:   z-index: 500; // WINDOW_Z_SHEETS: over every window
 10:   pointer-events: auto;
 11:   .mu-font();
 12:   user-select: none;
 13: 
 14:   .emote-menu {
 15:     position: relative;
 16:     pointer-events: auto;
 17:     animation: emote-menu-open 90ms ease-out;
 18: 
 19:     svg {
 20:       display: block;
 21:       overflow: visible;
 22:     }
 23:   }
 24: 
 25:   .emote-halo {
 26:     fill: rgba(0, 0, 0, 0.35);
 27:     stroke: rgba(232, 200, 119, 0.25);
 28:     stroke-width: 1;
 29:   }
 30: 
 31:   .emote-wedge {
 32:     cursor: pointer;
 33: 
 34:     path {
 35:       fill: url(#emote-plate);
 36:       stroke: rgba(232, 200, 119, 0.45);
 37:       stroke-width: 1;
 38:       transition: fill 60ms linear;
 39:     }
 40: 
 41:     text {
 42:       fill: #e2e2e2;
 43:       font-size: 13px;
 44:       font-weight: bold;
 45:       letter-spacing: 0.5px;
 46:       pointer-events: none;
 47:       paint-order: stroke;
 48:       stroke: rgba(0, 0, 0, 0.85);
 49:       stroke-width: 3px;
 50:       stroke-linejoin: round;
 51:     }
 52: 
 53:     &.emote-ring-1 text {
 54:       font-size: 12px;
 55:     }
 56: 
 57:     // Instrument ring: the outermost, shallow, three short words.
