1017: // ---- the look of a listing, by its item -----------------------------------
1018: //
1019: // Two axes, one class each (`src/marketplace/tiers.ts`): the tier from the
1020: // level - forged from +4, high from +7 where the original starts its glow,
1021: // elite from +10 - and the kind, excellent or ancient. Tiers tint and glow
1022: // the edge; kinds add a foil edge that slides, and sparkles that twinkle.
1023: // Cards and rows are both positioned so the pseudo-elements can sit on the
1024: // edge; on a row they are absolutely positioned and so stay out of the grid.
1025: 
1026: @foil-excellent: linear-gradient(
1027:   115deg,
1028:   rgba(110, 185, 255, 0) 15%,
1029:   rgba(140, 205, 255, 0.85) 42%,
1030:   rgba(235, 248, 255, 1) 50%,
1031:   rgba(140, 205, 255, 0.85) 58%,
1032:   rgba(110, 185, 255, 0) 85%
1033: );
1034: @foil-ancient: linear-gradient(
1035:   115deg,
1036:   rgba(224, 188, 106, 0) 15%,
1037:   rgba(224, 188, 106, 0.85) 42%,
1038:   rgba(255, 244, 214, 1) 50%,
1039:   rgba(224, 188, 106, 0.85) 58%,
1040:   rgba(224, 188, 106, 0) 85%
1041: );
1042: @foil-elite: linear-gradient(
1043:   115deg,
1044:   rgba(255, 228, 160, 0) 15%,
1045:   rgba(255, 228, 160, 0.8) 42%,
1046:   rgba(255, 255, 255, 1) 50%,
1047:   rgba(255, 228, 160, 0.8) 58%,
1048:   rgba(255, 228, 160, 0) 85%
1049: );
1050: @sparkle: radial-gradient(circle, rgba(255, 255, 255, 0.95) 0 1px, rgba(255, 255, 255, 0) 2px);
1051: 
1052: @keyframes mp-foil {
1053:   from {
1054:     background-position: 0% 50%;
1055:   }
1056:   to {
1057:     background-position: 200% 50%;
1058:   }
1059: }
1060: 
1061: @keyframes mp-twinkle {
1062:   0%,
1063:   100% {
1064:     opacity: 0.1;
1065:   }
1066:   50% {
1067:     opacity: 1;
1068:   }
1069: }
1070: 
1071: .mp-card,
1072: .mp-row {
1073:   position: relative;
1074: }
1075: 
1076: // Tiers: the edge warms and glows as the level climbs.
1077: .mp-card.tier-forged {
1078:   border-color: fade(@mp-gold, 40%);
1079: }
1080: 
1081: .mp-card.tier-high {
1082:   border-color: fade(@mp-gold, 62%);
1083:   box-shadow: inset 0 0 14px fade(@mp-gold, 10%);
1084: }
1085: 
1086: .mp-card.tier-elite {
1087:   border-color: fade(@mp-gold, 85%);
1088:   box-shadow:
1089:     inset 0 0 18px fade(@mp-gold, 18%),
1090:     0 0 8px fade(@mp-gold, 28%);
1091: }
1092: 
1093: .mp-row.tier-forged {
1094:   box-shadow: inset 2px 0 0 fade(@mp-gold, 40%);
1095: }
1096: 
1097: .mp-row.tier-high {
1098:   box-shadow: inset 3px 0 0 fade(@mp-gold, 70%);
1099: }
1100: 
1101: .mp-row.tier-elite {
1102:   box-shadow:
1103:     inset 3px 0 0 @mp-gold,
1104:     inset 60px 0 30px -30px fade(@mp-gold, 12%);
1105: }
1106: 
1107: // The icon glows for the high tiers, as the item does in the original.
1108: .mp-card.tier-high .mp-card-icon,
1109: .mp-row.tier-high .mp-row-icon {
1110:   filter: drop-shadow(0 0 4px fade(@mp-gold, 55%));
1111: }
1112: 
1113: .mp-card.tier-elite .mp-card-icon,
1114: .mp-row.tier-elite .mp-row-icon {
1115:   filter: drop-shadow(0 0 6px fade(@mp-gold, 90%));
1116: }
1117: 
1118: // Kinds: a foil edge that slides along the border, and sparkles on it.
1119: .mp-foil-edge(@foil) {
1120:   &::before {
1121:     position: absolute;
1122:     inset: -1px;
1123:     padding: 1px;
1124:     pointer-events: none;
1125:     content: '';
1126:     background: @foil;
1127:     background-size: 220% 100%;
1128:     border-radius: 5px;
1129:     animation: mp-foil 4.5s linear infinite;
1130:     -webkit-mask:
1131:       linear-gradient(#000 0 0) content-box,
1132:       linear-gradient(#000 0 0);
1133:     -webkit-mask-composite: xor;
1134:     mask-composite: exclude;
1135:   }
1136: 
1137:   &::after {
1138:     position: absolute;
1139:     inset: 0;
1140:     pointer-events: none;
1141:     content: '';
1142:     background-image: @sparkle, @sparkle, @sparkle, @sparkle, @sparkle, @sparkle;
1143:     background-position:
1144:       2% 0%,
1145:       38% 100%,
1146:       100% 22%,
1147:       70% 0%,
1148:       0% 78%,
1149:       99% 88%;
1150:     background-repeat: no-repeat;
1151:     background-size: 5px 5px;
1152:     animation: mp-twinkle 2.2s ease-in-out infinite;
1153:   }
1154: }
1155: 
1156: .mp-card.is-excellent {
1157:   .mp-foil-edge(@foil-excellent);
1158:   border-color: rgba(110, 185, 255, 0.35);
1159: }
1160: 
1161: .mp-card.is-ancient {
1162:   .mp-foil-edge(@foil-ancient);
1163: }
1164: 
1165: .mp-card.tier-elite:not(.is-excellent):not(.is-ancient) {
1166:   .mp-foil-edge(@foil-elite);
1167: }
1168: 
1169: // Rows are a strip, so the foil rides the name instead of the whole edge:
1170: // the text itself catches a sliding sheen, with a matching accent and a
1171: // couple of sparkles at the icon.
1172: .mp-sheen-name(@from, @to) {
1173:   .mp-card-name {
1174:     color: transparent;
1175:     background: linear-gradient(90deg, @from 0%, @from 35%, @to 50%, @from 65%, @from 100%);
1176:     background-size: 220% 100%;
1177:     -webkit-background-clip: text;
1178:     background-clip: text;
1179:     animation: mp-foil 4.5s linear infinite;
1180:   }
1181: 
1182:   &::after {
1183:     position: absolute;
1184:     top: 0;
1185:     bottom: 0;
1186:     left: 0;
1187:     width: 46px;
1188:     pointer-events: none;
1189:     content: '';
1190:     background-image: @sparkle, @sparkle, @sparkle;
1191:     background-position:
1192:       10% 15%,
1193:       85% 80%,
1194:       55% 45%;
1195:     background-repeat: no-repeat;
1196:     background-size: 5px 5px;
1197:     animation: mp-twinkle 2.2s ease-in-out infinite;
1198:   }
1199: }
1200: 
1201: .mp-row.is-excellent {
1202:   .mp-sheen-name(#86ccff, #eaf7ff);
1203:   box-shadow: inset 2px 0 0 rgba(110, 185, 255, 0.7);
1204: }
1205: 
1206: .mp-row.is-ancient {
1207:   .mp-sheen-name(@mp-gold, #fff4d6);
1208:   box-shadow: inset 2px 0 0 fade(@mp-gold, 80%);
1209: }
1210: 
1211: // Every second one twinkles on a different beat, so a page of them does
1212: // not blink in unison.
1213: .mp-card:nth-child(even)::after,
1214: .mp-row:nth-child(even)::after {
1215:   animation-delay: -1.1s;
1216: }
1217: 
1218: .mp-card:nth-child(3n)::before,
1219: .mp-row:nth-child(3n) .mp-card-name {
1220:   animation-delay: -1.5s;
1221: }
1222: 
1223: @media (prefers-reduced-motion: reduce) {
1224:   .mp-card::before,
1225:   .mp-card::after,
1226:   .mp-row::after,
1227:   .mp-row .mp-card-name {
1228:     animation: none;
1229:   }
1230: }
