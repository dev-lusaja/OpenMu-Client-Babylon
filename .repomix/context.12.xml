  1: // The events UI: entry windows on the item-window frame, the timer figure,
  2: // the countdown line and the result boxes. Coordinates live in layout.ts.
  3: .event-window {
  4:   font-size: 11px;
  5: 
  6:   .event-title {
  7:     position: absolute;
  8:     text-align: center;
  9:     font-weight: bold;
 10:     color: #fff;
 11:     text-shadow: 1px 1px 0 #000;
 12:   }
 13: 
 14:   // One fixed-height row per line (15 / 20 px, `m_EnterUITextPos`): a line
 15:   // never wraps into the next; the component shrinks the font, then cuts.
 16:   .event-intro {
 17:     position: absolute;
 18:     text-align: center;
 19:     color: #fff;
 20:     text-shadow: 1px 1px 0 #000;
 21:     white-space: nowrap;
 22:     overflow: hidden;
 23:     text-overflow: ellipsis;
 24:   }
 25: 
 26:   .event-button {
 27:     position: absolute;
 28:   }
 29: 
 30:   .head-close {
 31:     position: absolute;
 32:     cursor: pointer;
 33:   }
 34: 
 35:   // The Mirror of Dimensions Lugard's window shows (`RenderItem3D`).
 36:   .event-dg-item {
 37:     position: absolute;
 38:     display: flex;
 39:     align-items: center;
 40:     justify-content: center;
 41: 
 42:     .item-icon {
 43:       max-width: 100%;
 44:       max-height: 100%;
 45:       user-select: none;
 46:     }
 47:   }
 48: 
 49:   .event-dg-bold {
 50:     font-weight: bold;
 51:   }
 52: }
 53: 
 54: // `CNewUIBloodCastle::Render`: the figure with three centred lines.
 55: .event-timer {
 56:   position: absolute;
 57:   transform-origin: top left;
 58:   pointer-events: none;
 59: 
 60:   .event-timer-line {
 61:     position: absolute;
 62:     left: 0;
 63:     width: 100%;
 64:     text-align: center;
 65:     white-space: nowrap;
 66:   }
 67: }
 68: 
 69: // `CSBaseMatch::RenderTime`.
 70: .event-countdown {
 71:   position: absolute;
 72:   left: 0;
 73:   width: 100%;
 74:   text-align: center;
 75:   pointer-events: none;
 76:   white-space: nowrap;
 77: }
 78: 
 79: // `RenderMatchResult`: plain lines over a dark box.
 80: .event-result {
 81:   position: absolute;
 82:   transform-origin: top left;
 83:   background: rgba(0, 0, 0, 0.6);
 84:   border: 1px solid rgba(255, 255, 255, 0.25);
 85:   color: #fff;
 86:   padding: 8px 0;
 87:   pointer-events: none;
