338: /**
339:  * Dev-only staging for the offline demo: `?statPoints=500` opens the window
340:  * on a character with that many free points, `&statRun=200` starts a run on
341:  * Strength as well, `&statConfirm=200` puts the question for that run up
342:  * instead of starting it.
343:  */
344: function stageStatPoints(): (() => void) | undefined {
345:   const points = devQueryNumber('statPoints');
346:   if (points === null) return;
347: 
348:   runInAction(() => {
349:     Store.playerData.points = points;
350:     Store.characterInfoEnabled = true;
351:   });
352: 
353:   const wanted = devQueryNumber('statRun');
354:   const confirm = devQueryNumber('statConfirm');
355:   if (wanted === null && confirm === null) return;
356: 
357:   // The map is still being warped into when this mounts, and arriving is one
358:   // of the things that ends a run.
359:   const begin = () => {
360:     EventBus.off('warpCompleted', begin);
361: 
362:     const amount = confirm ?? wanted ?? 0;
363:     const clamped = clampAmount(amount, Store.playerData.points);
364:     if (clamped <= 0) return;
365: 
366:     if (confirm !== null) askToAdd(StatType.Strength, clamped);
367:     else StatAllocation.start(StatType.Strength, clamped);
368:   };
369:   EventBus.on('warpCompleted', begin);
370: 
371:   return () => EventBus.off('warpCompleted', begin);
372: }
373: 
374: export const CharacterInfo = observer(() => {
375:   const playerData = Store.playerData;
376:   const run = StatAllocation.run;
377: 
378:   useEventBus('keyPressed', key => {
379:     if (isKey(HOT_KEY, key)) {
380:       Store.characterInfoEnabled = !Store.characterInfoEnabled;
381:     }
382:   });
383: 
384:   const open = Store.characterInfoEnabled;
