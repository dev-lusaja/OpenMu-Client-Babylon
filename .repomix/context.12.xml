 93: /** Places a 640x480-stage rectangle on the window, scaled like the sheets. */
 94: function useStage() {
 95:   const scale = useUiStageScale();
 96:   const offsetX = (window.innerWidth - UI_STAGE_WIDTH * scale) / 2;
 97:   const offsetY = (window.innerHeight - UI_STAGE_HEIGHT * scale) / 2;
 98:   return {
 99:     scale,
100:     at: (x: number, y: number) => ({
101:       left: offsetX + x * scale,
102:       top: offsetY + y * scale,
103:       transform: `scale(${scale})`,
104:     }),
105:   };
106: }
