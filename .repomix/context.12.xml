 68: export const SELECTION_HEIGHT = 31;
 69: 
 70: /** The jewel bar on the bottom edge, where the NPC shop puts its repair cost. */
 71: export const WALLET_SPRITE = 'newui_item_money2.OZT';
 72: export const WALLET_X = 10;
 73: export const WALLET_Y = 355;
 74: export const WALLET_WIDTH = 170;
 75: export const WALLET_HEIGHT = 24;
 76: 
 77: /** `newui_exit_00.OZT` is 36x58: two 29px frames, up and down. */
 78: export const EXIT_SPRITE = 'newui_exit_00.OZT';
 79: export const EXIT = { x: 77, y: 392, width: 36, height: 29 };
 80: export const EXIT_FRAMES = { up: 0, down: 1 } as const;
 81: /** Where the exit moves when the plate beside it is up: 77 would overlap it by a pixel. */
 82: export const EXIT_BESIDE_X = 100;
 83: 
 84: /**
 85:  * The left plate: Buy on a stock tab, Roll on the gacha. A plain OK plate,
 86:  * not the X. `newui_button_ok.OZT` is 54x90, three 30px frames.
 87:  */
 88: export const ROLL_SPRITE = 'newui_button_ok.OZT';
 89: export const ROLL = { x: 24, y: 391, width: 54, height: 30 };
 90: export const ROLL_FRAMES = { up: 0, active: 1, down: 2 } as const;
 91: export const BUY = ROLL;
