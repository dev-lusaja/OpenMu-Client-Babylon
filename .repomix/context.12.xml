  2: 
  3: // The touch HUD. Anchored to the viewport, not to the 640x480 stage: these
  4: // are thumb targets and must keep their size on a small screen. Only ever
  5: // mounted on a touch client (`MobileControls` returns null otherwise), so
  6: // nothing here needs a `.mu-mobile` guard of its own.
  7: 
  8: @edge-gap: 12px;
  9: @button-gap: 8px;
 10: @bar-clearance: 63px;
 11: 
 12: .mobile-controls {
 13:   position: absolute;
 14:   inset: 0;
 15:   pointer-events: none;
 16:   z-index: 400;
 17:   .mu-font();
 18:   image-rendering: pixelated;
 19: 
 20:   // Every button opts back in; the layer stays transparent to taps.
 21:   .mobile-move-button,
 22:   .mobile-menu-button,
 23:   .mobile-skill-slot,
 24:   .mobile-picker-slot,
 25:   .mobile-picker-action {
 26:     pointer-events: auto;
 27:     cursor: pointer;
 28:     touch-action: none;
 29:   }
 30: 
 31:   .mobile-scaled {
 32:     position: relative;
 33:     overflow: hidden;
 34:   }
 35: }
 36: 
 37: // ---- the warp button, top left ---------------------------------------------
 38: 
 39: .mobile-move-button {
 40:   position: absolute;
 41:   top: @edge-gap;
 42:   left: @edge-gap;
 43: 
 44:   .mobile-move-glyph {
 45:     position: absolute;
 46:     left: 50%;
 47:     top: 50%;
 48:     transform: translate(-50%, -50%);
 49:     background-size: 100% 100%;
 50:     background-repeat: no-repeat;
 51:   }
 52: }
 53: 
 54: // ---- the five main-frame buttons, top right --------------------------------
 55: 
 56: .mobile-menu-cluster {
 57:   position: absolute;
 58:   top: @edge-gap;
 59:   right: @edge-gap;
 60:   display: flex;
 61:   gap: @button-gap;
 62: 
 63:   &.portrait {
 64:     flex-direction: column;
 65:     align-items: flex-end;
 66:   }
 67: 
 68:   // Landscape has width to spare and no height: the column becomes a row.
 69:   &.landscape {
