555: /** `CTradeMsgBoxLayout`: "<name> wants to trade with you." */
556: export const TradePrompt = observer(() => {
557:   const request = Economy.tradeRequest;
558: 
559:   useEffect(() => {
560:     if (!request) return;
561:     const handler = (event: KeyboardEvent) => {
562:       if (event.key === 'Enter') Economy.answerTradeRequest(true);
563:       else if (event.key === 'Escape') Economy.answerTradeRequest(false);
564:       else return;
565:       event.preventDefault();
