591:     );
592:   }
593: 
594:   if (inChaosCastle(map)) {
595:     const t = cc;
596:     if (!t.running || t.seconds <= 0) return null;
597:     const countLine =
598:       t.maxAlive === 65535
599:         ? null
600:         : formatText(EVENT_TEXT.characterCount, t.alive, t.maxAlive);
601:     return (
602:       <TimerFigure
603:         countLine={countLine}
604:         seconds={t.seconds}
605:         imminent={chaosCastleImminent()}
606:         at={at}
607:       />
608:     );
609:   }
610: 
611:   return null;
612: });
