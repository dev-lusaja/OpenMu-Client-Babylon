<file path="src/ui/pages/worldPage/components/commandWindow/index.tsx">
  1: import './style.less';
  2: import { t, type TextKey } from '../../../../../i18n';
  3: import { useEffect, useState } from 'react';
  4: import { observer } from 'mobx-react-lite';
  5: import { Store } from '../../../../../store';
  6: import { Commands } from '../../../../../commands';
  7: import { isKey } from '../../../../../common/keyBindings';
  8: import type { CommandKind } from '../../../../../common/chatCommands';
  9: import { useEventBus } from '../../../../../hooks/useEventBus';
 10: import { uiClick } from '../../../../../libs/sfx';
 11: import { MuButton } from '../../../../components/muButton';
 12: import { MuSpriteFrame } from '../../../../components/muSprite';
 13: import { MuItemWindow, WINDOW_WIDTH } from '../../../../components/muWindow';
 14: import { MuText } from '../../../../components/muText';
 15: import { TEXT_COLOR } from '../../../serversPage/layout';
 16: 
 17: /**
 18:  * `CNewUICommandWindow` (NewUICommandWindow.cpp): the "D" window - eleven
 19:  * 108x29 `newui_btn_empty` buttons down the inventory-style frame, one per
 20:  * player-to-player command. Clicking one arms it (the button stays in its
 21:  * pressed frame and its label goes bold); the next right click on a player
 22:  * within two tiles runs it (`RunCommand`, in commands.ts). While armed, the
 23:  * name of the player under the cursor follows the mouse on
 24:  * `newUI_cursorid_wnd` (128x32), white when the command can run and red when
 25:  * it cannot (`m_bCanCommand`).
 26:  */
 27: 
 28: const WINDOW_ID = 'command-window';
 29: const HOT_KEY = 'command';
 30: 
 31: /** `RenderText(m_Pos.x + 60, m_Pos.y + 12, GlobalText[938], 72, …, RT3_SORT_CENTER)`. */
 32: const TITLE = { x: 60, y: 12, width: 72 };
 33: /** The X in the frame art (`ptExitBtn1`). */
 34: const HEAD_CLOSE = { left: 169, top: 7, width: 13, height: 12 };
 35: /** `ChangeButtonInfo(m_Pos.x + 13, m_Pos.y + 392, 36, 29)`. */
 36: const EXIT_BUTTON = { x: 13, y: 392, width: 36, height: 29 };
 37: /** `(COMMAND_WINDOW_WIDTH / 2 - 108 / 2)`, `m_Pos.y + 33`, one 29 px button per `29 + 1`. */
 38: const BUTTON = { width: 108, height: 29 };
 39: const BUTTON_X = WINDOW_WIDTH / 2 - BUTTON.width / 2;
 40: const BUTTON_Y = 33;
 41: const BUTTON_STEP = BUTTON.height + 1;
 42: /** `RenderBitmap(BITMAP_COMMAND_WINDOW_BEGIN, MouseX + 5, MouseY + 5, 128, 32)`. */
 43: const ID_TAG = { dx: 5, dy: 5, width: 128, height: 32 };
 44: 
 45: const EXIT_SPRITE = 'newui_exit_00.OZT';
 46: const BUTTON_SPRITE = 'newui_btn_empty.OZT';
 47: const ID_TAG_SPRITE = 'newui_Cursorid_wnd.OZJ';
 48: 
 49: /** GlobalText 943, 1124, 944, 945, 946, 1352, 1321, 1322, 947, 948, 949 - the window's order. */
 50: const ENTRIES: { kind: CommandKind; labelKey: TextKey }[] = [
 51:   { kind: 'trade', labelKey: 'command.trade' },
 52:   { kind: 'purchase', labelKey: 'command.purchase' },
 53:   { kind: 'party', labelKey: 'command.party' },
 54:   { kind: 'whisper', labelKey: 'command.whisper' },
 55:   { kind: 'guild', labelKey: 'command.guild' },
 56:   { kind: 'guildUnion', labelKey: 'command.guildUnion' },
 57:   { kind: 'rival', labelKey: 'command.rival' },
 58:   { kind: 'rivalOff', labelKey: 'command.rivalOff' },
 59:   { kind: 'addFriend', labelKey: 'command.addFriend' },
 60:   { kind: 'follow', labelKey: 'command.follow' },
 61:   { kind: 'battle', labelKey: 'command.battle' },
 62: ];
 63: 
 64: /** `g_iFollowCharacter` is re-aimed by `MoveHero` every step; once a second is enough for a walk. */
 65: const FOLLOW_TICK_MS = 1000;
 66: /** How often the id tag re-reads the object under the cursor. */
 67: const ID_TAG_TICK_MS = 100;
 68: 
 69: const CommandButton = observer(({ kind, labelKey, index }: { kind: CommandKind; labelKey: TextKey; index: number }) => {
 70:   const armed = Commands.pending === kind;
 71:   return (
 72:     <div
 73:       data-no-drag="true"
 74:       className={`command-entry${armed ? ' armed' : ''}`}
 75:       style={{ position: 'absolute', left: BUTTON_X, top: BUTTON_Y + index * BUTTON_STEP }}
 76:     >
 77:       <MuButton
 78:         file={BUTTON_SPRITE}
 79:         width={BUTTON.width}
 80:         height={BUTTON.height}
 81:         // `SetBtnState`: armed = frame 2 in every state.
 82:         frames={armed ? { up: 2, active: 2, down: 2 } : { up: 0, active: 1, down: 2 }}
 83:         color={TEXT_COLOR.brightGray}
 84:         activeColor={TEXT_COLOR.white}
 85:         label={t(labelKey)}
 86:         onClick={() => Commands.arm(kind)}
 87:         labelStyle={{ fontSize: 11, fontWeight: armed ? 600 : 400 }}
 88:       />
 89:     </div>
 90:   );
 91: });
 92: 
 93: /** The `CURSOR_IDSELECT` name tag that follows the mouse while an entry is armed. */
 94: const CursorIdTag = observer(() => {
 95:   const [mouse, setMouse] = useState({ x: -1000, y: -1000 });
 96:   const [target, setTarget] = useState<{ name: string; ok: boolean } | null>(null);
 97: 
 98:   useEffect(() => {
 99:     const onMove = (e: PointerEvent) => setMouse({ x: e.clientX, y: e.clientY });
100:     window.addEventListener('pointermove', onMove);
101:     const id = window.setInterval(() => {
102:       const hovered = Store.world?.currentPointerTarget;
103:       if (!hovered || !hovered.playerAnimation || hovered.localPlayer) {
104:         setTarget(null);
105:         return;
106:       }
107:       setTarget({
108:         name: hovered.objectNameInWorld ?? '',
109:         ok: Commands.canRunOn(hovered),
110:       });
111:     }, ID_TAG_TICK_MS);
112:     return () => {
113:       window.removeEventListener('pointermove', onMove);
114:       window.clearInterval(id);
115:     };
116:   }, []);
117: 
118:   if (!target) return null;
119: 
120:   return (
121:     <MuSpriteFrame
122:       file={ID_TAG_SPRITE}
123:       width={ID_TAG.width}
124:       height={ID_TAG.height}
125:       className="command-id-tag"
126:       style={{ left: mouse.x + ID_TAG.dx, top: mouse.y + ID_TAG.dy }}
127:     >
128:       {/* `g_hFontBig`, white when `m_bCanCommand`, else red, centred at +64/+7. */}
129:       <MuText
130:         face="big"
131:         color={target.ok ? '#fff' : 'rgb(255,0,0)'}
132:         className="command-id-name"
133:         text={target.name}
134:       />
135:     </MuSpriteFrame>
136:   );
137: });
138: 
139: export const CommandWindow = observer(() => {
140:   useEventBus('keyPressed', key => {
141:     if (!Store.world?.playerEntity) return;
142:     if (isKey(HOT_KEY, key)) Commands.toggleWindow();
143:   });
144: 
145:   // `g_iFollowCharacter`: keep walking after the followed player.
146:   useEffect(() => {
147:     const id = window.setInterval(() => Commands.followTick(), FOLLOW_TICK_MS);
148:     return () => window.clearInterval(id);
149:   }, []);
150: 
151:   const close = uiClick(() => Commands.closeWindow());
152: 
153:   return (
154:     <>
155:       {Commands.pending && <CursorIdTag />}
156:       {Commands.windowOpen && (
157:         <MuItemWindow
158:           id={WINDOW_ID}
159:           className="command-window"
160:           column={2}
161:           label={t('command.title')}
162:           // `UpdateKeyEvent`: Escape closes the window (and disarms).
163:           onClose={() => Commands.closeWindow()}
164:         >
165:           {/* GlobalText 938 in `g_hFontBold`. */}
166:           <MuText
167:             face="bold"
168:             align="center"
169:             className="command-title"
170:             style={{ left: TITLE.x, top: TITLE.y, width: TITLE.width }}
171:             text={t('command.title')}
172:           />
173:           <div className="head-close" data-no-drag="true" style={HEAD_CLOSE} onClick={close} />
174: 
175:           {ENTRIES.map((entry, i) => (
176:             <CommandButton key={entry.kind} kind={entry.kind} labelKey={entry.labelKey} index={i} />
177:           ))}
178: 
179:           <div
180:             data-no-drag="true"
181:             style={{ position: 'absolute', left: EXIT_BUTTON.x, top: EXIT_BUTTON.y }}
