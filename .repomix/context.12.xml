12: /**
13:  * What the experience strip is worth in numbers. The bar itself only draws
14:  * tenths through the original's number strip, so the exact figures live in a
15:  * hover tip - the same box the skill hover tip uses, so no new chrome is
16:  * invented for it.
17:  *
18:  * The time to level is `SessionStats.msToLevel`: the session panel's rate,
19:  * read here, never recomputed.
20:  */
21: export function buildExpTooltip(
22:   percent: number,
23:   exp: number,
24:   next: number,
25:   msToLevel: number | null
26: ): TipLine[] {
27:   return [
28:     { text: '', color: 'white', blank: true },
29:     { text: t('exp.title'), color: 'blue', bold: true },
30:     { text: '', color: 'white', blank: true },
31:     { text: formatExpPercent(percent), color: 'white' },
32:     { text: formatExpProgress(exp, next), color: 'white' },
33:     {
34:       text: `${t('session.toLevel')} ${formatTimeToLevel(msToLevel)}`,
35:       color: msToLevel === null ? 'gray' : 'white',
36:     },
37:   ];
38: }
39: 
40: export const ExpTooltip = observer(({ x, y }: { x: number; y: number }) => {
41:   const { expPercent, exp, expToNextLvl } = Store.playerData;
42: 
43:   return (
44:     <MuTipList
45:       lines={buildExpTooltip(expPercent, exp, expToNextLvl, SessionStats.msToLevel)}
46:       x={x}
47:       y={y}
48:     />
49:   );
50: });
</file>

