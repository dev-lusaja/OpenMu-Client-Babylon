<file path="src/version/uiContract.ts">
 1: /**
 2:  * THE UI CONTRACT for a game version - what `versions/<id>/ui/` exports.
 3:  *
 4:  * Types only, so `versions/registry.ts` can name them without importing app
 5:  * code (`import type` is erased). The module itself is the one door a version
 6:  * has that *may* import app code, because it is only ever loaded from inside
 7:  * the running app (`loadVersionUi`, React.lazy at a consumer, or an ECS
 8:  * system after boot) - never from the boot path.
 9:  *
10:  * The rule base code follows: it never asks which version this is. It asks
11:  * this module for the screen, or `gameVersion.features.*` for whether a
12:  * screen exists at all.
13:  */
14: import type { ComponentType } from 'react';
15: import type { ENUM_WORLD } from '../common/types';
16: import type { World } from '../ecs/world';
17: 
18: /**
19:  * The scene behind the pre-game screens (start menu, server list, login,
20:  * character select). Two kinds, because they are genuinely different things:
21:  *
22:  * - `world`: warp to a login world and run its camera-walk script. Season 6
23:  *   (worlds 73 / 74) and anything else whose tree ships a login map.
24:  * - `scene`: build a set piece directly in the scene, no terrain and no
25:  *   warp. What 0.97d does - its login screen is a ship on an empty sea,
26:  *   assembled from five models around the world origin, and its tree has no
27:  *   login world to warp to.
28:  */
29: export type PregameBackdrop =
30:   | {
31:       readonly kind: 'world';
32:       readonly login: ENUM_WORLD;
33:       readonly characters: ENUM_WORLD;
34:     }
35:   | {
36:       readonly kind: 'scene';
37:       create(world: World): PregameScene;
38:     };
39: 
40: /** Which pre-game screen the backdrop is standing behind. */
41: export type PregamePhase = 'login' | 'characters';
42: 
43: /**
44:  * A standalone pre-game set piece. Owns its own models and its own camera;
45:  * `dispose` runs when the pre-game screens are left. `update` is called once
46:  * a frame with the seconds since the last one, and is the only writer of the
47:  * camera while it lives.
48:  */
49: export interface PregameScene {
50:   update(deltaTime: number, phase: PregamePhase): void;
51:   dispose(): void;
52: }
53: 
54: /**
55:  * The MU wordmark over the start menu. `Data/`-rooted paths (`muSprite`'s
56:  * prefix). At least one of the two layers must be given: Season 6 ships a
57:  * TGA mark over a JPEG glow, the 0.97d tree only the JPEG.
58:  */
59: export type PregameLogo = {
60:   /** Sprite with alpha, drawn on top. */
61:   readonly mark?: string;
62:   /** JPEG under it, or alone: keyed by luminance so its black is transparent. */
63:   readonly glow?: string;
64:   readonly width: number;
65:   readonly height: number;
66: };
67: 
68: /** The pre-game half of a version's UI: the backdrop and the two screens on it. */
69: export type PregameUi = {
70:   readonly backdrop: PregameBackdrop;
71:   readonly logo: PregameLogo;
72:   readonly LoginPage: ComponentType;
73:   readonly CharactersPage: ComponentType;
74: };
75: 
76: /**
77:  * The sprite sheets to decode up front. `preloadSprites.ts` keeps owning
78:  * *when* and *how*; which files exist is the version's own answer, because a
79:  * period `Data/Interface/` and the Season 6 one share almost no names.
80:  */
81: export type VersionPreload = {
82:   /** Decoded before the start menu paints. */
83:   readonly pregameSprites: readonly string[];
84:   /** Decoded on world entry, dropped on logout. */
85:   readonly worldSprites: readonly string[];
86: };
87: 
88: /**
89:  * What `versions/<id>/ui/index.tsx` exports. Every name exists in every
90:  * version: a version without a window exports a component that renders
91:  * nothing (`versions/_template/ui`), so no consumer branches on a version id.
92:  */
93: export type VersionUi = {
94:   readonly pregame: PregameUi;
95:   readonly preload: VersionPreload;
96:   /** In-game windows, one export per window. */
97:   readonly MasterSkillsWindow: ComponentType;
98: };
</file>

