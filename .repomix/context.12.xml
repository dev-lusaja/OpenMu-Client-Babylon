1045:         file={EXIT_SPRITE}
1046:         width={EXIT.width}
1047:         height={EXIT.height}
1048:         frames={EXIT_FRAMES}
1049:         onClick={() => toggleCashShopWindow(false)}
1050:         style={{ position: 'absolute', left: plateUp ? EXIT_BESIDE_X : EXIT.x, top: EXIT.y }}
1051:       />
1052: 
1053:       {asking && <BuyPrompt product={asking} onAnswer={answer} />}
1054:     </MuItemWindow>
1055:   );
1056: });
</file>

<file path="src/ui/pages/worldPage/components/cashShop/layout.ts">
  1: /**
  2:  * `CNewUICashShop`: the 190x429 item frame, laid out the way
  3:  * `CNewUINPCShop` lays out a merchant - title on the head, an 8-column grid of
  4:  * 20px squares below it, and the money bar on the bottom edge.
  5:  *
  6:  * Same numbers as `npcShop/layout.ts` on purpose: a player who can read one
  7:  * shop can read the other, and the squares have to line up with the inventory
  8:  * they are compared against.
  9:  *
 10:  * Every pixel the window and the gacha stage use is here. The stylesheet
 11:  * says how a piece behaves, never where it is.
 12:  */
 13: 
 14: export const GRID_X = 15;
 15: export const GRID_Y = 74;
 16: 
 17: export const SQUARE = 20;
 18: export const COLUMNS = 8;
 19: export const ROWS = 12;
 20: export const SQUARES = COLUMNS * ROWS;
 21: 
 22: export const SQUARE_SPRITE = 'newui_item_box.OZT';
 23: export const SQUARE_SPRITE_SIZE = 21;
 24: 
 25: const WND_TOP_EDGE = 3;
 26: const WND_LEFT_EDGE = 4;
 27: const WND_BOTTOM_EDGE = 8;
 28: const WND_RIGHT_EDGE = 9;
 29: const TABLE_CORNER = 14;
 30: 
 31: export const GRID_FRAME_X = GRID_X - WND_LEFT_EDGE;
 32: export const GRID_FRAME_Y = GRID_Y - WND_TOP_EDGE;
 33: export const GRID_FRAME_WIDTH =
 34:   COLUMNS * SQUARE - WND_RIGHT_EDGE + WND_LEFT_EDGE + TABLE_CORNER;
 35: export const GRID_FRAME_HEIGHT =
 36:   ROWS * SQUARE - WND_BOTTOM_EDGE + WND_TOP_EDGE + TABLE_CORNER;
 37: 
 38: export const TITLE_Y = 12;
 39: 
 40: /** The X in the frame art (`CheckMouseIn(x + 169, y + 7, 13, 12)`). */
 41: export const HEAD_CLOSE = { left: 169, top: 7, width: 13, height: 12 };
 42: 
 43: /**
 44:  * The tab strip, between the title and the grid. Four tabs - the three
 45:  * product lines and the delivery queue - across the 167px between the frame
 46:  * edges, so each is a 41px crop of `newui_guild_tab04.OZT`'s 56px art. The
 47:  * sheet is two 22px frames, off and on; MuButton picks the second for the
 48:  * checked tab.
 49:  *
 50:  * 41 rather than the 33 five tabs needed: the strip spans the same 164px
 51:  * either way, and the eight extra pixels are what let a translated label sit
 52:  * in the tab instead of being clipped by it.
 53:  */
 54: export const TAB_Y = 46;
