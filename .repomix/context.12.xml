557:           height: ROWS * SQUARE,
558:         }}
559:         onPointerDown={onGridPointerDown}
560:         onContextMenu={onGridContextMenu}
561:         onPointerMove={event => {
562:           // State only moves when the hovered *item* changes, not per event.
563:           const square = squareAt(event.clientX, event.clientY);
564:           const entry = square >= 0 ? squares[square] : null;
565:           setHover(current => {
566:             if (!entry) return current === null ? current : null;
567:             if (current && current.item === entry.item) return current;
568:             return { item: entry.item, slot: entry.slot, x: event.clientX, y: event.clientY };
569:           });
570:         }}
