175:     <>
176:       <div
177:         className="table-fill"
178:         style={{ left: BOX.x, top: BOX.y, width: BOX.width, height }}
179:       />
180:       <MuTableFrame left={BOX.x} top={BOX.y} width={BOX.width} height={height} />
181: 
182:       {row(LEVEL_Y, t('petInfo.level', { level: info.level }), 'pet-level')}
183:       {row(
184:         LIFE_TEXT_Y,
185:         t('petInfo.life', { current: life, max: PET_MAX_LIFE })
186:       )}
