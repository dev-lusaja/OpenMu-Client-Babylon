575:     if (!t.running || t.seconds <= 0) return null;
576:     const countLine =
577:       t.maxKill === 65535
578:         ? null
579:         : formatText(
580:             t.gateDestroyed ? EVENT_TEXT.skeletonCount : EVENT_TEXT.monsterCount,
581:             t.killed,
582:             t.maxKill
