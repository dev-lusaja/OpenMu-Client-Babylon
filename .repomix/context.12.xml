721:               onClick={uiClick(() => selectMyQuest(key))}
722:             >
723:               {i + 1}.{questSubject(key)}
724:             </div>
725:           ))}
726:         </div>
727:       )}
728: 
729:       <Separator y={MQ_LINE_Y} />
730: 
731:       <div className="table-fill" style={{ left: 10, top: MQ_SUMMARY_Y, width: 171, height: MQ_SUMMARY_HEIGHT }} />
732:       <MuTableFrame left={10} top={MQ_SUMMARY_Y} width={171} height={MQ_SUMMARY_HEIGHT} />
733:       <div
734:         className="quest-list"
735:         data-no-drag="true"
736:         style={{ left: 14, top: MQ_SUMMARY_Y + 4, width: 163, height: MQ_SUMMARY_HEIGHT - 8 }}
737:       >
738:         {summary.map((line, i) => (
739:           <div key={`s${i}`} className="row" style={{ color: COLOR.text, cursor: 'default' }}>
740:             {line}
741:           </div>
742:         ))}
743:         {progress?.lines.map((line, i) => (
744:           <div
745:             key={`p${i}`}
746:             className={`row${line.kind === 'header' ? ' header' : ''}`}
747:             style={{ cursor: 'default', color: lineColor(line) }}
748:           >
749:             {line.text}
750:           </div>
751:         ))}
752:       </div>
753: 
754:       <div className="quest-button" data-no-drag="true" style={{ left: OPEN_BUTTON.x, top: OPEN_BUTTON.y }}>
