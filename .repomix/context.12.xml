131:  * menu, below modal prompts (600), tooltips (1200) and the cursor (2000).
132:  */
133: export const DROP_LIGHT_Z = 520;
134: 
135: /** Folded into the world preload so the plates stop popping in on first open. */
136: export const CASH_SHOP_SPRITES = [
137:   TAB_SPRITE,
138:   WALLET_SPRITE,
139:   ROLL_SPRITE,
140:   EXIT_SPRITE,
141:   SQUARE_SPRITE,
142: ] as const;
