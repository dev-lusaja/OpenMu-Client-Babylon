 43: const RING_DEPTH = [62, 70, 58, 44];
 44: const WEDGE_GAP_DEG = 1.6;
 45: 
 46: /**
 47:  * A wedge is either an animated emote (plays a clip, sent as an animation
 48:  * request) or an emoji bubble (an overlay, sent as its chat token) - see
 49:  * common/emojiBubbles.ts for why those are separate things and why the
 50:  * bubbles travel over chat.
 51:  */
 52: type RadialEntry =
 53:   | { kind: 'emote'; id: string; glyph: string; emote: EmoteDefinition }
 54:   | { kind: 'emoji'; id: string; glyph: string; emoji: EmojiBubbleDefinition }
 55:   | { kind: 'instrument'; id: string; glyph: string; instrument: InstrumentDefinition };
 56: 
 57: /**
 58:  * The hub caption. An emoji also carries its chat token, which is both what
 59:  * goes out on the wire and what a player can type to pop the same bubble.
 60:  * An instrument already in hand offers to be put away.
 61:  */
 62: function entryLabel(entry: RadialEntry): string {
 63:   if (entry.kind === 'emote') return t(entry.emote.labelKey);
 64:   if (entry.kind === 'emoji') return `${t(entry.emoji.labelKey)}  ${entry.emoji.words[0]}`;
 65:   if (!Store.isOffline && !Band.available) return t('instrument.unavailable');
 66:   return Band.instrument === entry.instrument.id
 67:     ? `${t(entry.instrument.labelKey)} - ${t('instrument.putAway')}`
 68:     : t(entry.instrument.labelKey);
 69: }
