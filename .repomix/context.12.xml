<file path="src/ui/pages/worldPage/components/chat/style.less">
  1: @import (reference) '../../../../components/muText/style.less';
  2: // `CNewUIChatInputBox` / `CNewUIChatLogWindow`. Every coordinate comes from
  3: // the C++ and is passed in by the component; this file is only how the
  4: // pieces stack and how text is drawn.
  5: .chat-window {
  6:   position: absolute;
  7:   left: 0;
  8:   pointer-events: auto;
  9:   user-select: none;
 10:   .mu-font();
 11:   font-size: 11px;
 12:   color: #fff;
 13:   image-rendering: pixelated;
 14: 
 15:   .mu-resize-grip {
 16:     opacity: 0;
 17:   }
 18:   &:hover .mu-resize-grip {
 19:     opacity: 0.6;
 20:   }
 21: }
 22: 
 23: // Touch only. The window and the log are one big invisible rectangle in the
 24: // bottom-left corner - 422x221 px of it on a 375 px phone, right where the
 25: // thumb taps to walk - and while the log is unframed there is nothing there
 26: // to press. So nothing takes a tap unless it is actually on screen: a log the
 27: // player opened the frame on, and the input box while it is up.
 28: .mu-mobile {
 29:   .chat-window,
 30:   .chat-log:not(.framed) {
 31:     pointer-events: none;
 32:   }
 33: 
 34:   .chat-log.framed,
 35:   .chat-filter-tabs,
 36:   .chat-input {
 37:     pointer-events: auto;
 38:   }
 39: 
 40:   // No cursor to reveal it with, and another 20 px of dead corner.
 41:   .chat-window .mu-resize-grip {
 42:     display: none;
 43:   }
 44: }
 45: 
 46: // The log hangs above the input box's position (`m_WndPos.y - m_WndSize.cy`).
 47: .chat-log {
 48:   position: absolute;
 49:   left: 0;
 50:   overflow: visible;
 51: 
 52:   .chat-log-drag {
 53:     position: absolute;
 54:     left: 0;
 55:     cursor: ns-resize;
 56:   }
 57: 
 58:   .chat-log-part {
 59:     position: absolute;
 60:     pointer-events: none;
 61:   }
 62: 
 63:   .chat-log-thumb {
 64:     position: absolute;
 65:     &.idle {
 66:       opacity: 0.6;
 67:     }
 68:   }
 69:   .chat-log-thumb-hit {
 70:     position: absolute;
 71:     inset: 0;
 72:     cursor: pointer;
 73:   }
 74: }
 75: 
 76: // `RenderText` with a background colour: the box hugs the text.
 77: .chat-line {
 78:   // The optional clock column: dimmer than the line it prefixes.
 79:   .chat-line-time {
 80:     opacity: 0.65;
 81:   }
 82: 
 83:   position: absolute;
 84:   display: inline-block;
 85:   box-sizing: border-box;
 86:   height: 15px;
 87:   line-height: 15px;
 88:   padding: 0 2px;
 89:   white-space: nowrap;
 90:   overflow: hidden;
 91:   text-overflow: clip;
 92:   text-shadow: none;
 93:   cursor: default;
 94: }
 95: 
 96: // `newui_chat_back` is the box; everything else is laid on top of it.
 97: .chat-input {
 98:   position: absolute;
 99:   left: 0;
100:   bottom: 0;
101: 
102:   .chat-strip-button {
103:     position: absolute;
104:     cursor: pointer;
105:   }
106: 
107:   // `RenderTooltip`: white on black(180), just above the strip.
108:   .chat-tooltip {
109:     position: absolute;
110:     top: -15px;
111:     padding: 0 3px;
112:     height: 14px;
113:     line-height: 14px;
114:     white-space: nowrap;
115:     background: rgba(0, 0, 0, 0.7);
116:     color: #fff;
117:     pointer-events: none;
118:   }
119: 
120:   .chat-field {
121:     position: absolute;
122:     box-sizing: border-box;
123:     padding: 0 1px;
124:     margin: 0;
125:     background: transparent;
126:     border: none;
127:     outline: none;
128:     color: #fff;
129:     font: inherit;
130:     line-height: 13px;
131:     caret-color: #fff;
132:   }
133: 
134:   .chat-whisper-off {
135:     position: absolute;
136:     background: rgba(128, 51, 51, 0.2);
137:     cursor: pointer;
138:   }
139: 
140:   .chat-prefix-hint {
141:     position: absolute;
142:     pointer-events: none;
143:     color: rgba(255, 255, 255, 0.45);
144:     line-height: 13px;
145:     padding-left: 1px;
146:   }
147: }
148: 
149: // The `/` completion list: white-on-black(180) like the strip tooltip, one
150: // row per command, the selected row brighter. Ours - the original has no
151: // The filter tabs over the framed log: four sprite buttons and a text "All".
152: .chat-filter-tabs {
153:   position: absolute;
154:   pointer-events: auto;
155: }
156: 
157: .chat-filter-all {
158:   position: absolute;
159:   top: 0;
160:   line-height: 26px;
161:   text-align: center;
162:   color: #a0a0a0;
163:   background: rgba(0, 0, 0, 0.6);
164:   cursor: pointer;
165: 
166:   &.active {
167:     color: #fff;
168:   }
169: }
170: 
171: // command help beyond the server's `/help`.
172: .chat-input .chat-completion {
173:   position: absolute;
174:   width: 260px;
175:   padding: 2px 0;
176:   background: rgba(0, 0, 0, 0.75);
177:   border: 1px solid rgba(255, 255, 255, 0.25);
178:   pointer-events: auto;
179:   z-index: 2;
180: 
181:   .chat-completion-row {
182:     display: flex;
183:     gap: 5px;
184:     padding: 0 4px;
185:     height: 14px;
186:     line-height: 14px;
187:     white-space: nowrap;
188:     overflow: hidden;
189:     cursor: pointer;
190:     color: rgb(205, 220, 239);
191: 
192:     &.selected,
193:     &:hover {
194:       background: rgba(255, 255, 255, 0.15);
195:       color: #fff;
196:     }
197:   }
198:   .chat-completion-name {
199:     color: rgb(255, 200, 50);
200:   }
201:   .chat-completion-usage {
202:     color: rgb(150, 200, 255);
203:   }
204:   .chat-completion-help {
205:     flex: 1;
206:     text-align: right;
207:     color: rgba(255, 255, 255, 0.6);
208:     overflow: hidden;
209:     text-overflow: ellipsis;
210:   }
211: }
212: 
213: // The speaker, drawn in front of their line: the guild tag, then the name
214: // tinted by the `HeroState` byte they carried when they spoke
215: // (`SetPlayerColor`, common/nameTags.ts). A commoner is left flat - it is
216: // almost every line, and a log of shimmering names is unreadable - while the
217: // hero and outlaw levels get a sheen sliding along the letters, the same one
218: // the marketplace uses for a foil item.
219: .chat-line-guild {
220:   color: rgb(160, 200, 160);
221: }
222: 
223: .chat-line-name {
224:   // A name is not a sentence: the sheen slides along the letters only.
225:   display: inline-block;
226: }
227: 
228: @keyframes chat-name-sheen {
229:   from {
230:     background-position: 0% 50%;
231:   }
232:   to {
233:     background-position: 200% 50%;
234:   }
235: }
236: 
237: .chat-name-sheen(@from, @to) {
238:   color: transparent;
239:   background: linear-gradient(90deg, @from 0%, @from 35%, @to 50%, @from 65%, @from 100%);
240:   background-size: 220% 100%;
241:   -webkit-background-clip: text;
242:   background-clip: text;
243:   animation: chat-name-sheen 4.5s linear infinite;
244: }
245: 
246: // `PK_TEXT_COLOURS` (common/nameTags.ts), each lifted to a highlight.
247: .chat-line-name.pk-neutral {
248:   color: rgb(200, 220, 255);
249: }
250: .chat-line-name.pk-hero2 {
251:   .chat-name-sheen(rgb(100, 120, 255), rgb(200, 220, 255));
252: }
253: .chat-line-name.pk-hero1 {
254:   .chat-name-sheen(rgb(140, 180, 255), rgb(225, 240, 255));
255: }
256: .chat-line-name.pk-caution {
257:   .chat-name-sheen(rgb(255, 150, 60), rgb(255, 225, 170));
258: }
259: .chat-line-name.pk-murderer1 {
260:   .chat-name-sheen(rgb(255, 80, 30), rgb(255, 190, 140));
261: }
262: .chat-line-name.pk-murderer2 {
263:   .chat-name-sheen(rgb(255, 0, 0), rgb(255, 170, 170));
264: }
265: 
266: // A game master outranks whatever their hero state is: gold, and the sheen
267: // with it, so a staff line is picked out of a busy log at a glance.
268: .chat-line-name.is-gm {
269:   .chat-name-sheen(rgb(250, 200, 50), rgb(255, 250, 215));
270:   font-weight: bold;
271: }
272: 
273: // Names that slide in step read as a single blinking block; stagger them.
274: .chat-line:nth-child(even) .chat-line-name {
275:   animation-delay: -1.5s;
276: }
277: .chat-line:nth-child(3n) .chat-line-name {
278:   animation-delay: -2.8s;
279: }
280: 
281: @media (prefers-reduced-motion: reduce) {
282:   // Same compound selectors the sheen is set on, or this never wins.
283:   .chat-line-name.pk-hero2,
284:   .chat-line-name.pk-hero1,
285:   .chat-line-name.pk-caution,
286:   .chat-line-name.pk-murderer1,
287:   .chat-line-name.pk-murderer2,
288:   .chat-line-name.is-gm {
289:     animation: none;
290:     background-position: 0 50%;
291:   }
292: }
</file>

<file path="src/ui/pages/worldPage/components/emoteMenu/style.less">
  1: @import (reference) '../../../../components/muText/style.less';
  2: // Radial emote menu (E). Centred on screen; the backdrop swallows the click
  3: // so a miss closes the menu instead of walking the character.
