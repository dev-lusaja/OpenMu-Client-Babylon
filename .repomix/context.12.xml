  1: import './style.less';
  2: import { observer } from 'mobx-react-lite';
  3: import { useEffect, useState } from 'react';
  4: import { GameOptions, setGameOption } from '../../../../../common/gameOptions';
  5: import { formatRoundTrip } from '../../../../../common/hudFormat';
  6: import { isKey } from '../../../../../common/keyBindings';
  7: import { NetStats } from '../../../../../common/netStats';
  8: import { Store } from '../../../../../store';
  9: import { useEventBus } from '../../../../../hooks/useEventBus';
 10: import { MuText } from '../../../../components/muText';
 11: import { useUiStageScale } from '../../../../components/uiStage';
 12: import { t } from '../../../../../i18n';
 13: 
 14: /**
 15:  * Frames, frame time and the server round trip, in the top left under the
 16:  * map name banner. No original analog and no window: three lines of HUD text
 17:  * with the usual shadow, the way the coordinates the original prints there
 18:  * are drawn.
 19:  *
 20:  * The engine is polled twice a second into one piece of state, so a running
 21:  * readout is two React renders a second whatever the frame rate is. Off, the
 22:  * component renders nothing and holds no timer.
 23:  */
 24: 
 25: const HOT_KEY = 'performanceReadout';
 26: 
 27: /** Twice a second: fast enough to feel live, far below a frame. */
 28: const SAMPLE_MS = 500;
 29: 
 30: /** 640x480 UI space, clear of the buff row (y 15..48) and the banner. */
 31: const X = 6;
 32: const Y = 54;
 33: const LINE_HEIGHT = 12;
 34: const LABEL_WIDTH = 42;
 35: 
 36: const LABEL_COLOR = 'rgb(127, 178, 255)';
 37: 
 38: type Reading = { fps: number; frameMs: number; roundTripMs: number | null };
 39: 
 40: const EMPTY: Reading = { fps: 0, frameMs: 0, roundTripMs: null };
 41: 
 42: function read(): Reading {
 43:   const engine = Store.world?.scene.getEngine();
 44:   if (!engine) return { ...EMPTY, roundTripMs: NetStats.roundTripMs };
 45: 
 46:   return {
 47:     fps: engine.getFps(),
 48:     frameMs: engine.getDeltaTime(),
 49:     roundTripMs: NetStats.roundTripMs,
 50:   };
 51: }
 52: 
 53: const Line = observer(({ label, value, index }: { label: string; value: string; index: number }) => (
 54:   <>
 55:     <MuText
 56:       className="perf-label"
 57:       color={LABEL_COLOR}
 58:       style={{ left: 0, top: index * LINE_HEIGHT }}
 59:       text={label}
 60:     />
 61:     <MuText
 62:       className="perf-value"
 63:       style={{ left: LABEL_WIDTH, top: index * LINE_HEIGHT }}
 64:       text={value}
 65:     />
 66:   </>
 67: ));
 68: 
 69: export const PerfReadout = observer(() => {
 70:   const on = GameOptions.performanceReadout;
 71:   const scale = useUiStageScale();
 72:   const [reading, setReading] = useState<Reading>(EMPTY);
 73: 
 74:   useEventBus('keyPressed', key => {
 75:     if (!Store.world?.playerEntity) return;
 76:     if (isKey(HOT_KEY, key)) {
 77:       setGameOption('performanceReadout', !GameOptions.performanceReadout);
 78:     }
 79:   });
 80: 
 81:   useEffect(() => {
 82:     if (!on) return;
 83:     setReading(read());
 84:     const id = setInterval(() => setReading(read()), SAMPLE_MS);
 85:     return () => clearInterval(id);
 86:   }, [on]);
 87: 
 88:   if (!on) return null;
 89: 
 90:   return (
 91:     <div
 92:       className="perf-readout"
 93:       style={{ left: X * scale, top: Y * scale, transform: `scale(${scale})` }}
 94:     >
 95:       <Line label={t('perf.fps')} value={reading.fps.toFixed(0)} index={0} />
 96:       <Line label={t('perf.frame')} value={`${reading.frameMs.toFixed(1)} ms`} index={1} />
 97:       <Line label={t('perf.ping')} value={formatRoundTrip(reading.roundTripMs)} index={2} />
 98:     </div>
 99:   );
100: });
</file>

