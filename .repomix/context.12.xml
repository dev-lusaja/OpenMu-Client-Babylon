233: /**
234:  * How far the view has been dragged off the hero (ours: the original pins
235:  * the hero to the centre), in tiles along the picture's U (tile Y) and V
236:  * (tile X). Tiles rather than pixels, so a zoom step keeps the same tile
237:  * under the centre.
238:  */
239: export type MapPan = { u: number; v: number };
240: 
241: export const NO_PAN: MapPan = { u: 0, v: 0 };
242: 
243: export const isPanned = (pan: MapPan): boolean => pan.u !== 0 || pan.v !== 0;
244: 
245: /**
246:  * A pointer moved `sx, sy` screen pixels with the picture in hand: undo the
247:  * view's CSS scale, then the 45° spin, and the tile under the fixed centre
248:  * went the other way.
249:  */
250: export function dragToPan(sx: number, sy: number, mapSize: number, scale: number): MapPan {
251:   const rad = (MAP_ROTATION * Math.PI) / 180;
252:   const px = sx / scale;
253:   const py = sy / scale;
254:   const mu = px * Math.cos(rad) + py * Math.sin(rad);
255:   const mv = -px * Math.sin(rad) + py * Math.cos(rad);
256:   return {
257:     u: (-mu / mapSize) * TERRAIN_SIZE,
258:     v: (-mv / mapSize) * TERRAIN_SIZE,
259:   };
260: }
261: 
262: /**
263:  * Click and drag on the map picture. The pointer is captured on the element
264:  * the handlers go on, so a drag that leaves it (or the window) keeps
265:  * following until the button comes up.
266:  */
267: export function useMapDrag(
268:   mapSize: number,
269:   scale: number,
270:   setPan: React.Dispatch<React.SetStateAction<MapPan>>
271: ): {
272:   dragging: boolean;
273:   handlers: Pick<
274:     React.DOMAttributes<HTMLDivElement>,
275:     'onPointerDown' | 'onPointerMove' | 'onPointerUp' | 'onPointerCancel'
276:   >;
277: } {
278:   const [dragging, setDragging] = useState(false);
279:   const held = useRef<{ id: number; x: number; y: number } | null>(null);
280: 
281:   const end = (e: React.PointerEvent<HTMLDivElement>) => {
282:     if (held.current?.id !== e.pointerId) return;
283:     held.current = null;
284:     setDragging(false);
285:   };
286: 
287:   return {
288:     dragging,
289:     handlers: {
290:       onPointerDown: e => {
291:         if (e.button !== 0) return;
292:         e.currentTarget.setPointerCapture(e.pointerId);
293:         held.current = { id: e.pointerId, x: e.clientX, y: e.clientY };
294:         setDragging(true);
295:       },
296:       onPointerMove: e => {
297:         const h = held.current;
298:         if (!h || h.id !== e.pointerId) return;
299:         const d = dragToPan(e.clientX - h.x, e.clientY - h.y, mapSize, scale);
300:         h.x = e.clientX;
301:         h.y = e.clientY;
302:         setPan(p => ({ u: p.u + d.u, v: p.v + d.v }));
303:       },
304:       onPointerUp: end,
305:       onPointerCancel: end,
306:     },
307:   };
308: }
309: 
