 88:         stroke-width: 1.5;
 89:       }
 90: 
 91:       text {
 92:         fill: #ffffff;
 93:       }
 94:     }
 95:   }
 96: 
 97:   .emote-hub {
 98:     cursor: pointer;
 99: 
100:     circle {
101:       fill: rgba(12, 10, 8, 0.9);
102:       stroke: rgba(232, 200, 119, 0.7);
103:       stroke-width: 1.5;
104:     }
105: 
106:     .hub-label {
107:       fill: #e8c877;
108:       font-size: 13px;
109:       font-weight: bold;
110:       letter-spacing: 1px;
