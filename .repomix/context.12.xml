256:   const index = legacyQuestCurrentIndex();
257:   const quest = questDefinition(index);
258:   const state = legacyQuestState(index);
259:   const lines = legacyQuestLines();
260:   const answers = legacyQuestAnswers();
261:   const needZen = legacyQuestNeedZen();
262:   const inProgress = state === LegacyQuestState.InProgress;
263:   const column = getBaseClass(Store.playerData.charClass);
264: 
265:   const total = lines.length + answers.length;
266:   const textTop = NPC_TEXT_TOP + Math.floor(((NPC_LINES_MAX - total) * NPC_LINE_STEP) / 2);
267:   const answersTop = inProgress ? NPC_ANSWERS_ING_Y : textTop + lines.length * NPC_LINE_STEP;
