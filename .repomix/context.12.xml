696: /**
697:  * `CGuildBreakPasswordMsgBoxLayout` (NewUICustomMessageBox.cpp:7110): the
698:  * account's security code, asked before every guild kick - GlobalText 427 and
699:  * 428 over a masked input, OK / Cancel. OpenMU checks it against
700:  * `Account.SecurityCode`; without it the server only answers "Wrong Security
701:  * Code.".
702:  */
703: export const GuildKickPasswordDialog = observer(() => {
704:   const target = Social.guildKickPrompt;
705:   const [code, setCode] = useState('');
706: 
707:   useEffect(() => {
708:     if (target) setCode('');
709:   }, [target]);
710: 
711:   if (!target) return null;
712: 
713:   const send = () => {
714:     Social.confirmGuildKick(code);
715:     playUiSound('click');
716:   };
717: 
718:   return (
719:     <div className="guild-dialog-layer">
720:       <div className="guild-create guild-password">
721:         <div className="guild-create-title">
722:           {target.self ? t('guild.leaveTitle') : t('guild.kick', { name: target.name })}
723:         </div>
724:         <div className="guild-password-text">
725:           {target.self ? t('guild.breakHint') : t('guild.kickHint', { name: target.name })}
726:           <br />
727:           {t('guild.enterSecurityCode')}
728:         </div>
729:         <label className="guild-create-name">
730:           {t('guild.securityCode')}
731:           <input
732:             autoFocus
733:             type="password"
734:             maxLength={GUILD_SECURITY_CODE_MAX}
735:             value={code}
736:             spellCheck={false}
737:             onChange={e => setCode(e.target.value)}
738:             onKeyDown={e => {
739:               if (e.key === 'Enter') send();
740:               else if (e.key === 'Escape') Social.cancelGuildKick();
741:             }}
742:           />
743:         </label>
744:         <div className="guild-create-buttons">
745:           <button type="button" onClick={uiClick(send)}>
746:             {t('common.ok')}
747:           </button>
748:           <button type="button" onClick={uiClick(() => Social.cancelGuildKick())}>
749:             {t('common.cancel')}
750:           </button>
751:         </div>
752:       </div>
753:     </div>
