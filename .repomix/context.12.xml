 382: const Deliveries = observer(({ onOpenRoll }: { onOpenRoll: () => void }) => {
 383:   const { orders, ordersError, account, unconfirmed, buyError, unopened } = CashShopState;
 384:   const shown = orders.filter(order => order.state !== 'cancelled');
