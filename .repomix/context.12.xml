138: function buildWedges(): Wedge[] {
139:   const wedges: Wedge[] = [];
140:   let index = 0;
141:   let inner = HUB_RADIUS + RING_GAP;
142: 
143:   RINGS.forEach((count, ring) => {
144:     const outer = inner + RING_DEPTH[ring];
145:     const step = 360 / count;
146:     const mid = (inner + outer) / 2;
