 729:   const selectedEntry = selectedId ? (placed.find(entry => entry.product.id === selectedId) ?? null) : null;
 730: 
 731:   // The window opens to sell, not to the queue; and a prompt left up when
 732:   // the window closed under it would be asking a question nobody sees.
