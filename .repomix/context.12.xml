192: /**
193:  * The frame around a `width` x `height` map: the line strip along each edge
194:  * (the sides are the top strip turned 90 degrees, `RenderBitmapRotate`) and
195:  * the corner piece mirrored into each corner.
196:  */
197: export const Frame = ({ width, height }: { width: number; height: number }) => {
198:   const line = useMuSprite(LINE_SPRITE);
199:   const corner = useMuSprite(CORNER_SPRITE);
200:   const lineStyle: CSSProperties = {
201:     backgroundImage: line ? `url(${line.url})` : undefined,
202:     backgroundSize: `${EDGE_WIDTH}px ${EDGE_HEIGHT}px`,
203:   };
204:   const cornerStyle: CSSProperties = {
205:     backgroundImage: corner ? `url(${corner.url})` : undefined,
206:   };
207: 
208:   return (
209:     <>
210:       <div className="minimap-edge minimap-edge-top" style={lineStyle} />
211:       <div className="minimap-edge minimap-edge-bottom" style={lineStyle} />
212:       <div
213:         className="minimap-edge minimap-edge-side"
214:         style={{
215:           ...lineStyle,
216:           width: height,
217:           left: 0,
218:           transform: `rotate(90deg) translateY(-${EDGE_HEIGHT}px)`,
219:         }}
220:       />
221:       <div
222:         className="minimap-edge minimap-edge-side"
223:         style={{ ...lineStyle, width: height, left: width, transform: 'rotate(90deg)' }}
224:       />
225:       <div className="minimap-corner minimap-corner-tl" style={cornerStyle} />
226:       <div className="minimap-corner minimap-corner-tr" style={cornerStyle} />
227:       <div className="minimap-corner minimap-corner-bl" style={cornerStyle} />
228:       <div className="minimap-corner minimap-corner-br" style={cornerStyle} />
229:     </>
