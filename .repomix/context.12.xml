257: export const Inventory = observer(() => {
258:   const playerData = Store.playerData;
259:   const gridRef = useRef<HTMLDivElement>(null);
260: 
261:   const [target, setTarget] = useState<{ column: number; row: number } | null>(null);
262:   const [hover, setHover] = useState<HoverInfo | null>(null);
263: 
264:   const picked = Store.pickedItem;
265:   const pickedSize = picked ? itemSize(picked.item) : null;
266: 
267:   const stamp = occupancyStamp(playerData.items, FIRST_SLOT, SQUARES);
268:   const { squares, placed } = useMemo(
269:     () => buildOccupancy(playerData.items),
270:     // `stamp` stands in for the item contents.
271:     // eslint-disable-next-line react-hooks/exhaustive-deps
272:     [playerData.items, stamp]
273:   );
274:   const used = useMemo(() => usedMask(squares), [squares]);
275:   // The handlers read the latest occupancy without being recreated.
276:   const latest = useRef({ squares, pickedSize });
277:   latest.current = { squares, pickedSize };
278: 
279:   useEventBus('keyPressed', key => {
280:     if (
281:       isKey('inventory', key) ||
282:       (key === ALT_HOT_KEY && !actionOfKey(key))
283:     ) {
284:       Store.inventoryEnabled = !Store.inventoryEnabled;
285:     }
286: 
287:     // The grid packs itself top-left, kind by kind; a second press stops a
288:     // run that is still going.
289:     if (isKey('sortInventory', key) && Store.inventoryEnabled) {
290:       InventorySort.start();
291:     }
292: 
293:     // NewUIMyInventory.cpp:578: L toggles self-repair (level 50+), only
294:     // while no shop is open.
295:     if (isKey('repair', key) && Store.inventoryEnabled && !Store.npcShop) {
296:       Store.toggleRepairMode();
297:     }
298: 
299:     // NewUIMyInventory.cpp:622: Ctrl+Q/W/E/R over a potion binds that bar slot.
300:     const bind = ITEM_HOT_KEYS.indexOf(key);
301:     if (bind >= 0 && Store.inventoryEnabled && hover) {
302:       const keys = Store.world?.keyboardInput.pressedKeys;
303:       const ctrl = !!keys && (keys.has('ControlLeft') || keys.has('ControlRight'));
304:       if (ctrl && canRegisterItemHotkey(hover.item)) {
305:         Store.setItemHotkey(bind, hover.item);
306:       }
307:     }
308:   });
309: 
310:   useEffect(() => {
311:     if (!picked) {
312:       setTarget(null);
313:       return;
314:     }
315: 
316:     const onMove = (event: PointerEvent) => {
317:       const size = latest.current.pickedSize;
318:       const grid = gridRef.current;
319:       if (!size || !grid) return;
320:       const rect = grid.getBoundingClientRect();
321:       const scale = rect.width / (COLUMNS * SQUARE);
322:       let next: { column: number; row: number } | null = null;
323:       if (
324:         scale &&
325:         event.clientX >= rect.left &&
326:         event.clientX < rect.right &&
327:         event.clientY >= rect.top &&
328:         event.clientY < rect.bottom
329:       ) {
330:         next = targetSquareAt(
331:           (event.clientX - rect.left) / scale,
332:           (event.clientY - rect.top) / scale,
333:           size.w,
334:           size.h
335:         );
336:       }
337:       setTarget(current =>
338:         current === next ||
339:         (current && next && current.column === next.column && current.row === next.row)
340:           ? current
341:           : next
342:       );
343:     };
344: 
345:     window.addEventListener('pointermove', onMove, { passive: true });
346:     return () => window.removeEventListener('pointermove', onMove);
347:   }, [!!picked]);
348: 
349:   if (!Store.inventoryEnabled) {
350:     return null;
351:   }
352: 
353: 
354:   const gridPoint = (clientX: number, clientY: number) => {
355:     const rect = gridRef.current?.getBoundingClientRect();
356:     if (!rect) return null;
357: 
358:     const scale = rect.width / (COLUMNS * SQUARE);
359:     if (!scale) return null;
360: 
361:     return {
362:       rect,
363:       x: (clientX - rect.left) / scale,
364:       y: (clientY - rect.top) / scale,
365:     };
366:   };
367: 
368:   const targetFor = (clientX: number, clientY: number) => {
369:     if (!pickedSize) return null;
370: 
371:     const point = gridPoint(clientX, clientY);
372:     if (!point) return null;
373: 
374:     const { rect } = point;
375: 
376:     if (
377:       clientX < rect.left ||
378:       clientX >= rect.right ||
379:       clientY < rect.top ||
380:       clientY >= rect.bottom
381:     ) {
382:       return null;
383:     }
384: 
385:     return targetSquareAt(point.x, point.y, pickedSize.w, pickedSize.h);
386:   };
387: 
388:   const targetOk =
389:     !!target &&
390:     !!pickedSize &&
