 38: 
 39: const SkillRow = observer(({ number, level }: { number: number; level: number }) => {
 40:   const def = skillDefinition(number);
 41:   const usable = skills.requirementsMet(number);
 42:   const selected = Store.currentSkill === number;
 43:   const cost = def ? (def.ag > 0 ? `AG ${def.ag}` : def.mana > 0 ? `MP ${def.mana}` : '') : '';
 44:   const masterLevel = skills.masterSkillLevel(number);
 45: 
 46:   return (
 47:     <div
 48:       className={`skill-row${selected ? ' skill-row-selected' : ''}${usable ? '' : ' skill-row-blocked'}`}
 49:       style={{ height: ROW_HEIGHT }}
 50:       onClick={() => {
 51:         Store.selectSkill(number);
 52:         playUiSound('click');
 53:       }}
 54:     >
 55:       <div className="skill-row-icon" style={{ width: SKILL_ICON_WIDTH, height: SKILL_ICON_HEIGHT }}>
 56:         <SkillIcon number={number} disabled={!usable} />
 57:       </div>
 58:       <div className="skill-row-text">
 59:         <div className="skill-row-name">
 60:           {def?.name ?? t('skills.unnamed', { number })}
 61:         </div>
 62:         <div className="skill-row-meta">
 63:           {masterLevel > 0
 64:             ? t('skills.masterLevelShort', { level: masterLevel })
 65:             : level > 0
 66:               ? t('skills.levelShort', { level })
 67:               : ''}
 68:           {cost ? (masterLevel > 0 || level > 0 ? ` · ${cost}` : cost) : ''}
 69:         </div>
 70:       </div>
 71:     </div>
 72:   );
 73: });
 74: 
 75: export const SkillListWindow = observer(() => {
 76:   const toggle = () =>
 77:     runInAction(() => {
 78:       Store.skillListEnabled = !Store.skillListEnabled;
 79:     });
 80: 
 81:   useEventBus('keyPressed', key => {
 82:     if (isKey(HOT_KEY, key) && Store.world?.playerEntity) {
 83:       toggle();
 84:       playUiSound('click');
 85:     }
 86:   });
 87: 
 88:   if (!Store.skillListEnabled) return null;
 89: 
 90:   const column = 1 + (Store.inventoryEnabled ? 1 : 0) + (Store.characterInfoEnabled ? 1 : 0);
