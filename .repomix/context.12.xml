416:       }
417: 
418:       const at = targetFor(event.clientX, event.clientY);
419:       if (!at) return;
420: 
421:       if (at.column < 0 || at.row < 0) return;
422: 
423:       const toSlot = slotOf(at.column, at.row);
424: 
425:       if (toSlot === picked.fromSlot) {
426:         Store.cancelPickedItem();
427:         return;
428:       }
429: 
430:       if (canPlace(squares, at.column, at.row, pickedSize.w, pickedSize.h)) {
431:         Store.placePickedItem(toSlot);
432:       }
433:       return;
434:     }
435: 
436:     const square = squareAt(event.clientX, event.clientY);
437:     if (square < 0) return;
438: 
439:     const entry = squares[square];
440:     if (!entry) return;
441: 
442:     // REPAIR_MODE_ON (NewUIMyInventory.cpp:1520): the click repairs instead.
443:     if (Store.repairMode) {
444:       Store.repairItemRequest(entry.slot);
445:       return;
446:     }
447: 
448:     if (event.ctrlKey) {
449:       QuickItemActions.fromInventory(entry.slot);
450:       return;
451:     }
452: 
453:     Store.pickInventoryItem(entry.slot);
454:   };
455: 
456:   const onGridContextMenu = (event: React.MouseEvent) => {
457:     event.preventDefault();
