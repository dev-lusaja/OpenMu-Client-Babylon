 52: /**
 53:  * The decoded map of `map`: `undefined` while it loads, `null` for a world
 54:  * without `mini_map.ozt` (`m_bSuccess == false`).
 55:  */
 56: export function useWorldMinimap(map: number | undefined): WorldMinimap | null | undefined {
 57:   // Keyed by map, so a warp reads as "loading" until its own map arrives.
 58:   const [loaded, setLoaded] = useState<{
 59:     map: number;
 60:     minimap: WorldMinimap | null;
 61:   } | null>(null);
 62: 
 63:   useEffect(() => {
 64:     if (map === undefined) return;
 65: 
 66:     let cancelled = false;
 67: 
 68:     loadWorldMinimap(map).then(
 69:       minimap => {
 70:         if (!cancelled) setLoaded({ map, minimap });
 71:       },
 72:       err => {
 73:         console.error(`Could not load the minimap of world ${map}:`, err);
 74:         if (!cancelled) setLoaded({ map, minimap: null });
 75:       }
 76:     );
 77: 
 78:     return () => {
 79:       cancelled = true;
 80:     };
 81:   }, [map]);
 82: 
 83:   return loaded && loaded.map === map ? loaded.minimap : undefined;
 84: }
 85: 
 86: /**
 87:  * Party members on this map (ours: `mini_map_ui_party.tga` ships but the
 88:  * original never draws it). A member in scope is followed live through the
 89:  * entity; otherwise the last `PartyList` position is used. They are
 90:  * `MinimapMarker`s so the hover tip and placement code are shared.
 91:  */
 92: const NO_MARKERS: MinimapMarker[] = [];
 93: 
 94: export function usePartyMarkers(active: boolean, map: number | undefined): MinimapMarker[] {
 95:   const [markers, setMarkers] = useState<MinimapMarker[]>(NO_MARKERS);
 96: 
 97:   useEffect(() => {
 98:     if (!active || map === undefined) return;
 99: 
100:     const sample = () => {
101:       const world = Store.world;
102:       const heroName = Store.playerData.name;
103:       if (!world) return;
104: 
105:       const next: MinimapMarker[] = [];
106:       for (const member of Social.partyMembers) {
107:         if (member.name === heroName || member.mapId !== map) continue;
108: 
109:         let x = member.x;
110:         let y = member.y;
111:         for (const e of world.playersQuery.entities) {
112:           if (e.localPlayer || e.objectNameInWorld !== member.name) continue;
113:           x = e.transform.pos.x;
114:           y = e.transform.pos.z;
115:           break;
116:         }
117:         next.push({ kind: PARTY_KIND, x, y, rotation: 0, name: member.name });
118:       }
119: 
120:       setMarkers(prev =>
121:         prev.length === next.length &&
122:         prev.every((m, i) => m.x === next[i].x && m.y === next[i].y && m.name === next[i].name)
123:           ? prev
124:           : next
125:       );
126:     };
127: 
128:     const id = setInterval(sample, 250);
129:     return () => clearInterval(id);
130:   }, [active, map]);
131: 
132:   return active && map !== undefined ? markers : NO_MARKERS;
133: }
134: 
135: /** The hero's tile position, refreshed every frame while `active`. */
136: export function useHeroTile(active: boolean): MapPoint {
137:   const [tile, setTile] = useState<MapPoint>({ x: 0, y: 0 });
138: 
139:   useEffect(() => {
140:     if (!active) return;
141: 
142:     let frame = 0;
143:     let last = { x: NaN, y: NaN };
144: 
145:     const tick = () => {
146:       const pos = Store.world?.playerEntity?.transform?.pos;
147:       if (pos) {
148:         const next = { x: pos.x, y: pos.z };
149:         if (next.x !== last.x || next.y !== last.y) {
150:           last = next;
151:           setTile(next);
152:         }
153:       }
154:       frame = requestAnimationFrame(tick);
155:     };
156: 
157:     frame = requestAnimationFrame(tick);
158:     return () => cancelAnimationFrame(frame);
159:   }, [active]);
160: 
161:   return tile;
162: }
