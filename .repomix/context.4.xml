112: const BUCKLER: Item = { group: GROUP_SHIELD, num: 4 };
113: const GREAT_SCYTHE: Item = { group: GROUP_SPEAR, num: 8 };
114: const BILL_OF_BALROG: Item = { group: GROUP_SPEAR, num: 9 };
115: const ELVEN_BOW: Item = { group: GROUP_BOW, num: 2 };
116: const TOMAHAWK: Item = { group: GROUP_AXE, num: 3 };
117: const SKULL_SHIELD: Item = { group: GROUP_SHIELD, num: 6 };
