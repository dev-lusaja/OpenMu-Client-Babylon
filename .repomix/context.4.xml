<file path="src/common/band/receiver.ts">
  1: import type { BatchEvent } from './sequencer';
  2: 
  3: /**
  4:  * One remote performer's stream, turned back into notes on this client's
  5:  * audio clock. The first batch fixes the offset between the performer's
  6:  * `baseMs` and local audio time, with `delaySec` of slack so the next batch
  7:  * is already scheduled when it lands (SS14: 0.2 s + sqrt(ping)). A batch
  8:  * that arrives late anyway moves the offset and plays on the new timeline
  9:  * (nothing is dropped: a skipped note-off would hang a flute); a gap in the
 10:  * sequence numbers silences everything for the same reason; and a stream
 11:  * that goes quiet is silenced too, which covers a proxy restart with no stop
 12:  * frame.
 13:  *
 14:  * Pure: clock and sink injected.
 15:  */
 16: 
 17: export type ReceiverClock = { now(): number };
 18: 
 19: export type ReceiverSink = {
 20:   /** A note at audio time `when`. */
 21:   schedule(ev: BatchEvent, when: number): void;
 22:   /** Every voice of this performer off, now. */
 23:   allOff(): void;
 24: };
 25: 
 26: export type ReceiverOptions = {
 27:   /** Seconds of slack behind the performer. */
 28:   delaySec?: number;
 29:   /** A batch this late re-fixes the offset. */
 30:   resyncSec?: number;
 31:   /** Seconds without a batch before the voice is silenced. */
 32:   quietSec?: number;
 33: };
 34: 
 35: const RESYNC_SEC = 0.05;
 36: const QUIET_SEC = 3;
 37: 
 38: /** SS14's receiver delay: 0.2 s plus the square root of the ping in seconds, kept sane. */
 39: export function receiverDelay(roundTripMs: number | null): number {
 40:   const rtt = (roundTripMs ?? 150) / 1000;
 41:   return Math.max(0.3, Math.min(1.0, 0.2 + Math.sqrt(rtt)));
 42: }
 43: 
 44: export class Receiver {
 45:   private offset: number | null = null;
 46:   private lastSeq: number | null = null;
 47:   private lastBatchAt = 0;
 48:   private resyncs = 0;
 49:   private readonly delaySec: number;
 50:   private readonly resyncSec: number;
 51:   private readonly quietSec: number;
 52: 
 53:   constructor(
 54:     private readonly clock: ReceiverClock,
 55:     private readonly sink: ReceiverSink,
 56:     options: ReceiverOptions = {}
 57:   ) {
 58:     this.delaySec = options.delaySec ?? receiverDelay(null);
 59:     this.resyncSec = options.resyncSec ?? RESYNC_SEC;
 60:     this.quietSec = options.quietSec ?? QUIET_SEC;
 61:   }
 62: 
 63:   /** How many times the stream arrived late enough to move the offset (debug). */
 64:   get resyncCount(): number {
 65:     return this.resyncs;
 66:   }
 67: 
 68:   onBatch(seq: number, baseMs: number, events: BatchEvent[]): void {
 69:     const now = this.clock.now();
 70:     this.lastBatchAt = now;
 71: 
 72:     if (this.lastSeq !== null && ((this.lastSeq + 1) & 0xffff) !== seq) {
 73:       // Something was lost in between; whatever was sounding may never get its off.
 74:       this.sink.allOff();
 75:     }
 76:     this.lastSeq = seq;
 77: 
 78:     if (this.offset === null) {
 79:       this.offset = now + this.delaySec - baseMs / 1000;
 80:     } else {
 81:       const firstAt = this.offset + baseMs / 1000;
 82:       const late = now - firstAt;
 83:       if (late > this.resyncSec) {
 84:         this.offset += late + this.resyncSec;
 85:         this.resyncs++;
 86:       }
 87:     }
 88: 
 89:     for (const ev of events) {
 90:       const when = this.offset + (baseMs + ev.dt) / 1000;
 91:       this.sink.schedule(ev, Math.max(when, now));
 92:     }
 93:   }
 94: 
 95:   /** Call once a frame or so: silences a stream that stopped arriving. */
 96:   tick(): void {
 97:     if (this.lastBatchAt > 0 && this.clock.now() - this.lastBatchAt > this.quietSec) {
 98:       this.lastBatchAt = 0;
 99:       this.offset = null;
100:       this.sink.allOff();
101:     }
102:   }
103: 
104:   stop(): void {
105:     this.offset = null;
106:     this.lastSeq = null;
107:     this.lastBatchAt = 0;
108:     this.sink.allOff();
109:   }
110: }
</file>

