377: // ---- 4. bands: the hero's side --------------------------------------------
378: 
379: /** Join another performer's band with the instrument in hand, doubling the channels in `channelMask`. */
380: export function joinBand(masterId: number, channelMask = ALL_CHANNELS): void {
381:   const instrument = Band.instrument;
382:   if (!instrument || Band.phase === 'playing' || Band.phase === 'paused') return;
383:   transport.join(masterId, instrumentIndex(instrument), channelMask);
384:   membership = { masterId, instrument, channelMask };
385:   runInAction(() => {
386:     Band.role = 'member';
387:     Band.band = { masterId, members: [{ netId: Store.playerId ?? 0, instrument, channelMask }] };
388:   });
389:   refreshLocalMask();
390: }
391: 
392: export function leaveBand(): void {
393:   if (Band.role === 'member') transport.leave();
394:   membership = null;
395:   runInAction(() => {
396:     Band.role = 'solo';
397:     Band.band = null;
398:   });
399:   refreshLocalMask();
400: }
401: 
402: /** A member joined or left the hero's band (from the wire); the hero becomes / stays the master. */
403: export function memberChanged(member: BandMember | null, netId: number): void {
404:   const me = Store.playerId ?? 0;
405:   const current = Band.band ?? { masterId: me, members: [] };
406:   const next = member ? withMember(current, member) : withoutMember(current, netId);
407:   runInAction(() => {
408:     Band.band = next.members.length ? next : null;
409:     Band.role = next.members.length ? 'master' : 'solo';
410:   });
411:   refreshLocalMask();
412:   transport.state(masterMask(next), next.members);
413: }
414: 
415: /** The band state pushed by a master the hero follows. */
416: export function masterStateChanged(masterId: number, members: BandMember[]): void {
417:   if (Band.role !== 'member' || Band.band?.masterId !== masterId) return;
418:   runInAction(() => {
419:     Band.band = { masterId, members };
420:   });
421:   refreshLocalMask();
422: }
