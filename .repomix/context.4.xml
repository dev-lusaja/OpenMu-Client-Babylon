<file path="src/common/hudFormat.ts">
 1: /**
 2:  * How the HUD prints its numbers. Pure functions with no store behind them,
 3:  * so the session panel, the experience tooltip and the performance readout
 4:  * all spell the same figure the same way.
 5:  */
 6: 
 7: /** A span as the session panel prints it: `2:10:04`, or `10:04` under an hour. */
 8: export function formatDuration(ms: number): string {
 9:   const total = Math.floor(Math.max(0, ms) / 1000);
10:   const hours = Math.floor(total / 3600);
11:   const minutes = Math.floor((total % 3600) / 60);
12:   const seconds = total % 60;
13:   const pad = (v: number) => String(v).padStart(2, '0');
14: 
15:   return hours > 0
16:     ? `${hours}:${pad(minutes)}:${pad(seconds)}`
17:     : `${pad(minutes)}:${pad(seconds)}`;
18: }
19: 
20: /** `0.374231` -> `37.42 %`. */
21: export function formatExpPercent(fraction: number): string {
22:   const clamped = Math.max(0, Math.min(1, fraction));
23:   return `${(clamped * 100).toFixed(2)} %`;
24: }
25: 
26: /** `1234567 / 3300000` -> `1,234,567 / 3,300,000`. */
27: export function formatExpProgress(exp: number, next: number): string {
28:   // Fixed grouping, not the machine locale: the panel beside it groups the
29:   // same way, and a test must not read differently on a Spanish box.
30:   const group = (value: number) =>
31:     Math.max(0, Math.floor(value)).toLocaleString('en-US');
32: 
33:   return `${group(exp)} / ${group(next)}`;
34: }
35: 
36: /** The time to the next level, or a dash while no rate is known yet. */
37: export function formatTimeToLevel(ms: number | null): string {
38:   return ms === null ? '-' : formatDuration(ms);
39: }
40: 
41: /** The round trip in whole milliseconds, or a dash before the first sample. */
42: export function formatRoundTrip(ms: number | null): string {
43:   return ms === null ? '-' : `${Math.round(ms)} ms`;
44: }
</file>

