 92: export const Band = observable(
 93:   {
 94:     phase: 'idle' as BandPhase,
 95:     instrument: null as InstrumentId | null,
 96:     fileName: '',
 97:     song: null as ParsedMidi | null,
 98:     positionMs: 0,
 99:     loop: false,
100:     role: 'solo' as BandRole,
101:     band: null as BandState | null,
102:     bankLoading: false,
103:     /** The last thing that went wrong, shown in the window until the next action. */
104:     error: null as TextKey | null,
105:     windowOpen: false,
106:     /** Whether the proxy relays band frames on this connection. */
107:     available: false,
108:   },
109:   { song: observable.ref, band: observable.ref }
110: );
