491:   compareTooltips: 2,
492:   eventTimers: true,
493:   questTracker: true,
494:   englishItemNames: false,
495: };
496: 
497: /**
498:  * Keys the structured look retired. The grade they drove (darkness, contrast,
499:  * split-tone tint, saturation, the map gradient) no longer exists; the two
500:  * that survive in another shape are mapped in `migrate`.
501:  */
502: const DROPPED_KEYS = [
503:   'darkness',
504:   'sceneDarkening',
505:   'contrast',
506:   'colorTint',
507:   'saturation',
508:   'mapGradient',
509:   'toneMapping',
510:   'exposure',
511: ] as const;
512: 
513: type Listener = (options: GameOptions) => void;
514: 
515: const listeners = new Set<Listener>();
516: 
517: /**
518:  * One-time schema migration of a stored options blob; true when it changed.
519:  * Stored tiers are kept as they are: a returning player's Classic stays
520:  * Classic, the new default reaches fresh installs only.
521:  */
522: export function migrate(stored: Record<string, unknown>): boolean {
523:   const present = DROPPED_KEYS.filter(key => key in stored);
524: 
525:   if (present.length === 0) return false;
526: 
527:   if ('toneMapping' in stored && !('toneMapper' in stored)) {
528:     stored.toneMapper = stored.toneMapping ? 1 : 0;
529:   }
530: 
531:   if ('exposure' in stored && !('brightness' in stored)) {
532:     stored.brightness = 0;
533:   }
534: 
535:   // The vignette was 0..25 with a default of 13 nobody chose; it is 0..9
536:   // now, opt-in (§6). The old default resets, a chosen value is rescaled.
537:   const vignette = stored.vignette;
538:   let vignetteNote = '';
539: 
540:   if (typeof vignette === 'number') {
541:     stored.vignette = vignette === 13 ? 0 : Math.round((vignette * 9) / 25);
542:     vignetteNote = `, vignette ${vignette}/25 -> ${stored.vignette}/9`;
543:   }
544: 
545:   for (const key of present) delete stored[key];
546: 
547:   console.info(`[options] retired keys removed: ${present.join(', ')}${vignetteNote}`);
548: 
549:   return true;
550: }
551: 
552: function load(): GameOptions {
553:   const stored = LocalStorage.load(OPTIONS_KEY);
554: 
555:   if (!stored) return { ...DEFAULTS };
556: 
557:   try {
558:     const parsed = JSON.parse(stored) as Record<string, unknown>;
559:     const migrated = migrate(parsed);
560: 
561:     const loaded = {
562:       ...DEFAULTS,
563:       ...(parsed as Partial<GameOptions>),
564:     };
565: 
566:     for (const [key, [min, max]] of Object.entries(RANGES)) {
567:       const value = loaded[key as keyof GameOptions];
568: 
569:       if (typeof value === 'number') {
570:         (loaded as Record<string, unknown>)[key] = Math.max(
571:           min,
572:           Math.min(max, value)
573:         );
574:       }
575:     }
576: 
577:     if (migrated) LocalStorage.save(OPTIONS_KEY, JSON.stringify(loaded));
578: 
579:     return loaded;
580:   } catch {
581:     return { ...DEFAULTS };
582:   }
583: }
584: 
585: /**
586:  * The live options. Observable (every field a MobX observable) so the
587:  * Options window and any observer that reads a field re-render on change -
588:  * the window used to force itself with a counter bump. Reads outside a
589:  * reaction (the per-frame material / lighting checks) cost a getter call.
590:  */
591: export const GameOptions: GameOptions = makeAutoObservable(load());
592: 
593: export function setGameOption<K extends keyof GameOptions>(
594:   key: K,
595:   value: GameOptions[K]
596: ): void {
597:   if (GameOptions[key] === value) return;
598: 
599:   runInAction(() => {
600:     GameOptions[key] = value;
601:   });
602: 
603:   LocalStorage.save(OPTIONS_KEY, JSON.stringify(GameOptions));
604: 
605:   for (const listener of listeners) listener(GameOptions);
606: }
607: 
608: export function onGameOptionsChanged(listener: Listener): () => void {
609:   listeners.add(listener);
610:   return () => listeners.delete(listener);
611: }
