 2: import { delay, effects } from '../effects';
 3: import type { ParticleRecipe, RGB } from '../effects/core';
 4: import { BOMB_SPARKS, TEX } from '../effects/recipes';
 5: import { playSfx } from '../libs/sfx';
 6: 
 7: /**
 8:  * `ReceiveServerCommand` case 0 and the christmas variant (WSclient.cpp:7744,
 9:  * ZzzEffect.cpp BITMAP_FIRECRACKER0001/0002): spark bursts staggered over the
10:  * tile. The christmas one is denser, with a flash card per burst.
11:  */
12: 
13: const BURST_COLOURS: readonly RGB[] = [
14:   [1, 0.35, 0.35],
15:   [0.4, 0.55, 1],
16:   [1, 0.9, 0.4],
17:   [0.45, 1, 0.5],
18: ];
19: 
20: const BURST_GAP_SECONDS = 0.25;
21: 
22: export function spawnFireworks(scene: Scene, at: Vector3, christmas: boolean): void {
23:   const bursts = christmas ? 5 : 3;
24:   playSfx(christmas ? 'Sound/eFirecracker2' : 'Sound/eFirecracker1', at);
25: 
26:   for (let i = 0; i < bursts; i++) {
27:     const colour = BURST_COLOURS[(Math.random() * BURST_COLOURS.length) | 0];
28:     const pos = at.clone();
29:     pos.x += Math.random() * 2 - 1;
30:     pos.z += Math.random() * 2 - 1;
31:     pos.y += 1.5 + Math.random();
32:     const recipe: ParticleRecipe = { ...BOMB_SPARKS, colour, gravity: -3, life: 0.8 };
33: 
34:     delay(i * BURST_GAP_SECONDS, () => {
35:       effects.spawn('particles', scene, pos, { recipe, count: christmas ? 50 : 35 });
36:       if (christmas) {
37:         effects.spawn('sprite', scene, pos, { texture: TEX.shiny, colour, size: 1.4, seconds: 0.4, grow: 2 });
38:       }
39:       if (i > 0) playSfx('Sound/eFirecracker2', pos);
40:     });
41:   }
42: }
