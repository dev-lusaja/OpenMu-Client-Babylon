  1: import { TILE_CM } from './terrain/consts';
  2: import {
  3:   Color4,
  4:   Sprite,
  5:   SpriteManager,
  6:   Constants,
  7:   type Scene,
  8: } from '../libs/babylon/exports';
  9: import { downloadDataFile } from '../libs/mu/dataFolder';
 10: import { linearBufferActive } from './lightModel';
 11: import { lookDirector, type LookDirector } from '../lighting/director';
 12: import { EFFECT_RENDERING_GROUP, keepDepthForEffects } from '../effects/core';
 13: 
 14: /**
 15:  * Flare cards: the additive `flare01` sprite the original draws over a
 16:  * flame (`BITMAP_LIGHT` / `BITMAP_FLARE`). Purely visual - a flare lights
 17:  * nothing. The light a flame throws is the lighting layer's
 18:  * (`src/lighting/mapObjectLights.ts`), whose `LightEmitter.sprite` block is
 19:  * the `FlareSpec` a host hands to `createEffectLight`.
 20:  *
 21:  * A flare is the glow of a light, so it sits at the map's level: its colour
 22:  * is `lin(spec x luminosity) x flareLevel` (ARCHITECTURE F12, §13 F14),
 23:  * repainted when the director's state changes. Nothing decodes a sprite on
 24:  * its way into the buffer, so `paintFlare` does it.
 25:  *
 26:  * One `SpriteManager` per scene, shared by every flare on the map.
 27:  */
 28: 
 29: const FLARE_TEXTURE = 'Effect/flare01.OZJ';
 30: 
 31: const OZJ_HEADER_SIZE = 24;
 32: 
 33: const FLARE_SIZE_PX = 64;
 34: 
 35: 
 36: const MAX_SPRITES_PER_MANAGER = 512;
 37: 
 38: export type FlareSpec = {
 39:   readonly scale: number;
 40:   readonly color: readonly [number, number, number];
 41:   readonly pulse?: { speed: number; amount: number; base: number };
 42: };
 43: 
 44: let manager: SpriteManager | null = null;
 45: let managerScene: Scene | null = null;
 46: let pending: Promise<SpriteManager | null> | null = null;
 47: 
 48: /** Every live flare's repaint, run when the director publishes a new state. */
 49: const repaints = new Set<() => void>();
 50: let watched: LookDirector | null = null;
 51: 
 52: /**
 53:  * The level a flare is painted at. Outdoors and on Classic that is the map's
 54:  * own; inside a room it is the room's share of it, the same share the rig and
 55:  * the ground bake take (lighting_polish §13 F14). Without the share the flare
 56:  * runs at roughly four times the light of everything around it and saturates
 57:  * to a white ball with the candle bodies invisible inside it.
 58:  */
 59: function flareLevel(): number {
 60:   const look = lookDirector()?.state();
 61: 
 62:   return look ? look.keyGain * look.key.roomShare : 1;
 63: }
 64: 
 65: /** Whether the buffer a flare lands in is linear; see `paintFlare`. */
 66: function flaresDecoded(): boolean {
 67:   return managerScene ? linearBufferActive(managerScene) : false;
 68: }
 69: 
 70: function watchLook(): void {
 71:   const director = lookDirector();
 72:   if (!director || director === watched) return;
 73:   watched = director;
 74:   director.onChange.add(() => {
 75:     for (const repaint of repaints) repaint();
 76:   });
 77: }
 78: 
 79: async function getManager(scene: Scene): Promise<SpriteManager | null> {
 80:   if (manager && managerScene === scene) return manager;
 81: 
 82:   // Only a manager built for another scene is stale. While the first
 83:   // request is still in flight `manager` is null too, and resetting
 84:   // `pending` there made every concurrent caller build its own manager
 85:   // (seven empty 'effectLights' managers per map load).
 86:   if (manager && managerScene !== scene) {
 87:     pending = null;
 88:     manager = null;
 89:   }
 90: 
 91:   pending ??= (async () => {
 92:     const ozj = await downloadDataFile(FLARE_TEXTURE);
 93: 
 94:     const blob = new Blob([ozj.slice(OZJ_HEADER_SIZE)], { type: 'image/jpeg' });
 95:     const url = URL.createObjectURL(blob);
 96: 
 97:     const created = new SpriteManager(
 98:       'effectLights',
 99:       url,
100:       MAX_SPRITES_PER_MANAGER,
101:       { width: FLARE_SIZE_PX, height: FLARE_SIZE_PX },
102:       scene
103:     );
104: 
105:     created.blendMode = Constants.ALPHA_ONEONE;
106: 
107:     created.disableDepthWrite = true;
108: 
109:     created.isPickable = false;
110: 
111:     // After the alpha-keyed meshes, which write depth in the transparent
112:     // queue: a flare drawn before them was painted over by the hearth behind it.
113:     created.renderingGroupId = EFFECT_RENDERING_GROUP;
114:     keepDepthForEffects(scene);
115: 
116:     manager = created;
117:     managerScene = scene;
118: 
119:     return created;
120:   })();
121: 
122:   return pending;
123: }
124: 
125: export function disposeEffectLights(): void {
126:   manager?.dispose();
127:   manager = null;
128:   managerScene = null;
129:   pending = null;
130:   repaints.clear();
131: }
