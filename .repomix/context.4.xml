 462: /** itemFx bit layout (float-packed, read with int() in the shader). */
 463: const FX_LEVEL_MASK = 0x0f;
 464: const FX_EXCELLENT = 0x10;
 465: const FX_ANCIENT = 0x20;
 466: const FX_LEGACY = 0x40;
 467: const FX_SPECIALS = 0x80; // render level > 0: excellent / ancient passes allowed
 468: const FX_CHROME2_FROM_LIGHT = 0x100; // PartObjectColor2 case 0: tint = scene light
 469: const FX_BODY_SHINE = 0x200; // golden bodies: metal + chrome over the model
 470: const FX_BODY_SHINE_STAR = 0x400; // ...or the single Shiny02 pass instead
 471: 
 472: /** Tint of the body shine passes, per mesh (`ModelObject.BodyShine`). */
 473: const BODY_SHINE_UNIFORM = 'muBodyShine';
 474: 
 475: /**
 476:  * Weight of the legacy additive chrome passes. 1.0 is the original's math
 477:  * exactly; the original's framebuffer clips at 1 while ours is tone mapped
 478:  * and exposed, so the passes are eased a little to land on the same look.
 479:  */
 480: const LEGACY_GAIN = '0.65';
 481: 
 482: /**
 483:  * A blend mesh is drawn additive at `glColor3f(BodyLight * BlendMeshLight)`
 484:  * with the lighting off (`RenderMesh`, ZzzBMD.cpp:1580-1596), so the card is
 485:  * the texel scaled by the light where the object stands. This path read the
 486:  * texel alone, which put Elbeland's waterfalls - sixteen sheets over one
 487:  * cliff, and sixteen more flat on the plaza - at full strength on a map whose
 488:  * bake sits near white, and they summed to a solid white wall.
 489:  *
 490:  * The multiply is on the scrolling variant only, which is MU's `BlendMesh` /
 491:  * `StreamMesh` set: map water, waterfalls, sand-falls and the Dungeon
 492:  * curtains. The plain bright card keeps the texel because the same term on
 493:  * *its* meshes takes the wings off an elf - `metadata.bodyLight` on a
 494:  * character part is the light at the hero's feet, not the light the original
 495:  * hands a wing (wings go through `RenderPartObjectEffect`, not this branch),
 496:  * and at 0.45 an already-translucent wing card disappears. That half is a
 497:  * separate job; see found_issues.md.
 498:  *
 499:  * `muBodyLight` is `packBodyLight`'s output times `BlendMeshLight`, never
 500:  * above 1, so this only ever takes brightness away.
 501:  */
 502: const brightOverride = (withScroll: boolean) => `
 503:   color.rgb = baseColor.rgb * vDiffuseColor.rgb${
 504:     withScroll ? ` * ${BODY_LIGHT_UNIFORM}.rgb` : ''
 505:   };
 506: `;
 507: 
 508: /**
 509:  * Babylon's Standard fragment clamps the lighting sum before the texture
 510:  * multiply; this re-derives the colour without the clamp so warm light stays
 511:  * warm past 1.0. `muBodyLight` stands where `vDiffuseColor` did - that one
 512:  * lives in the Material UBO and never took a per-mesh write.
 513:  *
 514:  * Two compositions (ARCHITECTURE §3.2, §4.7). Classic: the original's
 515:  * `texel x BodyLight x light`, decoded whole by Babylon's trailing
 516:  * `toLinearSpace`. `MU_LINEAR_LIGHT`: `lin(texel x body) x light`, the one
 517:  * decode on the display-authored art and the light sum kept linear -
 518:  * re-encoded here so the trailing decode lands it exactly.
 519:  */
 520: const UNCLAMP = `
 521:   {
 522:     vec3 muLight = diffuseBase * baseAmbientColor;
 523:     vec3 muArt = max(baseColor.rgb * ${BODY_LIGHT_UNIFORM}.rgb * ${INSTANCE_VARYING}.rgb, vec3(0.0));
 524:   #ifdef ${LINEAR_LIGHT_DEFINE}
 525:     color.rgb = pow(pow(muArt, vec3(2.2)) * muLight, vec3(1.0 / 2.2));
 526:   #else
 527:     color.rgb = muArt * muLight;
 528:   #endif
 529:     color.rgb = muLightTint(color.rgb, muLight);
 530:   }
 531: `;
 532: 
 533: const FLAT_LIT_OVERRIDE = `
 534:   color.rgb = baseColor.rgb * vDiffuseColor.rgb;
 535: `;
 536: 
 537: /**
 538:  * The original client's item passes (ZzzObject.cpp `RenderPartObjectEffect`,
 539:  * ZzzBMD.cpp `RenderMesh`), folded into one fragment: every pass there is an
 540:  * additive (GL_ONE, GL_ONE) redraw of the mesh with a chrome texture looked up
 541:  * by the world-space normal, so summing them here is exact up to the
 542:  * per-vertex light term (we use Babylon's lambert sum, `diffuseBase`).
 543:  *
 544:  * MU is Z-up with Y forward; Babylon here is Y-up with Z forward, so the
 545:  * original's `normal[0..2]` is `(normalW.x, normalW.z, normalW.y)`.
 546:  * `WorldTime` is milliseconds; `time` is seconds.
 547:  */
 548: type ShaderVars = {
 549:   /** The fragment being composed (vec4). */
 550:   color: string;
 551:   /** The raw diffuse/albedo texel (vec4). */
 552:   texel: string;
 553:   /** BodyLight × BlendMeshLight per mesh (vec4, alpha = visibility). */
 554:   bodyLight: string;
 555: };
 556: 
 557: const STANDARD_VARS: ShaderVars = {
 558:   color: 'color',
 559:   texel: 'baseColor',
 560:   bodyLight: BODY_LIGHT_UNIFORM,
 561: };
 562: 
 563: const PBR_VARS: ShaderVars = {
 564:   color: 'finalColor',
 565:   texel: 'albedoTexture',
 566:   bodyLight: BODY_LIGHT_UNIFORM,
 567: };
 568: 
 569: const legacyPasses = ({ color, texel, bodyLight }: ShaderVars) => `
 570:     int fx = int(${ITEM_FX_UNIFORM});
 571:     int fxLevel = fx & ${FX_LEVEL_MASK};
 572:     bool fxExc = (fx & ${FX_EXCELLENT}) != 0;
 573:     bool fxAnc = (fx & ${FX_ANCIENT}) != 0;
 574:     bool fxLegacy = (fx & ${FX_LEGACY}) != 0;
 575:     bool fxSpecials = (fx & ${FX_SPECIALS}) != 0;
 576:     bool fxChrome2Light = (fx & ${FX_CHROME2_FROM_LIGHT}) != 0;
 577: 
 578:     // Improved look: the GlowLayer draws a soft capped halo (itemHaloAt);
 579:     // this is the in-surface part. Two rules keep the armor readable at high
 580:     // levels: the sheen rides the texel's own brightness squared, so the
 581:     // tint lands on trim and metal detail while dark leather keeps its
 582:     // texture (a flat add drowned everything into one bright shape), and
 583:     // the view-dependent rim stays a thin edge light.
 584:     if (itemGlow.r + itemGlow.g + itemGlow.b > 0.0) {
 585:       float rim = 1.0 - clamp(dot(normalize(viewDirectionW), normalW), 0.0, 1.0);
 586:       rim = rim * rim * rim;
 587:       float texLum = dot(${texel}.rgb, vec3(0.299, 0.587, 0.114));
 588:       ${color}.rgb += itemGlow * (0.3 * texLum * texLum + 0.35 * rim);
 589:     }
 590: 
 591:     // Golden monsters (modelObject.ts BodyShine): the original redraws the
 592:     // whole body over its lit pass, RENDER_METAL | RENDER_BRIGHT then
 593:     // RENDER_CHROME | RENDER_BRIGHT, both additive (ZzzCharacter.cpp:8560).
 594:     // Additive is the point - the gold has to land on top of the body
 595:     // texture, which is why tinting the light instead never read as gold.
 596:     if ((fx & ${FX_BODY_SHINE}) != 0) {
 597:       vec3 sN = vec3(normalW.x, normalW.z, normalW.y);
 598:       vec2 uvMetal = vec2(sN.z * 0.5 + 0.2, sN.y * 0.5 + 0.5);
 599:       vec3 shine;
 600:       if ((fx & ${FX_BODY_SHINE_STAR}) != 0) {
 601:         shine = texture2D(shiny2Sampler, uvMetal).rgb;
 602:       } else {
 603:         float sWave = mod(time * 1000.0, 10000.0) * 0.0001;
 604:         vec2 uvChrome = vec2(sN.z * 0.5 + sWave, sN.y * 0.5 + sWave * 2.0);
 605:         shine = texture2D(shinySampler, uvMetal).rgb +
 606:                 texture2D(chromeSampler, uvChrome).rgb;
 607:       }
 608:       ${color}.rgb += shine * ${BODY_SHINE_UNIFORM} * ${LEGACY_GAIN};
 609:     }
 610: 
 611:     if (fxLegacy) {
 612:       float tms = time * 1000.0;
 613:       vec3 nm = vec3(normalW.x, normalW.z, normalW.y);
 614:       // RENDER_TEXTURE passes are vertex lit (BodyLight × IntensityTransform,
 615:       // 0.2…1.2); the chrome passes are not - glColor3fv(BodyLight) only.
 616:       vec3 lit = clamp(diffuseBase, vec3(0.2), vec3(1.2));
 617:       float fade = ${LEGACY_GAIN};
 618: 
 619:       if (fxLevel >= 3 && fxLevel < 5) {
 620:         // +3 / +4: g_Luminosity tint, red (SceneManager.cpp:961, ZzzObject.cpp:10213)
 621:         float L = sin(tms * 0.004) * 0.15 + 0.6;
 622:         ${color}.rgb *= vec3(L, L * 0.6, L * 0.6);
 623:       } else if (fxLevel >= 5 && fxLevel < 7) {
 624:         // +5 / +6: blue
 625:         float L = sin(tms * 0.004) * 0.15 + 0.6;
 626:         ${color}.rgb *= vec3(L * 0.5, L * 0.7, L);
 627:       } else if (fxLevel >= 7) {
 628:         ${color}.rgb *= fxLevel < 9 ? 0.8 : 0.9;
 629: 
 630:         float wave = mod(tms, 10000.0) * 0.0001;
 631: 
 632:         // RENDER_CHROME | RENDER_BRIGHT: Chrome01 × PartObjectColor, added
 633:         // (ZzzBMD.cpp RenderMesh: glColor3fv(BodyLight), GL_ONE, GL_ONE)
 634:         vec2 uvChrome = vec2(nm.z * 0.5 + wave, nm.y * 0.5 + wave * 2.0);
 635:         ${color}.rgb += texture2D(chromeSampler, uvChrome).rgb * chromeColor * fade;
 636: 
 637:         if (fxLevel >= 9) {
 638:           // RENDER_METAL | RENDER_BRIGHT: Shiny01 with the static chrome coords
 639:           vec2 uvMetal = vec2(nm.z * 0.5 + 0.2, nm.y * 0.5 + 0.5);
 640:           ${color}.rgb += texture2D(shinySampler, uvMetal).rgb * chromeColor * fade;
 641:         }
 642: 
 643:         if (fxLevel >= 11) {
 644:           vec3 c2 = fxChrome2Light ? ${bodyLight}.rgb : chrome2Color;
 645:           vec2 uv2;
 646:           if (fxLevel < 13) {
 647:             // RENDER_CHROME2
 648:             float w2 = mod(tms, 5000.0) * 0.00024 - 0.4;
 649:             uv2 = vec2((nm.z + nm.x) * 0.8 + w2 * 2.0, (nm.y + nm.x) + w2 * 3.0);
 650:           } else {
 651:             // RENDER_CHROME4: rotating light vector
 652:             vec3 Lv = vec3(cos(tms * 0.001), sin(tms * 0.002), 1.0);
 653:             float d = dot(nm, Lv);
 654:             uv2 = vec2(d + nm.y * 0.5 + Lv.y * 3.0, (1.0 - d) - (nm.z * 0.5 + wave * 3.0));
 655:           }
 656:           ${color}.rgb += texture2D(chrome2Sampler, uv2).rgb * c2 * fade;
 657:         }
 658:       }
 659: 
 660:       if (fxSpecials) {
 661:         if (fxExc) {
 662:           // Excellent: the item's own texture re-drawn additively, tinted
 663:           // (L, 0.3L, 1-L) with L = sin(t*0.002)*0.5+0.5 (ZzzObject.cpp:10322)
 664:           float L = sin(tms * 0.002) * 0.5 + 0.5;
 665:           ${color}.rgb += ${texel}.rgb * vec3(L, L * 0.3, 1.0 - L) * lit;
 666:         } else if (fxAnc) {
 667:           // Ancient: RENDER_CHROME3 at alpha sin(t*0.001)*0.5+0.4 (:10374)
 668:           float a = sin(tms * 0.001) * 0.5 + 0.4;
 669:           if (a > 0.01) {
 670:             vec3 LV = vec3(0.0, -0.1, -0.8);
 671:             float d = dot(nm, LV);
 672:             ${color}.rgb += texture2D(chrome2Sampler, vec2(d, 1.0 - d)).rgb * ancientColor * a * fade;
 673:           }
 674:         }
 675:       }
 676:     }
 677: `;
 678: 
 679: let chromeTextures: {
 680:   chrome: Texture;
 681:   shiny: Texture;
 682:   shiny2: Texture;
 683:   chrome2: Texture;
 684: } | null = null;
 685: let chromeScene: Scene | null = null;
 686: 
 687: /**
 688:  * Effect/Chrome01 (repeat), Effect/Shiny01 and Shiny02, Effect/Chrome02
 689:  * (clamp, nearest).
 690:  *
 691:  * Read from the packed `.OZJ` every version's `Data/` tree ships, through the
 692:  * shared sprite decoder - the decoded `.jpg` siblings exist only beside the
 693:  * Season 6 data. A URL Babylon cannot fetch is answered with its own solid
 694:  * red placeholder, which the additive passes then smear over the whole mesh,
 695:  * so the texture starts URL-less and stays black until the real image lands.
 696:  */
 697: function getChromeTextures(scene: Scene) {
 698:   if (chromeTextures && chromeScene === scene) return chromeTextures;
 699: 
 700:   const load = (file: string, clamp: boolean, nearest: boolean) => {
 701:     const texture = new Texture(
 702:       null,
 703:       scene,
 704:       false,
 705:       false,
 706:       nearest ? Texture.NEAREST_SAMPLINGMODE : Texture.BILINEAR_SAMPLINGMODE
 707:     );
 708:     texture.name = `legacy_${file}`;
 709:     if (clamp) {
 710:       texture.wrapU = Texture.CLAMP_ADDRESSMODE;
 711:       texture.wrapV = Texture.CLAMP_ADDRESSMODE;
 712:     }
 713: 
 714:     void loadMuSprite(`Effect/${file}`).then(
 715:       sprite => texture.updateURL(sprite.url),
 716:       error => console.error(`Could not load item chrome map ${file}:`, error)
 717:     );
 718: 
 719:     return texture;
 720:   };
 721: 
 722:   chromeScene = scene;
 723:   chromeTextures = {
 724:     chrome: load('Chrome01.OZJ', false, false),
 725:     shiny: load('Shiny01.OZJ', true, false),
 726:     shiny2: load('Shiny02.OZJ', true, false),
 727:     chrome2: load('Chrome02.OZJ', true, true),
 728:   };
 729: 
 730:   return chromeTextures;
 731: }
