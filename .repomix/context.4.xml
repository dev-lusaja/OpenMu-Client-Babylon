112: const HERO_KEY = 'hero';
113: 
114: /**
115:  * The hero's own band membership, kept apart from `Band.band`: a master's
116:  * state lists the hero by the id the master sees them under, which is not
117:  * one this client knows itself by (every client is 0x200 to itself). The
118:  * hero's share of a master's stream is voiced from this record, never from
119:  * that list.
120:  */
121: let membership: { masterId: number; instrument: InstrumentId; channelMask: number } | null = null;
122: 
123: const sequencer = new Sequencer(
124:   { now: audioNow },
125:   {
126:     schedule: (ev, when) => voiceLocal(ev, when),
127:     batch: (baseMs, events) => transport.batch(baseMs, events),
128:     ended: () => {
129:       runInAction(() => {
130:         if (Band.phase === 'playing') Band.phase = 'out';
131:       });
132:     },
133:   },
134:   { tickMs: TICK_MS }
135: );
