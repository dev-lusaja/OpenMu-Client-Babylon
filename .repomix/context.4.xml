 1: import { describe, expect, it } from 'vitest';
 2: import {
 3:   EMOJI_BUBBLES,
 4:   RESERVED_CHAT_PREFIXES,
 5:   emojiBubbleToken,
 6:   matchEmojiBubbleWord,
 7: } from './emojiBubbles';
 8: import { ChatLineType, classifyInboundChat } from './chat';
 9: 
10: describe('emoji bubble tokens', () => {
11:   // A token opening with one of these is routed by the server (party, guild,
12:   // alliance, gens, global notification, command) instead of reaching the
13:   // players around the sender, so the bubble would show for the sender alone.
14:   it('never open with a prefix the server reads as routing', () => {
15:     for (const bubble of EMOJI_BUBBLES) {
16:       for (const word of bubble.words) {
17:         for (const prefix of RESERVED_CHAT_PREFIXES) {
18:           expect(
19:             word.startsWith(prefix),
20:             `${bubble.id} token ${JSON.stringify(word)} opens with ${prefix}`
21:           ).toBe(false);
22:         }
23:       }
24:     }
25:   });
26: 
27:   it('are unique across the table', () => {
28:     const words = EMOJI_BUBBLES.flatMap(b => b.words.map(w => w.toLowerCase()));
29:     expect(new Set(words).size).toBe(words.length);
30:   });
31: 
32:   it('are ASCII, since packet strings are one byte per character', () => {
33:     for (const bubble of EMOJI_BUBBLES) {
34:       for (const word of bubble.words) {
35:         expect(/^[\x20-\x7e]+$/.test(word), `${bubble.id}: ${word}`).toBe(true);
36:       }
37:     }
38:   });
39: 
40:   it('survive the round trip the wheel puts them through', () => {
41:     for (const bubble of EMOJI_BUBBLES) {
42:       const line = classifyInboundChat(emojiBubbleToken(bubble.id));
43:       expect(line.type).toBe(ChatLineType.Chat);
44:       expect(matchEmojiBubbleWord(line.text)).toBe(bubble.id);
45:     }
46:   });
47: });
