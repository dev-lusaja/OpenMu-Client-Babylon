117: /**
118:  * `CheckChatText`'s `else if` chain, in its own order - the first branch whose
119:  * token appears anywhere in the line wins, so a word two emotes claim goes to
120:  * whichever is checked first. Two of those collisions come straight from the
121:  * original and are kept: "Great" belongs to `cheer` (318) although `again`
122:  * (338) and `cheers` (317) list it too, and "There" fires `gesture` because
123:  * "Here" is a substring of it.
124:  *
125:  * **Choice:** `provocation` is moved ahead of `gesture`. The original's
126:  * `FindText` compares case-sensitively, which is the only reason "come on"
127:  * (291) was not eaten by "Come" (289); we match case-insensitively - an
128:  * English player types "hi", not "Hi" - so the one collision that
129:  * case-sensitivity used to resolve is resolved by the order instead.
130:  */
131: export const EMOTE_WORD_CHAIN: readonly EmoteId[] = [
132:   'provocation',
133:   'greeting',
134:   'goodbye',
135:   'clap',
136:   'gesture',
137:   'direction',
138:   'unknown',
139:   'awkward',
140:   'cry',
141:   'see',
142:   'smile',
143:   'cheer',
144:   'win',
145:   'sleep',
146:   'cold',
147:   'again',
148:   'respect',
149:   'salute',
150:   'rush',
151:   'hustle',
152:   'cheers',
153:   'lookAround',
154: ];
155: 
156: /**
157:  * `CheckChatText`: the emote a chat line triggers, or null. `FindText` is a
158:  * plain substring search over the whole line and not a word match, so
159:  * "Sorry!!" and "I am sorry" both fire `awkward`.
160:  */
161: export function matchEmoteWord(text: string): EmoteId | null {
162:   const line = text.toLowerCase();
163:   if (!line) return null;
164: 
165:   for (const id of EMOTE_WORD_CHAIN) {
166:     const words = emoteById(id).words;
167:     if (!words) continue;
168:     for (const word of words) {
169:       if (line.includes(word.toLowerCase())) return id;
170:     }
171:   }
172: 
173:   return null;
174: }
175: 
176: /**
177:  * Every social clip, male and female variants included
178:  * (PLAYER_GREETING1 .. PLAYER_COME_UP in the action table). They play once and
179:  * hand control back to idle, like attacks.
180:  */
181: export function isPlayerEmoteAction(action: PlayerAction): boolean {
182:   return (
183:     action >= PlayerAction.PLAYER_GREETING1 &&
184:     action <= PlayerAction.PLAYER_COME_UP
185:   );
186: }
187: 
188: /**
189:  * `SetActionClass`: a female character plays the clip right after the male
190:  * one, except for the block Respect..Rush which only has one variant.
191:  */
192: export function genderedEmoteAction(
193:   action: PlayerAction,
194:   isFemale: boolean
195: ): PlayerAction {
196:   if (!isFemale) return action;
197:   if (
198:     action >= PlayerAction.PLAYER_RESPECT1 &&
199:     action <= PlayerAction.PLAYER_RUSH1
200:   ) {
201:     return action;
202:   }
203:   if (
204:     action >= PlayerAction.PLAYER_GREETING1 &&
205:     action <= PlayerAction.PLAYER_AGAIN1 &&
206:     (action - PlayerAction.PLAYER_GREETING1) % 2 === 0 // male base clip
207:   ) {
208:     return action + 1;
209:   }
210:   return action;
211: }
