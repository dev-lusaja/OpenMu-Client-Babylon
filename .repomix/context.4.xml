159:   static readonly WarehouseSize = this.WarehouseRows * this.RowSize;
160: 
161:   /// <summary>
162:   /// Gets the size of the inventory with the specified number of extensions.
163:   /// </summary>
164:   /// <param name="numberOfExtensions">The number of inventory extensions.</param>
165:   /// <returns>The size of the inventory.</returns>
166:   static GetInventorySize(numberOfExtensions: number) {
167:     const size =
168:       this.EquippableSlotsCount +
169:       this.InventoryRows * this.RowSize +
170:       this.RowsOfOneExtension *
171:         this.RowSize *
172:         Math.max(
173:           Math.min(numberOfExtensions, this.MaximumNumberOfExtensions),
174:           0
175:         );
176: 
177:     return size;
178:   }
179: 
180:   /// <summary>
181:   /// Determines whether the item slot is of an defending item.
182:   /// </summary>
183:   /// <param name="itemSlot">The item slot.</param>
184:   /// <returns><see langword="true"/>, if the slot is of an defending item.</returns>
185:   static IsDefenseItemSlot(itemSlot: number) {
186:     return (
187:       (itemSlot >= this.HelmSlot && itemSlot <= this.WingsSlot) ||
188:       itemSlot == this.Ring1Slot ||
189:       itemSlot == this.Ring2Slot
190:     );
191:   }
192: }
</file>

