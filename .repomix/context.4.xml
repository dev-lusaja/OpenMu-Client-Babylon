 412: type LitDefines = Record<string, boolean> & { rebuild(): void };
 413: 
 414: /** The compile-time state of a lit variant, as one number to compare. */
 415: function litDefineState(scene: Scene): number {
 416:   return (
 417:     (linearLightActive(scene) ? 1 : 0) |
 418:     (wrapActive() ? 2 : 0) |
 419:     (toonRampActive() ? 4 : 0) |
 420:     (toonFlatActive() ? 8 : 0) |
 421:     (toonUltraActive() ? 16 : 0)
 422:   );
 423: }
 424: 
 425: /**
 426:  * Hands the tier defines to the material's shader build. Babylon calls
 427:  * `customShaderNameResolve` with the defines object whenever they are dirty,
 428:  * so the flags ride the same recompile the light and shadow defines use; the
 429:  * frame check marks the material dirty once when the state moves (a tier or
 430:  * post change), never per frame.
 431:  */
 432: function addLitDefines(material: ItemMaterial, scene: Scene): void {
 433:   const builder = material.customShaderNameResolve;
 434:   let compiled = -1;
 435: 
 436:   material.customShaderNameResolve = function (this: ItemMaterial, ...args) {
 437:     const state = litDefineState(scene);
 438:     const defines = args[4];
 439: 
 440:     compiled = state;
 441: 
 442:     if (!Array.isArray(defines)) {
 443:       const lit = defines as unknown as LitDefines;
 444:       lit[LINEAR_LIGHT_DEFINE] = (state & 1) !== 0;
 445:       lit[WRAP_DEFINE] = (state & 2) !== 0;
 446:       lit[TOON_DEFINE] = (state & 4) !== 0;
 447:       lit[FLAT_DEFINE] = (state & 8) !== 0;
 448:       lit[ULTRA_DEFINE] = (state & 16) !== 0;
 449:       lit.rebuild();
 450:     }
 451: 
 452:     return builder.apply(this, args);
 453:   };
 454: 
 455:   scene.onBeforeRenderObservable.add(() => {
 456:     if (compiled !== -1 && compiled !== litDefineState(scene)) {
 457:       material.markDirty(true);
 458:     }
 459:   });
 460: }
