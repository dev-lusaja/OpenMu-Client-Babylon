134:   dispose(): void;
135: };
136: 
137: export type MovableFlare = {
138:   moveTo(x: number, y: number, z: number): void;
139:   setLuminosity(lumi: number): void;
140:   dispose(): void;
141: };
142: 
143: /**
144:  * Paints `lin(color x lumi) x flareLevel` and keeps repainting it while the
145:  * flare lives.
146:  *
147:  * Babylon's sprite shader is `texel x vColor` and nothing more - its
148:  * `imageProcessingCompatibility` decode sits behind `IMAGEPROCESSINGPOSTPROCESS`
149:  * and `SpriteRenderer` never defines it - so on the graded tiers a flare lands
150:  * in a *linear* buffer carrying a *display* colour. Every tint here is
151:  * display-referred (they are the original's `Luminosity x (r, g, b)` vectors,
152:  * composited by a gamma-space client), so skipping the decode lifts the low
153:  * channels: Noria's (0.4, 0.7, 1.0) reached the buffer at 0.93/1.63/2.33 and
154:  * the fairy forest's blue burned as a white ball. The decode leaves the
155:  * brightest channel where it is and puts the colour back underneath it.
156:  *
157:  * Same rule as `effects/core.ts lightCardGain`, reached from the other side: a
158:  * card's material decodes downstream so only the gain enters pre-decoded
159:  * there, and nothing decodes a sprite so the whole product enters decoded
160:  * here. Classic has no linear buffer and keeps the original's own arithmetic.
161:  */
162: function paintFlare(
163:   sprite: Sprite,
164:   color: readonly [number, number, number]
165: ): { setLuminosity(lumi: number): void; release(): void } {
166:   const [r, g, b] = color;
167:   let lumi = 1;
168:   const repaint = () => {
169:     const level = flareLevel();
170:     const decode = flaresDecoded();
171:     const c = (v: number) => (decode ? (v * lumi) ** 2.2 : v * lumi) * level;
172:     sprite.color.set(c(r), c(g), c(b), 1);
173:   };
174:   sprite.color = new Color4(r, g, b, 1);
175:   repaint();
176:   repaints.add(repaint);
177:   watchLook();
178: 
179:   return {
180:     setLuminosity(next) {
181:       lumi = next;
182:       repaint();
183:     },
184:     release() {
185:       repaints.delete(repaint);
186:     },
187:   };
188: }
189: 
190: export async function createMovableFlare(
191:   scene: Scene,
192:   scale: number,
193:   color: readonly [number, number, number]
194: ): Promise<MovableFlare | null> {
195:   const spriteManager = await getManager(scene);
196: 
197:   if (!spriteManager || manager !== spriteManager) return null;
198: 
199:   const sprite = new Sprite('candleFlare', spriteManager);
200: 
201:   sprite.isPickable = false;
202: 
203:   const size = (FLARE_SIZE_PX * scale) / TILE_CM;
204: 
205:   sprite.width = size;
206:   sprite.height = size;
207: 
208:   const paint = paintFlare(sprite, color);
209: 
210:   return {
211:     moveTo: (x, y, z) => sprite.position.set(x, y, z),
212:     setLuminosity: lumi => paint.setLuminosity(lumi),
213:     dispose: () => {
214:       paint.release();
215:       sprite.dispose();
216:     },
217:   };
218: }
