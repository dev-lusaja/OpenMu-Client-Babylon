295: export async function loadMidiFile(file: File): Promise<void> {
296:   try {
297:     const bytes = new Uint8Array(await file.arrayBuffer());
298:     const song = parseMidi(bytes);
299:     stopPlaying();
300:     sequencer.load(song);
301:     runInAction(() => {
302:       Band.song = song;
303:       Band.fileName = file.name;
304:       Band.positionMs = 0;
305:       Band.error = null;
306:     });
307:     if (Band.role === 'master' || Band.role === 'solo') refreshLocalMask();
308:   } catch (err) {
309:     runInAction(() => {
310:       Band.error = err instanceof MidiFileError ? 'instrument.fileError' : 'instrument.fileError';
311:     });
312:   }
313: }
