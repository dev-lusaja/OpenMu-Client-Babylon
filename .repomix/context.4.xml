 96: function fireKind(
 97:   texture: TextureKey,
 98:   opts: {
 99:     lifeBase: number;
100:     lifeRand: number;
101:     fadeBelow: number;
102:     gravityBase: number;
103:     shrinkBase: number;
104:     shrinkRand: number;
105:     scaleBase?: number;
106:     gravityRand?: number;
107:   }
108: ): ParticleKind {
109:   return {
110:     texture,
111:     blend: 'add',
112:     init(p, scale, light) {
113:       p.lifeTime = rand(5) + opts.lifeBase;
114:       p.scale = (rand(72) + (opts.scaleBase ?? 72)) * 0.01 * scale;
115:       p.rotation = rand(360);
116:       p.gravity = (rand(opts.gravityRand ?? 24) + opts.gravityBase) * 0.1;
117:       p.alpha = 0;
118: 
119:       [p.tr, p.tg, p.tb] = light;
120:       p.lr = p.lg = p.lb = 0;
121:     },
122:     update(p, f) {
123:       if (p.lifeTime < opts.fadeBelow) {
124:         p.alpha -= f * 0.2;
125: 
126:         // Only a particle on its way out is cut here. The ramp below starts
127:         // at 0 and climbs by a frame-scaled step, so testing it against a
128:         // fixed floor killed every particle whose first frame was shorter
129:         // than the original's tick: half of them at 60 Hz (the step lands on
130:         // 0.083 or 0.125), all of them past 120, which left a torch with
131:         // nothing but its flare card.
132:         if (p.alpha < 0.1) {
133:           p.live = false;
134:           return;
135:         }
136:       } else if (p.alpha < 1) {
137:         p.alpha += f * (rand(2) + 2) * 0.1;
138:       } else {
139:         p.alpha = 1;
140:       }
141: 
142:       p.lr = p.tr * p.alpha;
143:       p.lg = p.tg * p.alpha;
144:       p.lb = p.tb * p.alpha;
145: 
146:       if (p.scale > 0) {
147:         p.scale -= f * (rand(opts.shrinkRand) + opts.shrinkBase) * 0.01;
148:       } else {
149:         p.live = false;
150:         return;
151:       }
152: 
153:       p.pz += p.gravity * f;
154:       p.rotation += 3 * f;
155:     },
156:     color: plainColor,
157:   };
158: }
