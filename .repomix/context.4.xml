 762: /**
 763:  * Per-draw item state: effect bits, chrome tints, improved glow. Both
 764:  * variants run this from their bind observer; the materials are frozen and
 765:  * shared, so everything per mesh has to go through here.
 766:  */
 767: function bindItemEffect(effect: Effect, mesh: AbstractMesh, time: number) {
 768:   effect.setFloat('time', time + (mesh.metadata?.timeOffset ?? 0));
 769:   effect.setFloat(LIGHT_TINT_UNIFORM, lightTintStrength());
 770:   bindItemClouds(effect, mesh.getScene());
 771: 
 772:   bindSunWrap(effect, mesh);
 773:   bindToon(effect, mesh.metadata?.characterAsset === true);
 774:   bindToonRef(effect, mesh.getScene());
 775: 
 776:   const tier = mesh.metadata?.itemTier as ItemVisualTier | null | undefined;
 777: 
 778:   let fx = 0;
 779: 
 780:   // Blend (bright) meshes are additive glow cards already; the original
 781:   // skips NoneBlendMesh meshes in its chrome passes the same way.
 782:   if (
 783:     tier &&
 784:     tier.active &&
 785:     legacyItemEffectsOn() &&
 786:     !mesh.metadata?.brightMesh
 787:   ) {
 788:     fx = (tier.level & FX_LEVEL_MASK) | FX_LEGACY;
 789:     if (tier.isExcellent) fx |= FX_EXCELLENT;
 790:     if (tier.isAncient) fx |= FX_ANCIENT;
 791:     if (legacyRenderLevel() > 0) fx |= FX_SPECIALS;
 792:     if (tier.legacy.chrome2 === null) fx |= FX_CHROME2_FROM_LIGHT;
 793: 
 794:     const { chrome, chrome2, ancient } = tier.legacy;
 795:     effect.setFloat3('chromeColor', chrome[0], chrome[1], chrome[2]);
 796:     if (chrome2) {
 797:       effect.setFloat3('chrome2Color', chrome2[0], chrome2[1], chrome2[2]);
 798:     } else {
 799:       effect.setFloat3('chrome2Color', 1, 1, 1);
 800:     }
 801:     effect.setFloat3('ancientColor', ancient[0], ancient[1], ancient[2]);
 802:   }
 803: 
 804:   // Same blend-mesh rule: the original's chrome passes skip NoneBlendMesh.
 805:   // `Bright` there rides o->Alpha, so a fading corpse loses its shine too.
 806:   const shine = mesh.metadata?.bodyShine as BodyShine | undefined;
 807:   const tint = shine?.tint;
 808:   if (tint && !mesh.metadata?.brightMesh && tint.x + tint.y + tint.z > 0) {
 809:     fx |= FX_BODY_SHINE;
 810:     if (shine.star) fx |= FX_BODY_SHINE_STAR;
 811:     const a = mesh.visibility;
 812:     effect.setFloat3(BODY_SHINE_UNIFORM, tint.x * a, tint.y * a, tint.z * a);
 813:   }
 814: 
 815:   effect.setFloat(ITEM_FX_UNIFORM, fx);
 816: 
 817:   // Snow caps: only map props flagged for it, never a glow card. The mesh's
 818:   // tile decides whether it stands under a roof - for a prop batch that is
 819:   // per placement, carried in the instance attribute, so the uniform is the
 820:   // cover alone.
 821:   let cap = 0;
 822:   if (mesh.metadata?.snowCap && !mesh.metadata.brightMesh) {
 823:     if (mesh.metadata.propBatch) {
 824:       cap = snowCapCover();
 825:     } else {
 826:       const p = mesh.absolutePosition;
 827:       cap = snowCapAt(p.x, p.z);
 828:     }
 829:   }
 830:   effect.setFloat(SNOW_CAP_UNIFORM, cap);
 831: 
 832:   if (
 833:     tier &&
 834:     tier.improvedActive &&
 835:     improvedItemEffectsOn() &&
 836:     !mesh.metadata?.brightMesh
 837:   ) {
 838:     const g = itemEmissiveAt(tier, itemGlowClock(), glowScratch);
 839:     effect.setFloat3('itemGlow', g.r, g.g, g.b);
 840:   } else {
 841:     effect.setFloat3('itemGlow', 0, 0, 0);
 842:   }
 843: }
 844: 
 845: /**
 846:  * BodyLight x BlendMeshLight (or the explicit per-mesh colour), alpha =
 847:  * visibility. The caller has already written the neutral (1, 1, 1,
 848:  * visibility); without the unified model the bake is left out and only the
 849:  * explicit colour lands, which is the older behaviour.
 850:  *
 851:  * BodyLight is capped before it meets the texel (§4.5): the original's
 852:  * `glColor` clamps it at 1.0 per channel (ZzzBMD.cpp:255-257), which Classic
 853:  * keeps byte for byte; tiers >= 1 divide by the peak instead so a torch's
 854:  * hue survives the cap.
 855:  */
 856: /**
 857:  * BodyLight as the shader takes it: the cap of the paragraph above, applied
 858:  * to one terrain-light triple. Written to `out[o..o+2]`. The per-mesh bind
 859:  * and the prop batches' per-instance attribute both pack through here, so a
 860:  * batched tree and its per-object twin read the same light.
 861:  */
 862: export function packBodyLight(
 863:   x: number,
 864:   y: number,
 865:   z: number,
 866:   out: Float32Array | number[],
 867:   o = 0
 868: ): void {
 869:   if (!UNIFIED_LIGHT_MODEL) {
 870:     out[o] = 1;
 871:     out[o + 1] = 1;
 872:     out[o + 2] = 1;
 873:     return;
 874:   }
 875: 
 876:   if (lightingTier()) {
 877:     const peak = Math.max(1, x, y, z);
 878:     out[o] = x / peak;
 879:     out[o + 1] = y / peak;
 880:     out[o + 2] = z / peak;
 881:   } else {
 882:     out[o] = Math.min(1, x);
 883:     out[o + 1] = Math.min(1, y);
 884:     out[o + 2] = Math.min(1, z);
 885:   }
 886: }
 887: 
 888: const packedLight = [1, 1, 1];
 889: 
 890: function bindBodyLight(effect: Effect, mesh: AbstractMesh, uniform: string) {
 891:   const bodyLight = mesh.metadata?.bodyLight;
 892: 
 893:   if (bodyLight && UNIFIED_LIGHT_MODEL) {
 894:     const blend = mesh.metadata?.blendMeshLight ?? 1;
 895: 
 896:     packBodyLight(bodyLight.x, bodyLight.y, bodyLight.z, packedLight);
 897: 
 898:     effect.setFloat4(
 899:       uniform,
 900:       packedLight[0] * blend,
 901:       packedLight[1] * blend,
 902:       packedLight[2] * blend,
 903:       mesh.visibility
 904:     );
 905:   }
 906: 
 907:   if (mesh.metadata?.diffuseColor) {
 908:     effect.setColor4(
 909:       uniform,
 910:       mesh.metadata.diffuseColor,
 911:       mesh.metadata.diffuseColor.a
 912:     );
 913:   }
 914: }
