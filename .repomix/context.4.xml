509: /**
510:  * The bytes of one GLB, taken through the asset transport so the build's gzip
511:  * sidecar is used when there is one (`common/compressedAssets.ts`), then
512:  * handed to Babylon as a file rather than a URL. These GLBs carry their own
513:  * textures, so nothing is resolved against the root URL and the loader only
514:  * needs the name for its `.glb` extension.
515:  */
516: async function loadContainerBytes(
517:   filePath: string,
518:   fileName: string,
519:   scene: Scene
520: ): Promise<AssetContainer> {
521:   const parse = (bytes: Uint8Array) =>
522:     SceneLoader.LoadAssetContainerAsync(
523:       '',
524:       new File([bytes as BlobPart], fileName, { type: 'model/gltf-binary' }),
525:       scene,
526:       null,
527:       '.glb'
528:     );
529: 
530:   const { bytes, fromSidecar } = await fetchAsset(filePath);
531: 
532:   try {
533:     return await parse(bytes);
534:   } catch (error) {
535:     if (!fromSidecar) throw error;
536: 
537:     // The glTF parser is the only thing that can tell a sidecar the browser
538:     // unwrapped for us from a whole file, so a parse failure on packed bytes
539:     // is the point where the plain file is tried instead.
540:     sidecarFailed(filePath, error);
541:     return parse(await plainBytes(filePath));
542:   }
543: }
544: 
545: function loadContainer(
546:   filePath: string,
547:   scene: Scene,
548:   fileName: string,
549:   characterAsset: boolean
550: ): Promise<AssetContainer> {
551:   const cached = containersCache.get(filePath);
552:   if (cached) return cached;
553: 
554:   const pending = loadContainerBytes(filePath, fileName, scene)
555:     .then(container => {
556:       prepareMeshes(
557:         container.meshes,
558:         container.skeletons,
559:         filePath,
560:         fileName,
561:         scene,
562:         characterAsset
563:       );
564: 
565:       // The glTF loader starts the first clip on parse (`animationStartMode`
566:       // FIRST) - on the container's own nodes, which never enter the scene.
567:       // The clones do, and `loadGLTF` plays their clip; the source's
568:       // Animatables would otherwise run for nothing, one set per cached
569:       // model, for the whole session (Noria: 1 620 of 2 122 running).
570:       for (const group of container.animationGroups) {
571:         if (group.isStarted) group.stop(true);
572:       }
573: 
574:       return container;
575:     })
576:     .catch(error => {
577:       // A failed load must not poison the cache: the next request retries.
578:       containersCache.delete(filePath);
579:       console.error(`Could not load model ${filePath}:`, error);
580:       throw error;
581:     });
582: 
583:   containersCache.set(filePath, pending);
584: 
585:   return pending;
586: }
587: 
588: /**
589:  * `player.glb` is a rig with 62 nodes, 284 clips and *no meshes* - the glTF
590:  * loader only materialises a `Skeleton` for a skin a mesh actually
591:  * references, so this one has to be built by hand from the instantiated
592:  * `skin_*` subtree. `PlayerObject` then hands it to the body-part models
593:  * through `LinkParent`.
594:  */
595: function synthesizeRigSkeleton(
596:   root: Node,
597:   fileName: string,
598:   scene: Scene
599: ): Skeleton {
600:   const skeleton = new Skeleton(
601:     `skeleton_${fileName}`,
602:     `skeleton_${fileName}_${skelId++}`,
603:     scene
604:   );
605: 
606:   const descendants = root.getDescendants(false);
607:   const skinRoot = descendants.find(node => node.name.startsWith('skin_'));
608: 
609:   if (skinRoot) {
610:     // Bone ORDER is load-bearing, not just membership: the mesh's
611:     // `matricesIndices` are the converter's `vertex.Node + 1`, and
612:     // `ParentBoneLink` indexes `skeleton.bones` directly (weaponAttachment's
613:     // LEFT_HAND_BONE / RIGHT_HAND_BONE). The converter emits the skin root
614:     // first and then `bone_<i>_<name>` in ascending `i`, so the list has to be
615:     // rebuilt in that order - a depth-first walk of the same nodes gives a
616:     // different order as soon as the bone tree branches, which skins every
617:     // vertex to the wrong bone.
618:     const bones: Node[] = [skinRoot];
619: 
620:     const numbered: { index: number; node: Node }[] = [];
621: 
622:     for (const node of descendants) {
623:       const match = /^bone_(\d+)_/.exec(node.name);
624:       if (match) numbered.push({ index: Number(match[1]), node });
625:     }
626: 
627:     numbered.sort((a, b) => a.index - b.index);
628: 
629:     for (const { node } of numbered) bones.push(node);
630: 
631:     // The converter guarantees a bone's parent has a lower index than the
632:     // bone itself (it re-roots anything else), so parents are always already
633:     // in the map by the time their children are read.
634:     const boneByNode = new Map<Node, Bone>();
635: 
636:     for (const node of bones) {
637:       const bone = new Bone(node.name, skeleton, null);
638:       bone.linkTransformNode(node as TransformNode);
639:       boneByNode.set(node, bone);
640:       bone.parent = node.parent ? boneByNode.get(node.parent) ?? null : null;
641:     }
642:   }
643: 
644:   skeleton.prepare();
645: 
646:   return skeleton;
647: }
648: 
649: export async function loadGLTF(
650:   filePath: string,
651:   world: World
652: ): Promise<LoadedModel> {
653:   const characterAsset = isCharacterAsset(filePath);
654: 
655:   filePath = resolveUrlToDataFolder(filePath);
656:   const fileName = filePath.split('/').at(-1)!;
657: 
658:   const scene = world.scene;
659: 
660:   if (!USE_MODEL_CONTAINER_CACHE) {
661:     // Uncached: one fresh parse per request, added to the scene as-is. No
662:     // clone, no shared geometry - the pre-cache behaviour, kept for A/B.
663:     const own = await loadContainerBytes(filePath, fileName, scene);
664: 
665:     prepareMeshes(
666:       own.meshes,
667:       own.skeletons,
668:       filePath,
669:       fileName,
670:       scene,
671:       characterAsset
672:     );
673:     own.addAllToScene();
674: 
675:     const ownRoot = own.meshes[0];
676: 
677:     return {
678:       mesh: ownRoot,
679:       skeleton:
680:         own.skeletons[0] ??
681:         (filePath.includes('player.glb')
682:           ? synthesizeRigSkeleton(ownRoot, fileName, scene)
683:           : own.skeletons[0]),
684:       animationGroups: own.animationGroups,
685:     };
686:   }
687: 
688:   const container = await loadContainer(filePath, scene, fileName, characterAsset);
689: 
690:   // doNotInstantiate defaults to true, so every node is cloned rather than
691:   // turned into an InstancedMesh. That is deliberate: the shared item
692:   // materials bind `metadata.diffuseTexture` and `metadata.bodyLight` per
693:   // mesh in `onBindObservable`, and hardware instances draw in one call with
694:   // one uniform set - every object would take the last one's terrain light.
695:   const entries = container.instantiateModelsToScene(name => name, false);
696: 
697:   const root = entries.rootNodes[0] as AbstractMesh;
698:   root.name = fileName;
699: 
700:   // Babylon shares `metadata` by reference across clones (mesh.js:395). The
701:   // per-mesh render contract (bodyLight, itemTier, itemLvl, diffuseColor…) is
702:   // per instance, so each clone needs its own object.
703:   root.metadata = { ...root.metadata };
704:   for (const mesh of root.getChildMeshes(false)) {
705:     mesh.metadata = { ...mesh.metadata };
706:   }
707: 
708:   let skeleton = entries.skeletons[0];
709: 
710:   if (!skeleton && filePath.includes('player.glb')) {
711:     skeleton = synthesizeRigSkeleton(root, fileName, scene);
712:   }
713: 
714:   // The glTF loader auto-starts the first clip (`animationStartMode` defaults
715:   // to FIRST), and BMD models carry their rest pose *in* that clip - the
716:   // converter leaves every bone node at identity, so an unplayed model sits in
717:   // the raw, tilted BMD orientation. Instantiated clones do not inherit the
718:   // auto-play, so reproduce it here.
719:   const first = entries.animationGroups[0];
720: 
721:   if (first) {
722:     first.play(true);
723:     // ...and write frame 0 straight away rather than waiting for the next
724:     // `scene.animate()`. Anything that renders the model outside the main pass
725:     // (the item-icon render target) can otherwise catch it still unposed.
726:     first.goToFrame(first.from);
727:   }
728: 
729:   return {
730:     mesh: root,
731:     skeleton,
732:     animationGroups: entries.animationGroups,
733:   };
734: }
735: 
736: /**
737:  * Drop every cached container whose path contains `pathPrefix` (an asset
738:  * folder such as `Object4/`): `loadMapIntoScene` calls it when the asset
739:  * world changes, after the old map's entities - the clones that shared the
740:  * containers' geometry - are gone. Without this the cache grew by one map's
741:  * worth of GLBs per warp for the whole session. Shared folders (`Player/`,
742:  * `Item/`, `Npc/`) are never passed here.
743:  */
744: export function evictContainers(pathPrefix: string): void {
745:   for (const [key, pending] of containersCache) {
746:     if (!key.includes(pathPrefix)) continue;
747:     containersCache.delete(key);
748:     // `AssetContainer.dispose` disposes the container's textures, so the
749:     // diffuse textures parsed out of this file die with it. Dropping them
750:     // here is what makes the map's next visit re-parse the GLB and keep the
751:     // fresh texture; a kept entry would be handed out already disposed and
752:     // the mesh would draw untextured until the page was reloaded.
753:     texturesCache.delete(key);
754:     pending.then(
755:       container => container.dispose(),
756:       () => {}
757:     );
758:   }
759: }
</file>

