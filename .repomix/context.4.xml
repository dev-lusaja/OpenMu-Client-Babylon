  1: import type { Item } from '../ecs/world';
  2: import { ItemsDatabase } from './itemsDatabase';
  3: import {
  4:   ItemGroup,
  5:   calcMaxDurability,
  6:   isCapeOfFighter,
  7:   isCapeOfLord,
  8:   isFirstWing,
  9:   isThirdWing,
 10:   itemDef,
 11:   type ItemDef,
 12: } from './itemStats';
 13: 
 14: /**
 15:  * Zen values the way the original client computes them for the shop and
 16:  * repair windows: `ItemValue` (ZzzInfomation.cpp:1457), `CalcRepairCost`
 17:  * (ZzzInventory.cpp:1201), `IsSellingBan` / `IsRepairBan`
 18:  * (ZzzInventory.cpp:7812/7887). The server has the final say; these are the
 19:  * numbers the tooltips and the repair bar show.
 20:  */
 21: 
 22: /** `goldType` of `ItemValue`: 0 = NPC buy price, 1 = sell price, 2 = repair base. */
 23: export type GoldType = 0 | 1 | 2;
 24: 
 25: const idiv = (a: number, b: number) => Math.trunc(a / b);
 26: 
 27: /** `Gold / 100 * 100` above 1000, `/ 10 * 10` above 100. */
 28: function roundGold(gold: number): number {
 29:   if (gold >= 1000) return idiv(gold, 100) * 100;
 30:   if (gold >= 100) return idiv(gold, 10) * 10;
 31:   return gold;
 32: }
 33: 
 34: /** Raw `items.json` columns `ItemDef` does not carry (`iZen`, `Value`). */
 35: function rawColumns(def: ItemDef): { zen: number; value: number } {
 36:   const raw = ItemsDatabase.getItem(def.group, def.index) as
 37:     | Record<string, unknown>
 38:     | null;
 39:   const zen = typeof raw?.Zen === 'number' ? raw.Zen : 0;
 40:   const value = typeof raw?.Valor === 'number' ? raw.Valor : 0;
 41:   return { zen, value };
 42: }
 43: 
 44: /** `Level2` bonus for +5…+15 items (the `switch (Level)` table). */
 45: const LEVEL_BONUS = [0, 0, 0, 0, 0, 4, 10, 25, 45, 65, 95, 135, 185, 245, 305, 365];
 46: 
 47: /** `AT_IMPROVE_DAMAGE` & co: +4/+8/+12/+16 option tiers. */
 48: function optionMultiplier(value: number): number {
 49:   switch (value) {
 50:     case 4:
 51:       return 6 / 10;
 52:     case 8:
 53:       return 14 / 10;
 54:     case 12:
 55:       return 28 / 10;
 56:     case 16:
 57:       return 56 / 10;
 58:     default:
 59:       return 0;
 60:   }
 61: }
 62: 
 63: function isPotionLike(def: ItemDef): boolean {
 64:   // ITEM_POTION..ITEM_ANTIDOTE: apple, the healing / mana potions, antidote.
 65:   return def.group === ItemGroup.Potion && def.index <= 8;
 66: }
 67: 
 68: function countBits(flags: number): number {
 69:   let n = 0;
 70:   for (let f = flags & 0xff; f; f >>= 1) n += f & 1;
 71:   return n;
 72: }
 73: 
 74: /** `ItemValue(ip, goldType)`; -1 never happens here (no pets). */
 75: export function itemValue(item: Item, goldType: GoldType): number {
 76:   const def = itemDef(item.group, item.num);
 77:   if (!def) return 0;
 78: 
 79:   const { zen, value } = rawColumns(def);
 80:   const level = item.lvl ?? 0;
 81:   const durability = item.durability ?? 0;
 82:   const { group, index } = def;
 83: 
 84:   if (zen !== 0) {
 85:     let gold = zen;
 86:     if (goldType) gold = idiv(gold, 3);
 87:     return roundGold(gold);
 88:   }
 89: 
 90:   const excellent = (item.excellentFlags ?? 0) !== 0 || item.isExcellent === true;
 91:   let level2 = def.level + level * 3;
 92:   if (excellent) level2 += 25;
 93: 
 94:   let gold = 0;
 95: 
 96:   const isJewelOfBless = group === ItemGroup.Potion && index === 13;
 97:   const isJewelOfSoul = group === ItemGroup.Potion && index === 14;
 98:   const isJewelOfChaos = group === ItemGroup.Wing && index === 15;
 99:   const isJewelOfLife = group === ItemGroup.Potion && index === 16;
100:   const isJewelOfCreation = group === ItemGroup.Potion && index === 22;
101:   const isJewelOfGuardian = group === ItemGroup.Potion && index === 31;
102: 
103:   if (group === ItemGroup.Bow && index === 7) {
104:     // Bolts
105:     const sell = [100, 1400, 2200, 3000][Math.min(level, 3)];
106:     if (def.durability > 0) gold = idiv(sell * durability, def.durability);
107:   } else if (group === ItemGroup.Bow && index === 15) {
108:     // Arrows
109:     const sell = [70, 1200, 2000, 2800][Math.min(level, 3)];
110:     if (def.durability > 0) gold = idiv(sell * durability, def.durability);
111:   } else if (isJewelOfBless) {
112:     gold = 9000000;
113:   } else if (isJewelOfSoul) {
114:     gold = 6000000;
115:   } else if (isJewelOfChaos) {
116:     gold = 810000;
117:   } else if (isJewelOfLife) {
118:     gold = 45000000;
119:   } else if (isJewelOfCreation) {
120:     gold = 36000000;
121:   } else if (isJewelOfGuardian) {
122:     gold = 60000000;
123:   } else if (group === ItemGroup.Helper && index === 14) {
124:     // Loch's Feather / Crest of Monarch
125:     gold = level === 0 ? 180000 : 7500000;
126:   } else if (group === ItemGroup.Helper && index === 3) {
127:     // Horn of Dinorant: +300,000 per option
128:     gold = 960000 + 300000 * countBits(item.excellentFlags ?? 0);
129:   } else if (group === ItemGroup.Helper && index === 15) {
130:     // Fruits
131:     gold = 33000000;
132:   } else if (group === ItemGroup.Helper && (index === 16 || index === 17)) {
133:     // Scroll of Archangel / Blood Bone
134:     gold = [0, 10000, 50000, 100000, 300000, 500000, 800000, 1000000, 1200000][
135:       Math.min(level, 8)
136:     ];
137:   } else if (group === ItemGroup.Helper && index === 18) {
138:     // Invisibility Cloak
139:     gold = (level === 1 ? 50000 : 200000 + 20000 * (level - 1)) * 3;
140:   } else if (group === ItemGroup.Potion && index === 9 && level === 1) {
141:     // Ale
142:     gold = 1000;
143:   } else if (group === ItemGroup.Potion && index === 10) {
144:     // Town Portal Scroll
145:     gold = 750;
146:   } else if (group === ItemGroup.Potion && index === 7) {
147:     // Siege Potion
148:     gold = (level === 0 ? 900000 : 450000) * durability;
149:   } else if (group === ItemGroup.Helper && index === 7) {
150:     // Contract (Summon)
151:     gold = level === 0 ? 1500000 : 1200000;
152:   } else if (group === ItemGroup.Helper && index === 11) {
153:     // Life Stone
154:     gold = level === 0 ? 100000 : 2400000;
155:   } else if (group === ItemGroup.Helper && index === 20) {
156:     // Wizard's Ring
157:     gold = level === 0 ? 3000 : 0;
158:   } else if (group === ItemGroup.Helper && index === 31) {
159:     // Spirit (Dark Horse / Raven spirit)
160:     gold = (level === 0 ? 10000000 : 5000000) * 3;
161:   } else if (value > 0 && isPotionLike(def)) {
162:     // ITEM_POTION..ITEM_ANTIDOTE: Value² · 10 / 12, doubled per level, per unit.
163:     gold = idiv(value * value * 10, 12);
164:     if (index === 3 || index === 6) gold = 1500; // large healing / mana potion
165:     if (level > 0) gold *= 2 ** level;
166:     gold = idiv(gold, 10) * 10;
167:     gold *= durability;
168:     if (goldType) {
169:       gold = idiv(gold, 3);
170:       gold = idiv(gold, 10) * 10;
171:     }
172:     return gold;
173:   } else if (value > 0) {
174:     gold = idiv(value * value * 10, 12);
175:   } else if (
176:     (group === ItemGroup.Wing &&
177:       index > 2 &&
178:       !isThirdWing(def) &&
179:       !isCapeOfFighter(def)) ||
180:     group === ItemGroup.Helper ||
181:     group === ItemGroup.Etc
182:   ) {
183:     // Second wings, orbs, rings / pendants, scrolls: 100 + Level2³.
184:     gold = 100 + level2 * level2 * level2;
185:   } else {
186:     level2 += LEVEL_BONUS[Math.min(level, 15)];
187: 
188:     if (isFirstWing(def) || isCapeOfLord(def) || isThirdWing(def)) {
189:       gold = 40000000 + (40 + level2) * level2 * level2 * 11;
190:     } else {
191:       gold = 100 + idiv((40 + level2) * level2 * level2, 8);
192:     }
193: 
194:     if (group <= ItemGroup.Shield && !def.twoHand) {
195:       gold = idiv(gold * 80, 100);
196:     }
197: 
198:     // The `Special[]` list: skill, +option, luck, excellent options.
199:     if (item.hasSkill) gold += Math.trunc(gold * 1.5);
200: 
201:     const option = item.optionLevel ?? 0;
202:     if (option > 0) {
203:       // Shields carry AT_IMPROVE_BLOCKING (5 per step) which lands on the
204:       // same tiers as the +4 options of everything else.
205:       gold += Math.trunc(gold * optionMultiplier(Math.min(option, 4) * 4));
206:     }
207: 
208:     if (item.luck) gold += Math.trunc((gold * 25) / 100);
209: 
210:     for (let i = countBits(item.excellentFlags ?? 0); i > 0; i--) {
211:       gold += gold;
212:     }
213:   }
214: 
215:   gold = Math.min(gold, 3000000000);
216: 
217:   if (goldType === 2) gold = roundGold(gold);
218:   if (goldType) gold = idiv(gold, 3);
219: 
220:   // Selling a worn item pays less: the repair share comes off (goldType 1).
221:   if (goldType === 1 && hasDurability(def)) {
222:     const max = calcMaxDurability(
223:       def,
224:       level,
225:       item.isExcellent === true,
226:       item.isAncient === true
227:     );
228:     if (max > 0) {
229:       // No durability byte (offline test items): treat as undamaged.
230:       const percent = 1 - (item.durability ?? max) / max;
231:       let repairGold = Math.trunc(gold * 0.6 * percent);
232:       if (group === ItemGroup.Helper && index === 31) repairGold = 0;
233:       gold -= repairGold;
234:     }
235:   }
236: 
237:   return roundGold(gold);
238: }
239: 
240: /** Weapons, armour, shields and wings wear out; the rest is exempt. */
241: function hasDurability(def: ItemDef): boolean {
242:   if (def.group <= ItemGroup.Boots) return true;
243:   if (def.group === ItemGroup.Wing) return def.index <= 6 || isThirdWing(def) || isCapeOfFighter(def);
244:   if (isCapeOfLord(def)) return true;
245:   return false;
246: }
247: 
248: /** `CalcRepairCost`; `selfRepair` is the +150% inventory-button rate. */
249: export function repairCost(item: Item, selfRepair: boolean): number {
250:   const def = itemDef(item.group, item.num);
251:   if (!def) return 0;
252: 
253:   const max = calcMaxDurability(
254:     def,
255:     item.lvl ?? 0,
256:     item.isExcellent === true,
257:     item.isAncient === true
258:   );
259:   const durability = item.durability ?? max;
260: 
261:   let gold = Math.min(itemValue(item, 2), 400000000);
262: 
263:   const percent = max > 0 ? 1 - durability / max : 0;
264:   if (percent > 0) {
265:     const root = Math.sqrt(gold);
266:     const rootRoot = Math.sqrt(root);
267:     gold = Math.trunc(3.5 * root * rootRoot * percent) + 1;
268: 
269:     if (durability <= 0) {
270:       const isPet = def.group === ItemGroup.Helper && (def.index === 4 || def.index === 5);
271:       gold = isPet ? gold * 2 : Math.trunc(gold * 1.4);
272:     }
273:   } else {
274:     gold = 0;
275:   }
276: 
277:   if (selfRepair) gold = Math.trunc(gold * 2.5);
278: 
279:   return roundGold(gold);
280: }
281: 
282: /** `IsSellingBan`: what the merchant refuses. */
283: export function isSellingBanned(item: Item): boolean {
284:   const { group, num: index } = item;
285:   const level = item.lvl ?? 0;
286: 
287:   if (group === ItemGroup.Potion && index === 11) return true; // Box of Luck
288:   if (group === ItemGroup.Potion && index === 21 && level === 1) return true;
289:   if (group === ItemGroup.Potion && index === 20 && level >= 1 && level <= 5) return true;
290:   if (group === ItemGroup.Helper && index === 20 && level !== 0) return true; // Wizard's Ring +1/+2
291:   if (group === ItemGroup.Helper && index === 19) return true; // Weapon of Archangel
292:   if (group === ItemGroup.Helper && (index === 4 || index === 5)) return true; // Dark Horse / Raven
293: 
294:   return false;
295: }
296: 
297: /** `IsRepairBan`: what no smith will touch. */
298: export function isRepairBanned(item: Item): boolean {
299:   const def = itemDef(item.group, item.num);
300:   if (!def) return true;
301: 
302:   const { group, index } = def;
303: 
304:   if (group >= ItemGroup.Potion) return true;
305:   if (group === ItemGroup.Bow && (index === 7 || index === 15)) return true; // bolts / arrows
306:   if (group === ItemGroup.Wing) return !hasDurability(def); // orbs, chaos
307:   if (group === ItemGroup.Helper) {
308:     if (index <= 3) return true; // guardian angel .. Dinorant
309:     if (index === 4 || index === 5) return true; // Dark Horse / Raven
310:     if (index === 7) return true; // contract
311:     if (index === 10) return true; // Transformation Ring
312:     if (index === 11) return true; // Life Stone
313:     if (index >= 14 && index <= 19) return true; // Loch's Feather .. Weapon of Archangel
314:     if (index === 38) return true; // Moonstone Pendant
315:     return !hasDurability(def) && !(index >= 8 && index <= 13) && !(index >= 20 && index <= 28);
316:   }
317: 
318:   return false;
319: }
320: 
321: /** Items with durability below their maximum (`RepairAllGold`). */
322: export function needsRepair(item: Item): boolean {
323:   const def = itemDef(item.group, item.num);
324:   if (!def) return false;
325:   if (isRepairBanned(item)) return false;
326: 
327:   const max = calcMaxDurability(
328:     def,
329:     item.lvl ?? 0,
330:     item.isExcellent === true,
331:     item.isAncient === true
332:   );
333:   return (item.durability ?? max) < max;
334: }
335: 
336: /** `RepairAllGold`: the smith's price for everything worn in the inventory. */
337: export function repairAllCost(items: (Item | null)[], selfRepair: boolean): number {
338:   let total = 0;
339:   for (const item of items) {
340:     if (!item || !needsRepair(item)) continue;
341:     total += repairCost(item, selfRepair);
342:   }
343:   return total;
344: }
345: 
346: /** `ConvertTaxGold`: the shop's price with the merchant's tax on top. */
347: export function withTax(gold: number, taxRate: number): number {
348:   return gold + idiv(gold * taxRate, 100);
349: }
</file>

<file path="src/common/itemVisualTier.ts">
  1: import type { Item } from '../ecs/world';
  2: import { gameVersion } from '../version';
  3: import {
  4:   capItemLevel,
  5:   legacyItemEffectsOn,
  6:   legacyRenderLevel,
  7: } from './itemEffectMode';
  8: 
  9: /** Improved emissive scale while the legacy passes are also drawn ("Both"). */
 10: const BOTH_SCALE = 0.65;
 11: import { legacyItemColours, type LegacyItemColours } from './itemLegacyEffects';
 12: 
 13: /**
 14:  * Item visual identity: a pure `(item) → ItemVisualTier` lookup
 15:  * that every renderer consumes - the character's equipment, the hand, and
 16:  * the ground drop all read the same descriptor, so a +13 blade glows, pulses
 17:  * and lights the floor the same way wherever it is.
 18:  *
 19:  * Two looks share the descriptor (Options → Video → Item effects):
 20:  *  - **legacy** - the original client's passes, reproduced in itemMaterial.ts
 21:  *    from ZzzObject.cpp `RenderPartObjectEffect`; `legacy` carries the
 22:  *    per-item chrome colours from its tables (itemLegacyEffects.ts).
 23:  *  - **improved** - our own: GlowLayer halo + in-surface rim sheen, aura
 24:  *    motes (itemAura.ts), energy arcs (itemCrackle.ts) and pooled lights, all
 25:  *    in the item's legacy chrome colour (improvedColour):
 26:  *      +0–6 none · +7–8 sheen · +9–10 pulse, motes, arcs, orbit ring, starts
 27:  *      to emit light · +11–12 much denser: sparks, forked arcs, double ring ·
 28:  *      +13–15 intense, a real light source. Every level from +9 is a visible
 29:  *      step up from the one below so the level reads at a glance.
 30:  *    Excellent layers a cyan↔green shimmer; ancient a deep green pulse.
 31:  *
 32:  * `level` is already capped by the original's render-level option, so both
 33:  * looks obey the same "+Effect limitation" slider.
 34:  */
 35: 
 36: export type ItemGlowTier = 0 | 1 | 2 | 3 | 4;
 37: 
 38: export type RGB = readonly [number, number, number];
 39: 
 40: export type ItemVisualTier = {
 41:   /** Item level after the render-level cap (capItemLevel). */
 42:   readonly level: number;
 43:   readonly isExcellent: boolean;
 44:   readonly isAncient: boolean;
 45:   readonly sockets: number;
 46:   readonly glow: ItemGlowTier;
 47:   /** Base emissive tint; may exceed 1 - the ACES tone map handles it. */
 48:   readonly emissive: RGB;
 49:   /** Emissive strength at the pulse peak (0 = no level glow). */
 50:   readonly intensity: number;
 51:   /**
 52:    * GlowLayer halo amplitude - deliberately a much gentler ladder than
 53:    * `intensity`. The layer paints the *whole mesh silhouette* and blurs it,
 54:    * so anything near the surface intensity floods the armor into one bright
 55:    * shape and every texel of detail drowns (the "reflective blob"). The
 56:    * halo stays a soft aura; the level reads through the crackle/aura
 57:    * density, the pooled light and the in-surface sheen instead.
 58:    */
 59:   readonly halo: number;
 60:   /** Fraction of `intensity` that breathes, and the breath rate (rad/s). */
 61:   readonly pulse: number;
 62:   readonly pulseRate: number;
 63:   /** Pooled / terrain light gain (0 = not a light source). */
 64:   readonly lightGain: number;
 65:   readonly lightColor: RGB;
 66:   /** Point-light range (tiles) and terrain stain radius (whole tiles). */
 67:   readonly lightRange: number;
 68:   readonly terrainRange: number;
 69:   /** +11 and up shed sparks (itemAura.ts adds a fast falling layer). */
 70:   readonly sparks: boolean;
 71:   /** Aura particles per second (0 = no aura); itemAura.ts. */
 72:   readonly auraRate: number;
 73:   /** Energy arcs per second over the body from +9 (0 = none); itemCrackle.ts. */
 74:   readonly crackleRate: number;
 75:   /** Original-client pass colours for this item. */
 76:   readonly legacy: LegacyItemColours;
 77:   /** True when either look has something to draw for this item. */
 78:   readonly active: boolean;
 79:   /** True when the improved (emissive) look has something to draw. */
 80:   readonly improvedActive: boolean;
 81: };
 82: 
 83: const NONE: RGB = [0, 0, 0];
 84: 
 85: /**
 86:  * Improved-look colour of an item: the original's chrome colour for it
 87:  * (PartObjectColor - gold for most, blue for Legendary / Lightning, white for
 88:  * Silver Bow…), so the halo, the motes and the floor light all agree with the
 89:  * legacy passes. From +11 the PartObjectColor2 tint is mixed in, as the
 90:  * original adds that pass on top. Normalised so the brightest channel is 1;
 91:  * `intensity` carries the level.
 92:  */
 93: function improvedColour(legacy: LegacyItemColours, level: number): RGB {
 94:   let [r, g, b] = legacy.chrome;
 95: 
 96:   if (level >= 11 && legacy.chrome2) {
 97:     const [r2, g2, b2] = legacy.chrome2;
 98:     r = r * 0.6 + r2 * 0.4;
 99:     g = g * 0.6 + g2 * 0.4;
100:     b = b * 0.6 + b2 * 0.4;
101:   }
102: 
103:   const peak = Math.max(r, g, b, 0.001);
104: 
105:   return [r / peak, g / peak, b / peak];
106: }
107: 
108: /** Light source from +9: gain 0.3 at +9 scaling to 1.2 at +15. */
109: const LIGHT_FIRST_LEVEL = 9;
110: const LIGHT_GAIN_MIN = 0.3;
111: const LIGHT_GAIN_MAX = 1.2;
112: 
113: /** The original starts tinting at +3 (ZzzObject.cpp:10213). */
114: const LEGACY_FIRST_LEVEL = 3;
115: 
116: function glowTierOf(level: number): ItemGlowTier {
117:   if (level >= 13) return 4;
118:   if (level >= 11) return 3;
119:   if (level >= 9) return 2;
120:   if (level >= 7) return 1;
121:   return 0;
122: }
123: 
124: const tierCache = new Map<string, ItemVisualTier>();
125: 
126: /** Level (+0…+15), excellent, ancient and socket count → visual tier. */
127: export function itemVisualTier(item: Item | null | undefined): ItemVisualTier {
128:   const rawLevel = Math.max(0, Math.min(15, item?.lvl ?? 0));
129:   const level = capItemLevel(rawLevel);
130:   const isExcellent = item?.isExcellent === true;
131:   // Ancient sets and sockets are later additions; a version without them has
132:   // no such item, so neither pass may draw (versions/<id> `features`).
133:   const isAncient =
134:     item?.isAncient === true && gameVersion.features.ancientItems;
135:   const sockets = gameVersion.features.socketItems
136:     ? Math.max(0, Math.min(5, item?.socketCount ?? 0))
137:     : 0;
138:   const group = item?.group ?? -1;
139:   const num = item?.num ?? -1;
140: 
141:   const key = `${group}:${num}|${level}|${isExcellent ? 1 : 0}|${
142:     isAncient ? 1 : 0
143:   }|${sockets}|${legacyRenderLevel()}`;
144:   const cached = tierCache.get(key);
145:   if (cached) return cached;
146: 
147:   const glow = glowTierOf(level);
148:   const legacy = legacyItemColours(group, num);
149:   const colour = improvedColour(legacy, level);
150: 
151:   let emissive: RGB = NONE;
152:   let intensity = 0;
153:   let halo = 0;
154:   let pulse = 0;
155:   let pulseRate = 0;
156: 
157:   let auraRate = 0;
158:   let crackleRate = 0;
159: 
160:   switch (glow) {
161:     case 1:
162:       emissive = colour;
163:       intensity = 0.35;
164:       halo = 0.18;
165:       pulse = 0.35;
166:       pulseRate = 2;
167:       break;
168:     case 2:
169:       // +9 / +10: the first "real" tier - clearly more than a sheen, with
170:       // a visible step between the two so the level reads at a glance.
171:       emissive = colour;
172:       intensity = level === 9 ? 1.1 : 1.3;
173:       halo = level === 9 ? 0.32 : 0.38;
174:       pulse = 0.45;
175:       pulseRate = 3;
176:       auraRate = level === 9 ? 18 : 24;
177:       crackleRate = level === 9 ? 4 : 5.5;
178:       break;
179:     case 3:
180:       // +11 / +12: dense motes, sparks, forked arcs and an orbit ring.
181:       emissive = colour;
182:       intensity = level === 11 ? 1.6 : 1.8;
183:       halo = level === 11 ? 0.48 : 0.54;
184:       pulse = 0.45;
185:       pulseRate = 3.5;
186:       auraRate = level === 11 ? 34 : 42;
187:       crackleRate = level === 11 ? 8 : 10;
188:       break;
189:     case 4:
190:       emissive = colour;
191:       intensity = 2.1 + (level - 13) * 0.3;
192:       halo = 0.62 + (level - 13) * 0.08;
193:       pulse = 0.4;
194:       pulseRate = 4;
195:       auraRate = 52 + (level - 13) * 8;
196:       crackleRate = 12 + (level - 13) * 2;
197:       break;
198:   }
199: 
200:   const lightGain =
201:     level >= LIGHT_FIRST_LEVEL
202:       ? LIGHT_GAIN_MIN +
203:         ((LIGHT_GAIN_MAX - LIGHT_GAIN_MIN) * (level - LIGHT_FIRST_LEVEL)) /
204:           (15 - LIGHT_FIRST_LEVEL)
205:       : 0;
206: 
207:   // At render level 0 the original skips the excellent / ancient passes too.
208:   const specials = legacyRenderLevel() > 0 && (isExcellent || isAncient);
209:   const improvedActive = intensity > 0 || specials || sockets > 0;
210: 
211:   // Excellent / ancient items twinkle even below +9.
212:   if (specials) auraRate += 6;
213: 
214:   const tier: ItemVisualTier = {
215:     level,
216:     isExcellent,
217:     isAncient,
218:     sockets,
219:     glow,
220:     emissive,
221:     intensity,
222:     halo,
223:     pulse,
224:     pulseRate,
225:     lightGain,
226:     lightColor: lightGain > 0 ? emissive : NONE,
227:     lightRange: lightGain > 0 ? 3 + ((level - LIGHT_FIRST_LEVEL) * 2) / 6 : 0,
228:     terrainRange: lightGain > 0 ? (level >= 13 ? 4 : level >= 11 ? 3 : 2) : 0,
229:     sparks: level >= 11,
230:     auraRate,
231:     crackleRate,
232:     legacy,
233:     active: improvedActive || level >= LEGACY_FIRST_LEVEL,
234:     improvedActive,
235:   };
236: 
237:   tierCache.set(key, tier);
238: 
239:   return tier;
240: }
241: 
242: /** The strongest tier across a set of equipped items (drives the body light). */
243: export function strongestTier(
244:   items: readonly (Item | null | undefined)[]
245: ): ItemVisualTier {
246:   let best = itemVisualTier(null);
247: 
248:   for (const item of items) {
249:     if (!item) continue;
250:     const tier = itemVisualTier(item);
251:     if (
252:       tier.lightGain > best.lightGain ||
253:       (tier.lightGain === best.lightGain && tier.intensity > best.intensity) ||
254:       (tier.lightGain === best.lightGain &&
255:         tier.intensity === best.intensity &&
256:         tier.auraRate > best.auraRate)
257:     ) {
258:       best = tier;
259:     }
260:   }
261: 
262:   return best;
263: }
264: 
265: // --- shared clock -----------------------------------------------------------
266: 
267: let clock = 0;
268: 
269: /** World-time seconds; set once per frame by ItemGlowSystem. */
270: export function setItemGlowClock(seconds: number): void {
271:   clock = seconds;
272: }
273: 
274: export function itemGlowClock(): number {
275:   return clock;
276: }
277: 
278: // --- animated colours (improved look) ----------------------------------------
279: 
280: const EXC_A: RGB = [0.2, 0.9, 1]; // cyan
281: const EXC_B: RGB = [0.3, 1, 0.45]; // green
282: const EXC_GAIN = 0.4;
283: const EXC_RATE = 2.4;
284: 
285: const ANCIENT: RGB = [0.12, 0.65, 0.28];
286: const ANCIENT_BASE = 0.25;
287: const ANCIENT_PULSE = 0.3;
288: const ANCIENT_RATE = 1.8;
289: 
290: const SOCKET: RGB = [0.55, 0.75, 1];
291: const SOCKET_GAIN = 0.08;
292: const SOCKET_RATE = 5;
293: 
294: type ColorOut = { r: number; g: number; b: number };
295: 
296: /**
297:  * Emissive colour of a tier at `t` seconds. `out` is written in place (a
298:  * Babylon Color4 works - only r/g/b/a are touched).
299:  */
300: export function itemEmissiveAt<T extends ColorOut & { a?: number }>(
301:   tier: ItemVisualTier,
302:   t: number,
303:   out: T
304: ): T {
305:   let r = 0;
306:   let g = 0;
307:   let b = 0;
308: 
309:   if (tier.intensity > 0) {
310:     const breath = 1 - tier.pulse * (0.5 - 0.5 * Math.sin(t * tier.pulseRate));
311:     const k = tier.intensity * breath;
312: 
313:     r += tier.emissive[0] * k;
314:     g += tier.emissive[1] * k;
315:     b += tier.emissive[2] * k;
316:   }
317: 
318:   const specials = legacyRenderLevel() > 0;
319: 
320:   if (tier.isExcellent && specials) {
321:     // The classic exc colour sweep: cyan ↔ green on the shared clock.
322:     const m = 0.5 + 0.5 * Math.sin(t * EXC_RATE);
323: 
324:     r += (EXC_A[0] + (EXC_B[0] - EXC_A[0]) * m) * EXC_GAIN;
325:     g += (EXC_A[1] + (EXC_B[1] - EXC_A[1]) * m) * EXC_GAIN;
326:     b += (EXC_A[2] + (EXC_B[2] - EXC_A[2]) * m) * EXC_GAIN;
327:   }
328: 
329:   if (tier.isAncient && specials) {
330:     const k =
331:       ANCIENT_BASE + ANCIENT_PULSE * (0.5 + 0.5 * Math.sin(t * ANCIENT_RATE));
332: 
333:     r += ANCIENT[0] * k;
334:     g += ANCIENT[1] * k;
335:     b += ANCIENT[2] * k;
336:   }
337: 
338:   if (tier.sockets > 0) {
339:     // Per-socket glint: a quick shimmer whose rate grows with the gem count.
340:     const k =
341:       SOCKET_GAIN *
342:       (0.5 + 0.5 * Math.sin(t * SOCKET_RATE * (1 + tier.sockets * 0.15)));
343: 
344:     r += SOCKET[0] * k;
345:     g += SOCKET[1] * k;
346:     b += SOCKET[2] * k;
347:   }
348: 
349:   // With the legacy wash underneath, the halo in the same colour doubles up.
350:   const k = legacyItemEffectsOn() ? BOTH_SCALE : 1;
351: 
352:   out.r = r * k;
353:   out.g = g * k;
354:   out.b = b * k;
355:   out.a = 1;
356: 
357:   return out;
358: }
359: 
360: /**
361:  * Colour handed to the GlowLayer's emissive selector: the tier tint at the
362:  * capped `halo` amplitude, breathing on the shared clock. Separate from
363:  * `itemEmissiveAt` on purpose - the layer floods the whole silhouette, so it
364:  * gets the soft-aura ladder while the surface sheen keeps the full ladder.
365:  * The excellent / ancient / socket shimmers ride along at half gain so their
366:  * colour still reads in the aura without re-flooding it.
367:  */
368: export function itemHaloAt<T extends ColorOut & { a?: number }>(
369:   tier: ItemVisualTier,
370:   t: number,
371:   out: T
372: ): T {
373:   let r = 0;
374:   let g = 0;
375:   let b = 0;
376: 
377:   if (tier.halo > 0) {
378:     const breath = 1 - tier.pulse * (0.5 - 0.5 * Math.sin(t * tier.pulseRate));
379:     const k = tier.halo * breath;
380: 
381:     r += tier.emissive[0] * k;
382:     g += tier.emissive[1] * k;
383:     b += tier.emissive[2] * k;
384:   }
385: 
386:   const specials = legacyRenderLevel() > 0;
387: 
388:   if (tier.isExcellent && specials) {
389:     const m = 0.5 + 0.5 * Math.sin(t * EXC_RATE);
390:     const e = EXC_GAIN * 0.5;
391: 
392:     r += (EXC_A[0] + (EXC_B[0] - EXC_A[0]) * m) * e;
393:     g += (EXC_A[1] + (EXC_B[1] - EXC_A[1]) * m) * e;
394:     b += (EXC_A[2] + (EXC_B[2] - EXC_A[2]) * m) * e;
395:   }
396: 
397:   if (tier.isAncient && specials) {
398:     const k =
399:       (ANCIENT_BASE + ANCIENT_PULSE * (0.5 + 0.5 * Math.sin(t * ANCIENT_RATE))) *
400:       0.5;
401: 
402:     r += ANCIENT[0] * k;
403:     g += ANCIENT[1] * k;
404:     b += ANCIENT[2] * k;
405:   }
406: 
407:   if (tier.sockets > 0) {
408:     const k =
409:       SOCKET_GAIN *
410:       (0.5 + 0.5 * Math.sin(t * SOCKET_RATE * (1 + tier.sockets * 0.15)));
411: 
412:     r += SOCKET[0] * k;
413:     g += SOCKET[1] * k;
414:     b += SOCKET[2] * k;
415:   }
416: 
417:   const k = legacyItemEffectsOn() ? BOTH_SCALE : 1;
418: 
419:   out.r = r * k;
420:   out.g = g * k;
421:   out.b = b * k;
422:   out.a = 1;
423: 
424:   return out;
425: }
426: 
427: /**
428:  * Colour fed to the pooled point light / terrain stain: the level tint scaled
429:  * by the light gain, breathing with the emissive so floor and blade agree.
430:  */
431: export function itemLightColorAt(
432:   tier: ItemVisualTier,
433:   t: number,
434:   out: ColorOut
435: ): ColorOut {
436:   if (tier.lightGain <= 0) {
437:     out.r = out.g = out.b = 0;
438:     return out;
439:   }
440: 
441:   const breath =
442:     1 - tier.pulse * 0.6 * (0.5 - 0.5 * Math.sin(t * tier.pulseRate));
443:   const k = tier.lightGain * breath;
444: 
445:   out.r = tier.lightColor[0] * k;
446:   out.g = tier.lightColor[1] * k;
447:   out.b = tier.lightColor[2] * k;
448: 
449:   if (tier.isExcellent && legacyRenderLevel() > 0) {
450:     const m = 0.5 + 0.5 * Math.sin(t * EXC_RATE);
451:     const e = 0.15 * tier.lightGain;
452: 
453:     out.r += (EXC_A[0] + (EXC_B[0] - EXC_A[0]) * m) * e;
454:     out.g += (EXC_A[1] + (EXC_B[1] - EXC_A[1]) * m) * e;
455:     out.b += (EXC_A[2] + (EXC_B[2] - EXC_A[2]) * m) * e;
456:   }
457: 
458:   return out;
459: }
</file>

<file path="src/common/jewelUpgrade.ts">
  1: import type { Item } from '../ecs/world';
  2: import { InventoryConstants } from './inventoryConstants';
  3: import { t } from '../i18n';
  4: 
  5: /**
  6:  * Item upgrading with jewels: pick a jewel, click it onto an item
  7:  * (`CNewUIMyInventory::ApplyJewels`, NewUIMyInventory.cpp:1546). Pure rules
  8:  * only - the packet (0x26 ConsumeItemRequest, ItemSlot = jewel, TargetSlot =
  9:  * item) is sent by `Store.applyPickedJewel`, the answer
 10:  * (`InventoryItemUpgraded` / `ItemConsumptionFailed`) lands in logic.ts.
 11:  *
 12:  * Server truth (OpenMU `ItemModifyConsumeHandlerPlugIn`): the target must sit
 13:  * in the inventory grid, never in an equipment slot, and the jewel's own
 14:  * handler decides the level / option window. The checks here mirror the
 15:  * original client so an obviously wrong drop never leaves the client.
 16:  */
 17: 
 18: /** Jewels share the potion group. */
 19: export const JEWEL_GROUP = 14;
 20: 
 21: /** Item numbers inside group 14 that are dropped onto gear. */
 22: export const JEWEL = {
 23:   bless: 13,
 24:   soul: 14,
 25:   life: 16,
 26:   creation: 22,
 27:   guardian: 31,
 28:   gemstone: 41,
 29:   harmony: 42,
 30:   lowerRefineStone: 43,
 31:   higherRefineStone: 44,
 32: } as const;
 33: 
 34: /** Jewel of Chaos lives in the jewel-of-chaos group (12, 15); it is only ever mixed. */
 35: export const JEWEL_OF_CHAOS = { group: 12, num: 15 } as const;
 36: 
 37: /**
 38:  * ApplyJewels' pick list: what may be clicked onto an item. Creation, Chaos,
 39:  * Guardian and Gemstone go through the chaos machine, never onto an item.
 40:  */
 41: const ITEM_JEWELS: ReadonlySet<number> = new Set([
 42:   JEWEL.bless,
 43:   JEWEL.soul,
 44:   JEWEL.life,
 45:   JEWEL.harmony,
 46:   JEWEL.lowerRefineStone,
 47:   JEWEL.higherRefineStone,
 48: ]);
 49: 
 50: /** Jewels that stay a jewel even when the whole stack is gone (no gulp sound). */
 51: export function isJewel(item: Item): boolean {
 52:   return (
 53:     (item.group === JEWEL_GROUP &&
 54:       (ITEM_JEWELS.has(item.num) ||
 55:         item.num === JEWEL.creation ||
 56:         item.num === JEWEL.guardian ||
 57:         item.num === JEWEL.gemstone)) ||
 58:     (item.group === JEWEL_OF_CHAOS.group && item.num === JEWEL_OF_CHAOS.num)
 59:   );
 60: }
 61: 
 62: /** True when the carried item is a jewel that is applied by clicking it onto gear. */
 63: export function isUpgradeJewel(item: Item): boolean {
 64:   return item.group === JEWEL_GROUP && ITEM_JEWELS.has(item.num);
 65: }
 66: 
 67: /** Highest item level a jewel still applies to (`iLevel >= 6` / `>= 9` refuse). */
 68: const BLESS_MAX_TARGET_LEVEL = 5;
 69: const SOUL_MAX_TARGET_LEVEL = 8;
 70: 
 71: /** Wing item numbers of group 12 that count as gear (ApplyJewels' wing ranges). */
 72: const WING_NUMBERS: ReadonlySet<number> = new Set([
 73:   0, 1, 2, 3, 4, 5, 6, // 1st / 2nd class wings + Wings of Darkness
 74:   36, 37, 38, 39, 40, 41, 42, 43, // 3rd class wings + Cape of Emperor
 75:   49, 50, // Cape of Fighter / Overrule
 76:   130, 131, 132, 133, 134, 135, // small wings
 77: ]);
 78: 
 79: /** Ammunition never takes a jewel (`ITEM_BOLT` 4/7, `ITEM_ARROWS` 4/15). */
 80: const AMMO_NUMBERS: ReadonlySet<number> = new Set([7, 15]);
 81: 
 82: /** Gear that accepts a jewel: weapons, armour, wings, Cape of Lord (13, 30). */
 83: export function isJewelTarget(item: Item): boolean {
 84:   if (item.group <= 11) return !(item.group === 4 && AMMO_NUMBERS.has(item.num));
 85:   if (item.group === 12) return WING_NUMBERS.has(item.num);
 86:   if (item.group === 13) return item.num === 30;
 87:   return false;
 88: }
 89: 
 90: /**
 91:  * Why `jewel` may not be dropped on `target` sitting at `targetSlot`, or
 92:  * `null` when the request may go out. Texts match the original's system log
 93:  * tone (GlobalText[474] for the storage case lives in Store).
 94:  */
 95: export function jewelTargetError(jewel: Item, target: Item, targetSlot: number): string | null {
 96:   if (!isUpgradeJewel(jewel)) return t('item.jewelNotAJewel');
 97: 
 98:   if (targetSlot < InventoryConstants.EquippableSlotsCount) {
 99:     return t('item.takeItemOffFirst');
100:   }
101: 
102:   if (!isJewelTarget(target)) return t('item.jewelNotUpgradable');
103: 
104:   const level = target.lvl ?? 0;
105: 
106:   switch (jewel.num) {
107:     case JEWEL.bless:
108:       if (level > BLESS_MAX_TARGET_LEVEL) return t('item.jewelBlessLimit');
109:       return null;
110:     case JEWEL.soul:
111:       if (level > SOUL_MAX_TARGET_LEVEL) return t('item.jewelSoulLimit');
112:       return null;
113:     case JEWEL.life:
114:       return null;
115:     case JEWEL.harmony:
116:       if (target.isAncient) return t('item.jewelHarmonyAncient');
117:       if ((target.socketCount ?? 0) > 0) return t('item.jewelHarmonySocket');
118:       return null;
119:     case JEWEL.lowerRefineStone:
120:     case JEWEL.higherRefineStone:
121:       if ((target.socketCount ?? 0) > 0) return t('item.refineStoneSocket');
122:       return null;
123:     default:
124:       return t('item.jewelWrongTarget');
125:   }
126: }
