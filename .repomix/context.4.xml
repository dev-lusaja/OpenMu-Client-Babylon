256: export function putAwayInstrument(): void {
257:   const world = Store.world;
258:   stopPlaying();
259:   if (Band.role !== 'solo') leaveBand();
260:   transport.stop();
261:   if (world) world.bandRequest = { kind: 'putAway' };
262:   membership = null;
263:   runInAction(() => {
264:     Band.instrument = null;
265:     Band.phase = 'idle';
266:     Band.windowOpen = false;
267:     Band.role = 'solo';
268:     Band.band = null;
269:   });
270: }
