  94: /**
  95:  * Per-bone AABB of the vertices each bone drives, in the mesh's vertex space
  96:  * (6 floats per bone, min xyz / max xyz; +Inf min marks an unused bone).
  97:  * The BMD→GLB converter stores vertices relative to their bone, so the
  98:  * unskinned bounding box collapses near the origin; this table, transformed by
  99:  * the skeleton's current bone matrices, gives the posed bounds without
 100:  * re-skinning the vertices on the CPU. Computed once per *geometry*.
 101:  */
 102: function boneLocalBounds(
 103:   mesh: AbstractMesh,
 104:   boneCount: number
 105: ): Float32Array | null {
 106:   const key = vertexDataKey(mesh);
 107:   const cached = boneBoundsCache.get(key);
 108:   if (cached !== undefined) return cached;
 109: 
 110:   const positions = mesh.getVerticesData('position');
 111:   const indices = mesh.getVerticesData('matricesIndices');
 112:   const weights = mesh.getVerticesData('matricesWeights');
 113:   if (!positions || !indices) {
 114:     boneBoundsCache.set(key, null);
 115:     return null;
 116:   }
 117: 
 118:   const bounds = new Float32Array(boneCount * 6);
 119:   for (let b = 0; b < boneCount; b++) {
 120:     bounds.fill(Number.POSITIVE_INFINITY, b * 6, b * 6 + 3);
 121:     bounds.fill(Number.NEGATIVE_INFINITY, b * 6 + 3, b * 6 + 6);
 122:   }
 123: 
 124:   const vertexCount = positions.length / 3;
 125:   for (let v = 0; v < vertexCount; v++) {
 126:     // Dominant influence (the loader sets numBoneInfluencers = 1 anyway).
 127:     let bone = indices[v * 4];
 128:     if (weights) {
 129:       let best = weights[v * 4];
 130:       for (let k = 1; k < 4; k++) {
 131:         if (weights[v * 4 + k] > best) {
 132:           best = weights[v * 4 + k];
 133:           bone = indices[v * 4 + k];
 134:         }
 135:       }
 136:     }
 137:     if (bone < 0 || bone >= boneCount) continue;
 138: 
 139:     const o = bone * 6;
 140:     const x = positions[v * 3];
 141:     const y = positions[v * 3 + 1];
 142:     const z = positions[v * 3 + 2];
 143:     if (x < bounds[o]) bounds[o] = x;
 144:     if (y < bounds[o + 1]) bounds[o + 1] = y;
 145:     if (z < bounds[o + 2]) bounds[o + 2] = z;
 146:     if (x > bounds[o + 3]) bounds[o + 3] = x;
 147:     if (y > bounds[o + 4]) bounds[o + 4] = y;
 148:     if (z > bounds[o + 5]) bounds[o + 5] = z;
 149:   }
 150: 
 151:   boneBoundsCache.set(key, bounds);
 152:   return bounds;
 153: }
