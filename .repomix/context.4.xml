264:     for (let i = 0; i < blockSize; i++) {
265:       checksum ^= inputBuffer[i];
266:     }
267: 
268:     size ^= checksum;
269: 
270:     this.ShiftBytes(outputBuffer, 0x48, castToUInt(checksum << 8 | size), 0x00, 0x10);
271:   }
272: 
273:   SetRingBuffer(inputBuffer: Uint8Array, blockSize: Int): void {
274:     const keys = this.encryptionKeys;
275:     const halfBlockSize = integerDevision(blockSize / 2);
276:     ArrayClear(this.CryptBuffer, halfBlockSize, this.CryptBuffer.length - halfBlockSize); // we don't need to clear the whole array since parts are getting overriden by the input buffer
277:     BufferBlockCopy(inputBuffer, 0, this.CryptBuffer, 0, blockSize);
278:     this.RingBuffer[0] = ((keys.XorKey[0] ^ this.CryptBuffer[0]) * keys.EncryptKey[0]) % keys.ModulusKey[0];
279:     this.RingBuffer[1] = ((keys.XorKey[1] ^ (this.CryptBuffer[1] ^ (this.RingBuffer[0] & 0xFFFF))) * keys.EncryptKey[1]) % keys.ModulusKey[1];
280:     this.RingBuffer[2] = ((keys.XorKey[2] ^ (this.CryptBuffer[2] ^ (this.RingBuffer[1] & 0xFFFF))) * keys.EncryptKey[2]) % keys.ModulusKey[2];
281:     this.RingBuffer[3] = ((keys.XorKey[3] ^ (this.CryptBuffer[3] ^ (this.RingBuffer[2] & 0xFFFF))) * keys.EncryptKey[3]) % keys.ModulusKey[3];
282:     BufferBlockCopy(this.CryptBuffer, 0, inputBuffer, 0, blockSize);
283:     this.RingBuffer[0] = this.RingBuffer[0] ^ keys.XorKey[0] ^ (this.RingBuffer[1] & 0xFFFF);
284:     this.RingBuffer[1] = this.RingBuffer[1] ^ keys.XorKey[1] ^ (this.RingBuffer[2] & 0xFFFF);
285:     this.RingBuffer[2] = this.RingBuffer[2] ^ keys.XorKey[2] ^ (this.RingBuffer[3] & 0xFFFF);
286:   }
287: 
288:   ShiftBytes(outputBuffer: Uint8Array, outputOffset: Int, shift: UInt, shiftOffset: Int, length: Int): void {
289:     const size: Int = this.GetShiftSize(length, shiftOffset);
290:     this.ShiftBuffer[2] = 0; // the first two bytes will be set at the next statement
291:     SimpleModulusEncryptor.CopyIntToArray(this.ShiftBuffer, shift, integerDevision(shiftOffset / DecryptedBlockSize), size);
292:     this.InternalShiftBytes(outputBuffer, outputOffset, this.ShiftBuffer, shiftOffset, size);
293:   }
294: }
295: 
296: export class SimpleModulusDecryptor extends SimpleModulusBase {
297:   static DefaultServerKey = SimpleModulusKeys.CreateDecryptionKeys([128079, 164742, 70235, 106898, 31544, 2047, 57011, 10183, 48413, 46165, 15171, 37433]);
298:   static DefaultClientKey = SimpleModulusKeys.CreateDecryptionKeys([73326, 109989, 98843, 171058, 18035, 30340, 24701, 11141, 62004, 64409, 35374, 64599]);
299: 
300:   decryptionKeys = SimpleModulusDecryptor.DefaultServerKey;
301:   readonly shiftArray = new Uint8Array(4);
302: 
303:   /**
304:    * Reject blocks whose checksum does not match, as OpenMU's decryptor does by
305:    * default (`AcceptWrongBlockChecksum` is false there too): with the size
306:    * check alone ~1% of random garbage still passes, with the checksum none does.
307:    * Set to true to only take the size check (`lastError` then stays null).
308:    */
309:   public AcceptWrongBlockChecksum = false;
310: 
311:   /**
312:    * Why the last `Decrypt` call failed (or "counter ..." when it resynced),
313:    * for the caller's log line. Null when the last packet was clean.
314:    */
315:   public lastError: string | null = null;
316: 
317:   /**
318:    * Decrypts a C3/C4 packet and returns it with its own (smaller) length
319:    * header; C1/C2 pass through. The caller keeps advancing its byte queue by
320:    * the *wire* length - only the returned packet is the decrypted size.
321:    *
322:    * The first decrypted byte is a per-packet counter that must match ours.
323:    * OpenMU disconnects on a mismatch (InvalidPacketCounterException); a client
324:    * cannot afford that, so when the blocks themselves decode cleanly we
325:    * *resync* to the received counter and accept the packet - one lost or
326:    * duplicated packet then costs nothing, and `lastError` says "counter" so
327:    * the caller can log it. Only a packet whose blocks are malformed (content
328:    * not a multiple of 11 bytes, block size > 8, bad checksum when rejected)
329:    * is reported as failed.
330:    */
331:   Decrypt(packet: Uint8Array): [boolean, Uint8Array] {
332:     this.lastError = null;
333: 
334:     if (packet[0] < 0xC3) {
335:       return [true, packet];
336:     }
337: 
338:     const r = this.DecryptC3(packet);
339: 
340:     if (r == null) {
341:       // Malformed blocks: the counter byte is meaningless, so leave ours
342:       // untouched - the next well-formed packet resyncs it if needed.
343:       return [false, packet];
344:     }
345: 
346:     const [received, decrypted] = r;
347: 
348:     if (this.Counter.Count !== received) {
349:       this.lastError = `counter (expected ${this.Counter.Count}, got ${received})`;
350:       this.Counter.Count = received;
351:     }
352: 
353:     this.Counter.Increase();
354: 
355:     return [true, decrypted];
356:   }
357: 
358:   private DecryptC3(data: Uint8Array): [Byte, Uint8Array] | null {
359:     const contentSize = this.GetContentSize(data, false);
360:     const headerSize = getPacketHeaderSize(data);
361: 
362:     if (contentSize <= 0 || (contentSize % EncryptedBlockSize) !== 0) {
363:       this.lastError = `content size ${contentSize} is not a multiple of ${EncryptedBlockSize}`;
364:       return null;
365:     }
366: 
367:     let result = new Uint8Array(this.GetMaximumDecryptedSize(data));
368:     let decryptedSize = this.DecodeBuffer(data, headerSize, contentSize, result);
369: 
370:     if (decryptedSize < 0) {
371:       return null;
372:     }
373: 
374:     decryptedSize += headerSize - 1;
375:     const decryptedCount = result[headerSize - 1];
376:     result[0] = data[0];
377:     result = ArrayResize(result, decryptedSize);
378:     setPacketSize(result);
379: 
380:     return [decryptedCount, result];
381:   }
382: 
383:   /** Returns the decrypted content size, or -1 when a block is malformed. */
384:   private DecodeBuffer(inputBuffer: Uint8Array, offset: Int, size: Int, result: Uint8Array): Int {
385:     let sizeCounter: Int = 0;
386: 
387:     for (let i = 0; i < size; i += EncryptedBlockSize) {
388:       BufferBlockCopy(inputBuffer, i + offset, this.EncryptedBlockBuffer, 0, EncryptedBlockSize);
389:       const blockSize = this.BlockDecode(this.DecryptedBlockBuffer, this.EncryptedBlockBuffer);
390:       if (blockSize < 0) {
391:         return -1;
392:       }
393: 
394:       BufferBlockCopy(this.DecryptedBlockBuffer, 0, result, (offset - 1) + sizeCounter, blockSize);
395:       sizeCounter += blockSize;
396:     }
397: 
398:     return sizeCounter;
399:   }
400: 
401:   BlockDecode(outputBuffer: Uint8Array, inputBuffer: Uint8Array): Int {
402:     this.ClearShiftBuffer();
403:     this.ShiftBytes(this.ShiftBuffer, 0x00, inputBuffer, 0x00, 0x10);
404:     this.ShiftBytes(this.ShiftBuffer, 0x16, inputBuffer, 0x10, 0x02);
405:     BufferBlockCopy(this.ShiftBuffer, 0, this.RingBuffer, 0, 4);
406:     this.ClearShiftBuffer();
407:     this.ShiftBytes(this.ShiftBuffer, 0x00, inputBuffer, 0x12, 0x10);
408:     this.ShiftBytes(this.ShiftBuffer, 0x16, inputBuffer, 0x22, 0x02);
409:     BufferBlockCopy(this.ShiftBuffer, 0, this.RingBuffer, 4, 4);
410:     this.ClearShiftBuffer();
411:     this.ShiftBytes(this.ShiftBuffer, 0x00, inputBuffer, 0x24, 0x10);
412:     this.ShiftBytes(this.ShiftBuffer, 0x16, inputBuffer, 0x34, 0x02);
413:     BufferBlockCopy(this.ShiftBuffer, 0, this.RingBuffer, 8, 4);
414:     this.ClearShiftBuffer();
415:     this.ShiftBytes(this.ShiftBuffer, 0x00, inputBuffer, 0x36, 0x10);
416:     this.ShiftBytes(this.ShiftBuffer, 0x16, inputBuffer, 0x46, 0x02);
417: 
418:     BufferBlockCopy(this.ShiftBuffer, 0, this.RingBuffer, 12, 4);
419:     var keys = this.decryptionKeys;
420:     this.RingBuffer[2] = this.RingBuffer[2] ^ keys.XorKey[2] ^ (this.RingBuffer[3] & 0xFFFF);
421:     this.RingBuffer[1] = this.RingBuffer[1] ^ keys.XorKey[1] ^ (this.RingBuffer[2] & 0xFFFF);
422:     this.RingBuffer[0] = this.RingBuffer[0] ^ keys.XorKey[0] ^ (this.RingBuffer[1] & 0xFFFF);
423: 
424:     this.CryptBuffer[0] = castToUShort(keys.XorKey[0] ^ ((this.RingBuffer[0] * keys.DecryptKey[0]) % keys.ModulusKey[0]));
425:     this.CryptBuffer[1] = castToUShort(keys.XorKey[1] ^ ((this.RingBuffer[1] * keys.DecryptKey[1]) % keys.ModulusKey[1]) ^ (this.RingBuffer[0] & 0xFFFF));
426:     this.CryptBuffer[2] = castToUShort(keys.XorKey[2] ^ ((this.RingBuffer[2] * keys.DecryptKey[2]) % keys.ModulusKey[2]) ^ (this.RingBuffer[1] & 0xFFFF));
427:     this.CryptBuffer[3] = castToUShort(keys.XorKey[3] ^ ((this.RingBuffer[3] * keys.DecryptKey[3]) % keys.ModulusKey[3]) ^ (this.RingBuffer[2] & 0xFFFF));
428: 
429:     return this.DecodeFinal(inputBuffer, outputBuffer);
430:   }
431: 
432:   private DecodeFinal(inputBuffer: Uint8Array, outputBuffer: Uint8Array): Int {
433:     this.ClearShiftBuffer();
434:     this.ShiftBytes(this.ShiftBuffer, 0x00, inputBuffer, 0x48, 0x10);
435: 
436:     // ShiftBuffer[0] -> block size (decrypted)
437:     // ShiftBuffer[1] -> checksum
438:     const blockSize: Byte = castToByte(this.ShiftBuffer[0] ^ this.ShiftBuffer[1] ^ BlockSizeXorKey);
439: 
440:     if (blockSize > DecryptedBlockSize) {
441:       // Garbage block (wrong key or corrupted stream). Copying `blockSize`
442:       // bytes out of the 8-byte CryptBuffer would throw a RangeError, which
443:       // used to escape the socket's packet loop and jam it for good.
444:       this.lastError = `block size ${blockSize} > ${DecryptedBlockSize}`;
445:       return -1;
446:     }
447: 
448:     // The checksum covers the whole 8-byte block (zero padded), as in
449:     // OpenMU's PipelinedSimpleModulusDecryptor.DecodeFinal.
450:     BufferBlockCopy(this.CryptBuffer, 0, outputBuffer, 0, DecryptedBlockSize);
451:     let checksum: Byte = BlockCheckSumXorKey;
452:     for (let i = 0; i < DecryptedBlockSize; i++) {
453:       checksum ^= outputBuffer[i];
454:     }
455: 
456:     if (this.ShiftBuffer[1] !== checksum && !this.AcceptWrongBlockChecksum) {
457:       this.lastError = `checksum (expected ${checksum}, got ${this.ShiftBuffer[1]})`;
458:       return -1;
459:     }
460: 
461:     return blockSize;
462:   }
463: 
464:   private ShiftBytes(outputBuffer: Uint8Array, outputOffset: Int, inputBuffer: Uint8Array, shiftOffset: Int, length: Int): void {
465:     const size: Int = this.GetShiftSize(length, shiftOffset);
466:     this.shiftArray[1] = 0;
467:     this.shiftArray[2] = 0;
468:     this.shiftArray[3] = 0;
469: 
470:     ArrayCopy(inputBuffer, integerDevision(shiftOffset / DecryptedBlockSize), this.shiftArray, 0, size);
471: 
472:     var tempShift = (length + shiftOffset) & 0x7;
473:     if (tempShift != 0) {
474:       this.shiftArray[size - 1] = castToByte(this.shiftArray[size - 1] & 0xFF << (8 - tempShift));
475:     }
476: 
477:     this.InternalShiftBytes(outputBuffer, outputOffset, this.shiftArray, shiftOffset, size);
478:   }
479: 
480:   private GetMaximumDecryptedSize(packet: Uint8Array): Int {
481:     return (integerDevision(this.GetContentSize(packet, false) / EncryptedBlockSize) * DecryptedBlockSize) + getPacketHeaderSize(packet) - 1;
482:   }
483: }
</file>

