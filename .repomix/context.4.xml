272: const CODE_LABELS: Record<string, string> = {
273:   Backquote: '` / º',
274:   Tab: 'Tab',
275:   Space: 'Space',
276:   Minus: '-',
277:   Equal: '=',
278:   BracketLeft: '[',
279:   BracketRight: ']',
280:   Backslash: '\\',
281:   Semicolon: ';',
282:   Quote: "'",
283:   Comma: ',',
284:   Period: '.',
285:   Slash: '/',
286:   Backspace: 'Backspace',
287:   Delete: 'Del',
288:   Insert: 'Ins',
289:   Home: 'Home',
290:   End: 'End',
291:   PageUp: 'PgUp',
292:   PageDown: 'PgDn',
293:   CapsLock: 'Caps',
294:   IntlBackslash: '< >',
295:   NumpadAdd: 'Num +',
296:   NumpadSubtract: 'Num -',
297:   NumpadMultiply: 'Num *',
298:   NumpadDivide: 'Num /',
299:   NumpadDecimal: 'Num .',
300: };
301: 
302: /** Short, human-readable name of a `KeyboardEvent.code`. */
303: export function keyLabel(code: string): string {
304:   if (code === '') return '-';
305:   if (CODE_LABELS[code]) return CODE_LABELS[code];
306:   const letter = /^Key([A-Z])$/.exec(code);
307:   if (letter) return letter[1];
308:   const arrow = /^Arrow(\w+)$/.exec(code);
309:   if (arrow) return arrow[1];
310:   return code;
311: }
