  79: const snowCapGlsl = (albedo: string) => `
  80:   {
  81:     float muCap = ${SNOW_CAP_UNIFORM} * ${INSTANCE_VARYING}.a;
  82:     if (muCap > 0.0) {
  83:       float capKnee = mix(${f(SNOW_CAP_KNEE_THIN)}, ${f(SNOW_CAP_KNEE_FULL)}, muCap);
  84:       float cap = smoothstep(capKnee - 0.12, capKnee + 0.12, normalW.y) * muCap;
  85:       ${albedo}.rgb = mix(${albedo}.rgb, vec3(${f(SNOW_CAP_COLOUR[0])}, ${f(
  86:   SNOW_CAP_COLOUR[1]
  87: )}, ${f(SNOW_CAP_COLOUR[2])}), cap);
  88:     }
  89:   }
  90: `;
  91: const f = (n: number) => n.toFixed(3);
