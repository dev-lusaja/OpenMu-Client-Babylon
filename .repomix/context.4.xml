1636:   /**
1637:    * Optional model-less pick box in local tile units (Babylon Y-up), mirroring
1638:    * the fixed `BoundingBoxMin/Max` the original assigns to invisible operate
1639:    * triggers (pose boxes: `(-40,-40,0)…(40,40,160)`, ZzzObject.cpp:4585).
1640:    * Used when the object has no mesh to derive bounds from.
1641:    */
1642:   FixedBoundingBox: { min: Vector3; max: Vector3 } | null = null;
1643: 
1644:   private _boundsFrameId = -1;
1645: 
1646:   /**
1647:    * World-space AABB of the model, like the original's per-model
1648:    * `BoundingBoxMin/Max` transformed by the object matrix: the mesh's
1649:    * bind-pose bounds under the current node transform (bone-linked children
1650:    * follow their bones). It deliberately does not re-skin the vertices on the
1651:    * CPU (`refreshBoundingInfo(true)`) - that cost ~10 ms per character per
1652:    * call and was being called by three systems per frame.
1653:    *
1654:    * Memoised per frame so the cursor, pointer and debug systems share one
1655:    * computation.
1656:    */
1657:   UpdateBoundings() {
1658:     const frameId = this.scene.getFrameId();
1659:     if (frameId === this._boundsFrameId) return;
1660:     this._boundsFrameId = frameId;
1661: 
1662:     // The original overwrites `BoundingBoxMax` outright for operate boxes
1663:     // (ZzzObject.cpp:4585), so a fixed box wins over the model's own even
1664:     // when the model is loaded and merely hidden.
1665:     if (!this.gltf || this.FixedBoundingBox) {
1666:       const fixed = this.FixedBoundingBox;
1667:       if (!fixed) return;
1668:       const p = this._node.position;
1669:       const s = this._node.scaling.x || 1;
1670:       this.BoundingBoxLocal.minimumWorld.set(
1671:         p.x + fixed.min.x * s,
1672:         p.y + fixed.min.y * s,
1673:         p.z + fixed.min.z * s
1674:       );
1675:       this.BoundingBoxLocal.maximumWorld.set(
1676:         p.x + fixed.max.x * s,
1677:         p.y + fixed.max.y * s,
1678:         p.z + fixed.max.z * s
1679:       );
1680:       return;
1681:     }
1682: 
1683:     // Union of the child meshes' world AABBs as Babylon left them after the
1684:     // last world-matrix pass (at most one frame old). Not
1685:     // getHierarchyBoundingVectors(): that calls scene.incrementRenderId(),
1686:     // invalidating every cached world matrix in the scene, and force-recomputes
1687:     // every descendant node (all skeleton joints included) - ~10 ms per
1688:     // character.
1689:     const meshes = this._node.getChildMeshes(
1690:       false,
1691:       n => !(n as AbstractMesh).metadata?.SkipBoundingBox
1692:     );
1693: 
1694:     const min = this.BoundingBoxLocal.minimumWorld;
1695:     const max = this.BoundingBoxLocal.maximumWorld;
1696:     min.setAll(Number.MAX_VALUE);
1697:     max.setAll(-Number.MAX_VALUE);
1698: 
1699:     for (const mesh of meshes) {
1700:       if (mesh.getTotalVertices() === 0) continue;
1701:       if (mesh.skeleton && extendBySkinnedBounds(mesh, min, max)) continue;
1702:       const box = mesh.getBoundingInfo().boundingBox;
1703:       Vector3.CheckExtends(box.minimumWorld, min, max);
1704:       Vector3.CheckExtends(box.maximumWorld, min, max);
1705:     }
1706:   }
1707: 
1708:   /**
1709:    * Extra height in world units the model floats at, on top of the terrain
1710:    * height its entity carries. The original writes these straight into
1711:    * `o->Position[2]` right after `RequestTerrainHeight`: +30 (or +90 in
1712:    * Tarkan / Heaven) for a Dinorant rider (ZzzCharacter.cpp:6263-6273) and the
1713:    * Budge Dragon's `(-|sin(Timer)| * 70 + 70)` bob (:6274-6277).
1714:    */
1715:   HoverHeight = 0;
1716: 
1717:   updateLocation(pos: IVector3Like, scale: Float, angles: IVector3Like) {
1718:     this._node.position.set(pos.x, pos.y + this.HoverHeight, pos.z);
1719: 
1720:     this._node.rotation.x = angles.x;
1721:     this._node.rotation.y = angles.y;
1722:     this._node.rotation.z = angles.z;
1723: 
1724:     this._node.scaling.setAll(scale);
1725:   }
1726: 
1727:   Unload() {
1728:     this.loadSeq++;
1729:     this.Ready = false;
1730:     this._frustumMeshes = [];
1731: 
1732:     for (const shadow of this._shadows) shadow?.dispose(false, false);
1733:     this._shadows = [];
1734:     this._shadowSlotsBarren = [];
1735:     this._shadowsVisible = null;
1736:     this._shadowsSerial = -1;
1737: 
1738:     if (this.gltf) {
1739:       this.gltf.mesh.dispose(false, false);
1740:       this.gltf.skeleton?.dispose();
1741:       this.gltf.animationGroups.forEach(group => {
1742:         group.dispose();
1743:       });
1744:       this.gltf = null;
1745:     }
1746:   }
1747: 
1748:   dispose(): void {
1749:     this.#disposed = true;
1750:     this.Lights?.dispose();
1751:     this.Lights = null;
1752: 
1753:     for (const shadow of this._shadows) shadow?.dispose(false, false);
1754: 
1755:     this._shadows = [];
1756: 
1757:     this._node.dispose();
1758:     this._boneSocket?.dispose();
1759:     this._boneSocket = null;
1760:     if (this.gltf) {
1761:       disposeGltf(this.gltf);
1762:       this.gltf = null;
1763:     }
1764: 
1765:     this.Ready = false;
1766: 
1767:     for (const child of this.Children) {
1768:       child.dispose();
1769:     }
1770: 
1771:     this.Children.length = 0;
1772:   }
1773: 
1774:   protected async loadSpecificModel(modelName: string) {
1775:     this.load(await loadGLTF(`${this.objectDir}${modelName}`, storeRef().world!));
1776:   }
1777: 
1778:   protected async loadSpecificModelWithDynamicID(
1779:     modelId: number,
1780:     namePrefix: string
1781:   ) {
1782:     const idx = (this.Type - modelId + 1).toString().padStart(2, '0');
1783:     const name = `${namePrefix}${idx}.glb`;
1784:     await this.loadSpecificModel(name);
1785:   }
1786: }
