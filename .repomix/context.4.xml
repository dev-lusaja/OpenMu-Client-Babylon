186: /**
187:  * The scrolling variants, kept in their own cache and deliberately **not**
188:  * shared with `getMaterial`.
189:  *
190:  * The UV-scroll uniform and its extra texel fetch exist on perhaps twenty
191:  * meshes in the whole game - Dungeon's flesh curtains, Noria's waterfalls,
192:  * Lost Tower's conduits, Stadium's fountain, Tarkan's sand-falls. Putting
193:  * them on the shared bright/flat-lit materials meant recompiling the shader
194:  * that draws *every* additive card in the game, foliage included, to serve
195:  * those twenty. That is a bad trade even when it works, and it is an
196:  * unnecessary one: a separate variant leaves the shared material byte-for-byte
197:  * what it was.
198:  */
199: const scrollMaterialsCache: Map<string, ItemMaterial> = new Map();
200: 
201: export function getScrollMaterial(
202:   scene: Scene,
203:   backFaceCulling: boolean,
204:   transparencyMode: number,
205:   alphaMode: BlendState,
206:   bright: boolean,
207:   flatLit: boolean
208: ): ItemMaterial {
209:   const name = `scroll_${backFaceCulling}_${transparencyMode}_${BlendState[alphaMode]}${
210:     bright ? '_bright' : ''
211:   }${flatLit ? '_flat' : ''}`;
212: 
213:   const cached = scrollMaterialsCache.get(name);
214:   if (cached) return cached;
215: 
216:   const material = createItemMaterial(scene, bright, flatLit, true);
217: 
218:   material.name = name;
219:   material.backFaceCulling = backFaceCulling;
220:   material.transparencyMode = transparencyMode;
221:   material.alphaMode = alphaMode;
222: 
223:   // Same rule as getMaterial: double-sided lit surfaces flip the normal.
224:   if (!backFaceCulling && !bright && !flatLit) {
225:     material.twoSidedLighting = true;
226:   }
227: 
228:   if (bright) material.disableDepthWrite = true;
229: 
230:   if (transparencyMode === ALPHA_TEST_AND_BLEND) {
231:     material.forceDepthWrite = true;
232:     material.alphaCutOff = ALPHA_TEST_CUTOFF;
233:   }
234: 
235:   // Every off-screen pass (G-buffer, cascades, glow layer) alpha-tests
236:   // against whatever getAlphaTestTexture() returns and never runs the bind
237:   // observable that hands over the mesh's real texture.
238:   useMeshAlphaTestTexture(material);
239: 
240:   material.freeze();
241: 
242:   scrollMaterialsCache.set(name, material);
243: 
244:   // Deliberately not in `materialArgs`: a quality flip must not re-resolve
245:   // these back to the shared non-scrolling material. Nothing is lost - bright
246:   // and flat-lit never take the PBR path anyway.
247:   return material;
248: }
