  1: import { describe, expect, it } from 'vitest';
  2: import {
  3:   CHAT_LOG_CLIENT_WIDTH,
  4:   chatPkClass,
  5:   chatSenderPrefix,
  6:   splitChatLine,
  7: } from './chat';
  8: 
  9: /** A fixed-width face, so the expected break is arithmetic rather than a guess. */
 10: const CHAR = 6;
 11: const measure = (text: string) => text.length * CHAR;
 12: 
 13: /** How many characters of a prefixless line fit on one row. */
 14: const FITS = Math.floor(CHAT_LOG_CLIENT_WIDTH / CHAR);
 15: 
 16: /** The longest thing OpenMU sends, and the one the log used to cut. */
 17: const LOGIN_WARNING =
 18:   "Another user attempted to login this account. If it wasn't you, we suggest" +
 19:   ' you to change your password.';
 20: 
 21: describe('splitChatLine', () => {
 22:   it('leaves a line that fits alone', () => {
 23:     expect(splitChatLine('', 'Elfita entered the game.', CHAT_LOG_CLIENT_WIDTH, measure)).toEqual([
 24:       'Elfita entered the game.',
 25:     ]);
 26:   });
 27: 
 28:   it('never measures a short line', () => {
 29:     expect(splitChatLine('', 'hi there', 0, measure)).toEqual(['hi there']);
 30:   });
 31: 
 32:   it('keeps all of a long line, breaking at the spaces that fit', () => {
 33:     const rows = splitChatLine('', LOGIN_WARNING, CHAT_LOG_CLIENT_WIDTH, measure);
 34: 
 35:     expect(rows.length).toBeGreaterThan(2);
 36:     for (const row of rows) {
 37:       expect(measure(row)).toBeLessThanOrEqual(CHAT_LOG_CLIENT_WIDTH);
 38:       expect(row.endsWith(' ')).toBe(false);
 39:     }
 40:     expect(rows.join(' ')).toBe(LOGIN_WARNING);
 41:   });
 42: 
 43:   it('takes the prefix out of the first row only', () => {
 44:     const text = 'a '.repeat(FITS).trim();
 45:     const prefix = chatSenderPrefix({ sender: 'Elfita' });
 46:     const alone = splitChatLine('', text, CHAT_LOG_CLIENT_WIDTH, measure);
 47:     const named = splitChatLine(prefix, text, CHAT_LOG_CLIENT_WIDTH, measure);
 48: 
 49:     expect(named[0].length).toBeLessThan(alone[0].length);
 50:     expect(measure(prefix + named[0])).toBeLessThanOrEqual(CHAT_LOG_CLIENT_WIDTH);
 51:     expect(measure(named[1])).toBeLessThanOrEqual(CHAT_LOG_CLIENT_WIDTH);
 52:   });
 53: 
 54:   it('charges the guild tag to the first row as well', () => {
 55:     const text = 'a '.repeat(FITS).trim();
 56:     const bare = chatSenderPrefix({ sender: 'Elfita' });
 57:     const tagged = chatSenderPrefix({ sender: 'Elfita', senderGuild: 'Ignies' });
 58: 
 59:     const plain = splitChatLine(bare, text, CHAT_LOG_CLIENT_WIDTH, measure);
 60:     const withTag = splitChatLine(tagged, text, CHAT_LOG_CLIENT_WIDTH, measure);
 61: 
 62:     expect(withTag[0].length).toBeLessThan(plain[0].length);
 63:     expect(measure(tagged + withTag[0])).toBeLessThanOrEqual(CHAT_LOG_CLIENT_WIDTH);
 64:   });
 65: 
 66:   it('cuts mid-word when one word is wider than the log', () => {
 67:     const text = 'x'.repeat(FITS * 2);
 68:     const rows = splitChatLine('', text, CHAT_LOG_CLIENT_WIDTH, measure);
 69: 
 70:     expect(measure(rows[0])).toBeLessThanOrEqual(CHAT_LOG_CLIENT_WIDTH);
 71:     expect(rows.join('')).toBe(text);
 72:   });
 73: 
 74:   it('gives up rather than looping on a width nothing fits in', () => {
 75:     expect(splitChatLine('', 'wwwwwwwwwwwwwwwwwwwwww', 1, measure)).toEqual([
 76:       'wwwwwwwwwwwwwwwwwwwwww',
 77:     ]);
 78:   });
 79: });
 80: 
 81: describe('chatSenderPrefix', () => {
 82:   it('is empty without a sender', () => {
 83:     expect(chatSenderPrefix({ sender: '' })).toBe('');
 84:   });
 85: 
 86:   it('puts the guild tag in front of the name', () => {
 87:     expect(chatSenderPrefix({ sender: 'Elfita', senderGuild: 'Ignies' })).toBe(
 88:       '[Ignies] Elfita : '
 89:     );
 90:   });
 91: 
 92:   it('leaves the tag out when the speaker has no guild', () => {
 93:     expect(chatSenderPrefix({ sender: 'Elfita' })).toBe('Elfita : ');
 94:   });
 95: });
 96: 
 97: describe('chatPkClass', () => {
 98:   it('has a class for every hero and outlaw level', () => {
 99:     expect(chatPkClass(1)).toBe('pk-hero2');
100:     expect(chatPkClass(2)).toBe('pk-hero1');
101:     expect(chatPkClass(3)).toBe('pk-neutral');
102:     expect(chatPkClass(4)).toBe('pk-caution');
103:     expect(chatPkClass(5)).toBe('pk-murderer1');
104:     expect(chatPkClass(6)).toBe('pk-murderer2');
105:   });
106: 
107:   it('keeps the murderer colour above the last level, as the original does', () => {
108:     expect(chatPkClass(7)).toBe('pk-murderer2');
109:     expect(chatPkClass(9)).toBe('pk-murderer2');
110:   });
111: 
112:   it('says nothing for a speaker whose state never arrived', () => {
113:     expect(chatPkClass(undefined)).toBe('');
114:   });
115: });
