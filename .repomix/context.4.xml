267:   const [backFaceCulling, transparencyMode, alphaMode] = args;
268: 
269:   return getScrollMaterial(
270:     scene,
271:     backFaceCulling,
272:     transparencyMode,
273:     alphaMode,
274:     false,
275:     true
276:   );
277: }
