253: /**
254:  * `ReceiveChat`: the server sends party / guild / alliance / gens lines as
255:  * normal chat with a prefix; the prefix picks the log type and is stripped.
256:  * Returns `balloon: false` for the kinds the original never puts over a head.
257:  */
258: export function classifyInboundChat(message: string): {
259:   type: ChatLineType;
260:   text: string;
261:   balloon: boolean;
262: } {
263:   if (message.startsWith('~')) {
264:     return { type: ChatLineType.Party, text: message.slice(1), balloon: false };
265:   }
266:   if (message.startsWith('@@')) {
267:     return { type: ChatLineType.Union, text: message.slice(2), balloon: false };
268:   }
269:   if (message.startsWith('@')) {
270:     return { type: ChatLineType.Guild, text: message.slice(1), balloon: false };
271:   }
272:   if (message.startsWith('$')) {
273:     return { type: ChatLineType.Gens, text: message.slice(1), balloon: false };
274:   }
275:   if (message.startsWith('#')) {
276:     // A GM shout; plain players get it as a (framed) balloon too.
277:     return { type: ChatLineType.GM, text: message.slice(1), balloon: true };
278:   }
279:   return { type: ChatLineType.Chat, text: message, balloon: true };
280: }
281: 
282: /**
283:  * Strip the C string padding the packets carry: NUL fill on either side
284:  * (the generated readers stop at the first NUL, but a field can start with
285:  * one) and surrounding blanks.
286:  */
287: export function cleanName(raw: string): string {
288:   return raw.replace(/^\0+|\0+$/g, '').trim();
289: }
