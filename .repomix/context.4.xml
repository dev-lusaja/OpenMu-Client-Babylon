<file path="src/common/guildMark.ts">
 1: /**
 2:  * Guild marks: an 8x8 bitmap of 4-bit palette indices, 32 bytes packed two
 3:  * pixels per byte (high nibble first), as `GuildInformation.Logo` and
 4:  * `GuildCreateRequest.GuildEmblem` carry it.
 5:  *
 6:  * `CreateGuildMark` (ZzzInventory.cpp:11204) is the palette: entry 0 is
 7:  * transparent, the rest are the 15 fixed colours of the mark editor.
 8:  */
 9: 
10: export const GUILD_MARK_SIZE = 8;
11: export const GUILD_MARK_BYTES = 32;
12: 
13: /** `MarkColor[i]` as CSS. Entry 0 is the transparent one. */
14: export const GUILD_MARK_PALETTE: string[] = [
15:   'transparent',
16:   'rgb(0,0,0)',
17:   'rgb(128,128,128)',
18:   'rgb(255,255,255)',
19:   'rgb(255,0,0)',
20:   'rgb(255,128,0)',
21:   'rgb(255,255,0)',
22:   'rgb(128,255,0)',
23:   'rgb(0,255,0)',
24:   'rgb(0,255,128)',
25:   'rgb(0,255,255)',
26:   'rgb(0,128,255)',
27:   'rgb(0,0,255)',
28:   'rgb(128,0,255)',
29:   'rgb(255,0,255)',
30:   'rgb(255,0,128)',
31: ];
32: 
33: /** Packed 32 bytes → 64 palette indices, row-major. */
34: export function unpackGuildMark(packed: ArrayLike<number>): number[] {
35:   const pixels = new Array<number>(GUILD_MARK_SIZE * GUILD_MARK_SIZE).fill(0);
36:   for (let i = 0; i < GUILD_MARK_BYTES && i < packed.length; i++) {
37:     const byte = packed[i] & 0xff;
38:     pixels[i * 2] = byte >> 4;
39:     pixels[i * 2 + 1] = byte & 0x0f;
40:   }
41:   return pixels;
42: }
43: 
44: /** 64 palette indices → the packed 32 bytes the packets want. */
45: export function packGuildMark(pixels: ArrayLike<number>): number[] {
46:   const packed = new Array<number>(GUILD_MARK_BYTES).fill(0);
47:   for (let i = 0; i < GUILD_MARK_BYTES; i++) {
48:     const hi = (pixels[i * 2] ?? 0) & 0x0f;
49:     const lo = (pixels[i * 2 + 1] ?? 0) & 0x0f;
50:     packed[i] = (hi << 4) | lo;
51:   }
52:   return packed;
53: }
54: 
55: export function isEmptyGuildMark(packed: ArrayLike<number>): boolean {
56:   for (let i = 0; i < packed.length; i++) if (packed[i]) return false;
57:   return true;
58: }
59: 
60: const dataUrlCache = new Map<string, string>();
61: 
62: /**
63:  * The mark as an SVG data URL (one `rect` per painted pixel), so it scales
64:  * crisply at any size. Cached by content.
65:  */
66: export function guildMarkDataUrl(packed: ArrayLike<number>): string {
67:   const key = Array.from(packed).join(',');
68:   const cached = dataUrlCache.get(key);
69:   if (cached) return cached;
70: 
71:   const pixels = unpackGuildMark(packed);
72:   let rects = '';
73:   for (let y = 0; y < GUILD_MARK_SIZE; y++) {
74:     for (let x = 0; x < GUILD_MARK_SIZE; x++) {
75:       const index = pixels[y * GUILD_MARK_SIZE + x];
76:       if (!index) continue;
77:       rects += `<rect x="${x}" y="${y}" width="1" height="1" fill="${GUILD_MARK_PALETTE[index]}"/>`;
78:     }
79:   }
80:   const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${GUILD_MARK_SIZE} ${GUILD_MARK_SIZE}" shape-rendering="crispEdges">${rects}</svg>`;
81:   const url = `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
82:   dataUrlCache.set(key, url);
83:   return url;
84: }
</file>

<file path="src/common/heroMoveTrace.ts">
 1: import { Store } from '../store';
 2: import type { Entity } from '../ecs/world';
 3: 
 4: /**
 5:  * Why the hero was just moved by the server.
 6:  *
 7:  * `ObjectMoved` (C1 15) is the only packet that repositions the hero without
 8:  * him walking there, so every unexplained jump in game is one of these. It
 9:  * arrives for a gate, for a teleport, for an `InstantMoveRequest` we asked
10:  * for - and for a resynchronisation, which is the server saying our idea of
11:  * where he stands drifted past its tolerance. Those cases are impossible to
12:  * tell apart from the outside, which is what makes a jump like this so hard
13:  * to chase from a bug report.
14:  *
15:  * So say it out loud. One line per jump, carrying what the client believed at
16:  * that moment: where it thought he stood, what walk it had last told the
17:  * server about, and which approach was driving him. A jump whose `sentWalk`
18:  * ends where the server put him is a walk we failed to stop; one with no walk
19:  * behind it at all is the server moving him on its own account.
20:  */
21: 
22: /** Below this a jump is the server nudging a rounding difference, not a move. */
23: const NOTABLE_TILES = 1.5;
24: 
25: export function traceHeroInstantMove(
26:   hero: Entity,
27:   to: { x: number; y: number },
28:   approach: { attack: Entity | null; cast: { x: number; y: number; range: number } | null }
29: ): void {
30:   const pos = hero.transform?.pos;
31:   if (!pos) return;
32: 
33:   const from = { x: Math.round(pos.x), y: Math.round(pos.z) };
34:   const tiles = Math.hypot(to.x - from.x, to.y - from.y);
35:   if (tiles < NOTABLE_TILES) return;
36: 
37:   const walk = Store.lastWalkRequest;
38:   const path = hero.pathfinding?.path;
39:   const attack = approach.attack?.transform?.pos;
40: 
41:   console.warn(
42:     `hero moved by server: ${tiles.toFixed(1)} tiles, ` +
43:       `(${from.x}, ${from.y}) -> (${to.x}, ${to.y})`,
44:     {
45:       skill: Store.currentSkill,
46:       // The walk the server was last told about. If it ends where the hero
47:       // was just put, the server was still walking one we thought we stopped.
48:       sentWalk: walk
49:         ? { from: [walk.x, walk.y], steps: walk.steps, msAgo: Math.round(performance.now() - walk.at) }
50:         : null,
51:       // What the client was steering by when the jump landed.
52:       walking: path ? path.length : 0,
53:       pathEnd: path?.length ? [path[path.length - 1].x, path[path.length - 1].y] : null,
54:       attackTarget: attack ? [Math.round(attack.x), Math.round(attack.z)] : null,
55:       castApproach: approach.cast ? [approach.cast.x, approach.cast.y, approach.cast.range] : null,
56:     }
57:   );
58: }
</file>

