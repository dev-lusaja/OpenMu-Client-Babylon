137: let timer: ReturnType<typeof setInterval> | null = null;
138: 
139: function startTimer(): void {
140:   if (timer) return;
141:   timer = setInterval(() => {
142:     sequencer.tick();
143:     runInAction(() => {
144:       Band.positionMs = sequencer.positionMs;
145:     });
146:     if (!sequencer.playing && timer) {
147:       clearInterval(timer);
148:       timer = null;
149:     }
150:   }, TICK_MS);
151: }
152: 
153: function stopTimer(): void {
154:   if (!timer) return;
155:   clearInterval(timer);
156:   timer = null;
157: }
