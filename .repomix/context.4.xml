<file path="src/common/gmNearby.ts">
 1: import { monsterDisplayName } from './monstersDatabase';
 2: import type { Entity } from '../ecs/world';
 3: 
 4: /**
 5:  * What is around the hero, from the entities the world holds.
 6:  *
 7:  * Split from `gmWorld.ts` so it can be tested: that one reads `Store`, which
 8:  * pulls in the whole client and a DOM with it. Everything here is arithmetic
 9:  * and sorting over data it is handed.
10:  */
11: 
12: /** MU tiles. Scope is smaller than this; it bounds the radar, not the query. */
13: export const RADAR_RANGE = 16;
14: 
15: export type NearbyKind = 'player' | 'monster' | 'npc';
16: 
17: export type Nearby = {
18:   netId: number;
19:   kind: NearbyKind;
20:   name: string;
21:   x: number;
22:   y: number;
23:   /** Chebyshev distance in tiles, which is how MU measures range. */
24:   distance: number;
25:   /** Players only. */
26:   isGm: boolean;
27:   guildId: number | null;
28:   dying: boolean;
29: };
30: 
31: /**
32:  * A monster with a name the server sent (a summon, a boss) keeps it; anything
33:  * else is looked up by its type number, which is what `/removenpc` and the
34:  * monster commands take anyway.
35:  */
36: function nameOf(entity: Entity, kind: NearbyKind): string {
37:   const given = entity.objectNameInWorld?.trim();
38:   if (given) return given;
39:   if (kind === 'player') return `#${entity.netId}`;
40:   return monsterDisplayName(entity.npcType ?? -1, `NPC ${entity.npcType ?? '?'}`);
41: }
42: 
43: function kindOf(entity: Entity): NearbyKind | null {
44:   if (entity.playerAnimation) return 'player';
45:   if (entity.monsterAnimation) return 'monster';
46:   // In scope with a type but no animation set: a stall, a gate guard, a
47:   // shopkeeper. Worth listing - `/removenpc` works on them too.
48:   return entity.npcType === undefined ? null : 'npc';
49: }
50: 
51: /**
52:  * The sorting and the arithmetic. `hx`/`hy` are the hero's tile; `entities` is
53:  * everything the world holds, hero and out-of-scope bodies included, which are
54:  * dropped here.
55:  */
56: export function nearbyOf(entities: Iterable<Entity>, hx: number, hy: number): Nearby[] {
57:   const nearby: Nearby[] = [];
58: 
59:   for (const entity of entities) {
60:     if (entity.localPlayer || entity.objOutOfScope) continue;
61:     if (entity.netId === undefined || !entity.transform) continue;
62: 
63:     const kind = kindOf(entity);
64:     if (!kind) continue;
65: 
66:     const x = Math.floor(entity.transform.pos.x);
67:     const y = Math.floor(entity.transform.pos.z);
68: 
69:     nearby.push({
70:       netId: entity.netId,
71:       kind,
72:       name: nameOf(entity, kind),
73:       x,
74:       y,
75:       distance: Math.max(Math.abs(x - hx), Math.abs(y - hy)),
76:       isGm: !!entity.isGm,
77:       guildId: entity.guild?.id ?? null,
78:       dying: !!entity.dying,
79:     });
80:   }
81: 
82:   // Players first, then by how close they are: the row a game master wants is
83:   // almost always the nearest person, not the nearest scorpion.
84:   nearby.sort((a, b) => {
85:     if (a.kind !== b.kind) return a.kind === 'player' ? -1 : b.kind === 'player' ? 1 : 0;
86:     return a.distance - b.distance;
87:   });
88: 
89:   return nearby;
90: }
</file>

