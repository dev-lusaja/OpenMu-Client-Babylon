244:     const now = gameTime.TotalGameTime.TotalSeconds;
245:     if (now < this.#nextFlame) return;
246:     this.#nextFlame = now + GREAT_DRAGON_FLAME_INTERVAL;
247: 
248:     for (const bone of GREAT_DRAGON_FLAME_BONES) {
249:       bonePos(entity, bone, tmpA, GREAT_DRAGON_FLAME_HEIGHT);
250:       effects.spawn('particles', world.scene, tmpA, {
251:         recipe: FLAME_TONGUES,
