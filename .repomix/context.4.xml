  1: import { ENUM_WORLD } from './types';
  2: import { loadGLTF } from './modelLoader';
  3: import { ModelObject } from './modelObject';
  4: import type { Entity, World } from '../ecs/world';
  5: 
  6: /**
  7:  * `Boids[]` - the ambient wildlife (GOBoid.cpp:814-1500).
  8:  *
  9:  * `GOBoid.cpp` has two halves and the clone only ever ported one. `Mounts[]`
 10:  * - pets, Fenrir, the Dark Lord's horse - is in `pets.ts` and
 11:  * `petSystem.ts`, cited line by line. `Boids[]` is everything else that
 12:  * moves in the world without being a monster: the birds over Lorencia, the
 13:  * bats in the Dungeon, Noria's butterflies, Blood Castle's crows, the fish
 14:  * over Atlans.
 15:  *
 16:  * It was never written. The giveaway was that the *sounds* had been:
 17:  * `sound/ambientBeds.ts` plays `aBird1`/`aBird2` in Lorencia and `aBat` in
 18:  * the Dungeon on the boids' own dice rolls, naming `MODEL_BIRD01` and
 19:  * `MODEL_BAT01` in its comments. Lorencia has been playing birdsong at an
 20:  * empty sky.
 21:  *
 22:  * ## Which map has what
 23:  *
 24:  * Two tables in the original agree and this is their intersection: what
 25:  * `LoadWorld` *loads* (MapManager.cpp:45-166, which also gives the folder
 26:  * each model comes from - never the current map's) and what `MoveBoids`
 27:  * *spawns* (GOBoid.cpp:1313-1375).
 28:  *
 29:  * The ground-crawling half of the spawner - Lorencia's river fish, the
 30:  * Dungeon's rats, Stadium's bugs, Tarkan's fireflies, Crywolf's scorpions
 31:  * (GOBoid.cpp:1690-1745) - is a second table with its own movement and is
 32:  * not here yet.
 33:  */
 34: 
 35: /**
 36:  * How many are in the air at once.
 37:  *
 38:  * `MAX_BOIDS` is 40 (_define.h:108) and taking it literally was wrong. That
 39:  * is the size of the original's *array*, shared with the event dragons and
 40:  * the ground-crawlers, and its population settles well below it because a
 41:  * boid flies out of range in a couple of seconds. Filling it instead - which
 42:  * is what happens when the spawn is not rate-limited - put two dozen birds in
 43:  * one shot, and the flocking then pulled them into a single dense knot.
 44:  *
 45:  * A flock reads as a flock at about a dozen.
 46:  */
 47: export const MAX_BOIDS = 13;
 48: 
 49: /** Seconds between spawns while there is room; the original has no gate. */
 50: export const SPAWN_INTERVAL = 0.55;
 51: 
 52: /** Seconds a boid takes to fade in, and to fade out before it is dropped. */
 53: export const FADE_IN = 1.1;
 54: export const FADE_OUT = 0.7;
 55: 
 56: /** Centimetres to world units: the original's positions are all in these. */
 57: export const MU_UNIT = 1 / 100;
 58: 
 59: /** The original steps its movement per 25 Hz tick. */
 60: export const TICKS_PER_SECOND = 25;
 61: 
 62: export type BoidKind = 'bird' | 'bat' | 'butterfly' | 'crow' | 'fish' | 'dragon';
 63: 
 64: export type BoidSpec = {
 65:   readonly kind: BoidKind;
 66:   /**
 67:    * The model, from the folder the original names - which is not the current
 68:    * map's: Noria's butterflies come out of `Object1`, and the Dungeon's bats
 69:    * out of `Object2` whether the hero is in the Dungeon or the Lost Tower.
 70:    */
 71:   readonly models: readonly string[];
 72:   readonly scale: number;
 73:   /** `o->Velocity` at spawn. */
 74:   readonly velocity: number;
 75:   /** `o->Gravity`, which is the turn rate in degrees per tick. */
 76:   readonly turn: number;
 77:   /** `o->LightEnable`; the butterflies alone are drawn unlit and white. */
 78:   readonly lit: boolean;
 79:   /** Slots this species may fill. `MAX_BOIDS` when it says nothing. */
 80:   readonly max?: number;
 81:   /**
 82:    * `rand_fps_check(n)` per free slot per tick, the original's own spawn.
 83:    * Without it the paced `SPAWN_INTERVAL` is used, which is what keeps a
 84:    * flock from arriving all at once.
 85:    */
 86:   readonly spawnOneIn?: number;
 87:   /** `FlyDistance` in MU units; past it from the hero the boid is dropped. */
 88:   readonly flyDistance?: number;
 89:   /** `o->Scale` range when the original rolls one, instead of the flat `scale`. */
 90:   readonly scaleRange?: readonly [number, number];
 91:   /** `o->LifeTime` in ticks, rolled per spawn. Endless when absent. */
 92:   readonly lifeTicks?: readonly [number, number];
 93:   /** The additive metal/chrome pass a golden body carries, linear RGB. */
 94:   readonly shine?: readonly [number, number, number];
 95:   /**
 96:    * Half-turn on the render angle for a model authored the other way round.
 97:    *
 98:    * The wildlife models face along `-yaw`, which is what `boidSystem` writes.
 99:    * Every character and monster in the game faces along
100:    * `atan2(dz, dx) + PI/2` instead (moveAlongPathSystem, skillCastSystem,
101:    * headTrackingSystem), and for a boid's own heading that is `PI - yaw` -
102:    * the same direction turned 180 degrees. A species that borrows a monster
103:    * model flies tail first without this.
104:    */
105:   readonly modelHalfTurn?: boolean;
106: };
107: 
108: const BIRD: BoidSpec = {
109:   kind: 'bird',
110:   models: ['Object1/Bird01.glb'],
111:   scale: 0.8,
112:   velocity: 1,
113:   turn: 13,
114:   lit: true,
115: };
116: 
117: const BAT: BoidSpec = {
118:   kind: 'bat',
119:   models: ['Object2/Bat01.glb'],
120:   scale: 0.8,
121:   velocity: 1,
122:   turn: 13,
123:   lit: true,
124: };
125: 
126: /** `Velocity` 0.3, `LightEnable` false, `Light` white (GOBoid.cpp:1334-1339). */
127: const BUTTERFLY: BoidSpec = {
128:   kind: 'butterfly',
129:   models: ['Object1/Butterfly01.glb'],
130:   scale: 0.8,
131:   velocity: 0.3,
132:   turn: 13,
133:   lit: false,
134: };
135: 
136: const CROW: BoidSpec = {
137:   kind: 'crow',
138:   models: ['Object12/Crow01.glb'],
139:   scale: 0.8,
140:   velocity: 1,
141:   turn: 13,
142:   lit: true,
143: };
144: 
145: /**
146:  * `CreateAtlanseFish` (GOBoid.cpp:885-895) picks `MODEL_FISH01 + 1 + rand()%2`
147:  * out of the eight `Object8` fish the map loads - so Fish02 or Fish03, never
148:  * the Lorencia Fish01 that shares the slot name.
149:  */
150: const FISH: BoidSpec = {
151:   kind: 'fish',
152:   models: ['Object8/Fish02.glb', 'Object8/Fish03.glb'],
153:   scale: 0.8,
154:   velocity: 1,
155:   turn: 15,
156:   lit: true,
157: };
158: 
159: /**
160:  * The invasion dragons (GOBoid.cpp:1274-1300). While `EnableEvent` is set the
161:  * spawner skips its per-map branch entirely and every free slot rolls for one
162:  * of these instead, so a Lorencia invasion has dragons overhead and no birds.
163:  *
164:  * `MONSTER_MODEL_DRAGON` is 31, which is `Monster32` (ZzzOpenData.cpp:2322).
165:  * Five slots is the default map's budget (GOBoid.cpp:1257); the roar, the
166:  * mouth fire and the flight path are the system's, not this table's.
167:  */
168: const DRAGON_MAX = 5;
169: 
170: const DRAGON: BoidSpec = {
171:   kind: 'dragon',
172:   models: ['Monster/Monster32.glb'],
173:   scale: 0.7,
174:   scaleRange: [0.6, 0.8],
175:   velocity: 0.5,
176:   turn: 0,
177:   lit: true,
178:   max: DRAGON_MAX,
179:   spawnOneIn: 300,
180:   flyDistance: 4000,
181:   lifeTicks: [128, 256],
182:   modelHalfTurn: true,
183: };
184: 
185: /**
186:  * `EnableEvent == 3` is the Golden Dragon and its only difference is
187:  * `SubType = 1` (GOBoid.cpp:1293), which the original renders as the
188:  * `RENDER_METAL | RENDER_BRIGHT` / `RENDER_CHROME | RENDER_BRIGHT` pair -
189:  * the same pass `monsters/goldenMonsters.ts` gives the rest of the golden
190:  * line, at the same tint.
191:  */
192: const GOLDEN_DRAGON: BoidSpec = { ...DRAGON, shine: [1, 0.5, 0] };
193: 
194: const BLOOD_CASTLE: readonly ENUM_WORLD[] = [
195:   ENUM_WORLD.WD_11BLOODCASTLE1,
196:   12,
197:   13,
198:   14,
199:   15,
200:   16,
201:   ENUM_WORLD.WD_11BLOODCASTLE_END,
202:   ENUM_WORLD.WD_52BLOODCASTLE_MASTER_LEVEL,
203: ] as ENUM_WORLD[];
204: 
205: const BY_WORLD: Partial<Record<ENUM_WORLD, BoidSpec>> = {
206:   [ENUM_WORLD.WD_0LORENCIA]: BIRD,
207:   [ENUM_WORLD.WD_1DUNGEON]: BAT,
208:   [ENUM_WORLD.WD_4LOSTTOWER]: BAT,
209:   [ENUM_WORLD.WD_3NORIA]: BUTTERFLY,
210:   [ENUM_WORLD.WD_7ATLANSE]: FISH,
211:   [ENUM_WORLD.WD_67DOPPLEGANGER3]: FISH,
212: };
213: 
214: for (const w of BLOOD_CASTLE) BY_WORLD[w] = CROW;
215: 
216: /**
217:  * What flies on this map, or null. A running invasion (`MapEventState`, so 1
218:  * Red or 3 Golden) takes the sky over from the map's own species on every
219:  * map, exactly as the original's spawner does.
220:  */
221: export function boidsFor(map: ENUM_WORLD, invasion = 0): BoidSpec | null {
222:   if (invasion) return invasion === 3 ? GOLDEN_DRAGON : DRAGON;
223: 
224:   return BY_WORLD[map] ?? null;
225: }
226: 
227: const factories = new Map<string, typeof ModelObject>();
228: 
229: /**
230:  * One `ModelObject` subclass per model file, the same shape `petFactoryFor`
231:  * uses: the boid is an ordinary model entity and the system only moves it.
232:  */
233: export function boidFactoryFor(spec: BoidSpec, model: string): typeof ModelObject {
234:   // The two dragons share one model file and differ only by the shine, so the
235:   // key has to carry it or the first one loaded decides the colour of both.
236:   const key = spec.shine ? `${model}|${spec.shine.join()}` : model;
237:   const cached = factories.get(key);
238:   if (cached) return cached;
239: 
240:   class BoidModel extends ModelObject {
241:     static {
242:       BoidModel.OverrideScale = spec.scale;
243:     }
244: 
245:     CastsShadow = false;
246: 
247:     async init(world: World, _entity: Entity) {
248:       const shine = spec.shine;
249: 
250:       if (shine) this.BodyShine.tint.set(shine[0], shine[1], shine[2]);
251: 
252:       this.load(await loadGLTF(model, world));
253:     }
254:   }
255: 
256:   Object.defineProperty(BoidModel, 'name', {
257:     value: model.replace(/^.*\/|\.glb$/g, ''),
258:   });
259: 
260:   factories.set(key, BoidModel);
261: 
262:   return BoidModel;
263: }
</file>

<file path="src/common/boneLink.ts">
 1: import { Matrix } from '../libs/babylon/exports';
 2: 
 3: /**
 4:  * The 3×4 matrix maths `RenderLinkObject` builds a bone-link transform with
 5:  * (ZzzMathLib.cpp:194 `AngleMatrix`, :254 `R_ConcatTransforms`), shared by
 6:  * every part that hangs off a bone with an explicit matrix - back weapons
 7:  * (weaponAttachment.ts) and capes (wings.ts).
 8:  *
 9:  * Angles are degrees in BMD space, offsets are centimetres.
10:  */
11: 
12: const DEG = Math.PI / 180;
13: const CM = 1 / 100;
14: 
15: export type BmdLink = {
16:   angle: [number, number, number];
17:   offset: [number, number, number];
18: };
19: 
20: /** MU's `float[3][4]`: rows, column-vector convention, translation in column 3. */
21: export type Mat34 = [number[], number[], number[]];
22: 
23: /** AngleMatrix (ZzzMathLib.cpp:194): `(Z * Y) * X`, angles[0] about X. */
24: export function angleMatrix(link: BmdLink): Mat34 {
25:   const [ax, ay, az] = link.angle;
26:   const sy = Math.sin(az * DEG);
27:   const cy = Math.cos(az * DEG);
28:   const sp = Math.sin(ay * DEG);
29:   const cp = Math.cos(ay * DEG);
30:   const sr = Math.sin(ax * DEG);
31:   const cr = Math.cos(ax * DEG);
32:   const [tx, ty, tz] = link.offset;
33:   return [
34:     [cp * cy, sr * sp * cy + cr * -sy, cr * sp * cy + -sr * -sy, tx],
35:     [cp * sy, sr * sp * sy + cr * cy, cr * sp * sy + -sr * cy, ty],
36:     [-sp, sr * cp, cr * cp, tz],
37:   ];
38: }
39: 
40: /**
41:  * R_ConcatTransforms (ZzzMathLib.cpp:254) in its exact evaluation order.
42:  * Passing the same array as `in1` and `out` reproduces the original's
43:  * aliasing, which is deliberate - see weaponAttachment.ts.
44:  */
45: export function concatTransforms(in1: Mat34, in2: Mat34, out: Mat34) {
46:   for (let r = 0; r < 3; r++) {
47:     for (let c = 0; c < 4; c++) {
48:       let v =
49:         in1[r][0] * in2[0][c] + in1[r][1] * in2[1][c] + in1[r][2] * in2[2][c];
50:       if (c === 3) v += in1[r][3];
51:       out[r][c] = v;
52:     }
53:   }
54: }
55: 
56: /** MU column-vector 3x4 (cm) → Babylon row-major matrix (metres). */
57: export function toBabylon(m: Mat34): Matrix {
58:   return Matrix.FromValues(
59:     m[0][0], m[1][0], m[2][0], 0,
60:     m[0][1], m[1][1], m[2][1], 0,
61:     m[0][2], m[1][2], m[2][2], 0,
62:     m[0][3] * CM, m[1][3] * CM, m[2][3] * CM, 1
63:   );
64: }
65: 
66: /** The common case: one `AngleMatrix` straight to a Babylon link matrix. */
67: export function angleLinkMatrix(link: BmdLink): Matrix {
68:   return toBabylon(angleMatrix(link));
69: }
</file>

