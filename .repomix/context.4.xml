 54: export type ItemDef = {
 55:   group: number;
 56:   index: number;
 57:   name: string;
 58:   slot: number;
 59:   width: number;
 60:   height: number;
 61:   /** `ITEM_ATTRIBUTE::Level` - the drop level every formula scales from. */
 62:   level: number;
 63:   damageMin: number;
 64:   damageMax: number;
 65:   magicPower: number;
 66:   /** `WeaponSpeed`. */
 67:   speed: number;
 68:   durability: number;
 69:   magicDur: number;
 70:   defense: number;
 71:   /** `SuccessfulBlocking` (`DefRate`). */
 72:   blocking: number;
 73:   reqLvl: number;
 74:   reqStr: number;
 75:   reqAgi: number;
 76:   reqEne: number;
 77:   reqVit: number;
 78:   reqCmd: number;
 79:   skill: number;
 80:   /** 0 = cannot, 1 = base class, 2 = second class, 3 = third class. */
 81:   classes: number[];
 82:   /** Ice, Poison, Lightning, Fire, Earth, Wind, Water (helper group only). */
 83:   resistances: number[];
 84:   twoHand: boolean;
 85:   modelFolder: string;
 86:   modelName: string;
 87: };
