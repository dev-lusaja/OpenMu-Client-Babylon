  65: const ITEM_FX_UNIFORM = `itemFx`;
  66: /**
  67:  * Snow on the object's up-facing surfaces, 0…1 (weather/snowCaps.ts). Per
  68:  * mesh, from `metadata.snowCap` and the cover at the mesh's tile; zero for
