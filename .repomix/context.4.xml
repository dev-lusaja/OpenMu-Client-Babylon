  6: /**
  7:  * Item stats as the original client computes them for the tooltip and the
  8:  * equip checks: `ZzzInfomation.cpp` `CalcDamageMin/Max`, `CalcMagicPower`,
  9:  * `CalcSuccessfulBlocking`, `CalcDefense`, `CalcRequirements` and
 10:  * `ZzzInventory.cpp` `CalcMaxDurability`, on top of a normalised view of
 11:  * `items.json` (whose column names differ per group: `Strength`/`Str`,
 12:  * `Durability`/`Dur`, `RequiredLvl`/`ReqLvl`, …).
 13:  */
 14: 
 15: export const ItemGroup = {
 16:   Sword: 0,
 17:   Axe: 1,
 18:   Mace: 2,
 19:   Spear: 3,
 20:   Bow: 4,
 21:   Staff: 5,
 22:   Shield: 6,
 23:   Helm: 7,
 24:   Armor: 8,
 25:   Pants: 9,
 26:   Gloves: 10,
 27:   Boots: 11,
 28:   Wing: 12,
 29:   Helper: 13,
 30:   Potion: 14,
 31:   Etc: 15,
 32: } as const;
 33: 
 34: /**
 35:  * Base-class index used by `RequireClass[]`: DW, DK, Elf, MG, DL, Summoner,
 36:  * Rage Fighter. The Item.txt this table was converted from predates the last
 37:  * class and names only six columns; `RF` is filled from the server's own item
 38:  * definitions (OpenMU `VersionSeasonSix/Items`), whose class block is in this
 39:  * same order.
 40:  */
 41: export const CLASS_COLUMNS = [
 42:   'DW/SM',
 43:   'DK/BK',
 44:   'Elf/ME',
 45:   'MG',
 46:   'DL',
 47:   'SUM',
 48:   'RF',
 49: ] as const;
 50: 
 51: /** How many of those the Item.txt itself named. See `classUnrestricted`. */
 52: const ITEM_TXT_CLASS_COLUMNS = 6;
