 79: function ArrayResize<TArray extends Uint8Array>(buffer: TArray, newSize: Int) {
 80:   if (buffer.byteLength <= newSize) {
 81:     return buffer.slice(0, newSize);
 82:   }
 83: 
 84:   const newBuffer = new Uint8Array(newSize);
 85: 
 86:   for (let i = 0; i < buffer.length; i++) {
 87:     newBuffer[i] = buffer[i];
 88:   }
 89: 
 90:   return newBuffer;
