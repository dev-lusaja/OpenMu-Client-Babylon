<file path="src/common/lowVitals.ts">
 1: /**
 2:  * When a vital bar counts as low, how hard the screen edge burns, and how
 3:  * fast it beats. Pure: a bar fill and the player's threshold in, the two
 4:  * numbers the overlay draws with out, so the reaction that writes the CSS
 5:  * variables and the test read one rule.
 6:  *
 7:  * Driven by: `ui/pages/worldPage/components/lowHealthOverlay`.
 8:  * Read by: nothing else - it holds no state.
 9:  */
10: 
11: /** Slider bounds of `lowHealthPercent` / `lowManaPercent`. */
12: export const LOW_VITAL_MIN_PERCENT = 10;
13: export const LOW_VITAL_MAX_PERCENT = 50;
14: 
15: /** Where the threshold sits when the option is out of range or missing. */
16: export const LOW_VITAL_DEFAULT_PERCENT = 30;
17: 
18: /** Edge strength the instant the threshold is crossed: the fade needs a target. */
19: const FLOOR_STRENGTH = 0.35;
20: 
21: /** The edge starts beating under this share of the threshold. */
22: const PULSE_SHARE = 0.5;
23: 
24: /** Seconds per beat where the beating starts, and at an empty bar. */
25: const SLOW_BEAT_SECONDS = 1.2;
26: const FAST_BEAT_SECONDS = 0.45;
27: 
28: /**
29:  * Quantisation. The strength feeds an opacity and the beat an
30:  * `animation-duration`, and a duration that changes on every point of health
31:  * makes the animation stutter, so both land on steps.
32:  */
33: const STRENGTH_STEP = 0.01;
34: const BEAT_STEP = 0.05;
35: 
36: export type VitalWarning = {
37:   /** 0 nothing to draw, up to 1 for the full edge. */
38:   strength: number;
39:   /** Seconds per beat; 0 while the edge is steady. */
40:   beatSeconds: number;
41: };
42: 
43: export const NO_WARNING: VitalWarning = { strength: 0, beatSeconds: 0 };
44: 
45: const clamp01 = (value: number): number =>
46:   value < 0 ? 0 : value > 1 ? 1 : value;
47: 
48: const step = (value: number, size: number): number =>
49:   Math.round(value / size) * size;
50: 
51: /** The option as a fill share, clamped into the slider's own range. */
52: export function lowVitalThreshold(percent: number): number {
53:   if (!Number.isFinite(percent)) return LOW_VITAL_DEFAULT_PERCENT / 100;
54: 
55:   return (
56:     Math.max(
57:       LOW_VITAL_MIN_PERCENT,
58:       Math.min(LOW_VITAL_MAX_PERCENT, percent)
59:     ) / 100
60:   );
61: }
62: 
63: /**
64:  * `fraction` is the bar's fill, 0..1. An empty bar is death rather than a
65:  * warning, so it clears the edge - nothing has to be survived any more.
66:  */
67: export function vitalWarning(
68:   fraction: number,
69:   thresholdPercent: number
70: ): VitalWarning {
71:   if (!Number.isFinite(fraction) || fraction <= 0) return NO_WARNING;
72: 
73:   const threshold = lowVitalThreshold(thresholdPercent);
74:   if (fraction >= threshold) return NO_WARNING;
75: 
76:   const depth = clamp01(1 - fraction / threshold);
77:   const strength = step(
78:     FLOOR_STRENGTH + (1 - FLOOR_STRENGTH) * depth,
79:     STRENGTH_STEP
80:   );
81: 
82:   const beatsFrom = threshold * PULSE_SHARE;
83:   if (fraction >= beatsFrom) return { strength, beatSeconds: 0 };
84: 
85:   const rush = clamp01(1 - fraction / beatsFrom);
86:   const beatSeconds = step(
87:     SLOW_BEAT_SECONDS + (FAST_BEAT_SECONDS - SLOW_BEAT_SECONDS) * rush,
88:     BEAT_STEP
89:   );
90: 
91:   return { strength, beatSeconds };
92: }
</file>

