189: type PoseRule = {
190:   readonly group: ItemGroup;
191:   /** A single item, or `from`/`to` for an inclusive range. */
192:   readonly num?: number;
193:   readonly from?: number;
194:   readonly to?: number;
195:   readonly pitch?: number;
196:   readonly roll?: number;
197:   readonly yaw?: number;
198:   readonly scale?: number;
199: };
