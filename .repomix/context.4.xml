498:         labelKey: 'gm.cmd.goldnotice.label',
499:         helpKey: 'gm.cmd.goldnotice.help',
500:         params: [
501:           {
502:             name: 'message',
503:             labelKey: 'gm.param.message',
504:             type: 'text',
505:             required: true,
506:             hintKey: 'gm.hint.whatToSay',
507:             rest: true,
508:           },
509:         ],
510:         confirm: true,
511:       },
512:     ],
513:   },
514: ];
515: 
516: /** Every command in the catalogue, flat - the search box reads this. */
517: export const GM_COMMANDS: readonly GmCommand[] = GM_GROUPS.flatMap(g => g.commands);
518: 
519: export type BuiltCommand = { line: string } | { error: string };
520: 
521: /**
522:  * Build the line to send, or say why it cannot be built.
523:  *
524:  * A blank optional parameter ends the line: the server parses positionally, so
525:  * anything after a gap would land in the wrong slot. That is why `/item` stops
526:  * at the first blank rather than skipping it.
527:  */
528: export function buildCommandLine(
529:   command: GmCommand,
530:   values: Readonly<Record<string, string>>
531: ): BuiltCommand {
532:   const parts: string[] = [command.command];
533: 
534:   for (const param of command.params ?? []) {
535:     const raw = (values[param.name] ?? '').trim();
536:     const field = t(param.labelKey);
537: 
538:     if (!raw) {
539:       if (param.required) return { error: t('gm.error.required', { field }) };
540:       break;
541:     }
542: 
543:     if (param.type === 'number' && !/^-?\d+$/.test(raw)) {
544:       return { error: t('gm.error.wholeNumber', { field }) };
545:     }
546: 
547:     if (param.validValues && !param.validValues.includes(raw)) {
548:       return {
549:         error: t('gm.error.oneOf', { field, values: param.validValues.join(', ') }),
550:       };
551:     }
552: 
553:     if (!param.rest && /\s/.test(raw)) {
554:       return { error: t('gm.error.noSpaces', { field }) };
555:     }
556: 
557:     parts.push(raw);
558:   }
559: 
560:   return { line: parts.join(' ') };
561: }
562: 
563: /**
564:  * Commands matching what was typed into the panel's filter box, across every
565:  * group - `/setmoney` is only in Players if you already knew that, so the box
566:  * searches the slash name, the label and the help alike. The label and help
567:  * are matched in the language on screen, so a Spanish game master can search
568:  * in Spanish.
569:  */
570: export function matchGmCommands(query: string): readonly GmCommand[] {
571:   const needle = query.trim().toLowerCase();
572:   if (!needle) return GM_COMMANDS;
573: 
574:   return GM_COMMANDS.filter(
575:     command =>
576:       command.command.includes(needle) ||
577:       t(command.labelKey).toLowerCase().includes(needle) ||
578:       t(command.helpKey).toLowerCase().includes(needle)
579:   );
580: }
581: 
582: const BY_NAME = new Map(GM_COMMANDS.map(command => [command.command, command]));
583: 
584: /**
585:  * One command by its slash name.
586:  *
587:  * The panel's purpose-built screens (teleport, the character editor, spawning)
588:  * compose their own layout out of named commands rather than listing a group,
589:  * and they must not restate the parameters: the order and the required flags
590:  * here were checked field by field against the server's argument classes, and
591:  * a second copy would drift from them.
592:  *
593:  * Throws rather than returning undefined - a typo names a command that will
594:  * never exist at runtime either, and a screen silently missing a button is
595:  * harder to notice than a failure at boot. `gmCommands.test.ts` calls this for
596:  * every name the panel uses.
597:  */
598: export function gmCommand(name: string): GmCommand {
599:   const command = BY_NAME.get(name);
600:   if (!command) throw new Error(`unknown game master command: ${name}`);
601:   return command;
602: }
</file>

