124:   InternalShiftBytes(outputBuffer: Uint8Array, outputOffset: Int, shiftArray: Uint8Array, shiftOffset: Int, size: Int): void {
125:     shiftOffset &= 0x7;
126: 
127:     SimpleModulusBase.ShiftRight(shiftArray, size, shiftOffset);
128:     SimpleModulusBase.ShiftLeft(shiftArray, size + 1, outputOffset & 0x7);
129: 
130:     if ((outputOffset & 0x7) > shiftOffset) {
131:       size++;
132:     }
133: 
134:     const offset = integerDevision(outputOffset / DecryptedBlockSize);
135:     for (let i = 0; i < size; i++) {
136:       outputBuffer[i + offset] |= shiftArray[i];
137:     }
138:   }
