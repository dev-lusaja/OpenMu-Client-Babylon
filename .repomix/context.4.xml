 44:   it('never puts a required parameter after an optional one', () => {
 45:     // The server parses positionally, so a gap cannot be filled later: an
 46:     // optional parameter followed by a required one could never be sent.
 47:     for (const command of GM_COMMANDS) {
 48:       const params = command.params ?? [];
 49:       const firstOptional = params.findIndex(p => !p.required);
 50:       if (firstOptional < 0) continue;
 51:       expect(params.slice(firstOptional).every(p => !p.required)).toBe(true);
 52:     }
 53:   });
 54: 
 55:   it('only marks the last parameter as taking the rest of the line', () => {
 56:     for (const command of GM_COMMANDS) {
 57:       const params = command.params ?? [];
 58:       params.slice(0, -1).forEach(param => expect(param.rest).toBeFalsy());
 59:     }
 60:   });
 61: });
 62: 
 63: describe('buildCommandLine', () => {
 64:   it('sends a command that takes no arguments on its own', () => {
 65:     expect(line('/hide', {})).toBe('/hide');
 66:   });
 67: 
 68:   it('puts positional arguments in the order the server declares them', () => {
 69:     expect(line('/teleport', { x: '125', y: '125' })).toBe('/teleport 125 125');
 70:     expect(line('/movemonster', { id: '3', x: '10', y: '20' })).toBe('/movemonster 3 10 20');
 71:   });
 72: 
 73:   it('puts the value before the character on the setters', () => {
 74:     // SetLevelChatCommandPlugIn.Arguments is { Level, CharacterName }, not the
 75:     // other way round - typing them the natural way sets the wrong thing.
 76:     expect(line('/setlevel', { level: '350', characterName: 'Ann' })).toBe('/setlevel 350 Ann');
 77:     expect(line('/setmoney', { amount: '5000' })).toBe('/setmoney 5000');
 78:     expect(line('/set', { statType: 'str', amount: '32000', characterName: 'Ann' })).toBe(
 79:       '/set str 32000 Ann'
 80:     );
 81:   });
 82: 
 83:   it('leaves a blank optional argument off the end', () => {
 84:     expect(line('/getlevel', {})).toBe('/getlevel');
 85:     expect(line('/createmonster', { number: '10' })).toBe('/createmonster 10');
 86:     expect(line('/createmonster', { number: '10', intelligence: '1' })).toBe(
 87:       '/createmonster 10 1'
 88:     );
 89:   });
 90: 
 91:   it('stops at the first gap rather than shifting later arguments up', () => {
 92:     // `/item 7 3 <blank> 5` would land the 5 in the level slot.
 93:     expect(line('/item', { group: '7', number: '3', ex: '5' })).toBe('/item 7 3');
 94:     expect(line('/item', { group: '7', number: '3', lvl: '13', ex: '63' })).toBe(
 95:       '/item 7 3 13 63'
 96:     );
 97:   });
 98: 
 99:   it('refuses a missing required argument', () => {
100:     expect(error('/teleport', { x: '125' })).toBe('Y is required.');
101:     expect(error('/banacc', {})).toBe('Account is required.');
102:   });
103: 
104:   it('refuses a number that is not one', () => {
105:     expect(error('/teleport', { x: 'here', y: '125' })).toBe('X must be a whole number.');
106:   });
107: 
108:   it('refuses a value outside the accepted set', () => {
109:     expect(error('/get', { statType: 'luk' })).toBe('Stat must be one of str, agi, vit, ene, cmd.');
110:   });
111: 
112:   it('refuses a space in an argument that is not the message', () => {
113:     // The server splits on spaces, so "Two Words" would become two arguments.
114:     expect(error('/trace', { characterName: 'Two Words' })).toBe(
115:       'Character cannot contain spaces.'
116:     );
117:   });
118: 
119:   it('keeps the spaces in an argument that takes the rest of the line', () => {
120:     expect(line('/goldnotice', { message: 'server restart in 5 minutes' })).toBe(
121:       '/goldnotice server restart in 5 minutes'
122:     );
123:   });
124: 
125:   it('trims what was typed', () => {
126:     expect(line('/trace', { characterName: '  Ann  ' })).toBe('/trace Ann');
127:   });
128: });
129: 
130: describe('matchGmCommands', () => {
131:   const search = (needle: string): string[] =>
132:     matchGmCommands(needle).map(c => c.command);
133: 
134:   it('offers everything when nothing has been typed', () => {
135:     expect(matchGmCommands('   ')).toHaveLength(GM_COMMANDS.length);
136:   });
137: 
138:   it('finds a command by its slash name', () => {
139:     expect(search('/setmoney')).toEqual(['/setmoney']);
140:   });
141: 
142:   it('finds a command by what it is called, whatever the case', () => {
143:     expect(search('MuTe')).toEqual(['/chatban', '/chatunban']);
144:   });
145: 
146:   it('finds a command by what it does, across every group', () => {
147:     // "warp" appears in three groups; the point of the box is not having to
148:     // know which one.
149:     expect(search('warp')).toEqual(
150:       expect.arrayContaining(['/trace', '/track', '/guildmove'])
151:     );
152:   });
153: 
154:   it('finds nothing rather than everything when there is no match', () => {
155:     expect(search('zzzz')).toEqual([]);
156:   });
157: });
