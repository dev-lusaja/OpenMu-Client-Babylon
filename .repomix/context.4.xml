 789:       }
 790:     }
 791: 
 792:     this.CurrentAction = actionIndex;
 793:     this.LoopAction = loop;
 794:     this.ActionIterationWasFinished = false;
 795:     this.actionSerial++;
 796: 
 797:     const animationGroup = this.gltf.animationGroups[actionIndex];
 798:     if (animationGroup) {
 799:       this.startGroup(animationGroup, actionIndex, loop);
 800:       // A clip started while off screen must not run; one-shots are exempt
 801:       // (see applyAnimationPause).
 802:       if (loop && this.OutOfView) animationGroup.pause();
 803:     }
 804:   }
