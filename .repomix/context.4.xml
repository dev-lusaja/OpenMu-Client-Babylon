1102: /**
1103:  * Gain on the derived/authored emissive map. It is added after lighting so
1104:  * gems and trim hold their colour in shadow; the GlowLayer picks the same
1105:  * map up through `sceneLook`'s texture selector. 0.2 keeps trim from reading
1106:  * lighter than its Classic twin (ARCHITECTURE §4.7).
1107:  */
1108: const PBR_EMISSIVE_GAIN = '0.2';
1109: 
1110: /*
1111:  * There is deliberately no diffuse-loss compensation for metalness any more.
1112:  *
1113:  * The old one scaled `surfaceAlbedo` up at the metallic-roughness anchor so a
1114:  * texel the palette heuristic called 'metal' would not go dark without an
1115:  * environment map to reflect. But `pbrBlockReflectivity` captures
1116:  * `vec3 baseColor = surfaceAlbedo;` immediately *after* that anchor and builds
1117:  * `surfaceReflectivityColor = mix(metallicF0, baseColor, metallic)` from it,
1118:  * so the boost landed on the metallic F0 as well - up to 1.6× at the old
1119:  * METAL_MAX. Lorencia's oak and stone got a conductor's reflectance on top of
1120:  * a diffuse that had barely dimmed: energy added twice, which is the broad
1121:  * yellow sheen Enhanced showed across the tavern floor and counter.
1122:  *
1123:  * The two cannot be separated at this anchor (`surfaceReflectivityColor` is
1124:  * already written by the next one), and they should not be: 'keep more
1125:  * diffuse' and 'reflect less like metal' are the same physical statement.
1126:  * `METAL_MAX` in `pbrMaps.ts` is now the single knob for both.
1127:  */
1128: 
1129: /**
1130:  * Enhanced variant: the same per-mesh contract as
1131:  * `createItemMaterial` - shared, frozen, `diffuseTexture` / `bodyLight` /
1132:  * `itemTier` read off `mesh.metadata` at bind - on a metallic-roughness PBR
1133:  * shader with normal, metal/rough and emissive maps per texture
1134:  * (`pbrMaps.ts`). Classic stays the Standard path; only lit, non-blend
1135:  * meshes ever get this material (see `modelLoader.getMaterial`).
1136:  *
1137:  * Calibration choices, so the toggle is a look change and not an exposure
1138:  * change: the albedo is sampled as-is (no gamma decode - the Standard path
1139:  * multiplies the gamma texel, and the moods/light intensities were tuned
1140:  * against that); light falloff stays Babylon's legacy range curve, matching
1141:  * the pooled torches' tuned ranges; no environment map, so specular only
1142:  * comes from the key lights and the torch pool (their `specular` is raised
1143:  * off black while this material is on - `syncMaterialQuality`).
1144:  */
1145: export function createItemPbrMaterial(scene: Scene) {
1146:   const material = new PBRCustomMaterial('itemPbrMaterial', scene);
1147:   const flat = pbrPlaceholders(scene);
1148: 
1149:   material.maxSimultaneousLights = 2 + pointLightPoolSize();
1150: 
1151:   material.albedoColor.setAll(1);
1152:   material.roughness = 1;
1153:   pbrMaterials.add(material);
1154:   material.useMetallnessFromMetallicTextureBlue = true;
1155:   material.useRoughnessFromMetallicTextureGreen = true;
1156:   material.useRoughnessFromMetallicTextureAlpha = false;
1157:   material.metallicTexture = flat.metallicRoughness;
1158:   material.bumpTexture = flat.normal;
1159:   material.usePhysicalLightFalloff = false;
1160:   material.enableSpecularAntiAliasing = true;
1161:   material.environmentIntensity = 0;
1162: 
1163:   // Dielectric F0 off, so only the metalness map decides what glints.
1164:   //
1165:   // The PBR fragment builds every light's specular from that light's
1166:   // *diffuse* colour, never its `specular` one (`lightFragment`:
1167:   // `computeSpecularLighting(..., diffuse{X}.rgb)`) - so parking
1168:   // `sky.specular` on the rig, which is what keeps the Standard path clean,
1169:   // buys nothing here. The sky key is a full hemisphere at intensity 1 that
1170:   // nothing can occlude, so its highlight is not a reflection of anything: it
1171:   // is a constant 0.04 of white laid over every pixel of every lit surface.
1172:   // That is a veil, and it lands hardest exactly where the art has the least
1173:   // headroom. Measured on Lorencia against the Classic tier, same frame: the
1174:   // 5th-percentile black lifted 0.042 -> 0.086, saturation fell 0.50 -> 0.40
1175:   // and texture detail dropped 9%, which is the greyed-out shading the
1176:   // Enhanced tier was reported with.
1177:   //
1178:   // Zeroing the factor drops F0 for dielectrics only. A texel the derived
1179:   // metal-rough map calls metal still reflects, at `metallic x albedo`, so
1180:   // plate and gems keep their glint under a torch while oak and stone stop
1181:   // being sheened. With it, the tier is pixel-identical to Classic wherever
1182:   // the art is not metal, and everything it adds on top is relief.
1183:   material.metallicF0Factor = 0;
1184:   material.ambientColor.setAll(0);
1185: 
1186:   // Materials are created as models load, after the option sync has run.
1187:   applyPbrDetail(material);
1188: 
1189:   addItemUniforms(material, scene);
1190:   material.AddUniform(BODY_LIGHT_UNIFORM, 'vec4', null);
1191:   material.AddUniform(DETAIL_UNIFORM, 'float', null);
1192:   material.AddUniform('muEmissiveSampler', 'sampler2D', flat.black);
1193:   addLitDefines(material, scene);
1194: 
1195:   addInstanceAttribute(material);
1196: 
1197:   material.Fragment_Definitions(
1198:     lightTintGlsl() +
1199:       cloudFieldGlsl(false) +
1200:       INSTANCE_FRAGMENT_DEFINITIONS +
1201:       toonFunctionsGlsl()
1202:   );
1203: 
1204:   // BodyLight: the bake's flat per-object light (the unified model). The
1205:   // albedo texel is already decoded (GAMMAALBEDO); the bake - a display-
1206:   // domain value like the texel - is decoded the same way before it meets
1207:   // it, so the product is `lin(texel x body)` (§3.2). Applied to
1208:   // `surfaceAlbedo` only: with metallic 0 the dielectric F0 does not read
1209:   // the albedo, so the highlight and the emissive trim keep their strength.
1210:   // Alpha carries mesh visibility on both paths.
1211:   material.Fragment_Custom_Albedo(`
1212:   #ifdef ${FLAT_DEFINE}
1213:   #ifdef ALBEDO
1214:     {
1215:       // The art read again with the mip bias and snapped to its tone levels,
1216:       // in the display space it was authored in, then decoded as Babylon did.
1217:       vec3 toonTexel = muToonFlat(texture2D(albedoSampler, vAlbedoUV + uvOffset, ${TOON_FILTER_UNIFORM}.x).rgb, ${TOON_FILTER_UNIFORM}.y);
1218:       #ifdef GAMMAALBEDO
1219:       toonTexel = toLinearSpace(toonTexel);
1220:       #endif
1221:       surfaceAlbedo = vAlbedoColor.rgb * toonTexel * vAlbedoInfos.y;
1222:     }
1223:   #endif
1224:   #endif
1225:     ${
1226:       UNIFIED_LIGHT_MODEL
1227:         ? `surfaceAlbedo *= pow(max(${BODY_LIGHT_UNIFORM}.rgb * ${INSTANCE_VARYING}.rgb, vec3(0.0)), vec3(2.2));`
1228:         : ''
1229:     }
1230:     alpha *= ${BODY_LIGHT_UNIFORM}.a;
1231: ${snowCapGlsl('surfaceAlbedo')}
1232:   `);
1233: 
1234:   material.Fragment_Before_Fog(`
1235:     finalColor.rgb += texture2D(muEmissiveSampler, vAlbedoUV).rgb * ${PBR_EMISSIVE_GAIN} * ${DETAIL_UNIFORM};
1236: ${sunResponseGlsl('finalColor.rgb', 'surfaceAlbedo')}
1237:     finalColor.rgb = muLightTint(finalColor.rgb, diffuseBase);
1238:   `);
1239: 
1240:   material.Fragment_Before_FragColor(legacyPasses(PBR_VARS));
1241: 
1242:   trackTime(scene, now => {
1243:     material.onBindObservable.add(mesh => {
1244:       const effect = material.getEffect();
1245:       if (!effect) return;
1246: 
1247:       bindItemEffect(effect, mesh, now());
1248: 
1249:       const diffuse = mesh.metadata!.diffuseTexture as Texture;
1250:       const maps = pbrMapsFor(diffuse, scene);
1251: 
1252:       effect.setFloat(DETAIL_UNIFORM, pbrDetailStrength());
1253: 
1254:       effect.setTexture('albedoSampler', diffuse);
1255:       effect.setTexture('bumpSampler', maps?.normal ?? flat.normal);
1256:       effect.setTexture(
1257:         'reflectivitySampler',
1258:         maps?.metallicRoughness ?? flat.metallicRoughness
1259:       );
1260:       effect.setTexture('muEmissiveSampler', maps?.emissive ?? flat.black);
1261: 
1262:       effect.setFloat4(BODY_LIGHT_UNIFORM, 1, 1, 1, mesh.visibility);
1263:       bindBodyLight(effect, mesh, BODY_LIGHT_UNIFORM);
1264:     });
1265:   });
1266: 
1267:   return material;
1268: }
1269: 
1270: /** Diagnostics: the live PBR item materials, for `window.muMat()`. */
1271: export function livePbrMaterials(): PBRCustomMaterial[] {
1272:   return [...pbrMaterials];
1273: }
