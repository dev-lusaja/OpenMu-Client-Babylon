 1: import type { Entity, World } from '../ecs/world';
 2: import { itemWornHeight } from './itemAngle';
 3: import { ModelObject } from './modelObject';
 4: 
 5: /**
 6:  * A dropped item. Everything the original does to a drop that it does not do
 7:  * to a prop, all of it in `RenderItems` (ZzzObject.cpp:6342):
 8:  *
 9:  * - `ItemHeight` pulls a worn body part back down onto the ground.
10:  * - `HideSkin = true` keeps the head, the skin and the hair out of it.
11:  * - `o->AnimationFrame` is never advanced, so the model is frozen.
12:  */
13: export class DropObject extends ModelObject {
14:   async init(_world: World, entity: Entity): Promise<void> {
15:     this.BodyHeight = itemWornHeight(entity.droppedItem?.group ?? -1);
16:     this.HideSkin = true;
17:     this.FrozenPose = true;
18:   }
19: }
</file>

