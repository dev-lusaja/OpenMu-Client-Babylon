163: type NoteEvent = { status: number; d1: number; d2: number };
164: 
165: /** One performer's take on a channel message: a note at their key, a strum on their entity. */
166: function voiceOn(
167:   key: string,
168:   instrument: InstrumentId,
169:   ev: NoteEvent,
170:   when: number,
171:   entity: Entity | null | undefined
172: ): void {
173:   const channel = ev.status & 0x0f;
174:   if (!canRender(instrument, channel)) return;
175:   const kind = ev.status & 0xf0;
176:   if (kind === 0x90 && ev.d2 > 0) {
177:     noteOn(key, instrument, channel, ev.d1, ev.d2, when);
178:     if (entity) queueHit(entity, when, ev.d1, ev.d2);
179:   } else if (kind === 0x80 || kind === 0x90) {
180:     noteOff(key, channel, ev.d1, when);
181:   } else if (kind === 0xb0) {
182:     allNotesOff(key);
183:   }
184: }
185: 
186: /**
187:  * The hero's own notes, at the hero's key - and, when the hero is a master,
188:  * each member's doubling of them: on the member's instrument, where the
189:  * member stands, on the channels in their mask. A member is a performer in
190:  * their own right here (their instrument is out), so their key is placed.
191:  */
192: function voiceLocal(ev: MidiEvent, when: number): void {
193:   const instrument = Band.instrument;
194:   if (!instrument) return;
195:   voiceOn(HERO_KEY, instrument, ev, when, heroEntity());
196:   if (Band.role !== 'master' || !Band.band) return;
197:   const channel = ev.status & 0x0f;
198:   for (const m of Band.band.members) {
199:     const remote = remotes.get(m.netId);
200:     if (!remote || !hasChannel(m.channelMask, channel)) continue;
201:     voiceOn(keyOf(m.netId), m.instrument, ev, when, remote.entity);
202:   }
203: }
204: 
205: /**
206:  * Which channels the hero's own sequencer voices: all of its song (a band
207:  * doubles the master, it takes nothing from them), percussion only if the
208:  * row renders it. A member's sequencer never runs; their notes come off the
209:  * master's stream in `voiceRemote`.
210:  */
211: function refreshLocalMask(): void {
212:   const instrument = Band.instrument;
213:   let mask = Band.role === 'member' ? 0 : ALL_CHANNELS;
214:   if (!instrument || !canRender(instrument, PERCUSSION_CHANNEL)) mask &= ~(1 << PERCUSSION_CHANNEL);
215:   sequencer.localMask = mask;
216: }
