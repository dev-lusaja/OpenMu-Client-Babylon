  1: /**
  2:  * The browser's own keyboard, kept off the game's.
  3:  *
  4:  * Ctrl plus a game key is a browser command in a tab. Ctrl+S sorts the
  5:  * inventory and opened the save dialog, Ctrl+A opens the master skill tree
  6:  * and selected the whole page, Ctrl+D opens the command window and
  7:  * bookmarked the client - and Ctrl+W, the second potion slot with Ctrl held,
  8:  * closed the tab outright in the middle of a fight.
  9:  *
 10:  * Three layers, strongest first:
 11:  *
 12:  *  1. `keyboard.lock()` while the document is in fullscreen. This is the only
 13:  *     way a page is ever handed Ctrl+W, Ctrl+T, Ctrl+N, Ctrl+Tab or
 14:  *     Ctrl+1..9: outside fullscreen the browser eats them before any listener
 15:  *     runs. Chromium only, and F11 below is how the fullscreen the lock needs
 16:  *     gets asked for.
 17:  *  2. `preventDefault` on every reserved chord a page is allowed to cancel -
 18:  *     reload, zoom, find, print, save, open, bookmark, history, caret
 19:  *     browsing, the address bar, the function keys.
 20:  *  3. `beforeunload` as the last net for what neither of those reaches:
 21:  *     Alt+F4, the window's close button, Cmd+W on a Mac, Ctrl+W on a browser
 22:  *     with no lock. The page cannot stop those, only ask.
 23:  *
 24:  * Only the default action is cancelled, never the propagation: the hot keys
 25:  * and the walk read the same event afterwards, so Ctrl+S still sorts the bag.
 26:  *
 27:  * Bare game keys are not this module's business - Tab, Alt and Space are
 28:  * guarded for their own reasons in `ecs/systems/keyboardInputSystem.ts`.
 29:  * This one owns chords and function keys.
 30:  */
 31: 
 32: import { GameOptions, onGameOptionsChanged } from './gameOptions';
 33: 
 34: /**
 35:  * Ctrl (or Cmd) plus one of these is a browser command. None of them is
 36:  * anything but a hot key to the game, which still gets the event.
 37:  */
 38: const CTRL_KEYS: ReadonlySet<string> = new Set([
 39:   // Select all, bookmark, address bar, find, downloads, history, print,
 40:   // open, quit, reload, save, new tab, new window, view source, close, redo.
 41:   'KeyA', 'KeyB', 'KeyD', 'KeyE', 'KeyF', 'KeyG', 'KeyH', 'KeyJ', 'KeyK',
 42:   'KeyL', 'KeyM', 'KeyN', 'KeyO', 'KeyP', 'KeyQ', 'KeyR', 'KeyS', 'KeyT',
 43:   'KeyU', 'KeyW', 'KeyY',
 44:   // Zoom in / out / reset.
 45:   'Minus', 'Equal', 'NumpadAdd', 'NumpadSubtract',
 46:   // Tab switching, and Ctrl+Tab cycling.
 47:   'Digit0', 'Digit1', 'Digit2', 'Digit3', 'Digit4', 'Digit5', 'Digit6',
 48:   'Digit7', 'Digit8', 'Digit9',
 49:   'Numpad0', 'Numpad1', 'Numpad2', 'Numpad3', 'Numpad4', 'Numpad5',
 50:   'Numpad6', 'Numpad7', 'Numpad8', 'Numpad9',
 51:   'Tab', 'PageUp', 'PageDown',
 52: ]);
 53: 
 54: /**
 55:  * ...except while a text field has the focus, where these are how the text is
 56:  * edited. Chat has to keep its copy, paste and undo.
 57:  */
 58: const CTRL_EDIT_KEYS: ReadonlySet<string> = new Set([
 59:   'KeyA', 'KeyC', 'KeyV', 'KeyX', 'KeyZ', 'KeyY',
 60:   'Home', 'End', 'Backspace', 'Delete', 'Insert',
 61:   'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown',
 62: ]);
 63: 
 64: /**
 65:  * Chords that take the page away entirely. Blocked even with the chat box
 66:  * open: a reload loses the session whatever the focus was on.
 67:  */
 68: const CTRL_FATAL_KEYS: ReadonlySet<string> = new Set([
 69:   'KeyW', 'KeyT', 'KeyN', 'KeyR', 'KeyQ',
 70: ]);
 71: 
 72: /** Alt plus one of these: back, forward, home page, address bar. */
 73: const ALT_KEYS: ReadonlySet<string> = new Set([
 74:   'ArrowLeft', 'ArrowRight', 'Home', 'KeyD',
 75: ]);
 76: 
 77: /**
 78:  * Help, find, reload, address bar, caret browsing, the menu bar, fullscreen.
 79:  * F12 is left out on purpose: the devtools chords are not cancelable anyway,
 80:  * and QA needs the panel.
 81:  */
 82: const FUNCTION_KEYS: ReadonlySet<string> = new Set([
 83:   'F1', 'F2', 'F3', 'F4', 'F5', 'F6', 'F7', 'F8', 'F9', 'F10', 'F11',
 84: ]);
 85: 
 86: /**
 87:  * The codes handed to `keyboard.lock()`: everything above, plus the ones no
 88:  * amount of `preventDefault` reaches. `KeyI`, `KeyJ` and `KeyC` stay out so
 89:  * Ctrl+Shift+I / J / C still open the devtools in fullscreen.
 90:  */
 91: const LOCKED_CODES: readonly string[] = [
 92:   ...CTRL_KEYS,
 93:   ...FUNCTION_KEYS,
 94:   'Escape',
 95:   'BracketLeft',
 96:   'BracketRight',
 97:   'Backspace',
 98: ].filter(code => code !== 'KeyJ');
 99: 
100: export type ChordEvent = {
101:   code: string;
102:   ctrlKey: boolean;
103:   metaKey: boolean;
104:   altKey: boolean;
105:   shiftKey: boolean;
106: };
107: 
108: const isTextField = (el: EventTarget | null): boolean => {
109:   const node = el as HTMLElement | null;
110:   return (
111:     !!node &&
112:     (node.tagName === 'INPUT' ||
113:       node.tagName === 'TEXTAREA' ||
114:       !!node.isContentEditable)
115:   );
116: };
117: 
118: /**
119:  * Whether the browser's default for this key press has to be cancelled. Pure,
120:  * so the tables above can be checked without a DOM.
121:  */
122: export function isBrowserChord(e: ChordEvent, typing: boolean): boolean {
123:   const devtools =
124:     e.code === 'KeyI' || e.code === 'KeyJ' || e.code === 'KeyC';
125: 
126:   // No page can cancel the devtools chords; claiming to would only hide them.
127:   if (e.ctrlKey && e.shiftKey && devtools) return false;
128: 
129:   if (e.ctrlKey || e.metaKey) {
130:     if (CTRL_FATAL_KEYS.has(e.code)) return true;
131:     if (typing && CTRL_EDIT_KEYS.has(e.code)) return false;
132:     if (CTRL_KEYS.has(e.code)) return true;
133:   }
134: 
135:   if (e.altKey && ALT_KEYS.has(e.code)) return !typing;
136: 
137:   if (FUNCTION_KEYS.has(e.code)) return true;
138: 
139:   // Backspace on a page with nothing focused used to mean "back".
140:   if (e.code === 'Backspace' && !typing && !e.ctrlKey && !e.metaKey) {
141:     return true;
142:   }
143: 
144:   return false;
145: }
146: 
147: /* ------------------------------------------------------------------ */
148: /* Fullscreen, and the keyboard lock that rides on it                   */
149: /* ------------------------------------------------------------------ */
150: 
151: type FullscreenDoc = Document & {
152:   webkitFullscreenElement?: Element | null;
153:   webkitExitFullscreen?: () => Promise<void>;
154: };
155: 
156: type FullscreenEl = HTMLElement & {
157:   webkitRequestFullscreen?: () => Promise<void>;
158: };
159: 
160: type KeyboardLock = {
161:   lock?: (codes?: string[]) => Promise<void>;
162:   unlock?: () => void;
163: };
164: 
165: const keyboardLock = (): KeyboardLock | undefined =>
166:   (navigator as Navigator & { keyboard?: KeyboardLock }).keyboard;
167: 
168: export function isFullscreen(): boolean {
169:   const doc = document as FullscreenDoc;
170:   return !!(doc.fullscreenElement ?? doc.webkitFullscreenElement);
171: }
172: 
173: /**
174:  * Enter or leave fullscreen. Has to run inside a user gesture (a key press, a
175:  * click), which is why nothing calls it on boot: the browser refuses the
176:  * request otherwise, so there is no way to restore the state silently.
177:  */
178: export function toggleFullscreen(): void {
179:   const doc = document as FullscreenDoc;
180: 
181:   if (isFullscreen()) {
182:     const exit = doc.exitFullscreen ?? doc.webkitExitFullscreen;
183:     exit?.call(doc)?.catch(() => {});
184:     return;
185:   }
186: 
187:   const el = document.documentElement as FullscreenEl;
188:   const request = el.requestFullscreen ?? el.webkitRequestFullscreen;
189:   request?.call(el)?.catch(() => {});
190: }
191: 
192: let locked = false;
193: 
194: /**
195:  * Takes or releases the lock to match the current state. Called on every
196:  * options change as well as on `fullscreenchange`, so it only acts when the
197:  * two disagree - a volume slider must not re-take the keyboard.
198:  */
199: function applyKeyboardLock(): void {
200:   const keyboard = keyboardLock();
201:   if (!keyboard?.lock) return;
202: 
203:   const wanted = isFullscreen() && GameOptions.blockBrowserKeys;
204:   if (wanted === locked) return;
205:   locked = wanted;
206: 
207:   if (!wanted) {
208:     keyboard.unlock?.();
209:     return;
210:   }
211: 
212:   // Rejects on a browser that refuses the codes, or if fullscreen was left in
213:   // between; the preventDefault layer stands on its own either way.
214:   keyboard.lock([...LOCKED_CODES]).catch(() => {
215:     locked = false;
216:   });
217: }
218: 
219: /* ------------------------------------------------------------------ */
220: /* Leaving the page                                                     */
221: /* ------------------------------------------------------------------ */
222: 
223: let unloadAllowed = false;
224: 
225: /**
226:  * The next navigation is the game's own (Exit Game, a version reload), so it
227:  * must not raise the "leave site?" prompt.
228:  */
229: export function allowUnload(): void {
230:   unloadAllowed = true;
231: }
232: 
233: /* ------------------------------------------------------------------ */
234: /* Install                                                              */
235: /* ------------------------------------------------------------------ */
236: 
237: let installed = false;
238: 
239: /**
240:  * Wires all three layers. Called once, from boot.
241:  *
242:  * `inSession` says whether losing the page right now would cost the player a
243:  * live session - the only thing here that has to know about the game's state,
244:  * and passed in rather than imported so this module stays free of the store.
245:  */
246: export function installBrowserHotkeyGuard(inSession: () => boolean): void {
247:   if (installed) return;
248:   installed = true;
249: 
250:   // Capture phase, so the default is cancelled even for a chord some window's
251:   // own handler stops from travelling any further.
252:   window.addEventListener(
253:     'keydown',
254:     ev => {
255:       if (!GameOptions.blockBrowserKeys) return;
256:       // A CJK composition owns the keyboard until the syllable is committed.
257:       if (ev.isComposing || ev.keyCode === 229) return;
258: 
259:       const typing =
260:         isTextField(ev.target) || isTextField(document.activeElement);
261: 
262:       if (!isBrowserChord(ev, typing)) return;
263: 
264:       ev.preventDefault();
265: 
266:       // F11 is the one of these with something to put in the browser's place:
267:       // the page's own fullscreen, which is what the keyboard lock needs.
268:       if (ev.code === 'F11' && !ev.ctrlKey && !ev.altKey && !ev.metaKey) {
269:         toggleFullscreen();
270:       }
271:     },
272:     { capture: true }
273:   );
274: 
275:   document.addEventListener('fullscreenchange', applyKeyboardLock);
276:   document.addEventListener('webkitfullscreenchange', applyKeyboardLock);
277: 
278:   onGameOptionsChanged(applyKeyboardLock);
279: 
280:   window.addEventListener('beforeunload', ev => {
281:     if (unloadAllowed) {
282:       unloadAllowed = false;
283:       return;
284:     }
285:     if (!GameOptions.blockBrowserKeys) return;
286:     if (!inSession()) return;
287: 
288:     // The wording is the browser's own; every one of them ignores ours.
289:     ev.preventDefault();
290:     ev.returnValue = '';
291:   });
292: }
</file>

