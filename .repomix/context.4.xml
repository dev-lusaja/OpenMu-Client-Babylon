 211: /**
 212:  * Half-lambert response (ARCHITECTURE §3.2 `wrap`).
 213:  *
 214:  * The original's character shading is `Luminosity = dot*0.8 + 0.4`, clamped
 215:  * >= 0.2 (`ZzzBMD.cpp:255-257`): side faces get 0.4, back faces never drop
 216:  * below 0.2. A raw `max(N.L, 0)` is why limbs read thin and dark.
 217:  *
 218:  * Compiled under `MU_WRAP` as a term added to the light sum the shader
 219:  * already holds: `sun x (wrap(dot) - max(dot, 0)) x shadow`, so the sun's
 220:  * lambert becomes `sun x wrap(dot) x shadow` exactly. The constants are
 221:  * normalized by 1.2 so a fully sun-facing surface is unchanged and the key
 222:  * budget still sums to 1.0 on an up face. It carries the sun share alone and
 223:  * the cascades cut it with the rest of the sun; the sky hemisphere is what a
 224:  * back face keeps.
 225:  *
 226:  * The sun's shadow factor is recovered from Babylon's per-light aggregate:
 227:  * every light adds its factor to `aggShadow` and 1 to `numLights`, and the
 228:  * sun is the only light with a generator, so `agg x n - (n - 1)` is its own.
 229:  *
 230:  * Dev overrides: `?halfLambert=0` disables, `?hlWrap=scale,bias,floor` tunes
 231:  * (values are the already-normalized shader constants).
 232:  */
 233: const SUN_DIR_UNIFORM = 'muSunDir';
 234: const SUN_COLOR_UNIFORM = 'muSunColor';
 235: 
 236: const HALF_LAMBERT_DEFAULT: [number, number, number] = [
 237:   0.8 / 1.2,
 238:   0.4 / 1.2,
 239:   0.2 / 1.2,
 240: ];
 241: 
 242: function halfLambertParams(): [number, number, number] | null {
 243:   if (devQuery('halfLambert') === '0') return null;
 244: 
 245:   const wrap = devQueryNumbers('hlWrap', 3);
 246: 
 247:   return wrap ? (wrap as [number, number, number]) : HALF_LAMBERT_DEFAULT;
 248: }
 249: 
 250: const halfLambert = halfLambertParams();
 251: 
 252: function wrapActive(): boolean {
 253:   return halfLambert !== null && lightingTier() !== null;
 254: }
 255: 
 256: /**
 257:  * `target` is the running lit sum the fill lands on: `diffuseBase` on the
 258:  * Standard path (the UNCLAMP recompute multiplies it by the texel after
 259:  * this), `finalColor.rgb` on the PBR path - there the albedo has to be
 260:  * applied by hand, the diffuse composition is already done.
 261:  *
 262:  */
 263: const halfLambertGlsl = (target: string, albedo: string) => {
 264:   const [scale, bias, floor] = halfLambert ?? HALF_LAMBERT_DEFAULT;
 265: 
 266:   return `
 267:   #ifdef ${WRAP_DEFINE}
 268:   {
 269:     float hlDot = dot(normalW, -${SUN_DIR_UNIFORM});
 270:     float hlWrap = max(max(hlDot * ${f(scale)} + ${f(bias)}, ${f(floor)}), 0.0);
 271:     float hlFill = max(hlWrap - max(hlDot, 0.0), 0.0);
 272:     float hlShadow = numLights > 0.0 ? clamp(aggShadow * numLights - (numLights - 1.0), 0.0, 1.0) : 1.0;
 273:     ${target} += ${SUN_COLOR_UNIFORM} * hlFill * hlShadow${albedo ? ` * ${albedo}` : ''};
 274: 
 275:     // The block above leaves the sun's whole contribution at
 276:     // sunColor x hlWrap x hlShadow, so a cloud is one subtraction from it and
 277:     // identity at cloud 1. One rule with the terrain's: a cloud removes the
 278:     // sun and leaves the sky share.
 279:     ${target} -= ${SUN_COLOR_UNIFORM} * hlWrap * hlShadow *
 280:       (1.0 - muCloudShadow(vPositionW))${albedo ? ` * ${albedo}` : ''};
 281:   }
 282:   #endif
 283: `;
 284: };
 285: 
 286: /**
 287:  * `MU_TOON` (renderingStyle.ts): the lit sum the wrap left - sky, sun with
 288:  * its wrap, cloud and cascade, the torches - is remapped onto `muToon.x`
 289:  * levels between the darkest a surface can be under the key (`muToonRef.y`,
 290:  * the sky's ground share) and the key's level (`muToonRef.x`); whatever
 291:  * stands above the level, a torch core, passes through. One scalar on the
 292:  * whole sum, so a coloured light keeps its hue and a shadow or a cloud lands
 293:  * as a band edge. The stepped rim in sun units goes on the figures
 294:  * (`muToon.z`), added after the bands so it stays one clean line.
 295:  *
 296:  * `MU_TOON_ULTRA` (the Ultra tier with the Anime style) adds two more
 297:  * drawn things: a hard highlight where the sun reflects toward the eye,
 298:  * stepped and shadowed like the rim and on the figures alone
 299:  * (`muToonUltra.x` is 0 on a prop), and hatching over the darkest band,
 300:  * diagonal screen-space lines that take a share of the stepped diffuse
 301:  * light away, so a shadow reads as pencilled rather than lit.
 302:  */
 303: const toonGlsl = (target: string, albedo: string) => {
 304:   const mul = albedo ? ` * ${albedo}` : '';
 305: 
 306:   return `
 307:   #ifdef ${TOON_DEFINE}
 308:   {
 309:     float toonLum = dot(diffuseBase, vec3(0.299, 0.587, 0.114));
 310:     float toonX = toonLum / max(${TOON_REF_UNIFORM}.x, 1e-4);
 311:     float toonLo = ${TOON_REF_UNIFORM}.y;
 312:     float toonT = clamp((toonX - toonLo) / max(1.0 - toonLo, 1e-4), 0.0, 1.0);
 313:     float toonQ = toonLo + (1.0 - toonLo) * muToonBands(toonT, ${TOON_UNIFORM}.x, ${TOON_UNIFORM}.y)
 314:       + max(toonX - 1.0, 0.0);
 315:     float toonScale = toonX > 1e-4 ? toonQ / toonX : 1.0;
 316:     vec3 toonLit = diffuseBase * toonScale;
 317:     ${target} += diffuseBase * (toonScale - 1.0)${mul};
 318: 
 319:     float rimDot = dot(normalW, -${SUN_DIR_UNIFORM});
 320:     float rimShadow = numLights > 0.0 ? clamp(aggShadow * numLights - (numLights - 1.0), 0.0, 1.0) : 1.0;
 321:     float rimV = 1.0 - clamp(dot(viewDirectionW, normalW), 0.0, 1.0);
 322:     float rimLit = clamp(rimDot * 0.5 + 0.5, 0.0, 1.0);
 323:     float rim = muToonStep(rimV * rimLit, ${TOON_UNIFORM}.w, ${TOON_UNIFORM}.y) * ${TOON_UNIFORM}.z;
 324:     ${target} += ${SUN_COLOR_UNIFORM} * rim * muToonStep(rimShadow, 0.5, ${TOON_UNIFORM}.y)${mul};
 325: 
 326:   #ifdef ${ULTRA_DEFINE}
 327:     vec3 glintH = normalize(viewDirectionW - ${SUN_DIR_UNIFORM});
 328:     float glintV = pow(clamp(dot(normalW, glintH), 0.0, 1.0), ${TOON_ULTRA_UNIFORM}.y);
 329:     float glint = muToonStep(glintV, 0.5, ${TOON_UNIFORM}.y) * ${TOON_ULTRA_UNIFORM}.x;
 330:     ${target} += ${SUN_COLOR_UNIFORM} * glint * muToonStep(rimShadow, 0.5, ${TOON_UNIFORM}.y)${mul};
 331: 
 332:     float hatchBand = 1.0 - muToonStep(toonT, 0.5 / max(${TOON_UNIFORM}.x - 1.0, 1.0), ${TOON_UNIFORM}.y);
 333:     float hatchWave = 0.5 + 0.5 * sin((gl_FragCoord.x + gl_FragCoord.y) * (6.2831853 / ${TOON_ULTRA_UNIFORM}.w));
 334:     float hatch = smoothstep(0.4, 0.6, hatchWave) * hatchBand * ${TOON_ULTRA_UNIFORM}.z;
 335:     ${target} -= toonLit * hatch${mul};
 336:   #endif
 337:   }
 338:   #endif
 339: `;
 340: };
 341: 
 342: /** The wrap, then the bands over what it left; each compiles under its own define. */
 343: const sunResponseGlsl = (target: string, albedo: string) =>
 344:   halfLambertGlsl(target, albedo) + toonGlsl(target, albedo);
 345: 
 346: const luma = (c: { r: number; g: number; b: number }): number =>
 347:   c.r * 0.299 + c.g * 0.587 + c.b * 0.114;
 348: 
 349: /** The key's level and its floor for the toon remap; unread without `MU_TOON`. */
 350: function bindToonRef(effect: Effect, scene: Scene): void {
 351:   if (!toonRampActive()) return;
 352: 
 353:   const sky = skyLightOf(scene);
 354:   const sun = sunLightOf(scene);
 355:   const skyTop = sky ? sky.intensity * luma(sky.diffuse) : 0;
 356:   const skyGround = sky ? sky.intensity * luma(sky.groundColor) : 0;
 357:   // `sun.intensity` carries `directLightGain`; see bindSunWrap.
 358:   const sunPlain =
 359:     sun && sun.intensity > 0
 360:       ? sun.intensity * specularLightScale() * luma(sun.diffuse)
 361:       : 0;
 362:   const level = skyTop + sunPlain;
 363: 
 364:   effect.setFloat2(TOON_REF_UNIFORM, level, level > 0 ? skyGround / level : 0);
 365: }
 366: 
 367: /**
 368:  * The cloud deck the wrap term subtracts. Null while the map has no sky and
 369:  * inside a room, so the shadow is identity there.
 370:  */
 371: function bindItemClouds(effect: Effect, scene: Scene): void {
 372:   const look = lookDirector()?.state();
 373: 
 374:   bindClouds(effect, scene, {
 375:     base: look?.profile.sky
 376:       ? look.profile.sky.clouds ?? SKY_CLOUDS_DEFAULT
 377:       : null,
 378:     sunDirection: look?.key.direction ?? [0, -1, 0],
 379:     sunElevationDeg: look?.profile.sun.elevationDeg ?? 45,
 380:   });
 381: }
 382: 
 383: /** Per-draw sun uniforms for the sun response; unread without `MU_WRAP` or `MU_TOON`. */
 384: function bindSunWrap(effect: Effect, mesh: AbstractMesh) {
 385:   if (!wrapActive() && !toonRampActive()) return;
 386: 
 387:   const sun = sunLightOf(mesh.getScene());
 388: 
 389:   if (!sun || sun.intensity <= 0) {
 390:     effect.setFloat3(SUN_COLOR_UNIFORM, 0, 0, 0);
 391:     return;
 392:   }
 393: 
 394:   const d = sun.direction;
 395:   const norm = 1 / (Math.hypot(d.x, d.y, d.z) || 1);
 396: 
 397:   // `sun.intensity` carries `directLightGain` - a pi the PBR material needs
 398:   // to undo Burley's 1/pi on its *diffuse*. This is a hand-written additive
 399:   // term that never had the 1/pi to undo, so it takes the plain intensity
 400:   // (the sun share x the map's key gain).
 401:   const fill = sun.intensity * specularLightScale();
 402: 
 403:   effect.setFloat3(SUN_DIR_UNIFORM, d.x * norm, d.y * norm, d.z * norm);
 404:   effect.setFloat3(
 405:     SUN_COLOR_UNIFORM,
 406:     sun.diffuse.r * fill,
 407:     sun.diffuse.g * fill,
 408:     sun.diffuse.b * fill
 409:   );
 410: }
