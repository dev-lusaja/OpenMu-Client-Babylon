155:   static ShiftLeft(data: Uint8Array, size: Int, shift: Int): void {
156:     if (shift === 0) {
157:       return;
158:     }
159: 
160:     for (let i = 1; i < size; i++) {
161:       data[size - i] = castToByte((data[size - i] >> shift) | (data[size - i - 1] << (8 - shift)));
162:     }
163: 
164:     data[0] >>= shift;
165:   }
