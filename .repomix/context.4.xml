272: /** The proxy stopped this client's performance (a limit, or its own stop echoed). */
273: export function stoppedByProxy(): void {
274:   const hero = heroEntity();
275:   const world = Store.world;
276:   if (hero && world) stopPerforming(world, hero);
277:   performanceEnded();
