<file path="src/common/band/sequencer.ts">
  1: import type { MidiEvent, ParsedMidi } from './midiFile';
  2: 
  3: /**
  4:  * The performer's scheduler. Walks the song on the audio clock and, once a
  5:  * tick, hands out every event whose time has come into the send window: to
  6:  * the sampler for the performer's own ears, and to the transport as one
  7:  * batch for everyone else's. The two share the timeline, so what the
  8:  * performer hears is what the room hears, later by the receivers' delay.
  9:  *
 10:  * "A tale of two clocks": the tick runs on a timer, the notes are stamped
 11:  * on `AudioContext.currentTime`. Events go out `leadMs` ahead of local
 12:  * playback (SS14 sends 200 ms early), so a receiver on a normal connection
 13:  * never gets a note after its time.
 14:  *
 15:  * `baseMs` in a batch counts from `t0`, the audio time the performance
 16:  * started - the proxy compares it with its own clock to spot a client
 17:  * pre-buffering a flood, and receivers only ever use the differences.
 18:  *
 19:  * Pure: the clock and the sink are injected, so the unit tests drive it.
 20:  */
 21: 
 22: export type BatchEvent = { dt: number; status: number; d1: number; d2: number };
 23: 
 24: export type SequencerClock = {
 25:   /** Audio time, seconds. */
 26:   now(): number;
 27: };
 28: 
 29: export type SequencerSink = {
 30:   /** A note for the performer's own sampler, at audio time `when`. */
 31:   schedule(ev: MidiEvent, when: number): void;
 32:   /** One send window's events for the transport. */
 33:   batch(baseMs: number, events: BatchEvent[]): void;
 34:   /** The song ran out with `loop` off. */
 35:   ended?(): void;
 36: };
 37: 
 38: export type SequencerOptions = {
 39:   tickMs?: number;
 40:   leadMs?: number;
 41:   localDelayMs?: number;
 42:   /** Silence between one pass of the song and the next when looping. */
 43:   loopGapMs?: number;
 44: };
 45: 
 46: /** Milliseconds between ticks; a window's worth of events per batch. */
 47: const TICK_MS = 100;
 48: 
 49: /** How far ahead of local playback a batch leaves. */
 50: const LEAD_MS = 200;
 51: 
 52: /** Lookahead of the local schedule over the clock - jitter cover for the timer. */
 53: const LOCAL_DELAY_MS = 250;
 54: 
 55: const LOOP_GAP_MS = 400;
 56: 
 57: const ALL_NOTES_OFF = 123;
 58: 
 59: export class Sequencer {
 60:   private song: ParsedMidi | null = null;
 61:   private cursor = 0;
 62:   /** Audio time (s) that song ms 0 maps to while playing. */
 63:   private origin = 0;
 64:   private t0 = 0;
 65:   private started = false;
 66:   private _playing = false;
 67:   private _paused = false;
 68:   private _loop = false;
 69:   private pausedAtMs = 0;
 70:   /**
 71:    * Channels voiced locally; every channel is still sent. Percussion is out
 72:    * until the facade says the instrument renders it.
 73:    */
 74:   localMask = 0xffff & ~(1 << 9);
 75:   private readonly tickMs: number;
 76:   private readonly leadMs: number;
 77:   private readonly localDelayMs: number;
 78:   private readonly loopGapMs: number;
 79: 
 80:   constructor(
 81:     private readonly clock: SequencerClock,
 82:     private readonly sink: SequencerSink,
 83:     options: SequencerOptions = {}
 84:   ) {
 85:     this.tickMs = options.tickMs ?? TICK_MS;
 86:     this.leadMs = options.leadMs ?? LEAD_MS;
 87:     this.localDelayMs = options.localDelayMs ?? LOCAL_DELAY_MS;
 88:     this.loopGapMs = options.loopGapMs ?? LOOP_GAP_MS;
 89:   }
 90: 
 91:   get playing(): boolean {
 92:     return this._playing;
 93:   }
 94: 
 95:   get paused(): boolean {
 96:     return this._paused;
 97:   }
 98: 
 99:   get loop(): boolean {
100:     return this._loop;
101:   }
102: 
103:   set loop(value: boolean) {
104:     this._loop = value;
105:   }
106: 
107:   get loaded(): ParsedMidi | null {
108:     return this.song;
109:   }
110: 
111:   /** Song position in ms: where playback is, or where it paused, or 0. */
112:   get positionMs(): number {
113:     if (this._playing) {
114:       const pos = (this.clock.now() - this.origin) * 1000;
115:       return Math.max(0, Math.min(this.song?.durationMs ?? 0, pos));
116:     }
117:     return this._paused ? this.pausedAtMs : 0;
118:   }
119: 
120:   /** The performance begins: `baseMs` counts from now. Once per take-out. */
121:   startClock(): void {
122:     this.t0 = this.clock.now();
123:     this.started = true;
124:   }
125: 
126:   load(song: ParsedMidi): void {
127:     this.stop();
128:     this.song = song;
129:   }
130: 
131:   play(): void {
132:     if (!this.song) return;
133:     if (!this.started) this.startClock();
134:     if (this._playing) return;
135:     const from = this._paused ? this.pausedAtMs : 0;
136:     this.origin = this.clock.now() + this.localDelayMs / 1000 - from / 1000;
137:     this.cursor = 0;
138:     while (this.cursor < this.song.events.length && this.song.events[this.cursor].ms < from) this.cursor++;
139:     this._playing = true;
140:     this._paused = false;
141:   }
142: 
143:   pause(): void {
144:     if (!this._playing) return;
145:     this.pausedAtMs = this.positionMs;
146:     this._playing = false;
147:     this._paused = true;
148:     this.silence();
149:   }
150: 
151:   stop(): void {
152:     const wasSounding = this._playing || this._paused;
153:     this._playing = false;
154:     this._paused = false;
155:     this.pausedAtMs = 0;
156:     this.cursor = 0;
157:     if (wasSounding) this.silence();
158:   }
159: 
160:   /** Every channel off, now, locally and on the wire. */
161:   silence(): void {
162:     const now = this.clock.now();
163:     const events: BatchEvent[] = [];
164:     const used = this.song ? this.song.channels : [];
165:     for (let c = 0; c < 16; c++) {
166:       if (used.length && !used[c].used) continue;
167:       const ev: MidiEvent = { ms: 0, status: 0xb0 | c, d1: ALL_NOTES_OFF, d2: 0 };
168:       if (this.voicesLocally(c)) this.sink.schedule(ev, now);
169:       events.push({ dt: 0, status: ev.status, d1: ev.d1, d2: ev.d2 });
170:     }
171:     if (events.length) this.sink.batch(this.baseMs(now), events);
172:   }
173: 
174:   /** One send window. Call every `tickMs`; a late call just sends a bigger window. */
175:   tick(): void {
176:     if (!this._playing || !this.song) return;
177:     const { events, durationMs } = this.song;
178:     const now = this.clock.now();
179:     const windowEndMs = (now - this.origin) * 1000 + this.leadMs + this.tickMs;
180: 
181:     const out: BatchEvent[] = [];
182:     let base = -1;
183: 
184:     const emit = (ev: MidiEvent): void => {
185:       const when = this.origin + ev.ms / 1000;
186:       if (this.voicesLocally(ev.status & 0x0f)) this.sink.schedule(ev, when);
187:       const absMs = this.baseMs(when);
188:       if (base < 0) base = absMs;
189:       out.push({ dt: Math.max(0, absMs - base), status: ev.status, d1: ev.d1, d2: ev.d2 });
190:     };
191: 
192:     // Guard against a pathological song looping inside one window.
193:     for (let passes = 0; passes < 8; passes++) {
194:       while (this.cursor < events.length && events[this.cursor].ms <= windowEndMs) {
195:         emit(events[this.cursor++]);
196:       }
197:       if (this.cursor < events.length) break;
198: 
199:       // Past the last event.
200:       const passEndMs = durationMs + this.loopGapMs;
201:       if (this._loop) {
202:         if (passEndMs > windowEndMs) break;
203:         this.origin += passEndMs / 1000;
204:         this.cursor = 0;
205:         continue;
206:       }
207:       if ((now - this.origin) * 1000 >= durationMs) {
208:         this._playing = false;
209:         this.cursor = 0;
210:         if (out.length) this.sink.batch(base, out);
211:         this.sink.ended?.();
212:         return;
213:       }
214:       break;
215:     }
216: 
217:     if (out.length) this.sink.batch(base, out);
218:   }
219: 
220:   private voicesLocally(channel: number): boolean {
221:     return (this.localMask & (1 << channel)) !== 0;
222:   }
223: 
224:   private baseMs(when: number): number {
225:     return Math.max(0, Math.round((when - this.t0) * 1000));
226:   }
227: }
</file>

<file path="src/common/band/testMidi.ts">
  1: /**
  2:  * A small Standard MIDI File built in code: format 1, 120 bpm, 480 ticks per
  3:  * quarter, two tracks. "Lead" plays a C-major arpeggio in quarter notes on
  4:  * channel 1 for eight bars; "Drums" puts a kick and a closed hat on channel
  5:  * 10, which the band system drops until an instrument renders percussion -
  6:  * so a test that hears the hat has found a bug.
  7:  *
  8:  * Feeds both `tools/instrumentSamples.ts --test-midi` (`public/dev/band/
  9:  * scale.mid`) and the parser / sequencer unit tests, so the bytes on disk and
 10:  * the bytes under test are the same.
 11:  */
 12: 
 13: const DIVISION = 480;
 14: const BARS = 8;
 15: 
 16: /** Variable-length quantity, as the format spells delta times. */
 17: function vlq(value: number): number[] {
 18:   const out = [value & 0x7f];
 19:   let v = value >> 7;
 20:   while (v > 0) {
 21:     out.unshift((v & 0x7f) | 0x80);
 22:     v >>= 7;
 23:   }
 24:   return out;
 25: }
 26: 
 27: function str(text: string): number[] {
 28:   return Array.from(new TextEncoder().encode(text));
 29: }
 30: 
 31: function u32(value: number): number[] {
 32:   return [(value >>> 24) & 0xff, (value >>> 16) & 0xff, (value >>> 8) & 0xff, value & 0xff];
 33: }
 34: 
 35: function u16(value: number): number[] {
 36:   return [(value >>> 8) & 0xff, value & 0xff];
 37: }
 38: 
 39: function chunk(tag: string, body: number[]): number[] {
 40:   return [...str(tag), ...u32(body.length), ...body];
 41: }
 42: 
 43: type Event = { delta: number; bytes: number[] };
 44: 
 45: function track(name: string, events: Event[]): number[] {
 46:   const body: number[] = [...vlq(0), 0xff, 0x03, name.length, ...str(name)];
 47:   for (const e of events) body.push(...vlq(e.delta), ...e.bytes);
 48:   body.push(...vlq(0), 0xff, 0x2f, 0x00);
 49:   return chunk('MTrk', body);
 50: }
 51: 
 52: /** The arpeggio's notes, one bar = C4 E4 G4 C5. */
 53: export const TEST_LEAD_NOTES = [60, 64, 67, 72] as const;
 54: 
 55: export const TEST_TEMPO_BPM = 120;
 56: 
 57: /** Milliseconds one quarter note lasts at the test tempo. */
 58: export const TEST_QUARTER_MS = 60000 / TEST_TEMPO_BPM;
 59: 
 60: export function buildTestMidi(): Uint8Array {
 61:   const tempo: Event[] = [
 62:     { delta: 0, bytes: [0xff, 0x51, 0x03, ...u32(60_000_000 / TEST_TEMPO_BPM).slice(1)] },
 63:   ];
 64: 
 65:   const lead: Event[] = [];
 66:   for (let bar = 0; bar < BARS; bar++) {
 67:     for (const note of TEST_LEAD_NOTES) {
 68:       lead.push({ delta: 0, bytes: [0x90, note, 100] });
 69:       // Note off as a note-on at velocity 0, the common running-status form.
 70:       lead.push({ delta: DIVISION - 10, bytes: [0x90, note, 0] });
 71:       lead.push({ delta: 10, bytes: [] });
 72:     }
 73:   }
 74:   // Merge the empty spacers into the next delta.
 75:   const leadEvents: Event[] = [];
 76:   let carry = 0;
 77:   for (const e of lead) {
 78:     if (e.bytes.length === 0) {
 79:       carry += e.delta;
 80:       continue;
 81:     }
 82:     leadEvents.push({ delta: e.delta + carry, bytes: e.bytes });
 83:     carry = 0;
 84:   }
 85: 
 86:   const drums: Event[] = [];
 87:   for (let beat = 0; beat < BARS * 4; beat++) {
 88:     const kick = beat % 2 === 0;
 89:     drums.push({ delta: 0, bytes: [0x99, kick ? 36 : 42, 90] });
 90:     drums.push({ delta: DIVISION / 2, bytes: [0x89, kick ? 36 : 42, 0] });
 91:     drums.push({ delta: DIVISION / 2, bytes: [] });
 92:   }
 93:   const drumEvents: Event[] = [];
 94:   carry = 0;
 95:   for (const e of drums) {
 96:     if (e.bytes.length === 0) {
 97:       carry += e.delta;
 98:       continue;
 99:     }
100:     drumEvents.push({ delta: e.delta + carry, bytes: e.bytes });
101:     carry = 0;
102:   }
103: 
104:   const header = chunk('MThd', [...u16(1), ...u16(3), ...u16(DIVISION)]);
105: 
106:   return new Uint8Array([
107:     ...header,
108:     ...track('Tempo', tempo),
109:     ...track('Lead', leadEvents),
110:     ...track('Drums', drumEvents),
111:   ]);
112: }
</file>

