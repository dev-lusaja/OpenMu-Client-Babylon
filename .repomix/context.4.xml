 928: /**
 929:  * `BlendMeshTexCoordU/V` (ZzzBMD.cpp `EnableWave`, :2146): the original adds a
 930:  * per-object offset to every texel lookup of one mesh, which is how water,
 931:  * waterfalls, sand-falls and the Dungeon flesh curtains move.
 932:  *
 933:  * Babylon's own texture matrix cannot carry it here: the shared item material
 934:  * is frozen, its `diffuseTexture` is a single placeholder, and the real
 935:  * texture is rebound per mesh in `onBindObservable`. With an identity
 936:  * placeholder Babylon compiles `DIFFUSEDIRECTUV = 1`, so `vDiffuseUV` is the
 937:  * raw attribute and there is no matrix uniform left to write.
 938:  *
 939:  * So the offset is its own uniform and the texel is re-fetched in the
 940:  * fragment, at `CUSTOM_FRAGMENT_UPDATE_DIFFUSE` - the first hook that runs
 941:  * after `baseColor = texture2D(diffuseSampler, vDiffuseUV + uvOffset)`.
 942:  *
 943:  * **Do not move this to the vertex stage.** Offsetting the varying there
 944:  * looks better on paper (one fetch, and the alpha test would see the scrolled
 945:  * texel) and it does not compile: `vDiffuseUV` is a *fragment-only* symbol.
 946:  * Babylon declares it through `samplerFragmentDeclaration`, and when the
 947:  * texture matrix is identity - which the shared placeholder always is, so
 948:  * `DIFFUSEDIRECTUV = 1` - it is a `#define` onto `vMainUV1` emitted into the
 949:  * fragment shader alone. Writing to it from `Vertex_MainEnd` is an undeclared
 950:  * identifier, the program fails to link, and Babylon dumps the whole shader
 951:  * to the console. Tried, reverted; this comment is the record.
 952:  *
 953:  * The `#ifdef DIFFUSE` guard is not decoration either: `diffuseSampler` and
 954:  * `vDiffuseUV` both live inside that block, so an unguarded body would fail
 955:  * the same way on any variant compiled without a diffuse texture.
 956:  *
 957:  * What this costs is the alpha test, which runs on the *unscrolled* texel a
 958:  * few lines earlier. It shows only on alpha-keyed scrollers - Noria's
 959:  * waterfall curtains (42/43) and Lost Tower's conduits (3/4) - where the
 960:  * texture slides inside a key that stays put. Both are near-uniform masks, so
 961:  * it is close to invisible; the fix, when it matters, is
 962:  * `ALPHATEST_AFTERALLALPHACOMPUTATIONS`, which Babylon does not expose here.
 963:  *
 964:  * It exists only on the bright/flat-lit variants - the ones MU marks
 965:  * `BlendMesh` or `StreamMesh`, which is every mesh that can scroll - so the
 966:  * ordinary lit path compiles exactly as before.
 967:  */
 968: const UV_SCROLL_UNIFORM = 'muUvScroll';
 969: 
 970: const UV_SCROLL_RESAMPLE = `
 971:   #ifdef DIFFUSE
 972:     if (${UV_SCROLL_UNIFORM}.x != 0.0 || ${UV_SCROLL_UNIFORM}.y != 0.0) {
 973:       baseColor = texture2D(diffuseSampler, vDiffuseUV + ${UV_SCROLL_UNIFORM});
 974:     }
 975:   #endif
 976: `;
 977: 
 978: /** Per-mesh scroll offset, written each frame by the object that owns it. */
 979: export type UvScroll = { u: number; v: number };
 980: 
 981: /**
 982:  * Give a shared item material a **per-mesh** alpha-test texture.
 983:  *
 984:  * Every off-screen pass Babylon runs - the geometry buffer, the cascades, the
 985:  * glow layer - alpha-tests with its own effect, not the material's, so none of
 986:  * them ever reaches `onBindObservable`. What they bind into `diffuseSampler`
 987:  * is whatever `getAlphaTestTexture()` hands back, and on a shared material
 988:  * that is the 2×2 opaque placeholder: alpha 1 everywhere, so the test passes
 989:  * everywhere and a keyed mesh writes its whole quad. That is why the G-buffer
 990:  * could only ever hold the opaque meshes - grass and leaves went into it as
 991:  * solid blocks and SSAO smeared them across the ground.
 992:  *
 993:  * Babylon always calls `needAlphaTestingForMesh(mesh)` immediately before
 994:  * `getAlphaTestTexture()` - geometryBufferRenderer, shadowGenerator and
 995:  * thinEffectLayer all do, and the `&&` between them fixes the order - so the
 996:  * first is where the mesh is picked up and the second is where its texture is
 997:  * handed over. Same trick `createCsm` uses through
 998:  * `onBeforeShadowMapRenderMeshObservable`, expressed through the API the
 999:  * other passes actually query.
1000:  *
1001:  * The lit path is untouched: `isReadyForSubMesh` reads `_diffuseTexture` /
1002:  * `_albedoTexture` directly, and the placeholder still stands in whenever no
1003:  * mesh is being rendered, so the ALPHATEST define never flickers.
1004:  */
1005: export function useMeshAlphaTestTexture(material: Material): void {
1006:   const placeholder = material.getAlphaTestTexture();
1007:   const needsTest = material.needAlphaTestingForMesh.bind(material);
1008: 
1009:   let current: AbstractMesh | null = null;
1010: 
1011:   material.needAlphaTestingForMesh = (mesh: AbstractMesh) => {
1012:     current = mesh;
1013:     return needsTest(mesh);
1014:   };
1015: 
1016:   material.getAlphaTestTexture = () =>
1017:     (current?.metadata?.diffuseTexture as BaseTexture | undefined) ??
1018:     placeholder;
1019: }
1020: 
1021: export function createItemMaterial(
1022:   scene: Scene,
1023:   bright = false,
1024:   flatLit = false,
1025:   withScroll = false
1026: ) {
1027:   const simpleMaterial = new CustomMaterial('itemMaterial', scene);
1028: 
1029:   simpleMaterial.diffuseColor.setAll(1);
1030: 
1031:   simpleMaterial.specularColor.setAll(0);
1032: 
1033:   simpleMaterial.maxSimultaneousLights = 2 + pointLightPoolSize();
1034: 
1035:   addItemUniforms(simpleMaterial, scene);
1036:   // Outside the Material UBO, so the per-mesh write below actually lands -
1037:   // see bindBodyLight.
1038:   simpleMaterial.AddUniform(BODY_LIGHT_UNIFORM, 'vec4', null);
1039: 
1040:   if (!bright && !flatLit) addLitDefines(simpleMaterial, scene);
1041: 
1042:   addInstanceAttribute(simpleMaterial);
1043: 
1044:   simpleMaterial.Fragment_Definitions(
1045:     lightTintGlsl() +
1046:       cloudFieldGlsl(false) +
1047:       INSTANCE_FRAGMENT_DEFINITIONS +
1048:       toonFunctionsGlsl()
1049:   );
1050: 
1051:   // Glow cards and flat-lit UI models never take a cap; the uniform is
1052:   // still declared for them (addItemUniforms) and simply unread.
1053:   simpleMaterial.Fragment_Custom_Diffuse(`
1054: ${withScroll ? UV_SCROLL_RESAMPLE : ''}
1055: ${
1056:   bright || flatLit
1057:     ? ''
1058:     : toonTextureGlsl(
1059:         'diffuseSampler',
1060:         withScroll ? `vDiffuseUV + ${UV_SCROLL_UNIFORM}` : 'vDiffuseUV + uvOffset',
1061:         'baseColor.rgb',
1062:         'DIFFUSE'
1063:       ) + snowCapGlsl('baseColor')
1064: }
1065:   `);
1066:   if (withScroll) {
1067:     simpleMaterial.AddUniform(UV_SCROLL_UNIFORM, 'vec2', null);
1068:   }
1069: 
1070:   simpleMaterial.Fragment_Before_FragColor(legacyPasses(STANDARD_VARS));
1071: 
1072:   // The sun response lands on `diffuseBase` before the UNCLAMP recompute
1073:   // reads it; glow cards and flat-lit models take neither.
1074:   simpleMaterial.Fragment_Before_Fog(`
1075: ${bright || flatLit ? '' : sunResponseGlsl('diffuseBase', '') + UNCLAMP}${
1076:     bright ? brightOverride(withScroll) : ''
1077:   }${flatLit ? FLAT_LIT_OVERRIDE : ''}
1078: `);
1079: 
1080:   trackTime(scene, now => {
1081:     simpleMaterial.onBindObservable.add(mesh => {
1082:       const effect = simpleMaterial.getEffect();
1083:       if (!effect) return;
1084: 
1085:       bindItemEffect(effect, mesh, now());
1086: 
1087:       effect.setTexture('diffuseSampler', mesh.metadata!.diffuseTexture);
1088: 
1089:       if (withScroll) {
1090:         const scroll = mesh.metadata!.uvScroll as UvScroll | undefined;
1091:         effect.setFloat2(UV_SCROLL_UNIFORM, scroll?.u ?? 0, scroll?.v ?? 0);
1092:       }
1093: 
1094:       effect.setFloat4(BODY_LIGHT_UNIFORM, 1, 1, 1, mesh.visibility);
1095:       bindBodyLight(effect, mesh, BODY_LIGHT_UNIFORM);
1096:     });
1097:   });
1098: 
1099:   return simpleMaterial;
1100: }
