  1: import { Animation, AnimationGroup, Quaternion, Vector3 } from '../../libs/babylon/exports';
  2: import type { ModelObject } from '../modelObject';
  3: 
  4: /**
  5:  * The instrument clips: frames copied out of an existing emote. The rig has
  6:  * no instrument animations and its clip table is full, but a few keys of
  7:  * the right emote - the end of Again, the start of Hustle - are a player
  8:  * holding an instrument; looped there and back they are a player playing
  9:  * one. The copy is made per model instance the first time it is needed and
 10:  * appended to that model's animation groups, so it plays like any clip.
 11:  *
 12:  * The copy is played at its own pace, not the source's: the window is a few
 13:  * hundredths of a clip, and a loop that short ran at seven hertz - the
 14:  * instrument shook. `SWAY_SECONDS` is the half-period the two poses are
 15:  * spread over, and the frames between them are re-timed into it.
 16:  *
 17:  * A pose is a hold, not a step of the dance the frames came from, so the
 18:  * copy is tamed on the way in: every bone keeps the position of the first
 19:  * frame (the emote's root travel is what read as the body lunging at the
 20:  * guitar), the hips and legs keep its rotation too, and what is left - the
 21:  * spine, arms and head - goes only `sway` of the way toward the last frame.
 22:  *
 23:  * `from` / `to` are fractions of the source clip.
 24:  */
 25: 
 26: /**
 27:  * Seconds from the first pose to the last, so a loop is twice this. Played at
 28:  * `CLIP_SPEED` (bandSystem), which is the speed that makes one clip frame one
 29:  * frame of playback.
 30:  */
 31: const SWAY_SECONDS = 1.2;
 32: 
 33: /** Keyed by the loaded rig, not the ModelObject: a reload brings a fresh clip table. */
 34: const cache = new WeakMap<object, Map<string, number>>();
 35: 
 36: /**
 37:  * Bones held rigid, by the rig's Biped names: the root (`bone_0_Bip01`), its
 38:  * footsteps helper, the pelvis and both legs, and the mesh dummies that ride
 39:  * the root.
 40:  */
 41: const HELD_BONE = /Bip01( Footsteps| Pelvis| [LR] (Thigh|Calf|Foot|Toe\d*))?$|Mesh\d+$|_gfh$/;
 42: 
 43: export function instrumentClip(model: ModelObject, source: number, from: number, to: number, sway = 1): number | null {
 44:   const gltf = model.gltf;
 45:   if (!gltf) return null;
 46:   const key = `${source}:${from}:${to}:${sway}`;
 47:   let clips = cache.get(gltf);
 48:   if (!clips) {
 49:     clips = new Map();
 50:     cache.set(gltf, clips);
 51:   }
 52:   const known = clips.get(key);
 53:   if (known !== undefined) return known;
 54: 
 55:   const src = gltf.animationGroups[source];
 56:   const first = src?.targetedAnimations[0];
 57:   if (!src || !first) return null;
 58: 
 59:   const f0 = src.from + from * (src.to - src.from);
 60:   const f1 = src.from + to * (src.to - src.from);
 61:   // The window's own width is a frame or two; the sway takes as long as it
 62:   // takes, and the frames inside are re-timed into that span rather than
 63:   // bunching at its start.
 64:   const span = Math.max(0.5, SWAY_SECONDS * (first.animation.framePerSecond || 60));
 65:   const stretch = f1 > f0 ? span / (f1 - f0) : 0;
 66:   const group = new AnimationGroup(`instrument_${key}`, first.target.getScene());
 67: 
 68:   for (const ta of src.targetedAnimations) {
 69:     const anim = ta.animation;
 70:     const base = cloneValue(anim.evaluate(f0));
 71:     const held = anim.targetProperty === 'position' || HELD_BONE.test(ta.target.name ?? '');
 72:     const tame = (value: unknown): unknown => (held ? cloneValue(base) : swayToward(base, value, sway));
 73:     const inside = anim
 74:       .getKeys()
 75:       .filter(k => k.frame > f0 && k.frame < f1)
 76:       .map(k => ({ frame: (k.frame - f0) * stretch, value: tame(k.value) }));
 77:     const forward = [
 78:       { frame: 0, value: cloneValue(base) },
 79:       ...inside,
 80:       { frame: span, value: tame(anim.evaluate(f1)) },
 81:     ];
 82:     // There and back: the loop closes on itself with no jump.
 83:     const back = forward
 84:       .slice(1, -1)
 85:       .reverse()
 86:       .map(k => ({ frame: 2 * span - k.frame, value: cloneValue(k.value) }));
 87:     const copy = new Animation(anim.name, anim.targetProperty, anim.framePerSecond, anim.dataType, Animation.ANIMATIONLOOPMODE_CYCLE);
 88:     copy.setKeys([...forward, ...back, { frame: 2 * span, value: cloneValue(forward[0].value) }]);
 89:     group.addTargetedAnimation(copy, ta.target);
 90:   }
 91: 
 92:   const index = gltf.animationGroups.push(group) - 1;
 93:   clips.set(key, index);
 94:   return index;
 95: }
 96: 
 97: /** `value` pulled back toward `base`: a rotation by slerp, a vector by lerp, anything else as it is. */
 98: function swayToward(base: unknown, value: unknown, t: number): unknown {
 99:   if (t >= 1) return cloneValue(value);
100:   if (base instanceof Quaternion && value instanceof Quaternion) return Quaternion.Slerp(base, value, t);
101:   if (base instanceof Vector3 && value instanceof Vector3) return Vector3.Lerp(base, value, t);
102:   return cloneValue(value);
103: }
104: 
105: function cloneValue<T>(value: T): T {
106:   const v = value as { clone?: () => T };
107:   return typeof v?.clone === 'function' ? v.clone() : value;
108: }
</file>

<file path="src/common/band/performing.ts">
 1: import type { Entity, World } from '../../ecs/world';
 2: import { genderedEmoteAction } from '../emotes';
 3: import { instrumentById, type InstrumentId } from '../instruments';
 4: 
 5: /**
 6:  * The `performing` component's two writers, in one place: the facade for the
 7:  * hero and for remote performers, `BandSystem` when a performer moves or
 8:  * dies. Everything else reads the component.
 9:  */
10: 
11: export type Performer = Entity & Required<Pick<Entity, 'playerAnimation' | 'transform'>>;
12: 
13: /** One note to show at audio time `when`: its MIDI pitch and velocity. */
14: export type BandHit = { when: number; note: number; velocity: number };
15: 
16: export function startPerforming(world: World, entity: Performer, instrument: InstrumentId, local: boolean): void {
17:   const def = instrumentById(instrument);
18:   if (entity.performing) {
19:     if (entity.performing.instrument === instrument) return;
20:     stopPerforming(world, entity);
21:   }
22:   const isFemale = entity.attributeSystem?.isAboveZero('isFemale') ?? false;
23:   world.addComponent(entity, 'performing', {
24:     instrument,
25:     source: genderedEmoteAction(def.pose.clip, isFemale),
26:     clip: -1,
27:     local,
28:     hits: [],
29:     model: null,
30:   });
31: }
32: 
33: export function stopPerforming(world: World, entity: Entity): void {
34:   if (!entity.performing) return;
35:   world.removeComponent(entity, 'performing');
36: }
37: 
38: /** A hit to show at audio time `when`, kept in time order. */
39: export function queueHit(entity: Entity, when: number, note: number, velocity: number): void {
40:   const p = entity.performing;
41:   if (!p) return;
42:   const hits = p.hits;
43:   const hit: BandHit = { when, note, velocity };
44:   if (hits.length === 0 || hits[hits.length - 1].when <= when) {
45:     hits.push(hit);
46:     return;
47:   }
48:   let i = hits.length;
49:   while (i > 0 && hits[i - 1].when > when) i--;
50:   hits.splice(i, 0, hit);
51: }
</file>

