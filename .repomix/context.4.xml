 1: import type { Scene } from '../libs/babylon/exports';
 2: import type { Entity } from '../ecs/world';
 3: import { effects } from '../effects';
 4: import { entityPos, tmpA } from '../effects/core';
 5: import { BLOOD_CHIPS, BLOOD_MIST, HIT_SPARKS, SAND_SMOKE } from '../effects/recipes';
 6: import { MonsterActionType } from './objects/enum';
 7: import { monsterModelTypeOf } from './playSpeed';
 8: 
 9: /**
10:  * What a walking sand-monster and a landed blow draw - the consumer table for
11:  * `ecs/systems/impactEffectSystem.ts` ("Footstep dust / hit
12:  * impacts"), in the shape of `deathVisuals.ts`.
13:  *
14:  * - **Sand smoke**: `MonsterMoveSandSmoke` (ZzzCharacter.cpp:5456): while a
15:  *   Tarkan / Kalima monster plays `MONSTER01_WALK` it drops one
16:  *   `BITMAP_SMOKE + 1` puff per 25 Hz tick (`rand_fps_check(1)`), anywhere
17:  *   within ±100 cm of its origin, on the ground. The **hero never raises
18:  *   dust**: `PlayWalkSound` (:5230) only picks a sound, and no
19:  *   `CreateParticle` in the client is tied to a footfall - walking Lorencia
20:  *   stone, Noria grass or Devias snow draws nothing.
21:  * - **Blow**: `BITMAP_SPARK` chips from the struck body (the spark loop next
22:  *   to `CreateBlood`, ZzzEffectBlurSpark.cpp:436, throws 20 of them), plus a
23:  *   few blood flecks when health - not just shield - was taken.
24:  */
25: 
26: // ---- sand smoke ------------------------------------------------------------------
27: 
28: /**
29:  * The monster models whose `MoveCharacterVisual` case calls
30:  * `MonsterMoveSandSmoke` (ZzzCharacter.cpp:5720-5866): Golden Wheel 41,
31:  * Tantallos 42 (the plain one - its fire-lit `SubType 1` variant burns
32:  * instead, and the client has no SubType yet), Bloody Wolf 43, Beam Knight
33:  * 44, Mutant 45, Red Skeleton Knight 88.
34:  */
35: const SAND_SMOKE_MODELS: ReadonlySet<number> = new Set([41, 42, 43, 44, 45, 88]);
36: 
37: /** Puffs per second: `rand_fps_check(1)` is every 25 Hz tick. */
38: export const SAND_SMOKE_RATE = 25;
39: 
40: /** `rand() % 200 - 100` cm each way. */
41: const SAND_SMOKE_SCATTER = 1;
42: 
43: /** Whether this entity is a sand monster walking right now. */
44: export function raisesSandSmoke(e: Entity): boolean {
45:   return (
46:     e.monsterAnimation?.action === MonsterActionType.Walk &&
47:     SAND_SMOKE_MODELS.has(monsterModelTypeOf(e.npcType))
48:   );
49: }
50: 
51: /** One `CreateParticle(BITMAP_SMOKE + 1, …)` somewhere under the monster. */
52: export function spawnSandSmoke(scene: Scene, monster: Entity): void {
53:   const at = entityPos(monster, 0, tmpA);
54:   at.x += (Math.random() * 2 - 1) * SAND_SMOKE_SCATTER;
55:   at.z += (Math.random() * 2 - 1) * SAND_SMOKE_SCATTER;
56:   effects.spawn('particles', scene, at, { recipe: SAND_SMOKE, count: 1 });
57: }
58: 
59: // ---- blow ------------------------------------------------------------------------
60: 
61: /** Chips per landed blow: the original's CreateSpark loop throws 20 (at 1.6–2.8 cm a chip). */
62: const HIT_SPARK_COUNT = 20;
63: /** Blood flecks when health was taken, and the softer spray behind them. */
64: const HIT_BLOOD_COUNT = 6;
65: const HIT_BLOOD_MIST_COUNT = 2;
66: /** Tiles above the feet a blow lands (the chest; skillVisuals' IMPACT_HEIGHT). */
67: const HIT_HEIGHT = 0.9;
68: 
69: export function spawnHitImpact(
70:   scene: Scene,
71:   target: Entity,
72:   healthDamage: number,
73:   shieldDamage: number
74: ): void {
75:   if (healthDamage + shieldDamage <= 0) return;
76:   const at = entityPos(target, HIT_HEIGHT, tmpA);
77:   effects.spawn('particles', scene, at, { recipe: HIT_SPARKS, count: HIT_SPARK_COUNT });
78:   if (healthDamage > 0) {
79:     effects.spawn('particles', scene, at, { recipe: BLOOD_CHIPS, count: HIT_BLOOD_COUNT });
80:     effects.spawn('particles', scene, at, { recipe: BLOOD_MIST, count: HIT_BLOOD_MIST_COUNT });
81:   }
82: }
