<file path="src/common/band/midiFile.ts">
  1: /**
  2:  * A Standard MIDI File, read into the events the band system plays: note on
  3:  * / off and the two "everything off" controllers, each with an absolute time
  4:  * in milliseconds, plus what each channel is called.
  5:  *
  6:  * Formats 0 and 1 with a ticks-per-quarter division (format 2 and SMPTE
  7:  * timing are refused: nobody's song file is either, and the tempo map below
  8:  * assumes ticks). Tracks are merged by tick so a tempo change in track 0
  9:  * applies to every track, as the format intends. Running status is honoured.
 10:  * SysEx and every other meta event are skipped.
 11:  *
 12:  * What is deliberately dropped: program changes (the chosen instrument voices
 13:  * every channel), pitch bend, aftertouch and the other controllers - the
 14:  * sampler has no use for them, and every event kept is bytes on the wire.
 15:  */
 16: 
 17: export type MidiEvent = {
 18:   /** Absolute time from the start of the song. */
 19:   ms: number;
 20:   /** Status byte with the channel in the low nibble: 0x8n, 0x9n, 0xBn. */
 21:   status: number;
 22:   d1: number;
 23:   d2: number;
 24: };
 25: 
 26: export type MidiChannel = {
 27:   /** Whether any note is played on this channel. */
 28:   used: boolean;
 29:   /** The name of the first track that plays notes on it, or "Ch N". */
 30:   name: string;
 31:   noteCount: number;
 32: };
 33: 
 34: export type ParsedMidi = {
 35:   durationMs: number;
 36:   /** Sixteen channels, index = MIDI channel (9 is percussion). */
 37:   channels: MidiChannel[];
 38:   /** Sorted by `ms`, ties in file order. */
 39:   events: MidiEvent[];
 40: };
 41: 
 42: export class MidiFileError extends Error {}
 43: 
 44: const DEFAULT_US_PER_QUARTER = 500_000;
 45: 
 46: /** Controllers the sampler acts on: all sound off (120), all notes off (123). */
 47: const KEPT_CONTROLLERS = new Set([120, 123]);
 48: 
 49: type Raw = {
 50:   tick: number;
 51:   order: number;
 52:   status: number;
 53:   d1: number;
 54:   d2: number;
 55:   track: number;
 56: };
 57: 
 58: class Reader {
 59:   pos = 0;
 60: 
 61:   constructor(private readonly bytes: Uint8Array) {}
 62: 
 63:   get eof(): boolean {
 64:     return this.pos >= this.bytes.length;
 65:   }
 66: 
 67:   u8(): number {
 68:     if (this.pos >= this.bytes.length) throw new MidiFileError('unexpected end of file');
 69:     return this.bytes[this.pos++];
 70:   }
 71: 
 72:   u16(): number {
 73:     return (this.u8() << 8) | this.u8();
 74:   }
 75: 
 76:   u32(): number {
 77:     return ((this.u8() << 24) | (this.u8() << 16) | (this.u8() << 8) | this.u8()) >>> 0;
 78:   }
 79: 
 80:   vlq(): number {
 81:     let value = 0;
 82:     for (let i = 0; i < 4; i++) {
 83:       const b = this.u8();
 84:       value = (value << 7) | (b & 0x7f);
 85:       if ((b & 0x80) === 0) return value;
 86:     }
 87:     throw new MidiFileError('bad variable-length quantity');
 88:   }
 89: 
 90:   skip(n: number): void {
 91:     this.pos += n;
 92:   }
 93: 
 94:   text(n: number): string {
 95:     const slice = this.bytes.subarray(this.pos, this.pos + n);
 96:     this.pos += n;
 97:     return new TextDecoder('latin1').decode(slice).replace(/\0+$/, '').trim();
 98:   }
 99: 
100:   tag(): string {
101:     return String.fromCharCode(this.u8(), this.u8(), this.u8(), this.u8());
102:   }
103: }
104: 
105: /** Bytes of data after a status byte, for the channel messages. */
106: function dataLength(status: number): number {
107:   const kind = status & 0xf0;
108:   return kind === 0xc0 || kind === 0xd0 ? 1 : 2;
109: }
110: 
111: export function parseMidi(bytes: Uint8Array): ParsedMidi {
112:   const r = new Reader(bytes);
113: 
114:   if (r.tag() !== 'MThd') throw new MidiFileError('not a MIDI file');
115:   const headerLength = r.u32();
116:   const format = r.u16();
117:   const trackCount = r.u16();
118:   const division = r.u16();
119:   r.skip(headerLength - 6);
120: 
121:   if (format !== 0 && format !== 1) throw new MidiFileError(`format ${format} is not supported`);
122:   if (division & 0x8000) throw new MidiFileError('SMPTE timing is not supported');
123:   if (division === 0) throw new MidiFileError('bad division');
124: 
125:   const raw: Raw[] = [];
126:   const tempos: { tick: number; usPerQuarter: number; order: number }[] = [];
127:   const trackNames: string[] = [];
128:   let order = 0;
129: 
130:   for (let t = 0; t < trackCount && !r.eof; t++) {
131:     const tag = r.tag();
132:     const length = r.u32();
133:     const end = r.pos + length;
134:     if (tag !== 'MTrk') {
135:       r.pos = end;
136:       continue;
137:     }
138: 
139:     let tick = 0;
140:     let running = 0;
141:     trackNames[t] = '';
142: 
143:     while (r.pos < end) {
144:       tick += r.vlq();
145:       let status = r.u8();
146: 
147:       if (status === 0xff) {
148:         const type = r.u8();
149:         const len = r.vlq();
150:         if (type === 0x51 && len === 3) {
151:           const us = (r.u8() << 16) | (r.u8() << 8) | r.u8();
152:           tempos.push({ tick, usPerQuarter: us || DEFAULT_US_PER_QUARTER, order: order++ });
153:         } else if (type === 0x03) {
154:           const name = r.text(len);
155:           if (!trackNames[t]) trackNames[t] = name;
156:         } else if (type === 0x2f) {
157:           r.skip(len);
158:           break;
159:         } else {
160:           r.skip(len);
161:         }
162:         continue;
163:       }
164: 
165:       if (status === 0xf0 || status === 0xf7) {
166:         r.skip(r.vlq());
167:         continue;
168:       }
169: 
170:       let d1: number;
171:       if (status & 0x80) {
172:         running = status;
173:         d1 = r.u8();
174:       } else {
175:         // Running status: the byte read was the first data byte.
176:         if (!running) throw new MidiFileError('data byte without a status');
177:         d1 = status;
178:         status = running;
179:       }
180:       const d2 = dataLength(status) === 2 ? r.u8() : 0;
181: 
182:       const kind = status & 0xf0;
183:       const keep =
184:         kind === 0x80 ||
185:         kind === 0x90 ||
186:         (kind === 0xb0 && KEPT_CONTROLLERS.has(d1));
187:       if (keep) raw.push({ tick, order: order++, status, d1: d1 & 0x7f, d2: d2 & 0x7f, track: t });
188:     }
189: 
190:     r.pos = end;
191:   }
192: 
193:   raw.sort((a, b) => a.tick - b.tick || a.order - b.order);
194:   tempos.sort((a, b) => a.tick - b.tick || a.order - b.order);
195: 
196:   // The tempo map: walk events and tempo changes together, in tick order.
197:   const events: MidiEvent[] = [];
198:   let usPerQuarter = DEFAULT_US_PER_QUARTER;
199:   let lastTick = 0;
200:   let lastMs = 0;
201:   let ti = 0;
202: 
203:   const msAt = (tick: number): number => {
204:     while (ti < tempos.length && tempos[ti].tick <= tick) {
205:       const change = tempos[ti++];
206:       lastMs += ((change.tick - lastTick) * usPerQuarter) / division / 1000;
207:       lastTick = change.tick;
208:       usPerQuarter = change.usPerQuarter;
209:     }
210:     return lastMs + ((tick - lastTick) * usPerQuarter) / division / 1000;
211:   };
212: 
213:   const channels: MidiChannel[] = Array.from({ length: 16 }, (_, i) => ({
214:     used: false,
215:     name: `Ch ${i + 1}`,
216:     noteCount: 0,
217:   }));
218: 
219:   for (const e of raw) {
220:     const ms = msAt(e.tick);
221:     const channel = e.status & 0x0f;
222:     const isNoteOn = (e.status & 0xf0) === 0x90 && e.d2 > 0;
223:     if (isNoteOn) {
224:       const c = channels[channel];
225:       if (!c.used) {
226:         c.used = true;
227:         if (trackNames[e.track]) c.name = trackNames[e.track];
228:       }
229:       c.noteCount++;
230:     }
231:     events.push({ ms, status: e.status, d1: e.d1, d2: e.d2 });
232:   }
233: 
234:   const durationMs = events.length ? events[events.length - 1].ms : 0;
235: 
236:   return { durationMs, channels, events };
237: }
</file>

<file path="src/common/band/receiver.test.ts">
 1: import { describe, expect, it } from 'vitest';
 2: import { Receiver, receiverDelay } from './receiver';
 3: import type { BatchEvent } from './sequencer';
 4: 
 5: const on = (note: number, dt = 0): BatchEvent => ({ dt, status: 0x90, d1: note, d2: 100 });
 6: const off = (note: number, dt = 0): BatchEvent => ({ dt, status: 0x80, d1: note, d2: 0 });
 7: 
 8: function harness(delaySec = 0.5) {
 9:   let now = 100;
10:   const scheduled: { ev: BatchEvent; when: number }[] = [];
11:   let offs = 0;
12:   const rx = new Receiver(
13:     { now: () => now },
14:     { schedule: (ev, when) => scheduled.push({ ev, when }), allOff: () => offs++ },
15:     { delaySec }
16:   );
17:   return { rx, scheduled, advance: (ms: number) => (now += ms / 1000), get now() { return now; }, get offs() { return offs; } };
18: }
19: 
20: describe('receiver', () => {
21:   it('fixes the offset on the first batch and keeps the performer\'s spacing', () => {
22:     const h = harness(0.5);
23:     h.rx.onBatch(1, 1000, [on(60), on(62, 100)]);
24:     expect(h.scheduled[0].when).toBeCloseTo(h.now + 0.5, 6);
25:     expect(h.scheduled[1].when).toBeCloseTo(h.now + 0.6, 6);
26: 
27:     h.advance(100);
28:     h.rx.onBatch(2, 1100, [on(64)]);
29:     expect(h.scheduled[2].when).toBeCloseTo(h.now - 0.1 + 0.5 + 0.1, 6);
30:   });
31: 
32:   it('moves the offset when a batch arrives late and plays it on the new timeline', () => {
33:     const h = harness(0.2);
34:     h.rx.onBatch(1, 0, [on(60)]);
35:     // The next batch arrives a full second late: its notes are 0.7 s overdue.
36:     h.advance(1000);
37:     h.rx.onBatch(2, 100, [on(62), off(60, 10)]);
