  1: /**
  2:  * Chat log model - `CNewUIChatLogWindow` (NewUIChatLogWindow.h/.cpp) and the
  3:  * prefix routing of `ReceiveChat` (WSclient.cpp:1435).
  4:  */
  5: 
  6: import type { TextKey } from '../i18n';
  7: 
  8: /** `MESSAGE_TYPE` (NewUIChatLogWindow.h:18). */
  9: export enum ChatLineType {
 10:   All = 0,
 11:   Chat,
 12:   Whisper,
 13:   System,
 14:   Error,
 15:   Party,
 16:   Guild,
 17:   Union,
 18:   Gens,
 19:   GM,
 20: }
 21: 
 22: export type ChatLine = {
 23:   id: number;
 24:   sender: string;
 25:   text: string;
 26:   type: ChatLineType;
 27:   /** Wall clock the line arrived, for the optional timestamp column. */
 28:   at: number;
 29:   /** A row carried over from the line above by `splitChatLine`. */
 30:   continued?: boolean;
 31:   /** The sender's guild, shown as a tag before the name. */
 32:   senderGuild?: string;
 33:   /** `HeroState` of the sender when they spoke, for the name colour. */
 34:   senderPk?: number;
 35:   /** The sender is a game master (`isGm`, raised by a `#` shout). */
 36:   senderGm?: boolean;
 37: };
 38: 
 39: /** "14:03" in the viewer's own locale-independent 24h form. */
 40: export function chatTimestamp(at: number): string {
 41:   const date = new Date(at);
 42:   const pad = (v: number) => String(v).padStart(2, '0');
 43:   return `${pad(date.getHours())}:${pad(date.getMinutes())}`;
 44: }
 45: 
 46: /** `MAX_NUMBER_OF_LINES` (NewUIChatLogWindow.h:88). */
 47: export const MAX_CHAT_LINES = 200;
 48: /** `MAX_CHAT_SIZE`: the longest line the server accepts. */
 49: export const MAX_CHAT_LENGTH = 60;
 50: /** `CHATBOX_WIDTH` / `CHATBOX_HEIGHT` (NewUIChatInputBox.h:27). */
 51: export const CHATBOX_WIDTH = 281;
 52: export const CHATBOX_HEIGHT = 47;
 53: /** The size the log paints at; `chat/style.less` sets the same. */
 54: export const CHAT_LINE_FONT_SIZE = 11;
 55: 
 56: /** `SCROLL_BAR_WIDTH` / `WND_LEFT_RIGHT_EDGE` (NewUIChatLogWindow.h:92-95). */
 57: export const CHAT_SCROLL_BAR_WIDTH = 7;
 58: export const CHAT_WND_EDGE = 4;
 59: 
 60: /**
 61:  * `CLIENT_WIDTH` (NewUIChatLogWindow.h:100): the width a log line has to fit
 62:  * in. Fixed, so framing the log does not re-split lines already in it.
 63:  */
 64: export const CHAT_LOG_CLIENT_WIDTH =
 65:   CHATBOX_WIDTH - CHAT_SCROLL_BAR_WIDTH * 2 - CHAT_WND_EDGE * 2;
 66: 
 67: /** `ProcessAddText`: shorter than this is never measured, let alone split. */
 68: const CHAT_SPLIT_MIN_LENGTH = 20;
 69: 
 70: /**
 71:  * `CNewUIChatLogWindow::SeparateText` (NewUIChatLogWindow.cpp:900): a line too
 72:  * wide for the log is broken at the last space that fits. `prefix` is what
 73:  * the line prints before its text (`chatSenderPrefix`) and comes out of the
 74:  * first row's budget; the rows after it carry no sender, as in the original.
 75:  *
 76:  * The original stops after one break, which is not enough for the longest
 77:  * messages OpenMU sends - its login warning is over twice the log's width, so
 78:  * two rows still lost the end of it. This keeps breaking until the whole line
 79:  * is placed.
 80:  */
 81: export function splitChatLine(
 82:   prefix: string,
 83:   text: string,
 84:   width: number,
 85:   measure: (text: string) => number
 86: ): string[] {
 87:   if (text.length < CHAT_SPLIT_MIN_LENGTH) return [text];
 88: 
 89:   const rows: string[] = [];
 90:   let rest = text;
 91: 
 92:   while (rest) {
 93:     // Only the first row pays for the name and its tag.
 94:     const budget = rows.length === 0 && prefix ? width - measure(prefix) : width;
 95: 
 96:     if (measure(rest) <= budget) {
 97:       rows.push(rest);
 98:       break;
 99:     }
100: 
101:     const hasSpace = rest.includes(' ');
102:     let at = rest.length;
103: 
104:     while (at > 0 && measure(rest.slice(0, at)) > budget) {
105:       // A word wider than the log on its own is cut mid-word rather than
106:       // dropped: `find_last_of` returns npos and the original falls to -1.
107:       const space = hasSpace ? rest.lastIndexOf(' ', at - 1) : -1;
108:       at = space > 0 ? space : at - 1;
109:     }
110: 
111:     // Nothing fits at all (a budget narrower than one character): keep the
112:     // line whole rather than looping forever on it.
113:     if (at <= 0) {
114:       rows.push(rest);
115:       break;
116:     }
117: 
118:     rows.push(rest.slice(0, at));
119:     rest = rest.slice(at).trimStart();
120:   }
121: 
122:   return rows;
123: }
124: 
125: /**
126:  * The class the log tints a name with, by the `HeroState` byte the sender
127:  * carried. The colours are `SetPlayerColor`'s (nameTags.ts); the hero and
128:  * outlaw ones are animated in the stylesheet, a commoner is left plain.
129:  */
130: export const CHAT_PK_CLASS: Readonly<Record<number, string>> = {
131:   1: 'pk-hero2',
132:   2: 'pk-hero1',
133:   3: 'pk-neutral',
134:   4: 'pk-caution',
135:   5: 'pk-murderer1',
136:   6: 'pk-murderer2',
