424: // ---- 5. remote performers --------------------------------------------------
425: 
426: type Remote = {
427:   netId: number;
428:   /** The scene entity, once it exists here: the pose and the exact position. */
429:   entity: NetEntity | null;
430:   /** Whether the pose was started on the entity (it has the player rig). */
431:   posed: boolean;
432:   instrument: InstrumentId;
433:   receiver: Receiver;
434:   band: BandState;
435:   /** Batches taken so far; the first one is announced on the console. */
436:   batches: number;
437: };
438: 
439: const remotes = new Map<number, Remote>();
440: 
441: /** Performers heard before their start landed here, each noted once. */
442: const orphans = new Set<number>();
443: let remoteTimer: ReturnType<typeof setInterval> | null = null;
444: 
445: const keyOf = (netId: number) => `net:${netId}`;
446: 
447: /**
448:  * Where a remote performer stands, for the ear. A posed player is placed by
449:  * `BandSystem` each frame; a skinned player and one whose entity has not
450:  * arrived yet are placed here - at the entity if we have it, else beside the
451:  * hero so the notes are heard rather than lost at the map origin.
452:  */
453: function placeRemote(remote: Remote): void {
454:   const e = remote.entity;
455:   if (e) {
456:     if (e.performing) return;
457:     setPerformerPosition(keyOf(remote.netId), e.transform.pos.x, e.transform.pos.z);
458:     return;
459:   }
460:   const hero = heroEntity();
461:   if (hero) setPerformerPosition(keyOf(remote.netId), hero.transform.pos.x, hero.transform.pos.z);
462: }
463: 
464: /**
465:  * Bind a remote to its scene entity once it exists: a start can arrive before
466:  * this client has drawn the performer (the proxy relays it the instant the
467:  * tracker sees them in scope), and a batch must never be lost waiting. The
468:  * audio always plays by net id; only the pose and the exact position wait.
469:  */
470: function resolveEntity(remote: Remote): void {
471:   const world = Store.world;
472:   let entity = remote.entity;
473:   if (!entity || entity.objOutOfScope) {
474:     entity = world?.getByNetId(remote.netId) ?? null;
475:     if (entity?.objOutOfScope) entity = null;
476:     remote.entity = entity;
477:   }
478:   // The pose (the instrument in hand) is attached once, the first time the
479:   // entity is here with a player rig - now if it was in view at the start,
480:   // else the tick it arrives. A skinned player has no rig and stays sound.
481:   if (entity && !remote.posed && entity.playerAnimation && world) {
482:     startPerforming(world, entity as never, remote.instrument, false);
483:     remote.posed = true;
484:     console.info(`band: #${remote.netId} in view, holding the ${remote.instrument}`);
485:   }
486:   placeRemote(remote);
487: }
488: 
489: export function remoteStart(netId: number, instrument: InstrumentId, entity: NetEntity | null): void {
490:   const world = Store.world;
491:   if (!world) return;
492:   const existing = remotes.get(netId);
493:   if (existing && existing.instrument === instrument) return;
494:   if (existing) remoteStop(netId);
495: 
496:   const band: BandState = { masterId: netId, members: [] };
497:   const remote: Remote = {
498:     netId,
499:     entity: entity && !entity.objOutOfScope ? entity : null,
500:     posed: false,
501:     instrument,
502:     band,
503:     batches: 0,
504:     receiver: new Receiver(
505:       { now: audioNow },
506:       {
507:         schedule: (ev, when) => voiceRemote(remote, ev, when),
508:         allOff: () => silenceRemote(remote),
509:       },
510:       { delaySec: receiverDelay(NetStats.roundTripMs) }
511:     ),
512:   };
513:   remotes.set(netId, remote);
514:   void ensureBank(instrument);
515:   // The pose (a player rig) is attached now if the entity is here, else the
516:   // moment it arrives; a skinned player never gets one.
517:   resolveEntity(remote);
518:   if (!remote.entity) console.info(`band: #${netId} starts playing, entity not in view yet - sound only for now`);
519:   if (!remoteTimer) {
520:     remoteTimer = setInterval(() => {
521:       for (const r of remotes.values()) {
522:         r.receiver.tick();
523:         resolveEntity(r);
524:       }
525:     }, REMOTE_TICK_MS);
526:   }
527: }
528: 
529: export function remoteBatch(netId: number, seq: number, baseMs: number, events: BatchEvent[]): void {
530:   const remote = remotes.get(netId);
531:   if (!remote) {
532:     // No start here yet: the performer just entered scope and the proxy's
533:     // cached start is on its way. Drop this batch; the next arrives with it.
534:     if (!orphans.has(netId)) {
535:       orphans.add(netId);
536:       console.warn(`band: notes from #${netId} before its start, waiting`);
537:     }
538:     return;
539:   }
540:   orphans.delete(netId);
541:   if (remote.batches++ === 0) {
542:     console.info(
543:       `band: first notes from #${netId}: ${events.length} events, ${(baseMs / 1000).toFixed(1)} s into their song`
544:     );
545:   }
546:   remote.receiver.onBatch(seq, baseMs, events);
547: }
548: 
549: export function remoteStop(netId: number): void {
550:   const remote = remotes.get(netId);
551:   if (!remote) return;
552:   remotes.delete(netId);
553:   remote.receiver.stop();
554:   const world = Store.world;
555:   if (world && remote.entity) stopPerforming(world, remote.entity);
556:   // Members were doubling this master; they are performers of their own and
557:   // keep their keys, only their doubling stops.
558:   silenceRemote(remote);
559:   dropPerformer(keyOf(netId));
560:   if (membership?.masterId === netId) {
561:     // The master stopped (the proxy already dropped the band): solo again,
562:     // with the instrument still in hand.
563:     membership = null;
564:     runInAction(() => {
565:       Band.role = 'solo';
566:       Band.band = null;
567:     });
568:     refreshLocalMask();
569:   }
570:   if (remotes.size === 0 && remoteTimer) {
571:     clearInterval(remoteTimer);
572:     remoteTimer = null;
573:   }
574: }
575: 
576: /** Band membership seen from the wire, for a remote master. */
577: export function remoteBandState(masterId: number, members: BandMember[]): void {
578:   const remote = remotes.get(masterId);
579:   if (!remote) return;
580:   remote.band = { masterId, members };
581:   for (const m of members) void ensureBank(m.instrument);
582: }
583: 
584: /** Who is performing in view of this client, with their instrument. */
585: export function remotePerformers(): { netId: number; instrument: InstrumentId }[] {
586:   return Array.from(remotes.values(), r => ({ netId: r.netId, instrument: r.instrument }));
587: }
588: 
589: /**
590:  * A note off a remote master's stream, voiced by everyone in that band who
591:  * holds the channel: the master on their instrument where they stand, each
592:  * member on theirs where they stand - and the hero, when a member of this
593:  * band, on the hero's own key, which is never attenuated.
594:  *
595:  * A member is found by the id the master lists them under, which is the id
596:  * their own start arrived here under; one that is not a performer here yet
597:  * has nowhere to be placed and waits. The hero is never in that lookup: the
598:  * master lists the hero by an id this client does not know itself by, so the
599:  * hero's share comes from the local join record.
600:  */
601: function voiceRemote(remote: Remote, ev: BatchEvent, when: number): void {
602:   const channel = ev.status & 0x0f;
603:   voiceOn(keyOf(remote.netId), remote.instrument, ev, when, remote.entity);
604:   for (const m of remote.band.members) {
605:     const member = remotes.get(m.netId);
606:     if (!member || !hasChannel(m.channelMask, channel)) continue;
607:     voiceOn(keyOf(m.netId), m.instrument, ev, when, member.entity);
608:   }
609:   if (membership?.masterId === remote.netId && hasChannel(membership.channelMask, channel)) {
610:     voiceOn(HERO_KEY, membership.instrument, ev, when, heroEntity());
611:   }
612: }
613: 
614: /** Every voice of the master's stream off: the master's, each member's doubling, the hero's share. */
615: function silenceRemote(remote: Remote): void {
616:   allNotesOff(keyOf(remote.netId));
617:   for (const m of remote.band.members) if (remotes.has(m.netId)) allNotesOff(keyOf(m.netId));
618:   if (membership?.masterId === remote.netId) allNotesOff(HERO_KEY);
619: }
620: 
621: /** Map change or logout: every stream gone, the hero's instrument away. */
622: export function resetBand(): void {
623:   for (const netId of Array.from(remotes.keys())) remoteStop(netId);
624:   if (Band.instrument) {
625:     const hero = heroEntity();
626:     const world = Store.world;
627:     if (hero && world) stopPerforming(world, hero);
628:     performanceEnded();
629:   }
630: }
631: 
632: EventBus.on('requestWarp', () => resetBand());
633: 
634: // Dev hook for the harness and the console: `window.__band.play('/dev/band/scale.mid')`.
635: if (import.meta.env.DEV && typeof window !== 'undefined') {
636:   (window as unknown as { __band: unknown }).__band = {
637:     state: Band,
638:     takeOut: takeOutInstrument,
639:     putAway: putAwayInstrument,
640:     async play(url: string) {
641:       const res = await fetch(url);
642:       const blob = await res.blob();
643:       await loadMidiFile(new File([blob], url.split('/').pop() ?? 'song.mid'));
644:       await playSong();
645:     },
646:     pause: pauseSong,
647:     stop: stopPlaying,
648:     loop: setLoop,
649:     join: joinBand,
650:     leave: leaveBand,
651:     window: toggleInstrumentWindow,
652:     // The app's own sampler instance: a probe's dynamic import after an HMR
653:     // update would get a fresh copy with nothing in it.
654:     voices: instrumentVoices,
655:     ready: contextReady,
656:   };
657: }
658: 
659: export { instrumentById };
