230: /** BandSystem: the instrument is in the hero's hands. */
231: export function takenOut(id: InstrumentId): void {
232:   runInAction(() => {
233:     Band.instrument = id;
234:     Band.phase = 'out';
235:     Band.windowOpen = true;
236:     Band.bankLoading = !bankReady(id);
237:   });
238:   sequencer.startClock();
239:   refreshLocalMask();
240:   transport.start(instrumentIndex(id));
241:   void ensureBank(id).then(ok => {
242:     runInAction(() => {
243:       Band.bankLoading = false;
244:       if (!ok && Band.instrument === id) Band.error = 'instrument.unavailable';
245:     });
246:   });
247: }
