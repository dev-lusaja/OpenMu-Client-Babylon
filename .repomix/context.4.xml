 78: type MaterialArgs = readonly [
 79:   backFaceCulling: boolean,
 80:   transparencyMode: number,
 81:   alphaMode: BlendState,
 82:   bright: boolean,
 83:   flatLit: boolean,
 84: ];
 85: 
 86: const materialsCache: Map<string, ItemMaterial> = new Map();
 87: 
 88: /** What each cached material was asked for, so a quality flip can re-resolve it. */
 89: const materialArgs: Map<ItemMaterial, MaterialArgs> = new Map();
 90: 
 91: /** Babylon `Material.MATERIAL_ALPHATESTANDBLEND`. */
 92: const ALPHA_TEST_AND_BLEND = 3;
 93: /** glAlphaFunc(GL_GREATER, 0.25f) - the threshold the original runs with. */
 94: const ALPHA_TEST_CUTOFF = 0.25;
 95: 
 96: export function getMaterial(
 97:   scene: Scene,
 98:   backFaceCulling: boolean,
 99:   transparencyMode: number,
100:   alphaMode: BlendState,
101:   bright = false,
102:   flatLit = false,
103:   characterAsset = false
104: ) {
105:   // Additive blend cards (bright `_R` meshes, and anything on an additive
106:   // blend such as wings) and flat-lit UI models are glow cards, not lit
107:   // surfaces; they stay on the Standard path in every quality.
108:   const additive =
109:     alphaMode === BlendState.ALPHA_ADD || alphaMode === BlendState.ALPHA_ONEOE;
110:   const pbr = pbrCovers(characterAsset) && !bright && !flatLit && !additive;
111: 
112:   const name = `${backFaceCulling}_${transparencyMode}_${BlendState[alphaMode]}${
113:     bright ? '_bright' : ''
114:   }${flatLit ? '_flat' : ''}${pbr ? '_pbr' : ''}`;
115: 
116:   if (materialsCache.has(name)) return materialsCache.get(name)!;
117: 
118:   let material: ItemMaterial;
119: 
120:   if (pbr) {
121:     const m = createItemPbrMaterial(scene);
122:     m.useAlphaFromAlbedoTexture = true;
123:     m.albedoTexture = getEmptyTexture(scene);
124:     // The placeholder decides the GAMMAALBEDO define for every texture bound
125:     // through it. It must be gamma (decode the texel) to sit on the Standard
126:     // path's curve: under IMAGEPROCESSINGPOSTPROCESS the Standard fragment
127:     // ends with `toLinearSpace(color)`, i.e. (texel × light)^2.2, while PBR
128:     // decodes its inputs and writes linear. A linear placeholder skipped the
129:     // decode and put every Enhanced object a stop *above* its Classic twin
130:     // (Enhanced materials read a stop light).
131:     m.albedoTexture.gammaSpace = true;
132:     material = m;
133:   } else {
134:     const m = createItemMaterial(scene, bright, flatLit);
135:     m.useAlphaFromDiffuseTexture = true;
136:     m.diffuseTexture = getEmptyTexture(scene);
137:     material = m;
138:   }
139: 
140:   material.name = name;
141:   material.backFaceCulling = backFaceCulling;
142:   material.transparencyMode = transparencyMode;
143:   material.alphaMode = alphaMode;
144: 
145:   // MU's DisableCullFace draws every alpha-keyed mesh double-sided; without
146:   // two-sided lighting the back faces of robes, capes, wings and trim shade
147:   // with the *front* normal and collapse to the hemisphere's ground colour.
148:   // Flip the normal instead (lighting_rework.md §3.2). Glow cards and
149:   // flat-lit models override the lit colour anyway.
150:   if (!backFaceCulling && !bright && !flatLit) {
151:     material.twoSidedLighting = true;
152:   }
153: 
154:   if (bright) {
155:     material.disableDepthWrite = true;
156:   }
157: 
158:   if (transparencyMode === ALPHA_TEST_AND_BLEND) {
159:     // MU's EnableAlphaTest (ZzzOpenglUtil.cpp:395): alpha test + SRC_ALPHA
160:     // blend with the depth mask left on - and it calls DisableCullFace(), so
161:     // every alpha-keyed mesh is drawn double-sided. Babylon drops depth writes
162:     // for anything in the blend pass unless forced.
163:     material.forceDepthWrite = true;
164:     material.alphaCutOff = ALPHA_TEST_CUTOFF;
165:   }
166: 
167:   // Every off-screen pass (G-buffer, cascades, glow layer) alpha-tests
168:   // against whatever getAlphaTestTexture() returns and never runs the bind
169:   // observable that hands over the mesh's real texture.
170:   useMeshAlphaTestTexture(material);
171: 
172:   material.freeze();
173: 
174:   materialsCache.set(name, material);
175:   materialArgs.set(material, [
176:     backFaceCulling,
177:     transparencyMode,
178:     alphaMode,
179:     bright,
180:     flatLit,
181:   ]);
182: 
183:   return material;
184: }
