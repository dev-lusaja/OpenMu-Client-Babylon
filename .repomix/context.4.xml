<file path="src/common/chatRoomProtocol.ts">
  1: import { Xor3Byte } from './encryption/xor3';
  2: 
  3: /**
  4:  * The OpenMU ChatServer wire protocol (a separate TCP endpoint from the game
  5:  * server, default port 55980). Plain C1/C2 frames, no SimpleModulus/Xor32;
  6:  * only the auth token and message bodies are XOR'd with the 3-byte key
  7:  * (FC CF AB), key index relative to the field start (Xor3Encryptor(offset)
  8:  * in MUnique.OpenMU.Network).
  9:  */
 10: 
 11: /** OpenMU's ChatServer listens here; the connection info packet carries no port. */
 12: export const CHAT_SERVER_PORT = 55980;
 13: 
 14: export const MAX_CHAT_MESSAGE_BYTES = 250;
 15: 
 16: const NAME_LENGTH = 10;
 17: 
 18: export type ChatClient = { index: number; name: string };
 19: 
 20: export type ChatServerEvent =
 21:   | { kind: 'joined'; index: number; name: string }
 22:   | { kind: 'left'; index: number; name: string }
 23:   | { kind: 'clients'; clients: ChatClient[] }
 24:   | { kind: 'message'; senderIndex: number; text: string };
 25: 
 26: const textEncoder = new TextEncoder();
 27: const textDecoder = new TextDecoder();
 28: 
 29: function readName(bytes: Uint8Array, from: number): string {
 30:   let end = from;
 31:   const to = Math.min(from + NAME_LENGTH, bytes.length);
 32:   while (end < to && bytes[end] !== 0 && bytes[end] !== 0x20) end++;
 33:   return textDecoder.decode(bytes.subarray(from, end));
 34: }
 35: 
 36: /** C1 00: room id + the token uint as a decimal string, XOR3 from offset 6. */
 37: export function encodeAuthenticate(roomId: number, token: number): Uint8Array {
 38:   const out = new Uint8Array(16);
 39:   out[0] = 0xc1;
 40:   out[1] = 16;
 41:   out[2] = 0x00;
 42:   out[4] = roomId & 0xff;
 43:   out[5] = (roomId >> 8) & 0xff;
 44:   const digits = String(token >>> 0);
 45:   for (let i = 0; i < digits.length && i < NAME_LENGTH; i++) {
 46:     out[6 + i] = digits.charCodeAt(i);
 47:   }
 48:   Xor3Byte(out.subarray(6));
 49:   return out;
 50: }
 51: 
 52: /** C1 01: sent before closing the connection. */
 53: export function encodeLeave(): Uint8Array {
 54:   return new Uint8Array([0xc1, 3, 0x01]);
 55: }
 56: 
 57: /** C1 05: sent in a fixed interval so the server keeps the room alive. */
 58: export function encodeKeepAlive(): Uint8Array {
 59:   return new Uint8Array([0xc1, 3, 0x05]);
 60: }
 61: 
 62: /** C1 04: sender index, message length, message bytes XOR3 from offset 5. */
 63: export function encodeChatMessage(senderIndex: number, text: string): Uint8Array {
 64:   let body = textEncoder.encode(text);
 65:   if (body.length > MAX_CHAT_MESSAGE_BYTES) body = body.subarray(0, MAX_CHAT_MESSAGE_BYTES);
 66:   const out = new Uint8Array(5 + body.length);
 67:   out[0] = 0xc1;
 68:   out[1] = out.length;
 69:   out[2] = 0x04;
 70:   out[3] = senderIndex;
 71:   out[4] = body.length;
 72:   out.set(body, 5);
 73:   Xor3Byte(out.subarray(5));
 74:   return out;
 75: }
 76: 
 77: /**
 78:  * One complete frame to an event, or null for anything unknown - which
 79:  * includes the weather frame (C1 04 0F) the ws proxy injects into every
 80:  * connection it carries.
 81:  */
 82: export function decodeChatServerFrame(frame: Uint8Array): ChatServerEvent | null {
 83:   if (frame.length < 3) return null;
 84: 
 85:   if (frame[0] === 0xc2) {
 86:     // C2 02 ChatRoomClients: count at 6, 11-byte {index, name[10]} rows at 8.
 87:     if (frame[3] !== 0x02 || frame.length < 8) return null;
 88:     const count = frame[6];
 89:     const clients: ChatClient[] = [];
 90:     for (let i = 0; i < count; i++) {
 91:       const at = 8 + i * 11;
 92:       if (at + 11 > frame.length) break;
 93:       clients.push({ index: frame[at], name: readName(frame, at + 1) });
 94:     }
 95:     return { kind: 'clients', clients };
 96:   }
 97: 
 98:   if (frame[0] !== 0xc1) return null;
 99: 
100:   switch (frame[2]) {
101:     case 0x01: {
102:       // C1 01 00 joined / C1 01 01 left: index at 4, name at 5.
103:       if (frame.length < 15) return null;
104:       const index = frame[4];
105:       const name = readName(frame, 5);
106:       return frame[3] === 0x00
107:         ? { kind: 'joined', index, name }
108:         : frame[3] === 0x01
109:           ? { kind: 'left', index, name }
110:           : null;
111:     }
112:     case 0x04: {
113:       if (frame.length < 5) return null;
114:       const senderIndex = frame[3];
115:       const body = frame.slice(5, 5 + Math.min(frame[4], frame.length - 5));
116:       Xor3Byte(body);
117:       let end = body.length;
118:       while (end > 0 && body[end - 1] === 0) end--;
119:       return { kind: 'message', senderIndex, text: textDecoder.decode(body.subarray(0, end)) };
120:     }
121:     default:
122:       return null;
123:   }
124: }
125: 
126: /**
127:  * Incremental C1/C2 frame splitter for the chat socket's byte stream.
128:  * Non-header bytes are dropped one at a time to resync, like the game
129:  * socket's queue does.
130:  */
131: export class ChatFrameSplitter {
132:   private buffer: Uint8Array = new Uint8Array(0);
133: 
134:   push(bytes: Uint8Array): Uint8Array[] {
135:     if (this.buffer.length === 0) {
136:       this.buffer = bytes;
137:     } else {
138:       const combined = new Uint8Array(this.buffer.length + bytes.length);
139:       combined.set(this.buffer);
140:       combined.set(bytes, this.buffer.length);
141:       this.buffer = combined;
142:     }
143: 
144:     const frames: Uint8Array[] = [];
145:     while (this.buffer.length > 0) {
146:       const header = this.buffer[0];
147:       if (header !== 0xc1 && header !== 0xc2) {
148:         this.buffer = this.buffer.subarray(1);
149:         continue;
150:       }
151:       const headerSize = header === 0xc1 ? 2 : 3;
152:       if (this.buffer.length < headerSize + 1) break;
153:       const length =
154:         header === 0xc1
155:           ? this.buffer[1]
156:           : (this.buffer[1] << 8) | this.buffer[2];
157:       if (length < headerSize + 1) {
158:         this.buffer = this.buffer.subarray(1);
159:         continue;
160:       }
161:       if (this.buffer.length < length) break;
162:       frames.push(this.buffer.slice(0, length));
163:       this.buffer = this.buffer.subarray(length);
164:     }
165:     return frames;
166:   }
167: }
</file>

