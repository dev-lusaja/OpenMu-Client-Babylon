 916: function trackTime(scene: Scene, onReady: (now: () => number) => void) {
 917:   let time = 0;
 918: 
 919:   scene.onReadyObservable.addOnce(() => {
 920:     scene.onBeforeRenderObservable.add(() => {
 921:       time += scene.getEngine()!.getDeltaTime()! / 1000;
 922:     });
 923: 
 924:     onReady(() => time);
 925:   });
