129: 
130: /** The most rows the completion list shows at once. */
131: export const CHAT_COMPLETION_ROWS = 8;
132: 
133: /**
134:  * Commands whose name starts with the word being typed (`/`, `/p`, `/po`…).
135:  * Once a space follows the name only the exact command is kept, so the list
136:  * turns into a usage hint. GM commands are offered only when asked for.
137:  */
138: export function matchChatCommands(text: string, gm: boolean): ChatCommand[] {
139:   if (!text.startsWith('/')) return [];
140:   const space = text.indexOf(' ');
141:   const word = (space < 0 ? text : text.slice(0, space)).toLowerCase();
142:   return CHAT_COMMANDS.filter(c => {
143:     if (c.gm && !gm) return false;
144:     return space < 0 ? c.name.startsWith(word) : c.name === word;
145:   });
146: }
147: 
148: /** The client-side command a typed line stands for, if any (`/pt`, `/trade`…). */
149: export function localCommandOf(text: string): ChatCommand | undefined {
150:   const word = text.trim().split(' ')[0].toLowerCase();
151:   return CHAT_COMMANDS.find(c => c.local && c.name === word);
152: }
