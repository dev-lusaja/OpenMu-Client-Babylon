158: // --- item-kind predicates (ZzzInfomation.cpp / _define.h ranges) ------------
159: 
160: export function isWeapon(def: ItemDef): boolean {
161:   return def.group <= ItemGroup.Staff;
162: }
163: 
164: export function isArmorPart(def: ItemDef): boolean {
165:   return def.group >= ItemGroup.Helm && def.group <= ItemGroup.Boots;
166: }
167: 
168: export function isShield(def: ItemDef): boolean {
169:   return def.group === ItemGroup.Shield;
170: }
171: 
172: export function isStaff(def: ItemDef): boolean {
173:   return def.group === ItemGroup.Staff;
174: }
175: 
176: /** Summoner books (Book of Samut… = MODEL_BOOK_OF_SAHAMUTT..STAFF+29). */
177: export function isSummonerBook(def: ItemDef): boolean {
178:   return def.group === ItemGroup.Staff && def.index >= 21 && def.index <= 29;
179: }
180: 
181: /** `IsCepterItem`: Dark Lord scepters (mace 8…18, Frost Mace excluded). */
182: export function isScepter(def: ItemDef): boolean {
183:   return def.group === ItemGroup.Mace && def.index >= 8 && def.index !== 16;
184: }
185: 
186: /** Fairy / Heaven / Satan wings (ITEM_WING..ITEM_WINGS_OF_SATAN) + Wing of Curse. */
187: export function isFirstWing(def: ItemDef): boolean {
188:   return (
189:     def.group === ItemGroup.Wing &&
190:     (def.index <= 2 || def.index === 41 || def.index === 42)
191:   );
192: }
193: 
194: /** Spirits / Soul / Dragon / Darkness wings + Wings of Despair. */
195: export function isSecondWing(def: ItemDef): boolean {
196:   return (
197:     def.group === ItemGroup.Wing &&
198:     ((def.index >= 3 && def.index <= 6) || def.index === 41)
199:   );
200: }
201: 
202: /** Storm / Eternal / Illusion / Ruin / Cape of Emperor / Wing of Dimension / Cape of Overrule. */
203: export function isThirdWing(def: ItemDef): boolean {
204:   return (
205:     def.group === ItemGroup.Wing &&
206:     ((def.index >= 36 && def.index <= 40) ||
207:       def.index === 43 ||
208:       def.index === 50)
209:   );
210: }
211: 
212: export function isCapeOfLord(def: ItemDef): boolean {
213:   return def.group === ItemGroup.Helper && def.index === 30;
214: }
215: 
216: export function isCapeOfFighter(def: ItemDef): boolean {
217:   return def.group === ItemGroup.Wing && def.index === 49;
218: }
219: 
220: export function isWing(def: ItemDef): boolean {
221:   return (
222:     isFirstWing(def) ||
223:     isSecondWing(def) ||
224:     isThirdWing(def) ||
225:     isCapeOfLord(def) ||
226:     isCapeOfFighter(def)
227:   );
228: }
229: 
230: export function isRing(def: ItemDef): boolean {
231:   return (
232:     def.group === ItemGroup.Helper &&
233:     ((def.index >= 8 && def.index <= 12) || (def.index >= 20 && def.index <= 24))
234:   );
235: }
236: 
237: export function isPendant(def: ItemDef): boolean {
238:   return (
239:     def.group === ItemGroup.Helper &&
240:     ((def.index >= 12 && def.index <= 13) || (def.index >= 25 && def.index <= 28))
241:   );
242: }
243: 
244: export function isJewel(def: ItemDef): boolean {
245:   if (def.group === ItemGroup.Wing && def.index === 15) return true; // Chaos
246:   if (def.group !== ItemGroup.Potion) return false;
247:   return [13, 14, 16, 22, 31, 41, 42, 43, 44].includes(def.index);
248: }
249: 
250: // --- stat formulas -----------------------------------------------------------
251: 
252: const idiv = (a: number, b: number) => Math.trunc(a / b);
253: 
254: export type ItemStats = {
255:   def: ItemDef;
256:   level: number;
257:   isExcellent: boolean;
258:   isAncient: boolean;
259:   damageMin: number;
260:   damageMax: number;
261:   magicPower: number;
262:   blocking: number;
263:   defense: number;
264:   reqLvl: number;
265:   reqStr: number;
266:   reqAgi: number;
267:   reqVit: number;
268:   reqEne: number;
269:   reqCmd: number;
270:   maxDurability: number;
271: };
272: 
273: function dropLevel(def: ItemDef): number {
274:   return def.level + 30;
275: }
276: 
277: /** `GetExcellentAddValue`: the three chaos weapons use a fixed bonus. */
278: function excellentAddValue(def: ItemDef): number {
279:   if (def.group === ItemGroup.Mace && def.index === 6) return 15; // Chaos Dragon Axe
280:   if (def.group === ItemGroup.Bow && def.index === 6) return 30; // Chaos Nature Bow
281:   if (def.group === ItemGroup.Staff && def.index === 7) return 25; // Chaos Lightning Staff
282:   return 0;
283: }
284: 
285: function calcDamage(
286:   base: number,
287:   def: ItemDef,
288:   level: number,
289:   isExcellent: boolean,
290:   isAncient: boolean
291: ): number {
292:   if (base <= 0) return 0;
293:   let value = base;
294: 
295:   if (isExcellent && def.level) {
296:     const add = excellentAddValue(def);
297:     value += add ? add : idiv(base * 25, def.level) + 5;
298:   }
299:   if (isAncient) value += 5 + idiv(dropLevel(def), 40);
300: 
301:   value += Math.min(9, level) * 3;
302:   if (level - 9 > 0) value += level - 6;
303: 
304:   return value;
305: }
306: 
307: function calcMagicPower(
308:   def: ItemDef,
309:   level: number,
310:   isExcellent: boolean,
311:   isAncient: boolean
312: ): number {
313:   if (def.magicPower <= 0) return 0;
314:   let value = def.magicPower;
315: 
316:   if (isExcellent && def.level) {
317:     const add = excellentAddValue(def);
318:     value += add ? add : idiv(def.magicPower * 25, def.level) + 5;
319:   }
320:   if (isAncient) value += 2 + idiv(dropLevel(def), 60);
321: 
322:   value += Math.min(9, level) * 3;
323:   if (level - 9 > 0) value += level - 6;
324: 
325:   value = idiv(value, 2);
326:   if (!isScepter(def)) value += level * 2;
327: 
328:   return value;
329: }
330: 
331: /** Note: the original scales this from the *drop* level, not the item's +N. */
332: function calcBlocking(def: ItemDef, isExcellent: boolean): number {
333:   if (def.blocking === 0) return 0;
334:   let value = def.blocking;
335: 
336:   if (isExcellent && def.level) {
337:     value += idiv(def.blocking * 25, def.level) + 5;
338:   }
339:   value += Math.min(9, def.level) * 3;
340:   if (def.level - 9 > 0) value += def.level - 6;
341: 
342:   return value;
343: }
344: 
345: function calcDefense(
346:   def: ItemDef,
347:   level: number,
348:   isExcellent: boolean,
349:   isAncient: boolean
350: ): number {
351:   let base = def.defense;
352:   if (isCapeOfLord(def)) base = 15;
353:   if (base === 0) return 0;
354: 
355:   let value = base;
356:   const drop = dropLevel(def);
357: 
358:   if (isShield(def)) {
359:     value += level;
360:     if (isAncient) value = value + (idiv(value * 20, drop) + 2);
361:     return value;
362:   }
363: 
364:   if (isExcellent && def.level > 0) {
365:     value += idiv(base * 12, def.level) + 4 + idiv(def.level, 5);
366:   }
367:   if (isAncient) {
368:     value += base + (idiv(value * 3, drop) + 2 + idiv(drop, 30));
369:   }
370: 
371:   if (isSecondWing(def)) {
372:     value += Math.min(9, level) * 2;
373:   } else if (isCapeOfLord(def) || isCapeOfFighter(def)) {
374:     value += Math.min(9, level) * 2;
375:   } else if (isThirdWing(def)) {
376:     value += Math.min(9, level) * 4;
377:   } else {
378:     value += Math.min(9, level) * 3;
379:   }
380: 
381:   if (level - 9 > 0) {
382:     value += isThirdWing(def) ? level - 5 : level - 6;
383:   }
384: 
385:   return value;
386: }
387: 
388: /** `CalcMaxDurability` (ZzzInventory.cpp:1549). */
389: export function calcMaxDurability(
390:   def: ItemDef,
391:   level: number,
392:   isExcellent: boolean,
393:   isAncient: boolean
394: ): number {
395:   let max = isStaff(def) ? def.magicDur : def.durability;
396: 
397:   for (let i = 0; i < level; i++) {
398:     // Scroll of Blood and later etc items do not gain durability.
399:     if (def.group === ItemGroup.Etc && def.index >= 21) break;
400:     if (i >= 14) max = Math.min(255, max + 8);
401:     else if (i >= 13) max = Math.min(255, max + 7);
402:     else if (i >= 12) max += 6;
403:     else if (i >= 11) max += 5;
404:     else if (i >= 10) max += 4;
405:     else if (i >= 9) max += 3;
406:     else if (i >= 4) max += 2;
407:     else max += 1;
408:   }
409: 
410:   // Dark Horse / Dark Raven
411:   if (def.group === ItemGroup.Helper && (def.index === 4 || def.index === 5)) {
412:     max = 255;
413:   }
414: 
415:   if (isAncient) {
416:     max += 20;
417:   } else if (isExcellent && !isWing(def)) {
418:     max += 15;
419:   }
420: 
421:   return max;
422: }
423: 
424: function calcRequirements(
425:   def: ItemDef,
426:   level: number,
427:   isExcellent: boolean,
428:   isAncient: boolean
429: ) {
430:   let itemLevel = def.level;
431:   if (isExcellent) itemLevel = def.level + 25;
432:   else if (isAncient) itemLevel = def.level + 30;
433: 
434:   const addValue = isSecondWing(def) ? 5 : 4;
435: 
436:   let reqLvl = 0;
437:   if (def.reqLvl) {
438:     // Gear keeps its table level; wings, helpers and consumables climb
439:     // `addValue` per +1.
440:     const scalesWithLevel =
441:       isFirstWing(def) ||
442:       isSecondWing(def) ||
443:       isCapeOfFighter(def) ||
444:       def.group >= ItemGroup.Helper;
445:     reqLvl = scalesWithLevel ? def.reqLvl + level * addValue : def.reqLvl;
446:   }
447: 
448:   const scaled = (req: number, mul: number) =>
449:     req ? 20 + idiv(req * (itemLevel + level * 3) * mul, 100) : 0;
450: 
451:   const reqStr = scaled(def.reqStr, 3);
452:   const reqAgi = scaled(def.reqAgi, 3);
453:   const reqVit = scaled(def.reqVit, 3);
454: 
455:   let reqEne = 0;
456:   if (def.reqEne) {
457:     if (isSummonerBook(def)) {
458:       reqEne = 20 + idiv(def.reqEne * (itemLevel + level) * 3, 100);
459:     } else if (def.reqLvl > 0 && def.group === ItemGroup.Etc) {
460:       reqEne = 20 + idiv(def.reqEne * def.reqLvl * 4, 100);
461:     } else {
462:       reqEne = scaled(def.reqEne, 4);
463:     }
464:   }
465: 
466:   // Orb of Summoning: fixed energy per level.
467:   if (def.group === ItemGroup.Wing && def.index === 11) {
468:     reqEne = [30, 60, 90, 130, 170, 210, 300, 500][Math.min(level, 7)];
469:   }
470: 
471:   let reqCmd = 0;
472:   if (def.reqCmd) {
473:     // Dark Raven scales, everything else reads the table value straight.
474:     reqCmd =
475:       def.group === ItemGroup.Helper && def.index === 5
476:         ? 185 + def.reqCmd * 15
477:         : def.reqCmd;
478:   }
479: 
480:   // Transformation Ring
481:   if (def.group === ItemGroup.Helper && def.index === 10) {
482:     reqLvl = level <= 2 ? 20 : 50;
483:   }
484: 
485:   // Orbs and scrolls: Item.txt has no level / energy column for most of
486:   // them - the skill they teach carries the numbers OpenMU checks on use
487:   // (`Scrolls.cs` / `Orbs.cs` seed the item requirements from the skill).
488:   const taught = learnableSkillNumber(def.group, def.index, level);
489:   const skill = taught === undefined ? undefined : skillDefinition(taught);
490:   if (skill) {
491:     reqLvl = Math.max(reqLvl, skill.level);
492:     reqEne = Math.max(reqEne, skill.energy);
493:   }
494: 
495:   return { reqLvl, reqStr, reqAgi, reqVit, reqEne, reqCmd };
496: }
497: 
498: const statsCache = new Map<string, ItemStats | null>();
499: 
500: /** The item's effective stats for its level / excellent / ancient state. */
501: export function itemStats(item: Item): ItemStats | null {
502:   const level = Math.max(0, Math.min(15, item.lvl ?? 0));
503:   const isExcellent = item.isExcellent === true;
504:   const isAncient = item.isAncient === true;
505: 
506:   const key = `${item.group}:${item.num}|${level}|${isExcellent ? 1 : 0}|${
507:     isAncient ? 1 : 0
508:   }`;
509:   const cached = statsCache.get(key);
510:   if (cached !== undefined) return cached;
511: 
512:   const def = itemDef(item.group, item.num);
513:   if (!def) {
514:     statsCache.set(key, null);
515:     return null;
516:   }
517: 
518:   const stats: ItemStats = {
519:     def,
520:     level,
521:     isExcellent,
522:     isAncient,
523:     damageMin: calcDamage(def.damageMin, def, level, isExcellent, isAncient),
524:     damageMax: calcDamage(def.damageMax, def, level, isExcellent, isAncient),
525:     magicPower: calcMagicPower(def, level, isExcellent, isAncient),
526:     blocking: calcBlocking(def, isExcellent),
527:     defense: calcDefense(def, level, isExcellent, isAncient),
528:     ...calcRequirements(def, level, isExcellent, isAncient),
529:     maxDurability: calcMaxDurability(def, level, isExcellent, isAncient),
530:   };
531: 
532:   statsCache.set(key, stats);
533:   return stats;
534: }
535: 
536: // --- the hero ---------------------------------------------------------------
537: 
538: export type HeroStats = {
539:   level: number;
540:   str: number;
541:   agi: number;
542:   vit: number;
543:   ene: number;
544:   cmd: number;
545:   /** Base class column (CLASS_COLUMNS index). */
546:   baseClass: number;
547:   /** 1 = first, 2 = second (quest), 3 = third (master) class. */
548:   stepClass: number;
549: };
550: 
551: /**
552:  * `CCharacterManager::GetBaseClass` / `GetStepClass` for the wire class
553:  * numbers (DW 0, SM 2, GM 3, DK 4, BK 6, BM 7, FE 8, ME 10, HE 11, MG 12,
554:  * DM 13, DL 16, LE 17, SUM 20, BS 22, DiM 23, RF 24, FM 25). MG and DL count
555:  * as second-class from the start, as in the original's `IsSecondClass`.
556:  */
557: export function classOf(charClass: number): { base: number; step: number } {
558:   switch (charClass) {
559:     case 0:
560:       return { base: 0, step: 1 };
561:     case 2:
562:       return { base: 0, step: 2 };
563:     case 3:
564:       return { base: 0, step: 3 };
565:     case 4:
566:       return { base: 1, step: 1 };
567:     case 6:
568:       return { base: 1, step: 2 };
569:     case 7:
570:       return { base: 1, step: 3 };
571:     case 8:
572:       return { base: 2, step: 1 };
573:     case 10:
574:       return { base: 2, step: 2 };
575:     case 11:
576:       return { base: 2, step: 3 };
577:     case 12:
578:       return { base: 3, step: 2 };
579:     case 13:
580:       return { base: 3, step: 3 };
581:     case 16:
582:       return { base: 4, step: 2 };
583:     case 17:
584:       return { base: 4, step: 3 };
585:     case 20:
586:       return { base: 5, step: 1 };
587:     case 22:
588:       return { base: 5, step: 2 };
589:     case 23:
590:       return { base: 5, step: 3 };
591:     // The Rage Fighter has no second class: `IsSecondClass` does not list him
592:     // and `IsThirdClass` lists only the Fist Master (CharacterManager.cpp:191-220).
593:     case 24:
594:       return { base: 6, step: 1 };
595:     case 25:
596:       return { base: 6, step: 3 };
597:     default:
598:       return { base: -1, step: 1 };
599:   }
600: }
601: 
602: /**
603:  * `RequireClass` with every column set: the item restricts nobody. Only the
604:  * six columns the Item.txt itself carries are counted - `RF` was filled in
605:  * from the server afterwards, and testing it too would turn every jewel and
606:  * box that was unrestricted into one that names six classes and omits the
607:  * seventh.
608:  */
609: export function classUnrestricted(def: ItemDef): boolean {
610:   return def.classes.slice(0, ITEM_TXT_CLASS_COLUMNS).every(value => value === 1);
611: }
612: 
613: /** `RequireClass`: the item's class entry for the hero is set and at or below the hero's step. */
614: export function classCanUse(def: ItemDef, hero: HeroStats): boolean {
615:   if (classUnrestricted(def)) return true;
616:   if (hero.baseClass < 0) return false;
617:   const required = def.classes[hero.baseClass] ?? 0;
618:   return required !== 0 && required <= hero.stepClass;
619: }
</file>

<file path="src/common/itemStorage.ts">
  1: import type { Item } from '../ecs/world';
  2: import { ItemGroup } from './itemStats';
  3: import { InventoryConstants } from './inventoryConstants';
  4: import { StorageKind, TRADE_COLUMNS, TRADE_ROWS, TRADE_SLOTS } from './storageKind';
  5: 
  6: /**
  7:  * `STORAGE_TYPE` (_define.h:168): the `FromStorage` / `ToStorage` byte of
  8:  * `ItemMoveRequest` and the `TargetStorageType` of `ItemMoved`. Only the
  9:  * five the client can actually open are listed; the mix variants beyond
 10:  * `ChaosMachine` (trainer, Elpis, Osbourne…) all reuse the same window in
 11:  * the original and are not ported.
 12:  *
 13:  * Defined in `storageKind.ts`, together with the trade grid, so the headless
 14:  * marketplace bot can import them without the item database this module
 15:  * reaches; everyone else keeps importing them from here.
 16:  */
 17: export { StorageKind, TRADE_COLUMNS, TRADE_ROWS, TRADE_SLOTS };
 18: 
 19: /**
 20:  * `STORAGE_TYPE::CHAOS_CARD_MIX` (_define.h:180) / OpenMU
 21:  * `Storages.ChaosCardMaster`: the Chaos Card Master's tray on the wire.
 22:  * Server-side it is the same temporary storage as the Chaos Machine
 23:  * (MoveItemAction.cs), so the client keeps it as `StorageKind.ChaosMachine`
 24:  * locally and only the move packets carry this byte while the card window
 25:  * is the open one (economy.ts `mixWireStorage`).
 26:  */
 27: export const CHAOS_CARD_WIRE_STORAGE = 9;
 28: 
 29: /** `COLUMN_*_INVENTORY` / `ROW_*_INVENTORY` (_define.h:150-155). */
 30: export const VAULT_COLUMNS = InventoryConstants.RowSize;
 31: export const VAULT_ROWS = InventoryConstants.WarehouseRows;
 32: export const VAULT_SLOTS = VAULT_COLUMNS * VAULT_ROWS;
 33: 
 34: 
 35: export const MIX_COLUMNS = 8;
 36: export const MIX_ROWS = 4;
 37: export const MIX_SLOTS = MIX_COLUMNS * MIX_ROWS;
 38: 
 39: export const PERSONAL_SHOP_COLUMNS = InventoryConstants.RowSize;
 40: export const PERSONAL_SHOP_ROWS = InventoryConstants.StoreRows;
 41: export const PERSONAL_SHOP_SLOTS = InventoryConstants.StoreSize;
 42: 
 43: /**
 44:  * Two index spaces meet here and they are not the same:
 45:  *
 46:  * - the **local index** is where an item sits in the array the client keeps
 47:  *   for that storage. The inventory array carries the 12 worn slots first,
 48:  *   so its grid starts at 12; every other storage array is just its grid.
 49:  * - the **wire slot** is what `ItemMoveRequest` / `ItemMoved` carry. It
 50:  *   matches the local index everywhere except the personal shop, which
 51:  *   OpenMU keeps inside the inventory storage behind
 52:  *   `FirstStoreItemSlotIndex` (the original's `MAX_MY_INVENTORY_EX_INDEX`).
 53:  */
 54: 
 55: /** Local array index of grid square 0 (`CNewUIInventoryCtrl::nIndexOffset`). */
 56: export function gridFirstIndex(storage: StorageKind): number {
 57:   return storage === StorageKind.Inventory
 58:     ? InventoryConstants.LastEquippableItemSlotIndex + 1
 59:     : 0;
 60: }
 61: 
 62: export function wireSlotOf(storage: StorageKind, localIndex: number): number {
 63:   return storage === StorageKind.PersonalShop
 64:     ? InventoryConstants.FirstStoreItemSlotIndex + localIndex
 65:     : localIndex;
 66: }
 67: 
 68: export function localIndexOf(storage: StorageKind, wireSlot: number): number {
 69:   return storage === StorageKind.PersonalShop
 70:     ? wireSlot - InventoryConstants.FirstStoreItemSlotIndex
 71:     : wireSlot;
 72: }
 73: 
 74: export function storageColumns(storage: StorageKind): number {
 75:   switch (storage) {
 76:     case StorageKind.Inventory:
 77:       return InventoryConstants.RowSize;
 78:     case StorageKind.Vault:
 79:       return VAULT_COLUMNS;
 80:     case StorageKind.Trade:
 81:       return TRADE_COLUMNS;
 82:     case StorageKind.ChaosMachine:
 83:       return MIX_COLUMNS;
 84:     case StorageKind.PersonalShop:
 85:       return PERSONAL_SHOP_COLUMNS;
 86:   }
 87: }
 88: 
 89: export function storageRows(storage: StorageKind): number {
 90:   switch (storage) {
 91:     case StorageKind.Inventory:
 92:       return InventoryConstants.InventoryRows;
 93:     case StorageKind.Vault:
 94:       return VAULT_ROWS;
 95:     case StorageKind.Trade:
 96:       return TRADE_ROWS;
 97:     case StorageKind.ChaosMachine:
 98:       return MIX_ROWS;
 99:     case StorageKind.PersonalShop:
100:       return PERSONAL_SHOP_ROWS;
101:   }
102: }
103: 
104: const is = (item: Item, group: number, num: number) =>
105:   item.group === group && item.num === num;
106: 
107: /**
108:  * The part of `IsStoreBan` / `IsTradeBan` / `IsPersonalShopBan`
109:  * (ZzzInventory.cpp:7529-7690) this Data copy can express: the Season 6
110:  * lists name dozens of item numbers that `items.json` here does not carry,
111:  * so only the entries whose group/number exist are checked - the server
112:  * refuses the rest anyway and the move rolls back.
113:  */
114: const WEAPON_OF_ARCHANGEL = (item: Item) => is(item, ItemGroup.Helper, 19);
115: const DARK_HORSE_OR_RAVEN = (item: Item) =>
116:   item.group === ItemGroup.Helper && (item.num === 4 || item.num === 5);
117: const WIZARDS_RING_PLUS = (item: Item) =>
118:   is(item, ItemGroup.Helper, 20) && (item.lvl ?? 0) !== 0;
119: const MOONSTONE_PENDANT = (item: Item) => is(item, ItemGroup.Helper, 38);
120: const BOX_OF_LUCK_13 = (item: Item) =>
121:   is(item, ItemGroup.Potion, 11) && (item.lvl ?? 0) === 13;
122: /** `ITEM_POTION + 21` is the Devil's Eye/Key box; only level 3 may move. */
123: const QUEST_BOX = (item: Item) =>
124:   is(item, ItemGroup.Potion, 21) && (item.lvl ?? 0) !== 3;
125: 
126: /** `IsStoreBan`: what the vault refuses. */
127: export function isVaultBanned(item: Item): boolean {
128:   return (
129:     WEAPON_OF_ARCHANGEL(item) ||
130:     WIZARDS_RING_PLUS(item) ||
131:     BOX_OF_LUCK_13(item) ||
132:     QUEST_BOX(item)
133:   );
134: }
135: 
136: /** `IsTradeBan`: what cannot cross to another player. */
137: export function isTradeBanned(item: Item): boolean {
138:   return (
139:     MOONSTONE_PENDANT(item) ||
140:     WEAPON_OF_ARCHANGEL(item) ||
141:     WIZARDS_RING_PLUS(item) ||
142:     BOX_OF_LUCK_13(item) ||
143:     QUEST_BOX(item)
144:   );
145: }
146: 
147: /** `IsPersonalShopBan`: what may not be put up for sale. */
148: export function isPersonalShopBanned(item: Item): boolean {
149:   return (
150:     MOONSTONE_PENDANT(item) ||
151:     WEAPON_OF_ARCHANGEL(item) ||
152:     WIZARDS_RING_PLUS(item) ||
153:     BOX_OF_LUCK_13(item) ||
154:     QUEST_BOX(item) ||
155:     DARK_HORSE_OR_RAVEN(item)
156:   );
157: }
158: 
159: /** The refusal reason a storage has for the carried item, or null. */
160: export function storageBan(storage: StorageKind, item: Item): string | null {
161:   switch (storage) {
162:     case StorageKind.Vault:
163:       return isVaultBanned(item) ? 'This item cannot be stored' : null;
164:     case StorageKind.Trade:
165:       return isTradeBanned(item) ? 'This item cannot be traded' : null;
166:     case StorageKind.PersonalShop:
167:       return isPersonalShopBanned(item) ? 'This item cannot be sold in a shop' : null;
168:     default:
169:       return null;
170:   }
171: }
</file>

