  6:  * and a warm-up for it.
  7:  *
  8:  * Why the warm-up: an `<img>` is a *low*-priority request that Chrome parks
  9:  * behind every high-priority `fetch()` / XHR in flight, and the world streams
 10:  * models and textures through exactly those while the player walks. A shop
 11:  * opened in a busy town watched its 30–100 icons trickle in six at a time
 12:  * (HTTP/1.1 per-host limit), each batch waiting on a frame, for 20 s. The
 13:  * warm-up fires the requests the moment the stock / inventory packet lands -
 14:  * before React mounts a single square - at high priority, and keeps the
 15:  * `Image` objects so the memory cache never has to revalidate them (vite's
 16:  * `public/` answers with `Cache-Control: no-cache`).
 17:  *
 18:  * Which files exist comes from `itemIconManifest.ts`, generated by
 19:  * `tools/itemIconManifest.ts` from the folder: the pack is uneven (wings and
 20:  * most later-season items only have the `_0` tint, some groups have no
 21:  * excellent variant, 46 `items.json` rows have no file at all), and without
 22:  * the manifest every gap was up to three 404s per square.
 23:  */
 24: 
 25: /** Tints the pack was rendered at: +0, +3, +5, … +15 (manifest bit order). */
 26: export const ITEM_ICON_TINTS: readonly number[] = [0, 3, 5, 7, 9, 11, 13, 15];
 27: 
 28: export function itemIconTint(lvl: number): number {
 29:   if (lvl < 3) return 0;
 30:   if (lvl < 5) return 3;
 31:   if (lvl < 7) return 5;
 32:   if (lvl < 9) return 7;
 33:   if (lvl < 11) return 9;
 34:   if (lvl < 13) return 11;
 35:   if (lvl < 15) return 13;
 36:   return 15;
 37: }
 38: 
 39: type Variant = '' | '_e' | '_a';
 40: 
 41: const VARIANT_BIT: Readonly<Record<Variant, number>> = {
 42:   '': 0,
 43:   _e: ITEM_ICON_TINTS.length,
 44:   _a: ITEM_ICON_TINTS.length * 2,
 45: };
 46: 
 47: function packUrl(group: number, num: number, tint: number, variant: Variant): string {
 48:   return `/items/item_${group}_${num}_${tint}${variant}.png`;
 49: }
 50: 
 51: /** Whether `public/items` holds this exact file (per the generated manifest). */
 52: export function hasItemIconFile(
 53:   group: number,
 54:   num: number,
 55:   tint: number,
 56:   variant: Variant
 57: ): boolean {
 58:   const mask = ITEM_ICON_MANIFEST[`${group}_${num}`];
 59:   if (mask === undefined) return false;
 60:   const tintIndex = ITEM_ICON_TINTS.indexOf(tint);
 61:   if (tintIndex < 0) return false;
 62:   return (mask & (1 << (tintIndex + VARIANT_BIT[variant]))) !== 0;
 63: }
 64: 
 65: /** URL of the file the item asks for, whether or not it exists. */
 66: export function itemIconPackUrl({ group, num, lvl, isExcellent }: Item): string {
 67:   return packUrl(group, num, itemIconTint(lvl ?? 0), isExcellent ? '_e' : '');
 68: }
 69: 
 70: /**
 71:  * The files to try for this item, best first, restricted to the ones that
 72:  * exist: the exact tint and variant, then the tint dropped, then the
 73:  * variant dropped, then both. Empty when the item has no icon at all - the
 74:  * caller shows the missing-icon square straight away instead of 404ing.
 75:  */
 76: export function itemIconPackChain(item: Item): string[] {
 77:   const { group, num } = item;
 78:   const tint = itemIconTint(item.lvl ?? 0);
 79:   const variant: Variant = item.isExcellent ? '_e' : item.isAncient ? '_a' : '';
 80: 
 81:   const candidates: [number, Variant][] = [[tint, variant]];
 82:   if (tint !== 0) candidates.push([0, variant]);
 83:   if (variant !== '') {
 84:     candidates.push([tint, '']);
 85:     if (tint !== 0) candidates.push([0, '']);
 86:   }
 87: 
 88:   const urls: string[] = [];
 89:   for (const [t, v] of candidates) {
 90:     if (hasItemIconFile(group, num, t, v)) urls.push(packUrl(group, num, t, v));
 91:   }
 92:   return urls;
 93: }
 94: 
 95: /** The first file of the chain: what the icon will show, or `null` for none. */
 96: export function itemIconUrl(item: Item): string | null {
 97:   return itemIconPackChain(item)[0] ?? null;
 98: }
 99: 
100: /**
101:  * Identity of an item's icon - every field the file name depends on. Used
102:  * as the React key / effect dependency so a durability tick on the same
103:  * item does not restart its load.
104:  */
105: export function itemIconKey(item: Item): string {
106:   return `${item.group}_${item.num}_${itemIconTint(item.lvl ?? 0)}${
107:     item.isExcellent ? '_e' : item.isAncient ? '_a' : ''
108:   }`;
109: }
110: 
111: /**
112:  * Pinned so the browser's memory cache keeps the decoded file. Bounded: a
113:  * long session through vault, shops and trades would otherwise pin every
114:  * icon ever seen (8 k files, 65 MB on disk). Insertion-ordered `Map` as an
115:  * LRU - a hit is re-inserted at the end, the oldest entry is dropped past
116:  * the cap.
117:  */
118: const WARM_CAP = 512;
119: const warmed = new Map<string, HTMLImageElement>();
120: 
121: /** Start loading the icons of these items now, ahead of the grid that shows them. */
122: export function prefetchItemIcons(
123:   items: Iterable<Item | null | undefined>
124: ): void {
125:   if (typeof Image === 'undefined') return;
126: 
127:   for (const item of items) {
128:     if (!item) continue;
129:     const url = itemIconUrl(item);
130:     if (!url) continue;
131: 
132:     const hit = warmed.get(url);
133:     if (hit) {
134:       warmed.delete(url);
135:       warmed.set(url, hit);
136:       continue;
137:     }
138: 
139:     const img = new Image();
140:     // Not in @types/react 18 / lib.dom of this TS: set as a plain property.
141:     (img as HTMLImageElement & { fetchPriority?: string }).fetchPriority = 'high';
142:     img.decoding = 'async';
143:     img.src = url;
144:     warmed.set(url, img);
145: 
146:     if (warmed.size > WARM_CAP) {
147:       const oldest = warmed.keys().next().value;
148:       if (oldest !== undefined) warmed.delete(oldest);
149:     }
150:   }
151: }
</file>

