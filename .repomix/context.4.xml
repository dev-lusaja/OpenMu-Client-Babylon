250: /**
251:  * `Models[type].StreamMesh = N` (ZzzBMD.cpp:997-1001): mesh N keeps its
252:  * texture and its blend state but is drawn *unlit* - flat `BodyLight`
253:  * instead of the per-vertex terrain light. Everything else about the
254:  * material is whatever the mesh already resolved to, so a keyed sand-fall
255:  * sheet stays alpha-tested and an opaque flesh curtain stays opaque.
256:  *
257:  * Returns null when the mesh is not on a shared item material (nothing to
258:  * re-resolve from).
259:  */
260: export function getFlatLitVariant(
261:   scene: Scene,
262:   mesh: AbstractMesh
