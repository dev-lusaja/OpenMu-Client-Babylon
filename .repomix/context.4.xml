<file path="src/common/equipSlots.ts">
 1: import type { Item } from '../ecs/world';
 2: import { InventoryConstants } from './inventoryConstants';
 3: import { itemDef } from './itemStats';
 4: 
 5: /**
 6:  * Which worn slot an item belongs to. `ItemSlot` in `items.json` names one
 7:  * slot per item; the two pairs the original lets an item fall through to are
 8:  * the hands (a weapon may go to the off hand) and the fingers.
 9:  *
10:  * The one table: the inventory's drop guard, its right-click auto-equip and
11:  * the compare tooltip all read this and nothing else.
12:  */
13: export function equipSlots(item: Item): number[] {
14:   const slot = itemDef(item.group, item.num)?.slot ?? -1;
15:   if (slot < 0) return [];
16: 
17:   if (slot === InventoryConstants.LeftHandSlot) {
18:     return [slot, InventoryConstants.RightHandSlot];
19:   }
20:   if (slot === InventoryConstants.Ring1Slot) {
21:     return [slot, InventoryConstants.Ring2Slot];
22:   }
23: 
24:   return [slot];
25: }
26: 
27: /** True when dropping `item` onto `slot` equips it. */
28: export function isEquipable(slot: number, item: Item): boolean {
29:   return equipSlots(item).includes(slot);
30: }
31: 
32: /** The free slot the item would land in, -1 when it has none. */
33: export function equipDestination(
34:   item: Item,
35:   worn: readonly (Item | null)[]
36: ): number {
37:   for (const slot of equipSlots(item)) {
38:     if (!worn[slot]) return slot;
39:   }
40:   return -1;
41: }
</file>

<file path="src/common/experience.ts">
 1: /**
 2:  * OpenMU's default experience table (GameContext.cs `DefaultExperienceFormula`):
 3:  *   level == 0      → 0
 4:  *   level <  256    → 10 * (level + 8) * (level - 1)^2
 5:  *   level >= 256    → the above + 1000 * (level - 247) * (level - 256)^2
 6:  *
 7:  * `experienceForLevel(n)` is the total experience needed to *reach* level n.
 8:  * The server only sends `ExperienceForNextLevel` with `CharacterInformation`;
 9:  * after a `CharacterLevelUpdate` the client has to derive the new bracket itself.
10:  */
11: export function experienceForLevel(level: number): number {
12:   if (level <= 0) return 0;
13:   const base = 10 * (level + 8) * (level - 1) * (level - 1);
14:   if (level < 256) return base;
15:   return base + 1000 * (level - 247) * (level - 256) * (level - 256);
16: }
</file>

