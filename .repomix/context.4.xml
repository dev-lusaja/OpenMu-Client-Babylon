1455:    *
1456:    * Nothing here is built speculatively. A clone is a full copy of the
1457:    * caster's submesh hierarchy and a second set of draw calls, so on a tier
1458:    * where the shadow never activates it should never exist - and when the
1459:    * player turns shadows off, the maps they have not visited yet cost nothing
1460:    * at all.
1461:    */
1462:   private updateShadowSlots() {
1463:     if (this._shadows.length === 0) return;
1464: 
1465:     for (let slot = 0; slot < this._shadows.length; slot++) {
1466:       if (this._shadows[slot] || this._shadowSlotsBarren[slot]) continue;
1467:       if (!blobShadowsActive() || !this._castsBlobShadow) continue;
1468: 
1469:       const shadow = createObjectShadow(
1470:         this.gltf!.mesh,
1471:         this._node,
1472:         this.rootObject.node,
1473:         slot,
1474:         {
1475:           blendMesh: this.ShadowBlendMeshCasts,
1476:           keyed: !this.IsMapObject,
1477:         }
1478:       );
1479: 
1480:       if (!shadow) {
1481:         this._shadowSlotsBarren[slot] = true;
1482:         continue;
1483:       }
1484: 
1485:       this._shadows[slot] = shadow;
1486:       this._shadowsVisible = null;
1487:     }
