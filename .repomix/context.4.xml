106: /**
107:  * One flag: the quad, its material and the socket that hangs it off the bone.
108:  * Everything under the socket is in BMD space (metres), the same space the
109:  * link matrices of weaponAttachment / wings are written in.
110:  */
111: export class GuildFlag {
112:   private readonly socket: TransformNode;
113:   private readonly mesh: Mesh;
114:   private readonly material: StandardMaterial;
115:   private texture: RawTexture | null = null;
116:   /** The mark this flag's texture was built from, to know when to rebuild. */
117:   private markKey = '';
118:   private bone: TransformNodeType | null = null;
119: 
120:   constructor(private readonly scene: Scene) {
121:     this.socket = new TransformNode('guildFlagSocket', scene);
122: 
123:     this.material = new StandardMaterial('guildFlag', scene);
124:     // `glColor3f(1,1,1)` + `BindTexture`: the flag is drawn unlit, and
125:     // `EnableAlphaTest()` keeps the transparent palette entry out.
126:     this.material.disableLighting = true;
127:     this.material.emissiveColor.set(1, 1, 1);
128:     this.material.diffuseColor.set(0, 0, 0);
129:     this.material.specularColor.set(0, 0, 0);
130:     this.material.useAlphaFromDiffuseTexture = true;
131:     this.material.transparencyMode = StandardMaterial.MATERIAL_ALPHATEST;
132:     // The original culls (`EnableCullFace`), but the loader basis mirrors the
133:     // model, so which face survives is not the original's; two-sided keeps the
134:     // flag visible from both sides of the character instead of half the turn.
135:     this.material.backFaceCulling = false;
136: 
137:     this.mesh = new Mesh('guildFlag', scene);
138:     // `RenderPlane3D`: (-W,-W,-H) (W,W,-H) (W,W,H) (-W,-W,H), UVs bottom-left
139:     // to top-right, so the mark reads upright on the diagonal quad.
140:     const w = FLAG_WIDTH * CM;
141:     const h = FLAG_HEIGHT * CM;
142:     const vertex = new VertexData();
143:     vertex.positions = [-w, -w, -h, w, w, -h, w, w, h, -w, -w, h];
144:     vertex.uvs = [0, 1, 1, 1, 1, 0, 0, 0];
145:     vertex.indices = [0, 1, 2, 0, 2, 3];
146:     vertex.normals = [];
147:     VertexData.ComputeNormals(vertex.positions, vertex.indices, vertex.normals);
148:     vertex.applyToMesh(this.mesh);
149:     this.mesh.material = this.material;
150:     this.mesh.isPickable = false;
151:     this.mesh.alwaysSelectAsActiveMesh = true;
152:     this.mesh.parent = this.socket;
153:   }
154: 
155:   /** Rebuilds the texture when the guild's mark changes; hides an empty one. */
156:   setMark(packed: ArrayLike<number>): void {
157:     const key = Array.from(packed).join(',');
158:     if (key === this.markKey) return;
159:     this.markKey = key;
160:     this.texture?.dispose();
161:     this.texture = guildMarkTexture(this.scene, packed, 'guildMark');
162:     this.material.diffuseTexture = this.texture;
163:   }
164: 
165:   /** Bone 26 of the wearer, once its skeleton exists. */
166:   attach(bone: TransformNodeType): void {
167:     if (this.bone === bone) return;
168:     this.bone = bone;
169:     this.socket.parent = bone;
170:   }
171: 
172:   get attached(): boolean {
173:     return this.bone !== null;
174:   }
175: 
176:   set visible(value: boolean) {
177:     this.mesh.setEnabled(value);
178:   }
179: 
180:   /**
181:    * `AngleMatrix(o->Angle + FLAG_ANGLE)` then the offset - rebuilt per frame
182:    * because it reads the wearer's yaw.
183:    */
184:   update(yawRadians: number, thunderHawk: boolean): void {
185:     this.socket.setPreTransformMatrix(
186:       toBabylon(
187:         angleMatrix({
188:           angle: [
189:             FLAG_ANGLE[0],
190:             FLAG_ANGLE[1],
191:             FLAG_ANGLE[2] + yawRadians / DEG,
192:           ],
193:           offset: [
194:             FLAG_OFFSET[0],
195:             FLAG_OFFSET[1],
196:             thunderHawk ? THUNDER_HAWK_OFFSET_Z : FLAG_OFFSET[2],
197:           ],
198:         })
199:       )
200:     );
201:   }
202: 
203:   dispose(): void {
204:     this.mesh.dispose();
205:     this.material.dispose();
206:     this.texture?.dispose();
207:     this.socket.dispose();
208:   }
209: }
