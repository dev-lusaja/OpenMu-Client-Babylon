 58: function BufferBlockCopy<TSourceArray extends Uint8Array | Uint16Array | Uint32Array, TDestArray extends Uint8Array | Uint16Array | Uint32Array>(buffer: TSourceArray, srcOffset: Int, dst: TDestArray, dstOffset: Int, bytesCount: Int): void {
 59:   if (buffer.BYTES_PER_ELEMENT === dst.BYTES_PER_ELEMENT) {
 60:     for (let i = 0; i < bytesCount; i++) {
 61:       dst[dstOffset + i] = buffer[srcOffset + i];
 62:     }
 63:   } else {
 64:     const s = new DataView(buffer.buffer);
 65:     const d = new DataView(dst.buffer);
 66: 
 67:     for (let i = 0; i < bytesCount; i++) {
 68:       d.setUint8(dstOffset + i, s.getUint8(srcOffset + i));
 69:     }
 70:   }
 71: }
