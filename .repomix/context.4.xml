<file path="src/common/approachPath.ts">
 1: /**
 2:  * Where a walk toward something the hero means to act on has to end.
 3:  *
 4:  * Both approaches - the swing's and the cast's - aim their walk at the
 5:  * target's own cell and rely on the caller stopping once it is in reach.
 6:  * That cell must never survive into the path that is actually walked: it is
 7:  * the array `NetworkSystem` turns into a WalkRequest *and* the array
 8:  * `MoveAlongPathSystem` steps the hero along, so leaving it in place walks
 9:  * the server onto the target (and the next ObjectMoved correction snaps the
10:  * hero there), and lets a frame that catches up on a long stall carry the
11:  * hero the whole remaining way in one go.
12:  */
13: 
14: /**
15:  * How far along `path` the hero still has to walk to reach `stop`.
16:  *
17:  * `stop` is the last step the server has been sent (`pathfinding.sentThrough`),
18:  * and this is the budget the walk is clamped to: a frame that catches up on a
19:  * long stall must not carry the hero past the end of the chunk the server is
20:  * walking, or the next request starts from a tile the server has not reached.
21:  * A `stop` already consumed off the front of the array is zero - hold here
22:  * until the next chunk goes out.
23:  */
24: export function distanceAlongPath(
25:   pos: { x: number; z: number },
26:   path: { x: number; y: number }[],
27:   stop: { x: number; y: number }
28: ): number {
29:   const end = path.indexOf(stop);
30:   if (end < 0) return 0;
31: 
32:   let total = 0;
33:   let fromX = pos.x;
34:   let fromY = pos.z;
35: 
36:   for (let i = 0; i <= end; i++) {
37:     const dx = path[i].x - fromX;
38:     const dy = path[i].y - fromY;
39:     total += Math.sqrt(dx * dx + dy * dy);
40:     fromX = path[i].x;
41:     fromY = path[i].y;
42:   }
43: 
44:   return total;
45: }
46: 
47: /** Cut `path` at the first cell already within `range` tiles of (x, y). */
48: export function truncatePathWithinRange(
49:   path: { x: number; y: number }[],
50:   x: number,
51:   y: number,
52:   range: number
53: ): void {
54:   const rangeSq = range * range;
55:   for (let i = 0; i < path.length; i++) {
56:     const dx = x - path[i].x;
57:     const dy = y - path[i].y;
58:     if (dx * dx + dy * dy <= rangeSq) {
59:       path.length = i + 1;
60:       return;
61:     }
62:   }
63: }
</file>

