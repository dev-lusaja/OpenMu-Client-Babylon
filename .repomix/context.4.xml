<file path="src/common/lightingQuality.ts">
  1: import type { Scene } from '../libs/babylon/exports';
  2: import { GameOptions } from './gameOptions';
  3: import type { TextKey } from '../i18n';
  4: 
  5: /**
  6:  * Lighting quality tiers (ARCHITECTURE §6). Classic is the original look:
  7:  * baked lightmap + projected blob shadows, no grade. Enhanced adds the
  8:  * structured key, a cascaded shadow map on the sun, half-res SSAO and the
  9:  * distance haze; Ultra runs the same set at full resolution with PCSS.
 10:  */
 11: /** The tier names, as text keys - the Options slider prints `t()` of these. */
 12: export const LIGHTING_QUALITY_LABEL_KEYS: readonly TextKey[] = [
 13:   'options.quality.classic',
 14:   'options.quality.enhanced',
 15:   'options.quality.ultra',
 16: ];
 17: 
 18: export const LIGHTING_QUALITY_MAX = LIGHTING_QUALITY_LABEL_KEYS.length - 1;
 19: 
 20: export type LightingTier = {
 21:   readonly cascades: number;
 22:   readonly shadowMapSize: number;
 23:   /** Contact-hardening (PCSS) instead of the fixed PCF kernel. */
 24:   readonly pcss: boolean;
 25:   readonly ssaoRatio: number;
 26:   readonly ssaoSamples: number;
 27: };
 28: 
 29: export const LIGHTING_TIERS: readonly (LightingTier | null)[] = [
 30:   null,
 31:   { cascades: 3, shadowMapSize: 2048, pcss: false, ssaoRatio: 0.5, ssaoSamples: 8 },
 32:   { cascades: 3, shadowMapSize: 4096, pcss: true, ssaoRatio: 1, ssaoSamples: 16 },
 33: ];
 34: 
 35: export function tierIndex(): number {
 36:   return Math.max(
 37:     0,
 38:     Math.min(LIGHTING_QUALITY_MAX, Math.round(GameOptions.lightingQuality))
 39:   );
 40: }
 41: 
 42: export function lightingTier(): LightingTier | null {
 43:   return LIGHTING_TIERS[tierIndex()];
 44: }
 45: 
 46: /**
 47:  * Pooled torch lights per tier - and, because every object material is
 48:  * compiled with `2 + budget` light slots, the number of lights the forward
 49:  * fragment shader evaluates for every pixel of every object.
 50:  *
 51:  * This is the single biggest knob on object shading cost: the slots run
 52:  * whether or not the light reaches the surface (Babylon builds a mesh's
 53:  * `lightSources` from layer masks and include/exclude lists, never from
 54:  * range), so an unused slot is not a free slot.
 55:  *
 56:  * None on Classic: the original has no per-pixel lights, BodyLight already
 57:  * carries the torch through the terrain delta (§11.5).
 58:  */
 59: const POINT_LIGHT_BUDGETS: readonly number[] = [0, 8, 8];
 60: 
 61: /**
 62:  * MSAA sample count on the rendering pipeline's HDR target, per tier. The
 63:  * engine itself is created without antialiasing (`main.tsx`), so this is the
 64:  * only AA in the chain - and at 4x it is the most expensive single line in
 65:  * the post setup on fill-rate-bound GPUs, because every pass in the chain
 66:  * inherits the multisampled target. None on Classic: the original has no
 67:  * AA, and a linear-space resolve lifts every dark edge pixel (K1 measured
 68:  * +0.004 on every percentile with 2 samples).
 69:  */
 70: const PIPELINE_SAMPLE_COUNTS: readonly number[] = [1, 4, 4];
 71: 
 72: export function pipelineSamples(): number {
 73:   return PIPELINE_SAMPLE_COUNTS[tierIndex()] ?? 4;
 74: }
 75: 
 76: let pointLightBudgetSnapshot: number | null = null;
 77: 
 78: /**
 79:  * Snapshotted on first use. It fixes both how many `PointLight`s the scene
 80:  * holds and the light-slot count baked into every cached object material, and
 81:  * neither can change without rebuilding the scene - so a mid-session quality
 82:  * change only reaches this on reload.
 83:  */
 84: export function pointLightBudget(): number {
 85:   if (pointLightBudgetSnapshot === null) {
 86:     pointLightBudgetSnapshot = POINT_LIGHT_BUDGETS[tierIndex()] ?? 8;
 87:   }
 88: 
 89:   return pointLightBudgetSnapshot;
 90: }
 91: 
 92: /**
 93:  * True while the cascaded shadow map is live. The projected blob shadows
 94:  * read as a second, wrong-direction shadow next to a CSM one, so they are
 95:  * parked whenever this is set.
 96:  */
 97: export const csmState = { active: false };
 98: 
 99: /**
100:  * Set by `objectShadow` so the shadow owner can re-park the blob shadows
101:  * without importing it (objectShadow -> scenes/shadows cycle).
102:  */
103: export const blobShadowRefresh: { fn: ((scene: Scene) => void) | null } = {
104:   fn: null,
105: };
106: 
107: export function csmActive(): boolean {
108:   return csmState.active;
109: }
110: 
111: /**
112:  * One dial for the whole dynamic layer. Multiplies every pooled point light's
113:  * intensity and the floor delta the terrain shader adds, so torches, item
114:  * lamps, skill flashes and NPC forges all scale together while their relative
115:  * tuning - the `pointGain`/`floorGain` each recipe carries - stays where it
116:  * was set. A constant rather than an option: the layer is additive by rule.
117:  */
118: export const DYNAMIC_LIGHT_GAIN = 1;
119: 
120: export function dynamicLightGain(): number {
121:   return DYNAMIC_LIGHT_GAIN;
122: }
</file>

<file path="src/common/lightModel.ts">
 1: import { lightingTier } from './lightingQuality';
 2: 
 3: /**
 4:  * The unified light model: **the bake is the exposure**.
 5:  *
 6:  * The original client lights the ground and every object with the same
 7:  * number - the baked lightmap at their tile (`texel x PrimaryTerrainLight`,
 8:  * ZzzLodTerrain.cpp:481-505; `texel x BodyLight`, ZzzBMD.cpp:255-257). With
 9:  * the flag on, the terrain decodes its output to linear when image processing
10:  * runs in post, exactly as Babylon's Standard fragment does, and objects
11:  * multiply their albedo by BodyLight on both material paths.
12:  *
13:  * The flag stays for A/B against the old look.
14:  */
15: export const UNIFIED_LIGHT_MODEL = true;
16: 
17: /**
18:  * Whether the frame buffer holds linear values (image processing runs in
19:  * post and the unified model is on). The terrain shader keys its output
20:  * decode on this. Colours that skip the material fragments entirely - the
21:  * clear colour, the haze colour - are decoded once at their source
22:  * (`lighting/director.ts`), never divided by an exposure.
23:  */
24: export function linearBufferActive(scene: {
25:   imageProcessingConfiguration: { applyByPostProcess: boolean };
26: }): boolean {
27:   return UNIFIED_LIGHT_MODEL && scene.imageProcessingConfiguration.applyByPostProcess;
28: }
29: 
30: /**
31:  * Whether the structured light budget (ARCHITECTURE §3.2) composes the
32:  * frame: `lin(texel x bake) x light`, torch delta added after the decode,
33:  * shadow floor applied in linear. Only on the Enhanced/Ultra tiers with a
34:  * linear buffer; Classic keeps the original's gamma-space product so that
35:  * tier stays byte-identical to the reference formula.
36:  */
37: export function linearLightActive(scene: {
38:   imageProcessingConfiguration: { applyByPostProcess: boolean };
39: }): boolean {
40:   return linearBufferActive(scene) && lightingTier() !== null;
41: }
</file>

