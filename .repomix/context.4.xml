<file path="src/common/compressedAssets.ts">
  1: /**
  2:  * Gzip sidecars for the game data.
  3:  *
  4:  * The converted assets are binary but not compressed: a GLB is a vertex blob
  5:  * behind a large ASCII glTF header (`player.glb` is 8.1 MB, 5.2 MB of it
  6:  * JSON), a `.OZT` is an uncompressed TGA, a `.att` is a tile array. gzip
  7:  * takes the tree to roughly a third, and the character rig to a sixth. Static
  8:  * hosts will not compress these content types on their own, so the bytes are
  9:  * packed at build time (`tools/compressAssets.ts`) into a `<file>.gz` beside
 10:  * each one, and unpacked here with the browser's own `DecompressionStream`.
 11:  *
 12:  * Nothing depends on a sidecar existing. Every read falls back to the plain
 13:  * file - a build published without them, a half-copied tree, a host that
 14:  * mangles them, a browser with no `DecompressionStream`: the scene still
 15:  * loads, it just pays full size for that file. The decision is made once per
 16:  * session so a deployment without sidecars costs one 404 rather than one per
 17:  * asset, and a run of failures after that turns the whole thing off.
 18:  *
 19:  * `OZJ` and the audio are deliberately not on the list: they are JPEG and MP3
 20:  * already and gzip hands back 0.81-0.93 of the original, which does not pay
 21:  * for the extra request.
 22:  */
 23: 
 24: /** Written beside every compressible asset by `tools/compressAssets.ts`. */
 25: export const COMPRESSED_SUFFIX = '.gz';
 26: 
 27: /**
 28:  * Extensions that get a sidecar. Shared with the build tool, which is the
 29:  * only producer: "on this list" and "has a sidecar" have to mean the same
 30:  * thing, or the client pays a 404 in front of files that never had one.
 31:  */
 32: export const COMPRESSED_EXTENSIONS: ReadonlySet<string> = new Set([
 33:   // converted models
 34:   'glb',
 35:   // sprites: OZT is a TGA behind a header (OZJ is a JPEG - not on this list)
 36:   'ozt',
 37:   // terrain: height field, tile attributes, tile map, object records
 38:   'ozb',
 39:   'att',
 40:   'map',
 41:   'obj',
 42:   // tables and scripts: minimap markers, quests, the camera walk scripts
 43:   'bmd',
 44:   'cws',
 45: ]);
 46: 
 47: export function isCompressedAsset(url: string): boolean {
 48:   const path = url.split(/[?#]/, 1)[0];
 49:   const ext = path.split('.').pop()?.toLowerCase();
 50:   return !!ext && COMPRESSED_EXTENSIONS.has(ext);
 51: }
 52: 
 53: const GZIP_MAGIC = [0x1f, 0x8b];
 54: 
 55: /** `?nogz` takes every read to the plain file: the A/B, and the kill switch. */
 56: function turnedOff(): boolean {
 57:   try {
 58:     return new URLSearchParams(location.search).has('nogz');
 59:   } catch {
 60:     return false;
 61:   }
 62: }
 63: 
 64: /** No decoder, no sidecars: every read goes straight to the plain file. */
 65: const CAN_UNPACK = typeof DecompressionStream !== 'undefined' && !turnedOff();
 66: 
 67: /**
 68:  * Whether this deployment ships sidecars at all, answered by the first
 69:  * compressible read and awaited by every other one - they are waiting on the
 70:  * network anyway, and the answer arrives with that first response's headers.
 71:  */
 72: let answered: Promise<boolean> | null = null;
 73: let answer: ((available: boolean) => void) | null = null;
 74: 
 75: /** Revocable after the answer: a tree that starts failing is switched off. */
 76: let enabled = true;
 77: 
 78: let failures = 0;
 79: 
 80: const MAX_FAILURES = 3;
 81: 
 82: function disable(reason: string): null {
 83:   if (enabled) {
 84:     enabled = false;
 85:     console.warn(`Compressed assets off (${reason}); serving the plain files.`);
 86:   }
 87:   return null;
 88: }
 89: 
 90: function failed(url: string, reason: unknown): null {
 91:   console.warn(`Could not unpack ${url}${COMPRESSED_SUFFIX}, using the plain file:`, reason);
 92:   if (++failures >= MAX_FAILURES) disable(`${failures} failures`);
 93:   return null;
 94: }
 95: 
 96: async function unpack(packed: Uint8Array): Promise<Uint8Array> {
 97:   const stream = new Blob([packed as BlobPart])
 98:     .stream()
 99:     .pipeThrough(new DecompressionStream('gzip'));
100: 
101:   return new Uint8Array(await new Response(stream).arrayBuffer());
102: }
103: 
104: /** The sidecar's bytes, or null for "there is no usable sidecar for this". */
105: async function fromSidecar(url: string): Promise<Uint8Array | null> {
106:   if (!CAN_UNPACK || !enabled || !isCompressedAsset(url)) return null;
107: 
108:   let probing = false;
109: 
110:   if (!answered) {
111:     probing = true;
112:     answered = new Promise<boolean>(resolve => {
113:       answer = resolve;
114:     });
115:   } else if (!(await answered) || !enabled) {
116:     return null;
117:   }
118: 
119:   const settle = (available: boolean) => {
120:     if (!probing) return;
121:     probing = false;
122:     answer?.(available);
123:     if (!available) disable('this build ships none');
124:   };
125: 
126:   try {
127:     const res = await fetch(url + COMPRESSED_SUFFIX);
128:     const type = res.headers.get('content-type') ?? '';
129:     // A dev server answers a missing path with index.html and HTTP 200, so
130:     // the status alone does not say the file is there (same trap as
131:     // `downloadBytesBuffer`).
132:     const missing = !res.ok || type.startsWith('text/html');
133: 
134:     settle(!missing);
135: 
136:     if (missing) return null;
137: 
138:     const packed = new Uint8Array(await res.arrayBuffer());
139: 
140:     // A host that answers `.gz` with `Content-Encoding: gzip` (vite's dev
141:     // server does, and so does nginx's `gzip_static`) has had the browser
142:     // unwrap it already: the wire still carried the packed bytes, and what is
143:     // left here is the asset. Only unpack what is still gzip.
144:     const gzipped =
145:       packed[0] === GZIP_MAGIC[0] && packed[1] === GZIP_MAGIC[1];
146: 
147:     const bytes = gzipped ? await unpack(packed) : packed;
148:     failures = 0;
149:     return bytes;
150:   } catch (error) {
151:     settle(false);
152:     return failed(url, error);
153:   }
154: }
155: 
156: /**
157:  * A sidecar that read back fine but turned out not to hold the asset. Only a
158:  * reader that parses the bytes can tell - a host that answers `.gz` with
159:  * `Content-Encoding` has the browser unwrap it, so a truncated sidecar
160:  * arrives here as a short but otherwise plausible file. Counts towards the
161:  * same limit as a failure inside this module.
162:  */
163: export function sidecarFailed(url: string, reason: unknown): void {
164:   failed(url, reason);
165: }
166: 
167: export async function plainBytes(url: string): Promise<Uint8Array> {
168:   const res = await fetch(url);
169:   // vite's SPA fallback answers a missing path with index.html and HTTP 200;
170:   // a BMD / OZJ / GLB reader then decodes HTML into plausible-looking garbage
171:   // (the master tree once showed groups 134-255 that way). Fail loudly instead.
172:   const type = res.headers.get('content-type') ?? '';
173:   if (!res.ok || type.startsWith('text/html')) {
174:     throw new Error(
175:       `Data file not found: ${url} (HTTP ${res.status}, ${type || 'no content-type'})`
176:     );
177:   }
178: 
179:   return new Uint8Array(await res.arrayBuffer());
180: }
181: 
182: /**
183:  * One asset's bytes: the sidecar when this build has one and the browser can
184:  * unpack it, the file itself otherwise. Every caller that reads a data file
185:  * goes through here.
186:  *
187:  * `fromSidecar` says where the bytes came from, for a reader that can check
188:  * them: it should report the failure and read the plain file rather than pass
189:  * a bad payload on (`loadContainerBytes` in `modelLoader.ts`).
190:  */
191: export async function fetchAsset(
192:   url: string
193: ): Promise<{ bytes: Uint8Array; fromSidecar: boolean }> {
194:   const packed = await fromSidecar(url);
195: 
196:   return packed
197:     ? { bytes: packed, fromSidecar: true }
198:     : { bytes: await plainBytes(url), fromSidecar: false };
199: }
200: 
201: export async function fetchAssetBytes(url: string): Promise<Uint8Array> {
202:   return (await fetchAsset(url)).bytes;
203: }
204: 
205: /**
206:  * Warm the HTTP cache for an asset without reading it. Warms whichever of the
207:  * two URLs `fetchAssetBytes` would ask for, so the later read is a cache hit
208:  * rather than a second download; a prefetch never starts the probe itself.
209:  */
210: export async function prefetchAsset(url: string): Promise<void> {
211:   const sidecar =
212:     CAN_UNPACK && enabled && isCompressedAsset(url) && !!answered && (await answered) && enabled;
213: 
214:   await fetch(sidecar ? url + COMPRESSED_SUFFIX : url).then(
215:     res => res.body?.cancel(),
216:     () => {}
217:   );
218: }
</file>

<file path="src/common/deathVisuals.ts">
  1: import type { Scene, Vector3 } from '../libs/babylon/exports';
  2: import { effects } from '../effects';
  3: import type { RGB } from '../effects/core';
  4: import { BOMB_SPARKS, EXPLOSION_CELLS, FIRE_PUFF, MODEL, SMOKE, TEX } from '../effects/recipes';
  5: import type { Sounds } from '../libs/soundsManager';
  6: 
  7: /**
  8:  * What a character breaks into when it dies - the effects-layer consumer for
  9:  * the special deaths of `SetPlayerDie` (ZzzCharacter.cpp:1372-1420) and
 10:  * `CreateBlood` (ZzzEffectBlurSpark.cpp:445-450). `deathSystem.ts` asks
 11:  * `shatterDeathFor(monsterModelType)` when the Die clip would start; a row
 12:  * means the body vanishes at once (`o->Live = false`) and the pieces fly
 13:  * instead of the corpse fading and sinking.
 14:  *
 15:  * Keyed by the *monster model type* (`MONSTER_MODEL_*`, `MODEL_MONSTER01 +
 16:  * type` in `OpenMonsterModel`, ZzzOpenData.cpp:2313), which
 17:  * `monsterModelTypeOf(npcType)` reads from `MONSTER_MODEL_TABLE`.
 18:  *
 19:  * Not here: the player transformed by a Skeleton ring (`o->SubType` in
 20:  * `MODEL_SKELETON1..3`, :1383) - the client has no transformation rings yet;
 21:  * it takes the same `boneShatter` when it does.
 22:  */
 23: 
 24: export interface ShatterDeath {
 25:   /** Spawn the pieces at the body origin with the body's `Light`. */
 26:   spawn(scene: Scene, at: Vector3, light: RGB): void;
 27:   /** `PlayBuffer(SOUND_BONE2, o)`; the Ice Monster is silent. */
 28:   sound?: Sounds;
 29: }
 30: 
 31: /** `SOUND_BONE2`: mBone2.wav, the bone rattle every shatter plays. */
 32: const BONE_SOUND: Sounds = 'Sound/mBone2';
 33: 
 34: /** MONSTER_MODEL_ICE_MONSTER / STONE_GOLEM / DEATH_COW (_enum.h:4162, :4172, :4177). */
 35: const MONSTER_MODEL_ICE_MONSTER = 15;
 36: const MONSTER_MODEL_STONE_GOLEM = 25;
 37: const MONSTER_MODEL_DEATH_COW = 30;
 38: 
 39: /** Death Cow (:1397-1405): one MODEL_BONE1 skull from 150 cm up, ten MODEL_BONE2 from 100 cm. */
 40: export const boneShatter: ShatterDeath = {
 41:   spawn(scene, at, light) {
 42:     effects.spawn('debris', scene, at, { model: MODEL.bone, count: 1, colour: light, liftCm: 150 });
 43:     effects.spawn('debris', scene, at, { model: MODEL.bone2, count: 10, colour: light, liftCm: 100 });
 44:   },
 45:   sound: BONE_SOUND,
 46: };
 47: 
 48: /**
 49:  * Stone Golem (:1407-1416): 8 × MODEL_BIG_STONE1 + 8 × MODEL_BIG_STONE2, each
 50:  * started in a ±64 cm × 0…180 cm box (ZzzEffect.cpp:2817-2821).
 51:  */
 52: const BIG_STONE_SCATTER_CM = [64, 64, 180] as const;
 53: const stoneShatter: ShatterDeath = {
 54:   spawn(scene, at, light) {
 55:     const scatterCm = BIG_STONE_SCATTER_CM;
 56:     effects.spawn('debris', scene, at, { model: MODEL.bigStone, count: 8, colour: light, scatterCm });
 57:     effects.spawn('debris', scene, at, { model: MODEL.bigStone2, count: 8, colour: light, scatterCm });
 58:   },
 59:   sound: BONE_SOUND,
 60: };
 61: 
 62: /**
 63:  * Ice Monster (`CreateBlood`, ZzzEffectBlurSpark.cpp:445-450): instead of the
 64:  * two blood splats, ten MODEL_ICE_SMALL shards from 50 cm up, each trailing
 65:  * BITMAP_SMOKE (ZzzEffect.cpp:11017-11018).
 66:  */
 67: const iceShatter: ShatterDeath = {
 68:   spawn(scene, at, light) {
 69:     effects.spawn('debris', scene, at, {
 70:       model: MODEL.ice2,
 71:       count: 10,
 72:       colour: light,
 73:       liftCm: 50,
 74:       puff: SMOKE,
 75:     });
 76:   },
 77: };
 78: 
 79: /** `o->SubType` in MODEL_SKELETON1..3 (:1383-1390): the player-rig skeleton monsters
 80:  *  (`common/monsters/skeletonWarrior.ts`) take the same bone shatter. */
 81: export const skeletonShatter: ShatterDeath = boneShatter;
 82: 
 83: const SPECIAL_DEATHS: Readonly<Record<number, ShatterDeath>> = {
 84:   [MONSTER_MODEL_DEATH_COW]: boneShatter,
 85:   [MONSTER_MODEL_STONE_GOLEM]: stoneShatter,
 86:   [MONSTER_MODEL_ICE_MONSTER]: iceShatter,
 87: };
 88: 
 89: /** The shatter this monster model dies with, or undefined for the Die clip. */
 90: export function shatterDeathFor(monsterModelType: number): ShatterDeath | undefined {
 91:   return SPECIAL_DEATHS[monsterModelType];
 92: }
 93: 
 94: /**
 95:  * Small stone chips (MODEL_STONE1/2, `SubType 0`) with their fire puffs
 96:  * (ZzzEffect.cpp:11019-11022) - what a breaking prop or a stone skill throws.
 97:  * Exposed for the next consumer; no death uses it.
 98:  */
 99: export function spawnStoneChips(scene: Scene, at: Vector3, count: number, light: RGB): void {
100:   effects.spawn('debris', scene, at, { model: MODEL.stone, count: Math.ceil(count / 2), colour: light, puff: FIRE_PUFF });
101:   effects.spawn('debris', scene, at, { model: MODEL.stone2, count: Math.floor(count / 2), colour: light, puff: FIRE_PUFF });
102: }
103: 
104: /** `CreateBomb(pos, true)` (ZzzEffect.cpp:6394-6466, SubType 0): 20 sparks + one grey explosion card. */
105: const BOMB_SPARK_COUNT = 20;
106: const BOMB_LIGHT: RGB = [0.7, 0.7, 0.7];
107: /** BITMAP_EXPLOTION at its default 20-tick life and Scale 1: `Width = 256 cm`, its 10 cells played once. */
108: const BOMB_CARD_TILES = 2.56;
109: const BOMB_CARD_SECONDS = 0.8;
110: 
111: export function spawnBomb(scene: Scene, at: Vector3): void {
112:   effects.spawn('particles', scene, at, { recipe: BOMB_SPARKS, count: BOMB_SPARK_COUNT });
113:   effects.spawn('sprite', scene, at, {
114:     texture: TEX.explosion,
115:     colour: BOMB_LIGHT,
116:     size: BOMB_CARD_TILES,
117:     seconds: BOMB_CARD_SECONDS,
118:     cells: EXPLOSION_CELLS,
119:   });
120: }
</file>

<file path="src/common/debugMenu.ts">
  1: import { makeAutoObservable, runInAction } from 'mobx';
  2: 
  3: /**
  4:  * The debug menu registry (documentation/debug_menu/ARCHITECTURE.md).
  5:  *
  6:  * One window, one registry: features register a `DebugModule` here and the
  7:  * window (`ui/components/debugMenu/`) renders whatever is registered - it
  8:  * knows no module by name. Modules describe their content as data (rows of
  9:  * checks, sliders, buttons, lists and live info lines) carrying getters and
 10:  * setters as closures; the registry stores nothing beyond `open` and the
 11:  * module list, and imports nothing but MobX, so a gameplay system can
 12:  * register a panel without pulling UI code.
 13:  *
 14:  * The menu is an offline-only tool: it is mounted by `WorldPage` behind
 15:  * `Store.isOffline` and every mutation a module performs must go through a
 16:  * seam that already has a public owner (a `requestWarp` event, a
 17:  * `setGameOption`, a `/time` command) - the menu itself owns no game state.
 18:  */
 19: 
 20: /** One clickable entry: a chip in a `buttons` row or a row in a `list`. */
 21: export type DebugAction = {
 22:   id: string;
 23:   label: string;
 24:   /** Drawn highlighted while true (the frozen phase, the current map). */
 25:   active?: () => boolean;
 26:   onClick: () => void;
 27: };
 28: 
 29: export type DebugRow =
 30:   | {
 31:       kind: 'check';
 32:       id: string;
 33:       label: string;
 34:       get: () => boolean;
 35:       set: (value: boolean) => void;
 36:     }
 37:   | {
 38:       kind: 'slider';
 39:       id: string;
 40:       label: string;
 41:       min?: number;
 42:       max: number;
 43:       step?: number;
 44:       get: () => number;
 45:       set: (value: number) => void;
 46:       /** What the value plate prints; the raw number when omitted. */
 47:       display?: (value: number) => string;
 48:     }
 49:   | { kind: 'buttons'; id: string; items: readonly DebugAction[] }
 50:   | { kind: 'list'; id: string; items: () => readonly DebugAction[] }
 51:   | { kind: 'info'; id: string; label: string; value: () => string }
 52:   | { kind: 'section'; id: string; label: string };
 53: 
 54: export type DebugModule = {
 55:   /** Unique kebab-case; also the tab's key. */
 56:   id: string;
 57:   /** The tab label. */
 58:   title: string;
 59:   /** Tabs sort ascending; the built-ins use 10..40. Default 100. */
 60:   order?: number;
 61:   /** The tab's rows, rebuilt per render - read live state in the closures. */
 62:   rows: () => readonly DebugRow[];
 63: };
 64: 
 65: class DebugMenuState {
 66:   open = false;
 67: 
 68:   modules: DebugModule[] = [];
 69: 
 70:   constructor() {
 71:     makeAutoObservable(this);
 72:   }
 73: 
 74:   toggle(): void {
 75:     this.open = !this.open;
 76:   }
 77: 
 78:   close(): void {
 79:     this.open = false;
 80:   }
 81: 
 82:   register(module: DebugModule): () => void {
 83:     if (this.modules.some(m => m.id === module.id)) {
 84:       console.error(`debugMenu: module '${module.id}' is already registered`);
 85:       return () => {};
 86:     }
 87: 
 88:     this.modules.push(module);
 89:     this.modules.sort((a, b) => (a.order ?? 100) - (b.order ?? 100));
 90: 
 91:     // Not a class method, so not an action by itself.
 92:     return () =>
 93:       runInAction(() => {
 94:         const i = this.modules.indexOf(module);
 95:         if (i >= 0) this.modules.splice(i, 1);
 96:       });
 97:   }
 98: }
 99: 
100: export const DebugMenu = new DebugMenuState();
101: 
102: /** Add a tab to the debug menu. Returns the unregister. */
103: export function registerDebugModule(module: DebugModule): () => void {
104:   return DebugMenu.register(module);
105: }
</file>

<file path="src/common/deserializeAppearance.ts">
  1: import { CharacterClassNumber } from './types';
  2: import { GetByteValue } from './utils';
  3: 
  4: type Item = {
  5:   num: number;
  6:   group: number;
  7:   lvl: number;
  8:   isExcellent?: boolean;
  9:   isAncient?: boolean;
 10:   /** The Fenrir colour bits, mirrored from `c->Helper.ExcellentFlags`. */
 11:   excellentFlags?: number;
 12: };
 13: 
 14: const APPEARANCE_LENGTH = 18;
 15: 
 16: /**
 17:  * Equipment slot order of the 18-byte preview's level field - the inventory's
 18:  * own numbering (`InventoryConstants`), which `SetItemLevels` walks 0..6.
 19:  */
 20: const LEVEL_SLOTS = [
 21:   'leftHand',
 22:   'rightHand',
 23:   'helm',
 24:   'armor',
 25:   'pants',
 26:   'gloves',
 27:   'boots',
 28: ] as const;
 29: 
 30: /**
 31:  * The per-slot bit each armor piece owns in the three flag bytes: byte 9 is
 32:  * bit 4 of its item number, byte 10 says excellent, byte 11 says ancient.
 33:  */
 34: const HELM_MASK = 0x80;
 35: const ARMOR_MASK = 0x40;
 36: const PANTS_MASK = 0x20;
 37: const GLOVES_MASK = 0x10;
 38: const BOOTS_MASK = 0x08;
 39: 
 40: export function isAppearanceBlank(app: DataView): boolean {
 41:   for (let i = 0; i < app.byteLength; i++) {
 42:     if (app.getUint8(i) !== 0) return false;
 43:   }
 44: 
 45:   return true;
 46: }
 47: 
 48: export function emptyAppearance(cls: CharacterClassNumber): DataView {
 49:   const bytes = new Uint8Array(APPEARANCE_LENGTH);
 50: 
 51:   bytes[0] = (cls << 3) & 0xf8;
 52:   // Both hands empty: index 0xFF and group nibble 0xF (`SetHand`).
 53:   bytes[1] = 0xff;
 54:   bytes[2] = 0xff;
 55:   // Every armor index nibble set to 0xF, plus the five byte-9 bits, is what
 56:   // `SetEmptyArmor` writes for an unequipped piece.
 57:   bytes[3] = 0xff;
 58:   bytes[4] = 0xff;
 59:   // Boots nibble empty; the low two bits are the pet slot, and `AddPet` marks
 60:   // "no pet" with 0b11 - leaving them at 0 would read back as a Guardian Angel.
 61:   bytes[5] = 0xf3;
 62:   bytes[9] = HELM_MASK | ARMOR_MASK | PANTS_MASK | GLOVES_MASK | BOOTS_MASK;
 63:   bytes[12] = 0xf0;
 64:   bytes[13] = 0xff;
 65:   bytes[14] = 0xff;
 66:   bytes[15] = 0xff;
 67: 
 68:   return new DataView(bytes.buffer);
 69: }
 70: 
 71: export function withAppearanceClass(
 72:   app: DataView,
 73:   cls: CharacterClassNumber
 74: ): DataView {
 75:   const bytes = new Uint8Array(app.byteLength);
 76: 
 77:   for (let i = 0; i < app.byteLength; i++) bytes[i] = app.getUint8(i);
 78: 
 79:   bytes[0] = ((cls << 3) & 0xf8) | (bytes[0] & 0x07);
 80: 
 81:   return new DataView(bytes.buffer);
 82: }
 83: 
 84: export function classFromAppearance(app: DataView): CharacterClassNumber {
 85:   return ClassFromAppearance(GetByteValue(app.getUint8(0), 5, 3));
 86: }
 87: 
 88: /**
 89:  * The classic 18-byte preview ("CharSet") every Season 6 client is sent for a
 90:  * player in scope - the exact inverse of OpenMU's `AppearanceSerializer`:
 91:  *
 92:  *   0      class (bits 3-7) + pose (bits 0-2)
 93:  *   1, 2   left / right hand item number, 0xFF = empty
 94:  *   3, 4   helm / armor and pants / gloves index nibbles
 95:  *   5      boots index nibble (high) + wing level (0x0C) + pet (0x03)
 96:  *   6-8    seven 3-bit glow levels, slot 0 in the low bits of byte 8
 97:  *   9      armor index bit 4 per slot (high 5 bits) + wing id (low 3 bits)
 98:  *   10     excellent per armor slot (high 5 bits) + Dinorant (bit 0)
 99:  *   11     ancient per armor slot (high 5 bits) + full ancient set (bit 0)
100:  *   12, 13 left / right hand group (bits 5-7); byte 12 bit 0/2 = horse/Fenrir
101:  *   13-15  armor index bits 5-8, one nibble per slot
102:  *   16     transform pet flags (high 3 bits) + black/blue Fenrir (bits 0/1)
103:  *   17     small-wing flags (high 3 bits) + gold Fenrir (bit 0)
104:  *
105:  * Everything the wearer's own gear can show - level glow, excellent and
106:  * ancient passes, wings, the pet - is in here; reading only the item numbers
107:  * is what left other players' effects and wings off in the first place.
108:  */
109: export function deserializeAppearance(app: DataView) {
110:   const cls = classFromAppearance(app);
111:   const levels = itemLevels(app);
112: 
113:   const leftHandIndex = app.getUint8(1);
114:   const rightHandIndex = app.getUint8(2);
115: 
116:   const leftHandGroup = GetByteValue(app.getUint8(12), 3, 5);
117:   const rightHandGroup = GetByteValue(app.getUint8(13), 3, 5);
118: 
119:   // Hands carry no excellent / ancient bit in this layout - only the five
120:   // armor slots do - so a remote weapon shows its level glow and nothing more.
121:   const leftHand: Item | null =
122:     leftHandIndex === 0xff && leftHandGroup === 0x07
123:       ? null
124:       : { num: leftHandIndex, group: leftHandGroup, lvl: levels.leftHand };
125: 
126:   const rightHand: Item | null =
127:     rightHandIndex === 0xff && rightHandGroup === 0x07
128:       ? null
129:       : { num: rightHandIndex, group: rightHandGroup, lvl: levels.rightHand };
130: 
131:   const helm = GetArmorPiece(app, 7, 3, true, HELM_MASK, 13, false, levels.helm);
132:   const armor = GetArmorPiece(app, 8, 3, false, ARMOR_MASK, 14, true, levels.armor);
133:   const pants = GetArmorPiece(app, 9, 4, true, PANTS_MASK, 14, false, levels.pants);
134:   const gloves = GetArmorPiece(app, 10, 4, false, GLOVES_MASK, 15, true, levels.gloves);
135:   const boots = GetArmorPiece(app, 11, 5, true, BOOTS_MASK, 15, false, levels.boots);
136: 
137:   return {
138:     cls,
139:     leftHand,
140:     rightHand,
141:     helm,
142:     armor,
143:     pants,
144:     gloves,
145:     boots,
146:     wings: wingFromAppearance(app),
147:     pet: petFromAppearance(app),
148:   } as const;
149: }
150: 
151: /**
152:  * Appearance layout of the "extended" protocol (OpenMU
153:  * AppearanceSerializerExtended, client version >= 106.3): byte 0 = class
154:  * number, byte 1 = pose/flags, then 3-byte "shiny" items (left hand, right
155:  * hand, helm, armor, pants, gloves, boots) and 2-byte wings / pet.
156:  * Item: group = high nibble of byte 0, number = low nibble << 8 | byte 1,
157:  * glow level = high nibble of byte 2, excellent = bit 3, ancient = bit 2.
158:  * Empty slot: group 0xF.
159:  */
160: export function deserializeAppearanceExtended(app: DataView) {
161:   const cls = ClassFromAppearance(app.getUint8(0));
162: 
163:   const shiny = (
164:     at: number
165:   ): (Item & { isExcellent: boolean; isAncient: boolean }) | null => {
166:     if (app.byteLength < at + 3) return null;
167:     const b0 = app.getUint8(at);
168:     const group = (b0 >> 4) & 0xf;
169:     if (group === 0xf) return null;
170:     const num = ((b0 & 0xf) << 8) | app.getUint8(at + 1);
171:     const b2 = app.getUint8(at + 2);
172:     return {
173:       num,
174:       group,
175:       lvl: (b2 >> 4) & 0xf,
176:       isExcellent: (b2 & 0x08) !== 0,
177:       isAncient: (b2 & 0x04) !== 0,
178:     };
179:   };
180:   const unshiny = (at: number): Item | null => {
181:     if (app.byteLength < at + 2) return null;
182:     const b0 = app.getUint8(at);
183:     const group = (b0 >> 4) & 0xf;
184:     if (group === 0xf) return null;
185:     return { num: ((b0 & 0xf) << 8) | app.getUint8(at + 1), group, lvl: 0 };
186:   };
187: 
188:   return {
189:     cls,
190:     leftHand: shiny(2),
191:     rightHand: shiny(5),
192:     helm: shiny(8),
193:     armor: shiny(11),
194:     pants: shiny(14),
195:     gloves: shiny(17),
196:     boots: shiny(20),
197:     wings: unshiny(23),
198:     pet: unshiny(25),
199:   } as const;
200: }
201: 
202: /** Bytes the extended appearance occupies in AddCharacterToScopeExtended. */
203: export const APPEARANCE_EXTENDED_LENGTH = 27;
204: 
205: const KNOWN_CLASSES: ReadonlySet<number> = new Set(
206:   Object.values(CharacterClassNumber).filter(v => typeof v === 'number')
207: );
208: 
209: function ClassFromAppearance(raw: number): CharacterClassNumber {
210:   return KNOWN_CLASSES.has(raw)
211:     ? (raw as CharacterClassNumber)
212:     : CharacterClassNumber.DarkWizard;
213: }
214: 
215: /**
216:  * The seven glow levels packed into bytes 6-8, three bits each, back as item
217:  * levels.
218:  *
219:  * The wire carries `(level - 1) / 2` (`ItemExtensions.GetGlowLevel`), so a
220:  * level cannot be recovered exactly: glow *g* was worn as +2g+1 or +2g+2. The
221:  * odd one is the answer, because every threshold the renderer steps on - +7
222:  * sheen, +9 aura, +11 sparks, +13 light - is odd, so the tier always comes
223:  * out right and only the shade between two levels of one tier is lost. That
224:  * loss is the protocol's, not ours: the original client cannot tell either.
225:  */
226: function itemLevels(app: DataView): Record<(typeof LEVEL_SLOTS)[number], number> {
227:   const packed =
228:     (app.getUint8(6) << 16) | (app.getUint8(7) << 8) | app.getUint8(8);
229: 
230:   const out = {} as Record<(typeof LEVEL_SLOTS)[number], number>;
231: 
232:   LEVEL_SLOTS.forEach((slot, i) => {
233:     out[slot] = itemLevelFromGlow((packed >> (i * 3)) & 0x07);
234:   });
235: 
236:   return out;
237: }
238: 
239: /**
240:  * One glow level back to the item level to render it at - see `itemLevels`
241:  * for why the odd one is the right answer. Shared with the `AppearanceChanged`
242:  * (0x25) path, whose byte 1 carries the same glow level in its low nibble.
243:  */
244: export function itemLevelFromGlow(glow: number): number {
245:   return glow > 0 ? glow * 2 + 1 : 0;
246: }
247: 
248: /**
249:  * The wing slot, from the three bits `AddWing` spends on it: byte 5 carries
250:  * the wing's *level* (1st / 2nd / 3rd) and byte 9 which of that level it is.
251:  * Together they name one item; neither half means anything alone.
252:  */
253: function wingFromAppearance(app: DataView): Item | null {
254:   const level = app.getUint8(5) & 0x0c;
255:   if (level === 0) return null;
256: 
257:   const id = app.getUint8(9) & 0x07;
258:   const num = WING_NUMBERS[level]?.[id];
259: 
260:   // 3rd-level bits with no id: one of the "small" wings (WingIndex 130-135),
261:   // which byte 17 distinguishes. Season 6 has no model for any of them, and
262:   // neither do the 4th-level Cape of Fighter / Cape of Overrule (id 7).
263:   if (num === undefined) return null;
264: 
265:   // Cape of Lord is the one wing that lives in the helper group (13) - the
266:   // preview has no room for a group, so the table names it.
267:   return { num, group: num === CAPE_OF_LORD ? 13 : 12, lvl: 0 };
268: }
269: 
270: const CAPE_OF_LORD = 30;
271: 
272: /** `AddWing`'s two switches, read backwards: byte 5 level → byte 9 id → item. */
273: const WING_NUMBERS: Record<number, Record<number, number | undefined>> = {
274:   // 1st level.
275:   0x04: { 1: 0, 2: 1, 3: 2, 4: 41 },
276:   // 2nd level. 7 = Cape of Fighter (49), post-S6.
277:   0x08: { 1: 3, 2: 4, 3: 5, 4: 6, 5: CAPE_OF_LORD, 6: 42 },
278:   // 3rd level. 7 = Cape of Overrule (50), post-S6.
279:   0x0c: { 1: 36, 2: 37, 3: 38, 4: 39, 5: 40, 6: 43 },
280: };
281: 
282: /**
283:  * The pet slot (`AddPet`). The low two bits of byte 5 hold the three pets that
284:  * fit there; 0b11 means "one of the rest", and the rest are single bits spread
285:  * over bytes 10 and 12. A Dark Raven is written as plain 0b11 with no flag, so
286:  * it is indistinguishable from an empty slot here - the original client has
287:  * the same blind spot.
288:  *
289:  * Byte 16's transform pets (Demon, Spirit of Guardian, Skeleton, Rudolph, Pet
290:  * Unicorn, Panda) are left alone: none of them has a model in `pets.ts`, so
291:  * naming them would only produce an item the renderer drops again.
292:  */
293: function petFromAppearance(app: DataView): Item | null {
294:   const bits = app.getUint8(5) & 0x03;
295: 
296:   // 0 Guardian Angel, 1 Imp, 2 Horn of Uniria.
297:   if (bits !== 0x03) return { num: bits, group: 13, lvl: 0 };
298: 
299:   // Fenrir first: it clears the Dinorant and Dark Horse bits as it sets its
300:   // own. Its colour rides bytes 16/17 (the client reads Equipment[15] & 3 and
301:   // Equipment[16] & 1, ZzzCharacter.cpp:12455-12500) and is carried as the
302:   // item's excellent flags, exactly like `c->Helper.ExcellentFlags`.
303:   if (app.getUint8(12) & 0x04) {
304:     const flags =
305:       app.getUint8(17) & 0x01 ? 0x04 : app.getUint8(16) & 0x03;
306:     return { num: 37, group: 13, lvl: 0, excellentFlags: flags };
307:   }
308:   if (app.getUint8(12) & 0x01) return { num: 4, group: 13, lvl: 0 };
309:   if (app.getUint8(10) & 0x01) return { num: 3, group: 13, lvl: 0 };
310: 
311:   return null;
312: }
313: 
314: /**
315:  * One of the five armor slots. `SetArmorItemIndex` splits the item number
316:  * three ways - bits 0-3 into a nibble of `firstIndex`, bit 4 into the slot's
317:  * byte-9 bit, bits 5-8 into a nibble of `thirdIndex` - and an unequipped slot
318:  * is every one of those bits set (`SetEmptyArmor`).
319:  */
320: function GetArmorPiece(
321:   app: DataView,
322:   group: number,
323:   firstIndex: number,
324:   firstIndexHigh: boolean,
325:   slotMask: number,
326:   thirdIndex: number,
327:   thirdIndexHigh: boolean,
328:   lvl: number
329: ): Item | null {
330:   const high = GetByteValue(app.getUint8(thirdIndex), 4, thirdIndexHigh ? 4 : 0);
331: 
332:   // `SetEmptyArmor` fills the top nibble with ones; no real item reaches it
333:   // (it would need number >= 480, and the S6 tables stop at 53).
334:   if (high === 0x0f) return null;
335: 
336:   const num =
337:     GetByteValue(app.getUint8(firstIndex), 4, firstIndexHigh ? 4 : 0) |
338:     (((app.getUint8(9) & slotMask) === slotMask ? 1 : 0) << 4) |
339:     (high << 5);
340: 
341:   return {
342:     num,
343:     group,
344:     lvl,
345:     isExcellent: (app.getUint8(10) & slotMask) === slotMask,
346:     isAncient: (app.getUint8(11) & slotMask) === slotMask,
347:   };
348: }
</file>

<file path="src/common/devSeams.ts">
 1: /**
 2:  * Dev-only URL seams (lighting_polish ARCHITECTURE §5). Every reader returns
 3:  * null outside the dev build, so a seam can never reach production.
 4:  */
 5: export function devQuery(key: string): string | null {
 6:   if (!import.meta.env.DEV) return null;
 7: 
 8:   try {
 9:     return new URLSearchParams(location.search).get(key);
10:   } catch {
11:     return null;
12:   }
13: }
14: 
15: export function devQueryNumber(key: string): number | null {
16:   const raw = devQuery(key);
17:   const n = raw === null ? NaN : Number(raw);
18: 
19:   return Number.isFinite(n) ? n : null;
20: }
21: 
22: /**
23:  * `?hp=` / `?mp=`: stage the hero's health or mana at a percentage on the
24:  * offline route, so a warning state can be looked at without being hit.
25:  */
26: export function devVitalPercent(key: 'hp' | 'mp'): number | null {
27:   const percent = devQueryNumber(key);
28:   if (percent === null) return null;
29: 
30:   return Math.max(0, Math.min(100, percent));
31: }
32: 
33: /** A comma-separated list of exactly `count` numbers, or null. */
34: export function devQueryNumbers(key: string, count: number): number[] | null {
35:   const raw = devQuery(key);
36:   if (!raw) return null;
37: 
38:   const parts = raw.split(',').map(Number);
39: 
40:   return parts.length === count && parts.every(Number.isFinite) ? parts : null;
41: }
</file>

