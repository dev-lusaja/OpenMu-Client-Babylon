377:         bone.Name = _readString(dv, DataPtr, DataPtr + 32);
378:         DataPtr += 32;
379:         bone.Parent = dv.getInt16(DataPtr, true);
380:         DataPtr += 2;
381: 
382:         bone.Matrixes = new Array(actions.length).fill(null);
383: 
384:         for (let m = 0; m < bone.Matrixes.length; m++) {
385:           const action = actions[m];
386:           const bm = (bone.Matrixes[m] = new BMDBoneMatrix());
387: 
388:           Size = action.NumAnimationKeys * 12;
389: 
390:           bm.Position = new Array(action.NumAnimationKeys).fill(null);
391: 
392:           bm.Position.forEach((_, i) => {
393:             let offset = DataPtr + i * 12;
394:             const x = dv.getFloat32(offset, true);
395:             offset += 4;
396:             const y = dv.getFloat32(offset, true);
397:             offset += 4;
398:             const z = dv.getFloat32(offset, true);
399:             offset += 4;
400: 
401:             bm.Position[i] = new Vector3(x, y, z);
402:           });
403: 
404:           DataPtr += Size;
405: 
406:           bm.Rotation = new Array(action.NumAnimationKeys).fill(null);
407: 
408:           bm.Rotation.forEach((_, i) => {
409:             let offset = DataPtr + i * 12;
410:             const x = dv.getFloat32(offset, true);
411:             offset += 4;
412:             const y = dv.getFloat32(offset, true);
413:             offset += 4;
414:             const z = dv.getFloat32(offset, true);
415:             offset += 4;
416: 
417:             bm.Rotation[i] = new Vector3(x, y, z);
418:           });
419: 
420:           DataPtr += Size;
421: 
422:           // precalculate quaternion
423:           bm.Quaternion = bm.Rotation.map(r => MathUtils.AngleQuaternion(r));
424:         }
