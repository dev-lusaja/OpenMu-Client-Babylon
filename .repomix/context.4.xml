  1: import { reaction } from 'mobx';
  2: import { t } from '../i18n';
  3: import { Store } from '../store';
  4: import {
  5:   itemSquares,
  6:   planLayout,
  7:   squareFits,
  8:   stampSquares,
  9:   type Square,
 10: } from './inventoryLayout';
 11: import {
 12:   gridFirstIndex,
 13:   StorageKind,
 14:   storageColumns,
 15:   storageRows,
 16: } from './itemStorage';
 17: 
 18: /**
 19:  * Auto-arrange for the inventory grid: pack every loose item into the
 20:  * top-left, kind by kind, so a hunt's worth of drops stops looking like a
 21:  * shotgun blast. The layout itself is `inventoryLayout.ts`; this is the run.
 22:  *
 23:  * The server owns the grid, so this cannot be a local reshuffle: every step
 24:  * is the same `ItemMoveRequest` a drag would send, and only one may be in
 25:  * flight (`Store.pendingItemMove`). So the run is a small state machine -
 26:  * plan the layout, move one item per answered move, re-plan from what is
 27:  * actually on the grid - and it stops the moment the player picks something
 28:  * up, a move is rolled back, or the grid is packed.
 29:  *
 30:  * Two items can want each other's square (A sits on B's target and B on
 31:  * A's). Nothing can move then, so one of them is parked on a free square at
 32:  * the far end of the grid, which breaks the cycle at the cost of one extra
 33:  * move.
 34:  */
 35: 
 36: /** Ceiling on the moves one run may send; a full grid needs far fewer. */
 37: const MAX_MOVES = 120;
 38: 
 39: /** How many times a run may park a blocker to break a cycle. */
 40: const MAX_PARKS = 6;
 41: 
 42: type Grid = {
 43:   columns: number;
 44:   rows: number;
 45:   first: number;
 46:   squares: Square[];
 47: };
 48: 
 49: function read(storage: StorageKind): Grid {
 50:   const items = Store.itemsOfStorage(storage);
 51:   const columns = storageColumns(storage);
 52:   const rows = storageRows(storage);
 53:   const first = gridFirstIndex(storage);
 54:   const squares: Square[] = [];
 55: 
 56:   for (let square = 0; square < columns * rows; square++) {
 57:     const item = items[first + square];
 58:     if (!item) continue;
 59:     squares.push({ slot: first + square, item, ...itemSquares(item) });
 60:   }
 61: 
 62:   return { columns, rows, first, squares };
 63: }
 64: 
 65: /** Occupancy of the live grid, with `ignore`'s own squares left free. */
 66: function occupancy(grid: Grid, ignore: number): Uint8Array {
 67:   const used = new Uint8Array(grid.columns * grid.rows);
 68:   for (const entry of grid.squares) {
 69:     if (entry.slot === ignore) continue;
 70:     stampSquares(used, grid.columns, grid.rows, entry.slot - grid.first, entry.w, entry.h);
 71:   }
 72:   return used;
 73: }
 74: 
 75: export const InventorySort = new (class _InventorySort {
 76:   private storage: StorageKind = StorageKind.Inventory;
 77:   private running = false;
 78:   private moves = 0;
 79:   private parks = 0;
 80:   private stop: (() => void) | null = null;
 81: 
 82:   get active(): boolean {
 83:     return this.running;
 84:   }
 85: 
 86:   /**
 87:    * Arrange `storage`. A second call while a run is going stops it (the key
 88:    * is a toggle), because a half-finished run is still a valid grid.
 89:    */
 90:   start(storage: StorageKind = StorageKind.Inventory): void {
 91:     if (this.running) {
 92:       this.cancel();
 93:       return;
 94:     }
 95:     if (Store.pickedItem || Store.pendingItemMove) return;
 96: 
 97:     this.storage = storage;
 98:     this.running = true;
 99:     this.moves = 0;
100:     this.parks = 0;
101: 
102:     // Each answered move (`confirmItemMove` / `rollbackItemMove` clear the
103:     // pending record) releases the next one.
104:     this.stop = reaction(
105:       () => Store.pendingItemMove === null,
106:       idle => {
107:         if (idle) this.step();
108:       }
109:     );
110: 
111:     this.step();
112:   }
113: 
114:   cancel(): void {
115:     this.finish();
116:   }
117: 
118:   private finish(done = false): void {
119:     this.stop?.();
120:     this.stop = null;
121:     this.running = false;
122:     if (done && this.moves > 0) Store.addNotification(t('notify.inventorySorted'));
123:   }
124: 
125:   private step(): void {
126:     if (!this.running) return;
127: 
128:     // The player took over: their drag owns the grid, not this run.
129:     if (Store.pickedItem || Store.pendingItemMove) return;
130:     if (this.moves >= MAX_MOVES) {
131:       this.finish(true);
132:       return;
133:     }
134: 
135:     // Planned afresh every step: after a move (or a park) the grid is a
136:     // different grid, and a plan keyed by the old slots would be stale.
137:     const grid = read(this.storage);
138:     const targets = planLayout(grid.squares, grid.columns, grid.rows, grid.first);
139: 
140:     const move = this.nextMove(grid, targets) ?? this.parkMove(grid, targets);
141:     if (!move) {
142:       this.finish(true);
143:       return;
144:     }
145: 
146:     this.moves++;
147:     if (!Store.moveItemToSquare(this.storage, move.from, move.to)) {
148:       this.finish(true);
149:       return;
150:     }
151:     // Offline there is no answer to wait for, so drive the next step here.
152:     if (Store.isOffline) this.step();
153:   }
154: 
155:   /** The next item that can go straight to its planned square. */
156:   private nextMove(grid: Grid, targets: Map<number, number>): { from: number; to: number } | null {
157:     for (const entry of grid.squares) {
158:       const to = targets.get(entry.slot);
159:       if (to === undefined || to === entry.slot) continue;
160: 
161:       const used = occupancy(grid, entry.slot);
162:       if (!squareFits(used, grid.columns, grid.rows, to - grid.first, entry.w, entry.h)) {
163:         continue;
164:       }
165: 
166:       return { from: entry.slot, to };
167:     }
168: 
169:     return null;
170:   }
171: 
172:   /**
173:    * Nothing can reach its target: two items are sitting on each other's
174:    * square. Move the first blocked one to a free square at the far end of
175:    * the grid, which unblocks the rest and is tidied by the next steps.
176:    */
177:   private parkMove(grid: Grid, targets: Map<number, number>): { from: number; to: number } | null {
178:     if (this.parks >= MAX_PARKS) return null;
179: 
180:     for (const entry of grid.squares) {
181:       const to = targets.get(entry.slot);
182:       if (to === undefined || to === entry.slot) continue;
183: 
184:       const used = occupancy(grid, entry.slot);
185:       for (let square = grid.columns * grid.rows - 1; square >= 0; square--) {
186:         if (grid.first + square === entry.slot) continue;
187:         if (!squareFits(used, grid.columns, grid.rows, square, entry.w, entry.h)) continue;
188: 
189:         this.parks++;
190:         return { from: entry.slot, to: grid.first + square };
191:       }
192:     }
193: 
194:     return null;
195:   }
196: })();
</file>

