  1: /**
  2:  * The game master command catalogue, as data.
  3:  *
  4:  * Every entry is a command OpenMU already implements in
  5:  * `GameLogic/PlugIns/ChatCommands`. The panel builds a `/line` from an entry
  6:  * and sends it as ordinary chat, exactly as if it had been typed - there is no
  7:  * other way to run one, and no way for the panel to run something the server
  8:  * would refuse from the chat box.
  9:  *
 10:  * Parameter order and required flags are the ones the server's argument
 11:  * classes declare, because it parses positionally when no `name=value` pair is
 12:  * present (`CommandExtensions.TryParseArgumentsAsync`). The `set*` commands
 13:  * take the **value first and the character second**, which is the opposite of
 14:  * what their name suggests.
 15:  *
 16:  * All of these need `CharacterStatus.GameMaster` except `/openware`, `/npc`
 17:  * and `/clearinv`, which any player may run but which do more for a game
 18:  * master: the warehouse opens anywhere, any NPC store opens by id, and the
 19:  * inventory cleared can be someone else's, for free.
 20:  *
 21:  * Everything a person reads is a `TextKey`, resolved where it is drawn - the
 22:  * table is module scope, and a `t()` here would freeze at whatever language
 23:  * was current when the module first loaded. The slash names themselves are the
 24:  * server's and are never translated.
 25:  *
 26:  * The shape mirrors the server's own `AvailableChatCommand` message (command,
 27:  * name, description, and per-parameter name / type / required / valid values),
 28:  * so once the client declares itself as OpenMU 106.3 this table can be replaced
 29:  * by the list the server sends for the logged-in character without the panel
 30:  * changing. See `todo/client_version_106_3_migration.md`.
 31:  */
 32: 
 33: import { t, type TextKey } from '../i18n';
 34: 
 35: export type GmParamType = 'text' | 'number' | 'boolean';
 36: 
 37: export type GmParam = {
 38:   /** Matches the property on the server's argument class. */
 39:   name: string;
 40:   /** What to show above the input. */
 41:   labelKey: TextKey;
 42:   type: GmParamType;
 43:   required: boolean;
 44:   /** Offered as a chip row instead of a free input when present. */
 45:   validValues?: readonly string[];
 46:   /** Greyed hint inside an empty input. */
 47:   hintKey?: TextKey;
 48:   /** Takes the rest of the line, spaces and all. Only ever the last one. */
 49:   rest?: boolean;
 50: };
 51: 
 52: export type GmCommand = {
 53:   /** With the leading slash, as the server's plugin `Key` spells it. */
 54:   command: string;
 55:   labelKey: TextKey;
 56:   helpKey: TextKey;
 57:   params?: readonly GmParam[];
 58:   /**
 59:    * Takes someone's access or progress away, or speaks to the whole server.
 60:    * The panel asks once before sending, because none of these can be undone
 61:    * by pressing the button again.
 62:    */
 63:   confirm?: boolean;
 64: };
 65: 
 66: export type GmGroup = {
 67:   id: string;
 68:   titleKey: TextKey;
 69:   commands: readonly GmCommand[];
 70: };
 71: 
 72: const characterParam = (required: boolean): GmParam => ({
 73:   name: 'characterName',
 74:   labelKey: 'gm.param.character',
 75:   type: 'text',
 76:   required,
 77:   hintKey: required ? 'gm.hint.name' : 'gm.hint.blankIsYou',
 78: });
 79: 
 80: const COORDS: readonly GmParam[] = [
 81:   { name: 'x', labelKey: 'gm.param.x', type: 'number', required: true },
 82:   { name: 'y', labelKey: 'gm.param.y', type: 'number', required: true },
 83: ];
 84: 
 85: /** `/set<thing> <value> [character]` - the value comes first, always. */
 86: const setter = (
 87:   command: string,
 88:   labelKey: TextKey,
 89:   helpKey: TextKey,
 90:   valueName: string,
 91:   valueLabelKey: TextKey
 92: ): GmCommand => ({
 93:   command,
 94:   labelKey,
 95:   helpKey,
 96:   params: [
 97:     { name: valueName, labelKey: valueLabelKey, type: 'number', required: true },
 98:     characterParam(false),
 99:   ],
100:   confirm: true,
101: });
102: 
103: const getter = (command: string, labelKey: TextKey, helpKey: TextKey): GmCommand => ({
104:   command,
105:   labelKey,
106:   helpKey,
107:   params: [characterParam(false)],
108: });
