<file path="src/common/band/bandState.ts">
 1: import { instrumentById, type InstrumentId } from '../instruments';
 2: 
 3: /**
 4:  * Who voices which channel of a performance. The master voices every
 5:  * channel of their song; a member doubles it on their own instrument, from
 6:  * where they stand, on the channels in their mask (Space Station 14's
 7:  * band: one file, every instrument in the band plays it). Channel 9 (MIDI
 8:  * 10, percussion) is only ever voiced by an instrument whose row says so -
 9:  * none does yet, so it is silent.
10:  *
11:  * Pure data; the same shape travels in the `bandState` frame.
12:  */
13: 
14: export const PERCUSSION_CHANNEL = 9;
15: 
16: export type BandMember = {
17:   netId: number;
18:   instrument: InstrumentId;
19:   /** Bit `c` set: this member voices channel `c`. */
20:   channelMask: number;
21: };
22: 
23: export type BandState = {
24:   masterId: number;
25:   members: BandMember[];
26: };
27: 
28: /** A mask over all sixteen channels. */
29: export const ALL_CHANNELS = 0xffff;
30: 
31: export function hasChannel(mask: number, channel: number): boolean {
32:   return (mask & (1 << channel)) !== 0;
33: }
34: 
35: /** Bits of every channel some member has taken. */
36: export function takenChannels(state: BandState): number {
37:   let mask = 0;
38:   for (const m of state.members) mask |= m.channelMask;
39:   return mask & ALL_CHANNELS;
40: }
41: 
42: /** Everyone who voices `channel`: the master first, then each member whose mask has it. */
43: export function ownersOf(state: BandState, channel: number): number[] {
44:   const owners = [state.masterId];
45:   for (const m of state.members) if (hasChannel(m.channelMask, channel)) owners.push(m.netId);
46:   return owners;
47: }
48: 
49: /** The mask the master voices: all of it, a band takes nothing away from them. */
50: export function masterMask(_state: BandState): number {
51:   return ALL_CHANNELS;
52: }
53: 
54: /** Whether an instrument may voice a channel at all. */
55: export function canRender(instrument: InstrumentId, channel: number): boolean {
56:   if (channel !== PERCUSSION_CHANNEL) return true;
57:   return instrumentById(instrument).percussion === true;
58: }
59: 
60: export function memberOf(state: BandState, netId: number): BandMember | null {
61:   return state.members.find(m => m.netId === netId) ?? null;
62: }
63: 
64: /** A copy with `member` added or replaced. */
65: export function withMember(state: BandState, member: BandMember): BandState {
66:   return {
67:     masterId: state.masterId,
68:     members: [...state.members.filter(m => m.netId !== member.netId), member],
69:   };
70: }
71: 
72: export function withoutMember(state: BandState, netId: number): BandState {
73:   return { masterId: state.masterId, members: state.members.filter(m => m.netId !== netId) };
74: }
</file>

<file path="src/common/bandProtocol.ts">
  1: /**
  2:  * The band system's wire format: `C1 len FA sub ...`, both ways.
  3:  *
  4:  * Client -> proxy frames go through `Store.sendToGS`, which Xor32s bytes 3..
  5:  * like every other C1; the proxy decrypts a copy, validates, and relays.
  6:  * Proxy -> client frames are plain (a C1 never touches the SimpleModulus
  7:  * counter) and carry the performer's object id at bytes 4-5, stamped by the
  8:  * proxy from the socket's own session - a client cannot claim to be someone
  9:  * else. A relayed batch is the client's batch with those two bytes inserted
 10:  * (`stampPerformer`), never re-encoded.
 11:  *
 12:  * Engine-free: the proxy, the client and the tests all import this. Nothing
 13:  * here knows an instrument by name - the id is the registry index.
 14:  */
 15: 
 16: export const BAND_CODE = 0xfa;
 17: export const BAND_VERSION = 1;
 18: 
 19: export const BandSub = {
 20:   Hello: 0x00,
 21:   Start: 0x01,
 22:   Stop: 0x02,
 23:   Batch: 0x03,
 24:   Join: 0x04,
 25:   Leave: 0x05,
 26:   BandState: 0x06,
 27:   ChannelNames: 0x07,
 28:   Refused: 0x08,
 29: } as const;
 30: 
 31: export const StopReason = {
 32:   Ended: 0,
 33:   Flood: 1,
 34:   Order: 2,
 35:   Gone: 3,
 36: } as const;
 37: export type StopReasonCode = (typeof StopReason)[keyof typeof StopReason];
 38: 
 39: export const RefuseCause = {
 40:   Cooldown: 1,
 41:   Busy: 2,
 42:   Full: 3,
 43:   Range: 4,
 44:   Map: 5,
 45:   NotPerforming: 6,
 46:   Rate: 7,
 47: } as const;
 48: export type RefuseCauseCode = (typeof RefuseCause)[keyof typeof RefuseCause];
 49: 
 50: /** What the refusal was about: `what` in a refused frame. */
 51: export const RefuseWhat = { Start: 1, Join: 2 } as const;
 52: 
 53: /**
 54:  * The limits both ends agree on. The client sender keeps under them; the
 55:  * proxy enforces them (SS14: 1000 events/s, 60 per batch, stop after 1
 56:  * dropped or 8 lagged batches).
 57:  */
 58: export const BAND_LIMITS = {
 59:   maxEventsPerBatch: 48,
 60:   /** What the proxy allows per second; the client sends at most 10. */
 61:   maxBatchesPerSecond: 12,
 62:   clientBatchesPerSecond: 10,
 63:   maxEventsPerSecond: 1000,
 64:   maxBytesPerSecond: 4096,
 65:   maxDroppedBatches: 1,
 66:   maxLaggedBatches: 8,
 67:   /** Milliseconds a batch may be behind the proxy's clock before it counts as lagged. */
 68:   lagToleranceMs: 1000,
 69:   maxStrikes: 8,
 70:   strikeWindowMs: 10_000,
 71:   cooldownAfterStopMs: 10_000,
 72:   cooldownAfterEndMs: 1_000,
 73:   maxPerformers: 16,
 74:   maxPerformersPerMap: 6,
 75:   maxBandMembers: 7,
 76:   joinRangeTiles: 10,
 77:   joinIntervalMs: 2_000,
 78:   maxReceivers: 48,
 79:   maxChannelNamesBytes: 207,
 80:   /** Milliseconds between a performer's receiver-set refreshes. */
 81:   receiversTtlMs: 250,
 82: } as const;
 83: 
 84: export type BandMidiEvent = {
 85:   /** Milliseconds after the batch's `baseMs`, 0..1000. */
 86:   dt: number;
 87:   /** 0x80..0xEF: a channel message with the channel in the low nibble. */
 88:   status: number;
 89:   d1: number;
 90:   d2: number;
 91: };
 92: 
 93: export type BandMember = { id: number; instrument: number; mask: number };
 94: 
 95: export type BandClientMessage =
 96:   | { sub: typeof BandSub.Start; version: number; instrument: number }
 97:   | { sub: typeof BandSub.Stop }
 98:   | { sub: typeof BandSub.Batch; seq: number; baseMs: number; events: BandMidiEvent[] }
 99:   | { sub: typeof BandSub.Join; masterId: number; instrument: number; mask: number }
100:   | { sub: typeof BandSub.Leave }
101:   | { sub: typeof BandSub.BandState; masterMask: number; members: BandMember[] }
102:   | { sub: typeof BandSub.ChannelNames; names: { channel: number; name: string }[] };
103: 
104: export type BandRelayMessage =
105:   | { sub: typeof BandSub.Hello; performerId: number; version: number }
106:   | { sub: typeof BandSub.Start; performerId: number; version: number; instrument: number }
107:   | { sub: typeof BandSub.Stop; performerId: number; reason: number; arg: number }
108:   | { sub: typeof BandSub.Batch; performerId: number; seq: number; baseMs: number; events: BandMidiEvent[] }
109:   | { sub: typeof BandSub.Join; performerId: number; masterId: number; instrument: number; mask: number }
110:   | { sub: typeof BandSub.Leave; performerId: number }
111:   | { sub: typeof BandSub.BandState; performerId: number; masterMask: number; members: BandMember[] }
112:   | { sub: typeof BandSub.ChannelNames; performerId: number; names: { channel: number; name: string }[] }
113:   | { sub: typeof BandSub.Refused; performerId: number; what: number; cause: number; arg: number };
114: 
115: // ---- writing ---------------------------------------------------------------
116: 
117: class Writer {
118:   private readonly bytes: number[] = [];
119: 
120:   constructor(sub: number) {
121:     this.bytes.push(0xc1, 0, BAND_CODE, sub);
122:   }
123: 
124:   u8(v: number): this {
125:     this.bytes.push(v & 0xff);
126:     return this;
127:   }
128: 
129:   u16(v: number): this {
130:     this.bytes.push((v >>> 8) & 0xff, v & 0xff);
131:     return this;
132:   }
133: 
134:   u32(v: number): this {
135:     this.bytes.push((v >>> 24) & 0xff, (v >>> 16) & 0xff, (v >>> 8) & 0xff, v & 0xff);
136:     return this;
137:   }
138: 
139:   raw(bytes: ArrayLike<number>): this {
140:     for (let i = 0; i < bytes.length; i++) this.bytes.push(bytes[i] & 0xff);
141:     return this;
142:   }
143: 
144:   finish(): Uint8Array {
145:     if (this.bytes.length > 255) throw new Error(`band frame of ${this.bytes.length} bytes does not fit a C1`);
146:     this.bytes[1] = this.bytes.length;
147:     return new Uint8Array(this.bytes);
148:   }
149: }
150: 
151: export function encodeStart(instrument: number): Uint8Array {
152:   return new Writer(BandSub.Start).u8(BAND_VERSION).u8(instrument).finish();
153: }
154: 
155: export function encodeStop(): Uint8Array {
156:   return new Writer(BandSub.Stop).finish();
157: }
158: 
159: /** Throws over `maxEventsPerBatch`: the sender splits before it gets here. */
160: export function encodeBatch(seq: number, baseMs: number, events: readonly BandMidiEvent[]): Uint8Array {
161:   if (events.length === 0 || events.length > BAND_LIMITS.maxEventsPerBatch) {
162:     throw new Error(`a batch carries 1..${BAND_LIMITS.maxEventsPerBatch} events, not ${events.length}`);
163:   }
164:   const w = new Writer(BandSub.Batch).u16(seq).u32(baseMs).u8(events.length);
165:   for (const e of events) w.u16(Math.min(1000, Math.max(0, e.dt))).u8(e.status).u8(e.d1 & 0x7f).u8(e.d2 & 0x7f);
166:   return w.finish();
167: }
168: 
169: export function encodeJoin(masterId: number, instrument: number, mask: number): Uint8Array {
170:   return new Writer(BandSub.Join).u16(masterId).u8(instrument).u16(mask).finish();
171: }
172: 
173: export function encodeLeave(): Uint8Array {
174:   return new Writer(BandSub.Leave).finish();
175: }
176: 
177: export function encodeBandState(masterMask: number, members: readonly BandMember[]): Uint8Array {
178:   if (members.length > BAND_LIMITS.maxBandMembers) throw new Error(`a band holds at most ${BAND_LIMITS.maxBandMembers} members`);
179:   const w = new Writer(BandSub.BandState).u16(masterMask).u8(members.length);
180:   for (const m of members) w.u16(m.id).u8(m.instrument).u16(m.mask);
181:   return w.finish();
182: }
183: 
184: /** Names longer than the frame allows are cut; a name is a label, not data. */
185: export function encodeChannelNames(names: readonly { channel: number; name: string }[]): Uint8Array {
186:   const encoder = new TextEncoder();
187:   const w = new Writer(BandSub.ChannelNames);
188:   const rows = names.slice(0, 16);
189:   w.u8(rows.length);
190:   let budget = BAND_LIMITS.maxChannelNamesBytes - 1;
191:   for (const row of rows) {
192:     let bytes = encoder.encode(row.name);
193:     if (bytes.length > 24) bytes = bytes.subarray(0, 24);
194:     if (budget - 2 - bytes.length < 0) bytes = new Uint8Array(0);
195:     w.u8(row.channel & 0x0f).u8(bytes.length).raw(bytes);
196:     budget -= 2 + bytes.length;
197:   }
198:   return w.finish();
199: }
200: 
201: // ---- proxy-originated frames ------------------------------------------------
202: 
203: function relayWriter(sub: number, performerId: number): Writer {
204:   return new Writer(sub).u16(performerId);
205: }
206: 
207: export function encodeHello(): Uint8Array {
208:   return relayWriter(BandSub.Hello, 0).u8(BAND_VERSION).finish();
209: }
210: 
211: export function encodeStopNotice(performerId: number, reason: number, arg = 0): Uint8Array {
212:   return relayWriter(BandSub.Stop, performerId).u8(reason).u8(arg).finish();
213: }
214: 
215: export function encodeRefused(selfId: number, what: number, cause: number, arg = 0): Uint8Array {
216:   return relayWriter(BandSub.Refused, selfId).u8(what).u8(cause).u8(arg).finish();
217: }
218: 
219: export function encodeLeaveNotice(memberId: number): Uint8Array {
220:   return relayWriter(BandSub.Leave, memberId).finish();
221: }
222: 
223: /** A relay frame from a client's (decrypted) frame: the performer id goes in after the sub. */
224: export function stampPerformer(plain: Uint8Array, performerId: number): Uint8Array {
225:   const out = new Uint8Array(plain.length + 2);
226:   out[0] = 0xc1;
227:   out[1] = plain.length + 2;
228:   out[2] = BAND_CODE;
229:   out[3] = plain[3];
230:   out[4] = (performerId >>> 8) & 0xff;
231:   out[5] = performerId & 0xff;
232:   out.set(plain.subarray(4), 6);
233:   return out;
234: }
235: 
236: // ---- reading ---------------------------------------------------------------
237: 
238: class Reader {
239:   pos: number;
240: 
241:   constructor(private readonly bytes: Uint8Array, start: number) {
242:     this.pos = start;
243:   }
244: 
245:   get left(): number {
246:     return this.bytes.length - this.pos;
247:   }
248: 
249:   u8(): number {
250:     return this.bytes[this.pos++];
251:   }
252: 
253:   u16(): number {
254:     const v = (this.bytes[this.pos] << 8) | this.bytes[this.pos + 1];
255:     this.pos += 2;
256:     return v;
257:   }
258: 
259:   u32(): number {
260:     const v =
261:       ((this.bytes[this.pos] << 24) |
262:         (this.bytes[this.pos + 1] << 16) |
263:         (this.bytes[this.pos + 2] << 8) |
264:         this.bytes[this.pos + 3]) >>>
265:       0;
266:     this.pos += 4;
267:     return v;
268:   }
269: 
270:   raw(n: number): Uint8Array {
271:     const v = this.bytes.subarray(this.pos, this.pos + n);
272:     this.pos += n;
273:     return v;
274:   }
275: }
276: 
277: function frameOk(bytes: Uint8Array): boolean {
278:   return bytes.length >= 4 && bytes.length <= 255 && bytes[0] === 0xc1 && bytes[1] === bytes.length && bytes[2] === BAND_CODE;
279: }
280: 
281: function readEvents(r: Reader): BandMidiEvent[] | null {
282:   if (r.left < 1) return null;
283:   const count = r.u8();
284:   if (count < 1 || count > BAND_LIMITS.maxEventsPerBatch || r.left !== count * 5) return null;
285:   const events: BandMidiEvent[] = [];
286:   for (let i = 0; i < count; i++) {
287:     const dt = r.u16();
288:     const status = r.u8();
289:     const d1 = r.u8();
290:     const d2 = r.u8();
291:     if (dt > 1000 || status < 0x80 || status > 0xef || d1 > 0x7f || d2 > 0x7f) return null;
292:     events.push({ dt, status, d1, d2 });
293:   }
294:   return events;
295: }
296: 
297: function readMembers(r: Reader): BandMember[] | null {
298:   if (r.left < 1) return null;
299:   const count = r.u8();
300:   if (count > BAND_LIMITS.maxBandMembers || r.left !== count * 5) return null;
301:   const members: BandMember[] = [];
302:   for (let i = 0; i < count; i++) members.push({ id: r.u16(), instrument: r.u8(), mask: r.u16() });
303:   return members;
304: }
305: 
306: function readNames(r: Reader): { channel: number; name: string }[] | null {
307:   if (r.left < 1) return null;
308:   const count = r.u8();
309:   if (count > 16) return null;
310:   const decoder = new TextDecoder();
311:   const names: { channel: number; name: string }[] = [];
312:   for (let i = 0; i < count; i++) {
313:     if (r.left < 2) return null;
314:     const channel = r.u8();
315:     const n = r.u8();
316:     if (channel > 15 || r.left < n) return null;
317:     names.push({ channel, name: decoder.decode(r.raw(n)) });
318:   }
319:   return r.left === 0 ? names : null;
320: }
321: 
322: /** A client frame after Xor32 decryption. Null for anything the proxy should drop. */
323: export function decodeClientFrame(bytes: Uint8Array): BandClientMessage | null {
324:   if (!frameOk(bytes)) return null;
325:   const sub = bytes[3];
326:   const r = new Reader(bytes, 4);
327: 
328:   switch (sub) {
329:     case BandSub.Start:
330:       if (r.left !== 2) return null;
331:       return { sub, version: r.u8(), instrument: r.u8() };
332:     case BandSub.Stop:
333:       return r.left === 0 ? { sub } : null;
334:     case BandSub.Batch: {
335:       if (r.left < 7) return null;
336:       const seq = r.u16();
337:       const baseMs = r.u32();
338:       const events = readEvents(r);
339:       return events ? { sub, seq, baseMs, events } : null;
340:     }
341:     case BandSub.Join:
342:       if (r.left !== 5) return null;
343:       return { sub, masterId: r.u16(), instrument: r.u8(), mask: r.u16() };
344:     case BandSub.Leave:
345:       return r.left === 0 ? { sub } : null;
346:     case BandSub.BandState: {
347:       if (r.left < 3) return null;
348:       const masterMask = r.u16();
349:       const members = readMembers(r);
350:       return members ? { sub, masterMask, members } : null;
351:     }
352:     case BandSub.ChannelNames: {
353:       const names = readNames(r);
354:       return names ? { sub, names } : null;
355:     }
356:     default:
357:       return null;
358:   }
359: }
360: 
361: /** A frame from the proxy. Null for anything malformed. */
362: export function decodeRelayFrame(bytes: Uint8Array): BandRelayMessage | null {
363:   if (!frameOk(bytes) || bytes.length < 6) return null;
364:   const sub = bytes[3];
365:   const r = new Reader(bytes, 4);
366:   const performerId = r.u16();
367: 
368:   switch (sub) {
369:     case BandSub.Hello:
370:       return r.left === 1 ? { sub, performerId, version: r.u8() } : null;
371:     case BandSub.Start:
372:       if (r.left !== 2) return null;
373:       return { sub, performerId, version: r.u8(), instrument: r.u8() };
374:     case BandSub.Stop:
375:       if (r.left !== 2) return null;
376:       return { sub, performerId, reason: r.u8(), arg: r.u8() };
377:     case BandSub.Batch: {
378:       if (r.left < 7) return null;
379:       const seq = r.u16();
380:       const baseMs = r.u32();
381:       const events = readEvents(r);
382:       return events ? { sub, performerId, seq, baseMs, events } : null;
383:     }
384:     case BandSub.Join:
385:       if (r.left !== 5) return null;
386:       return { sub, performerId, masterId: r.u16(), instrument: r.u8(), mask: r.u16() };
387:     case BandSub.Leave:
388:       return r.left === 0 ? { sub, performerId } : null;
389:     case BandSub.BandState: {
390:       if (r.left < 3) return null;
391:       const masterMask = r.u16();
392:       const members = readMembers(r);
393:       return members ? { sub, performerId, masterMask, members } : null;
394:     }
395:     case BandSub.ChannelNames: {
396:       const names = readNames(r);
397:       return names ? { sub, performerId, names } : null;
398:     }
399:     case BandSub.Refused:
400:       if (r.left !== 3) return null;
401:       return { sub, performerId, what: r.u8(), cause: r.u8(), arg: r.u8() };
402:     default:
403:       return null;
404:   }
405: }
406: 
407: /** Whether a client message on the wire is a band frame: header, code, nothing else. */
408: export function isBandFrame(bytes: Uint8Array): boolean {
409:   return bytes.length >= 4 && bytes[0] === 0xc1 && bytes[2] === BAND_CODE;
410: }
</file>

