<file path="src/common/monstersDatabase.ts">
 1: import monsters from './monsters.json';
 2: import monsterHealth from './monsterHealth.json';
 3: import { localisedNpcName } from '../libs/mu/npcNameFile';
 4: import { t } from '../i18n';
 5: 
 6: export const MonstersDatabase = new (class _MonstersDatabase {
 7:   cache = new Map<number, (typeof monsters)[number]>();
 8: 
 9:   get(id: number) {
10:     if (this.cache.has(id)) {
11:       return this.cache.get(id);
12:     }
13: 
14:     const monster = monsters.find(m => m.Numb === id);
15:     if (monster) {
16:       this.cache.set(id, monster);
17:       return monster;
18:     }
19: 
20:     return null;
21:   }
22: })();
23: 
24: /**
25:  * What to print for a monster or NPC: the active language pack's name when it
26:  * has one (`Local/<lang>/NpcName_<Lang>.txt`), else the English name the JSON
27:  * table carries, else a placeholder. Everything that keys on a monster still
28:  * uses `MonstersDatabase.get`; this is only what the player reads.
29:  */
30: export function monsterDisplayName(type: number, fallback?: string): string {
31:   return (
32:     localisedNpcName(type) ??
33:     MonstersDatabase.get(type)?.Name ??
34:     fallback ??
35:     t('item.monsterFallback', { type })
36:   );
37: }
38: 
39: const MAX_HEALTH: Readonly<Record<string, number>> = monsterHealth;
40: 
41: /**
42:  * The monster's maximum health, or 0 when nothing knows it. The server never
43:  * puts a monster's health on the wire in this protocol, so the health bar
44:  * needs a table to measure the damage it sees against; this one is generated
45:  * from the server's own monster definitions by
46:  * [tools/buildMonsterHealth.ts](../../tools/buildMonsterHealth.ts). The
47:  * `HP` column of `monsters.json` is an older version's and is not it.
48:  */
49: export function monsterMaxHealth(type: number): number {
50:   return MAX_HEALTH[type] ?? 0;
51: }
</file>

