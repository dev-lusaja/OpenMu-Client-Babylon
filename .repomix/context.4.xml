<file path="src/common/emojiBubbles.ts">
  1: /**
  2:  * Emoji bubbles - a small status glyph a character can pop for a couple of
  3:  * seconds. Unlike the emotes in `emotes.ts` these play no animation clip and
  4:  * have no `ServerPlayerActionType`, so no packet in the protocol carries one.
  5:  *
  6:  * They travel as public chat instead. Every bubble owns a short ASCII token
  7:  * (`words`) in the spirit of the original's chat emoticons - `^^`, `T_T` and
  8:  * `-_-` all fired social actions through `CheckChatText` - and picking one in
  9:  * the radial menu sends that token as an ordinary chat line. A client that
 10:  * knows the table turns the line back into a bubble over the sender
 11:  * (`matchEmojiBubbleWord`, the ChatMessage handler in logic.ts); one that does
 12:  * not just shows `<3`, which is what a player would have typed anyway.
 13:  *
 14:  * Why chat rather than a synthesised packet like the proxy's weather: the
 15:  * bubble has to reach exactly the players who can see the sender, and the
 16:  * server's chat scope is already that set. The proxy is a per-connection byte
 17:  * pipe with no idea who stands near whom, so relaying there would mean either
 18:  * tracking every viewport or popping hearts over players on another map.
 19:  *
 20:  * Because the token *is* the message, typing `<3` pops the same bubble. The
 21:  * match is on the whole line, so ordinary chat that merely contains `??`
 22:  * is left alone.
 23:  *
 24:  * Two placements:
 25:  *
 26:  *  - `head` - floats above the head, just over where the name balloon sits.
 27:  *  - `side` - floats beside the shoulder, on whichever side currently faces
 28:  *    the camera, so it swaps across as the character turns
 29:  *    (`EmojiBubbleSystem` picks the side, `CalculateScreenPositionSystem`
 30:  *    projects it).
 31:  */
 32: 
 33: import type { TextKey } from '../i18n';
 34: 
 35: export type EmojiBubbleId =
 36:   | 'anger'
 37:   | 'love'
 38:   | 'sleep'
 39:   | 'exclaim'
 40:   | 'question'
 41:   | 'interrobang'
 42:   | 'dizzy';
 43: 
 44: export type EmojiBubblePlacement = 'head' | 'side';
 45: 
 46: export type EmojiBubbleDefinition = {
 47:   id: EmojiBubbleId;
 48:   labelKey: TextKey;
 49:   glyph: string;
 50:   placement: EmojiBubblePlacement;
 51:   /** Seconds the bubble stays up, fade included. */
 52:   duration: number;
 53:   /**
 54:    * The chat spellings that stand for this bubble, ASCII only: packet strings
 55:    * are written one byte per character (`stringToBytes`), so the glyph itself
 56:    * cannot go on the wire. The first entry is what the radial menu sends, the
 57:    * rest are alternatives a player might type. Tokens are unique across the
 58:    * table and may not open with a character the server reads as routing
 59:    * (`RESERVED_CHAT_PREFIXES`) - such a line never comes back as normal chat,
 60:    * so the bubble would show for the sender and for nobody else.
 61:    */
 62:   words: [string, ...string[]];
 63: };
 64: 
 65: const DEFAULT_DURATION = 2.6;
 66: 
 67: /**
 68:  * The first characters OpenMU reads as routing instead of speech
 69:  * (`ChatMessageAction._messagePrefixes`): party, guild, alliance, gens,
 70:  * global notification and command. A line opening with one of them is handed
 71:  * to that processor and never reaches the players around the sender - and
 72:  * `!` in particular is dropped outright below game master rank
 73:  * (`ChatMessageGlobalNotificationProcessor`). `#` is not in the list: the
 74:  * server sends it, the client only reads it (`classifyInboundChat`).
 75:  */
 76: export const RESERVED_CHAT_PREFIXES = ['~', '@', '$', '!', '/'] as const;
 77: 
 78: export const EMOJI_BUBBLES: readonly EmojiBubbleDefinition[] = [
 79:   {
 80:     id: 'anger',
 81:     labelKey: 'emoji.anger',
 82:     glyph: '💢',
 83:     placement: 'side',
 84:     duration: DEFAULT_DURATION,
 85:     words: ['>:(', 'grr'],
 86:   },
 87:   {
 88:     id: 'love',
 89:     labelKey: 'emoji.love',
 90:     glyph: '❤️',
 91:     placement: 'head',
 92:     duration: DEFAULT_DURATION,
 93:     words: ['<3'],
 94:   },
 95:   {
 96:     id: 'sleep',
 97:     labelKey: 'emoji.sleepy',
 98:     glyph: '💤',
 99:     placement: 'head',
100:     duration: DEFAULT_DURATION,
101:     words: ['zzz'],
102:   },
103:   {
104:     id: 'exclaim',
105:     labelKey: 'emoji.alert',
106:     glyph: '❗',
107:     placement: 'head',
108:     duration: DEFAULT_DURATION,
109:     // `!!` would be the obvious spelling, but `!` is reserved on the wire.
110:     words: ['(!)'],
111:   },
112:   {
113:     id: 'question',
114:     labelKey: 'emoji.question',
115:     glyph: '❓',
116:     placement: 'head',
117:     duration: DEFAULT_DURATION,
118:     words: ['??'],
119:   },
120:   {
121:     id: 'interrobang',
122:     labelKey: 'emoji.what',
123:     glyph: '⁉️',
124:     placement: 'head',
125:     duration: DEFAULT_DURATION,
126:     words: ['?!'],
127:   },
128:   {
129:     id: 'dizzy',
130:     labelKey: 'emoji.dizzy',
131:     glyph: '💫',
132:     placement: 'head',
133:     duration: DEFAULT_DURATION,
134:     words: ['x_x'],
135:   },
136: ];
137: 
138: const BY_ID = new Map<EmojiBubbleId, EmojiBubbleDefinition>(
139:   EMOJI_BUBBLES.map(bubble => [bubble.id, bubble])
140: );
141: 
142: export function emojiBubbleById(id: EmojiBubbleId): EmojiBubbleDefinition {
143:   const def = BY_ID.get(id);
144:   if (!def) throw new Error(`Unknown emoji bubble ${id}`);
145:   return def;
146: }
147: 
148: /** The token the radial menu puts on the wire for this bubble. */
149: export function emojiBubbleToken(id: EmojiBubbleId): string {
150:   return emojiBubbleById(id).words[0];
151: }
152: 
153: const BY_WORD = new Map<string, EmojiBubbleId>(
154:   EMOJI_BUBBLES.flatMap(bubble =>
155:     bubble.words.map(word => [word.toLowerCase(), bubble.id] as const)
156:   )
157: );
158: 
159: /**
160:  * The bubble a chat line stands for, or null.
161:  *
162:  * Deliberately not `CheckChatText`'s substring search: an emote fires from a
163:  * word buried in a sentence because the sentence is the point and the clip is
164:  * decoration, while a bubble *is* the message. Matching `??` anywhere would
165:  * hang a question mark over every player who ever asked something, so the
166:  * whole line has to be the token and nothing else.
167:  */
168: export function matchEmojiBubbleWord(text: string): EmojiBubbleId | null {
169:   return BY_WORD.get(text.trim().toLowerCase()) ?? null;
170: }
171: 
172: /**
173:  * Anchor heights as a fraction of the entity's name-balloon height
174:  * (`screenPosition.worldOffsetZ`, 2.5 tiles for a player). The balloon
175:  * deliberately floats clear of the head so a name never covers it, which is
176:  * too high for a bubble - these bring both placements back down onto the
177:  * character.
178:  *
179:  * Both are world-space, so the bubbles keep their distance from the body as
180:  * the camera zooms, which a fixed pixel offset would not.
181:  */
182: export const HEAD_ANCHOR_HEIGHT_RATIO = 0.82;
183: export const SIDE_ANCHOR_HEIGHT_RATIO = 0.62;
