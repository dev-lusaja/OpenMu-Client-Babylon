280: /** BandSystem: the performance ended on its side (a step, a hit, death, the request). */
281: export function performanceEnded(): void {
282:   if (Band.phase === 'idle' && Band.instrument === null) return;
283:   stopPlaying();
284:   transport.stop();
285:   membership = null;
286:   runInAction(() => {
287:     Band.instrument = null;
288:     Band.phase = 'idle';
289:     Band.windowOpen = false;
290:     Band.role = 'solo';
291:     Band.band = null;
292:   });
293: }
