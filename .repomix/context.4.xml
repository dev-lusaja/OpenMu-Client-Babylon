<file path="src/common/mapObjectLights.ts">
  1: import { TILE_CM } from './terrain/consts';
  2: import { Matrix, Vector3 } from '../libs/babylon/exports';
  3: import type { World } from '../ecs/world';
  4: import type { ModelObject } from './modelObject';
  5: import { createEffectLight, type EffectLight } from './effectLights';
  6: import {
  7:   lightEmittersFor,
  8:   lightMapObject,
  9:   type LightEmitter,
 10: } from '../lighting/mapObjectLights';
 11: import type { LightSource } from '../lighting/lightSource';
 12: import { ParticleEmitter, type Emission } from './effectParticles';
 13: 
 14: /**
 15:  * The adapter between a `ModelObject` and its rows in the lighting layer's
 16:  * map-object table (`src/lighting/mapObjectLights.ts`): resolves each row's
 17:  * offset in the object's frame, asks the entry for the light, draws the
 18:  * flare and the particles that ride along, and feeds the light's colour
 19:  * back into the particle tint and the object's own `SelfLight` - the
 20:  * original adds a burning object's light to its own body.
 21:  *
 22:  * Owns no registration: the `LightSource` handles are the entry's; this
 23:  * class only disposes them with the object.
 24:  */
 25: 
 26: 
 27: const SELF_LIGHT = 1;
 28: 
 29: const localOffset = Vector3.Zero();
 30: const rotatedOffset = Vector3.Zero();
 31: const rotation = Matrix.Identity();
 32: 
 33: export class MapObjectLights {
 34:   #sprites: EffectLight[] = [];
 35:   #emitters: ParticleEmitter[] = [];
 36:   #sources: LightSource[] = [];
 37: 
 38:   #object: ModelObject | null = null;
 39: 
 40:   emitsLight = false;
 41: 
 42:   #disposed = false;
 43: 
 44:   private constructor() {}
 45: 
 46:   static attach(world: World, object: ModelObject): MapObjectLights | null {
 47:     const emitters = lightEmittersFor(object.WorldIndex, object.Type);
 48: 
 49:     if (!emitters?.length) return null;
 50: 
 51:     const attached = new MapObjectLights();
 52: 
 53:     attached.#object = object;
 54: 
 55:     for (const emitter of emitters) {
 56:       attached.#attachOne(world, object, emitter);
 57:     }
 58: 
 59:     return attached;
 60:   }
 61: 
 62:   #attachOne(world: World, object: ModelObject, emitter: LightEmitter): void {
 63:     const node = object.node;
 64:     const objectScale = node.scaling.x;
 65:     const position = resolveEmitterPosition(object, emitter);
 66: 
 67:     const source = lightMapObject(world.scene, emitter, position);
 68: 
 69:     if (source) {
 70:       this.#sources.push(source);
 71:       this.emitsLight = true;
 72:     }
 73: 
 74:     if (emitter.sprite) {
 75:       void createEffectLight(
 76:         world.scene,
 77:         emitter.sprite,
 78:         position,
 79:         objectScale
 80:       ).then(light => {
 81:         if (!light) return;
 82: 
 83:         if (this.#disposed) light.dispose();
 84:         else this.#sprites.push(light);
 85:       });
 86:     }
 87: 
 88:     const emissions =
 89:       typeof emitter.emissions === 'function'
 90:         ? emitter.emissions(objectScale)
 91:         : emitter.emissions;
 92: 
 93:     if (emissions?.length) {
 94:       this.#emitters.push(
 95:         new ParticleEmitter(
 96:           world.scene,
 97:           tintEmissions(emissions, source),
 98:           position,
 99:           node.rotation.y,
100:           objectScale
101:         )
102:       );
103:     }
104:   }
105: 
106:   update(): void {
107:     for (const emitter of this.#emitters) emitter.update();
108: 
109:     this.#updateSelfLight();
110:   }
111: 
112:   #updateSelfLight(): void {
113:     const object = this.#object;
114: 
115:     if (!object || this.#sources.length === 0) return;
116: 
117:     let r = 0;
118:     let g = 0;
119:     let b = 0;
120: 
121:     for (const source of this.#sources) {
122:       const c = source.color;
123: 
124:       r += c.r;
125:       g += c.g;
126:       b += c.b;
127:     }
128: 
129:     object.SelfLight.set(r * SELF_LIGHT, g * SELF_LIGHT, b * SELF_LIGHT);
130:   }
131: 
132:   dispose(): void {
133:     this.#disposed = true;
134: 
135:     for (const sprite of this.#sprites) sprite.dispose();
136:     this.#sprites.length = 0;
137: 
138:     for (const source of this.#sources) source.dispose();
139:     this.#sources.length = 0;
140: 
141:     this.#emitters.length = 0;
142: 
143:     this.#object?.SelfLight.setAll(0);
144:     this.#object = null;
145:   }
146: }
147: 
148: /** Particles without their own `light` take the source's current colour. */
149: function tintEmissions(
150:   emissions: readonly Emission[],
151:   source: LightSource | null
152: ): Emission[] {
153:   if (!source) return emissions.slice();
154: 
155:   const tint: [number, number, number] = [1, 1, 1];
156: 
157:   const light = () => {
158:     const { r, g, b } = source.color;
159: 
160:     tint[0] = r;
161:     tint[1] = g;
162:     tint[2] = b;
163: 
164:     return tint;
165:   };
166: 
167:   return emissions.map(emission =>
168:     emission.light ? emission : { ...emission, light }
169:   );
170: }
171: 
172: function resolveEmitterPosition(
173:   object: ModelObject,
174:   emitter: LightEmitter
175: ): { x: number; y: number; z: number } {
176:   const node = object.node;
177:   const { x, y, z } = node.position;
178: 
179:   if (!emitter.offset) return { x, y, z };
180: 
181:   const [ox, oy, oz] = emitter.offset;
182: 
183:   localOffset.set(ox / TILE_CM, oz / TILE_CM, oy / TILE_CM);
184: 
185:   Matrix.RotationYawPitchRollToRef(
186:     node.rotation.y,
187:     node.rotation.x,
188:     node.rotation.z,
189:     rotation
190:   );
191: 
192:   Vector3.TransformCoordinatesToRef(localOffset, rotation, rotatedOffset);
193: 
194:   return {
195:     x: x + rotatedOffset.x,
196:     y: y + rotatedOffset.y,
197:     z: z + rotatedOffset.z,
198:   };
199: }
</file>

