 1: import type { Entity } from '../ecs/world';
 2: 
 3: export type DropTier = 'normal' | 'high' | 'excellent' | 'money';
 4: 
 5: /** Level from which a drop counts as "high" (gold name, ground glow). */
 6: export const HIGH_DROP_LEVEL = 7;
 7: 
 8: /** Visual tier of a dropped item: name colour + ground glow. */
 9: export function dropTier(drop: NonNullable<Entity['droppedItem']>): DropTier {
10:   if (drop.isMoney) return 'money';
11:   const item = drop.item;
12:   if (!item) return 'normal';
13:   if (item.isExcellent) return 'excellent';
14:   if ((item.lvl ?? 0) >= HIGH_DROP_LEVEL) return 'high';
15:   return 'normal';
16: }
