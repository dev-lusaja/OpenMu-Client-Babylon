 89: const defCache = new Map<string, ItemDef | null>();
 90: 
 91: function num(raw: Record<string, unknown>, ...keys: string[]): number {
 92:   for (const key of keys) {
 93:     const value = raw[key];
 94:     if (typeof value === 'number') return value;
 95:   }
 96:   return 0;
 97: }
