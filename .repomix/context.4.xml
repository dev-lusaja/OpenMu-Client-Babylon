 191: function applyPbrDetail(material: PBRCustomMaterial): void {
 192:   const strength = pbrDetailStrength();
 193: 
 194:   if (material.bumpTexture) material.bumpTexture.level = strength;
 195:   material.metallic = strength;
 196:   // The 1/pi puts the GGX highlight in key units: the sun and the pool
 197:   // carry `directLightGain` (pi) for Burley's diffuse, and the PBR fragment
 198:   // builds the specular from the same light colour, so the factor is
 199:   // cancelled here, the one place the fragment honours it.
 200:   material.specularIntensity = strength / Math.PI;
 201: 
 202:   // All three live in the Material UBO, and `bindForSubMesh` skips that
 203:   // write while the material is frozen and the buffer is in sync. Only
 204:   // `markDirty(true)` sets `_forceRebindOnNextCall`, which is the one
 205:   // condition in that guard we can reach - plain `markDirty()` assigns the
 206:   // flag its `false` default, so freeze/unfreeze around the writes looks
 207:   // like it should work and silently does not.
 208:   material.markDirty(true);
