 1: /**
 2:  * `CreateItem`'s per-level model swap (ZzzObject.cpp:6056-6116): a few wire
 3:  * items are shown on the ground as another model, picked by the item's
 4:  * level. The swap replaces `o->Type` outright in the original, so the pose
 5:  * (`ItemAngle`) follows the shown model too - a Weapon of Archangel lies
 6:  * like the staff, sword or crossbow it displays, not like a ring.
 7:  */
 8: 
 9: import { ItemGroup } from './itemAngle';
10: import { ItemsDatabase } from './itemsDatabase';
11: 
12: export type DropModelProxy = {
13:   /** The (group, num) whose ItemAngle pose the drop takes. */
14:   group: number;
15:   num: number;
16:   modelFilePath: string;
17: };
18: 
19: const WEAPON_OF_ARCHANGEL = 19;
20: const WIZARDS_RING = 20;
21: 
22: /**
23:  * Level 0 staff / 1 sword / 2 crossbow (`ITEM_WEAPON_OF_ARCHANGEL`,
24:  * ZzzObject.cpp:6066-6083), as the (group, num) of the real weapon whose
25:  * model the original points at: `MODEL_DIVINE_STAFF_OF_ARCHANGEL` is
26:  * Staff + 10, `MODEL_DIVINE_SWORD_OF_ARCHANGEL` Sword + 19,
27:  * `MODEL_DIVINE_CB_OF_ARCHANGEL` Bow + 18.
28:  */
29: const ARCHANGEL_WEAPONS: Record<number, readonly [number, number]> = {
30:   0: [ItemGroup.Staff, 10],
31:   1: [ItemGroup.Sword, 19],
32:   2: [ItemGroup.Bow, 18],
33: };
34: 
35: export function dropModelProxy(
36:   group: number,
37:   num: number,
38:   lvl: number
39: ): DropModelProxy | null {
40:   if (group !== ItemGroup.Helper) return null;
41: 
42:   if (num === WEAPON_OF_ARCHANGEL) {
43:     const [g, n] = ARCHANGEL_WEAPONS[lvl] ?? ARCHANGEL_WEAPONS[0];
44:     const item = ItemsDatabase.getItem(g, n);
45:     if (!item) return null;
46:     return { group: g, num: n, modelFilePath: item.szModelFolder + item.szModelName };
47:   }
48: 
49:   // Wizards Ring: level 0 keeps its own MagicRing row; 1-3 are the Ring of
50:   // Lord event rings, `MODEL_EVENT + 14` (ZzzObject.cpp:6103-6116), a model
51:   // that is no item row of its own. The ring pose stays.
52:   if (num === WIZARDS_RING && lvl >= 1 && lvl <= 3) {
53:     return { group, num, modelFilePath: 'Item/RingOfLordEvent00.glb' };
54:   }
55: 
56:   return null;
57: }
</file>

