 93: class Counter {
 94:   Count = 0;
 95:   Reset(): void {
 96:     this.Count = 0;
 97:   }
 98: 
 99:   /**
100:    * Wraps 255 -> 0 like OpenMU's `Counter` (Network/Counter.cs, `_maxCount`
101:    * = 255): the value travels as one byte in the first decrypted block, so an
102:    * unbounded count would disagree with the wire from the 257th C3/C4 packet
103:    * on and every later packet would be rejected.
104:    */
105:   Increase() {
106:     this.Count = this.Count === 255 ? 0 : this.Count + 1;
107:   }
108: }
