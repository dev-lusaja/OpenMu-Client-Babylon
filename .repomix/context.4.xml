 16: /**
 17:  * Ambient particle backbone: high-count, long-lived emitters -
 18:  * weather, leaves, dust - that the CPU sprite pool (effectParticles.ts) is
 19:  * the wrong tool for. Each recipe becomes one Babylon system:
 20:  *
 21:  *  - `GPUParticleSystem` when the engine can run it (WebGL2 transform
 22:  *    feedback); the simulation never touches the CPU, so a few thousand
 23:  *    raindrops cost one draw.
 24:  *  - `ParticleSystem` otherwise (WebGL1 / blocked contexts) with a smaller
 25:  *    capacity, so the same recipe still shows up, just thinner.
 26:  *
 27:  * Textures are shared through `loadEffectTexture` (one GPU texture per
 28:  * file), and every recipe positions itself through an emitter `Vector3`
 29:  * the owner moves each frame - weather follows the hero, room effects stay
 30:  * put. The original's leaves / rain / snow (ZzzEffectFireLeave.cpp) ran
 31:  * around `Hero->Object.Position`, which is the same idea.
 32:  *
 33:  * A `NoiseProceduralTexture` stands in for the original's per-tick random
 34:  * walk (`Velocity += RangeFloat(-8, 7) * 0.1`): both paths read it, so a
 35:  * leaf wanders the same way on either.
 36:  */
 37: 
 38: export type AmbientBlend = 'alpha' | 'add';
 39: 
 40: /**
 41:  * Generated sprites, for recipes whose data-file texture cannot do the job.
 42:  *
 43:  * `proc:streak` is the raindrop: a soft white vertical streak. The
 44:  * original's `rain01` is a 4x32 TGA whose RGB is ~0.1 (28,20,18) - under
 45:  * the original's `GL_ONE, GL_ONE` blend that adds a faint glint, and under
 46:  * a straight-alpha blend it draws as **dark brown rain**. Additive of a
 47:  * white streak is what a drop against a lit street actually reads as.
 48:  *
 49:  * ### The streak has to be WIDE enough to survive the frame
 50:  *
 51:  * The first cut put a Gaussian of variance 0.045 across an 8-texel sprite:
 52:  * that is a bright core about two texels wide, and the `RAIN` recipe drew it
 53:  * ~0.014 tiles across. At the game camera (radius 10, fov 0.8) a tile is
 54:  * ~130 px, so the lit part of a drop landed on **under half a pixel**. A
 55:  * sub-pixel additive streak is not dim, it is *sampled away*: the rasteriser
 56:  * covers a fraction of the pixel, the tone-mapping curve in post then pulls
 57:  * what little arrived toward the exposed mid-grey, and the rain disappears
 58:  * exactly when post-processing is on. Rain that only reads with the grade
 59:  * off is rain that does not work.
 60:  *
 61:  * So the core is broadened here and the recipe draws it wider (`scaleX`).
 62:  * Both halves are needed: widening the sprite alone just stretches the same
 63:  * two lit texels' worth of light over more pixels.
 64:  *
 65:  * `proc:bubble` is the Atlans bubble, and it is here for the same kind of
 66:  * reason: the original's `Object8/drop01.jpg` is a nine-frame flipbook packed
 67:  * into a 4x4 UV grid at cells 0,1,2,4,5,6,8,9,10
 68:  * (ZzzEffectParticle.cpp:8945), and a recipe has no cell remap to read it
 69:  * with. A drawn ring costs nothing and needs no remap.
 70:  */
 71: const procedural = new Map<string, RawTexture>();
 72: 
 73: type Pixels = {
 74:   w: number;
 75:   h: number;
 76:   data: Uint8Array;
 77:   /** Mip the sprite: for one whose detail is finer than the pixels it lands on. */
 78:   mips?: boolean;
 79: };
 80: 
 81: /** One greyscale value into RGB and A alike. */
 82: function put(data: Uint8Array, i: number, a: number): void {
 83:   const v = Math.round(255 * Math.min(1, Math.max(0, a)));
 84:   data[i] = v;
 85:   data[i + 1] = v;
 86:   data[i + 2] = v;
 87:   data[i + 3] = v;
 88: }
 89: 
 90: function streakPixels(): Pixels {
 91:   const w = 8;
 92:   const h = 32;
 93:   const data = new Uint8Array(w * h * 4);
 94: 
 95:   // Variance of the Gaussian across the streak. Was 0.045 - a two-texel core
 96:   // in an eight-texel sprite, i.e. a quarter of the drop's width carrying
 97:   // essentially all of its light. 0.13 lights about two thirds of the sprite
 98:   // and still falls to ~0.15 at the edge, so the streak has a soft edge
 99:   // rather than a hard one and there is something left to antialias.
100:   const ACROSS_VARIANCE = 0.13;
101: 
102:   for (let y = 0; y < h; y++) {
103:     for (let x = 0; x < w; x++) {
104:       // Gaussian across, tapered at both ends along.
105:       const u = (x + 0.5) / w - 0.5;
106:       const v = (y + 0.5) / h;
107:       const across = Math.exp(-(u * u) / ACROSS_VARIANCE);
108:       const along = Math.sin(v * Math.PI);
109:       put(data, (y * w + x) * 4, across * Math.sqrt(along));
110:     }
111:   }
112: 
113:   return { w, h, data };
114: }
115: 
116: /**
117:  * A bubble, in four parts, all of them lit from the upper left so that one
118:  * sprite reads as a shell of air and not as a ring:
119:  *
120:  *  - the **rim**, a thin bright silhouette where the shell turns away from
121:  *    the camera and the eye looks through the most of it;
122:  *  - the **sheen**, a gradient over the interior falling from the lit side to
123:  *    the shaded one - this is the reflection, and it is what stops the middle
124:  *    reading as a hole;
125:  *  - the **gloss**, the small hard specular where the light source is;
126:  *  - the **counter**, a soft arc inside the far rim: light that entered the
127:  *    front of the bubble and came back off the inside of the back of it.
128:  *
129:  * The rim is thin on purpose and that is what sets the rest of the numbers.
130:  * At 64 texels a band of this variance is ~2 px, and a bubble drawn 0.08-0.2
131:  * tiles across is ~7-18 px on screen, so the rim lands under a pixel - it
132:  * survives only because the texture is mipped (`mips`), which turns it into a
133:  * softer thin ring at distance instead of the sparkling dotted one an
134:  * unfiltered minification would give. The sheen carries the bubble at the
135:  * sizes where the rim has thinned out to nothing.
136:  *
137:  * Because all four parts point at one light, the sprite has a direction, and
138:  * the recipe must not spin it (no `angularSpeed` on `ATLANS_BUBBLES`): a
139:  * rotating highlight reads as a spinning marble.
140:  */
141: function bubblePixels(): Pixels {
142:   const size = 64;
143:   const data = new Uint8Array(size * size * 4);
144: 
145:   const RIM_AT = 0.88;
146:   const RIM_VARIANCE = 0.0012;
147:   const SHEEN = 0.42;
148:   /** Falloff of the sheen across the bubble; >1 keeps it a gradient, not a wash. */
149:   const SHEEN_POWER = 1.5;
150:   const GLOSS = 1;
151:   const GLOSS_AT = -0.38;
152:   const GLOSS_VARIANCE = 0.006;
153:   const COUNTER = 0.8;
154:   const COUNTER_AT = 0.72;
155:   const COUNTER_VARIANCE = 0.03;
156:   /** Outer softening as a fraction of the radius; without it the disc is a cut-out. */
157:   const EDGE = 0.07;
158: 
159:   for (let y = 0; y < size; y++) {
160:     for (let x = 0; x < size; x++) {
161:       const u = ((x + 0.5) / size - 0.5) * 2;
162:       // Row 0 draws at the BOTTOM of the sprite (the quad is built with
163:       // invertY off), so t as written here is already screen-space up: +1 at
164:       // the top. Only a sprite with a light direction cares, and this is the
165:       // one that has one.
166:       const t = ((y + 0.5) / size - 0.5) * 2;
167:       const r = Math.hypot(u, t);
168:       if (r >= 1) continue;
169: 
170:       // +1 at the lit corner (upper left), -1 at the shaded one.
171:       const lit = (t - u) / Math.SQRT2;
172: 
173:       const rim = Math.exp(-((r - RIM_AT) ** 2) / RIM_VARIANCE);
174:       const sheen = SHEEN * (0.5 + 0.5 * lit) ** SHEEN_POWER * (1 - r * r);
175:       const gloss =
176:         GLOSS *
177:         Math.exp(
178:           -((u - GLOSS_AT) ** 2 + (t + GLOSS_AT) ** 2) / GLOSS_VARIANCE
179:         );
180:       const counter =
181:         COUNTER *
182:         Math.exp(-((r - COUNTER_AT) ** 2) / COUNTER_VARIANCE) *
183:         Math.max(0, -lit) ** 2;
184: 
185:       const edge = Math.min(1, (1 - r) / EDGE);
186:       put(data, (y * size + x) * 4, (rim + sheen + gloss + counter) * edge);
187:     }
188:   }
189: 
190:   return { w: size, h: size, data, mips: true };
191: }
