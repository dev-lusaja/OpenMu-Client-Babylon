378: ): AmbientSystem {
379:   const gpu = ambientGpuSupported();
380:   const emitter = at.clone();
381: 
382:   const capacity = gpu
383:     ? recipe.capacity
384:     : Math.max(32, Math.round(recipe.capacity * CPU_CAPACITY_SCALE));
385: 
386:   const system: ParticleSystem | GPUParticleSystem = gpu
387:     ? new GPUParticleSystem(`ambient:${recipe.name}`, { capacity }, scene)
388:     : new ParticleSystem(`ambient:${recipe.name}`, capacity, scene);
389: 
390:   system.emitter = emitter;
391:   system.isLocal = false;
392:   system.blendMode =
393:     recipe.blend === 'add'
394:       ? ParticleSystem.BLENDMODE_ADD
395:       : ParticleSystem.BLENDMODE_STANDARD;
396: 
397:   const [boxMin, boxMax] = recipe.box;
398:   system.minEmitBox = boxMin;
399:   system.maxEmitBox = boxMax;
400:   system.direction1 = recipe.direction[0];
401:   system.direction2 = recipe.direction[1];
402:   system.minEmitPower = recipe.power[0];
403:   system.maxEmitPower = recipe.power[1];
404:   system.minLifeTime = recipe.life[0];
405:   system.maxLifeTime = recipe.life[1];
406:   system.minSize = recipe.size[0];
407:   system.maxSize = recipe.size[1];
408: 
409:   if (recipe.scaleX) {
410:     system.minScaleX = recipe.scaleX[0];
411:     system.maxScaleX = recipe.scaleX[1];
412:   }
413:   if (recipe.scaleY) {
414:     system.minScaleY = recipe.scaleY[0];
415:     system.maxScaleY = recipe.scaleY[1];
416:   }
417: 
418:   system.gravity = recipe.gravity ?? Vector3.Zero();
419: 
420:   if (recipe.angularSpeed) {
421:     system.minAngularSpeed = recipe.angularSpeed[0];
422:     system.maxAngularSpeed = recipe.angularSpeed[1];
423:     system.minInitialRotation = 0;
424:     system.maxInitialRotation = Math.PI * 2;
425:   }
426: 
427:   const [c1, c2] = recipe.colour;
428:   system.color1 = c1;
429:   system.color2 = c2;
430:   system.colorDead = recipe.colourDead ?? new Color4(c2.r, c2.g, c2.b, 0);
431: 
432:   if (recipe.fade && recipe.fade > 0) {
433:     const f = Math.min(0.45, recipe.fade);
434:     system.addColorGradient(0, new Color4(c1.r, c1.g, c1.b, 0));
435:     system.addColorGradient(f, c1, c2);
436:     system.addColorGradient(1 - f, c1, c2);
437:     system.addColorGradient(1, new Color4(c2.r, c2.g, c2.b, 0));
438:   }
439: 
440:   if (recipe.noise) {
441:     system.noiseTexture = wanderNoise(scene);
442:     system.noiseStrength = recipe.noise;
443:   }
444: 
445:   if (recipe.stretched) {
446:     system.isBillboardBased = true;
447:     system.billboardMode = ParticleSystem.BILLBOARDMODE_STRETCHED;
448:   }
449: 
450:   /**
451:    * Rewrite the per-particle ranges for the strength the system is now at.
452:    *
453:    * Only newly emitted particles take these: every one of the four is bound
454:    * to the update shader from the live property each frame (GPU path) or read
455:    * at emission (CPU path), so a drop already falling keeps the size and
456:    * speed the sky had when it left the cloud. That is the behaviour we want
457:    * and not a compromise - a shower easing off should not shrink the drops
458:    * already in the air, it should stop making new big ones.
459:    */
460:   function applyGrowth(k: number): void {
461:     const g = recipe.growth;
462:     if (!g) return;
463: 
464:     const t = k <= 0 ? 0 : k >= 1 ? 1 : k;
465:     const size = g.size + (1 - g.size) * t;
466:     const length = g.length + (1 - g.length) * t;
467:     const speed = g.speed + (1 - g.speed) * t;
468: 
469:     system.minSize = recipe.size[0] * size;
470:     system.maxSize = recipe.size[1] * size;
471: 
472:     if (recipe.scaleY) {
473:       system.minScaleY = recipe.scaleY[0] * length;
474:       system.maxScaleY = recipe.scaleY[1] * length;
475:     }
476: 
477:     system.minEmitPower = recipe.power[0] * speed;
478:     system.maxEmitPower = recipe.power[1] * speed;
479: 
480:     // Life pays for the speed, so the fall distance is invariant. See the
481:     // `growth` doc on the recipe.
482:     system.minLifeTime = recipe.life[0] / speed;
483:     system.maxLifeTime = recipe.life[1] / speed;
484:   }
485: 
486:   // Rate is scaled live via setStrength; the rate itself is the 1.0 mark.
487:   // It starts at zero and climbs in `update`, so a system that has just been
488:   // created thickens up rather than arriving whole.
489:   const ramp = Math.max(0.001, recipe.ramp ?? DEFAULT_RAMP);
490:   let target = 0;
491:   let strength = 0;
492:   system.emitRate = 0;
493: 
494:   // At zero: the smallest, slowest, longest-lived particles the recipe has.
495:   // Nothing is emitted before the first `update`, but the ranges have to be
496:   // right for the first frame that does emit.
497:   applyGrowth(0);
498: 
499:   // Never into the depth buffer: these sit over everything like the sprite
500:   // pool does, and the GPU path cannot sort against the scene anyway.
501:   system.forceDepthWrite = false;
502: 
503:   let disposed = false;
504: 
505:   if (recipe.texture.startsWith('proc:')) {
506:     system.particleTexture = proceduralTexture(scene, recipe.texture);
507:   } else {
508:     void loadEffectTexture(scene, recipe.texture).then(texture => {
509:       if (!disposed) system.particleTexture = texture;
510:     });
511:   }
512: 
513:   system.start();
514: 
515:   const clip = recipe.skyBorne ? clipToRoom(scene, system) : null;
516: 
517:   return {
518:     emitter,
519:     system,
520:     gpu,
521:     ramp,
522:     maxLife() {
523:       return system.maxLifeTime;
524:     },
525:     setStrength(k: number) {
526:       target = Math.max(0, k);
527:     },
528:     update(dt: number) {
529:       clip?.refresh();
530:       if (strength === target) return;
531:       // Rate-limited rather than exponential: an exponential tail never quite
532:       // reaches zero, so a draining system would dribble particles forever
533:       // instead of going quiet.
534:       const step = dt / ramp;
535:       strength =
536:         strength < target
537:           ? Math.min(target, strength + step)
538:           : Math.max(target, strength - step);
539:       system.emitRate = recipe.rate * strength;
540:       applyGrowth(strength);
541:     },
542:     strength() {
543:       return strength;
544:     },
545:     dispose() {
546:       disposed = true;
547:       clip?.dispose();
548:       // Never the texture: the recipe file and the wander noise are shared
549:       // across every ambient system (loadEffectTexture, wanderNoise), so the
550:       // default `dispose(true)` would take the rain away with the leaves.
551:       system.dispose(false);
552:     },
553:   };
554: }
</file>

<file path="src/common/binaryUtils.ts">
 1: /**
 2:  * Byte-level helpers with no Babylon (and no DOM) dependency.
 3:  *
 4:  * These used to live in `common/utils.ts`, which imports `Scene`/`Texture`.
 5:  * Two things need them without wanting the engine:
 6:  *
 7:  *  - the terrain worker (todo C8), which reaches them via
 8:  *    `mapFileEncryption`;
 9:  *  - the generated packet modules (todo C9), which are the bulk of the app
10:  *    chunk. While they imported `common/utils`, any attempt to split them
11:  *    into their own chunk dragged 2.4 MB of Babylon along with them.
12:  *
13:  * `common/utils.ts` re-exports every name here, so existing importers are
14:  * unaffected.
15:  */
16: 
17: export function castToByte(n: number): Byte {
18:   return n & 0xff;
19: }
20: 
21: export function ArrayCopy<TArray extends Uint8Array | Uint16Array>(
22:   buffer: TArray,
23:   srcOffset: Int,
24:   dst: TArray,
25:   dstOffset: Int,
26:   count: Int
27: ): void {
28:   for (let i = 0; i < count; i++) {
29:     dst[dstOffset + i] = buffer[srcOffset + i];
30:   }
31: }
32: 
33: export function GetByteValue(byte: Byte, bits: Int, leftShifted: Int): Byte {
34:   const andMask = castToByte(Math.pow(2, bits) - 1);
35:   const numericalValue = castToByte((byte >> leftShifted) & andMask);
36: 
37:   return numericalValue;
38: }
39: 
40: export function SetByteValue(
41:   oldValue: Byte,
42:   value: Byte,
43:   bits: Int,
44:   leftShifted: Int
45: ): Byte {
46:   const bitMask = castToByte(Math.pow(2, bits) - 1) << leftShifted;
47:   const clearMask = castToByte(0xff - bitMask);
48: 
49:   oldValue &= clearMask;
50: 
51:   const numericalValue = castToByte(value); //Convert.ToByte check?
52:   oldValue |= castToByte((numericalValue << leftShifted) & bitMask);
53: 
54:   return oldValue;
55: }
56: 
57: export function GetBoolean(byte: Byte, leftShifted: Int): boolean {
58:   return ((byte >> leftShifted) & 1) === 1;
59: }
60: 
61: export function SetBoolean(
62:   oldValue: Byte,
63:   value: Boolean,
64:   leftShifted: Int
65: ): Byte {
66:   const mask = castToByte(1 << leftShifted);
67:   const clearMask = castToByte(0xff - (1 << leftShifted));
68:   oldValue &= clearMask;
69:   if (value) {
70:     oldValue |= mask;
71:   }
72: 
73:   return oldValue;
74: }
</file>

