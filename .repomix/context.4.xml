140:   GetContentSize(packet: Uint8Array, decrypted: boolean): Int {
141:     return getPacketSize(packet) - getPacketHeaderSize(packet) + (decrypted ? 1 : 0);
142:   }
143: 
144:   GetShiftSize(length: Int, shiftOffset: Int): Int {
145:     return integerDevision((length + shiftOffset - 1) / DecryptedBlockSize) + (1 - integerDevision(shiftOffset / DecryptedBlockSize));
146:   }
147: 
148:   ClearShiftBuffer(): void {
149:     this.ShiftBuffer[0] = 0;
150:     this.ShiftBuffer[1] = 0;
151:     this.ShiftBuffer[2] = 0;
152:     this.ShiftBuffer[3] = 0;
