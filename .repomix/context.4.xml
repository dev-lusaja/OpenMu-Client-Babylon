448: /** The first `POSE_TABLE` row this item matches, or null. */
449: function tablePose(group: number, num: number): RestPose | null {
450:   for (const rule of POSE_TABLE) {
451:     if (rule.group !== group) continue;
452:     const from = rule.from ?? rule.num ?? -1;
453:     const to = rule.to ?? rule.num ?? -1;
454:     if (num < from || num > to) continue;
455: 
456:     const [pitch, roll, yaw] = DEFAULT_POSE.angle;
457:     return {
458:       angle: [rule.pitch ?? pitch, rule.roll ?? roll, rule.yaw ?? yaw],
459:       scale: rule.scale,
460:     };
461:   }
462: 
463:   return null;
464: }
465: 
466: 
467: /** `itemRestPose` as entity `transform.rot` (radians, renderAngles convention). */
468: export function itemRestRotation(
469:   group: number,
470:   num: number
471: ): { x: number; y: number; z: number } {
472:   const [pitch, roll, yaw] = itemRestPose(group, num).angle;
473:   return { x: -pitch * DEG, y: yaw * DEG, z: -roll * DEG };
474: }
475: 
476: /**
477:  * Height a drop settles at above the terrain, world units (`MoveItems`:6250).
478:  * Weapons sit 40 cm higher than everything else.
479:  */
480: export function itemRestHeight(group: number): number {
481:   const weapon = group >= ItemGroup.Sword && group <= ItemGroup.Staff;
482:   return (REST_ABOVE_TERRAIN_CM + (weapon ? WEAPON_EXTRA_CM : 0)) * CM;
483: }
484: 
485: /**
486:  * `ItemHeight` (ZzzObject.cpp:6274), world units: how far a worn body part has
487:  * to come down to sit on the drop's own origin. Armour drops reuse the model
488:  * the character wears (`items.json` points group 7-11 at `Player/`), so a helm
489:  * is authored up at head height and lands in the air without this.
490:  */
491: export function itemWornHeight(group: number): number {
492:   switch (group) {
493:     case ItemGroup.Helm:
494:       return -160 * CM;
495:     case ItemGroup.Armor:
496:       return -100 * CM;
497:     case ItemGroup.Gloves:
498:       return -70 * CM;
499:     case ItemGroup.Pants:
500:       return -50 * CM;
501:     default:
502:       // Boots are already at the origin, and nothing else is a body part.
503:       return 0;
504:   }
505: }
506: 
507: /**
508:  * Which `transform.rot` axis the tumble uses while the drop is in the air:
509:  * `o->Angle[1]` for shields, `o->Angle[0]` for everything else
510:  * (MoveItems:6255-6259).
511:  */
512: export function itemTumbleAxis(group: number): 'x' | 'z' {
513:   return group === ItemGroup.Shield ? 'z' : 'x';
514: }
