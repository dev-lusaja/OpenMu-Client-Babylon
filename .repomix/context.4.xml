193: function proceduralTexture(scene: Scene, key: string): RawTexture {
194:   const have = procedural.get(key);
195:   if (have && have.getScene() === scene) return have;
196: 
197:   const { w, h, data, mips } =
198:     key === 'proc:bubble' ? bubblePixels() : streakPixels();
199: 
200:   const texture = RawTexture.CreateRGBATexture(
201:     data,
202:     w,
203:     h,
204:     scene,
205:     mips === true,
206:     false,
207:     Texture.TRILINEAR_SAMPLINGMODE
208:   );
209:   texture.name = key;
210:   texture.wrapU = Texture.CLAMP_ADDRESSMODE;
211:   texture.wrapV = Texture.CLAMP_ADDRESSMODE;
212:   texture.onDisposeObservable.addOnce(() => {
213:     if (procedural.get(key) === texture) procedural.delete(key);
214:   });
215:   procedural.set(key, texture);
216: 
217:   return texture;
218: }
