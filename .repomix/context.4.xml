 71: export function guildMarkTexture(
 72:   scene: Scene,
 73:   packed: ArrayLike<number>,
 74:   name: string
 75: ): RawTexture {
 76:   const pixels = unpackGuildMark(packed);
 77:   const data = new Uint8Array(GUILD_MARK_SIZE * GUILD_MARK_SIZE * 4);
 78:   for (let i = 0; i < pixels.length; i++) {
 79:     const index = pixels[i];
 80:     const at = i * 4;
 81:     if (!index) continue;
 82:     const rgb = GUILD_MARK_PALETTE[index].match(/\d+/g);
 83:     if (!rgb) continue;
 84:     data[at] = Number(rgb[0]);
 85:     data[at + 1] = Number(rgb[1]);
 86:     data[at + 2] = Number(rgb[2]);
 87:     data[at + 3] = 255;
 88:   }
 89: 
 90:   const texture = RawTexture.CreateRGBATexture(
 91:     data,
 92:     GUILD_MARK_SIZE,
 93:     GUILD_MARK_SIZE,
 94:     scene,
 95:     false,
 96:     false,
 97:     Texture.NEAREST_SAMPLINGMODE
 98:   );
 99:   texture.name = name;
100:   texture.wrapU = Texture.CLAMP_ADDRESSMODE;
101:   texture.wrapV = Texture.CLAMP_ADDRESSMODE;
102:   texture.hasAlpha = true;
103:   return texture;
