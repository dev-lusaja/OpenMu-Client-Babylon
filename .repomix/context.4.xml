303: /**
304:  * Re-resolve every mesh on a shared item material against the current
305:  * `GameOptions.materialQuality` (Classic ⇄ PBR). The cache keeps both
306:  * variants, so flipping back is a pointer swap, not a recompile.
307:  */
308: export function syncMaterialQuality(scene: Scene): void {
309:   for (const mesh of scene.meshes) {
310:     const args = materialArgs.get(mesh.material as ItemMaterial);
311:     if (!args) continue;
312: 
313:     // Whose art this is comes off the mesh, not off `materialArgs`: on
314:     // Classic a character and a crate share one material, so the cached args
315:     // cannot tell the two apart when the tier moves to Characters.
316:     const material = getMaterial(
317:       scene,
318:       ...args,
319:       mesh.metadata?.characterAsset === true
320:     );
321:     if (mesh.material !== material) mesh.material = material;
322:   }
323: 
324:   syncTextureFiltering();
325: }
