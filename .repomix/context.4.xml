 40: /**
 41:  * The band: what the player is doing with their instrument, and what every
 42:  * performer in scope is doing with theirs. The one object the Instrument
 43:  * window, the emote wheel, `BandSystem` and the wire module talk to.
 44:  *
 45:  * Playback runs on a 100 ms timer, not the frame: the sequencer stamps notes
 46:  * on the audio clock a quarter second ahead, so a slow frame costs nothing.
 47:  * Entity work (the pose, the model) goes through `world.bandRequest` and
 48:  * `BandSystem`, like the emotes do.
 49:  *
 50:  * The wire is a `BandTransport` handed in by `band/bandNet.ts`; offline, or
 51:  * before the proxy says hello, it is the silent one below and the hero
 52:  * simply plays for themselves.
 53:  */
 54: 
 55: // ---- 1. tuning -------------------------------------------------------------
 56: 
 57: const TICK_MS = 100;
 58: 
 59: /** Seconds between the watchdog ticks over the remote streams. */
 60: const REMOTE_TICK_MS = 500;
 61: 
 62: // ---- 2. state --------------------------------------------------------------
 63: 
 64: export type BandPhase = 'idle' | 'out' | 'playing' | 'paused';
 65: export type BandRole = 'solo' | 'master' | 'member';
 66: 
 67: export type BandTransport = {
 68:   start(instrument: number): void;
 69:   stop(): void;
 70:   batch(baseMs: number, events: BatchEvent[]): void;
 71:   join(masterId: number, instrument: number, channelMask: number): void;
 72:   leave(): void;
 73:   state(masterMask: number, members: BandMember[]): void;
 74: };
 75: 
 76: const SILENT_TRANSPORT: BandTransport = {
 77:   start() {},
 78:   stop() {},
 79:   batch() {},
 80:   join() {},
 81:   leave() {},
 82:   state() {},
 83: };
 84: 
 85: let transport: BandTransport = SILENT_TRANSPORT;
 86: 
 87: /** The wire module plugs itself in here once the proxy has said hello. */
 88: export function setBandTransport(t: BandTransport | null): void {
 89:   transport = t ?? SILENT_TRANSPORT;
 90: }
