 1: import { Vector3 } from '../libs/babylon/exports';
 2: import { toRadians } from './utils';
 3: 
 4: const MU_SCALE = 100;
 5: 
 6: function fromMu(x: number, y: number, z: number): Vector3 {
 7:   return new Vector3(x / MU_SCALE, z / MU_SCALE, y / MU_SCALE);
 8: }
 9: 
10: export const CHARACTER_SLOTS = [
11:   { x: 8008, y: 18885, angle: 115 },
12:   { x: 7986, y: 19145, angle: 90 },
13:   { x: 8046, y: 19400, angle: 75 },
14:   { x: 8133, y: 19645, angle: 60 },
15:   { x: 8282, y: 19845, angle: 35 },
16: ] as const;
17: 
18: export const CHARACTER_HEIGHT = 169.5 / MU_SCALE;
19: 
20: export function characterSlotPosition(slot: number): Vector3 | null {
21:   const entry = CHARACTER_SLOTS[slot];
22:   if (!entry) return null;
23: 
24:   return fromMu(entry.x, entry.y, 169.5);
25: }
26: 
27: export function characterSlotAngle(slot: number): number {
28:   return toRadians(CHARACTER_SLOTS[slot]?.angle ?? 0);
29: }
30: 
31: export const CHARACTER_CAMERA_POSITION = fromMu(9758.93, 18913.11, 675.5);
32: 
33: const CAMERA_PITCH = -84.5;
34: const CAMERA_YAW = -75;
35: 
36: function cameraForward(): Vector3 {
37:   const pitch = toRadians(CAMERA_PITCH);
38:   const yaw = toRadians(CAMERA_YAW);
39: 
40:   const muX = -Math.sin(pitch) * Math.sin(yaw);
41:   const muY = -Math.sin(pitch) * Math.cos(yaw);
42:   const muZ = -Math.cos(pitch);
43: 
44:   return new Vector3(muX, muZ, muY).normalize();
45: }
46: 
47: export const CHARACTER_CAMERA_FORWARD = cameraForward();
48: 
49: export function characterCameraTarget(): Vector3 {
50:   const centre = Vector3.Zero();
51: 
52:   for (let slot = 0; slot < CHARACTER_SLOTS.length; slot++) {
53:     centre.addInPlace(characterSlotPosition(slot)!);
54:   }
55: 
56:   centre.scaleInPlace(1 / CHARACTER_SLOTS.length);
57: 
58:   const distance = Vector3.Dot(
59:     centre.subtract(CHARACTER_CAMERA_POSITION),
60:     CHARACTER_CAMERA_FORWARD
61:   );
62: 
63:   return CHARACTER_CAMERA_POSITION.add(
64:     CHARACTER_CAMERA_FORWARD.scale(distance)
65:   );
66: }
</file>

