 86:   [StatType.Strength]: 'stat.strength',
 87:   [StatType.Agility]: 'stat.agility',
 88:   [StatType.Vitality]: 'stat.vitality',
 89:   [StatType.Energy]: 'stat.energy',
 90:   [StatType.Leadership]: 'stat.command',
 91: };
 92: 
 93: export function getStatName(stat: StatType): string {
 94:   return t(STAT_NAME_KEYS[stat]);
 95: }
 96: 
 97: type ItemConfig = Record<string, unknown>;
 98: 
 99: function configOf(item: Item): ItemConfig | null {
100:   return ItemsDatabase.getItem(item.group, item.num) as ItemConfig | null;
101: }
102: 
103: function field(config: ItemConfig, ...names: string[]): number {
104:   for (const name of names) {
105:     const value = config[name];
106:     if (typeof value === 'number') return value;
107:   }
108:   return 0;
109: }
110: 
111: function firstSet(config: ItemConfig, ...names: string[]): number {
112:   for (const name of names) {
113:     const value = config[name];
114:     if (typeof value === 'number' && value !== 0) return value;
115:   }
116:   return 0;
117: }
118: 
119: const GROUP_MACE = 2;
120: const GROUP_BOW = 4;
121: const GROUP_STAFF = 5;
122: const GROUP_SHIELD = 6;
123: const GROUP_WING = 12;
124: const GROUP_HELPER = 13;
125: 
126: function isBow(item: Item): boolean {
127:   return item.group === GROUP_BOW && item.num <= 6;
128: }
129: 
130: function isCrossbow(item: Item): boolean {
131:   return item.group === GROUP_BOW && item.num >= 8 && item.num <= 14;
132: }
133: 
134: function isShield(item: Item): boolean {
135:   return item.group === GROUP_SHIELD;
136: }
137: 
138: function isStaff(item: Item): boolean {
139:   return item.group === GROUP_STAFF;
140: }
141: 
142: function itemDamage(item: Item): { min: number; max: number } {
143:   const config = configOf(item);
144:   if (!config) return { min: 0, max: 0 };
145: 
146:   const dropLevel = field(config, 'ItemLvl');
147:   const level = item.lvl ?? 0;
148: 
149:   const withBonuses = (base: number) => {
150:     if (base <= 0) return 0;
151: 
152:     let value = base;
153: 
154:     if (item.isExcellent && dropLevel > 0) {
155:       value += Math.trunc((base * 25) / dropLevel) + 5;
156:     }
157: 
158:     value += Math.min(9, level) * 3;
159:     if (level > 9) value += level - 6;
160: 
161:     return value;
162:   };
163: 
164:   return {
165:     min: withBonuses(field(config, 'DmgMin')),
166:     max: withBonuses(field(config, 'DmgMax')),
167:   };
168: }
169: 
170: function itemDefense(item: Item): number {
171:   const config = configOf(item);
172:   if (!config) return 0;
173: 
174:   const base = firstSet(config, 'Def', 'DefRate');
175:   if (base <= 0) return 0;
176: 
177:   const level = item.lvl ?? 0;
178:   let defense = base;
179: 
180:   if (isShield(item)) {
181:     return defense + level;
182:   }
183: 
184:   const dropLevel = field(config, 'ItemLvl');
185:   if (item.isExcellent && dropLevel > 0) {
186:     defense +=
187:       Math.trunc((base * 12) / dropLevel) + 4 + Math.trunc(dropLevel / 5);
188:   }
189: 
190:   return defense + Math.min(9, level) * defensePerLevel(item);
191: }
192: 
193: function defensePerLevel(item: Item): number {
194:   if (item.group === GROUP_WING) {
195:     if (item.num >= 3 && item.num <= 6) return 2;
196:     if (item.num === 42) return 2;
197:     if (item.num === 49 || item.num === 50) return 2;
198:     if ((item.num >= 36 && item.num <= 40) || item.num === 43) return 4;
199:   }
200: 
201:   if (item.group === GROUP_HELPER && item.num === 30) return 2;
202: 
203:   return 3;
204: }
205: 
206: function itemBlocking(item: Item): number {
207:   const config = configOf(item);
208:   if (!config) return 0;
209: 
210:   const base = field(config, 'DefRate');
211:   if (base <= 0) return 0;
212: 
213:   const dropLevel = field(config, 'ItemLvl');
214: 
215:   let blocking = base;
216:   if (item.isExcellent && dropLevel > 0) {
217:     blocking += Math.trunc((base * 25) / dropLevel) + 5;
218:   }
219: 
220:   blocking += Math.min(9, dropLevel) * 3;
221:   if (dropLevel > 9) blocking += dropLevel - 6;
222: 
223:   return blocking;
224: }
225: 
226: function itemMagicPower(item: Item): number {
227:   const config = configOf(item);
228:   if (!config) return 0;
229: 
230:   const base = field(config, 'MagicPwr');
231:   if (base <= 0) return 0;
232: 
233:   const level = item.lvl ?? 0;
234:   const dropLevel = field(config, 'ItemLvl');
235: 
236:   let power = base;
237: 
238:   if (item.isExcellent && dropLevel > 0) {
239:     power += Math.trunc((base * 25) / dropLevel) + 5;
240:   }
241: 
242:   power += Math.min(9, level) * 3;
243:   if (level > 9) power += level - 6;
244: 
245:   power = Math.trunc(power / 2);
246: 
247:   if (item.group !== GROUP_MACE) power += level * 2;
248: 
249:   return power;
250: }
251: 
252: export type CharacterStatsInput = {
253:   charClass: CharacterClassNumber;
254:   level: number;
255:   strength: number;
256:   agility: number;
257:   vitality: number;
258:   energy: number;
259:   leadership: number;
260:   items: (Item | null)[];
261: };
262: 
263: /**
264:  * Attack/magic speed per point of agility, as configured on the OpenMU
265:  * server (Persistence/Initialization/CharacterClasses/Class*.cs). Item
266:  * "+attack speed" options are not included yet (items.json has no option data).
267:  */
268: const ATTACK_SPEED_DIVISOR: Record<BaseClass, number> = {
269:   [BaseClass.Wizard]: 20,
270:   [BaseClass.Knight]: 15,
271:   [BaseClass.Elf]: 50,
272:   [BaseClass.MagicGladiator]: 15,
273:   [BaseClass.DarkLord]: 10,
274:   [BaseClass.Summoner]: 20,
275:   [BaseClass.RageFighter]: 9,
276: };
277: 
278: const MAGIC_SPEED_DIVISOR: Record<BaseClass, number> = {
279:   [BaseClass.Wizard]: 10,
280:   [BaseClass.Knight]: 20,
281:   [BaseClass.Elf]: 50,
282:   [BaseClass.MagicGladiator]: 20,
283:   [BaseClass.DarkLord]: 10,
284:   [BaseClass.Summoner]: 20,
285:   [BaseClass.RageFighter]: 9,
286: };
287: 
288: export function attackSpeedOf(cls: CharacterClassNumber, agility: number): number {
289:   return Math.trunc(agility / ATTACK_SPEED_DIVISOR[getBaseClass(cls)]);
290: }
291: 
292: export function magicSpeedOf(cls: CharacterClassNumber, agility: number): number {
293:   return Math.trunc(agility / MAGIC_SPEED_DIVISOR[getBaseClass(cls)]);
294: }
295: 
296: export type DerivedStats = {
297:   attackSpeed: number;
298:   magicSpeed: number;
299:   damageMin: number;
300:   damageMax: number;
301:   attackRate: number;
302:   attackRatePvp: number;
303:   defense: number;
304:   defenseRate: number;
305:   defenseRatePvp: number;
306:   dualWield: boolean;
307:   wizardryMin: number;
308:   wizardryMax: number;
309:   staffRate: number;
310:   curseMin: number;
311:   curseMax: number;
312: };
313: 
314: function equipped(items: (Item | null)[], slot: number): Item | null {
315:   return items[slot] ?? null;
316: }
317: 
318: function calculateDamage(
319:   input: CharacterStatsInput,
320:   base: BaseClass
321: ): { min: number; max: number; dualWield: boolean } {
322:   const { strength, agility, energy, vitality, items } = input;
323: 
324:   const weaponRight = equipped(items, InventoryConstants.LeftHandSlot);
325:   const weaponLeft = equipped(items, InventoryConstants.RightHandSlot);
326: 
327:   let statMin = 0;
328:   let statMax = 0;
329: 
330:   const usingBow =
331:     (!!weaponLeft && isBow(weaponLeft)) ||
332:     (!!weaponRight && isCrossbow(weaponRight));
333: 
334:   if (usingBow) {
335:     statMin = Math.trunc(agility / 7) + Math.trunc(strength / 14);
336:     statMax = Math.trunc(agility / 4) + Math.trunc(strength / 8);
337:   } else {
338:     switch (base) {
339:       case BaseClass.Elf:
340:       case BaseClass.Summoner:
341:         statMin = Math.trunc((strength + agility) / 7);
342:         statMax = Math.trunc((strength + agility) / 4);
343:         break;
344: 
345:       case BaseClass.Knight:
346:         statMin = Math.trunc(strength / 6);
347:         statMax = Math.trunc(strength / 4);
348:         break;
349: 
350:       case BaseClass.MagicGladiator:
351:         statMin = Math.trunc(strength / 6) + Math.trunc(energy / 12);
352:         statMax = Math.trunc(strength / 4) + Math.trunc(energy / 9);
353:         break;
354: 
355:       case BaseClass.DarkLord:
356:         statMin = Math.trunc(strength / 7) + Math.trunc(energy / 14);
357:         statMax = Math.trunc(strength / 5) + Math.trunc(energy / 10);
358:         break;
359: 
360:       case BaseClass.RageFighter:
361:         statMin = Math.trunc(strength / 7) + Math.trunc(vitality / 15);
362:         statMax = Math.trunc(strength / 5) + Math.trunc(vitality / 12);
363:         break;
364: 
365:       default:
366:         statMin = Math.trunc(strength / 8);
367:         statMax = Math.trunc(strength / 4);
368:         break;
369:     }
370:   }
371: 
372:   let minRight = statMin;
373:   let maxRight = statMax;
374:   let minLeft = statMin;
375:   let maxLeft = statMax;
376: 
377:   if (weaponRight) {
378:     const damage = itemDamage(weaponRight);
379: 
380:     if (isStaff(weaponRight)) {
381:       minLeft += damage.min;
382:       maxLeft += damage.max;
383:     } else {
384:       minRight += damage.min;
385:       maxRight += damage.max;
386:     }
387:   }
388: 
389:   if (weaponLeft) {
390:     const damage = itemDamage(weaponLeft);
391:     minLeft += damage.min;
392:     maxLeft += damage.max;
393:   }
394: 
395: let min: number;
396:   let max: number;
397: 
398:   if (!!weaponRight && isCrossbow(weaponRight)) {
399:     min = minRight;
400:     max = maxRight;
401:   } else if (!!weaponLeft && isBow(weaponLeft)) {
402:     min = minLeft;
403:     max = maxLeft;
404:   } else if (!weaponRight || isStaff(weaponRight)) {
405:     min = minLeft;
406:     max = maxLeft;
407:   } else {
408:     min = minRight;
409:     max = maxRight;
410:   }
411: 
412:   let dualWield = false;
413: 
414:   const bothHands = !!weaponRight && !!weaponLeft;
415: 
416:   if (base === BaseClass.Knight || base === BaseClass.MagicGladiator) {
417:     if (
418:       bothHands &&
419:       weaponRight!.group <= GROUP_STAFF &&
420:       weaponLeft!.group <= GROUP_STAFF
421:     ) {
422:       dualWield = true;
423:       min = Math.trunc((minRight * 55) / 100) + Math.trunc((minLeft * 55) / 100);
424:       max = Math.trunc((maxRight * 55) / 100) + Math.trunc((maxLeft * 55) / 100);
425:     }
426:   } else if (base === BaseClass.RageFighter) {
427:     if (
428:       bothHands &&
429:       weaponRight!.group <= GROUP_MACE &&
430:       weaponLeft!.group <= GROUP_MACE
431:     ) {
432:       dualWield = true;
433:       min = Math.trunc(((minRight + minLeft) * 60) / 100);
434:       max = Math.trunc(((maxRight + maxLeft) * 65) / 100);
435:     }
436:   }
437: 
438:   return { min, max, dualWield };
439: }
440: 
441: function calculateAttackRate(
442:   input: CharacterStatsInput,
443:   base: BaseClass
444: ): number {
445:   const { level, strength, agility, leadership } = input;
446: 
447:   if (base === BaseClass.DarkLord) {
448:     return (
449:       level * 5 +
450:       Math.trunc((agility * 5) / 2) +
451:       Math.trunc(strength / 6) +
452:       Math.trunc(leadership / 10)
453:     );
454:   }
455: 
456:   if (base === BaseClass.RageFighter) {
457:     return level * 3 + Math.trunc((agility * 5) / 4) + Math.trunc(strength / 6);
458:   }
459: 
460:   return level * 5 + Math.trunc((agility * 3) / 2) + Math.trunc(strength / 4);
461: }
462: 
463: function calculateAttackRatePvp(
464:   input: CharacterStatsInput,
465:   base: BaseClass
466: ): number {
467:   const { level, agility } = input;
468: 
469:   switch (base) {
470:     case BaseClass.Knight:
471:       return Math.trunc(level * 3 + agility * 4.5);
472:     case BaseClass.DarkLord:
473:     case BaseClass.Wizard:
474:       return Math.trunc(level * 3 + agility * 4);
475:     case BaseClass.Elf:
476:       return Math.trunc(level * 3 + agility * 0.6);
477:     case BaseClass.MagicGladiator:
478:     case BaseClass.Summoner:
479:       return Math.trunc(level * 3 + agility * 3.5);
480:     case BaseClass.RageFighter:
481:       return Math.trunc(level * 2.6 + agility * 3.6);
482:     default:
483:       return 0;
484:   }
485: }
486: 
487: function calculateDefense(input: CharacterStatsInput, base: BaseClass): number {
488:   const { agility, items } = input;
489: 
490:   let defense: number;
491: 
492:   switch (base) {
493:     case BaseClass.Elf:
494:       defense = Math.trunc(agility / 10);
495:       break;
496:     case BaseClass.Knight:
497:     case BaseClass.Summoner:
498:       defense = Math.trunc(agility / 3);
499:       break;
500:     case BaseClass.Wizard:
501:       defense = Math.trunc(agility / 4);
502:       break;
503:     case BaseClass.DarkLord:
504:       defense = Math.trunc(agility / 7);
505:       break;
506:     case BaseClass.RageFighter:
507:       defense = Math.trunc(agility / 8);
508:       break;
509:     default:
510:       defense = Math.trunc(agility / 5);
511:       break;
512:   }
513: 
514:   const defending = [
515:     InventoryConstants.LeftHandSlot,
516:     InventoryConstants.RightHandSlot,
517:     InventoryConstants.HelmSlot,
518:     InventoryConstants.ArmorSlot,
519:     InventoryConstants.PantsSlot,
520:     InventoryConstants.GlovesSlot,
521:     InventoryConstants.BootsSlot,
522:     InventoryConstants.WingsSlot,
523:   ];
524: 
525:   for (const slot of defending) {
526:     const item = equipped(items, slot);
527:     if (item) defense += itemDefense(item);
528:   }
529: 
530:   return defense;
531: }
532: 
533: function calculateDefenseRate(
534:   input: CharacterStatsInput,
535:   base: BaseClass
536: ): number {
537:   const { agility, items } = input;
538: 
539:   let blocking: number;
540: 
541:   switch (base) {
542:     case BaseClass.Elf:
543:     case BaseClass.Summoner:
544:       blocking = Math.trunc(agility / 4);
545:       break;
546:     case BaseClass.DarkLord:
547:       blocking = Math.trunc(agility / 7);
548:       break;
549:     case BaseClass.RageFighter:
550:       blocking = Math.trunc(agility / 10);
551:       break;
552:     default:
553:       blocking = Math.trunc(agility / 3);
554:       break;
555:   }
556: 
557:   const left = equipped(items, InventoryConstants.LeftHandSlot);
558:   if (left) blocking += itemBlocking(left);
559: 
560:   return blocking;
561: }
562: 
563: function calculateDefenseRatePvp(
564:   input: CharacterStatsInput,
565:   base: BaseClass
566: ): number {
567:   const { level, agility } = input;
568: 
569:   switch (base) {
570:     case BaseClass.Knight:
571:     case BaseClass.DarkLord:
572:     case BaseClass.Summoner:
573:       return Math.trunc(level * 2 + agility * 0.5);
574:     case BaseClass.Elf:
575:       return Math.trunc(level * 2 + agility * 0.1);
576:     case BaseClass.MagicGladiator:
577:     case BaseClass.Wizard:
578:       return Math.trunc(level * 2 + agility * 0.25);
579:     case BaseClass.RageFighter:
580:       return Math.trunc(level * 1.5 + agility * 0.2);
581:     default:
582:       return 0;
583:   }
584: }
585: 
586: function calculateWizardry(input: CharacterStatsInput): {
587:   min: number;
588:   max: number;
589:   rate: number;
590: } {
591:   const { energy, items } = input;
592: 
593:   let min = Math.trunc(energy / 9);
594:   let max = Math.trunc(energy / 4);
595:   let rate = 0;
596: 
597:   const right = equipped(items, InventoryConstants.RightHandSlot);
598: 
599:   if (right && isStaff(right)) {
600:     const damage = itemDamage(right);
601:     min += damage.min;
602:     max += damage.max;
603:     rate = itemMagicPower(right);
604:   }
605: 
606:   return { min, max, rate };
607: }
608: 
609: export function deriveCharacterStats(input: CharacterStatsInput): DerivedStats {
610:   const base = getBaseClass(input.charClass);
611: 
612:   const damage = calculateDamage(input, base);
613:   const wizardry = calculateWizardry(input);
614: 
615:   return {
616:     attackSpeed: attackSpeedOf(input.charClass, input.agility),
617:     magicSpeed: magicSpeedOf(input.charClass, input.agility),
618:     damageMin: damage.min,
619:     damageMax: damage.max,
620:     dualWield: damage.dualWield,
621:     attackRate: calculateAttackRate(input, base),
622:     attackRatePvp: calculateAttackRatePvp(input, base),
623:     defense: calculateDefense(input, base),
624:     defenseRate: calculateDefenseRate(input, base),
625:     defenseRatePvp: calculateDefenseRatePvp(input, base),
626:     wizardryMin: wizardry.min,
627:     wizardryMax: wizardry.max,
628:     staffRate: wizardry.rate,
629:     curseMin: Math.trunc(input.energy / 9),
630:     curseMax: Math.trunc(input.energy / 4),
631:   };
632: }
