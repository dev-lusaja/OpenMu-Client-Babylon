 1: import { reaction } from 'mobx';
 2: import { t } from '../i18n';
 3: import { Store } from '../store';
 4: import { gridFirstIndex, StorageKind, storageColumns, storageRows } from './itemStorage';
 5: import type { Item } from '../ecs/world';
 6: 
 7: /**
 8:  * "Send all of these over there": the loop behind the vault's jewel button.
 9:  *
10:  * Same shape as the auto-arrange run (`inventorySort.ts`) and for the same
11:  * reason - the server owns both grids and answers one move at a time - so
12:  * this walks the source grid, hands one item to `Store.autoMoveItem` per
13:  * answered move, and stops when the far grid is full or nothing matches.
14:  */
15: 
16: const MAX_MOVES = 120;
17: 
18: export const BulkMove = new (class _BulkMove {
19:   private from: StorageKind = StorageKind.Inventory;
20:   private to: StorageKind = StorageKind.Vault;
21:   private wanted: ((item: Item) => boolean) | null = null;
22:   private moves = 0;
23:   private stop: (() => void) | null = null;
24: 
25:   get running(): boolean {
26:     return this.wanted !== null;
27:   }
28: 
29:   start(from: StorageKind, to: StorageKind, wanted: (item: Item) => boolean): void {
30:     if (this.running) {
31:       this.cancel();
32:       return;
33:     }
34:     if (Store.pickedItem || Store.pendingItemMove) return;
35: 
36:     this.from = from;
37:     this.to = to;
38:     this.wanted = wanted;
39:     this.moves = 0;
40: 
41:     this.stop = reaction(
42:       () => Store.pendingItemMove === null,
43:       idle => {
44:         if (idle) this.step();
45:       }
46:     );
47: 
48:     this.step();
49:   }
50: 
51:   cancel(): void {
52:     this.stop?.();
53:     this.stop = null;
54:     this.wanted = null;
55:   }
56: 
57:   private step(): void {
58:     const wanted = this.wanted;
59:     if (!wanted) return;
60:     if (Store.pickedItem || Store.pendingItemMove) return;
61: 
62:     if (this.moves >= MAX_MOVES) {
63:       this.cancel();
64:       return;
65:     }
66: 
67:     const slot = this.nextSlot(wanted);
68:     if (slot < 0) {
69:       const moved = this.moves;
70:       this.cancel();
71:       if (moved > 0) Store.addNotification(t('notify.itemsMoved', { count: moved }));
72:       return;
73:     }
74: 
75:     const item = Store.itemsOfStorage(this.from)[slot];
76:     if (!item || Store.findFreeSquare(this.to, item) < 0) {
77:       this.cancel();
78:       Store.addNotification(t('notify.noRoomForItem'), 'error');
79:       return;
80:     }
81: 
82:     this.moves++;
83:     Store.autoMoveItem(this.from, slot, this.to);
84:     if (Store.isOffline) this.step();
85:   }
86: 
87:   private nextSlot(wanted: (item: Item) => boolean): number {
88:     const items = Store.itemsOfStorage(this.from);
89:     const first = gridFirstIndex(this.from);
90:     const count = storageColumns(this.from) * storageRows(this.from);
91: 
92:     for (let square = 0; square < count; square++) {
93:       const item = items[first + square];
94:       if (item && wanted(item)) return first + square;
95:     }
96: 
97:     return -1;
98:   }
99: })();
</file>

