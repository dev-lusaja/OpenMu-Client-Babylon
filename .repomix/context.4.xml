1503:     if (this._shadows.length === 0) return;
1504: 
1505:     const visible = !this.OutOfView && this.Alpha >= 1;
1506:     const serial = shadowStateVersion();
1507: 
1508:     if (visible === this._shadowsVisible && serial === this._shadowsSerial) {
1509:       return;
1510:     }
1511: 
1512:     this._shadowsVisible = visible;
1513:     this._shadowsSerial = serial;
1514: 
1515:     for (let slot = 0; slot < this._shadows.length; slot++) {
1516:       this._shadows[slot]?.setEnabled(visible && blobShadowsActive());
1517:     }
1518:   }
