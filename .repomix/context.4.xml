<file path="src/common/encryption/xor32.ts">
 1: import { castToByte } from "../binaryUtils";
 2: import { getPacketHeaderSize } from "../wireUtils";
 3: import { DefaultKeys } from "./keys";
 4: 
 5: export class Xor32Decryptor {
 6:   xor32Key: Uint8Array = DefaultKeys.Xor32Key;
 7: 
 8:   Decrypt(packet: Uint8Array): [boolean, Uint8Array] {
 9:     const headerSize = getPacketHeaderSize(packet);
10:     for (let i = packet.length - 1; i > headerSize; i--) {
11:       packet[i] = castToByte(packet[i] ^ packet[i - 1] ^ this.xor32Key[i % 32]);
12:     }
13: 
14:     return [true, packet];
15:   }
16: }
17: 
18: export class Xor32Encryptor {
19:   xor32Key: Uint8Array = DefaultKeys.Xor32Key;
20: 
21:   Encrypt(packet: Uint8Array): Uint8Array {
22:     const headerSize = getPacketHeaderSize(packet);
23:     for (let i = headerSize + 1; i < packet.length; i++) {
24:       packet[i] = castToByte(packet[i] ^ packet[i - 1] ^ this.xor32Key[i % 32]);
25:     }
26: 
27:     return packet;
28:   }
29: }
