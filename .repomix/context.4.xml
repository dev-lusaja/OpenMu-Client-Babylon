508:     blend: 'add',
509:     init(p, scale, light) {
510:       p.lifeTime = 6;
511:       p.scale = scale;
512:       p.rotation = rand(360);
513:       [p.tr, p.tg, p.tb] = light;
514:     },
515:     update(p) {
516:       // Sprite scale follows sinf(WorldTime * 0.004) * 0.3 + 0.3 in the
517:       // original; the emitter passes that in, so only the fade is left.
518:       const t = Math.max(0, Math.min(1, p.lifeTime / 6));
519:       p.lr = p.tr * t;
520:       p.lg = p.tg * t;
521:       p.lb = p.tb * t;
522:     },
523:     color: plainColor,
524:   } satisfies ParticleKind,
525: 
526:   /**
527:    * Wing of Storm cloud aura (ZzzObject.cpp:9896-9915): BITMAP_CLUD64 at 25
528:    * wing bones, luminosity |sin(WorldTime * 0.0004)| * 0.4 + 0.5.
529:    */
530:   wingCloud: {
531:     texture: 'clud64',
532:     blend: 'add',
533:     init(p, scale, light) {
534:       p.lifeTime = 8;
535:       p.scale = scale;
536:       p.rotation = rand(360);
537:       [p.tr, p.tg, p.tb] = light;
538:     },
539:     update(p, f) {
540:       const t = Math.max(0, Math.min(1, p.lifeTime / 8));
541:       p.rotation += f;
542:       p.lr = p.tr * t;
543:       p.lg = p.tg * t;
544:       p.lb = p.tb * t;
545:     },
546:     color: plainColor,
547:   } satisfies ParticleKind,
548: } satisfies Record<string, ParticleKind>;
549: 
550: export type KindName = keyof typeof KINDS;
551: 
552: export type Emission = {
553:   readonly kinds: readonly KindName[];
554:   readonly every: number;
555:   readonly count?: number;
556:   readonly light?:
557:     | readonly [number, number, number]
558:     | (() => readonly [number, number, number]);
559:   readonly scale?: number;
560:   readonly jitter?: number;
561: };
562: 
563: /**
564:  * Emissions for an object type on a world - `MapLayer.emissions` on each map
565:  * entry (`src/maps/<name>/spec.ts`), read through the facade.
566:  */
567: export function emissionsFor(
568:   world: number,
569:   type: number
570: ): readonly Emission[] | undefined {
571:   return maps.emissionsFor(world, type);
572: }
573: 
574: type Pool = {
575:   manager: SpriteManager;
576:   pixelSize: number;
577:   frames: number;
578:   free: Sprite[];
579: };
580: 
581: let scene: Scene | null = null;
582: const pools = new Map<string, Pool>();
583: const loading = new Map<string, Promise<Pool | null>>();
584: const particles: Particle[] = [];
585: let worldTimeMs = 0;
586: let tickObserver: unknown = null;
587: 
588: const poolKey = (texture: TextureKey, blend: Blend) => `${texture}:${blend}`;
589: 
590: async function getPool(
591:   target: Scene,
592:   texture: TextureKey,
593:   blend: Blend
594: ): Promise<Pool | null> {
595:   const key = poolKey(texture, blend);
596: 
597:   const existing = pools.get(key);
598:   if (existing) return existing;
599: 
600:   let inFlight = loading.get(key);
601: 
602:   if (!inFlight) {
603:     inFlight = (async () => {
604:       const { file, size } = TEXTURES[texture];
605: 
606:       // A sheet this version never shipped: no pool, no particles, and no
607:       // fetch per emission for the rest of the session (`hasDataFile`).
608:       if (!hasDataFile(file)) return null;
609: 
610:       const ozj = await downloadDataFile(file);
611: 
612:       const blob = new Blob([ozj.slice(OZJ_HEADER_SIZE)], {
613:         type: 'image/jpeg',
614:       });
615: 
616:       const manager = new SpriteManager(
617:         `effectParticles_${key}`,
618:         URL.createObjectURL(blob),
619:         POOL_SIZE,
620:         { width: size, height: size },
621:         target
622:       );
623: 
624:       manager.blendMode =
625:         blend === 'add' ? Constants.ALPHA_ONEONE : Constants.ALPHA_SUBTRACT;
626: 
627:       manager.disableDepthWrite = true;
628:       manager.isPickable = false;
629: 
630:       // The group the flare card over the flame already sits in
631:       // (`common/effectLights.ts`). Babylon draws sprites before the
632:       // transparent queue, and MU's alpha-keyed meshes write depth in that
633:       // queue, so a flame left in group 0 was drawn first and then painted
634:       // over by the bridge rail, the fence or the bush standing in front of
635:       // it. Dev seam: `?fxgroup=0` puts them back.
636:       manager.renderingGroupId = devQueryNumber('fxgroup') ?? EFFECT_RENDERING_GROUP;
637:       keepDepthForEffects(target);
638: 
639:       const pool: Pool = {
640:         manager,
641:         pixelSize: size,
642:         frames: TEXTURES[texture].frames ?? 1,
643:         free: [],
644:       };
645:       pools.set(key, pool);
646: 
647:       return pool;
648:     })();
649: 
650:     loading.set(key, inFlight);
651:   }
652: 
653:   return inFlight;
654: }
655: 
656: function acquire(pool: Pool): Sprite | null {
657:   const reused = pool.free.pop();
658: 
659:   if (reused) {
660:     reused.isVisible = true;
661:     return reused;
662:   }
663: 
664:   if (pool.manager.sprites.length >= POOL_SIZE) return null;
665: 
666:   const sprite = new Sprite('particle', pool.manager);
667:   sprite.isPickable = false;
668: 
669:   return sprite;
670: }
671: 
672: function ensureTicking(target: Scene) {
673:   if (tickObserver && scene === target) return;
674: 
675:   scene = target;
676: 
677:   tickObserver = target.onBeforeRenderObservable.add(() => {
678:     const deltaMs = target.getEngine().getDeltaTime();
679:     worldTimeMs += deltaMs;
680: 
681:     const f = Math.min(1, (deltaMs / 1000) * TICKS_PER_SECOND);
682: 
683:     const color = new Color4(1, 1, 1, 1);
684: 
685:     for (let i = particles.length - 1; i >= 0; i--) {
686:       const p = particles[i];
687: 
688:       p.lifeTime -= f;
689:       if (p.lifeTime <= 0) p.live = false;
690: 
691:       if (p.live) {
692:         if (p.vx !== 0 || p.vy !== 0 || p.vz !== 0) {
693:           const c = Math.cos(p.angleZ);
694:           const s = Math.sin(p.angleZ);
695: 
696:           p.px += (p.vx * c - p.vy * s) * f;
697:           p.py += (p.vx * s + p.vy * c) * f;
698:           p.pz += p.vz * f;
699:         }
700: 
701:         p.kind.update(p, f, worldTimeMs);
702:       }
703: 
704:       if (!p.live || p.scale <= 0) {
705:         release(p);
706:         particles.splice(i, 1);
707:         continue;
708:       }
709: 
710:       const sprite = p.sprite;
711: 
712:       sprite.position.set(
713:         p.px / TILE_CM,
714:         p.pz / TILE_CM,
715:         p.py / TILE_CM
716:       );
717: 
718:       const size = (p.pixelSize * p.scale) / TILE_CM;
719:       sprite.width = size;
720:       sprite.height = size;
721:       sprite.angle = (p.rotation * Math.PI) / 180;
722: 
723:       if (p.frames > 1) {
724:         sprite.cellIndex = ((p.frame % p.frames) + p.frames) % p.frames;
725:       }
726: 
727:       p.kind.color(p, color);
728:       sprite.color.copyFrom(color);
729:     }
730:   });
731: }
732: 
733: const releasePools = new Map<Sprite, Pool>();
734: 
735: function release(p: Particle) {
736:   p.sprite.isVisible = false;
737: 
738:   const pool = releasePools.get(p.sprite);
739:   if (pool) pool.free.push(p.sprite);
740: }
741: 
742: export async function spawnParticle(
743:   target: Scene,
744:   kindName: KindName,
745:   position: { x: number; y: number; z: number },
746:   angleZ: number,
747:   scale: number,
748:   light: readonly [number, number, number],
749:   jitter = 0
750: ): Promise<void> {
751:   const kind = KINDS[kindName] as ParticleKind;
752: 
753:   const pool = await getPool(target, kind.texture, kind.blend);
754:   if (!pool) return;
755: 
756:   const sprite = acquire(pool);
757:   if (!sprite) return;
758: 
759:   releasePools.set(sprite, pool);
760:   ensureTicking(target);
761: 
762:   const p: Particle = {
763:     live: true,
764:     kind,
765:     sprite,
766:     pixelSize: pool.pixelSize,
767:     frame: 0,
768:     frames: pool.frames,
769:     lifeTime: 2,
770:     scale,
771:     alpha: 1,
772:     gravity: 0,
773:     rotation: 0,
774:     px: position.x * TILE_CM + (jitter ? rand(jitter * 2) - jitter : 0),
775:     py: position.z * TILE_CM + (jitter ? rand(jitter * 2) - jitter : 0),
776:     pz: position.y * TILE_CM + (jitter ? rand(jitter * 2) - jitter : 0),
777:     vx: 0,
778:     vy: 0,
779:     vz: 0,
780:     angleZ,
781:     lr: light[0],
782:     lg: light[1],
783:     lb: light[2],
784:     tr: light[0],
785:     tg: light[1],
786:     tb: light[2],
787:   };
788: 
789:   kind.init(p, scale, light);
790: 
791:   particles.push(p);
792: }
793: 
794: export class ParticleEmitter {
795:   #due: number[];
796: 
797:   constructor(
798:     private readonly target: Scene,
799:     private readonly emissions: readonly Emission[],
800:     private readonly position: { x: number; y: number; z: number },
801:     private readonly angleZ: number,
802:     private readonly scale: number
803:   ) {
804:     this.#due = emissions.map(() => 0);
805:   }
806: 
807:   update(): void {
808:     const deltaSeconds = this.target.getEngine().getDeltaTime() / 1000;
809: 
810:     for (let i = 0; i < this.emissions.length; i++) {
811:       const emission = this.emissions[i];
812: 
813:       this.#due[i] += (deltaSeconds * TICKS_PER_SECOND) / emission.every;
814: 
815:       if (this.#due[i] > 4) this.#due[i] = 4;
816: 
817:       while (this.#due[i] >= 1) {
818:         this.#due[i] -= 1;
819: 
820:         const count = emission.count ?? 1;
821: 
822:         for (let n = 0; n < count; n++) {
823:           const kind =
824:             emission.kinds[Math.floor(Math.random() * emission.kinds.length)];
825: 
826:           const light =
827:             typeof emission.light === 'function'
828:               ? emission.light()
829:               : (emission.light ?? WHITE);
830: 
831:           void spawnParticle(
832:             this.target,
833:             kind,
834:             this.position,
835:             this.angleZ,
836:             this.scale * (emission.scale ?? 1),
837:             light,
838:             emission.jitter
839:           );
840:         }
841:       }
842:     }
843:   }
844: }
845: 
846: export type BonedEmission = {
847:   readonly node: { getAbsolutePosition(): { x: number; y: number; z: number } };
848:   readonly kinds: readonly KindName[];
849:   readonly count: number;
850:   /** Constant size, or one sampled per spawn (wing auras pulse with WorldTime). */
851:   readonly scale: number | (() => number);
852:   readonly light: readonly [number, number, number] | (() => readonly [number, number, number]);
853:   readonly offsetY?: number;
854:   /** Spawn only every n-th 25 Hz tick (default 1 = every tick). */
855:   readonly every?: number;
856: };
857: 
858: export class BonedParticleEmitter {
859:   #due = 0;
860:   #tick = 0;
861: 
862:   constructor(
863:     private readonly target: Scene,
864:     private readonly points: readonly BonedEmission[]
865:   ) {}
866: 
867:   update(): void {
868:     this.#due += (this.target.getEngine().getDeltaTime() / 1000) * TICKS_PER_SECOND;
869: 
870:     if (this.#due > 4) this.#due = 4;
871: 
872:     while (this.#due >= 1) {
873:       this.#due -= 1;
874:       this.#tick++;
875: 
876:       for (const point of this.points) {
877:         if (point.every && point.every > 1 && this.#tick % point.every !== 0) {
878:           continue;
879:         }
880: 
881:         const base = point.node.getAbsolutePosition();
882:         const position = point.offsetY
883:           ? { x: base.x, y: base.y + point.offsetY, z: base.z }
884:           : base;
885: 
886:         const scale =
887:           typeof point.scale === 'function' ? point.scale() : point.scale;
888:         const light =
889:           typeof point.light === 'function' ? point.light() : point.light;
890: 
891:         for (let n = 0; n < point.count; n++) {
892:           const kind =
893:             point.kinds[Math.floor(Math.random() * point.kinds.length)];
894: 
895:           void spawnParticle(this.target, kind, position, 0, scale, light);
896:         }
897:       }
898:     }
899:   }
900: }
901: 
902: export function disposeEffectParticles(): void {
903:   for (const p of particles) p.sprite.dispose();
904:   particles.length = 0;
905:   releasePools.clear();
906: 
907:   for (const pool of pools.values()) pool.manager.dispose();
908:   pools.clear();
909:   loading.clear();
910: 
911:   if (tickObserver && scene) {
912:     scene.onBeforeRenderObservable.remove(tickObserver as never);
913:   }
914: 
915:   tickObserver = null;
916:   scene = null;
917: }
</file>

