 84:     expect(Array.from(bytes.slice(7, 12))).toEqual([5, 0xfe, 10, 0xff, 0xff]);
 85: 
 86:     const back = roundTrip(item);
 87:     expect(back.socketCount).toBe(3);
 88:     expect(back.sockets).toEqual([5, 0xfe, 10]);
 89:     expect(back.socketBonus).toBe(1);
