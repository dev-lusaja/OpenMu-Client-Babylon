  99:  * byte what it was.
 100:  */
 101: const INSTANCE_ATTRIBUTE = 'muInst';
 102: const INSTANCE_VARYING = 'vMuInst';
 103: 
 104: const INSTANCE_VERTEX_DEFINITIONS = `
 105:   #ifdef INSTANCES
 106:     attribute vec4 ${INSTANCE_ATTRIBUTE};
 107:   #endif
 108:   varying vec4 ${INSTANCE_VARYING};
 109: `;
 110: 
 111: const INSTANCE_VERTEX_MAIN_END = `
 112:   #ifdef INSTANCES
 113:     ${INSTANCE_VARYING} = ${INSTANCE_ATTRIBUTE};
 114:   #else
 115:     ${INSTANCE_VARYING} = vec4(1.0);
 116:   #endif
 117: `;
 118: 
 119: const INSTANCE_FRAGMENT_DEFINITIONS = `
 120:   varying vec4 ${INSTANCE_VARYING};
 121: `;
 122: 
 123: /** Both item materials declare the attribute and carry the varying across. */
 124: function addInstanceAttribute(material: ItemMaterial): void {
 125:   material.AddAttribute(INSTANCE_ATTRIBUTE);
 126:   material.Vertex_Definitions(INSTANCE_VERTEX_DEFINITIONS);
 127:   material.Vertex_MainEnd(INSTANCE_VERTEX_MAIN_END);
 128: }
 129: /** PBR variant: BodyLight lives outside the Material UBO so it can be set per mesh. */
 130: const BODY_LIGHT_UNIFORM = `muBodyLight`;
 131: 
 132: /**
 133:  * The lit variants are compiled per lighting state (ARCHITECTURE §4.7), the
 134:  * way the terrain takes its `CSM_` defines: `MU_LINEAR_LIGHT` composes
 135:  * `lin(texel x body) x light` while the structured budget is on
 136:  * (`linearLightActive`), `MU_WRAP` is the half-lambert response on tiers
 137:  * >= 1, `MU_TOON` steps that response while a rendering style is on,
 138:  * `MU_TOON_FLAT` flattens the art's tones and `MU_TOON_ULTRA` adds the
 139:  * Ultra tier's highlight and hatching (renderingStyle.ts). Classic compiles
 140:  * none of them and stays byte-identical to the original's
 141:  * `texel x BodyLight x light`.
 142:  */
 143: const LINEAR_LIGHT_DEFINE = 'MU_LINEAR_LIGHT';
 144: const WRAP_DEFINE = 'MU_WRAP';
 145: const TOON_DEFINE = 'MU_TOON';
 146: const FLAT_DEFINE = 'MU_TOON_FLAT';
 147: const ULTRA_DEFINE = 'MU_TOON_ULTRA';
 148: 
 149: /**
 150:  * Detail strength as the shader sees it. The emissive map is *added* on top
 151:  * of the lit surface, so a texture the derivation found trim in comes out
 152:  * brighter than its Classic twin - that is one of the ways Enhanced reads as
 153:  * "the texture itself got lighter", and it has to follow the dial with the
 154:  * rest of the derivation.
 155:  */
 156: const DETAIL_UNIFORM = `muDetail`;
 157: 
 158: /**
 159:  * Every live PBR item material, so the detail strength can be re-applied
 160:  * without a reload. There is one per blend-state variant, not per mesh.
 161:  */
 162: const pbrMaterials = new Set<PBRCustomMaterial>();
 163: 
 164: /**
 165:  * Dial the whole PBR deviation back toward Classic. At 0 the material is the
 166:  * lit albedo and nothing else; at 1 it is the full derivation.
 167:  *
 168:  * Each of these is a separate way Enhanced comes out lighter and paler than
 169:  * its Classic twin, which is why the dial has to move all of them together:
 170:  *
 171:  *  - `specularIntensity` - the Standard item material ships `specularColor 0`
 172:  *    and has no highlight at all, so every bit of GGX the PBR path adds is
 173:  *    white laid over the texture. That is the *pale*: it lifts the surface and
 174:  *    desaturates it at the same time, and it is the largest of the three.
 175:  *  - `metallic` - multiplies the map's blue channel, pulling back the palette
 176:  *    heuristic's guesses. A texel it calls metal loses its diffuse and gets a
 177:  *    highlight back in exchange, with no environment map to justify it.
 178:  *  - `bumpTexture.level` - scales `perturbNormal`, thinning the
 179:  *    height-from-luma relief that turns JPEG ringing into geometry.
 180:  *
 181:  * The added emissive follows too, through `DETAIL_UNIFORM` in the shader.
 182:  *
 183:  * Roughness is deliberately left alone: it is already a multiply against the
 184:  * map, and scaling it would make surfaces *smoother* (shinier), which is the
 185:  * wrong direction for toning the effect down.
 186:  */
 187: export function syncPbrDetail(): void {
 188:   for (const material of pbrMaterials) applyPbrDetail(material);
 189: }
