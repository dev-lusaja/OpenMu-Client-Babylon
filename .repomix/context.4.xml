 253: /**
 254:  * Gives a skinned mesh a local bounding box that covers its posed vertices.
 255:  * The converter stores vertices relative to their bone, so the raw position
 256:  * bounds Babylon computes at load collapse near the origin; with frustum
 257:  * clipping on, a long wall piece is culled as soon as that tiny box leaves
 258:  * the screen. The real placement of a BMD object's parts comes from its
 259:  * animation (frame 0 even for static props), which is not applied yet inside
 260:  * `load()`, so the box is grown after each of the first few rendered frames
 261:  * - this also covers swaying trees and flags - and then left alone; Babylon's
 262:  * `_updateBoundingInfo` carries it along with the world matrix each frame.
 263:  */
 264: function fixSkinnedLocalBounds(mesh: AbstractMesh): void {
 265:   if (!mesh.skeleton) return;
 266: 
 267:   const settled = settledSkinnedBounds.get(vertexDataKey(mesh));
 268:   if (settled) {
 269:     mesh.setBoundingInfo(new BoundingInfo(settled.min, settled.max));
 270:     return;
 271:   }
 272: 
 273:   const scene = mesh.getScene();
 274: 
 275:   let pending = pendingSkinnedBounds.get(scene);
 276:   if (!pending) {
 277:     pending = [];
 278:     pendingSkinnedBounds.set(scene, pending);
 279:     scene.onAfterRenderObservable.add(() => {
 280:       const list = pendingSkinnedBounds.get(scene);
 281:       if (!list || list.length === 0) return;
 282: 
 283:       for (let i = list.length - 1; i >= 0; i--) {
 284:         const entry = list[i];
 285:         if (entry.mesh.isDisposed()) {
 286:           list.splice(i, 1);
 287:           continue;
 288:         }
 289:         const prevMinX = entry.min.x;
 290:         const prevMaxX = entry.max.x;
 291:         const prevMinY = entry.min.y;
 292:         const prevMaxY = entry.max.y;
 293:         const prevMinZ = entry.min.z;
 294:         const prevMaxZ = entry.max.z;
 295:         if (!extendByPosedLocalBounds(entry.mesh, entry.min, entry.max)) {
 296:           list.splice(i, 1);
 297:           continue;
 298:         }
 299:         entry.frames++;
 300:         if (
 301:           entry.min.x !== prevMinX || entry.max.x !== prevMaxX ||
 302:           entry.min.y !== prevMinY || entry.max.y !== prevMaxY ||
 303:           entry.min.z !== prevMinZ || entry.max.z !== prevMaxZ
 304:         ) {
 305:           entry.mesh.setBoundingInfo(new BoundingInfo(entry.min, entry.max));
 306:         }
 307:         if (entry.frames >= SKINNED_BOUNDS_FRAMES) {
 308:           settledSkinnedBounds.set(vertexDataKey(entry.mesh), {
 309:             min: entry.min.clone(),
 310:             max: entry.max.clone(),
 311:           });
 312:           list.splice(i, 1);
 313:         }
 314:       }
 315:     });
 316:   }
 317: 
 318:   pending.push({
 319:     mesh,
 320:     min: new Vector3(Number.MAX_VALUE, Number.MAX_VALUE, Number.MAX_VALUE),
 321:     max: new Vector3(-Number.MAX_VALUE, -Number.MAX_VALUE, -Number.MAX_VALUE),
 322:     frames: 0,
 323:   });
