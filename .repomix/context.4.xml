  9:  * (ZzzCharacter.cpp:157-679) and `CharacterMoveSpeed` (:6165-6250): the
 10:  * `c->Run` accumulator, the maps that swim, and the movement speed the two
 11:  * states imply.
 12:  *
 13:  * Everything here is expressed in the original's units and converted at the
 14:  * call site: `c->Run` counts `FPS_ANIMATION_FACTOR` per frame, which is
 15:  * `clamp(REFERENCE_FPS / FPS, 0, 1)` (ZzzAI.cpp:729) - i.e. it climbs by
 16:  * REFERENCE_FPS (25) per second whenever the frame rate is at or above the
 17:  * reference, and slower below it. Time-stepping it is the frame-rate
 18:  * independent form of the same thing.
 19:  */
 20: 
 21: /** `c->Run >= 40` is the run threshold (ZzzCharacter.cpp:387, :544). */
 22: export const RUN_THRESHOLD = 40;
 23: 
 24: /** A Fenrir rider breaks into the run clips at 20 (`FENRIR_RUN_DELAY`). */
 25: export const FENRIR_RUN_DELAY = 20;
 26: 
 27: /** `c->Run += FPS_ANIMATION_FACTOR` once per frame → 25 units per second. */
 28: export const RUN_UNITS_PER_SECOND = REFERENCE_FPS;
 29: 
 30: /** Seconds of continuous walking before the run clips take over. */
 31: export const RUN_DELAY_SECONDS = RUN_THRESHOLD / RUN_UNITS_PER_SECOND;
