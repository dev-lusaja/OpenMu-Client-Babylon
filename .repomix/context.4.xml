 178:     for (let corner = 0; corner < 8; corner++) {
 179:       Vector3.TransformCoordinatesFromFloatsToRef(
 180:         bounds[o + (corner & 1 ? 3 : 0)],
 181:         bounds[o + 1 + (corner & 2 ? 3 : 0)],
 182:         bounds[o + 2 + (corner & 4 ? 3 : 0)],
 183:         boneWorldTmp,
 184:         tmpVec3
