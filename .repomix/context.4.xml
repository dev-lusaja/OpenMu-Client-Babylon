170:       p.rotation = 0;
171: 
172:       [p.tr, p.tg, p.tb] = light;
173:     },
174:     update(p, fps) {
175:       p.gravity += 0.004 * fps;
176:       p.scale -= 0.04 * fps;
177:       p.frame = Math.floor((23 - p.lifeTime) / 6);
178:       p.pz += p.gravity * 10 * fps;
179: 
180:       const luminosity = p.lifeTime / 24;
181: 
182:       p.lr = p.tr * luminosity;
183:       p.lg = p.tg * luminosity;
184:       p.lb = p.tb * luminosity;
185:     },
186:     color: plainColor,
187:   };
188: }
