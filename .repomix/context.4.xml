 1: import { GameOptions } from './gameOptions';
 2: import type { TextKey } from '../i18n';
 3: 
 4: /**
 5:  * Item effect style (Options → Video → "Item effects"):
 6:  *   0 Off                 - no level tints, no glow, no item lights
 7:  *   1 Legacy              - the original client's passes only (itemMaterial.ts)
 8:  *   2 Legacy + improved   - original passes plus the GlowLayer / light layer
 9:  *   3 Improved            - only the modern layer
10:  *
11:  * `effectLevel` is the original's "+Effect limitation" (`g_pOption->GetRenderLevel()`,
12:  * 0–4): it caps the rendered item level at `2n + 5` and, at 0, drops the
13:  * excellent / ancient passes entirely (ZzzObject.cpp:9555, :10307). It applies
14:  * to both styles so the slider means the same thing whichever look is on.
15:  */
16: export const enum ItemEffectMode {
17:   Off = 0,
18:   Legacy = 1,
19:   Both = 2,
20:   Improved = 3,
21: }
22: 
23: export const ITEM_EFFECT_MODE_MAX = 3;
24: 
25: /** The mode names, as text keys - the Options slider prints `t()` of these. */
26: export const ITEM_EFFECT_MODE_LABEL_KEYS: Record<number, TextKey> = {
27:   [ItemEffectMode.Off]: 'common.off',
28:   [ItemEffectMode.Legacy]: 'options.itemEffects.legacy',
29:   [ItemEffectMode.Both]: 'options.itemEffects.both',
30:   [ItemEffectMode.Improved]: 'options.itemEffects.improved',
31: };
32: 
33: export function itemEffectMode(): ItemEffectMode {
34:   const v = GameOptions.itemEffects;
35:   return v === 0 || v === 1 || v === 2 || v === 3 ? v : ItemEffectMode.Both;
36: }
37: 
38: export function legacyItemEffectsOn(): boolean {
39:   const m = itemEffectMode();
40:   return m === ItemEffectMode.Legacy || m === ItemEffectMode.Both;
41: }
42: 
43: export function improvedItemEffectsOn(): boolean {
44:   const m = itemEffectMode();
45:   return m === ItemEffectMode.Improved || m === ItemEffectMode.Both;
46: }
47: 
48: /** The original's render level (0–4). */
49: export function legacyRenderLevel(): number {
50:   return Math.max(0, Math.min(4, GameOptions.effectLevel | 0));
51: }
52: 
53: /** `Level = min(Level, RenderLevel * 2 + 5)` when the cap is below max. */
54: export function capItemLevel(level: number): number {
55:   const rl = legacyRenderLevel();
56:   return rl < 4 ? Math.min(level, rl * 2 + 5) : level;
57: }
58: 
59: /** A cheap key for "did anything that changes item looks move?" */
60: export function itemEffectSignature(): string {
61:   return `${itemEffectMode()}/${legacyRenderLevel()}`;
62: }
