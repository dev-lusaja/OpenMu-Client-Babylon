  2: import type { Item } from '../ecs/world';
  3: import { ItemSerializer } from './itemSerializer';
  4: import { DARK_HORSE, PET_GROUP } from './petConstants';
  5: 
  6: function serialize(item: Item): Uint8Array {
  7:   const bytes = new Uint8Array(ItemSerializer.NeededSpace);
  8:   ItemSerializer.SerializeItem(bytes, item);
  9:   return bytes;
 10: }
 11: 
 12: function roundTrip(item: Item): Item {
 13:   return ItemSerializer.DeserializeItem(serialize(item));
 14: }
 15: 
 16: describe('ItemSerializer round-trip', () => {
 17:   it('plain item', () => {
 18:     const back = roundTrip({ group: 0, num: 5, lvl: 0, durability: 20 });
 19:     expect(back.group).toBe(0);
 20:     expect(back.num).toBe(5);
 21:     expect(back.lvl).toBe(0);
 22:     expect(back.durability).toBe(20);
 23:     expect(back.hasSkill).toBeUndefined();
 24:     expect(back.luck).toBeUndefined();
 25:     expect(back.optionLevel).toBeUndefined();
 26:     expect(back.isExcellent).toBe(false);
 27:     expect(back.isAncient).toBeUndefined();
 28:     expect(back.socketCount).toBe(0);
 29:   });
 30: 
 31:   it('+13 lucky skill item with option level 7', () => {
 32:     const item: Item = {
 33:       group: 0,
 34:       num: 5,
 35:       lvl: 13,
 36:       luck: true,
 37:       hasSkill: true,
 38:       optionLevel: 7,
 39:       durability: 255,
 40:     };
 41:     const bytes = serialize(item);
 42:     expect(bytes[1]).toBe(((13 << 3) & 0x78) | 0x80 | 0x04 | 0x03);
 43:     expect(bytes[3] & 0x40).toBe(0x40);
 44: 
 45:     const back = roundTrip(item);
 46:     expect(back.lvl).toBe(13);
 47:     expect(back.luck).toBe(true);
 48:     expect(back.hasSkill).toBe(true);
 49:     expect(back.optionLevel).toBe(7);
 50:     expect(back.durability).toBe(255);
 51:   });
 52: 
 53:   it('excellent item', () => {
 54:     const back = roundTrip({ group: 5, num: 11, lvl: 9, excellentFlags: 0x21 });
 55:     expect(back.isExcellent).toBe(true);
 56:     expect(back.excellentFlags).toBe(0x21);
 57:     expect(back.lvl).toBe(9);
 58:   });
 59: 
 60:   it('ancient item', () => {
 61:     const back = roundTrip({
 62:       group: 8,
 63:       num: 5,
 64:       lvl: 7,
 65:       isAncient: true,
 66:       ancientDiscriminator: 2,
 67:       ancientBonusLevel: 1,
 68:     });
 69:     expect(back.isAncient).toBe(true);
 70:     expect(back.ancientDiscriminator).toBe(2);
 71:     expect(back.ancientBonusLevel).toBe(1);
