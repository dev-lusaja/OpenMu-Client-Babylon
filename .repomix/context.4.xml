<file path="src/common/bloodDecals.ts">
  1: import type { Vector3 } from '../libs/babylon/exports';
  2: import type { World } from '../ecs/world';
  3: import { TerrainDecal } from './moveTargetEffect';
  4: 
  5: /**
  6:  * CreateBlood (ZzzEffectBlurSpark.cpp:443) + the BITMAP_BLOOD pointer effect
  7:  * (ZzzEffectPointer.cpp:20-100): two blood splats dropped under the head
  8:  * bone when a character starts its Die clip, each 0.8-1.2 tiles wide with
  9:  * a random rotation, alive for 50 + rand(31) ticks and fading out over the
 10:  * last 50.
 11:  */
 12: 
 13: const BLOOD_TEXTURE = 'Effect/blood01.ozt';
 14: const POOL_SIZE = 24;
 15: const TICKS_PER_SECOND = 25;
 16: const FADE_TICKS = 50;
 17: const HEAD_SPREAD = 0.5; // +-50 cm around the head bone
 18: 
 19: type Splat = {
 20:   decal: TerrainDecal;
 21:   lifeTicks: number;
 22:   x: number;
 23:   y: number;
 24:   scale: number;
 25:   rotation: number;
 26:   light: [number, number, number];
 27: };
 28: 
 29: export class BloodDecals {
 30:   readonly #splats: Splat[] = [];
 31:   #next = 0;
 32: 
 33:   constructor(private readonly world: World) {}
 34: 
 35:   #acquire(): Splat {
 36:     if (this.#splats.length < POOL_SIZE) {
 37:       const splat: Splat = {
 38:         decal: new TerrainDecal(
 39:           this.world,
 40:           `blood${this.#splats.length}`,
 41:           BLOOD_TEXTURE,
 42:           1.2,
 43:           'alpha'
 44:         ),
 45:         lifeTicks: 0,
 46:         x: 0,
 47:         y: 0,
 48:         scale: 1,
 49:         rotation: 0,
 50:         light: [1, 1, 1],
 51:       };
 52:       this.#splats.push(splat);
 53:       return splat;
 54:     }
 55:     // Oldest-first reuse, like the pointer ring in the original.
 56:     const splat = this.#splats[this.#next];
 57:     this.#next = (this.#next + 1) % POOL_SIZE;
 58:     return splat;
 59:   }
 60: 
 61:   /** CreateBlood: two splats around `headPos` (world units; y ignored). */
 62:   spawn(headPos: Vector3, light: Vector3): void {
 63:     for (let i = 0; i < 2; i++) {
 64:       const splat = this.#acquire();
 65:       splat.x = headPos.x + (Math.random() - 0.5) * 2 * HEAD_SPREAD;
 66:       splat.y = headPos.z + (Math.random() - 0.5) * 2 * HEAD_SPREAD;
 67:       splat.rotation = Math.random() * 360;
 68:       splat.scale = 0.8 + Math.random() * 0.4;
 69:       splat.light = [light.x, light.y, light.z];
 70:       splat.lifeTicks = 50 + Math.floor(Math.random() * 32);
 71:       splat.decal.setAlpha(1);
 72:       splat.decal.draw(
 73:         this.world,
 74:         splat.x,
 75:         splat.y,
 76:         splat.scale,
 77:         splat.rotation,
 78:         splat.light
 79:       );
 80:     }
 81:   }
 82: 
 83:   update(dt: number): void {
 84:     const ticks = dt * TICKS_PER_SECOND;
 85:     for (const splat of this.#splats) {
 86:       if (splat.lifeTicks <= 0) continue;
 87:       splat.lifeTicks -= ticks;
 88:       if (splat.lifeTicks <= 0) {
 89:         splat.lifeTicks = 0;
 90:         splat.decal.hide();
 91:         continue;
 92:       }
 93:       if (splat.lifeTicks < FADE_TICKS) {
 94:         splat.decal.setAlpha(splat.lifeTicks / FADE_TICKS);
 95:       }
 96:       // Re-drape in case the texture finished loading after spawn.
 97:       if (!splat.decal.enabled) {
 98:         splat.decal.draw(
 99:           this.world,
100:           splat.x,
101:           splat.y,
102:           splat.scale,
103:           splat.rotation,
104:           splat.light
105:         );
106:       }
107:     }
108:   }
109: 
110:   clear(): void {
111:     for (const splat of this.#splats) {
112:       splat.lifeTicks = 0;
113:       splat.decal.hide();
114:     }
115:   }
116: }
</file>

