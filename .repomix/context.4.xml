<file path="src/common/inventoryFit.ts">
 1: import { InventoryConstants } from './inventoryConstants';
 2: 
 3: /**
 4:  * The free-rectangle search over an inventory grid, shared by the client
 5:  * (`Store.buyOffline` in `src/store.ts`) and the cash shop's delivery worker
 6:  * (`cashshop/server/fulfilment.ts`), which runs under Bun with no engine
 7:  * behind it and so cannot import `store.ts`. One implementation on purpose:
 8:  * the client draws occupancy with this loop, and a server that placed an item
 9:  * where the client computes something else would draw two items on one
10:  * square.
11:  *
12:  * A port of the original's `FindEmptySlot`: `InventoryConstants` geometry,
13:  * every footprint marked from its top-left square and clipped at the grid's
14:  * edges, then a row-major, top-left-anchored first fit. Not a smarter packer,
15:  * for the reason above.
16:  */
17: 
18: export interface Footprint {
19:   /** The item's slot in the storage, counted from the first equipment slot. */
20:   slot: number;
21:   width: number;
22:   height: number;
23: }
24: 
25: /**
26:  * The first grid slot where a `width` x `height` item fits among `occupied`,
27:  * in a grid of `rows` rows below the twelve equipment slots; -1 when none
28:  * does. Footprints outside the grid - equipment, extension rows the grid does
29:  * not cover, the personal store - are ignored.
30:  */
31: export function findFreeSlot(
32:   occupied: readonly Footprint[],
33:   rows: number,
34:   width: number,
35:   height: number
36: ): number {
37:   const columns = InventoryConstants.RowSize;
38:   const first = InventoryConstants.LastEquippableItemSlotIndex + 1;
39:   const used = new Uint8Array(columns * rows);
40: 
41:   for (const item of occupied) {
42:     const square = item.slot - first;
43:     if (square < 0 || square >= columns * rows) continue;
44:     const column = square % columns;
45:     const row = (square - column) / columns;
46:     for (let y = 0; y < item.height; y++) {
47:       for (let x = 0; x < item.width; x++) {
48:         if (column + x < columns && row + y < rows) {
49:           used[(row + y) * columns + column + x] = 1;
50:         }
51:       }
52:     }
53:   }
54: 
55:   for (let row = 0; row + height <= rows; row++) {
56:     for (let column = 0; column + width <= columns; column++) {
57:       let fits = true;
58:       for (let y = 0; y < height && fits; y++) {
59:         for (let x = 0; x < width; x++) {
60:           if (used[(row + y) * columns + column + x]) {
61:             fits = false;
62:             break;
63:           }
64:         }
65:       }
66:       if (fits) return first + row * columns + column;
67:     }
68:   }
69: 
70:   return -1;
71: }
</file>

