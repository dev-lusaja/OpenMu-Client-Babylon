302:   readonly emitter: Vector3;
303:   readonly system: IParticleSystem;
304:   readonly gpu: boolean;
305:   /** Seconds the live strength needs to cross the whole 0…1 range. */
306:   readonly ramp: number;
307:   /**
308:    * The longest a particle emitted right now can live, in seconds. Read by
309:    * the owner to decide how long a draining system must be left alone before
310:    * it is safe to dispose.
311:    *
312:    * A reader rather than `recipe.life[1]`, because `growth` moves it: light
