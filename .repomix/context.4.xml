 99: /** Normalised `items.json` row, or null for an unknown item. */
100: export function itemDef(group: number, index: number): ItemDef | null {
101:   const key = `${group}:${index}`;
102:   const cached = defCache.get(key);
103:   if (cached !== undefined) return cached;
104: 
105:   const raw = ItemsDatabase.getItem(group, index) as
106:     | Record<string, unknown>
107:     | null;
108:   if (!raw) {
109:     defCache.set(key, null);
110:     return null;
111:   }
112: 
113:   const width = num(raw, 'X') || 1;
114:   const def: ItemDef = {
115:     group,
116:     index,
117:     name: String(raw.ItemName ?? ''),
118:     slot: typeof raw.ItemSlot === 'number' ? raw.ItemSlot : -1,
119:     width,
120:     height: num(raw, 'Y') || 1,
121:     level: num(raw, 'ItemLvl', 'Lvl'),
122:     damageMin: num(raw, 'DmgMin'),
123:     damageMax: num(raw, 'DmgMax'),
124:     magicPower: num(raw, 'MagicPwr'),
125:     speed: num(raw, 'Speed'),
126:     durability: num(raw, 'Durability', 'Dur'),
127:     magicDur: num(raw, 'MagicDur'),
128:     defense: num(raw, 'Def'),
129:     blocking: num(raw, 'DefRate'),
130:     reqLvl: num(raw, 'RequiredLvl', 'ReqLvl'),
131:     reqStr: num(raw, 'Strength', 'Str'),
132:     reqAgi: num(raw, 'Agi'),
133:     reqEne: num(raw, 'Ene', 'Energy'),
134:     reqVit: num(raw, 'Vit'),
135:     reqCmd: num(raw, 'Command', 'Comm'),
136:     skill: num(raw, 'Skill'),
137:     classes: CLASS_COLUMNS.map(column => num(raw, column)),
138:     resistances: [
139:       'Ice',
140:       'Poison',
141:       'Light',
142:       'Fire',
143:       'Earth',
144:       'Wind',
145:       'Water',
146:     ].map(column => num(raw, column)),
147:     // Item.bmd's TwoHand flag is not in Item.txt; every two-handed weapon
148:     // in the table is two squares wide and no one-hander is.
149:     twoHand: group <= ItemGroup.Staff && width >= 2,
150:     modelFolder: String(raw.szModelFolder ?? ''),
151:     modelName: String(raw.szModelName ?? ''),
152:   };
153: 
154:   defCache.set(key, def);
155:   return def;
156: }
