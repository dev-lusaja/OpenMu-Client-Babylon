 64: export const KEY_ACTIONS = Object.keys(KEY_ACTION_LABEL_KEYS) as KeyAction[];
 65: 
 66: const DEFAULTS: KeyBindings = {
 67:   minimap: 'Tab',
 68:   emoteMenu: 'Backquote',
 69:   inventory: 'KeyI',
 70:   characterInfo: 'KeyC',
 71:   party: 'KeyP',
 72:   guild: 'KeyG',
 73:   friends: 'KeyF',
 74:   quests: 'KeyT',
 75:   options: 'KeyO',
 76:   warpList: 'KeyM',
 77:   repair: 'KeyL',
 78:   // `GetAsyncKeyState('D')` (ZzzInterface.cpp:9098).
 79:   command: 'KeyD',
 80:   masterSkills: 'KeyA',
 81:   skillList: 'KeyK',
 82:   // The retail client's Home key; this C++ port only has the Start / Stop
 83:   // button on `CNewUIHeroPositionInfo`.
 84:   muHelper: 'Home',
 85:   // The original opens the config from the position panel's button; a key
 86:   // stands in for the panel here.
 87:   muHelperConfig: 'End',
 88:   // No original analog: the arrange run is this client's own.
 89:   hideUi: 'KeyH',
 90:   sessionStats: 'KeyU',
 91:   sortInventory: 'KeyS',
 92:   targetNearest: 'KeyN',
 93:   replyWhisper: 'KeyY',
 94:   // Unbound on purpose: a diagnostics readout should not claim a letter from
 95:   // a fresh install. An empty code matches no key press.
 96:   performanceReadout: '',
 97: };
