167:     chrome: CHROME_PALETTE[chromeIndex] ?? CHROME_PALETTE[0],
168:     chrome2: CHROME2_PALETTE[chrome2Index] ?? null,
169:     ancient:
170:       isArmourGroup(group) && SET_ANCIENT_GOLD.has(num)
171:         ? ANCIENT_GOLD
172:         : ANCIENT_BLUE,
