  1: import { describe, expect, it } from 'vitest';
  2: import { nearbyOf, type Nearby } from './gmNearby';
  3: import type { Entity } from '../ecs/world';
  4: 
  5: /**
  6:  * `nearbyOf` is what the panel's Nearby list and its radar both read, so the
  7:  * kind it decides and the distance it measures are what a game master acts on:
  8:  * the wrong kind offers the wrong buttons, and the wrong distance sorts the
  9:  * person in front of them below a scorpion.
 10:  */
 11: 
 12: const at = (x: number, y: number, extra: Partial<Entity> = {}): Entity => ({
 13:   netId: Math.round(x * 1000 + y),
 14:   transform: { pos: { x, y: 0, z: y }, rot: { x: 0, y: 0, z: 0 }, scale: 1 },
 15:   ...extra,
 16: });
 17: 
 18: const player = (x: number, y: number, name: string, extra: Partial<Entity> = {}): Entity =>
 19:   at(x, y, {
 20:     playerAnimation: { action: 0, run: 0 } as Entity['playerAnimation'],
 21:     objectNameInWorld: name,
 22:     ...extra,
 23:   });
 24: 
 25: const monster = (x: number, y: number, npcType: number): Entity =>
 26:   at(x, y, {
 27:     monsterAnimation: { action: 0 } as Entity['monsterAnimation'],
 28:     npcType,
 29:   });
 30: 
 31: describe('nearbyOf', () => {
 32:   it('measures distance the way MU does, by the longer axis', () => {
 33:     // Chebyshev, not Pythagoras: three east and four north is four tiles away,
 34:     // which is the range every command and every scope check uses.
 35:     const [entry] = nearbyOf([player(103, 104, 'Ann')], 100, 100);
 36:     expect(entry.distance).toBe(4);
 37:   });
 38: 
 39:   it('reads the tile a body stands on, not its smooth position', () => {
 40:     const [entry] = nearbyOf([player(120.94, 60.02, 'Ann')], 100, 100);
 41:     expect([entry.x, entry.y]).toEqual([120, 60]);
 42:   });
 43: 
 44:   it('tells a player from a monster from an npc', () => {
 45:     const found = nearbyOf(
 46:       [player(101, 100, 'Ann'), monster(102, 100, 3), at(103, 100, { npcType: 230 })],
 47:       100,
 48:       100
 49:     );
 50: 
 51:     expect(found.map(e => e.kind)).toEqual(['player', 'monster', 'npc']);
 52:   });
 53: 
 54:   it('puts players first, then everything by how close it is', () => {
 55:     const found = nearbyOf(
 56:       [
 57:         monster(101, 100, 3),
 58:         player(140, 100, 'Far'),
 59:         monster(105, 100, 4),
 60:         player(102, 100, 'Near'),
 61:       ],
 62:       100,
 63:       100
 64:     );
 65: 
 66:     expect(found.map(e => e.name)).toEqual(['Near', 'Far', 'Spider', 'Bull Fighter']);
 67:   });
 68: 
 69:   it('leaves out the hero, anything out of scope, and anything with no position', () => {
 70:     const found = nearbyOf(
 71:       [
 72:         player(101, 100, 'Me', { localPlayer: true }),
 73:         player(102, 100, 'Gone', { objOutOfScope: true }),
 74:         { netId: 9 } as Entity,
 75:         player(103, 100, 'Ann'),
 76:       ],
 77:       100,
 78:       100
 79:     );
 80: 
 81:     expect(found.map(e => e.name)).toEqual(['Ann']);
 82:   });
 83: 
 84:   it('leaves out anything that is neither a body nor an npc', () => {
 85:     // A dropped item carries a netId and a position and nothing else; it is
 86:     // not something a game master aims a command at.
 87:     const found = nearbyOf([at(101, 100)], 100, 100);
 88:     expect(found).toEqual([]);
 89:   });
 90: 
 91:   it('keeps a dying body, marked, because it is still there to act on', () => {
 92:     const found = nearbyOf(
 93:       [player(101, 100, 'Ann', { dying: { time: 0 } as Entity['dying'] })],
 94:       100,
 95:       100
 96:     );
 97: 
 98:     expect(found[0]).toMatchObject({ name: 'Ann', dying: true });
 99:   });
100: 
101:   it('names a monster from its type when the server sent no name', () => {
102:     const [entry] = nearbyOf([monster(101, 100, 3)], 100, 100);
103:     expect(entry.name).toBe('Spider');
104:   });
105: 
106:   it('falls back to the net id for a nameless player', () => {
107:     const [entry] = nearbyOf([player(101, 100, '')], 100, 100);
108:     expect(entry.name).toBe(`#${entry.netId}`);
109:   });
