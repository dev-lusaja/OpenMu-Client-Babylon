 1: import type { Entity, World } from '../ecs/world';
 2: import { ModelObject } from './modelObject';
 3: 
 4: /** MU vertical units → world units (`TERRAIN_SCALE` is 100). */
 5: const MU_UNIT = 1 / 100;
 6: 
 7: /** `o->Timer += 0.15f * FPS_ANIMATION_FACTOR` → 0.15 × 25 radians per second. */
 8: const BOB_RADIANS_PER_SECOND = 0.15 * 25;
 9: 
10: /** Peak lift of the Budge Dragon bob, in MU units (ZzzCharacter.cpp:6276). */
11: const BUDGE_DRAGON_BOB = 70;
12: 
13: export class MonsterObject extends ModelObject {
14:   /**
15:    * `MODEL_BUDGE_DRAGON`'s hover: `o->Position[2] += -|sin(Timer)| * 70 + 70`
16:    * every time `MoveCharacterPosition` runs (ZzzCharacter.cpp:6274-6278), i.e.
17:    * only while the monster is walking. A dead one drops back to the terrain
18:    * (`MoveMonsterClient`:6320-6324).
19:    */
20:   BobsWhileMoving = false;
21: 
22:   #entity: Entity | null = null;
23:   #bobTimer = 0;
24: 
25:   async init(_world: World, entity: Entity): Promise<void> {
26:     this.#entity = entity;
27:   }
28: 
29:   Update(gameTime: World['gameTime']): void {
30:     super.Update(gameTime);
31: 
32:     if (!this.BobsWhileMoving) return;
33: 
34:     const entity = this.#entity;
35:     const velocity = entity?.movement?.velocity;
36:     const moving = !!velocity && (velocity.x !== 0 || velocity.y !== 0);
37: 
38:     if (!moving || entity?.dying) {
39:       this.HoverHeight = 0;
40:       return;
41:     }
42: 
43:     this.#bobTimer = gameTime.TotalGameTime.TotalSeconds * BOB_RADIANS_PER_SECOND;
44: 
45:     this.HoverHeight =
46:       (-Math.abs(Math.sin(this.#bobTimer)) * BUDGE_DRAGON_BOB +
47:         BUDGE_DRAGON_BOB) *
48:       MU_UNIT;
49:   }
50: }
</file>

