282:         offset += 2;
283:         const VertexIndex: [Short, Short, Short, Short] = [] as any;
284:         VertexIndex.push(dv.getInt16(offset, true));
285:         offset += 2;
286:         VertexIndex.push(dv.getInt16(offset, true));
287:         offset += 2;
288:         VertexIndex.push(dv.getInt16(offset, true));
289:         offset += 2;
290:         VertexIndex.push(dv.getInt16(offset, true));
291:         offset += 2;
292: 
293:         const NormalIndex: [Short, Short, Short, Short] = [] as any;
294:         NormalIndex.push(dv.getInt16(offset, true));
295:         offset += 2;
296:         NormalIndex.push(dv.getInt16(offset, true));
297:         offset += 2;
298:         NormalIndex.push(dv.getInt16(offset, true));
299:         offset += 2;
300:         NormalIndex.push(dv.getInt16(offset, true));
301:         offset += 2;
302: 
303:         const TexCoordIndex: [Short, Short, Short, Short] = [] as any;
304:         TexCoordIndex.push(dv.getInt16(offset, true));
305:         offset += 2;
306:         TexCoordIndex.push(dv.getInt16(offset, true));
307:         offset += 2;
308:         TexCoordIndex.push(dv.getInt16(offset, true));
309:         offset += 2;
310:         TexCoordIndex.push(dv.getInt16(offset, true));
311:         offset += 2;
312: 
313:         const LightMapCoord: BMDTexCoord[] = [new BMDTexCoord()];
314:         LightMapCoord[0].U = dv.getFloat32(offset, true);
315:         offset += 4;
316:         LightMapCoord[0].V = dv.getFloat32(offset, true);
317:         offset += 4;
318: 
319:         const Front = dv.getUint8(offset);
320:         offset += 2;
321: 
322:         const triangle = (mesh.Triangles[j] = new BMDTriangle());
323:         triangle.Polygon = Polygon;
324: 
325:         triangle.VertexIndex = VertexIndex;
326:         triangle.NormalIndex = NormalIndex;
327:         triangle.TexCoordIndex = TexCoordIndex;
328:         triangle.LightMapCoord = LightMapCoord;
329:         triangle.LightMapIndexes = Front;
330:         DataPtr += Size;
