327: /**
328:  * The diffuse textures a GLB was parsed for, grouped by container path: a file
329:  * that names one image on two meshes binds it once. Grouped by path because
330:  * the textures belong to the `AssetContainer` they came out of, and
331:  * `evictContainers` disposes that container - the entries have to go with it.
332:  */
333: const texturesCache: Map<string, Map<string, Texture>> = new Map();
334: 
335: /**
336:  * The model textures' samplers follow the lighting tier (`textureFiltering`).
337:  * The GLBs declare no sampler filter, so the loader builds the mip chain on
338:  * every tier; Classic's nearest mode reads level 0 only.
339:  */
340: function applyTextureFiltering(texture: Texture): void {
341:   const { sampling, anisotropy } = textureFiltering();
342: 
343:   texture.updateSamplingMode(sampling);
344:   texture.anisotropicFilteringLevel = anisotropy;
345: }
346: 
347: function syncTextureFiltering(): void {
348:   for (const byName of texturesCache.values()) {
349:     for (const texture of byName.values()) applyTextureFiltering(texture);
350:   }
351: }
352: 
353: function getTexture(filePath: string, key: string, fallback: Texture) {
354:   let byName = texturesCache.get(filePath);
355: 
356:   if (!byName) {
357:     byName = new Map();
358:     texturesCache.set(filePath, byName);
359:   }
360: 
361:   const cached = byName.get(key);
362:   if (cached) return cached;
363: 
364:   fallback.isBlocking = true;
365:   applyTextureFiltering(fallback);
366: 
367:   byName.set(key, fallback);
368: 
369:   return fallback;
370: }
