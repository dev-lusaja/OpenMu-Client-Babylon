  1: import { t, type TextKey } from '../i18n';
  2: import type { Item } from '../ecs/world';
  3: import {
  4:   ItemGroup,
  5:   classCanUse,
  6:   classUnrestricted,
  7:   isArmorPart,
  8:   isCapeOfFighter,
  9:   isCapeOfLord,
 10:   isFirstWing,
 11:   isJewel,
 12:   isPendant,
 13:   isRing,
 14:   isScepter,
 15:   isSecondWing,
 16:   isShield,
 17:   isStaff,
 18:   isSummonerBook,
 19:   isThirdWing,
 20:   isWeapon,
 21:   isWing,
 22:   itemStats,
 23:   type HeroStats,
 24:   type ItemDef,
 25:   type ItemStats,
 26: } from './itemStats';
 27: import { itemBaseName } from './itemsDatabase';
 28: import { learnableSkill } from './skillItems';
 29: import { skillDisplayName } from './skillNames';
 30: 
 31: /**
 32:  * `RenderItemInfo` (ZzzInventory.cpp:2091) as data: the tooltip is a list
 33:  * of coloured lines, blank lines being half-height spacers, drawn by
 34:  * `RenderTipTextList`. Only the paths the clone can reach are ported - the
 35:  * generic equipment block, wings, jewels and the option/excellent lines;
 36:  * event items and pets fall back to their name.
 37:  *
 38:  * `GlobalText` is not available here (Text.bmd is encoded), so the English
 39:  * strings are written out inline.
 40:  */
 41: 
 42: /** `TEXT_COLOR_*` (_define.h:219) as the tooltip renders them. */
 43: export type TooltipColor =
 44:   | 'white'
 45:   | 'blue'
 46:   | 'red'
 47:   | 'yellow'
 48:   | 'green'
 49:   | 'darkRed'
 50:   | 'purple'
 51:   | 'darkBlue'
 52:   | 'darkYellow'
 53:   | 'greenBlue'
 54:   | 'gray'
 55:   | 'redPurple'
 56:   | 'violet'
 57:   | 'orange';
 58: 
 59: /**
 60:  * The `(+N)` / `(-N)` tail a line grows when the item is being compared with
 61:  * the worn one. Green is the better number, red the worse, which for a
 62:  * requirement means the smaller one.
 63:  */
 64: export type TooltipDelta = {
 65:   text: string;
 66:   color: 'green' | 'red';
 67: };
 68: 
 69: export type TooltipLine = {
 70:   text: string;
 71:   color: TooltipColor;
 72:   bold: boolean;
 73:   /** A `"\n"` entry: half a line of space. */
 74:   blank?: true;
 75:   delta?: TooltipDelta;
 76: };
 77: 
 78: export type ItemTooltipData = {
 79:   lines: TooltipLine[];
 80:   /** Every requirement and the class gate pass for the hero. */
 81:   usable: boolean;
 82: };
 83: 
 84: const CLASS_NAME_KEYS: readonly (readonly [TextKey, TextKey, TextKey])[] = [
 85:   ['class.darkWizard', 'class.soulMaster', 'class.grandMaster'],
 86:   ['class.darkKnight', 'class.bladeKnight', 'class.bladeMaster'],
 87:   ['class.fairyElf', 'class.museElf', 'class.highElf'],
 88:   ['class.magicGladiator', 'class.magicGladiator', 'class.duelMaster'],
 89:   ['class.darkLord', 'class.darkLord', 'class.lordEmperor'],
 90:   ['class.summoner', 'class.bloodySummoner', 'class.dimensionMaster'],
 91:   // No second class, so step 2 falls back to the first name, as MG and DL do.
 92:   ['class.rageFighter', 'class.rageFighter', 'class.fistMaster'],
 93: ];
 94: 
 95: const RESISTANCE_NAME_KEYS: readonly TextKey[] = [
 96:   'element.ice',
 97:   'element.poison',
 98:   'element.lightning',
 99:   'element.fire',
100:   'element.earth',
101:   'element.wind',
102:   'element.water',
103: ];
104: 
105: class Lines {
106:   readonly list: TooltipLine[] = [];
107: 
108:   add(
109:     text: string,
110:     color: TooltipColor = 'white',
111:     bold = false,
112:     delta?: TooltipDelta
113:   ) {
114:     this.list.push(delta ? { text, color, bold, delta } : { text, color, bold });
115:   }
116: 
117:   blank() {
118:     // The original never stacks two spacers back to back.
119:     if (this.list.at(-1)?.blank) return;
120:     this.list.push({ text: '', color: 'white', bold: false, blank: true });
121:   }
122: }
123: 
124: /** The first block of `RenderItemInfo`: which colour the name line takes. */
125: function nameColor(item: Item, def: ItemDef, level: number): TooltipColor {
126:   const optionLevel = item.optionLevel ?? 0;
127: 
128:   if (isJewel(def)) return 'yellow';
129:   if (item.isAncient) return 'greenBlue';
130:   if ((item.socketCount ?? 0) > 0) return 'violet';
131:   if (isWing(def)) {
132:     if (level >= 7) return 'yellow';
133:     return optionLevel > 0 ? 'blue' : 'white';
134:   }
135:   if (optionLevel > 0 && item.isExcellent) return 'green';
136:   if (level >= 7) return 'yellow';
137:   return optionLevel > 0 ? 'blue' : 'white';
138: }
139: 
140: function nameLine(item: Item, def: ItemDef, level: number): string {
141:   let name = itemBaseName(def.group, def.index) || def.name;
142:   if (item.isExcellent) name = t('item.excellentPrefix', { name });
143:   return level > 0 ? `${name} +${level}` : name;
144: }
145: 
146: /**
147:  * The first tooltip line on its own, for the message boxes that name an
148:  * item ("Asking price for Excellent Dragon Armour +9").
149:  */
150: export function itemDisplayName(item: Item): string {
151:   const stats = itemStats(item);
152:   if (!stats) return t('item.thisItem');
153:   return nameLine(item, stats.def, stats.level);
154: }
155: 
156: /** `CalcExcellentOptions` order and `GetSpecialOptionText` wording. */
157: function excellentLines(out: Lines, def: ItemDef, flags: number, heroLevel: number) {
158:   const armorLike = isShield(def) || isArmorPart(def) || isRing(def);
159:   const weaponLike = isWeapon(def) || isPendant(def);
160: 
161:   if (armorLike) {
162:     if (flags & 0x20) out.add(t('item.exc.maxLife'), 'blue');
163:     if (flags & 0x10) out.add(t('item.exc.maxMana'), 'blue');
164:     if (flags & 0x08) out.add(t('item.exc.damageDecrease'), 'blue');
165:     if (flags & 0x04) out.add(t('item.exc.reflect'), 'blue');
166:     if (flags & 0x02) out.add(t('item.exc.defenseRate'), 'blue');
167:     if (flags & 0x01) out.add(t('item.exc.zen'), 'blue');
168:   }
169: 
170:   if (weaponLike) {
171:     const magic =
172:       isStaff(def) ||
173:       (def.group === ItemGroup.Helper &&
174:         [12, 25, 26].includes(def.index)); // Lightning / Ice / Water pendants
175:     const kind = t(magic ? 'item.kind.wizardry' : 'item.kind.damage');
176: 
177:     if (flags & 0x20) out.add(t('item.exc.excellentDamage'), 'blue');
178:     if (flags & 0x10) {
179:       out.add(
180:         t('item.exc.perLevel', { kind, value: Math.trunc(heroLevel / 20) }),
181:         'blue'
182:       );
183:     }
184:     if (flags & 0x08) out.add(t('item.exc.percent', { kind }), 'blue');
185:     if (flags & 0x04) out.add(t('item.exc.speed'), 'blue');
186:     if (flags & 0x02) out.add(t('item.exc.life'), 'blue');
187:     if (flags & 0x01) out.add(t('item.exc.mana'), 'blue');
188:   }
189: }
190: 
191: const signed = (value: number) => (value > 0 ? `+${value}` : `${value}`);
192: 
193: /**
194:  * The tail for one number against the worn item's. `lowerIsBetter` for the
195:  * requirement lines, where needing less is the upgrade.
196:  */
197: export function statDelta(
198:   now: number,
199:   before: number | undefined,
200:   lowerIsBetter = false
201: ): TooltipDelta | undefined {
202:   if (before === undefined) return undefined;
203:   const diff = now - before;
204:   if (diff === 0) return undefined;
205:   const better = lowerIsBetter ? diff < 0 : diff > 0;
206:   return { text: `(${signed(diff)})`, color: better ? 'green' : 'red' };
207: }
208: 
209: /** Both ends of the damage range in one tail: `(+3 / +5)`. */
210: export function damageDelta(
211:   min: number,
212:   max: number,
213:   before: { damageMin: number; damageMax: number } | undefined
214: ): TooltipDelta | undefined {
215:   if (!before) return undefined;
216:   const low = min - before.damageMin;
217:   const high = max - before.damageMax;
218:   if (low === 0 && high === 0) return undefined;
219: 
220:   const total = low + high;
221:   const better = total !== 0 ? total > 0 : high > 0;
222:   return {
223:     text:
224:       low === high
225:         ? `(${signed(low)})`
226:         : `(${signed(low)} / ${signed(high)})`,
227:     color: better ? 'green' : 'red',
228:   };
229: }
230: 
231: function requirementLine(
232:   out: Lines,
233:   labelKey: TextKey,
234:   required: number,
235:   have: number,
236:   before?: number
237: ) {
238:   if (!required) return;
239:   const label = t(labelKey);
240:   const line = t('item.required', { label, value: required });
241:   const delta = statDelta(required, before, true);
242:   if (have < required) {
243:     out.add(line, 'red', false, delta);
244:     out.add(t('item.moreNeeded', { value: required - have }), 'red');
245:   } else {
246:     out.add(line, 'white', false, delta);
247:   }
248: }
249: 
250: /** `RequireClass` (ZzzInventory.cpp:604). */
251: function classLines(out: Lines, def: ItemDef, hero: HeroStats) {
252:   if (classUnrestricted(def)) return;
253:   if (def.classes.every(value => value === 0)) return;
254: 
255:   out.blank();
256:   def.classes.forEach((required, index) => {
257:     if (required === 0) return;
258:     const usable =
259:       index === hero.baseClass && required <= hero.stepClass;
260:     const name = t(CLASS_NAME_KEYS[index][Math.min(3, required) - 1]);
261:     out.add(t('item.canBeEquippedBy', { name }), usable ? 'white' : 'darkRed');
262:   });
263: }
264: 
265: function wingLines(out: Lines, def: ItemDef, level: number) {
266:   if (isFirstWing(def)) {
267:     out.add(t('item.increaseDamage', { value: 12 + level * 2 }));
268:     out.add(t('item.absorbDamage', { value: 12 + level * 2 }));
269:     out.add(t('item.ableToFly'));
270:   } else if (isSecondWing(def)) {
271:     out.add(t('item.increaseDamage', { value: 32 + level }));
272:     out.add(t('item.absorbDamage', { value: 25 + level * 2 }));
273:     out.add(t('item.ableToFly'));
274:   } else if (isThirdWing(def)) {
275:     out.add(t('item.increaseDamage', { value: 39 + level * 2 }));
276:     // Cape of Emperor / Overrule absorb less.
277:     const absorb = def.index === 40 || def.index === 50 ? 24 : 39;
278:     out.add(t('item.absorbDamage', { value: absorb + level * 2 }));
279:     out.add(t('item.ableToFly'));
280:   } else if (isCapeOfLord(def) || isCapeOfFighter(def)) {
281:     out.add(t('item.increaseDamage', { value: 20 + level * 2 }));
282:     const absorb = isCapeOfFighter(def) ? 10 + level * 2 : 10 + level;
283:     out.add(t('item.absorbDamage', { value: absorb }));
284:   }
285: }
286: 
287: function jewelLines(out: Lines, def: ItemDef) {
288:   if (def.group === ItemGroup.Potion) {
289:     switch (def.index) {
290:       case 13:
291:         out.add(t('item.raiseLevel6'));
292:         return;
293:       case 14:
294:         out.add(t('item.raiseLevel9'));
295:         return;
296:       case 16:
297:         out.add(t('item.addOption'));
298:         return;
299:       case 22:
300:         out.add(t('item.createFruit'));
301:         return;
302:       case 31:
303:         out.add(t('item.addGuardian'));
304:         return;
305:     }
306:   }
307:   if (def.group === ItemGroup.Wing && def.index === 15) {
308:     out.add(t('item.chaosCombination'));
309:   }
310: }
311: 
312: /** Potions, scrolls and orbs: one line of what they do. */
313: function consumableLines(out: Lines, def: ItemDef, item: Item) {
314:   if (def.group === ItemGroup.Potion) {
315:     const count = item.durability ?? 0;
316:     if (def.index <= 3) out.add(t('item.restoresHp', { count }));
317:     else if (def.index >= 4 && def.index <= 6) out.add(t('item.restoresMp', { count }));
318:     else if (def.index === 8) out.add(t('item.curesPoison', { count }));
319:     else if (def.index === 9) out.add(t('item.liquor', { count }));
320:     else if (def.index === 10) out.add(t('item.townScroll', { count }));
321:     return;
322:   }
323:   // Orbs, scrolls and crystals name the skill they teach.
324:   const taught = learnableSkill(item);
325:   const skill = taught === undefined ? undefined : skillDisplayName(taught);
326:   if (skill) out.add(t('item.learns', { skill }), 'blue');
327: }
328: 
329: /**
330:  * Builds the tooltip for `item` as seen by `hero`. `compareWith` is the worn
331:  * item of the slot this one would take: its numbers become the `(+N)` tails
332:  * on the lines the two share. The worn item's own tooltip is this same
333:  * builder called without it.
334:  */
335: export function buildItemTooltip(
336:   item: Item,
337:   hero: HeroStats,
338:   compareWith?: Item | null
339: ): ItemTooltipData | null {
340:   const stats = itemStats(item);
341:   if (!stats) return null;
342: 
343:   const { def, level } = stats;
344:   const out = new Lines();
345:   const worn = compareWith ? itemStats(compareWith) : null;
346: 
347:   out.blank();
348:   out.add(nameLine(item, def, level), nameColor(item, def, level), true);
349:   out.blank();
350: 
351:   equipmentLines(out, item, stats, hero, worn);
352: 
353:   const requirementsFail =
354:     hero.level < stats.reqLvl ||
355:     hero.str < stats.reqStr ||
356:     hero.agi < stats.reqAgi ||
357:     hero.vit < stats.reqVit ||
358:     hero.ene < stats.reqEne ||
359:     hero.cmd < stats.reqCmd;
360: 
361:   return {
362:     lines: trimBlanks(out.list),
363:     usable: !requirementsFail && classCanUse(def, hero),
364:   };
365: }
366: 
367: function equipmentLines(
368:   out: Lines,
369:   item: Item,
370:   stats: ItemStats,
371:   hero: HeroStats,
372:   worn: ItemStats | null = null
373: ) {
374:   const { def, level, isExcellent } = stats;
375: 
376:   // Attack power
377:   if (def.damageMin) {
378:     const label = t(
379:       def.group === ItemGroup.Etc
380:         ? 'item.attackPower'
381:         : def.twoHand
382:           ? 'item.attackPowerTwoHand'
383:           : 'item.attackPowerOneHand'
384:     );
385:     const min = stats.damageMin;
386:     const max = stats.damageMax;
387:     out.add(
388:       t('item.damageRange', { label, min: min >= max ? max : min, max }),
389:       isExcellent ? 'blue' : 'white',
390:       false,
391:       damageDelta(min, max, worn ?? undefined)
392:     );
393:   }
394: 
395:   if (stats.defense) {
396:     out.add(
397:       t('item.defense', { value: stats.defense }),
398:       isArmorPart(def) && isExcellent ? 'blue' : 'white',
399:       false,
400:       statDelta(stats.defense, worn?.defense)
401:     );
402:   }
403: 
404:   if (def.blocking) {
405:     out.add(
406:       t('item.defenseRate', { value: stats.blocking }),
407:       isExcellent ? 'blue' : 'white',
408:       false,
409:       statDelta(stats.blocking, worn?.blocking)
410:     );
411:   }
412: 
413:   if (def.speed) {
414:     out.add(
415:       t('item.attackSpeed', { value: def.speed }),
416:       'white',
417:       false,
418:       statDelta(def.speed, worn?.def.speed)
419:     );
420:   }
421: 
422:   wingLines(out, def, level);
423:   jewelLines(out, def);
424:   consumableLines(out, def, item);
425: 
426:   // Durability: gear, wings and helpers show current/max.
427:   const hasDurability =
428:     (def.durability || def.magicDur) &&
429:     (def.group <= ItemGroup.Boots || def.group === ItemGroup.Helper || isWing(def));
430:   if (hasDurability) {
431:     out.add(
432:       t('item.durability', {
433:         current: item.durability ?? stats.maxDurability,
434:         max: stats.maxDurability,
435:       }),
436:       'white',
437:       false,
438:       statDelta(stats.maxDurability, worn?.maxDurability)
439:     );
440:   }
441: 
442:   def.resistances.forEach((value, index) => {
443:     if (value) {
444:       out.add(
445:         t('item.resistance', {
446:           element: t(RESISTANCE_NAME_KEYS[index]),
447:           value: level + 1,
448:         })
449:       );
450:     }
451:   });
452: 
453:   requirementLine(out, 'common.level', stats.reqLvl, hero.level, worn?.reqLvl);
454:   requirementLine(out, 'stat.strength', stats.reqStr, hero.str, worn?.reqStr);
455:   requirementLine(out, 'stat.agility', stats.reqAgi, hero.agi, worn?.reqAgi);
456:   requirementLine(out, 'stat.vitality', stats.reqVit, hero.vit, worn?.reqVit);
457:   requirementLine(out, 'stat.energy', stats.reqEne, hero.ene, worn?.reqEne);
458:   requirementLine(out, 'stat.command', stats.reqCmd, hero.cmd, worn?.reqCmd);
459: 
460:   if (def.group !== ItemGroup.Potion && !isJewel(def)) {
461:     classLines(out, def, hero);
462:   }
463: 
464:   if (def.group === ItemGroup.Boots && level >= 5) {
465:     out.blank();
466:     out.add(t('item.defenseRateUp'), 'blue', true);
467:   }
468:   if (def.group === ItemGroup.Gloves && level >= 5) {
469:     out.blank();
470:     out.add(t('item.attackRateUp'), 'blue', true);
471:   }
472: 
473:   if (isStaff(def)) {
474:     out.blank();
475:     const label = t(
476:       isSummonerBook(def) ? 'item.curseIncrease' : 'item.wizardryIncrease'
477:     );
478:     out.add(
479:       t('item.percentBonus', { label, value: stats.magicPower }),
480:       'blue',
481:       true,
482:       statDelta(stats.magicPower, worn?.magicPower)
483:     );
484:   } else if (isScepter(def) && def.magicPower) {
485:     out.blank();
486:     out.add(
487:       t('item.petAttackIncrease', { value: stats.magicPower }),
488:       'blue',
489:       true,
490:       statDelta(stats.magicPower, worn?.magicPower)
491:     );
492:   }
493: 
494:   // Options (`RenderDefaultOptionText`), skill, luck, excellent.
495:   const optionLevel = item.optionLevel ?? 0;
496:   const excellentFlags = item.excellentFlags ?? (item.isExcellent ? 0 : 0);
497:   const hasOptions =
498:     optionLevel > 0 || item.luck || item.hasSkill || excellentFlags > 0;
499: 
500:   if (hasOptions) out.blank();
501: 
502:   if (item.hasSkill) {
503:     const skill = skillDisplayName(def.skill);
504:     out.add(skill ? t('item.skillNamed', { skill }) : t('item.skill'), 'blue');
505:   }
506: 
507:   if (item.luck) {
508:     out.add(t('item.luckSoul'), 'blue');
509:     out.add(t('item.luckCritical'), 'blue');
510:   }
511: 
512:   if (optionLevel > 0) {
513:     const bonus = optionLevel * 4;
514:     if (isStaff(def)) out.add(t('item.additionalWizardry', { value: bonus }), 'blue');
515:     else if (isWeapon(def)) out.add(t('item.additionalDamage', { value: bonus }), 'blue');
516:     else out.add(t('item.additionalDefense', { value: bonus }), 'blue');
517:   }
518: 
519:   if (excellentFlags > 0) {
520:     excellentLines(out, def, excellentFlags, hero.level);
521:   }
522: 
523:   if (item.isAncient) {
524:     out.blank();
525:     const bonus = item.ancientBonusLevel ?? 0;
526:     out.add(
527:       bonus > 0
528:         ? t('item.ancientBonus', { value: bonus * 5 })
529:         : t('item.ancient'),
530:       'greenBlue'
531:     );
532:   }
533: }
534: 
535: function trimBlanks(lines: TooltipLine[]): TooltipLine[] {
536:   let start = 0;
537:   let end = lines.length;
538:   while (start < end && lines[start].blank) start++;
539:   while (end > start && lines[end - 1].blank) end--;
540:   return lines.slice(start, end);
541: }
