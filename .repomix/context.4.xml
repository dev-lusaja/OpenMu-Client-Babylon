 27: const on = (note: number, dt = 0): BandMidiEvent => ({ dt, status: 0x90, d1: note, d2: 100 });
 28: 
 29: describe('band protocol', () => {
 30:   it('round-trips every client frame', () => {
 31:     expect(decodeClientFrame(encodeStart(2))).toEqual({ sub: BandSub.Start, version: 1, instrument: 2 });
 32:     expect(decodeClientFrame(encodeStop())).toEqual({ sub: BandSub.Stop });
 33:     expect(decodeClientFrame(encodeJoin(0x1234, 1, 0b1010))).toEqual({ sub: BandSub.Join, masterId: 0x1234, instrument: 1, mask: 0b1010 });
 34:     expect(decodeClientFrame(encodeLeave())).toEqual({ sub: BandSub.Leave });
 35: 
 36:     const batch = encodeBatch(65535, 123456789, [on(60), on(62, 100), { dt: 1000, status: 0xb0, d1: 123, d2: 0 }]);
 37:     expect(decodeClientFrame(batch)).toEqual({
 38:       sub: BandSub.Batch,
 39:       seq: 65535,
 40:       baseMs: 123456789,
 41:       events: [on(60), on(62, 100), { dt: 1000, status: 0xb0, d1: 123, d2: 0 }],
 42:     });
 43: 
 44:     const members = [
 45:       { id: 5, instrument: 0, mask: 0b11 },
 46:       { id: 6, instrument: 2, mask: 0b100 },
 47:     ];
 48:     expect(decodeClientFrame(encodeBandState(0xfff8, members))).toEqual({ sub: BandSub.BandState, masterMask: 0xfff8, members });
 49: 
 50:     const names = [
 51:       { channel: 0, name: 'Lead' },
 52:       { channel: 9, name: 'Drums' },
 53:     ];
 54:     expect(decodeClientFrame(encodeChannelNames(names))).toEqual({ sub: BandSub.ChannelNames, names });
 55:   });
 56: 
 57:   it('keeps every frame inside a C1', () => {
 58:     const full = Array.from({ length: BAND_LIMITS.maxEventsPerBatch }, (_, i) => on(40 + i, i * 10));
 59:     const batch = encodeBatch(1, 0, full);
 60:     expect(batch.length).toBe(11 + 5 * 48);
 61:     expect(batch[1]).toBe(batch.length);
 62:     expect(stampPerformer(batch, 1).length).toBe(253);
 63:     expect(() => encodeBatch(1, 0, [...full, on(99)])).toThrow();
 64:     expect(() => encodeBatch(1, 0, [])).toThrow();
 65: 
 66:     const longNames = Array.from({ length: 16 }, (_, c) => ({ channel: c, name: 'x'.repeat(40) }));
 67:     const framed = encodeChannelNames(longNames);
 68:     expect(framed.length).toBeLessThanOrEqual(4 + BAND_LIMITS.maxChannelNamesBytes);
 69:     expect(decodeClientFrame(framed)).not.toBeNull();
 70:   });
 71: 
 72:   it('rejects what a proxy should drop', () => {
 73:     const batch = encodeBatch(1, 0, [on(60)]);
 74:     const wrongLen = new Uint8Array(batch);
 75:     wrongLen[1] = batch.length - 1;
 76:     expect(decodeClientFrame(wrongLen)).toBeNull();
 77: 
 78:     const badStatus = new Uint8Array(batch);
 79:     badStatus[13] = 0x7f;
 80:     expect(decodeClientFrame(badStatus)).toBeNull();
 81:     badStatus[13] = 0xf0;
 82:     expect(decodeClientFrame(badStatus)).toBeNull();
 83: 
 84:     const badData = new Uint8Array(batch);
 85:     badData[14] = 0x80;
 86:     expect(decodeClientFrame(badData)).toBeNull();
 87: 
 88:     const badDt = new Uint8Array(batch);
 89:     badDt[11] = 0x04;
 90:     badDt[12] = 0x00;
 91:     expect(decodeClientFrame(badDt)).toBeNull();
 92: 
 93:     expect(decodeClientFrame(new Uint8Array([0xc1, 4, 0xfa, 0x42]))).toBeNull();
 94:     expect(decodeClientFrame(new Uint8Array([0xc2, 0, 5, 0xfa, 0x02]))).toBeNull();
 95:     expect(decodeClientFrame(new Uint8Array([0xc1, 5, 0xfa, 0x02, 0]))).toBeNull();
 96: 
 97:     const eight = Array.from({ length: 8 }, (_, i) => ({ id: i, instrument: 0, mask: 1 }));
 98:     expect(() => encodeBandState(0, eight)).toThrow();
 99:   });
100: 
101:   it('stamps the performer in and reads it back', () => {
102:     const batch = encodeBatch(7, 4200, [on(64, 30)]);
103:     const relayed = stampPerformer(batch, 0x8123 & 0x7fff);
104:     expect(relayed[1]).toBe(batch.length + 2);
105:     expect(decodeRelayFrame(relayed)).toEqual({
106:       sub: BandSub.Batch,
107:       performerId: 0x0123,
108:       seq: 7,
109:       baseMs: 4200,
110:       events: [on(64, 30)],
111:     });
112:     expect(decodeRelayFrame(stampPerformer(encodeStart(1), 9))).toEqual({ sub: BandSub.Start, performerId: 9, version: 1, instrument: 1 });
113:     expect(decodeRelayFrame(stampPerformer(encodeJoin(3, 2, 1), 9))).toEqual({ sub: BandSub.Join, performerId: 9, masterId: 3, instrument: 2, mask: 1 });
114:   });
115: 
116:   it('round-trips the proxy-originated frames', () => {
117:     expect(decodeRelayFrame(encodeHello())).toEqual({ sub: BandSub.Hello, performerId: 0, version: 1 });
118:     expect(decodeRelayFrame(encodeStopNotice(12, StopReason.Flood))).toEqual({ sub: BandSub.Stop, performerId: 12, reason: 1, arg: 0 });
119:     expect(decodeRelayFrame(encodeRefused(12, RefuseWhat.Start, RefuseCause.Cooldown, 9))).toEqual({
120:       sub: BandSub.Refused,
121:       performerId: 12,
122:       what: 1,
123:       cause: 1,
124:       arg: 9,
125:     });
126:     expect(decodeRelayFrame(encodeLeaveNotice(12))).toEqual({ sub: BandSub.Leave, performerId: 12 });
127:   });
128: 
129:   it('is recognised on the wire before decryption, and decodes after it', () => {
130:     const plain = encodeBatch(1, 0, [on(60)]);
131:     const wire = new Uint8Array(plain);
132:     new Xor32Encryptor().Encrypt(wire);
133:     expect(isBandFrame(wire)).toBe(true);
134:     expect(wire[3]).not.toBe(plain[3]);
135: 
136:     const copy = new Uint8Array(wire);
137:     new Xor32Decryptor().Decrypt(copy);
138:     expect(decodeClientFrame(copy)).toEqual(decodeClientFrame(plain));
139:   });
140: });
