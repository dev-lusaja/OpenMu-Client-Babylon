220: /** A fixed flare at `position`, sized by the object's own scale. */
221: export async function createEffectLight(
222:   scene: Scene,
223:   spec: FlareSpec,
224:   position: { x: number; y: number; z: number },
225:   objectScale: number
226: ): Promise<EffectLight | null> {
227:   const spriteManager = await getManager(scene);
228: 
229:   if (!spriteManager || manager !== spriteManager) return null;
230: 
231:   const sprite = new Sprite('effectLight', spriteManager);
232: 
233:   sprite.position.set(position.x, position.y, position.z);
234:   sprite.isPickable = false;
235: 
236:   const size = (FLARE_SIZE_PX * spec.scale * objectScale) / TILE_CM;
237:   sprite.width = size;
238:   sprite.height = size;
239: 
240:   const paint = paintFlare(sprite, spec.color);
241: 
242:   let observer: ReturnType<Scene['onBeforeRenderObservable']['add']> | null =
243:     null;
244: 
245:   if (spec.pulse) {
246:     const { speed, amount, base } = spec.pulse;
247: 
248:     let elapsed = 0;
249: 
250:     observer = scene.onBeforeRenderObservable.add(() => {
251:       elapsed += scene.getEngine().getDeltaTime();
252: 
253:       paint.setLuminosity((Math.sin(elapsed * speed) + 1) * amount + base);
254:     });
255:   }
256: 
257:   return {
258:     dispose: () => {
259:       if (observer) scene.onBeforeRenderObservable.remove(observer);
260:       paint.release();
261:       sprite.dispose();
262:     },
263:   };
264: }
</file>

