 99: /** Keys that cannot be bound: they already mean something else. */
100: const RESERVED = new Set([
101:   'Escape',
102:   'Enter',
103:   'NumpadEnter',
104:   'AltLeft',
105:   'AltRight',
106:   'ControlLeft',
107:   'ControlRight',
108:   'ShiftLeft',
109:   'ShiftRight',
110:   'MetaLeft',
111:   'MetaRight',
112:   // Potion bar and skill slots are printed on the bottom bar.
113:   'KeyQ',
114:   'KeyW',
115:   'KeyE',
116:   'KeyR',
117:   ...Array.from({ length: 10 }, (_, i) => `Digit${i}`),
118:   ...Array.from({ length: 10 }, (_, i) => `Numpad${i}`),
119: ]);
120: 
121: export function isReservedKey(code: string): boolean {
122:   return RESERVED.has(code);
123: }
124: 
125: /**
126:  * The four walk keys, live while the `wsadMovement` option is on. Not
127:  * rebindable: they are the layout every game that walks on a keyboard uses,
128:  * and the option itself is the way out of them.
129:  */
130: export const WALK_KEYS = {
131:   forward: 'KeyW',
132:   back: 'KeyS',
133:   left: 'KeyA',
134:   right: 'KeyD',
135: } as const;
136: 
137: export const WALK_KEY_CODES: ReadonlySet<string> = new Set(
138:   Object.values(WALK_KEYS)
139: );
140: 
141: type Listener = (bindings: KeyBindings) => void;
142: 
143: const listeners = new Set<Listener>();
144: 
145: /**
146:  * Whose bindings are live: a character name, or '' for the shared set every
147:  * character starts from. A Summoner and a Blade Knight want different keys,
148:  * and before this they fought over one file.
149:  */
150: let profile = '';
151: 
152: function storageKeyOf(name: string): string {
153:   return name ? `${KEYS_STORAGE_KEY}:${name}` : KEYS_STORAGE_KEY;
154: }
155: 
156: function readStored(name: string): Partial<KeyBindings> | null {
157:   const stored = LocalStorage.load(storageKeyOf(name));
158:   if (!stored) return null;
159:   try {
160:     return JSON.parse(stored) as Partial<KeyBindings>;
161:   } catch {
162:     return null;
163:   }
164: }
165: 
166: function load(): KeyBindings {
167:   // The character's own set if it has one, else the shared one.
168:   const parsed = (profile ? readStored(profile) : null) ?? readStored('');
169:   if (!parsed) return { ...DEFAULTS };
170: 
171:   try {
172:     const loaded = { ...DEFAULTS };
173:     for (const action of KEY_ACTIONS) {
174:       const code = parsed[action];
175:       if (typeof code === 'string' && code && !RESERVED.has(code)) {
176:         loaded[action] = code;
177:       }
178:     }
179:     return loaded;
180:   } catch {
181:     return { ...DEFAULTS };
182:   }
183: }
184: 
185: /** The live bindings; observable so the Keys tab re-renders on a rebind. */
186: export const KeyBindings: KeyBindings = makeAutoObservable(load());
187: 
188: function save(): void {
189:   LocalStorage.save(storageKeyOf(profile), JSON.stringify(KeyBindings));
190:   for (const listener of listeners) listener(KeyBindings);
191: }
192: 
193: /**
194:  * Switch to a character's own bindings (or back to the shared set with an
195:  * empty name). Called when a character enters the world.
196:  */
197: export function setKeyProfile(name: string): void {
198:   if (profile === name) return;
199:   profile = name;
200:   runInAction(() => Object.assign(KeyBindings, load()));
201:   for (const listener of listeners) listener(KeyBindings);
202: }
203: 
204: /** The character whose bindings are live, '' for the shared set. */
205: export function keyProfile(): string {
206:   return profile;
207: }
208: 
209: /** The code bound to `action`. */
210: export function keyFor(action: KeyAction): string {
211:   return KeyBindings[action];
212: }
213: 
214: /** Whether `code` is the key bound to `action`. */
215: export function isKey(action: KeyAction, code: string): boolean {
216:   return code !== '' && KeyBindings[action] === code;
217: }
218: 
219: /** The action `code` is bound to, if any. */
220: export function actionOfKey(code: string): KeyAction | null {
221:   if (code === '') return null;
222:   for (const action of KEY_ACTIONS) {
223:     if (KeyBindings[action] === code) return action;
224:   }
225:   return null;
226: }
227: 
228: /**
229:  * Binds `code` to `action`. Another action already on that key is swapped
230:  * onto the old key so no action is left without one. Returns false when the
231:  * key is reserved.
232:  */
233: export function setKeyBinding(action: KeyAction, code: string): boolean {
234:   if (RESERVED.has(code)) return false;
235:   const previous = KeyBindings[action];
236:   if (previous === code) return true;
237: 
238:   const other = actionOfKey(code);
239:   runInAction(() => {
240:     if (other) KeyBindings[other] = previous;
241:     KeyBindings[action] = code;
242:   });
243: 
244:   save();
245:   return true;
246: }
247: 
248: export function resetKeyBindings(): void {
249:   runInAction(() => Object.assign(KeyBindings, DEFAULTS));
250:   save();
251: }
252: 
253: export function onKeyBindingsChanged(listener: Listener): () => void {
254:   listeners.add(listener);
255:   return () => listeners.delete(listener);
256: }
257: 
258: /**
259:  * Set while the Options window waits for the next key press to rebind; the
260:  * keyboard system stops broadcasting hot keys meanwhile.
261:  */
262: let capturing = false;
263: 
264: export function isCapturingKey(): boolean {
265:   return capturing;
266: }
267: 
268: export function setCapturingKey(value: boolean): void {
269:   capturing = value;
270: }
