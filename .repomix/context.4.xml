<file path="src/common/inventoryLayout.ts">
  1: import { ItemsDatabase } from './itemsDatabase';
  2: import {
  3:   isArmorPart,
  4:   isJewel,
  5:   isPendant,
  6:   isRing,
  7:   isShield,
  8:   isWeapon,
  9:   isWing,
 10:   itemDef,
 11: } from './itemStats';
 12: import type { Item } from '../ecs/world';
 13: 
 14: /**
 15:  * The packing behind the inventory's auto-arrange (`inventorySort.ts`):
 16:  * where every item would sit if the grid were laid out from scratch.
 17:  *
 18:  * Kept apart from the run itself because this half is pure - a list of
 19:  * occupied squares in, a slot per item out - so it can be reasoned about
 20:  * (and tested) without a store, a socket or a server.
 21:  */
 22: 
 23: export type Square = { slot: number; item: Item; w: number; h: number };
 24: 
 25: /** Grid footprint of an item, from its Item.txt row. */
 26: export function itemSquares(item: Item): { w: number; h: number } {
 27:   const config = ItemsDatabase.getItem(item.group, item.num);
 28:   return { w: config?.X ?? 1, h: config?.Y ?? 1 };
 29: }
 30: 
 31: /** `ITEM_GROUP_POTION`: the stacks that grow and shrink as you play. */
 32: const POTION_GROUP = 14;
 33: 
 34: /** Kinds in the order they are packed: what a player looks for, first. */
 35: export function itemCategory(item: Item): number {
 36:   if (item.group === POTION_GROUP) return 5;
 37:   const def = itemDef(item.group, item.num);
 38:   if (!def) return 6;
 39:   if (isJewel(def)) return 0;
 40:   if (isWeapon(def) || isShield(def)) return 1;
 41:   if (isWing(def)) return 2;
 42:   if (isArmorPart(def)) return 3;
 43:   if (isRing(def) || isPendant(def)) return 4;
 44:   return 6;
 45: }
 46: 
 47: /** Big items first inside a kind, so first-fit leaves no holes behind them. */
 48: export function compareSquares(a: Square, b: Square): number {
 49:   const ai = a.item;
 50:   const bi = b.item;
 51:   return (
 52:     itemCategory(ai) - itemCategory(bi) ||
 53:     b.h - a.h ||
 54:     b.w - a.w ||
 55:     ai.group - bi.group ||
 56:     ai.num - bi.num ||
 57:     (bi.lvl ?? 0) - (ai.lvl ?? 0) ||
 58:     a.slot - b.slot
 59:   );
 60: }
 61: 
 62: export function stampSquares(
 63:   used: Uint8Array,
 64:   columns: number,
 65:   rows: number,
 66:   square: number,
 67:   w: number,
 68:   h: number
 69: ): void {
 70:   const column = square % columns;
 71:   const row = (square - column) / columns;
 72:   for (let y = 0; y < h; y++) {
 73:     for (let x = 0; x < w; x++) {
 74:       if (column + x < columns && row + y < rows) {
 75:         used[(row + y) * columns + column + x] = 1;
 76:       }
 77:     }
 78:   }
 79: }
 80: 
 81: export function squareFits(
 82:   used: Uint8Array,
 83:   columns: number,
 84:   rows: number,
 85:   square: number,
 86:   w: number,
 87:   h: number
 88: ): boolean {
 89:   if (square < 0) return false;
 90:   const column = square % columns;
 91:   const row = (square - column) / columns;
 92:   if (column + w > columns || row + h > rows) return false;
 93:   for (let y = 0; y < h; y++) {
 94:     for (let x = 0; x < w; x++) {
 95:       if (used[(row + y) * columns + column + x]) return false;
 96:     }
 97:   }
 98:   return true;
 99: }
100: 
101: /** Where every item wants to end up: first-fit, in `compareSquares` order. */
102: export function planLayout(
103:   squares: readonly Square[],
104:   columns: number,
105:   rows: number,
106:   first: number
107: ): Map<number, number> {
108:   const used = new Uint8Array(columns * rows);
109:   const targets = new Map<number, number>();
110: 
111:   for (const entry of [...squares].sort(compareSquares)) {
112:     for (let square = 0; square < columns * rows; square++) {
113:       if (!squareFits(used, columns, rows, square, entry.w, entry.h)) continue;
114:       stampSquares(used, columns, rows, square, entry.w, entry.h);
115:       targets.set(entry.slot, first + square);
116:       break;
117:     }
118:   }
119: 
120:   return targets;
121: }
</file>

