<file path="src/common/itemSerializer.ts">
  1: import { Item } from '../ecs/world';
  2: import { castToByte } from './utils';
  3: import { PET_GROUP, DARK_HORSE, DARK_RAVEN } from './petConstants';
  4: 
  5: const LuckFlag = 4;
  6: const SkillFlag = 128;
  7: const LevelMask = 0x78;
  8: const OptionLevelLowMask = 0x03;
  9: const OptionLevelHighFlag = 0x40;
 10: const AncientBonusLevelMask = 0b1100;
 11: const AncientDiscriminatorMask = 0b0011;
 12: const AncientMask = AncientBonusLevelMask | AncientDiscriminatorMask;
 13: const ExcellentOptionsMask = 0x3f;
 14: const ItemNumberHighFlag = 0x80;
 15: const NoSocket = 0xff;
 16: const EmptySocket = 0xfe;
 17: 
 18: /** Dark Horse / Dark Raven: their level rides in byte 2, not the level bits. */
 19: function IsTrainablePet(item: Item) {
 20:   return (
 21:     item.group === PET_GROUP &&
 22:     (item.num === DARK_HORSE || item.num === DARK_RAVEN)
 23:   );
 24: }
 25: export class ItemSerializer {
 26:   static readonly NeededSpace = 12;
 27: 
 28:   static SerializeItem(target: Uint8Array, item: Item): number {
 29:     target.fill(0, 0, ItemSerializer.NeededSpace);
 30: 
 31:     target[0] = castToByte(item.num);
 32: 
 33:     const trainablePet = IsTrainablePet(item);
 34:     const itemLevel = trainablePet ? 0 : item.lvl ?? 0;
 35:     target[1] = castToByte((itemLevel << 3) & LevelMask);
 36:     if (item.hasSkill) target[1] |= SkillFlag;
 37:     if (item.luck) target[1] |= LuckFlag;
 38: 
 39:     const optionLevel = item.optionLevel ?? 0;
 40:     target[1] |= optionLevel & OptionLevelLowMask;
 41:     if (optionLevel > 3) target[3] |= OptionLevelHighFlag;
 42: 
 43:     target[2] = castToByte(
 44:       item.durability ?? (trainablePet ? item.lvl ?? 0 : 0)
 45:     );
 46: 
 47:     target[3] |= (item.excellentFlags ?? 0) & ExcellentOptionsMask;
 48: 
 49:     if ((item.num & 0x100) === 0x100) {
 50:       target[3] |= ItemNumberHighFlag;
 51:     }
 52: 
 53:     if (item.isAncient) {
 54:       target[4] = castToByte(
 55:         (((item.ancientBonusLevel ?? 0) << 2) & AncientBonusLevelMask) |
 56:           ((item.ancientDiscriminator ?? 0) & AncientDiscriminatorMask)
 57:       );
 58:     }
 59: 
 60:     target[5] = castToByte(item.group << 4);
 61: 
 62:     target[6] = castToByte(item.socketBonus ?? 0);
 63: 
 64:     const sockets = item.sockets ?? [];
 65:     const socketCount = item.socketCount ?? sockets.length;
 66:     for (let i = 0; i < 5; i++) {
 67:       target[7 + i] =
 68:         i < socketCount ? castToByte(sockets[i] ?? EmptySocket) : NoSocket;
 69:     }
 70: 
 71:     return ItemSerializer.NeededSpace;
 72:   }
 73: 
 74:   /**
 75:    * OpenMU `ItemSerializer.DeserializeItem` (12-byte layout):
 76:    *  0: item number (low byte) · 1: level (bits 3-6), luck (bit 2), skill
 77:    *  (bit 7), option level low bits (0-1) · 2: durability · 3: excellent bits
 78:    *  0-5, option level high bit (0x40), item number high bit (0x80) ·
 79:    *  4: ancient discriminator (bits 0-1) + bonus level (bits 2-3) · 5: group
 80:    *  (high nibble) · 6: socket bonus/380 option · 7-11: sockets (0xFF = none).
 81:    */
 82:   static DeserializeItem(array: Uint8Array): Item {
 83:     const itemNumber = array[0] + ((array[3] & ItemNumberHighFlag) << 1);
 84:     const itemGroup = (array[5] & 0xf0) >> 4;
 85: 
 86: const item: Item = {
 87:       group: itemGroup,
 88:       num: itemNumber,
 89:       raw: Array.from(array.slice(0, ItemSerializer.NeededSpace)),
 90:     };
 91: 
 92:     item.lvl = castToByte((array[1] & LevelMask) >> 3);
 93: 
 94:     item.durability = array[2];
 95: 
 96:     ReadSkillFlag(array[1], item);
 97:     ReadLuckOption(array[1], item);
 98:     ReadNormalOption(array, item);
 99:     ReadExcellentOption(array[3], item);
100:     ReadAncientOption(array[4], item);
101: 
102:     if (array[6] !== 0) item.socketBonus = array[6];
103: 
104:     // Bytes 7–11: socket slots; 0xFF = the item has no slot there.
105:     const sockets: number[] = [];
106:     for (let i = 7; i < ItemSerializer.NeededSpace && i < array.length; i++) {
107:       if (array[i] !== NoSocket) sockets.push(array[i]);
108:     }
109:     item.socketCount = sockets.length;
110:     if (sockets.length > 0) item.sockets = sockets;
111: 
112:     return item;
113:   }
114: }
115: 
116: function ReadSkillFlag(optionByte: number, item: Item) {
117:   if ((optionByte & SkillFlag) == 0) {
118:     return;
119:   }
120: 
121: item.hasSkill = true;
122: }
123: 
124: function ReadLuckOption(optionByte: number, item: Item) {
125:   if ((optionByte & LuckFlag) == 0) {
126:     return;
127:   }
128: 
129:   item.luck = true;
130: }
131: 
132: function ReadExcellentOption(excByte: number, item: Item) {
133:   const excellentBits = excByte & ExcellentOptionsMask;
134:   item.excellentFlags = excellentBits;
135:   item.isExcellent = excellentBits !== 0;
136: }
137: 
138: function ReadNormalOption(array: Uint8Array, item: Item) {
139:   const optionLevel =
140:     (array[1] & OptionLevelLowMask) +
141:     ((array[3] & OptionLevelHighFlag) !== 0 ? 4 : 0);
142:   if (optionLevel == 0) {
143:     return;
144:   }
145: 
146:   item.optionLevel = optionLevel;
147: }
148: 
149: function ReadAncientOption(ancientByte: number, item: Item) {
150:   if ((ancientByte & AncientMask) == 0) {
151:     return;
152:   }
153: 
154:   item.isAncient = true;
155:   item.ancientBonusLevel = (ancientByte & AncientBonusLevelMask) >> 2;
156:   item.ancientDiscriminator = ancientByte & AncientDiscriminatorMask;
157: }
