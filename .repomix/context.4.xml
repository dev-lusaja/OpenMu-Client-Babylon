 735: /** The item-effect uniforms both variants share. */
 736: function addItemUniforms(material: ItemMaterial, scene: Scene) {
 737:   const textures = getChromeTextures(scene);
 738: 
 739:   material.AddUniform(ITEM_FX_UNIFORM, 'float', 0);
 740:   material.AddUniform(SNOW_CAP_UNIFORM, 'float', 0);
 741:   material.AddUniform(SUN_DIR_UNIFORM, 'vec3', null);
 742:   material.AddUniform(SUN_COLOR_UNIFORM, 'vec3', null);
 743:   material.AddUniform(TOON_UNIFORM, 'vec4', null);
 744:   material.AddUniform(TOON_REF_UNIFORM, 'vec2', null);
 745:   material.AddUniform(TOON_FILTER_UNIFORM, 'vec4', null);
 746:   material.AddUniform(TOON_ULTRA_UNIFORM, 'vec4', null);
 747:   material.AddUniform('time', 'float', 0);
 748:   material.AddUniform('chromeColor', 'vec3', null);
 749:   material.AddUniform('chrome2Color', 'vec3', null);
 750:   material.AddUniform('ancientColor', 'vec3', null);
 751:   material.AddUniform('itemGlow', 'vec3', null);
 752:   material.AddUniform(BODY_SHINE_UNIFORM, 'vec3', null);
 753:   material.AddUniform(LIGHT_TINT_UNIFORM, 'float', 0);
 754:   material.AddUniform(CLOUD_NOISE_SAMPLER, 'sampler2D', textures.chrome);
 755:   for (const name of CLOUD_UNIFORMS) material.AddUniform(name, 'vec4', null);
 756:   material.AddUniform('chromeSampler', 'sampler2D', textures.chrome);
 757:   material.AddUniform('shinySampler', 'sampler2D', textures.shiny);
 758:   material.AddUniform('shiny2Sampler', 'sampler2D', textures.shiny2);
 759:   material.AddUniform('chrome2Sampler', 'sampler2D', textures.chrome2);
