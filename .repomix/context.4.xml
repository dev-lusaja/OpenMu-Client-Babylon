  1: /**
  2:  * How a dropped item lies on the ground: `ItemAngle` / `ItemAngleRF`
  3:  * (ZzzObject.cpp:5338 / :5302) plus the resting height `MoveItems` (:6244)
  4:  * snaps it to.
  5:  *
  6:  * The original's item models are all authored standing (that is the pose the
  7:  * inventory and the hand want), so a drop is only ever "lying" because
  8:  * `ItemAngle` pitches it over - armour rolls face-down at `Angle[0] = 270`,
  9:  * a sword leans back at 60, a crossbow lies flat at 90. Without this every
 10:  * drop stands to attention in the grass.
 11:  *
 12:  * `o->Angle` is MU's Z-up (pitch, roll, yaw); `transform.rot` is
 13:  * `(-Angle[0], Angle[2], -Angle[1])` in radians (see common/renderAngles.ts).
 14:  */
 15: 
 16: // ---- 1. tuning ---------------------------------------------------------
 17: 
 18: const DEG = Math.PI / 180;
 19: /** Centimetres per world unit - `MoveItems` works in the original's cm. */
 20: const CM = 1 / 100;
 21: 
 22: /** `ITEM_GROUP_*`: an item's model is `MODEL_ITEM + group × 512 + num`. */
 23: export enum ItemGroup {
 24:   Sword = 0,
 25:   Axe = 1,
 26:   Mace = 2,
 27:   Spear = 3,
 28:   Bow = 4,
 29:   Staff = 5,
 30:   Shield = 6,
 31:   Helm = 7,
 32:   Armor = 8,
 33:   Pants = 9,
 34:   Gloves = 10,
 35:   Boots = 11,
 36:   Wing = 12,
 37:   Helper = 13,
 38:   Potion = 14,
 39:   Etc = 15,
 40: }
 41: 
 42: /**
 43:  * `o->Scale` every drop starts at, and the 0.7 band `MODEL_SPEAR` to
 44:  * `MODEL_PLATINA_STAFF` (`ItemObjectAttribute`, ZzzObject.cpp:5151).
 45:  * `ItemAngle` overrides it for a handful of items; everything else keeps this.
 46:  */
 47: const DROP_SCALE = 0.8;
 48: const LONG_WEAPON_SCALE = 0.7;
 49: /** `MODEL_PLATINA_STAFF = MODEL_STAFF + 13`, the last of the 0.7 band. */
 50: const PLATINA_STAFF = 13;
 51: 
 52: /** `Height = RequestTerrainHeight(...) + 30` for every drop (MoveItems:6250). */
 53: const REST_ABOVE_TERRAIN_CM = 30;
 54: /** `if (Type >= MODEL_SWORD && Type < MODEL_STAFF + MAX_ITEM_INDEX) Height += 40` - a
 55:  *  weapon rests on its guard, not on the model origin. */
 56: const WEAPON_EXTRA_CM = 40;
 57: 
 58: /** `MODEL_CROSSBOW = MODEL_BOW + 8`, `MODEL_CELESTIAL_BOW = MODEL_BOW + 17`. */
 59: const CROSSBOW_FIRST = 8;
 60: const CROSSBOW_LAST = 16;
 61: /** `MODEL_DIVINE_CB_OF_ARCHANGEL = MODEL_BOW + 18` … `MODEL_ARROW_VIPER_BOW = +20`. */
 62: const DIVINE_CROSSBOW_FIRST = 18;
 63: const DIVINE_CROSSBOW_LAST = 19;
 64: /** Arrow Viper / Sylph Wind / Albatross: bows that keep the upright pose. */
 65: const UPRIGHT_BOWS: ReadonlySet<number> = new Set([20, 21, 22]);
 66: /** `MODEL_MISTERY_HELM = MODEL_HELM + 39` … `MODEL_LILIUM_HELM = +44`. */
 67: const BIG_HELM_FIRST = 39;
 68: const BIG_HELM_LAST = 44;
 69: /** `MODEL_SACRED_HELM = MODEL_HELM + 59`, three of them (ItemAngleRF). */
 70: const SACRED_HELM_FIRST = 59;
 71: const SACRED_HELM_LAST = 61;
 72: /** `MODEL_CAPE_OF_FIGHTER = MODEL_WING + 49`, `MODEL_CAPE_OF_OVERRULE = +50`. */
 73: const CAPE_OF_FIGHTER = 49;
 74: const CAPE_OF_OVERRULE = 50;
 75: /** `MODEL_CHAIN_DRIVE_PARCHMENT = MODEL_ETC + 30` … `+ 36`. */
 76: const PARCHMENT_FIRST = 30;
 77: const PARCHMENT_LAST = 36;
 78: /** `MODEL_DIVINE_SWORD_OF_ARCHANGEL = MODEL_SWORD + 19`: shrunk on the ground. */
 79: const DIVINE_SWORD = 19;
 80: 
 81: // ---- 2. the pose --------------------------------------------------------
 82: 
 83: export type ItemRestPose = {
 84:   /** MU `o->Angle`, degrees: (pitch, roll, yaw). */
 85:   readonly angle: readonly [number, number, number];
 86:   /** `o->Scale`: ItemAngle's override where it has one, the base otherwise. */
 87:   readonly scale: number;
 88: };
 89: 
 90: /** A pose with `scale` left out where the original does not override it. */
 91: type RestPose = {
 92:   readonly angle: readonly [number, number, number];
 93:   readonly scale?: number;
 94: };
 95: 
 96: /** `Vector(0, 0, -45, o->Angle)`: upright, turned 45° off the map axis. */
 97: const DEFAULT_POSE: RestPose = { angle: [0, 0, -45] };
 98: 
 99: /**
100:  * The resting `o->Angle` / `o->Scale` for one item.
101:  *
102:  * Covers `ItemAngleRF`, every *structural* branch of `ItemAngle` and, through
103:  * `POSE_TABLE`, the long tail of per-item tweaks after them.
104:  */
105: export function itemRestPose(group: number, num: number): ItemRestPose {
106:   const pose = restPose(group, num);
107: 
108:   return { angle: pose.angle, scale: pose.scale ?? baseScale(group, num) };
109: }
110: 
111: /** `o->Scale` as `ItemObjectAttribute` leaves it, before `ItemAngle` runs. */
112: function baseScale(group: number, num: number): number {
113:   if (group === ItemGroup.Spear || group === ItemGroup.Bow) {
114:     return LONG_WEAPON_SCALE;
115:   }
116:   if (group === ItemGroup.Staff && num <= PLATINA_STAFF) {
117:     return LONG_WEAPON_SCALE;
118:   }
119:   return DROP_SCALE;
120: }
121: 
122: function restPose(group: number, num: number): RestPose {
123:   // --- ItemAngleRF first: it returns early in the original.
124:   if (group === ItemGroup.Wing) {
125:     if (num === CAPE_OF_FIGHTER) return { angle: [270, 180, 45], scale: 0.7 };
126:     if (num === CAPE_OF_OVERRULE) return { angle: [250, 180, 45] };
127:   }
128:   if (group === ItemGroup.Helm && num >= SACRED_HELM_FIRST && num <= SACRED_HELM_LAST) {
129:     return { angle: [0, 0, 45], scale: 1 };
130:   }
131:   if (group === ItemGroup.Etc && num >= PARCHMENT_FIRST && num <= PARCHMENT_LAST) {
132:     return { angle: [270, 0, -45], scale: 0.8 };
133:   }
134: 
135:   // --- ItemAngle.
136:   switch (group) {
137:     // `Type >= MODEL_SWORD && Type < MODEL_AXE + MAX_ITEM_INDEX`: leans back.
138:     case ItemGroup.Sword:
139:       return {
140:         angle: [60, 0, -45],
141:         scale: num === DIVINE_SWORD ? 0.7 : undefined,
142:       };
143:     case ItemGroup.Axe:
144:       return { angle: [60, 0, -45] };
145: 
146:     case ItemGroup.Bow:
147:       if (UPRIGHT_BOWS.has(num)) return { angle: [0, 0, -45] };
148:       if (
149:         (num >= CROSSBOW_FIRST && num <= CROSSBOW_LAST) ||
150:         (num >= DIVINE_CROSSBOW_FIRST && num <= DIVINE_CROSSBOW_LAST)
151:       ) {
152:         // A crossbow lies flat on its stock.
153:         return { angle: [90, 0, -45] };
154:       }
155:       // Every other bow falls through to the mace branch below.
156:       return { angle: [0, 270, -45] };
157: 
158:     // `Type >= MODEL_MACE && Type < MODEL_STAFF + MAX_ITEM_INDEX`: rolled onto
159:     // its side rather than pitched over.
160:     case ItemGroup.Mace:
161:     case ItemGroup.Spear:
162:     case ItemGroup.Staff:
163:       return { angle: [0, 270, -45] };
164: 
165:     case ItemGroup.Shield:
166:       return { angle: [0, 270, 270 - 45] };
167: 
168:     case ItemGroup.Helm:
169:       // The oversized helms are the only ones ItemAngle touches; the rest keep
170:       // the default upright pose.
171:       if (num >= BIG_HELM_FIRST && num <= BIG_HELM_LAST) {
172:         return { angle: [0, 0, 45], scale: 1.5 };
173:       }
174:       return DEFAULT_POSE;
175: 
176:     // `Type >= MODEL_ARMOR && Type < MODEL_GLOVES + MAX_ITEM_INDEX`: face-down.
177:     // Boots and helms are deliberately outside that range in the original.
178:     case ItemGroup.Armor:
179:     case ItemGroup.Pants:
180:     case ItemGroup.Gloves:
181:       return { angle: [270, 0, -45] };
182: 
183:     default:
184:       return tablePose(group, num) ?? DEFAULT_POSE;
185:   }
186: }
