<file path="src/common/mapTileObject.ts">
  1: import { Entity, World } from '../ecs/world';
  2: import { getMaterial, loadGLTF } from './modelLoader';
  3: import { ModelObject } from './modelObject';
  4: import { BlendState } from './objects/enum';
  5: import { ENUM_WORLD } from './types';
  6: import { SNOW_GROUND_MAPS } from '../weather/snowCover';
  7: import { isEffectOnlyObject } from './effectOnlyObjects';
  8: import { createEffectLight, type EffectLight } from './effectLights';
  9: import {
 10:   LOGIN_CHANDELIER,
 11:   LOGIN_WALL_TORCH,
 12:   lightMapObject,
 13: } from '../lighting/mapObjectLights';
 14: import type { LightSource } from '../lighting/lightSource';
 15: import {
 16:   BonedParticleEmitter,
 17:   ParticleEmitter,
 18:   emissionsFor,
 19:   type BonedEmission,
 20: } from './effectParticles';
 21: 
 22: export class MapTileObject extends ModelObject {
 23:   static Batchable = true;
 24: 
 25:   #light: EffectLight | null = null;
 26: 
 27:   #emitter: ParticleEmitter | null = null;
 28: 
 29:   #boneEmitter: BonedParticleEmitter | null = null;
 30: 
 31:   /** The light, when this type has one (login chandelier / wall torch). */
 32:   #source: LightSource | null = null;
 33: 
 34:   #disposed = false;
 35: 
 36:   async init(world: World, entity: Entity) {
 37:     await super.init(world, entity);
 38: 
 39:     if (isEffectOnlyObject(this.WorldIndex, this.Type)) {
 40:       this.CastsShadow = false;
 41:       this.Visible = false;
 42:       this.Ready = true;
 43: 
 44:       const emissions = emissionsFor(this.WorldIndex, this.Type);
 45: 
 46:       if (emissions) {
 47:         this.#emitter = new ParticleEmitter(
 48:           world.scene,
 49:           emissions,
 50:           this.node.position,
 51:           this.node.rotation.y,
 52:           this.node.scaling.x
 53:         );
 54:       }
 55: 
 56:       return;
 57:     }
 58: 
 59:     const dir = this.objectDir;
 60:     const modelPath = `${dir}Object${(this.Type + 1)
 61:       .toString()
 62:       .padStart(2, '0')}.glb`;
 63: 
 64:     // Icarus 4/5 used to be remapped to `Object11/cloud.glb` here. That was a
 65:     // misreading: Object01..Object06 are six byte-identical copies of one
 66:     // 50-unit smoke box, and `RenderObjectVisual` hides all six on sight
 67:     // (`o->HiddenMesh = -2`, ZzzObject.cpp:3052-3110) and replaces them with
 68:     // BITMAP_CLOUD billboards. `cloud.bmd` is MODEL_CLOUD, an *effect* model
 69:     // loaded by MapManager.cpp:151 and used only for the lightning flash
 70:     // plane - never a map object. maps/icarus/cloudObject.ts owns all six now.
 71:     // Before load: the metadata loop in ModelObject.load stamps every mesh.
 72:     this.SnowCap = SNOW_GROUND_MAPS.has(this.WorldIndex);
 73: 
 74:     this.load(await loadGLTF(modelPath, world));
 75: 
 76:     if (
 77:       this.Type === 157 &&
 78:       this.WorldIndex === ENUM_WORLD.WD_73NEW_LOGIN_SCENE
 79:     ) {
 80:       this.#boneEmitter = this.#createChandelierFire(world);
 81:     }
 82: 
 83:     if (
 84:       this.WorldIndex === ENUM_WORLD.WD_73NEW_LOGIN_SCENE &&
 85:       this.Type === 37
 86:     ) {
 87:       this.#createWallTorch(world);
 88:     }
 89: 
 90:     if (modelPath === 'Object3/Object20.glb') {
 91:       const m = this.getMesh(0)!;
 92:       m.material = getMaterial(world.scene, false, 2, BlendState.ALPHA_ADD);
 93:     }
 94: 
 95:     // The three `Object8/*` overrides that stood here are gone. They were
 96:     // guesses at what the Atlans water plane (type 23), bubble vent (22) and
 97:     // god-ray (38) should look like, made before the map had a table; all
 98:     // three are now the original's own `o->BlendMesh` values in
 99:     // maps/atlans/spec.ts, with the breathing `BlendMeshLight` sines from
100:     // ZzzObject.cpp:4014-4034 in common/meshAnimation.ts. Two were actively
101:     // wrong: type 22 is `HiddenMesh = -2` and never drawn at all, and the
102:     // material override on 23 ran *after* `applyBlendMesh` and would have
103:     // silently beaten the table entry.
104: 
105:     // Icarus used to force every mesh on the map additive here. It is not in
106:     // the reference and it is not needed: every Icarus map mesh is textured
107:     // `top02_R` or `gyg_R`, and the `_R` suffix already means bright/additive
108:     // through textureScript.ts - the one mesh family that is not (`test12_H`)
109:     // is `_H`, never drawn. The blanket added nothing the flags had not
110:     // already done, and took the decision away from them.
111:   }
112: 
113:   #createChandelierFire(world: World): BonedParticleEmitter | null {
114:     const root = this.gltf?.mesh;
115: 
116:     if (!root) return null;
117: 
118:     const nodeByBone = new Map<number, BonedEmission['node']>();
119: 
120:     for (const node of root.getDescendants(false)) {
121:       const match = /^bone_(\d+)_/.exec(node.name);
122: 
123:       if (match && 'getAbsolutePosition' in node) {
124:         nodeByBone.set(Number(match[1]), node as BonedEmission['node']);
125:       }
126:     }
127: 
128:     const scale = this.node.scaling.x;
129:     const points: BonedEmission[] = [];
130: 
131:     for (const bone of [22, 23, 25]) {
132:       const node = nodeByBone.get(bone);
133:       if (!node) continue;
134: 
135:       points.push(
136:         { node, kinds: ['fire157'], count: 2, scale: scale * 0.2, light: [0.9, 0.5, 0] },
137:         { node, kinds: ['fire157'], count: 2, scale: scale * 0.1, light: [0.75, 0.3, 0] }
138:       );
139:     }
140: 
141:     for (const bone of [26, 24, 21]) {
142:       const node = nodeByBone.get(bone);
143:       if (!node) continue;
144: 
145:       points.push({
146:         node,
147:         kinds: ['smoke65'],
148:         count: 1,
149:         scale: scale * 0.1,
150:         light: [1, 1, 1],
151:       });
152:     }
153: 
154:     if (!points.length) return null;
155: 
156:     this.#source = lightMapObject(
157:       world.scene,
158:       LOGIN_CHANDELIER,
159:       this.node.position
160:     );
161: 
162:     return new BonedParticleEmitter(world.scene, points);
163:   }
164: 
165:   #createWallTorch(world: World): void {
166:     const scale = this.node.scaling.x;
167: 
168:     const bone = this.gltf?.mesh
169:       .getDescendants(false)
170:       .find(n => n.name.startsWith('bone_1_'));
171: 
172:     const anchor: BonedEmission['node'] =
173:       bone && 'getAbsolutePosition' in bone
174:         ? (bone as unknown as BonedEmission['node'])
175:         : this.node;
176: 
177:     const position = anchor.getAbsolutePosition();
178:     const offsetY = 0;
179: 
180:     const spritePosition = {
181:       x: position.x,
182:       y: position.y + offsetY,
183:       z: position.z,
184:     };
185: 
186:     void createEffectLight(
187:       world.scene,
188:       LOGIN_WALL_TORCH.sprite!,
189:       spritePosition,
190:       scale
191:     ).then(light => {
192:       this.#light = light;
193: 
194:       if (this.#disposed) {
195:         this.#light?.dispose();
196:         this.#light = null;
197:       }
198:     });
199: 
200:     this.#source = lightMapObject(world.scene, LOGIN_WALL_TORCH, spritePosition);
201: 
202:     this.#boneEmitter = new BonedParticleEmitter(world.scene, [
203:       {
204:         node: anchor,
205:         kinds: ['fire1', 'fire2', 'fire3'],
206:         count: 1,
207:         scale: scale * 0.8,
208:         light: [1, 1, 1],
209:         offsetY,
210:       },
211:     ]);
212:   }
213: 
214:   dispose(): void {
215:     this.#disposed = true;
216:     this.#light?.dispose();
217:     this.#light = null;
218: 
219:     this.#source?.dispose();
220:     this.#source = null;
221: 
222:     this.#emitter = null;
223:     this.#boneEmitter = null;
224: 
225:     super.dispose();
226:   }
227: 
228:   Update(gameTime: World['gameTime']): void {
229:     super.Update(gameTime);
230: 
231:     if (!this.Ready) return;
232: 
233:     this.#emitter?.update();
234:     this.#boneEmitter?.update();
235: 
236:     // The `Object8/Object24.glb` sine that pulsed mesh *visibility* here was
237:     // the Atlans water plane's `BlendMeshLight` done as alpha - it dimmed the
238:     // whole mesh rather than the additive layer. ZzzObject.cpp:4016 is
239:     // `o->BlendMeshLight = sinf(WorldTime * 0.002f) * 0.3f + 0.5f`, which now
240:     // lives in common/meshAnimation.ts as the ATLANS table's `light`.
241:   }
242: }
</file>

<file path="src/common/materialQuality.ts">
  1: import { Texture, type AbstractMesh } from '../libs/babylon/exports';
  2: import { GameOptions } from './gameOptions';
  3: import { lightingTier } from './lightingQuality';
  4: import type { TextKey } from '../i18n';
  5: 
  6: /**
  7:  * Material quality (ARCHITECTURE §4.7). Classic is the faithful flat pipeline -
  8:  * the shared Standard-derived item material, byte-for-byte what the game
  9:  * shipped with. Both tiers above it put every lit mesh on the PBR variant;
 10:  * they differ only in the *scope of the derived maps* (`pbrMaps.ts`, or
 11:  * authored overrides from `Data/PBR/`): tier 1 derives them for the figures
 12:  * and their gear, tier 2 for the whole world. Meshes outside the scope bind
 13:  * the flat placeholders - PBR lighting with none of the derived relief.
 14:  *
 15:  * Only *lit* surfaces move: additive `_R` blend cards and flat-lit UI models
 16:  * stay on the Standard path in every mode. Terrain is the hand-written shader
 17:  * in every mode.
 18:  *
 19:  * The whole-mesh rule is load-bearing: `directLightGain` raises the sun and
 20:  * the torch pool by pi to undo Burley's 1/pi, and that gain lands on every
 21:  * light in the scene at once, so no lit mesh may be left on the Standard
 22:  * path while it is on.
 23:  */
 24: /** The tier names, as text keys - the Options slider prints `t()` of these. */
 25: export const MATERIAL_QUALITY_LABEL_KEYS: readonly TextKey[] = [
 26:   'options.quality.classic',
 27:   'options.quality.characters',
 28:   'options.quality.enhanced',
 29: ];
 30: 
 31: export const MATERIAL_QUALITY_MAX = MATERIAL_QUALITY_LABEL_KEYS.length - 1;
 32: 
 33: export function materialQuality(): number {
 34:   return Math.max(
 35:     0,
 36:     Math.min(MATERIAL_QUALITY_MAX, Math.round(GameOptions.materialQuality))
 37:   );
 38: }
 39: 
 40: /** True while every lit surface is on the PBR variant (tiers >= 1). */
 41: export function pbrMaterialsOn(): boolean {
 42:   return materialQuality() >= 1;
 43: }
 44: 
 45: /** True while every lit surface also takes a derived map set (tier 2). */
 46: export function pbrMaterialsEverywhere(): boolean {
 47:   return materialQuality() >= 2;
 48: }
 49: 
 50: /** Whether a lit mesh takes the PBR material: every one of them above Classic. */
 51: export function pbrCovers(_characterAsset: boolean): boolean {
 52:   return pbrMaterialsOn();
 53: }
 54: 
 55: /**
 56:  * Asset folders that count as "a character": the animated figures and the
 57:  * gear worn on them. `Item/` is in the list because a knight whose skin takes
 58:  * the derived maps and whose plate does not reads as two different materials
 59:  * bolted together - the armour is also where the metal/rough derivation
 60:  * earns its keep. Drop `'item/'` here to leave equipment flat.
 61:  */
 62: const CHARACTER_ROOTS = ['player/', 'monster/', 'npc/', 'skill/', 'item/'];
 63: 
 64: /**
 65:  * Whether a model path is character art. Takes the path `loadGLTF` was
 66:  * handed, so it is folder-based and needs no per-texture bookkeeping.
 67:  */
 68: export function isCharacterAsset(path: string): boolean {
 69:   const lower = path.toLowerCase().replace(/\\/g, '/');
 70: 
 71:   return CHARACTER_ROOTS.some(root => lower.includes(root));
 72: }
 73: 
 74: /**
 75:  * Whether this mesh takes a derived map set rather than the flat
 76:  * placeholders: characters on tier 1, everything lit on tier 2. Used by the
 77:  * PBR bind and by the glow layer's trim selector (`sceneLook`).
 78:  */
 79: export function meshTakesPbrMaps(mesh: AbstractMesh): boolean {
 80:   if (pbrMaterialsEverywhere()) return true;
 81:   if (!pbrMaterialsOn()) return false;
 82: 
 83:   return mesh.metadata?.characterAsset === true;
 84: }
 85: 
 86: /**
 87:  * Gain on the key (sun) and pooled torch lights while the lit meshes are PBR.
 88:  *
 89:  * Babylon's PBR direct diffuse is the Burley BRDF, which carries a 1/pi the
 90:  * Standard path's plain lambert never had; the hemispheric sky term is a
 91:  * `mix` on both and needs no gain. The one place the pi lives (§4.5).
 92:  */
 93: export function directLightGain(): number {
 94:   return pbrMaterialsOn() ? Math.PI : 1;
 95: }
 96: 
 97: /** Top of the detail slider; the notch at which the maps land full strength. */
 98: export const MATERIAL_DETAIL_MAX = 9;
 99: 
100: /**
101:  * How much of the derived normal / metalness the PBR material keeps, 0..1.
102:  * See `syncPbrDetail` for what each end of it does.
103:  */
104: export function pbrDetailStrength(): number {
105:   const value = Math.max(
106:     0,
107:     Math.min(MATERIAL_DETAIL_MAX, GameOptions.materialDetail)
108:   );
109: 
110:   return value / MATERIAL_DETAIL_MAX;
111: }
112: 
113: /** Anisotropy on the art's samplers on tiers >= 1 (ARCHITECTURE §4.7). */
114: export const FILTER_ANISOTROPY = 16;
115: 
116: export type TextureFiltering = { sampling: number; anisotropy: number };
117: 
118: /**
119:  * Sampler state for the art, per lighting tier. Classic reads level 0 with
120:  * nearest filtering, the way the original binds every texture
121:  * (GlobalBitmap.cpp:680: one level, no mip chain); tiers >= 1 filter
122:  * trilinear with anisotropy. Mip chains are built at load on every tier so
123:  * the flip is a sampler write, not a reload; Classic's mode never reads them.
124:  */
125: export function textureFiltering(): TextureFiltering {
126:   if (lightingTier() === null) {
127:     return { sampling: Texture.NEAREST_NEAREST, anisotropy: 1 };
128:   }
129: 
130:   return {
131:     sampling: Texture.TRILINEAR_SAMPLINGMODE,
132:     anisotropy: FILTER_ANISOTROPY,
133:   };
134: }
135: 
136: /**
137:  * Scale for a light's `specular` colour, cancelling `directLightGain` back out
138:  * of the specular term.
139:  *
140:  * `light.intensity` scales *both* `vLightDiffuse` and `vLightSpecular`
141:  * (`Light.transferToEffect`), but the gain above exists only to undo Burley's
142:  * 1/pi on the diffuse - the GGX specular never carried that factor. Left
143:  * alone, every highlight the PBR material draws came out pi times too hot.
144:  */
145: export function specularLightScale(): number {
146:   return 1 / directLightGain();
147: }
</file>

<file path="src/common/mathUtils.ts">
 1: import { Quaternion, Vector3 } from '../libs/babylon/exports';
 2: 
 3: export class MathUtils {
 4:   static AngleQuaternion(angles: Vector3): Quaternion {
 5:     // return Quaternion.FromEulerVector(angles);
 6:     let angle: Float;
 7:     let sr, sp, sy, cr, cp, cy: Float;
 8: 
 9:     angle = angles.z * 0.5;
10:     sy = Math.sin(angle);
11:     cy = Math.cos(angle);
12:     angle = angles.y * 0.5;
13:     sp = Math.sin(angle);
14:     cp = Math.cos(angle);
15:     angle = angles.x * 0.5;
16:     sr = Math.sin(angle);
17:     cr = Math.cos(angle);
18: 
19:     const x = sr * cp * cy - cr * sp * sy;
20:     const y = cr * sp * cy + sr * cp * sy;
21:     const z = cr * cp * sy - sr * sp * cy;
22:     const w = cr * cp * cy + sr * sp * sy;
23: 
24:     return new Quaternion(x, y, z, w);
25:   }
26: }
</file>

<file path="src/common/meshAnimation.ts">
  1: import { ENUM_WORLD } from './types';
  2: import {
  3:   CURSED_TEMPLE_WORLDS,
  4:   EMPIRE_GUARDIAN_WORLDS,
  5:   onWorlds,
  6: } from './worldAssets';
  7: 
  8: /**
  9:  * The per-frame mesh writes the original does from `MoveObject`:
 10:  * `o->BlendMeshTexCoordU/V` (a UV offset on one mesh) and `o->BlendMeshLight`
 11:  * (that mesh's brightness). Both are pure functions of `WorldTime`, identical
 12:  * for every instance of a type, so they live in a table rather than in a
 13:  * class per object.
 14:  *
 15:  * `mesh` names which mesh the writes land on:
 16:  *  - `blend` - the mesh the object already declares as its `BlendMesh`
 17:  *    (additive, unlit). The original sets `o->BlendMesh = N` in the same
 18:  *    `MoveObject` case.
 19:  *  - `stream` - `Models[type].StreamMesh = N`: drawn *textured but unlit*,
 20:  *    flat `BodyLight` instead of the per-vertex terrain light
 21:  *    (ZzzBMD.cpp:990-1001). That is the sand-fall / waterfall look.
 22:  *
 23:  * Time is milliseconds, matching `WorldTime`. Note `-(int)WorldTime % 1000`
 24:  * in C parses as `((-(int)WorldTime) % 1000)` - `%` keeps the dividend's
 25:  * sign - so it ramps 0 → -0.999 and wraps, which is what `-(t % 1000)` gives
 26:  * for positive `t`.
 27:  */
 28: export type MeshAnimation = {
 29:   /** Which mesh index the writes target. */
 30:   readonly mesh: number;
 31:   /** `stream`: unlit + scrolling. `blend`: the additive BlendMesh. */
 32:   readonly kind: 'stream' | 'blend';
 33:   readonly u?: (timeMs: number) => number;
 34:   readonly v?: (timeMs: number) => number;
 35:   /** Animated `o->BlendMeshLight`; `blend` meshes only. */
 36:   readonly light?: (timeMs: number) => number;
 37: };
 38: 
 39: const saw = (period: number, rate: number) => (t: number) =>
 40:   -((t % period) * rate);
 41: 
 42: const sawUp = (period: number, rate: number) => (t: number) =>
 43:   (t % period) * rate;
 44: 
 45: /**
 46:  * Dungeon (ZzzObject.cpp:3830-3835). Types 22/23/24 are the same squid01/02
 47:  * flesh curtain in three variants; the original sets `StreamMesh = 1` every
 48:  * frame and scrolls V a whole texture per second, downward.
 49:  */
 50: const DUNGEON: Partial<Record<number, MeshAnimation>> = {
 51:   22: { mesh: 1, kind: 'stream', v: saw(1000, 0.001) },
 52:   23: { mesh: 1, kind: 'stream', v: saw(1000, 0.001) },
 53:   24: { mesh: 1, kind: 'stream', v: saw(1000, 0.001) },
 54: };
 55: 
 56: /**
 57:  * Noria (ZzzObject.cpp:3925-3944). 18 is the mill wheel's water, 41 the
 58:  * stream, 42/43 a mirrored pair of waterfall curtains - hence the opposite
 59:  * U signs.
 60:  */
 61: const NORIA: Partial<Record<number, MeshAnimation>> = {
 62:   18: { mesh: 2, kind: 'blend', v: sawUp(1000, 0.001) },
 63:   41: { mesh: 0, kind: 'blend', v: sawUp(2000, 0.0005) },
 64:   42: { mesh: 0, kind: 'stream', u: saw(500, 0.002) },
 65:   43: { mesh: 0, kind: 'stream', u: sawUp(500, 0.002) },
 66: };
 67: 
 68: /**
 69:  * Lost Tower (ZzzObject.cpp:3952-3966). 3/4 are the glowing conduits - the
 70:  * original scrolls them and then re-draws mesh 1 through `StreamMesh` with a
 71:  * chrome pass (`Draw_RenderObject`:1002); we keep the scroll and the unlit
 72:  * pass, the chrome layer is materials work. 19/20 are the two tower machines.
 73:  */
 74: const LOST_TOWER: Partial<Record<number, MeshAnimation>> = {
 75:   3: { mesh: 1, kind: 'stream', u: saw(1000, 0.001) },
 76:   4: { mesh: 1, kind: 'stream', u: saw(1000, 0.001) },
 77:   19: { mesh: 4, kind: 'blend', u: saw(1000, 0.001) },
 78:   20: { mesh: 4, kind: 'blend', u: saw(1000, 0.001) },
 79: };
 80: 
 81: /** Stadium (ZzzObject.cpp:3996-3999): the fountain basin, mesh 3 = water.jpg. */
 82: const STADIUM: Partial<Record<number, MeshAnimation>> = {
 83:   21: { mesh: 3, kind: 'blend', v: saw(1000, 0.001) },
 84: };
 85: 
 86: /**
 87:  * Atlans (ZzzObject.cpp:4012-4034). No UV scroll at all here - the movement
 88:  * is baked into the BMD bone animation. What the original does animate is
 89:  * `BlendMeshLight`, a slow breathing on the water plane (23), the two coral
 90:  * lamps (32/34) and the anemone (40).
 91:  */
 92: const ATLANS: Partial<Record<number, MeshAnimation>> = {
 93:   23: { mesh: 0, kind: 'blend', light: t => Math.sin(t * 0.002) * 0.3 + 0.5 },
 94:   32: { mesh: 1, kind: 'blend', light: t => Math.sin(t * 0.004) * 0.5 + 0.5 },
 95:   34: { mesh: 1, kind: 'blend', light: t => Math.sin(t * 0.004) * 0.5 + 0.5 },
 96:   40: { mesh: 0, kind: 'blend', light: t => Math.sin(t * 0.004) * 0.3 + 0.5 },
 97: };
