 14: 
 15: // [NpcInfo(349, "Balgass")] - MODEL_BALGASS at Scale 2.0
 16: // (GMCrywolf1st.cpp:667-677). His voice (MapManager.cpp:224-230, played per
 17: // action at :1618-1652) is in sound/monsters.ts. Not ported: the
 18: // BITMAP_JOINT_ENERGY mesh wraps (:674-675) and the per-mesh
 19: // RENDER_CHROME2 overlay (:1423-1436) - no mesh-wrap ribbon or monster
 20: // chrome pass exists.
 21: const NPC_TYPE = 349;
 22: 
 23: /** MONSTER_MODEL_BALGASS. */
 24: const MODEL_TYPE = 89;
 25: 
 26: /** Attack2 ground slam: bone 33 at key 7.5 (GMCrywolf1st.cpp:806-820). */
 27: const SLAM_BONE = 33;
 28: const SLAM_FRAME = 7.5;
 29: /** 6 x MODEL_BIG_STONE1 plus the BITMAP_EXPLOTION card of the slam. */
 30: const SLAM_STONES = 6;
 31: const SLAM_CARD_TILES = 2.56;
 32: const SLAM_CARD_SECONDS = 0.8;
 33: 
 34: /** Walking drops a BITMAP_SMOKE + 1 puff per `rand_fps_check(10)` (:824-829). */
 35: const WALK_SMOKE_INTERVAL = 0.4;
 36: 
