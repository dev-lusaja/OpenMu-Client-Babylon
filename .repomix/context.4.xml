 38:   static {
 39:     Balgass.OverrideScale = monsterScaleOf(NPC_TYPE);
 40:   }
 41: 
 42:   #world: World | null = null;
 43:   #entity: Entity | null = null;
 44:   #slamSerial = -1;
 45:   #nextSmoke = 0;
 46: 
 47:   async init(world: World, entity: Entity) {
 48:     await super.init(world, entity);
 49: 
 50:     this.#world = world;
 51:     this.#entity = entity;
 52: 
 53:     this.load(await loadGLTF(monsterModelFile(MODEL_TYPE), world));
 54:   }
 55: 
 56:   Update(gameTime: World['gameTime']): void {
 57:     super.Update(gameTime);
 58: 
 59:     const world = this.#world;
 60:     const entity = this.#entity;
 61:     if (!this.Ready || !world || !entity || entity.dying) return;
 62: 
 63:     if (
 64:       this.CurrentAction === MonsterActionType.Attack2 &&
 65:       this.actionSerial !== this.#slamSerial &&
 66:       this.actionFrame() >= SLAM_FRAME
 67:     ) {
 68:       this.#slamSerial = this.actionSerial;
 69: 
 70:       const at = bonePos(entity, SLAM_BONE, tmpA, 0);
 71:       const light: [number, number, number] = [
 72:         this.Light.x,
 73:         this.Light.y,
 74:         this.Light.z,
 75:       ];
 76:       effects.spawn('sprite', world.scene, at, {
 77:         texture: TEX.explosion,
 78:         colour: [1, 1, 1],
 79:         size: SLAM_CARD_TILES,
 80:         seconds: SLAM_CARD_SECONDS,
 81:         cells: EXPLOSION_CELLS,
 82:       });
 83:       effects.spawn('debris', world.scene, at, {
 84:         model: MODEL.bigStone,
 85:         count: SLAM_STONES,
 86:         colour: light,
 87:       });
 88:       return;
 89:     }
 90: 
 91:     if (this.CurrentAction === MonsterActionType.Walk && !this.OutOfView) {
 92:       const now = gameTime.TotalGameTime.TotalSeconds;
 93:       if (now < this.#nextSmoke) return;
 94:       this.#nextSmoke = now + WALK_SMOKE_INTERVAL;
 95: 
 96:       const at = entityPos(entity, 0, tmpA);
 97:       effects.spawn('particles', world.scene, at, {
 98:         recipe: SAND_SMOKE,
 99:         count: 1,
100:       });
101:     }
102:   }
103: }
