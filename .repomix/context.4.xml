 78:     world === ENUM_WORLD.WD_7ATLANSE ||
 79:     inHellas(world) ||
 80:     world === ENUM_WORLD.WD_67DOPPLEGANGER3
 81:   );
 82: }
 83: 
 84: /**
 85:  * `SetPlayerWalk`'s gate on the run accumulator (ZzzCharacter.cpp:387-408).
 86:  * Knights, Dark Lords, Rage Fighters and anyone on a Fenrir always run;
 87:  * everyone else needs +5 boots - or +5 gloves in the swim worlds, where the
 88:  * "run" is a swim stroke driven by the arms.
 89:  *
 90:  * The original ORs the equipped-item level with the *rendered* body-part
 91:  * level; here there is one source for both, so a single check covers it.
 92:  */
 93: export function canAccumulateRun(
 94:   cls: CharacterClassNumber,
 95:   boots: Item | null | undefined,
 96:   gloves: Item | null | undefined,
 97:   world: number,
 98:   ridingFenrir = false
 99: ): boolean {
100:   if (ridingFenrir) return true;
101: 
102:   const base = getBaseClass(cls);
103:   if (
104:     base === BaseClass.Knight ||
105:     base === BaseClass.DarkLord ||
106:     base === BaseClass.RageFighter
107:   ) {
108:     return true;
109:   }
110: 
111:   const swim = isSwimWorld(world);
112:   const gate = swim ? gloves : boots;
113: 
114:   return !!gate && (gate.lvl ?? 0) >= 5;
115: }
116: 
117: /** Movement speeds `CharacterMoveSpeed` returns, in the original's units. */
118: const SPEED_WALK = 12;
119: const SPEED_RUN = 15;
120: const SPEED_WINGS = 15;
121: const SPEED_FAST_WINGS = 16;
122: 
123: /**
124:  * `MoveSpeed` units are per 25 Hz frame at `TERRAIN_SCALE` 100, so one tile
125:  * per second is 4 units (ZzzCharacter.cpp:11530, MoveCharacterPosition:6259).
126:  */
127: export const MOVE_SPEED_UNITS_PER_TILE_PER_SECOND = 4;
128: 
129: export type MoveSpeedInput = {
130:   /** `c->Run`, in the original's 0…40 units. */
131:   run: number;
132:   inSafeZone: boolean;
133:   /** `c->Wing` - the equipped wing item, or null. */
134:   wings: Item | null | undefined;
135:   /** `c->Helper` is a Horn of Uniria / Dinorant (they move at wing speed). */
136:   riding: boolean;
137:   /** `c->Helper` is a Horn of Fenrir: its own walk-up and speed ladder. */
138:   fenrir?: boolean;
139:   /** A Fenrir with an option (`Helper.ExcellentFlags > 0`) tops out at 19. */
140:   fenrirUpgraded?: boolean;
141:   world: number;
142: };
143: 
144: /**
145:  * States in which `CharacterMoveSpeed` writes `c->Run = 40` outright, so the
146:  * character never walks up to running: wings, a Uniria / Dinorant, and Chaos
147:  * Castle (ZzzCharacter.cpp:6200-6215, :6232-6236).
148:  */
149: export function forcesRun(
150:   input: Pick<
151:     MoveSpeedInput,
152:     'wings' | 'riding' | 'fenrir' | 'inSafeZone' | 'world'
153:   >
154: ): boolean {
155:   // A Fenrir keeps the walk-up: its branch of CharacterMoveSpeed (:6182-6194)
156:   // reads c->Run instead of pinning it to 40.
157:   if (input.fenrir && !input.inSafeZone) return inChaosCastle(input.world);
158:   if ((input.wings || input.riding) && !input.inSafeZone) return true;
159:   return inChaosCastle(input.world);
160: }
161: 
162: /**
163:  * `CharacterMoveSpeed` (ZzzCharacter.cpp:6165-6250) minus the Dark Horse and
164:  * the Cursed Temple holy item, in tiles per second.
165:  */
166: export function characterMoveSpeed(input: MoveSpeedInput): number {
167:   let speed: number;
168: 
169:   if (input.fenrir && !input.inSafeZone) {
170:     // The Fenrir ladder (:6182-6194): 15 while walking, 16 through the
171:     // walk-up's back half, then 17 - or 19 on a coloured one.
172:     if (input.run < FENRIR_RUN_DELAY / 2) speed = 15;
173:     else if (input.run < FENRIR_RUN_DELAY) speed = 16;
174:     else speed = input.fenrirUpgraded ? 19 : 17;
175:   } else if ((input.wings || input.riding) && !input.inSafeZone) {
176:     speed = isFastWing(input.wings) ? SPEED_FAST_WINGS : SPEED_WINGS;
177:   } else {
178:     speed = input.run >= RUN_THRESHOLD ? SPEED_RUN : SPEED_WALK;
179:   }
180: 
181:   if (inChaosCastle(input.world)) speed = SPEED_RUN;
182: 
183:   return speed / MOVE_SPEED_UNITS_PER_TILE_PER_SECOND;
184: }
</file>

<file path="src/common/lootFilter.ts">
 1: import { GameOptions } from './gameOptions';
 2: import { isJewel, itemDef } from './itemStats';
 3: import { HIGH_DROP_LEVEL } from './dropTier';
 4: import type { Entity } from '../ecs/world';
 5: 
 6: /**
 7:  * Which drops keep their name on screen while the ALT overlay is latched.
 8:  *
 9:  * The overlay itself is the original's (`CNewUINameWindow`): ALT toggles the
10:  * names over every drop. On a busy hunting ground that is a wall of white
11:  * text, so the latched overlay runs the pile through these rules instead;
12:  * ALT *held* still shows everything, which is the escape hatch when the
13:  * filter hides something the player wanted.
14:  *
15:  * The vocabulary is MU Helper's pickup filter (`muHelper/config.ts`) on
16:  * purpose: what the helper would pick up is what the eye wants marked.
17:  */
18: 
19: type Drop = NonNullable<Entity['droppedItem']>;
20: 
21: /** Zen slider step -> the smallest pile that still gets a name. */
22: export const LOOT_ZEN_STEPS = [
23:   0, 100, 500, 1_000, 5_000, 10_000, 50_000, 100_000, 500_000, 1_000_000,
24: ] as const;
25: 
26: export const LOOT_ZEN_MAX = LOOT_ZEN_STEPS.length - 1;
27: 
28: export function lootZenThreshold(step: number): number {
29:   return LOOT_ZEN_STEPS[Math.max(0, Math.min(LOOT_ZEN_MAX, step))] ?? 0;
30: }
31: 
32: /**
33:  * Whether the latched overlay names this drop. Reads `GameOptions`, so an
34:  * `observer` that calls it repaints when a filter box is ticked.
35:  */
36: export function dropPassesLootFilter(drop: Drop): boolean {
37:   if (!GameOptions.lootFilter) return true;
38: 
39:   if (drop.isMoney) {
40:     const amount = drop.amount ?? 0;
41:     return amount >= lootZenThreshold(GameOptions.lootZen);
42:   }
43: 
44:   const item = drop.item;
45:   if (item) {
46:     if (GameOptions.lootExcellent && item.isExcellent) return true;
47:     if (GameOptions.lootAncient && item.isAncient) return true;
48:     if (GameOptions.lootHighLevel && (item.lvl ?? 0) >= HIGH_DROP_LEVEL) return true;
49:   }
50: 
51:   if (GameOptions.lootJewels) {
52:     const def = itemDef(drop.group, drop.num);
53:     if (def && isJewel(def)) return true;
54:   }
55: 
56:   return GameOptions.lootOther;
57: }
</file>

