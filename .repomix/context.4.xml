401: /**
402:  * Per-file preparation: everything that used to run inside the per-instance
403:  * mesh task and only ever produced the same result. On the cached path it
404:  * runs exactly once per GLB and the clones inherit it (Babylon's
405:  * `DeepCopier` carries the flags, `_geometry.applyToMesh` shares the buffers).
406:  */
407: function prepareMeshes(
408:   meshes: AbstractMesh[],
409:   skeletons: Skeleton[],
410:   filePath: string,
411:   fileName: string,
412:   scene: Scene,
413:   characterAsset: boolean
414: ): void {
415:   const root = meshes[0];
416: 
417:   if (root) root.name = fileName;
418: 
419:   meshes.forEach(mesh => {
420:     mesh.metadata ??= {};
421:     // Which folder the model came out of, for the Characters material tier.
422:     // Stamped rather than re-derived because the mesh has no path of its own
423:     // once the container is cloned, and the clone copies metadata.
424:     mesh.metadata.characterAsset = characterAsset;
425:     mesh.metadata.itemLvl = 0;
426:     mesh.metadata.isExcellent = false;
427:     mesh.metadata.timeOffset = 0;
428:     // Let Babylon frustum-cull model meshes; in Lorencia ~3/4 of the
429:     // meshes inside the visibility radius are behind the camera.
430:     // Shadow clones keep alwaysSelectAsActiveMesh (objectShadow.ts):
431:     // their vertex shader moves them away from their bounds.
432:     mesh.alwaysSelectAsActiveMesh = false;
433:     mesh.isPickable = false;
434:     mesh.doNotSyncBoundingInfo = false;
435: 
436:     const m = mesh.material as PBRBaseSimpleMaterial;
437:     if (m && !!m._albedoTexture) {
438:       const cached = getTexture(
439:         filePath,
440:         m._albedoTexture.name,
441:         m._albedoTexture as Texture
442:       );
443:       const diffuseTexture = cached;
444: 
445:       const textureName = textureSourceName(m._albedoTexture as Texture);
446:       const script = parseTextureScriptFromPath(textureName);
447: 
448:       // A texture named `hid*` is not a texture: `CLoadData::OpenTexture`
449:       // (LoadData.cpp:70-73) binds BITMAP_HIDE for it before it looks at the
450:       // extension, and every RenderMesh returns on that index
451:       // (ZzzBMD.cpp:953-956, :1384, :1964). The slot means "this mesh does not
452:       // draw" - 147 meshes name one, mostly the skin panels under the Lucky
453:       // Item armour parts.
454:       if (script?.hiddenMesh || isHideTexture(textureName)) {
455:         mesh.setEnabled(false);
456:         mesh.metadata.hiddenByScript = true;
457:       }
458: 
459:       // `pBitmap->IsSkin` / `IsHair` (LoadData.cpp:82-96): the flag belongs to
460:       // the texture, so it is read once per GLB here rather than per drop.
461:       mesh.metadata.skinTexture = isSkinOrHairTexture(textureName);
462: 
463:       const bright = script?.bright === true;
464:       // The converter marks every TGA-textured mesh BLEND; the
465:       // original draws those through EnableAlphaTest - alpha test +
466:       // blend, depth-written, and with face culling disabled. The
467:       // spider's legs (single-sided alpha cards) vanish from behind
468:       // and get overdrawn by the body without this.
469:       const alphaTested = !bright && m.transparencyMode === 2;
470: 
471:       const clonedMaterial = getMaterial(
472:         scene,
473:         bright || alphaTested ? false : m.backFaceCulling,
474:         bright
475:           ? 2
476:           : alphaTested
477:             ? ALPHA_TEST_AND_BLEND
478:             : m.transparencyMode ?? 0,
479:         bright
480:           ? BlendState.ALPHA_ONEOE
481:           : m.alphaMode ?? BlendState.ALPHA_DISABLE,
482:         bright,
483:         false,
484:         characterAsset
485:       );
486:       mesh.visibility = m.alpha;
487:       mesh.metadata.diffuseTexture = diffuseTexture;
488:       mesh.metadata.brightMesh = bright;
489: 
490:       if (m._albedoTexture !== cached) {
491:         m._albedoTexture.dispose();
492:       }
493:       m._albedoTexture = null;
494: 
495:       mesh.material = clonedMaterial;
496:       m.dispose(true, false);
497:     }
498: 
499:     if (mesh.skeleton) {
500:       mesh.numBoneInfluencers = 1;
501:     }
502:   });
503: 
504:   skeletons.forEach(skeleton => {
505:     skeleton.name = `skeleton_${fileName}`;
506:   });
507: }
