110: class SimpleModulusBase {
111:   Counter = new Counter();
112: 
113:   DecryptedBlockBuffer = new Uint8Array(DecryptedBlockSize);
114:   EncryptedBlockBuffer = new Uint8Array(EncryptedBlockSize);
