 1: /**
 2:  * The friend list and the letter box - `CFriendList` / `CLetterList` and the
 3:  * three tabs of `CUIFriendWindow` (UIWindows.h:304-540). The original's third
 4:  * tab is the chat-room list, which needs the separate chat server MU used to
 5:  * ship with; OpenMU has no such server and no chat-room packets, so only the
 6:  * friend list and the letter box are ported.
 7:  */
 8: 
 9: /** `MAX_FRIEND_COUNT`. */
10: export const MAX_FRIENDS = 50;
11: /** `Server` 0xFF means the friend is offline (OpenMU FriendOnlineStateUpdate). */
12: export const FRIEND_OFFLINE = 0xff;
13: /** `MAX_ID_SIZE`: the name fields are ten bytes. */
14: export const MAX_FRIEND_NAME = 10;
15: /** `Title` of LetterSendRequest is 60 bytes; `Subject` comes back in 32. */
16: export const MAX_LETTER_TITLE = 32;
17: /** `MAX_LETTER_TEXT`: the body the original's edit box accepts. */
18: export const MAX_LETTER_TEXT = 1000;
19: 
20: export type Friend = {
21:   name: string;
22:   /** -1 offline, otherwise the game-server id the friend is on. */
23:   server: number;
24: };
25: 
26: /** One row of the letter box (`LETTERLIST_TEXT`). */
27: export type Letter = {
28:   index: number;
29:   sender: string;
30:   subject: string;
31:   /** The server sends the stamp pre-formatted, so it is shown as it arrives. */
32:   timestamp: string;
33:   read: boolean;
34:   /** `New`: arrived while the hero was online, so it also raises a notice. */
35:   isNew: boolean;
36:   /** Filled in by OpenLetter when the letter is opened. */
37:   body?: string;
38: };
39: 
40: export function isFriendOnline(friend: Friend): boolean {
41:   return friend.server >= 0;
42: }
43: 
44: /** `CFriendList::Sort`: online first, then by name. */
45: export function sortFriends(friends: Friend[]): Friend[] {
46:   return friends.slice().sort((a, b) => {
47:     const onlineA = isFriendOnline(a) ? 0 : 1;
48:     const onlineB = isFriendOnline(b) ? 0 : 1;
49:     if (onlineA !== onlineB) return onlineA - onlineB;
50:     return a.name.localeCompare(b.name);
51:   });
52: }
53: 
54: /** `CLetterList::Sort`: newest first, which is the index the server hands out. */
55: export function sortLetters(letters: Letter[]): Letter[] {
56:   return letters.slice().sort((a, b) => b.index - a.index);
57: }
</file>

<file path="src/common/minimapData.ts">
 1: import { convertBux } from './terrain/mapFileEncryption';
 2: 
 3: /**
 4:  * `Data/World{n}/Minimap.bmd` - the NPC / portal markers drawn over the
 5:  * minimap (`CNewUIMiniMap::LoadImages`). The file is `MAX_MINI_MAP_DATA`
 6:  * (100) BUX-encoded `MINI_MAP_FILE` records, a 45-byte tail and a 4-byte
 7:  * checksum (`GenerateCheckSum2(..., 0x2BC1)`). The struct is 4-byte aligned:
 8:  *
 9:  *   BYTE Kind;          // 0 = end of list, 1 = NPC, 2 = portal
10:  *   int  Location[2];   // tile X, tile Y
11:  *   int  Rotation;      // marker yaw in degrees
12:  *   char Name[100];     // UTF-8 tooltip
13:  *
14:  * so each record is 116 bytes. The later client reads the localised
15:  * `Data/Local/{lang}/Minimap/Minimap_World{n}_{lang}.bmd` instead; the copies
16:  * shipped with this Data folder are the pre-localisation per-world files,
17:  * which use the same layout.
18:  */
19: 
20: export const MAX_MINI_MAP_DATA = 100;
21: const RECORD_SIZE = 116;
22: const NAME_OFFSET = 16;
23: const NAME_SIZE = 100;
24: 
25: export const MinimapMarkerKind = {
26:   Npc: 1,
27:   Portal: 2,
28: } as const;
29: 
30: export type MinimapMarker = {
31:   kind: number;
32:   /** Tile coordinates (`Location[0]`, `Location[1]`). */
33:   x: number;
34:   y: number;
35:   /** Degrees; the marker sprite is rotated by this on top of the map's 45°. */
36:   rotation: number;
37:   name: string;
38: };
39: 
40: /**
41:  * @param encoding The English localised file is UTF-8 (`ConvertFromUtf8`), the
42:  * Latin packs are their own code page (`i18n.dataEncoding`), and the
43:  * pre-localisation per-world files in this Data folder are Shift-JIS.
44:  */
45: export function parseMinimapData(
46:   buffer: Uint8Array,
47:   encoding: string = 'utf-8'
48: ): MinimapMarker[] {
49:   const decoder = new TextDecoder(encoding);
50:   const expected = MAX_MINI_MAP_DATA * RECORD_SIZE;
51: 
52:   if (buffer.length < expected) {
53:     throw new Error(
54:       `Minimap.bmd is truncated: expected at least ${expected} bytes, got ${buffer.length}`
55:     );
56:   }
57: 
58:   const markers: MinimapMarker[] = [];
59: 
60:   for (let i = 0; i < MAX_MINI_MAP_DATA; i++) {
61:     const record = buffer.slice(i * RECORD_SIZE, (i + 1) * RECORD_SIZE);
62:     convertBux(record, RECORD_SIZE);
63: 
64:     const kind = record[0];
65:     // The original stops at the first Kind == 0 entry.
66:     if (kind === 0) break;
67: 
68:     const view = new DataView(
69:       record.buffer,
70:       record.byteOffset,
71:       record.byteLength
72:     );
73: 
74:     let nameEnd = NAME_OFFSET;
75:     while (nameEnd < NAME_OFFSET + NAME_SIZE && record[nameEnd] !== 0) {
76:       nameEnd++;
77:     }
78: 
79:     markers.push({
80:       kind,
81:       x: view.getInt32(4, true),
82:       y: view.getInt32(8, true),
83:       rotation: view.getInt32(12, true),
84:       name: decoder.decode(record.subarray(NAME_OFFSET, nameEnd)).trim(),
85:     });
86:   }
87: 
88:   return markers;
89: }
</file>

<file path="src/common/mobile.ts">
 1: /**
 2:  * The one place the client decides it is being played with a thumb. Nothing
 3:  * else may sniff the user agent or query `matchMedia` for this: the whole
 4:  * mobile HUD, the touch-only input rules and every `.mu-mobile` style rule
 5:  * hang off this answer, so there is exactly one of it.
 6:  *
 7:  * Coarse pointer *and* a touch point: a desktop with a touch monitor reports
 8:  * coarse on its own, and a laptop trackpad reports touch points on its own.
 9:  *
10:  * `?mobile=1` / `?mobile=0` overrides for the life of the page, which is how
11:  * the screenshot harness and a reviewer on a desktop see the mobile HUD. It
12:  * is deliberately not remembered: a stored override would leave a desktop
13:  * that once opened that URL on the touch HUD for good.
14:  *
15:  * Imported by `main.tsx` before the version loads, so it keeps no imports of
16:  * its own - the app graph behind `boot.tsx` reads `gameVersion` at module
17:  * scope and must not be pulled in early.
18:  */
19: 
20: const ROOT_CLASS = 'mu-mobile';
21: 
22: function readOverride(): boolean | null {
23:   if (typeof window === 'undefined') return null;
24:   const param = new URLSearchParams(window.location.search).get('mobile');
25:   if (param === '1') return true;
26:   if (param === '0') return false;
27:   return null;
28: }
29: 
30: function detect(): boolean {
31:   const override = readOverride();
32:   if (override !== null) return override;
33:   if (typeof window === 'undefined' || typeof navigator === 'undefined') return false;
34:   const coarse = window.matchMedia?.('(pointer: coarse)').matches ?? false;
35:   return coarse && navigator.maxTouchPoints > 0;
36: }
37: 
38: const mobile = detect();
39: 
40: // The class the stylesheets key on, set before React's first paint so no
41: // desktop rule flashes on a phone.
42: if (mobile && typeof document !== 'undefined') {
43:   document.documentElement.classList.add(ROOT_CLASS);
44: }
45: 
46: export function isMobileDevice(): boolean {
47:   return mobile;
48: }
49: 
50: export function useIsMobile(): boolean {
51:   return mobile;
52: }
</file>

<file path="src/common/mobileSkillSlots.ts">
 1: import { makeAutoObservable, runInAction } from 'mobx';
 2: import { LocalStorage } from '../libs/localStorage';
 3: import { isHotbarSkill } from './skillCasting';
 4: 
 5: /**
 6:  * The three skills linked to the mobile pad, per character.
 7:  *
 8:  * Deliberately not `Store.skillHotkeys`: those ten are the digit keys and are
 9:  * round-tripped to the server through `SaveKeyConfiguration`, so borrowing
10:  * three of them would rewrite the player's desktop bar from their phone.
11:  * These live in the browser only, keyed by character name so two characters
12:  * on one device keep their own pads.
13:  */
14: 
15: const STORAGE_KEY = 'mu_mobile_skills';
16: 
17: export const MOBILE_SKILL_SLOTS = 3;
18: 
19: const EMPTY: number[] = new Array(MOBILE_SKILL_SLOTS).fill(-1);
20: 
21: type Saved = Record<string, number[]>;
22: 
23: function load(): Saved {
24:   const stored = LocalStorage.load(STORAGE_KEY);
25:   if (!stored) return {};
26:   try {
27:     const parsed = JSON.parse(stored) as Saved;
28:     return parsed && typeof parsed === 'object' ? parsed : {};
29:   } catch {
30:     return {};
31:   }
32: }
33: 
34: export const MobileSkillSlots = new (class _MobileSkillSlots {
35:   private saved: Saved = load();
36:   private character = '';
37:   /** The live pad: three wire skill numbers, -1 for empty. */
38:   slots: number[] = EMPTY.slice();
39: 
40:   constructor() {
41:     makeAutoObservable(this, { slots: true });
42:   }
43: 
44:   /** The character changed: swap in that character's pad. */
45:   use(character: string): void {
46:     if (this.character === character) return;
47:     this.character = character;
48:     const stored = this.saved[character];
49:     runInAction(() => {
50:       this.slots = EMPTY.map((_, i) => {
51:         const number = stored?.[i];
52:         return typeof number === 'number' && isHotbarSkill(number) ? number : -1;
53:       });
54:     });
55:   }
56: 
57:   /** `number` < 0 clears the slot. A skill sits on one slot only. */
58:   assign(slot: number, number: number): void {
59:     if (slot < 0 || slot >= MOBILE_SKILL_SLOTS) return;
60:     runInAction(() => {
61:       const next = this.slots.map(n => (n === number ? -1 : n));
62:       next[slot] = number >= 0 && isHotbarSkill(number) ? number : -1;
63:       this.slots = next;
64:     });
65:     this.save();
66:   }
67: 
68:   /** Login / skill list update: a slot may not point at a skill we do not have. */
69:   prune(learned: readonly number[]): void {
70:     const known = new Set(learned);
71:     const next = this.slots.map(n => (n >= 0 && known.has(n) ? n : -1));
72:     if (next.every((n, i) => n === this.slots[i])) return;
73:     runInAction(() => {
74:       this.slots = next;
75:     });
76:     this.save();
77:   }
78: 
79:   private save(): void {
80:     if (!this.character) return;
81:     this.saved = { ...this.saved, [this.character]: this.slots.slice() };
82:     LocalStorage.save(STORAGE_KEY, JSON.stringify(this.saved));
83:   }
84: })();
</file>

