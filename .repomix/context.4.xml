<file path="src/common/chatTextWidth.ts">
 1: import { CHAT_LINE_FONT_SIZE } from './chat';
 2: 
 3: /**
 4:  * How wide a chat line would be drawn, in the log's own pixels.
 5:  *
 6:  * The log splits a long line when it is added, not when it is drawn
 7:  * (`ProcessAddText`), so the width has to be known outside React and before
 8:  * anything is on screen. A detached canvas measures in the same font the log
 9:  * paints with; without a DOM (tests, the packet decoder under bun) it falls
10:  * back to an average character width, which only has to be close enough to
11:  * pick a space to break at.
12:  */
13: 
14: /** Tahoma at the log's size: measured average, good to a few percent. */
15: const FALLBACK_CHAR_WIDTH = 5.4;
16: 
17: let context: CanvasRenderingContext2D | null | undefined;
18: 
19: function measuringContext(): CanvasRenderingContext2D | null {
20:   if (context !== undefined) return context;
21: 
22:   try {
23:     const canvas = document.createElement('canvas');
24:     const own = canvas.getContext('2d');
25:     if (own) {
26:       // The family the log resolves to, rather than the stack: `--mu-script-font`
27:       // is whatever `i18n` set for the language on screen.
28:       const root = getComputedStyle(document.documentElement);
29:       const script = root.getPropertyValue('--mu-script-font').trim();
30:       own.font = `${CHAT_LINE_FONT_SIZE}px ${script || 'Tahoma'}, Tahoma, sans-serif`;
31:     }
32:     context = own;
33:   } catch {
34:     context = null;
35:   }
36: 
37:   return context;
38: }
39: 
40: export function chatTextWidth(text: string): number {
41:   const own = measuringContext();
42:   if (!own) return text.length * FALLBACK_CHAR_WIDTH;
43:   return own.measureText(text).width;
44: }
45: 
46: /** The language changed, so the face the log paints with may have too. */
47: export function resetChatTextWidth(): void {
48:   context = undefined;
49: }
</file>

