315: export async function playSong(): Promise<void> {
316:   const instrument = Band.instrument;
317:   if (!instrument || !Band.song || Band.role === 'member') return;
318:   if (Band.phase === 'playing') return;
319:   if (!bankReady(instrument)) {
320:     runInAction(() => {
321:       Band.bankLoading = true;
322:     });
323:     const ok = await ensureBank(instrument);
324:     runInAction(() => {
325:       Band.bankLoading = false;
326:     });
327:     if (!ok || Band.instrument !== instrument) return;
328:   }
329:   if (!contextReady()) return;
330:   refreshLocalMask();
331:   sequencer.play();
332:   runInAction(() => {
333:     Band.phase = 'playing';
334:   });
335:   startTimer();
336: }
