220: /** Asks BandSystem to take the instrument out; `takenOut` / `refused` come back next frame. */
221: export function takeOutInstrument(id: InstrumentId): void {
222:   const world = Store.world;
223:   if (!world?.playerEntity) return;
224:   runInAction(() => {
225:     Band.error = null;
226:   });
227:   world.bandRequest = { kind: 'takeOut', instrument: id };
