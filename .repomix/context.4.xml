<file path="src/common/itemHotkeys.ts">
  1: import type { Item } from '../ecs/world';
  2: import { InventoryConstants } from './inventoryConstants';
  3: 
  4: /**
  5:  * The Q/W/E/R consumable slots of the bottom bar (`CNewUIItemHotKey`,
  6:  * NewUIMainFrameWindow.cpp:929-1320).
  7:  *
  8:  * A slot does not hold an item; it holds a *kind* of item (type + level).
  9:  * Every frame the bar looks the kind up in the inventory - best potion first
 10:  * (large → small → apple) - and renders whatever it found with the summed
 11:  * count. Using the key consumes that found item. Unbound slots fall back to
 12:  * HP / MP / antidote / SD for Q / W / E / R.
 13:  */
 14: 
 15: export const HOTKEY_COUNT = 4;
 16: export const HOTKEY_Q = 0;
 17: export const HOTKEY_W = 1;
 18: export const HOTKEY_E = 2;
 19: export const HOTKEY_R = 3;
 20: 
 21: /** The four key codes, in slot order. Ctrl + one of them binds that slot. */
 22: export const ITEM_HOTKEY_CODES: readonly string[] = ['KeyQ', 'KeyW', 'KeyE', 'KeyR'];
 23: 
 24: export const POTION_GROUP = 14;
 25: 
 26: const APPLE = 0;
 27: const LARGE_HEALING = 3;
 28: const SMALL_MANA = 4;
 29: const LARGE_MANA = 6;
 30: const SIEGE = 7;
 31: const ANTIDOTE = 8;
 32: const ALE = 9;
 33: const TOWN_PORTAL = 10;
 34: const FRUIT = 20;
 35: const SMALL_SHIELD = 35;
 36: const LARGE_SHIELD = 37;
 37: const SMALL_COMPLEX = 38;
 38: const LARGE_COMPLEX = 40;
 39: 
 40: export type ItemHotkey = { type: number; level: number };
 41: 
 42: export const UNBOUND_HOTKEY: ItemHotkey = { type: -1, level: 0 };
 43: 
 44: const SINGLE_TYPES = new Set([
 45:   SIEGE,
 46:   ANTIDOTE,
 47:   ALE,
 48:   TOWN_PORTAL,
 49:   FRUIT,
 50:   46, 47, 48, 49, 50, // Jack O'Lantern
 51:   70, 71, 78, 79, 80, 81, 82, 94,
 52:   85, 86, 87, // Cherry blossom
 53:   133,
 54: ]);
 55: 
 56: const isHealing = (n: number) => n >= APPLE && n <= LARGE_HEALING;
 57: const isMana = (n: number) => n >= SMALL_MANA && n <= LARGE_MANA;
 58: const isShield = (n: number) => n >= SMALL_SHIELD && n <= LARGE_SHIELD;
 59: const isComplex = (n: number) => n >= SMALL_COMPLEX && n <= LARGE_COMPLEX;
 60: 
 61: /** `CNewUIMyInventory::CanRegisterItemHotKey`. */
 62: export function canRegisterItemHotkey(item: Item | null | undefined): boolean {
 63:   if (!item || item.group !== POTION_GROUP) return false;
 64:   const n = item.num;
 65:   return (
 66:     isHealing(n) || isMana(n) || isShield(n) || isComplex(n) || SINGLE_TYPES.has(n)
 67:   );
 68: }
 69: 
 70: /**
 71:  * The range [start..end] (descending, best first) a slot searches the
 72:  * inventory for: `GetHotKeyCommonItem` + the per-key defaults of
 73:  * `GetHotKeyItemIndex`.
 74:  */
 75: function searchRange(slot: number, hotkey: ItemHotkey): [number, number] {
 76:   const t = hotkey.type;
 77: 
 78:   if (SINGLE_TYPES.has(t) && (t !== FRUIT || hotkey.level === 0)) return [t, t];
 79:   if (isShield(t)) return [LARGE_SHIELD, SMALL_SHIELD];
 80:   if (isComplex(t)) return [LARGE_COMPLEX, SMALL_COMPLEX];
 81:   if (isHealing(t)) return [LARGE_HEALING, APPLE];
 82:   if (isMana(t)) return [LARGE_MANA, SMALL_MANA];
 83: 
 84:   switch (slot) {
 85:     case HOTKEY_Q:
 86:       return [LARGE_HEALING, APPLE];
 87:     case HOTKEY_W:
 88:       return [LARGE_MANA, SMALL_MANA];
 89:     case HOTKEY_E:
 90:       return [ANTIDOTE, ANTIDOTE];
 91:     default:
 92:       return [LARGE_SHIELD, SMALL_SHIELD];
 93:   }
 94: }
 95: 
 96: const GRID_START = InventoryConstants.LastEquippableItemSlotIndex + 1;
 97: const GRID_END = InventoryConstants.FirstExtensionItemSlotIndex;
 98: 
 99: /** Items with a level of their own, where the level must match to count. */
100: const levelMatters = (n: number) => n === SIEGE || n === TOWN_PORTAL || n === FRUIT;
101: 
102: /**
103:  * `GetHotKeyItemIndex(iType)`: the inventory slot the key would consume, or
104:  * -1. Best potion kind first; within a kind the last grid slot, as
105:  * `FindItemReverseIndex` does.
106:  */
107: export function findHotkeyItem(
108:   items: (Item | null)[],
109:   slot: number,
110:   hotkey: ItemHotkey
111: ): number {
112:   const [start, end] = searchRange(slot, hotkey);
113: 
114:   for (let n = start; n >= end; n--) {
115:     for (let i = GRID_END - 1; i >= GRID_START; i--) {
116:       const item = items[i];
117:       if (!item || item.group !== POTION_GROUP || item.num !== n) continue;
118:       if (levelMatters(n) && (item.lvl ?? 0) !== hotkey.level) continue;
119:       return i;
120:     }
121:   }
122: 
123:   return -1;
124: }
125: 
126: /** `GetHotKeyItemIndex(iType, true)`: the number shown under the icon. */
127: export function countHotkeyItems(
128:   items: (Item | null)[],
129:   slot: number,
130:   hotkey: ItemHotkey
131: ): number {
132:   const [start, end] = searchRange(slot, hotkey);
133:   let count = 0;
134: 
135:   for (let n = start; n >= end; n--) {
136:     for (let i = GRID_START; i < GRID_END; i++) {
137:       const item = items[i];
138:       if (!item || item.group !== POTION_GROUP || item.num !== n) continue;
139:       if (!isHealing(n) && levelMatters(n) && (item.lvl ?? 0) !== hotkey.level) {
140:         continue;
141:       }
142:       // Ale, scrolls and fruit are one per square; potions stack.
143:       if (n === ALE || n === TOWN_PORTAL || n === FRUIT) count++;
144:       else count += item.durability ?? 1;
145:     }
146:   }
147: 
148:   return count;
149: }
</file>

<file path="src/common/itemIconScale.ts">
  1: // Ported from RenderObjectScreen (ZzzInventory.cpp:9308-10090) - do not edit.
  2: // 664 of 667 item types; the rest fall back to
  3: // ITEM_ICON_SCALE_DEFAULT (the three Archangel weapons, which the original
  4: // draws through a separate multi-model path).
  5: //
  6: // `o->Scale` - the size the original renders each item's model at in the
  7: // inventory, hand-tuned per type. It is the relative sizing between items that
