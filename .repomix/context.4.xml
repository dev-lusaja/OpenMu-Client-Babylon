332: 
333:       const texturePath = _readString(dv, DataPtr, DataPtr + 32);
334:       DataPtr += 32;
335: 
336:       mesh.TexturePath = texturePath;
337:     }
338: 
339:     for (let i = 0; i < actions.length; i++) {
340:       const action = (actions[i] = new BMDTextureAction());
341: 
342:       action.NumAnimationKeys = dv.getInt16(DataPtr, true);
343:       DataPtr += 2;
344:       action.LockPositions = dv.getUint8(DataPtr) === 1;
345:       DataPtr += 1;
346: 
347:       if (action.LockPositions) {
348:         // action.Positions = br.ReadStructArray<Vector3>(action.NumAnimationKeys);
349:         action.Positions = new Array(action.NumAnimationKeys).fill(null);
350: 
351:         Size = action.NumAnimationKeys * 12;
352: 
353:         action.Positions.forEach((_, i) => {
354:           let offset = DataPtr + i * 12;
355:           const x = dv.getFloat32(offset, true);
356:           offset += 4;
357:           const y = dv.getFloat32(offset, true);
358:           offset += 4;
359:           const z = dv.getFloat32(offset, true);
360:           offset += 4;
361: 
362:           action.Positions[i] = new Vector3(x, y, z);
363:         });
364:         DataPtr += Size;
365:       }
366:     }
367: 
368:     for (let i = 0; i < bones.length; i++) {
369:       const dummy = dv.getUint8(DataPtr) === 1;
370:       DataPtr += 1;
371: 
372:       if (dummy) {
373:         bones[i] = BMDTextureBone.Dummy;
374:       } else {
375:         const bone = (bones[i] = new BMDTextureBone());
