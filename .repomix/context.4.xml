1407:   /**
1408:    * `true` when the caster is tall enough for its blob to read, and not so
1409:    * wide that it is scenery. Measured off the bind-pose bounds under the
1410:    * node's own scale, so a scaled-down instance of a tall model is judged on
1411:    * what it actually is.
1412:    */
1413:   private get _blobShadowIsVisible(): boolean {
1414:     if (this._blobShadowWorthIt !== null) return this._blobShadowWorthIt;
1415: 
1416:     const root = this.gltf?.mesh;
1417:     if (!root) return false;
1418: 
1419:     let height = 0;
1420:     let footprint = 0;
1421: 
1422:     for (const mesh of root.getChildMeshes(false)) {
1423:       if (mesh.getTotalVertices() === 0) continue;
1424:       const box = mesh.getBoundingInfo().boundingBox;
1425:       height = Math.max(height, box.maximum.y - box.minimum.y);
1426:       footprint = Math.max(
1427:         footprint,
1428:         box.maximum.x - box.minimum.x,
1429:         box.maximum.z - box.minimum.z
1430:       );
1431:     }
1432: 
1433:     const scale = Math.abs(this._node.scaling.x);
1434: 
1435:     this._blobShadowWorthIt =
1436:       height * scale >= ModelObject.BLOB_SHADOW_MIN_HEIGHT &&
1437:       footprint * scale <= ModelObject.BLOB_SHADOW_MAX_FOOTPRINT;
1438: 
1439:     return this._blobShadowWorthIt;
