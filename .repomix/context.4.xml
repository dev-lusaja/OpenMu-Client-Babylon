258:       });
259:       DataPtr += Size;
260: 
261:       // const textCoords = br.ReadStructArray<BMDTexCoord>(numTexCoords);
262:       Size = numTexCoords * SIZE_OF_TexCoord_t;
263: 
264:       mesh.TexCoords.forEach((_, i) => {
265:         let offset = DataPtr + i * SIZE_OF_TexCoord_t;
266:         const x = dv.getFloat32(offset, true);
267:         offset += 4;
268:         const y = dv.getFloat32(offset, true);
269:         offset += 4;
270: 
271:         const texCoord = (mesh.TexCoords[i] = new BMDTexCoord());
272:         texCoord.U = x;
273:         texCoord.V = y;
274:       });
275:       DataPtr += Size;
276: 
277:       // const triangles = br.ReadStructArray<BMDTriangle>(numTriangles);
278:       Size = SIZE_OF_Triangle_t;
279:       for (let j = 0; j < numTriangles; j++) {
280:         let offset = DataPtr;
