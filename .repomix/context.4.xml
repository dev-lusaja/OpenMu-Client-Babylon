  5:   GROUP_AXE,
  6:   GROUP_BOW,
  7:   GROUP_SHIELD,
  8:   GROUP_SPEAR,
  9:   GROUP_SWORD,
 10: } from '../weaponClass';
 11: import { loadGLTF } from '../modelLoader';
 12: import { PlayerObject } from '../playerObject';
 13: import { CharacterClassNumber } from '../types';
 14: import { skeletonShatter } from '../deathVisuals';
 15: 
 16: /**
 17:  * The Skill/Skeleton01..03 monsters (Skeleton Warrior, Skeleton Archer, Elite
 18:  * Skeleton, Death King, Death Bone) are *player-rig* characters in the
 19:  * original: `CreateCharacter(Key, MODEL_PLAYER, …)` with `Object.SubType =
 20:  * MODEL_SKELETON1..3` (ZzzCharacter.cpp:13910-13950), drawn by
 21:  * `RenderPartObject(&c->Object, o->SubType, …)` (:9321) on the Player.bmd
 22:  * bones instead of the helm/armor/… parts. `Skeleton0N.bmd` is a body part
 23:  * file exactly like `ArmorClass01.bmd` - the player's `Bip01` bone list, one
 24:  * single-key bind-pose action, vertices skinned to bones 2..39 - so it has no
 25:  * animation of its own. Loading it standalone and driving it with the
 26:  * monster action table left the mesh posed by whatever clip index happened to
 27:  * exist: the stretched, splayed limbs of the bug report.
 28:  *
 29:  * Here the part rides the player rig in the Armor slot, every other body slot
 30:  * stays empty, the weapons come from the same `c->Weapon[]` kit, and the
 31:  * player state machine (`playerAnimation`) chooses the weapon-class idle /
 32:  * walk / attack clips the way `SetPlayerStop` / `SetPlayerAttack` do for the
 33:  * original's MODEL_PLAYER monsters.
 34:  */
 35: export abstract class SkeletonMonster extends PlayerObject {
 36:   /** Skeleton monsters pose as a male knight (`c->Class` is never set). */
 37:   static NpcClass = CharacterClassNumber.DarkKnight;
 38: 
 39:   /** `o->SubType` in MODEL_SKELETON1..3 dies as a bone shatter (:1383-1390). */
 40:   static DeathShatter = skeletonShatter;
 41: 
 42:   /** The Skill/Skeleton0N part rendered in place of the body. */
 43:   protected abstract readonly part: string;
 44:   /** `c->Weapon[0]` (Weapon1, right hand). */
 45:   protected readonly mainHand: Item | null = null;
 46:   /** `c->Weapon[1]` (Weapon2, left hand). */
 47:   protected readonly offHand: Item | null = null;
 48: 
 49:   async init(world: World, entity: Entity) {
 50:     this.load(await loadGLTF('Player/player.glb', world));
 51:     this.Ready = false;
 52: 
 53:     await this.loadSkeletonPart();
 54: 
 55:     world.addComponent(entity, 'charAppearance', {
 56:       charClass: CharacterClassNumber.DarkKnight,
 57:       helm: null,
 58:       armor: null,
 59:       pants: null,
 60:       gloves: null,
 61:       boots: null,
 62:       leftHand: this.mainHand,
 63:       rightHand: this.offHand,
 64:       wings: null,
 65:       pet: null,
 66:       changed: true,
 67:     });
 68: 
 69:     this.startNpcIdle();
 70:     world.removeComponent(entity, 'monsterAnimation');
 71:     if (!entity.playerAnimation) {
 72:       world.addComponent(entity, 'playerAnimation', {
 73:         action: PlayerAction.PLAYER_SET,
 74:         run: 0,
 75:       });
 76:     }
 77: 
 78:     this.Ready = true;
 79:   }
 80: 
 81:   private loadSkeletonPart() {
 82:     return this.loadPartAsync('Skill/', this.Armor, this.part);
 83:   }
 84: 
 85:   // The body is the skeleton part alone: AppearanceSystem's "no item → class
 86:   // default" fallbacks must not dress it in the default knight kit.
 87:   override async updateBodyPartClassesAsync() {
 88:     await this.loadSkeletonPart();
 89:   }
 90:   override async setDefaultArmor() {
 91:     await this.loadSkeletonPart();
 92:   }
 93:   override async setDefaultHelm() {
 94:     this.Helm.Unload();
 95:   }
 96:   override async setDefaultMask() {
 97:     this.HelmMask.Unload();
 98:   }
 99:   override async setDefaultPants() {
100:     this.Pants.Unload();
101:   }
102:   override async setDefaultGloves() {
103:     this.Gloves.Unload();
104:   }
105:   override async setDefaultBoots() {
106:     this.Boots.Unload();
107:   }
108: }
109: 
