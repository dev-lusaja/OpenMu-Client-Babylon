 1: import type { Item } from '../ecs/world';
 2: import type { TextKey } from '../i18n';
 3: import { equipSlots } from './equipSlots';
 4: import { GameOptions } from './gameOptions';
 5: import { classCanUse, itemDef, type HeroStats } from './itemStats';
 6: 
 7: /**
 8:  * Which worn item a hovered item is measured against, and when the second
 9:  * tooltip is drawn at all.
10:  */
11: 
12: /** `compareTooltips` steps, as the Options slider prints them. */
13: export const COMPARE_TOOLTIP_LABEL_KEYS: readonly TextKey[] = [
14:   'common.off',
15:   'options.compare.shift',
16:   'options.compare.always',
17: ];
18: 
19: export const COMPARE_TOOLTIP_MAX = COMPARE_TOOLTIP_LABEL_KEYS.length - 1;
20: 
21: export const CompareTooltips = {
22:   Off: 0,
23:   HoldShift: 1,
24:   Always: 2,
25: } as const;
26: 
27: export function compareTooltipsOn(shiftHeld: boolean): boolean {
28:   const mode = Math.round(GameOptions.compareTooltips);
29:   if (mode >= CompareTooltips.Always) return true;
30:   return mode === CompareTooltips.HoldShift && shiftHeld;
31: }
32: 
33: /**
34:  * The worn item the hovered one would replace, or null: nothing of the same
35:  * item group worn in a slot it could take, the item is not gear, the hero's
36:  * class can never wear it, or the hovered item is the worn one itself.
37:  *
38:  * Like for like is the item group and nothing wider: a sword against a sword,
39:  * a staff against a staff, a shield against a shield. A staff next to a worn
40:  * sword shares the hand but nothing worth measuring. Rings and earrings take
41:  * the first of their pair, which is the slot the item would land in.
42:  */
43: export function comparedItem(
44:   item: Item,
45:   worn: readonly (Item | null)[],
46:   hero: HeroStats
47: ): Item | null {
48:   const def = itemDef(item.group, item.num);
49:   if (!def || def.slot < 0) return null;
50:   if (!classCanUse(def, hero)) return null;
51: 
52:   for (const slot of equipSlots(item)) {
53:     const other = worn[slot];
54:     if (!other || other === item) continue;
55: 
56:     const otherDef = itemDef(other.group, other.num);
57:     if (otherDef && otherDef.group === def.group) return other;
58:   }
59: 
60:   return null;
61: }
</file>

