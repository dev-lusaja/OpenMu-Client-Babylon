220: export type AmbientRecipe = {
221:   readonly name: string;
222:   /**
223:    * Data file, relative to the Data folder (`World1/leaf01.OZT`), or one of
224:    * the generated sprites (`proc:streak`, `proc:bubble`).
225:    */
226:   readonly texture: string;
227:   readonly blend: AmbientBlend;
228:   /** Particles per second and the capacity the GPU path gets. */
229:   readonly rate: number;
230:   readonly capacity: number;
231:   /** Spawn box around the emitter (tiles). */
232:   readonly box: readonly [Vector3, Vector3];
233:   /** Direction cone (tiles/s after `power`). */
234:   readonly direction: readonly [Vector3, Vector3];
235:   readonly power: readonly [number, number];
236:   readonly life: readonly [number, number];
237:   readonly size: readonly [number, number];
238:   /** Per-axis sprite stretch (rain streaks); 1 = square. */
239:   readonly scaleX?: readonly [number, number];
240:   readonly scaleY?: readonly [number, number];
241:   readonly gravity?: Vector3;
242:   readonly angularSpeed?: readonly [number, number];
243:   readonly colour: readonly [Color4, Color4];
244:   readonly colourDead?: Color4;
245:   /** Noise wander strength per axis (tiles/s²-ish); none = straight flight. */
246:   readonly noise?: Vector3;
247:   /**
248:    * How the particle ITSELF changes with the system's strength, as the
249:    * fraction of each range in effect at the faintest emission. 1 everywhere
250:    * (the default, and what every recipe without this does) means only the
251:    * *number* of particles follows the strength.
252:    *
253:    * That default is wrong for rain and right for nearly everything else. A
254:    * gust of leaves is more leaves; a shower is not just more drops, it is
255:    * bigger and faster ones - the first spits of a shower are small, slow and
256:    * sparse, and a downpour is long fast streaks. With count as the only
257:    * variable, the difference between a drizzle and a downpour is density
258:    * alone, which is what makes a shower look like a tap being opened.
259:    *
260:    * `speed` also buys the drop its `life`: the lifetime is divided by the
261:    * same factor, so **a particle always falls the same distance** whatever
262:    * the intensity - it just takes longer to do it when the rain is light.
263:    * That invariant is what lets a recipe promise its particles reach the
264:    * ground (see `RAIN`) without the promise breaking at low strength.
265:    */
266:   readonly growth?: {
267:     /** Sprite size at the faintest emission, as a fraction of `size`. */
268:     readonly size: number;
269:     /** Streak length, as a fraction of `scaleY`. */
270:     readonly length: number;
271:     /** Fall speed, as a fraction of `power`. Also divides `life`. */
272:     readonly speed: number;
273:   };
274:   /** Stretch the sprite along its velocity (rain). */
275:   readonly stretched?: boolean;
276:   /**
277:    * Weather that falls out of the sky, as against something a room makes of
278:    * its own (dust). Sky-borne systems are clipped to the active room
279:    * (`weather/roomClip.ts`) so a hero standing indoors sees the shower
280:    * through the doorway and none of it on the floor beside him.
281:    */
282:   readonly skyBorne?: boolean;
283:   /** Fade in/out ramp as colour gradients (0 = hard). */
284:   readonly fade?: number;
285:   /**
286:    * Seconds the *emit rate* needs to cross the whole 0…1 strength range.
287:    * The owner only ever sets a target (`setStrength`); the live rate walks
288:    * toward it at this speed, so a recipe starting, stopping or gusting thins
289:    * out and thickens up instead of switching. Default `DEFAULT_RAMP`.
290:    */
291:   readonly ramp?: number;
292:   /**
293:    * Episode schedule off the shared clock. Absent = runs whenever its slot is
294:    * eligible (interior dust, packet-driven rain); present = the owner scales
295:    * `rate` by `ambientStrengthAt`, so weather comes and goes in gusts every
296:    * client agrees on.
297:    */
298:   readonly schedule?: AmbientSchedule;
299: };
