123: const byId = new Map(INSTRUMENTS.map(def => [def.id, def]));
124: 
125: export function instrumentById(id: InstrumentId): InstrumentDefinition {
126:   const def = byId.get(id);
127:   if (!def) throw new Error(`no instrument row for ${id}`);
128:   return def;
129: }
130: 
131: /** The row behind a wire id, or null for one this client does not know. */
132: export function instrumentByIndex(index: number): InstrumentDefinition | null {
133:   return INSTRUMENTS[index] ?? null;
134: }
135: 
136: /** The wire id of a row. */
137: export function instrumentIndex(id: InstrumentId): number {
138:   return INSTRUMENTS.findIndex(def => def.id === id);
139: }
140: 
141: export function isInstrumentId(value: string): value is InstrumentId {
142:   return byId.has(value as InstrumentId);
