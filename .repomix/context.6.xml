166: function update(_map: ENUM_WORLD, dt: number): void {
167:   if (!state.result) return;
168:   resultLeft -= dt;
169:   if (resultLeft <= 0) {
170:     runInAction(() => {
171:       state.result = null;
172:     });
173:   }
