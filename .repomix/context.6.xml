 10:   boidsFor,
 11:   type BoidSpec,
 12: } from '../../common/boids';
 13: import { GameOptions } from '../../common/gameOptions';
 14: import { effects } from '../../effects';
 15: import { FIRE_PUFF, TEX } from '../../effects/recipes';
 16: import { invasionEvent } from '../../events/invasion';
 17: import { playSfx } from '../../libs/sfx';
 18: import type { Entity, ISystemFactory } from '../world';
 19: 
 20: /**
 21:  * `MoveBoids` (GOBoid.cpp:1199-1500): the ambient wildlife, spawned around the
 22:  * hero, flown on a flock rule, and dropped when it gets too far away.
 23:  *
 24:  * Everything here is the original's, in its units, converted once at the
 25:  * edges: positions in centimetres become world units through `MU_UNIT`, and
 26:  * the per-frame steps are per 25 Hz tick scaled by the frame's own delta -
 27:  * the same `FPS_ANIMATION_FACTOR` the original multiplies through.
 28:  *
 29:  * The species and where each one flies are in `common/boids.ts`.
 30:  */
 31: 
 32: /** Spawn box around the hero: `rand()%1024 - 512` in x and y. */
 33: const SPAWN_SPREAD = 512 * MU_UNIT;
 34: /** `RequestTerrainHeight(...) + rand()%200 + 150`. */
 35: const SPAWN_RISE_MIN = 150 * MU_UNIT;
 36: const SPAWN_RISE_SPAN = 200 * MU_UNIT;
 37: 
 38: /** `FlyDistance`: past this from the hero a boid is dropped. */
 39: const FLY_DISTANCE = 1500 * MU_UNIT;
 40: 
 41: /**
 42:  * How far off a boid has to be before its own time can run out.
 43:  *
 44:  * Nothing in the original, which drops one wherever it happens to be. It is
 45:  * the price of fading rather than popping: a fade is a second long and a
 46:  * second is long enough to watch. Inside this the only way out is distance.
 47:  */
 48: const LEAVE_RANGE = 700 * MU_UNIT;
 49: 
 50: /** `Vector(o->Velocity * 25.f, ...)`: forward units per tick. */
 51: const FORWARD_PER_TICK = 25 * MU_UNIT;
 52: 
 53: /** How far ahead the steering aims: `o->Position + 3 * p`. */
 54: const LEAD_AHEAD = 3;
 55: 
 56: /** Flock neighbourhood and the separation radius inside it. */
 57: const FLOCK_RANGE = 400 * MU_UNIT;
 58: const FLOCK_CLOSE = 80 * MU_UNIT;
 59: 
 60: /** The bird's altitude band while flying, absolute (GOBoid.cpp:969-971). */
 61: const BIRD_LOW = 200 * MU_UNIT;
 62: const BIRD_HIGH = 600 * MU_UNIT;
 63: const BIRD_RISE = 10 * MU_UNIT;
 64: const BIRD_DIVE = -20 * MU_UNIT;
 65: 
 66: /** The bat's hover: terrain + 350, dipping 150 on a sine (GOBoid.cpp:926-928). */
 67: const BAT_RISE = 350 * MU_UNIT;
 68: const BAT_DIP = 150 * MU_UNIT;
 69: const BAT_TIMER_PER_TICK = 0.2;
 70: 
 71: /** The butterfly's height band over the terrain, and its wander. */
 72: const FLY_LOW = 50 * MU_UNIT;
 73: const FLY_HIGH = 300 * MU_UNIT;
 74: 
 75: /**
 76:  * The invasion dragon (GOBoid.cpp:1395-1412). It does not flock and it does
 77:  * not turn: `Angle[2]` is fixed at spawn and it holds it, riding a sine
 78:  * between +300 and +400 over the ground and covering `Scale * 40` a tick.
 79:  * `-90` in the original's angles is the same heading its meteors take, so the
 80:  * two stream the same way.
 81:  */
 82: const DRAGON_YAW = 180;
 83: const DRAGON_RIDE = 400 * MU_UNIT;
 84: const DRAGON_DIP = 100 * MU_UNIT;
 85: const DRAGON_TIMER_PER_TICK = 0.05;
 86: const DRAGON_UNITS_PER_TICK = 40 * MU_UNIT;
 87: 
 88: /** Spawn box off the hero: `rand%600 - 100` and `rand%400 + 200`. */
 89: const DRAGON_SPAWN_X = [-100, 500] as const;
 90: const DRAGON_SPAWN_Z = [200, 600] as const;
 91: 
 92: /** `SetAction(o, MONSTER01_DIE + 1)` at `PlaySpeed` 0.5 (_define.h:495-506). */
 93: const DRAGON_ACTION = 7;
 94: const DRAGON_ACTION_SPEED = 0.5;
 95: 
 96: /** `PlayBuffer(SOUND_MONSTER_BULLATTACK1)` on `rand_fps_check(128)`. */
 97: const ROAR_ONE_IN = 128;
 98: 
 99: /**
100:  * The mouth: `BoneTransform[11]` in the original (GOBoid.cpp:1546-1549),
101:  * which the export names `bone_11_attack01`. Skeletons here carry a root bone
102:  * the BMD does not, so an MU bone index is one lower than the glb's - the
103:  * same `+ 1` `ModelObject.ParentBoneLink` applies.
104:  */
105: const MOUTH_BONE = 11 + 1;
106: 
107: /** `CreateSprite(BITMAP_LIGHTNING + 1, ..., 1.f, red)` at the mouth. */
108: const BREATH_CARD_TILES = 0.9;
109: const BREATH_CARD_SECONDS = 0.32;
110: const BREATH_RED = [1, 0, 0] as const;
111: 
112: /**
113:  * The original emits one card and one puff per rendered frame, at 25 Hz. A
114:  * roll instead of a frame, so a 144 Hz client does not put six times the
115:  * flame in the sky as a 25 Hz one.
116:  */
117: const BREATH_ONE_IN = 2;
118: 
119: const DEG = Math.PI / 180;
120: 
121: /** A `rand_fps_check(n)` - one chance in n, per tick, over `ticks` ticks. */
122: function rolled(one_in: number, ticks: number): boolean {
123:   return Math.random() < ticks / one_in;
124: }
125: 
126: const rand = (n: number) => Math.floor(Math.random() * n);
127: 
128: /** `TurnAngle`: toward `to` by at most `by` degrees, the short way round. */
129: function turnToward(from: number, to: number, by: number): number {
130:   let d = ((to - from) % 360 + 540) % 360 - 180;
131: 
132:   if (d > by) d = by;
133:   if (d < -by) d = -by;
134: 
135:   return (from + d + 360) % 360;
136: }
137: 
138: export const BoidSystem: ISystemFactory = world => {
139:   const boids = world.with('boid', 'transform');
140: 
141:   let spec: BoidSpec | null = null;
142:   let map = world.mapIndex;
143:   let sinceSpawn = 0;
144: 
145:   function despawnAll(): void {
146:     for (const e of [...boids]) {
147:       world.remove(e);
148:       e.modelObject?.dispose();
149:     }
150:   }
151: 
152:   function spawn(heroPos: IVector3Like): void {
153:     if (!spec) return;
154: 
155:     const dragon = spec.kind === 'dragon';
156: 
157:     // The dragons come in off one shoulder rather than out of a box centred
158:     // on the hero, and they all fly the same way (GOBoid.cpp:1288-1299).
159:     const x = dragon
160:       ? heroPos.x + (DRAGON_SPAWN_X[0] + rand(DRAGON_SPAWN_X[1] - DRAGON_SPAWN_X[0])) * MU_UNIT
161:       : heroPos.x + (rand(1024) - 512) * MU_UNIT;
162:     const z = dragon
163:       ? heroPos.z + (DRAGON_SPAWN_Z[0] + rand(DRAGON_SPAWN_Z[1] - DRAGON_SPAWN_Z[0])) * MU_UNIT
164:       : heroPos.z + (rand(1024) - 512) * MU_UNIT;
165:     const ground = world.getTerrainHeight(x, z);
166:     const model = spec.models[rand(spec.models.length)];
167:     const range = spec.scaleRange;
168:     const scale = range
169:       ? range[0] + Math.random() * (range[1] - range[0])
170:       : spec.scale;
171:     const ticks = spec.lifeTicks;
172: 
173:     world.add({
174:       worldIndex: world.mapIndex,
175:       transform: {
176:         pos: new Vector3(x, ground + SPAWN_RISE_MIN + Math.random() * SPAWN_RISE_SPAN, z),
177:         rot: new Vector3(0, 0, 0),
178:         scale,
179:       },
180:       modelFactory: boidFactoryFor(spec, model),
181:       visibility: { state: 'hidden', lastChecked: 0 },
182:       boid: {
183:         kind: spec.kind,
184:         ai: 'fly',
185:         yaw: dragon ? DRAGON_YAW : rand(360),
186:         rise: 0,
187:         velocity: spec.velocity,
188:         timer: dragon ? rand(10) * 0.1 : Math.random() * 3.14,
189:         life: ticks
190:           ? (ticks[0] + rand(ticks[1] - ticks[0])) / TICKS_PER_SECOND
191:           : Infinity,
192:         leadX: x,
193:         leadZ: z,
194:         alpha: 0,
195:         leaving: false,
196:       },
197:     });
198:   }
199: 
200:   /**
201:    * `MoveBoid` (ZzzAI.cpp:192): neighbours inside `FLOCK_RANGE` pull the
202:    * heading toward where they are going, and the near ones inside
203:    * `FLOCK_CLOSE` push it the other way. Cohesion and separation in one sum,
204:    * then a turn-rate limit - which is what keeps a flock from snapping.
205:    */
206:   function flock(self: Entity, ticks: number): void {
207:     const s = self.boid!;
208:     const p = self.transform!.pos;
209: 
210:     let n = 0;
211:     let tx = 0;
212:     let tz = 0;
213: 
214:     for (const other of boids) {
215:       if (other === self) continue;
216: 
217:       const o = other.transform!.pos;
218:       const dx = p.x - o.x;
219:       const dz = p.z - o.z;
220:       const dist = Math.hypot(dx, dz);
221: 
222:       if (dist >= FLOCK_RANGE) continue;
223: 
224:       const ob = other.boid!;
225:       let ax = ob.leadX - o.x;
226:       let az = ob.leadZ - o.z;
227: 
228:       if (dist < FLOCK_CLOSE) {
229:         ax -= ob.leadX - p.x;
230:         az -= ob.leadZ - p.z;
231:       } else {
232:         ax += ob.leadX - p.x;
233:         az += ob.leadZ - p.z;
234:       }
235: 
236:       ax *= ticks;
237:       az *= ticks;
238: 
239:       const len = Math.hypot(ax, az) || 1;
240: 
241:       tx += ax / len;
242:       tz += az / len;
243:       n++;
244:     }
245: 
246:     if (!n) return;
247: 
248:     const aimX = p.x + tx / n;
249:     const aimZ = p.z + tz / n;
250:     const want = (Math.atan2(aimX - p.x, aimZ - p.z) / DEG + 360) % 360;
251: 
252:     s.yaw = turnToward(s.yaw, want, spec!.turn * ticks);
253:   }
254: 
255:   /** `MoveBird`: fly, drop in near the hero, sit, then take off again. */
256:   function bird(e: Entity, ticks: number, heroPos: IVector3Like): void {
257:     const s = e.boid!;
258:     const p = e.transform!.pos;
259:     const ground = world.getTerrainHeight(p.x, p.z);
260: 
261:     if (s.ai === 'fly') {
262:       // The original gates the dive on the first quarter of every 8.192 s.
263:       const range = Math.hypot(p.x - heroPos.x, p.z - heroPos.z);
264: 
265:       if (
266:         (Date.now() % 8192) < 2048 &&
267:         range >= 2 &&
268:         range <= 4 &&
269:         rolled(64, ticks)
270:       ) {
271:         s.ai = 'down';
272:       }
273: 
274:       s.velocity = 1;
275:       p.y += (rand(16) - 8) * MU_UNIT * ticks;
276:       if (p.y < BIRD_LOW) s.rise = BIRD_RISE;
277:       else if (p.y > BIRD_HIGH) s.rise = -BIRD_RISE;
278:     }
279: 
280:     if (s.ai === 'down') {
281:       s.rise = BIRD_DIVE;
282: 
283:       if (p.y < ground) {
284:         p.y = ground;
285:         s.ai = 'ground';
286:       }
287:     }
288: 
289:     if (s.ai === 'ground') {
290:       p.y = ground;
291:       s.rise = 0;
292: 
293:       // Up again when the hero moves nearby, or on its own.
294:       const near = Math.hypot(p.x - heroPos.x, p.z - heroPos.z) < 3;
295: 
296:       if (near || rolled(256, ticks)) {
297:         s.ai = 'up';
298:         s.velocity = 1.1;
299:         s.rise = -BIRD_DIVE;
300:       }
301:     }
302: 
303:     if (s.ai === 'up') {
304:       p.y += (rand(16) - 8) * MU_UNIT * ticks;
305:       s.velocity -= 0.005 * ticks;
306: 
307:       if (s.velocity <= 1) {
308:         s.velocity = 1;
309:         s.ai = 'fly';
310:       }
311:     }
312:   }
313: 
314:   /** `MoveBat`: pinned over the ground, dipping on a sine. */
315:   function bat(e: Entity, ticks: number): void {
316:     const s = e.boid!;
317:     const p = e.transform!.pos;
318:     const ground = world.getTerrainHeight(p.x, p.z);
319: 
320:     s.timer += BAT_TIMER_PER_TICK * ticks;
321:     p.y = ground + BAT_RISE - Math.abs(Math.sin(s.timer)) * BAT_DIP;
322:     s.rise = 0;
323:   }
324: 
325:   /** `MoveButterFly`: a wandering climb held inside a band over the ground. */
326:   function butterfly(e: Entity, ticks: number): void {
327:     const s = e.boid!;
328:     const p = e.transform!.pos;
329:     const ground = world.getTerrainHeight(p.x, p.z);
330: 
331:     if (rolled(32, ticks)) {
332:       s.yaw = rand(360);
333:       s.rise = (rand(15) - 7) * MU_UNIT;
334:     }
335: 
336:     s.rise += (rand(15) - 7) * 0.2 * MU_UNIT * ticks;
337: 
338:     if (p.y < ground + FLY_LOW) {
339:       s.rise = s.rise * Math.pow(0.8, ticks) + 1 * MU_UNIT * ticks;
340:     }
341: 
342:     if (p.y > ground + FLY_HIGH) {
343:       s.rise = s.rise * Math.pow(0.8, ticks) - 1 * MU_UNIT * ticks;
344:     }
345: 
346:     p.y += (rand(15) - 7) * 0.3 * MU_UNIT * ticks;
347:   }
348: 
349:   /**
350:    * `MoveBoids`' event branch: no flock rule, no turn, a fixed heading and a
351:    * sine ride over the ground, breathing fire and roaring as it goes.
352:    */
353:   function dragon(e: Entity, ticks: number): void {
354:     const s = e.boid!;
355:     const p = e.transform!.pos;
356:     const scale = e.transform!.scale;
357: 
358:     s.timer += scale * DRAGON_TIMER_PER_TICK * ticks;
359:     p.y =
360:       world.getTerrainHeight(p.x, p.z) +
361:       DRAGON_RIDE -
362:       Math.abs(Math.sin(s.timer)) * DRAGON_DIP;
363:     s.rise = 0;
364: 
365:     const model = e.modelObject;
366: 
367:     if (!model) return;
368: 
369:     model.setActionSpeed(DRAGON_ACTION, DRAGON_ACTION_SPEED);
370:     model.playAction(DRAGON_ACTION, true);
371: 
372:     if (rolled(ROAR_ONE_IN, ticks)) {
373:       // Wildlife at a distance is part of the place, not a monster in front
374:       // of you: it rides the ambience slider.
375:       playSfx('Sound/mBullAttack1', p, { bus: 'ambient' });
376:     }
377: 
378:     if (!rolled(BREATH_ONE_IN, ticks)) return;
379: 
380:     const gltf = model.gltf;
381:     const bone = gltf?.skeleton?.bones[MOUTH_BONE];
382: 
383:     if (!gltf || !bone) return;
384: 
385:     const mouth = bone.getAbsolutePosition(gltf.mesh);
386: 
387:     effects.spawn('particles', world.scene, mouth, {
388:       recipe: FIRE_PUFF,
389:       count: 1,
390:     });
391:     effects.spawn('sprite', world.scene, mouth, {
392:       texture: TEX.lightning2,
393:       colour: BREATH_RED,
394:       size: BREATH_CARD_TILES * scale,
395:       seconds: BREATH_CARD_SECONDS,
396:     });
397:   }
398: 
399:   return {
400:     update(dt) {
401:       // The wildlife rides the ambient budget, like the leaves and the dust.
402:       // An invasion takes the sky over from the map's own species.
403:       const wanted = GameOptions.ambientParticles
404:         ? boidsFor(world.mapIndex, invasionEvent())
405:         : null;
406: 
407:       if (world.mapIndex !== map || wanted !== spec) {
408:         despawnAll();
409:         map = world.mapIndex;
410:         spec = wanted;
411:       }
412: 
413:       if (!spec) return;
414: 
415:       const hero = world.playerEntity?.transform?.pos;
416: 
417:       if (!hero) return;
418: 
419:       const ticks = Math.min(dt, 0.1) * TICKS_PER_SECOND;
420: 
421:       let live = 0;
422: 
423:       for (const e of [...boids]) {
424:         const s = e.boid!;
425:         const p = e.transform!.pos;
426: 
427:         if (s.kind === 'bird') bird(e, ticks, hero);
428:         else if (s.kind === 'bat') bat(e, ticks);
429:         else if (s.kind === 'butterfly') butterfly(e, ticks);
430:         else if (s.kind === 'dragon') dragon(e, ticks);
431: 
432:         // The butterflies flock a quarter as often (GOBoid.cpp:1133); the
433:         // dragons never do - the original holds their spawn angle.
434:         if (
435:           s.ai !== 'ground' &&
436:           s.kind !== 'dragon' &&
437:           (s.kind !== 'butterfly' || rolled(4, ticks))
438:         ) {
439:           flock(e, ticks);
440:         }
441: 
442:         if (s.ai !== 'ground') {
443:           const step =
444:             s.kind === 'dragon'
445:               ? e.transform!.scale * DRAGON_UNITS_PER_TICK * ticks
446:               : s.velocity * FORWARD_PER_TICK * ticks;
447:           const rad = s.yaw * DEG;
448:           const fx = Math.sin(rad);
449:           const fz = Math.cos(rad);
450: 
451:           p.x += fx * step;
452:           p.z += fz * step;
453:           p.y += s.rise * ticks;
454: 
455:           s.leadX = p.x + LEAD_AHEAD * fx * step;
456:           s.leadZ = p.z + LEAD_AHEAD * fz * step;
457:         }
458: 
459:         // The model faces along its heading; MU yaw is the render angle's
460:         // mirror, the same relationship every other object here has - plus a
461:         // half turn for a species wearing a monster model, which the rest of
462:         // the game orients the other way round (`BoidSpec.modelHalfTurn`).
463:         e.transform!.rot.y = spec.modelHalfTurn
464:           ? Math.PI - rad0(s.yaw)
465:           : -rad0(s.yaw);
466: 
467:         // Out of range, or its time is up. Either way it is told to leave
468:         // rather than deleted: the original fades one in and out through
469:         // `o->Alpha`, and popping a bird out of the middle of the sky is the
470:         // one thing the eye is guaranteed to catch.
471:         //
472:         // The 1-in-512 is the original's own (GOBoid.cpp:1191), but there it
473:         // sets `Live = false` and the bird is gone between two frames, high up
474:         // and unwatched. Spread over most of a second it becomes something a
475:         // player can stand and watch happen, so it only fires on a bird that
476:         // is flying and already far enough off to be at the edge of the eye.
477:         //
478:         // A grounded one is exempt outright. It came down in front of the
479:         // player and it leaves the way it arrived, by taking off: `bird()`
480:         // sends it up as soon as the hero is within three tiles, or on its own
481:         // 1-in-256. Fading one out where it stands is the one place this is
482:         // certain to be seen.
483:         //
484:         // A dragon is exempt from both: the original gives it a `LifeTime`
485:         // instead (GOBoid.cpp:1284) and a `FlyDistance` of its own
486:         // (:1178-1181), and never rolls the 1-in-512 on it.
487:         const range = Math.hypot(p.x - hero.x, p.z - hero.z);
488:         const flyDistance = spec.flyDistance
489:           ? spec.flyDistance * MU_UNIT
490:           : FLY_DISTANCE;
491: 
492:         s.life -= dt;
493: 
494:         if (
495:           !s.leaving &&
496:           (range >= flyDistance ||
497:             s.life <= 0 ||
498:             (s.kind !== 'dragon' &&
499:               s.ai === 'fly' &&
500:               range >= LEAVE_RANGE &&
501:               rolled(512, ticks)))
502:         ) {
503:           s.leaving = true;
504:         }
505: 
506:         s.alpha = s.leaving
507:           ? s.alpha - dt / FADE_OUT
508:           : Math.min(1, s.alpha + dt / FADE_IN);
509: 
510:         if (s.alpha <= 0) {
511:           world.remove(e);
512:           e.modelObject?.dispose();
513:           continue;
514:         }
515: 
516:         e.modelObject?.setAlpha(s.alpha);
517: 
518:         live++;
519:       }
520: 
521:       // Paced, not filled. Left ungated it reached the ceiling within a
522:       // second of a warp and the flocking knotted the lot of them together.
523:       sinceSpawn += dt;
524: 
525:       const max = spec.max ?? MAX_BOIDS;
526: 
527:       if (live >= max) return;
528: 
529:       // The dragons keep the original's own gate instead: one roll per free
530:       // slot per tick (GOBoid.cpp:1277). There are five slots and they cross
531:       // the map in a few seconds, so pacing them would empty the sky.
532:       if (spec.spawnOneIn) {
533:         for (let i = live; i < max; i++) {
534:           if (rolled(spec.spawnOneIn, ticks)) spawn(hero);
535:         }
536: 
537:         return;
538:       }
539: 
540:       if (sinceSpawn >= SPAWN_INTERVAL) {
541:         sinceSpawn = 0;
542:         spawn(hero);
543:       }
544:     },
545:   };
546: };
547: 
548: const rad0 = (deg: number) => deg * DEG;
</file>

<file path="src/ecs/systems/calculateScreenPositionSystem.ts">
  1: import { Matrix, Vector2, Vector3 } from '../../libs/babylon/exports';
  2: import {
  3:   clearScreenPositionListeners,
  4:   emitScreenPosition,
  5: } from '../../libs/screenPositionBus';
  6: import { Entity, ISystemFactory } from '../world';
  7: 
  8: const DIST = 10;
  9: 
 10: const DIST_SQUARED = DIST ** 2;
 11: 
 12: const ZERO_MATRIX = Matrix.Identity();
 13: 
 14: export const CalculateScreenPositionSystem: ISystemFactory = world => {
 15:   const query = world.with('screenPosition', 'worldIndex', 'transform');
 16: 
 17:   const finalPosition = Vector3.Zero();
 18:   const screenPosition = Vector3.Zero();
 19:   const viewProjection = Matrix.Identity();
 20: 
 21:   const tmp1 = Vector3.Zero();
 22:   const tmp2 = Vector3.Zero();
 23:   const sidePosition = Vector3.Zero();
 24:   const sideScreen = Vector3.Zero();
 25: 
 26:   const result = {
 27:     entity: null as Entity | null,
 28:     screenPosition: Vector2.Zero(),
 29:   };
 30: 
 31:   const hiddenEntities = new Set<Entity>();
 32: 
 33:   query.onEntityRemoved.subscribe(e => {
 34:     hiddenEntities.delete(e);
 35:     clearScreenPositionListeners(e);
 36:   });
 37: 
 38:   const scene = world.scene;
 39: 
 40:   const engine = scene.getEngine();
 41: 
 42:   return {
 43:     update: () => {
 44:       const terrain = world.terrain;
 45:       if (!terrain) return;
 46:       const playerEntity = world.playerEntity;
 47: 
 48:       if (!playerEntity) return;
 49: 
 50:       const camera = scene.activeCamera;
 51:       if (!camera) return;
 52: 
 53:       const renderW = engine.getRenderWidth();
 54:       const renderH = engine.getRenderHeight();
 55:       camera.viewport.toGlobalToRef(renderW, renderH, world.viewport);
 56: 
 57:       // Project with the camera's *current* view matrix, not
 58:       // `scene.getTransformMatrix()`, which is the matrix of the previous
 59:       // `scene.render()` - a stale camera makes labels trail their owners.
 60:       camera
 61:         .getViewMatrix()
 62:         .multiplyToRef(camera.getProjectionMatrix(), viewProjection);
 63: 
 64:       // Labels are CSS-positioned, so convert render pixels to CSS pixels
 65:       // (device pixel ratio / hardware scaling).
 66:       const canvas = engine.getRenderingCanvas();
 67:       const cssW = canvas?.clientWidth || renderW;
 68:       const cssH = canvas?.clientHeight || renderH;
 69:       const ratioX = renderW / cssW;
 70:       const ratioY = renderH / cssH;
 71: 
 72:       const mapParent = world.mapParent.position;
 73: 
 74:       const playerTransform = playerEntity.transform;
 75:       tmp1.x = playerTransform.pos.x + (playerTransform.posOffset?.x ?? 0);
 76:       tmp1.y = playerTransform.pos.y + (playerTransform.posOffset?.y ?? 0);
 77:       tmp1.z = playerTransform.pos.z + (playerTransform.posOffset?.z ?? 0);
 78: 
 79:       query.entities.forEach(entity => {
 80:         if (world.mapIndex !== entity.worldIndex) {
 81:           if (!hiddenEntities.has(entity)) {
 82:             hiddenEntities.add(entity);
 83:             entity.screenPosition.x = entity.screenPosition.y = 0;
 84:             result.screenPosition.copyFrom(entity.screenPosition);
 85:             emitScreenPosition(entity, result.screenPosition);
 86:           }
 87:           return;
 88:         }
 89: 
 90:         screenPosition.setAll(0);
 91: 
 92:         // Anchor at the rendered position: `transform.pos` is the tile
 93:         // corner, `posOffset` centres characters on the tile (RenderSystem /
 94:         // HeadTrackingSystem apply the same sum).
 95:         const { pos, posOffset } = entity.transform;
 96:         finalPosition.x = pos.x + (posOffset?.x ?? 0) + mapParent.x;
 97:         finalPosition.y = pos.y + (posOffset?.y ?? 0) + mapParent.y;
 98:         finalPosition.z = pos.z + (posOffset?.z ?? 0) + mapParent.z;
 99: 
100:         tmp2.copyFrom(finalPosition);
101: 
102:         finalPosition.y += entity.screenPosition.worldOffsetZ;
103: 
104:         const distSquared = Vector3.DistanceSquared(tmp1, tmp2);
105: 
106:         if (distSquared < DIST_SQUARED) {
107:           Vector3.ProjectToRef(
108:             finalPosition,
109:             ZERO_MATRIX,
110:             viewProjection,
111:             world.viewport,
112:             screenPosition
113:           );
114:         }
115: 
116:         const scrPos = entity.screenPosition;
117: 
118:         scrPos.x = screenPosition.x / ratioX;
119:         scrPos.y = screenPosition.y / ratioY;
120: 
121:         // An emoji bubble hangs off its own world anchor (over the head, or
122:         // on the shoulder facing the camera - placed by EmojiBubbleSystem)
123:         // rather than off the balloon anchor above, so it gets its own
124:         // projection here, where the matrices and the ratios are to hand.
125:         const bubble = entity.emojiBubble;
126: 
127:         if (bubble) {
128:           sidePosition.x = bubble.anchor.x + mapParent.x;
129:           sidePosition.y = bubble.anchor.y + mapParent.y;
130:           sidePosition.z = bubble.anchor.z + mapParent.z;
131: 
132:           // Behind the camera the projection folds back onto the screen, so
133:           // test the clip-space w before trusting it.
134:           const m = viewProjection.m;
135:           const w =
136:             sidePosition.x * m[3] +
137:             sidePosition.y * m[7] +
138:             sidePosition.z * m[11] +
139:             m[15];
140: 
141:           if (w > 0) {
142:             Vector3.ProjectToRef(
143:               sidePosition,
144:               ZERO_MATRIX,
145:               viewProjection,
146:               world.viewport,
147:               sideScreen
148:             );
149: 
150:             bubble.screenX = sideScreen.x / ratioX;
151:             bubble.screenY = sideScreen.y / ratioY;
152:             bubble.onScreen = true;
153:           } else {
154:             bubble.onScreen = false;
155:           }
156:         }
157: 
158:         result.screenPosition.copyFrom(scrPos);
159: 
160:         const uiDistSqrt = scrPos.x * scrPos.x + scrPos.y * scrPos.y;
161: 
162:         const isHidden = uiDistSqrt < 0.1;
163: 
164:         if (isHidden) {
165:           if (!hiddenEntities.has(entity)) {
166:             hiddenEntities.add(entity);
167:             emitScreenPosition(entity, result.screenPosition);
168:           }
169: 
170:           return;
171:         }
172: 
173:         hiddenEntities.delete(entity);
174: 
175:         emitScreenPosition(entity, result.screenPosition);
176:       });
177:     },
178:   };
179: };
</file>

<file path="src/ecs/systems/calculateVisibilitySystem.ts">
 1: import type { ISystemFactory } from '../world';
 2: import { GameOptions } from '../../common/gameOptions';
 3: import { renderDistanceRanges } from '../../common/renderDistance';
 4: 
 5: export const CalculateVisibilitySystem: ISystemFactory = world => {
 6:   const query = world.with('transform', 'visibility');
 7: 
 8:   return {
 9:     update: dt => {
10:       const terrain = world.terrain;
11:       if (!terrain) return;
12: 
13:       // Hero-relative load radius, in tiles - the Render distance option
14:       // (`common/renderDistance.ts`), whose step 0 is the pair this held
15:       // as constants. Babylon frustum-culls the loaded meshes, so the radius
16:       // only has to cover what the camera can possibly see, and the camera
17:       // facade's zoom, pitch and FOV all move that horizon.
18:       const { visible: visibleRange, nearby: nearbyRange } =
19:         renderDistanceRanges(GameOptions.renderDistance);
20: 
21:       const playerEntity = world.playerEntity;
22: 
23:       if (!playerEntity) {
24:         for (const { visibility } of query) {
25:           if (visibility.state === 'visible') continue;
26: 
27:           visibility.state = 'visible';
28:           visibility.lastChecked = 1;
29:         }
30: 
31:         return;
32:       }
33: 
34:       for (const { transform, visibility } of query) {
35:         visibility.lastChecked -= dt;
36: 
37:         if (visibility.lastChecked > 0) continue;
38: 
39:         const distance = Math.sqrt(
40:           Math.pow(transform.pos.x - playerEntity.transform.pos.x, 2) +
41:             Math.pow(transform.pos.z - playerEntity.transform.pos.z, 2)
42:         );
43: 
44:         if (distance <= visibleRange) {
45:           visibility.state = 'visible';
46:           visibility.lastChecked = 0.2;
47:         } else if (distance <= nearbyRange) {
48:           visibility.state = 'nearby';
49:           visibility.lastChecked = 0.3;
50:         } else {
51:           visibility.state = 'hidden';
52:           visibility.lastChecked = 1;
53:         }
54:       }
55:     },
56:   };
57: };
</file>

<file path="src/ecs/systems/cameraFollowSystem.ts">
 1: import { Vector3, type ArcRotateCamera } from '../../libs/babylon/exports';
 2: import type { ISystemFactory } from '../world';
 3: import { Store, UIState } from '../../store';
 4: import {
 5:   installCameraControl,
 6:   releaseMouseLook,
 7:   showHeroBody,
 8:   updateGameCamera,
 9: } from '../../camera';
10: 
11: const v3Temp = Vector3.Zero();
12: 
13: export const CameraFollowSystem: ISystemFactory = world => {
14:   const scene = world.scene;
15: 
16:   // At factory time nothing has moved the camera yet, so the classic framing
17:   // the module captures is the constructor's.
18:   installCameraControl(
19:     scene.defaultCamera,
20:     () => Store.uiState === UIState.World
21:   );
22: 
23:   return {
24:     update: dt => {
25:       const camera = scene.activeCamera as ArcRotateCamera;
26: 
27:       if (!camera) return;
28: 
29:       const playerEntity = world.playerEntity;
30:       if (!playerEntity) return;
31: 
32:       v3Temp.copyFrom(playerEntity.transform.pos as any);
33: 
34:       const offset = playerEntity.transform.posOffset;
35:       if (offset !== undefined) {
36:         // Component-wise: posOffset may be a plain {x, y, z} (see renderSystem).
37:         v3Temp.x += offset.x;
38:         v3Temp.y += offset.y;
39:         v3Temp.z += offset.z;
40:       }
41: 
42:       camera.target.copyFrom(v3Temp);
43: 
44:       // The login/character screens keep their own camera (loginSceneSystem).
45:       if (Store.uiState !== UIState.World) {
46:         // Leaving the world with the camera zoomed into the hero's head would
47:         // strand the body hidden - and the pointer locked.
48:         showHeroBody();
49:         releaseMouseLook();
50:         return;
51:       }
52: 
53:       updateGameCamera(
54:         camera,
55:         world.mapIndex,
56:         world.keyboardInput.pressedKeys,
57:         playerEntity.modelObject?.node ?? null,
58:         dt
59:       );
60:     },
61:   };
62: };
