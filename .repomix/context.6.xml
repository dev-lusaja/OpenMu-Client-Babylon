143:   function sendTargeted(skill: number, targetId: number): void {
144:     if (Store.isOffline) return;
145:     const packet = TargetedSkillPacket.createPacket();
146:     packet.SkillId = skill;
147:     packet.TargetId = targetId;
148:     Store.sendToGS(packet.buffer);
149:   }
