184: 
185:   /** Open the Map tab on a map, with a player picked out. */
186:   showOnMap(map: number | null, playerId: string | null): void {
187:     this.mapView = map;
188:     this.selectedPlayerId = playerId;
189:     this.setSection('map');
190:   }
191: 
192:   setSkin(skin: number): void {
193:     this.skin = skin;
194:   }
195: 
196:   /**
197:    * What the Console lists: the commands matching the filter box, or all of
198:    * them grouped when it is empty. Searching across groups is the point of it -
199:    * `/setmoney` is only in Players if you already knew that.
200:    */
201:   get consoleGroups(): readonly { titleKey: TextKey; commands: readonly GmCommand[] }[] {
202:     if (!this.query.trim()) return GM_GROUPS;
203: 
204:     const found = matchGmCommands(this.query);
205:     return found.length ? [{ titleKey: 'gm.console.matches', commands: found }] : [];
206:   }
207: 
208:   /** Click a command in the Console: open its form, or close it if it was open. */
209:   select(command: GmCommand): void {
210:     this.error = null;
211:     this.confirming = null;
212:     this.selected = this.selected?.command === command.command ? null : command;
213:   }
214: 
215:   closeForm(): void {
216:     this.selected = null;
217:     this.confirming = null;
218:     this.error = null;
219:   }
220: 
221:   private clearPending(): void {
222:     this.selected = null;
223:     this.confirming = null;
224:     this.error = null;
225:   }
226: 
227:   valueFor(command: GmCommand, paramName: string): string {
228:     return this.values[`${command.command}:${paramName}`] ?? '';
229:   }
230: 
231:   setValue(command: GmCommand, paramName: string, value: string): void {
232:     this.values[`${command.command}:${paramName}`] = value;
233:     this.error = null;
234:     // Editing after asking to confirm means the answer was to the old line.
235:     this.confirming = null;
236:   }
237: 
238:   /**
239:    * The values a command would be sent with. `characterName` falls back to the
240:    * shared target, so picking someone in Live fills every tab at once without
241:    * copying the name into each form.
242:    */
243:   private valuesFor(command: GmCommand, overrides?: Record<string, string>): Record<string, string> {
244:     const values: Record<string, string> = {};
245: 
246:     for (const param of command.params ?? []) {
247:       const own = this.valueFor(command, param.name);
248:       values[param.name] =
249:         overrides?.[param.name] ??
250:         (own || (param.name === 'characterName' ? this.target : ''));
251:     }
252: 
253:     return values;
254:   }
255: 
256:   /** The line as it stands, for a form's preview row. */
257:   preview(command: GmCommand, overrides?: Record<string, string>): string {
258:     const built = buildCommandLine(command, this.valuesFor(command, overrides));
259:     return 'line' in built ? built.line : command.command;
260:   }
261: 
262:   /** True while `command` is armed and waiting for its second press. */
263:   isArmed(command: GmCommand, overrides?: Record<string, string>): boolean {
264:     return this.confirming !== null && this.confirming === this.preview(command, overrides);
265:   }
266: 
267:   /**
268:    * Run a command. A `confirm: true` one arms instead on the first press and
269:    * runs on the second, so nothing that takes someone's access away is one
270:    * click from a misplaced cursor. Arming remembers the *line*, not the
271:    * command, so changing a field disarms it.
272:    */
273:   run(command: GmCommand, overrides?: Record<string, string>): void {
274:     const built = buildCommandLine(command, this.valuesFor(command, overrides));
275: 
276:     if ('error' in built) {
277:       this.error = built.error;
278:       this.confirming = null;
279:       return;
280:     }
281: 
282:     if (command.confirm && this.confirming !== built.line) {
283:       this.error = null;
284:       this.confirming = built.line;
285:       return;
286:     }
287: 
288:     this.confirming = null;
289:     this.error = null;
290:     this.send(built.line);
291:   }
292: 
293:   /** The Console's raw line, and anything else that already knows what to send. */
294:   sendRaw(line: string): void {
295:     const trimmed = line.trim();
296:     if (!trimmed.startsWith('/')) {
297:       this.error = t('gm.error.needsSlash');
298:       return;
299:     }
300: 
301:     this.error = null;
302:     this.send(trimmed);
303:   }
304: 
305:   private send(line: string): void {
306:     this.sent = [...this.sent, { id: this.nextId++, line, at: Date.now() }].slice(-MAX_SENT);
307:     this.queue.push(line);
308:     this.drain();
309:   }
310: 
311:   private drain(): void {
312:     if (this.timer) return;
313: 
314:     const line = this.queue[0];
315:     if (line === undefined) return;
316: 
317:     if (Social.sendChat(line)) {
318:       this.queue.shift();
319:       if (this.queue.length === 0) return;
320:     }
321: 
322:     // Either the cooldown refused this line, or more are waiting behind it.
323:     this.timer = setTimeout(() => {
324:       runInAction(() => {
325:         this.timer = null;
326:         this.drain();
327:       });
328:     }, RETRY_MS);
329:   }
330: 
331:   /** Character select and logout: the panel belongs to the character. */
332:   reset(): void {
333:     runInAction(() => {
334:       this.open = false;
335:       this.section = 'live';
336:       this.target = '';
337:       this.query = '';
338:       this.search = '';
339:       this.selected = null;
340:       this.selectedPlayerId = null;
341:       this.mapView = null;
342:       this.logCharacter = '';
343:       this.skin = 0;
344:       this.confirming = null;
345:       this.error = null;
346:       this.sent = [];
347:       this.values = {};
348:       this.queue = [];
349:       if (this.timer) {
350:         clearTimeout(this.timer);
351:         this.timer = null;
352:       }
353:     });
354:   }
355: })();
