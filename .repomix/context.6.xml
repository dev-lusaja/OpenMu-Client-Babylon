 4: /**
 5:  * The contract every event entry implements: one file per event (Blood
 6:  * Castle, Devil Square, Chaos Castle, the shared notices), one exported
 7:  * `EventLayer` per file, listed once in `layers.ts`. Copy `_template.ts` for the recipe.
 8:  *
 9:  * The four common-core fields (`name`, `maps?`, `update?`, `reset?`) are
10:  * spelled exactly like every other system's contract.
11:  * The extras are what every event must answer: a `state()` snapshot for the
12:  * HUD and tools, and - optionally - the inventory ticket that opens it.
13:  */
14: export interface EventLayer {
15:   /** Unique camelCase, identical to the file name. */
16:   readonly name: string;
17: 
18:   /** Event maps this entry tracks (the timer HUD, scores). Omit = every map. */
19:   readonly maps?: ReadonlySet<ENUM_WORLD>;
20: 
21:   /**
22:    * Once a frame, in `layers.ts` order, before anything reads the events.
23:    * `dt` is seconds; timers count down here, packets only resync them.
24:    */
25:   update?(map: ENUM_WORLD, dt: number): void;
26: 
27:   /**
28:    * Map changed: drop the match being tracked (`CreateEventMatch` recreates
29:    * the match object on every warp) and close any entry window.
30:    */
31:   reset?(): void;
32: 
33:   /** Snapshot for the HUD: is a window of this entry up, is a match running. */
34:   state(): EventEntryState;
35: 
36:   /**
37:    * A ticket item was double-clicked in the inventory (`CNewUIMyInventory`
38:    * → `SendRequestEventRemainTime` in the original). Return true when the
39:    * item is this event's ticket and the request was taken over.
40:    */
41:   useTicket?(slot: number, item: Item): boolean;
42: 
43:   /**
44:    * The hero reached and clicked an NPC. Return true when the NPC belongs to
45:    * this event (the Crywolf statue) and the talk was taken over, so no
46:    * `TalkToNpcRequest` goes out.
47:    */
48:   useNpc?(npc: { netId: number; name: string; npcType: number }): boolean;
49: }
50: 
51: export type EventEntryState = {
52:   /** A window or prompt of this entry is on screen. */
53:   readonly open: boolean;
54:   /** The hero is on one of the entry's maps with a match being tracked. */
55:   readonly running: boolean;
56: };
</file>

