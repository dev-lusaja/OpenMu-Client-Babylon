31: 
32:         const ids: number[] = [];
33: 
34:         for (let x = 0; x < TERRAIN_SIZE; x++) {
35:           for (let y = 0; y < TERRAIN_SIZE; y++) {
36:             const isWalkable = world.isWalkable(x, y);
37: 
38:             if (!isWalkable) {
39:               ids.push(x * TERRAIN_SIZE + y);
40:             }
41:           }
42:         }
