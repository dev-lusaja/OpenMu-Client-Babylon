 1: import {
 2:   type MutableRefObject,
 3:   useEffect,
 4:   useMemo,
 5:   useRef,
 6:   useState,
 7: } from 'react';
 8: import type { Entity } from '../ecs/world';
 9: import type { IVector2Like } from '../libs/babylon/exports';
10: import { onScreenPosition } from '../libs/screenPositionBus';
11: 
12: export function useRenderId() {
13:   const [renderId, incRenderId] = useState(() => 0);
14: 
15:   const refresh = useMemo(() => () => incRenderId(val => ++val), []);
16: 
17:   return { renderId, refresh } as const;
18: }
19: 
20: const TOO_FAR = `translate(-10000px, -10000px)`;
21: 
22: export function usePositionOnScreen(
23:   e: Entity,
24:   ref: MutableRefObject<HTMLElement | null>,
25:   offsetX: number = 0,
26:   offsetY: number = 0,
27:   preprocessScreenPosition?: (resultPoint: { x: number; y: number }) => void
28: ) {
29:   const fontSize = 1;
30: 
31:   offsetX *= fontSize;
32:   offsetY *= fontSize;
33: 
34:   const preprocessorRef = useRef(preprocessScreenPosition);
35: 
36:   preprocessorRef.current = preprocessScreenPosition;
37: 
38:   useEffect(() => {
39:     let outOfScreen = true;
40: 
41:     const element = ref.current;
42:     if (element != null) {
43:       element.style.transform = TOO_FAR;
44:     }
45: 
46:     const point = {
47:       x: 0,
48:       y: 0,
49:     };
50: 
51:     const handler = (screenPosition: IVector2Like) => {
52:       const element = ref.current;
53:       if (element == null) return;
54: 
55:       const lngSqrt =
56:         screenPosition.x * screenPosition.x +
57:         screenPosition.y * screenPosition.y;
58: 
59:       if (lngSqrt < 0.1) {
60:         if (!outOfScreen) {
61:           element.style.transform = TOO_FAR;
62:           outOfScreen = true;
63:         }
64:         return;
65:       }
66: 
67:       outOfScreen = false;
68: 
69:       const x = Math.floor(screenPosition.x + offsetX);
70:       const y = Math.floor(screenPosition.y + offsetY);
71: 
72:       point.x = x;
73:       point.y = y;
74: 
75:       if (preprocessorRef.current != null) {
76:         preprocessorRef.current(point);
77:       }
78: 
79:       element.style.transform = `translate(${point.x}px, ${point.y}px)`;
80:     };
81: 
82:     return onScreenPosition(e, handler);
83:   }, [e, ref, preprocessorRef]);
84: }
</file>

<file path="src/hooks/useEventBus.ts">
 1: import { useEffect, useRef } from 'react';
 2: import type { Events } from '../libs/eventBus/events';
 3: import { EventBus } from '../libs/eventBus';
 4: 
 5: /**
 6:  * Subscribes to one `EventBus` event for the component's lifetime. The
 7:  * latest `callback` is always the one called, without re-subscribing on
 8:  * every render.
 9:  */
10: export function useEventBus<TKey extends keyof Events>(
11:   evName: TKey,
12:   callback: (data: Events[TKey]) => any
13: ) {
14:   const callbackRef = useRef(callback);
15: 
16:   // Assigned in an effect, not during render, so a render that is thrown
17:   // away (StrictMode, Suspense) never leaks its closure into the listener.
18:   useEffect(() => {
19:     callbackRef.current = callback;
20:   });
21: 
22:   useEffect(() => {
23:     const listener = (data: Events[TKey]) => {
24:       callbackRef.current(data);
25:     };
26:     EventBus.on(evName, listener);
27: 
28:     return () => {
29:       EventBus.off(evName, listener);
30:     };
31:   }, [evName]);
32: }
</file>

