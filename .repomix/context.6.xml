  1: import { TILE_CM, TWFlags } from '../../common/terrain/consts';
  2: import { isFlagInBinaryMask } from '../../common/utils';
  3: import { InventoryConstants } from '../../common/inventoryConstants';
  4: import { Store } from '../../store';
  5: import { BaseClass, getBaseClass } from '../../common/characterStats';
  6: import { isSwimWorld } from '../../common/locomotion';
  7: import { isFastWing } from '../../common/wings';
  8: import { isRidingMount } from '../../common/pets';
  9: import type { Entity, ISystemFactory } from '../world';
 10: import { distanceAlongPath } from '../../common/approachPath';
 11: 
 12: /**
 13:  * OpenMU walks every object by wall-clock time: each step takes
 14:  * `100 * tileDistance / movementSpeed * 40 ms` (PlayerMovement.GetStepDelay),
 15:  * i.e. `movementSpeed / 4` tiles per second. The speed is 12 while walking
 16:  * (safe zone, or no running gear) and the MovementSpeed attribute otherwise -
 17:  * 15 with boots of level >= 5 or wings (MovementSpeedConstants). The client
 18:  * has to cover the same distance in the same time, otherwise the next
 19:  * WalkRequest's source tile drifts away from the server's position and the
 20:  * server rubber-bands us (`Resynchronizing client`, tolerance 5 tiles).
 21:  */
 22: const WALK_MOVEMENT_SPEED = 12;
 23: const RUNNING_GEAR_MOVEMENT_SPEED = 15;
 24: const RUNNING_GEAR_MINIMUM_LEVEL = 5;
 25: const REFERENCE_FRAME_SECONDS = 0.04;
 26: 
 27: /** Tiles per second the server expects for `movementSpeed`. */
 28: function tilesPerSecond(movementSpeed: number): number {
 29:   return movementSpeed / (TILE_CM * REFERENCE_FRAME_SECONDS);
 30: }
 31: 
 32: /** OpenMU `MovementSpeedConstants`: wings / mounts, and the classes that run natively. */
 33: const DEFAULT_WING_MOVEMENT_SPEED = 15;
 34: const FAST_WING_MOVEMENT_SPEED = 16;
 35: const BASIC_MOUNT_MOVEMENT_SPEED = 15;
 36: const HORSE_OR_FENRIR_MOVEMENT_SPEED = 17;
 37: const DARK_HORSE = 4;
 38: const HORN_OF_FENRIR = 37;
 39: 
 40: /**
 41:  * `Stats.MovementSpeed` (or `MovementSpeedUnderwater` in a swim world) as
 42:  * OpenMU aggregates it (AggregateType.Maximum) from the class and the gear:
 43:  *  - Dark Lord, Magic Gladiator and Rage Fighter carry 15 as a base value
 44:  *    (ClassDarkLord.cs:128, ClassMagicGladiator.cs:130, ClassRageFighter.cs:100),
 45:  *  - boots of level >= 5 give 15 (gloves >= 5 underwater instead),
 46:  *  - wings 15, Wings of Dragon / Wing of Storm 16,
 47:  *  - Uniria / Dinorant 15, Dark Horse / Fenrir 17 (the upgraded-Fenrir
 48:  *    combination bonuses are not modelled).
 49:  * Without any of these the server walks at 12 even while the client plays the
 50:  * run clip - OpenMU has no free run for the Dark Knight.
 51:  */
 52: function runningMovementSpeed(entity: Entity, world: number): number {
 53:   const items = Store.playerData.items;
 54:   const app = entity.charAppearance;
 55:   const local = !!entity.localPlayer;
 56:   const boots = local ? items[InventoryConstants.BootsSlot] : app?.boots;
 57:   const gloves = local ? items[InventoryConstants.GlovesSlot] : app?.gloves;
 58:   const wings = local ? items[InventoryConstants.WingsSlot] : app?.wings;
 59:   const pet = local ? items[InventoryConstants.PetSlot] : app?.pet;
 60:   const cls = local ? Store.playerData.charClass : app?.charClass;
 61: 
 62:   let speed = 0;
 63:   if (cls !== undefined) {
 64:     const base = getBaseClass(cls);
 65:     if (base === BaseClass.DarkLord || base === BaseClass.MagicGladiator || base === BaseClass.RageFighter) {
 66:       speed = RUNNING_GEAR_MOVEMENT_SPEED;
 67:     }
 68:   }
 69:   const gear = isSwimWorld(world) ? gloves : boots;
 70:   if (gear && (gear.lvl ?? 0) >= RUNNING_GEAR_MINIMUM_LEVEL) {
 71:     speed = Math.max(speed, RUNNING_GEAR_MOVEMENT_SPEED);
 72:   }
 73:   if (wings) {
 74:     speed = Math.max(speed, isFastWing(wings) ? FAST_WING_MOVEMENT_SPEED : DEFAULT_WING_MOVEMENT_SPEED);
 75:   }
 76:   if (pet) {
 77:     // Horse and Fenrir first: both count as riding mounts, at 17 not 15.
 78:     if (pet.num === DARK_HORSE || pet.num === HORN_OF_FENRIR) speed = Math.max(speed, HORSE_OR_FENRIR_MOVEMENT_SPEED);
 79:     else if (isRidingMount(pet)) speed = Math.max(speed, BASIC_MOUNT_MOVEMENT_SPEED);
 80:   }
 81:   return speed;
 82: }
 83: 
 84: /** `PlayerMovement.GetClientMovementSpeed` for player entities. */
 85: function playerTilesPerSecond(entity: Entity, inSafeZone: boolean, world: number): number {
 86:   if (inSafeZone) return tilesPerSecond(WALK_MOVEMENT_SPEED);
 87:   return tilesPerSecond(
 88:     Math.max(WALK_MOVEMENT_SPEED, runningMovementSpeed(entity, world))
 89:   );
 90: }
 91: 
 92: /**
 93:  * Longest wall-clock gap a walker is allowed to catch up on at once. A
 94:  * WalkRequest carries at most 15 steps (~5 s), so anything longer is a stall
 95:  * the server has long finished walking for us; ObjectMoved fixes the rest.
 96:  */
 97: const MAX_WALK_CATCH_UP_SECONDS = 6;
 98: 
 99: export const MoveAlongPathSystem: ISystemFactory = world => {
100:   const query = world.with('transform', 'pathfinding', 'movement');
101: 
102:   let lastTick = performance.now();
103: 
104:   return {
105:     update: () => {
106:       // The render loop clamps its delta to 100 ms (MAX_FRAME_DELTA) so
107:       // effects never skip ahead; walkers must not inherit that clamp - the
108:       // server keeps stepping at wall-clock pace while we render at 3 fps in
109:       // a background tab, and every lost frame became a tile of desync.
110:       const now = performance.now();
111:       const deltaTime = Math.min(
112:         (now - lastTick) / 1000,
113:         MAX_WALK_CATCH_UP_SECONDS
114:       );
115:       lastTick = now;
116: 
117:       for (const entity of query) {
118:         const { pathfinding, transform, movement, localPlayer, attributeSystem } =
119:           entity;
120: 
121:         if (localPlayer) {
122:           // Both setters are MobX actions: writing an unchanged value still
123:           // runs the action (and its reaction pass) every frame, so only the
124:           // tile the hero stands on - not its float position - is mirrored,
125:           // and only when it moved.
126:           const tileX = ~~transform.pos.x;
127:           const tileY = ~~transform.pos.z;
128:           const playerData = Store.playerData;
129:           if (playerData.x !== tileX || playerData.y !== tileY) {
130:             playerData.setPosition(tileX, tileY);
131:           }
132: 
133:           const flag = world.getTerrainFlag(tileX, tileY);
134:           if (playerData.tileFlag !== flag) playerData.setTileFlag(flag);
135:         }
136: 
137:         let speed: number;
138:         if (entity.playerAnimation || localPlayer) {
139:           // OpenMU's SafezoneMap is the terrain's SafeZone flag at the
140:           // player's current (integer) position.
141:           const flag = world.getTerrainFlag(
142:             Math.round(transform.pos.x),
143:             Math.round(transform.pos.z)
144:           );
145:           speed = playerTilesPerSecond(
146:             entity,
147:             isFlagInBinaryMask(flag, TWFlags.SafeZone),
148:             world.mapIndex
149:           );
150:         } else {
151:           // getValue() materialises a 0-valued element for unknown
152:           // attributes, so guard with hasAttribute: a 0 speed silently
153:           // freezes the walker.
154:           speed = attributeSystem?.hasAttribute('totalMovementSpeed')
155:             ? attributeSystem.getValue('totalMovementSpeed')
156:             : 4;
157:         }
158:         let deltaSpeed = speed * deltaTime;
159: 
160:         // The hero may not outwalk what the server has been told. A frame
161:         // hitch (a tab in the background, a burst of asset loading) hands
162:         // this loop seconds of catch-up at once, and without a stop it
163:         // strides past the end of the sent chunk - where the server's walker
164:         // is parked - by several tiles. The next WalkRequest then starts from
165:         // a tile the server has not reached, which is what it reports as a
166:         // speedhack and what rubber-bands the player back a moment later.
167:         if (localPlayer && pathfinding.sentThrough && pathfinding.path) {
168:           deltaSpeed = Math.min(
169:             deltaSpeed,
170:             distanceAlongPath(transform.pos, pathfinding.path, pathfinding.sentThrough)
171:           );
172:         }
173: 
174:         if (
175:           !pathfinding.path ||
176:           pathfinding.path.length === 0 ||
177:           !pathfinding.calculated
178:         ) {
179:           movement.velocity.x = 0;
180:           movement.velocity.y = 0;
181: 
182:           continue;
183:         }
184: 
185:         while (deltaSpeed > 0 && pathfinding.path.length > 0) {
186:           let nextPoint = pathfinding.path[0];
187:           let dx = nextPoint.x - transform.pos.x;
188:           let dy = nextPoint.y - transform.pos.z;
189:           const distance = Math.sqrt(dx * dx + dy * dy);
190: 
191:           const deltaDistance = Math.min(deltaSpeed, distance);
192:           deltaSpeed -= deltaDistance;
193: 
194:           if (deltaDistance === distance) {
195:             pathfinding.path.shift();
196: 
197:             if (distance < 0.00001) continue;
198:           }
199: 
200:           movement.velocity.x = (dx / distance) * speed;
201:           movement.velocity.y = (dy / distance) * speed;
202: 
203:           const deltaX = (dx / distance) * deltaDistance;
204:           const deltaY = (dy / distance) * deltaDistance;
205: 
206:           transform.pos.x += deltaX;
207:           transform.pos.z += deltaY;
208: 
209:           if (world.terrain) {
210:             // RequestTerrainHeight is bilinear at the float position
211:             // (ZzzLodTerrain.cpp:825-839, ZzzCharacter.cpp:6265) - the
212:             // previous 4 integer samples averaged with fixed weights made
213:             // characters float/sink on slopes.
214:             transform.pos.y = world.getTerrainHeight(
215:               transform.pos.x,
216:               transform.pos.z
217:             );
218: 
219:             if (attributeSystem) {
220:               const flag = world.getTerrainFlag(
221:                 ~~transform.pos.x,
222:                 ~~transform.pos.z
223:               );
224:               attributeSystem.setValue(
225:                 'inSafeZone',
226:                 isFlagInBinaryMask(flag, TWFlags.SafeZone) ? 1 : 0
227:               );
228:             }
229:           }
230: 
231:           transform.rot.y =
232:             Math.atan2(movement.velocity.y, movement.velocity.x) + Math.PI / 2;
233:         }
234:       }
235:     },
236:   };
237: };
</file>

<file path="src/ecs/systems/networkSystem.ts">
  1: import type { IVector2Like } from '../../libs/babylon/exports';
  2: import type { ISystemFactory } from '../world';
  3: import { Store } from '../../store';
  4: import { truncatePathForAttack } from './attackSystem';
  5: import { truncatePathWithinRange } from '../../common/approachPath';
  6: 
  7: // Function returning CLIENT CODE (0-7) according to MU Online documentation
  8: // W=0, SW=1, S=2, SE=3, E=4, NE=5, N=6, NW=7
  9: 
 10: function GetClientDirectionCode(from: IVector2Like, to: IVector2Like): number {
 11:   const dx = ~~(Math.round(to.x) - Math.round(from.x)); // Horizontal (X): left / right – works correctly
 12:   const dy = ~~(Math.round(to.y) - Math.round(from.y)); // Vertical (Y): up / down – correction here
 13: 
 14:   if (dx === -1 && dy === -1) return 0; // West
 15:   if (dx === 0 && dy === -1) return 1; // South-West
 16:   if (dx === 1 && dy === -1) return 2; // South
 17:   if (dx === 1 && dy === 0) return 3; // South-East
 18:   if (dx === 1 && dy === 1) return 4; // East
 19:   if (dx === 0 && dy === 1) return 5; // North-East
 20:   if (dx === -1 && dy === 1) return 6; // North
 21:   if (dx === -1 && dy === 0) return 7; // North-West
 22:   return 0xff; // Invalid direction
 23: }
 24: 
 25: function mapToServerDirectionCode(clientDir: number): number {
 26:   return clientDir;
 27:   // return 7 - clientDir;
 28: }
 29: 
 30: // A WalkRequest carries at most 15 steps (4-bit step count). The server
 31: // (OpenMU Walker) stops at the last step it received, so longer paths have to
 32: // be re-sent in chunks as the hero walks - the original client does the same
 33: // by re-issuing the walk packet while moving (ZzzCharacter.cpp).
 34: const MAX_STEPS_PER_PACKET = 15;
 35: 
 36: // stackalloc: no GC pressure for  ≤15-step MU packet
 37: const clientDirs = new Array<number>(MAX_STEPS_PER_PACKET);
 38: 
 39: /**
 40:  * Sends up to 15 steps of `path` starting at `path[startIndex]`.
 41:  * Returns the index of the last path point covered by the packet, or -1 when
 42:  * nothing was sent.
 43:  */
 44: function sendWalkPathToServer(path: IVector2Like[], startIndex: number): number {
 45:   if (path.length <= startIndex + 1) return -1;
 46: 
 47:   // The server replays the steps from SourceX/Y, so the start tile must be the
 48:   // same tile the direction steps were derived from. The pathfinder and
 49:   // GetClientDirectionCode both round (posToIndex = floor(v + 0.5)); the old
 50:   // `~~` truncation put the server one tile off whenever the hero's fractional
 51:   // position was ≥ .5, and the error accumulated walk after walk until the
 52:   // server's 5-tile tolerance kicked in and rubber-banded us via ObjectMoved.
 53:   //
 54:   // For a fresh walk path[0] is the hero's position when the path was
 55:   // planned (PlayerControllerSystem copies transform.pos into
 56:   // pathfinding.from), i.e. the tile it is logically standing on; for a
 57:   // continuation it is the last tile of the previous segment, where the
 58:   // server's walker stops and waits for the next WalkRequest.
 59:   const startX = Math.round(path[startIndex].x);
 60:   const startY = Math.round(path[startIndex].y);
 61: 
 62:   let dirLen = 0;
 63:   let lastIndex = startIndex;
 64:   let currentPos = path[startIndex];
 65:   for (let i = startIndex + 1; i < path.length; i++) {
 66:     const step = path[i];
 67:     const dirCode = GetClientDirectionCode(currentPos, step);
 68:     if (dirCode > 7) {
 69:       console.error(
 70:         `Invalid direction code: ${dirCode} at step ${i} from [${currentPos.x}, ${currentPos.y}] to [${step.x}, ${step.y}]`
 71:       );
 72:       break;
 73:     }
 74:     clientDirs[dirLen++] = dirCode;
 75:     currentPos = step;
 76:     lastIndex = i;
 77:     if (dirLen == MAX_STEPS_PER_PACKET) break;
 78:   }
 79:   if (dirLen == 0) return -1;
 80: 
 81:   // const directionMap = MuGame.Network?.GetDirectionMap();
 82:   const serverDirs = new Array<number>(dirLen);
 83:   for (let i = 0; i < dirLen; i++) {
 84:     const cd = clientDirs[i];
 85:     serverDirs[i] = mapToServerDirectionCode(cd);
 86:   }
 87: 
 88:   Store.sendWalkPath(startX, startY, serverDirs);
 89:   return lastIndex;
 90: }
 91: 
 92: export const NetworkSystem: ISystemFactory = world => {
 93:   // Last path point the server knows about (the end of the last sent chunk).
 94:   // MoveAlongPathSystem shifts consumed points off `pathfinding.path`, so we
 95:   // track the point object itself rather than an index.
 96:   let sentUpTo: IVector2Like | undefined;
 97:   let sentPath: IVector2Like[] | undefined;
 98: 
 99:   return {
100:     update: () => {
101:       const playerEntity = world.playerEntity;
102:       if (!playerEntity) return;
103: 
104:       const { playerMoveTo, pathfinding } = playerEntity;
105:       const path = pathfinding.path;
106: 
107:       if (playerMoveTo.sendToServer && pathfinding.calculated && path) {
108:         // Approaching a target: stop the server-side walk where the client
109:         // stops (in attack or cast range), not on the target's cell.
110:         if (world.attackTarget?.transform) {
111:           truncatePathForAttack(path, world.attackTarget);
112:         } else if (world.castApproach) {
113:           const { x, y, range } = world.castApproach;
114:           truncatePathWithinRange(path, x, y, range);
115:         }
116:         const last = sendWalkPathToServer(path, 0);
117:         sentUpTo = last >= 0 && last < path.length - 1 ? path[last] : undefined;
118:         sentPath = sentUpTo ? path : undefined;
119:         pathfinding.sentThrough = sentUpTo;
120:         playerMoveTo.sendToServer = false;
121:         return;
122:       }
123: 
124:       if (!sentUpTo || !sentPath) return;
125: 
126:       // Path was replaced/cleared (new click, ObjectMoved resync, ...): the
127:       // continuation belongs to a walk that no longer exists.
128:       if (!pathfinding.calculated || path !== sentPath || path.length === 0) {
129:         sentUpTo = undefined;
130:         sentPath = undefined;
131:         pathfinding.sentThrough = undefined;
132:         return;
133:       }
134: 
135:       // Hand the next chunk over when the hero is about to reach the end of
136:       // the sent one, so the server keeps walking without a visible stop.
137:       // MoveAlongPathSystem walks at the server's wall-clock pace, so by
138:       // then the server is at (or within a tile of) that end tile too.
139:       const idx = path.indexOf(sentUpTo);
140:       if (idx === -1) {
141:         // Already walked past it (should not happen, but never strand the
142:         // server): continue from the current tile.
143:         const last = sendWalkPathToServer(path, 0);
144:         sentUpTo = last >= 0 && last < path.length - 1 ? path[last] : undefined;
145:         if (!sentUpTo) sentPath = undefined;
146:         pathfinding.sentThrough = sentUpTo;
147:         return;
148:       }
149:       if (idx > 1) return;
150: 
151:       const last = sendWalkPathToServer(path, idx);
152:       sentUpTo = last >= 0 && last < path.length - 1 ? path[last] : undefined;
153:       if (!sentUpTo) sentPath = undefined;
154:       pathfinding.sentThrough = sentUpTo;
155:     },
156:   };
157: };
</file>

