149: /**
150:  * A skinned bone's world position, or the entity at `fallbackHeight` when
151:  * the skeleton is not there (monsters, still-loading models). `bone` is the
152:  * MU bone index (the GLB adds a root, hence +1 - modelObject.ts:1099).
153:  */
154: export function bonePos(e: Entity, bone: number, out: Vector3, fallbackHeight = 0.9): Vector3 {
155:   const gltf = e.modelObject?.gltf;
156:   const node = gltf?.skeleton?.bones[bone + 1]?.getTransformNode();
157:   if (node && gltf && !gltf.mesh.isDisposed()) {
158:     return out.copyFrom(node.getAbsolutePosition());
159:   }
160:   return entityPos(e, fallbackHeight, out);
161: }
