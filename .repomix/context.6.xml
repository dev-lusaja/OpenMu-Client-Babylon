224: /**
225:  * Effects draw after every group-0 mesh, the alpha-keyed ones included.
226:  * Babylon draws sprites and particles before the transparent queue, and an
227:  * alpha-tested mesh in that queue writes depth, so a flame in group 0 was
228:  * painted over by the fireplace behind it. Group 1 keeps group 0's depth
229:  * (`setRenderingAutoClearDepthStencil` below), so the cards still hide
230:  * behind what is in front of them.
231:  */
232: export const EFFECT_RENDERING_GROUP = 1;
233: 
234: export function keepDepthForEffects(scene: Scene): void {
235:   scene.setRenderingAutoClearDepthStencil(EFFECT_RENDERING_GROUP, false);
236: }
