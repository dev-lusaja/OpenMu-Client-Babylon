 73: export const AnimationSystem: ISystemFactory = world => {
 74:   const playersQuery = world.with(
 75:     'playerAnimation',
 76:     'modelObject',
 77:     'attributeSystem',
 78:     'movement'
 79:   );
 80: 
 81:   const playerAnimatableQuery = world.with('modelObject', 'playerAnimation');
 82:   const monsterAnimatableQuery = world.with(
 83:     'modelObject',
 84:     'monsterAnimation',
 85:     'movement',
 86:     'modelObject'
 87:   );
 88: 
 89:   /**
 90:    * SetPlayerStop / SetPlayerWalk (ZzzCharacter.cpp:157-679) minus the Dark
 91:    * Spirit. The order is the original's and it matters: Fenrir, then the
 92:    * horse, the horns, wings, the swim worlds, and only then the weapon
 93:    * switch - a winged character in Atlans flies, it does not swim.
 94:    */
 95:   function calculateAnimation(ctx: {
 96:     pose: CharacterPose;
 97:     inSafeZone: boolean;
 98:     isMoving: boolean;
 99:     run: number;
100:     wings: boolean;
101:     riding: boolean;
102:     /** The rider is on a Dark Horse, which has its own clip pair. */
103:     ridingHorse: boolean;
104:     /** The rider is on a Fenrir: weapon-split clips, run break at 20. */
105:     ridingFenrir: boolean;
106:     swimWorld: boolean;
107:   }): PlayerAction {
108:     const armed = isArmed(ctx.pose.hands);
109:     const crossbow = equippedCrossbow(ctx.pose.hands);
110:     const running = ctx.run >= RUN_THRESHOLD;
111: 
112:     // The Fenrir is tested first (SetPlayerStop:164-187, SetPlayerWalk:
113:     // 466-476): its own weapon-split families, breaking into the run clips
114:     // at FENRIR_RUN_DELAY instead of the usual 40.
115:     if (ctx.ridingFenrir && !ctx.inSafeZone) {
116:       if (!ctx.isMoving) return chooseFenrirIdleAction(ctx.pose);
117:       return ctx.run < FENRIR_RUN_DELAY
118:         ? chooseFenrirWalkAction(ctx.pose)
119:         : chooseFenrirRunAction(ctx.pose);
120:     }
121: 
122:     // The Dark Horse is tested before the horns and ignores the weapon
123:     // split - both arms of the original pick the same clip
124:     // (SetPlayerStop:189-195, SetPlayerWalk:477-480).
125:     if (ctx.ridingHorse && !ctx.inSafeZone) {
126:       return ctx.isMoving
127:         ? PlayerAction.PLAYER_RUN_RIDE_HORSE
128:         : PlayerAction.PLAYER_STOP_RIDE_HORSE;
129:     }
130: 
131:     // Horn of Uniria / Dinorant (SetPlayerStop:201-209, SetPlayerWalk:485-527).
132:     if (ctx.riding && !ctx.inSafeZone) {
133:       if (ctx.isMoving) {
134:         return armed
135:           ? PlayerAction.PLAYER_RUN_RIDE_WEAPON
136:           : PlayerAction.PLAYER_RUN_RIDE;
137:       }
138:       return armed
139:         ? PlayerAction.PLAYER_STOP_RIDE_WEAPON
140:         : PlayerAction.PLAYER_STOP_RIDE;
141:     }
142: 
143:     // Wings (`Fly`, SetPlayerStop:213-245; SetPlayerWalk:533-541).
144:     if (!ctx.inSafeZone && ctx.wings) {
145:       if (ctx.isMoving) {
146:         return crossbow
147:           ? PlayerAction.PLAYER_FLY_CROSSBOW
148:           : PlayerAction.PLAYER_FLY;
149:       }
150:       return crossbow
151:         ? PlayerAction.PLAYER_STOP_FLY_CROSSBOW
152:         : PlayerAction.PLAYER_STOP_FLY;
153:     }
154: 
155:     // Atlans / Hellas / Doppelganger 3. Standing there is the *fly* pose:
156:     // SetPlayerStop sets `Fly = true` for these maps outside a safe zone
157:     // (:218-219), which is what makes a character tread water.
158:     if (!ctx.inSafeZone && ctx.swimWorld) {
159:       if (ctx.isMoving) {
160:         return running
161:           ? PlayerAction.PLAYER_RUN_SWIM
162:           : PlayerAction.PLAYER_WALK_SWIM;
163:       }
164:       return crossbow
165:         ? PlayerAction.PLAYER_STOP_FLY_CROSSBOW
166:         : PlayerAction.PLAYER_STOP_FLY;
167:     }
168: 
169:     if (!ctx.isMoving) return chooseIdleAction(ctx.pose);
170: 
171:     return running ? chooseRunAction(ctx.pose) : chooseWalkAction(ctx.pose);
172:   }
173: 
174:   let lastRunTick = performance.now();
175: 
176:   return {
177:     update: dt => {
178:       // c->Run is a wall-clock walk-up (the original counts real frames at
179:       // its own FPS). The render dt is clamped to 0.1 s in main.tsx, so under
180:       // 10 fps the walker (already on wall-clock time) runs while this
181:       // counter would still say "walking" - use the real elapsed time, capped
182:       // so a stalled tab does not jump straight to running.
183:       const nowMs = performance.now();
184:       const runDt = Math.min(1, (nowMs - lastRunTick) / 1000);
185:       lastRunTick = nowMs;
186:       const mapIndex = world.mapIndex;
187:       const swimWorld = isSwimWorld(mapIndex);
188:       const chaosCastle = inChaosCastle(mapIndex);
189:       const bloodCastle = inBloodCastle(mapIndex);
190: 
191:       for (const entity of playersQuery) {
192:         const { playerAnimation, movement, attributeSystem, modelObject } = entity;
193: 
194:         // c->SafeZone is re-evaluated every frame from the terrain flag
195:         // (ZzzCharacter.cpp:5490); the path system alone left it stale after
196:         // spawns and teleports.
197:         if (entity.transform) {
198:           const flag = world.getTerrainFlag(
199:             ~~entity.transform.pos.x,
200:             ~~entity.transform.pos.z
201:           );
202:           attributeSystem.setValue(
203:             'inSafeZone',
204:             isFlagInBinaryMask(flag, TWFlags.SafeZone) ? 1 : 0
205:           );
206:         }
207: 
208:         if (entity.localPlayer) {
209:           // Server-computed speeds (CurrentStatsExtended) win over the
210:           // client-side agility formula once they have arrived.
211:           const pd = Store.playerData;
212:           attributeSystem.setValue(
213:             'attackSpeed',
214:             pd.attackSpeed ?? attackSpeedOf(pd.charClass, pd.agi)
215:           );
216:           attributeSystem.setValue(
217:             'magicSpeed',
218:             pd.magicSpeed ?? magicSpeedOf(pd.charClass, pd.agi)
219:           );
220:         }
221: 
222:         const inSafeZone = attributeSystem.isAboveZero('inSafeZone');
223:         const hands = entity.charAppearance;
224:         const wings = isWingItem(hands?.wings) ? hands!.wings : null;
225:         const mount = petSpec(hands?.pet);
226:         const riding = isRidingMount(hands?.pet);
227:         const ridingHorse = riding && mount?.riderClips === 'horse';
228:         const ridingFenrir = riding && mount?.riderClips === 'fenrir';
229: 
230:         // `c->Wing.Type != -1 && !SafeZone` (SetPlayerStop:213,
231:         // SetPlayerWalk:535). The swim worlds also set the original’s local
232:         // `Fly`, but not this flag: its consumers (the walk sound) want
233:         // "airborne", and swimming keeps its footstep.
234:         attributeSystem.setValue('isFlying', !inSafeZone && wings ? 1 : 0);
235:         attributeSystem.setValue('isSwimming', !inSafeZone && swimWorld ? 1 : 0);
236: 
237:         const moving = movement.velocity.x !== 0 || movement.velocity.y !== 0;
238: 
239:         // --- c->Run (ZzzCharacter.cpp:159, :376-408).
240:         const speedInput = {
241:           run: playerAnimation.run,
242:           inSafeZone,
243:           wings,
244:           riding,
245:           fenrir: ridingFenrir,
246:           fenrirUpgraded: (hands?.pet?.excellentFlags ?? 0) > 0,
247:           world: mapIndex,
248:         };
249: 
250:         if (!moving || inSafeZone) {
251:           // SetPlayerStop opens with `c->Run = 0`, and SetPlayerWalk zeroes it
252:           // again inside a safe zone.
253:           playerAnimation.run = 0;
254:         } else if (forcesRun(speedInput)) {
255:           // Wings, a mount and Chaos Castle skip the walk-up entirely
256:           // (`CharacterMoveSpeed` writes `c->Run = 40` outright).
257:           playerAnimation.run = RUN_THRESHOLD;
258:         } else if (
259:           playerAnimation.run < RUN_THRESHOLD &&
260:           // A player-rigged NPC (guards, Lumen…) has no c->Run walk-up: the
261:           // original moves NPCs with SetPlayerWalk on a MODEL_PLAYER object
262:           // whose Run stays 0, so a patrol is always PLAYER_WALK_*.
263:           entity.npcType === undefined &&
264:           canAccumulateRun(
265:             hands?.charClass ?? Store.playerData.charClass,
266:             hands?.boots,
267:             hands?.gloves,
268:             mapIndex,
269:             ridingFenrir
270:           )
271:         ) {
272:           playerAnimation.run = Math.min(
273:             RUN_THRESHOLD,
274:             playerAnimation.run + RUN_UNITS_PER_SECOND * runDt
275:           );
276:         }
277: 
278:         speedInput.run = playerAnimation.run;
279:         attributeSystem.setValue(
280:           'totalMovementSpeed',
281:           characterMoveSpeed(speedInput)
282:         );
283: 
284:         // Dinorant riders float 30 units off the terrain (:6263-6273).
285:         modelObject.HoverHeight =
286:           riding && !inSafeZone ? (mount?.riderLift ?? 0) : 0;
287: 
288:         // RenderCharacterBackItem: weapons ride on the back in safe zones,
289:         // during social actions and swim walks. Blood Castle and Chaos Castle
290:         // override it back to false (:14969-14980).
291:         const bindBack =
292:           !bloodCastle &&
293:           !chaosCastle &&
294:           (inSafeZone ||
295:             isSocialAction(playerAnimation.action) ||
296:             // An instrument takes both hands; the weapons wait on the back.
297:             !!entity.performing ||
298:             playerAnimation.action === PlayerAction.PLAYER_WALK_SWIM ||
299:             playerAnimation.action === PlayerAction.PLAYER_RUN_SWIM);
300:         if (attributeSystem.isAboveZero('weaponsOnBack') !== bindBack) {
301:           // Latch the flag only once the attachments were actually applied:
302:           // a character spawning already in a safe zone hits this before its
303:           // PlayerObject exists, and consuming the flip then would leave the
304:           // weapons on the hand links forever (the original re-evaluates
305:           // every frame, ZzzCharacter.cpp:14953).
306:           if ((modelObject as PlayerObject).Weapon1) {
307:             attributeSystem.setValue('weaponsOnBack', bindBack ? 1 : 0);
308:             applyWeaponAttachments(
309:               modelObject as PlayerObject,
310:               entity.charAppearance,
311:               bindBack
312:             );
313:           }
314:         }
315: 
316:         // Dead or about to die: c->Movement = false, no stop/walk re-evaluation.
317:         if (playerAnimation.action === PlayerAction.PLAYER_DIE1 || entity.dying) continue;
318: 
319:         // Performing: BandSystem holds the pose; nothing to re-evaluate until a step.
320:         if (entity.performing && !moving) continue;
321: 
322:         if (isOneShotPlayerAction(playerAnimation.action) && !moving) {
323:           // Hold the one-shot clip until it has played through once, then
324:           // fall back to idle/walk (ActionIterationWasFinished is set by the
325:           // animation-group end observer in ModelObject). Walking cuts it
326:           // short: the original re-evaluates the walk action as soon as
327:           // c->Movement is set, so a swing never plays over a step.
328:           if (
329:             modelObject.CurrentAction !== playerAnimation.action ||
330:             !modelObject.ActionIterationWasFinished
331:           ) {
332:             continue;
333:           }
334:         }
335: 
336:         if (
337:           playerAnimation.action >= PlayerAction.PLAYER_SIT1 &&
338:           playerAnimation.action <= PlayerAction.PLAYER_POSE_FEMALE1 &&
339:           !moving
340:         ) {
341:           continue;
342:         }
343: 
344:         const npcClass =
345:           entity.npcType !== undefined
346:             ? ((modelObject.constructor as typeof PlayerObject).NpcClass ?? undefined)
347:             : undefined;
348:         const charClass =
349:           npcClass ?? hands?.charClass ?? Store.playerData.charClass;
350: 
351:         playerAnimation.action = calculateAnimation({
352:           pose: {
353:             hands,
354:             baseClass: getBaseClass(charClass),
355:             isFemale:
356:               npcClass !== undefined
357:                 ? isFemaleClass(npcClass)
358:                 : attributeSystem.isAboveZero('isFemale'),
359:             // "(no weapon) or (safe zone outside Blood Castle)" - the caller
360:             // side of the collapse is the safe zone; the no-weapon half is
361:             // tested inside chooseIdleAction / chooseWalkAction.
362:             weaponsStowed: inSafeZone && !bloodCastle,
363:             inChaosCastle: chaosCastle,
364:           },
365:           inSafeZone,
366:           isMoving: moving,
367:           run: playerAnimation.run,
368:           wings: !!wings,
369:           riding,
370:           ridingHorse,
371:           ridingFenrir,
372:           swimWorld,
373:         });
374:       }
375: 
376:       for (const entity of playerAnimatableQuery) {
377:         const { playerAnimation, modelObject } = entity;
378:         const playerObject = modelObject as PlayerObject;
379:         if (!playerObject.Ready) continue;
380: 
381:         const action = playerAnimation.action;
382:         const attrs = entity.attributeSystem;
383:         const isRageFighter =
384:           getBaseClass(
385:             entity.charAppearance?.charClass ?? Store.playerData.charClass
386:           ) === BaseClass.RageFighter;
387: 
388:         playerObject.AnimationSpeed =
389:           playerObject.actionPlaySpeed(action) ??
390:           playerPlaySpeed(
391:             action,
392:             attrs?.getValue('attackSpeed') ?? 0,
393:             attrs?.getValue('magicSpeed') ?? 0,
394:             isRageFighter
395:           );
396: 
397:         // A performer's clip loops whatever band it sits in: the pose is held
398:         // for as long as the instrument is out.
399:         const oneShot =
400:           (isOneShotPlayerAction(action) && !entity.performing) ||
401:           action === PlayerAction.PLAYER_DIE1;
402:         playerObject.playAction(action, !oneShot);
403: 
404:         // RenderCharacterItem rewrites the weapons' own clip every frame off
405:         // the character's: a bow only draws while the shot plays.
406:         if (playerObject.Weapon1) {
407:           applyWeaponPoses(
408:             playerObject,
409:             entity.charAppearance,
410:             attrs?.isAboveZero('weaponsOnBack') ?? false,
411:             action,
412:             playerObject.AnimationSpeed
413:           );
414:         }
415: 
416:         const wings = playerObject.Wings;
417:         if (wings?.Ready) {
418:           wings.setAnimationSpeed(wingsPlaySpeed(action, wings.spec));
419:           // The Wings of Darkness fold shut in town (:6785); every other
420:           // wing has a single flap clip.
421:           const folded =
422:             (entity.attributeSystem?.isAboveZero('inSafeZone') ?? false) &&
423:             wings.spec?.safeZoneAction !== undefined;
424:           wings.playAction(folded ? wings.spec!.safeZoneAction! : 0, true);
425:         }
426: 
427:         // The Imp flaps at its own fixed rate (ZzzCharacter.cpp:15149).
428:         const pet = playerObject.Pet;
429:         if (pet?.Ready) {
430:           const spec = petSpec(entity.charAppearance?.pet);
431:           pet.setAnimationSpeed(spec?.playSpeed ?? 0.25);
432:           pet.playAction(0, true);
433:         }
434:       }
435: 
436:       for (const entity of monsterAnimatableQuery) {
437:         const { monsterAnimation, movement, modelObject } = entity;
438:         if (!modelObject.Ready) continue;
439: 
440:         if (monsterAnimation.action === MonsterActionType.Die) {
441:           // Death: play once and hold the last frame; DeathSystem fades and despawns.
442:           modelObject.AnimationSpeed =
443:             modelObject.actionPlaySpeed(MonsterActionType.Die) ??
444:             monsterPlaySpeed(monsterModelTypeOf(entity.npcType), MonsterActionType.Die);
445:           modelObject.playAction(MonsterActionType.Die, false);
446:           continue;
447:         }
448:         // Killed but the Die clip has not started yet (death delay): freeze.
449:         if (entity.dying) continue;
450: 
451:         const oneShot = MONSTER_ONE_SHOT_ACTIONS.has(monsterAnimation.action);
452:         if (
453:           oneShot &&
454:           modelObject.CurrentAction === monsterAnimation.action &&
455:           modelObject.ActionIterationWasFinished
456:         ) {
457:           monsterAnimation.action = MonsterActionType.Stop1;
458:         }
459: 
460:         const isMoving = movement.velocity.x !== 0 || movement.velocity.y !== 0;
461:         if (isMoving && !MONSTER_ONE_SHOT_ACTIONS.has(monsterAnimation.action)) {
462:           monsterAnimation.action = MonsterActionType.Walk;
463:         } else if (!isMoving && monsterAnimation.action === MonsterActionType.Walk) {
464:           // Path consumed: the original returns to MONSTER01_STOP1 when the
465:           // walk ends (MoveHumen); the server never sends a "stop" animation.
466:           monsterAnimation.action = MonsterActionType.Stop1;
467:         }
468: 
469:         const action = monsterAnimation.action;
470:         modelObject.AnimationSpeed =
471:           modelObject.actionPlaySpeed(action) ??
472:           monsterPlaySpeed(monsterModelTypeOf(entity.npcType), action);
473:         modelObject.playAction(action, !MONSTER_ONE_SHOT_ACTIONS.has(action));
474:       }
475:     },
476:   };
477: };
</file>

<file path="src/effects/bandNotes.ts">
  1: /**
  2:  * Band notes - a music note that floats up from an instrument for every note
  3:  * it plays: the strum the held pose does not make.
  4:  *
  5:  * Unlike the rest of the effects a note is not a glow: it is a solid glyph,
  6:  * alpha-tested at full opacity in the world's own rendering group, so it
  7:  * writes depth and lands in the G-buffer - which is what gives it an ink
  8:  * line of its own under the Anime style (scenes/inkOutline.ts) instead of
  9:  * the contour that pass draws around the additive cards. Tinted by the
 10:  * pitch class, twelve hues around the octave, and sized by the velocity.
 11:  * The glyph is drawn once per scene into a small dynamic texture as shapes
 12:  * (head, stem, flag, beam), not a font character: every machine draws the
 13:  * same note.
 14:  *
 15:  * Driven by: `BandSystem`, one spawn per hit it lets through. Read by: nobody.
 16:  */
 17: import {
 18:   Constants,
 19:   DynamicTexture,
 20:   Material,
 21:   StandardMaterial,
 22:   Texture,
 23:   type Scene,
 24:   type Vector3,
 25: } from '../libs/babylon/exports';
 26: import { LiveList, acquireCard, hash, lerp, releaseCard, setCardCell, type Card, type RGB } from './core';
 27: import type { EffectHandle, EffectLayer } from './layer';
 28: 
 29: // ---- 1. tuning -------------------------------------------------------------
 30: 
 31: /** Seconds a note floats before it is gone. */
 32: const SECONDS = 1.5;
 33: 
 34: /** Card edge in tiles at full velocity: 30 cm, a glyph the size of a hand. */
 35: const SIZE = 0.3;
 36: 
 37: /** The quietest note's share of that. */
 38: const MIN_SIZE = 0.6;
 39: 
 40: /** Tiles per second the note rises. */
 41: const RISE = 0.45;
 42: 
 43: /** Tiles per second it drifts sideways, one way or the other per note. */
 44: const DRIFT = 0.12;
 45: 
 46: /** The sway on top of the drift: amplitude in tiles, rate in radians per second. */
 47: const SWAY = 0.05;
 48: const SWAY_RATE = 3;
 49: 
 50: /** Share of the life spent growing in from nothing. */
 51: const GROW = 0.12;
 52: 
 53: /** Share of the life spent shrinking away at the end: a note holds its colour, so it leaves by size. */
 54: const SHRINK = 0.25;
 55: 
 56: /** Saturation of the pitch hues, 0..1: pastel, so the note reads as a glyph, not a flare. */
 57: const SATURATION = 0.55;
 58: 
 59: /** Share of notes drawn as the single glyph; the rest are the beamed pair. */
 60: const SINGLE_SHARE = 0.75;
 61: 
 62: /** The glyph sheet: two 64-texel cells, a single note and a beamed pair. */
 63: const CELL = 64;
 64: const CELLS = { w: CELL, h: CELL, count: 2 };
 65: 
 66: // ---- 2. state + readers ----------------------------------------------------
 67: 
 68: export interface BandNoteOptions {
 69:   /** MIDI pitch, 0..127; only its class (the note within the octave) shows. */
 70:   pitch: number;
 71:   /** MIDI velocity, 0..127; the size. */
 72:   velocity?: number;
 73: }
 74: 
 75: const live = new LiveList();
 76: 
 77: /** The glyph sheet of the current scene; a map change disposes it with the pools. */
 78: let sheetScene: Scene | null = null;
 79: let sheet: DynamicTexture | null = null;
 80: 
 81: /** One opaque material per tint, this entry's own: the shared cache holds additive ones. */
 82: const materials = new Map<string, StandardMaterial>();
 83: 
 84: let seed = 0;
 85: 
 86: /** How many notes are floating (debug). */
 87: export function bandNoteCount(): number {
 88:   return live.size;
 89: }
 90: 
 91: /** Twelve hues around the octave, C red: the same pitch class is always the same colour. */
 92: export function pitchColour(pitch: number): RGB {
 93:   const h = ((((pitch % 12) + 12) % 12) / 12) * 6;
 94:   const i = Math.floor(h);
 95:   const f = h - i;
 96:   const p = 1 - SATURATION;
 97:   const q = 1 - SATURATION * f;
 98:   const t = 1 - SATURATION * (1 - f);
 99:   switch (i % 6) {
100:     case 0:
101:       return [1, t, p];
102:     case 1:
103:       return [q, 1, p];
104:     case 2:
105:       return [p, 1, t];
106:     case 3:
107:       return [p, q, 1];
108:     case 4:
109:       return [t, p, 1];
110:     default:
111:       return [1, p, q];
112:   }
113: }
114: 
115: /** A note head: an ellipse tilted up to the right, filled. */
116: function head(ctx: CanvasRenderingContext2D, x: number, y: number): void {
117:   ctx.beginPath();
118:   ctx.ellipse(x, y, 10.5, 7, -0.4, 0, Math.PI * 2);
119:   ctx.fill();
120: }
121: 
122: /**
123:  * The glyphs, white on nothing: the card is alpha-tested, so the sheet's
124:  * transparent half is the shape the ink pass outlines and the depth buffer
125:  * sees. White, because the material multiplies the texel by the tint.
126:  */
127: function drawSheet(tex: DynamicTexture): void {
128:   const ctx = tex.getContext() as CanvasRenderingContext2D;
129:   ctx.clearRect(0, 0, CELL * 2, CELL);
130:   ctx.fillStyle = '#fff';
131: 
132:   // Cell 0: one eighth note - head, stem up its right side, a flag curling out.
133:   head(ctx, 24, 47);
134:   ctx.fillRect(32, 12, 4, 36);
135:   ctx.beginPath();
136:   ctx.moveTo(36, 12);
137:   ctx.quadraticCurveTo(56, 22, 47, 42);
138:   ctx.quadraticCurveTo(51, 27, 36, 23);
139:   ctx.closePath();
140:   ctx.fill();
141: 
142:   // Cell 1: two eighth notes under one beam, the right one a little higher.
143:   const x0 = CELL;
144:   head(ctx, x0 + 16, 50);
145:   head(ctx, x0 + 44, 45);
146:   ctx.fillRect(x0 + 24, 14, 4, 37);
147:   ctx.fillRect(x0 + 52, 9, 4, 37);
148:   ctx.beginPath();
149:   ctx.moveTo(x0 + 24, 14);
150:   ctx.lineTo(x0 + 56, 9);
151:   ctx.lineTo(x0 + 56, 17);
152:   ctx.lineTo(x0 + 24, 22);
153:   ctx.closePath();
154:   ctx.fill();
155: 
156:   tex.update();
157: }
158: 
159: function sheetFor(scene: Scene): DynamicTexture {
160:   if (sheet && sheetScene === scene) return sheet;
161:   sheet?.dispose();
162:   // No mipmaps: a mip of a glyph on a clear sheet averages its alpha down
163:   // toward nothing, and an alpha-tested note would thin and fade with
164:   // distance instead of staying a solid symbol.
165:   sheet = new DynamicTexture('fx:bandNotes', { width: CELL * 2, height: CELL }, scene, false, Texture.BILINEAR_SAMPLINGMODE);
166:   sheet.hasAlpha = true;
167:   sheet.wrapU = Texture.CLAMP_ADDRESSMODE;
168:   sheet.wrapV = Texture.CLAMP_ADDRESSMODE;
169:   sheetScene = scene;
170:   drawSheet(sheet);
171:   return sheet;
172: }
173: 
174: /**
175:  * The glyph in one tint: unlit, so the texel is simply multiplied by it
176:  * (`emissiveColor` with lighting off), and alpha-tested rather than blended,
177:  * so every note is fully opaque and cut to its own outline.
178:  */
179: function noteMaterial(scene: Scene, colour: RGB): StandardMaterial {
180:   const key = `${(colour[0] * 255) | 0},${(colour[1] * 255) | 0},${(colour[2] * 255) | 0}`;
181:   const known = materials.get(key);
182:   if (known && known.getScene() === scene) return known;
183:   const mat = new StandardMaterial(`fx:note:${key}`, scene);
184:   mat.diffuseColor.set(0, 0, 0);
185:   mat.specularColor.set(0, 0, 0);
186:   mat.ambientColor.set(0, 0, 0);
187:   mat.emissiveColor.set(colour[0], colour[1], colour[2]);
188:   mat.disableLighting = true;
189:   mat.diffuseTexture = sheetFor(scene);
190:   // The alpha test reads the *material's* alpha, which only picks up the
191:   // texture's with this on (Babylon's ALPHATEST_AFTERALLALPHACOMPUTATIONS):
192:   // without it the sheet's clear half draws as a black square around the note.
193:   mat.useAlphaFromDiffuseTexture = true;
194:   mat.alphaMode = Constants.ALPHA_DISABLE;
195:   mat.transparencyMode = Material.MATERIAL_ALPHATEST;
196:   mat.backFaceCulling = false;
197:   materials.set(key, mat);
198:   return mat;
199: }
200: 
201: function spawn(scene: Scene, at: Vector3, opts: BandNoteOptions): EffectHandle {
202:   const material = noteMaterial(scene, pitchColour(opts.pitch));
203:   // Group 0: a note is a solid thing in the world, not a glow over it.
204:   const card: Card = acquireCard(scene, material, true, 0);
205:   const s = seed++;
206:   setCardCell(card, CELLS, hash(s) < SINGLE_SHARE ? 0 : 1);
207:   const velocity = Math.max(0, Math.min(127, opts.velocity ?? 100)) / 127;
208:   const size = SIZE * lerp(MIN_SIZE, 1, velocity);
209:   const side = hash(s + 0.5) < 0.5 ? -1 : 1;
210:   const phase = hash(s + 0.25) * Math.PI * 2;
211:   const x = at.x, y = at.y, z = at.z;
212:   card.position.set(x, y, z);
213:   card.scaling.setAll(0);
214: 
215:   let t = 0;
216:   return live.push({
217:     update(dt) {
218:       t += dt;
219:       const p = t / SECONDS;
220:       if (p >= 1) return false;
221:       const grown = p < GROW ? p / GROW : p > 1 - SHRINK ? (1 - p) / SHRINK : 1;
222:       card.scaling.setAll(size * grown);
223:       card.position.set(x + side * (DRIFT * t + SWAY * Math.sin(phase + SWAY_RATE * t)), y + RISE * t, z);
224:       return true;
225:     },
226:     release() {
227:       releaseCard(scene, card);
228:     },
229:   });
230: }
231: 
232: function update(_map: number, dt: number): void {
233:   live.update(dt);
234: }
235: 
236: function reset(): void {
237:   live.clear();
238:   for (const mat of materials.values()) mat.dispose();
239:   materials.clear();
240:   sheet?.dispose();
241:   sheet = null;
242:   sheetScene = null;
243: }
244: 
245: // ---- 3. the layer ----------------------------------------------------------
246: 
247: export const bandNotesLayer: EffectLayer<BandNoteOptions, 'bandNotes'> = {
248:   name: 'bandNotes',
249:   update,
250:   reset,
251:   spawn,
252: };
</file>

<file path="src/ecs/systems/characterSelectSystem.ts">
  1: import {
  2:   Color3,
  3:   CreateDisc,
  4:   PointerEventTypes,
  5:   StandardMaterial,
  6:   Vector3,
  7:   GlowLayer,
  8:   type Mesh,
  9: } from '../../libs/babylon/exports';
 10: import type { Entity, ISystemFactory } from '../world';
 11: import { Store, UIState } from '../../store';
 12: import { ENUM_WORLD } from '../../common';
 13: import { spawnPlayer } from '../../logic';
 14: import { deserializeAppearance } from '../../common/deserializeAppearance';
 15: import {
 16:   characterSlotAngle,
 17:   characterSlotPosition,
 18: } from '../../common/characterSelect';
 19: import { setSceneHold } from '../../common/sceneGate';
 20: 
 21: /** This system's name on the loading gate (`common/sceneGate.ts`). */
 22: const GATE = 'characterSelect';
 23: 
 24: export const CharacterSelectSystem: ISystemFactory = world => {
 25:   const spawned: Entity[] = [];
 26: 
 27:   let stagedFor: string | null = null;
 28: 
 29:   let selectionRing: Mesh | null = null;
 30: 
 31:   let glowLayer: GlowLayer | null = null;
 32: 
 33:   const createSelectionRing = (): Mesh => {
 34:     if (!glowLayer) {
 35:       glowLayer = new GlowLayer("charSelectGlow", world.scene);
 36:       glowLayer.intensity = 0.6; // Ajusta este número (0.1 a 1.0) para más o menos brillo
 37:     }
 38:     
 39:     const disc = CreateDisc(
 40:       'charSelectGlowRing',
 41:       { radius: 0.9, tessellation: 32 },
 42:       world.scene
 43:     );
 44:     disc.rotation.x = Math.PI / 2;
 45:     const mat = new StandardMaterial('charSelectGlowMat', world.scene);
 46:     mat.diffuseColor = new Color3(1, 0.85, 0.2);
 47:     mat.emissiveColor = new Color3(1, 0.8, 0.1);
 48:     mat.alpha = 0.5;
 49:     mat.disableLighting = true;
 50:     disc.material = mat;
 51:     disc.isPickable = false;
 52:     return disc;
 53:   };
 54: 
 55:   const clear = () => {
 56:     for (const entity of spawned) {
 57:       entity.modelObject?.dispose();
 58:       world.remove(entity);
 59:     }
 60: 
 61:     if (selectionRing) {
 62:       selectionRing.material?.dispose();
 63:       selectionRing.dispose();
 64:       selectionRing = null;
 65:     }
 66: 
 67:     spawned.length = 0;
 68:     stagedFor = null;
 69:   };
 70: 
 71:   const stage = () => {
 72:     clear();
 73: 
 74:     for (const character of Store.charactersList) {
 75:       const position = characterSlotPosition(character.SlotIndex);
 76: 
 77:       if (!position) continue;
 78: 
 79:       const appearance = deserializeAppearance(character.Appearance);
 80:       const entity = spawnPlayer(world, { cls: appearance.cls });
 81: 
 82:       world.addComponent(
 83:         entity,
 84:         'worldIndex',
 85:         ENUM_WORLD.WD_74NEW_CHARACTER_SCENE
 86:       );
 87: 
 88:       entity.transform.pos.x = position.x;
 89:       entity.transform.pos.y = position.y;
 90:       entity.transform.pos.z = position.z;
 91: 
 92:       entity.transform.posOffset = Vector3.ZeroReadOnly;
 93: 
 94:       entity.transform.rot.y = characterSlotAngle(character.SlotIndex);
 95: 
 96:       entity.objectNameInWorld = character.Name;
 97: 
 98:       world.addComponent(entity, 'interactable', true);
 99: 
100:       const app = entity.charAppearance;
101: 
102:       app.leftHand = appearance.leftHand;
103:       app.rightHand = appearance.rightHand;
104:       app.helm = appearance.helm;
105:       app.armor = appearance.armor;
106:       app.pants = appearance.pants;
107:       app.gloves = appearance.gloves;
108:       app.boots = appearance.boots;
109:       app.changed = true;
110: 
111:       spawned.push(entity);
112:     }
113:   };
114: 
115:   world.scene.onPointerObservable.add(event => {
116:     if (event.type !== PointerEventTypes.POINTERDOWN) return;
117:     if (Store.uiState !== UIState.Characters) return;
118: 
119:     const target = world.currentPointerTarget;
120:     if (!target || !spawned.includes(target)) return;
121: 
122:     const name = target.objectNameInWorld;
123:     if (!name || name === Store.focusedChar) return;
124: 
125:     Store.focusedChar = name;
126: 
127:     Store.focusCharacterRequest(name);
128:   });
129: 
130:   return {
131:     update: () => {
132:       const staged =
133:         Store.uiState === UIState.Characters &&
134:         world.mapIndex === ENUM_WORLD.WD_74NEW_CHARACTER_SCENE &&
135:         !!world.terrain;
136: 
137:       if (!staged) {
138:         if (stagedFor !== null) clear();
139:         // The line-up is part of this screen's load, so the loading screen
140:         // has to wait for it: the terrain lands first and the character list
141:         // is still in flight, and without this hold the gate lifted on an
142:         // empty scene with the characters walking in behind it.
143:         setSceneHold(GATE, Store.uiState === UIState.Characters);
144:         return;
145:       }
146: 
147:       const key = Store.charactersList
148:         .map(c => `${c.SlotIndex}:${c.Name}:${c.Level}`)
149:         .join('|');
150: 
151:       if (key !== stagedFor) {
152:         stage();
153:         stagedFor = key;
154:       }
155: 
156:       // Spawned: from here the models are counted by the ready check like
157:       // every other one in the scene.
158:       setSceneHold(GATE, Store.loadingCharactersList);
159: 
160:       // Update selection ring under focused character
161:       const focusedName = Store.focusedChar;
162:       const focusedEntity = spawned.find(
163:         e => e.objectNameInWorld === focusedName
164:       );
165: 
166:       if (focusedEntity && focusedEntity.transform) {
167:         if (!selectionRing) {
168:           selectionRing = createSelectionRing();
169:         }
170:         selectionRing.isVisible = true;
171:         selectionRing.position.x = focusedEntity.transform.pos.x;
172:         selectionRing.position.y = focusedEntity.transform.pos.y + 0.02;
173:         selectionRing.position.z = focusedEntity.transform.pos.z;
174: 
175:         // 1. Esto hace que rote un poco en cada frame
176:         selectionRing.rotation.y -= 0.015; 
177:         
178:         // 2. (Opcional) Esto hace el efecto de pulso con la transparencia
179:         if (selectionRing.material) {
180:            selectionRing.material.alpha = 0.5 + Math.sin(performance.now() * 0.003) * 0.2;
181:         }
182:       } else if (selectionRing) {
183:         selectionRing.isVisible = false;
184:       }
185:     },
186:   };
187: };
