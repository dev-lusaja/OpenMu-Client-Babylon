165:   // A warp removes every entity of the map just left (`unloadMap`), the pet
166:   // actors among them. Without this the slot still reads as filled on the new
167:   // map and the pet only comes back on a re-equip.
168:   actors.onEntityRemoved.subscribe(actor => {
169:     glowClocks.delete(actor);
170:     const state = actor.petActor;
171:     (state.kind === 'raven' ? spawnedRaven : spawned).delete(state.owner);
172:   });
