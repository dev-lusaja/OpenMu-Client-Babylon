 22:   // (`RenderSwordformGloves`, MonkSystem.cpp:248); the model items.json names
 23:   // is the one the inventory draws.
 24:   const worn =
 25:     (slot !== undefined && swordformGlovesModel(part, slot)) || item.szModelName;
 26: 
 27:   playerObject.loadPartAsync(
 28:     item.szModelFolder,
 29:     socket,
 30:     worn,
 31:     part.lvl,
 32:     part.isExcellent,
 33:     itemVisualTier(part)
 34:   );
 35: 
 36:   return true;
 37: }
