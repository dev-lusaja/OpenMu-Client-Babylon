27: export const EFFECT_LAYERS = [
28:   projectileLayer, // moves the point the model / trail below follow
29:   debrisLayer, // moves the pieces the models below follow
30:   feathersLayer, // moves the feathers the models below follow
31:   modelLayer, // reads projectile's / debris' / feathers' points
32:   spriteLayer,
33:   particlesLayer,
