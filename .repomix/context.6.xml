163: /**
164:  * A point given in a skinned bone's own frame - the original's
165:  * `TransformPosition(BoneTransform[bone], p, …)`. `local` is in tiles: the
166:  * GLB keeps bone frames in BMD bone space with centimetres scaled to tiles
167:  * (weaponAttachment.ts). Falls back to the entity at `fallbackHeight`.
168:  */
169: export function boneLocalPos(
170:   e: Entity,
171:   bone: number,
172:   local: Vector3,
173:   out: Vector3,
174:   fallbackHeight = 0.9
175: ): Vector3 {
176:   const gltf = e.modelObject?.gltf;
177:   const node = gltf?.skeleton?.bones[bone + 1]?.getTransformNode();
178:   if (node && gltf && !gltf.mesh.isDisposed()) {
179:     Vector3.TransformCoordinatesToRef(local, node.getWorldMatrix(), out);
180:     return out;
181:   }
182:   return entityPos(e, fallbackHeight, out);
183: }
