 96: export interface JointOptions {
 97:   /** Bolt: the far end. Omitted = trail mode (`head` or `velocity`). */
 98:   to?: Vector3 | PointSource;
 99:   /** Bolt: move the near end too (default: fixed at `at`). */
100:   from?: PointSource;
101:   /** Trail: a driven head (a bone, an orbit); the tail is where it has been. */
102:   head?: PointSource;
103:   /** Trail: a free head leaving `at` at this many tiles/s (C++ `Velocity`). */
104:   velocity?: number;
105:   /** Trail: the free head's direction (unit-ish; default: +z). */
106:   heading?: Vector3;
107:   /** Trail: radians/s the free head's yaw turns (the original's per-tick `Angle` step). */
108:   turn?: number;
109:   /** Trail: tiles/s² pulling the free head down. */
110:   gravity?: number;
111:   /**
112:    * Trail: steer like JOINT_SPIRIT sub0 (ZzzEffectJoint.cpp:3732-3772) - per
113:    * tick, home the heading on `seek` by up to `seekRate` radians
114:    * (MoveHumming's 10°/frame), kick damped angular velocities with uniform
115:    * impulses in ±`wander.pitch` / ±`wander.yaw` (the ±3.2°/±12.8° rolls,
116:    * damped ×0.6/×0.8), and keep the head `band` tiles above the terrain (an
117:    * excursion zeroes the pitch momentum and pitches 5° back in). Wins over
118:    * `turn`/`gravity`.
119:    */
120:   steer?: {
121:     seek?: PointSource;
122:     seekRate?: number;
123:     wander?: { pitch: number; yaw: number };
124:     band?: { floor: number; ceiling: number };
125:   };
126:   /**
127:    * Trail: the head's position, once a tick - the per-frame `CreateEffect`
128:    * stamp at a joint's head (Evil Spirit's MODEL_LASER). Read-only: copy it,
129:    * never keep it.
130:    */
131:   trace?: (head: Vector3) => void;
132:   /** Fade fraction at end of life (default 0.3). Evil Spirit's `Light = LifeTime * 0.1` is 10/49. */
133:   fadeTail?: number;
134:   /** Trail: segments kept behind the head (C++ `MaxTails`). */
135:   maxTails?: number;
136:   /**
137:    * Narrow the ribbon toward its ends instead of cutting it off square: a
138:    * rounded nose and a tail that comes to a point. A constant-width ribbon is
139:    * what the original draws, and on a short trail it reads as a rectangular
140:    * plank sliding about rather than as something alive.
141:    */
142:   taper?: boolean;
143:   colour?: RGB;
144:   /** Lifetime; `Infinity` lives until `stop()` / `until` (the original's LT 999999). */
145:   seconds?: number;
146:   /** Ribbon width in tiles (C++ `Scale`). */
147:   width?: number;
148:   /** Bolt: points between the ends. */
149:   segments?: number;
150:   /** Bolt: sideways noise as a fraction of length; 0 = a straight beam. */
151:   jitter?: number;
152:   /** Bolt: side branches, 0…3. */
153:   forks?: number;
154:   /** Tiles above both points. */
155:   height?: number;
156:   /**
157:    * `add` (default) is `EnableAlphaBlend`; `subtract` is
158:    * `EnableAlphaBlendMinus` (`dst × (1 − src)`, ZzzOpenglUtil.cpp:444) - the
159:    * dark ribbons of `RENDER_TYPE_ALPHA_BLEND_MINUS` joints (Evil Spirit's
160:    * JOINT_SPIRIT sub0, ZzzEffectJoint.cpp:602).
161:    */
162:   blend?: EffectBlend;
163:   /**
164:    * `Effect/Joint*` sheet run along the ribbon (recipes.ts `TEX.joint*`) -
165:    * the original's `BindTexture(o->Type)` per joint. Without it the ribbon is
166:    * a flat band of `colour`.
167:    */
168:   texture?: string;
169:   /** U lengths of the sheet along the ribbon (JOINT_THUNDER maps 2). */
170:   textureRepeats?: number;
171:   /** U scroll in sheet lengths/s (`Light -= Scroll`, thunder only: 1). */
172:   textureScroll?: number;
173:   /** Ends it early when true (the wearer left, the charge released). */
174:   until?: () => boolean;
175: }
