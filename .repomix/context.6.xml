125: /**
126:  * A slot has to be rebuilt when the item changed, and when its actor was left
127:  * behind on another map: `unloadMap` sweeps the actors of the map just left,
128:  * and one spawned in the gap before the hero is moved sits on his old tile.
129:  */
130: function stale(current: Spawned | undefined, item: Item | null, map: number) {
131:   if (!sameItem(current?.item ?? null, item)) return true;
132:   return current !== undefined && current.map !== map;
133: }
