  2: import { Store } from '../../store';
  3: import { applyPlayerActionSpeed, serverMinAttackInterval } from '../../common/playSpeed';
  4: import { HitRequestPacket } from '../../common/packets/ClientToServerPackets';
  5: import {
  6:   MonsterActionType,
  7:   ServerPlayerActionType,
  8: } from '../../common/objects/enum';
  9: import { TWFlags } from '../../common/terrain/consts';
 10: import { isFlagInBinaryMask } from '../../common/utils';
 11: import { chooseAttackAction } from '../../common/weaponClass';
 12: import { getBaseClass } from '../../common/characterStats';
 13: import { isWingItem } from '../../common/wings';
 14: import { mountKind } from '../../common/pets';
 15: import { playBowShotVisual } from '../../common/skillVisuals';
 16: import { combat } from '../../combat';
 17: import { MOUSE_UPDATE_SECONDS_MAX } from '../../combat/inputGate';
 18: import { skillDefinition } from '../../common/skillsDatabase';
 19: import { truncatePathWithinRange } from '../../common/approachPath';
 20: import { isHostilePlayer } from '../../combat/playerTarget';
 21: import { duelEnemyId } from '../../events/duel';
 22: 
 23: /**
 24:  * Left-click basic attack (`Action()` MOVEMENT_ATTACK, ZzzInterface.cpp:3283-3356):
 25:  * walk into the weapon's reach, face the target, restart the swing clip and
 26:  * latch the hit. Timing comes from the `combat` layer - the 0.24 s input
 27:  * gate, the `AttackTime` latch that sends `HitRequest` at the clip's hit
 28:  * key, the reach per weapon and the archer's ammunition check. This is
 29:  * also the one place `combat.update` is stepped: it runs before
 30:  * SkillCastSystem, so both read a fresh frame.
 31:  */
 32: 
 33: /** The swing's half of `truncatePathWithinRange`: the reach of the hands. */
 34: export function truncatePathForAttack(
 35:   path: { x: number; y: number }[],
 36:   target: Entity
 37: ): void {
 38:   truncatePathWithinRange(
 39:     path,
 40:     ~~target.transform!.pos.x,
 41:     ~~target.transform!.pos.z,
 42:     combat.attackRange(Store.world?.playerEntity?.charAppearance)
 43:   );
 44: }
 45: 
 46: const APPROACH_INTERVAL = 0.4;
 47: 
 48: const NPC_TYPE_OVERRIDES = new Set([
 49:   367, 368, 369, 370, 371, 375, 376, 377, 378, 379, 380, 381, 382, 383, 384,
 50:   385, 406, 407, 408, 414, 415, 416, 417, 450, 452, 453, 464, 465, 467, 468,
 51:   469, 470, 471, 472, 473, 474, 475, 478, 479, 492, 522, 540, 541, 542, 543,
 52:   544, 545, 546, 547, 566, 568, 577, 578, 579,
 53: ]); // 566 Mercenary Guild Felicia, 568 Wandering Merchant Zyro (OpenMU NpcInitialization, PassiveNpc)
 54: 
 55: export function isNpcOrTrapType(type: number): boolean {
 56:   if (type === 200) return false;
 57:   if (type > 200 && type < 260) return true;
 58:   if (type >= 480 && type <= 491) return false;
 59:   if (NPC_TYPE_OVERRIDES.has(type)) return true;
 60:   if (type >= 100 && type <= 110) return true;
 61:   return false;
 62: }
 63: 
 64: export function isAttackableEntity(
 65:   world: Parameters<ISystemFactory>[0],
 66:   e: Entity
 67: ): boolean {
 68:   if (e.netId === undefined || e.localPlayer) return false;
 69:   // `npcType` is what makes an entity a monster or an NPC: only the
 70:   // AddNpcsToScope path sets it, so players never reach the type test below.
 71:   // The animation component is deliberately not part of this: the player-rig
 72:   // monsters (the Skeletons, Death King, Death Bone, the Cursed Wizard) drop
 73:   // `monsterAnimation` in favour of `playerAnimation` when they load
 74:   // (skeletonWarrior.ts), and requiring it here left them un-hoverable and
 75:   // un-attackable - no attack cursor, no `attackTarget` on click.
 76:   if (e.npcType === undefined) return false;
 77:   if (e.objOutOfScope) return false;
 78:   // A player-rig monster dies through `dying` / PLAYER_DIE1 instead.
 79:   if (e.monsterAnimation?.action === MonsterActionType.Die || e.dying) return false;
 80:   if (isNpcOrTrapType(e.npcType)) return false;
 81: 
 82:   const player = world.playerEntity;
 83:   if (player?.attributeSystem.isAboveZero('inSafeZone')) return false;
 84: 
 85:   const flag = world.getTerrainFlag(~~e.transform!.pos.x, ~~e.transform!.pos.z);
 86:   if (isFlagInBinaryMask(flag, TWFlags.SafeZone)) return false;
 87: 
 88:   return true;
 89: }
 90: 
 91: /**
 92:  * Another player's character. Stricter than `playerAnimation` alone: the
 93:  * player-rig monsters (the Skeletons, Death King, the Cursed Wizard) carry
 94:  * that component too, and every attack rule counts them as monsters.
 95:  */
 96: export function isOtherPlayer(e: Entity): boolean {
 97:   if (e.netId === undefined || e.localPlayer) return false;
 98:   return e.npcType === undefined && (!!e.playerAnimation || e.skin !== undefined);
 99: }
100: 
101: /**
102:  * A player the hero may swing at. `isAttackableEntity` refuses every player
103:  * so an ordinary click in a crowd never starts a fight; the quick command
104:  * menu's attack entry, a deliberate gesture, tests with this instead: the
105:  * same safe-zone and liveness rules, without the monster/NPC one. The
106:  * clicks themselves go through `canAttackPlayer`.
107:  */
108: export function isAttackablePlayer(
109:   world: Parameters<ISystemFactory>[0],
110:   e: Entity
111: ): boolean {
112:   if (!isOtherPlayer(e)) return false;
113:   if (e.objOutOfScope || e.dying) return false;
114: 
115:   const player = world.playerEntity;
116:   if (player?.attributeSystem.isAboveZero('inSafeZone')) return false;
117: 
118:   const flag = world.getTerrainFlag(~~e.transform!.pos.x, ~~e.transform!.pos.z);
119:   if (isFlagInBinaryMask(flag, TWFlags.SafeZone)) return false;
120: 
121:   return true;
122: }
123: 
124: /**
125:  * `CheckAttack` on another player, in full: `isAttackablePlayer` plus the
126:  * rule that makes them fair game - the duel, their PK state, or Ctrl held
127:  * (`combat/playerTarget`). What both click paths test.
128:  */
129: export function canAttackPlayer(
130:   world: Parameters<ISystemFactory>[0],
131:   e: Entity,
132:   ctrl: boolean
133: ): boolean {
134:   return (
135:     isAttackablePlayer(world, e) &&
136:     isHostilePlayer(e, { duelEnemyId: duelEnemyId(), ctrl })
137:   );
138: }
139: 
140: function directionCode(dx: number, dy: number): number {
141:   const octant = Math.round(Math.atan2(dy, dx) / (Math.PI / 4));
142:   return (((3 + octant) % 8) + 8) % 8;
143: }
144: 
145: export const AttackSystem: ISystemFactory = world => {
146:   let attackCooldown = 0;
147:   let approachDelay = 0;
148:   let alternateSwing = false;
149: 
150:   return {
151:     update: dt => {
152:       // The one lifecycle call: every combat timer steps here, before any
153:       // fighting system reads it this frame.
154:       combat.update(world.mapIndex, dt);
155: 
156:       attackCooldown -= dt;
157:       approachDelay -= dt;
158: 
159:       const playerEntity = world.playerEntity;
160:       if (!playerEntity || playerEntity.dying) {
161:         combat.cancelAttack(); // Hero->Dead > 0: a swing in flight never lands
162:         return;
163:       }
164: 
165:       const target = world.attackTarget;
166:       if (!target) return;
167: 
168:       if (
169:         (!isAttackableEntity(world, target) && !isAttackablePlayer(world, target)) ||
170:         target.worldIndex !== world.mapIndex
171:       ) {
172:         world.attackTarget = null;
173:         return;
174:       }
175: 
176:       // A cast is being served this frame: it owns the hero. `Action()` runs
177:       // one movement intent, and these two do not agree on where to stand -
178:       // the swing walks into weapon reach, the cast stands off at the skill's
179:       // range. Left set against each other they take turns on the same
180:       // `playerMoveTo` every frame and drag the hero onto what he is casting
181:       // at. The target stays selected (the health bar, head tracking and the
182:       // mobile skill pad all read it); only the walk and the swing yield.
183:       if (world.castRequest && skillDefinition(Store.currentSkill)) return;
184: 
185:       const hands = playerEntity.charAppearance;
186:       const playerPos = playerEntity.transform.pos;
187:       const targetPos = target.transform!.pos;
188: 
189:       // Tile distance, both sides truncated, like truncatePathForAttack.
190:       // Mixing the target's tile corner with the hero's float position
191:       // read "out of range" whenever the hero stood off-grid beside the
192:       // monster (the path is cleared mid-step on entering range), so the
193:       // approach branch ran instead of the facing/swing branch and the
194:       // hero stood shuffling with a stale walk yaw.
195:       const dx = ~~targetPos.x - ~~playerPos.x;
196:       const dz = ~~targetPos.z - ~~playerPos.z;
197:       const distSquared = dx * dx + dz * dz;
198:       const range = combat.attackRange(hands);
199: 
200:       // Face the target's live position, not its tile corner, and keep
201:       // facing it whenever the hero stands still - including the throttle
202:       // gaps of the approach walk while a swing clip is still finishing:
203:       // the original's CreateAngle (ZzzCharacter.cpp, AT_ATTACK*) works on
204:       // the objects' float positions, re-evaluated every frame while the
205:       // attack action plays. The old truncated tile delta degenerated to
206:       // atan2(0, 0) when the monster stepped onto the hero's tile and
207:       // skewed the yaw up to ~90° at melee distances; walking frames keep
208:       // the path facing (MoveAlongPathSystem), like the original's chase.
209:       const fdx = targetPos.x - playerPos.x;
210:       const fdz = targetPos.z - playerPos.z;
211:       const vel = playerEntity.movement?.velocity;
212:       const standing = !vel || (vel.x === 0 && vel.y === 0);
213:       if (standing && fdx * fdx + fdz * fdz > 1e-6) {
214:         playerEntity.transform.rot.y = Math.atan2(fdz, fdx) + Math.PI / 2;
215:       }
216: 
217:       if (distSquared > range * range) {
218:         if (approachDelay <= 0) {
219:           approachDelay = APPROACH_INTERVAL;
220:           const moveTo = playerEntity.playerMoveTo;
221:           moveTo.point.x = targetPos.x;
222:           moveTo.point.y = targetPos.z;
223:           moveTo.handled = false;
224:           moveTo.sendToServer = true;
225:         }
226:         return;
227:       }
228: 
229:       const { pathfinding } = playerEntity;
230:       if (pathfinding.path && pathfinding.path.length > 0) {
231:         pathfinding.path = null;
232:         pathfinding.from = { x: ~~playerPos.x, y: ~~playerPos.z };
233:         pathfinding.to = { x: ~~playerPos.x, y: ~~playerPos.z };
234:       }
235: 
236:       if (attackCooldown > 0 || !combat.inputGateOpen) return;
237: 
238:       // CheckArrow(): a bow without arrows / a crossbow without bolts does
239:       // not swing. The original tries ReloadArrow() from the inventory; we
240:       // drop the target and let the player equip ammunition.
241:       if (!combat.hasAmmo(hands)) {
242:         world.attackTarget = null;
243:         return;
244:       }
245: 
246:       const anim = playerEntity.playerAnimation;
247:       const swordCount = anim.swordCount ?? 0;
248:       const action = chooseAttackAction({
249:         hands,
250:         baseClass: getBaseClass(hands?.charClass ?? Store.playerData.charClass),
251:         swordCount,
252:         wings: isWingItem(hands?.wings),
253:         mount: mountKind(
254:           hands?.pet,
255:           playerEntity.attributeSystem?.isAboveZero('inSafeZone') ?? false
256:         ),
257:       });
258:       // `c->SwordCount++` at the end of SetPlayerAttack.
259:       anim.swordCount = swordCount + 1;
260:       const attackAnimation = alternateSwing
261:         ? ServerPlayerActionType.Attack2
262:         : ServerPlayerActionType.Attack1;
263:       const lookingDirection = directionCode(fdx, fdz);
264:       alternateSwing = !alternateSwing;
265: 
266:       const model = playerEntity.modelObject;
267:       if (model) applyPlayerActionSpeed(model, action, playerEntity.attributeSystem);
268:       if (model && anim.action === action) {
269:         // Same clip twice in a row: AnimationSystem would see no change, so
270:         // restart it explicitly.
271:         model.restartAction();
272:       }
273:       anim.action = action;
274: 
275:       // The blow lands at the clip's hit key: latch the HitRequest there. The
276:       // clip length is the fallback - the request never outlives the clip.
277:       const playSpeed = model?.AnimationSpeed ?? 0;
278:       const clipSeconds = model?.getActionDuration(action) || undefined;
279:       const hitDelay = combat.startAttack(action, playSpeed, () => {
280:         // CreateArrows() at AttackStage's hit key: the bow lets go here.
281:         playBowShotVisual(world.scene, playerEntity, target);
282:         if (target.dying || target.objOutOfScope || target.netId === undefined) return;
283:         const packet = HitRequestPacket.createPacket();
284:         packet.TargetId = target.netId;
285:         packet.AttackAnimation = attackAnimation;
286:         packet.LookingDirection = lookingDirection;
287:         Store.sendToGS(packet.buffer);
288:       }, clipSeconds);
289:       combat.consumeInputGate();
290: 
291:       // MouseUpdateTimeMax (0.24 s), the hit key of this swing, and the
292:       // server's anti-speedhack interval - whichever is the latest.
293:       attackCooldown = Math.max(
294:         MOUSE_UPDATE_SECONDS_MAX,
295:         hitDelay,
296:         serverMinAttackInterval(playerEntity.attributeSystem?.getValue('attackSpeed') ?? 0)
297:       );
298:     },
299:   };
300: };
</file>

