<file path="src/ecs/systems/dropMotionSystem.ts">
  1: import { ENUM_WORLD } from '../../common/types';
  2: import { itemRestHeight, itemTumbleAxis } from '../../common/itemAngle';
  3: import type { Entity, ISystemFactory } from '../world';
  4: 
  5: /**
  6:  * How a dropped item moves (`MoveItems`, ZzzObject.cpp:6244; `CreateItem`
  7:  * :6200; `RenderItems` :6394):
  8:  *
  9:  * - A **fresh** drop (`IsFreshDrop`) is created 180 cm up with
 10:  *   `Gravity = 20` cm/tick and falls under `Gravity -= 6` a tick, tumbling
 11:  *   - `Angle[0] = -Gravity × 10°` while airborne, `Angle[1]` for a shield -
 12:  *   until it reaches its rest height, where `ItemAngle` sets the lying pose
 13:  *   back (that pose is `common/itemAngle.ts`, applied at spawn). Here the
 14:  *   fall is a render-only `posOffset.y` above the rest position logic.ts
 15:  *   placed it at, so pathing, picking and the name tag never see it move.
 16:  * - On Icarus (and Kanturu's Maya scene) every drop **bobs**:
 17:  *   `Position[2] += 10 × sin((i × 1237 + WorldTime) × 0.002)`.
 18:  *
 19:  * Nothing here allocates per frame; a drop that is neither fresh nor on a
 20:  * bobbing map costs one boolean.
 21:  */
 22: 
 23: // ---- tuning ------------------------------------------------------------------
 24: 
 25: /** 25 Hz: the original's step. */
 26: const TICKS_PER_SECOND = 25;
 27: 
 28: /** `Position[2] = terrain + 180` at creation, above the item's rest height. */
 29: const START_HEIGHT_CM = 180;
 30: /** `o->Gravity = 20.f`, cm per tick, upward. */
 31: const START_VELOCITY_CM = 20;
 32: /** `o->Gravity -= 6.f` a tick. */
 33: const GRAVITY_CM = 6;
 34: /**
 35:  * `Angle[0] = -Gravity × 10` degrees while airborne. `transform.rot` negates
 36:  * the original's pitch and roll (common/renderAngles.ts), so the rotation the
 37:  * entity carries is `+Gravity × 10`.
 38:  */
 39: const TUMBLE_DEG_PER_CM = 10;
 40: 
 41: /** Maps whose drops bob. */
 42: const BOB_MAPS: ReadonlySet<ENUM_WORLD> = new Set([ENUM_WORLD.WD_10ICARUS]);
 43: /** `10 × sin(…)` cm. */
 44: const BOB_CM = 10;
 45: /** `WorldTime × 0.002` with WorldTime in ms: radians per second. */
 46: const BOB_RATE = 2;
 47: /** `i × 1237 × 0.002`: the per-drop phase, radians per index. */
 48: const BOB_PHASE = 1237 * 0.002;
 49: 
 50: /**
 51:  * Seconds a fresh drop waits for its model before the fall is written off.
 52:  * A drop that spawns at the edge of the view range may never get one, and a
 53:  * corpse's loot must not leap into the air a minute later when the hero
 54:  * finally walks over to it.
 55:  */
 56: const FRESH_GRACE_SECONDS = 2;
 57: 
 58: const DEG = Math.PI / 180;
 59: const CM = 1 / 100;
 60: 
 61: // ---- state -------------------------------------------------------------------
 62: 
 63: type Motion = {
 64:   /** cm/tick, the original's `Gravity` field. */
 65:   velocity: number;
 66:   /** Fractional ticks carried between frames. */
 67:   tickAcc: number;
 68:   airborne: boolean;
 69:   /** `ItemAngle`'s pose, to restore on landing. */
 70:   restRotX: number;
 71:   restRotZ: number;
 72:   /** Which axis the tumble spins: `Angle[1]` for shields, `Angle[0]` otherwise. */
 73:   tumbleAxis: 'x' | 'z';
 74:   offset: { x: number; y: number; z: number };
 75: };
 76: 
 77: export const DropMotionSystem: ISystemFactory = world => {
 78:   const drops = world.with('droppedItem', 'transform');
 79:   const motions = new Map<Entity, Motion>();
 80:   /** When each still-modelless fresh drop was first seen (FRESH_GRACE_SECONDS). */
 81:   const waiting = new Map<Entity, number>();
 82: 
 83:   drops.onEntityRemoved.subscribe(e => {
 84:     motions.delete(e);
 85:     waiting.delete(e);
 86:   });
 87: 
 88:   function start(e: Entity, airborne: boolean): Motion {
 89:     const t = e.transform!;
 90:     const group = e.droppedItem!.group;
 91:     // The drop already sits at its rest height; the fall starts at the
 92:     // original's absolute +180 cm, which is that much *further* up.
 93:     const above = START_HEIGHT_CM * CM - itemRestHeight(group);
 94:     const offset = { x: 0, y: airborne ? Math.max(0, above) : 0, z: 0 };
 95:     t.posOffset = offset;
 96:     const m: Motion = {
 97:       velocity: START_VELOCITY_CM,
 98:       tickAcc: 0,
 99:       airborne,
100:       restRotX: t.rot.x,
101:       restRotZ: t.rot.z,
102:       tumbleAxis: itemTumbleAxis(group),
103:       offset,
104:     };
105:     motions.set(e, m);
106:     return m;
107:   }
108: 
109:   return {
110:     update: dt => {
111:       const bob = BOB_MAPS.has(world.mapIndex);
112:       const now = world.gameTime.TotalGameTime.TotalSeconds;
113: 
114:       for (const e of drops) {
115:         const { droppedItem, transform } = e;
116:         let m = motions.get(e);
117:         // The model is built lazily, once the drop is close enough to matter
118:         // (ModelLoaderSystem), and the whole fall is over in half a second:
119:         // starting it on the packet meant every drop had already landed by
120:         // the time it had a mesh to see it with.
121:         if (!m && droppedItem.fresh) {
122:           if (e.modelObject?.Ready) {
123:             waiting.delete(e);
124:             m = start(e, true);
125:           } else {
126:             const since = waiting.get(e);
127:             if (since === undefined) waiting.set(e, now);
128:             else if (now - since > FRESH_GRACE_SECONDS) {
129:               droppedItem.fresh = false;
130:               waiting.delete(e);
131:             }
132:           }
133:         }
134: 
135:         if (m?.airborne) {
136:           m.tickAcc += dt * TICKS_PER_SECOND;
137:           while (m.tickAcc >= 1) {
138:             m.tickAcc -= 1;
139:             m.offset.y += m.velocity * CM;
140:             m.velocity -= GRAVITY_CM;
141:           }
142:           if (m.offset.y <= 0) {
143:             m.offset.y = 0;
144:             m.airborne = false;
145:             transform.rot.x = m.restRotX;
146:             transform.rot.z = m.restRotZ;
147:             droppedItem.fresh = false;
148:           } else {
149:             transform.rot[m.tumbleAxis] = m.velocity * TUMBLE_DEG_PER_CM * DEG;
150:           }
151:           continue;
152:         }
153: 
154:         if (!bob) continue;
155:         if (!m) m = start(e, false);
156:         m.offset.y = BOB_CM * CM * Math.sin((e.netId ?? 0) * BOB_PHASE + now * BOB_RATE);
157:       }
158:     },
159:   };
160: };
</file>

