186: /** `ReceiveMoveToDevilSquareResult`. */
187: EventBus.on('DevilSquareEnterResult', packet => {
188:   const p = new DevilSquareEnterResultPacket(packet);
189:   closeDevilSquare();
190: 
191:   let text: string | null = null;
192:   switch (p.Result) {
193:     case DevilSquareEnterResultEnterResultEnum.Success:
194:       break;
195:     case DevilSquareEnterResultEnterResultEnum.Failed:
