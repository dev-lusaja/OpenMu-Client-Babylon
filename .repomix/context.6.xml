279:   /**
280:    * The mid-clip half: the step lands the first time the clip passes the
281:    * consecutive-attack key, once per cast. The clip itself is only started by
282:    * `animationSystem` later in the frame, so this waits for the model to be
283:    * in it rather than latching a serial at cast time, and gives up after the
284:    * clip's own length in case it never gets there (the cast was interrupted,
285:    * the hero walked away, the model is still loading).
286:    *
287:    * The original also re-sends the skill packet on this frame; that is not
288:    * repeated here, because the cast already went out as a
289:    * `RageAttackRequest` and OpenMU reads a second one as a second hit.
290:    * Chain Drive keeps the facing it stepped in with (`m_btAttState ==
291:    * FRAME_SECONDATT`, MonkSystem.cpp:476-478), which `clipHoldsFacing` covers.
292:    */
293:   function drainPendingStep(hero: Entity, dt: number): void {
294:     if (!pendingStep) return;
295:     pendingStep.expiresIn -= dt;
296:     if (pendingStep.expiresIn <= 0) {
297:       pendingStep = null;
298:       return;
299:     }
300:     const model = hero.modelObject;
301:     if (!model || model.CurrentAction !== pendingStep.clip) return;
302:     if (model.actionFrame() < CONSECUTIVE_ATTACK_KEY) return;
303:     stepIn(hero, pendingStep.to);
304:     pendingStep = null;
305:   }
306: 
307:   /** 0xDB: name the attackable objects inside the area around (x, y). */
308:   function sendAreaHit(def: SkillDefinition, x: number, y: number): void {
309:     if (Store.isOffline || !combat.needsAreaHit(def)) return;
310:     const radius = combat.areaHitRadius(def);
311:     const ids: number[] = [];
312:     for (const e of world.netObjsQuery.entities) {
313:       if (!isAttackableEntity(world, e)) continue;
314:       const dx = e.transform!.pos.x - x;
315:       const dz = e.transform!.pos.z - y;
316:       if (dx * dx + dz * dz <= radius * radius) ids.push(e.netId!);
317:     }
318:     const packet = combat.buildAreaHit(def.num, x, y, ids);
319:     if (packet) Store.sendToGS(packet.buffer);
320:   }
321: 
322:   return {
323:     update: dt => {
324:       cooldown -= dt;
325:       approachDelay -= dt;
326:       if (!world.rightPointerPressed) summonCast = false;
327:       // Re-armed below for as long as the approach walk is still running, so
328:       // a dropped cast never leaves a stale cut on the next ordinary walk.
329:       world.castApproach = null;
330: 
331:       const hero = world.playerEntity;
332:       if (!hero || hero.dying) {
333:         world.castRequest = null;
334:         if (combat.novaCharging) combat.releaseNova();
335:         return;
336:       }
337: 
338:       drainDarkSide();
339:       drainPendingStep(hero, dt);
340: 
341:       // Standing on a safe zone tile: no skill goes out at all, whatever the
342:       // gesture was - `if (c->SafeZone) break` out of the AT_SKILL_* branches
343:       // (ZzzInterface.cpp:3325), the same rule that already refuses the plain
344:       // attack click (attackSystem). Ahead of the request so nothing is left
345:       // half-done: no walk into range, no clip, no packet, and a Nova charge
346:       // carried in from outside is dropped instead of fired.
347:       if (hero.attributeSystem?.isAboveZero('inSafeZone')) {
348:         if (combat.novaCharging) combat.releaseNova();
349:         world.castRequest = null;
350:         return;
351:       }
352: 
353:       const req = world.castRequest;
354: 
355:       // ---- Nova hold: the button came up (or the left button was clicked)
356:       // while charging → AT_SKILL_NOVA at the selected target (`SkillKeyPush`).
357:       if (combat.novaCharging && (!world.rightPointerPressed || world.pointerPressed)) {
358:         combat.releaseNova();
359:         const def = skillDefinition(SKILL_NOVA);
360:         const target = req?.target ?? null;
361:         const targetId =
362:           target && isAttackableEntity(world, target) && target.netId !== undefined
363:             ? target.netId
364:             : (Store.playerId ?? 0);
365:         sendTargeted(SKILL_NOVA, targetId);
366:         if (def) {
367:           const duration = playClip(hero, clipFor(hero, def));
368:           cooldown = Math.max(
369:             duration > 0 ? duration : FALLBACK_CAST_COOLDOWN,
370:             serverMinAttackInterval(hero.attributeSystem?.getValue('attackSpeed') ?? 0)
371:           );
372:           const sfx = skillSound(def.num);
373:           if (sfx) playSfx(sfx, hero.transform.pos, { bus: COMBAT_BUS });
374:         }
375:         world.castRequest = null;
376:         return;
377:       }
378: 
379:       // The repeat belongs to the held button, not to the request: one that
380:       // has already cast is dropped as soon as the button is up, instead of
381:       // waiting for the clip to end and going out a second time. A request
382:       // that has not cast yet is left alone - that is the hero still walking
383:       // into range, which the mobile pad and the approach walk both rely on.
384:       if (req && castSent === req && !world.rightPointerPressed) {
385:         world.castRequest = null;
386:         castSent = null;
387:         return;
388:       }
389: 
390:       if (!req) return;
391: 
392:       const def = skillDefinition(Store.currentSkill);
393:       if (!def) {
394:         // No skill selected: the right button behaves like a plain attack
395:         // click, and another player is only swung at with Ctrl held.
396:         const swingAt = req.target;
397:         if (
398:           swingAt &&
399:           (isAttackableEntity(world, swingAt) ||
400:             (req.pvp && isAttackablePlayer(world, swingAt)))
401:         ) {
402:           world.attackTarget = swingAt;
403:         }
404:         world.castRequest = null;
405:         return;
406:       }
407: 
408:       // One summon per press. The button is still down when the cast goes
409:       // out, and a right-drag re-arms the request on every mouse move, so
410:       // without the latch the second cast dismisses the monster the first
411:       // one just put on the map.
412:       if (def.type === 'SummonMonster' && summonCast) {
413:         world.castRequest = null;
414:         return;
415:       }
416: 
417:       // ---- Nova hold: the button is down - keep the charge clip up.
418:       if (combat.novaCharging) {
419:         const model = hero.modelObject;
420:         if (model?.ActionIterationWasFinished) {
421:           const beginDef = skillDefinition(SKILL_NOVA_BEGIN);
422:           if (beginDef) playClip(hero, clipFor(hero, beginDef));
423:         }
424:         return;
425:       }
426: 
427:       if (cooldown > 0) return;
428: 
429:       // ---- Teleport: a one-shot at the square under the cursor.
430:       if (isTeleportSkill(def.num)) {
431:         const point = req.point;
432:         if (castTeleport(hero, def, req.target ?? null, point)) {
433:           const heroPos = hero.transform.pos;
434:           hero.pathfinding.path = null;
435:           const duration = playClip(hero, clipFor(hero, def));
436:           const sfx = skillSound(def.num);
437:           if (sfx) playSfx(sfx, heroPos, { bus: COMBAT_BUS });
438:           cooldown = duration > 0 ? duration : FALLBACK_CAST_COOLDOWN;
439:         }
440:         world.castRequest = null;
441:         return;
442:       }
443: 
444:       const area = isAreaSkill(def);
445: 
446:       let target: Entity | null = req.target ?? null;
447:       if (
448:         target &&
449:         !(isAttackableEntity(world, target) || (isPlayer(target) && target !== hero))
450:       ) {
451:         target = null;
452:       }
453:       // `CheckAttack` (ZzzInterface.cpp:1778) hands a hostile skill another
454:       // player's key only while Ctrl is held, so a right click on a passer-by
455:       // is not an attack. The ally casts - Heal, Greater Damage / Defense,
456:       // Soul Barrier - are the original's own exception (:4896-4909) and
457:       // reach a player without it.
458:       if (
459:         target &&
460:         isOtherPlayer(target) &&
461:         !isSelfCastable(def) &&
462:         !(req.pvp && isAttackablePlayer(world, target))
463:       ) {
464:         target = null;
465:       }
466:       // Ctrl + right button on a targeted skill: the hovered object was
467:       // dropped by the pointer system, so aim at whoever stands nearest the
468:       // cursor's ground point inside the skill's reach instead.
469:       if (req.forced && !area && !target && req.point && !isSelfCastable(def)) {
470:         target = nearestAttackable(req.point.x, req.point.y, def.distance > 0 ? def.distance : DEFAULT_RANGE);
471:       }
472:       // `SendRequestMagic(Skill, HeroKey)` with the selection ignored: Swell
473:       // Life, the elf summons, Infinity Arrow, Berserker and the Rage
474:       // Fighter party buffs go out on the caster even with a monster picked.
475:       if (castsOnSelfOnly(def)) target = hero;
476:       else if (!area && !target && isSelfCastable(def)) target = hero;
477: 
478:       const heroPos = hero.transform.pos;
479:       let tx: number | undefined;
480:       let ty: number | undefined;
481:       if (target) {
482:         tx = target.transform!.pos.x;
483:         ty = target.transform!.pos.z;
484:       } else if ((area || req.forced) && req.point) {
485:         // Forced cast with nothing near the cursor still fires at the
486:         // ground point instead of silently returning.
487:         tx = req.point.x;
488:         ty = req.point.y;
489:       }
490: 
491:       // ---- Nova: the press starts the charge on the hero, no target needed.
492:       if (def.num === SKILL_NOVA) {
493:         const beginDef = skillDefinition(SKILL_NOVA_BEGIN) ?? def;
494:         if (!skills.canUse(SKILL_NOVA) || !combat.beginNova()) {
495:           world.castRequest = null;
496:           return;
497:         }
498:         skills.startCooldown(SKILL_NOVA);
499:         sendTargeted(SKILL_NOVA_BEGIN, Store.playerId ?? 0);
500:         playClip(hero, clipFor(hero, beginDef));
501:         return;
502:       }
503: 
504:       if (tx === undefined || ty === undefined) {
505:         if (!world.rightPointerPressed) world.castRequest = null;
506:         return;
507:       }
508: 
509:       const dx = ~~tx - heroPos.x;
510:       const dz = ~~ty - heroPos.z;
511:       const dist = Math.sqrt(dx * dx + dz * dz);
512:       const range = def.distance > 0 ? def.distance + 0.5 : DEFAULT_RANGE;
513: 
514:       // Force cast (Ctrl) fires in place like the original's force attack -
515:       // it never walks the hero into range first.
516:       if (target !== hero && dist > range && !req.forced) {
517:         // The walk is aimed at the target's own cell, so both the server and
518:         // the client's walker have to be told to give up the last `range`
519:         // tiles of it (NetworkSystem, `truncatePathWithinRange`). Without
520:         // that the walk ends on top of what the hero came to cast at.
521:         world.castApproach = { x: ~~tx, y: ~~ty, range };
522:         if (approachDelay <= 0) {
523:           approachDelay = APPROACH_INTERVAL;
524:           const moveTo = hero.playerMoveTo;
525:           moveTo.point.x = tx;
526:           moveTo.point.y = ty;
527:           moveTo.handled = false;
528:           moveTo.sendToServer = true;
529:         }
530:         return;
531:       }
532: 
533:       // `LetHeroStop()` (ZzzInterface.cpp:1935): every cast drops the path
534:       // first, so a skill is never taken mid-stride.
535:       const { pathfinding } = hero;
536:       const wasWalking = !!pathfinding.path && pathfinding.path.length > 0;
537:       if (wasWalking) {
538:         pathfinding.path = null;
539:         pathfinding.from = { x: ~~heroPos.x, y: ~~heroPos.z };
540:         pathfinding.to = { x: ~~heroPos.x, y: ~~heroPos.z };
541:       }
542:       // `bLookAtMouse = false` (:7394-7419): Rageful Blow and Chain Drive
543:       // keep the facing they started with, so a repeat cast does not snap
544:       // the caster round mid-swing.
545:       const heldClip =
546:         hero.modelObject &&
547:         !hero.modelObject.ActionIterationWasFinished &&
548:         combat.clipHoldsFacing(hero.modelObject.CurrentAction);
549:       if (target !== hero && dist > 0.01 && !heldClip) {
550:         hero.transform.rot.y = Math.atan2(dz, dx) + Math.PI / 2;
551:       }
552:       // The stop is a packet, not just a dropped path. The server is still
553:       // walking the steps it was handed - for the approach walk, all the way
554:       // onto the target's tile - while the hero stands here casting, and once
555:       // the two are more than 5 tiles apart it resynchronises us onto its own
556:       // position with an ObjectMoved.
557:       if (wasWalking) Store.sendWalkStop(heroPos.x, heroPos.z, hero.transform.rot.y);
558: 
559:       // Mana / AG / re-use delay / requirements are gated client-side first
560:       // (the skill layer's verdict; the server re-checks everything).
561:       if (!skills.canUse(def.num)) {
562:         world.castRequest = null;
563:         return;
564:       }
565:       skills.startCooldown(def.num);
566: 
567:       if (!Store.isOffline) {
568:         if (!area && !target) {
569:           // Forced cast with nothing near the cursor: the clip whiffs
570:           // toward the ground point and nothing goes on the wire. The hero
571:           // key must not stand in here - a targeted packet naming the
572:           // caster lands the skill on the character, not at the cursor.
573:         } else if (combat.isDarkSide(def.num)) {
574:           // Dark Side: 0x4B asks the server for the targets, 0x4A lands the
575:           // first blow (ZzzInterface.cpp:2841-2842).
576:           const targetId = target?.netId ?? Store.playerId ?? 0;
577:           const range = RageAttackRangeRequestPacket.createPacket();
578:           range.SkillId = def.num;
579:           range.TargetId = targetId;
580:           Store.sendToGS(range.buffer);
581:           sendRageAttack(def.num, targetId);
582:           combat.beginDarkSide(def.num, targetId);
583:         } else if (area) {
584:           const packet = AreaSkillPacket.createPacket();
585:           packet.SkillId = def.num;
586:           packet.TargetX = ~~tx;
587:           packet.TargetY = ~~ty;
588:           packet.Rotation = rotationByte256(hero.transform.rot.y);
589:           packet.ExtraTargetId = target?.netId ?? NO_EXTRA_TARGET;
590:           Store.sendToGS(packet.buffer);
591:           sendAreaHit(def, ~~tx, ~~ty);
592:         } else {
593:           sendTargeted(def.num, target!.netId ?? Store.playerId ?? 0);
594:         }
595:       }
596: 
597:       // Where the cast puts the caster (`combat/skillMovement`): the contact
598:       // skills close the last tile themselves, either now or partway through
599:       // the clip.
600:       // The step closes the last tile, not the whole gap: `SendAttackPacket`
601:       // only runs it for a target the skill could already reach. A Ctrl force
602:       // cast skips the approach walk, so without the range check here it puts
603:       // the caster next to a target anywhere on the map.
604:       const step = dist <= range ? combat.skillStepIn(def.num) : null;
605:       const stepSquare =
606:         step && target && target !== hero
607:           ? combat.stepInSquare(
608:               { x: heroPos.x, y: heroPos.z },
609:               { x: target.transform!.pos.x, y: target.transform!.pos.z }
610:             )
611:           : null;
612:       if (step === 'cast' && stepSquare) stepIn(hero, stepSquare);
613: 
614:       const action = clipFor(hero, def);
615:       const duration = playClip(hero, action);
616: 
617:       if (step === 'midClip' && stepSquare) {
618:         pendingStep = {
619:           clip: action,
620:           to: stepSquare,
621:           expiresIn: duration > 0 ? duration : FALLBACK_CAST_COOLDOWN,
622:         };
623:       }
624: 
625:       // ExecuteSkill plays the skill's sound as the cast starts.
626:       const sfx = skillSound(def.num);
627:       if (sfx) playSfx(sfx, hero.transform.pos, { bus: COMBAT_BUS });
628: 
629:       cooldown = Math.max(
630:         duration > 0 ? duration : FALLBACK_CAST_COOLDOWN,
631:         serverMinAttackInterval(hero.attributeSystem?.getValue('attackSpeed') ?? 0)
632:       );
633: 
634:       if (def.type === 'SummonMonster') summonCast = true;
635: 
636:       if (def.type === 'SummonMonster' || !world.rightPointerPressed) {
637:         world.castRequest = null;
638:         castSent = null;
639:       } else {
640:         castSent = req;
641:       }
642:     },
643:   };
644: };
</file>

