138: export function closeDevilSquare(): void {
139:   runInAction(() => {
140:     state.open = false;
141:   });
142: }
143: 
144: /** `SendDevilSquareEnterRequest(m_iNumActiveBtn, 0xFF)`: grade is 0-based. */
145: export function enterDevilSquare(grade: number): void {
146:   if (grade !== state.active) return;
147:   const packet = DevilSquareEnterRequestPacket.createPacket();
148:   packet.SquareLevel = grade;
149:   packet.TicketItemInventoryIndex = NO_TICKET_SLOT;
150:   Store.sendToGS(packet.buffer);
151: }
152: 
153: /** Double-clicked Devil's Invitation: `SendMiniGameOpeningStateRequest(1, Level)`. */
154: function useTicket(_slot: number, item: Item): boolean {
155:   const t = TICKETS.devilInvitation;
156:   if (item.group !== t.group || item.num !== t.num) return false;
157: 
158:   noteOpeningStateRequest(OPENING_STATE_GAME.devilSquare);
159:   const packet = MiniGameOpeningStateRequestPacket.createPacket();
160:   packet.EventType = OPENING_STATE_GAME.devilSquare;
161:   packet.EventLevel = item.lvl ?? 0;
162:   Store.sendToGS(packet.buffer);
163:   return true;
