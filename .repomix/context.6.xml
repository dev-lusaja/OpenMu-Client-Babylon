  1: import { observable, runInAction } from 'mobx';
  2: import { EventBus } from '../libs/eventBus';
  3: import { Store } from '../store';
  4: import { t } from '../i18n';
  5: import { ItemGroup } from '../common/itemStats';
  6: import {
  7:   EventChipExitDialogPacket,
  8:   EventChipRegistrationRequestPacket,
  9: } from '../common/packets/ClientToServerPackets';
 10: import { EventChipRegistrationResultPacket } from '../common/packets/ServerToClientPackets';
 11: import type { EventLayer } from './layer';
 12: 
 13: /**
 14:  * Golden Archer (NPC 236): Rena registration (`CNewUIGoldBowmanLena`,
 15:  * NewUIGoldBowmanLena.cpp). Talking to the NPC makes OpenMU answer with
 16:  * `EventChipRegistrationResult` (no `NpcWindowResponse`): result 0 opens or
 17:  * refreshes the dialog, result 1 is "no Rena in the inventory"
 18:  * (ItemRegistrationResultPlugIn.cs / GoldenArcherWindowHandlerPlugIn.cs).
 19:  * The Register button sends `EventChipRegistrationRequest`; the server picks
 20:  * the Rena itself, pays the reward and answers with the updated counts.
 21:  * Closing sends `EventChipExitDialog`, which resets NpcDialogOpened.
 22:  */
 23: 
 24: /** Rena: items.json group 14, index 21 - what the register request points at. */
 25: const RENA = { group: ItemGroup.Potion, num: 21 } as const;
 26: 
 27: /** The reference sends type 0 for the Rena dialog (`SendEventChipRegistrationRequest(0, index)`). */
 28: const REGISTRATION_TYPE_RENA = 0;
 29: 
 30: /** Only `MissingItem` gets a distinct result byte; 0 is open/refresh. */
 31: const RESULT_MISSING_ITEM = 1;
 32: 
 33: const MESSAGE_MS = 5000;
 34: 
 35: // ---- state + readers --------------------------------------------------------
 36: 
 37: const state = observable(
 38:   {
 39:     open: false,
 40:     /** `RegisteredCount`: Rena turned in so far (server-side stat). */
 41:     registered: 0,
 42:     /** `RemainingInventoryCount`: Rena the server counted in the bag. */
 43:     remaining: 0,
 44:   },
 45:   {},
 46:   { deep: false }
 47: );
 48: 
 49: export function goldenArcherWindow(): {
 50:   open: boolean;
 51:   registered: number;
 52:   remaining: number;
 53: } {
 54:   return { open: state.open, registered: state.registered, remaining: state.remaining };
 55: }
 56: 
 57: // ---- commands ----------------------------------------------------------------
 58: 
 59: /** The Register button: point the server at the first Rena in the bag. */
 60: export function registerRena(): void {
 61:   if (!state.open || Store.isOffline) return;
 62: 
 63:   const slot = Store.playerData.items.findIndex(
 64:     item => item?.group === RENA.group && item?.num === RENA.num
 65:   );
 66:   if (slot < 0) {
 67:     Store.addNotification(t('goldenArcher.noRena'), 'error', MESSAGE_MS);
 68:     return;
 69:   }
 70: 
 71:   const packet = EventChipRegistrationRequestPacket.createPacket();
 72:   packet.Type = REGISTRATION_TYPE_RENA;
 73:   packet.ItemIndex = slot;
 74:   Store.sendToGS(packet.buffer);
 75: }
 76: 
 77: /**
 78:  * `ClosingProcess`: `SendEventChipExitDialog` - OpenMU keeps the character in
 79:  * NpcDialogOpened until it arrives. `notify` is false when the dialog is
 80:  * already gone server-side (map change, relog).
 81:  */
 82: export function closeGoldenArcher(notify = true): void {
 83:   if (!state.open) return;
 84:   if (notify && !Store.isOffline) {
 85:     Store.sendToGS(EventChipExitDialogPacket.createPacket().buffer);
 86:   }
 87:   runInAction(() => {
 88:     state.open = false;
 89:   });
 90: }
 91: 
 92: // ---- packets ------------------------------------------------------------------
 93: 
 94: /** `ReceiveEventChipInfomation` (0x94): open or refresh the dialog. */
 95: EventBus.on('EventChipRegistrationResult', packet => {
 96:   const p = new EventChipRegistrationResultPacket(packet);
 97: 
 98:   if (p.Result === RESULT_MISSING_ITEM) {
 99:     runInAction(() => {
100:       state.remaining = p.RemainingInventoryCount;
101:     });
102:     Store.addNotification(t('goldenArcher.noRena'), 'error', MESSAGE_MS);
103:     return;
104:   }
105: 
106:   Store.dropNpcTalk();
107:   runInAction(() => {
108:     state.registered = p.RegisteredCount;
109:     state.remaining = p.RemainingInventoryCount;
110:     state.open = true;
111:   });
112: });
113: 
114: // ---- the layer ------------------------------------------------------------------
115: 
116: export const goldenArcherLayer: EventLayer = {
117:   name: 'goldenArcher',
118:   // The warp already dropped the dialog server-side: close without the packet.
119:   reset: () => closeGoldenArcher(false),
120:   state: () => ({ open: state.open, running: false }),
121: };
</file>

