<file path="src/ecs/systems/emojiBubbleSystem.ts">
  1: import {
  2:   HEAD_ANCHOR_HEIGHT_RATIO,
  3:   SIDE_ANCHOR_DISTANCE,
  4:   SIDE_ANCHOR_HEIGHT_RATIO,
  5:   emojiBubbleById,
  6:   type EmojiBubbleId,
  7: } from '../../common/emojiBubbles';
  8: import type { Entity, ISystemFactory, World } from '../world';
  9: 
 10: /**
 11:  * Owns the lifetime of every emoji bubble and its world anchor.
 12:  *
 13:  * The side anchor has to sit on whichever shoulder currently points at the
 14:  * camera and swap across when the character turns around. The character's
 15:  * side axis is the local +X of its rendered node: `RenderSystem` gives the
 16:  * node a Y rotation of `2π − yaw` (`toRenderAngles`), and Babylon's
 17:  * left-handed `RotationY(θ)` sends local +X to `(cos θ, 0, −sin θ)`, so with
 18:  * θ = 2π − yaw that axis is `(cos yaw, 0, sin yaw)`.
 19:  *
 20:  * Which of the two shoulders is "facing the camera" is then just the sign
 21:  * that puts the anchor on the camera's side of the spine - so the anatomical
 22:  * polarity of the axis never has to be worked out, and the same code is
 23:  * correct for players, NPCs and monsters alike.
 24:  *
 25:  * This runs before `CalculateScreenPositionSystem`, which projects `anchor`
 26:  * with the same view-projection it uses for the name balloons.
 27:  */
 28: 
 29: /** Bubbles never outlive this, whatever a definition asks for. */
 30: const MAX_LIFE = 10;
 31: 
 32: let serial = 0;
 33: 
 34: export function startEmojiBubble(
 35:   world: World,
 36:   entity: Entity,
 37:   id: EmojiBubbleId
 38: ): void {
 39:   const def = emojiBubbleById(id);
 40:   const duration = Math.min(def.duration, MAX_LIFE);
 41: 
 42:   // Replace rather than mutate in place: the overlay keys its element off the
 43:   // component's presence and serial, so a re-trigger has to look like a fresh
 44:   // component for the glyph to change and the pop-in to replay.
 45:   if (entity.emojiBubble) world.removeComponent(entity, 'emojiBubble');
 46: 
 47:   world.addComponent(entity, 'emojiBubble', {
 48:     id,
 49:     life: duration,
 50:     duration,
 51:     serial: ++serial,
 52:     isSide: def.placement === 'side',
 53:     anchor: { x: 0, y: 0, z: 0 },
 54:     screenX: 0,
 55:     screenY: 0,
 56:     onScreen: false,
 57:   });
 58: }
 59: 
 60: export const EmojiBubbleSystem: ISystemFactory = world => {
 61:   const query = world.with('emojiBubble', 'transform');
 62: 
 63:   const expired: Entity[] = [];
 64: 
 65:   return {
 66:     update: dt => {
 67:       const request = world.emojiRequest;
 68: 
 69:       if (request) {
 70:         world.emojiRequest = null;
 71: 
 72:         const hero = world.playerEntity;
 73:         if (hero) startEmojiBubble(world, hero, request);
 74:       }
 75: 
 76:       const camera = world.scene.activeCamera;
 77:       const camPos = camera?.globalPosition;
 78: 
 79:       expired.length = 0;
 80: 
 81:       for (const entity of query) {
 82:         const bubble = entity.emojiBubble;
 83: 
 84:         bubble.life -= dt;
 85: 
 86:         if (bubble.life <= 0) {
 87:           expired.push(entity);
 88:           continue;
 89:         }
 90: 
 91:         const { transform } = entity;
 92:         const offset = transform.posOffset;
 93: 
 94:         const baseX = transform.pos.x + (offset?.x ?? 0);
 95:         const baseY = transform.pos.y + (offset?.y ?? 0);
 96:         const baseZ = transform.pos.z + (offset?.z ?? 0);
 97: 
 98:         const balloonHeight = entity.screenPosition?.worldOffsetZ ?? 0;
 99: 
100:         if (!bubble.isSide) {
101:           bubble.anchor.x = baseX;
102:           bubble.anchor.y = baseY + balloonHeight * HEAD_ANCHOR_HEIGHT_RATIO;
103:           bubble.anchor.z = baseZ;
104:           continue;
105:         }
106: 
107:         // Horizontal axis perpendicular to the character's facing.
108:         const yaw = transform.visualRotY ?? transform.rot.y;
109:         let sideX = Math.cos(yaw);
110:         let sideZ = Math.sin(yaw);
111: 
112:         // Flip to the shoulder on the camera's side of the spine.
113:         if (camPos) {
114:           const toCameraX = camPos.x - baseX;
115:           const toCameraZ = camPos.z - baseZ;
116: 
117:           if (sideX * toCameraX + sideZ * toCameraZ < 0) {
118:             sideX = -sideX;
119:             sideZ = -sideZ;
120:           }
121:         }
122: 
123:         const reach = SIDE_ANCHOR_DISTANCE * (transform.scale || 1);
124: 
125:         bubble.anchor.x = baseX + sideX * reach;
126:         bubble.anchor.y = baseY + balloonHeight * SIDE_ANCHOR_HEIGHT_RATIO;
127:         bubble.anchor.z = baseZ + sideZ * reach;
128:       }
129: 
130:       for (const entity of expired) {
131:         world.removeComponent(entity, 'emojiBubble');
132:       }
133:     },
134:   };
135: };
</file>

