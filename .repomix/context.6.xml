  5: import { loadGLTF } from '../../common/modelLoader';
  6: import { ModelObject } from '../../common/modelObject';
  7: import type { PlayerAction } from '../../common/objects/enum';
  8: import { isStandingIdle } from '../../common/playerActionMapper';
  9: import type { PlayerObject } from '../../common/playerObject';
 10: import {
 11:   performanceEnded,
 12:   refused,
 13:   takenOut,
 14: } from '../../common/band';
 15: import { instrumentClip } from '../../common/band/instrumentClip';
 16: import { startPerforming, stopPerforming } from '../../common/band/performing';
 17: import { audioNow, dropPerformer, setPerformerPosition } from '../../sound/instruments';
 18: import { effects } from '../../effects';
 19: import { playUiSound } from '../../libs/sfx';
 20: import type { Entity, ISystemFactory } from '../world';
 21: 
 22: /**
 23:  * Performers: the hero with an instrument out, and every player in scope the
 24:  * proxy says is playing. Gives them the row's pose - a few frames copied out
 25:  * of an emote, looped (`band/instrumentClip.ts`) - hangs the model on the
 26:  * hand bone, and ends the performance the moment they step, get hit into
 27:  * another clip, or die.
 28:  *
 29:  * Before `AnimationSystem`, like `EmoteSystem`: it writes
 30:  * `playerAnimation.action`, and the animation pass plays it like any clip.
 31:  */
 32: 
 33: // ---- 1. tuning -------------------------------------------------------------
 34: 
 35: /**
 36:  * Play rate of the copied clip. `speedRatioFor` is `AnimationSpeed x 25 / 24`
 37:  * for a clip the loader never timed (the copy is appended after `load`), so
 38:  * this is the value that plays one of its frames per frame - the pace
 39:  * `instrumentClip` writes the sway at.
 40:  */
 41: const CLIP_SPEED = 24 / 25;
 42: 
 43: /** Seconds between two notes shown for one performer: a chord is one note, not six. */
 44: const NOTE_GAP = 0.09;
 45: 
 46: /** Tiles above the instrument's origin (the hand) a note is born. */
 47: const NOTE_HEIGHT = 0.15;
 48: 
 49: /** Dev seams: `?instRot=x,y,z` / `?instOff=x,y,z` (BMD deg / cm). */
 50: const rotDev = devQueryNumbers('instRot', 3);
 51: const offDev = devQueryNumbers('instOff', 3);
 52: /** `?band=<id>`: the offline scene takes the instrument out by itself. */
 53: const bandDev = devQuery('band');
 54: 
 55: // ---- 2. the system ---------------------------------------------------------
 56: 
 57: /** A live-tuned link (dev only), used for the hero's next attach. */
 58: let linkOverride: { angle: [number, number, number]; offset: [number, number, number] } | null = null;
 59: 
 60: /** A live-tuned frame window (dev only) for the hero's clip. */
 61: let poseOverride: { from: number; to: number; sway: number } | null = null;
 62: 
 63: /** Audio time of the last note each performer showed. */
 64: const lastNoteAt = new WeakMap<Entity, number>();
 65: const noteAt = new Vector3();
 66: 
 67: export const BandSystem: ISystemFactory = world => {
 68:   const performers = world.with('performing', 'modelObject', 'transform', 'playerAnimation');
 69: 
 70:   function keyOf(e: Entity): string {
 71:     return e.performing?.local ? 'hero' : `net:${e.netId ?? -1}`;
 72:   }
 73: 
 74:   function attachModel(e: Entity): void {
 75:     const p = e.performing;
 76:     const player = e.modelObject as PlayerObject | undefined;
 77:     if (!p || !player?.node) return;
 78:     const def = instrumentById(p.instrument);
 79:     const model = new ModelObject(world.scene, player.node);
 80:     model.NodeNamePrefix = 'Instrument_';
 81:     model.setParent(player);
 82:     model.LinkParent = false;
 83:     model.SkipBoundingBox = true;
 84:     model.CurrentAction = -1;
 85:     const live = p.local ? linkOverride : null;
 86:     model.setBoneLink(
 87:       def.bone,
 88:       angleLinkMatrix({
 89:         angle: live?.angle ?? (rotDev as [number, number, number] | null) ?? def.link.angle,
 90:         offset: live?.offset ?? (offDev as [number, number, number] | null) ?? def.link.offset,
 91:       })
 92:     );
 93:     p.model = model;
 94: 
 95:     const seq = ++model.loadSeq;
 96:     void loadGLTF(def.model, world).then(gltf => {
 97:       if (seq !== model.loadSeq || e.performing?.model !== model) return;
 98:       model.load(gltf);
 99:       for (const mesh of model.getMeshes(true)) {
100:         mesh.isPickable = false;
101:         mesh.metadata ??= {};
102:         mesh.metadata.timeOffset = 0;
103:       }
104:     });
105:   }
106: 
107:   function detachModel(e: Entity, model: ModelObject | null): void {
108:     if (!model) return;
109:     model.loadSeq++;
110:     const player = e.modelObject;
111:     if (player) {
112:       const i = player.Children.indexOf(model);
113:       if (i >= 0) player.Children.splice(i, 1);
114:     }
115:     model.dispose();
116:   }
117: 
118:   performers.onEntityRemoved.subscribe(e => {
119:     // miniplex hands the entity over while the component is still on it.
120:     const p = e.performing;
121:     detachModel(e, p?.model ?? null);
122:     if (p) p.model = null;
123:     dropPerformer(keyOf(e));
124:   });
125: 
126:   /** The copied clip for this performer's model, made on first use; -1 until the model is in. */
127:   function ensureClip(e: Entity): number {
128:     const p = e.performing;
129:     const model = e.modelObject;
130:     if (!p || !model?.gltf) return -1;
131:     // A reloaded rig has no copy yet: its table ends where the source's did.
132:     if (p.clip >= 0 && model.gltf.animationGroups[p.clip]) return p.clip;
133:     const def = instrumentById(p.instrument);
134:     const window = p.local && poseOverride ? poseOverride : def.pose;
135:     const clip = instrumentClip(model, p.source, window.from, window.to, window.sway);
136:     if (clip === null) return -1;
137:     model.setActionSpeed(clip, CLIP_SPEED);
138:     p.clip = clip;
139:     return clip;
140:   }
141: 
142:   function handleRequest(): void {
143:     const request = world.bandRequest;
144:     if (!request) return;
145:     world.bandRequest = null;
146: 
147:     const hero = world.playerEntity;
148:     if (!hero) return;
149: 
150:     if (request.kind === 'putAway') {
151:       if (hero.performing) {
152:         stopPerforming(world, hero);
153:         performanceEnded();
154:       }
155:       return;
156:     }
157: 
158:     const velocity = hero.movement?.velocity;
159:     const moving = !!velocity && (velocity.x !== 0 || velocity.y !== 0);
160:     const idle = isStandingIdle(hero.playerAnimation.action) || !!hero.performing;
161:     if (hero.dying || moving || !idle) {
162:       playUiSound('error');
163:       refused('instrument.needStanding');
164:       return;
165:     }
166: 
167:     startPerforming(world, hero, request.instrument, true);
168:     takenOut(request.instrument);
169:   }
170: 
171:   let devTakeOut = bandDev && isInstrumentId(bandDev) ? bandDev : null;
172: 
173:   // Dev hooks for tuning a row live: `__bandLink([ax,ay,az],[ox,oy,oz])`
174:   // rebuilds the hero's instrument on the bone with that link;
175:   // `__bandPose(from, to, sway)` recuts the hero's clip from that window (0..1).
176:   if (import.meta.env.DEV && typeof window !== 'undefined') {
177:     const w = window as unknown as { __bandLink: unknown; __bandPose: unknown };
178:     w.__bandLink = (angle: [number, number, number], offset: [number, number, number]) => {
179:       const hero = world.playerEntity;
180:       const p = hero?.performing;
181:       if (!hero || !p) return false;
182:       linkOverride = { angle, offset };
183:       detachModel(hero, p.model);
184:       p.model = null;
185:       return true;
186:     };
187:     w.__bandPose = (from: number, to: number, sway = 1) => {
188:       const hero = world.playerEntity;
189:       const p = hero?.performing;
190:       if (!hero || !p) return false;
191:       poseOverride = { from, to, sway };
192:       p.clip = -1;
193:       return true;
194:     };
195:   }
196: 
197:   return {
198:     update: dt => {
199:       if (devTakeOut && world.playerEntity?.modelObject?.gltf) {
200:         world.bandRequest = { kind: 'takeOut', instrument: devTakeOut };
201:         devTakeOut = null;
202:       }
203: 
204:       handleRequest();
205: 
206:       const now = audioNow();
207:       for (const e of performers) {
208:         const p = e.performing;
209:         const velocity = e.movement?.velocity;
210:         const moving = !!velocity && (velocity.x !== 0 || velocity.y !== 0);
211:         const fresh = p.clip < 0;
212:         const clip = ensureClip(e);
213:         // The clip is taken the frame it is cut, so the takeover check below
214:         // never sees the idle it replaces.
215:         if (fresh && clip >= 0) e.playerAnimation.action = clip as PlayerAction;
216: 
217:         if (moving || e.dying || (p.local && clip >= 0 && e.playerAnimation.action !== clip)) {
218:           // A step, death, or - for the hero - an attack or skill that took
219:           // the clip: the performance is over. A remote performer's clip is
220:           // ours to hold; their own client sends the stop.
221:           stopPerforming(world, e);
222:           if (p.local) performanceEnded();
223:           continue;
224:         }
225: 
226:         if (clip >= 0) e.playerAnimation.action = clip as PlayerAction;
227: 
228:         // Every hit whose time has come floats a note up from the instrument
229:         // (effects/bandNotes.ts); the pose itself only sways. A chord's notes
230:         // land together, and one of them is the strum.
231:         const hits = p.hits;
232:         while (hits.length && hits[0].when <= now + dt) {
233:           const hit = hits.shift()!;
234:           const node = p.model?.node;
235:           if (!node || now - (lastNoteAt.get(e) ?? -Infinity) < NOTE_GAP) continue;
236:           lastNoteAt.set(e, now);
237:           noteAt.copyFrom(node.getAbsolutePosition());
238:           noteAt.y += NOTE_HEIGHT;
239:           effects.spawn('bandNotes', world.scene, noteAt, { pitch: hit.note, velocity: hit.velocity });
240:         }
241: 
242:         setPerformerPosition(keyOf(e), e.transform.pos.x, e.transform.pos.z, p.local);
243: 
244:         if (!p.model && e.modelObject.gltf?.skeleton) attachModel(e);
245:       }
246:     },
247:   };
248: };
