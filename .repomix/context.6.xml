<file path="src/ecs/systems/targetCycleSystem.ts">
 1: import { EventBus } from '../../libs/eventBus';
 2: import { isKey } from '../../common/keyBindings';
 3: import { isAttackableEntity } from './attackSystem';
 4: import type { Entity, ISystemFactory } from '../world';
 5: 
 6: /**
 7:  * Keyboard targeting: one key walks the monsters in range, nearest first,
 8:  * and hands the pick to `world.attackTarget` - the same field a click on a
 9:  * monster sets, so everything downstream (the approach walk, the swing
10:  * loop, the target health bar, the pet's attack command) behaves exactly as
11:  * it does for a clicked target, including staying on it until it dies.
12:  *
13:  * No original analog: the C++ client is mouse-only. It is a hot key like
14:  * any other, so a player who never binds it never notices.
15:  */
16: 
17: /** Tiles: a little past the longest bow, so a picked target is worth walking to. */
18: const TARGET_RANGE = 10;
19: 
20: /** How long a pick stays "the one we are cycling from", in seconds. */
21: const CYCLE_MEMORY = 4;
22: 
23: function tileDistance(a: Entity, b: Entity): number {
24:   const ax = ~~a.transform!.pos.x;
25:   const az = ~~a.transform!.pos.z;
26:   const bx = ~~b.transform!.pos.x;
27:   const bz = ~~b.transform!.pos.z;
28:   return Math.max(Math.abs(ax - bx), Math.abs(az - bz));
29: }
30: 
31: export const TargetCycleSystem: ISystemFactory = world => {
32:   let sinceCycle = CYCLE_MEMORY;
33: 
34:   const candidates = (hero: Entity): Entity[] => {
35:     const list: Entity[] = [];
36:     for (const e of world.netObjsQuery.entities) {
37:       if (!e.transform || !isAttackableEntity(world, e)) continue;
38:       if (tileDistance(hero, e) > TARGET_RANGE) continue;
39:       list.push(e);
40:     }
41:     // Nearest first, then by net id so the walk order is stable while the
42:     // monsters shuffle around at the same distance.
43:     return list.sort(
44:       (a, b) => tileDistance(hero, a) - tileDistance(hero, b) || a.netId! - b.netId!
45:     );
46:   };
47: 
48:   EventBus.on('keyPressed', code => {
49:     if (!isKey('targetNearest', code)) return;
50: 
51:     const hero = world.playerEntity;
52:     if (!hero || hero.dying) return;
53: 
54:     const list = candidates(hero);
55:     if (list.length === 0) {
56:       world.attackTarget = null;
57:       return;
58:     }
59: 
60:     // A fresh press after the memory ran out starts again at the nearest;
61:     // a press while the current pick is still current takes the next one.
62:     const current = sinceCycle < CYCLE_MEMORY ? world.attackTarget : null;
63:     const at = current ? list.indexOf(current) : -1;
64:     world.attackTarget = list[(at + 1) % list.length];
65:     sinceCycle = 0;
66:   });
67: 
68:   return {
69:     update: dt => {
70:       sinceCycle += dt;
71:     },
72:   };
73: };
</file>

<file path="src/ecs/systems/terrainGrassSystem.ts">
 1: import type { ArcRotateCamera } from '../../libs/babylon/exports';
 2: import { grassFieldForFrame, type GrassActor } from '../../libs/mu/terrainGrass';
 3: import type { Entity, ISystemFactory } from '../world';
 4: 
 5: /**
 6:  * Residency for the grass field, and who is standing in it.
 7:  *
 8:  * The field owns every blade mesh (`terrainGrass.ts`); this owns the answers
 9:  * to "which blocks should exist right now" and "who is in the grass", which
10:  * are per-frame questions about the world and therefore ECS ones. Two jobs,
11:  * two modules: the system never touches geometry and the field never reads
12:  * the world.
13:  *
14:  * The work per frame is one block build at most, so a warp streams its grass
15:  * in over the following second or so rather than spending a frame on the
16:  * whole ring - the frame a warp lands on being the one that can least afford
17:  * it.
18:  */
19: export const TerrainGrassSystem: ISystemFactory = world => {
20:   /**
21:    * Who can be in the grass, and nothing else.
22:    *
23:    * This was `world.with('transform')` - every entity that has a position.
24:    * On Lorencia that is 2875 of them, 412 within actor range, and 406 of
25:    * those were static map props: rocks, barrels, fence posts. The press
26:    * budget is four, so it went to the hero and three pieces of scenery, and
27:    * because the nearest rock changes as the hero walks, each new one stamped
28:    * a fresh full-life press that evicted the hero's fading breadcrumbs. Two
29:    * symptoms, one cause: grass lying flat under nothing visible, and no body
30:    * ever leaving a path. The ambient birds were in there too, pushing the
31:    * field aside from six tiles up.
32:    *
33:    * A creature is one the server names (`netId`), the local hero, one of the
34:    * offline maps' own NPCs, or a pet. Nothing else has feet. Four buckets
35:    * rather than one query filtered per frame: miniplex maintains these
36:    * incrementally, so the cost is the handful of bodies on the map and not a
37:    * sweep of every prop on it.
38:    */
39:   const groups = [
40:     world.with('transform', 'netId'),
41:     world.with('transform', 'localPlayer'),
42:     world.with('transform', 'npcType'),
43:     world.with('transform', 'petActor'),
44:   ];
45: 
46:   const actors: GrassActor[] = [];
47:   // A server NPC carries both a `netId` and an `npcType`, so the buckets do
48:   // overlap. Reused across frames rather than allocated per frame.
49:   const seen = new Set<Entity>();
50: 
51:   return {
52:     update(deltaTime) {
53:       const field = grassFieldForFrame();
54: 
55:       if (!field) return;
56: 
57:       // The camera, not the hero: the grass has to be dense where it is being
58:       // looked at, and those part company as soon as the camera is rotated or
59:       // pulled back.
60:       const camera = world.scene.activeCamera as ArcRotateCamera | null;
61:       const target = camera?.target;
62: 
63:       if (!target) return;
64: 
65:       field.setCenter(target.x, target.z);
66: 
67:       actors.length = 0;
68:       seen.clear();
69: 
70:       for (const group of groups) {
71:         for (const e of group) {
72:           const p = e.transform.pos;
73: 
74:           // Cheap reject before anything else: the field only cares about
75:           // what is close enough to touch a blade.
76:           if (Math.abs(p.x - target.x) > ACTOR_RANGE) continue;
77:           if (Math.abs(p.z - target.z) > ACTOR_RANGE) continue;
78:           if (seen.has(e)) continue;
79: 
80:           seen.add(e);
81:           actors.push({ x: p.x, y: p.y, z: p.z });
82:         }
83:       }
84: 
85:       field.setActors(actors, deltaTime);
86:       field.step();
87:     },
88:   };
89: };
90: 
91: /** Tiles from the camera centre past which a body cannot be in shot's grass. */
92: const ACTOR_RANGE = 24;
</file>

