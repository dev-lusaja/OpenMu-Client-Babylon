202:       text = EVENT_TEXT.levelTooHigh;
203:       break;
204:     case DevilSquareEnterResultEnterResultEnum.CharacterLevelTooLow:
205:       text = EVENT_TEXT.levelTooLow;
206:       break;
207:     case DevilSquareEnterResultEnterResultEnum.Full:
208:       text = EVENT_TEXT.devilFull;
209:       break;
210:     default:
211:       // 6 in the original's switch: killers.
212:       text = formatText(EVENT_TEXT.killersRestricted, EVENT_TEXT.devilSquare);
213:       break;
214:   }
215:   if (text) Store.addNotification(text, 'error', MESSAGE_MS);
216: });
