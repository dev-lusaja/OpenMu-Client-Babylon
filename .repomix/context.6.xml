404: /**
405:  * A pooled card. `group` is the rendering group it draws in: the effects
406:  * group by default, group 0 for a card that is a solid object rather than a
407:  * glow - an alpha-tested one belongs with the world, where it writes depth
408:  * and lands in the G-buffer, which is what puts an ink line around it.
409:  * Always set, never only on creation: the pool is shared.
410:  */
411: export function acquireCard(
412:   scene: Scene,
413:   material: StandardMaterial,
414:   billboard = true,
415:   group = EFFECT_RENDERING_GROUP
416: ): Card {
417:   let pool = cardPool.get(scene);
418:   if (!pool) {
419:     pool = [];
420:     cardPool.set(scene, pool);
421:   }
422:   let card = pool.pop();
423:   if (!card) {
424:     card = CreatePlane(`fxCard${cardSeq++}`, { size: 1, updatable: true }, scene);
425:     card.isPickable = false;
426:     card.alwaysSelectAsActiveMesh = true;
427:     card.receiveShadows = false;
428:     card.doNotSyncBoundingInfo = true;
429:     keepDepthForEffects(scene);
430:     // Not the item halo layer: it draws every active mesh and a card carries
431:     // no tier, so it would cost a draw to contribute nothing. The card's own
432:     // halo is the effects layer's (glow.ts).
433:     (scene as TestScene).look?.glow.addExcludedMesh(card);
434:   }
435:   card.material = material;
436:   card.renderingGroupId = group;
437:   // A card in the world's group is matter: it goes into the G-buffer, so the
438:   // haze and the AO read its own depth rather than whatever stands behind it
439:   // (which washed a note out to the colour of the distance), and the ink pass
440:   // has an edge to draw. An effect card stays out of it - it is light.
441:   card.metadata ??= {};
442:   card.metadata.depthOccluder = group === 0;
443:   // ... which needs its bounds to be real: the G-buffer's own reach test
444:   // measures from the bounding sphere, and a pooled card never syncs one, so
445:   // it reads as a card at the map's origin and is dropped every frame.
446:   card.doNotSyncBoundingInfo = group !== 0;
447:   card.billboardMode = billboard ? Mesh.BILLBOARDMODE_ALL : Mesh.BILLBOARDMODE_NONE;
448:   card.rotationQuaternion = null;
449:   card.rotation.setAll(0);
450:   card.scaling.setAll(1);
451:   card.visibility = 1;
452:   card.setEnabled(true);
453:   // Emissive art is light and blooms; a RENDER_DARK card removes light and a
454:   // halo would add back what it just took.
455:   if (material.alphaMode === ADDITIVE_ALPHA_MODE) addEffectGlow(scene, card);
456:   else dropEffectGlow(card);
457:   return card;
458: }
459: 
460: export function releaseCard(scene: Scene, card: Card): void {
461:   card.setEnabled(false);
462:   card.parent = null;
463:   dropEffectGlow(card);
464:   if (card.metadata?.cellUvs) {
465:     card.updateVerticesData(VertexBuffer.UVKind, WHOLE_SHEET_UVS);
466:     card.metadata.cellUvs = false;
467:   }
468:   cardPool.get(scene)?.push(card);
469: }
470: 
471: /**
472:  * Point a card's UVs at cell `frame` of its material's sheet - row-major from
473:  * the top-left, like the original's `Frame % 4`, `Frame / 4`. The columns
474:  * come from the loaded sheet's size, so this returns false (and leaves the
475:  * card alone) until the texture is ready; call it again next frame.
476:  */
477: export function setCardCell(card: Card, cells: SheetCells, frame: number): boolean {
478:   const tex = (card.material as StandardMaterial | null)?.diffuseTexture;
479:   if (!tex?.isReady()) return false;
480:   const size = tex.getBaseSize();
481:   if (!size.width || !size.height) return false;
482:   const cols = Math.max(1, Math.floor(size.width / cells.w));
483:   const rows = Math.max(1, Math.floor(size.height / cells.h));
484:   const col = frame % cols;
485:   const row = Math.floor(frame / cols);
486:   const u0 = col / cols + CELL_INSET;
487:   const u1 = (col + 1) / cols - CELL_INSET;
488:   // Effect textures load with invertY, so v = 0 is the sheet's bottom edge.
489:   const v1 = 1 - row / rows - CELL_INSET;
490:   const v0 = 1 - (row + 1) / rows + CELL_INSET;
491:   card.updateVerticesData(VertexBuffer.UVKind, [u0, v0, u1, v0, u1, v1, u0, v1]);
492:   card.metadata ??= {};
493:   card.metadata.cellUvs = true;
494:   return true;
495: }
496: 
497: /* -------------------------------------------------------------- particles */
498: 
499: export interface ParticleRecipe {
500:   texture: string;
501:   colour: RGB;
502:   /** Colour the particle dies to (default: same hue, faded). */
503:   colourEnd?: RGB;
504:   /** Card edge in tiles. */
505:   size: number;
506:   sizeJitter?: number;
507:   /** Seconds. */
508:   life: number;
509:   lifeJitter?: number;
510:   /** Emit box half extents around the emitter (tiles). */
511:   box?: readonly [number, number, number];
512:   /** Direction range. */
513:   dir1?: readonly [number, number, number];
514:   dir2?: readonly [number, number, number];
515:   /** Tiles per second. */
516:   power?: number;
517:   powerJitter?: number;
518:   /** Tiles per second squared, +up. */
519:   gravity?: number;
520:   /** Radians per second, ± */
521:   spin?: number;
522:   /** Animation-sheet cells when the texture is a strip. */
523:   cells?: { w: number; h: number; count: number };
524:   /** Size factor at death (1 = constant). */
525:   endScale?: number;
526:   capacity?: number;
527:   /** Additive (MU default) or standard alpha (smoke). */
528:   blend?: 'add' | 'alpha';
529: }
530: 
531: const systems = new Map<Scene, Map<string, ParticleSystem>>();
532: /** Recipe identity → system, so a table row's burst never re-stringifies its recipe; a flame's system is keyed with its gain. */
533: const systemsByRecipe = new Map<Scene, WeakMap<ParticleRecipe, { ps: ParticleSystem; gain: number }>>();
534: 
535: /**
536:  * Where the next manually emitted particles start. `emitBurst` / `Emitter`
537:  * used to write `ps.emitter` and bump `manualEmitCount`: two spawns of one
538:  * recipe in the same frame (a hit's sparks and its blood, three arrows'
539:  * trails, every `scatter(every = 0)`) left only the last position, and the
540:  * whole frame's particles came out of it . The emissions
541:  * of a frame now queue their positions and `startPositionFunction` hands
542:  * them out in order as the system flushes `manualEmitCount`.
543:  */
544: interface PendingEmit {
545:   x: number;
546:   y: number;
547:   z: number;
548:   n: number;
549: }
550: interface EmitQueue {
551:   q: PendingEmit[];
552:   head: number;
553:   len: number;
554: }
555: const emitQueues = new WeakMap<ParticleSystem, EmitQueue>();
556: 
557: function queueEmit(ps: ParticleSystem, at: Vector3, n: number): void {
558:   let s = emitQueues.get(ps);
559:   if (!s) {
560:     s = { q: [], head: 0, len: 0 };
561:     emitQueues.set(ps, s);
562:   }
563:   // Babylon zeroes `manualEmitCount` when it flushes; nothing pending means
564:   // last frame's queue is spent (or was dropped at capacity) - start over.
565:   if (ps.manualEmitCount <= 0) {
566:     s.head = 0;
567:     s.len = 0;
568:   }
569:   let p = s.q[s.len];
570:   if (!p) {
571:     p = { x: 0, y: 0, z: 0, n: 0 };
572:     s.q.push(p);
573:   }
574:   p.x = at.x;
575:   p.y = at.y;
576:   p.z = at.z;
577:   p.n = n;
578:   s.len++;
579:   (ps.emitter as Vector3).copyFrom(at);
580:   ps.manualEmitCount = Math.max(ps.manualEmitCount, 0) + n;
581: }
582: 
583: function nextStartPosition(ps: ParticleSystem, out: Vector3): void {
584:   const s = emitQueues.get(ps);
585:   const min = ps.minEmitBox;
586:   const max = ps.maxEmitBox;
587:   let x: number;
588:   let y: number;
589:   let z: number;
590:   if (s && s.head < s.len) {
591:     const p = s.q[s.head];
592:     if (--p.n <= 0) s.head++;
593:     x = p.x;
594:     y = p.y;
595:     z = p.z;
596:   } else {
597:     const e = ps.emitter as Vector3;
598:     x = e.x;
599:     y = e.y;
600:     z = e.z;
601:   }
602:   out.set(
603:     x + lerp(min.x, max.x, Math.random()),
604:     y + lerp(min.y, max.y, Math.random()),
605:     z + lerp(min.z, max.z, Math.random())
606:   );
607: }
608: 
609: export function particleSystemFor(scene: Scene, r: ParticleRecipe): ParticleSystem {
610:   let byRecipe = systemsByRecipe.get(scene);
611:   if (!byRecipe) {
612:     byRecipe = new WeakMap();
613:     systemsByRecipe.set(scene, byRecipe);
614:   }
615:   const gain = r.blend === 'alpha' ? 1 : lightCardGain(scene);
616:   const known = byRecipe.get(r);
617:   if (known && known.gain === gain) return known.ps;
618: 
619:   let map = systems.get(scene);
620:   if (!map) {
621:     map = new Map();
622:     systems.set(scene, map);
623:   }
624:   // An inline `{ ...recipe }` spread is a new identity with an old shape.
625:   const k = gain === 1 ? JSON.stringify(r) : `${JSON.stringify(r)}|g${gain.toFixed(3)}`;
626:   let ps = map.get(k);
627:   if (ps) {
628:     byRecipe.set(r, { ps, gain });
629:     return ps;
630:   }
631: 
632:   ps = new ParticleSystem(`fx:${r.texture}`, r.capacity ?? 256, scene);
633:   ps.emitter = Vector3.Zero();
634:   ps.isLocal = false;
635:   ps.forceDepthWrite = false;
636:   ps.renderingGroupId = EFFECT_RENDERING_GROUP;
637:   keepDepthForEffects(scene);
638:   // BLENDMODE_ADD is (SRC_ALPHA, ONE): the colour × alpha is added, so the
639:   // gradients below fade a sprite toward black under it.
640:   ps.blendMode =
641:     r.blend === 'alpha' ? ParticleSystem.BLENDMODE_STANDARD : ParticleSystem.BLENDMODE_ADD;
642: 
643:   // The fade: an additive sprite dies by its colour going to black (the
644:   // original's `Light × LifeTime / n`), an alpha one by its alpha. The
645:   // start / mid / end keys carry the same 1 → 0.8 → 0 curve either way.
646:   const c = r.colour;
647:   const e = r.colourEnd ?? c;
648:   const key = (rgb: RGB, k: number): Color4 =>
649:     r.blend === 'alpha'
650:       ? new Color4(rgb[0], rgb[1], rgb[2], k)
651:       : new Color4(rgb[0] * k * gain, rgb[1] * k * gain, rgb[2] * k * gain, 1);
652:   const start = key(c, 1);
653:   ps.color1 = start;
654:   ps.color2 = start.scale(0.85);
655:   ps.colorDead = key(e, 0);
656:   ps.addColorGradient(0, start);
657:   ps.addColorGradient(0.6, key(e, 0.8));
658:   ps.addColorGradient(1, key(e, 0));
659: 
660:   const sj = r.sizeJitter ?? 0.25;
661:   ps.minSize = r.size * (1 - sj);
662:   ps.maxSize = r.size * (1 + sj);
663:   if (r.endScale !== undefined) {
664:     // A size gradient *replaces* minSize/maxSize (thinParticleSystem
665:     // `_createParticle`: `particle.size = gradient.getFactor()`), so the
666:     // keys must carry the real size range - `(0, 1) → (1, endScale)` was born
667:     // one tile wide and grew to `endScale` tiles.
668:     ps.addSizeGradient(0, ps.minSize, ps.maxSize);
669:     ps.addSizeGradient(1, ps.minSize * r.endScale, ps.maxSize * r.endScale);
670:   }
671:   const lj = r.lifeJitter ?? 0.3;
672:   ps.minLifeTime = r.life * (1 - lj);
673:   ps.maxLifeTime = r.life;
674: 
675:   const b = r.box ?? [0.05, 0.05, 0.05];
676:   ps.minEmitBox = new Vector3(-b[0], -b[1], -b[2]);
677:   ps.maxEmitBox = new Vector3(b[0], b[1], b[2]);
678:   const d1 = r.dir1 ?? [-1, -1, -1];
679:   const d2 = r.dir2 ?? [1, 1, 1];
680:   ps.direction1 = new Vector3(d1[0], d1[1], d1[2]);
681:   ps.direction2 = new Vector3(d2[0], d2[1], d2[2]);
682:   const p = r.power ?? 1;
683:   const pj = r.powerJitter ?? 0.4;
684:   ps.minEmitPower = p * (1 - pj);
685:   ps.maxEmitPower = p;
686:   ps.gravity = new Vector3(0, r.gravity ?? 0, 0);
687:   const spin = r.spin ?? 0;
688:   ps.minAngularSpeed = -spin;
689:   ps.maxAngularSpeed = spin;
690:   ps.minInitialRotation = 0;
691:   ps.maxInitialRotation = Math.PI * 2;
692: 
693:   if (r.cells) {
694:     ps.isAnimationSheetEnabled = true;
695:     ps.spriteCellWidth = r.cells.w;
696:     ps.spriteCellHeight = r.cells.h;
697:     ps.startSpriteCellID = 0;
698:     ps.endSpriteCellID = r.cells.count - 1;
699:     ps.spriteCellLoop = true;
700:     ps.spriteRandomStartCell = true;
701:   }
702: 
703:   ps.emitRate = 0;
704:   ps.manualEmitCount = 0;
705: 
706:   const created = ps;
707:   created.startPositionFunction = (_world, position) => nextStartPosition(created, position);
708:   void effectTexture(scene, r.texture).then(tex => {
709:     if (systems.get(scene)?.get(k) === created) created.particleTexture = tex;
710:   });
711: 
712:   ps.start();
713:   map.set(k, ps);
714:   byRecipe.set(r, { ps, gain });
715:   return ps;
716: }
717: 
718: /** One burst of `count` particles at `at`. */
719: export function emitBurst(scene: Scene, r: ParticleRecipe, at: Vector3, count: number): void {
720:   queueEmit(particleSystemFor(scene, r), at, count);
721: }
722: 
723: /**
724:  * A continuous emitter that follows a moving point for as long as the
725:  * caller drives it. Shares the recipe's system, so several trails of one
726:  * kind (three arrows, a volley) cost one draw.
727:  */
728: export class Emitter {
729:   #acc = 0;
730:   readonly #ps: ParticleSystem;
731:   constructor(scene: Scene, r: ParticleRecipe, readonly rate: number) {
732:     this.#ps = particleSystemFor(scene, r);
733:   }
734:   /** Emit `rate` particles per second at `at`; call every frame. */
735:   tick(at: Vector3, dt: number, rate = this.rate): void {
736:     this.#acc += rate * dt;
737:     const n = this.#acc | 0;
738:     if (n <= 0) return;
739:     this.#acc -= n;
740:     queueEmit(this.#ps, at, n);
741:   }
742: }
743: 
744: /* ------------------------------------------------------------------ clock */
745: 
746: /**
747:  * The effects clock: seconds of `effects.update` so far. Everything that
748:  * sequences a skill - a step after a delay, a point flying along the facing,
749:  * a ribbon spiralling up - reads this, never `performance.now()` or
750:  * `setTimeout`: it stops when the game does, and `effects.reset()` cancels
751:  * every pending step so a warp or a death mid-cast leaves nothing to land
752:  * on the next map .
753:  */
754: let clock = 0;
755: 
756: interface Timer extends LiveEffect {
757:   due: number;
758:   fn: () => void;
759: }
760: 
761: const timers = new LiveList();
762: 
763: /** Seconds on the effects clock. */
764: export function fxNow(): number {
765:   return clock;
766: }
767: 
768: /** Run `fn` once `seconds` of effects time have passed. `stop()` cancels it. */
769: export function delay(seconds: number, fn: () => void): EffectHandle {
770:   const timer: Timer = {
771:     due: clock + seconds,
772:     fn,
773:     update() {
774:       if (clock < this.due) return true;
775:       this.fn();
776:       return false;
777:     },
778:     release() {},
779:   };
780:   return timers.push(timer);
781: }
782: 
783: /** Advance the clock and fire what is due. The facade calls it before the layers step. */
784: export function stepClock(dt: number): void {
785:   clock += dt;
786:   timers.update(dt);
787: }
788: 
789: /** Drop every pending `delay`. The facade's reset. */
790: export function clearTimers(): void {
791:   timers.clear();
792: }
793: 
794: /* ------------------------------------------------------------------ reset */
795: 
796: /** Dispose every shared pool (materials, cards, particle systems). The facade's reset. */
797: export function disposePools(): void {
798:   // The halo draws the pooled meshes, so it goes with them.
799:   disposeEffectGlow();
800:   // Not the textures - a card's comes from loadEffectTexture's cache, a
801:   // skill mesh's from the GLB cache; both are shared with the map.
802:   for (const byKey of materials.values()) for (const m of byKey.values()) m.dispose(false, false);
803:   materials.clear();
804:   for (const pool of cardPool.values()) for (const c of pool) c.dispose(false, false);
805:   cardPool.clear();
806:   for (const map of systems.values()) for (const ps of map.values()) ps.dispose(false);
807:   systems.clear();
808:   systemsByRecipe.clear();
809: }
810: 
811: /* ------------------------------------------------------------------ misc */
812: 
813: export const tmpA = new Vector3();
814: export const tmpB = new Vector3();
815: export const tmpC = new Vector3();
816: 
817: export function lerp(a: number, b: number, t: number): number {
818:   return a + (b - a) * t;
819: }
820: 
821: export function clamp01(t: number): number {
822:   return t < 0 ? 0 : t > 1 ? 1 : t;
823: }
824: 
825: /** 1 → 0 over the last `tail` fraction of a 0…1 progress. */
826: export function fadeOut(progress: number, tail = 0.35): number {
827:   return clamp01((1 - progress) / tail);
828: }
829: 
830: /** Deterministic 0…1 noise per seed - jitter without `Math.random` churn. */
831: export function hash(n: number): number {
832:   const x = Math.sin(n * 127.1 + 311.7) * 43758.5453;
833:   return x - Math.floor(x);
834: }
835: 
836: export function scaleRGB(c: RGB, k: number): RGB {
837:   return [c[0] * k, c[1] * k, c[2] * k];
838: }
</file>

