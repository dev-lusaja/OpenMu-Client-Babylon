 1: import { describe, expect, it } from 'vitest';
 2: import { DuelStartResultDuelStartResultTypeEnum as DuelStartResult } from '../common/packets/ServerToClientPackets';
 3: import {
 4:   duelStartFailureKey,
 5:   orientPair,
 6:   orientValues,
 7:   presentSpectators,
 8:   roomCountOf,
 9: } from './duelRules';
10: 
11: describe('orientPair', () => {
12:   it('matches the stored order directly', () => {
13:     expect(orientPair(10, 20, 10, 20)).toBe('direct');
14:   });
15: 
16:   it('detects the swapped broadcast order', () => {
17:     expect(orientPair(10, 20, 20, 10)).toBe('swapped');
18:   });
19: 
20:   it('ignores a packet for another duel', () => {
21:     expect(orientPair(10, 20, 30, 40)).toBeNull();
22:   });
23: 
24:   it('masks the 0x8000 self bit on either side', () => {
25:     expect(orientPair(0x8000 | 10, 20, 10, 0x8000 | 20)).toBe('direct');
26:     expect(orientPair(10, 20, 0x8000 | 20, 10)).toBe('swapped');
27:   });
28: });
29: 
30: describe('orientValues', () => {
31:   it('keeps direct pairs and flips swapped ones', () => {
32:     expect(orientValues('direct', 1, 2)).toEqual([1, 2]);
33:     expect(orientValues('swapped', 1, 2)).toEqual([2, 1]);
34:   });
35: });
36: 
37: describe('roomCountOf', () => {
38:   it('reads 4 rooms out of the fixed 92-byte packet', () => {
39:     expect(roomCountOf(92)).toBe(4);
40:   });
41: 
42:   it('never goes negative on a short packet', () => {
43:     expect(roomCountOf(4)).toBe(0);
44:     expect(roomCountOf(0)).toBe(0);
45:   });
46: });
47: 
48: describe('presentSpectators', () => {
49:   it('drops empty and NUL-padded slots (OpenMU never fills Count)', () => {
50:     const slots = ['Alice\0\0\0', '', 'Bob', '\0\0', '  ', 'Cara'];
51:     expect(presentSpectators(slots)).toEqual(['Alice', 'Bob', 'Cara']);
52:   });
53: 
54:   it('caps at the 10 wire slots', () => {
55:     const slots = Array.from({ length: 12 }, (_, i) => `P${i}`);
56:     expect(presentSpectators(slots)).toHaveLength(10);
57:   });
58: });
59: 
60: describe('duelStartFailureKey', () => {
61:   it('is null on success', () => {
62:     expect(duelStartFailureKey(DuelStartResult.Success)).toBeNull();
63:   });
64: 
65:   it('maps the known failures', () => {
66:     expect(duelStartFailureKey(DuelStartResult.Refused)).toBe('duel.refused');
67:     expect(duelStartFailureKey(DuelStartResult.FailedByTooLowLevel)).toBe('duel.failedLevel');
68:     expect(duelStartFailureKey(DuelStartResult.FailedByNotEnoughMoney)).toBe('duel.failedZen');
69:     expect(duelStartFailureKey(DuelStartResult.FailedByNoFreeRoom)).toBe('duel.failedRoom');
70:   });
71: 
72:   it('falls back to the generic error for the rest', () => {
73:     expect(duelStartFailureKey(DuelStartResult.FailedByError)).toBe('duel.failedError');
74:     expect(duelStartFailureKey(DuelStartResult.FailedBy_)).toBe('duel.failedError');
75:   });
76: });
