 1: import { GreasedLineMaterialDefaults, type GreasedLineMesh } from '../libs/babylon/exports';
 2: 
 3: /**
 4:  * Releases a GreasedLine mesh's material **without** taking the shared
 5:  * empty-colours texture with it - the one place every ribbon (joint.ts) and
 6:  * crackle (itemCrackle.ts) goes through to drop its line.
 7:  *
 8:  * A GreasedLine material that carries no per-point colours - ours never do,
 9:  * the whole line is one `color` - is handed the process-wide singleton that
10:  * `GreasedLineTools.PrepareEmptyColorsTexture` caches in
11:  * `GreasedLineMaterialDefaults.EmptyColorsTexture`. That helper rebuilds the
12:  * texture only when its static is *null*, and
13:  * `GreasedLineSimpleMaterial.dispose()` disposes whatever sits in
14:  * `_colorsTexture` without ever nulling it. So the first line released
15:  * destroys that texture for **every** GreasedLine material in the game, the
16:  * ones already on screen included, for the rest of the session.
17:  *
18:  * The failure is completely silent. A material holding a disposed texture
19:  * never gets past the texture loop in `ShaderMaterial.isReady()`, so it never
20:  * builds an effect, and Babylon skips the mesh every frame while it still
21:  * reports `isEnabled`, `isVisible` and a live position - nothing renders and
22:  * nothing is logged. It looked like a teleport bug only because a warp always
23:  * releases *some* crackle (a player leaving scope, the wearer's lamp being
24:  * rebuilt for the new map); picking up a +9 drop does it just as well.
25:  *
26:  * The detach goes through the private `_colorsTexture` field on purpose. The
27:  * public `colorsTexture` setter of `GreasedLineSimpleMaterial` dereferences
28:  * the value it is given (`value.getSize()`), so `colorsTexture = null`
29:  * throws - and a throw out of an effect's release runs up through the ECS
30:  * update into Babylon's render loop, which never queues its next frame after
31:  * an exception: the picture freezes while the socket and the audio go on.
32:  * That was Drain Life's "hang": its tether is the Summoner's only untextured
33:  * ribbon, so 70 ticks after every cast the release threw. The plugin
34:  * variant of the material (textured ribbons) keeps `colorsTexture` as a
35:  * plain field that only ever holds a texture the material owns, resolving
36:  * the shared default at bind time instead, so it needs no detach.
37:  *
38:  * itemAura.ts carries the same trap for the shared flare01 texture, and solves
39:  * it the way Babylon allows there - `ps.dispose(false)`. `GreasedLineSimpleMaterial`
40:  * exposes no such flag, so the shared texture is taken off the material first.
41:  */
42: export function releaseGreasedLineMaterial(mesh: GreasedLineMesh): void {
43:   // Cast through `unknown`: `_colorsTexture` is private on the real class, so
44:   // an intersection with it collapses to `never`.
45:   const material = mesh.material as unknown as
46:     | { _colorsTexture?: unknown; dispose(): void }
47:     | null;
48: 
49:   if (!material) return;
50: 
51:   const shared: unknown = GreasedLineMaterialDefaults.EmptyColorsTexture;
52: 
53:   // Only ever detach the shared one: a material that owns its colours texture
54:   // must still take it with it.
55:   if (shared && material._colorsTexture === shared) {
56:     material._colorsTexture = null;
57:   }
58: 
59:   // `dispose()` without flags leaves the sheet textures alone - a textured
60:   // ribbon's sheet is loadEffectTexture's shared cache.
61:   material.dispose();
62: }
</file>

<file path="src/effects/index.ts">
 1: import type { ENUM_WORLD } from '../common/types';
 2: import type { Scene, Vector3 } from '../libs/babylon/exports';
 3: import type { EffectHandle, EffectLayer } from './layer';
 4: import { EFFECT_LAYERS } from './layers';
 5: import { clearTimers, disposePools, stepClock } from './core';
 6: 
 7: export type { EffectHandle, EffectLayer } from './layer';
 8: export { DEAD_HANDLE } from './layer';
 9: export { delay, fxNow } from './core';
10: 
11: /**
12:  * The effects layer: everything a skill, a packet or a buff draws in the
13:  * world for a while - bolts, columns, rings, trails, auras - behind one
14:  * object. Copy `_template.ts` when adding to it.
15:  *
16:  * The game talks to `effects.update` once a frame
17:  * (`ecs/systems/effectSystem.ts`) and `effects.reset` on a map change
18:  * (`libs/mu/loadMapIntoScene.ts`); both fan out over `EFFECT_LAYERS`
19:  * (`layers.ts`), the only list of entries. `spawn(name, …)` is the one
20:  * command: the name is an entry's `name`, the options its own type.
21:  *
22:  * `common/skillVisuals.ts` is the consumer that maps skill ids and buff ids
23:  * to spawns; this facade holds no state of its own.
24:  */
25: 
26: type Layers = (typeof EFFECT_LAYERS)[number];
27: 
28: /** Every entry name, from the list. */
29: export type EffectName = Layers['name'];
30: 
31: /** The options type an entry takes, from its `EffectLayer<TOptions, name>`. */
32: export type EffectOptions<N extends EffectName> =
33:   Extract<Layers, { name: N }> extends EffectLayer<infer O, N> ? O : never;
34: 
35: class Effects {
36:   private readonly layers: EffectLayer[] = [...EFFECT_LAYERS];
37:   private readonly byName = new Map<string, EffectLayer>(
38:     EFFECT_LAYERS.map(l => [l.name, l as EffectLayer])
39:   );
40: 
41:   /** Add an entry at runtime (tools, experiments). Returns the unregister. */
42:   register(layer: EffectLayer): () => void {
43:     this.layers.push(layer);
44:     this.byName.set(layer.name, layer);
45:     return () => {
46:       const i = this.layers.indexOf(layer);
47:       if (i >= 0) this.layers.splice(i, 1);
48:       if (this.byName.get(layer.name) === layer) this.byName.delete(layer.name);
49:     };
50:   }
51: 
52:   /** Every entry that exists on this map. */
53:   layersFor(map: ENUM_WORLD): EffectLayer[] {
54:     return this.layers.filter(l => !l.maps || l.maps.has(map));
55:   }
56: 
57:   /** Step every entry. Call once a frame, before anything reads the effects. */
58:   update(map: ENUM_WORLD, dt: number): void {
59:     // The clock first: a step that comes due spawns into this same frame.
60:     stepClock(dt);
61:     for (const layer of this.layers) layer.update?.(map, dt);
62:   }
63: 
64:   /** End every live effect, cancel every pending step and drop every pool. Call when the map changes. */
65:   reset(): void {
66:     clearTimers();
67:     for (const layer of this.layers) layer.reset?.();
68:     disposePools();
69:   }
70: 
71:   // ---- commands ----------------------------------------------------------
72: 
73:   /** Start one effect of entry `name` at `at` (world tiles). */
74:   spawn<N extends EffectName>(
75:     name: N,
76:     scene: Scene,
77:     at: Vector3,
78:     opts: EffectOptions<N>
79:   ): EffectHandle {
80:     const layer = this.byName.get(name);
81:     if (!layer) throw new Error(`[effects] no entry named ${name}`);
82:     return layer.spawn(scene, at, opts);
83:   }
84: }
85: 
86: export const effects = new Effects();
87: 
88: // A hot update that reaches this module must reload the page: Vite would
89: // otherwise re-execute it and hand later-loaded importers a second instance
90: // of this singleton (same guard as store.ts).
91: const hot = (import.meta as { hot?: { decline(): void } }).hot;
92: if (hot) hot.decline();
</file>

