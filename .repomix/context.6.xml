108: /** The rank table, or null when there is none. */
109: export function devilSquareResult(): DevilSquareResult | null {
110:   return state.result;
111: }
112: 
113: export function inDevilSquare(map: ENUM_WORLD): boolean {
114:   return MAPS.has(map);
115: }
116: 
117: /** `OpenningProcess`: build the buttons and show the window. */
118: export function openDevilSquare(): void {
119:   const pd = Store.playerData;
120:   const master = isMasterClass(pd.charClass);
121:   const row = LOWER_LIMIT_CLASSES.has(getBaseClass(pd.charClass)) ? 1 : 0;
122:   const { buttons, active } = entryButtons(
123:     DEVIL_SQUARE_LEVELS,
124:     row,
125:     master ? skills.masterLevel : pd.level,
126:     master,
127:     EVENT_TEXT.squareButton,
128:     EVENT_TEXT.squareButtonMaster,
129:     MASTER_SQUARE_NUMBER
130:   );
131:   runInAction(() => {
132:     state.buttons = buttons;
133:     state.active = active;
134:     state.open = true;
135:   });
136: }
