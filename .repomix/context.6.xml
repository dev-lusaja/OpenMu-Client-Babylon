301: /** MU's two effect blends: `EnableAlphaBlend` (ONE, ONE) and `EnableAlphaBlendMinus` (ZERO, ONE_MINUS_SRC_COLOR). */
302: export type EffectBlend = 'add' | 'subtract';
303: 
304: /**
305:  * The additive blend the cards and skill meshes use: `(SRC_ALPHA, ONE)`.
306:  * The original's `EnableAlphaBlend` is `(ONE, ONE)` and it fades an effect
307:  * by scaling `glColor3fv(Light × Alpha)` - the colour toward black. Under
308:  * `(ONE, ONE)` Babylon's `mesh.visibility` never reaches the framebuffer
309:  * (the alpha is simply dropped), so every fade was a no-op and `sprite`
310:  * shrank its card instead. `(SRC_ALPHA, ONE)` with an opaque sheet is the
311:  * same maths - `src × visibility + dst` - and lets `visibility` be the
312:  * original's `Alpha` .
313:  */
314: const ADDITIVE_ALPHA_MODE = Constants.ALPHA_ADD;
315: 
316: /**
317:  * Unlit material tinted `colour` (the original's `glColor3fv(Light)` on an
318:  * `EnableAlphaBlend` quad). Cached per (texture, colour, blend). JPG effect
319:  * sheets are black where they are transparent, and with (ONE, ONE) black adds
320:  * nothing - so no alpha channel is needed. The sheet rides in `diffuseTexture`
321:  * with the tint in `emissiveColor`: the Standard fragment is
322:  * `clamp(diffuseBase·diffuseColor + emissiveColor + ambient) × diffuseTexel`,
323:  * and with lighting off `diffuseBase` is 0, so the texel is *multiplied* by
324:  * the tint like `glColor3fv`. (The sheet as `emissiveTexture` is *added* to
325:  * `emissiveColor` instead - the tint filled the card's black and every flash
326:  * was a solid tinted square, 2026-08-30.) `subtract` is
327:  * `EnableAlphaBlendMinus` (ZzzOpenglUtil.cpp:444, `dest × (1 − src)`,
328:  * Babylon's ALPHA_SUBTRACT): the dark trail a levelled character's sword
329:  * leaves in `RenderBlurs`.
330:  */
331: export function additiveMaterial(
332:   scene: Scene,
333:   texture: string | Texture,
334:   colour: RGB,
335:   blend: EffectBlend = 'add'
336: ): StandardMaterial {
337:   let byKey = materials.get(scene);
338:   if (!byKey) {
339:     byKey = new Map();
340:     materials.set(scene, byKey);
341:   }
342:   const gain = blend === 'add' ? lightCardGain(scene) : 1;
343:   const tint: RGB = gain === 1 ? colour : [colour[0] * gain, colour[1] * gain, colour[2] * gain];
344:   const texKey = typeof texture === 'string' ? texture : `#${texture.uniqueId}`;
345:   const key = `${texKey}|${colourKey(tint)}|${blend}`;
346:   let m = byKey.get(key);
347:   if (m) return m;
348: 
349:   const mat = new StandardMaterial(`fx:${key}`, scene);
350:   mat.diffuseColor.set(0, 0, 0);
351:   mat.specularColor.set(0, 0, 0);
352:   mat.ambientColor.set(0, 0, 0);
353:   mat.emissiveColor.set(tint[0], tint[1], tint[2]);
354:   mat.disableLighting = true;
355:   mat.alphaMode = blend === 'subtract' ? Constants.ALPHA_SUBTRACT : ADDITIVE_ALPHA_MODE;
356:   mat.transparencyMode = Material.MATERIAL_ALPHABLEND;
357:   mat.backFaceCulling = false;
358:   mat.disableDepthWrite = true;
359:   mat.fogEnabled = false;
360: 
361:   if (typeof texture === 'string') {
362:     void effectTexture(scene, texture).then(tex => {
363:       if (materials.get(scene)?.get(key) !== mat) return; // pools were reset meanwhile
364:       mat.diffuseTexture = tex;
365:     });
366:   } else {
367:     // A texture somebody else owns (a skill model's, from the GLB cache):
368:     // referenced, never disposed - `disposePools` drops the material only.
369:     mat.diffuseTexture = texture;
370:   }
371: 
372:   byKey.set(key, mat);
373:   m = mat;
374:   return m;
375: }
