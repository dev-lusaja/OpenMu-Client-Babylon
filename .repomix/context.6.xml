 39: export const AppearanceSystem: ISystemFactory = world => {
 40:   const query = world.with('charAppearance', 'modelObject', 'visibility');
 41: 
 42:   return {
 43:     update: () => {
 44:       for (const {
 45:         charAppearance,
 46:         modelObject,
 47:         visibility,
 48:         attributeSystem,
 49:       } of query) {
 50:         if (visibility.state === 'hidden') continue;
 51:         if (!charAppearance.changed) continue;
 52:         if (!modelObject.Ready) continue;
 53: 
 54:         const playerObject = modelObject as PlayerObject;
 55: 
 56:         loadPart(charAppearance.helm, playerObject, playerObject.HelmMask) ||
 57:           playerObject.setDefaultMask();
 58:         loadPart(charAppearance.armor, playerObject, playerObject.Armor) ||
 59:           playerObject.setDefaultArmor();
 60:         loadPart(charAppearance.pants, playerObject, playerObject.Pants) ||
 61:           playerObject.setDefaultPants();
 62:         loadPart(charAppearance.gloves, playerObject, playerObject.Gloves) ||
 63:           playerObject.setDefaultGloves();
 64:         loadPart(charAppearance.boots, playerObject, playerObject.Boots) ||
 65:           playerObject.setDefaultBoots();
 66: 
 67:         // c->Wing and the body-linked half of c->Helper. Both need their own
 68:         // loader: the wing decides its bone (back vs cape) and blend mesh
 69:         // before load, and the pet models live under Player/ rather than at
 70:         // the Item/ path items.json carries for the horn items.
 71:         void playerObject.setWingsAsync(charAppearance.wings);
 72:         void playerObject.setBodyPetAsync(charAppearance.pet);
 73: 
 74:         // Summoner books are never drawn on the character (`RenderLinkObject`
 75:         // returns before them, ZzzCharacter.cpp:6453-6456).
 76:         const mainHand = isBook(charAppearance.leftHand)
 77:           ? null
 78:           : charAppearance.leftHand;
 79:         const offHand = isBook(charAppearance.rightHand)
 80:           ? null
 81:           : charAppearance.rightHand;
 82:         loadPart(mainHand, playerObject, playerObject.Weapon1, 0) ||
 83:           playerObject.Weapon1.Unload();
 84:         loadPart(offHand, playerObject, playerObject.Weapon2, 1) ||
 85:           playerObject.Weapon2.Unload();
 86:         void playerObject.setPhoenixWingAsync(0, mainHand);
 87:         void playerObject.setPhoenixWingAsync(1, offHand);
 88: 
 89:         if (attributeSystem) {
 90:           // Kept for consumers of the flag; reset properly on unequip and
 91:           // driven by the main-hand slot only (slot 0 = "leftHand" bytes).
 92:           const main = charAppearance.leftHand;
 93:           attributeSystem.setValue(
 94:             'isSpearEquipped',
 95:             main && main.group === 3 ? 1 : 0
 96:           );
 97:         }
 98: 
 99:         applyWeaponAttachments(
100:           playerObject,
101:           charAppearance,
102:           attributeSystem?.isAboveZero('weaponsOnBack') ?? false
103:         );
104: 
105:         charAppearance.changed = false;
106:         // Everything built off this character's items is re-examined from
107:         // here, the same way the item-effect stamps above are re-applied.
108:         charAppearance.applied = (charAppearance.applied ?? 0) + 1;
109:       }
110:     },
111:   };
112: };
