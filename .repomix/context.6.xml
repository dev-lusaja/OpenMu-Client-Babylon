  2:   GlowLayer,
  3:   type AbstractMesh,
  4:   type Mesh,
  5:   type Scene,
  6: } from '../libs/babylon/exports';
  7: import { GameOptions, onGameOptionsChanged } from '../common/gameOptions';
  8: import { devQueryNumber } from '../common/devSeams';
  9: 
 10: /**
 11:  * The halo around effect art - the light a bolt or a flare throws into the
 12:  * frame around itself.
 13:  *
 14:  * The scene's other `GlowLayer` (`scenes/sceneLook.ts`) is the *item* halo:
 15:  * it has no render list, draws every active mesh, and its emissive selectors
 16:  * answer for item tiers and PBR trim maps. Effect art was excluded from it
 17:  * for that reason and got no bloom of its own, which on a scene-referred
 18:  * frame leaves a skill flat: the bolt and the ground it is drawn over land at
 19:  * the same display value once the tone curve has compressed them
 20:  * (documentation/effects_exposure). What the original reads as is a hot core
 21:  * inside a wide coloured halo, and the halo is this file.
 22:  *
 23:  * Three things separate it from the item layer:
 24:  *
 25:  *  - **an include list, not the whole scene.** The only meshes it draws are
 26:  *    the ones an entry hands it, so a halo costs the cards that are on
 27:  *    screen, not a second pass over the map.
 28:  *  - **their own material.** What lands in the glow map is the card as drawn
 29:  *    - sheet x tint x `visibility`, at the map's `lightCardGain` - rather
 30:  *    than a flat quad of the tint an emissive selector would produce.
 31:  *  - **its own strength.** The item ladder rings a silhouette at 0.25; a
 32:  *    skill has to read as light thrown into the scene.
 33:  *
 34:  * Only emissive art joins: a `RENDER_DARK` card removes light and blooming it
 35:  * would add back what it just took, and alpha art is matter, not light. Off
 36:  * with post processing, where the frame is display-referred and the art is
 37:  * already at the value it was authored for.
 38:  *
 39:  * `effects/core.ts` (cards), `joint.ts` (ribbons) and `model.ts` (skill
 40:  * meshes) are the only callers; `disposePools` takes the layer down with the
 41:  * map.
 42:  */
 43: 
 44: const SLIDER_MAX = 9;
 45: 
 46: /**
 47:  * Layer strength at the top notch of the Glow slider (the default 5/9 lands
 48:  * on 0.5). Twice the item ladder's 0.45: that one is a rim around armour and
 49:  * a bolt at it does not survive the tone curve.
 50:  *
 51:  * Measured, not guessed - sweep at `?fxglow=` over 0.4 / 0.7 / 0.9 / 1.2 /
 52:  * 1.8 on Lightning and Ice. Under 0.7 a bolt has no halo worth the pass; over
 53:  * 1.2 a *model* loses its own shape, because a mesh covers area where a
 54:  * ribbon covers a line and the same blur turns it into a dome. 0.9 is where
 55:  * the bolt reads as light and the ice shards still read as shards.
 56:  */
 57: const FX_GLOW_MAX_INTENSITY = 0.9;
 58: 
 59: /**
 60:  * Glow map resolution as a share of the canvas, and the blur kernel in its
 61:  * pixels. A lightning ribbon is a few pixels wide: at the item layer's fixed
 62:  * 256 it rasterises to a dashed line and the halo crawls along it, so the
 63:  * effect map is half-res. The kernel is then ~16 % of the frame width at
 64:  * 1080p, which is the reference halo's reach.
 65:  */
 66: const FX_TEXTURE_RATIO = 0.5;
 67: const FX_BLUR_KERNEL = 64;
 68: 
 69: let layer: GlowLayer | null = null;
 70: let layerScene: Scene | null = null;
 71: let offOptions: (() => void) | null = null;
 72: 
 73: /** Meshes drawn into the halo right now. */
 74: const included = new Set<AbstractMesh>();
 75: 
 76: /**
 77:  * Meshes already handed to the layer as own-material. Referencing adds an
 78:  * `onDispose` observer every call, and a pooled card is acquired thousands of
 79:  * times a session - so it is referenced once and its *participation* is the
 80:  * include list.
 81:  */
 82: let referenced = new WeakSet<AbstractMesh>();
 83: 
 84: function syncIntensity(): void {
 85:   if (!layer) return;
 86: 
 87:   // Dev seam for the sweep: `?fxglow=`.
 88:   const max = devQueryNumber('fxglow') ?? FX_GLOW_MAX_INTENSITY;
 89: 
 90:   layer.intensity = GameOptions.postProcessing
 91:     ? (Math.max(0, GameOptions.glow) / SLIDER_MAX) * max
 92:     : 0;
 93: 
 94:   syncEnabled();
 95: }
 96: 
 97: function syncEnabled(): void {
 98:   if (!layer) return;
 99: 
100:   const on = included.size > 0 && layer.intensity > 0;
101: 
102:   if (layer.isEnabled !== on) layer.isEnabled = on;
103: }
104: 
105: function ensureLayer(scene: Scene): GlowLayer | null {
106:   if (layer && layerScene === scene) return layer;
107:   if (layer) disposeEffectGlow();
108: 
109:   layer = new GlowLayer('fxGlow', scene, {
110:     mainTextureRatio: FX_TEXTURE_RATIO,
111:     blurKernelSize: FX_BLUR_KERNEL,
112:   });
113:   layer.isEnabled = false;
114:   layerScene = scene;
115:   offOptions = onGameOptionsChanged(syncIntensity);
116: 
117:   syncIntensity();
118: 
119:   return layer;
120: }
121: 
122: /** Draw `mesh` into the halo. Idempotent; only emissive art should ask. */
123: export function addEffectGlow(scene: Scene, mesh: AbstractMesh): void {
124:   const gl = ensureLayer(scene);
125: 
126:   if (!gl || included.has(mesh)) return;
127: 
128:   if (!referenced.has(mesh)) {
129:     referenced.add(mesh);
130:     gl.referenceMeshToUseItsOwnMaterial(mesh);
131:   }
132: 
133:   // The include list is typed `Mesh` and keyed on `uniqueId`; a skill mesh
134:   // arrives as the AbstractMesh the GLB cache handed over.
135:   gl.addIncludedOnlyMesh(mesh as Mesh);
136:   included.add(mesh);
137: 
138:   syncEnabled();
139: }
140: 
141: /** Stop drawing `mesh`. A pooled card comes back through `addEffectGlow`. */
142: export function dropEffectGlow(mesh: AbstractMesh): void {
143:   if (!included.delete(mesh)) return;
144: 
145:   layer?.removeIncludedOnlyMesh(mesh as Mesh);
146: 
147:   syncEnabled();
148: }
149: 
150: /**
151:  * …and forget it: the mesh is about to be disposed. Babylon's own dispose
152:  * hook drops a mesh from the include and exclude lists but *not* from the
153:  * own-material list, so a spawn that disposes its meshes has to say so.
154:  */
155: export function releaseEffectGlow(mesh: AbstractMesh): void {
156:   dropEffectGlow(mesh);
157: 
158:   if (!referenced.has(mesh)) return;
159: 
160:   referenced.delete(mesh);
161:   layer?.unReferenceMeshFromUsingItsOwnMaterial(mesh);
162: }
163: 
164: /** Map change: the layer goes with the pools it drew from. */
165: export function disposeEffectGlow(): void {
166:   included.clear();
167:   // A mesh that outlives the layer has to be referenced again by the next one.
168:   referenced = new WeakSet();
169:   offOptions?.();
170:   offOptions = null;
171:   layer?.dispose();
172:   layer = null;
173:   layerScene = null;
174: }
</file>

