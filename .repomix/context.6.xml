 1: import { useEffect, useState } from 'react';
 2: import { loadVersionUi, versionUi } from '../version';
 3: import type { VersionUi } from '../version/uiContract';
 4: 
 5: /**
 6:  * The active version's UI module for a shared component that has to ask it
 7:  * which art to draw (`muLogo`). Null on the first paint if the chunk is not
 8:  * in yet; the component renders nothing until it is, which is what it
 9:  * already does while a sprite decodes.
10:  *
11:  * A screen that is *wholly* the version's is not this - it comes out of
12:  * `pregame.LoginPage` / `pregame.CharactersPage` through `React.lazy`.
13:  */
14: export function useVersionUi(): VersionUi | null {
15:   const [ui, setUi] = useState(versionUi);
16: 
17:   useEffect(() => {
18:     if (ui) return;
19: 
20:     let cancelled = false;
21: 
22:     void loadVersionUi().then(loaded => {
23:       if (!cancelled) setUi(loaded);
24:     });
25: 
26:     return () => {
27:       cancelled = true;
28:     };
29:   }, [ui]);
30: 
31:   return ui;
32: }
</file>

<file path="src/ecs/systems/emoteSystem.ts">
  1: import { PlayerAction, ServerPlayerActionType } from '../../common/objects/enum';
  2: import { emoteById, genderedEmoteAction } from '../../common/emotes';
  3: import { isStandingIdle } from '../../common/playerActionMapper';
  4: import { rotationByteOf } from '../../common/turnAngle';
  5: import { Store } from '../../store';
  6: import type { ISystemFactory } from '../world';
  7: 
  8: /**
  9:  * Plays the emote picked in the radial menu on the hero and tells the server
 10:  * (ZzzInterface.cpp `SetActionClass` + `SendRequestAction`).
 11:  *
 12:  * The original only accepted an emote from a standing idle. We also accept it
 13:  * while sitting / posing / healing on a rest object: the clip plays standing,
 14:  * and when it ends the character drops back into the same rest pose and the
 15:  * rest action is re-sent so everyone else sees it too. Walking, dying or any
 16:  * other action change cancels that restore, exactly as it would cancel the
 17:  * sit itself.
 18:  */
 19: 
 20: /** PLAYER_SIT1 .. PLAYER_POSE_FEMALE1: the held rest poses (RestObjectSystem). */
 21: function isRestAction(action: PlayerAction): boolean {
 22:   return (
 23:     action >= PlayerAction.PLAYER_SIT1 &&
 24:     action <= PlayerAction.PLAYER_POSE_FEMALE1
 25:   );
 26: }
 27: 
 28: function restServerAction(action: PlayerAction): ServerPlayerActionType {
 29:   if (
 30:     action === PlayerAction.PLAYER_HEALING1 ||
 31:     action === PlayerAction.PLAYER_HEALING_FEMALE1
 32:   ) {
 33:     return ServerPlayerActionType.Healing;
 34:   }
 35:   if (
 36:     action === PlayerAction.PLAYER_POSE1 ||
 37:     action === PlayerAction.PLAYER_POSE_FEMALE1
 38:   ) {
 39:     return ServerPlayerActionType.Pose;
 40:   }
 41:   return ServerPlayerActionType.Sit;
 42: }
 43: 
 44: export const EmoteSystem: ISystemFactory = world => {
 45:   let active: {
 46:     action: PlayerAction;
 47:     restore: PlayerAction | null;
 48:   } | null = null;
 49: 
 50:   return {
 51:     update: () => {
 52:       const hero = world.playerEntity;
 53:       if (!hero) {
 54:         active = null;
 55:         world.emoteRequest = null;
 56:         return;
 57:       }
 58: 
 59:       const anim = hero.playerAnimation;
 60:       const model = hero.modelObject;
 61:       const velocity = hero.movement?.velocity;
 62:       const moving = !!velocity && (velocity.x !== 0 || velocity.y !== 0);
 63: 
 64:       if (active) {
 65:         if (anim.action !== active.action || moving || hero.dying) {
 66:           // Something else took over (a step, a hit, death): no restore.
 67:           active = null;
 68:         } else if (
 69:           model &&
 70:           model.CurrentAction === active.action &&
 71:           model.ActionIterationWasFinished
 72:         ) {
 73:           // Runs before AnimationSystem, so setting the rest pose here keeps
 74:           // it from re-evaluating to idle on the frame the clip ends.
 75:           if (active.restore !== null) {
 76:             anim.action = active.restore;
 77:             if (!Store.isOffline) {
 78:               Store.sendAnimationRequest(
 79:                 rotationByteOf(hero.transform.rot.y),
 80:                 restServerAction(active.restore)
 81:               );
 82:             }
 83:           }
 84:           active = null;
 85:         }
 86:       }
 87: 
 88:       const request = world.emoteRequest;
 89:       if (!request) return;
 90:       world.emoteRequest = null;
 91: 
 92:       // An instrument in hand holds its own pose; the wheel greys the emotes out too.
 93:       if (hero.dying || moving || active || hero.performing) return;
 94: 
 95:       const current = anim.action;
 96:       const resting = isRestAction(current);
 97:       if (!resting && !isStandingIdle(current)) return;
 98: 
 99:       const emote = emoteById(request);
100:       const isFemale = hero.attributeSystem.isAboveZero('isFemale');
101:       const action = genderedEmoteAction(emote.action, isFemale);
102: 
103:       anim.action = action;
104:       active = { action, restore: resting ? current : null };
105: 
106:       if (!Store.isOffline) {
107:         Store.sendAnimationRequest(
108:           rotationByteOf(hero.transform.rot.y),
109:           emote.serverAction
110:         );
111:       }
112:     },
113:   };
114: };
</file>

<file path="src/ecs/systems/headTrackingSystem.ts">
  1: import {
  2:   Matrix,
  3:   Quaternion,
  4:   Vector3,
  5:   type Observer,
  6:   type Scene,
  7: } from '../../libs/babylon/exports';
  8: import { PlayerAction, ServerPlayerActionType } from '../../common/objects/enum';
  9: import {
 10:   approachAngle,
 11:   rotationByteOf,
 12:   signedAngleDelta,
 13: } from '../../common/turnAngle';
 14: import { Store } from '../../store';
 15: import type { Entity, ISystemFactory } from '../world';
 16: 
 17: /**
 18:  * Head look-at-mouse + idle turn-to-mouse, from ZzzInterface.cpp:7386-7498
 19:  * and ZzzCharacter.cpp:5504-5513 / ZzzBMD.cpp:83-96.
 20:  *
 21:  * - The hero's head yaw follows the cursor (clamped to ±60°), pitch follows
 22:  *   the cursor height; it keeps doing so while leaning or sitting (only the
 23:  *   *body* turn is suppressed then). Disabled while auto-attacking a target.
 24:  * - Other players glance around randomly (±64° / ±16°, roughly every 32 ticks).
 25:  * - Both are smoothed with TurnAngle2(…, FarAngle × 0.2) per tick.
 26:  * - After ~40 idle ticks the hero's body turns to the cursor and AT_STAND1 is
 27:  *   sent so other clients see the new facing.
 28:  *
 29:  * The original derives the cursor yaw with `CreateAngle(...) + 315` in its own
 30:  * screen/yaw convention; here the yaw is solved from the camera projection
 31:  * instead (hero + unit X / unit Z projected to screen, cursor vector expressed
 32:  * in that basis), so it is exact for any camera.
 33:  *
 34:  * The bone override has to run *after* Babylon evaluated the animation groups
 35:  * (they overwrite the head bone's rotation every frame), hence the
 36:  * onAfterAnimationsObservable hook.
 37:  */
 38: 
 39: const DEG = Math.PI / 180;
 40: const HEAD_BONE = 20; // Models[MODEL_PLAYER].BoneHead (ZzzOpenData.cpp:311)
 41: const HEAD_TURN_FRACTION = 0.2;
 42: const HEAD_YAW_LIMIT = 60 * DEG;
 43: const HERO_SCREEN_Y = 180; // hero anchor in the original's 640×480 space
 44: const REFERENCE_SCREEN_H = 480;
 45: const IDLE_TURN_SECONDS = 40 / 25;
 46: const GLANCE_TICK_CHANCE = 1 / 32;
 47: 
 48: type HeadState = {
 49:   yaw: number;
 50:   pitch: number;
 51:   targetYaw: number;
 52:   targetPitch: number;
 53: };
 54: 
 55: const heads = new WeakMap<Entity, HeadState>();
 56: 
 57: function headOf(e: Entity): HeadState {
 58:   let h = heads.get(e);
 59:   if (!h) {
 60:     h = { yaw: 0, pitch: 0, targetYaw: 0, targetPitch: 0 };
 61:     heads.set(e, h);
 62:   }
 63:   return h;
 64: }
 65: 
 66: function isIdleStandAction(action: PlayerAction): boolean {
 67:   return (
 68:     (action >= PlayerAction.PLAYER_STOP_MALE &&
 69:       action <= PlayerAction.PLAYER_STOP_RIDE_WEAPON) ||
 70:     action === PlayerAction.PLAYER_STOP_TWO_HAND_SWORD_TWO
 71:   );
 72: }
 73: 
 74: function blocksBodyTurn(action: PlayerAction): boolean {
 75:   return (
 76:     action === PlayerAction.PLAYER_POSE1 ||
 77:     action === PlayerAction.PLAYER_POSE_FEMALE1 ||
 78:     action === PlayerAction.PLAYER_SIT1 ||
 79:     action === PlayerAction.PLAYER_SIT_FEMALE1
 80:   );
 81: }
 82: 
 83: /** Yaw convention of transform.rot.y (moveAlongPathSystem): atan2(dz, dx) + π/2. */
 84: function yawOf(dx: number, dz: number): number {
 85:   return Math.atan2(dz, dx) + Math.PI / 2;
 86: }
 87: 
 88: type CursorInfo = { yaw: number; mouseY: number; canvasH: number };
 89: 
 90: export const HeadTrackingSystem: ISystemFactory = world => {
 91:   const scene: Scene = world.scene;
 92:   const players = world.with('playerAnimation', 'modelObject', 'transform');
 93: 
 94:   let standTime = 0;
 95:   let observer: Observer<Scene> | null = null;
 96:   const tmpQ = new Quaternion();
 97:   const wHero = new Vector3();
 98:   const wX = new Vector3();
 99:   const wZ = new Vector3();
100:   const sHero = new Vector3();
101:   const sX = new Vector3();
102:   const sZ = new Vector3();
103: 
104:   /** World yaw from the hero towards the cursor, or null when degenerate. */
105:   function cursorYaw(e: Entity): CursorInfo | null {
106:     const camera = scene.activeCamera;
107:     if (!camera) return null;
108:     const engine = scene.getEngine();
109:     const renderW = engine.getRenderWidth(true);
110:     const renderH = engine.getRenderHeight(true);
111:     const canvas = engine.getRenderingCanvas();
112:     const cssW = canvas?.clientWidth || renderW;
113:     const cssH = canvas?.clientHeight || renderH;
114:     const mouseX = (scene.pointerX * renderW) / cssW;
115:     const mouseY = (scene.pointerY * renderH) / cssH;
116: 
117:     const t = e.transform!;
118:     const mp = world.mapParent.position;
119:     wHero.set(
120:       t.pos.x + (t.posOffset?.x ?? 0) + mp.x,
121:       t.pos.y + (t.posOffset?.y ?? 0) + mp.y,
122:       t.pos.z + (t.posOffset?.z ?? 0) + mp.z
123:     );
124:     wX.copyFrom(wHero).addInPlaceFromFloats(1, 0, 0);
125:     wZ.copyFrom(wHero).addInPlaceFromFloats(0, 0, 1);
126: 
127:     const viewport = camera.viewport.toGlobal(renderW, renderH);
128:     const transform = scene.getTransformMatrix();
129:     Vector3.ProjectToRef(wHero, Matrix.IdentityReadOnly, transform, viewport, sHero);
130:     Vector3.ProjectToRef(wX, Matrix.IdentityReadOnly, transform, viewport, sX);
131:     Vector3.ProjectToRef(wZ, Matrix.IdentityReadOnly, transform, viewport, sZ);
132: 
133:     // Screen basis of the world X/Z axes at the hero; solve a·ex + b·ez = m.
134:     const exx = sX.x - sHero.x;
135:     const exy = sX.y - sHero.y;
136:     const ezx = sZ.x - sHero.x;
137:     const ezy = sZ.y - sHero.y;
138:     const mx = mouseX - sHero.x;
139:     const my = mouseY - sHero.y;
140:     const det = exx * ezy - exy * ezx;
141:     if (Math.abs(det) < 1e-6 || mx * mx + my * my < 4) return null;
142:     const a = (mx * ezy - my * ezx) / det;
143:     const b = (exx * my - exy * mx) / det;
144: 
145:     return { yaw: yawOf(a, b), mouseY, canvasH: renderH };
146:   }
147: 
148:   function applyHeadBones() {
149:     for (const e of players) {
150:       const model = e.modelObject;
151:       const bone = model.gltf?.skeleton?.bones[HEAD_BONE + 1];
152:       const node = bone?.getTransformNode();
153:       if (!node || !node.rotationQuaternion) continue;
154: 
155:       const h = heads.get(e);
156:       if (!h || (h.yaw === 0 && h.pitch === 0)) continue;
157: 
158:       // BMD::Animation: head bone X -= HeadAngle[0] (yaw), Z -= HeadAngle[1]
159:       // (pitch), applied on top of the clip's pose.
160:       Quaternion.FromEulerAnglesToRef(-h.yaw, 0, -h.pitch, tmpQ);
161:       node.rotationQuaternion.multiplyInPlace(tmpQ);
162:     }
163:   }
164: 
165:   return {
166:     update: dt => {
167:       if (!observer) {
168:         observer = scene.onAfterAnimationsObservable.add(applyHeadBones);
169:       }
170: 
171:       const hero = world.playerEntity;
172:       const ticks = dt * 25;
173: 
174:       for (const e of players) {
175:         const h = headOf(e);
176:         const action = e.playerAnimation.action;
177: 
178:         if (e === hero) {
179:           let lookAtMouse = true;
180:           if (world.attackTarget) lookAtMouse = false; // auto-attack with a target
181:           if (action === PlayerAction.PLAYER_DIE1 || e.dying) lookAtMouse = false;
182: 
183:           const cursor = lookAtMouse ? cursorYaw(e) : null;
184: 
185:           if (cursor) {
186:             // Head yaw = how far the cursor is from the body facing, ±60°.
187:             // Bone yaw is applied as -yaw in applyHeadBones (BMD X -= HeadAngle),
188:             // so the offset is negated here to turn towards the cursor.
189:             h.targetYaw = -signedAngleDelta(e.transform.rot.y, cursor.yaw);
190:             const toRef = REFERENCE_SCREEN_H / cursor.canvasH;
191:             h.targetPitch =
192:               (HERO_SCREEN_Y - Math.min(cursor.mouseY, cursor.canvasH) * toRef) *
193:               0.05 *
194:               DEG;
195:           } else {
196:             h.targetYaw = 0;
197:             h.targetPitch = 0;
198:           }
199: 
200:           // Idle turn-to-mouse (ZzzInterface.cpp:7474-7498).
201:           const moving =
202:             !!e.movement && (e.movement.velocity.x !== 0 || e.movement.velocity.y !== 0);
203:           if (
204:             cursor &&
205:             !moving &&
206:             isIdleStandAction(action) &&
207:             !blocksBodyTurn(action) &&
208:             // Mid-performance the pose is the band system's; a Stand1 here would end it.
209:             !e.performing &&
210:             !e.dying &&
211:             !world.attackTarget
212:           ) {
213:             standTime += dt;
214:             if (standTime >= IDLE_TURN_SECONDS) {
215:               standTime = 0;
216:               const wanted = cursor.yaw;
217:               if (rotationByteOf(e.transform.rot.y) !== rotationByteOf(wanted)) {
218:                 e.transform.rot.y = wanted;
219:                 if (!Store.isOffline) {
220:                   Store.sendAnimationRequest(
221:                     rotationByteOf(wanted),
222:                     ServerPlayerActionType.Stand1
223:                   );
224:                 }
225:               }
226:             }
227:           } else {
228:             standTime = 0;
229:           }
230:         } else {
231:           // Other players: random glances (ZzzCharacter.cpp:5504-5510).
232:           if (action !== PlayerAction.PLAYER_DIE1 && Math.random() < GLANCE_TICK_CHANCE * ticks) {
233:             h.targetYaw = (Math.random() * 128 - 64) * DEG;
234:             h.targetPitch = (Math.random() * 32 - 16) * DEG;
235:           }
236:         }
237: 
238:         h.targetYaw = Math.max(-HEAD_YAW_LIMIT, Math.min(HEAD_YAW_LIMIT, h.targetYaw));
239:         h.yaw = signedAngleDelta(0, approachAngle(h.yaw, h.targetYaw, HEAD_TURN_FRACTION, dt));
240:         h.pitch = signedAngleDelta(0, approachAngle(h.pitch, h.targetPitch, HEAD_TURN_FRACTION, dt));
241:       }
242:     },
243:   };
244: };
</file>

<file path="src/ecs/systems/keyboardInputSystem.ts">
  1: import { EventBus } from '../../libs/eventBus';
  2: import { Store } from '../../store';
  3: import {
  4:   isCapturingKey,
  5:   isKey,
  6:   WALK_KEY_CODES,
  7: } from '../../common/keyBindings';
  8: import { GameOptions } from '../../common/gameOptions';
  9: import { ITEM_HOTKEY_CODES } from '../../common/itemHotkeys';
 10: import { MuWindows } from '../../ui/components/muWindow/windowState';
 11: import { openSystemMenu } from '../../common/sessionExit';
 12: import type { ISystemFactory } from '../world';
 13: 
 14: /** Keys the page would scroll on; kept from doing so while playing. */
 15: const PAGE_SCROLL_KEYS = new Set(['Space', 'ArrowUp', 'ArrowDown']);
 16: 
 17: const isTextField = (el: EventTarget | null): boolean => {
 18:   const node = el as HTMLElement | null;
 19:   return (
 20:     !!node &&
 21:     (node.tagName === 'INPUT' ||
 22:       node.tagName === 'TEXTAREA' ||
 23:       !!node.isContentEditable)
 24:   );
 25: };
 26: 
 27: /** The focused element takes characters, so nothing here is a hot key. */
 28: export const isTypingInField = (): boolean => isTextField(document.activeElement);
 29: 
 30: /**
 31:  * The one keyboard dispatcher. Every keydown goes through here before any
 32:  * window sees it, in the original's order (`NewUIManager::UpdateKeyEvent`):
 33:  * a focused text field first, then the modal message box, then the topmost
 34:  * window for Escape, and only then the `keyPressed` broadcast the hot keys
 35:  * listen to.
 36:  */
 37: export const KeyboardInputSystem: ISystemFactory = world => {
 38:   const pressedKeys = new Set<string>();
 39: 
 40:   document.addEventListener('keydown', e => {
 41:     // A CJK composition in progress: the syllable is not committed yet, and
 42:     // Enter / Escape belong to the IME (229 is the legacy IME keyCode).
 43:     if (e.isComposing || e.keyCode === 229) return;
 44: 
 45:     // The event's own target as well as the focus: React flushes a field's
 46:     // unmount synchronously inside the keydown (Escape closes the chat box),
 47:     // so by the time this runs the focus is already back on the body.
 48:     const typing = isTextField(e.target) || isTypingInField();
 49:     if (!typing) {
 50:       // Tab opens the minimap by default; keep it from cycling browser focus
 51:       // while playing. Text fields keep the normal behaviour.
 52:       if (e.code === 'Tab') e.preventDefault();
 53:       // ALT shows drop names (and the original's macro chord); in a browser a
 54:       // bare ALT moves focus to the menu bar and eats the next click. A text
 55:       // field keeps it (Alt+Gr characters, Alt+arrow caret moves).
 56:       if (e.code === 'AltLeft' || e.code === 'AltRight') e.preventDefault();
 57:       // Space / arrows scroll the page; a field needs them as characters and
 58:       // caret keys.
 59:       if (PAGE_SCROLL_KEYS.has(e.code)) e.preventDefault();
 60:       // Ctrl+Q/W/E/R over the inventory binds an item hot key
 61:       // (NewUIMyInventory.cpp:622), but the browser claims the chord first:
 62:       // Ctrl+R reloads the page and Ctrl+E opens the search bar. Only while
 63:       // the window is open, so Ctrl+R still reloads the rest of the time.
 64:       // Ctrl+W is the browser's own and cannot be taken back from here.
 65:       if (
 66:         e.ctrlKey &&
 67:         Store.inventoryEnabled &&
 68:         ITEM_HOTKEY_CODES.includes(e.code)
 69:       ) {
 70:         e.preventDefault();
 71:       }
 72:     }
 73:     // The Options window is waiting for a key to rebind: it reads the key
 74:     // itself, nothing else should react to it.
 75:     if (isCapturingKey()) return;
 76:     // Typing in the chat box (or any field) is not a hot key: the original
 77:     // routes keys to the focused input first. That includes Escape - the
 78:     // field closes itself (chat, prompts) rather than the windows behind it.
 79:     if (typing) return;
 80:     // `CMsgWin` is modal: while it is up it owns Enter and Escape.
 81:     if (Store.msgWin) return;
 82:     // `NewUIHotKey.cpp:131`: while the minimap sheet is up only its own key
 83:     // (and Escape, which closes it) get through to the windows.
 84:     if (Store.minimapEnabled) {
 85:       if (!isKey('minimap', e.code) && e.code !== 'Escape') return;
 86:     } else if (e.code === 'Escape' && !pressedKeys.has('Escape')) {
 87:       // Escape closes the top window only. A window without a closer of its
 88:       // own leaves it to the broadcast below (every legacy handler closes).
 89:       if (MuWindows.closeTop()) {
 90:         pressedKeys.add(e.code);
 91:         return;
 92:       }
 93:       // Nothing left to close, so Escape means the system menu, as it does
 94:       // in the original.
 95:       if (openSystemMenu()) {
 96:         pressedKeys.add(e.code);
 97:         return;
 98:       }
 99:     }
100:     // W/A/S/D walk the hero while the option is on, so the actions they
101:     // carry (potion slot 2, master skills, sort, the command window) are not
102:     // broadcast for them. Ctrl + the key still is: that is the way to those
103:     // actions without rebinding anything, and nothing walks with Ctrl held.
104:     // The key still joins `pressedKeys` either way - that set is what the
105:     // walk polls.
106:     const walks =
107:       GameOptions.wsadMovement && !e.ctrlKey && WALK_KEY_CODES.has(e.code);
108: 
109:     if (!walks && !pressedKeys.has(e.code)) {
110:       EventBus.emit('keyPressed', e.code);
111:     }
112:     pressedKeys.add(e.code);
113:   });
114: 
115:   document.addEventListener('keyup', e => {
116:     if (pressedKeys.has(e.code)) {
117:       EventBus.emit('keyReleased', e.code);
118:     }
119:     pressedKeys.delete(e.code);
120:   });
121: 
122:   const clear = () => {
123:     pressedKeys.forEach(code => {
124:       EventBus.emit('keyReleased', code);
125:     });
126: 
127:     pressedKeys.clear();
128:   };
129: 
130:   EventBus.on('pageVisibilityChanged', visible => {
131:     if (visible) return;
132:     clear();
133:   });
134: 
135:   window.addEventListener('blur', () => {
136:     clear();
137:   });
138: 
139:   const keyboardInput = world.keyboardInput;
140: 
141:   return {
142:     update: () => {
143:       keyboardInput.pressedKeys = pressedKeys;
144:     },
145:   };
146: };
