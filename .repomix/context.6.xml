 12: 
 13: /**
 14:  * Item aura (improved look): a slow drift of additive motes in the
 15:  * item's glow colour around the wearer (or the drop), orbit rings of motes
 16:  * from +9 (more with each tier), plus a quick shower of falling sparks from
 17:  * +11. Excellent items mix the cyan/green sweep into the
 18:  * motes, ancient ones the deep green.
 19:  *
 20:  * One system per character / drop so the emitter can follow the body; the
 21:  * capacity is small and the texture shared (flare01 via loadEffectTexture).
 22:  *
 23:  * That "one system per character" is the cost (todo C13): a +13 wearer runs
 24:  * motes + sparks + three rings, and a crowded town square multiplies that by
 25:  * every glowing player and every drop on the ground - each one a per-frame
 26:  * CPU walk over its particle array. None of these systems needs a custom
 27:  * `startPositionFunction` or `updateFunction` (only the ring's *emitter
 28:  * point* is animated, from a scene observer, which works the same either
 29:  * way), so they all run on `GPUParticleSystem` where transform feedback is
 30:  * available and the whole update leaves the CPU. This mirrors what
 31:  * `common/ambientParticles.ts` already does for weather.
 32:  *
 33:  * Driven by: `createItemAura` from `ecs/systems/itemGlowSystem.ts` (worn
 34:  * and dropped item tiers), or `effects.spawn('itemAura', …)`. Read by: nobody.
 35:  */
 36: 
 37: // ---- 1. tuning -------------------------------------------------------------
 38: 
 39: /**
 40:  * Both concrete classes rather than `IParticleSystem`: the interface omits the
 41:  * `BaseParticleSystem` shape these builders actually set (emit boxes,
 42:  * directions, forceDepthWrite), which both implementations do have.
 43:  */
 44: type AuraSystem = ParticleSystem | GPUParticleSystem;
 45: 
 46: /** Whether this engine can run the GPU path (cached after the first ask). */
 47: let gpuSupported: boolean | null = null;
 48: 
 49: function auraGpuSupported(): boolean {
 50:   if (gpuSupported === null) {
 51:     try {
 52:       gpuSupported = GPUParticleSystem.IsSupported;
 53:     } catch {
 54:       gpuSupported = false;
 55:     }
 56:   }
 57:   return gpuSupported;
 58: }
 59: 
 60: /**
 61:  * A GPU system where possible, the CPU one otherwise. The CPU fallback keeps
 62:  * the original capacity so the look is unchanged on engines that need it.
 63:  */
 64: function createAuraSystem(
 65:   scene: Scene,
 66:   name: string,
 67:   capacity: number
 68: ): AuraSystem {
 69:   const system: AuraSystem = auraGpuSupported()
 70:     ? new GPUParticleSystem(name, { capacity }, scene)
 71:     : new ParticleSystem(name, capacity, scene);
 72: 
 73:   system.blendMode = ParticleSystem.BLENDMODE_ADD;
 74:   system.isLocal = false;
 75: 
 76:   // Additive and always over the scene, like the sprite pool; the GPU path
 77:   // cannot depth-sort against the scene anyway.
 78:   system.forceDepthWrite = false;
 79: 
 80:   return system;
 81: }
