168:   /**
169:    * Teleport (6) / Teleport Ally (15): the square under the cursor is the
170:    * destination. The original refuses the click in silence when the square
171:    * is not walkable, lies in a safe zone or is out of the skill's Distance
172:    * (`AT_SKILL_TELEPORT`, ZzzInterface.cpp); OpenMU adds that the caster
173:    * must stand outside a safe zone too, and Teleport Ally wants a party
174:    * member as the target. The hero lands on the square as the cast goes out
175:    * instead of a round trip later; the server's `MapChanged` confirms it, or
176:    * puts him back on the old square when it refuses.
177:    */
178:   function castTeleport(
179:     hero: Entity,
180:     def: SkillDefinition,
181:     target: Entity | null,
182:     point: { x: number; y: number } | null
183:   ): boolean {
184:     if (!point) return false;
185:     const x = ~~point.x;
186:     const y = ~~point.y;
187:     const heroPos = hero.transform!.pos;
188:     const dist = Math.hypot(x - heroPos.x, y - heroPos.z);
189:     const range = def.distance > 0 ? def.distance + 0.5 : DEFAULT_RANGE;
190:     const inSafeZone = !!hero.attributeSystem?.isAboveZero('inSafeZone');
191:     if (
192:       inSafeZone ||
193:       dist > range ||
194:       !world.isWalkable(x, y) ||
195:       (world.getTerrainFlag(x, y) & TW_SAFEZONE) !== 0
196:     ) {
197:       return false;
198:     }
199:     const ally = def.num !== TELEPORT;
200:     if (ally && !(target && isPlayer(target) && target !== hero)) return false;
201:     if (!skills.canUse(def.num)) return false;
202:     skills.startCooldown(def.num);
203: 
204:     // The original takes the facing before the teleport, while the hero is
205:     // still on the old square (`o->Angle[2] = CreateAngle2D`).
206:     const dx = x - heroPos.x;
207:     const dz = y - heroPos.z;
208:     if (dx * dx + dz * dz > 0.01) hero.transform!.rot.y = Math.atan2(dz, dx) + Math.PI / 2;
209: 
210:     if (!Store.isOffline) {
211:       if (ally) {
212:         const packet = TeleportTargetPacket.createPacket();
213:         packet.TargetId = target!.netId!;
214:         packet.TeleportTargetX = x;
215:         packet.TeleportTargetY = y;
216:         Store.sendToGS(packet.buffer);
217:       } else {
218:         const packet = EnterGateRequestPacket.createPacket();
219:         packet.GateNumber = 0;
220:         packet.TeleportTargetX = x;
221:         packet.TeleportTargetY = y;
222:         Store.sendToGS(packet.buffer);
223:       }
224:     }
225: 
226:     if (!ally) {
227:       // The swap the MapChanged handler would do, done here so the hero is
228:       // not a round trip behind the click.
229:       heroPos.x = x;
230:       heroPos.z = y;
231:       heroPos.y = world.getTerrainHeight(x, y);
232:       const pathfinding = hero.pathfinding!;
233:       pathfinding.from = { x, y };
234:       pathfinding.to = { x, y };
235:     }
236:     return true;
237:   }
