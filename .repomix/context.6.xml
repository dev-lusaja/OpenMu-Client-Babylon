174:   function spawn(owner: Entity, item: Item, spec: PetSpec) {
175:     const pos = owner.transform!.pos;
176:     const map = owner.worldIndex ?? world.mapIndex;
177: 
178:     // CreateMountSub seeds the angel a couple of tiles away and above its
179:     // owner; a mount starts exactly on him (GOBoid.cpp:114-125). The raven
180:     // starts 300 units straight up (CSPetSystem.cpp:299).
181:     const angel = spec.kind === 'angel';
182:     const raven = spec.kind === 'raven';
183: 
184:     world.add({
185:       worldIndex: map,
186:       transform: {
187:         pos: new Vector3(
188:           pos.x + (angel ? (rand(512) - 256) * MU_UNIT : 0),
189:           pos.y +
190:             (angel ? (rand(128) + 128) * MU_UNIT : 0) +
191:             (raven ? RAVEN_SPAWN_HEIGHT * MU_UNIT : 0),
192:           pos.z + (angel ? (rand(512) - 256) * MU_UNIT : 0)
193:         ),
194:         rot: new Vector3(0, owner.transform!.rot.y, 0),
195:         scale: spec.scale,
196:         posOffset: new Vector3(0.5, 0, 0.5),
197:       },
198:       modelFactory: petFactoryFor(spec),
199:       visibility: { state: 'hidden', lastChecked: 0 },
200:       petActor: {
201:         owner,
202:         kind: angel ? 'angel' : raven ? 'raven' : 'mount',
203:         yaw: owner.transform!.rot.y,
204:         dir: { x: 0, y: 0, z: 0 },
205:         reroll: 0,
206:         flyRange: (spec.flyRange ?? 0) * MU_UNIT,
207:         drop: spec.mountDrop ?? 0,
208:         standAction: spec.standAction ?? MOUNT_ACTION_STAND,
209:         moveAction: spec.moveAction ?? MOUNT_ACTION_MOVE,
210:         fenrirThunder: spec.thunder,
211:       },
212:     });
213: 
214:     (raven ? spawnedRaven : spawned).set(owner, { item, map });
215:   }
