421:   function updateMount(actor: Entity, dt: number, inSafeZone: boolean) {
422:     const state = actor.petActor!;
423:     const target = state.owner.transform?.pos;
424:     if (!target) return;
425: 
426:     const pos = actor.transform!.pos;
427:     pos.x = target.x;
428:     pos.y = target.y - state.drop;
429:     pos.z = target.z;
430:     actor.transform!.rot.y = state.owner.transform!.rot.y;
431: 
432:     // Faded out in town: pinned, but no clip and no Fenrir glow behind it.
433:     if (inSafeZone) return;
434: 
435:     // A Fenrir mirrors its rider's clip family instead of the stand/move
436:     // pair, at the per-clip velocities of MoveMount.
437:     if (state.fenrirThunder) {
438:       const rider = state.owner.modelObject?.CurrentAction ?? -1;
439:       const mirrored = fenrirMountAction(rider);
440:       actor.modelObject?.setAnimationSpeed(mirrored.playSpeed);
441:       actor.modelObject?.playAction(mirrored.action, true);
442:       updateFenrirGlow(actor, dt);
443:       return;
444:     }
445: 
446:     const velocity = state.owner.movement?.velocity;
447:     const moving = !!velocity && (velocity.x !== 0 || velocity.y !== 0);
448: 
449:     actor.modelObject?.setAnimationSpeed(MOUNT_PLAY_SPEED);
450:     actor.modelObject?.playAction(
451:       moving ? state.moveAction : state.standAction,
452:       true
453:     );
454:   }
455: 
456:   return {
457:     update: dt => {
458:       const chaosCastle = inChaosCastle(world.mapIndex);
459: 
460:       for (const owner of owners) {
461:         const map = owner.worldIndex ?? world.mapIndex;
462:         const wanted = chaosCastle ? null : owner.charAppearance.pet;
463:         const spec = petSpec(wanted);
464:         // The Imp is not a world object - PlayerObject.Pet carries it.
465:         const wantsActor = spec && spec.kind !== 'imp' ? wanted : null;
466: 
467:         if (stale(spawned.get(owner), wantsActor, map)) {
468:           despawn(owner, false);
469:           if (wantsActor && spec) spawn(owner, wantsActor, spec);
470:         }
471: 
472:         // The raven rides the left-hand slot, beside whatever the pet slot holds.
473:         const raven = chaosCastle
474:           ? null
475:           : ravenOf(owner.charAppearance.leftHand);
476:         if (stale(spawnedRaven.get(owner), raven, map)) {
477:           despawn(owner, true);
478:           const ravenSpec = petSpec(raven);
479:           if (raven && ravenSpec) spawn(owner, raven, ravenSpec);
480:         }
481:       }
482: 
483:       for (const actor of actors) {
484:         const state = actor.petActor;
485: 
486:         const inSafeZone =
487:           state.owner.attributeSystem?.isAboveZero('inSafeZone') ?? false;
488: 
489:         // The raven stays visible in town: it perches instead of fading.
490:         if (state.kind === 'raven') {
491:           actor.modelObject?.setAlpha(1);
492:           if (inSafeZone) perchRaven(actor);
493:           else updateRaven(actor, dt);
494:           continue;
495:         }
496: 
497:         // The angel has no safe-zone branch of its own: it keeps flying, and
498:         // in town too. Freezing it there left the actor a town behind, with
499:         // nothing but a re-equip to bring it home.
500:         if (state.kind === 'angel') {
501:           actor.modelObject?.setAlpha(1);
502:           updateAngel(actor, dt);
503:           continue;
504:         }
505: 
506:         // A mount is faded out instead (o->Alpha = 0), but stays pinned to its
507:         // rider so it is already in place the moment he steps out of town.
508:         actor.modelObject?.setAlpha(inSafeZone ? 0 : 1);
509:         updateMount(actor, dt, inSafeZone);
510:       }
511:     },
512:   };
513: };
