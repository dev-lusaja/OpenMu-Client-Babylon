190: /** `m_iBloodCastleLimitLevel`, same two rows; seven castles plus master. */
191: export const BLOOD_CASTLE_LEVELS: readonly (readonly LevelRange[])[] = [
192:   [[15, 80], [81, 130], [131, 180], [181, 230], [231, 280], [281, 330], [331, 400]],
193:   [[10, 60], [61, 110], [111, 160], [161, 210], [211, 260], [261, 310], [311, 400]],
194: ];
