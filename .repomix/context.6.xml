 1: import type { ENUM_WORLD } from '../common/types';
 2: import type { Scene, Vector3 } from '../libs/babylon/exports';
 3: 
 4: /**
 5:  * The contract every visual effect implements. One file per effect, one
 6:  * exported `EffectLayer` per file, listed once in `layers.ts`. Copy `_template.ts` for the recipe.
 7:  *
 8:  * Effects differ from weather in one way: they are *spawned* - a skill, a
 9:  * packet or a buff asks for one at a point, and it lives for its own
10:  * duration. So the contract adds `spawn`, and `update` is where an entry
11:  * steps the effects it has spawned (its own live list, from `core.ts`).
12:  */
13: 
14: /** What a spawn hands back: enough to end it early and to ask if it is over. */
15: export interface EffectHandle {
16:   /** False once the effect has finished (or was stopped) and released its pool slots. */
17:   readonly alive: boolean;
18:   /** End it now - a buff cancelled, a flame column released, a map left. */
19:   stop(): void;
20: }
21: 
22: export interface EffectLayer<TOptions = unknown, TName extends string = string> {
23:   /** Unique camelCase, identical to the file name. */
24:   readonly name: TName;
25: 
26:   /** Maps this exists on. Omit = every map. */
27:   readonly maps?: ReadonlySet<ENUM_WORLD>;
28: 
29:   /**
30:    * Once a frame, in list order, before anything reads the system. `dt` is
31:    * seconds. Steps this entry's live effects. Must be cheap: no allocation.
32:    */
33:   update?(map: ENUM_WORLD, dt: number): void;
34: 
35:   /** Map changed: end every live effect and dispose the pools this entry owns. */
36:   reset?(): void;
37: 
38:   /**
39:    * Start one effect at `at` (world position, tiles). `opts` is the entry's
40:    * own option type - what flies where, which texture, what colour, how
41:    * long. Every effect is spawnable; the handle ends it early.
42:    */
43:   spawn(scene: Scene, at: Vector3, opts: TOptions): EffectHandle;
44: }
45: 
46: /** A handle for an effect that never started (bad options, missing target). */
47: export const DEAD_HANDLE: EffectHandle = { alive: false, stop() {} };
</file>

