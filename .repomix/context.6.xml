 16: 
 17: /**
 18:  * The sky while a dragon invasion runs. `MapEventState` (0x0B) sets the
 19:  * original's `EnableEvent` (ReceiveEvent, WSclient.cpp:6726: 1 Red Dragon,
 20:  * 3 Golden Dragon) and, while it is set, `MoveBoids` (GOBoid.cpp:1206-1223)
 21:  * does three things: it streaks MODEL_FIRE sub3 meteors over the hero with
 22:  * SOUND_METEORITE01, it subtracts light from the terrain in a 16-tile disc
 23:  * that follows them, and it fills the boid slots with dragons instead of the
 24:  * map's own birds.
 25:  *
 26:  * The meteors and the dim are here. The dragons are a boid species
 27:  * (`common/boids.ts`, `ecs/systems/boidSystem.ts`), which is where the
 28:  * original keeps them and which is why they roar from over there and not from
 29:  * this file. The banner text stays in `matchNotices.ts`.
 30:  */
 31: 
 32: // ---- 1. tuning -------------------------------------------------------------
 33: 
 34: /** `rand_fps_check(40)` at 25 ticks/s: a meteor about every 1.6 s. */
 35: const METEOR_CHANCE_PER_SECOND = 25 / 40;
 36: 
 37: /**
 38:  * MODEL_FIRE sub3 (ZzzEffect.cpp:2659-2665): Dir(0,-12,0) doubled half the
 39:  * frames (:17969) - 12 u/tick * 1.5 = 4.5 tiles/s for LifeTime 80 ticks.
 40:  */
 41: const METEOR_SPEED = 4.5;
 42: const METEOR_SECONDS = 80 / 25;
 43: const METEOR_SCALE = 0.3;
 44: 
 45: /** Spawn box off the hero (MU rand%600-200, rand%400+200, +300 - :1212-1214). */
 46: const METEOR_X = [-2, 4] as const;
 47: const METEOR_Z = [2, 6] as const;
 48: const METEOR_HEIGHT = 3;
 49: 
 50: /**
 51:  * Ours. The original's meteor throws no light - no MODEL_FIRE path calls
 52:  * AddTerrainLight - it just reads as one because everything under it has been
 53:  * darkened. The clone dims the same way (`lighting` omen below) and this is
 54:  * what the room is made for: a small travelling ember so the ground under a
 55:  * passing meteor moves, at the pool priority every event light takes.
 56:  */
 57: const METEOR_LIGHT_TILES = 4;
 58: 
 59: /** MODEL_FIRE's `o->BlendMesh = 1`: additive tail over an opaque lava core. */
 60: const FIRE_BLEND_MESH = 1;
 61: 
 62: // ---- 2. state + readers ----------------------------------------------------
 63: 
 64: const state = observable(
 65:   {
 66:     /**
 67:      * 0 none, else the `MapEventStateEventsEnum` value the server lit. Dev
 68:      * seam `?invasion=1` (Red) / `?invasion=3` (Golden): the event is
 69:      * server-driven and there is otherwise no way to stand in one to look at
 70:      * it, which the screenshot runs need.
 71:      */
 72:     event: devQueryNumber('invasion') ?? 0,
 73:     /**
 74:      * The map the server lit it for, -1 for the dev seam (every map). OpenMU
 75:      * only sends this packet to the players standing on the invasion map, and
 76:      * only sends the off to the ones still standing there, so a flag kept for
 77:      * the whole session leaves one client with dragons over a map where
 78:      * nobody else has any.
 79:      */
 80:     map: -1,
 81:   },
 82:   {},
 83:   { deep: false }
 84: );
 85: 
 86: /** The invasion the server has lit here: 0 none, 1 Red Dragon, 3 Golden Dragon. */
 87: export function invasionEvent(): number {
 88:   if (!state.event) return 0;
 89:   if (state.map < 0) return state.event;
 90:   return Store.world?.mapIndex === state.map ? state.event : 0;
 91: }
 92: 
 93: /** MoveBoids' meteor pass, one roll per frame. */
 94: function update(_map: ENUM_WORLD, dt: number): void {
 95:   const event = invasionEvent();
 96: 
 97:   // Asserted every frame rather than on the packet: a new scene builds a new
 98:   // look director, and an invasion that started before it must still be lit.
 99:   // `setOmen` is a no-op when nothing changed.
100:   lighting.omen(event ? 'invasion' : null);
101: 
102:   if (!event) return;
103:   const world = Store.world;
104:   const hero = world?.playerEntity;
105:   if (!world || !hero) return;
106:   const pos = hero.transform.pos;
107: 
108:   if (Math.random() < dt * METEOR_CHANCE_PER_SECOND) {
109:     const x = pos.x + METEOR_X[0] + Math.random() * (METEOR_X[1] - METEOR_X[0]);
110:     const z = pos.z + METEOR_Z[0] + Math.random() * (METEOR_Z[1] - METEOR_Z[0]);
111:     const from = new Vector3(x, world.getTerrainHeight(x, z) + METEOR_HEIGHT, z);
112:     // Straight along -z at spawn height, expiring in the air like sub3 does.
113:     const to = from.add(new Vector3(0, 0, -METEOR_SPEED * METEOR_SECONDS));
114:     effects.spawn('projectile', world.scene, from, {
115:       to,
116:       speed: METEOR_SPEED,
117:       model: { model: MODEL.fire, colour: RGBS.fire, scale: METEOR_SCALE, blendMesh: FIRE_BLEND_MESH },
118:       trail: { recipe: FIRE_PUFF, rate: 30 },
119:     });
120:     lighting.flash(
121:       world.scene,
122:       ember(METEOR_LIGHT_TILES, METEOR_SECONDS),
123:       { position: from.clone(), travel: { to, speed: METEOR_SPEED } }
124:     );
125:     playSfx('Sound/eMeteorite', from);
126:   }
127: }
128: 
129: // ---- packets ---------------------------------------------------------------
130: 
131: EventBus.on('MapEventState', packet => {
132:   const p = new MapEventStatePacket(packet);
133:   runInAction(() => {
134:     state.event = p.Enable ? p.Event : 0;
135:     // `ReceiveTeleport` clears `EnableEvent` on every warp (WSclient.cpp:1919)
136:     // and the server announces it again on arrival; the map it was announced
137:     // for is the same rule without the round trip.
138:     state.map = Store.world?.mapIndex ?? -1;
139:   });
140: });
141: 
142: // ---- 3. the layer ----------------------------------------------------------
143: 
144: export const invasionLayer: EventLayer = {
145:   name: 'invasion',
146:   update,
147:   state: () => ({ open: false, running: invasionEvent() !== 0 }),
148: };
</file>

