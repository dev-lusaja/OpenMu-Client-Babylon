184: const a = new Vector3();
185: const b = new Vector3();
186: const p = new Vector3();
187: const side = new Vector3();
188: const up = new Vector3(0, 1, 0);
189: let seed = 0;
190: 
191: function fillLine(points: number[], from: Vector3, to: Vector3, segments: number, jitter: number, s: number): void {
192:   to.subtractToRef(from, p);
193:   const len = p.length() || 1;
194:   Vector3.CrossToRef(p, up, side);
195:   side.normalize();
196:   for (let i = 0; i <= segments; i++) {
197:     const t = i / segments;
198:     const k = Math.sin(t * Math.PI) * jitter * len;
199:     const jx = (hash(s + i * 1.37) - 0.5) * 2 * k;
200:     const jy = (hash(s + i * 2.71) - 0.5) * 2 * k;
201:     const o = i * 3;
202:     points[o] = from.x + p.x * t + side.x * jx;
203:     points[o + 1] = from.y + p.y * t + jy;
204:     points[o + 2] = from.z + p.z * t + side.z * jx;
205:   }
206: }
207: 
208: function park(points: number[]): void {
209:   for (let i = 0; i < points.length; i += 3) {
210:     points[i] = 0;
211:     points[i + 1] = PARKED_Y;
212:     points[i + 2] = 0;
213:   }
214: }
215: 
216: interface Line {
217:   mesh: GreasedLineMesh;
218:   /** Set the ribbon's fade 0…1 (the original's `Alpha` on the tail quads). */
219:   fade(vis: number): void;
220:   /** Step the thunder scroll; a no-op without `textureScroll`. */
221:   scroll(): void;
222: }
223: 
224: /**
225:  * The U along the ribbon per point slot - the original's
226:  * `(NumTails − j) / (MaxTails − 1)`: the head end at `repeats`, the oldest
227:  * tail at 0 (ZzzEffectJoint.cpp:7036). Four floats per point, matching the
228:  * two side vertices GreasedLine builds per point; explicit because the
229:  * auto-UVs divide by the line's *initial* length, and every joint here is
230:  * born with all points on one spot.
231:  */
232: function rampUVs(lines: number[][], repeats: number): number[] {
233:   const uvs: number[] = [];
234:   for (const line of lines) {
235:     const points = line.length / 3;
236:     for (let i = 0; i < points; i++) {
237:       const u = (1 - i / (points - 1)) * repeats;
238:       uvs.push(u, 0, u, 1);
239:     }
240:   }
241:   return uvs;
242: }
243: 
244: /**
245:  * `taper`'s width multipliers, two per point (lower, upper). Point 0 is the
246:  * head (`spawnTrail` shifts the history down from slot 0), so the nose is
247:  * rounded off over the first tenth and the rest falls to a point at the tail.
248:  */
249: function taperWidths(lines: number[][]): number[] {
250:   const widths: number[] = [];
251:   for (const line of lines) {
252:     const points = line.length / 3;
253:     for (let i = 0; i < points; i++) {
254:       const s = points > 1 ? i / (points - 1) : 0;
255:       const nose = Math.min(1, NOSE_WIDTH + s * (1 - NOSE_WIDTH) / NOSE_SPAN);
256:       const w = nose * Math.pow(1 - s, TAIL_FALLOFF);
257:       widths.push(w, w);
258:     }
259:   }
260:   return widths;
261: }
262: 
263: function makeLine(scene: Scene, lines: number[][], colour: RGB, width: number, opts: JointOptions): Line {
264:   const blend = opts.blend ?? 'add';
265:   const sheetFile = opts.texture;
266:   const textured = !!sheetFile;
267:   const repeats = opts.textureRepeats ?? 1;
268:   const dark = blend === 'subtract' && textured;
269:   const alphaMode = dark
270:     ? Constants.ALPHA_COMBINE
271:     : blend === 'subtract'
272:       ? Constants.ALPHA_SUBTRACT
273:       : Constants.ALPHA_ADD;
274:   const mesh = CreateGreasedLine(
275:     'fxJoint',
276:     {
277:       points: lines,
278:       updatable: true,
279:       ...(textured ? { uvs: rampUVs(lines, repeats) } : {}),
280:       ...(opts.taper ? { widths: taperWidths(lines) } : {}),
281:     },
282:     {
283:       // With a texture the colour rides in `emissiveColor` below - the plugin's
284:       // own colour would *replace* the sampled texel (COLOR_MODE_SET).
285:       ...(textured ? {} : { color: new Color3(colour[0], colour[1], colour[2]) }),
286:       width,
287:       sizeAttenuation: false,
288:       materialType: textured
289:         ? GreasedLineMeshMaterialType.MATERIAL_TYPE_STANDARD
290:         : GreasedLineMeshMaterialType.MATERIAL_TYPE_SIMPLE,
291:     },
292:     scene
293:   ) as GreasedLineMesh;
294:   mesh.isPickable = false;
295:   mesh.doNotSyncBoundingInfo = true;
296:   mesh.alwaysSelectAsActiveMesh = true;
297: 
298:   // The length-cutoff uniform lives on the greased-line side of either
299:   // material type; it is a reveal, not a fade, so it only gates load state.
300:   const glMat = mesh.greasedLineMaterial as IGreasedLineMaterial | undefined;
301:   let sheet: Texture | null = null;
302:   let fade: (vis: number) => void;
303: 
304:   if (sheetFile) {
305:     // The plugin defaults to white + COLOR_MODE_SET when no color is given,
306:     // overwriting the shaded texel with a flat band; null keeps ours.
307:     if (glMat) glMat.color = null;
308:     // The sheet × `Light` under the joint's blend - the same Standard set-up
309:     // as core.ts `additiveMaterial` (texel × emissive tint, lighting off).
310:     // A dark ribbon instead draws black with the sheet as its coverage, for
311:     // the reason model.ts `subtractMaterial` gives: coverage is the only
312:     // channel a gain can push past the sheet's own levels.
313:     const std = mesh.material as StandardMaterial;
314:     const gain = dark ? luma(colour) * darkCardGain(scene) : lightCardGain(scene);
315:     std.diffuseColor.set(0, 0, 0);
316:     std.specularColor.set(0, 0, 0);
317:     std.ambientColor.set(0, 0, 0);
318:     std.emissiveColor.set(dark ? 0 : colour[0] * gain, dark ? 0 : colour[1] * gain, dark ? 0 : colour[2] * gain);
319:     std.alpha = dark ? gain : 1;
320:     std.disableLighting = true;
321:     std.alphaMode = alphaMode;
322:     std.transparencyMode = Material.MATERIAL_ALPHABLEND;
323:     std.backFaceCulling = false;
324:     std.disableDepthWrite = true;
325:     std.fogEnabled = false;
326:     // Hold the line unseen until the sheet is in - a texture-less Standard
327:     // ribbon is exactly the solid band this is here to remove.
328:     if (glMat) glMat.visibility = -1;
329:     void effectTexture(scene, sheetFile).then(tex => {
330:       if (mesh.isDisposed()) return;
331:       // Thunder scrolls and tiles along U (loaded GL_REPEAT in the original);
332:       // the shared texture's wrap only matters to other joints of the same
333:       // sheet, which want the same thing.
334:       if (repeats !== 1 || opts.textureScroll) tex.wrapU = Texture.WRAP_ADDRESSMODE;
335:       sheet = tex;
336:       if (dark) {
337:         tex.getAlphaFromRGB = true;
338:         std.opacityTexture = tex;
339:       } else {
340:         std.diffuseTexture = tex;
341:       }
342:       if (glMat) glMat.visibility = 1;
343:     });
344:     // A real brightness fade: the emissive tint toward black fades a bright
345:     // ribbon out, the coverage toward zero a dark one.
346:     fade = dark
347:       ? vis => (std.alpha = gain * vis)
348:       : vis => std.emissiveColor.set(colour[0] * gain * vis, colour[1] * gain * vis, colour[2] * gain * vis);
349:   } else {
350:     const std = mesh.material;
351:     if (std) {
352:       std.alpha = 0.99;
353:       std.alphaMode = alphaMode;
354:       std.disableDepthWrite = true;
355:       std.backFaceCulling = false;
356:     }
357:     // The simple material has no per-fragment alpha; the length cutoff is
358:     // the closest thing to the original's die-out.
359:     fade = vis => {
360:       if (glMat) glMat.visibility = vis;
361:     };
362:   }
363: 
364:   // The item halo layer draws every active mesh and would rasterise the
365:   // ribbon into its map for nothing (no tier, no trim); the ribbon's halo is
366:   // the effects layer's.
367:   (scene as TestScene).look?.glow.addExcludedMesh(mesh);
368: 
369:   // A subtractive ribbon darkens what is behind it; blooming it would re-add
370:   // the light it just took away.
371:   if (blend !== 'subtract') addEffectGlow(scene, mesh);
372: 
373:   const scrollRate = opts.textureScroll ?? 0;
374:   return {
375:     mesh,
376:     fade,
377:     scroll:
378:       scrollRate > 0
379:         ? () => {
380:             // The original's global `WorldTime % 1000 * 0.001` - every thunder
381:             // joint writes the same value, so sharing the texture is safe.
382:             if (sheet) sheet.uOffset = -((fxNow() * scrollRate) % 1);
383:           }
384:         : () => {},
385:   };
386: }
387: 
388: function disposeLine(scene: Scene, line: Line, lines: number[][]): void {
389:   const mesh = line.mesh;
390:   for (const l of lines) park(l);
391:   releaseEffectGlow(mesh);
392:   (scene as TestScene).look?.glow.removeExcludedMesh(mesh);
393:   // Never dispose the shared empty-colours texture, and never through the
394:   // public `colorsTexture` setter - greasedLineRelease.ts documents both traps.
395:   releaseGreasedLineMaterial(mesh);
396:   mesh.dispose();
397: }
398: 
399: /** A bolt between two ends (the original shape of this entry). */
400: function spawnBolt(scene: Scene, at: Vector3, opts: JointOptions): EffectHandle {
401:   const colour = opts.colour ?? RGBS.arc;
402:   const seconds = opts.seconds ?? DEFAULT_SECONDS;
403:   const segments = opts.segments ?? DEFAULT_SEGMENTS;
404:   const jitter = opts.jitter ?? DEFAULT_JITTER;
405:   const forks = Math.min(MAX_FORKS, opts.forks ?? 0);
406:   const height = opts.height ?? 0;
407:   const near = opts.from ?? pointSource(at);
408:   const far = pointSource(opts.to ?? at);
409: 
410:   const lines: number[][] = [];
411:   for (let i = 0; i < 1 + forks; i++) lines.push(new Array<number>((segments + 1) * 3).fill(0));
412:   const line = makeLine(scene, lines, colour, opts.width ?? DEFAULT_WIDTH, opts);
413:   const mesh = line.mesh;
414: 
415:   let t = 0;
416:   let sinceRoll = REROLL_SECONDS;
417:   let s = seed++ * 7.13;
418:   const forkFrom = new Vector3();
419:   const forkTo = new Vector3();
420: 
421:   return live.push({
422:     update(dt) {
423:       t += dt;
424:       const prog = t / seconds;
425:       if (prog >= 1 || opts.until?.()) return false;
426:       sinceRoll += dt;
427:       near(a);
428:       far(b);
429:       a.y += height;
430:       b.y += height;
431:       if (sinceRoll >= REROLL_SECONDS) {
432:         sinceRoll = 0;
433:         s += 3.3;
434:         fillLine(lines[0], a, b, segments, jitter, s);
435:         for (let f = 1; f <= forks; f++) {
436:           const at = 0.3 + hash(s + f) * 0.4;
437:           const o = Math.floor(at * segments) * 3;
438:           forkFrom.set(lines[0][o], lines[0][o + 1], lines[0][o + 2]);
439:           const len = Vector3.Distance(a, b) * 0.35;
440:           forkTo.set(
441:             forkFrom.x + (hash(s + f * 1.1) - 0.5) * 2 * len,
442:             forkFrom.y + (hash(s + f * 1.3) - 0.8) * len,
443:             forkFrom.z + (hash(s + f * 1.7) - 0.5) * 2 * len
444:           );
445:           fillLine(lines[f], forkFrom, forkTo, segments, jitter * 1.5, s + f * 11);
446:         }
447:         mesh.setPoints(lines);
448:       }
449:       line.scroll();
450:       line.fade(fadeOut(prog, opts.fadeTail ?? 0.3) * (0.6 + 0.4 * hash(t * 97)));
451:       return true;
452:     },
453:     release() {
454:       disposeLine(scene, line, lines);
455:     },
456:   });
457: }
458: 
459: /** A head with its last `maxTails` positions behind it (C++ Velocity / MaxTails). */
460: function spawnTrail(scene: Scene, at: Vector3, opts: JointOptions): EffectHandle {
461:   const colour = opts.colour ?? RGBS.arc;
462:   const seconds = opts.seconds ?? DEFAULT_SECONDS;
463:   const tails = Math.max(1, opts.maxTails ?? DEFAULT_TAILS);
464:   const height = opts.height ?? 0;
465:   const velocity = opts.velocity ?? 0;
466:   const turn = opts.turn ?? 0;
467:   const gravity = opts.gravity ?? 0;
468:   const steer = opts.steer;
469:   const heading = opts.heading ? opts.heading.clone().normalize() : new Vector3(0, 0, 1);
470:   let yaw = Math.atan2(heading.x, heading.z);
471:   let pitch = Math.asin(Math.max(-1, Math.min(1, heading.y)));
472:   let vy = velocity * Math.sin(pitch);
473:   // Wander momentum, radians per tick (the original's `Direction[0]`/`[2]`).
474:   let wanderPitch = 0;
475:   let wanderYaw = 0;
476:   const seekPoint = new Vector3();
477: 
478:   const head = new Vector3(at.x, at.y + height, at.z);
479:   if (opts.head) {
480:     opts.head(head);
481:     head.y += height;
482:   }
483:   const line = new Array<number>((tails + 1) * 3).fill(0);
484:   for (let i = 0; i <= tails; i++) {
485:     line[i * 3] = head.x;
486:     line[i * 3 + 1] = head.y;
487:     line[i * 3 + 2] = head.z;
488:   }
489:   const lines = [line];
490:   const ribbon = makeLine(scene, lines, colour, opts.width ?? DEFAULT_WIDTH, opts);
491:   const mesh = ribbon.mesh;
492: 
493:   let t = 0;
494:   let sinceSample = 0;
495: 
496:   return live.push({
497:     update(dt) {
498:       t += dt;
499:       const prog = t / seconds;
500:       if (prog >= 1 || opts.until?.()) return false;
501:       if (opts.head) {
502:         opts.head(head);
503:         head.y += height;
504:       } else if (steer) {
505:         // Flight from the live angles; the angles themselves step at tick
506:         // cadence below, like the original's 25 Hz frames.
507:         const flat = velocity * Math.cos(pitch);
508:         head.x += Math.sin(yaw) * flat * dt;
509:         head.z += Math.cos(yaw) * flat * dt;
510:         head.y += velocity * Math.sin(pitch) * dt;
511:       } else {
512:         yaw += turn * dt;
513:         const flat = velocity * Math.cos(pitch);
514:         vy -= gravity * dt;
515:         head.x += Math.sin(yaw) * flat * dt;
516:         head.z += Math.cos(yaw) * flat * dt;
517:         head.y += vy * dt;
518:       }
519:       sinceSample += dt;
520:       if (sinceSample >= TAIL_SAMPLE_SECONDS) {
521:         sinceSample = 0;
522:         if (steer) {
523:           if (steer.seek) {
524:             // MoveHumming: turn toward the target by at most `seekRate`.
525:             steer.seek(seekPoint);
526:             const dx = seekPoint.x - head.x;
527:             const dy = seekPoint.y - head.y;
528:             const dz = seekPoint.z - head.z;
529:             const rate = steer.seekRate ?? (10 * Math.PI) / 180;
530:             const dYaw = Math.atan2(dx, dz) - yaw;
531:             yaw += Math.max(-rate, Math.min(rate, Math.atan2(Math.sin(dYaw), Math.cos(dYaw))));
532:             const dPitch = Math.atan2(dy, Math.hypot(dx, dz) || 1) - pitch;
533:             pitch += Math.max(-rate, Math.min(rate, dPitch));
534:           }
535:           const w = steer.wander;
536:           if (w) {
537:             wanderPitch += (Math.random() * 2 - 1) * w.pitch;
538:             wanderYaw += (Math.random() * 2 - 1) * w.yaw;
539:             pitch += wanderPitch;
540:             yaw += wanderYaw;
541:             wanderPitch *= WANDER_DAMP_PITCH;
542:             wanderYaw *= WANDER_DAMP_YAW;
543:           }
544:           const band = steer.band;
545:           if (band) {
546:             // -9999 until the map's height data is in; skip the clamp then.
547:             const ground = Store.world?.getTerrainHeight(head.x, head.z) ?? -9999;
548:             if (ground > -9000) {
549:               if (head.y < ground + band.floor) {
550:                 wanderPitch = 0;
551:                 pitch = BAND_ESCAPE_PITCH;
552:               } else if (head.y > ground + band.ceiling) {
553:                 wanderPitch = 0;
554:                 pitch = -BAND_ESCAPE_PITCH;
555:               }
556:             }
557:           }
558:         }
559:         // Shift the history back one slot; slot 0 is the head.
560:         line.copyWithin(3, 0, tails * 3);
561:         opts.trace?.(head);
562:       }
563:       line[0] = head.x;
564:       line[1] = head.y;
565:       line[2] = head.z;
566:       mesh.setPoints(lines);
567:       ribbon.scroll();
568:       ribbon.fade(fadeOut(prog, opts.fadeTail ?? 0.3));
569:       return true;
570:     },
571:     release() {
572:       disposeLine(scene, ribbon, lines);
573:     },
574:   });
575: }
576: 
577: /** Spawn helper other entries call directly (aura's orbit ribbons). */
578: export function spawnJoint(scene: Scene, at: Vector3, opts: JointOptions): EffectHandle {
579:   return opts.head || opts.velocity !== undefined ? spawnTrail(scene, at, opts) : spawnBolt(scene, at, opts);
580: }
581: 
582: function spawn(scene: Scene, at: Vector3, opts: JointOptions): EffectHandle {
583:   return spawnJoint(scene, at, opts);
584: }
