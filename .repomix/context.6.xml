 62: /** `GetEquipedBowType(c) == BOWTYPE_CROSSBOW` - picks the crossbow variants. */
 63: function equippedCrossbow(hands: Hands | undefined): boolean {
 64:   if (!hands) return false;
 65:   return isCrossbow(hands.leftHand) || isCrossbow(hands.rightHand);
 66: }
 67: 
 68: function isArmed(hands: Hands | undefined): boolean {
 69:   if (!hands) return false;
 70:   return isWeaponItem(hands.leftHand) || isWeaponItem(hands.rightHand);
 71: }
