<file path="src/ecs/systems/ceilingHideSystem.ts">
  1: import type { AbstractMesh } from '../../libs/babylon/exports';
  2: import { ENUM_WORLD } from '../../common/types';
  3: import { lookDirector } from '../../lighting/director';
  4: import type { RoomVolume } from '../../lighting/profiles';
  5: import type { ISystemFactory } from '../world';
  6: 
  7: /**
  8:  * Fades out the ceiling of the building the hero is standing in, so the
  9:  * inside stays readable from the fixed camera. The original never hides
 10:  * roofs (its only object fade is the Chaos Castle one, ZzzObject.cpp:228);
 11:  * this is the Devias counterpart of the Lorencia pub hack in
 12:  * loadMapIntoScene, which lifts HOUSE_WALL05/06 out of view.
 13:  *
 14:  * Data-driven rather than a per-type table: Devias buildings are tiled from
 15:  * wall/roof pieces (Object3 types 15-18, 33-34, 62-63, …) whose roof
 16:  * sub-meshes sit 2.4-3.6 tiles up, while wall meshes start at the floor. A
 17:  * mesh is "a ceiling piece" when its world AABB is a thin slab above head
 18:  * height. The piece over the hero seeds a flood fill through touching pieces
 19:  * at about the same height, so the whole roof of that building fades, not
 20:  * just the tile above him. While a room is the active area its frame seeds
 21:  * the set instead: every slab whose centre lies inside it, whole roof, however
 22:  * long the room (§13 F11).
 23:  */
 24: 
 25: const ENABLED_WORLDS = new Set<ENUM_WORLD>([
 26:   ENUM_WORLD.WD_0LORENCIA,
 27:   ENUM_WORLD.WD_2DEVIAS,
 28: ]);
 29: 
 30: /** Slab bottom must be this far (tiles) above the hero's feet: clears his head. */
 31: const ABOVE_HEAD = 1.0;
 32: 
 33: /**
 34:  * Whether a submesh standing on the ground at `ground` could be a ceiling
 35:  * piece this system fades: the slab test below, without the hero. The prop
 36:  * batches keep any type that answers yes on the per-object path, because a
 37:  * batched mesh has no visibility of its own to fade.
 38:  */
 39: export function mayBeCeilingPiece(
 40:   map: ENUM_WORLD,
 41:   minY: number,
 42:   maxY: number,
 43:   ground: number
 44: ): boolean {
 45:   if (!ENABLED_WORLDS.has(map)) return false;
 46: 
 47:   return minY >= ground + ABOVE_HEAD && maxY - minY <= MAX_THICKNESS;
 48: }
 49: /**
 50:  * How far (tiles) under the room's roof underside a slab may still start and
 51:  * count as roof.
 52:  *
 53:  * Inside a room the frame says where the ceiling is, and only that height is
 54:  * ceiling. "Above the hero's head" is not: the Lorencia pub stands its
 55:  * candelabra, bottles and cups on tables between 2.7 and 3.6, its roof
 56:  * underside at 4.28, and the head-height rule faded all of them out of the
 57:  * room the moment it became the active area. Same slack as `SAME_ROOF_HEIGHT`,
 58:  * for pieces of one roof whose bases were measured off different walls.
 59:  */
 60: const ROOF_SLACK = 0.6;
 61: /** Footprint slack (tiles) for the hero-under test. */
 62: const FOOTPRINT_MARGIN = 0.25;
 63: /** Gap (tiles) across which two pieces still count as one roof. */
 64: const TOUCH_MARGIN = 0.05;
 65: /** Height difference (tiles) allowed between two pieces of the same roof. */
 66: const SAME_ROOF_HEIGHT = 0.6;
 67: /** Taller boxes are tree crowns / poles, not ceilings. */
 68: const MAX_THICKNESS = 2.5;
 69: /** Objects further than this (tiles, per axis) are not part of the building. */
 70: const OBJECT_REACH = 12;
 71: /**
 72:  * Flood-fill radius (tiles) around the hero. Devias shop rows abut exactly,
 73:  * so touching alone would chain a whole street of roofs; a building is at
 74:  * most ~8 tiles across.
 75:  */
 76: const ROOF_RADIUS = 8;
 77: /** Fade speed, visibility per second. */
 78: const FADE_SPEED = 5;
 79: /**
 80:  * The roof set only changes when the hero moves to a different tile, so the
 81:  * slab collection + flood fill (which walks every visible object's child
 82:  * meshes) is gated on that rather than run every frame. Sub-tile movement
 83:  * cannot change which building he is inside; it can only shift the
 84:  * footprint test by at most half a tile at a roof's edge, which the 0.2 s
 85:  * fade already smears over.
 86:  */
 87: const RESCAN_TILE = 1;
 88: /**
 89:  * Fallback re-scan. A model finishing its async load, or a roof piece being
 90:  * disposed at the visibility boundary, changes the answer without the hero
 91:  * moving. Four scans a second covers that and is still ~15x cheaper than
 92:  * the per-frame scan this replaces.
 93:  */
 94: const RESCAN_INTERVAL = 0.25;
 95: 
 96: let heroUnderRoof = false;
 97: 
 98: /** True while the hero stands under a ceiling this system is hiding (weather must not fall in). */
 99: export function isHeroUnderRoof(): boolean {
100:   return heroUnderRoof;
101: }
102: 
103: interface Slab {
104:   mesh: AbstractMesh;
105:   minX: number;
106:   maxX: number;
107:   minZ: number;
108:   maxZ: number;
109:   minY: number;
110: }
111: 
112: export const CeilingHideSystem: ISystemFactory = world => {
113:   const query = world.with('modelObject', 'transform', 'visibility', 'worldIndex');
114: 
115:   /** Meshes currently faded (or fading back in). */
116:   const fading = new Map<AbstractMesh, { hide: boolean }>();
117: 
118:   const slabs: Slab[] = [];
119: 
120:   /**
121:    * The roof the hero is under, carried between scans. The fade loop reads
122:    * this every frame; only the scan that produces it is gated.
123:    */
124:   let roofMeshes: AbstractMesh[] = [];
125:   let lastTileX = NaN;
126:   let lastTileZ = NaN;
127:   let lastMapIndex: ENUM_WORLD | null = null;
128:   let lastRoom = '';
129:   let sinceRescan = RESCAN_INTERVAL;
130: 
131:   const roomKey = (room: RoomVolume | null) =>
132:     room ? `${room.minX},${room.minY},${room.maxX},${room.maxY}` : '';
133: 
134:   /** Whether the slab's centre lies inside the room's frame. */
135:   function inRoom(s: Slab, room: RoomVolume): boolean {
136:     const cx = (s.minX + s.maxX) * 0.5;
137:     const cz = (s.minZ + s.maxZ) * 0.5;
138: 
139:     return cx >= room.minX && cx <= room.maxX && cz >= room.minY && cz <= room.maxY;
140:   }
141: 
142:   function collectSlabs(heroY: number, hx: number, hz: number, room: RoomVolume | null) {
143:     slabs.length = 0;
144: 
145:     // A room knows where its ceiling is; outside one, head height is the only
146:     // measure there is.
147:     const slabFloor = room ? room.roofY - ROOF_SLACK : heroY + ABOVE_HEAD;
148: 
149:     for (const e of query) {
150:       if (e.worldIndex !== world.mapIndex) continue;
151:       if (e.visibility.state !== 'visible') continue;
152: 
153:       const { pos } = e.transform;
154:       if (room) {
155:         if (pos.x < room.minX - OBJECT_REACH || pos.x > room.maxX + OBJECT_REACH) continue;
156:         if (pos.z < room.minY - OBJECT_REACH || pos.z > room.maxY + OBJECT_REACH) continue;
157:       } else {
158:         if (Math.abs(pos.x - hx) > OBJECT_REACH) continue;
159:         if (Math.abs(pos.z - hz) > OBJECT_REACH) continue;
160:       }
161: 
162:       const mo = e.modelObject;
163:       if (!mo.Ready || !mo.gltf) continue;
164: 
165:       for (const mesh of mo.gltf.mesh.getChildMeshes(false)) {
166:         if (mesh.metadata?.SkipBoundingBox) continue;
167:         if (mesh.getTotalVertices() === 0) continue;
168: 
169:         const box = mesh.getBoundingInfo().boundingBox;
170:         const min = box.minimumWorld;
171:         const max = box.maximumWorld;
172: 
173:         if (min.y < slabFloor) continue;
174:         if (max.y - min.y > MAX_THICKNESS) continue;
175: 
176:         const cx = (min.x + max.x) * 0.5 - hx;
177:         const cz = (min.z + max.z) * 0.5 - hz;
178:         if (!room && cx * cx + cz * cz > ROOF_RADIUS * ROOF_RADIUS) continue;
179: 
180:         slabs.push({
181:           mesh,
182:           minX: min.x,
183:           maxX: max.x,
184:           minZ: min.z,
185:           maxZ: max.z,
186:           minY: min.y,
187:         });
188:       }
189:     }
190:   }
191: 
192:   function touches(a: Slab, b: Slab): boolean {
193:     if (Math.abs(a.minY - b.minY) > SAME_ROOF_HEIGHT) return false;
194:     return (
195:       a.minX <= b.maxX + TOUCH_MARGIN &&
196:       b.minX <= a.maxX + TOUCH_MARGIN &&
197:       a.minZ <= b.maxZ + TOUCH_MARGIN &&
198:       b.minZ <= a.maxZ + TOUCH_MARGIN
199:     );
200:   }
201: 
202:   function markHide(mesh: AbstractMesh) {
203:     const entry = fading.get(mesh);
204:     if (entry) entry.hide = true;
205:     else fading.set(mesh, { hide: true });
206:   }
207: 
208:   return {
209:     update: dt => {
210:       const hero = world.playerEntity;
211:       const enabled = ENABLED_WORLDS.has(world.mapIndex) && !!hero;
212: 
213:       sinceRescan += dt;
214: 
215:       if (enabled) {
216:         const ht = hero.transform;
217:         const hx = ht.pos.x + (ht.posOffset?.x ?? 0);
218:         const hy = ht.pos.y;
219:         const hz = ht.pos.z + (ht.posOffset?.z ?? 0);
220: 
221:         const tileX = Math.floor(hx / RESCAN_TILE);
222:         const tileZ = Math.floor(hz / RESCAN_TILE);
223:         // The frame, not the footprint: a room whose volume the map never
224:         // measured cannot say where its roof is, so it falls back to the
225:         // hero-seeded fill rather than fading everything standing in it.
226:         const area = lookDirector()?.state().area ?? null;
227:         const room = area?.volume ?? null;
228:         const roomNow = roomKey(room);
229: 
230:         // Gate: re-derive the roof only when the hero changes tile, the map
231:         // or the room changes, or the fallback interval expires. Everything
232:         // else in this system is the per-frame fade, which is O(faded meshes).
233:         if (
234:           tileX !== lastTileX ||
235:           tileZ !== lastTileZ ||
236:           world.mapIndex !== lastMapIndex ||
237:           roomNow !== lastRoom ||
238:           sinceRescan >= RESCAN_INTERVAL
239:         ) {
240:           lastTileX = tileX;
241:           lastTileZ = tileZ;
242:           lastMapIndex = world.mapIndex;
243:           lastRoom = roomNow;
244:           sinceRescan = 0;
245: 
246:           collectSlabs(hy, hx, hz, room);
247: 
248:           const roof: Slab[] = [];
249:           const inRoof = new Set<Slab>();
250: 
251:           if (room) {
252:             // The room's whole roof: every slab over its frame.
253:             for (const s of slabs) {
254:               if (inRoom(s, room)) {
255:                 roof.push(s);
256:                 inRoof.add(s);
257:               }
258:             }
259:           } else {
260:             // Seeds: slabs directly over the hero.
261:             for (const s of slabs) {
262:               if (
263:                 hx >= s.minX - FOOTPRINT_MARGIN &&
264:                 hx <= s.maxX + FOOTPRINT_MARGIN &&
265:                 hz >= s.minZ - FOOTPRINT_MARGIN &&
266:                 hz <= s.maxZ + FOOTPRINT_MARGIN
267:               ) {
268:                 roof.push(s);
269:                 inRoof.add(s);
270:               }
271:             }
272: 
273:             // Flood fill through touching pieces: the rest of this building's roof.
274:             for (let i = 0; i < roof.length; i++) {
275:               const a = roof[i];
276:               for (const b of slabs) {
277:                 if (inRoof.has(b)) continue;
278:                 if (!touches(a, b)) continue;
279:                 roof.push(b);
280:                 inRoof.add(b);
281:               }
282:             }
283:           }
284: 
285:           roofMeshes = roof.map(s => s.mesh);
286:           heroUnderRoof = roofMeshes.length > 0 || area !== null;
287:         }
288: 
289:         // Re-assert the hide flag every frame from the carried set: the fade
290:         // loop below clears it, and a mesh that dropped out of the set on the
291:         // last scan is simply no longer re-marked, so it fades back in.
292:         for (let i = roofMeshes.length - 1; i >= 0; i--) {
293:           const mesh = roofMeshes[i];
294:           if (mesh.isDisposed()) {
295:             // Disposed at the visibility boundary; drop it and re-scan next
296:             // frame so the rest of that building is re-evaluated.
297:             roofMeshes.splice(i, 1);
298:             sinceRescan = RESCAN_INTERVAL;
299:             continue;
300:           }
301:           markHide(mesh);
302:         }
303:       } else {
304:         if (roofMeshes.length > 0) roofMeshes = [];
305:         lastTileX = NaN;
306:         lastTileZ = NaN;
307:         lastMapIndex = null;
308:         lastRoom = '';
309:         heroUnderRoof = false;
310:       }
311: 
312:       if (fading.size === 0) return;
313: 
314:       const step = FADE_SPEED * dt;
315: 
316:       for (const [mesh, entry] of fading) {
317:         if (mesh.isDisposed()) {
318:           fading.delete(mesh);
319:           continue;
320:         }
321: 
322:         if (entry.hide) {
323:           mesh.visibility = Math.max(0, mesh.visibility - step);
324:           // A faded slab must leave the depth passes too (G-buffer, room
325:           // mask, cascades): they test isVisible, not visibility, and a
326:           // roof gone from the frame but present in the depth would black
327:           // out the floor under it.
328:           if (mesh.visibility <= 0) mesh.isVisible = false;
329:           // Re-evaluated next frame; anything no longer part of the roof fades back.
330:           entry.hide = false;
331:         } else {
332:           mesh.isVisible = true;
333:           mesh.visibility = Math.min(1, mesh.visibility + step);
334:           if (mesh.visibility >= 1) fading.delete(mesh);
335:         }
336:       }
337:     },
338:   };
339: };
</file>

<file path="src/ecs/systems/characterLightSystem.ts">
 1: import type { ISystemFactory } from '../world';
 2: import { lighting } from '../../lighting';
 3: import { characterLightFor } from '../../lighting/characters';
 4: 
 5: /**
 6:  * Consumer of the lighting layer's `characters` entry: walks the entities
 7:  * that have an `npcType` and asks the entry to light the ones its table
 8:  * names, drop the dying, and re-light after a map load (which disposes every
 9:  * source). Owns no lighting state - `src/lighting/characters.ts` does.
10:  */
11: export const CharacterLightSystem: ISystemFactory = world => {
12:   const characters = world.with('npcType', 'modelObject', 'transform');
13: 
14:   characters.onEntityRemoved.subscribe(e => lighting.snuffCharacter(e));
15: 
16:   return {
17:     update: () => {
18:       for (const e of characters) {
19:         if (!characterLightFor(e.npcType)) continue;
20: 
21:         if (e.dying) {
22:           lighting.snuffCharacter(e);
23:           continue;
24:         }
25: 
26:         if (lighting.characterIsLit(e) || !e.modelObject.Ready) continue;
27: 
28:         lighting.lightCharacter(world.scene, e);
29:       }
30:     },
31:   };
32: };
