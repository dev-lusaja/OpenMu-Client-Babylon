<file path="src/ecs/systems/combatSfxSystem.ts">
  1: import type { ISystemFactory } from '../world';
  2: import { MonsterActionType, PlayerAction } from '../../common/objects/enum';
  3: import { isPlayerAttackAction } from '../../common/playerActionMapper';
  4: import { monsterModelTypeOf } from '../../common/playSpeed';
  5: import type { CharacterClassNumber } from '../../common/types';
  6: import {
  7:   COMBAT_BUS,
  8:   MONSTER_ASSASSIN,
  9:   MONSTER_BUS,
 10:   monsterAttackSound,
 11:   monsterDeathSound,
 12:   monsterIdleSound,
 13:   playerDeathSound,
 14:   playerPainSound,
 15:   playerSwingSound,
 16: } from '../../common/combatSounds';
 17: import { playSfx, setSfxListener } from '../../libs/sfx';
 18: import { Store } from '../../store';
 19: 
 20: /**
 21:  * Plays the sounds the original client fires on `AnimationFrame == 0` of a
 22:  * freshly set action (SetPlayerStop / SetPlayerWalk / SetPlayerAttack /
 23:  * SetPlayerShock / SetPlayerDie, ZzzCharacter.cpp:347, :706, :1196, :1321,
 24:  * :1452): every entity's ModelObject bumps `actionSerial` when a clip
 25:  * (re)starts, and this system reacts to the bump.
 26:  *
 27:  * Monster idle / walk chatter is `rand_fps_check(16)` at the moment the
 28:  * action is set, i.e. a 1-in-16 roll per stop/walk transition - not a
 29:  * per-frame roll.
 30:  */
 31: 
 32: const IDLE_CHATTER_CHANCE = 1 / 16;
 33: 
 34: export const CombatSfxSystem: ISystemFactory = world => {
 35:   const query = world.with('modelObject', 'transform');
 36:   const seen = new WeakMap<object, number>();
 37: 
 38:   function classOf(e: (typeof query.entities)[number]): CharacterClassNumber {
 39:     return (
 40:       e.charAppearance?.charClass ??
 41:       (e.localPlayer ? Store.playerData.charClass : undefined) ??
 42:       (e.attributeSystem?.getValue('playerNetClass') as CharacterClassNumber)
 43:     );
 44:   }
 45: 
 46:   return {
 47:     update: () => {
 48:       const hero = world.playerEntity;
 49:       if (hero) setSfxListener(hero.transform.pos.x, hero.transform.pos.z);
 50: 
 51:       for (const e of query) {
 52:         const model = e.modelObject;
 53:         const serial = model.actionSerial;
 54:         const prev = seen.get(model);
 55:         if (prev === serial) continue;
 56:         seen.set(model, serial);
 57:         // First sighting: the spawn pose is not an event.
 58:         if (prev === undefined) continue;
 59: 
 60:         const pos = e.transform.pos;
 61:         const action = model.CurrentAction;
 62: 
 63:         if (e.monsterAnimation) {
 64:           const type = monsterModelTypeOf(e.npcType);
 65:           switch (action) {
 66:             case MonsterActionType.Attack1:
 67:             case MonsterActionType.Attack2:
 68:             case MonsterActionType.Attack3:
 69:             case MonsterActionType.Attack4: {
 70:               const sfx = monsterAttackSound(type);
 71:               if (sfx) playSfx(sfx, pos, { bus: MONSTER_BUS });
 72:               break;
 73:             }
 74:             case MonsterActionType.Shock: {
 75:               if (type === MONSTER_ASSASSIN) break;
 76:               const sfx = monsterAttackSound(type);
 77:               if (sfx) playSfx(sfx, pos, { bus: MONSTER_BUS });
 78:               break;
 79:             }
 80:             case MonsterActionType.Die: {
 81:               const sfx = monsterDeathSound(type);
 82:               if (sfx) playSfx(sfx, pos, { bus: MONSTER_BUS });
 83:               break;
 84:             }
 85:             case MonsterActionType.Stop1:
 86:             case MonsterActionType.Walk: {
 87:               if (Math.random() >= IDLE_CHATTER_CHANCE) break;
 88:               const sfx = monsterIdleSound(type);
 89:               if (sfx) playSfx(sfx, pos, { bus: MONSTER_BUS });
 90:               break;
 91:             }
 92:           }
 93:         } else if (e.playerAnimation) {
 94:           if (isPlayerAttackAction(action)) {
 95:             const sfx = playerSwingSound(e.charAppearance);
 96:             if (sfx) playSfx(sfx, pos, { bus: COMBAT_BUS });
 97:           } else if (action === PlayerAction.PLAYER_SHOCK) {
 98:             playSfx(playerPainSound(classOf(e)), pos, { bus: COMBAT_BUS });
 99:           } else if (
100:             action === PlayerAction.PLAYER_DIE1 ||
101:             action === PlayerAction.PLAYER_DIE2
102:           ) {
103:             playSfx(playerDeathSound(classOf(e)), pos, { bus: COMBAT_BUS });
104:           }
105:         }
106:       }
107:     },
108:   };
109: };
</file>

