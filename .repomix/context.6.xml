185: /** True once the entity has left the world (despawned, out of scope, disposed). */
186: export function entityGone(e: Entity): boolean {
187:   if (!e.transform) return true;
188:   if (e.objOutOfScope) return true;
189:   const mesh = e.modelObject?.gltf?.mesh;
