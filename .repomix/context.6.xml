  1: /**
  2:  * Monster glow - the additive cards a monster carries on its own bones for as
  3:  * long as it is in scope: Bahamut's anglerfish lure, the light in each of
  4:  * Vepar's hands, the Lost Tower Shadow's whole luminous body.
  5:  *
  6:  * The original draws these from `RenderCharacter` every frame
  7:  * (ZzzCharacter.cpp:11005-11036, :11099-11132) through `RenderLight` (:8243):
  8:  * one `CreateSprite` on a skinned bone, warm amber, breathing
  9:  * `sinf(WorldTime * 0.002f) * 0.3f + 0.7f`. `CreateSprite` sizes a card in
 10:  * texture pixels x `Scale` and the world is centimetres
 11:  * (zzzeffectsprite.cpp:73), which is the `px * scale / TILE_CM` below.
 12:  *
 13:  * Drawn as `SpriteManager` sprites rather than `core.ts` cards for one
 14:  * reason: the Shadow is 39 cards on its own, and Lost Tower spawns them in
 15:  * packs. One manager per texture batches every glow on the map into one draw
 16:  * call each.
 17:  *
 18:  * Driven by: `ecs/systems/monsterGlowSystem.ts`. Read by: nobody. The light
 19:  * these throw on the floor is the lighting layer's
 20:  * (`lighting/characters.ts`), which carries the matching rows.
 21:  */
 22: import {
 23:   Color4,
 24:   Constants,
 25:   Sprite,
 26:   SpriteManager,
 27:   Vector3,
 28:   type Scene,
 29: } from '../libs/babylon/exports';
 30: import { TILE_CM } from '../common/terrain/consts';
 31: import { downloadDataFile } from '../libs/mu/dataFolder';
 32: import type { Entity } from '../ecs/world';
 33: import { boneLocalPos, entityGone } from './core';
 34: import { TEX } from './recipes';
 35: import { DEAD_HANDLE, type EffectHandle, type EffectLayer } from './layer';
 36: 
 37: // ---- 1. tuning -------------------------------------------------------------
 38: 
 39: /** OZJ files open with a 24-byte header before the JPEG (`effectLights.ts`). */
 40: const OZJ_HEADER_SIZE = 24;
 41: 
 42: /** Sprites one manager holds. A Shadow takes 39; a map full of them fits. */
 43: const MAX_SPRITES_PER_MANAGER = 1024;
 44: 
 45: /** `RenderLight`'s breathing, in radians per second (`WorldTime` is ms). */
 46: const BREATH_SPEED = 0.002 * 1000;
 47: 
 48: /** ...and its shape: `sin(t) * 0.3 + 0.7`, so 0.4 at the trough. */
 49: const BREATH_AMOUNT = 0.3;
 50: const BREATH_BASE = 0.7;
 51: 
 52: /** `RenderLight`'s colour before the breath: `(L, 0.6L, 0.4L)` (:8250). */
 53: const RENDER_LIGHT_RGB = [1, 0.6, 0.4] as const;
 54: 
 55: /**
 56:  * The textures a glow is drawn with, with the pixel size `CreateSprite`
 57:  * multiplies by `Scale`. Shiny03 is the 8:1 flare bar, Spark02 the 4x4
 58:  * pinpoint that sits in its middle.
 59:  */
 60: const GLOW_TEXTURES = {
 61:   /** BITMAP_SPARK (Spark02): the hot core. */
 62:   core: { file: TEX.spark2, px: [4, 4] },
 63:   /** BITMAP_SHINY+2 (Shiny03): the wide, thin flare bar. */
 64:   bar: { file: TEX.shiny3, px: [128, 16] },
 65:   /** BITMAP_LIGHTNING+1 (lightning2): the ragged halo around a held light. */
 66:   halo: { file: TEX.lightning2, px: [128, 128] },
 67:   /** BITMAP_SHINY+1 (Shiny02): the Shadow's body wisp. */
 68:   wisp: { file: TEX.shiny2, px: [32, 64] },
 69:   /** BITMAP_MAGIC+1 (Magic_Ground2): Poison Shadow's body haze. */
 70:   haze: { file: TEX.magicGround2, px: [128, 128] },
 71:   /** BITMAP_LIGHT (flare01): the plain round glow. */
 72:   flare: { file: TEX.flare, px: [64, 64] },
 73: } as const;
 74: 
 75: type GlowTexture = keyof typeof GLOW_TEXTURES;
 76: 
 77: /**
 78:  * `CreateSprite`'s `SubType` picks the blend (zzzeffectsprite.cpp:151-166):
 79:  * 0 is `EnableAlphaBlend`, `(ONE, ONE)`; 1 is `EnableAlphaBlendMinus`,
 80:  * `(ZERO, ONE_MINUS_SRC_COLOR)` - `dst * (1 - src)`, which is Babylon's
 81:  * `ALPHA_SUBTRACT` exactly. The Shadow is the one glow drawn that way, and
 82:  * that is the whole monster: it takes light out of the frame.
 83:  */
 84: type GlowBlend = 'add' | 'subtract';
 85: 
 86: /** One `CreateSprite` call: which sheet, at which `Scale`, blended how. */
 87: type GlowCard = {
 88:   readonly tex: GlowTexture;
 89:   readonly scale: number;
 90:   readonly blend?: GlowBlend;
 91: };
 92: 
 93: export type MonsterGlow = {
 94:   /**
 95:    * MU bone indices the cards hang on, or `'body'` for the Shadow's "every
 96:    * bone that is not a dummy" walk.
 97:    */
 98:   readonly bones: readonly number[] | 'body';
 99:   /** Bone ranges `'body'` leaves out, inclusive (:11109-11112). */
100:   readonly skip?: readonly (readonly [number, number])[];
101:   /** Offset in the bone's own frame, tiles (the original's `x, y, z` / 100). */
102:   readonly local?: readonly [number, number, number];
103:   readonly cards: readonly GlowCard[];
104:   /** Peak colour. Defaults to `RenderLight`'s amber. */
105:   readonly colour?: readonly [number, number, number];
106:   /** `RenderLight` breathes; the hand-written cases hold a fixed luminosity. */
107:   readonly breathe?: boolean;
108:   /** Fixed luminosity when `breathe` is false (the case's `Luminosity`). */
109:   readonly luminosity?: number;
110: };
111: 
112: /** `RenderLight(o, tex, scale, bone, x, y, z)` for one or more bones. */
113: function renderLight(
114:   bones: readonly number[],
115:   cards: readonly GlowCard[],
116:   local?: readonly [number, number, number]
117: ): MonsterGlow {
118:   return { bones, cards, local, breathe: true };
119: }
120: 
121: /**
122:  * Keyed by NPC/monster type number (`MonstersDatabase`). Every row is a
123:  * transcription; the file:line is the original's site.
124:  */
125: export const MONSTER_GLOWS: Partial<Record<number, MonsterGlow>> = {
126:   // 45 Bahamut / 51 Great Bahamut (MODEL_BAHAMUT): the lure on bone 9, :11028.
127:   45: renderLight([9], [{ tex: 'core', scale: 4 }, { tex: 'bar', scale: 3 }], [0, 0, 0.05]),
128:   // 46 Vepar / 80 Golden Vepar (MODEL_VEPAR): one in each hand, :11009.
129:   46: renderLight(
130:     [30, 39],
131:     [
132:       { tex: 'halo', scale: 0.5 },
133:       { tex: 'core', scale: 4 },
134:       { tex: 'bar', scale: 2 },
135:     ],
136:     [0, 0, -0.05]
137:   ),
138:   // 48 Lizard King / 81 Golden Lizard King (MODEL_LIZARD): four spikes, :11017.
139:   48: renderLight([26, 31, 36, 41], [{ tex: 'core', scale: 2 }, { tex: 'bar', scale: 1 }]),
140:   // 49 Hydra (MODEL_HYDRA): one big flare over the head, :11005.
141:   49: renderLight([63], [{ tex: 'halo', scale: 1 }, { tex: 'bar', scale: 4 }], [0, 0, 0.2]),
142:   // 36 Shadow (MODEL_SHADOW, `c->Level == 0`): `SubType 1`, so the body is
143:   // drawn *out* of the frame rather than into it - the name is literal
144:   // (:11123). The skipped bones are the floating Box01-14 shards, which stay
145:   // solid. :11099-11132.
146:   36: {
147:     bones: 'body',
148:     skip: [
149:       [15, 20],
150:       [27, 32],
151:     ],
152:     cards: [{ tex: 'wisp', scale: 2.5, blend: 'subtract' }],
153:     colour: [1, 1, 1],
154:     breathe: false,
155:     luminosity: 1,
156:   },
157:   // 39 Poison Shadow (MODEL_SHADOW, `c->Level == 1`): the same body, green.
158:   39: {
159:     bones: 'body',
160:     skip: [
161:       [15, 20],
162:       [27, 32],
163:     ],
164:     cards: [{ tex: 'haze', scale: 0.8 }],
165:     colour: [0.2, 0.7, 0.1],
166:     breathe: false,
167:     luminosity: 1,
168:   },
169:   // 27 Scorpion (MODEL_CHAIN_SCORPION): the tail lamp, `Luminosity` 0.8 flat
170:   // (ZzzCharacter.cpp:6032-6039).
171:   27: {
172:     bones: [7],
173:     cards: [{ tex: 'flare', scale: 1 }],
174:     colour: [1, 0.4, 0.2],
175:     breathe: false,
176:     luminosity: 0.8,
177:   },
178:   // 235 Priest Sevina (MODEL_NPC_SEVINA), :11034.
179:   235: renderLight([6], [{ tex: 'flare', scale: 2.5 }]),
180:   // 238 Chaos Goblin (MODEL_MIX_NPC), :11031.
181:   238: renderLight([32], [{ tex: 'flare', scale: 1.5 }]),
182: };
183: 
184: // The golden line shares the model, and the original shares the render case
185: // with it: MODEL_VEPAR and MODEL_LIZARD are the same `o->Type` either way.
186: MONSTER_GLOWS[51] = MONSTER_GLOWS[45];
187: MONSTER_GLOWS[80] = MONSTER_GLOWS[46];
188: MONSTER_GLOWS[81] = MONSTER_GLOWS[48];
189: 
190: /** The glow a character type carries, if any. */
191: export function monsterGlowFor(npcType: number): MonsterGlow | undefined {
192:   return MONSTER_GLOWS[npcType];
193: }
194: 
195: // ---- 2. state + readers ----------------------------------------------------
196: 
197: /** One manager per texture *and* blend - `blendMode` is a manager setting. */
198: type ManagerKey = `${GlowTexture}:${GlowBlend}`;
199: 
200: const managers = new Map<ManagerKey, SpriteManager>();
201: const loading = new Set<ManagerKey>();
202: 
203: /**
204:  * Bumped by `reset()`. An OZJ still in flight across a map change belongs to
205:  * the scene that is being torn down, so its manager is dropped on arrival.
206:  */
207: let generation = 0;
208: 
209: /**
210:  * The manager for one texture, built on first use. Null until the OZJ has
211:  * decoded - a glow asked for meanwhile has no sprite for that card yet and
212:  * picks it up on a later frame.
213:  */
214: function managerFor(
215:   scene: Scene,
216:   tex: GlowTexture,
217:   blend: GlowBlend
218: ): SpriteManager | null {
219:   const key: ManagerKey = `${tex}:${blend}`;
220: 
221:   const built = managers.get(key);
222:   if (built) return built;
223:   if (loading.has(key)) return null;
224: 
225:   loading.add(key);
226: 
227:   const { file, px } = GLOW_TEXTURES[tex];
228:   const mine = generation;
229: 
230:   void (async () => {
231:     try {
232:       const ozj = await downloadDataFile(file);
233:       if (mine !== generation) return;
234: 
235:       const blob = new Blob([ozj.slice(OZJ_HEADER_SIZE)], { type: 'image/jpeg' });
236: 
237:       const manager = new SpriteManager(
238:         `monsterGlow:${key}`,
239:         URL.createObjectURL(blob),
240:         MAX_SPRITES_PER_MANAGER,
241:         { width: px[0], height: px[1] },
242:         scene
243:       );
244: 
245:       manager.blendMode =
246:         blend === 'subtract' ? Constants.ALPHA_SUBTRACT : Constants.ALPHA_ONEONE;
247:       manager.disableDepthWrite = true;
248:       manager.isPickable = false;
249:       manager.fogEnabled = false;
250: 
251:       if (mine !== generation) {
252:         manager.dispose();
253:         return;
254:       }
255: 
256:       managers.set(key, manager);
257:     } catch (err) {
258:       console.warn(`[monsterGlow] could not load ${file}`, err);
259:     } finally {
260:       loading.delete(key);
261:     }
262:   })();
263: 
264:   return null;
265: }
266: 
267: function disposeManagers(): void {
268:   generation++;
269:   for (const manager of managers.values()) manager.dispose();
270:   managers.clear();
271:   loading.clear();
272: }
273: 
274: /** One card of one glow: a sprite waiting for, or riding, a bone. */
275: type GlowSprite = {
276:   readonly bone: number;
277:   readonly tex: GlowTexture;
278:   readonly scale: number;
279:   readonly blend: GlowBlend;
280:   sprite: Sprite | null;
281: };
282: 
283: type LiveGlow = {
284:   readonly scene: Scene;
285:   readonly entity: Entity;
286:   readonly glow: MonsterGlow;
287:   readonly sprites: GlowSprite[];
288:   readonly rgb: readonly [number, number, number];
289:   clock: number;
290:   stopped: boolean;
291: };
292: 
293: const live = new Set<LiveGlow>();
294: 
295: /** How many monsters are glowing (debug). */
296: export function monsterGlowCount(): number {
297:   return live.size;
298: }
299: 
300: /** How many sprites that costs (debug). */
301: export function monsterGlowSpriteCount(): number {
302:   let n = 0;
303:   for (const g of live) n += g.sprites.length;
304:   return n;
305: }
306: 
307: function skipped(glow: MonsterGlow, bone: number): boolean {
308:   for (const [from, to] of glow.skip ?? []) if (bone >= from && bone <= to) return true;
309:   return false;
310: }
311: 
312: /**
313:  * The bones the cards hang on. `'body'` resolves against the loaded skeleton
314:  * - the original's `for (i < b->NumBones) if (!b->Bones[i].Dummy)`. The
315:  * converter keeps a dummy as a joint named `bone_<i>_Dummy`
316:  * (tools/bmdToGlb.ts:312), which is that test.
317:  */
318: function bonesOf(glow: MonsterGlow, entity: Entity): number[] {
319:   if (glow.bones !== 'body') return [...glow.bones];
320: 
321:   const bones = entity.modelObject?.gltf?.skeleton?.bones;
322:   if (!bones) return [];
323: 
324:   const out: number[] = [];
325:   // The GLB adds a root, so MU bone `i` is `bones[i + 1]` (core.ts `bonePos`).
326:   for (let i = 0; i + 1 < bones.length; i++) {
327:     if (skipped(glow, i)) continue;
328: 
329:     const bone = bones[i + 1];
330:     if (!bone.getTransformNode()) continue;
331:     if (bone.name.endsWith('_Dummy')) continue;
332: 
333:     out.push(i);
334:   }
335:   return out;
336: }
337: 
338: const tmpLocal = new Vector3();
339: const tmpWorld = new Vector3();
340: 
341: function place(g: LiveGlow): void {
342:   const [lx, ly, lz] = g.glow.local ?? [0, 0, 0];
343:   tmpLocal.set(lx, ly, lz);
344: 
345:   const lumi = g.glow.breathe
346:     ? Math.sin(g.clock * BREATH_SPEED) * BREATH_AMOUNT + BREATH_BASE
347:     : (g.glow.luminosity ?? 1);
348: 
349:   const [r, gr, b] = g.rgb;
350:   const hidden = g.entity.modelObject?.OutOfView === true;
351: 
352:   for (const s of g.sprites) {
353:     let sprite = s.sprite;
354: 
355:     if (!sprite) {
356:       const manager = managerFor(g.scene, s.tex, s.blend);
357:       if (!manager) continue;
358: 
359:       const { px } = GLOW_TEXTURES[s.tex];
360:       sprite = new Sprite(`monsterGlow`, manager);
361:       sprite.isPickable = false;
362:       sprite.width = (px[0] * s.scale) / TILE_CM;
363:       sprite.height = (px[1] * s.scale) / TILE_CM;
364:       sprite.color = new Color4(r * lumi, gr * lumi, b * lumi, 1);
365:       s.sprite = sprite;
366:     }
367: 
368:     sprite.isVisible = !hidden;
369:     if (hidden) continue;
370: 
371:     boneLocalPos(g.entity, s.bone, tmpLocal, tmpWorld);
372:     sprite.position.copyFrom(tmpWorld);
373:     sprite.color.set(r * lumi, gr * lumi, b * lumi, 1);
374:   }
375: }
376: 
377: function drop(g: LiveGlow): void {
378:   for (const s of g.sprites) {
379:     s.sprite?.dispose();
380:     s.sprite = null;
381:   }
382:   g.sprites.length = 0;
383: }
384: 
385: /**
386:  * Command: light a monster's own body. The handle ends it - the system stops
387:  * it when the monster dies or leaves; a map change ends every one.
388:  */
389: export function glowMonster(
390:   scene: Scene,
391:   entity: Entity,
392:   glow: MonsterGlow
393: ): EffectHandle {
394:   const bones = bonesOf(glow, entity);
395:   if (!bones.length) return DEAD_HANDLE;
396: 
397:   const sprites: GlowSprite[] = [];
398:   for (const bone of bones) {
399:     for (const card of glow.cards) {
400:       sprites.push({
401:         bone,
402:         tex: card.tex,
403:         scale: card.scale,
404:         blend: card.blend ?? 'add',
405:         sprite: null,
406:       });
407:     }
408:   }
409: 
410:   const g: LiveGlow = {
411:     scene,
412:     entity,
413:     glow,
414:     sprites,
415:     rgb: glow.colour ?? RENDER_LIGHT_RGB,
416:     clock: 0,
417:     stopped: false,
418:   };
419: 
420:   live.add(g);
421:   place(g);
422: 
423:   return {
424:     get alive() {
425:       return live.has(g);
426:     },
427:     stop() {
428:       g.stopped = true;
429:     },
430:   };
431: }
432: 
433: function update(_map: number, dt: number): void {
434:   for (const g of live) {
435:     if (g.stopped || entityGone(g.entity)) {
436:       drop(g);
437:       live.delete(g);
438:       continue;
439:     }
440: 
441:     g.clock += dt;
442:     place(g);
443:   }
444: }
445: 
446: function reset(): void {
447:   for (const g of live) drop(g);
448:   live.clear();
449:   disposeManagers();
450: }
451: 
452: // ---- 3. the layer ----------------------------------------------------------
453: 
454: export interface MonsterGlowOptions {
455:   entity: Entity;
456:   glow: MonsterGlow;
457: }
458: 
459: export const monsterGlowLayer: EffectLayer<MonsterGlowOptions, 'monsterGlow'> = {
460:   name: 'monsterGlow',
461:   update,
462:   reset,
463:   spawn: (scene, _at, opts) => glowMonster(scene, opts.entity, opts.glow),
464: };
</file>

<file path="src/effects/particles.ts">
 1: /**
 2:  * Particles - a burst or a timed stream of pooled particles from one recipe.
 3:  * The original's `CreateParticle(BITMAP_*, …)` loop: N particles thrown from
 4:  * a point with a direction, gravity and a lifetime (ZzzEffectParticle.cpp).
 5:  *
 6:  * A burst is one call; a stream (`rate` + `seconds`) keeps emitting while it
 7:  * lives, following `follow` if given - a fireball's trail, a buff's shimmer.
 8:  * Every recipe shares one `ParticleSystem` (core.ts), so a hundred bursts of
 9:  * one kind cost one draw.
10:  *
11:  * Driven by: `effects.spawn('particles', …)`. Read by: nobody.
12:  */
13: import { Vector3, type Scene } from '../libs/babylon/exports';
14: import {
15:   Emitter,
16:   LiveList,
17:   emitBurst,
18:   pointSource,
19:   type ParticleRecipe,
20:   type PointSource,
21: } from './core';
22: import { DEAD_HANDLE, type EffectHandle, type EffectLayer } from './layer';
23: 
24: // ---- 1. tuning -------------------------------------------------------------
25: 
26: /** A stream with no `seconds` runs this long - long enough to be a mistake you notice. */
27: const DEFAULT_STREAM_SECONDS = 2;
28: 
29: // ---- 2. state + readers ----------------------------------------------------
30: 
31: export interface ParticlesOptions {
32:   recipe: ParticleRecipe;
33:   /** Burst: this many at once. */
34:   count?: number;
35:   /** Stream: this many per second for `seconds`. */
36:   rate?: number;
37:   seconds?: number;
38:   /** Stream only: emit from a moving point. */
39:   follow?: PointSource;
40:   /** Tiles above the point. */
41:   height?: number;
42:   /** Stream only: ends early when true (a held charge released). */
43:   until?: () => boolean;
44:   /** Stream only: multiplies `rate` each frame (Nova's `(skillCount+1)×` per bone). */
45:   rateScale?: () => number;
46: }
47: 
48: const live = new LiveList();
49: 
50: /** How many streams are running (debug). */
51: export function particleStreamCount(): number {
52:   return live.size;
53: }
54: 
55: const tmp = new Vector3();
56: 
57: function spawn(scene: Scene, at: Vector3, opts: ParticlesOptions): EffectHandle {
58:   const height = opts.height ?? 0;
59:   if (opts.count) {
60:     tmp.copyFrom(at);
61:     tmp.y += height;
62:     emitBurst(scene, opts.recipe, tmp, opts.count);
63:   }
64:   if (!opts.rate) return DEAD_HANDLE;
65: 
66:   const emitter = new Emitter(scene, opts.recipe, opts.rate);
67:   const seconds = opts.seconds ?? DEFAULT_STREAM_SECONDS;
68:   const source = opts.follow ?? pointSource(at);
69:   let t = 0;
70:   return live.push({
71:     update(dt) {
72:       t += dt;
73:       if (t >= seconds || opts.until?.()) return false;
74:       source(tmp);
75:       tmp.y += height;
76:       emitter.tick(tmp, dt, opts.rateScale ? emitter.rate * opts.rateScale() : emitter.rate);
77:       return true;
78:     },
79:     release() {},
80:   });
81: }
82: 
83: function update(_map: number, dt: number): void {
84:   live.update(dt);
85: }
86: 
87: function reset(): void {
88:   live.clear();
89: }
90: 
91: // ---- 3. the layer ----------------------------------------------------------
92: 
93: export const particlesLayer: EffectLayer<ParticlesOptions, 'particles'> = {
94:   name: 'particles',
95:   update,
96:   reset,
97:   spawn,
98: };
</file>

<file path="src/effects/projectile.ts">
  1: /**
  2:  * Projectile - something that flies from a point to a target and does a
  3:  * thing on arrival. The original's `CreateEffect(MODEL_* or BITMAP_*, …, Target)`
  4:  * with a `Velocity`: `MoveEffect` steps toward `Target->Position` each tick
  5:  * and, within one step of it, kills the effect and spawns the hit
  6:  * (ZzzEffect.cpp `MoveEffect`, the `o->Target` branch).
  7:  *
  8:  * The head is a billboard card (BITMAP_ENERGY, BITMAP_FIRE…) and/or a skill
  9:  * model (`Skill/*.glb`, spawned through the `model` entry and told to follow
 10:  * this projectile's point). An optional trail streams a particle recipe from
 11:  * the same point. `to` may be a moving point so the bolt homes on a walking
 12:  * target like the original.
 13:  *
 14:  * Driven by: `effects.spawn('projectile', …)`. Read by: nobody; `onArrive`
 15:  * is the callback the skill table uses to fire the impact.
 16:  */
 17: import { Vector3, type Scene } from '../libs/babylon/exports';
 18: import {
 19:   Emitter,
 20:   LiveList,
 21:   acquireCard,
 22:   additiveMaterial,
 23:   pointSource,
 24:   releaseCard,
 25:   hash,
 26:   type Card,
 27:   type ParticleRecipe,
 28:   type PointSource,
 29:   type RGB,
 30: } from './core';
 31: import { spawnModel, type ModelOptions } from './model';
 32: import { RGBS } from './recipes';
 33: import type { EffectHandle, EffectLayer } from './layer';
 34: 
 35: // ---- 1. tuning -------------------------------------------------------------
 36: 
 37: /** Magic bolts: the original's 7 units/tick... at 25 Hz - 7 tiles/s, matching lighting/skills.ts. */
 38: const DEFAULT_SPEED = 7;
 39: 
 40: /** Give up after this long: a target that despawned mid-flight. */
 41: const MAX_FLIGHT_SECONDS = 4;
 42: 
 43: /** Within this distance of the target, it has hit. */
 44: const HIT_DISTANCE = 0.2;
 45: 
 46: /** A head card spins this fast so the sheet does not read as a still image. */
 47: const HEAD_SPIN = 6;
 48: 
 49: // ---- 2. state + readers ----------------------------------------------------
 50: 
 51: export interface ProjectileHead {
 52:   texture: string;
 53:   colour?: RGB;
 54:   /** Card edge in tiles. */
 55:   size?: number;
 56:   spin?: number;
 57: }
 58: 
 59: export interface ProjectileOptions {
 60:   /** Where it flies to - a fixed point or a moving one (the target's chest). */
 61:   to: Vector3 | PointSource;
 62:   /** Tiles per second. */
 63:   speed?: number;
 64:   head?: ProjectileHead;
 65:   /** A skill model that rides the point (`Skill/*.glb`). */
 66:   model?: Omit<ModelOptions, 'follow' | 'seconds'>;
 67:   /** Particles left behind. */
 68:   trail?: { recipe: ParticleRecipe; rate: number };
 69:   /** Peak height of a lob in tiles (0 = straight). A Meteorite falls, so it starts high instead - use `from`. */
 70:   arc?: number;
 71:   /** Start somewhere other than `at` (a comet from the sky). */
 72:   from?: Vector3;
 73:   /** Fired when it reaches the target, with the hit point. */
 74:   onArrive?: (at: Vector3) => void;
 75:   /** Fired if it gave up (target gone). */
 76:   onLost?: () => void;
 77:   /**
 78:    * The head's position, once a tick - as `joint`'s `trace`. For a host
 79:    * that must ride something on the bolt this layer does not own: an
 80:    * arrow's own light. Read-only: copy it, never keep it.
 81:    */
 82:   trace?: (head: Vector3) => void;
 83: }
 84: 
 85: const live = new LiveList();
 86: 
 87: /** How many bolts are in the air (debug). */
 88: export function projectileCount(): number {
 89:   return live.size;
 90: }
 91: 
 92: const target = new Vector3();
 93: const dir = new Vector3();
 94: let seed = 0;
 95: 
 96: function spawn(scene: Scene, at: Vector3, opts: ProjectileOptions): EffectHandle {
 97:   const speed = opts.speed ?? DEFAULT_SPEED;
 98:   const goal = pointSource(opts.to);
 99:   const pos = (opts.from ?? at).clone();
100:   const start = pos.clone();
101:   const arc = opts.arc ?? 0;
102:   const spin = opts.head?.spin ?? HEAD_SPIN;
103:   const phase = hash(seed++) * Math.PI * 2;
104: 
105:   let card: Card | null = null;
106:   if (opts.head) {
107:     const m = additiveMaterial(scene, opts.head.texture, opts.head.colour ?? RGBS.white);
108:     card = acquireCard(scene, m);
109:     card.position.copyFrom(pos);
110:     card.scaling.setAll(opts.head.size ?? 0.6);
111:   }
112: 
113:   const point: PointSource = out => out.copyFrom(pos);
114:   const model = opts.model
115:     ? spawnModel(scene, pos, { ...opts.model, follow: point, seconds: MAX_FLIGHT_SECONDS })
116:     : null;
117:   const trail = opts.trail ? new Emitter(scene, opts.trail.recipe, opts.trail.rate) : null;
118: 
119:   opts.trace?.(pos);
120: 
121:   let t = 0;
122:   let travelled = 0;
123:   let arrived = false;
124:   // The straight-line point; `pos` is it lifted by the lob parabola.
125:   const flat = pos.clone();
126:   const totalGuess = Vector3.Distance(start, goal(target)) || 1;
127: 
128:   return live.push({
129:     update(dt) {
130:       t += dt;
131:       goal(target);
132:       target.subtractToRef(flat, dir);
133:       const dist = dir.length();
134:       const step = speed * dt;
135:       if (dist <= Math.max(step, HIT_DISTANCE)) {
136:         pos.copyFrom(target);
137:         opts.trace?.(pos);
138:         arrived = true;
139:         return false;
140:       }
141:       if (t > MAX_FLIGHT_SECONDS) return false;
142:       dir.scaleInPlace(step / dist);
143:       flat.addInPlace(dir);
144:       travelled += step;
145:       pos.copyFrom(flat);
146:       if (arc > 0) {
147:         // Parabola over the straight line: peak at the middle of the flight.
148:         const p = Math.min(1, travelled / totalGuess);
149:         pos.y += 4 * p * (1 - p) * arc;
150:       }
151:       if (card) {
152:         card.position.copyFrom(pos);
153:         card.rotation.z = phase + spin * t;
154:         // A solid tinted square until the sheet is in.
155:         card.visibility = (card.material as { diffuseTexture?: unknown } | null)?.diffuseTexture ? 1 : 0;
156:       }
157:       if (model) model.yawTo(dir);
158:       opts.trace?.(pos);
159:       trail?.tick(pos, dt);
160:       return true;
161:     },
162:     release() {
163:       if (card) releaseCard(scene, card);
164:       model?.stop();
165:       if (arrived) opts.onArrive?.(pos);
166:       else opts.onLost?.();
167:     },
168:   });
169: }
170: 
171: function update(_map: number, dt: number): void {
172:   live.update(dt);
173: }
174: 
175: function reset(): void {
176:   live.clear();
177: }
178: 
179: // ---- 3. the layer ----------------------------------------------------------
180: 
181: export const projectileLayer: EffectLayer<ProjectileOptions, 'projectile'> = {
182:   name: 'projectile',
183:   update,
184:   reset,
185:   spawn,
186: };
</file>

