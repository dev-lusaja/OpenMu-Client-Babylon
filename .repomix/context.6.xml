 54: /* ------------------------------------------------------------- live list */
 55: 
 56: export interface LiveEffect {
 57:   /** Return false to finish; `release` is then called once. */
 58:   update(dt: number): boolean;
 59:   release(): void;
 60: }
 61: 
 62: /**
 63:  * An entry's running effects. `push` returns the handle the spawn hands out;
 64:  * `update` steps them in place (swap-remove, so a burst of endings is O(n)).
 65:  */
 66: export class LiveList {
 67:   readonly #live: (LiveEffect & { alive: boolean; stopped: boolean })[] = [];
 68: 
 69:   get size(): number {
 70:     return this.#live.length;
 71:   }
 72: 
 73:   push(fx: LiveEffect): EffectHandle {
 74:     const item = Object.assign(fx, { alive: true, stopped: false });
 75:     this.#live.push(item);
 76:     return {
 77:       get alive() {
 78:         return item.alive;
 79:       },
 80:       stop() {
 81:         item.stopped = true;
 82:       },
 83:     };
 84:   }
 85: 
 86:   update(dt: number): void {
 87:     const live = this.#live;
 88:     for (let i = live.length - 1; i >= 0; i--) {
 89:       const e = live[i];
 90:       let alive = false;
 91:       if (!e.stopped) {
 92:         try {
 93:           alive = e.update(dt);
 94:         } catch (err) {
 95:           console.warn('[effects] effect threw, dropping it', err);
 96:         }
 97:       }
 98:       if (!alive) {
 99:         live[i] = live[live.length - 1];
100:         live.pop();
101:         e.alive = false;
102:         release(e);
103:       }
104:     }
105:   }
106: 
107:   clear(): void {
108:     for (const e of this.#live) {
109:       e.alive = false;
110:       release(e);
111:     }
112:     this.#live.length = 0;
113:   }
114: }
