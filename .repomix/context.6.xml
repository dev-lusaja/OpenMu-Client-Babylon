272:   /**
273:    * `CSPetDarkSpirit::MovePet`, PET_FLY / PET_FLYING (CSPetSystem.cpp:420-505):
274:    * the same boid drift as the angel, but 250 units over the owner (350 when
275:    * he rides a Dark Horse), dashing home once it drifts past FlyRange. The
276:    * original steers height through the pitch angle; the angel's direction
277:    * nudge stands in for it.
278:    */
279:   function updateRaven(actor: Entity, dt: number) {
280:     const state = actor.petActor!;
281:     const pos = actor.transform!.pos;
282:     const owner = state.owner;
283:     const target = owner.transform?.pos;
284:     if (!target) return;
285: 
286:     const ticks = dt * TICKS_PER_SECOND;
287: 
288:     const dx = target.x - pos.x;
289:     const dz = target.z - pos.z;
290:     const distance2 = dx * dx + dz * dz;
291:     const far = distance2 >= state.flyRange * state.flyRange;
292: 
293:     // The far failsafe (:598-608): way off or far below, snap back home.
294:     const snap = RAVEN_SNAP_DISTANCE * MU_UNIT;
295:     if (distance2 > snap * snap || pos.y < target.y - 2) {
296:       pos.x = target.x;
297:       pos.z = target.z;
298:       pos.y = target.y + RAVEN_SPAWN_HEIGHT * MU_UNIT;
299:     }
300: 
301:     if (far) {
302:       // TurnAngle2(..., RangeFloat(0,14) + 5): 5..19 degrees per tick.
303:       const heading = createAngleDeg(pos.x, pos.z, target.x, target.z) * DEG;
304:       state.yaw = turnAngle(state.yaw, heading, (rand(15) + 5) * DEG * ticks);
305:     }
306: 
307:     state.reroll -= ticks;
308:     if (state.reroll <= 0) {
309:       state.reroll = REROLL_TICKS;
310: 
311:       // Far: a dash back (128..191); near: a lazy circle (32..39) on a
312:       // rerolled heading. Speeds are negative - forward is -Y (see the angel).
313:       const speed = far ? -(rand(64) + 128) * 0.1 : -(rand(8) + 32) * 0.1;
314:       if (!far) state.yaw += rand(60) * DEG;
315: 
316:       state.dir.y = (speed + state.dir.y) / 2;
317:       state.dir.z = (rand(64) - 32) * 0.1;
318:     }
319: 
320:     const ridesHorse =
321:       owner.charAppearance?.pet?.group === PET_GROUP &&
322:       owner.charAppearance.pet.num === DARK_HORSE;
323:     const wanted = ridesHorse ? RAVEN_HEIGHT_HORSE : RAVEN_HEIGHT;
324:     const height = (pos.y - target.y) / MU_UNIT;
325:     if (height < wanted) state.dir.z += RAVEN_HEIGHT_NUDGE * ticks;
326:     if (height > wanted + 100) state.dir.z -= RAVEN_HEIGHT_NUDGE * ticks;
327: 
328:     const step = state.dir.y * MU_UNIT * ticks;
329:     pos.x += -Math.sin(state.yaw) * step;
330:     pos.z += Math.cos(state.yaw) * step;
331:     pos.y += state.dir.z * MU_UNIT * ticks;
332: 
333:     actor.transform!.rot.y = state.yaw;
334: 
335:     actor.modelObject?.setAnimationSpeed(RAVEN_PLAY_SPEED);
336:     // `Direction[1] < -12` flips PET_FLY (glide) into PET_FLYING (flap).
337:     actor.modelObject?.playAction(
338:       state.dir.y < -12 ? RAVEN_ACTION_FLYING : RAVEN_ACTION_FLY,
339:       true
340:     );
341:   }
