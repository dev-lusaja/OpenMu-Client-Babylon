<file path="src/ecs/systems/playerControllerSystem.ts">
  1: import {
  2:   PointerEventTypes,
  3:   type ArcRotateCamera,
  4: } from '../../libs/babylon/exports';
  5: import type { ISystemFactory, World } from '../world';
  6: import { Store, UIState } from '../../store';
  7: import { isMobileDevice } from '../../common/mobile';
  8: import { MoveTargetEffect } from '../../common/moveTargetEffect';
  9: import { GameOptions } from '../../common/gameOptions';
 10: import { WALK_KEYS } from '../../common/keyBindings';
 11: import { aimX, aimY } from '../../camera';
 12: import { Commands } from '../../commands';
 13: 
 14: const MOVE_DELAY = 0.25;
 15: 
 16: /**
 17:  * How far ahead a held walk key aims, in tiles. Long enough that the walk
 18:  * never runs out of path between two re-issues, short enough that letting go
 19:  * does not leave the server walking a route the hero abandoned.
 20:  */
 21: const WALK_AHEAD_TILES = 3;
 22: 
 23: /** Points left on the path when the next keyboard walk is asked for. */
 24: const WALK_REISSUE_AT = 2;
 25: 
 26: /** Shortest gap between two keyboard walk requests, seconds. */
 27: const WALK_REISSUE_SECONDS = 0.15;
 28: 
 29: const OCTANT = Math.PI / 4;
 30: 
 31: export const PlayerControllerSystem: ISystemFactory = world => {
 32:   const query = world.with('playerMoveTo', 'transform', 'pathfinding');
 33: 
 34:   const moveTarget = new MoveTargetEffect(world);
 35: 
 36:   const scene = world.scene;
 37: 
 38:   let lastClientX = 0;
 39:   let lastClientY = 0;
 40:   /**
 41:    * A press was seen and has not been walked on yet. The walk used to be
 42:    * driven purely by polling `world.pointerPressed` once a frame, which can
 43:    * only see a button that is still down when a frame runs: a measured touch
 44:    * tap is held ~29 ms and no render tick observed it at all, so the tap was
 45:    * dropped whole. Remembering the press instead makes it an edge, and the
 46:    * poll below still repeats the walk for as long as the button stays down.
 47:    */
 48:   let pressPending = false;
 49: 
 50:   scene.onPointerObservable.add(ev => {
 51:     // The press counts as well as the move: a touch tap fires POINTERDOWN and
 52:     // POINTERUP with no POINTERMOVE between them, so on a phone this was the
 53:     // only sample there ever was and `tryMove` picked against the screen
 54:     // corner. A mouse always moves to where it clicks, so the down event
 55:     // carries the coordinates the move already wrote.
 56:     if (
 57:       ev.type === PointerEventTypes.POINTERMOVE ||
 58:       ev.type === PointerEventTypes.POINTERDOWN
 59:     ) {
 60:       lastClientX = ev.event.clientX;
 61:       lastClientY = ev.event.clientY;
 62:     }
 63: 
 64:     // Left button only, the same button `pointerInputSystem` walks on: the
 65:     // middle one belongs to the camera and the right one casts.
 66:     if (ev.type === PointerEventTypes.POINTERDOWN && ev.event.button === 0) {
 67:       pressPending = true;
 68:     }
 69:   });
 70: 
 71:   let delay = MOVE_DELAY;
 72:   function tryMove() {
 73:     const playerEntity = world.playerEntity;
 74:     if (!playerEntity) return;
 75: 
 76:     // Dead until the server respawns us (Hero->Dead in the original): no
 77:     // walking and no new path, or the corpse strolls off with HP 0.
 78:     if (playerEntity.dying) return;
 79: 
 80:     if (world.currentPointerTarget) return;
 81: 
 82:     if (Store.pickedItem) return;
 83: 
 84:     const pickInfo = scene.pick(
 85:       aimX(lastClientX),
 86:       aimY(lastClientY),
 87:       m => m === world.terrain?.mesh,
 88:       true
 89:     );
 90: 
 91:     if (!pickInfo) return;
 92: 
 93:     const point = pickInfo.pickedPoint;
 94: 
 95:     if (!point) return;
 96: 
 97:     if (point.lengthSquared() < 0.01) return;
 98: 
 99:     const x = ~~point.x;
100:     const z = ~~point.z;
101: 
102:     if (!world.isWalkable(x, z)) return;
103: 
104:     playerEntity.playerMoveTo.point.x = point.x;
105:     playerEntity.playerMoveTo.point.y = point.z;
106:     playerEntity.playerMoveTo.handled = false;
107:     playerEntity.playerMoveTo.sendToServer = true;
108: 
109:     world.attackTarget = null;
110:     world.pickupTarget = null;
111:     world.talkTarget = null;
112:     // Touch only: a skill fired from the mobile pad leaves a cast standing
113:     // while the hero walks into range, the way a held right button does. With
114:     // no button to let go of, a tap on the ground is how it is called off. On
115:     // a mouse the right-drag repeat re-arms `castRequest` on every move event,
116:     // so clearing it there would fight the desktop repeat cast.
117:     if (isMobileDevice()) world.castRequest = null;
118:   }
119: 
120:   /** The tile step the walk is currently aimed along; 0,0 when idle. */
121:   let walkStepX = 0;
122:   let walkStepY = 0;
123:   let walkDelay = 0;
124:   let walking = false;
125: 
126:   /** How many tiles of the straight run out of (x, y) are walkable, capped. */
127:   function walkableRun(
128:     x: number,
129:     y: number,
130:     stepX: number,
131:     stepY: number
132:   ): number {
133:     if (!stepX && !stepY) return 0;
134: 
135:     let steps = 0;
136: 
137:     while (
138:       steps < WALK_AHEAD_TILES &&
139:       world.isWalkable(x + stepX * (steps + 1), y + stepY * (steps + 1))
140:     ) {
141:       steps++;
142:     }
143: 
144:     return steps;
145:   }
146: 
147:   /**
148:    * Keys let go of: stop at the next tile instead of finishing the run the
149:    * walk was aimed at. The server keeps walking its own copy to the end of
150:    * the chunk it was sent and the next walk request re-anchors it there -
151:    * the same short overshoot a path truncated for an attack already leaves.
152:    */
153:   function stopWalking(playerEntity: World['playerEntity']): void {
154:     if (!walking) return;
155: 
156:     walking = false;
157:     walkStepX = 0;
158:     walkStepY = 0;
159: 
160:     const path = playerEntity?.pathfinding.path;
161:     if (path && path.length > 1) path.length = 1;
162:   }
163: 
164:   /**
165:    * Walk on the held W/A/S/D keys, camera-relative: forward is the way the
166:    * camera looks, flattened onto the ground. Returns whether a direction is
167:    * held - the click walk stands down while one is.
168:    *
169:    * The hero still walks the tile grid the server knows: the direction is
170:    * quantised to one of the eight tile steps and aimed a few tiles ahead, so
171:    * this produces ordinary walk requests and nothing downstream (pathfinding,
172:    * the network chunking, the walk speed) learns about the keyboard at all.
173:    */
174:   function keyboardWalk(dt: number): boolean {
175:     walkDelay = Math.max(0, walkDelay - dt);
176: 
177:     const playerEntity = world.playerEntity;
178:     const camera = scene.activeCamera as ArcRotateCamera | null;
179: 
180:     let forward = 0;
181:     let strafe = 0;
182: 
183:     if (
184:       GameOptions.wsadMovement &&
185:       playerEntity &&
186:       camera &&
187:       // Dead until the server respawns us, the same gate the click walk has.
188:       !playerEntity.dying &&
189:       Store.uiState === UIState.World
190:     ) {
191:       const keys = world.keyboardInput.pressedKeys;
192: 
193:       if (keys.has(WALK_KEYS.forward)) forward++;
194:       if (keys.has(WALK_KEYS.back)) forward--;
195:       if (keys.has(WALK_KEYS.right)) strafe++;
196:       if (keys.has(WALK_KEYS.left)) strafe--;
197:     }
198: 
199:     if ((!forward && !strafe) || !playerEntity || !camera) {
200:       stopWalking(playerEntity);
201:       return false;
202:     }
203: 
204:     // ArcRotateCamera sits at target + r * (cos a, _, sin a) * sin b, so the
205:     // way it looks, flattened, is -(cos a, sin a); right is cross(up,
206:     // forward) in Babylon's left-handed world.
207:     const lookX = -Math.cos(camera.alpha);
208:     const lookZ = -Math.sin(camera.alpha);
209: 
210:     const octant = Math.round(
211:       Math.atan2(
212:         forward * lookZ - strafe * lookX,
213:         forward * lookX + strafe * lookZ
214:       ) / OCTANT
215:     );
216: 
217:     let stepX = Math.round(Math.cos(octant * OCTANT));
218:     let stepY = Math.round(Math.sin(octant * OCTANT));
219: 
220:     const tileX = ~~playerEntity.transform.pos.x;
221:     const tileY = ~~playerEntity.transform.pos.z;
222: 
223:     let steps = walkableRun(tileX, tileY, stepX, stepY);
224: 
225:     // Nose against a wall: drop the blocked half of a diagonal and slide
226:     // along the other, rather than standing still against it.
227:     if (steps === 0 && stepX && stepY) {
228:       if (world.isWalkable(tileX + stepX, tileY)) stepY = 0;
229:       else if (world.isWalkable(tileX, tileY + stepY)) stepX = 0;
230: 
231:       steps = walkableRun(tileX, tileY, stepX, stepY);
232:     }
233: 
234:     if (steps === 0) {
235:       stopWalking(playerEntity);
236:       return true;
237:     }
238: 
239:     const path = playerEntity.pathfinding.path;
240:     const turned = stepX !== walkStepX || stepY !== walkStepY;
241:     const running = walking && !!path && path.length > WALK_REISSUE_AT;
242: 
243:     if (!turned && running) return true;
244:     // Turning under the mouse look would otherwise ask for a walk every
245:     // frame; the walk is aimed far enough ahead to sit out the wait.
246:     if (walkDelay > 0) return true;
247: 
248:     walkDelay = WALK_REISSUE_SECONDS;
249:     walkStepX = stepX;
250:     walkStepY = stepY;
251:     walking = true;
252: 
253:     const moveTo = playerEntity.playerMoveTo;
254: 
255:     moveTo.point.x = tileX + stepX * steps + 0.5;
256:     moveTo.point.y = tileY + stepY * steps + 0.5;
257:     moveTo.handled = false;
258:     moveTo.sendToServer = true;
259:     moveTo.silent = true;
260: 
261:     world.attackTarget = null;
262:     world.pickupTarget = null;
263:     world.talkTarget = null;
264:     // A walk of the hero's own ends the follow, the way a click does.
265:     Commands.stopFollowing();
266: 
267:     return true;
268:   }
269: 
270:   return {
271:     update: dt => {
272:       delay -= dt;
273: 
274:       moveTarget.update(dt);
275: 
276:       const steering = keyboardWalk(dt);
277: 
278:       // A press that is still down repeats the walk on the throttle; a press
279:       // already released walks once. Either way the throttle holds - a tap
280:       // inside it waits its turn rather than being thrown away.
281:       if (steering) {
282:         // The keys steer; a click made while they are held is not a walk
283:         // waiting to happen once they are let go.
284:         pressPending = false;
285:       } else if (world.pointerPressed || pressPending) {
286:         if (delay <= 0) {
287:           delay = MOVE_DELAY;
288:           pressPending = false;
289:           tryMove();
290:         }
291:       }
292: 
293:       for (const {
294:         playerMoveTo,
295:         transform,
296:         pathfinding,
297:         localPlayer,
298:       } of query) {
299:         if (playerMoveTo.handled) continue;
300: 
301:         playerMoveTo.handled = true;
302: 
303:         const silent = playerMoveTo.silent === true;
304:         playerMoveTo.silent = false;
305: 
306:         pathfinding.calculated = false;
307: 
308:         pathfinding.from.x = transform.pos.x;
309:         pathfinding.from.y = transform.pos.z;
310: 
311:         pathfinding.to.x = ~~playerMoveTo.point.x;
312:         pathfinding.to.y = ~~playerMoveTo.point.y;
313: 
314:         if (localPlayer && !silent) {
315:           moveTarget.spawn(
316:             playerMoveTo.point.x,
317:             world.getTerrainHeight(playerMoveTo.point.x, playerMoveTo.point.y),
318:             playerMoveTo.point.y,
319:             Math.PI * 2 - transform.rot.y
320:           );
321:         }
322:       }
323:     },
324:   };
325: };
</file>

<file path="src/ecs/systems/pointerInputSystem.ts">
  1: import {
  2:   Color3,
  3:   Matrix,
  4:   PointerEventTypes,
  5:   Ray,
  6:   Vector3,
  7: } from '../../libs/babylon/exports';
  8: import type { EntityTypeFromQuery, ISystemFactory } from '../world';
  9: import { canAttackPlayer, isAttackableEntity } from './attackSystem';
 10: import { isMobileDevice } from '../../common/mobile';
 11: import { Commands } from '../../commands';
 12: import { aimX, aimY } from '../../camera';
 13: 
 14: const COLOR_RED = new Color3(1, 0, 0);
 15: 
 16: // `CheckMouseIn` on a character in the original tests the model's
 17: // BoundingBox, but the boxes it ships are generous (whole-model bind pose
 18: // with the weapon), so a click near a body still selects it. Our boxes come
 19: // from the mesh bounds and are tight, so they are padded here, in tiles: a
 20: // third of a tile around the feet, a little over the head, and every
 21: // selectable stands at least a character tall - a kneeling smith or a short
 22: // NPC is still a full click target.
 23: const PICK_PAD_XZ = 0.35;
 24: const PICK_PAD_TOP = 0.15;
 25: const PICK_MIN_HEIGHT = 1.6;
 26: 
 27: /** Hover re-sample interval (s); the click itself always re-samples. */
 28: const HOVER_INTERVAL = 0.05;
 29: 
 30: export const PointerInputSystem: ISystemFactory = world => {
 31:   const scene = world.scene;
 32: 
 33:   const tmpCameraRay = new Ray(Vector3.Zero(), Vector3.Up(), Number.MAX_VALUE);
 34:   const identity = Matrix.Identity();
 35: 
 36:   const query = world.with(
 37:     'modelObject',
 38:     'visibility',
 39:     'transform',
 40:     'interactable'
 41:   );
 42: 
 43:   type Selectable = EntityTypeFromQuery<typeof query>;
 44: 
 45:   const paddedMin = new Vector3();
 46:   const paddedMax = new Vector3();
 47:   const centre = new Vector3();
 48: 
 49:   let lastClientX = 0;
 50:   let lastClientY = 0;
 51: 
 52:   /**
 53:    * Point `tmpCameraRay` where the player is aiming. `aimX/aimY`: the
 54:    * first-person look holds the pointer lock, which freezes
 55:    * `clientX/clientY` where it was taken, so the aim is the crosshair.
 56:    */
 57:   function aimRay(): void {
 58:     scene.createPickingRayToRef(
 59:       aimX(lastClientX),
 60:       aimY(lastClientY),
 61:       identity,
 62:       tmpCameraRay,
 63:       null
 64:     );
 65:   }
 66: 
 67:   /**
 68:    * The selectable under `tmpCameraRay`, nearest to the camera first.
 69:    *
 70:    * Bodies (players, monsters, NPCs) win over drops: the original's pick
 71:    * pass runs `SelectCharacter` for characters and monsters, then NPCs, and
 72:    * only asks `SelectItem` when both came back empty (ZzzInterface.cpp
 73:    * :8117-8130), so a monster standing on a pile of loot is the click target
 74:    * and not the loot. Holding Alt flips the order - items first, then NPCs,
 75:    * then monsters (:8048-8058) - which is how loot under a monster is still
 76:    * reachable. Without that rule a drop's padded box (every selectable is
 77:    * at least a character tall) could steal the click from the monster on
 78:    * top of it and turn an attack into a walk-to-pick-up under its blows.
 79:    */
 80:   function resolveTarget(): Selectable | null {
 81:     let best: Selectable | null = null;
 82:     let bestDistance = Number.MAX_VALUE;
 83:     let bestDrop: Selectable | null = null;
 84:     let bestDropDistance = Number.MAX_VALUE;
 85: 
 86:     for (const e of query) {
 87:       const { modelObject, visibility, attributeSystem } = e;
 88: 
 89:       if (!modelObject.Ready) continue;
 90:       if (!attributeSystem) continue;
 91:       if (visibility.state === 'hidden') continue;
 92:       if (e.dying) continue; // corpses are neither selectable nor show a name/HP bar
 93: 
 94:       modelObject.UpdateBoundings();
 95:       const bb = modelObject.BoundingBoxLocal;
 96:       if (bb.minimumWorld.x > bb.maximumWorld.x) {
 97:         // Degenerate box (a model whose GLB carries no meshes - e.g. a
 98:         // bones-only conversion): fall back to a body-sized box on the
 99:         // entity position so the NPC stays clickable.
100:         const pos = e.transform.pos;
101:         paddedMin.set(pos.x, pos.y, pos.z);
102:         paddedMax.set(pos.x, pos.y + PICK_MIN_HEIGHT, pos.z);
103:       } else {
104:         paddedMin.copyFrom(bb.minimumWorld);
105:         paddedMax.copyFrom(bb.maximumWorld);
106:       }
107:       paddedMin.x -= PICK_PAD_XZ;
108:       paddedMin.z -= PICK_PAD_XZ;
109:       paddedMax.x += PICK_PAD_XZ;
110:       paddedMax.z += PICK_PAD_XZ;
111:       paddedMax.y += PICK_PAD_TOP;
112:       if (paddedMax.y - paddedMin.y < PICK_MIN_HEIGHT) {
113:         paddedMax.y = paddedMin.y + PICK_MIN_HEIGHT;
114:       }
115: 
116:       if (!tmpCameraRay.intersectsBoxMinMax(paddedMin, paddedMax)) continue;
117: 
118:       paddedMin.addToRef(paddedMax, centre).scaleInPlace(0.5);
119:       const distance = Vector3.DistanceSquared(tmpCameraRay.origin, centre);
120:       if (e.droppedItem) {
121:         if (distance < bestDropDistance) {
122:           bestDropDistance = distance;
123:           bestDrop = e;
124:         }
125:       } else if (distance < bestDistance) {
126:         bestDistance = distance;
127:         best = e;
128:       }
129:     }
130: 
131:     const keys = world.keyboardInput.pressedKeys;
132:     const itemsFirst = keys.has('AltLeft') || keys.has('AltRight');
133:     return itemsFirst ? (bestDrop ?? best) : (best ?? bestDrop);
134:   }
135: 
136:   function applyTarget(target: Selectable | null): void {
137:     const oldTarget = world.currentPointerTarget;
138:     world.currentPointerTarget = target;
139: 
140:     if (oldTarget !== target && oldTarget && oldTarget.highlighted) {
141:       world.removeComponent(oldTarget, 'highlighted');
142:     }
143: 
144:     if (target && !target.highlighted) {
145:       world.addComponent(target, 'highlighted', {
146:         color: COLOR_RED,
147:         layer: null,
148:       });
149:     }
150:   }
151: 
152:   scene.onPointerObservable.add(ev => {
153:     // Only the ray is wanted here - the hovered object is resolved by
154:     // testing it against each candidate's own box. `scene.pick` would
155:     // ray-intersect every pickable mesh in the scene (the terrain's 131k
156:     // triangles included) on every pointer event, move events included.
157:     lastClientX = ev.event.clientX;
158:     lastClientY = ev.event.clientY;
159:     aimRay();
160: 
161:     // The click re-resolves against its own ray: the hover sample can be up
162:     // to HOVER_INTERVAL old, and the systems registered after this one
163:     // (talk, rest objects, movement) read `currentPointerTarget` in their
164:     // own pointer-down handlers.
165:     if (ev.type === PointerEventTypes.POINTERDOWN) applyTarget(resolveTarget());
166: 
167:     // A move event reports button -1, so a right-button drag is recognised
168:     // by the held state, not by the button field.
169:     const rightDrag =
170:       ev.type === PointerEventTypes.POINTERMOVE && world.rightPointerPressed;
171: 
172:     if (ev.event.button === 2 || rightDrag) {
173:       // `CNewUICommandWindow::RunCommand`: with an entry armed the right
174:       // click runs it on the player under the cursor instead of casting.
175:       if (
176:         ev.type === PointerEventTypes.POINTERDOWN &&
177:         Commands.runPendingOn(world.currentPointerTarget)
178:       ) {
179:         return;
180:       }
181:       // `CheckAttack` (ZzzInterface.cpp:1752-1783) on the player under the
182:       // cursor: the duel enemy, an outlaw, or anyone while Ctrl is held.
183:       const hovered = world.currentPointerTarget ?? null;
184:       const pvp = !!hovered && canAttackPlayer(world, hovered, ev.event.ctrlKey);
185:       // `CNewUIHotKey::UpdateMouseEvent`: on another player the right click
186:       // opens the quick command menu at the cursor instead of casting - but
187:       // not on one the hero may attack, where the click is the attack. Ctrl
188:       // is the force-cast modifier below, so it still aims past the player.
189:       if (
190:         ev.type === PointerEventTypes.POINTERDOWN &&
191:         !ev.event.ctrlKey &&
192:         !pvp &&
193:         Commands.openQuickOn(hovered, ev.event.clientX, ev.event.clientY)
194:       ) {
195:         return;
196:       }
197:       // Right button: skill use (Attack() with MouseRButton). Re-picked on
198:       // every move while held so the cast follows the cursor.
199:       if (ev.type === PointerEventTypes.POINTERDOWN) {
200:         world.rightPointerPressed = true;
201:         // A cast of the hero's own ends the follow (ZzzInterface.cpp:6812).
202:         Commands.stopFollowing();
203:       } else if (ev.type === PointerEventTypes.POINTERUP) {
204:         world.rightPointerPressed = false;
205:       }
206:       if (ev.type === PointerEventTypes.POINTERDOWN || rightDrag) {
207:         const ground = scene.pick(
208:           aimX(ev.event.clientX),
209:           aimY(ev.event.clientY),
210:           m => m === world.terrain?.mesh,
211:           true
212:         ).pickedPoint;
213:         // Without `pvp` a player under the cursor is no target, so a right
214:         // click in a crowd never opens fire on a passer-by. Ctrl over
215:         // anything else drops the object under the cursor and casts at the
216:         // ground point, to aim an area skill past a merchant standing in
217:         // the line of fire.
218:         const forced = ev.event.ctrlKey && !pvp;
219:         world.castRequest = {
220:           target: forced ? null : hovered,
221:           point: ground ? { x: ground.x, y: ground.z } : null,
222:           forced,
223:           pvp,
224:         };
225:       }
226:       return;
227:     }
228: 
229:     // Left button only: the middle button belongs to the camera (drag
230:     // rotate) and must never move or attack.
231:     if (ev.event.button !== 0) return;
232: 
233:     if (ev.type === PointerEventTypes.POINTERDOWN) {
234:       world.pointerPressed = true;
235:       // `MoveHero` (ZzzInterface.cpp:7535): a click of the hero's own -
236:       // ground, monster, NPC or drop - ends the follow.
237:       Commands.stopFollowing();
238: 
239:       const target = world.currentPointerTarget;
240:       if (
241:         target &&
242:         (isAttackableEntity(world, target) ||
243:           canAttackPlayer(world, target, ev.event.ctrlKey))
244:       ) {
245:         world.attackTarget = target;
246:       }
247:     } else if (ev.type === PointerEventTypes.POINTERUP) {
248:       world.pointerPressed = false;
249:     }
250:   });
251: 
252:   window.addEventListener('lostpointercapture', () => {
253:     world.pointerPressed = false;
254:     world.rightPointerPressed = false;
255:   });
256: 
257:   scene
258:     .getEngine()
259:     .getRenderingCanvas()
260:     ?.addEventListener('contextmenu', e => e.preventDefault());
261: 
262:   let delay = 0;
263: 
264:   return {
265:     update: dt => {
266:       // Touch only: with no cursor hovering, the ray this would re-sample is
267:       // just wherever the player last tapped, so a monster wandering across
268:       // it would steal the selection they made. The tap itself resolves the
269:       // target (POINTERDOWN above) and it stays until the next one.
270:       if (isMobileDevice()) return;
271: 
272:       delay -= dt;
273:       if (delay > 0) return;
274:       delay = HOVER_INTERVAL;
275: 
276:       // Re-aimed, not just re-tested: the camera moves without the mouse
277:       // (Insert/Delete, and every step of a keyboard walk), and a ray built
278:       // from where it used to stand hovers whatever used to be there.
279:       aimRay();
280:       applyTarget(resolveTarget());
281:     },
282:   };
283: };
