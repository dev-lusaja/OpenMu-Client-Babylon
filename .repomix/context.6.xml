<file path="src/events/duelRules.ts">
 1: import type { TextKey } from '../i18n';
 2: import { DuelStartResultDuelStartResultTypeEnum as DuelStartResult } from '../common/packets/ServerToClientPackets';
 3: 
 4: /**
 5:  * Pure duel logic, ported from `DuelMgr.cpp` / `WSclient.cpp:8465-8498`
 6:  * (`ReceiveDuelScore`, `ReceiveDuelHP`): id-perspective mapping and the
 7:  * packet-shape quirks of OpenMU's duel senders. No state, no imports of the
 8:  * store - `duel.ts` calls these and vitest covers them directly.
 9:  */
10: 
11: /** `MAX_DUEL_CHANNELS`: the watch window's fixed row count. */
12: export const DUEL_CHANNELS = 4;
13: /** Bytes per `DuelStatus` room row (2 names + running + open). */
14: const ROOM_BYTES = 22;
15: /** `DuelSpectatorList` carries this many fixed name slots. */
16: const SPECTATOR_SLOTS = 10;
17: 
18: const ID_MASK = 0x7fff;
19: 
20: /**
21:  * Which way a `Player1/Player2` packet pair maps onto the stored duel sides.
22:  * The reference compares ids, not order (`IsDuelPlayer`), because broadcast
23:  * packets arrive in requester/opponent order for spectators but in
24:  * self/opponent order for duelists.
25:  */
26: export function orientPair(
27:   side1Id: number,
28:   side2Id: number,
29:   packet1Id: number,
30:   packet2Id: number
31: ): 'direct' | 'swapped' | null {
32:   const s1 = side1Id & ID_MASK;
33:   const s2 = side2Id & ID_MASK;
34:   const p1 = packet1Id & ID_MASK;
35:   const p2 = packet2Id & ID_MASK;
36:   if (s1 === p1 && s2 === p2) return 'direct';
37:   if (s1 === p2 && s2 === p1) return 'swapped';
38:   return null;
39: }
40: 
41: /** Orders a `[for player1, for player2]` value pair onto `[side1, side2]`. */
42: export function orientValues<T>(
43:   orientation: 'direct' | 'swapped',
44:   value1: T,
45:   value2: T
46: ): [T, T] {
47:   return orientation === 'direct' ? [value1, value2] : [value2, value1];
48: }
49: 
50: /**
51:  * How many room rows a `DuelStatus` packet carries. The codec pins 4 (92
52:  * bytes), but the row math keeps a reconfigured server readable.
53:  */
54: export function roomCountOf(byteLength: number): number {
55:   return Math.max(0, Math.floor((byteLength - 4) / ROOM_BYTES));
56: }
57: 
58: /**
59:  * OpenMU's `DuelSpectatorListUpdatePlugIn` never writes the `Count` field,
60:  * so the client reads every fixed slot and keeps the real names.
61:  */
62: export function presentSpectators(slots: readonly string[]): string[] {
63:   return slots
64:     .slice(0, SPECTATOR_SLOTS)
65:     .map(name => name.replace(/\0+/g, '').trim())
66:     .filter(name => name.length > 0);
67: }
68: 
69: /** `ReceiveDuelStart`'s answers, keyed like the guild result tables. */
70: const FAILURE_KEYS: Partial<Record<DuelStartResult, TextKey>> = {
71:   [DuelStartResult.Refused]: 'duel.refused',
72:   [DuelStartResult.FailedByTooLowLevel]: 'duel.failedLevel',
73:   [DuelStartResult.FailedByNotEnoughMoney]: 'duel.failedZen',
74:   [DuelStartResult.FailedByNoFreeRoom]: 'duel.failedRoom',
75: };
76: 
77: /** `DuelStartResult` failures -> catalogue key; `Success` is null. */
78: export function duelStartFailureKey(result: DuelStartResult): TextKey | null {
79:   if (result === DuelStartResult.Success) return null;
80:   return FAILURE_KEYS[result] ?? 'duel.failedError';
81: }
</file>

