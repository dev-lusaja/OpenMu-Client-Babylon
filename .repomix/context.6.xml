  2: import type { ENUM_WORLD } from '../common/types';
  3: import { EventBus } from '../libs/eventBus';
  4: import { Notices } from '../common/notices';
  5: import {
  6:   MapEventStateEventsEnum,
  7:   MapEventStatePacket,
  8:   UpdateMiniGameStateMiniGameTypeStateEnum,
  9:   UpdateMiniGameStatePacket,
 10: } from '../common/packets/ServerToClientPackets';
 11: import type { EventLayer } from './layer';
 12: import { EVENT_TEXT, formatText } from './recipes';
 13: import { t, type TextKey } from '../i18n';
 14: 
 15: /**
 16:  * The lines every event shares: the 30-second state countdown
 17:  * (`CSBaseMatch::StartMatchCountDown` / `RenderTime`, CSEventMatch.cpp -
 18:  * "%s Closing (in %d seconds)" at the bottom of the screen) and the map
 19:  * invasion banners (`MapEventState`: Red / Golden Dragon).
 20:  *
 21:  * Driven by: `UpdateMiniGameState` (0x92, `ReceiveDevilSquareCountDown`)
 22:  * and `MapEventState`. Read by: `EventCountdown` in
 23:  * `ui/pages/worldPage/components/events` through `matchCountdownLine()`.
 24:  */
 25: 
 26: // ---- 1. tuning -------------------------------------------------------------
 27: 
 28: /** `kMatchCountdownDuration`: the line runs this long, then vanishes. */
 29: const COUNTDOWN_SECONDS = 30;
 30: 
 31: /**
 32:  * `RenderTime`: which `GlobalText` line each 0x92 state maps to. The
 33:  * original's `StartMatchCountDown(Value + 1)` reads value 0..2 as
 34:  * `TYPE_MATCH_DEVIL_ENTER_START/ENTER_CLOSE/CLOSE` (640..642), 3..6 as
 35:  * `TYPE_MATCH_CASTLE_ENTER_CLOSE/INFILTRATION/CLOSE/END` (824..827) and
 36:  * 10..13 as the Chaos Castle four (824, 828, 826, 827). Devil Square lines
 37:  * take one `%d`; the castle lines take the zone name and the `%d`.
 38:  *
 39:  * What the server *means* by a value differs from the original's table
 40:  * for the castles: OpenMU (`MiniGameContext.RunGameAsync`) only ever sends
 41:  * `Closed` (3 / 10) - and it does so *after* `CloseEntranceAsync`, 30 s
 42:  * before `StartAsync` - and `Ended` (6 / 13) 30 s before the shutdown
 43:  * warp. The original's 824 "%s Closing" belongs to the last 30 s the gate
 44:  * is still open; when 3 arrives from OpenMU the gate is already shut and
 45:  * everyone is inside waiting for the assault, which is the original's 825
 46:  * "Infiltration" / 828 "Penetration" moment (Devil Square's 0 → 640 "You
 47:  * will enter … (N seconds from now)" already says exactly that). So
 48:  * `Closed` prints the start line and `Opened` - never sent by OpenMU, but
 49:  * the original's "gate closes in N" if a server ever does - the closing one.
 50:  */
 51: const COUNTDOWN_TEXT: Readonly<
 52:   Record<number, { template: string; zone?: string }>
 53: > = {
 54:   [UpdateMiniGameStateMiniGameTypeStateEnum.DevilSquareClosed]: {
 55:     template: EVENT_TEXT.devilEnterStart,
 56:   },
 57:   [UpdateMiniGameStateMiniGameTypeStateEnum.DevilSquareOpened]: {
 58:     template: EVENT_TEXT.devilEnterClose,
 59:   },
 60:   [UpdateMiniGameStateMiniGameTypeStateEnum.DevilSquareRunning]: {
 61:     template: EVENT_TEXT.devilClose,
 62:   },
 63:   [UpdateMiniGameStateMiniGameTypeStateEnum.BloodCastleClosed]: {
 64:     template: EVENT_TEXT.zoneInfiltration,
 65:     zone: EVENT_TEXT.bloodCastleZone,
 66:   },
 67:   [UpdateMiniGameStateMiniGameTypeStateEnum.BloodCastleOpened]: {
 68:     template: EVENT_TEXT.zoneClosing,
 69:     zone: EVENT_TEXT.bloodCastleZone,
 70:   },
 71:   [UpdateMiniGameStateMiniGameTypeStateEnum.BloodCastleEnding]: {
 72:     template: EVENT_TEXT.zoneEventEnds,
 73:     zone: EVENT_TEXT.bloodCastleZone,
 74:   },
 75:   [UpdateMiniGameStateMiniGameTypeStateEnum.BloodCastleFinished]: {
 76:     template: EVENT_TEXT.zoneShutsDown,
 77:     zone: EVENT_TEXT.bloodCastleZone,
 78:   },
 79:   // `TYPE_MATCH_CHAOS_EINFILTRATION` is redirected 825 → 828 by RenderTime.
 80:   [UpdateMiniGameStateMiniGameTypeStateEnum.ChaosCastleClosed]: {
 81:     template: EVENT_TEXT.zonePenetration,
 82:     zone: EVENT_TEXT.chaosCastleZone,
 83:   },
 84:   [UpdateMiniGameStateMiniGameTypeStateEnum.ChaosCastleOpened]: {
 85:     template: EVENT_TEXT.zoneClosing,
 86:     zone: EVENT_TEXT.chaosCastleZone,
 87:   },
 88:   [UpdateMiniGameStateMiniGameTypeStateEnum.ChaosCastleEnding]: {
 89:     template: EVENT_TEXT.zoneEventEnds,
 90:     zone: EVENT_TEXT.chaosCastleZone,
 91:   },
 92:   [UpdateMiniGameStateMiniGameTypeStateEnum.ChaosCastleFinished]: {
 93:     template: EVENT_TEXT.zoneShutsDown,
 94:     zone: EVENT_TEXT.chaosCastleZone,
 95:   },
 96: };
 97: 
 98: /**
 99:  * Ours: OpenMU's `MapEventState` has no text of its own in the original
100:  * (it only lit the dragon effects), so the banner wording is the clone's.
101:  */
102: const MAP_EVENT_TEXT: Readonly<Record<number, TextKey>> = {
103:   [MapEventStateEventsEnum.RedDragon]: 'event.redDragon',
104:   [MapEventStateEventsEnum.GoldenDragon]: 'event.goldenDragon',
105: };
106: 
107: // ---- 2. state + readers ----------------------------------------------------
108: 
109: const state = observable(
110:   {
111:     template: null as { template: string; zone?: string } | null,
112:     /** Seconds left of the 30; whole seconds are what the line prints. */
113:     left: 0,
114:   },
115:   {},
116:   { deep: false }
117: );
118: 
119: /** The countdown line to draw, or null when none is running. */
120: export function matchCountdownLine(): string | null {
121:   const t = state.template;
122:   if (!t || state.left <= 0) return null;
123:   const seconds = Math.ceil(state.left);
124:   return t.zone
125:     ? formatText(t.template, t.zone, seconds)
126:     : formatText(t.template, seconds);
127: }
128: 
129: function update(_map: ENUM_WORLD, dt: number): void {
130:   if (!state.template) return;
131:   runInAction(() => {
132:     state.left = Math.max(0, state.left - dt);
133:     if (state.left === 0) state.template = null;
134:   });
135: }
136: 
137: function reset(): void {
138:   // The countdown is global - a warp into the event must not eat it - so
139:   // only a finished line is dropped here.
140:   if (state.left <= 0) {
141:     runInAction(() => {
142:       state.template = null;
143:     });
144:   }
145: }
146: 
147: // ---- packets ---------------------------------------------------------------
148: 
149: EventBus.on('UpdateMiniGameState', packet => {
150:   const p = new UpdateMiniGameStatePacket(packet);
151:   const text = COUNTDOWN_TEXT[p.State];
152:   if (!text) return;
153:   runInAction(() => {
154:     state.template = text;
155:     state.left = COUNTDOWN_SECONDS;
156:   });
157: });
158: 
159: EventBus.on('MapEventState', packet => {
160:   const p = new MapEventStatePacket(packet);
161:   const key = MAP_EVENT_TEXT[p.Event];
162:   if (p.Enable && key) Notices.create(t(key));
163: });
164: 
165: // ---- 3. the layer ----------------------------------------------------------
166: 
167: export const matchNoticesLayer: EventLayer = {
168:   name: 'matchNotices',
169:   update,
170:   reset,
171:   state: () => ({ open: false, running: state.template !== null }),
172: };
</file>

