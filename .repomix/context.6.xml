 73:   BaseClass.MagicGladiator,
 74:   BaseClass.DarkLord,
 75:   BaseClass.RageFighter,
 76: ]);
 77: /** Seconds the result box stays before it clears itself. */
 78: const RESULT_SECONDS = 15;
 79: /** Ticket byte the NPC route sends: "no inventory slot, take any cloak". */
 80: const NO_TICKET_SLOT = 0xff;
 81: /** How long the OK-box substitutes stay on screen. */
 82: const MESSAGE_MS = 5000;
 83: 
 84: // ---- 2. state + readers ----------------------------------------------------
 85: 
 86: export type BloodCastleTimer = {
 87:   /** Seconds left in the match; counted down between `BloodCastleState` resyncs. */
 88:   seconds: number;
 89:   killed: number;
 90:   /** `NO_KILL_QUOTA` hides the count line. */
 91:   maxKill: number;
 92:   /** `GetMatchType() == 5`: the gate is down, the count is Magic Skeletons. */
 93:   gateDestroyed: boolean;
 94:   running: boolean;
 95: };
 96: 
 97: export type BloodCastleScore = {
 98:   success: boolean;
 99:   name: string;
100:   score: number;
101:   exp: number;
102:   zen: number;
103: };
104: 
105: const state = observable(
106:   {
107:     open: false,
108:     buttons: [] as EntryButton[],
109:     active: -1,
110:     timer: {
111:       seconds: 0,
112:       killed: 0,
113:       maxKill: NO_KILL_QUOTA,
114:       gateDestroyed: false,
115:       running: false,
116:     } as BloodCastleTimer,
117:     score: null as BloodCastleScore | null,
118:   },
119:   {},
120:   { deep: false }
121: );
122: 
123: let scoreLeft = 0;
124: 
125: /** The messenger window: whether it is up and its eight buttons. */
126: export function bloodCastleWindow(): {
127:   open: boolean;
128:   buttons: EntryButton[];
129:   active: number;
130: } {
131:   return { open: state.open, buttons: state.buttons, active: state.active };
132: }
133: 
134: /** The match timer the castle HUD draws. */
135: export function bloodCastleTimer(): BloodCastleTimer {
136:   return state.timer;
137: }
138: 
139: /** `SetTime`: red clock under five minutes. */
140: export function bloodCastleImminent(): boolean {
141:   return state.timer.seconds / 60 < IMMINENT_MINUTES;
142: }
143: 
144: /** The result box, or null when there is none. */
145: export function bloodCastleScore(): BloodCastleScore | null {
146:   return state.score;
147: }
148: 
149: /** Whether a Blood Castle timer is what the HUD should draw on this map. */
150: export function inBloodCastle(map: ENUM_WORLD): boolean {
151:   return MAPS.has(map);
152: }
153: 
154: /** `OpenningProcess` + `Render`: build the buttons and show the window. */
155: export function openBloodCastle(): void {
156:   const pd = Store.playerData;
157:   const row = LOWER_LIMIT_CLASSES.has(getBaseClass(pd.charClass)) ? 1 : 0;
158:   const { buttons, active } = entryButtons(
159:     BLOOD_CASTLE_LEVELS,
160:     row,
161:     pd.level,
162:     isMasterClass(pd.charClass),
163:     EVENT_TEXT.castleButton,
164:     EVENT_TEXT.castleButtonMaster,
165:     MASTER_CASTLE_NUMBER
166:   );
167:   runInAction(() => {
168:     state.buttons = buttons;
169:     state.active = active;
170:     state.open = true;
171:   });
172: }
173: 
174: export function closeBloodCastle(): void {
175:   runInAction(() => {
176:     state.open = false;
177:   });
178: }
179: 
180: /** `SendBloodCastleEnterRequest(m_iNumActiveBtn + 1, 0xFF)`. */
181: export function enterBloodCastle(grade: number): void {
182:   if (grade !== state.active) return;
183:   const packet = BloodCastleEnterRequestPacket.createPacket();
184:   packet.CastleLevel = grade + 1;
185:   packet.TicketItemInventoryIndex = NO_TICKET_SLOT;
186:   Store.sendToGS(packet.buffer);
187: }
188: 
189: /**
190:  * `CNewUIMyInventory` on a double-clicked Cloak of Invisibility:
191:  * `SendMiniGameOpeningStateRequest(2, Level - 1)`; a +0 cloak is refused.
192:  */
193: function useTicket(_slot: number, item: Item): boolean {
194:   const t = TICKETS.invisibilityCloak;
195:   if (item.group !== t.group || item.num !== t.num) return false;
196: 
197:   const level = item.lvl ?? 0;
198:   if (level === 0) {
199:     Store.addNotification(EVENT_TEXT.cloakLevelWrong, 'error', MESSAGE_MS);
200:     return true;
201:   }
202: 
203:   noteOpeningStateRequest(OPENING_STATE_GAME.bloodCastle);
204:   const packet = MiniGameOpeningStateRequestPacket.createPacket();
205:   packet.EventType = OPENING_STATE_GAME.bloodCastle;
206:   packet.EventLevel = level - 1;
207:   Store.sendToGS(packet.buffer);
208:   return true;
209: }
210: 
211: function update(map: ENUM_WORLD, dt: number): void {
212:   const t = state.timer;
213:   if (t.running && MAPS.has(map) && t.seconds > 0) {
214:     // Reassigned, not mutated: the observable is shallow.
215:     runInAction(() => {
216:       state.timer = { ...t, seconds: Math.max(0, t.seconds - dt) };
217:     });
218:   }
219: 
220:   if (state.score) {
221:     scoreLeft -= dt;
222:     if (scoreLeft <= 0) {
223:       runInAction(() => {
224:         state.score = null;
225:       });
226:     }
227:   }
228: }
229: 
230: function clearTimer(): void {
231:   runInAction(() => {
232:     state.timer = {
233:       seconds: 0,
234:       killed: 0,
235:       maxKill: NO_KILL_QUOTA,
236:       gateDestroyed: false,
237:       running: false,
238:     };
239:   });
240: }
241: 
242: function reset(): void {
243:   closeBloodCastle();
244:   clearTimer();
245:   runInAction(() => {
246:     state.score = null;
247:   });
248:   scoreLeft = 0;
249: }
250: 
251: // ---- packets ---------------------------------------------------------------
252: 
253: /** `ReceiveMoveToEventMatchResult`: close the window, explain a refusal. */
254: EventBus.on('BloodCastleEnterResult', packet => {
255:   const p = new BloodCastleEnterResultPacket(packet);
256:   closeBloodCastle();
257: 
258:   const zone = EVENT_TEXT.bloodCastleZone;
259:   let text: string | null = null;
260:   switch (p.Result) {
261:     case BloodCastleEnterResultEnterResultEnum.Success:
262:       break;
263:     case BloodCastleEnterResultEnterResultEnum.Failed:
264:       text = EVENT_TEXT.cloakLevelWrong;
265:       break;
266:     case BloodCastleEnterResultEnterResultEnum.NotOpen:
267:       text = formatText(EVENT_TEXT.timePassed, zone);
268:       break;
269:     case BloodCastleEnterResultEnterResultEnum.CharacterLevelTooHigh:
270:       text = EVENT_TEXT.levelTooHigh;
271:       break;
272:     case BloodCastleEnterResultEnterResultEnum.CharacterLevelTooLow:
273:       text = EVENT_TEXT.levelTooLow;
274:       break;
275:     case BloodCastleEnterResultEnterResultEnum.Full:
276:       text = formatText(EVENT_TEXT.capacityReached, zone, MAX_MEN);
277:       break;
278:     default:
279:       // 6 / 7 of the original's switch: per-day limit, killers.
280:       text =
281:         (p.Result as number) === 6
282:           ? formatText(EVENT_TEXT.timesPerDay, TIMES_PER_DAY)
283:           : formatText(EVENT_TEXT.killersRestricted, EVENT_TEXT.bloodCastle);
284:       break;
285:   }
286:   if (text) Store.addNotification(text, 'error', MESSAGE_MS);
287: });
288: 
289: /** `ReceiveEventZoneOpenTime`, Value 2: the cloak's answer. */
290: EventBus.on('MiniGameOpeningState', packet => {
291:   const p = new MiniGameOpeningStatePacket(packet);
292:   if (p.GameType !== OPENING_STATE_GAME.bloodCastle) return;
293: 
294:   const minutes = p.RemainingEnteringTimeMinutes;
295:   // The HUD rows ask the same question on their own timer; those answers
296:   // feed the schedule and say nothing.
297:   if (takeOpeningState(OPENING_STATE_GAME.bloodCastle, minutes)) return;
298: 
299:   const zone = EVENT_TEXT.bloodCastleZone;
300:   Store.addNotification(
301:     minutes === 0
302:       ? formatText(EVENT_TEXT.enterNow, zone)
303:       : formatText(EVENT_TEXT.enterAfterMinutes, minutes, zone),
304:     'info',
305:     MESSAGE_MS
306:   );
307: });
308: 
309: /** `SetMatchGameCommand` (NewBloodCastleSystem.cpp): states 0..4. */
310: EventBus.on('BloodCastleState', packet => {
311:   const p = new BloodCastleStatePacket(packet);
312: 
313:   switch (p.State) {
314:     case BloodCastleStateStatusEnum.BloodCastleStarted:
315:     case BloodCastleStateStatusEnum.BloodCastleGateNotDestroyed:
316:     case BloodCastleStateStatusEnum.BloodCastleGateDestroyed:
317:       runInAction(() => {
318:         state.timer = {
319:           seconds: p.RemainSecond,
320:           killed: p.CurMonster,
321:           maxKill: p.MaxMonster,
322:           gateDestroyed:
323:             p.State === BloodCastleStateStatusEnum.BloodCastleGateDestroyed,
324:           running: true,
325:         };
326:       });
327:       break;
328:     case BloodCastleStateStatusEnum.BloodCastleEnded:
329:       clearTimer();
330:       break;
331:     default:
332:       // 5..10 belong to Chaos Castle (chaosCastle.ts).
333:       break;
334:   }
335: });
336: 
337: /** `ReceiveDevilSquareRank` with the 29-byte Blood Castle body. */
338: EventBus.on('BloodCastleScore', packet => {
339:   const p = new BloodCastleScorePacket(packet);
340:   scoreLeft = RESULT_SECONDS;
341:   runInAction(() => {
342:     state.score = {
343:       success: p.Success,
344:       name: p.PlayerName,
345:       // The generated reader is `getUint32`; the server sends a signed score
346:       // (a failed castle is -300 -> 4294966996 otherwise, B12). `| 0` is the
347:       // int32 reinterpretation without touching the generated file.
348:       score: p.TotalScore | 0,
349:       exp: p.BonusExperience,
350:       zen: p.BonusMoney,
351:     };
352:   });
353: });
354: 
355: // ---- 3. the layer ----------------------------------------------------------
356: 
357: export const bloodCastleLayer: EventLayer = {
358:   name: 'bloodCastle',
359:   maps: MAPS,
360:   update,
361:   reset,
362:   state: () => ({ open: state.open, running: state.timer.running }),
363:   useTicket,
364: };
</file>

