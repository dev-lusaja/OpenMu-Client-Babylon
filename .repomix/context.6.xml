149:   function despawn(owner: Entity, raven: boolean) {
150:     (raven ? spawnedRaven : spawned).delete(owner);
151: 
152:     for (const actor of [...actors.entities]) {
153:       if (actor.petActor.owner !== owner) continue;
154:       if ((actor.petActor.kind === 'raven') !== raven) continue;
155:       world.remove(actor);
156:       actor.modelObject?.dispose();
157:     }
158:   }
