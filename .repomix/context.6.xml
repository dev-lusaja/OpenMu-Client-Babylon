116: /**
117:  * An effect's release runs from the frame loop, and a throw there does not
118:  * stop at the effect: it climbs through `effects.update` and the ECS into
119:  * Babylon's render loop, which never queues another frame after an exception
120:  * - the picture freezes while the socket and the audio carry on. `update`
121:  * already drops a throwing effect; its release gets the same treatment.
122:  */
123: function release(e: LiveEffect): void {
124:   try {
125:     e.release();
126:   } catch (err) {
127:     console.warn('[effects] effect release threw', err);
128:   }
129: }
