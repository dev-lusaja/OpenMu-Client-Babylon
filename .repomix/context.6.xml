 31: /**
 32:  * Devil Square: Charon's entry window (`CNewUIEnterDevilSquare`,
 33:  * NewUIEnterDevilSquare.cpp), the Devil's Invitation ticket and the rank
 34:  * table at the end (`CSDevilSquareMatch::SetMatchResult` /
 35:  * `RenderMatchResult`, CSEventMatch.cpp).
 36:  *
 37:  * Driven by: `NpcWindowResponse` (DevilSquare) via `openDevilSquare`, the
 38:  * inventory ticket via `useTicket`, and the `DevilSquareEnterResult` /
 39:  * `MiniGameOpeningState` / `MiniGameScoreTable` packets. Read by the
 40:  * entry window and result table in `ui/pages/worldPage/components/events`.
 41:  *
 42:  * There is no per-second match clock for the square: the original only
 43:  * has the 30 s state countdown line (`matchNotices.ts`).
 44:  */
 45: 
 46: // ---- 1. tuning -------------------------------------------------------------
 47: 
 48: /** The square map (`WD_9DEVILSQUARE`) and OpenMU's map 32 for squares 5-7, the same world. */
 49: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([
 50:   ENUM_WORLD.WD_9DEVILSQUARE,
 51:   ENUM_WORLD.WD_32DEVILSQUARE_5_7,
 52: ]);
 53: /** `GlobalText[1778]` argument: the number the master square button shows. */
 54: const MASTER_SQUARE_NUMBER = 7;
 55: /** Classes whose level table is the second row (`iLimitLVIndex = 1`). */
 56: const LOWER_LIMIT_CLASSES: ReadonlySet<BaseClass> = new Set([
 57:   BaseClass.Knight,
 58:   BaseClass.MagicGladiator,
 59:   BaseClass.DarkLord,
 60:   BaseClass.RageFighter,
 61: ]);
 62: /** `SetMatchResult` drops tables of 200 rows and more. */
 63: const MAX_RANK_ROWS = 200;
 64: /** Seconds the rank table stays before it clears itself. */
 65: const RESULT_SECONDS = 20;
 66: /** Ticket byte the NPC route sends: "no inventory slot, take any invitation". */
 67: const NO_TICKET_SLOT = 0xff;
 68: /** How long the OK-box substitutes stay on screen. */
 69: const MESSAGE_MS = 5000;
 70: 
 71: // ---- 2. state + readers ----------------------------------------------------
 72: 
 73: export type DevilSquareRank = {
 74:   name: string;
 75:   score: number;
 76:   exp: number;
 77:   zen: number;
 78: };
 79: 
 80: export type DevilSquareResult = {
 81:   /** 1-based rank of the hero, 0 when unplaced. */
 82:   myRank: number;
 83:   rows: DevilSquareRank[];
 84: };
 85: 
 86: const state = observable(
 87:   {
 88:     open: false,
 89:     buttons: [] as EntryButton[],
 90:     active: -1,
 91:     result: null as DevilSquareResult | null,
