196: /** One enter button of an entry window (`m_BtnEnter[i]`). */
197: export type EntryButton = { readonly label: string; readonly enabled: boolean };
198: 
199: /**
200:  * `CheckLimitLV` + `OpenningProcess`: every button of the window, with the
201:  * one grade the hero's level falls into unlocked - or the master button
202:  * when the hero is a master class, whatever the level. Returns the buttons
203:  * and the unlocked index (-1 when no grade fits).
204:  */
205: export function entryButtons(
206:   table: readonly (readonly LevelRange[])[],
207:   row: number,
208:   level: number,
209:   master: boolean,
210:   labelFormat: string,
211:   masterFormat: string,
212:   masterNumber: number
213: ): { buttons: EntryButton[]; active: number } {
214:   const ranges = table[row] ?? table[0]!;
215:   let active = -1;
216: 
217:   if (master) {
218:     active = ranges.length;
219:   } else {
220:     active = ranges.findIndex(([min, max]) => level >= min && level <= max);
221:   }
222: 
223:   const buttons: EntryButton[] = ranges.map(([min, max], i) => ({
224:     label: formatText(labelFormat, i + 1, min, max),
225:     enabled: i === active,
226:   }));
227:   buttons.push({
228:     label: formatText(masterFormat, masterNumber),
229:     enabled: active === ranges.length,
230:   });
231: 
232:   return { buttons, active };
233: }
