  1: import {
  2:   Matrix,
  3:   PointerEventTypes,
  4:   Ray,
  5:   Vector3,
  6: } from '../../libs/babylon/exports';
  7: import { TWFlags } from '../../common/terrain/consts';
  8: import { isFlagInBinaryMask } from '../../common/utils';
  9: import { aimX, aimY } from '../../camera';
 10: import { LEAN_CURSOR_OBJECTS, findRestObject } from '../../libs/mu/restObjects';
 11: import { Store } from '../../store';
 12: import type { CursorHover } from '../../ui/components/gameCursor/cursors';
 13: import type { Entity, ISystemFactory, World } from '../world';
 14: import { isAttackableEntity, isNpcOrTrapType } from './attackSystem';
 15: 
 16: const SAMPLE_INTERVAL = 0.05;
 17: 
 18: 
 19: function isNpcEntity(e: Entity): boolean {
 20:   const type = e.npcType;
 21: 
 22:   if (type === undefined) return false;
 23:   if (type >= 100 && type <= 110) return false;
 24:   return isNpcOrTrapType(type);
 25: }
 26: 
 27: function isDontMoveTile(world: World, x: number, y: number): boolean {
 28:   const flag = world.getTerrainFlag(x, y);
 29: 
 30:   if (flag < TWFlags.NoGround) return false;
 31:   if (isFlagInBinaryMask(flag, TWFlags.Action)) return false;
 32:   if (isFlagInBinaryMask(flag, TWFlags.Height)) return false;
 33: 
 34:   return true;
 35: }
 36: 
 37: export const CursorSystem: ISystemFactory = world => {
 38:   const scene = world.scene;
 39: 
 40:   const propsQuery = world.with(
 41:     'modelObject',
 42:     'transform',
 43:     'visibility',
 44:     'modelId',
 45:     'worldIndex'
 46:   );
 47: 
 48:   const tmpRay = new Ray(Vector3.Zero(), Vector3.Up(), 1);
 49: 
 50:   const identity = Matrix.Identity();
 51: 
 52:   let lastClientX = 0;
 53:   let lastClientY = 0;
 54: 
 55:   scene.onPointerObservable.add(ev => {
 56:     if (ev.type !== PointerEventTypes.POINTERMOVE) return;
 57: 
 58:     lastClientX = ev.event.clientX;
 59:     lastClientY = ev.event.clientY;
 60:   });
 61: 
 62:   function hoveredRestObject(): CursorHover | null {
 63:     scene.createPickingRayToRef(
 64:       aimX(lastClientX),
 65:       aimY(lastClientY),
 66:       identity,
 67:       tmpRay,
 68:       null
 69:     );
 70: 
 71:     for (const e of propsQuery) {
 72:       if (e.worldIndex !== world.mapIndex) continue;
 73:       if (e.visibility.state === 'hidden') continue;
 74:       if (!findRestObject(world.mapIndex, e.modelId)) continue;
 75:       if (!e.modelObject.Ready) continue;
 76: 
 77:       e.modelObject.UpdateBoundings();
 78:       const bb = e.modelObject.BoundingBoxLocal;
 79: 
 80:       if (!tmpRay.intersectsBoxMinMax(bb.minimumWorld, bb.maximumWorld)) {
 81:         continue;
 82:       }
 83: 
 84:       return LEAN_CURSOR_OBJECTS[world.mapIndex]?.has(e.modelId)
 85:         ? 'lean'
 86:         : 'sit';
 87:     }
 88: 
 89:     return null;
 90:   }
 91: 
 92:   function resolveHover(): CursorHover | null {
 93:     const target = world.currentPointerTarget;
 94: 
 95:     if (target) {
 96:       if (target.droppedItem) return Store.pickedItem ? null : 'get';
 97:       if (isNpcEntity(target)) return 'talk';
 98:       if (isAttackableEntity(world, target)) return 'attack';
 99: 
100:       return null;
101:     }
102: 
103:     return hoveredRestObject();
104:   }
105: 
106:   let delay = 0;
107: 
108:   return {
109:     update: dt => {
110:       delay -= dt;
111:       if (delay > 0) return;
112:       delay = SAMPLE_INTERVAL;
113: 
114:       world.cursorHover = resolveHover();
115: 
116:       if (!world.pointerPressed) return;
117: 
118:       const pickInfo = scene.pick(
119:         aimX(lastClientX),
120:         aimY(lastClientY),
121:         m => m === world.terrain?.mesh,
122:         true
123:       );
124: 
125:       const point = pickInfo?.pickedPoint;
126: 
127:       world.cursorBlocked = point
128:         ? isDontMoveTile(world, ~~point.x, ~~point.z)
129:         : false;
130:     },
131:   };
132: };
