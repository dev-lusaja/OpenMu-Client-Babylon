 41: export type { EventLayer, EventEntryState } from './layer';
 42: 
 43: /**
 44:  * The events layer: Blood Castle, Devil Square, Chaos Castle and the lines
 45:  * they share, behind one object. Copy `_template.ts` when adding to it.
 46:  *
 47:  * The game talks to `events.update` once a frame (`ecs/systems/eventSystem.ts`)
 48:  * and `events.reset` on a map change (`libs/mu/loadMapIntoScene.ts`); both
 49:  * fan out over `EVENT_LAYERS` (`layers.ts`), the only list of events in the
 50:  * codebase. The commands below are what `logic.ts` (NPC windows) and the
 51:  * inventory (tickets) call; the HUD reads the entry files directly.
 52:  */
 53: class Events {
 54:   private readonly layers: EventLayer[] = [...EVENT_LAYERS];
 55: 
 56:   /** Add an event at runtime (tools, experiments). Returns the unregister. */
 57:   register(layer: EventLayer): () => void {
 58:     this.layers.push(layer);
 59:     return () => {
 60:       const i = this.layers.indexOf(layer);
 61:       if (i >= 0) this.layers.splice(i, 1);
 62:     };
 63:   }
 64: 
 65:   /** Every event that exists on this map. */
 66:   layersFor(map: ENUM_WORLD): EventLayer[] {
 67:     return this.layers.filter(l => !l.maps || l.maps.has(map));
 68:   }
 69: 
 70:   /** Step every layer. Call once a frame, before anything reads the events. */
 71:   update(map: ENUM_WORLD, dt: number): void {
 72:     for (const layer of this.layers) layer.update?.(map, dt);
 73:   }
 74: 
 75:   /** Drop every layer's state. Call when the map changes. */
 76:   reset(): void {
 77:     for (const layer of this.layers) layer.reset?.();
 78:   }
