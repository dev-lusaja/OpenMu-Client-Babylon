  1: import { observable, runInAction } from 'mobx';
  2: import { GameOptions } from '../common/gameOptions';
  3: import { devQueryNumbers } from '../common/devSeams';
  4: import { serverNow } from '../common/serverTime';
  5: import { MiniGameOpeningStateRequestPacket } from '../common/packets/ClientToServerPackets';
  6: import { Store, UIState } from '../store';
  7: import type { EventLayer } from './layer';
  8: import { OPENING_STATE_GAME } from './recipes';
  9: import {
 10:   MIN_REQUEST_MS,
 11:   UNKNOWN_ENTRY,
 12:   countdownSeconds,
 13:   nextPollAt,
 14:   resolveOpening,
 15:   type EventScheduleEntry,
 16: } from './scheduleClock';
 17: 
 18: export type { EventScheduleEntry } from './scheduleClock';
 19: 
 20: /**
 21:  * When each event next opens, on the one clock (`common/serverTime.ts`).
 22:  *
 23:  * The only writer of that state. It is fed by the three
 24:  * `MiniGameOpeningState` handlers (`bloodCastle.ts`, `devilSquare.ts`,
 25:  * `chaosCastle.ts`), which call `takeOpeningState` before they word their
 26:  * own notice, and it keeps the answer fresh by re-sending the very request
 27:  * a ticket sends - `MiniGameOpeningStateRequest`, nothing new on the wire.
 28:  * OpenMU answers it from `MiniGameOpeningStateRequestHandlerPlugIn` with no
 29:  * NPC dialog open: the only thing it asks for is a selected character.
 30:  *
 31:  * Read by the HUD rows in `ui/pages/worldPage/components/events`.
 32:  */
 33: 
 34: // ---- 1. tuning -------------------------------------------------------------
 35: 
 36: /** Display order of the rows, and the only three events OpenMU runs. */
 37: export const EVENT_SCHEDULE_KEYS = ['bloodCastle', 'devilSquare', 'chaosCastle'] as const;
 38: 
 39: export type EventScheduleKey = (typeof EVENT_SCHEDULE_KEYS)[number];
 40: 
 41: const GAME_OF: Readonly<Record<EventScheduleKey, number>> = {
 42:   bloodCastle: OPENING_STATE_GAME.bloodCastle,
 43:   devilSquare: OPENING_STATE_GAME.devilSquare,
 44:   chaosCastle: OPENING_STATE_GAME.chaosCastle,
 45: };
 46: 
 47: /**
 48:  * Chaos Castle is the one answer that carries the minutes as two bytes
 49:  * (`ShowMiniGameOpeningStateViewPlugIn`), so its "no timetable" sentinel is
 50:  * 0xFFFF where the other two send 0xFF.
 51:  */
 52: const WIDE_MINUTES: Readonly<Record<EventScheduleKey, boolean>> = {
 53:   bloodCastle: false,
 54:   devilSquare: false,
 55:   chaosCastle: true,
 56: };
 57: 
 58: /**
 59:  * `GetSuitableMiniGameDefinition` falls back to the definition whose
 60:  * `GameLevel` equals the level asked for when the hero is in no level range
 61:  * at all. Every event has a level 1 definition and none has a level 0, so 1
 62:  * is the value that always resolves - a 0 would leave Chaos Castle with no
 63:  * definition and throw on the server.
 64:  */
 65: const POLL_EVENT_LEVEL = 1;
 66: 
 67: /** An unanswered request is written off after this and may be retried. */
 68: const ANSWER_TIMEOUT_MS = 15_000;
 69: /**
 70:  * A server that never answers for an event (the periodic task disabled) is
 71:  * left alone after this many tries; a warp or a click on the row retries.
 72:  */
 73: const MAX_SILENT_POLLS = 3;
 74: 
 75: // ---- 2. state + readers ----------------------------------------------------
 76: 
 77: export type EventScheduleRow = {
 78:   readonly key: EventScheduleKey;
 79:   readonly open: boolean;
 80:   /** Answered, but no nearer than the 255 minutes one byte can hold. */
 81:   readonly far: boolean;
 82:   /** Whole seconds until it opens, or null when open / far off / not known. */
 83:   readonly seconds: number | null;
 84: };
 85: 
 86: const entries: Record<EventScheduleKey, EventScheduleEntry> = {
 87:   bloodCastle: UNKNOWN_ENTRY,
 88:   devilSquare: UNKNOWN_ENTRY,
 89:   chaosCastle: UNKNOWN_ENTRY,
 90: };
 91: 
 92: type PollState = {
 93:   nextPollAtMs: number;
 94:   lastRequestMs: number;
 95:   /** Set while a request of ours is out; null when nothing is awaited. */
 96:   sentAtMs: number | null;
 97:   silentPolls: number;
 98:   /** A ticket or a row click is waiting for the answer: it gets the notice. */
 99:   manual: boolean;
100: };
101: 
102: const polls: Record<EventScheduleKey, PollState> = {
103:   bloodCastle: fresh(),
104:   devilSquare: fresh(),
105:   chaosCastle: fresh(),
106: };
107: 
108: function fresh(): PollState {
109:   return {
110:     nextPollAtMs: 0,
111:     lastRequestMs: Number.NEGATIVE_INFINITY,
112:     sentAtMs: null,
113:     silentPolls: 0,
114:     manual: false,
115:   };
116: }
117: 
118: /** What the HUD draws, one row per event, in `EVENT_SCHEDULE_KEYS` order. */
119: const state = observable(
120:   {
121:     rows: EVENT_SCHEDULE_KEYS.map(key => ({
122:       key,
123:       open: false,
124:       far: false,
125:       seconds: null,
126:     })) as readonly EventScheduleRow[],
127:   },
128:   {},
129:   { deep: false }
130: );
131: 
132: export function eventSchedule(): readonly EventScheduleRow[] {
133:   return state.rows;
134: }
135: 
136: function keyOfGame(game: number): EventScheduleKey | null {
137:   for (const key of EVENT_SCHEDULE_KEYS) {
138:     if (GAME_OF[key] === game) return key;
139:   }
140:   return null;
141: }
142: 
143: /**
144:  * A `MiniGameOpeningState` answer, before its handler words it. Returns true
145:  * when it answers a poll of ours, so the handler shows nothing.
146:  */
147: export function takeOpeningState(game: number, minutes: number): boolean {
148:   const key = keyOfGame(game);
149:   if (!key) return false;
150: 
151:   const now = serverNow();
152:   const poll = polls[key];
153:   const ours = poll.sentAtMs !== null && !poll.manual;
154: 
155:   entries[key] = resolveOpening(minutes, WIDE_MINUTES[key], now);
156:   poll.sentAtMs = null;
157:   poll.manual = false;
158:   poll.silentPolls = 0;
159:   poll.nextPollAtMs = nextPollAt(entries[key], now);
160:   publish(now);
161: 
162:   return ours;
163: }
164: 
165: /** A ticket or a row click sent the request: the answer is the player's. */
166: export function noteOpeningStateRequest(game: number): void {
167:   const key = keyOfGame(game);
168:   if (!key) return;
169:   const poll = polls[key];
170:   poll.manual = true;
171:   poll.lastRequestMs = serverNow();
172:   poll.sentAtMs = null;
173: }
174: 
175: /** The row was clicked while nothing is known: ask again as soon as allowed. */
176: export function refreshEventSchedule(key: EventScheduleKey): void {
177:   const poll = polls[key];
178:   poll.silentPolls = 0;
179:   poll.sentAtMs = null;
180:   poll.nextPollAtMs = 0;
181: }
182: 
183: // ---- 3. the poll -----------------------------------------------------------
184: 
185: function publish(nowMs: number): void {
186:   const rows = EVENT_SCHEDULE_KEYS.map(key => ({
187:     key,
188:     open: entries[key].open,
189:     far: entries[key].far,
190:     seconds: countdownSeconds(entries[key], nowMs),
191:   }));
192:   const same = rows.every((row, i) => {
193:     const old = state.rows[i];
194:     return old.open === row.open && old.far === row.far && old.seconds === row.seconds;
195:   });
196:   if (same) return;
197:   runInAction(() => {
198:     state.rows = rows;
199:   });
200: }
201: 
202: function send(key: EventScheduleKey, nowMs: number): void {
203:   const packet = MiniGameOpeningStateRequestPacket.createPacket();
204:   packet.EventType = GAME_OF[key];
205:   packet.EventLevel = POLL_EVENT_LEVEL;
206:   Store.sendToGS(packet.buffer);
207: 
208:   const poll = polls[key];
209:   poll.lastRequestMs = nowMs;
210:   poll.sentAtMs = nowMs;
211:   poll.silentPolls += 1;
212:   // A lost answer must not wedge the row: the floor is the only guard.
213:   poll.nextPollAtMs = nowMs + MIN_REQUEST_MS;
214: }
215: 
216: function pollable(): boolean {
217:   return (
218:     GameOptions.eventTimers &&
219:     !Store.isOffline &&
220:     Store.uiState === UIState.World &&
221:     Store.world !== null
222:   );
223: }
224: 
225: /** The rows print whole seconds, so nothing is rebuilt in between. */
226: let publishedSecond = 0;
227: 
228: function tick(): void {
229:   if (!GameOptions.eventTimers) return;
230: 
231:   const now = serverNow();
232:   const second = Math.floor(now / 1000);
233:   if (second !== publishedSecond) {
234:     publishedSecond = second;
235:     publish(now);
236:   }
237:   if (!pollable()) return;
238: 
239:   for (const key of EVENT_SCHEDULE_KEYS) {
240:     const poll = polls[key];
241:     if (poll.sentAtMs !== null && now - poll.sentAtMs < ANSWER_TIMEOUT_MS) continue;
242:     if (poll.silentPolls >= MAX_SILENT_POLLS) continue;
243:     if (now < poll.nextPollAtMs) continue;
244:     if (now - poll.lastRequestMs < MIN_REQUEST_MS) continue;
245:     send(key, now);
246:   }
247: }
248: 
249: /** A warp: ask again as soon as the 30 s floor allows, on every event. */
250: function reset(): void {
251:   for (const key of EVENT_SCHEDULE_KEYS) {
252:     const poll = polls[key];
253:     poll.nextPollAtMs = 0;
254:     poll.sentAtMs = null;
255:     poll.silentPolls = 0;
256:   }
257: }
258: 
259: // Dev only (`?events=<blood>,<devil>,<chaos>` in minutes): stage the rows
260: // with no server. `devQueryNumbers` answers null in a production build.
261: const seeded = devQueryNumbers('events', EVENT_SCHEDULE_KEYS.length);
262: if (seeded) {
263:   const now = serverNow();
264:   EVENT_SCHEDULE_KEYS.forEach((key, i) => {
265:     entries[key] = resolveOpening(seeded[i], WIDE_MINUTES[key], now);
266:     polls[key].silentPolls = MAX_SILENT_POLLS;
267:   });
268:   publish(now);
269: }
270: 
271: // ---- 4. the layer ----------------------------------------------------------
272: 
273: export const scheduleLayer: EventLayer = {
274:   name: 'schedule',
275:   update: () => tick(),
276:   reset,
277:   state: () => ({ open: false, running: false }),
278: };
</file>

