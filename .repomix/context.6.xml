<file path="src/ecs/systems/impactEffectSystem.ts">
 1: import type { ISystemFactory } from '../world';
 2: import { EventBus } from '../../libs/eventBus';
 3: import {
 4:   SAND_SMOKE_RATE,
 5:   raisesSandSmoke,
 6:   spawnHitImpact,
 7:   spawnSandSmoke,
 8: } from '../../common/impactVisuals';
 9: 
10: /**
11:  * Sand smoke and hit impacts: the **consumer** that turns a
12:  * walking sand monster and the `ObjectHit` packet into `effects` spawns,
13:  * with the recipes in `common/impactVisuals.ts`.
14:  *
15:  * - `MonsterMoveSandSmoke` (ZzzCharacter.cpp:5456): every 25 Hz tick a
16:  *   walking Tarkan / Kalima monster drops one puff. Frame time is banked
17:  *   per monster so a 60 Hz frame emits 0 or 1 and a hitch emits the
18:  *   backlog, as the original's `rand_fps_check(1)` does.
19:  * - A blow is the `ObjectHit` packet: logic.ts already emits `objectDamaged`
20:  *   with the struck entity and the health / shield split; the sparks come off
21:  *   that.
22:  *
23:  * The hero's footsteps draw nothing - the original's `PlayWalkSound` is
24:  * sound only.
25:  */
26: export const ImpactEffectSystem: ISystemFactory = world => {
27:   const walkers = world.with('npcType', 'monsterAnimation', 'transform');
28:   /** Banked seconds per walking monster, spent a puff at a time. */
29:   const banked = new WeakMap<object, number>();
30: 
31:   EventBus.on('objectDamaged', ({ entity, healthDamage, shieldDamage }) => {
32:     if (entity.worldIndex !== undefined && entity.worldIndex !== world.mapIndex) return;
33:     spawnHitImpact(world.scene, entity, healthDamage, shieldDamage);
34:   });
35: 
36:   return {
37:     update: (dt: number) => {
38:       for (const e of walkers) {
39:         if (!raisesSandSmoke(e)) {
40:           banked.delete(e);
41:           continue;
42:         }
43:         let t = (banked.get(e) ?? 0) + dt;
44:         while (t >= 1 / SAND_SMOKE_RATE) {
45:           t -= 1 / SAND_SMOKE_RATE;
46:           spawnSandSmoke(world.scene, e);
47:         }
48:         banked.set(e, t);
49:       }
50:     },
51:   };
52: };
</file>

<file path="src/ecs/systems/interactiveAreaSystem.ts">
 1: import type { ISystemFactory } from '../world';
 2: import { Vector3 } from '../../libs/babylon/exports';
 3: 
 4: const v3Temp = Vector3.Zero();
 5: 
 6: export const InteractiveAreaSystem: ISystemFactory = world => {
 7:   const query = world.with('interactiveArea', 'worldIndex');
 8: 
 9:   return {
10:     update: () => {
11:       const playerEntity = world.playerEntity;
12:       if (!playerEntity) return;
13: 
14:       v3Temp.copyFrom(playerEntity.transform.pos as any);
15: 
16:       if (playerEntity.transform.posOffset !== undefined) {
17:         v3Temp.addInPlace(playerEntity.transform.posOffset as any);
18:       }
19: 
20:       for (const e of query) {
21:         if (e.worldIndex !== playerEntity.worldIndex) continue;
22: 
23:         const { min, max } = e.interactiveArea;
24: 
25:         const old = !!e.interactiveArea.inside;
26:         const newInside =
27:           v3Temp.x >= min.x &&
28:           v3Temp.x <= max.x &&
29:           v3Temp.z >= min.y &&
30:           v3Temp.z <= max.y;
31: 
32:         e.interactiveArea.inside = newInside;
33: 
34:         if (old !== newInside) {
35:           if (newInside) {
36:             e.interactiveArea.onEnter?.();
37:           } else {
38:             e.interactiveArea.onLeave?.();
39:           }
40:         }
41:       }
42:     },
43:   };
44: };
</file>

<file path="src/ecs/systems/itemGlowSystem.ts">
  1: import type { Entity, ISystemFactory, Item } from '../world';
  2: import {
  3:   itemVisualTier,
  4:   setItemGlowClock,
  5:   strongestTier,
  6:   type ItemVisualTier,
  7: } from '../../common/itemVisualTier';
  8: import {
  9:   improvedItemEffectsOn,
 10:   itemEffectSignature,
 11: } from '../../common/itemEffectMode';
 12: import type { PlayerObject } from '../../common/playerObject';
 13: import type { ModelObject } from '../../common/modelObject';
 14: import {
 15:   createItemAura,
 16:   type ItemAura,
 17:   type ItemAuraKind,
 18: } from '../../effects/itemAura';
 19: import { createItemCrackle, type ItemCrackle } from '../../effects/itemCrackle';
 20: import type { ItemSparkleKind } from '../../effects/itemSparkle';
 21: import { effects, type EffectHandle } from '../../effects';
 22: import { entityGone, entityPos, entityYaw, followEntity, tmpA } from '../../effects/core';
 23: import { requestGlowProbe } from '../../scenes/sceneLook';
 24: import { EventBus } from '../../libs/eventBus';
 25: import { itemSelfLight, lightItem, type ItemLampKind } from '../../lighting/items';
 26: import type { LightSource } from '../../lighting/lightSource';
 27: 
 28: /**
 29:  * Item glow.
 30:  *
 31:  *  - Stamps `metadata.itemTier` on item meshes once their model is in
 32:  *    (`PlayerObject.loadPartAsync` does the first stamp for gear; this system
 33:  *    re-stamps everything when the item-effects option or the level cap
 34:  *    changes, because tiers are baked per option state). itemMaterial.ts
 35:  *    (legacy passes) and the GlowLayer selector in sceneLook.ts read it.
 36:  *  - Improved look only: +9…+15 gear gets a lamp - one light source from the
 37:  *    lighting layer's `items` entry, following the body - plus an aura and a
 38:  *    crackle (effects/). Dropped +9…+15 items do the same, static.
 39:  *  - Both looks: an excellent item - worn or on the ground - throws the
 40:  *    `CreateShiny` star glints (`effects/itemSparkle.ts`), on the body for a
 41:  *    wearer, beside and above the drop for a drop.
 42:  *
 43:  * This system decides *which* entity is lit and keeps the lamp's position on
 44:  * the wearer; the light itself (range, colour, priority, the terrain stain)
 45:  * is `src/lighting/items.ts`.
 46:  */
 47: 
 48: type Lamp = {
 49:   tier: ItemVisualTier;
 50:   /** Shared with the light source, the aura and the crackle; moved in place. */
 51:   position: { x: number; y: number; z: number };
 52:   source: LightSource | null;
 53:   /**
 54:    * The world generation this lamp's scene objects were built in. A map load
 55:    * takes the scene they live in with it, so a lamp from an older generation
 56:    * has to be rebuilt even though the gear that made it never changed.
 57:    */
 58:   gen: number;
 59:   aura: ItemAura | null;
 60:   crackle: ItemCrackle | null;
 61: };
 62: 
 63: type Tracked = {
 64:   signature: string;
 65:   lamp: Lamp | null;
 66:   stamped: boolean;
 67:   /** An excellent item is here: keep a sparkle alive (re-spawned after a map reset). */
 68:   sparkleWanted: boolean;
 69:   sparkle: EffectHandle | null;
 70: };
 71: 
 72: function anyExcellent(app: NonNullable<Entity['charAppearance']>): boolean {
 73:   return !!(
 74:     app.leftHand?.isExcellent ||
 75:     app.rightHand?.isExcellent ||
 76:     app.helm?.isExcellent ||
 77:     app.armor?.isExcellent ||
 78:     app.pants?.isExcellent ||
 79:     app.gloves?.isExcellent ||
 80:     app.boots?.isExcellent
 81:   );
 82: }
 83: 
 84: function itemSignature(item: Item | null | undefined): string {
 85:   if (!item) return '-';
 86:   return `${item.group}:${item.num}:${item.lvl ?? 0}:${item.isExcellent ? 1 : 0}:${
 87:     item.isAncient ? 1 : 0
 88:   }:${item.socketCount ?? 0}`;
 89: }
 90: 
 91: function stampMeshes(part: ModelObject, item: Item | null | undefined): void {
 92:   const tier = itemVisualTier(item);
 93:   // A tier stamp is what wakes the GlowLayer up (sceneLook's layer gate).
 94:   if (item && tier.active) requestGlowProbe();
 95:   for (const mesh of part.getMeshes(true)) {
 96:     mesh.metadata ??= {};
 97:     mesh.metadata.itemTier = item && tier.active ? tier : null;
 98:     mesh.metadata.itemLvl = tier.level;
 99:     mesh.metadata.isExcellent = tier.isExcellent;
100:     mesh.metadata.timeOffset = 0;
101:   }
102: }
103: 
104: /** Equipment slots and the part they load into (appearanceSystem.ts). */
105: function stampPlayer(player: PlayerObject, app: NonNullable<Entity['charAppearance']>): void {
106:   stampMeshes(player.HelmMask, app.helm);
107:   stampMeshes(player.Armor, app.armor);
108:   stampMeshes(player.Pants, app.pants);
109:   stampMeshes(player.Gloves, app.gloves);
110:   stampMeshes(player.Boots, app.boots);
111:   stampMeshes(player.Weapon1, app.leftHand);
112:   stampMeshes(player.Weapon2, app.rightHand);
113: }
114: 
115: export const ItemGlowSystem: ISystemFactory = world => {
116:   const players = world.with('charAppearance', 'modelObject', 'transform');
117:   const drops = world.with('droppedItem', 'modelObject', 'transform');
118: 
119:   const tracked = new Map<Entity, Tracked>();
120: 
121:   let optionState = itemEffectSignature();
122: 
123:   function clock(): number {
124:     return world.gameTime.TotalGameTime.TotalSeconds;
125:   }
126: 
127:   function lightLamp(
128:     tier: ItemVisualTier,
129:     x: number,
130:     y: number,
131:     z: number,
132:     kind: ItemLampKind,
133:     auraKind: ItemAuraKind
134:   ): Lamp {
135:     const position = { x, y, z };
136: 
137:     return {
138:       tier,
139:       position,
140:       source: lightItem(world.scene, tier, kind, position),
141:       gen: worldGen,
142:       aura: createItemAura(world.scene, tier, auraKind, x, y, z),
143:       crackle: createItemCrackle(world.scene, tier, auraKind, x, y, z),
144:     };
145:   }
146: 
147:   /** Anything to draw for this tier in the improved look besides emissive? */
148:   function wantsLamp(tier: ItemVisualTier): boolean {
149:     return tier.lightGain > 0 || tier.auraRate > 0 || tier.crackleRate > 0;
150:   }
151: 
152:   function snuff(state: Tracked): void {
153:     if (!state.lamp) return;
154:     // Idempotent: after a map change the facade already disposed it.
155:     state.lamp.source?.dispose();
156:     state.lamp.aura?.dispose();
157:     state.lamp.crackle?.dispose();
158:     state.lamp = null;
159:   }
160: 
161:   function stateOf(e: Entity): Tracked {
162:     let state = tracked.get(e);
163:     if (!state) {
164:       state = { signature: '', lamp: null, stamped: false, sparkleWanted: false, sparkle: null };
165:       tracked.set(e, state);
166:     }
167:     return state;
168:   }
169: 
170:   /** `CreateShiny`: the glints an excellent item throws; ends with the entity. */
171:   function spawnSparkle(e: Entity, kind: ItemSparkleKind): EffectHandle {
172:     return effects.spawn('itemSparkle', world.scene, entityPos(e, 0, tmpA), {
173:       kind,
174:       follow: followEntity(e, 0),
175:       yaw: () => entityYaw(e),
176:       until: () => entityGone(e),
177:     });
178:   }
179: 
180:   /** Keeps exactly one live sparkle while wanted (a map reset ends the old one). */
181:   function keepSparkle(e: Entity, state: Tracked, kind: ItemSparkleKind): void {
182:     if (state.sparkleWanted) {
183:       if (!state.sparkle?.alive) state.sparkle = spawnSparkle(e, kind);
184:     } else if (state.sparkle) {
185:       state.sparkle.stop();
186:       state.sparkle = null;
187:     }
188:   }
189: 
190:   function forget(e: Entity): void {
191:     const state = tracked.get(e);
192:     if (!state) return;
193:     snuff(state);
194:     state.sparkle?.stop();
195:     state.sparkle = null;
196:     e.modelObject?.SelfLight.setAll(0);
197:     tracked.delete(e);
198:   }
199: 
200:   players.onEntityRemoved.subscribe(forget);
201:   drops.onEntityRemoved.subscribe(forget);
202: 
203:   /** The map the lamps were built against, and the generation counter. */
204:   let lampWorld = world.mapIndex;
205:   let worldGen = 0;
206: 
207:   // Loading a map disposes every light source (`lighting.reset()`) and takes
208:   // the scene the auras live in with it. Map objects are recreated with their
209:   // map so they re-light on their own; a worn item lamp is the one thing that
210:   // outlives the load, so the generation bump re-seats it at the wearer's new
211:   // position on the next apply of their items. Note what it is *not* for: the
212:   // crackle vanishing across a gate was never this - see itemCrackle.ts's
213:   // `disposeCrackleMaterial`, which is the actual cause and the actual fix.
214:   EventBus.on('warpCompleted', ({ map }) => {
215:     // Warping to the map you are already on reloads nothing.
216:     if (map === lampWorld) return;
217:     lampWorld = map;
218:     worldGen++;
219:   });
220: 
221:   const selfColour = { r: 0, g: 0, b: 0 };
222: 
223:   return {
224:     update: () => {
225:       const now = clock();
226:       setItemGlowClock(now);
227: 
228:       const lampsOn = improvedItemEffectsOn();
229: 
230:       // Option changed: every baked tier is stale - re-stamp and re-light.
231:       const options = itemEffectSignature();
232:       const restamp = options !== optionState;
233:       optionState = options;
234: 
235:       // --- dropped items ----------------------------------------------------
236:       for (const e of drops) {
237:         const state = stateOf(e);
238:         const { modelObject, transform, droppedItem } = e;
239: 
240:         keepSparkle(e, state, 'drop');
241:         if (state.stamped && !restamp) continue;
242:         if (!modelObject.Ready) continue;
243: 
244:         const tier = itemVisualTier(droppedItem.item);
245:         state.sparkleWanted = tier.isExcellent;
246:         stampMeshes(modelObject, droppedItem.item);
247: 
248:         snuff(state);
249:         if (lampsOn && wantsLamp(tier)) {
250:           state.lamp = lightLamp(
251:             tier,
252:             transform.pos.x,
253:             transform.pos.y,
254:             transform.pos.z,
255:             'drop',
256:             'drop'
257:           );
258:         }
259: 
260:         state.stamped = true;
261:       }
262: 
263:       // --- characters -------------------------------------------------------
264:       for (const e of players) {
265:         const state = stateOf(e);
266:         const { charAppearance: app, modelObject, transform } = e;
267: 
268:         // The apply counter leads: the lamp belongs to this character's
269:         // items, so it is re-examined whenever those items are put on the
270:         // model, not only when they come out different - re-applying the same
271:         // gear is exactly what a warp does.
272:         const signature =
273:           options +
274:           '|' +
275:           (app.applied ?? 0) +
276:           '|' +
277:           itemSignature(app.leftHand) +
278:           '|' +
279:           itemSignature(app.rightHand) +
280:           '|' +
281:           itemSignature(app.helm) +
282:           '|' +
283:           itemSignature(app.armor) +
284:           '|' +
285:           itemSignature(app.pants) +
286:           '|' +
287:           itemSignature(app.gloves) +
288:           '|' +
289:           itemSignature(app.boots);
290: 
291:         if (signature !== state.signature) {
292:           state.signature = signature;
293:           state.sparkleWanted = anyExcellent(app);
294: 
295:           const tier = strongestTier([
296:             app.leftHand,
297:             app.rightHand,
298:             app.helm,
299:             app.armor,
300:             app.pants,
301:             app.gloves,
302:             app.boots,
303:           ]);
304: 
305:           // Re-examined is not rebuilt. itemVisualTier interns its tiers, so
306:           // identity is the whole comparison: same tier, same generation, and
307:           // the lamp standing there is the one this gear would build anyway.
308:           //
309:           // This guard is load-bearing, not an optimisation. The apply beat
310:           // fires on every inventory move, and a rebuild throws away the
311:           // crackle's GreasedLine mesh and compiles a fresh ShaderMaterial
312:           // for the replacement. Doing that on repeat is how a shader compile
313:           // starts failing, and a material whose shader fails to compile
314:           // renders WHITE - see the note above.
315:           const stale =
316:             restamp ||
317:             !state.lamp ||
318:             state.lamp.tier !== tier ||
319:             state.lamp.gen !== worldGen;
320: 
321:           if (stale) {
322:             snuff(state);
323:             modelObject.SelfLight.setAll(0);
324: 
325:             if (restamp && modelObject.Ready) {
326:               stampPlayer(modelObject as PlayerObject, app);
327:             }
328: 
329:             if (lampsOn && wantsLamp(tier)) {
330:               state.lamp = lightLamp(
331:                 tier,
332:                 transform.pos.x,
333:                 transform.pos.y,
334:                 transform.pos.z,
335:                 e.localPlayer ? 'hero' : 'player',
336:                 'character'
337:               );
338:             }
339:           }
340:         }
341: 
342:         keepSparkle(e, state, 'character');
343: 
344:         const lamp = state.lamp;
345:         if (!lamp) continue;
346: 
347:         const x = transform.pos.x + (transform.posOffset?.x ?? 0);
348:         const y = transform.pos.y + (transform.posOffset?.y ?? 0);
349:         const z = transform.pos.z + (transform.posOffset?.z ?? 0);
350: 
351:         // The light source follows this object; the tile re-registration of
352:         // the terrain stain is its own business.
353:         lamp.position.x = x;
354:         lamp.position.y = y;
355:         lamp.position.z = z;
356: 
357:         lamp.aura?.emitter.set(x, y, z);
358:         lamp.crackle?.position.set(x, y, z);
359: 
360:         if (!lamp.source?.alive) continue;
361: 
362:         // The wearer is lit by their own gear, as the original adds o->Light.
363:         const c = itemSelfLight(lamp.source, selfColour);
364:         modelObject.SelfLight.set(c.r, c.g, c.b);
365:       }
366:     },
367:   };
368: };
</file>

<file path="src/ecs/systems/itemPickupSystem.ts">
  1: import { PointerEventTypes } from '../../libs/babylon/exports';
  2: import { Store } from '../../store';
  3: import { QuickItemActions } from '../../common/quickItemActions';
  4: import type { Entity, ISystemFactory } from '../world';
  5: 
  6: /**
  7:  * MOVEMENT_GET (ZzzInterface.cpp:3543-3575): clicking a drop - its model or
  8:  * its name label - walks the hero next to it (CheckTile 1.5 tiles) and only
  9:  * then sends the pickup request. A ground click or another target cancels it.
 10:  */
 11: 
 12: /** Chebyshev tile distance at which the hero reaches for the item. */
 13: const PICKUP_RANGE = 1;
 14: /** Seconds between path refreshes while approaching (the drop never moves). */
 15: const APPROACH_INTERVAL = 0.4;
 16: 
 17: export const ItemPickupSystem: ISystemFactory = world => {
 18:   world.scene.onPointerObservable.add(event => {
 19:     if (event.type !== PointerEventTypes.POINTERDOWN) return;
 20:     if (event.event.button !== 0) return;
 21: 
 22:     if (Store.pendingItemMove) return;
 23: 
 24:     const picked = Store.pickedItem;
 25: 
 26:     if (picked) {
 27:       const pickInfo = world.scene.pick(
 28:         event.event.clientX,
 29:         event.event.clientY,
 30:         m => m === world.terrain?.mesh,
 31:         true
 32:       );
 33: 
 34:       const point = pickInfo?.pickedPoint;
 35:       if (!point) return;
 36: 
 37:       QuickItemActions.dropPickedItem(~~point.x, ~~point.z);
 38:       return;
 39:     }
 40: 
 41:     const target = world.currentPointerTarget;
 42:     if (!target?.droppedItem) {
 43:       // Clicking anything else (monster, NPC, ground) gives up the pickup.
 44:       world.pickupTarget = null;
 45:       return;
 46:     }
 47: 
 48:     world.pickupTarget = target;
 49:   });
 50: 
 51:   let approachDelay = 0;
 52: 
 53:   function isStillOnGround(target: Entity): boolean {
 54:     return (
 55:       !!target.droppedItem &&
 56:       target.netId !== undefined &&
 57:       !target.objOutOfScope &&
 58:       target.worldIndex === world.mapIndex &&
 59:       !!target.transform &&
 60:       world.has(target)
 61:     );
 62:   }
 63: 
 64:   return {
 65:     update: dt => {
 66:       approachDelay -= dt;
 67: 
 68:       const target = world.pickupTarget;
 69:       if (!target) return;
 70: 
 71:       const playerEntity = world.playerEntity;
 72:       if (!playerEntity || playerEntity.dying || !isStillOnGround(target)) {
 73:         world.pickupTarget = null;
 74:         return;
 75:       }
 76: 
 77:       const playerPos = playerEntity.transform.pos;
 78:       const targetPos = target.transform!.pos;
 79: 
 80:       const dx = Math.abs(~~targetPos.x - ~~playerPos.x);
 81:       const dz = Math.abs(~~targetPos.z - ~~playerPos.z);
 82: 
 83:       if (Math.max(dx, dz) > PICKUP_RANGE) {
 84:         if (approachDelay <= 0) {
 85:           approachDelay = APPROACH_INTERVAL;
 86:           const moveTo = playerEntity.playerMoveTo;
 87:           moveTo.point.x = targetPos.x;
 88:           moveTo.point.y = targetPos.z;
 89:           moveTo.handled = false;
 90:           moveTo.sendToServer = true;
 91:         }
 92:         return;
 93:       }
 94: 
 95:       // In reach: stop walking and ask for the item.
 96:       const { pathfinding } = playerEntity;
 97:       if (pathfinding.path && pathfinding.path.length > 0) {
 98:         pathfinding.path = null;
 99:         pathfinding.from = { x: ~~playerPos.x, y: ~~playerPos.z };
100:         pathfinding.to = { x: ~~playerPos.x, y: ~~playerPos.z };
101:       }
102: 
103:       world.pickupTarget = null;
104:       Store.pickupItemRequest(target.netId!);
105:     },
106:   };
107: };
</file>

<file path="src/ecs/systems/loginSceneSystem.ts">
  1: import type { ISystemFactory } from '../world';
  2: import { Store, UIState } from '../../store';
  3: import { ENUM_WORLD } from '../../common';
  4: import { EventBus } from '../../libs/eventBus';
  5: import { Vector3, type ArcRotateCamera } from '../../libs/babylon/exports';
  6: import {
  7:   loadCameraWalkScript,
  8:   type CameraWaypoint,
  9: } from '../../libs/mu/cameraWalkScript';
 10: import {
 11:   CHARACTER_CAMERA_POSITION,
 12:   characterCameraTarget,
 13: } from '../../common/characterSelect';
 14: import { prefetchWorldTerrain } from '../../libs/mu/prefetchWorld';
 15: import { loadVersionUi, versionUi } from '../../version';
 16: import type {
 17:   PregameBackdrop,
 18:   PregamePhase,
 19:   PregameScene,
 20: } from '../../version/uiContract';
 21: 
 22: const MU_SCALE = 100;
 23: 
 24: const REFERENCE_FPS = 25;
 25: 
 26: const speedFor = (waypoint: CameraWaypoint) =>
 27:   (waypoint.moveAccel * REFERENCE_FPS) / MU_SCALE;
 28: 
 29: const TOUR_RADIUS_SCALE = 1.1;
 30: 
 31: /** `SetCameraFOV` (CameraUtility.cpp:284): the login world in tour mode. */
 32: const TOUR_FOV = (65 * Math.PI) / 180;
 33: 
 34: /** `MoveCamera` (LoginScene.cpp:256): the scene's own camera, the one the character line-up is shot with. */
 35: const CHARACTER_FOV = (45 * Math.PI) / 180;
 36: 
 37: /**
 38:  * The pitch the backdrop is framed at - the scene camera's own, which is what
 39:  * the tour was drawn with before anything else had touched it. A constant
 40:  * because the game's camera must not reach back here: the pre-game screens
 41:  * have to look the same on the way out of a session as on the way in.
 42:  */
 43: const BACKDROP_BETA = Math.PI / 4.5;
 44: 
 45: /**
 46:  * Which pre-game screen the backdrop is standing behind, or null in the
 47:  * world. The start menu sits on the same backdrop the server list does: the
 48:  * original never shows a bare screen, and it is what the next click needs
 49:  * anyway, so putting it up here costs nothing later.
 50:  */
 51: function phaseFor(uiState: UIState): PregamePhase | null {
 52:   switch (uiState) {
 53:     case UIState.Preloader:
 54:     case UIState.Servers:
 55:     case UIState.Login:
 56:       return 'login';
 57:     case UIState.Characters:
 58:       return 'characters';
 59:     default:
 60:       return null;
 61:   }
 62: }
 63: 
 64: export const LoginSceneSystem: ISystemFactory = world => {
 65:   /**
 66:    * The version's backdrop plan. Not available on the first frames - the UI
 67:    * chunk loads after the app graph is up - so until it lands the system
 68:    * does nothing, which is what it did anyway while the backdrop terrain
 69:    * downloaded.
 70:    */
 71:   let backdropPlan: PregameBackdrop | null =
 72:     versionUi()?.pregame.backdrop ?? null;
 73: 
 74:   if (!backdropPlan) {
 75:     void loadVersionUi().then(ui => {
 76:       backdropPlan = ui.pregame.backdrop;
 77:     });
 78:   }
 79: 
 80:   let requestedBackdrop: ENUM_WORLD | null = null;
 81: 
 82:   let waypoints: CameraWaypoint[] | null = null;
 83:   let scriptForWorld: number | null = null;
 84: 
 85:   let leg = 0;
 86:   let legProgress = 0;
 87: 
 88:   const target = new Vector3(0, 0, 0);
 89: 
 90:   let gameFraming: {
 91:     alpha: number;
 92:     beta: number;
 93:     radius: number;
 94:     fov: number;
 95:   } | null = null;
 96:   let cameraIsOurs = false;
 97: 
 98:   /** The standalone set piece, for a version whose backdrop is not a world. */
 99:   let setPiece: PregameScene | null = null;
100: 
101:   const resetTour = () => {
102:     leg = 0;
103:     legProgress = 0;
104:   };
105: 
106:   EventBus.on('warpCompleted', resetTour);
107: 
108:   const advanceTour = (deltaTime: number, path: CameraWaypoint[]) => {
109:     const from = path[leg];
110:     const to = path[(leg + 1) % path.length];
111: 
112:     const dx = to.x - from.x;
113:     const dy = to.y - from.y;
114:     const legLength = Math.hypot(dx, dy) || 1;
115: 
116:     legProgress += (speedFor(from) * deltaTime) / legLength;
117: 
118:     while (legProgress >= 1) {
119:       legProgress -= 1;
120:       leg = (leg + 1) % path.length;
121:     }
122: 
123:     const a = path[leg];
124:     const b = path[(leg + 1) % path.length];
125: 
126:     const x = a.x + (b.x - a.x) * legProgress;
127:     const y = a.y + (b.y - a.y) * legProgress;
128: 
129:     target.x = x;
130:     target.z = y;
131:     target.y = world.getTerrainHeight(x, y) + a.height / MU_SCALE;
132: 
133:     const heading = Math.atan2(b.y - a.y, b.x - a.x);
134:     const radius =
135:       (a.distanceLevel + (b.distanceLevel - a.distanceLevel) * legProgress) *
136:       TOUR_RADIUS_SCALE;
137: 
138:     return { heading, radius };
139:   };
140: 
141:   return {
142:     update: (deltaTime: number) => {
143:       const camera = world.scene.activeCamera as ArcRotateCamera;
144:       if (!camera) return;
145: 
146:       if (!gameFraming) {
147:         gameFraming = {
148:           alpha: camera.alpha,
149:           beta: camera.beta,
150:           radius: camera.radius,
151:           fov: camera.fov,
152:         };
153:       }
154: 
155:       const plan = backdropPlan;
156:       const phase = plan ? phaseFor(Store.uiState) : null;
157: 
158:       if (phase === null) {
159:         requestedBackdrop = null;
160: 
161:         if (setPiece) {
162:           setPiece.dispose();
163:           setPiece = null;
164:         }
165: 
166:         if (cameraIsOurs) {
167:           camera.alpha = gameFraming.alpha;
168:           camera.beta = gameFraming.beta;
169:           camera.radius = gameFraming.radius;
170:           camera.fov = gameFraming.fov;
171:           cameraIsOurs = false;
172:         }
173: 
174:         return;
175:       }
176: 
177:       if (plan!.kind === 'scene') {
178:         setPiece ??= plan!.create(world);
179:         cameraIsOurs = true;
180:         setPiece.update(deltaTime, phase);
181:         return;
182:       }
183: 
184:       const backdrop = phase === 'login' ? plan!.login : plan!.characters;
185: 
186:       if (requestedBackdrop !== backdrop) {
187:         requestedBackdrop = backdrop;
188:         resetTour();
189:         waypoints = null;
190:         scriptForWorld = null;
191:         EventBus.emit('requestWarp', { map: backdrop });
192:         return;
193:       }
194: 
195:       if (world.mapIndex !== backdrop || !world.terrain) return;
196: 
197:       if (backdrop === plan!.login) {
198:         prefetchWorldTerrain(plan!.characters);
199:       }
200: 
201:       const worldNum = backdrop + 1;
202: 
203:       if (scriptForWorld !== worldNum) {
204:         scriptForWorld = worldNum;
205:         loadCameraWalkScript(worldNum).then(loaded => {
206:           if (scriptForWorld === worldNum) waypoints = loaded;
207:         });
208:       }
209: 
210:       cameraIsOurs = true;
211: 
212:       if (waypoints && waypoints.length > 1) {
213:         const { heading, radius } = advanceTour(deltaTime, waypoints);
214: 
215:         camera.setTarget(target);
216:         camera.fov = TOUR_FOV;
217:         camera.alpha = heading + Math.PI;
218:         camera.beta = BACKDROP_BETA;
219:         camera.radius = radius;
220:         return;
221:       }
222: 
223:       camera.fov = CHARACTER_FOV;
224: 
225:       camera.setTarget(characterCameraTarget());
226:       camera.setPosition(CHARACTER_CAMERA_POSITION);
227:     },
228:   };
229: };
</file>

<file path="src/ecs/systems/mapDoorSystem.ts">
  1: import { ENUM_WORLD } from '../../common/types';
  2: import { playSfx } from '../../libs/sfx';
  3: import type { Entity, ISystemFactory } from '../world';
  4: 
  5: /**
  6:  * Proximity doors (MoveObject, ZzzObject.cpp:3871-3913). Devias has two
  7:  * kinds: hinged doors (types 20 / 65 / 88) swing open around their model
  8:  * pivot, the gate (type 86) slides sideways. Both react only to the hero:
  9:  * inside 200 MU units (2 tiles) the door opens in proportion to the distance,
 10:  * outside it turns back (TurnAngle2, 10°/tick) and slides home (×0.2/tick).
 11:  * The original keys the table off the rest angle stored at CreateObject
 12:  * (ZzzObject.cpp:4663: `HeadAngle` = angle, `HeadTargetAngle` = position).
 13:  */
 14: 
 15: type DoorKind = 'hinged' | 'sliding';
 16: 
 17: const DOORS: Partial<Record<ENUM_WORLD, Record<number, DoorKind>>> = {
 18:   [ENUM_WORLD.WD_2DEVIAS]: {
 19:     20: 'hinged',
 20:     65: 'hinged',
 21:     88: 'hinged',
 22:     86: 'sliding',
 23:   },
 24: };
 25: 
 26: /** Hero distance (MU units) inside which a door reacts. */
 27: const OPEN_RANGE = 200;
 28: /** TurnAngle2 step per 25 Hz tick while closing, degrees. */
 29: const CLOSE_TURN_PER_TICK = 10;
 30: /** Position lerp towards the rest position per tick while closing. */
 31: const CLOSE_SLIDE_PER_TICK = 0.2;
 32: 
 33: const DEG = 180 / Math.PI;
 34: const RAD = Math.PI / 180;
 35: 
 36: interface DoorState {
 37:   kind: DoorKind;
 38:   /** Rest position in MU units (HeadTargetAngle). */
 39:   homeX: number;
 40:   homeY: number;
 41:   /** Rest yaw in degrees, 0..360 (HeadAngle[2]). */
 42:   homeAngle: number;
 43:   /** Current yaw in degrees (Angle[2]). */
 44:   angle: number;
 45:   open: boolean;
 46: }
 47: 
 48: function normalizeDegrees(angle: number): number {
 49:   angle %= 360;
 50:   return angle < 0 ? angle + 360 : angle;
 51: }
 52: 
 53: /** TurnAngle2 (ZzzAI.cpp:112): step `current` towards `target` by at most `maxDelta`. */
 54: function turnAngle2(current: number, target: number, maxDelta: number): number {
 55:   if (maxDelta <= 0) return normalizeDegrees(current);
 56:   let delta = normalizeDegrees(target) - normalizeDegrees(current);
 57:   if (delta > 180) delta -= 360;
 58:   else if (delta < -180) delta += 360;
 59:   delta = Math.max(-maxDelta, Math.min(maxDelta, delta));
 60:   return normalizeDegrees(current + delta);
 61: }
 62: 
 63: /** Whether the map animates this object type as a door. */
 64: export function isMapDoorType(map: ENUM_WORLD, type: number): boolean {
 65:   return DOORS[map]?.[type] !== undefined;
 66: }
 67: 
 68: export const MapDoorSystem: ISystemFactory = world => {
 69:   const query = world.with('modelId', 'worldIndex', 'transform');
 70:   const states = new WeakMap<Entity, DoorState>();
 71: 
 72:   function stateOf(e: Entity, kind: DoorKind): DoorState {
 73:     let state = states.get(e);
 74:     if (state) return state;
 75: 
 76:     const t = e.transform!;
 77:     // `(int)Angle[2] % 360` - rest yaws are multiples of 90 in the map data.
 78:     const homeAngle = normalizeDegrees(Math.trunc(t.rot.y * DEG));
 79:     state = {
 80:       kind,
 81:       homeX: t.pos.x * world.terrainScale,
 82:       homeY: t.pos.z * world.terrainScale,
 83:       homeAngle,
 84:       angle: homeAngle,
 85:       open: false,
 86:     };
 87:     states.set(e, state);
 88:     return state;
 89:   }
 90: 
 91:   return {
 92:     update: dt => {
 93:       const table = DOORS[world.mapIndex];
 94:       if (!table) return;
 95: 
 96:       const hero = world.playerEntity;
 97:       if (!hero) return;
 98: 
 99:       const ht = hero.transform;
100:       const heroX = (ht.pos.x + (ht.posOffset?.x ?? 0)) * world.terrainScale;
101:       const heroY = (ht.pos.z + (ht.posOffset?.z ?? 0)) * world.terrainScale;
102:       const ticks = Math.min(1, dt * 25);
103: 
104:       for (const e of query) {
105:         if (e.worldIndex !== world.mapIndex) continue;
106:         const kind = table[e.modelId];
107:         if (!kind) continue;
108: 
109:         const s = stateOf(e, kind);
110:         const t = e.transform;
111: 
112:         const dx = heroX - s.homeX;
113:         const dy = heroY - s.homeY;
114:         const distance = Math.sqrt(dx * dx + dy * dy);
115: 
116:         let x = t.pos.x * world.terrainScale;
117:         let y = t.pos.z * world.terrainScale;
118: 
119:         if (distance < OPEN_RANGE) {
120:           const push = OPEN_RANGE - distance;
121: 
122:           if (kind === 'sliding') {
123:             if (s.homeAngle === 90) y = s.homeY + push * 2;
124:             else if (s.homeAngle === 270) y = s.homeY - push * 2;
125:             else if (s.homeAngle === 0) x = s.homeX + push * 2;
126:             else if (s.homeAngle === 180) x = s.homeX - push * 2;
127:           } else {
128:             if (s.homeAngle === 90) s.angle = 30 - push * 0.5;
129:             else if (s.homeAngle === 270) s.angle = 330 + push * 0.5;
130:             else if (s.homeAngle === 0) s.angle = 300 - push * 0.5;
131:             else if (s.homeAngle === 180) s.angle = 240 + push * 0.5;
132:           }
133: 
134:           if (!s.open) {
135:             s.open = true;
136:             // SOUND_DOOR02 (aCastleDoor) for the gate, SOUND_DOOR01 (aDoor) otherwise.
137:             playSfx(
138:               kind === 'sliding' ? 'Sound/aCastleDoor' : 'Sound/aDoor',
139:               { x: t.pos.x, z: t.pos.z }
140:             );
141:           }
142:         } else {
143:           s.angle = turnAngle2(s.angle, s.homeAngle, CLOSE_TURN_PER_TICK * ticks);
144:           const k = Math.min(1, CLOSE_SLIDE_PER_TICK * ticks);
145:           x += (s.homeX - x) * k;
146:           y += (s.homeY - y) * k;
147:           s.open = false;
148:         }
149: 
150:         t.pos.x = x / world.terrainScale;
151:         t.pos.z = y / world.terrainScale;
152:         t.rot.y = s.angle * RAD;
153:       }
154:     },
155:   };
156: };
</file>

<file path="src/ecs/systems/modelLoaderSystem.ts">
  1: import { With } from 'miniplex';
  2: import { MapPlayerNetClassToModelClass } from '../../common/mapPlayerNetClassToModelClass';
  3: import { getModel, loadGLTF } from '../../common/modelLoader';
  4: import { ModelObject } from '../../common/modelObject';
  5: import { PlayerObject } from '../../common/playerObject';
  6: import { MapObjectLights } from '../../common/mapObjectLights';
  7: import { blendMeshFor } from '../../common/blendMeshes';
  8: import { toRenderAngles } from '../../common/renderAngles';
  9: import {
 10:   Color3,
 11:   CreateBox,
 12:   Mesh,
 13:   StandardMaterial,
 14:   type Skeleton,
 15:   Vector3,
 16: } from '../../libs/babylon/exports';
 17: import { Entity, ISystemFactory, World } from '../world';
 18: 
 19: const v3Temp = { x: 0, y: 0, z: 0 };
 20: const v3RotTemp = Vector3.Zero();
 21: 
 22: /**
 23:  * Roughly a character's footprint in world units (the converter's
 24:  * SCALE_MULTIPLIER makes 100 MU units = 1; a standing character is ~180).
 25:  */
 26: const PLACEHOLDER_WIDTH = 0.6;
 27: const PLACEHOLDER_HEIGHT = 1.8;
 28: 
 29: let placeholderMaterial: StandardMaterial | null = null;
 30: 
 31: /**
 32:  * Feeds `ModelObject.load()` a plain unlit box in place of the GLB that
 33:  * failed, so the object reports `Ready`, has a bounding box, and so remains
 34:  * hoverable / clickable. Nothing animates, which is fine: `playAction` on an
 35:  * empty `animationGroups` list is a no-op.
 36:  */
 37: function attachMissingModelPlaceholder(world: World, modelObject: ModelObject) {
 38:   if (modelObject.Ready || modelObject.gltf) return;
 39: 
 40:   const scene = world.scene;
 41: 
 42:   if (!placeholderMaterial || placeholderMaterial.getScene() !== scene) {
 43:     placeholderMaterial = new StandardMaterial('missingModel', scene);
 44:     placeholderMaterial.emissiveColor = new Color3(1, 0, 1);
 45:     placeholderMaterial.disableLighting = true;
 46:   }
 47: 
 48:   // An empty root so `getChildMeshes()`-based code (frustum test, bounds)
 49:   // sees the box the same way it sees a converted GLB's primitives.
 50:   const root = new Mesh('missingModel', scene);
 51:   const box = CreateBox(
 52:     'missingModel_box',
 53:     {
 54:       width: PLACEHOLDER_WIDTH,
 55:       height: PLACEHOLDER_HEIGHT,
 56:       depth: PLACEHOLDER_WIDTH,
 57:     },
 58:     scene
 59:   );
 60:   box.material = placeholderMaterial;
 61:   box.isPickable = false;
 62:   box.parent = root;
 63: 
 64:   modelObject.load({
 65:     mesh: root,
 66:     // No rig: every reader of `gltf.skeleton` in ModelObject is null-guarded.
 67:     skeleton: null as unknown as Skeleton,
 68:     animationGroups: [],
 69:   });
 70: 
 71:   // load() zeroes the root and rotates it; lift it afterwards, in the node's
 72:   // (yaw-only) space, so the box stands on the terrain instead of straddling it.
 73:   root.position.y = PLACEHOLDER_HEIGHT / 2;
 74: }
 75: 
 76: function createModelObject(
 77:   world: World,
 78:   entity: With<Entity, 'modelFactory' | 'worldIndex' | 'transform'>
 79: ) {
 80:   const terrainScale = world.terrainScale;
 81:   const transform = entity.transform;
 82:   const modelId = entity.modelId;
 83: 
 84:   world.addComponent(
 85:     entity,
 86:     'modelObject',
 87:     new entity.modelFactory(world.scene, world.mapParent)
 88:   );
 89: 
 90:   const modelObject = entity.modelObject as any as ModelObject;
 91:   modelObject.WorldIndex = entity.worldIndex;
 92:   if (modelId !== undefined) {
 93:     modelObject.Type = modelId;
 94:     // `modelId` is set by `createObjects` and by nothing else, so it is the
 95:     // one reliable 'this came from the map's object list' signal.
 96:     modelObject.IsMapObject = true;
 97:   }
 98: 
 99:   v3Temp.x = transform.pos.x;
100:   v3Temp.y = transform.pos.y;
101:   v3Temp.z = transform.pos.z;
102: 
103:   // Same yaw flip the render loop applies, so init()-time readers of
104:   // node.rotation (emitters, lights) don't see a mirrored first frame.
105:   modelObject.updateLocation(
106:     v3Temp,
107:     transform.scale,
108:     toRenderAngles(transform.rot, v3RotTemp)
109:   );
110: 
111:   modelObject.Lights = MapObjectLights.attach(world, modelObject);
112: 
113:   // A fresh model starts in its class's default body parts; the equipment
114:   // has to be re-applied even if the appearance was already consumed by a
115:   // previous (since disposed) model of this entity.
116:   if (entity.charAppearance) {
117:     entity.charAppearance.changed = true;
118:   }
119: 
120:   const blendMesh = blendMeshFor(modelObject.WorldIndex, modelObject.Type);
121: 
122:   if (blendMesh >= 0) {
123:     modelObject.BlendMesh = blendMesh;
124:   }
125: 
126:   if (
127:     'playerClass' in modelObject &&
128:     entity.attributeSystem?.hasAttribute('playerNetClass')
129:   ) {
130:     (modelObject as PlayerObject).playerClass = MapPlayerNetClassToModelClass(
131:       entity.attributeSystem.getValue('playerNetClass')
132:     );
133:   }
134: 
135:   const failed = (reason: unknown) => {
136:     console.error(
137:       `Could not load model for ${entity.modelFilePath ?? `id ${modelId}`}:`,
138:       reason
139:     );
140:     modelObject.LoadFailed = true;
141: 
142:     // A model that never became Ready has no bounds, so the pointer and
143:     // cursor systems skip it: an NPC whose GLB is missing or corrupt could
144:     // not be hovered, clicked or talked to at all. Stand a placeholder in so
145:     // the entity keeps a pickable footprint (map props are left alone - an
146:     // invisible rock is preferable to a magenta box).
147:     if (entity.modelObject === modelObject && entity.netId !== undefined) {
148:       attachMissingModelPlaceholder(world, modelObject);
149:     }
150:   };
151: 
152:   modelObject
153:     .init(world, entity)
154:     .then(() => {
155:       if (modelObject.gltf || modelObject.Ready) {
156:         return;
157:       }
158:       if (!entity.modelObject) {
159:         modelObject.dispose();
160:         return;
161:       }
162: 
163:       const modelFilePath = entity.modelFilePath;
164: 
165:       if (modelId != null) {
166:         // Deferred BMD-runtime seam : getModel() resolves a parsed
167:         // BMD, which is not yet the {mesh, skeleton, animationGroups} contract
168:         // ModelObject.load() takes. ModelsFactory is empty today, so this always
169:         // rejects into failed(); wire the BMD -> gltf bridge here when
170:         // BMDReader is revived behind the same contract.
171:         return getModel(modelId).then(() =>
172:           failed(`model id ${modelId}: BMD -> gltf bridge not implemented`)
173:         );
174:       }
175: 
176:       if (modelFilePath) {
177:         return loadGLTF(modelFilePath, world).then(gltf => {
178:           if (entity.modelObject) {
179:             entity.modelObject.load(gltf);
180:           }
181:         });
182:       }
183: 
184:       failed('no model id or file path');
185:     })
186:     .catch(failed);
187: }
188: 
189: /**
190:  * How many models may be instantiated per frame. After a warp several
191:  * hundred entities turn `visible` in the same tick; instantiating them all in
192:  * one frame was the 700-1000 ms frames of the review. At 24 a Noria arrival
193:  * (~500 in range) spreads over ~20 frames, nearest first, so the ground under
194:  * the hero fills in before the tree line does.
195:  */
196: const MODELS_PER_FRAME = 24;
197: 
198: type Pending = {
199:   entity: With<Entity, 'modelFactory' | 'worldIndex' | 'transform'>;
200:   priority: number;
201: };
202: 
203: /** `nearby` entities queue behind every `visible` one whatever their distance. */
204: const NEARBY_PENALTY = 1e6;
205: 
206: export const ModelLoaderSystem: ISystemFactory = world => {
207:   const query = world.with(
208:     'modelFactory',
209:     'worldIndex',
210:     'transform',
211:     'visibility'
212:   );
213: 
214:   const pending: Pending[] = [];
215: 
216:   return {
217:     update: () => {
218:       const terrain = world.terrain;
219:       if (!terrain) return;
220: 
221:       const hero = world.playerEntity?.transform.pos;
222: 
223:       pending.length = 0;
224: 
225:       for (const entity of query) {
226:         const visibility = entity.visibility;
227: 
228:         switch (visibility.state) {
229:           case 'visible':
230:           case 'nearby': {
231:             if (!entity.modelObject) {
232:               const pos = entity.transform.pos;
233:               const distance = hero
234:                 ? (pos.x - hero.x) * (pos.x - hero.x) +
235:                   (pos.z - hero.z) * (pos.z - hero.z)
236:                 : 0;
237:               pending.push({
238:                 entity,
239:                 priority:
240:                   visibility.state === 'nearby'
241:                     ? distance + NEARBY_PENALTY
242:                     : distance,
243:               });
244:             }
245:             break;
246:           }
247:           case 'hidden': {
248:             if (entity.modelObject) {
249:               entity.modelObject.dispose();
250:               world.removeComponent(entity, 'modelObject');
251:             }
252:             break;
253:           }
254:         }
255:       }
256: 
257:       if (pending.length === 0) return;
258: 
259:       if (pending.length > MODELS_PER_FRAME) {
260:         pending.sort((a, b) => a.priority - b.priority);
261:       }
262: 
263:       const count = Math.min(pending.length, MODELS_PER_FRAME);
264:       for (let i = 0; i < count; i++) {
265:         createModelObject(world, pending[i].entity);
266:       }
267:     },
268:   };
269: };
</file>

<file path="src/ecs/systems/monsterGlowSystem.ts">
 1: import type { Entity, ISystemFactory } from '../world';
 2: import { glowMonster, monsterGlowFor } from '../../effects/monsterGlow';
 3: import type { EffectHandle } from '../../effects';
 4: 
 5: /**
 6:  * Consumer of the effects layer's `monsterGlow` entry: walks the entities
 7:  * that have an `npcType` and gives the ones its table names their own body
 8:  * glow once the model is posed, drops it when they die or leave. Owns no
 9:  * visual state - `effects/monsterGlow.ts` does.
10:  *
11:  * The light these monsters throw on the floor is a separate seam entirely:
12:  * `CharacterLightSystem` reads `lighting/characters.ts`, which carries the
13:  * matching rows.
14:  */
15: export const MonsterGlowSystem: ISystemFactory = world => {
16:   const characters = world.with('npcType', 'modelObject', 'transform');
17:   const glows = new Map<Entity, EffectHandle>();
18: 
19:   function snuff(e: Entity): void {
20:     glows.get(e)?.stop();
21:     glows.delete(e);
22:   }
23: 
24:   characters.onEntityRemoved.subscribe(snuff);
25: 
26:   return {
27:     update: () => {
28:       for (const e of characters) {
29:         const glow = monsterGlowFor(e.npcType);
30:         if (!glow) continue;
31: 
32:         if (e.dying) {
33:           snuff(e);
34:           continue;
35:         }
36: 
37:         // A map change ends every glow underneath us; `alive` is then false
38:         // and the next frame rebuilds it.
39:         if (glows.get(e)?.alive) continue;
40:         // Out of scope the entry drops the glow on its own, so re-lighting
41:         // here would rebuild 39 sprites a frame until the monster is back.
42:         if (e.objOutOfScope) continue;
43:         if (!e.modelObject.Ready || !e.modelObject.gltf?.skeleton) continue;
44: 
45:         glows.set(e, glowMonster(world.scene, e, glow));
46:       }
47:     },
48:   };
49: };
</file>

