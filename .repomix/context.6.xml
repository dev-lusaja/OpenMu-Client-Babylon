<file path="src/ecs/systems/nameTagSystem.ts">
  1: import { EventBus } from '../../libs/eventBus';
  2: import type { Entity, ISystemFactory, World } from '../world';
  3: import { isNpcOrTrapType } from './attackSystem';
  4: import { Economy } from '../../economy';
  5: import {
  6:   bubbleLifetime,
  7:   CHAT_LIFETIME,
  8:   CUT_TEXT_LENGTH,
  9:   cutText,
 10:   ID_LIFE_CREATE,
 11:   ID_LIFE_REFRESH,
 12:   TICKS_PER_SECOND,
 13: } from '../../common/nameTags';
 14: 
 15: /**
 16:  * The original's name balloons - `CreateChat` / `AddChat` / `MoveChat`
 17:  * (ZzzInterface.cpp:1091-1236) driven by `CNewUINameWindow::RenderName`
 18:  * (NewUINameWindow.cpp:108-192):
 19:  *
 20:  * - While the cursor is on an NPC (`SelectedNpc`) or another player
 21:  *   (`SelectedCharacter`, not a monster - those get the top HP bar instead,
 22:  *   and never the hero: `SelectCharacter` skips it in the main scene), the
 23:  *   name entry is created for 100 ticks, then refreshed to 10 each frame.
 24:  * - ObjectMessage (`CreateChat(..., flag 0)`) puts a speech line under the
 25:  *   name for `len * 2 + 160` ticks; ChatMessage (`AssignChat`, flag 1) for
 26:  *   1000. A second line while one is up pushes the first up (Text[1]).
 27:  * - Lifetimes count down by `FPS_ANIMATION_FACTOR` (1 per 25-fps frame); the
 28:  *   entry goes when the name and both lines have run out, or the owner left.
 29:  */
 30: export const NameTagSystem: ISystemFactory = world => {
 31:   const tags = world.with('nameTag');
 32:   const named = world.with('objectNameInWorld', 'transform');
 33: 
 34:   const create = (entity: Entity, color: number) => {
 35:     if (entity.nameTag) return entity.nameTag;
 36:     world.addComponent(entity, 'nameTag', {
 37:       idLife: 0,
 38:       color,
 39:       text: ['', ''],
 40:       life: [0, 0],
 41:     });
 42:     return entity.nameTag!;
 43:   };
 44: 
 45:   /** `CreateChat(c->ID, L"", c)`: show the name. */
 46:   const showName = (entity: Entity) => {
 47:     const existed = !!entity.nameTag;
 48:     const tag = create(entity, nameColour(entity));
 49:     tag.color = nameColour(entity);
 50:     tag.idLife = existed ? ID_LIFE_REFRESH : ID_LIFE_CREATE;
 51:   };
 52: 
 53:   /** `CreateChat` + `AddChat`: a chat line under the name. */
 54:   const addChat = (entity: Entity, text: string, lifetime: number) => {
 55:     const tag = create(entity, nameColour(entity));
 56:     tag.color = nameColour(entity);
 57:     // A line still showing is kept as the older, upper one.
 58:     if (tag.life[0] > 0) {
 59:       tag.text[1] = tag.text[0];
 60:       tag.life[1] = tag.life[0];
 61:     }
 62:     if (text.length >= CUT_TEXT_LENGTH) {
 63:       const [top, bottom] = cutText(text);
 64:       tag.text[1] = top;
 65:       tag.text[0] = bottom;
 66:       tag.life[0] = lifetime;
 67:       tag.life[1] = lifetime;
 68:     } else {
 69:       tag.text[0] = text;
 70:       tag.life[0] = lifetime;
 71:     }
 72:   };
 73: 
 74:   const byNetId = (netId: number) => world.getByNetId(netId) ?? null;
 75: 
 76:   EventBus.on('objectMessage', ({ netId, message }) => {
 77:     const entity = byNetId(netId);
 78:     if (!entity || !entity.objectNameInWorld) return;
 79:     addChat(entity, message, bubbleLifetime(message));
 80:   });
 81: 
 82:   EventBus.on('chatMessage', ({ sender, message }) => {
 83:     // `AssignChat`: players first, then monsters/NPCs, matched by name.
 84:     const entity =
 85:       named.entities.find(
 86:         e => e.playerAnimation && e.objectNameInWorld === sender
 87:       ) ?? named.entities.find(e => e.objectNameInWorld === sender);
 88:     if (!entity) return;
 89:     addChat(entity, message, CHAT_LIFETIME);
 90:   });
 91: 
 92:   return {
 93:     update: dt => {
 94:       // `FPS_ANIMATION_FACTOR = clamp(fpsRatio, 0, 1)` (ZzzAI.cpp:730): a slow
 95:       // frame never takes more than one tick off, or the per-frame hover
 96:       // refresh of 10 could not keep a name alive.
 97:       const ticks = Math.min(1, dt * TICKS_PER_SECOND);
 98: 
 99:       const hovered = world.currentPointerTarget;
100:       if (hovered && isBalloonTarget(world, hovered)) showName(hovered);
101: 
102:       // `CPersonalShopTitleImp::Draw`: a stall title is its own draw list in
103:       // the original, not the hover balloon - it stands over the seller for
104:       // as long as the stall is up, the hero's own included. Here it rides
105:       // on the balloon (buildLines swaps the guild lines for it the way
106:       // `IsShopInViewport` does), so the balloon is kept alive per frame.
107:       for (const netId of Economy.shopTitles.keys()) {
108:         const seller = byNetId(netId);
109:         if (seller && !seller.objOutOfScope && !seller.dying) showName(seller);
110:       }
111: 
112:       for (const entity of tags) {
113:         const tag = entity.nameTag!;
114:         if (tag.idLife > 0) tag.idLife -= ticks;
115:         if (tag.life[0] > 0) tag.life[0] -= ticks;
116:         if (tag.life[1] > 0) tag.life[1] -= ticks;
117: 
118:         // `MoveChat`: the owner is gone (out of scope or another map).
119:         const gone =
120:           entity.objOutOfScope ||
121:           (entity.worldIndex !== undefined &&
122:             entity.worldIndex !== world.mapIndex);
123: 
124:         if (gone || (tag.idLife <= 0 && tag.life[0] <= 0)) {
125:           world.removeComponent(entity, 'nameTag');
126:         }
127:       }
128:     },
129:   };
130: };
131: 
132: /** `Color = Owner->PK; if NPC Color = 0` (ZzzInterface.cpp:1097). */
133: function nameColour(entity: Entity): number {
134:   if (entity.npcType !== undefined) return 0;
135:   return entity.heroState ?? 3; // PVP_NEUTRAL until the server says otherwise
136: }
137: 
138: /**
139:  * SelectedNpc → any NPC; SelectedCharacter → players only (monsters get the
140:  * HP bar, NewUINameWindow.cpp:138), never the hero, never the dead.
141:  */
142: function isBalloonTarget(world: World, e: Entity): boolean {
143:   if (!e.objectNameInWorld || e.dying || e.droppedItem) return false;
144:   if (e.localPlayer) return false;
145:   if (e.playerAnimation) return true;
146:   const type = e.npcType;
147:   if (type === undefined) return false;
148:   if (type >= 100 && type <= 110) return false; // traps are KIND_TRAP
149:   return isNpcOrTrapType(type);
150: }
</file>

<file path="src/ecs/systems/npcTalkSystem.ts">
  1: import { PointerEventTypes } from '../../libs/babylon/exports';
  2: import { Store } from '../../store';
  3: import { events } from '../../events';
  4: import type { Entity, ISystemFactory } from '../world';
  5: import { isNpcOrTrapType } from './attackSystem';
  6: 
  7: /**
  8:  * MOVEMENT_TALK (ZzzInterface.cpp:7681-7700, 3576-3620): clicking an NPC
  9:  * walks the hero up to it and only then sends the talk request; the server
 10:  * answers with the window to open (a merchant's stock, a vault, …). A ground
 11:  * click or another target cancels the walk. Nothing is sent while a shop is
 12:  * already open - the original ignores NPC clicks behind the shop window.
 13:  */
 14: 
 15: /** Chebyshev tile distance at which the hero stops and talks. */
 16: const TALK_RANGE = 2;
 17: /** Seconds between path refreshes while approaching (NPCs barely move). */
 18: const APPROACH_INTERVAL = 0.4;
 19: 
 20: /** Talkable NPC: a non-monster with a server id that is not a trap. */
 21: export function isTalkableNpc(e: Entity): boolean {
 22:   const type = e.npcType;
 23:   if (type === undefined || e.netId === undefined || e.localPlayer) return false;
 24:   if (type >= 100 && type <= 110) return false; // traps
 25:   return isNpcOrTrapType(type);
 26: }
 27: 
 28: const TERRAIN_MAX = 255;
 29: 
 30: /**
 31:  * NPC cells are flagged non-walkable (their `TW_NOMOVE` footprint), so a path
 32:  * to the NPC's own tile is empty and the hero would never arrive. Approach
 33:  * the nearest walkable tile within TALK_RANGE of the NPC instead (the attack
 34:  * approach cuts its path at weapon reach the same way, `truncatePathForAttack`).
 35:  * `excluded` holds tiles a previous search could not reach.
 36:  */
 37: function findApproachTile(
 38:   world: Parameters<ISystemFactory>[0],
 39:   npcX: number,
 40:   npcY: number,
 41:   heroX: number,
 42:   heroY: number,
 43:   excluded: Set<number>
 44: ): { x: number; y: number } | null {
 45:   let best: { x: number; y: number } | null = null;
 46:   let bestDist = Infinity;
 47:   for (let dx = -TALK_RANGE; dx <= TALK_RANGE; dx++) {
 48:     for (let dy = -TALK_RANGE; dy <= TALK_RANGE; dy++) {
 49:       const x = npcX + dx;
 50:       const y = npcY + dy;
 51:       if (x < 0 || y < 0 || x > TERRAIN_MAX || y > TERRAIN_MAX) continue;
 52:       if (excluded.has(x * 256 + y)) continue;
 53:       if (!world.isWalkable(x, y)) continue;
 54:       const ex = x - heroX;
 55:       const ey = y - heroY;
 56:       const dist = ex * ex + ey * ey;
 57:       if (dist < bestDist) {
 58:         bestDist = dist;
 59:         best = { x, y };
 60:       }
 61:     }
 62:   }
 63:   return best;
 64: }
 65: 
 66: export const NpcTalkSystem: ISystemFactory = world => {
 67:   world.scene.onPointerObservable.add(event => {
 68:     if (event.type !== PointerEventTypes.POINTERDOWN) return;
 69:     if (event.event.button !== 0) return;
 70: 
 71:     if (Store.pendingItemMove || Store.pickedItem) return;
 72: 
 73:     const target = world.currentPointerTarget;
 74:     if (!target || !isTalkableNpc(target) || Store.npcShop) {
 75:       // Clicking anything else (monster, drop, ground) gives up the talk.
 76:       world.talkTarget = null;
 77:       return;
 78:     }
 79: 
 80:     world.talkTarget = target;
 81:   });
 82: 
 83:   let approachDelay = 0;
 84:   /** Tile requested by the last approach; cleared when the target changes. */
 85:   let approachTile: { x: number; y: number } | null = null;
 86:   let approachTarget: Entity | null = null;
 87:   /** Approach tiles the pathfinder returned no path for (this target). */
 88:   const unreachable = new Set<number>();
 89: 
 90:   function isStillThere(target: Entity): boolean {
 91:     return (
 92:       isTalkableNpc(target) &&
 93:       !target.objOutOfScope &&
 94:       target.worldIndex === world.mapIndex &&
 95:       !!target.transform &&
 96:       world.has(target)
 97:     );
 98:   }
 99: 
100:   return {
101:     update: dt => {
102:       approachDelay -= dt;
103: 
104:       const target = world.talkTarget;
105:       if (!target) {
106:         approachTarget = null;
107:         return;
108:       }
109: 
110:       const playerEntity = world.playerEntity;
111:       if (!playerEntity || playerEntity.dying || !isStillThere(target)) {
112:         world.talkTarget = null;
113:         approachTarget = null;
114:         return;
115:       }
116: 
117:       if (approachTarget !== target) {
118:         approachTarget = target;
119:         approachTile = null;
120:         unreachable.clear();
121:         approachDelay = 0;
122:       }
123: 
124:       const playerPos = playerEntity.transform.pos;
125:       const targetPos = target.transform!.pos;
126:       const { pathfinding } = playerEntity;
127: 
128:       const heroX = ~~playerPos.x;
129:       const heroY = ~~playerPos.z;
130:       const npcX = ~~targetPos.x;
131:       const npcY = ~~targetPos.z;
132: 
133:       const dx = Math.abs(npcX - heroX);
134:       const dz = Math.abs(npcY - heroY);
135: 
136:       // Out of reach: walk to a tile next to the NPC. Already in reach (the
137:       // hero stands beside the NPC, or the path ended early inside the
138:       // range) falls through to the talk request without moving.
139:       if (Math.max(dx, dz) > TALK_RANGE) {
140:         // The A* (`libs/astar.ts`) never returns an empty path for an
141:         // unreachable goal: it hands back the path to the *closest* node. So
142:         // "unreachable" is a calculated path whose last node is not the tile
143:         // asked for (an empty path counts too) - a tile behind a merchant's
144:         // counter, say. Strike it and try the next-nearest at once; waiting
145:         // the approach interval here would leave the hero standing short of
146:         // the NPC for no reason.
147:         if (approachTile && pathfinding.calculated) {
148:           const path = pathfinding.path;
149:           const last = path && path.length > 0 ? path[path.length - 1] : null;
150:           const arrives =
151:             !!last && ~~last.x === approachTile.x && ~~last.y === approachTile.y;
152:           if (!arrives) {
153:             unreachable.add(approachTile.x * 256 + approachTile.y);
154:             approachTile = null;
155:             approachDelay = 0;
156:           }
157:         }
158: 
159:         if (approachDelay > 0) return;
160:         approachDelay = APPROACH_INTERVAL;
161: 
162:         const tile = findApproachTile(world, npcX, npcY, heroX, heroY, unreachable);
163:         if (!tile) {
164:           // No way to get next to the NPC (blocked in): give up like a
165:           // cancelled walk instead of re-requesting forever.
166:           world.talkTarget = null;
167:           approachTarget = null;
168:           return;
169:         }
170: 
171:         approachTile = tile;
172:         const moveTo = playerEntity.playerMoveTo;
173:         moveTo.point.x = tile.x + 0.5;
174:         moveTo.point.y = tile.y + 0.5;
175:         moveTo.handled = false;
176:         moveTo.sendToServer = true;
177:         return;
178:       }
179: 
180:       // In reach: stop (`SetPlayerStop`), face the NPC, and talk.
181:       if (pathfinding.path && pathfinding.path.length > 0) {
182:         pathfinding.path = null;
183:         pathfinding.from = { x: ~~playerPos.x, y: ~~playerPos.z };
184:         pathfinding.to = { x: ~~playerPos.x, y: ~~playerPos.z };
185:       }
186: 
187:       playerEntity.transform.rot.y =
188:         Math.atan2(targetPos.z - playerPos.z, targetPos.x - playerPos.x) +
189:         Math.PI / 2;
190: 
191:       world.talkTarget = null;
192:       const npc = {
193:         netId: target.netId!,
194:         name: target.objectNameInWorld ?? 'NPC',
195:         npcType: target.npcType!,
196:       };
197:       // An event NPC (the Crywolf statue) never opens a server window.
198:       if (events.useNpc(npc)) return;
199:       Store.talkToNpc(npc);
200:     },
201:   };
202: };
</file>

<file path="src/ecs/systems/objectEffectSystem.ts">
  1: import { Vector3 } from '../../libs/babylon/exports';
  2: import { EventBus } from '../../libs/eventBus';
  3: import { playBurst, type BurstKind } from '../../effects/bursts';
  4: import { playSfx } from '../../libs/sfx';
  5: import { UI_BUS } from '../../sound/ui';
  6: import { TerrainDecal } from '../../common/moveTargetEffect';
  7: import { dropTier, type DropTier } from '../../common/dropTier';
  8: import { lighting } from '../../lighting';
  9: import type { Entity, ISystemFactory } from '../world';
 10: 
 11: /**
 12:  * Renders server-driven object effects:
 13:  *  - `objectEffect` events (ShowEffect / ShowSwirl / level-up) → particle bursts
 14:  *    at the object (effects/bursts.ts).
 15:  *  - dropped items: a soft ground glow under excellent / high-level drops so
 16:  *    valuable loot reads from a distance (tier colours from dropTier.ts).
 17:  */
 18: 
 19: const GLOW_TEXTURE = 'Effect/flare01.OZJ';
 20: const GLOW_SCALE = 1.4;
 21: const GLOW_LIGHT: Record<Exclude<DropTier, 'normal'>, [number, number, number]> = {
 22:   excellent: [0.25, 0.7, 0.3],
 23:   high: [0.7, 0.55, 0.15],
 24:   money: [0.6, 0.5, 0.1],
 25: };
 26: 
 27: const tmp = new Vector3();
 28: 
 29: export const ObjectEffectSystem: ISystemFactory = world => {
 30:   const drops = world.with('droppedItem', 'transform');
 31:   const glows = new Map<Entity, TerrainDecal>();
 32:   const pool: TerrainDecal[] = [];
 33:   let glowSeq = 0;
 34: 
 35:   function positionOf(e: Entity, height: number): Vector3 {
 36:     const t = e.transform!;
 37:     return tmp.set(
 38:       t.pos.x + (t.posOffset?.x ?? 0),
 39:       t.pos.y + height,
 40:       t.pos.z + (t.posOffset?.z ?? 0)
 41:     );
 42:   }
 43: 
 44:   EventBus.on('objectEffect', ({ entity, effect }) => {
 45:     // ReceiveLevelUp (WSclient.cpp:6476, :9027): SOUND_LEVEL_UP with the flare burst.
 46:     if (effect === 'levelUp') {
 47:       playSfx('Sound/pLevelUp', entity.transform.pos, { bus: UI_BUS });
 48:     }
 49:     const kind: BurstKind = effect;
 50:     playBurst(world.scene, kind, positionOf(entity, 0).clone());
 51: 
 52:     // The burst also lights the ground and whoever stands by - the lighting
 53:     // layer's `objectEffects` entry owns the recipe and the follow.
 54:     lighting.objectEffect(world.scene, entity, effect);
 55:   });
 56: 
 57:   drops.onEntityAdded.subscribe(e => {
 58:     const tier = dropTier(e.droppedItem);
 59:     if (tier === 'normal') return;
 60:     const decal =
 61:       pool.pop() ??
 62:       new TerrainDecal(world, `dropGlow${glowSeq++}`, GLOW_TEXTURE, GLOW_SCALE);
 63:     decal.setAlpha(0.6);
 64:     decal.draw(
 65:       world,
 66:       e.transform.pos.x + 0.5,
 67:       e.transform.pos.z + 0.5,
 68:       GLOW_SCALE,
 69:       0,
 70:       GLOW_LIGHT[tier]
 71:     );
 72:     glows.set(e, decal);
 73:   });
 74: 
 75:   drops.onEntityRemoved.subscribe(e => {
 76:     const decal = glows.get(e);
 77:     if (!decal) return;
 78:     decal.hide();
 79:     glows.delete(e);
 80:     pool.push(decal);
 81:   });
 82: 
 83:   return {
 84:     update: () => {
 85:       // Decals drape lazily once their texture arrives.
 86:       for (const [e, decal] of glows) {
 87:         if (decal.enabled) continue;
 88:         const tier = dropTier(e.droppedItem!);
 89:         if (tier === 'normal') continue;
 90:         decal.draw(
 91:           world,
 92:           e.transform!.pos.x + 0.5,
 93:           e.transform!.pos.z + 0.5,
 94:           GLOW_SCALE,
 95:           0,
 96:           GLOW_LIGHT[tier]
 97:         );
 98:       }
 99:     },
100:   };
101: };
</file>

