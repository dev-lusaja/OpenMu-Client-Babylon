 99:   // ---- commands ----------------------------------------------------------
100: 
101:   /**
102:    * A ticket item was double-clicked in the inventory. Returns true when an
103:    * entry took the item over, so the caller does not consume it.
104:    */
105:   useTicket(slot: number, item: Item): boolean {
106:     for (const layer of this.layers) {
107:       if (layer.useTicket?.(slot, item)) return true;
108:     }
109:     return false;
110:   }
111: 
112:   /**
113:    * The hero clicked an NPC. Returns true when an entry took the talk over
114:    * (the Crywolf statue), so no `TalkToNpcRequest` goes out.
115:    */
116:   useNpc(npc: { netId: number; name: string; npcType: number }): boolean {
117:     for (const layer of this.layers) {
118:       if (layer.useNpc?.(npc)) return true;
119:     }
120:     return false;
121:   }
122: 
123:   /** `NpcWindowResponse` BloodCastle: the Archangel messenger window. */
124:   openBloodCastle(): void {
125:     openBloodCastle();
126:   }
127: 
128:   /** `NpcWindowResponse` DevilSquare: Charon's window. */
129:   openDevilSquare(): void {
130:     openDevilSquare();
131:   }
132: 
133:   enterBloodCastle(grade: number): void {
134:     enterBloodCastle(grade);
135:   }
