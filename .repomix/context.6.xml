553:   constructor(readonly scene: TestScene) {
554:     super();
555: 
556:     // `netIdCount` only exists for the transient case of two entities sharing
557:     // an id (a re-scoped object before `removeNetObject` purged the stale
558:     // one): when the indexed entity of a still-shared id goes, the survivor
559:     // is found by the one linear scan this index otherwise never does.
560:     const netIdCount = new Map<number, number>();
561:     this.netObjsQuery.onEntityAdded.subscribe(e => {
562:       this.byNetId.set(e.netId, e);
563:       netIdCount.set(e.netId, (netIdCount.get(e.netId) ?? 0) + 1);
564:     });
565:     this.netObjsQuery.onEntityRemoved.subscribe(e => {
566:       const id = e.netId;
567:       const left = (netIdCount.get(id) ?? 1) - 1;
568:       if (left <= 0) netIdCount.delete(id);
569:       else netIdCount.set(id, left);
570:       if (this.byNetId.get(id) !== e) return;
571:       this.byNetId.delete(id);
572:       if (left > 0) {
573:         for (const other of this.netObjsQuery.entities) {
574:           if (other !== e && other.netId === id) {
575:             this.byNetId.set(id, other);
