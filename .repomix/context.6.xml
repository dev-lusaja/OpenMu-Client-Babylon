 92:   function playClip(hero: Entity, action: PlayerAction): number {
 93:     const model = hero.modelObject;
 94:     if (model) applyPlayerActionSpeed(model, action, hero.attributeSystem);
 95:     if (model && hero.playerAnimation!.action === action) {
 96:       model.restartAction();
 97:     }
 98:     hero.playerAnimation!.action = action;
 99:     return model?.getActionDuration(action) ?? 0;
100:   }
101: 
102:   /**
103:    * What the clip switches branch on: the mount (collapsed to none inside a
104:    * safe zone, the way every `&& !c->SafeZone` in the original does),
105:    * `IsFemale(Class)` - which is Elf *and* Summoner, not "is elf" - and the
106:    * active world, for Rider's flying variant.
107:    */
108:   function castContext(hero: Entity): CastContext {
109:     const cls = hero.charAppearance?.charClass ?? Store.playerData.charClass;
110:     const inSafeZone = !!hero.attributeSystem?.isAboveZero('inSafeZone');
111:     return {
112:       mount: mountKind(hero.charAppearance?.pet, inSafeZone),
113:       isFemale: isFemaleClass(cls),
114:       world: world.mapIndex,
115:       alternate,
116:     };
117:   }
118: 
119:   /** The swing half of the fallback: what `SetPlayerAttack` would read. */
120:   function attackPose(hero: Entity): AttackPose {
121:     const hands = hero.charAppearance;
122:     const inSafeZone = !!hero.attributeSystem?.isAboveZero('inSafeZone');
123:     return {
124:       hands,
125:       baseClass: getBaseClass(hands?.charClass ?? Store.playerData.charClass),
126:       swordCount: hero.playerAnimation?.swordCount ?? 0,
127:       wings: isWingItem(hands?.wings),
128:       mount: mountKind(hands?.pet, inSafeZone),
129:     };
130:   }
131: 
132:   function clipFor(hero: Entity, def: SkillDefinition): PlayerAction {
133:     const action = chooseSkillAction(def, attackPose(hero), castContext(hero));
134:     // `c->SwordCount++`: every SetPlayerAttack / SetPlayerHighBowAttack the
135:     // skill switch falls through to ends on it.
136:     if (hero.playerAnimation) {
137:       hero.playerAnimation.swordCount = (hero.playerAnimation.swordCount ?? 0) + 1;
138:     }
139:     alternate = !alternate;
140:     return action;
141:   }
