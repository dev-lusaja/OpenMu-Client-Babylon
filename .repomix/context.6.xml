 67: export const GmPanel = new (class _GmPanel {
 68:   open = false;
 69: 
 70:   section: GmSection = 'live';
 71: 
 72:   /**
 73:    * The character the Character and Moderation tabs act on. Blank means
 74:    * "me" wherever the command allows it. Set by clicking a player anywhere
 75:    * in the panel, which is the whole point: a name typed by hand is a name
 76:    * typed wrong.
 77:    */
 78:   target = '';
 79: 
 80:   /** The Console's filter box. While it holds anything, it searches every group. */
 81:   query = '';
 82: 
 83:   /** The command whose form is open in the Console, if any. */
 84:   selected: GmCommand | null = null;
 85: 
 86:   /** Input values, keyed `"/command:paramName"` so each command keeps its own. */
 87:   values: Record<string, string> = {};
 88: 
 89:   /** A `confirm: true` command waiting for the second press, by line. */
 90:   confirming: string | null = null;
 91: 
 92:   /** Why the last build failed. Cleared on the next edit or send. */
 93:   error: string | null = null;
 94: 
 95:   /** What the panel sent, oldest first. */
 96:   sent: SentLine[] = [];
 97: 
 98:   /** The top bar's player search, shared by the Live and Map tabs. */
 99:   search = '';
100: 
101:   /** The tracked player whose details are open, by the tracker's id. */
102:   selectedPlayerId: string | null = null;
103: 
104:   /** The map the Map tab shows; null is wherever the game master stands. */
105:   mapView: number | null = null;
106: 
107:   /** The character whose log the Logs tab reads. */
108:   logCharacter = '';
109: 
110:   /** The last `/skin` sent; 0 is the own body. What the server holds is not reported back. */
111:   skin = 0;
112: 
113:   private nextId = 1;
114: 
115:   private queue: string[] = [];
116: 
117:   private timer: ReturnType<typeof setTimeout> | null = null;
118: 
119:   constructor() {
120:     makeAutoObservable(this, {}, { autoBind: true });
121:   }
122: 
123:   /**
124:    * True for a character the server said is a game master - and in the offline
125:    * mode, which has no server to ask and no account to be one on.
126:    *
127:    * Offline is the seam the debug menu already uses (`?offline`, see
128:    * `Store.playOffline`): it is a local scene with nobody else in it, so
129:    * showing the panel there gives away nothing and is the only way to work on
130:    * its layout without a game master account on a live server. The commands it
131:    * sends go nowhere, because there is no socket.
132:    */
133:   get available(): boolean {
134:     return Store.playerData.isGameMaster || Store.isOffline;
135:   }
136: 
137:   toggle(): void {
138:     this.open = !this.open;
139:     if (!this.open) this.clearPending();
140:   }
141: 
142:   close(): void {
143:     this.open = false;
144:     this.clearPending();
145:   }
146: 
147:   setSection(section: GmSection): void {
148:     this.section = section;
149:     this.clearPending();
150:   }
151: 
152:   /** A player row anywhere, or the field on the Character tab. */
153:   setTarget(name: string): void {
154:     this.target = name;
155:     this.error = null;
156:     this.confirming = null;
157:   }
158: 
159:   setQuery(value: string): void {
