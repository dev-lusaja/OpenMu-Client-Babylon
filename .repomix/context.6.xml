168:   const systems = factories.map((f, index) => ({
169:     name: f.name || `system${index}`,
170:     update: f(world).update,
171:   }));
172: 
173:   return {
174:     world,
175:     updateSystems: (dt: number) => {
176:       if (!perfOverlayVisible()) {
177:         for (const system of systems) system.update?.(dt);
178:         return;
179:       }
180: 
181:       for (const system of systems) {
182:         if (!system.update) continue;
183:         const started = performance.now();
184:         system.update(dt);
185:         recordSystemTime(system.name, performance.now() - started);
186:       }
187:     },
188:   } as const;
189: }
