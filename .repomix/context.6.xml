<file path="src/effects/_template.ts">
 1: /**
 2:  * TEMPLATE - copy this file to `<name>.ts`, fill in the blanks, add the layer
 3:  * to `layers.ts`. Never imported; it only exists to be copied.
 4:  *
 5:  * Every effect file has the same three parts, in this order:
 6:  *
 7:  *   1. Tuning constants at the top, each with a comment saying what it is in
 8:  *      real units (seconds, tiles, 0…1, linear RGB) and why it has that value.
 9:  *   2. Module state (a `LiveList` from core.ts plus any pool this entry owns)
10:  *      and the functions that read it. State lives here, not in the facade.
11:  *   3. The exported `EffectLayer` at the bottom, wiring `update` / `reset` /
12:  *      `spawn`.
13:  *
14:  * Pools come from core.ts: `additiveMaterial` + `acquireCard` for a handful
15:  * of billboards, `particleSystemFor` / `emitBurst` / `Emitter` for many.
16:  * Shared colours, textures and particle recipes go in `recipes.ts`.
17:  */
18: import type { Scene, Vector3 } from '../libs/babylon/exports';
19: import { LiveList, acquireCard, additiveMaterial, releaseCard, fadeOut, WHITE, type RGB, type Card } from './core';
20: import type { EffectHandle, EffectLayer } from './layer';
21: 
22: // ---- 1. tuning -------------------------------------------------------------
23: 
24: /** Seconds the card stays; the original's 20-tick lifetime at 25 Hz. */
25: const SECONDS = 0.8;
26: 
27: /** Card edge in tiles: 60 cm, a hand-sized flash. */
28: const SIZE = 0.6;
29: 
30: // ---- 2. state + readers ----------------------------------------------------
31: 
32: export interface TemplateOptions {
33:   texture: string;
34:   colour?: RGB;
35: }
36: 
37: const live = new LiveList();
38: 
39: /** How many of these are running (debug). */
40: export function templateCount(): number {
41:   return live.size;
42: }
43: 
44: function spawn(scene: Scene, at: Vector3, opts: TemplateOptions): EffectHandle {
45:   const material = additiveMaterial(scene, opts.texture, opts.colour ?? WHITE);
46:   const card: Card = acquireCard(scene, material);
47:   card.position.copyFrom(at);
48:   let t = 0;
49:   return live.push({
50:     update(dt) {
51:       t += dt;
52:       const p = t / SECONDS;
53:       card.scaling.setAll(SIZE * fadeOut(p));
54:       return p < 1;
55:     },
56:     release() {
57:       releaseCard(scene, card);
58:     },
59:   });
60: }
61: 
62: function update(_map: number, dt: number): void {
63:   live.update(dt);
64: }
65: 
66: function reset(): void {
67:   live.clear();
68: }
69: 
70: // ---- 3. the layer ----------------------------------------------------------
71: 
72: export const templateLayer: EffectLayer<TemplateOptions> = {
73:   name: 'template',
74:   update,
75:   reset,
76:   spawn,
77: };
</file>

<file path="src/effects/aura.ts">
  1: /**
  2:  * Aura - a persistent effect that wraps a body until told to stop: the
  3:  * Soul Barrier bubble, the elf buffs' orbiting motes, Swell Life's red
  4:  * shimmer. The original keeps these in the character's `m_pEffect` slots and
  5:  * re-draws them every frame while the buff flag is set
  6:  * (ZzzCharacter.cpp `RenderCharacterEffect`: MODEL_SHIELD, BITMAP_SHINY orbit).
  7:  *
  8:  * Three optional parts, all following the same point: a particle stream
  9:  * from a recipe, `orbit` cards circling at waist height, and one `shell`
 10:  * card (a sphere-ish billboard) over the body. Lives until `stop()`.
 11:  *
 12:  * Driven by: `effects.spawn('aura', …)` from `common/skillVisuals.ts`'s buff
 13:  * table (MagicEffectStatus). Read by: nobody.
 14:  */
 15: import { Vector3, type Scene } from '../libs/babylon/exports';
 16: import {
 17:   Emitter,
 18:   LiveList,
 19:   acquireCard,
 20:   additiveMaterial,
 21:   releaseCard,
 22:   hash,
 23:   type Card,
 24:   type ParticleRecipe,
 25:   type PointSource,
 26:   type RGB,
 27: } from './core';
 28: import { RGBS } from './recipes';
 29: import { spawnJoint } from './joint';
 30: import type { EffectHandle, EffectLayer } from './layer';
 31: 
 32: // ---- 1. tuning -------------------------------------------------------------
 33: 
 34: /** Orbit radius in tiles: just outside the body. */
 35: const ORBIT_RADIUS = 0.45;
 36: 
 37: /** Orbit height above the feet: the waist. */
 38: const ORBIT_HEIGHT = 0.7;
 39: 
 40: /** Orbit speed, radians/s: one lap in ~2 s like the original's `Angle += 3` per tick. */
 41: const ORBIT_SPEED = Math.PI;
 42: 
 43: /** Shell height: the chest, where MODEL_SHIELD is centred. */
 44: const SHELL_HEIGHT = 0.8;
 45: 
 46: /** Shell breathing: ±8 % scale at 2 Hz. */
 47: const SHELL_PULSE = 0.08;
 48: const SHELL_PULSE_HZ = 2;
 49: 
 50: /** Fade in/out so a buff does not pop. */
 51: const RAMP_SECONDS = 0.3;
 52: 
 53: /** Ribbon orbit: the spear-skill joints circle at 1 tile and rise the body's height... */
 54: const RIBBON_RADIUS = 0.6;
 55: const RIBBON_HEIGHT = 0.9;
 56: /** ...twice as fast as the shiny orbit so the tails stretch into a band. */
 57: const RIBBON_SPEED = Math.PI * 2;
 58: /** Vertical bob of the ribbon heads: ±0.4 tiles at half the orbit rate. */
 59: const RIBBON_BOB = 0.4;
 60: /** Default ribbon width (C++ Scale 20 = 20 cm) and tail count (MaxTails 30). */
 61: const RIBBON_WIDTH = 0.2;
 62: const RIBBON_TAILS = 30;
 63: 
 64: // ---- 2. state + readers ----------------------------------------------------
 65: 
 66: export interface AuraOptions {
 67:   follow: PointSource;
 68:   /** Particle shimmer over the body. */
 69:   stream?: { recipe: ParticleRecipe; rate: number; height?: number };
 70:   /** Cards circling the waist. */
 71:   orbit?: { texture: string; colour?: RGB; count: number; size?: number; radius?: number; height?: number };
 72:   /** Ends the aura on its own when true (the wearer left the world). */
 73:   until?: () => boolean;
 74:   /** One card over the chest. */
 75:   shell?: { texture: string; colour?: RGB; size: number; height?: number; spin?: number };
 76:   /**
 77:    * Ribbons whose heads orbit the body, tails trailing (the original's five
 78:    * MODEL_SPEARSKILL joints with LT 999999 on a Soul Barrier / Greater
 79:    * Defense). `width` = C++ Scale in tiles, `tails` = MaxTails.
 80:    */
 81:   ribbons?: { count: number; colour?: RGB; width?: number; tails?: number; radius?: number; height?: number; speed?: number };
 82: }
 83: 
 84: const live = new LiveList();
 85: 
 86: /** How many auras are up (debug). */
 87: export function auraCount(): number {
 88:   return live.size;
 89: }
 90: 
 91: const tmp = new Vector3();
 92: let seed = 0;
 93: 
 94: function spawn(scene: Scene, _at: Vector3, opts: AuraOptions): EffectHandle {
 95:   const stream = opts.stream ? new Emitter(scene, opts.stream.recipe, opts.stream.rate) : null;
 96:   const streamHeight = opts.stream?.height ?? 0;
 97: 
 98:   const orbit: Card[] = [];
 99:   const orbitRadius = opts.orbit?.radius ?? ORBIT_RADIUS;
100:   const orbitHeight = opts.orbit?.height ?? ORBIT_HEIGHT;
101:   const orbitSize = opts.orbit?.size ?? 0.25;
102:   if (opts.orbit) {
103:     const m = additiveMaterial(scene, opts.orbit.texture, opts.orbit.colour ?? RGBS.holy);
104:     for (let i = 0; i < opts.orbit.count; i++) orbit.push(acquireCard(scene, m));
105:   }
106: 
107:   let shell: Card | null = null;
108:   const shellHeight = opts.shell?.height ?? SHELL_HEIGHT;
109:   const shellSpin = opts.shell?.spin ?? 0;
110:   if (opts.shell) {
111:     shell = acquireCard(scene, additiveMaterial(scene, opts.shell.texture, opts.shell.colour ?? RGBS.soul));
112:   }
113: 
114:   const phase = hash(seed++) * Math.PI * 2;
115:   let t = 0;
116:   let stopping = false;
117:   let ramp = 0;
118: 
119:   // Persistent orbit ribbons: trail joints whose heads we drive from here.
120:   const ribbons: EffectHandle[] = [];
121:   if (opts.ribbons) {
122:     const r = opts.ribbons;
123:     const radius = r.radius ?? RIBBON_RADIUS;
124:     const height = r.height ?? RIBBON_HEIGHT;
125:     const speed = r.speed ?? RIBBON_SPEED;
126:     const anchor = new Vector3();
127:     for (let i = 0; i < r.count; i++) {
128:       const offset = (i * Math.PI * 2) / r.count;
129:       const head: PointSource = out => {
130:         opts.follow(anchor);
131:         const ang = phase + offset + speed * t;
132:         return out.set(
133:           anchor.x + Math.cos(ang) * radius,
134:           anchor.y + height + Math.sin(ang * 0.5 + offset) * RIBBON_BOB,
135:           anchor.z + Math.sin(ang) * radius
136:         );
137:       };
138:       ribbons.push(
139:         spawnJoint(scene, anchor, {
140:           head,
141:           maxTails: r.tails ?? RIBBON_TAILS,
142:           width: r.width ?? RIBBON_WIDTH,
143:           colour: r.colour ?? RGBS.white,
144:           seconds: Infinity,
145:           until: () => stopping,
146:         })
147:       );
148:     }
149:   }
150: 
151:   const fx = live.push({
152:     update(dt) {
153:       t += dt;
154:       ramp += (stopping ? -dt : dt) / RAMP_SECONDS;
155:       if (ramp > 1) ramp = 1;
156:       if (ramp <= 0) return false;
157:       if (!stopping && opts.until?.()) stopping = true;
158:       opts.follow(tmp);
159:       if (stream && !stopping) {
160:         tmp.y += streamHeight;
161:         stream.tick(tmp, dt);
162:         tmp.y -= streamHeight;
163:       }
164:       for (let i = 0; i < orbit.length; i++) {
165:         const a = phase + ORBIT_SPEED * t + (i * Math.PI * 2) / orbit.length;
166:         const c = orbit[i];
167:         c.position.set(tmp.x + Math.cos(a) * orbitRadius, tmp.y + orbitHeight + Math.sin(a * 2) * 0.08, tmp.z + Math.sin(a) * orbitRadius);
168:         c.scaling.setAll(orbitSize * ramp);
169:       }
170:       if (shell) {
171:         const pulse = 1 + Math.sin(t * SHELL_PULSE_HZ * Math.PI * 2) * SHELL_PULSE;
172:         shell.position.set(tmp.x, tmp.y + shellHeight, tmp.z);
173:         shell.scaling.setAll(opts.shell!.size * pulse * ramp);
174:         if (shellSpin) shell.rotation.z = shellSpin * t;
175:       }
176:       return true;
177:     },
178:     release() {
179:       for (const c of orbit) releaseCard(scene, c);
180:       orbit.length = 0;
181:       if (shell) releaseCard(scene, shell);
182:       for (const r of ribbons) r.stop();
183:       ribbons.length = 0;
184:     },
185:   });
186: 
187:   // A soft stop: ramp down, then the live list releases it.
188:   return {
189:     get alive() {
190:       return fx.alive;
191:     },
192:     stop() {
193:       stopping = true;
194:     },
195:   };
196: }
197: 
198: function update(_map: number, dt: number): void {
199:   live.update(dt);
200: }
201: 
202: function reset(): void {
203:   live.clear();
204: }
205: 
206: // ---- 3. the layer ----------------------------------------------------------
207: 
208: export const auraLayer: EffectLayer<AuraOptions, 'aura'> = {
209:   name: 'aura',
210:   update,
211:   reset,
212:   spawn,
213: };
</file>

<file path="src/effects/blur.ts">
  1: /**
  2:  * Blur - a weapon-swing trail: a ribbon stretched between the last N
  3:  * positions of two moving points (hilt and tip), textured with the sword
  4:  * sheet, fading from the newest sample to the oldest. The original's
  5:  * `CreateBlur(o, bone, …)` / `RenderBlur` (ZzzEffectBlur.cpp): it stores
  6:  * `MAX_BLURS` past frames of a bone's two ends and draws them as one strip.
  7:  *
  8:  * One updatable mesh per trail; positions rewritten every frame, UVs fixed.
  9:  * Sampled every frame for `seconds`, then it fades out as the samples age.
 10:  *
 11:  * Driven by: `effects.spawn('blur', …)` from the melee skill rows and from
 12:  * `ecs/systems/weaponTrailSystem.ts` (`CreateWeaponBlur`: every swing clip,
 13:  * the table in `common/weaponBlur.ts`), with the weapon bone pair as
 14:  * `follow` / `base`. Read by: nobody.
 15:  */
 16: import { Mesh, Vector3, VertexBuffer, VertexData, type Scene } from '../libs/babylon/exports';
 17: import type { TestScene } from '../scenes/testScene';
 18: import {
 19:   LiveList,
 20:   additiveMaterial,
 21:   fadeOut,
 22:   type EffectBlend,
 23:   type PointSource,
 24:   type RGB,
 25: } from './core';
 26: import { RGBS, TEX } from './recipes';
 27: import type { EffectHandle, EffectLayer } from './layer';
 28: 
 29: // ---- 1. tuning -------------------------------------------------------------
 30: 
 31: /** Frames of history: the original keeps 10 blur slots. */
 32: const SAMPLES = 10;
 33: 
 34: /** How long a swing is sampled: the attack clip's contact window. */
 35: const DEFAULT_SECONDS = 0.5;
 36: 
 37: /** Tail length after sampling stops: the last samples fade over this. */
 38: const FADE_SECONDS = 0.15;
 39: 
 40: // ---- 2. state + readers ----------------------------------------------------
 41: 
 42: export interface BlurOptions {
 43:   /** The moving tip (weapon end). */
 44:   follow: PointSource;
 45:   /** The moving base (hilt / hand). Default: 0.6 tiles below the tip. */
 46:   base?: PointSource;
 47:   texture?: string;
 48:   colour?: RGB;
 49:   seconds?: number;
 50:   /**
 51:    * `add` (default) is `EnableAlphaBlend`; `subtract` is the
 52:    * `EnableAlphaBlendMinus` pass RenderBlurs switches to once the owner has a
 53:    * level - the trail darkens what is behind it instead of glowing.
 54:    */
 55:   blend?: EffectBlend;
 56:   /** Stops sampling early when true (the swing clip was cut short). */
 57:   until?: () => boolean;
 58: }
 59: 
 60: const live = new LiveList();
 61: 
 62: /** How many trails are drawn (debug). */
 63: export function blurCount(): number {
 64:   return live.size;
 65: }
 66: 
 67: const tip = new Vector3();
 68: const hilt = new Vector3();
 69: 
 70: function spawn(scene: Scene, _at: Vector3, opts: BlurOptions): EffectHandle {
 71:   const seconds = opts.seconds ?? DEFAULT_SECONDS;
 72:   const material = additiveMaterial(
 73:     scene,
 74:     opts.texture ?? TEX.swordBlur,
 75:     opts.colour ?? RGBS.steel,
 76:     opts.blend ?? 'add'
 77:   );
 78: 
 79:   const positions = new Float32Array(SAMPLES * 2 * 3);
 80:   const uvs = new Float32Array(SAMPLES * 2 * 2);
 81:   const indices: number[] = [];
 82:   for (let i = 0; i < SAMPLES; i++) {
 83:     uvs[i * 4] = i / (SAMPLES - 1);
 84:     uvs[i * 4 + 1] = 0;
 85:     uvs[i * 4 + 2] = i / (SAMPLES - 1);
 86:     uvs[i * 4 + 3] = 1;
 87:     if (i < SAMPLES - 1) {
 88:       const a = i * 2;
 89:       indices.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
 90:     }
 91:   }
 92:   const mesh = new Mesh('fxBlur', scene);
 93:   const data = new VertexData();
 94:   data.positions = positions;
 95:   data.uvs = uvs;
 96:   data.indices = indices;
 97:   data.applyToMesh(mesh, true);
 98:   mesh.material = material;
 99:   mesh.isPickable = false;
100:   mesh.alwaysSelectAsActiveMesh = true;
101:   mesh.doNotSyncBoundingInfo = true;
102:   (scene as TestScene).look?.glow.addExcludedMesh(mesh);
103: 
104:   // Seed every sample at the first frame's pair so the strip has no tail to nowhere.
105:   opts.follow(tip);
106:   if (opts.base) opts.base(hilt);
107:   else hilt.set(tip.x, tip.y - 0.6, tip.z);
108:   for (let i = 0; i < SAMPLES; i++) {
109:     positions.set([hilt.x, hilt.y, hilt.z, tip.x, tip.y, tip.z], i * 6);
110:   }
111: 
112:   let t = 0;
113:   /** When sampling stopped (planned `seconds`, or earlier through `until`). */
114:   let endAt = seconds;
115:   let sampling = true;
116:   return live.push({
117:     update(dt) {
118:       t += dt;
119:       if (sampling && (t >= seconds || opts.until?.())) {
120:         sampling = false;
121:         endAt = Math.min(t, seconds);
122:       }
123:       if (t >= endAt + FADE_SECONDS) return false;
124:       if (sampling) {
125:         opts.follow(tip);
126:         if (opts.base) opts.base(hilt);
127:         else hilt.set(tip.x, tip.y - 0.6, tip.z);
128:         // Shift history back one slot; slot 0 is the newest.
129:         positions.copyWithin(6, 0, (SAMPLES - 1) * 6);
130:         positions[0] = hilt.x;
131:         positions[1] = hilt.y;
132:         positions[2] = hilt.z;
133:         positions[3] = tip.x;
134:         positions[4] = tip.y;
135:         positions[5] = tip.z;
136:       } else {
137:         // Sampling stopped: collapse the strip toward its newest edge.
138:         const k = 1 - (t - endAt) / FADE_SECONDS;
139:         for (let i = 1; i < SAMPLES; i++) {
140:           for (let c = 0; c < 6; c++) {
141:             positions[i * 6 + c] = positions[c] + (positions[i * 6 + c] - positions[c]) * k;
142:           }
143:         }
144:       }
145:       mesh.updateVerticesData(VertexBuffer.PositionKind, positions, false, false);
146:       // Until the sheet is in, the strip would draw as a solid wedge of the
147:       // tint (a subtractive one as its complement): hold it invisible.
148:       mesh.visibility = material.diffuseTexture
149:         ? fadeOut(t / (endAt + FADE_SECONDS), 0.3)
150:         : 0;
151:       return true;
152:     },
153:     release() {
154:       mesh.dispose(false, false);
155:     },
156:   });
157: }
158: 
159: function update(_map: number, dt: number): void {
160:   live.update(dt);
161: }
162: 
163: function reset(): void {
164:   live.clear();
165: }
166: 
167: // ---- 3. the layer ----------------------------------------------------------
168: 
169: export const blurLayer: EffectLayer<BlurOptions, 'blur'> = {
170:   name: 'blur',
171:   update,
172:   reset,
173:   spawn,
174: };
</file>

<file path="src/effects/bursts.ts">
  1: /**
  2:  * Bursts - the server-driven object effects: level-up, shield potion,
  3:  * shield lost, swirl. Short additive flare bursts around a body, each a row
  4:  * in `BURSTS`. The original's `ReceiveLevelUp` (WSclient.cpp:6455-6476)
  5:  * spawns 15 flare joints that rise ~40 ticks plus a magic ring; the shield
  6:  * ones are `CreateEffect(BITMAP_SHINY…)` puffs.
  7:  *
  8:  * A row may carry two more parts, both the level-up's: `rings`, the flare
  9:  * joints drawn as ribbons that orbit the spot while they climb, and
 10:  * `ground`, the circle that spreads under the feet.
 11:  *
 12:  * Driven by: `playBurst` from `ecs/systems/objectEffectSystem.ts` (the
 13:  * `objectEffect` event). Read by: nobody.
 14:  */
 15: import { Vector3, type Scene } from '../libs/babylon/exports';
 16: import { emitBurst, fxNow, hash, type ParticleRecipe, type PointSource, type RGB } from './core';
 17: import { spawnJoint } from './joint';
 18: import { spawnRing } from './ring';
 19: import { TEX } from './recipes';
 20: import { DEAD_HANDLE, type EffectHandle, type EffectLayer } from './layer';
 21: 
 22: // ---- 1. tuning -------------------------------------------------------------
 23: 
 24: /**
 25:  * Ribbons whose heads circle the spot the effect fired on while they climb:
 26:  * the original's `CreateJoint(BITMAP_FLARE, pos, pos, angle, 0, hero, 40, 2)`
 27:  * (ZzzEffectJoint.cpp:1628-1652, :5327-5361). The orbit centre is frozen at
 28:  * spawn, so the rings stay where the level-up happened.
 29:  */
 30: type BurstRings = {
 31:   /** Ribbon count (C++ 15). */
 32:   count: number;
 33:   colour: RGB;
 34:   /** Orbit radius in tiles (C++ `Velocity` 40). */
 35:   radius: number;
 36:   /** Tiles/s the head climbs (C++ `Direction[2]` 2.0-4.5 a tick). */
 37:   rise: number;
 38:   /** Fraction of `rise` the per-ribbon roll spreads over, so they never stack. */
 39:   riseJitter: number;
 40:   /** Radians/s around the centre (C++ 0.5 rad a tick at 25 Hz). */
 41:   spin: number;
 42:   /** Lifetime in seconds (C++ `LifeTime` 50). */
 43:   seconds: number;
 44:   /** Ribbon width in tiles (C++ `Scale` 40). */
 45:   width: number;
 46:   /** Tail slots, ~1.5 turns of ribbon at this spin (C++ `MaxTails` 20). */
 47:   tails: number;
 48:   /** Where the heads start above the feet. */
 49:   height: number;
 50: };
 51: 
 52: /** The circle that spreads under the feet: `CreateEffect(BITMAP_MAGIC + 1, …, 0, …)`. */
 53: type BurstGround = {
 54:   colour: RGB;
 55:   /** Diameter in tiles at the end (C++ `Scale = (20 - LifeTime) * 0.15`). */
 56:   scale: number;
 57:   /** Lifetime in seconds (C++ `LifeTime` 20). */
 58:   seconds: number;
 59: };
 60: 
 61: type BurstRow = {
 62:   colour: RGB;
 63:   count: number;
 64:   /** Seconds a flare lives. */
 65:   seconds: number;
 66:   /** Emit box half-width in tiles around the body. */
 67:   radius: number;
 68:   /** Tiles/s upward. */
 69:   rise: number;
 70:   /** Flare edge in tiles. */
 71:   size: number;
 72:   /** Emit box bottom above the feet. */
 73:   height: number;
 74:   rings?: BurstRings;
 75:   ground?: BurstGround;
 76: };
 77: 
 78: export type BurstKind = 'levelUp' | 'shieldPotion' | 'shieldLost' | 'swirl';
 79: 
 80: /** Keyed by the `objectEffect` event's name. */
 81: export const BURSTS: Record<BurstKind, BurstRow> = {
 82:   // 15 joints × ~40 ticks, gold: a column of rising sparks.
 83:   levelUp: {
 84:     colour: [1, 0.85, 0.4],
 85:     count: 60,
 86:     seconds: 1.6,
 87:     radius: 0.6,
 88:     rise: 1.8,
 89:     size: 0.35,
 90:     height: 0.1,
 91:     // The character's own light tints these in the original, which on open
 92:     // terrain is a warm white.
 93:     rings: {
 94:       count: 15,
 95:       colour: [1, 0.95, 0.7],
 96:       radius: 0.4,
 97:       rise: 0.8,
 98:       riseJitter: 0.4,
 99:       spin: 12.5,
100:       seconds: 2,
101:       width: 0.4,
102:       tails: 20,
103:       height: 0.1,
104:     },
105:     ground: { colour: [0.4, 0.6, 1], scale: 3, seconds: 0.8 },
106:   },
107:   shieldPotion: { colour: [0.4, 0.7, 1], count: 24, seconds: 0.8, radius: 0.5, rise: 0.8, size: 0.25, height: 0.8 },
108:   shieldLost: { colour: [0.8, 0.3, 0.3], count: 24, seconds: 0.8, radius: 0.5, rise: 0.4, size: 0.25, height: 0.8 },
109:   swirl: { colour: [1, 1, 1], count: 30, seconds: 1.0, radius: 0.4, rise: 1.2, size: 0.2, height: 0.2 },
110: };
111: 
112: // ---- 2. state + readers ----------------------------------------------------
113: 
114: export interface BurstsOptions {
115:   kind: BurstKind;
116: }
117: 
118: const recipes = new Map<BurstKind, ParticleRecipe>();
119: let seq = 0;
120: 
121: function recipeFor(kind: BurstKind): ParticleRecipe {
122:   let r = recipes.get(kind);
123:   if (r) return r;
124:   const row = BURSTS[kind];
125:   r = {
126:     texture: TEX.flare,
127:     colour: row.colour,
128:     size: row.size,
129:     sizeJitter: 0.3,
130:     life: row.seconds,
131:     box: [row.radius, 0.15, row.radius],
132:     dir1: [-0.15, 1, -0.15],
133:     dir2: [0.15, 1, 0.15],
134:     power: row.rise,
135:     gravity: row.rise * 0.25,
136:     spin: 1,
137:   };
138:   recipes.set(kind, r);
139:   return r;
140: }
141: 
142: function playRings(scene: Scene, rings: BurstRings, at: Vector3): void {
143:   const centre = new Vector3(at.x, at.y + rings.height, at.z);
144:   for (let i = 0; i < rings.count; i++) {
145:     const seed = seq++;
146:     const phase = hash(seed) * Math.PI * 2;
147:     const rise = rings.rise * (1 + (hash(seed + 0.5) * 2 - 1) * rings.riseJitter);
148:     const born = fxNow();
149:     // The joint layer pulls the head every frame; the effects clock is what
150:     // makes each ribbon drive itself without a step of our own.
151:     const head: PointSource = out => {
152:       const t = fxNow() - born;
153:       const a = phase + rings.spin * t;
154:       return out.set(
155:         centre.x + Math.cos(a) * rings.radius,
156:         centre.y + rise * t,
157:         centre.z + Math.sin(a) * rings.radius
158:       );
159:     };
160:     spawnJoint(scene, centre, {
161:       head,
162:       colour: rings.colour,
163:       seconds: rings.seconds,
164:       width: rings.width,
165:       maxTails: rings.tails,
166:       texture: TEX.flareBig,
167:     });
168:   }
169: }
170: 
171: /** Command: one burst of `kind` at a world position (tiles). */
172: export function playBurst(scene: Scene, kind: BurstKind, at: Vector3): void {
173:   const row = BURSTS[kind];
174:   const r = recipeFor(kind);
175:   // The box sits above the feet; nudge the emitter up by the row's height.
176:   at.y += row.height;
177:   emitBurst(scene, r, at, row.count);
178:   at.y -= row.height;
179:   if (row.rings) playRings(scene, row.rings, at);
180:   if (row.ground) {
181:     spawnRing(scene, at, {
182:       texture: TEX.magicGround2,
183:       colour: row.ground.colour,
184:       scale: row.ground.scale,
185:       seconds: row.ground.seconds,
186:       growFrom: 0,
187:       fadeTail: 0.25,
188:     });
189:   }
190: }
191: 
192: function spawn(scene: Scene, at: Vector3, opts: BurstsOptions): EffectHandle {
193:   playBurst(scene, opts.kind, at);
194:   return DEAD_HANDLE;
195: }
196: 
197: // ---- 3. the layer ----------------------------------------------------------
198: 
199: /** No update: the shared particle pool steps itself; reset is the pool's. */
200: export const burstsLayer: EffectLayer<BurstsOptions, 'bursts'> = {
201:   name: 'bursts',
202:   spawn,
203: };
</file>

<file path="src/effects/column.ts">
  1: /**
  2:  * Column - a standing column of rising, animated fire (or ice, or spirit)
  3:  * cards at a ground point for a while. The original's Flame / Inferno /
  4:  * Hellfire: `CreateEffect(BITMAP_FLAME, …)` stacked every few ticks over the
  5:  * cast point, each tongue rising and cycling its 4-cell strip
  6:  * (ZzzCharacter.cpp AT_SKILL_FLAME, ZzzEffect.cpp BITMAP_FLAME `MoveEffect`).
  7:  *
  8:  * Built on the particle pool: one shared system per recipe, an emitter at
  9:  * the point streaming `rate` tongues per second for `seconds`, then it lets
 10:  * the last tongues burn out on their own. `stop()` on the handle ends the
 11:  * stream early (a held Flame released).
 12:  *
 13:  * Driven by: `effects.spawn('column', …)`. Read by: nobody.
 14:  */
 15: import { Vector3, type Scene } from '../libs/babylon/exports';
 16: import { Emitter, LiveList, pointSource, type ParticleRecipe, type PointSource, type RGB } from './core';
 17: import { RGBS, TEX } from './recipes';
 18: import type { EffectHandle, EffectLayer } from './layer';
 19: 
 20: // ---- 1. tuning -------------------------------------------------------------
 21: 
 22: /** The original spawns a tongue every 2 ticks: 12.5/s; doubled for a full column. */
 23: const DEFAULT_RATE = 24;
 24: 
 25: /** Flame's hold: the C++ clip loops ~1.5 s before the next cast. */
 26: const DEFAULT_SECONDS = 1.5;
 27: 
 28: /** A tongue lives 20 ticks. */
 29: const TONGUE_LIFE = 0.8;
 30: 
 31: /** Tongues rise 8 units/tick = 2 tiles/s. */
 32: const TONGUE_RISE = 2;
 33: 
 34: /** Tongue card edge: 120 cm, the BITMAP_FLAME quad at scale 1.2. */
 35: const TONGUE_SIZE = 1.2;
 36: 
 37: /** Footprint half-width in tiles: Flame is a tile wide; Inferno scales it. */
 38: const DEFAULT_RADIUS = 0.35;
 39: 
 40: // ---- 2. state + readers ----------------------------------------------------
 41: 
 42: export interface ColumnOptions {
 43:   /** Tongue sheet, 4-cell strip (default BITMAP_FIRE). */
 44:   texture?: string;
 45:   colour?: RGB;
 46:   /** Seconds the column stands before it burns out. */
 47:   seconds?: number;
 48:   /** Tongues per second. */
 49:   rate?: number;
 50:   /** Footprint half-width in tiles. */
 51:   radius?: number;
 52:   /** Tongue edge in tiles. */
 53:   size?: number;
 54:   /** Rise speed, tiles/s. */
 55:   rise?: number;
 56:   /** Follow a moving point (a burning character). */
 57:   follow?: PointSource;
 58:   /** Override the whole recipe (ice columns, spirit columns). */
 59:   recipe?: ParticleRecipe;
 60: }
 61: 
 62: const live = new LiveList();
 63: 
 64: /** How many columns are burning (debug). */
 65: export function columnCount(): number {
 66:   return live.size;
 67: }
 68: 
 69: function recipeFor(opts: ColumnOptions): ParticleRecipe {
 70:   if (opts.recipe) return opts.recipe;
 71:   const r = opts.radius ?? DEFAULT_RADIUS;
 72:   const rise = opts.rise ?? TONGUE_RISE;
 73:   return {
 74:     texture: opts.texture ?? TEX.fire,
 75:     cells: { w: 64, h: 64, count: 4 },
 76:     colour: opts.colour ?? RGBS.fire,
 77:     colourEnd: RGBS.ember,
 78:     size: opts.size ?? TONGUE_SIZE,
 79:     sizeJitter: 0.2,
 80:     life: TONGUE_LIFE,
 81:     lifeJitter: 0.2,
 82:     box: [r, 0.05, r],
 83:     dir1: [-0.1, 1, -0.1],
 84:     dir2: [0.1, 1, 0.1],
 85:     power: rise,
 86:     powerJitter: 0.3,
 87:     gravity: 0,
 88:     endScale: 1.3,
 89:     capacity: 256,
 90:   };
 91: }
 92: 
 93: const tmp = new Vector3();
 94: 
 95: function spawn(scene: Scene, at: Vector3, opts: ColumnOptions): EffectHandle {
 96:   const emitter = new Emitter(scene, recipeFor(opts), opts.rate ?? DEFAULT_RATE);
 97:   const seconds = opts.seconds ?? DEFAULT_SECONDS;
 98:   const source = opts.follow ?? pointSource(at);
 99:   let t = 0;
100:   return live.push({
101:     update(dt) {
102:       t += dt;
103:       if (t >= seconds) return false;
104:       emitter.tick(source(tmp), dt);
105:       return true;
106:     },
107:     release() {},
108:   });
109: }
110: 
111: function update(_map: number, dt: number): void {
112:   live.update(dt);
113: }
114: 
115: function reset(): void {
116:   live.clear();
117: }
118: 
119: // ---- 3. the layer ----------------------------------------------------------
120: 
121: export const columnLayer: EffectLayer<ColumnOptions, 'column'> = {
122:   name: 'column',
123:   update,
124:   reset,
125:   spawn,
126: };
</file>

<file path="src/effects/debris.ts">
  1: /**
  2:  * Debris - a handful of solid pieces thrown from a point that fly, tumble,
  3:  * bounce on the terrain and vanish: the bones a skeleton / Death Cow bursts
  4:  * into (`MODEL_BONE1/2`), the boulders of a Stone Golem (`MODEL_BIG_STONE1/2`),
  5:  * the shards of an Ice Monster (`MODEL_ICE_SMALL`), the chips of a shattered
  6:  * stone (`MODEL_STONE1/2`).
  7:  *
  8:  * The original is one `CreateEffect(MODEL_*, pos, angle, light)` per piece
  9:  * with `SubType 0`: the init block (ZzzEffect.cpp:2742-2890) lifts the piece,
 10:  * picks a random yaw, a horizontal speed of (64..319)×0.1 cm/tick along it,
 11:  * an upward speed of 8..23 cm/tick, a scale of 0.8..1.1 and a life of 32..47
 12:  * ticks; the move block (:10993-11062) steps the position, damps the
 13:  * horizontal speed ×0.9 a tick, pulls 3 cm/tick² down, bounces at half speed
 14:  * off the terrain (costing 4 ticks of life and a kick of tumble), tumbles
 15:  * `Scale × 32°` a tick in the air and now and then (1 in 10 ticks) leaves a
 16:  * smoke (ice) or fire (stone) puff behind.
 17:  *
 18:  * Each piece is a `model` spawn driven from here (this entry owns the
 19:  * physics, `model.ts` the mesh), so the list order puts `debris` before
 20:  * `model`.
 21:  *
 22:  * Driven by: `effects.spawn('debris', …)` from `common/deathVisuals.ts`.
 23:  * Read by: nobody.
 24:  */
 25: import { Vector3, type Scene } from '../libs/babylon/exports';
 26: import { Store } from '../store';
 27: import { CM, LiveList, TICK, WHITE, emitBurst, type ParticleRecipe, type RGB } from './core';
 28: import { spawnModel, type ModelHandle } from './model';
 29: import type { EffectHandle, EffectLayer } from './layer';
 30: 
 31: // ---- 1. tuning -------------------------------------------------------------
 32: 
 33: /** Life in ticks: `rand() % 16 + 32`. */
 34: const LIFE_TICKS_MIN = 32;
 35: const LIFE_TICKS_SPAN = 16;
 36: 
 37: /** Horizontal launch speed: `(rand() % 256 + 64) * 0.1` cm/tick, along a random yaw. */
 38: const SPEED_CM_MIN = 6.4;
 39: const SPEED_CM_SPAN = 25.6;
 40: 
 41: /** Upward launch speed: `rand() % 16 + 8` cm/tick. */
 42: const RISE_CM_MIN = 8;
 43: const RISE_CM_SPAN = 16;
 44: 
 45: /** `o->Gravity -= 3` a tick, in cm/tick². */
 46: const GRAVITY_CM = 3;
 47: 
 48: /** `VectorScale(o->Direction, 0.9f, …)` a tick. */
 49: const DRAG_PER_TICK = 0.9;
 50: 
 51: /** Bounce: `Gravity = -Gravity * 0.5`, and 4 ticks of life gone. */
 52: const BOUNCE = 0.5;
 53: const BOUNCE_LIFE_TICKS = 4;
 54: 
 55: /** Tumble `Scale * 32°` a tick in the air, `Scale * 128°` on the bounce tick. */
 56: const TUMBLE_DEG_AIR = 32;
 57: const TUMBLE_DEG_BOUNCE = 128;
 58: 
 59: /** Piece scale `(rand() % 4 + 8) * 0.1` = 0.8…1.1 of the model's own size (`model.ts` scale 1). */
 60: const SCALE_MIN = 0.8;
 61: const SCALE_SPAN = 0.4;
 62: 
 63: /** `rand_fps_check(10)`: one puff every ~10 ticks. */
 64: const PUFF_CHANCE_PER_TICK = 0.1;
 65: 
 66: /** The piece vanishes at end of life; no alpha fade in the original. */
 67: const FADE_TAIL = 0.08;
 68: 
 69: // ---- 2. state + readers ----------------------------------------------------
 70: 
 71: export interface DebrisOptions {
 72:   /** `Skill/…glb` (recipes.ts `MODEL`). */
 73:   model: string;
 74:   /** How many pieces. */
 75:   count?: number;
 76:   /** Tint (`o->Light` of the character that broke). */
 77:   colour?: RGB;
 78:   /** Centimetres the piece starts above `at` (`o->Position[2] += …`: bone 150 / 100, ice 50). */
 79:   liftCm?: number;
 80:   /** Random start box in cm, `[±x, ±z, 0…y]` (the big stones' `rand()%128-64, …, rand()%180`). */
 81:   scatterCm?: readonly [number, number, number];
 82:   /** A puff left behind 1 tick in 10 (smoke for ice, fire for stone). */
 83:   puff?: ParticleRecipe;
 84:   /** Extra scale on every piece (1 = the original). */
 85:   scale?: number;
 86: }
 87: 
 88: type Piece = {
 89:   handle: ModelHandle;
 90:   pos: Vector3;
 91:   /** Horizontal velocity, tiles/s. */
 92:   vx: number;
 93:   vz: number;
 94:   /** Vertical velocity, tiles/s (up positive). */
 95:   vy: number;
 96:   /** Radians of pitch so far. */
 97:   pitch: number;
 98:   size: number;
 99:   /** Seconds left. */
100:   life: number;
101: };
102: 
103: const live = new LiveList();
104: 
105: /** How many pieces are in the air (debug). */
106: export function debrisCount(): number {
107:   return live.size;
108: }
109: 
110: const tmp = new Vector3();
111: 
112: /** cm/tick → tiles/s. */
113: function cmPerTick(v: number): number {
114:   return (v * CM) / TICK;
115: }
116: 
117: function spawn(scene: Scene, at: Vector3, opts: DebrisOptions): EffectHandle {
118:   const world = Store.world;
119:   const count = opts.count ?? 1;
120:   const colour = opts.colour ?? WHITE;
121:   const lift = (opts.liftCm ?? 0) * CM;
122:   const scatter = opts.scatterCm;
123:   const extra = opts.scale ?? 1;
124:   const pieces: Piece[] = [];
125: 
126:   for (let i = 0; i < count; i++) {
127:     const pos = new Vector3(at.x, at.y + lift, at.z);
128:     if (scatter) {
129:       pos.x += (Math.random() * 2 - 1) * scatter[0] * CM;
130:       pos.z += (Math.random() * 2 - 1) * scatter[1] * CM;
131:       pos.y += Math.random() * scatter[2] * CM;
132:     }
133:     const yaw = Math.random() * Math.PI * 2;
134:     const speed = cmPerTick(SPEED_CM_MIN + Math.random() * SPEED_CM_SPAN);
135:     const size = SCALE_MIN + Math.random() * SCALE_SPAN;
136:     const lifeTicks = LIFE_TICKS_MIN + Math.random() * LIFE_TICKS_SPAN;
137:     const piece: Piece = {
138:       pos,
139:       vx: Math.sin(yaw) * speed,
140:       vz: -Math.cos(yaw) * speed,
141:       vy: cmPerTick(RISE_CM_MIN + Math.random() * RISE_CM_SPAN),
142:       pitch: 0,
143:       size,
144:       life: lifeTicks * TICK,
145:       handle: spawnModel(scene, pos, {
146:         model: opts.model,
147:         // Upper bound; the piece is stopped from here when its own life ends.
148:         seconds: (LIFE_TICKS_MIN + LIFE_TICKS_SPAN) * TICK,
149:         scale: size * extra,
150:         colour,
151:         yaw,
152:         loop: false,
153:         fadeTail: FADE_TAIL,
154:         follow: out => out.copyFrom(pos),
155:       }),
156:     };
157:     pieces.push(piece);
158:   }
159: 
160:   const gravity = cmPerTick(GRAVITY_CM) / TICK;
161:   const puff = opts.puff;
162: 
163:   return live.push({
164:     update(dt) {
165:       const ticks = dt / TICK;
166:       const drag = Math.pow(DRAG_PER_TICK, ticks);
167:       let any = false;
168:       for (const p of pieces) {
169:         if (!p.handle.alive) continue;
170:         p.life -= dt;
171:         if (p.life <= 0) {
172:           p.handle.stop();
173:           continue;
174:         }
175:         any = true;
176:         p.pos.x += p.vx * dt;
177:         p.pos.z += p.vz * dt;
178:         p.vx *= drag;
179:         p.vz *= drag;
180:         p.pos.y += p.vy * dt;
181:         p.vy -= gravity * dt;
182:         const ground = world ? world.getTerrainHeight(p.pos.x, p.pos.z) : -Infinity;
183:         if (p.pos.y < ground) {
184:           p.pos.y = ground;
185:           p.vy = -p.vy * BOUNCE;
186:           p.life -= BOUNCE_LIFE_TICKS * TICK;
187:           p.pitch -= ((p.size * TUMBLE_DEG_BOUNCE * Math.PI) / 180) * ticks;
188:         } else {
189:           p.pitch -= ((p.size * TUMBLE_DEG_AIR * Math.PI) / 180) * ticks;
190:         }
191:         p.handle.pitchTo(p.pitch);
192:         if (puff && Math.random() < PUFF_CHANCE_PER_TICK * ticks) {
193:           tmp.copyFrom(p.pos);
194:           emitBurst(scene, puff, tmp, 1);
195:         }
196:       }
197:       return any;
198:     },
199:     release() {
200:       for (const p of pieces) p.handle.stop();
201:     },
202:   });
203: }
204: 
205: function update(_map: number, dt: number): void {
206:   live.update(dt);
207: }
208: 
209: function reset(): void {
210:   live.clear();
211: }
212: 
213: // ---- 3. the layer ----------------------------------------------------------
214: 
215: export const debrisLayer: EffectLayer<DebrisOptions, 'debris'> = {
216:   name: 'debris',
217:   update,
218:   reset,
219:   spawn,
220: };
</file>

<file path="src/effects/feathers.ts">
  1: /**
  2:  * Feathers - a few white feathers let go from a point that drift down,
  3:  * tumbling, and fade: what the Blood Castle archangels shed
  4:  * (`common/npcs/archangel.ts`, documentation/archangel_npcs).
  5:  *
  6:  * Modelled on the original's `MODEL_FEATHER` (ZzzEffect.cpp:4806-4848 init,
  7:  * :15454-15500 per tick): the piece starts jittered up to 40 cm from its
  8:  * point on every axis, faces a random way, tumbles by a random 0..5 degrees
  9:  * a tick, holds an `Alpha` of 0.6..0.8 and fades `x0.97` a tick, over
 10:  * `30 +- 10` ticks under a light gravity. The original lets these fall from
 11:  * the dark wings' flap and the Desair skill, never from an NPC: the release
 12:  * from the archangels is the reviewer's ask. The fall here is slower than a
 13:  * hit's spray (a feather from a wing has a way to go) and the piece vanishes
 14:  * where it meets the ground rather than lying on it.
 15:  *
 16:  * Each feather is a `model` spawn driven from here (this entry owns the
 17:  * motion, `model.ts` the mesh), so the list order puts `feathers` before
 18:  * `model`.
 19:  *
 20:  * Driven by: `effects.spawn('feathers', …)` from `common/npcs/archangel.ts`.
 21:  * Read by: nobody.
 22:  */
 23: import { Vector3, type Scene } from '../libs/babylon/exports';
 24: import { Store } from '../store';
 25: import { CM, LiveList, TICK, WHITE, type RGB } from './core';
 26: import { spawnModel, type ModelHandle } from './model';
 27: import { MODEL } from './recipes';
 28: import type { EffectHandle, EffectLayer } from './layer';
 29: 
 30: // ---- 1. tuning -------------------------------------------------------------
 31: 
 32: /** `Position[i] += (rand() % 20 - 10) * 4`: up to 40 cm off the point, each axis. */
 33: const JITTER_CM = 40;
 34: 
 35: /**
 36:  * Life in ticks. The original's `30 + rand() % 20 - 10` is a hit's spray;
 37:  * a feather let go from a wing has two tiles to fall and a few to drift,
 38:  * so it lives seconds, not a second.
 39:  */
 40: const LIFE_TICKS_MIN = 110;
 41: const LIFE_TICKS_SPAN = 50;
 42: 
 43: /** `Alpha = 0.6 + (rand() % 10) * 0.02`. */
 44: const ALPHA_MIN = 0.6;
 45: const ALPHA_SPAN = 0.2;
 46: 
 47: /** `Angle += EyeRight`, `EyeRight = rand() % 10 - 5` degrees a tick. */
 48: const TUMBLE_DEG_MAX = 5;
 49: 
 50: /** How fast the feather ends up falling, tiles/s, and how quickly it gets there. */
 51: const FALL_TILES_PER_S = 0.32;
 52: const FALL_RAMP_S = 0.8;
 53: 
 54: /** Sideways drift, tiles/s, along a random heading, with a slow sway across it. */
 55: const DRIFT_TILES_PER_S = 0.18;
 56: const SWAY_TILES = 0.12;
 57: const SWAY_RATE = 2.2;
 58: 
 59: /**
 60:  * The fade: in over the first share of life (a feather does not pop into
 61:  * being beside a wing), out over the last, where the original's
 62:  * `Alpha *= 0.97` a tick would have taken it.
 63:  */
 64: const FADE_IN = 0.12;
 65: const FADE_TAIL = 0.45;
 66: 
 67: /** Piece scale: the Desair feather's 1.4, not the dark wings' 0.6 (a shed feather, seen whole). */
 68: const SCALE = 1.4;
 69: 
 70: // ---- 2. state + readers ----------------------------------------------------
 71: 
 72: export interface FeathersOptions {
 73:   /** How many feathers. */
 74:   count?: number;
 75:   /** Tint (`o->Light`); white is an angel's. */
 76:   colour?: RGB;
 77:   /** Extra scale on every feather (1 = the original). */
 78:   scale?: number;
 79:   /**
 80:    * A heading the drift favours, tiles/s on the ground plane (the way the
 81:    * wings face, a breeze). Added to each feather's own random drift.
 82:    */
 83:   drift?: readonly [number, number];
 84:   /**
 85:    * Ground a feather may not cross (a wall, a building): it settles there
 86:    * and falls straight down the face instead of drifting through it.
 87:    */
 88:   blocked?: (x: number, z: number) => boolean;
 89: }
 90: 
 91: type Feather = {
 92:   handle: ModelHandle;
 93:   pos: Vector3;
 94:   /** Drift heading, tiles/s. */
 95:   vx: number;
 96:   vz: number;
 97:   /** Across the heading, for the sway. */
 98:   swayX: number;
 99:   swayZ: number;
100:   swayPhase: number;
101:   /** Radians of pitch so far, and the tumble rate, radians/s. */
102:   pitch: number;
103:   tumble: number;
104:   /** Seconds alive, seconds left. */
105:   age: number;
106:   life: number;
107: };
108: 
109: const live = new LiveList();
110: 
111: /** How many feathers are in the air (debug). */
112: export function feathersCount(): number {
113:   return live.size;
114: }
115: 
116: function spawn(scene: Scene, at: Vector3, opts: FeathersOptions): EffectHandle {
117:   const world = Store.world;
118:   const count = opts.count ?? 1;
119:   const colour = opts.colour ?? WHITE;
120:   const extra = opts.scale ?? 1;
121:   const feathers: Feather[] = [];
122: 
123:   for (let i = 0; i < count; i++) {
124:     const pos = new Vector3(
125:       at.x + (Math.random() * 2 - 1) * JITTER_CM * CM,
126:       at.y + (Math.random() * 2 - 1) * JITTER_CM * CM,
127:       at.z + (Math.random() * 2 - 1) * JITTER_CM * CM
128:     );
129:     const heading = Math.random() * Math.PI * 2;
130:     const drift = DRIFT_TILES_PER_S * (0.5 + Math.random() * 0.5);
131:     const bias = opts.drift ?? [0, 0];
132:     const lifeTicks = LIFE_TICKS_MIN + Math.random() * LIFE_TICKS_SPAN;
133:     const tumbleDeg = (Math.random() * 2 - 1) * TUMBLE_DEG_MAX;
134: 
135:     feathers.push({
136:       pos,
137:       vx: Math.sin(heading) * drift + bias[0],
138:       vz: -Math.cos(heading) * drift + bias[1],
139:       swayX: Math.cos(heading) * SWAY_TILES,
140:       swayZ: Math.sin(heading) * SWAY_TILES,
141:       swayPhase: Math.random() * Math.PI * 2,
142:       pitch: Math.random() * Math.PI * 2,
143:       tumble: ((tumbleDeg * Math.PI) / 180) / TICK,
144:       age: 0,
145:       life: lifeTicks * TICK,
146:       handle: spawnModel(scene, pos, {
147:         model: MODEL.feather,
148:         // Upper bound; the feather is stopped from here when its own life ends.
149:         seconds: (LIFE_TICKS_MIN + LIFE_TICKS_SPAN) * TICK,
150:         scale: SCALE * extra,
151:         colour,
152:         yaw: Math.random() * Math.PI * 2,
153:         loop: false,
154:         alpha: ALPHA_MIN + Math.random() * ALPHA_SPAN,
155:         fadeIn: FADE_IN,
156:         fadeTail: FADE_TAIL,
157:         follow: out => out.copyFrom(pos),
158:       }),
159:     });
160:   }
161: 
162:   return live.push({
163:     update(dt) {
164:       let any = false;
165: 
166:       for (const f of feathers) {
167:         if (!f.handle.alive) continue;
168: 
169:         f.life -= dt;
170:         f.age += dt;
171: 
172:         if (f.life <= 0) {
173:           f.handle.stop();
174:           continue;
175:         }
176: 
177:         any = true;
178: 
179:         const fall = FALL_TILES_PER_S * Math.min(1, f.age / FALL_RAMP_S);
180:         const sway = Math.cos(f.swayPhase + f.age * SWAY_RATE) * SWAY_RATE;
181: 
182:         f.pos.y -= fall * dt;
183: 
184:         const nx = f.pos.x + (f.vx + f.swayX * sway) * dt;
185:         const nz = f.pos.z + (f.vz + f.swayZ * sway) * dt;
186: 
187:         if (opts.blocked && opts.blocked(nx, nz)) {
188:           // Met a wall: the drift is spent, the fall goes on where it is.
189:           f.vx = 0;
190:           f.vz = 0;
191:           f.swayX = 0;
192:           f.swayZ = 0;
193:         } else {
194:           f.pos.x = nx;
195:           f.pos.z = nz;
196:         }
197: 
198:         const ground = world ? world.getTerrainHeight(f.pos.x, f.pos.z) : -Infinity;
199: 
200:         if (f.pos.y <= ground) {
201:           f.handle.stop();
202:           continue;
203:         }
204: 
205:         f.pitch += f.tumble * dt;
206:         f.handle.pitchTo(f.pitch);
207:       }
208: 
209:       return any;
210:     },
211:     release() {
212:       for (const f of feathers) f.handle.stop();
213:     },
214:   });
215: }
216: 
217: function update(_map: number, dt: number): void {
218:   live.update(dt);
219: }
220: 
221: function reset(): void {
222:   live.clear();
223: }
224: 
225: // ---- 3. the layer ----------------------------------------------------------
226: 
227: export const feathersLayer: EffectLayer<FeathersOptions, 'feathers'> = {
228:   name: 'feathers',
229:   update,
230:   reset,
231:   spawn,
232: };
</file>

