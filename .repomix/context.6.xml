 35: import { Vector3 } from '../../libs/babylon/exports';
 36: import { GameOptions } from '../../common/gameOptions';
 37: import { rainStrength, rainTarget } from '../../weather/rainState';
 38: import type { ISystemFactory } from '../world';
 39: 
 40: /**
 41:  * Ambient particles: decides each frame which of the weather /
 42:  * leaf / dust recipes should be alive for the current map, weather and
 43:  * area, creates or disposes them to match, and drags the hero-relative
 44:  * ones along with the hero (the original's `MoveLeaves` spawned every
 45:  * leaf around `Hero->Object.Position`).
 46:  *
 47:  *  - Lorencia: falling leaves (`CreateLorenciaLeaf`). Noria takes the same
 48:  *    numbers (`CreateAtlanseLeaf`) on its own petal; see `NORIA_PETALS`.
 49:  *  - Atlans: marine snow drifting on the current, and bubbles rising off the
 50:  *    seabed. The original runs Atlans through the leaf path with Lorencia's
 51:  *    numbers (`CreateAtlanseLeaf`), but on World8's own round sprite and
 52:  *    additive; see `ATLANS_DRIFT`.
 53:  *  - Devias: snow (`CreateDeviasSnow`).
 54:  *  - Rain on any outdoor map while `WeatherStatusUpdate` reports weather 1
 55:  *    (the original only rained on event maps; the packet is OpenMU's way
 56:  *    of switching it, so we honour it everywhere the sky is visible).
 57:  *  - Lorencia tavern, Devias tavern and reading room: golden dust while the
 58:  *    hero stands inside the room footprint (`ROOMS`, the same boxes the
 59:  *    map modules register as `interactiveArea` entities).
 60:  *
 61:  * Sky weather is no longer switched off at a room's door. It keeps falling on
 62:  * the world outside and is clipped per particle to what the room's openings
 63:  * actually show (`weather/roomClip.ts`), which is the same rule the room mask
 64:  * draws the rest of the frame by: from a tavern you watch the snow through
 65:  * the doorway and none of it lands on the floor. Only a roof with no measured
 66:  * volume behind it - Classic tier, an arch, a shed - still turns it off.
 67:  *
 68:  * Nothing here switches. A slot that stops being eligible - the hero ducks
 69:  * under a roof, walks out of the tavern, the option goes off - only has its
 70:  * emit rate *ramped* down to zero (`AmbientSystem.update`), and the recipe is
 71:  * not disposed until the last particle it emitted has died. Becoming eligible
 72:  * is the same in reverse: the system is created at rate zero and thickens up.
 73:  * Disposing a live emitter is a pop - every leaf in the air vanishes in one
 74:  * frame - so it is kept for the one case where the particles belong to a world
 75:  * we are no longer standing in: a map change.
 76:  *
 77:  * Eligibility (map / area / option) only says a recipe *may* run. A recipe
 78:  * carrying a `schedule` then asks the shared clock how hard it blows right
 79:  * now (`ambientSchedule.ts`): leaves and snow come in gusts and squalls with
 80:  * calm in between, rolled from `serverNow()` so every client on the map sees
 81:  * the same weather at the same second. Rain is left unscheduled - the server
 82:  * already drives it through `WeatherStatusUpdate` - and so is interior dust,
 83:  * which is a property of the room rather than of the weather.
 84:  */
 85: 
 86: /** Weather byte that means rain (assumed - see the weather notes). */
 87: 
 88: 
 89: // Maps with a sky (rain may fall) are declared per map as `MapLayer.outdoor`
 90: // and read through `maps.isOutdoor(map)`.
 91: 
 92: /**
 93:  * What falls out of the sky on the two maps that shed anything, each on its
 94:  * own `<WorldName>/leaf01` (MapManager.cpp:1474-1476): Lorencia's dandelion
 95:  * puffs, Noria's pink petals.
 96:  */
 97: const LEAF_RECIPES: readonly { map: ENUM_WORLD; recipe: AmbientRecipe }[] = [
 98:   { map: ENUM_WORLD.WD_0LORENCIA, recipe: LORENCIA_LEAVES },
 99:   { map: ENUM_WORLD.WD_3NORIA, recipe: NORIA_PETALS },
100: ];
101: 
102: /** Lorencia pub floor, matching the interactive area in loadMapIntoScene. */
103: const LORENCIA_TAVERN: Room = {
104:   min: { x: 120, y: 120 },
105:   max: { x: 129, y: 136 },
106:   centre: { x: 124.5, z: 128 },
107: };
108: 
109: /** Dust rooms: the recipe runs while the hero stands inside the footprint. */
110: const ROOMS: { map: ENUM_WORLD; room: Room; recipe: AmbientRecipe }[] = [
111:   { map: ENUM_WORLD.WD_0LORENCIA, room: LORENCIA_TAVERN, recipe: TAVERN_DUST },
112:   { map: ENUM_WORLD.WD_2DEVIAS, room: DEVIAS_TAVERN, recipe: HEARTH_DUST },
113:   { map: ENUM_WORLD.WD_2DEVIAS, room: DEVIAS_READING_ROOM, recipe: TAVERN_DUST },
114:   {
115:     map: ENUM_WORLD.WD_2DEVIAS,
116:     room: DEVIAS_WEST_HEARTH_HOUSE,
117:     recipe: HOUSE_HEARTH_DUST,
118:   },
119:   {
120:     map: ENUM_WORLD.WD_2DEVIAS,
121:     room: DEVIAS_EAST_HEARTH_HOUSE,
122:     recipe: HOUSE_HEARTH_DUST,
123:   },
124: ];
125: 
126: type Slot = {
127:   recipe: AmbientRecipe;
128:   /** Follows the hero each frame; otherwise the emitter is placed once. */
129:   followHero: boolean;
130:   /** `indoors`: the hero is under a roof the room clip cannot judge, so sky
131:    *  weather must not follow them in at all. */
132:   active: (world: ENUM_WORLD, indoors: boolean) => boolean;
133:   placeAt?: (out: Vector3) => void;
134:   /** Room slots: alive only while the hero stands inside this footprint. */
135:   room?: Room;
136:   /** Extra 0..1 gain on top of the recipe's schedule (rain intensity). */
137:   strength?: () => number;
138: };
139: 
140: /** Stand-in eye while the scene has no active camera; the clip is off then anyway. */
141: const ORIGIN = new Vector3();
142: 
143: export const AmbientParticleSystem: ISystemFactory = world => {
144:   const scene = world.scene;
145:   const areas = world.with('interactiveArea', 'worldIndex');
146: 
147:   const slots: Slot[] = [
148:     ...LEAF_RECIPES.map(
149:       ({ map: leafMap, recipe }): Slot => ({
150:         recipe,
151:         followHero: true,
152:         active: (map, indoors) =>
153:           GameOptions.ambientParticles && !indoors && map === leafMap,
154:       })
155:     ),
156:     // Atlans, and any other map declaring `MapLayer.underwater`. Both run
157:     // whenever the map is: there is no roof to duck under down here, and the
158:     // drift carries its own schedule.
159:     {
160:       recipe: ATLANS_DRIFT,
161:       followHero: true,
162:       active: map => GameOptions.ambientParticles && UNDERWATER_MAPS.has(map),
163:     },
164:     {
165:       recipe: ATLANS_BUBBLES,
166:       followHero: true,
167:       active: map => GameOptions.ambientParticles && UNDERWATER_MAPS.has(map),
168:     },
169:     // Snow falls on the maps that declare a fall (`SNOWFALL_MAPS`: Devias and
170:     // Santa Town). A snow sky keeps rain off every Ice City world too, but
171:     // nothing comes down over the ice.
172:     {
173:       recipe: DEVIAS_SNOW,
174:       followHero: true,
175:       active: (map, indoors) =>
176:         GameOptions.ambientParticles && !indoors && SNOWFALL_MAPS.has(map),
177:     },
178:     {
179:       recipe: DEVIAS_SNOW_BIG,
180:       followHero: true,
181:       active: (map, indoors) =>
182:         GameOptions.ambientParticles && !indoors && SNOWFALL_MAPS.has(map),
183:     },
184:     {
185:       recipe: RAIN,
186:       followHero: true,
187:       // `RainCurrent` (see rainState.ts): the server's low nibble is the
188:       // intensity, and the value ramps rather than snapping - so the slot is
189:       // alive as long as any rain is still falling, including while the last
190:       // shower fades out after the packet has already said 'clear'.
191:       active: (map, indoors) =>
192:         GameOptions.weatherEffects &&
193:         !indoors &&
194:         maps.canRain(map) &&
195:         (rainTarget(map) > 0 || rainStrength() > 0),
196:       strength: () => rainStrength(),
197:     },
198:     ...ROOMS.map(
199:       ({ map, room, recipe }): Slot => ({
200:         recipe,
201:         followHero: false,
202:         room,
203:         active: current => GameOptions.ambientParticles && current === map,
204:         placeAt: out => {
205:           out.set(
206:             room.centre.x,
207:             world.getTerrainHeight(room.centre.x, room.centre.z),
208:             room.centre.z
209:           );
210:         },
211:       })
212:     ),
213:   ];
214: 
215:   /** A live recipe, plus when its schedule last went quiet (null = emitting). */
216:   type Live = { ambient: AmbientSystem; quietSince: number | null };
217: 
218:   const live = new Map<Slot, Live>();
219:   const heroPos = new Vector3();
220:   /** Last map we ran on: a warp is the one hard cut (see the note above). */
221:   let lastMap: ENUM_WORLD | null = null;
222: 
223:   /**
224:    * How long a system may keep draining after it is told to stop: the ramp
225:    * down, plus the longest a particle emitted on the way down can still live.
226:    *
227:    * `ambient.maxLife()` rather than `recipe.life[1]`: a recipe with `growth`
228:    * lengthens its lifetimes as the strength falls (a slow drop takes longer
229:    * to reach the ground), so the recipe's own number is a floor. Reading the
230:    * live one is what keeps the promise that the last drops of a shower land
231:    * instead of being disposed in mid-air.
232:    */
233:   function drainMs(_slot: Slot, ambient: AmbientSystem): number {
234:     return (ambient.ramp + ambient.maxLife() + 1) * 1000;
235:   }
236: 
237:   function heroInside(room: Room, x: number, z: number): boolean {
238:     return (
239:       x >= room.min.x && x <= room.max.x && z >= room.min.y && z <= room.max.y
240:     );
241:   }
242: 
243:   function inTavern(): boolean {
244:     for (const e of areas) {
245:       if (e.worldIndex !== world.mapIndex) continue;
246:       if (e.interactiveArea.inside) return true;
247:     }
248:     return false;
249:   }
250: 
251:   return {
252:     update: dt => {
253:       const hero = world.playerEntity;
254:       if (!hero) return;
255: 
256:       const map = world.mapIndex;
257: 
258:       // The one hard cut: these emitters are placed in the world we just
259:       // left, so they cannot be allowed to drain across the warp.
260:       if (lastMap !== null && map !== lastMap) {
261:         for (const have of live.values()) have.ambient.dispose();
262:         live.clear();
263:       }
264:       lastMap = map;
265: 
266:       // The weather itself (rain ramp, settled snow, wetness) was stepped by
267:       // WeatherSystem just before this; the slots below only read it.
268:       const tavern = inTavern();
269: 
270:       // A room the mask is drawing keeps its own weather out, per particle
271:       // (weather/roomClip.ts), so the shower goes on falling in the world
272:       // outside and is seen through the doorway. Without one - Classic tier,
273:       // or a roof nobody measured a volume for - there is nothing to clip
274:       // against and the old rule stands: under a roof, no sky weather.
275:       const room =
276:         roomMaskActive() && roomClipAvailable()
277:           ? (lookDirector()?.state().area?.volume ?? null)
278:           : null;
279:       const camera = scene.activeCamera?.globalPosition;
280:       setRoomWeatherClip(room, camera ?? ORIGIN);
281: 
282:       // A ceiling hidden by CeilingHideSystem still keeps the weather out.
283:       const indoors = (tavern || isHeroUnderRoof()) && room === null;
284: 
285:       heroPos.copyFrom(hero.transform.pos as Vector3);
286:       const hx = heroPos.x + (hero.transform.posOffset?.x ?? 0);
287:       const hz = heroPos.z + (hero.transform.posOffset?.z ?? 0);
288: 
289:       const now = serverNow();
290: 
291:       for (const slot of slots) {
292:         const eligible =
293:           slot.active(map, indoors) &&
294:           (!slot.room || heroInside(slot.room, hx, hz));
295: 
296:         // Eligibility, the gust schedule and the rain intensity all feed the
297:         // same number, so losing the area reads exactly like the wind dying:
298:         // the rate ramps down and the leaves already flying land.
299:         const { schedule } = slot.recipe;
300:         const strength = !eligible
301:           ? 0
302:           : (schedule ? ambientStrengthAt(schedule, map, now) : 1) *
303:             (slot.strength?.() ?? 1);
304: 
305:         let have = live.get(slot);
306: 
307:         if (strength <= 0) {
308:           // Between episodes: ramp the rate to zero, let what is in the air
309:           // finish falling, then release the system until the next gust.
310:           if (have) {
311:             have.ambient.setStrength(0);
312:             have.ambient.update(dt);
313:             if (have.quietSince === null) have.quietSince = now;
314:             if (slot.followHero) have.ambient.emitter.copyFrom(heroPos);
315:             if (now - have.quietSince > drainMs(slot, have.ambient)) {
316:               have.ambient.dispose();
317:               live.delete(slot);
318:             }
319:           }
320:           continue;
321:         }
322: 
323:         if (!have) {
324:           const at = new Vector3();
325:           if (slot.placeAt) slot.placeAt(at);
326:           else at.copyFrom(heroPos);
327:           have = {
328:             ambient: createAmbientSystem(scene, slot.recipe, at),
329:             quietSince: null,
330:           };
331:           live.set(slot, have);
332:         }
333: 
334:         have.quietSince = null;
335:         have.ambient.setStrength(strength);
336:         have.ambient.update(dt);
337:         if (slot.followHero) have.ambient.emitter.copyFrom(heroPos);
338:       }
339:     },
340:   };
341: };
