<file path="src/ecs/systems/deathSystem.ts">
  1: import { Vector3 } from '../../libs/babylon/exports';
  2: import { MonsterActionType, PlayerAction } from '../../common/objects/enum';
  3: import { isPlayerAttackAction } from '../../common/playerActionMapper';
  4: import { BloodDecals } from '../../common/bloodDecals';
  5: import { shatterDeathFor, spawnBomb } from '../../common/deathVisuals';
  6: import { monsterModelTypeOf } from '../../common/playSpeed';
  7: import { inBloodCastle, inChaosCastle } from '../../common/locomotion';
  8: import { TW_ACTION, TW_NOGROUND } from '../../common/terrain/consts';
  9: import { playSfx } from '../../libs/sfx';
 10: import { COMBAT_BUS } from '../../common/combatSounds';
 11: import { effects } from '../../effects';
 12: import { bonePos, entityYaw, type RGB } from '../../effects/core';
 13: import { NOVA_DEATH_MOTES } from '../../effects/recipes';
 14: import { SKILL_COMBO, SKILL_NOVA } from '../../combat/recipes';
 15: import type { DeathMotion, Entity, ISystemFactory } from '../world';
 16: import type { PlayerObject } from '../../common/playerObject';
 17: 
 18: /**
 19:  * DeadCharacter / SetPlayerDie / the Dead counter (ZzzCharacter.cpp:3105,
 20:  * 1372, 3958; WSclient.cpp:5370, 5489):
 21:  *
 22:  * 1. Kill packet: Dead = 1, movement stops. If the hero landed the blow the
 23:  *    Die clip waits for the swing to connect (AttackFlag = ATTACK_DIE), with
 24:  *    the generic 15-tick fallback; anyone else's kill dies at once. A Nova /
 25:  *    Combo kill or a castle death also starts a body motion.
 26:  * 2. Die clip plays once and holds; two blood splats under the head bone.
 27:  *    **Special deaths** (`common/deathVisuals.ts`): Death Cow / Stone Golem /
 28:  *    Ice Monster burst into pieces instead - the body vanishes at once.
 29:  * 3. Rot += 0.02/tick from the kill. At Rot >= 1 (2 s) alpha fades to 0
 30:  *    over the next 2 s while the body sinks 0.4 cm per tick.
 31:  * 4. Body motion, render-only (`dying.offset` / `dying.pitch`):
 32:  *    - Nova / Combo (:3173-3193): for 15 ticks the corpse slides toward the
 33:  *      killer, 40…54 cm/tick decelerating; a Nova death also throws blue
 34:  *      BITMAP_LIGHT motes from random bones for 30 ticks.
 35:  *    - Blood Castle bridge edge / Chaos Castle pit (`FallingStartCharacter`,
 36:  *      WSclient.cpp:5440; `FallingCharacter`, :3014): the body tips over and
 37:  *      falls off, sideways on the bridge, straight down in the pit. Chaos
 38:  *      Castle corpses also pop `CreateBomb`s on odd ticks 15…25 (:3145-3168).
 39:  * 5. Alpha < 0.01: everyone but the hero is removed. The hero stays until
 40:  *    the respawn packet clears the state.
 41:  */
 42: 
 43: const TICKS_PER_SECOND = 25;
 44: const DIE_FALLBACK_TICKS = 15;
 45: const ROT_PER_TICK = 0.02;
 46: const SINK_PER_TICK = 0.4 / 100; // 0.4 in the original's cm units
 47: const HEAD_BONE = 20;
 48: /** Fraction of the swing clip at which the blow is taken to connect (AttackFrame). */
 49: const SWING_HIT_FRACTION = 0.5;
 50: const CM = 1 / 100;
 51: const DEG = Math.PI / 180;
 52: 
 53: // ---- Nova / Combo knock (ZzzCharacter.cpp:3173-3193, WSclient.cpp:5527-5546)
 54: /** `c->Dead < 15`: ticks the slide lasts. */
 55: const KNOCK_TICKS = 15;
 56: /** `Direction[1] = rand() % 15 + 40` cm/tick. */
 57: const KNOCK_SPEED_CM_MIN = 40;
 58: const KNOCK_SPEED_CM_SPAN = 15;
 59: /** `Velocity = (rand() % 5 + 10) * 0.1`, `+= 1` a tick. */
 60: const KNOCK_DECEL_MIN = 1.0;
 61: const KNOCK_DECEL_SPAN = 0.5;
 62: const KNOCK_DECEL_PER_TICK = 1;
 63: /** `c->Dead <= 30`: ticks the Nova motes fall from the body, 10 a tick from bones 0…31. */
 64: const NOVA_GLOW_TICKS = 30;
 65: const NOVA_MOTES_PER_TICK = 10;
 66: const NOVA_BONES = 32;
 67: 
 68: // ---- castle falls (WSclient.cpp:5440-5487, ZzzCharacter.cpp:3014-3032)
 69: /** `Gravity = rand() % 10 + 10` (cm, the initial hop up). */
 70: const FALL_HOP_CM_MIN = 10;
 71: const FALL_HOP_CM_SPAN = 10;
 72: /** Pit: `Velocity -= rand() % 3 + 3`, `Direction = (0, 0, 1)`. */
 73: const PIT_VY_MIN = 3;
 74: const PIT_VY_SPAN = 3;
 75: const PIT_DROP = 1;
 76: /** Bridge: `Velocity = rand() % 20 + 20`, `Direction = (rand()%6+8, 13-rand()%2, 5)`. */
 77: const BRIDGE_VY_MIN = 20;
 78: const BRIDGE_VY_SPAN = 20;
 79: const BRIDGE_ACCEL_MIN = 8;
 80: const BRIDGE_ACCEL_SPAN = 6;
 81: const BRIDGE_SPEED_MIN = 12;
 82: const BRIDGE_SPEED_SPAN = 2;
 83: const BRIDGE_DROP = 5;
 84: /** `Angle[0] -= 5` a tick: the body tips over as it falls. */
 85: const FALL_TIP_DEG_PER_TICK = 5;
 86: /** Chaos Castle bombs: on odd ticks in `[start - 10, start]`, start 25 (15 while falling). */
 87: const BOMB_START_TICK = 25;
 88: const BOMB_START_TICK_FALLING = 15;
 89: const BOMB_WINDOW_TICKS = 10;
 90: /** `rand() % 160 - 80` cm around the body, `+ 50` up. */
 91: const BOMB_SPREAD_CM = 80;
 92: const BOMB_RAISE_CM = 50;
 93: 
 94: const tmpHead = new Vector3();
 95: const tmpBone = new Vector3();
 96: const tmpBomb = new Vector3();
 97: 
 98: export const DeathSystem: ISystemFactory = world => {
 99:   const query = world.with('dying', 'modelObject', 'transform');
100:   let blood: BloodDecals | null = null;
101: 
102:   function heroSwingConnected(): boolean {
103:     const hero = world.playerEntity;
104:     if (!hero) return true;
105:     const action = hero.playerAnimation.action;
106:     if (!isPlayerAttackAction(action)) return true;
107:     const model = hero.modelObject;
108:     if (!model || model.CurrentAction !== action) return true;
109:     return (
110:       model.ActionIterationWasFinished ||
111:       model.actionProgress() >= SWING_HIT_FRACTION
112:     );
113:   }
114: 
115:   /** Body origin in map-local tiles (what `o->Position` is to an effect). */
116:   function bodyOrigin(e: Entity, out: Vector3): Vector3 {
117:     const t = e.transform!;
118:     return out.set(
119:       t.pos.x + (t.posOffset?.x ?? 0),
120:       t.pos.y,
121:       t.pos.z + (t.posOffset?.z ?? 0)
122:     );
123:   }
124: 
125:   /** `ReceiveDie`'s motion setup, once per kill packet. */
126:   function startMotion(e: Entity): DeathMotion | undefined {
127:     const d = e.dying!;
128:     const t = e.transform!;
129:     const map = world.mapIndex;
130:     const x = ~~t.pos.x;
131:     const y = ~~t.pos.z;
132:     if (inChaosCastle(map) && world.getTerrainFlag(x, y) & TW_NOGROUND) {
133:       return {
134:         kind: 'fall',
135:         side: 0,
136:         accel: 0,
137:         speed: 0,
138:         height: FALL_HOP_CM_MIN + Math.random() * FALL_HOP_CM_SPAN,
139:         vy: -(PIT_VY_MIN + Math.random() * PIT_VY_SPAN),
140:         drop: PIT_DROP,
141:       };
142:     }
143:     if (inBloodCastle(map) && world.getTerrainFlag(x, y) & TW_ACTION) {
144:       const side =
145:         world.getTerrainFlag(x + 1, y) & TW_NOGROUND
146:           ? 1
147:           : world.getTerrainFlag(x - 1, y) & TW_NOGROUND
148:             ? -1
149:             : 0;
150:       return {
151:         kind: 'fall',
152:         side,
153:         accel: BRIDGE_ACCEL_MIN + Math.random() * BRIDGE_ACCEL_SPAN,
154:         speed: BRIDGE_SPEED_MIN + Math.random() * BRIDGE_SPEED_SPAN,
155:         height: FALL_HOP_CM_MIN + Math.random() * FALL_HOP_CM_SPAN,
156:         vy: BRIDGE_VY_MIN + Math.random() * BRIDGE_VY_SPAN,
157:         drop: BRIDGE_DROP,
158:       };
159:     }
160:     if (inBloodCastle(map) || inChaosCastle(map)) return undefined;
161:     if (d.skill === SKILL_NOVA || d.skill === SKILL_COMBO) {
162:       // Face the killer (`CreateAngle2D(o->Position, to->Position)`); the
163:       // slide runs along that heading. Without the killer in scope: own yaw.
164:       const killer = world.getByNetId(d.killerNetId);
165:       let dirX: number;
166:       let dirZ: number;
167:       if (killer?.transform) {
168:         dirX = killer.transform.pos.x - t.pos.x;
169:         dirZ = killer.transform.pos.z - t.pos.z;
170:         const len = Math.hypot(dirX, dirZ) || 1;
171:         dirX /= len;
172:         dirZ /= len;
173:       } else {
174:         const yaw = entityYaw(e);
175:         dirX = Math.sin(yaw);
176:         dirZ = -Math.cos(yaw);
177:       }
178:       return {
179:         kind: 'knock',
180:         dirX,
181:         dirZ,
182:         speed: KNOCK_SPEED_CM_MIN + Math.random() * KNOCK_SPEED_CM_SPAN,
183:         decel: KNOCK_DECEL_MIN + Math.random() * KNOCK_DECEL_SPAN,
184:       };
185:     }
186:     return undefined;
187:   }
188: 
189:   /** One 25 Hz tick of the body motion; `tick` is the Dead counter after it. */
190:   function stepMotion(e: Entity, m: DeathMotion, tick: number): void {
191:     const d = e.dying!;
192:     if (m.kind === 'knock') {
193:       if (tick >= KNOCK_TICKS) return;
194:       m.speed = Math.max(0, m.speed - m.decel);
195:       m.decel += KNOCK_DECEL_PER_TICK;
196:       d.offset.x += m.dirX * m.speed * CM;
197:       d.offset.z += m.dirZ * m.speed * CM;
198:       return;
199:     }
200:     // FallingCharacter: Direction[1] += Direction[0]; Gravity += Velocity;
201:     // Velocity -= Direction[2]; Angle[0] -= 5; Position = dead + rotated slide, z = dead + Gravity.
202:     m.speed += m.accel;
203:     m.height += m.vy;
204:     m.vy -= m.drop;
205:     d.pitch -= FALL_TIP_DEG_PER_TICK * DEG;
206:     d.offset.x = m.side * m.speed * CM;
207:     d.offset.y = m.height * CM;
208:   }
209: 
210:   function novaGlow(e: Entity, ticks: number): void {
211:     const count = Math.round(NOVA_MOTES_PER_TICK * ticks);
212:     for (let i = 0; i < count; i++) {
213:       bonePos(e, Math.floor(Math.random() * NOVA_BONES), tmpBone);
214:       tmpBone.x -= world.mapParent.position.x;
215:       tmpBone.z -= world.mapParent.position.z;
216:       effects.spawn('particles', world.scene, tmpBone, { recipe: NOVA_DEATH_MOTES, count: 1 });
217:     }
218:   }
219: 
220:   function chaosBombs(e: Entity, tickBefore: number, tickAfter: number): void {
221:     const start = e.dying!.motion?.kind === 'fall' ? BOMB_START_TICK_FALLING : BOMB_START_TICK;
222:     for (let tick = Math.floor(tickBefore) + 1; tick <= Math.floor(tickAfter); tick++) {
223:       if (tick > start || tick < start - BOMB_WINDOW_TICKS || tick % 2 === 0) continue;
224:       bodyOrigin(e, tmpBomb);
225:       tmpBomb.x += (Math.random() * 2 - 1) * BOMB_SPREAD_CM * CM;
226:       tmpBomb.z += (Math.random() * 2 - 1) * BOMB_SPREAD_CM * CM;
227:       tmpBomb.y += ((Math.random() * 2 - 1) * BOMB_SPREAD_CM + BOMB_RAISE_CM) * CM;
228:       spawnBomb(world.scene, tmpBomb);
229:     }
230:   }
231: 
232:   function startDie(e: Entity) {
233:     const d = e.dying!;
234:     const model = e.modelObject!;
235: 
236:     // SetPlayerDie's switch: a shatter death replaces the Die clip and the
237:     // blood - the body is gone (`o->Live = false`) and the pieces fly.
238:     const shatter = e.monsterAnimation
239:       ? shatterDeathFor(monsterModelTypeOf(e.npcType))
240:       : ((model.constructor as typeof PlayerObject).DeathShatter ?? undefined);
241:     if (shatter) {
242:       const light: RGB = [model.Light.x, model.Light.y, model.Light.z];
243:       bodyOrigin(e, tmpHead);
244:       shatter.spawn(world.scene, tmpHead, light);
245:       if (shatter.sound) {
246:         playSfx(shatter.sound, { x: tmpHead.x, z: tmpHead.z }, { bus: COMBAT_BUS });
247:       }
248:       model.setAlpha(0);
249:       d.alpha = 0;
250:       d.shattered = true;
251:       return;
252:     }
253: 
254:     if (e.monsterAnimation) {
255:       e.monsterAnimation.action = MonsterActionType.Die;
256:     } else if (e.playerAnimation) {
257:       e.playerAnimation.action = PlayerAction.PLAYER_DIE1;
258:     }
259: 
260:     // CreateBlood at the head bone (falls back to the body origin).
261:     const transform = e.transform!;
262:     const bone = model.gltf?.skeleton?.bones[HEAD_BONE + 1];
263:     const node = bone?.getTransformNode();
264:     if (node) {
265:       tmpHead.copyFrom(node.getAbsolutePosition());
266:       tmpHead.x -= world.mapParent.position.x;
267:       tmpHead.z -= world.mapParent.position.z;
268:     } else {
269:       tmpHead.set(
270:         transform.pos.x + (transform.posOffset?.x ?? 0),
271:         transform.pos.y,
272:         transform.pos.z + (transform.posOffset?.z ?? 0)
273:       );
274:     }
275:     if (!blood) blood = new BloodDecals(world);
276:     blood.spawn(tmpHead, model.Light);
277:   }
278: 
279:   return {
280:     update: dt => {
281:       const ticks = dt * TICKS_PER_SECOND;
282:       blood?.update(dt);
283: 
284:       for (const e of query) {
285:         const d = e.dying;
286:         const model = e.modelObject;
287:         const tickBefore = d.time * TICKS_PER_SECOND;
288:         d.time += dt;
289:         const tickAfter = d.time * TICKS_PER_SECOND;
290: 
291:         // ReceiveDie's motion setup runs on the kill tick, before the Die clip.
292:         if (tickBefore === 0) d.motion = startMotion(e);
293:         if (d.motion) {
294:           for (let tick = Math.floor(tickBefore) + 1; tick <= Math.floor(tickAfter); tick++) {
295:             stepMotion(e, d.motion, tick);
296:           }
297:         }
298:         if (d.skill === SKILL_NOVA && tickAfter <= NOVA_GLOW_TICKS && !d.shattered) {
299:           novaGlow(e, ticks);
300:         }
301:         if (inChaosCastle(world.mapIndex)) chaosBombs(e, tickBefore, tickAfter);
302: 
303:         if (!d.started) {
304:           const waitForHero = d.killedByHero && !heroSwingConnected();
305:           if (
306:             model.Ready &&
307:             (!waitForHero || d.time * TICKS_PER_SECOND >= DIE_FALLBACK_TICKS)
308:           ) {
309:             d.started = true;
310:             startDie(e);
311:           }
312:           continue;
313:         }
314: 
315:         if (d.shattered) {
316:           // `o->Live = false`: nothing left to fade; the pieces are the effects layer's.
317:           if (!e.localPlayer && !e.objOutOfScope) {
318:             world.addComponent(e, 'objOutOfScope', true);
319:           }
320:           continue;
321:         }
322: 
323:         d.rot += ROT_PER_TICK * ticks;
324:         if (d.rot >= 1) {
325:           d.alpha = Math.max(0, 1 - (d.rot - 1));
326:           model.setAlpha(d.alpha);
327:           if (d.alpha >= 0.01) {
328:             d.sink += SINK_PER_TICK * ticks;
329:           } else if (!e.localPlayer && !e.objOutOfScope) {
330:             world.addComponent(e, 'objOutOfScope', true);
331:           }
332:         }
333:       }
334:     },
335:   };
336: };
</file>

