51:       for (const { pathfinding } of query) {
52:         if (pathfinding.calculated) continue;
53: 
54:         pathfinding.path = world.pathfinder.search(
55:           pathfinding.from,
56:           pathfinding.to
57:         );
58: 
59:         pathfinding.calculated = true;
60: 
61:         if (pathfinding.path.length > 0) {
62:           pathfinding.path[0].x = pathfinding.from.x;
63:           pathfinding.path[0].y = pathfinding.from.y;
64:         }
65:       }
66:     },
67:   };
