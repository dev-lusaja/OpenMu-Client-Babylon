367:   /**
368:    * The per-frame eye / jaw sprites and the variant-coloured body lightning
369:    * of the original's Fenrir render branch (ZzzObject.cpp:855-895), as
370:    * periodic effect spawns. Not called in a safe zone - the mount is faded
371:    * out there and the original skips the branch with it.
372:    */
373:   function updateFenrirGlow(actor: Entity, dt: number) {
374:     const clock = (glowClocks.get(actor) ?? 0) + dt;
375:     if (clock < FENRIR_GLOW_TICK) {
376:       glowClocks.set(actor, clock);
377:       return;
378:     }
379:     glowClocks.set(actor, clock % FENRIR_GLOW_TICK);
380: 
381:     const scene = world.scene;
382:     if (!scene || !actor.modelObject?.gltf) return;
383: 
384:     for (const local of FENRIR_EYE_LOCALS) {
385:       boneLocalPos(actor, FENRIR_HEAD_BONE, local, tmpGlow);
386:       effects.spawn('sprite', scene, tmpGlow, {
387:         texture: TEX.flare,
388:         colour: FENRIR_EYE_RGB,
389:         size: 0.35,
390:         seconds: 0.16,
391:         fadeTail: 0.6,
392:       });
393:     }
394:     boneLocalPos(actor, FENRIR_JAW_BONE, FENRIR_JAW_LOCAL, tmpGlow);
395:     effects.spawn('sprite', scene, tmpGlow, {
396:       texture: TEX.flare,
397:       colour: FENRIR_JAW_RGB,
398:       size: 0.8,
399:       seconds: 0.16,
400:       fadeTail: 0.6,
401:     });
402: 
403:     // MODEL_FENRIR_THUNDER: lightning_type01 flickers on a random bone, a
404:     // third of the rolls discarded (ZzzEffect.cpp:4363-4415).
405:     if (Math.random() < 0.85) {
406:       const bone =
407:         FENRIR_THUNDER_BONES[(Math.random() * FENRIR_THUNDER_BONES.length) | 0];
408:       bonePos(actor, bone, tmpGlow, 0.6);
409:       effects.spawn('model', scene, tmpGlow, {
410:         model: MODEL.lightningType,
411:         colour: actor.petActor!.fenrirThunder!,
412:         seconds: 0.28,
413:         scale: 0.3 + Math.random() * 0.2,
414:         yaw: Math.random() * Math.PI * 2,
415:         fadeIn: 0.4,
416:         fadeTail: 0.5,
417:       });
418:     }
419:   }
