256:   /**
257:    * `SendInstantMoveRequest(CharPosX, CharPosY)` (MonkSystem.cpp:466-473):
258:    * the caster is put on the square one tile short of the target, along the
259:    * line between them, when that square is walkable. The server answers with
260:    * the move; offline the hero is placed directly so the lunge is still
261:    * visible.
262:    */
263:   function stepIn(hero: Entity, to: { x: number; y: number }): void {
264:     const x = ~~to.x;
265:     const y = ~~to.y;
266:     if (!world.isWalkable(x, y)) return;
267:     if (!Store.isOffline) {
268:       const packet = InstantMoveRequestPacket.createPacket();
269:       packet.TargetX = x;
270:       packet.TargetY = y;
271:       Store.sendToGS(packet.buffer);
272:     }
273:     const pos = hero.transform!.pos;
274:     pos.x = x;
275:     pos.z = y;
276:     pos.y = world.getTerrainHeight(x, y);
277:   }
