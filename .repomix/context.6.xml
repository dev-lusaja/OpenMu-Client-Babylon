<file path="src/ecs/systems/footprintSystem.ts">
  1: import { ENUM_WORLD } from '../../common/types';
  2: import { GameOptions } from '../../common/gameOptions';
  3: import {
  4:   FADE_STEPS,
  5:   FULL_STEPS,
  6:   addFootprint,
  7:   bootStrength,
  8:   resetFootprints,
  9:   updateFootprints,
 10:   type PrintKind,
 11:   type PrintLane,
 12: } from '../../weather/footprints';
 13: import { trackFor, type TrackRecipe } from '../../weather/recipes';
 14: import { monsterModelTypeOf } from '../../common/playSpeed';
 15: import { weather } from '../../weather';
 16: import { isTileOpen } from '../../libs/mu/terrainMask';
 17: import { onSnowGround } from '../../weather/snowSink';
 18: import { SNOW_GROUND_MAPS } from '../../weather/snowCover';
 19: import { RUN_THRESHOLD } from '../../common/locomotion';
 20: import { ploughSnowTrail } from '../../weather/snowTrail';
 21: import type { Entity, ISystemFactory } from '../world';
 22: 
 23: /**
 24:  * Lays the tracks down (`footprints.ts`) and runs the drying boot.
 25:  *
 26:  * Two different things wear the same shapes:
 27:  *
 28:  *  - **Wet prints.** The water is on the *boot*, not on the ground, so these
 29:  *    keep appearing after the walker has left the puddle and - the whole point
 30:  *    - keep appearing **indoors**. Walking wet feet into the tavern and leaving
 31:  *    a trail across the floorboards is the behaviour worth having.
 32:  *  - **Snow prints.** The snow is on the *ground*, so these need settled cover
 33:  *    under the foot and stop dead at a doorway. A run of them is the trail.
 34:  *
 35:  * ### Everything that walks, not just the hero
 36:  *
 37:  * This was hero-only by design, and the design was a budget: a pool of 64
 38:  * prints is about sixteen tiles of trail, and one busy square would have
 39:  * emptied it into a mess of overlapping stamps. Three things pay for the
 40:  * change.
 41:  *
 42:  *  - The hero has a **ring of their own** (`PrintLane`), at exactly the size
 43:  *    they had. Nothing anyone else does can evict the trail leading away from
 44:  *    where you are standing.
 45:  *  - Only walkers **near the hero** are laid at all (`PRINT_RANGE`), and only
 46:  *    so many of them at once (`MAX_WALKERS`). A print half a screen away is a
 47:  *    few pixels; a print off the screen is nothing at all.
 48:  *  - The long trail is not decals anyway. It is the ploughed channel in
 49:  *    `snowTrail.ts`, a world-space depth map that the terrain shader folds
 50:  *    into the snow's own relief - that has no pool to empty and is what
 51:  *    actually reads from a distance.
 52:  *
 53:  * ### Different feet leave different marks
 54:  *
 55:  * What a thing presses into the snow is its own (`weather/recipes.ts`): a
 56:  * humanoid leaves boot prints, a hound leaves four pads in two pairs, a spider
 57:  * leaves a line of pricks with clean snow between them, a worm leaves one
 58:  * unbroken groove and no prints at all, and anything off the ground - a Budge
 59:  * Dragon hovering, a wraith, a Dinorant rider - leaves the snow exactly as it
 60:  * found it. The recipe decides the silhouette, the size, the stride, the
 61:  * stance, whether there are two feet or four, how hard it presses and how wide
 62:  * a channel its body ploughs; this file decides *when*, and does it once for
 63:  * everyone.
 64:  */
 65: 
 66: // ---- what a walker is ------------------------------------------------------
 67: 
 68: /**
 69:  * Tiles from the hero past which nothing lays a print.
 70:  *
 71:  * Comfortably past the far edge of the screen at the game's camera, so a trail
 72:  * is never seen to start. Everything beyond it costs nothing at all - the
 73:  * distance test is the first thing the loop does.
 74:  */
 75: const PRINT_RANGE = 26;
 76: 
 77: /**
 78:  * Most walkers laid in one frame, hero excluded.
 79:  *
 80:  * The cap exists for the crowd ring rather than for the CPU: sixteen walkers
 81:  * at two prints a footfall drain 128 slots in a few seconds of a Devias square
 82:  * at its busiest, and past that the marks stop being anybody's trail and start
 83:  * being churn. Everything in range over the cap is simply skipped this frame;
 84:  * it is not a queue, because a trail that fills in one stride out of three is
 85:  * worse than one that is not there.
 86:  */
 87: const MAX_WALKERS = 16;
 88: 
 89: /**
 90:  * A print is only laid where the *foot* is, so a walker whose feet are off the
 91:  * ground leaves nothing however its recipe reads. `HoverHeight` is the render
 92:  * lift the original applies to a Budge Dragon's bob (`MonsterObject`) and to a
 93:  * Dinorant rider (`animationSystem`), and it is exactly the signal wanted: a
 94:  * flyer is a flyer for as long as it is actually up.
 95:  *
 96:  * The recipe's own `none` covers the ones that never come down, which the lift
 97:  * cannot see because their models simply walk their animation in the air.
 98:  */
 99: const HOVERING = 0.05;
100: 
101: /**
102:  * The two gaits, and the two reference looks they produce (`improved_2.jpg`
103:  * for the walk, `improved.jpg` for the run).
104:  *
105:  * **Walking** through dense snow the boot never clears the surface: each step
106:  * ploughs on from the last, and what is left is one continuous trench with
107:  * broken, shouldered walls, the individual prints only readable as deeper
108:  * pockets inside it. So the walk lays a wide, strong drag under the whole
109:  * track and keeps a short stride so the pockets run together.
110:  *
111:  * **Running** the leg lifts clear between footfalls: the stride is longer,
112:  * each print is a separate deep punch with untouched snow between, there is
113:  * no trough at all, and the push-off throws far more snow. Keyed on the
114:  * original's `c->Run` accumulator (`playerAnimation.run`), which is what
115:  * swaps the run clips in, so the prints change gait when the animation does.
116:  *
117:  * These are **multipliers on the recipe**, not absolute numbers, and that is
118:  * what lets one gait table serve a hero, a yeti and a spider. Against the
119:  * `boot` recipe they reproduce the tuned hero exactly: stride 0.5 and 0.78,
120:  * press 0.28 and 0.4, and so on down. Only players have a `run` accumulator,
121:  * so everything else walks - which is right anyway, since a charging hound
122:  * lays prints by the tile and not by the second.
123:  */
124: const GAIT = {
125:   walk: {
126:     stride: 1,
127:     /** Print size. */
128:     scale: 1,
129:     /** Print strength inside the trench. */
130:     press: 1,
131:     /** Trench width. */
132:     dragWidth: 1,
133:     /** How strongly the trench applies. */
134:     drag: 1,
135:     /** Spray at each footfall. */
136:     spray: 1,
137:   },
138:   run: {
139:     /** A running stride is about half again a walking one (0.5 → 0.78). */
140:     stride: 1.56,
141:     /** The boot comes down harder and goes in further. */
142:     scale: 1.05,
143:     /**
144:      * Still a pocket in a channel, not a separate hole (0.28 → 0.4). The
145:      * earlier cut gave the run no trough at all and full-strength prints, and
146:      * because MU's hero runs by default that was the trail everybody actually
147:      * saw: a row of dark ovals (the "before" shot). Deep snow does not care
148:      * whether the leg lifted between footfalls - the body still ploughs a
149:      * channel.
150:      */
151:     press: 1.4286,
152:     dragWidth: 0.9,
153:     drag: 0.9,
154:     spray: 1.2,
155:   },
156: } as const;
157: 
158: type Gait = keyof typeof GAIT;
159: 
160: /**
161:  * Everything remembered about one walker between frames.
162:  *
163:  * Held in a `WeakMap` keyed by the entity, so a monster that dies, despawns or
164:  * goes out of scope takes its state with it and there is nothing to prune.
165:  */
166: type Walker = {
167:   /** Where it was last frame, so the distance walked can be banked. */
168:   lastX: number;
169:   lastZ: number;
170:   /** Distance banked since the last footfall. */
171:   travelled: number;
172:   /** Which foot is next: +1 or -1. */
173:   side: number;
174:   /** Where its CENTRE was at the last footfall, so a trench can run from it. */
175:   prevCX: number;
176:   prevCZ: number;
177:   havePrev: boolean;
178:   /**
179:    * Prints since the boots were last in water. Starts past the end of the fade
180:    * so someone who has not stepped in anything leaves nothing.
181:    */
182:   stepsSinceWet: number;
183: };
184: 
185: function newWalker(x: number, z: number): Walker {
186:   return {
187:     lastX: x,
188:     lastZ: z,
189:     travelled: 0,
190:     side: 1,
191:     prevCX: 0,
192:     prevCZ: 0,
193:     havePrev: false,
194:     stepsSinceWet: FULL_STEPS + FADE_STEPS + 1,
195:   };
196: }
197: 
198: // ---- tuning ----------------------------------------------------------------
199: 
200: /**
201:  * Tiles walked between footfalls, and how far apart the two feet are, both now
202:  * per creature in `weather/recipes.ts`. The reasoning that set the hero's is
203:  * kept here, because it is about the *system* and not about boots.
204:  *
205:  * `stride` is ALSO how far the newest print can be behind the walker, and that
206:  * is the number that matters most for how the trail reads. A print is laid the
207:  * instant the accumulator crosses it and not again until the next one, so when
208:  * someone stops walking the last print is, on average, half a stride back -
209:  * and at the moment they stop, up to a full one. That lag is what keeps
210:  * reading as "the prints are too far from the boots"; it is not an offset that
211:  * can be corrected, because at the moment of placement the print IS under the
212:  * foot. The only lever is to place them more often.
213:  *
214:  * It is ALSO, and this is the binding constraint, what makes the trail read as
215:  * a walk. Feet alternate, so consecutive prints must be separated along the
216:  * track by MORE than a print is long. At 0.34 against a print 0.573 long they
217:  * overlapped by 0.23 and the trail read as rows of PAIRS rather than as left,
218:  * right, left - which is not a matter of taste, it is the gait being wrong.
219:  * Shortening the PRINT is what buys room for both, which is why
220:  * `FOOTPRINT_TUNING.length` came down at the same time.
221:  *
222:  * `side` is the distance from the WALKER'S CENTRE to the print, so it has to
223:  * match where that creature's feet actually are - and a person's stance is
224:  * narrow. At 0.24 the two tracks were 0.48 tiles apart, roughly a third of the
225:  * figure's own height, so the near print landed visibly outside the near boot
226:  * and the trail straddled the character instead of running under them.
227:  */
228: 
229: /** Settled cover needed before a foot leaves a mark in it. */
230: const SNOW_MIN = 0.12;
231: 
232: /**
233:  * How snowy a tile has to be before it takes a print at all.
234:  *
235:  * Above `SNOW_COVER.bedDefault` (0.3), the share `snowUnderfoot` gives a
236:  * non-snow tile, so paving and paths take none - they get the thin overlay
237:  * wash and nothing stamped into them - and below the 0.55 the part-snow
238:  * tiles (cobbles with snow between) get, so those take a faint mark. The
239:  * bilinear sampling means the threshold is crossed part way across the
240:  * boundary tile rather than exactly on its edge.
241:  */
242: const SNOW_TILE_MIN = 0.45;
243: 
244: /**
245:  * Print size against how deep the snow is.
246:  *
247:  * A boot on a dusting scuffs a small mark off the top; the same boot in deep
248:  * snow sinks in and leaves a wide crater. Because the quad scales uniformly
249:  * and the relief march works in UV, this makes the print deeper as well as
250:  * bigger, which is the whole point of it.
251:  */
252: const SNOW_SCALE_MIN = 0.75;
253: const SNOW_SCALE_MAX = 1.35;
254: 
255: /** A jump in position larger than this is a warp, not a stride. */
256: const TELEPORT = 4;
257: 
258: /** How far either side of the foot the ground slope is sampled, in tiles. */
259: const SLOPE_SPAN = 0.35;
260: 
261: /**
262:  * Settled cover from which a foot stops clearing the snow between steps and
263:  * starts ploughing through it, joining the prints into a trail.
264:  *
265:  * Above a scuff, well below a blizzard: in thin cover the foot lifts clean and
266:  * the prints genuinely are separate, which is what the earlier build was
267:  * drawing for every depth.
268:  */
269: const DRAG_MIN_COVER = 0.4;
270: 
271: /** Longest gap worth joining, in tiles. Beyond this it was a bound, not a step. */
272: const DRAG_MAX_GAP = 1.1;
273: 
274: export const FootprintSystem: ISystemFactory = world => {
275:   /**
276:    * Everything that has feet and a place to put them: every player (the hero
277:    * included, via `playerAnimation`) and every monster and NPC (`npcType`).
278:    * Two queries rather than one because the ECS has no "or", and because the
279:    * two differ in exactly one thing - a player has a run accumulator.
280:    */
281:   const players = world.with('transform', 'playerAnimation');
282:   const characters = world.with('transform', 'npcType');
283: 
284:   let lastMap: ENUM_WORLD | null = null;
285:   let have = false;
286: 
287:   /** Per-walker state; replaced wholesale on a map change. */
288:   let walkers = new WeakMap<Entity, Walker>();
289: 
290:   function step(
291:     map: ENUM_WORLD,
292:     walker: Walker,
293:     track: TrackRecipe,
294:     lane: PrintLane,
295:     x: number,
296:     y: number,
297:     z: number,
298:     angle: number,
299:     gait: Gait
300:   ) {
301:     const G = GAIT[gait];
302:     const cover = weather.snowCover;
303: 
304:     let kind: PrintKind | null = null;
305:     let strength = 0;
306:     let scale = 1;
307: 
308:     if (SNOW_GROUND_MAPS.has(map)) {
309:       // Snow lies on the ground, so the ground has to be open, covered, and
310:       // actually snow - and it has to be the ground, not a bridge over it.
311:       // `isTileOpen` alone only says there is sky overhead; it is true of a
312:       // paved square as readily as of a drift, which is how prints ended up
313:       // stamped into Devias' swept stone.
314:       const lying = isTileOpen(x, z) ? weather.snowUnderfoot(world, x, z) : 0;
315: 
316:       if (
317:         cover > SNOW_MIN &&
318:         lying > SNOW_TILE_MIN &&
319:         onSnowGround(world, x, y, z)
320:       ) {
321:         kind = 'snow';
322:         // Barely-covered ground takes a faint mark; deep cover takes a clear
323:         // one. Saturates well before full cover so a trail is not reserved
324:         // for blizzards. Scaled by how much snow is down here as well as by
325:         // how much has fallen, so the trail thins out as it crosses a path
326:         // rather than stopping at a tile edge.
327:         strength = Math.min(1, (cover - SNOW_MIN) / 0.35) * lying;
328:         scale = SNOW_SCALE_MIN + (SNOW_SCALE_MAX - SNOW_SCALE_MIN) * cover;
329:       }
330:     } else {
331:       // Water is on the boot. Standing in it recharges; every print spends it.
332:       //
333:       // Asked of the PATCH under the foot, not of the map. The first cut
334:       // read `inPuddles()` - "has the ground pooled anywhere" - so once the
335:       // streets were wet the boot recharged on every outdoor step and never
336:       // dried. Water is where the shader draws it (weather/puddleUnderfoot).
337:       // A half-drawn edge charges the sole part way: a boot that clipped the
338:       // rim of a puddle is damp, not soaked.
339:       const open = isTileOpen(x, z);
340:       const water = open ? weather.puddleUnderfoot(world, x, z) : 0;
341: 
342:       if (open && water >= 0.5) {
343:         walker.stepsSinceWet = 0;
344:       } else if (open && water > 0.15) {
345:         walker.stepsSinceWet = Math.min(
346:           walker.stepsSinceWet,
347:           FULL_STEPS + Math.round(FADE_STEPS * (1 - water))
348:         );
349:       } else {
350:         walker.stepsSinceWet++;
351:       }
352: 
353:       strength = bootStrength(walker.stepsSinceWet);
354:       if (strength > 0) kind = 'wet';
355:     }
356: 
357:     if (!kind || strength <= 0) return;
358: 
359:     // Perpendicular to the heading, so the feet straddle the walk line.
360:     const px = Math.cos(angle) * track.side * walker.side;
361:     const pz = -Math.sin(angle) * track.side * walker.side;
362:     walker.side = -walker.side;
363: 
364:     // A quadruped puts a hind foot down and a fore foot ahead of it on the
365:     // same side. Two prints in a pair, and the pair alternating sides, is
366:     // what makes a four-legged track read as four-legged.
367:     //
368:     // None at all for a slitherer: a worm's footfall is only a place along
369:     // the groove for the channel below to run from.
370:     const feet = track.shape === 'none' ? 0 : track.feet === 4 ? 2 : 1;
371:     const alongX = Math.sin(angle) * track.reach;
372:     const alongZ = Math.cos(angle) * track.reach;
373: 
374:     let sprayed = false;
375: 
376:     for (let foot = 0; foot < feet; foot++) {
377:       const fx = x + px + alongX * foot;
378:       const fz = z + pz + alongZ * foot;
379: 
380:       // The snow surface. THE PRINT GOES HERE AND NOWHERE ELSE.
381:       //
382:       // An earlier cut dropped the quad by `snowSinkDepth` to line it up with
383:       // the sunken boot, and that broke it outright: the print is a decal on
384:       // an opaque, depth-writing terrain, held just `Z_LIFT` (0.012 tiles)
385:       // above it. A drop of 0.2 tiles is seventeen times that lift, so the
386:       // quad went *under* the ground and failed the depth test everywhere the
387:       // sink was non-zero. It still drew on bridges - the one place
388:       // snowSinkDepth answers zero - which is exactly backwards from what it
389:       // should do, and is what gave the bug away.
390:       //
391:       // The alignment it was reaching for is already right without moving
392:       // anything. The rim of a hole in snow IS at the surface; the boot is
393:       // *inside* the hole. The wearer sits at -sink (0.204) and the hollow's
394:       // floor is at -depth (0.34), so the foot is in the hole with room under
395:       // it, which is what it should look like. If the two ever do read apart,
396:       // the safe dial is `FOOTPRINT_TUNING.sink` - moving the character cannot
397:       // break a depth test, and moving the decal can.
398:       const fy = world.getTerrainHeight(fx, fz);
399: 
400:       // -9999 until the map's height data lands; a print at that depth would
401:       // be a quad a mile under the world.
402:       if (fy <= -9000) continue;
403: 
404:       // The ground's own normal under the foot, from four height samples. A
405:       // decal held flat on sloping ground has to hover to clear its high side,
406:       // which is what made the prints look stuck on rather than pressed in.
407:       const hx0 = world.getTerrainHeight(fx - SLOPE_SPAN, fz);
408:       const hx1 = world.getTerrainHeight(fx + SLOPE_SPAN, fz);
409:       const hz0 = world.getTerrainHeight(fx, fz - SLOPE_SPAN);
410:       const hz1 = world.getTerrainHeight(fx, fz + SLOPE_SPAN);
411: 
412:       // A sample that fell off the map or onto a NoGround tile (-10000) would
413:       // tip the print on its side; flat is the safe answer.
414:       const usable = hx0 > -9000 && hx1 > -9000 && hz0 > -9000 && hz1 > -9000;
415: 
416:       const up = usable
417:         ? {
418:             x: -(hx1 - hx0) / (2 * SLOPE_SPAN),
419:             y: 1,
420:             z: -(hz1 - hz0) / (2 * SLOPE_SPAN),
421:           }
422:         : { x: 0, y: 1, z: 0 };
423: 
424:       addFootprint(world.scene, {
425:         x: fx,
426:         y: fy,
427:         z: fz,
428:         angle,
429:         kind,
430:         shape: track.shape,
431:         strength:
432:           kind === 'snow' ? strength * track.press * G.press : strength,
433:         scale: scale * (kind === 'snow' ? track.scale * G.scale : 1),
434:         up,
435:         lane,
436:       });
437: 
438:       // The snow the print displaced has to go somewhere. Fired from the same
439:       // stride so the puff and the hole it came from always agree.
440:       //
441:       // The hero's only, and the reason is `snowSpray`'s single shared
442:       // emitter: every burst in a frame comes out wherever the last caller
443:       // put it, so a yeti across the square would throw its snow at the
444:       // hero's feet. It is "a detail around the feet, not a feature you see
445:       // from across the square" (snowSpray.ts) and is not worth a second
446:       // particle system; a per-burst emitter is what it would take.
447:       if (kind === 'snow' && lane === 'hero' && !sprayed) {
448:         sprayed = true;
449:         weather.snowSpray(
450:           world.scene,
451:           fx,
452:           fy,
453:           fz,
454:           Math.min(1, strength * track.spray * G.spray)
455:         );
456:       }
457:     }
458: 
459:     // Join it to the last footfall. Deep snow does not let a leg swing through
460:     // cleanly, so the gap between footfalls is a ploughed trough - and that
461:     // trough is what makes a row of holes read as somebody's trail. It runs
462:     // from CENTRE to CENTRE, not from foot to foot: joined foot to foot it
463:     // zigzags with the alternating feet and reads as a sawtooth of rectangles
464:     // instead of the one channel the legs actually plough.
465:     const dragWidth = track.dragWidth * G.dragWidth;
466: 
467:     if (
468:       kind === 'snow' &&
469:       dragWidth > 0 &&
470:       track.drag > 0 &&
471:       cover >= DRAG_MIN_COVER &&
472:       walker.havePrev
473:     ) {
474:       const gap = Math.hypot(x - walker.prevCX, z - walker.prevCZ);
475: 
476:       if (gap <= DRAG_MAX_GAP) {
477:         // Into the trail depth map, not a decal: the channel is one
478:         // continuous shape in the snow's own relief (weather/snowTrail.ts).
479:         // Scaled by how far past the threshold the cover is, so the trail
480:         // fades in with the snow rather than switching on.
481:         ploughSnowTrail(
482:           walker.prevCX,
483:           walker.prevCZ,
484:           x,
485:           z,
486:           dragWidth,
487:           strength *
488:             track.drag *
489:             G.drag *
490:             Math.min(1, (cover - DRAG_MIN_COVER) / 0.3)
491:         );
492:       }
493:     }
494: 
495:     walker.prevCX = x;
496:     walker.prevCZ = z;
497:     walker.havePrev = true;
498:   }
499: 
500:   /**
501:    * Bank one entity's movement and lay a footfall when it has walked far
502:    * enough. Returns whether it counted against `MAX_WALKERS` - a walker that
503:    * did not move, or that leaves nothing, is free.
504:    */
505:   function walk(map: ENUM_WORLD, entity: Entity, lane: PrintLane): boolean {
506:     const { transform, modelObject, attributeSystem } = entity;
507:     if (!transform) return false;
508: 
509:     const track = trackFor(entity.npcType);
510: 
511:     /** Nothing to press and nothing to plough: a flyer, a wraith. */
512:     const marks = track.shape !== 'none' || track.dragWidth > 0;
513: 
514:     const x = transform.pos.x + (transform.posOffset?.x ?? 0);
515:     const z = transform.pos.z + (transform.posOffset?.z ?? 0);
516: 
517:     const walker = walkers.get(entity);
518: 
519:     if (!walker) {
520:       if (marks) walkers.set(entity, newWalker(x, z));
521:       return false;
522:     }
523: 
524:     const dx = x - walker.lastX;
525:     const dz = z - walker.lastZ;
526:     const moved = Math.sqrt(dx * dx + dz * dz);
527: 
528:     walker.lastX = x;
529:     walker.lastZ = z;
530: 
531:     // Off the ground: a hovering Budge Dragon, a Dinorant rider, a winged
532:     // character in flight. The lift only covers the first two; wings run the
533:     // FLY clips with no HoverHeight at all, so they are read off `isFlying`
534:     // (animationSystem, the original's `c->Wing.Type != -1 && !SafeZone`) -
535:     // which also keeps the boots dry over a puddle. The position is still
536:     // banked - the trail is picked up where they land, and not with a trench
537:     // dragged across everywhere they flew.
538:     //
539:     // A gate, a knock-back or a respawn is the same case for the same reason:
540:     // it is not a stride.
541:     if (
542:       moved > TELEPORT ||
543:       (modelObject?.HoverHeight ?? 0) > HOVERING ||
544:       attributeSystem?.isAboveZero('isFlying')
545:     ) {
546:       walker.travelled = 0;
547:       walker.havePrev = false;
548:       return false;
549:     }
550: 
551:     if (moved <= 0 || !marks) return false;
552: 
553:     walker.travelled += moved;
554: 
555:     const gait: Gait =
556:       entity.playerAnimation && entity.playerAnimation.run >= RUN_THRESHOLD
557:         ? 'run'
558:         : 'walk';
559: 
560:     const stride = track.stride * GAIT[gait].stride;
561: 
562:     if (walker.travelled < stride) return true;
563: 
564:     walker.travelled -= stride;
565:     step(
566:       map,
567:       walker,
568:       track,
569:       lane,
570:       x,
571:       transform.pos.y,
572:       z,
573:       Math.atan2(dx, dz),
574:       gait
575:     );
576: 
577:     return true;
578:   }
579: 
580:   /**
581:    * Why each character in scope is or is not marking the ground, from the
582:    * browser console:
583:    *
584:    *     muTracks()
585:    *
586:    * A wrong row in `weather/recipes.ts` fails **silently** - a creature
587:    * classified `none` or `slide` simply leaves nothing, which is
588:    * indistinguishable from the whole feature being broken, and Devias' Worm
589:    * cost an afternoon of guessing at a screenshot before that was obvious.
590:    * Every gate this system applies is reported here against the model type
591:    * the recipe was keyed by, so the next one is a lookup.
592:    */
593:   function explain() {
594:     const hero = world.playerEntity;
595:     const rows: Record<string, unknown>[] = [];
596: 
597:     for (const group of [players, characters]) {
598:       for (const entity of group) {
599:         const { transform, modelObject } = entity;
600:         const x = transform.pos.x + (transform.posOffset?.x ?? 0);
601:         const z = transform.pos.z + (transform.posOffset?.z ?? 0);
602:         const track = trackFor(entity.npcType);
603: 
604:         const range = hero
605:           ? Math.hypot(x - hero.transform.pos.x, z - hero.transform.pos.z)
606:           : Infinity;
607: 
608:         rows.push({
609:           name: entity.objectNameInWorld ?? (entity === hero ? '<hero>' : ''),
610:           npcType: entity.npcType ?? '<player>',
611:           model: monsterModelTypeOf(entity.npcType),
612:           shape: track.shape,
613:           press: track.press,
614:           drag: track.dragWidth,
615:           tiles: +range.toFixed(1),
616:           why:
617:             entity.dying
618:               ? 'dying'
619:               : track.shape === 'none' && track.dragWidth <= 0
620:                 ? 'recipe leaves nothing'
621:                 : (modelObject?.HoverHeight ?? 0) > HOVERING ||
622:                     entity.attributeSystem?.isAboveZero('isFlying')
623:                   ? 'off the ground'
624:                   : entity !== hero && range > PRINT_RANGE
625:                     ? 'out of range'
626:                     : !onSnowGround(world, x, transform.pos.y, z)
627:                       ? 'on a structure'
628:                       : !isTileOpen(x, z)
629:                         ? 'under a roof'
630:                         : weather.snowCover <= SNOW_MIN
631:                           ? `snow cover ${weather.snowCover.toFixed(2)}`
632:                           : weather.snowUnderfoot(world, x, z) <= SNOW_TILE_MIN
633:                             ? 'tile is not snow'
634:                             : 'marking',
635:         });
636:       }
637:     }
638: 
639:     return rows;
640:   }
641: 
642:   if (typeof window !== 'undefined') {
643:     (window as unknown as Record<string, unknown>).muTracks = explain;
644:   }
645: 
646:   return {
647:     update: dt => {
648:       const map = world.mapIndex;
649: 
650:       if (map !== lastMap) {
651:         lastMap = map;
652:         have = false;
653:         walkers = new WeakMap();
654:         resetFootprints();
655:       }
656: 
657:       // Ground weather is its own option: prints, spray and the terrain
658:       // layers go together, and none of them is the sky.
659:       if (!GameOptions.weatherEffects || !GameOptions.advancedEffects) {
660:         if (have) resetFootprints();
661:         have = false;
662:         return;
663:       }
664: 
665:       have = true;
666: 
667:       const hero = world.playerEntity;
668: 
669:       if (hero) walk(map, hero, 'hero');
670: 
671:       // Everyone else, nearest first in the only sense that is free: the
672:       // hero's own position is the centre and the range test is a squared
673:       // distance, so a monster on the far side of the map costs two
674:       // subtractions and a compare.
675:       const hx = hero?.transform.pos.x ?? 0;
676:       const hz = hero?.transform.pos.z ?? 0;
677:       let laid = 0;
678: 
679:       if (hero) {
680:         for (const group of [players, characters]) {
681:           for (const entity of group) {
682:             if (laid >= MAX_WALKERS) break;
683:             if (entity === hero) continue;
684: 
685:             // A corpse fading into the ground is not walking.
686:             if (entity.dying) continue;
687: 
688:             const ex = entity.transform.pos.x - hx;
689:             const ez = entity.transform.pos.z - hz;
690:             if (ex * ex + ez * ez > PRINT_RANGE * PRINT_RANGE) continue;
691: 
692:             if (walk(map, entity, 'crowd')) laid++;
693:           }
694:         }
695:       }
696: 
697:       updateFootprints(dt);
698:     },
699:   };
700: };
</file>

<file path="src/ecs/systems/gateSystem.ts">
 1: import type { ISystemFactory } from '../world';
 2: import { Store } from '../../store';
 3: import { findEntranceGateAt, loadGates, type Gate } from '../../libs/mu/gates';
 4: import { EventBus } from '../../libs/eventBus';
 5: import { prefetchWorldTerrain } from '../../libs/mu/prefetchWorld';
 6: 
 7: export const GateSystem: ISystemFactory = world => {
 8:   let allGates: readonly Gate[] | null = null;
 9:   let gatesOnMap: Gate[] = [];
10:   let indexedMap: number | null = null;
11: 
12:   let requestedGate: number | null = null;
13: 
14:   loadGates().then(
15:     gates => {
16:       allGates = gates;
17:       indexedMap = null;
18:     },
19:     err => console.error('Could not load the gate table:', err)
20:   );
21: 
22:   EventBus.on('warpCompleted', () => {
23:     requestedGate = null;
24:   });
25: 
26:   return {
27:     update: () => {
28:       if (!allGates) return;
29:       if (Store.isOffline) return;
30:       // A warp is in flight: the hero's position is the old map's until the
31:       // new terrain is up, and a second EnterGate on top of it double-warps.
32:       if (Store.sceneLoading) return;
33: 
34:       const playerEntity = world.playerEntity;
35:       if (!playerEntity) return;
36: 
37:       const map = playerEntity.worldIndex;
38:       if (map === undefined) return;
39: 
40:       if (indexedMap !== map) {
41:         gatesOnMap = allGates.filter(gate => gate.map === map);
42:         indexedMap = map;
43:         requestedGate = null;
44:       }
45: 
46:       if (gatesOnMap.length === 0) return;
47: 
48:       // The gate rectangle is in whole tiles and the hero is on tile
49:       // `trunc(pos)`: `round` fired half a tile before the hero was on it.
50:       const pos = playerEntity.transform.pos;
51:       const x = Math.trunc(pos.x);
52:       const y = Math.trunc(pos.z);
53: 
54:       const gate = findEntranceGateAt(gatesOnMap, map, x, y);
55: 
56:       if (!gate) {
57:         requestedGate = null;
58:         return;
59:       }
60: 
61:       if (requestedGate === gate.index) return;
62: 
63:       requestedGate = gate.index;
64: 
65:       // The exit gate names the destination map: start its terrain download
66:       // now, so the `MapChanged` answer finds the files already in flight.
67:       const exit = allGates[gate.target];
68:       if (exit && exit.map !== map) prefetchWorldTerrain(exit.map);
69: 
70:       Store.enterGateRequest(gate.index);
71:     },
72:   };
73: };
</file>

<file path="src/ecs/systems/guildFlagSystem.ts">
 1: import { Store } from '../../store';
 2: import { GUILD_FLAG_BONE, GuildFlag, isThunderHawkArmor } from '../../common/guildFlag';
 3: import { isEmptyGuildMark } from '../../common/guildMark';
 4: import { inChaosCastle } from '../../common/locomotion';
 5: import type { Entity, ISystemFactory } from '../world';
 6: 
 7: /**
 8:  * `RenderGuild` (ZzzCharacter.cpp:9450-9475, :6388): the guild mark flies on
 9:  * bone 26 of every guild member in scope - a 5x7 textured plane, drawn for
10:  * `MODEL_PLAYER` only, never inside Chaos Castle, and gone while the wearer
11:  * is cloaked or fully transparent.
12:  *
13:  * The flag's link matrix folds in the wearer's own yaw on top of the bone
14:  * transform that already carries it, so it has to be rebuilt every frame -
15:  * that is one `AngleMatrix` per visible guild member, and nothing else.
16:  */
17: export const GuildFlagSystem: ISystemFactory = world => {
18:   const query = world.with('guild', 'modelObject', 'transform', 'playerAnimation');
19:   const flags = new Map<Entity, GuildFlag>();
20: 
21:   function drop(entity: Entity): void {
22:     flags.get(entity)?.dispose();
23:     flags.delete(entity);
24:   }
25: 
26:   query.onEntityRemoved.subscribe(drop);
27: 
28:   return {
29:     update: () => {
30:       const scene = world.scene;
31:       const castle = inChaosCastle(world.mapIndex);
32: 
33:       for (const entity of query) {
34:         const model = entity.modelObject;
35:         const guild = Store.guilds.get(entity.guild.id);
36:         const logo = guild?.logo;
37:         const wanted =
38:           !castle &&
39:           !!logo &&
40:           logo.length > 0 &&
41:           !isEmptyGuildMark(logo) &&
42:           entity.visibility?.state !== 'hidden' &&
43:           model.Visible;
44: 
45:         if (!wanted) {
46:           drop(entity);
47:           continue;
48:         }
49: 
50:         const bone = model.gltf?.skeleton?.bones[GUILD_FLAG_BONE + 1];
51:         const boneNode = bone?.getTransformNode();
52:         if (!boneNode) {
53:           // The model is still loading; the flag joins it the frame it exists.
54:           drop(entity);
55:           continue;
56:         }
57: 
58:         let flag = flags.get(entity);
59:         if (!flag) {
60:           flag = new GuildFlag(scene);
61:           flags.set(entity, flag);
62:         }
63: 
64:         flag.attach(boneNode);
65:         flag.setMark(logo);
66:         flag.visible = !model.OutOfView;
67:         flag.update(
68:           entity.transform.visualRotY ?? entity.transform.rot.y,
69:           isThunderHawkArmor(entity.charAppearance?.armor)
70:         );
71:       }
72:     },
73:   };
74: };
