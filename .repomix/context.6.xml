109: // ---- 2. state + readers ----------------------------------------------------
110: 
111: export interface ItemAuraOptions {
112:   tier: ItemVisualTier;
113:   kind: ItemAuraKind;
114: }
115: 
116: /** Every aura handed out and not yet disposed - so a map change can end them. */
117: const liveAuras = new Set<ItemAura>();
118: 
119: /** How many auras are running (debug). */
120: export function itemAuraCount(): number {
121:   return liveAuras.size;
122: }
123: 
124: function tint(tier: ItemVisualTier): Color4 {
125:   if (tier.intensity > 0) {
126:     const [r, g, b] = tier.emissive;
127:     return new Color4(r, g, b, 1);
128:   }
129:   // Specials below +7: the shimmer colour alone.
130:   return tier.isAncient ? ANCIENT_TINT.clone() : EXC_TINT.clone();
131: }
132: 
133: function motes(
134:   scene: Scene,
135:   tier: ItemVisualTier,
136:   kind: ItemAuraKind,
137:   emitter: Vector3
138: ): AuraSystem {
139:   const ps = createAuraSystem(scene, 'itemAura', 96 + tier.glow * 48);
140:   ps.emitter = emitter;
141: 
142:   const colour = tint(tier);
143:   const specials = legacyRenderLevel() > 0;
144:   const second =
145:     tier.isExcellent && specials
146:       ? EXC_TINT
147:       : tier.isAncient && specials
148:         ? ANCIENT_TINT
149:         : colour.scale(0.75);
150: 
151:   ps.color1 = colour;
152:   ps.color2 = second;
153:   ps.colorDead = new Color4(colour.r, colour.g, colour.b, 0);
154: 
155:   // Soft in, hold, fade out - flare cards popping in read as noise.
156:   ps.addColorGradient(0, new Color4(colour.r, colour.g, colour.b, 0));
157:   ps.addColorGradient(0.25, colour, second);
158:   ps.addColorGradient(1, new Color4(second.r, second.g, second.b, 0));
159: 
160:   // Motes grow a touch with the tier so +11 reads bigger as well as denser.
161:   const grow = 1 + Math.max(0, tier.glow - 2) * 0.15;
162:   ps.minSize = 0.09 * grow;
163:   ps.maxSize = 0.2 * grow;
164:   ps.minLifeTime = 0.9;
165:   ps.maxLifeTime = 1.6;
166:   ps.emitRate = tier.auraRate;
167: 
168:   if (kind === 'character') {
169:     ps.minEmitBox = new Vector3(-0.22, 0.15, -0.22);
170:     ps.maxEmitBox = new Vector3(0.22, 1.1, 0.22);
171:   } else {
172:     ps.minEmitBox = new Vector3(-0.16, 0.02, -0.16);
173:     ps.maxEmitBox = new Vector3(0.16, 0.3, 0.16);
174:   }
175: 
176:   ps.direction1 = new Vector3(-0.2, 0.6, -0.2);
177:   ps.direction2 = new Vector3(0.2, 1, 0.2);
178:   ps.minEmitPower = 0.12;
179:   ps.maxEmitPower = 0.3;
180:   ps.gravity = new Vector3(0, 0.18, 0);
181:   ps.minAngularSpeed = -0.6;
182:   ps.maxAngularSpeed = 0.6;
183: 
184:   flareWhenLoaded(scene, ps);
185: 
186:   ps.start();
187:   return ps;
188: }
189: 
190: function sparks(
191:   scene: Scene,
192:   tier: ItemVisualTier,
193:   kind: ItemAuraKind,
194:   emitter: Vector3
195: ): AuraSystem {
196:   const ps = createAuraSystem(scene, 'itemSparks', 48 + tier.glow * 24);
197:   ps.emitter = emitter;
198: 
199:   const colour = tint(tier);
200:   const hot = new Color4(
201:     Math.min(1, colour.r + 0.5),
202:     Math.min(1, colour.g + 0.5),
203:     Math.min(1, colour.b + 0.5),
204:     1
205:   );
206: 
207:   ps.color1 = hot;
208:   ps.color2 = colour;
209:   ps.colorDead = new Color4(colour.r, colour.g, colour.b, 0);
210: 
211:   ps.minSize = 0.03;
212:   ps.maxSize = 0.07;
213:   ps.minLifeTime = 0.35;
214:   ps.maxLifeTime = 0.7;
215:   ps.emitRate = Math.round(tier.auraRate * 0.6);
216: 
217:   const top = kind === 'character' ? 1.1 : 0.3;
218:   ps.minEmitBox = new Vector3(-0.18, top * 0.5, -0.18);
219:   ps.maxEmitBox = new Vector3(0.18, top, 0.18);
220: 
221:   ps.direction1 = new Vector3(-1, 0.4, -1);
222:   ps.direction2 = new Vector3(1, 1, 1);
223:   ps.minEmitPower = 0.8;
224:   ps.maxEmitPower = 1.6;
225:   ps.gravity = new Vector3(0, -3, 0);
226: 
227:   flareWhenLoaded(scene, ps);
228: 
229:   ps.start();
230:   return ps;
231: }
232: 
233: /**
234:  * Orbit ring (+9 and up): motes released from a point circling the body at
235:  * waist height, so the wearer is wrapped in a visible band rather than just
236:  * a haze. From +11 a second ring counter-rotates higher up; +13 adds a third.
237:  */
238: function ring(
239:   scene: Scene,
240:   tier: ItemVisualTier,
241:   kind: ItemAuraKind,
242:   emitter: Vector3,
243:   index: number
244: ): AuraSystem {
245:   const ps = createAuraSystem(scene, 'itemRing', 160);
246: 
247:   const colour = tint(tier);
248:   const bright = new Color4(
249:     Math.min(1.5, colour.r * 1.3),
250:     Math.min(1.5, colour.g * 1.3),
251:     Math.min(1.5, colour.b * 1.3),
252:     1
253:   );
254:   ps.color1 = bright;
255:   ps.color2 = colour;
256:   ps.colorDead = new Color4(colour.r, colour.g, colour.b, 0);
257:   ps.addColorGradient(0, bright);
258:   ps.addColorGradient(0.6, colour);
259:   ps.addColorGradient(1, new Color4(colour.r, colour.g, colour.b, 0));
260: 
261:   const scale = kind === 'character' ? 1 : 0.5;
262:   ps.minSize = 0.05 * scale;
263:   ps.maxSize = 0.11 * scale;
264:   ps.minLifeTime = 0.5;
265:   ps.maxLifeTime = 0.9;
266:   ps.emitRate = 40 + tier.glow * 10;
267:   ps.minEmitPower = 0;
268:   ps.maxEmitPower = 0.05;
269:   ps.direction1 = new Vector3(0, 0.3, 0);
270:   ps.direction2 = new Vector3(0, 0.6, 0);
271:   ps.gravity = new Vector3(0, 0.1, 0);
272: 
273:   // The emitter point itself orbits; the particles it leaves behind trail
274:   // into a band. Each ring has its own radius, height, speed and direction.
275:   const radius = (0.32 + index * 0.06) * scale;
276:   const height = (0.45 + index * 0.3) * scale;
277:   const speed = (3.2 + index * 0.8) * (index % 2 === 0 ? 1 : -1);
278:   const phase = (index * Math.PI * 2) / 3;
279:   const point = new Vector3();
280:   ps.emitter = point;
281: 
282:   const observer = scene.onBeforeRenderObservable.add(() => {
283:     const t = itemGlowClock() * speed + phase;
284:     // Slight bob so the band is not a flat disc.
285:     const bob = Math.sin(t * 0.7) * 0.06 * scale;
286:     point.set(
287:       emitter.x + Math.cos(t) * radius,
288:       emitter.y + height + bob,
289:       emitter.z + Math.sin(t) * radius
290:     );
291:   });
292: 
293:   flareWhenLoaded(scene, ps);
294: 
295:   ps.onDisposeObservable.add(() => {
296:     scene.onBeforeRenderObservable.remove(observer);
297:   });
298: 
299:   ps.start();
300:   return ps;
301: }
302: 
303: /** Creates the aura for `tier` at `x,y,z`; move it through `emitter`. */
304: export function createItemAura(
305:   scene: Scene,
306:   tier: ItemVisualTier,
307:   kind: ItemAuraKind,
308:   x: number,
309:   y: number,
310:   z: number
311: ): ItemAura | null {
312:   if (tier.auraRate <= 0) return null;
313: 
314:   const emitter = new Vector3(x, y, z);
315:   const systems: AuraSystem[] = [motes(scene, tier, kind, emitter)];
316: 
317:   if (tier.sparks) systems.push(sparks(scene, tier, kind, emitter));
318: 
319:   // Orbit rings: one from +9, two from +11, three from +13.
320:   const rings = tier.glow >= 2 ? tier.glow - 1 : 0;
321:   for (let i = 0; i < rings; i++)
322:     systems.push(ring(scene, tier, kind, emitter, i));
323: 
324:   let alive = true;
325:   const aura: ItemAura = {
326:     emitter,
327:     get alive() {
328:       return alive;
329:     },
330:     stop() {
331:       this.dispose();
332:     },
333:     dispose: () => {
334:       if (!alive) return;
335:       alive = false;
336:       liveAuras.delete(aura);
337:       // `dispose()` defaults to disposing `particleTexture` as well, and every
338:       // aura in the game shares one cached flare01 (loadEffectTexture). The
339:       // first drop picked up or wearer walking out of range would otherwise
340:       // destroy that texture for everyone, and the cache would keep handing
341:       // out the dead handle - every mote, spark and ring gone for the session.
342:       for (const ps of systems) ps.dispose(false);
343:       systems.length = 0;
344:     },
345:   };
346:   liveAuras.add(aura);
347:   return aura;
348: }
349: 
350: function spawn(scene: Scene, at: Vector3, opts: ItemAuraOptions): EffectHandle {
351:   return createItemAura(scene, opts.tier, opts.kind, at.x, at.y, at.z) ?? DEAD_HANDLE;
352: }
353: 
354: function reset(): void {
355:   for (const aura of Array.from(liveAuras)) aura.dispose();
356:   liveAuras.clear();
357: }
358: 
359: // ---- 3. the layer ----------------------------------------------------------
360: 
361: /** No update: the particle systems step themselves; the emitter is moved by itemGlowSystem. */
362: export const itemAuraLayer: EffectLayer<ItemAuraOptions, 'itemAura'> = {
363:   name: 'itemAura',
364:   reset,
365:   spawn,
366: };
</file>

<file path="src/effects/itemCrackle.ts">
  1: import {
  2:   Color3,
  3:   Constants,
  4:   CreateGreasedLine,
  5:   GreasedLineMeshMaterialType,
  6:   type GreasedLineMesh,
  7:   type GreasedLineSimpleMaterial,
  8:   type Scene,
  9:   Vector3,
 10: } from '../libs/babylon/exports';
 11: import type { ItemVisualTier } from '../common/itemVisualTier';
 12: import type { TestScene } from '../scenes/testScene';
 13: import { releaseGreasedLineMaterial } from './greasedLineRelease';
 14: import type { ItemAuraKind } from './itemAura';
 15: import { DEAD_HANDLE, type EffectHandle, type EffectLayer } from './layer';
 16: 
 17: /**
 18:  * Energy crackle (improved look, +9 and up): short lightning arcs that flash
 19:  * over the body in the item's colour - a few times a second, each living a
 20:  * handful of frames, jittering while alive.
 21:  *
 22:  * One GreasedLine mesh per wearer with a fixed topology (bolts × segments
 23:  * per glow tier, plus a fork slot per bolt),
 24:  * re-pointed in place; inactive bolts are parked far below the map. The mesh
 25:  * is registered with the GlowLayer to render with its own material, so the
 26:  * arcs bloom in the same colour as the armour's halo.
 27:  *
 28:  * Driven by: `createItemCrackle` from `ecs/systems/itemGlowSystem.ts`, or
 29:  * `effects.spawn('itemCrackle', …)`. Read by: nobody.
 30:  */
 31: 
 32: // ---- 1. tuning -------------------------------------------------------------
 33: 
 34: /**
 35:  * Per glow tier (itemVisualTier.glow 2–4): how many arcs may live at once,
 36:  * how many segments each has, their width (tile units, no size attenuation),
 37:  * and the chance an arc grows a fork off its middle. Higher tiers are denser
 38:  * and jaggier, so +9, +11 and +13 look different before the spawn rate is
 39:  * even considered.
 40:  */
 41: type CrackleShape = {
 42:   bolts: number;
 43:   segments: number;
 44:   width: number;
 45:   fork: number;
 46: };
 47: 
 48: const SHAPES: Record<number, CrackleShape> = {
 49:   2: { bolts: 6, segments: 8, width: 0.022, fork: 0 },
 50:   3: { bolts: 10, segments: 10, width: 0.028, fork: 0.5 },
 51:   4: { bolts: 14, segments: 12, width: 0.034, fork: 0.8 },
 52: };
 53: 
 54: /** Fork length as a fraction of the parent arc. */
 55: const FORK_LEN = 0.55;
 56: 
 57: const BOLT_LIFE_MIN = 0.08;
 58: const BOLT_LIFE_MAX = 0.2;
 59: 
 60: /** Arc length over the body (fraction of the body radius), and jitter. */
 61: const ARC_MIN = 0.9;
 62: const ARC_MAX = 1.9;
 63: const JITTER = 0.05;
 64: 
 65: const PARKED_Y = -1000;
 66: 
 67: type Body = {
 68:   radius: number;
 69:   bottom: number;
 70:   top: number;
 71: };
 72: 
 73: const BODIES: Record<ItemAuraKind, Body> = {
 74:   character: { radius: 0.27, bottom: 0.2, top: 1.15 },
 75:   drop: { radius: 0.17, bottom: 0.02, top: 0.28 },
 76: };
 77: 
 78: type Bolt = {
 79:   age: number;
 80:   life: number;
 81:   from: Vector3;
 82:   to: Vector3;
 83:   /** Fork off the middle of this arc (a second line slot), or none. */
 84:   forked: boolean;
 85:   forkTo: Vector3;
 86: };
 87: 
 88: // ---- 2. state + readers ----------------------------------------------------
 89: 
 90: export type ItemCrackle = EffectHandle & {
 91:   readonly position: Vector3;
 92:   /** Same as `stop()`; the name itemGlowSystem has always used. */
 93:   dispose(): void;
 94: };
 95: 
 96: export interface ItemCrackleOptions {
 97:   tier: ItemVisualTier;
 98:   kind: ItemAuraKind;
 99: }
100: 
101: /** Every crackle handed out and not yet disposed - so a map change can end them. */
102: const liveCrackles = new Set<ItemCrackle>();
103: 
104: /** How many crackles are running (debug). */
105: export function itemCrackleCount(): number {
106:   return liveCrackles.size;
107: }
108: 
109: const rand = (a: number, b: number) => a + Math.random() * (b - a);
110: 
111: /** Random point on the body's cylinder surface (local space). */
112: function surfacePoint(body: Body, out: Vector3): Vector3 {
113:   const angle = Math.random() * Math.PI * 2;
114:   out.set(
115:     Math.cos(angle) * body.radius,
116:     rand(body.bottom, body.top),
117:     Math.sin(angle) * body.radius
118:   );
119:   return out;
120: }
121: 
122: /** Push `p` back onto the body cylinder (keeps arcs hugging the surface). */
123: function toSurface(body: Body, p: Vector3): void {
124:   const d = Math.hypot(p.x, p.z) || 1;
125:   const k = body.radius / d;
126:   p.x *= k;
127:   p.z *= k;
128:   p.y = Math.min(body.top, Math.max(body.bottom, p.y));
129: }
130: 
131: export function createItemCrackle(
132:   scene: Scene,
133:   tier: ItemVisualTier,
134:   kind: ItemAuraKind,
135:   x: number,
136:   y: number,
137:   z: number
138: ): ItemCrackle | null {
139:   if (tier.crackleRate <= 0) return null;
140: 
141:   const body = BODIES[kind];
142:   const position = new Vector3(x, y, z);
143:   const shapeOf = SHAPES[tier.glow] ?? SHAPES[2];
144:   const BOLTS = shapeOf.bolts;
145:   const SEGMENTS = shapeOf.segments;
146:   const WIDTH = shapeOf.width;
147: 
148:   // Flat xyz arrays - one per bolt, then one fork slot per bolt - the shape
149:   // GreasedLine rebuilds fastest. Line b is bolt b; line BOLTS + b its fork.
150:   const lines: number[][] = [];
151:   const bolts: Bolt[] = [];
152: 
153:   for (let b = 0; b < BOLTS * 2; b++) {
154:     const points: number[] = [];
155:     for (let s = 0; s <= SEGMENTS; s++) points.push(0, PARKED_Y, 0);
156:     lines.push(points);
157:   }
158:   for (let b = 0; b < BOLTS; b++) {
159:     bolts.push({
160:       age: 0,
161:       life: 0,
162:       from: new Vector3(),
163:       to: new Vector3(),
164:       forked: false,
165:       forkTo: new Vector3(),
166:     });
167:   }
168: 
169:   const [r, g, bl] = tier.emissive;
170:   const colour = new Color3(r, g, bl);
171: 
172:   const mesh = CreateGreasedLine(
173:     'itemCrackle',
174:     { points: lines, updatable: true },
175:     {
176:       color: colour,
177:       width: WIDTH,
178:       sizeAttenuation: false,
179:       materialType: GreasedLineMeshMaterialType.MATERIAL_TYPE_SIMPLE,
180:     },
181:     scene
182:   ) as GreasedLineMesh;
183: 
184:   mesh.isPickable = false;
185:   mesh.doNotSyncBoundingInfo = true;
186:   mesh.alwaysSelectAsActiveMesh = true;
187:   mesh.metadata = { itemTier: tier, itemCrackle: true };
188: 
189:   const material = mesh.material as GreasedLineSimpleMaterial | null;
190: 
191:   if (material) {
192:     // Additive over the armour, never into the depth buffer.
193:     material.alpha = 0.99;
194:     material.alphaMode = Constants.ALPHA_ADD;
195:     material.disableDepthWrite = true;
196:     material.backFaceCulling = false;
197:   }
198: 
199:   (scene as TestScene).look?.glow.referenceMeshToUseItsOwnMaterial(mesh);
200: 
201:   const tmp = new Vector3();
202: 
203:   function spawn(bolt: Bolt): void {
204:     bolt.age = 0;
205:     bolt.life = rand(BOLT_LIFE_MIN, BOLT_LIFE_MAX);
206:     surfacePoint(body, bolt.from);
207: 
208:     // End point: a step around / along the surface from the start.
209:     const len = body.radius * rand(ARC_MIN, ARC_MAX);
210:     const dir = Math.random() * Math.PI * 2;
211:     bolt.to.set(
212:       bolt.from.x + Math.cos(dir) * len,
213:       bolt.from.y + rand(-len, len),
214:       bolt.from.z + Math.sin(dir) * len
215:     );
216:     toSurface(body, bolt.to);
217: 
218:     // Fork: a shorter branch leaving the middle of the arc sideways.
219:     bolt.forked = Math.random() < shapeOf.fork;
220:     if (bolt.forked) {
221:       const fdir = dir + (Math.random() < 0.5 ? 1 : -1) * rand(0.9, 2.0);
222:       const flen = len * FORK_LEN;
223:       bolt.forkTo.set(
224:         (bolt.from.x + bolt.to.x) * 0.5 + Math.cos(fdir) * flen,
225:         (bolt.from.y + bolt.to.y) * 0.5 + rand(-flen, flen),
226:         (bolt.from.z + bolt.to.z) * 0.5 + Math.sin(fdir) * flen
227:       );
228:       toSurface(body, bolt.forkTo);
229:     }
230:   }
231: 
232:   const mid = new Vector3();
233: 
234:   /** Re-points bolt b (and its fork slot) for its current state. */
235:   function shapeBolt(b: number, active: boolean): void {
236:     const bolt = bolts[b];
237:     shape(bolt.from, bolt.to, lines[b], active);
238:     const fork = active && bolt.forked;
239:     if (fork) Vector3.LerpToRef(bolt.from, bolt.to, 0.5, mid);
240:     shape(mid, bolt.forkTo, lines[BOLTS + b], fork);
241:   }
242: 
243:   function shape(
244:     from: Vector3,
245:     to: Vector3,
246:     points: number[],
247:     active: boolean
248:   ): void {
249:     if (!active) {
250:       for (let i = 0; i < points.length; i += 3) {
251:         points[i] = 0;
252:         points[i + 1] = PARKED_Y;
253:         points[i + 2] = 0;
254:       }
255:       return;
256:     }
257: 
258:     for (let s = 0; s <= SEGMENTS; s++) {
259:       const t = s / SEGMENTS;
260:       Vector3.LerpToRef(from, to, t, tmp);
261: 
262:       if (s > 0 && s < SEGMENTS) {
263:         // Jitter grows towards the middle of the arc, and pushes outward a
264:         // touch so the bolt sits just off the skin.
265:         const k = Math.sin(t * Math.PI);
266:         tmp.x += rand(-JITTER, JITTER) * k;
267:         tmp.y += rand(-JITTER, JITTER) * k;
268:         tmp.z += rand(-JITTER, JITTER) * k;
269:         const d = Math.hypot(tmp.x, tmp.z) || 1;
270:         const push = (body.radius * (1 + 0.1 * k)) / d;
271:         tmp.x *= push;
272:         tmp.z *= push;
273:       }
274: 
275:       const i = s * 3;
276:       points[i] = tmp.x + position.x;
277:       points[i + 1] = tmp.y + position.y;
278:       points[i + 2] = tmp.z + position.z;
279:     }
280:   }
281: 
282:   const observer = scene.onBeforeRenderObservable.add(() => {
283:     const dt = scene.getEngine().getDeltaTime() / 1000;
284:     let dirty = false;
285: 
286:     // Poisson-ish spawning at crackleRate arcs per second, into free slots.
287:     // Expected crackleRate * dt arcs this frame: whole part plus a roll on
288:     // the fraction, so high rates are not capped at two a frame.
289:     const expect = tier.crackleRate * dt;
290:     let spawns = Math.floor(expect);
291:     if (Math.random() < expect - spawns) spawns++;
292: 
293:     for (let b = 0; b < BOLTS; b++) {
294:       const bolt = bolts[b];
295:       const wasActive = bolt.age < bolt.life;
296: 
297:       if (wasActive) {
298:         bolt.age += dt;
299:         shapeBolt(b, bolt.age < bolt.life);
300:         dirty = true;
301:       } else if (spawns > 0) {
302:         spawns--;
303:         spawn(bolt);
304:         shapeBolt(b, true);
305:         dirty = true;
306:       }
307:     }
308: 
309:     if (!dirty) return;
310: 
311:     mesh.setPoints(lines);
312: 
313:     // Flicker: arcs read as energy when their brightness isn't steady.
314:     if (material) material.visibility = rand(0.55, 1);
315:   });
316: 
317:   let alive = true;
318:   const crackle: ItemCrackle = {
319:     position,
320:     get alive() {
321:       return alive;
322:     },
323:     stop() {
324:       this.dispose();
325:     },
326:     dispose: () => {
327:       if (!alive) return;
328:       alive = false;
329:       liveCrackles.delete(crackle);
330:       scene.onBeforeRenderObservable.remove(observer);
331:       (scene as TestScene).look?.glow.unReferenceMeshFromUsingItsOwnMaterial(
332:         mesh
333:       );
334:       // The shared empty-colours texture must survive this - see greasedLineRelease.ts.
335:       releaseGreasedLineMaterial(mesh);
336:       mesh.dispose();
337:     },
338:   };
339:   liveCrackles.add(crackle);
340:   return crackle;
341: }
342: 
343: function spawn(scene: Scene, at: Vector3, opts: ItemCrackleOptions): EffectHandle {
344:   return createItemCrackle(scene, opts.tier, opts.kind, at.x, at.y, at.z) ?? DEAD_HANDLE;
345: }
346: 
347: function reset(): void {
348:   for (const c of Array.from(liveCrackles)) c.dispose();
349:   liveCrackles.clear();
350: }
351: 
352: // ---- 3. the layer ----------------------------------------------------------
353: 
354: /** No update: each crackle steps itself from a render observer. */
355: export const itemCrackleLayer: EffectLayer<ItemCrackleOptions, 'itemCrackle'> = {
356:   name: 'itemCrackle',
357:   reset,
358:   spawn,
359: };
</file>

<file path="src/effects/itemSparkle.ts">
  1: /**
  2:  * Item sparkle - the infrequent star glints an excellent item throws from
  3:  * random points of its surface. The original's `CreateShiny`
  4:  * (ZzzObject.cpp:6223, called from `MoveItems` :6268): every 48th tick two
  5:  * `BITMAP_SHINY` particles at a point 16–48 cm out and 16–48 cm up from the
  6:  * object, turned by its yaw. On a worn item the point is on the body instead.
  7:  *
  8:  * One counter per live sparkle; the glints themselves are pooled through the
  9:  * shared `SHINY_GLINT` particle system, so a square of excellent drops costs
 10:  * one draw and no allocation.
 11:  *
 12:  * Driven by: `effects.spawn('itemSparkle', …)` from
 13:  * `ecs/systems/itemGlowSystem.ts` (excellent drops and wearers). Read by: nobody.
 14:  */
 15: import { Vector3, type Scene } from '../libs/babylon/exports';
 16: import { LiveList, TICK, emitBurst, pointSource, type PointSource } from './core';
 17: import { SHINY_GLINT } from './recipes';
 18: import type { EffectHandle, EffectLayer } from './layer';
 19: 
 20: // ---- 1. tuning -------------------------------------------------------------
 21: 
 22: /** `o->SubType++ % 48 == 0`: one burst every 48 ticks. */
 23: const PERIOD_SECONDS = 48 * TICK;
 24: 
 25: /** Two particles a burst (SubType 0 and 1). */
 26: const PER_BURST = 2;
 27: 
 28: /** `rand() % 32 + 16` cm: how far out / up from a drop the glint sits. */
 29: const DROP_OFFSET_MIN = 0.16;
 30: const DROP_OFFSET_MAX = 0.48;
 31: 
 32: /** A wearer's body: the cylinder the glint is placed on (itemCrackle's). */
 33: const BODY_RADIUS = 0.27;
 34: const BODY_BOTTOM = 0.2;
 35: const BODY_TOP = 1.15;
 36: 
 37: // ---- 2. state + readers ----------------------------------------------------
 38: 
 39: export type ItemSparkleKind = 'character' | 'drop';
 40: 
 41: export interface ItemSparkleOptions {
 42:   kind: ItemSparkleKind;
 43:   /** The item's position; a wearer moves, a drop falls in. */
 44:   follow?: PointSource;
 45:   /** The drop's yaw, radians (MU convention): the offset is turned by it. */
 46:   yaw?: () => number;
 47:   /** Ends when true (the wearer left, the drop was picked up). */
 48:   until?: () => boolean;
 49: }
 50: 
 51: const live = new LiveList();
 52: 
 53: /** How many sparkles are ticking (debug). */
 54: export function itemSparkleCount(): number {
 55:   return live.size;
 56: }
 57: 
 58: const tmp = new Vector3();
 59: 
 60: function spawn(scene: Scene, at: Vector3, opts: ItemSparkleOptions): EffectHandle {
 61:   const source = opts.follow ?? pointSource(at);
 62:   // A random phase so a pile of drops does not glint in unison.
 63:   let countdown = Math.random() * PERIOD_SECONDS;
 64:   return live.push({
 65:     update(dt) {
 66:       if (opts.until?.()) return false;
 67:       countdown -= dt;
 68:       if (countdown > 0) return true;
 69:       countdown += PERIOD_SECONDS;
 70: 
 71:       source(tmp);
 72:       if (opts.kind === 'drop') {
 73:         const out = DROP_OFFSET_MIN + Math.random() * (DROP_OFFSET_MAX - DROP_OFFSET_MIN);
 74:         const up = DROP_OFFSET_MIN + Math.random() * (DROP_OFFSET_MAX - DROP_OFFSET_MIN);
 75:         const yaw = opts.yaw?.() ?? 0;
 76:         tmp.x += Math.sin(yaw) * out;
 77:         tmp.z += Math.cos(yaw) * out;
 78:         tmp.y += up;
 79:       } else {
 80:         const angle = Math.random() * Math.PI * 2;
 81:         tmp.x += Math.cos(angle) * BODY_RADIUS;
 82:         tmp.z += Math.sin(angle) * BODY_RADIUS;
 83:         tmp.y += BODY_BOTTOM + Math.random() * (BODY_TOP - BODY_BOTTOM);
 84:       }
 85:       emitBurst(scene, SHINY_GLINT, tmp, PER_BURST);
 86:       return true;
 87:     },
 88:     release() {},
 89:   });
 90: }
 91: 
 92: function update(_map: number, dt: number): void {
 93:   live.update(dt);
 94: }
 95: 
 96: function reset(): void {
 97:   live.clear();
 98: }
 99: 
100: // ---- 3. the layer ----------------------------------------------------------
101: 
102: export const itemSparkleLayer: EffectLayer<ItemSparkleOptions, 'itemSparkle'> = {
103:   name: 'itemSparkle',
104:   update,
105:   reset,
106:   spawn,
107: };
</file>

