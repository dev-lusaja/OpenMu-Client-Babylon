 83:    * them read as a lunge instead of a swing on the spot.
 84:    */
 85:   let pendingStep: {
 86:     clip: PlayerAction;
 87:     to: { x: number; y: number };
 88:     /** Seconds left to see the clip reach its key before the step is dropped. */
