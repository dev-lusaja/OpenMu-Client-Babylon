135: /** World position of an entity at `height` tiles above its feet. */
136: export function entityPos(e: Entity, height: number, out: Vector3): Vector3 {
137:   const t = e.transform;
138:   if (!t) return out.set(0, height, 0);
139:   const off = t.posOffset ?? ZERO_OFF;
140:   return out.set(t.pos.x + off.x, t.pos.y + height, t.pos.z + off.z);
141: }
