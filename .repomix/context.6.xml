239:   /** The attackable object nearest to (x, y), within `radius` tiles of it. */
240:   function nearestAttackable(x: number, y: number, radius: number): Entity | null {
241:     let best: Entity | null = null;
242:     let bestD = radius * radius;
243:     for (const e of world.netObjsQuery.entities) {
244:       if (!isAttackableEntity(world, e)) continue;
245:       const dx = e.transform!.pos.x - x;
246:       const dz = e.transform!.pos.z - y;
247:       const d = dx * dx + dz * dz;
248:       if (d <= bestD) {
249:         bestD = d;
250:         best = e;
251:       }
252:     }
253:     return best;
254:   }
