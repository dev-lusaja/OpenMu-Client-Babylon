 99: /** Charon's window: whether it is up and its seven buttons. */
100: export function devilSquareWindow(): {
101:   open: boolean;
102:   buttons: EntryButton[];
103:   active: number;
104: } {
105:   return { open: state.open, buttons: state.buttons, active: state.active };
106: }
