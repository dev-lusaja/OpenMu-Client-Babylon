  1: /**
  2:  * Model - a skill mesh from Data/Skill (the original's `MODEL_*` effects:
  3:  * MODEL_FIRE, MODEL_ICE, MODEL_POISON, MODEL_MAGIC_CIRCLE…) placed at a
  4:  * point, drawn bright/additive with its own animation, scaled and turned
  5:  * over its life, then dropped. `CreateEffect(MODEL_*, …)` + the per-model
  6:  * `MoveEffect` / `RenderEffect` branches (ZzzEffect.cpp).
  7:  *
  8:  * Loading is asynchronous through the shared GLB container cache
  9:  * (`common/modelLoader.ts`, read-only use); the mesh appears when it has
 10:  * decoded, if the effect is still alive, and a second spawn of the same
 11:  * model is a clone. A spawn can `follow` a moving point (a projectile) and be
 12:  * turned with `yawTo` by whoever moves it.
 13:  *
 14:  * Driven by: `effects.spawn('model', …)`, `projectile.ts`. Read by: nobody.
 15:  */
 16: import {
 17:   Constants,
 18:   Material,
 19:   Quaternion,
 20:   StandardMaterial,
 21:   TransformNode,
 22:   Vector3,
 23:   type AbstractMesh,
 24:   type AnimationGroup,
 25:   type Scene,
 26:   type Texture,
 27: } from '../libs/babylon/exports';
 28: import { getMaterial, loadGLTF } from '../common/modelLoader';
 29: import { BlendState } from '../common/objects/enum';
 30: import { Store } from '../store';
 31: import type { TestScene } from '../scenes/testScene';
 32: import { LiveList, additiveMaterial, darkCardGain, fadeOut, lerp, luma, pointSource, type EffectBlend, type PointSource, type RGB } from './core';
 33: import { addEffectGlow, releaseEffectGlow } from './glow';
 34: import { RGBS } from './recipes';
 35: import type { EffectHandle, EffectLayer } from './layer';
 36: 
 37: // ---- 1. tuning -------------------------------------------------------------
 38: 
 39: /** Lifetime when none is given: 30 ticks. */
 40: const DEFAULT_SECONDS = 1.2;
 41: 
 42: /**
 43:  * The GLB converter already scales BMD centimetres to tiles, so `scale` 1 is
 44:  * the model's native size - `CreateEffect`'s `Scale` default (ZzzEffect.cpp:332;
 45:  * MODEL_FIRE rolls 1.0–1.7, MODEL_POISON 1.0, MODEL_ICE 0.8). The move-target
 46:  * pin's 0.6 is its own (moveTargetEffect.ts) and used to leak in here, drawing
 47:  * every skill mesh at 60 % .
 48:  */
 49: const DEFAULT_SCALE = 1;
 50: 
 51: /** The BMD clip runs at ~24 fps in the original's `AnimationSpeed` terms. */
 52: const ANIMATION_SPEED = (0.3 * 25) / 24;
 53: 
 54: // ---- 2. state + readers ----------------------------------------------------
 55: 
 56: export interface ModelOptions {
 57:   /** `Skill/…glb` or `Effect/…glb` (recipes.ts `MODEL`). */
 58:   model: string;
 59:   seconds?: number;
 60:   /** The original's `Scale`: 1 = the model's native size. */
 61:   scale?: number;
 62:   /** Scale multiplier at end of life. */
 63:   grow?: number;
 64:   /** Tint (`bodyLight`). */
 65:   colour?: RGB;
 66:   /** Radians/s around the up axis. */
 67:   spin?: number;
 68:   /** Tiles/s upward. */
 69:   rise?: number;
 70:   /** Initial yaw, radians. */
 71:   yaw?: number;
 72:   /** Lay the model flat on the ground (rings, circles). Default: upright like a character. */
 73:   flat?: boolean;
 74:   follow?: PointSource;
 75:   height?: number;
 76:   /** Loop the clip (default) or play it once. */
 77:   loop?: boolean;
 78:   /** Fade tail fraction (visibility). */
 79:   fadeTail?: number;
 80:   /** Peak visibility 0…1 (the original's `Alpha`; TwistingSlash's wheels are 0.6 → 0.3). */
 81:   alpha?: number;
 82:   /** Visibility ramps up from 0 over this fraction of life (`Alpha 0→` effects). */
 83:   fadeIn?: number;
 84:   /**
 85:    * The original's `o->BlendMesh`: only this mesh (BMD order) is drawn
 86:    * bright/additive; every other mesh is an opaque textured surface
 87:    * (ZzzBMD.cpp `RenderMesh`, RENDER_TEXTURE → `DisableAlphaBlend`) -
 88:    * MODEL_FIRE's lava core under its additive tail. Default: every mesh bright.
 89:    */
 90:   blendMesh?: number;
 91:   /**
 92:    * `add` (default) is the bright meshes' usual look; `subtract` is
 93:    * `RENDER_DARK` - `EnableAlphaBlendMinus`, `dst × (1 − src)`
 94:    * (ZzzBMD.cpp:1606) - the dark spirit stamps of Evil Spirit's MODEL_LASER.
 95:    */
 96:   blend?: EffectBlend;
 97:   /** Yaw follows the direction `follow` moves the node (the original re-stamps along the joint's `Angle`). */
 98:   aim?: boolean;
 99:   /**
100:    * Let the mesh into the sun cascades. Off by default: an effect mesh is
101:    * light, not matter, and `scenes/shadows.ts castsSunShadow` drops every
102:    * bright mesh for that reason. A spirit is the exception the wings already
103:    * are (`shadowBlendCaster`) - the card *is* the body, so it should throw a
104:    * shadow as it goes over the ground. The shadow layer still decides whether
105:    * the tier runs cascades at all.
106:    */
107:   shadow?: boolean;
108: }
109: 
110: export interface ModelHandle extends EffectHandle {
111:   /** Point the model's nose along `dir` (a flying arrow). */
112:   yawTo(dir: Vector3): void;
113:   /** Tilt the model `rad` about its side axis (a tumbling stone; `o->Angle[0]`). */
114:   pitchTo(rad: number): void;
115: }
116: 
117: const live = new LiveList();
118: 
119: /** How many model effects are up (debug). */
120: export function modelCount(): number {
121:   return live.size;
122: }
123: 
124: const tmp = new Vector3();
125: const UPRIGHT = Quaternion.FromEulerAngles(-Math.PI / 2, 0, 0);
126: const FLAT = Quaternion.FromEulerAngles(0, 0, 0);
127: 
128: /**
129:  * `RENDER_DARK`'s mesh material (ZzzBMD.cpp:1606). Owned by the spawn, never
130:  * core.ts's shared cache: the fade lives on the material and a cache entry is
131:  * shared.
132:  *
133:  * Drawn as black under `(SRC_ALPHA, ONE_MINUS_SRC_ALPHA)` with the sheet as
134:  * the coverage, not as `(ZERO, ONE_MINUS_SRC_COLOR)` with the sheet as the
135:  * colour. For the greyscale `Light` the original gives these
136:  * (ZzzEffectJoint.cpp:3773) the two are the same arithmetic - `dst x (1 - t)`
137:  * either way - but the subtract route caps at the sheet's own levels:
138:  * `clamp(diffuseBase x diffuseColor + emissiveColor, 0, 1) x texel` means the
139:  * emissive can never push the source past the texel, and the Laser01 sheet
140:  * averages 0.34. Coverage has no such cap (`alpha = material.alpha x
141:  * luminance(sheet)`), so `darkCardGain` can saturate the silhouette on the
142:  * graded tiers, where a partial subtraction is flattened by the tone curve.
143:  */
144: function subtractMaterial(scene: Scene, tex: Texture, owned: StandardMaterial[]): StandardMaterial {
145:   const mat = new StandardMaterial('fxModelMinus', scene);
146:   mat.diffuseColor.set(0, 0, 0);
147:   mat.specularColor.set(0, 0, 0);
148:   mat.ambientColor.set(0, 0, 0);
149:   mat.emissiveColor.set(0, 0, 0);
150:   mat.disableLighting = true;
151:   mat.alphaMode = Constants.ALPHA_COMBINE;
152:   mat.transparencyMode = Material.MATERIAL_ALPHABLEND;
153:   mat.backFaceCulling = false;
154:   mat.disableDepthWrite = true;
155:   mat.fogEnabled = false;
156:   mat.opacityTexture = tex;
157:   mat.opacityTexture.getAlphaFromRGB = true;
158:   owned.push(mat);
159:   return mat;
160: }
161: 
162: /** Spawn helper other entries call directly (projectile heads). */
163: export function spawnModel(scene: Scene, at: Vector3, opts: ModelOptions): ModelHandle {
164:   const world = Store.world;
165:   const seconds = opts.seconds ?? DEFAULT_SECONDS;
166:   const scale = (opts.scale ?? 1) * DEFAULT_SCALE;
167:   const grow = opts.grow ?? 1;
168:   const spin = opts.spin ?? 0;
169:   const rise = opts.rise ?? 0;
170:   const height = opts.height ?? 0;
171:   const tail = opts.fadeTail ?? 0.25;
172:   const alpha = opts.alpha ?? 1;
173:   const fadeIn = opts.fadeIn ?? 0;
174:   const source = opts.follow ?? pointSource(at);
175:   const colour = opts.colour ?? RGBS.white;
176:   const subtract = opts.blend === 'subtract';
177:   // The original's greyscale `Light` is the coverage a RENDER_DARK stamp takes out; the map's
178:   // level scales it so the silhouette saturates on a scene-referred buffer (core.ts).
179:   const cover = subtract ? luma(colour) * darkCardGain(scene) : 0;
180: 
181:   const node = new TransformNode('fxModel', scene);
182:   node.rotationQuaternion = null;
183:   node.rotation.y = opts.yaw ?? 0;
184:   node.scaling.setAll(scale);
185:   if (world) node.setParent(world.mapParent);
186:   source(tmp);
187:   node.position.set(tmp.x, tmp.y + height, tmp.z);
188:   let prevX = tmp.x;
189:   let prevZ = tmp.z;
190: 
191:   let meshes: AbstractMesh[] = [];
192:   const fadeMats: StandardMaterial[] = [];
193:   let clip: AnimationGroup | null = null;
194:   let disposed = false;
195:   let t = 0;
196: 
197:   if (world) {
198:     void loadGLTF(opts.model, world)
199:       .then(gltf => {
200:         if (disposed) {
201:           gltf.mesh.dispose(false, false);
202:           return;
203:         }
204:         gltf.mesh.setParent(node);
205:         gltf.mesh.position.setAll(0);
206:         gltf.mesh.scaling.set(1, -1, 1);
207:         gltf.mesh.rotationQuaternion = (opts.flat ? FLAT : UPRIGHT).clone();
208:         const bodyLight = new Vector3(colour[0], colour[1], colour[2]);
209:         // The lighting lane's shared bright material, for a mesh whose
210:         // texture did not come through the GLB cache (never disposed here).
211:         const brightFallback = getMaterial(scene, false, Material.MATERIAL_ALPHABLEND, BlendState.ALPHA_ONEOE, true);
212:         // Unlit, opaque, texture × body light - `glColor3fv(BodyLight)` with lighting off.
213:         const solid =
214:           opts.blendMesh === undefined
215:             ? null
216:             : getMaterial(scene, true, Material.MATERIAL_OPAQUE, BlendState.ALPHA_DISABLE, false, true);
217:         // The converter names nodes in BMD mesh order (node_0, node_1…).
218:         meshes = gltf.mesh.getChildMeshes(false).sort((a, b) => a.name.localeCompare(b.name));
219:         meshes.forEach((mesh, i) => {
220:           const isBright = !solid || i === opts.blendMesh;
221:           mesh.metadata ??= {};
222:           mesh.metadata.bodyLight = bodyLight;
223:           mesh.metadata.brightMesh = isBright;
224:           if (opts.shadow) {
225:             mesh.metadata.csmCaster = true;
226:             mesh.metadata.shadowBlendCaster = true;
227:           }
228:           mesh.isPickable = false;
229:           mesh.alwaysSelectAsActiveMesh = true;
230:           // A bright mesh takes the effects' own additive material - the
231:           // sheet × `colour` under (SRC_ALPHA, ONE) - so `visibility` is the
232:           // original's `Alpha` and the tint is its `Light`. Cached per
233:           // (texture, colour) in core.ts; the texture stays the GLB cache's.
234:           const tex = mesh.metadata.diffuseTexture as Texture | undefined;
235:           mesh.material = isBright
236:             ? tex
237:               ? subtract
238:                 ? subtractMaterial(scene, tex, fadeMats)
239:                 : additiveMaterial(scene, tex, colour)
240:               : brightFallback
241:             : solid;
242:           (scene as TestScene).look?.glow.addExcludedMesh(mesh as never);
243:           // Emissive skill art blooms; the opaque body of a blend-mesh model
244:           // and a subtractive one do not (glow.ts).
245:           if (isBright && !subtract) addEffectGlow(scene, mesh);
246:         });
247:         clip = gltf.animationGroups[0] ?? null;
248:         if (clip) {
249:           clip.speedRatio = ANIMATION_SPEED;
250:           clip.play(opts.loop ?? true);
251:         }
252:         meshes.push(gltf.mesh);
253:       })
254:       .catch(err => console.warn('[effects] model failed', opts.model, err));
255:   }
256: 
257:   const handle = live.push({
258:     update(dt) {
259:       t += dt;
260:       const p = t / seconds;
261:       if (p >= 1) return false;
262:       source(tmp);
263:       node.position.set(tmp.x, tmp.y + height + rise * t, tmp.z);
264:       node.scaling.setAll(scale * lerp(1, grow, p));
265:       if (spin) node.rotation.y += spin * dt;
266:       if (opts.aim) {
267:         const dx = tmp.x - prevX;
268:         const dz = tmp.z - prevZ;
269:         if (dx * dx + dz * dz > 1e-8) node.rotation.y = Math.atan2(dx, dz);
270:         prevX = tmp.x;
271:         prevZ = tmp.z;
272:       }
273:       const vis = fadeOut(p, tail) * alpha * (fadeIn > 0 ? Math.min(1, p / fadeIn) : 1);
274:       // A dark mesh fades through its coverage: `visibility` is clamped at 1 and the
275:       // coverage runs past it on the graded tiers.
276:       if (subtract) for (const m of fadeMats) m.alpha = cover * vis;
277:       else for (const m of meshes) m.visibility = vis;
278:       return true;
279:     },
280:     release() {
281:       disposed = true;
282:       clip?.stop();
283:       // Never the shared materials and textures: the bright / solid materials
284:       // are shared caches (core.ts, modelLoader.ts) and the textures the GLB
285:       // cache's - `dispose(false, true)` used to take them down with the
286:       // first Meteorite to land. The subtractive materials are this spawn's
287:       // own (their emissive is mutated per frame) and go with it.
288:       for (const m of fadeMats) m.dispose(false, false);
289:       for (const m of meshes) releaseEffectGlow(m);
290:       node.dispose(false, false);
291:     },
292:   });
293: 
294:   return {
295:     get alive() {
296:       return handle.alive;
297:     },
298:     stop: () => handle.stop(),
299:     yawTo(dir: Vector3) {
300:       node.rotation.y = Math.atan2(dir.x, dir.z);
301:     },
302:     pitchTo(rad: number) {
303:       node.rotation.x = rad;
304:     },
305:   };
306: }
307: 
308: function spawn(scene: Scene, at: Vector3, opts: ModelOptions): EffectHandle {
309:   return spawnModel(scene, at, opts);
310: }
311: 
312: function update(_map: number, dt: number): void {
313:   live.update(dt);
314: }
315: 
316: function reset(): void {
317:   live.clear();
318: }
319: 
320: // ---- 3. the layer ----------------------------------------------------------
321: 
322: export const modelLayer: EffectLayer<ModelOptions, 'model'> = {
323:   name: 'model',
324:   update,
325:   reset,
326:   spawn,
327: };
</file>

