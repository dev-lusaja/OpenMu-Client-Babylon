237: /**
238:  * `ReceiveDevilSquareRank`: the same 0x93 code as the Blood Castle score;
239:  * the socket tells them apart by length. Chaos Castle shares this table
240:  * (chaosCastle.ts), so it is taken only on the square.
241:  */
242: EventBus.on('MiniGameScoreTable', packet => {
243:   if (!MAPS.has(Store.world?.mapIndex ?? ENUM_WORLD.WD_0LORENCIA)) return;
244: 
245:   const p = new MiniGameScoreTablePacket(packet);
246:   if (p.ResultCount >= MAX_RANK_ROWS) return;
247: 
248:   resultLeft = RESULT_SECONDS;
249:   runInAction(() => {
250:     state.result = {
251:       myRank: p.PlayerRank,
252:       rows: p.getResults().map(r => ({
253:         name: r.PlayerName,
254:         // Signed on the wire, read as uint32 by the generated packet (B12).
255:         score: r.TotalScore | 0,
256:         exp: r.BonusExperience,
257:         zen: r.BonusMoney,
258:       })),
259:     };
260:   });
261: });
262: 
263: // ---- 3. the layer ----------------------------------------------------------
264: 
265: export const devilSquareLayer: EventLayer = {
266:   name: 'devilSquare',
267:   maps: MAPS,
268:   update,
269:   reset,
270:   state: () => ({ open: state.open, running: state.result !== null }),
271:   useTicket,
272: };
