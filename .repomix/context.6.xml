<file path="src/events/scheduleClock.ts">
 1: /**
 2:  * The maths behind the event schedule rows, on its own so it can be tested
 3:  * without the client: `MiniGameOpeningState` minutes into a moment on the
 4:  * shared clock, the text that moment prints, and when to ask again.
 5:  * `schedule.ts` owns the state and does the asking.
 6:  */
 7: 
 8: import { EVENT_TEXT } from './recipes';
 9: 
10: /** The floor: one request per event per 30 s, whatever else asks. */
11: export const MIN_REQUEST_MS = 30_000;
12: /** Nothing known yet, or the server has no timetable: ask again soon. */
13: export const POLL_UNKNOWN_MS = 30_000;
14: /** The gate is open: the row only has to notice it closing again. */
15: export const POLL_OPEN_MS = 60_000;
16: /** A countdown is running: nothing can change it, so drift slowly. */
17: export const POLL_KNOWN_MS = 5 * 60_000;
18: 
19: export type EventScheduleEntry = {
20:   /** Epoch ms on the shared clock, or null while there is no moment to print. */
21:   readonly opensAtServerMs: number | null;
22:   readonly open: boolean;
23:   /** Answered, but the minutes hit the ceiling: it opens further off than that. */
24:   readonly far: boolean;
25: };
26: 
27: export const UNKNOWN_ENTRY: EventScheduleEntry = {
28:   opensAtServerMs: null,
29:   open: false,
30:   far: false,
31: };
32: 
33: /** Answered with the top value a one-byte figure can hold: 255 minutes or more. */
34: export const FAR_ENTRY: EventScheduleEntry = {
35:   opensAtServerMs: null,
36:   open: false,
37:   far: true,
38: };
39: 
40: /**
41:  * `RemainingEnteringTimeMinutes` into a moment on the shared clock. The
42:  * server rounds the wait up to whole minutes and writes its "no timetable"
43:  * value as 0xFFFF, which Blood Castle and Devil Square then send truncated
44:  * to one byte: for them 255 is both "no timetable" and any wait of 255
45:  * minutes or more, so it is read as the long wait rather than as silence.
46:  * Chaos Castle's answer is two bytes wide and has no such ambiguity.
47:  */
48: export function resolveOpening(
49:   minutes: number,
50:   wide: boolean,
51:   nowMs: number
52: ): EventScheduleEntry {
53:   const ceiling = wide ? 0xffff : 0xff;
54:   if (!Number.isFinite(minutes) || minutes < 0) return UNKNOWN_ENTRY;
55:   if (minutes >= ceiling) return wide ? UNKNOWN_ENTRY : FAR_ENTRY;
56:   if (minutes === 0) return { opensAtServerMs: nowMs, open: true, far: false };
57:   return { opensAtServerMs: nowMs + minutes * 60_000, open: false, far: false };
58: }
59: 
60: /** Whole seconds until the gate opens; null when open, far off or unknown. */
61: export function countdownSeconds(entry: EventScheduleEntry, nowMs: number): number | null {
62:   if (entry.open || entry.opensAtServerMs === null) return null;
63:   return Math.max(0, Math.ceil((entry.opensAtServerMs - nowMs) / 1000));
64: }
65: 
66: /** `%.2d:%.2d` of the seconds left; the same clock the timer figure prints. */
67: export function clockText(seconds: number): string {
68:   const s = Math.max(0, Math.floor(seconds));
69:   const m = Math.floor(s / 60);
70:   return `${String(m).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
71: }
72: 
73: /** What one row prints, in the order the states rule each other out. */
74: export function rowText(row: {
75:   open: boolean;
76:   far: boolean;
77:   seconds: number | null;
78: }): string {
79:   if (row.open) return EVENT_TEXT.timerOpen;
80:   if (row.far) return EVENT_TEXT.timerFarOff;
81:   if (row.seconds === null) return '--:--';
82:   return clockText(row.seconds);
83: }
84: 
85: /** When the next request for this event may go out, given its last answer. */
86: export function nextPollAt(entry: EventScheduleEntry, nowMs: number): number {
87:   if (entry.open) return nowMs + POLL_OPEN_MS;
88:   // Far off is an answer like any other, so it backs off the same way: the
89:   // row turns into a real countdown as soon as the figure drops under 255.
90:   if (entry.far) return nowMs + POLL_KNOWN_MS;
91:   if (entry.opensAtServerMs === null) return nowMs + POLL_UNKNOWN_MS;
92:   // Back off, but never past the moment the countdown hits zero.
93:   const backOff = Math.min(nowMs + POLL_KNOWN_MS, entry.opensAtServerMs);
94:   return Math.max(backOff, nowMs + MIN_REQUEST_MS);
95: }
</file>

<file path="src/gmWorld.ts">
 1: import { Store } from './store';
 2: import { nearbyOf } from './common/gmNearby';
 3: 
 4: export { RADAR_RANGE, type Nearby, type NearbyKind } from './common/gmNearby';
 5: 
 6: /**
 7:  * What the panel can see of the world right now.
 8:  *
 9:  * Read straight off the ECS every time it is asked, never cached and never
10:  * made observable: `transform.pos` is written by the movement system on every
11:  * frame, and wrapping a per-frame value in MobX would re-render the panel
12:  * sixty times a second to move a number by a tenth of a tile. The panel polls
13:  * this a few times a second instead, only while it is open - the same bargain
14:  * the debug menu makes with its live rows.
15:  *
16:  * It is only ever *this client's* view. The server tells us about objects in
17:  * scope and nothing else, so "nearby" means nearby, not "on the server". A
18:  * game master who wants the whole map still asks the server, with `/online`
19:  * or `/trace`.
20:  *
21:  * The arithmetic lives in `common/gmNearby.ts`, which imports no store and is
22:  * therefore testable.
23:  */
24: 
25: export type HeroView = {
26:   name: string;
27:   x: number;
28:   y: number;
29:   map: number;
30:   level: number;
31:   /** `CharacterHeroState`; 3 is Normal. */
32:   heroState: number;
33: };
34: 
35: export type WorldView = {
36:   hero: HeroView | null;
37:   nearby: readonly import('./common/gmNearby').Nearby[];
38:   /** What the cursor is over, if it is one of `nearby`. */
39:   targetNetId: number | null;
40: };
41: 
42: const EMPTY: WorldView = { hero: null, nearby: [], targetNetId: null };
43: 
44: export function worldView(): WorldView {
45:   const world = Store.world;
46:   const hero = world?.playerEntity;
47:   if (!world || !hero?.transform) return EMPTY;
48: 
49:   const hx = Math.floor(hero.transform.pos.x);
50:   const hy = Math.floor(hero.transform.pos.z);
51: 
52:   return {
53:     hero: {
54:       name: Store.playerData.name,
55:       x: hx,
56:       y: hy,
57:       map: world.mapIndex,
58:       level: Store.playerData.level,
59:       heroState: Store.playerData.heroState,
60:     },
61:     nearby: nearbyOf(world.netObjsQuery.entities, hx, hy),
62:     targetNetId: world.currentPointerTarget?.netId ?? null,
63:   };
64: }
