343:   /** PET_STAND (:556-562): perched beside the shoulder, facing 120° off. */
344:   function perchRaven(actor: Entity) {
345:     const state = actor.petActor!;
346:     const target = state.owner.transform?.pos;
347:     if (!target) return;
348: 
349:     const yaw = state.owner.transform!.rot.y;
350:     const pos = actor.transform!.pos;
351:     pos.x = target.x + Math.cos(yaw) * RAVEN_PERCH_SIDE;
352:     pos.z = target.z + Math.sin(yaw) * RAVEN_PERCH_SIDE;
353:     pos.y = target.y + RAVEN_PERCH_UP;
