151:   function sendRageAttack(skill: number, targetId: number): void {
152:     if (Store.isOffline) return;
153:     const packet = RageAttackRequestPacket.createPacket();
154:     packet.SkillId = skill;
155:     packet.TargetId = targetId;
156:     Store.sendToGS(packet.buffer);
157:   }
