  9: } from '../../libs/babylon/exports';
 10: import type { ISystemFactory } from '../world';
 11: 
 12: const vec3Tmp = new Vector3();
 13: const qTmp = Quaternion.Identity();
 14: 
 15: export const DrawDebugSystem: ISystemFactory = world => {
 16:   const boundingBoxQuery = world.with('transform', 'modelObject', 'visibility');
 17: 
 18:   const box = CreateBox(
 19:     '__bb__',
 20:     { width: 1, height: 1, depth: 1 },
 21:     world.scene
 22:   );
 23:   box.setParent(world.mapParent);
 24:   box.position.set(0, 0, 0);
 25:   box.scaling.setAll(1);
 26:   const boxMaterial = new StandardMaterial('__bb__mat', world.scene);
 27:   boxMaterial.alpha = 0.6;
 28:   boxMaterial.disableLighting = true;
 29:   box.alwaysSelectAsActiveMesh = true;
 30:   box.material = boxMaterial;
 31:   box.thinInstanceEnablePicking = true;
 32:   box.isPickable = true;
 33:   box.setEnabled(DEBUG_SHOW_BOUNDING_BOXES);
 34:   // box.showBoundingBox = true;
 35: 
 36:   let delay = 1;
 37: 
 38:   // world.scene.constantlyUpdateMeshUnderPointer = true;
 39: 
 40:   const cache = new Map<any, number>();
 41:   let time = 0;
 42:   world.scene.onPointerObservable.add(ev => {
 43:     if (ev.type === PointerEventTypes.POINTERDOWN) {
 44:       time = Date.now();
 45:     } else if (ev.type === PointerEventTypes.POINTERUP) {
 46:       const diff = Date.now() - time;
 47: 
 48:       if (ev.pickInfo) {
 49:         const point = ev.pickInfo.pickedPoint;
 50: 
 51:         // if (
 52:         //   point &&
 53:         //   ev.pickInfo.pickedMesh?.metadata?.terrain &&
 54:         //   diff < CLICK_TO_MOVE_MAX_TIME_DELTA
 55:         // ) {
 56:         // const mouseInput = world.with('mouseInput').entities[0];
 57:         // if (mouseInput) {
 58:         //   const delta = mouseInput.mouseInput.delta;
 59: 
 60:         //   if (delta) {
 61:         //     const magnitude = Math.abs(delta.x) + Math.abs(delta.y);
 62: 
 63:         //     if (magnitude > 3) {
 64:         //       return;
 65:         //     }
 66:         //   }
 67:         // }
 68:         // point.y = 256 - point.y;
 69: 
 70:         // EventBus.emit('groundPointClicked', { point });
 71:         // }
 72:       }
 73:     } else if (ev.type === PointerEventTypes.POINTERMOVE) {
 74:       //         const p =ev.pickInfo?.pickedPoint;
 75:       //         if(!p)return;
 76:       //         p.y = 256 - p.y;
 77:       // console.log('pointer move', p.toString());
 78:       // const e = ev.event;
 79:       // const x = e.clientX;
 80:       // const y = e.clientY;
 81:       // const pickInfo = world.scene.pick(x, y, mesh =>true);
 82:       // console.log(pickInfo?.pickedPoint?.toString())
 83:     }
 84:   });
 85: 
 86:   return {
 87:     update: dt => {
 88:       // Debug-only: the bounds walk below is pure cost when the boxes are
 89:       // not drawn.
 90:       if (!DEBUG_SHOW_BOUNDING_BOXES) return;
 91: 
 92:       delay -= dt;
 93:       if (delay > 0) return;
 94:       delay = 0.1;
 95: 
 96:       for (const {
 97:         transform,
 98:         modelObject,
 99:         visibility,
100:         attributeSystem,
101:       } of boundingBoxQuery) {
102:         if (!modelObject.Ready) continue;
103:         if (!attributeSystem) continue;
104:         if (visibility.state === 'hidden') continue;
105: 
106:         modelObject.UpdateBoundings();
107: 
108:         const bb = modelObject.BoundingBoxLocal;
109: 
110:         // console.log(bb);
111: 
112:         const size = bb.maximumWorld.subtractToRef(bb.minimumWorld, vec3Tmp);
113: 
114:         //size.scaleToRef(0.5, vec3Tmp2);
115:         const center = bb.maximumWorld.add(bb.minimumWorld).scaleInPlace(0.5); //bb.center.scaleToRef(0.01, vec3Tmp2);
116:         const pos = center;
117: 
118:         Quaternion.FromEulerAnglesToRef(
119:           transform.rot.x,
120:           transform.rot.y,
121:           transform.rot.z,
122:           qTmp
123:         );
124: 
125:         const m = Matrix.Compose(size, qTmp, pos);
126: 
127:         if (DEBUG_SHOW_BOUNDING_BOXES) {
128:           if (cache.has(transform)) {
129:             box.thinInstanceSetMatrixAt(cache.get(transform)!, m, false);
130:           } else {
131:             const ind = box.thinInstanceAdd(m, false);
132:             cache.set(transform, ind);
133:           }
134:         }
135:       }
136: 
137:       DEBUG_SHOW_BOUNDING_BOXES && box!.thinInstanceBufferUpdated('matrix');
138:     },
139:   };
