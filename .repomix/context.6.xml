218: /** `ReceiveEventZoneOpenTime`, Value 1: the invitation's answer. */
219: EventBus.on('MiniGameOpeningState', packet => {
220:   const p = new MiniGameOpeningStatePacket(packet);
221:   if (p.GameType !== OPENING_STATE_GAME.devilSquare) return;
222: 
223:   const minutes = p.RemainingEnteringTimeMinutes;
224:   // The HUD rows ask the same question on their own timer; those answers
225:   // feed the schedule and say nothing.
226:   if (takeOpeningState(OPENING_STATE_GAME.devilSquare, minutes)) return;
227: 
228:   Store.addNotification(
229:     minutes === 0
230:       ? EVENT_TEXT.devilOpenNow
231:       : formatText(EVENT_TEXT.devilOpensIn, minutes),
