13: import { updateSceneLook } from '../../scenes/sceneLook';
14: import { lookDirector } from '../../lighting/director';
15: 
16: /**
17:  * The lighting layer's per-frame call site: the look director composes the
18:  * frame's look, then `lighting` steps every source, then the two sinks it
19:  * registers into - the terrain delta texture and the point-light pool - so
20:  * everything a source wrote this frame is what the terrain and the objects
21:  * are lit by this frame.
22:  */
23: export const TerrainLightSystem: ISystemFactory = world => {
24:   return {
25:     update: dt => {
26:       lookDirector()?.tick(dt);
27: 
28:       updateSceneLook(world.scene, world.scene.look);
29: 
30:       lighting.update(world.mapIndex, dt);
31: 
32:       const elapsedMs = world.gameTime.TotalGameTime.TotalSeconds * 1000;
33:       const enabled = GameOptions.dynamicLights;
34:       const camera = world.scene.activeCamera;
35:       // The pool first: on tiers >= 1 the ground takes its slots per pixel,
36:       // and the tile map below carries only what the pool does not hold.
37:       if (camera) {
38:         updatePointLightPool(elapsedMs, camera);
39:       }
40:       const held = lightingTier() ? pointLightPoolHeldTerrain() : undefined;
41:       updateTerrainDynamicLight(elapsedMs, enabled, held);
42:       uploadTerrainLightDelta();
43:     },
44:   };
45: };
</file>

<file path="src/ecs/systems/terrainMaskSystem.ts">
  1: import { ENUM_WORLD } from '../../common/types';
  2: import {
  3:   flushTerrainMask,
  4:   isRoofSlab,
  5:   paintRoof,
  6:   resetTerrainMask,
  7: } from '../../libs/mu/terrainMask';
  8: import { needsTerrainMask } from '../../libs/mu/terrainOverlay';
  9: import { DEVIAS_ROOMS } from '../../maps/devias/rooms';
 10: import type { ISystemFactory } from '../world';
 11: 
 12: /**
 13:  * Keeps the terrain mask (`terrainMask.ts`) up to date: which tiles have a roof
 14:  * over them, so the ground overlays - settled snow today - stop at the door.
 15:  *
 16:  * Nothing in the map data says where an interior is (see the note in
 17:  * terrainMask.ts: the shipped `.att` files carry no `TW_HEIGHT` at all), so a
 18:  * roof has to be recognised by its shape. The test is the one
 19:  * `CeilingHideSystem` already proved for finding the ceiling over the hero - a
 20:  * mesh whose world AABB is a thin slab sitting above head height - applied to
 21:  * every loaded object rather than a radius around the player.
 22:  *
 23:  * ### Why it scans continuously instead of once
 24:  *
 25:  * Objects stream in with the player, so at map load most of the world's
 26:  * geometry does not exist yet and a single pass would see almost nothing.
 27:  * Because painting is additive, a continuous scan converges on exactly the
 28:  * right answer wherever the player has been - and the only place that matters
 29:  * is where they can see the ground. Each entity is measured **once** and then
 30:  * skipped forever, so the steady-state cost is walking the entity list, not
 31:  * its meshes.
 32:  *
 33:  * Measuring once also quietly handles the Lorencia pub, whose roof is lifted
 34:  * 100 units out of view while the hero is inside it: the roof is measured on
 35:  * the approach, and the lift afterwards cannot un-measure it.
 36:  *
 37:  * ### Only the map's own geometry is ever measured
 38:  *
 39:  * The query is keyed on `modelId`, which `loadMapIntoScene.createObjects`
 40:  * sets and nothing else in the game does - so it holds exactly the objects
 41:  * the map file placed, and never a player, a monster, an NPC or a dropped
 42:  * item.
 43:  *
 44:  * That is not tidiness, it is a fix. A **fresh drop** is created 180 cm up
 45:  * and thrown a further ~44 cm by `DropMotionSystem`, then falls for about
 46:  * half a second: for that half second it is a thin mesh hanging 1.8–2.2
 47:  * tiles over the ground, which is precisely the slab test below. Whichever
 48:  * scan caught it painted the item's tumbling world AABB as a roof - and
 49:  * because painting is additive and each entity is measured once, every item
 50:  * that ever fell left a permanent square of bare ground in the snow under it.
 51:  * Living bodies are out for the same reason: nothing that can be somewhere
 52:  * else a second later has any business deciding what the sky over a tile is.
 53:  */
 54: 
 55: /** Seconds between scans. The mask only has to be right before snow builds. */
 56: const SCAN_INTERVAL = 0.5;
 57: 
 58: /** Mid-map tile, used only to ask whether terrain height is loaded yet. */
 59: const TERRAIN_PROBE = 128;
 60: 
 61: export const TerrainMaskSystem: ISystemFactory = world => {
 62:   // `modelId` is the map file's object id, set only by `createObjects`. It is
 63:   // what separates the world's own geometry from everything that walks, flies
 64:   // or falls through it - see the note above.
 65:   const models = world.with('modelObject', 'transform', 'worldIndex', 'modelId');
 66:   const areas = world.with('interactiveArea', 'worldIndex');
 67: 
 68:   /** Entities already measured; their geometry does not move. */
 69:   let measured = new WeakSet<object>();
 70: 
 71:   let lastMap: ENUM_WORLD | null = null;
 72:   let sinceScan = SCAN_INTERVAL;
 73: 
 74:   /**
 75:    * The interiors the game already knows by name - every registered
 76:    * `interactiveArea`, plus the Devias rooms that are data-only. Painted
 77:    * unconditionally, because these are the rooms a player is most likely to be
 78:    * standing in when the map loads and no roof has streamed in yet.
 79:    */
 80:   function paintKnownInteriors(map: ENUM_WORLD) {
 81:     for (const e of areas) {
 82:       if (e.worldIndex !== map) continue;
 83:       const { min, max } = e.interactiveArea;
 84:       paintRoof({ minX: min.x, maxX: max.x, minZ: min.y, maxZ: max.y });
 85:     }
 86: 
 87:     if (map === ENUM_WORLD.WD_2DEVIAS) {
 88:       for (const room of DEVIAS_ROOMS) {
 89:         paintRoof({
 90:           minX: room.min.x,
 91:           maxX: room.max.x,
 92:           minZ: room.min.y,
 93:           maxZ: room.max.y,
 94:         });
 95:       }
 96:     }
 97:   }
 98: 
 99:   function scanRoofs(map: ENUM_WORLD) {
100:     // `World.getTerrainHeight` answers -9999 until the map's height data is
101:     // installed. Measuring against that would put every roof's clearance in
102:     // the thousands, and since an entity is only ever measured once, the
103:     // whole map would be permanently unroofed. Wait instead.
104:     if (world.getTerrainHeight(TERRAIN_PROBE, TERRAIN_PROBE) <= -9000) return;
105: 
106:     for (const e of models) {
107:       if (e.worldIndex !== map) continue;
108:       if (measured.has(e)) continue;
109: 
110:       const mo = e.modelObject;
111:       if (!mo.Ready || !mo.gltf) continue;
112: 
113:       // Ready and measured: never look at this one again, whatever it turned
114:       // out to be. A building does not grow a roof later.
115:       measured.add(e);
116: 
117:       for (const mesh of mo.gltf.mesh.getChildMeshes(false)) {
118:         if (mesh.metadata?.SkipBoundingBox) continue;
119:         if (mesh.getTotalVertices() === 0) continue;
120: 
121:         const box = mesh.getBoundingInfo().boundingBox;
122:         const min = box.minimumWorld;
123:         const max = box.maximumWorld;
124: 
125:         const ground = world.getTerrainHeight(
126:           (min.x + max.x) * 0.5,
127:           (min.z + max.z) * 0.5
128:         );
129: 
130:         if (!isRoofSlab(min.y, max.y, ground)) continue;
131: 
132:         paintRoof({
133:           minX: min.x,
134:           maxX: max.x,
135:           minZ: min.z,
136:           maxZ: max.z,
137:         });
138:       }
139:     }
140:   }
141: 
142:   return {
143:     update: dt => {
144:       const map = world.mapIndex;
145: 
146:       if (map !== lastMap) {
147:         lastMap = map;
148:         measured = new WeakSet();
149:         resetTerrainMask();
150:         sinceScan = SCAN_INTERVAL;
151:       }
152: 
153:       // Only maps with a ground overlay pay for any of this.
154:       if (!needsTerrainMask(map)) return;
155: 
156:       sinceScan += dt;
157:       if (sinceScan < SCAN_INTERVAL) return;
158:       sinceScan = 0;
159: 
160:       paintKnownInteriors(map);
161:       scanRoofs(map);
162:       flushTerrainMask();
163:     },
164:   };
165: };
</file>

<file path="src/ecs/systems/weaponTrailSystem.ts">
 1: import { Vector3 } from '../../libs/babylon/exports';
 2: import type { ISystemFactory } from '../world';
 3: import { effects } from '../../effects';
 4: import { boneLocalPos } from '../../effects/core';
 5: import { weaponBlurFor, type WeaponBlurRow } from '../../common/weaponBlur';
 6: import {
 7:   isPlayerAttackAction,
 8:   isPlayerSkillAction,
 9: } from '../../common/playerActionMapper';
10: 
11: /**
12:  * `CreateWeaponBlur` (ZzzCharacter.cpp:3656, called from MoveCharacterVisual
13:  * :5212 every tick): while a character is in a swing clip and past its third
14:  * key, the two ends of the blade are sampled from the weapon's hand bone and
15:  * drawn as one strip. Here the sampling is the `blur` primitive's; this
16:  * system is the **consumer** that notices a clip (re)start (`actionSerial`,
17:  * the way CombatSfxSystem does for sounds), looks the swing up in
18:  * `common/weaponBlur.ts` and spawns the trail once the clip reaches the
19:  * start key. The trail ends itself when the clip does or is replaced.
20:  *
21:  * Per frame: one integer compare per character, one `actionFrame()` for a
22:  * character whose swing has not yet reached its start key. No allocation
23:  * outside the spawn itself (once per swing).
24:  */
25: 
26: type Swing = {
27:   serial: number;
28:   row: WeaponBlurRow | null;
29:   spawned: boolean;
30: };
31: 
32: export const WeaponTrailSystem: ISystemFactory = world => {
33:   const query = world.with('modelObject', 'transform', 'playerAnimation');
34:   const swings = new WeakMap<object, Swing>();
35: 
36:   return {
37:     update: () => {
38:       for (const e of query) {
39:         const model = e.modelObject;
40:         let swing = swings.get(model);
41:         if (!swing) {
42:           swing = { serial: model.actionSerial, row: null, spawned: true };
43:           swings.set(model, swing);
44:           continue; // the pose it was first seen in is not a swing start
45:         }
46:         const serial = model.actionSerial;
47:         if (swing.serial !== serial) {
48:           swing.serial = serial;
49:           swing.spawned = false;
50:           const action = model.CurrentAction;
51:           swing.row =
52:             isPlayerAttackAction(action) || isPlayerSkillAction(action)
53:               ? weaponBlurFor(e.charAppearance, action, true)
54:               : null;
55:         }
56:         const row = swing.row;
57:         if (!row || swing.spawned) continue;
58:         if (!model.Ready || model.OutOfView || !model.gltf?.skeleton) continue;
59:         if (model.actionFrame() < row.startKey) continue;
60: 
61:         swing.spawned = true;
62:         const hiltLocal = new Vector3(0, -row.hilt, 0);
63:         const tipLocal = new Vector3(0, -row.tip, 0);
64:         const entity = e;
65:         const bone = row.bone;
66:         const endKey = row.endKey;
67:         effects.spawn('blur', world.scene, Vector3.Zero(), {
68:           follow: out => boneLocalPos(entity, bone, tipLocal, out),
69:           base: out => boneLocalPos(entity, bone, hiltLocal, out),
70:           texture: row.texture,
71:           colour: row.colour,
72:           blend: row.blend,
73:           seconds: model.getActionDuration(model.CurrentAction) || undefined,
74:           until: () =>
75:             model.actionSerial !== serial ||
76:             model.ActionIterationWasFinished ||
77:             model.actionFrame() > endKey,
78:         });
79:       }
80:     },
81:   };
82: };
</file>

