159:   /** Dark Side: one 0x4A per extra target as the follow-up blows come round. */
160:   function drainDarkSide(): void {
161:     for (;;) {
162:       const id = combat.nextDarkSideHit();
163:       if (id < 0) return;
164:       sendRageAttack(combat.darkSidePendingSkill, id);
165:     }
166:   }
