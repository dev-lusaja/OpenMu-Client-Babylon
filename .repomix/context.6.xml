<file path="src/ecs/systems/renderSystem.ts">
  1: import { Plane, Vector3 } from '../../libs/babylon/exports';
  2: import { ISystemFactory } from '../world';
  3: import { toRenderAngles } from '../../common/renderAngles';
  4: import { weather } from '../../weather';
  5: 
  6: const v3Temp = Vector3.Zero();
  7: const v3Temp2 = Vector3.Zero();
  8: 
  9: /**
 10:  * Tiles the camera frustum is widened by before a model is called off screen.
 11:  * It has to cover how far a blob shadow can travel from its caster
 12:  * (`LIGHT_SHADOW_MAX` = 3 tiles for the torch projection, a little more for
 13:  * the sun skew), so that a caster just past the edge still draws the shadow
 14:  * that reaches into view.
 15:  */
 16: const OFF_SCREEN_MARGIN = 8;
 17: 
 18: export const RenderSystem: ISystemFactory = world => {
 19:   const query = world.with('transform', 'modelObject');
 20: 
 21:   /** Reused copy of `scene.frustumPlanes`, pushed out by OFF_SCREEN_MARGIN. */
 22:   const widenedPlanes: Plane[] = [];
 23: 
 24:   function widenFrustum(): Plane[] | null {
 25:     const source = world.scene.frustumPlanes;
 26: 
 27:     if (!source || source.length < 6) return null;
 28: 
 29:     if (widenedPlanes.length === 0) {
 30:       for (let i = 0; i < 6; i++) widenedPlanes.push(new Plane(0, 0, 0, 0));
 31:     }
 32: 
 33:     for (let i = 0; i < 6; i++) {
 34:       // Babylon normalises the frustum planes and points their normals
 35:       // inward, so raising `d` moves the plane outward by exactly that many
 36:       // world units.
 37:       widenedPlanes[i].normal.copyFrom(source[i].normal);
 38:       widenedPlanes[i].d = source[i].d + OFF_SCREEN_MARGIN;
 39:     }
 40: 
 41:     return widenedPlanes;
 42:   }
 43: 
 44:   return {
 45:     update: dt => {
 46:       const map = world.mapIndex;
 47: 
 48:       const terrain = world.terrain;
 49:       if (!terrain) return;
 50: 
 51:       const extraHeight = terrain.extraHeight;
 52: 
 53:       // Built from the previous `scene.render()`. One frame of lag is fine:
 54:       // this only pauses looping clips and hides blob shadows, and
 55:       // `updateFrustumVisibility` waits OUT_OF_VIEW_GRACE frames first.
 56:       const frustumPlanes = widenFrustum();
 57: 
 58:       for (const entity of query) {
 59:         const { transform, modelObject } = entity;
 60: 
 61:         // Bone-linked children follow their root, so only roots are tested.
 62:         if (!modelObject.Parent) {
 63:           modelObject.updateFrustumVisibility(frustumPlanes);
 64:         }
 65: 
 66:         modelObject.Update(world.gameTime);
 67: 
 68:         // Characters face their target yaw at once: the original assigns
 69:         // Object.Angle[2] directly for players and monsters (the smoothed
 70:         // TurnAngle2 variant in ZzzObject.cpp:3799 is commented-out door code).
 71:         if (entity.playerAnimation || entity.monsterAnimation) {
 72:           transform.visualRotY = transform.rot.y;
 73:         }
 74: 
 75:         const light = world.getTerrainLight(transform.pos.x, transform.pos.z);
 76:         const self = modelObject.SelfLight;
 77: 
 78:         modelObject.Light.set(
 79:           light.x + self.x,
 80:           light.y + self.y,
 81:           light.z + self.z
 82:         );
 83: 
 84:         toRenderAngles(transform.rot, v3Temp);
 85:         if (transform.visualRotY !== undefined) {
 86:           v3Temp.y = Math.PI * 2 - transform.visualRotY;
 87:         }
 88: 
 89:         v3Temp2.copyFrom(transform.pos as any);
 90:         if (transform.posOffset !== undefined) {
 91:           // Component-wise, not addInPlace(): posOffset is an IVector3Like and
 92:           // most writers (fresh drops, Chaos Castle ring floors, the Kanturu
 93:           // tower sink, Lorencia walls) hand a plain {x, y, z}. Babylon's
 94:           // addInPlace reads `_x`, undefined on those, which turned the whole
 95:           // node position NaN - a model that never draws under a perfectly
 96:           // placed name tag ("Zen 336" with nothing beneath it).
 97:           const offset = transform.posOffset;
 98:           v3Temp2.x += offset.x;
 99:           v3Temp2.y += offset.y;
100:           v3Temp2.z += offset.z;
101:         }
102:         if (entity.dying) {
103:           // Sink while fading; the knock-up slide / castle fall displacement
104:           // and tilt (DeathSystem's `offset` / `pitch`, render-only).
105:           const { sink, offset, pitch } = entity.dying;
106:           v3Temp2.y -= sink;
107:           v3Temp2.x += offset.x;
108:           v3Temp2.y += offset.y;
109:           v3Temp2.z += offset.z;
110:           v3Temp.x += pitch;
111:         }
112:         // Settled snow is something you stand *in*, not on - but only where
113:         // it is actually lying. Rendered position only: transform.pos stays
114:         // where pathing and the server think it is.
115:         // Characters only. A prop out of the map's object list is placed at an
116:         // authored height that already fits its neighbours, and the sink is a
117:         // per-position number: it pulled every segment of a fence run down by a
118:         // different amount and the rail stopped meeting itself.
119:         if (!modelObject.IsMapObject) {
120:           v3Temp2.y -= weather.snowSinkDepth(
121:             world,
122:             map,
123:             v3Temp2.x,
124:             transform.pos.y,
125:             v3Temp2.z
126:           );
127:         }
128: 
129: modelObject.updateLocation(v3Temp2, transform.scale, v3Temp);
130: 
131:         modelObject.Draw(world.gameTime);
132:       }
133:     },
134:   };
135: };
</file>

<file path="src/ecs/systems/restObjectSystem.ts">
  1: import {
  2:   PointerEventTypes,
  3:   Ray,
  4:   Vector3,
  5: } from '../../libs/babylon/exports';
  6: import {
  7:   PlayerAction,
  8:   ServerPlayerActionType,
  9: } from '../../common/objects/enum';
 10: import { resolveGenderedAction } from '../../common/playerActionMapper';
 11: import { TWFlags } from '../../common/terrain/consts';
 12: import {
 13:   findRestObject,
 14:   type RestKind,
 15: } from '../../libs/mu/restObjects';
 16: import { sound } from '../../sound';
 17: import { Store } from '../../store';
 18: import type { ISystemFactory } from '../world';
 19: 
 20: const SERVER_ACTION: Record<RestKind, ServerPlayerActionType> = {
 21:   sit: ServerPlayerActionType.Sit,
 22:   pose: ServerPlayerActionType.Pose,
 23:   healing: ServerPlayerActionType.Healing,
 24: };
 25: 
 26: const CLIENT_ACTION: Record<RestKind, PlayerAction> = {
 27:   sit: PlayerAction.PLAYER_SIT1,
 28:   pose: PlayerAction.PLAYER_POSE1,
 29:   healing: PlayerAction.PLAYER_HEALING1,
 30: };
 31: 
 32: function rotationByte(rotYRadians: number): number {
 33:   let deg = ((rotYRadians * 180) / Math.PI) % 360;
 34:   if (deg < 0) deg += 360;
 35: 
 36:   return Math.floor(((deg + 22.5) / 360) * 8 + 1) % 8;
 37: }
 38: 
 39: export const RestObjectSystem: ISystemFactory = world => {
 40:   const scene = world.scene;
 41: 
 42:   const propsQuery = world.with(
 43:     'modelObject',
 44:     'transform',
 45:     'visibility',
 46:     'modelId',
 47:     'worldIndex'
 48:   );
 49: 
 50:   const tmpRay = new Ray(Vector3.Zero(), Vector3.Up(), 1);
 51: 
 52:   let pending: {
 53:     x: number;
 54:     y: number;
 55:     kind: RestKind;
 56:     useObjectAngle: boolean;
 57:     angle: number;
 58:   } | null = null;
 59: 
 60:   let clickedThisFrame = false;
 61: 
 62:   let issuedPoint: { x: number; y: number } | null = null;
 63: 
 64:   let currentMap: number | null = null;
 65: 
 66:   scene.onPointerObservable.add(ev => {
 67:     if (ev.type !== PointerEventTypes.POINTERDOWN) return;
 68:     if (!world.playerEntity) return;
 69:     // Something selectable (NPC, monster, drop) under the cursor takes the
 70:     // click; the bench / wall behind it must not steal it into a lean.
 71:     if (world.currentPointerTarget) return;
 72: 
 73:     const pickInfo = scene.pick(ev.event.clientX, ev.event.clientY);
 74:     const ray = pickInfo.ray;
 75:     if (!ray) return;
 76: 
 77:     tmpRay.origin.copyFrom(ray.origin);
 78:     tmpRay.direction.copyFrom(ray.direction);
 79:     tmpRay.length = ray.length;
 80: 
 81:     for (const e of propsQuery) {
 82:       if (e.worldIndex !== world.mapIndex) continue;
 83:       if (e.visibility.state === 'hidden') continue;
 84: 
 85:       const rest = findRestObject(world.mapIndex, e.modelId);
 86:       if (!rest) continue;
 87: 
 88:       if (!e.modelObject.Ready) continue;
 89:       e.modelObject.UpdateBoundings();
 90:       const bb = e.modelObject.BoundingBoxLocal;
 91:       if (!tmpRay.intersectsBoxMinMax(bb.minimumWorld, bb.maximumWorld)) {
 92:         continue;
 93:       }
 94: 
 95:       const tileX = ~~e.transform.pos.x;
 96:       const tileY = ~~e.transform.pos.z;
 97: 
 98:       const wall = world.getTerrainFlag(tileX, tileY);
 99:       if (wall !== TWFlags.Height && wall >= TWFlags.Character) {
100:         pending = null;
101:         issuedPoint = null;
102:         break;
103:       }
104: 
105:       pending = {
106:         x: tileX,
107:         y: tileY,
108:         kind: rest.kind,
109:         useObjectAngle: rest.useObjectAngle,
110:         angle: e.transform.rot.y,
111:       };
112:       clickedThisFrame = true;
113:       break;
114:     }
115:   });
116: 
117:   return {
118:     update: () => {
119:       if (currentMap !== world.mapIndex) {
120:         currentMap = world.mapIndex;
121:         pending = null;
122:       }
123: 
124:       const playerEntity = world.playerEntity;
125:       if (!playerEntity) {
126:         pending = null;
127:         return;
128:       }
129: 
130:       if (!pending) return;
131: 
132:       const moveTo = playerEntity.playerMoveTo;
133: 
134:       if (clickedThisFrame) {
135:         clickedThisFrame = false;
136: 
137:         if (world.isWalkable(pending.x, pending.y)) {
138:           moveTo.point.x = pending.x;
139:           moveTo.point.y = pending.y;
140:           moveTo.handled = false;
141:           moveTo.sendToServer = true;
142: 
143:           const pathfinding = playerEntity.pathfinding;
144:           pathfinding.from.x = playerEntity.transform.pos.x;
145:           pathfinding.from.y = playerEntity.transform.pos.z;
146:           pathfinding.to.x = pending.x;
147:           pathfinding.to.y = pending.y;
148:           pathfinding.calculated = false;
149:         }
150:         issuedPoint = { x: moveTo.point.x, y: moveTo.point.y };
151:         return;
152:       }
153: 
154:       if (
155:         issuedPoint &&
156:         (moveTo.point.x !== issuedPoint.x || moveTo.point.y !== issuedPoint.y)
157:       ) {
158:         pending = null;
159:         issuedPoint = null;
160:         return;
161:       }
162: 
163:       if (!moveTo.handled) return;
164: 
165:       const pathfinding = playerEntity.pathfinding;
166:       if (
167:         !pathfinding.calculated ||
168:         (pathfinding.path && pathfinding.path.length > 0)
169:       ) {
170:         return;
171:       }
172: 
173:       const velocity = playerEntity.movement?.velocity;
174:       if (velocity && (velocity.x !== 0 || velocity.y !== 0)) return;
175: 
176:       const px = ~~playerEntity.transform.pos.x;
177:       const py = ~~playerEntity.transform.pos.z;
178: 
179:       const done = pending;
180:       pending = null;
181:       issuedPoint = null;
182: 
183:       if (Math.max(Math.abs(px - done.x), Math.abs(py - done.y)) > 1) return;
184: 
185: if (done.useObjectAngle) {
186:         playerEntity.transform.rot.y = done.angle;
187:       }
188: 
189:       const isFemale = playerEntity.attributeSystem.isAboveZero('isFemale');
190:       playerEntity.playerAnimation.action = resolveGenderedAction(
191:         CLIENT_ACTION[done.kind],
192:         isFemale
193:       );
194: 
195:       if (!Store.isOffline) {
196:         Store.sendAnimationRequest(
197:           rotationByte(playerEntity.transform.rot.y),
198:           SERVER_ACTION[done.kind]
199:         );
200:       }
201: 
202:       if (done.kind !== 'healing') {
203:         sound.play('Sound/pDropItem');
204:       }
205:     },
206:   };
207: };
</file>

<file path="src/ecs/systems/sceneReadySystem.ts">
  1: import type { ISystemFactory } from '../world';
  2: import { Store, UIState } from '../../store';
  3: import { EventBus } from '../../libs/eventBus';
  4: import { isStaged, sceneHeld } from '../../common/sceneGate';
  5: 
  6: const READY_GRACE_SECONDS = 3;
  7: 
  8: const MAX_WAIT_SECONDS = 30;
  9: 
 10: const MIN_SHOW_SECONDS = 0.3;
 11: 
 12: /**
 13:  * How long the gate may stay shut on actors alone once the map itself is in:
 14:  * the character select line-up, and the hero's own body on world entry. Both
 15:  * come from the server, so neither is guaranteed to arrive - past this the
 16:  * scene is shown without them rather than sitting on the loading art.
 17:  */
 18: const STAGE_WAIT_SECONDS = 10;
 19: 
 20: const MAP_SHARE = 0.35;
 21: const MODEL_SHARE = 0.6;
 22: 
 23: const MAP_CREEP_PER_SECOND = 0.6;
 24: 
 25: const MAX_REPORTED = 0.99;
 26: 
 27: export const SceneReadySystem: ISystemFactory = world => {
 28:   const query = world.with('visibility', 'modelFactory');
 29: 
 30:   let waited = 0;
 31: 
 32:   let mapLoaded = false;
 33: 
 34:   let readyWait = 0;
 35: 
 36:   let stageWait = 0;
 37: 
 38:   let reported = 0;
 39: 
 40:   const report = (value: number) => {
 41:     reported = Math.max(reported, Math.min(value, MAX_REPORTED));
 42:     Store.setLoadingProgress(reported);
 43:   };
 44: 
 45:   EventBus.on('warpCompleted', () => {
 46:     mapLoaded = true;
 47:   });
 48: 
 49:   EventBus.on('requestWarp', () => {
 50:     mapLoaded = false;
 51:     waited = 0;
 52:     readyWait = 0;
 53:     stageWait = 0;
 54:     reported = 0;
 55:   });
 56: 
 57:   /**
 58:    * The actors the screen is about to be judged on. Systems that stage their
 59:    * own content hold the gate by name (`sceneGate`); the hero is checked here
 60:    * because entering a world with no body on screen is the same half-load,
 61:    * and nothing else owns it.
 62:    */
 63:   const actorsStaged = () => {
 64:     if (sceneHeld()) return false;
 65: 
 66:     if (Store.uiState === UIState.World && !isStaged(world.playerEntity)) {
 67:       return false;
 68:     }
 69: 
 70:     return true;
 71:   };
 72: 
 73:   const finish = () => {
 74:     Store.setLoadingProgress(1);
 75:     Store.setSceneLoading(false);
 76:     readyWait = 0;
 77:     stageWait = 0;
 78:     waited = 0;
 79:     reported = 0;
 80:   };
 81: 
 82:   return {
 83:     update: (deltaTime: number) => {
 84:       if (!Store.sceneLoading) {
 85:         waited = 0;
 86:         readyWait = 0;
 87:         stageWait = 0;
 88:         return;
 89:       }
 90: 
 91:       waited += deltaTime;
 92: 
 93:       if (waited > MAX_WAIT_SECONDS) {
 94:         const stuck: string[] = [];
 95: 
 96:         for (const entity of query) {
 97:           if (entity.visibility.state === 'hidden') continue;
 98: 
 99:           if (isStaged(entity)) continue;
100: 
101:           stuck.push(
102:             entity.modelFilePath ?? `model id ${entity.modelId ?? '?'}`
103:           );
104:         }
105: 
106:         console.warn(
107:           `Scene still not ready after ${MAX_WAIT_SECONDS}s - showing it anyway.`,
108:           stuck.length
109:             ? `Still waiting on ${stuck.length} model(s): ${[...new Set(stuck)].slice(0, 10).join(', ')}`
110:             : 'All models loaded; the scene itself never reported ready.'
111:         );
112: 
113:         finish();
114:         return;
115:       }
116: 
117:       if (!mapLoaded || !world.terrain) {
118:         report(MAP_SHARE * (1 - Math.exp(-waited * MAP_CREEP_PER_SECOND)));
119:         return;
120:       }
121: 
122:       let loaded = 0;
123:       let expected = 0;
124: 
125:       for (const entity of query) {
126:         if (entity.visibility.state === 'hidden') continue;
127: 
128:         expected++;
129: 
130:         if (isStaged(entity)) loaded++;
131:       }
132: 
133:       const modelRatio = expected === 0 ? 1 : loaded / expected;
134: 
135:       report(MAP_SHARE + MODEL_SHARE * modelRatio);
136: 
137:       if (loaded < expected) return;
138: 
139:       if (waited < MIN_SHOW_SECONDS) return;
140: 
141:       // The map is in. What is left is whatever the server still owes this
142:       // screen: the character list its line-up is spawned from, and the
143:       // hero's body on the way into a world. Bounded on its own clock so a
144:       // server that never sends them costs ten seconds, not thirty.
145:       if (stageWait < STAGE_WAIT_SECONDS && !actorsStaged()) {
146:         stageWait += deltaTime;
147:         return;
148:       }
149: 
150:       readyWait += deltaTime;
151: 
152:       if (world.scene.isReady() || readyWait > READY_GRACE_SECONDS) {
153:         finish();
154:       }
155:     },
156:   };
157: };
</file>

