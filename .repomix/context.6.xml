 52: 
 53: export const GM_SECTIONS: readonly GmSectionInfo[] = [
 54:   { id: 'live', titleKey: 'gm.section.live', hintKey: 'gm.section.liveHint' },
 55:   { id: 'map', titleKey: 'gm.section.map', hintKey: 'gm.section.mapHint' },
 56:   { id: 'logs', titleKey: 'gm.section.logs', hintKey: 'gm.section.logsHint' },
 57:   { id: 'skins', titleKey: 'gm.section.skins', hintKey: 'gm.section.skinsHint' },
