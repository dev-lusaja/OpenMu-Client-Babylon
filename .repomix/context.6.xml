238: /**
239:  * How much of the map's level a dark card takes as coverage. Full level
240:  * saturates the whole sheet into a flat slab and loses the art's own shading;
241:  * this is the measured point where the silhouette reads as black on a graded
242:  * frame and still keeps its internal detail (2026-09-07 sweep, 1 / 0.75 /
243:  * 0.55 / 0.35). Dev seam: `?darkgain=`.
244:  */
245: const DARK_COVERAGE = 0.7;
246: 
247: /** The map's level, `2^ev` (lighting/director `keyGain`). 1 on Classic. */
248: function mapKey(): number {
249:   return lookDirector()?.state().keyGain ?? 1;
250: }
251: 
252: /** Rec709 luma of an effect tint - what a greyscale `Light` carries. */
253: export function luma(c: RGB): number {
254:   return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
255: }
256: 
257: /**
258:  * The multiplier an emissive card's tint takes so it lands at `keyGain` x its
259:  * authored value in the buffer: effect art is light and follows the map's
260:  * level like the torches (ARCHITECTURE F12). The material's colour is decoded
261:  * once downstream when the buffer is linear, so the gain enters pre-decoded
262:  * there. 1 on Classic.
263:  *
264:  * This used to be the fire family's alone, on the reading that a flame is
265:  * light and a flare is "authored art at its authored value". The art is
266:  * authored *display-referred* though - these are the original client's
267:  * sheets, drawn into a frame whose lit ground sat near 1 - and on the graded
268:  * tiers the buffer is scene-referred, so that same ground sits at `keyGain`
269:  * and a card at its authored value lands a stop or two *under* what it is
270:  * drawn over. A lightning bolt went from a blown white core to a pale line
271:  * the moment post processing came on, and so did every other skill
272:  * (2026-09-07). Alpha art - blood, smoke, a scorch - is matter, not light,
273:  * and keeps its authored value on every tier.
274:  */
275: export function lightCardGain(scene: Scene): number {
276:   const gain = mapKey();
277:   return linearBufferActive(scene) ? gain ** (1 / 2.2) : gain;
278: }
279: 
280: /**
281:  * The same rule for `RENDER_DARK`. A subtraction removes a *fraction of the
282:  * frame*, and the original applied it to a display buffer; on a scene-referred
283:  * one that fraction is worth far less by the time the tone curve has
284:  * compressed what is left, so the coverage takes the map's level too.
285:  *
286:  * Unlike the light gain this one is **not** gated on the buffer. It was, and
287:  * that made a dark effect a different effect either side of the post
288:  * processing switch - the point of the switch is the grade, not the art
289:  * (2026-09-07). Coverage is alpha and alpha is never decoded, so no 1/2.2
290:  * here either; the two tiers differ only in the frame the same silhouette
291:  * lands on, and on a graded frame that reads blacker because the surround is
292:  * not clipped to white.
293:  */
294: export function darkCardGain(_scene: Scene): number {
295:   // Never under 1: the sheet's own levels are what the art was drawn at, and
296:   // Classic composites in the buffer it was drawn for. The map's level only
297:   // ever lifts a dark card above that, never below.
298:   return Math.max(1, mapKey() * (devQueryNumber('darkgain') ?? DARK_COVERAGE));
299: }
