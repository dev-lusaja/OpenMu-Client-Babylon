 85: /**
 86:  * Hands a system the shared flare once it decodes. The system can be gone by
 87:  * then - the wearer walked out of range, the drop was picked up - and Babylon
 88:  * splices a disposed system out of `scene.particleSystems`, so that is the
 89:  * check. Assigning to a dead system would pin the decoded texture to it and,
 90:  * worse, hide the fact that it is dead.
 91:  */
 92: function flareWhenLoaded(scene: Scene, ps: AuraSystem): void {
 93:   void loadEffectTexture(scene, FLARE).then(texture => {
 94:     if (scene.particleSystems.indexOf(ps) >= 0) ps.particleTexture = texture;
 95:   });
 96: }
