217:   function updateAngel(actor: Entity, dt: number) {
218:     const state = actor.petActor!;
219:     const pos = actor.transform!.pos;
220:     const target = state.owner.transform?.pos;
221:     if (!target) return;
222: 
223:     const ticks = dt * TICKS_PER_SECOND;
224: 
225:     const dx = target.x - pos.x;
226:     const dz = target.z - pos.z;
227:     const far = dx * dx + dz * dz >= state.flyRange * state.flyRange;
228: 
229:     if (far) {
230:       const heading = createAngleDeg(pos.x, pos.z, target.x, target.z) * DEG;
231:       state.yaw = turnAngle(
232:         state.yaw,
233:         heading,
234:         TURN_DEGREES_PER_TICK * DEG * ticks
235:       );
236:     }
237: 
238:     // rand_fps_check(32): a fresh heading and speed roughly every 32 ticks.
239:     state.reroll -= ticks;
240:     if (state.reroll <= 0) {
241:       state.reroll = REROLL_TICKS;
242: 
243:       // Forward is -Y in the original's object space, so the speed is negative.
244:       const speed = far ? -(rand(64) + 128) * 0.1 : -(rand(64) + 16) * 0.1;
245: 
246:       if (!far) state.yaw = rand(360) * DEG;
247: 
248:       state.dir.y = speed;
249:       state.dir.z = (rand(64) - 32) * 0.1;
250:     }
251: 
252:     // Height band, applied to the direction rather than to the position.
253:     const height = (pos.y - target.y) / MU_UNIT;
254:     if (height < ANGEL_MIN_HEIGHT) state.dir.z += ANGEL_HEIGHT_NUDGE * ticks;
255:     if (height > ANGEL_MAX_HEIGHT) state.dir.z -= ANGEL_HEIGHT_NUDGE * ticks;
256: 
257:     // VectorRotate((0, speed, dz), AngleMatrix(0, 0, yaw)) with a negative
258:     // speed points along the facing direction.
259:     const step = state.dir.y * MU_UNIT * ticks;
260:     pos.x += -Math.sin(state.yaw) * step;
261:     pos.z += Math.cos(state.yaw) * step;
262:     pos.y += state.dir.z * MU_UNIT * ticks;
263:     // o->Position[2] += rand() % 16 - 8: a flutter on top of the drift.
264:     pos.y += (rand(16) - 8) * MU_UNIT * ticks;
265: 
266:     actor.transform!.rot.y = state.yaw;
267: 
268:     actor.modelObject?.setAnimationSpeed(ANGEL_PLAY_SPEED);
269:     actor.modelObject?.playAction(MOUNT_ACTION_STAND, true);
270:   }
