  1: /**
  2:  * Ring - a textured decal draped over the terrain at a point that grows,
  3:  * turns and fades: the magic circle under a heal, the shock ring of an
  4:  * earth skill, the scorch under a meteor. The original's
  5:  * `RenderTerrainAlphaBitmap(BITMAP_MAGIC_*, …)` calls from `RenderEffect`
  6:  * (ZzzEffect.cpp) and the ground circles in `ZzzCharacter.cpp`.
  7:  *
  8:  * Decals are `TerrainDecal`s (common/moveTargetEffect.ts, read-only use)
  9:  * pooled per texture so a spam of heals reuses the same mesh.
 10:  *
 11:  * Driven by: `effects.spawn('ring', …)`. Read by: nobody.
 12:  */
 13: import { Vector3, type Scene } from '../libs/babylon/exports';
 14: import { TerrainDecal } from '../common/moveTargetEffect';
 15: import { Store } from '../store';
 16: import { LiveList, fadeOut, lerp, type RGB } from './core';
 17: import { RGBS, TEX } from './recipes';
 18: import { DEAD_HANDLE, type EffectHandle, type EffectLayer } from './layer';
 19: 
 20: // ---- 1. tuning -------------------------------------------------------------
 21: 
 22: /** A magic circle lives 30 ticks. */
 23: const DEFAULT_SECONDS = 1.2;
 24: 
 25: /** Diameter in tiles: the heal circle is 3 tiles across. */
 26: const DEFAULT_SCALE = 3;
 27: 
 28: /** Biggest decal grid a pooled ring can draw (tiles); larger asks are clamped. */
 29: const MAX_SCALE = 8;
 30: 
 31: // ---- 2. state + readers ----------------------------------------------------
 32: 
 33: export interface RingOptions {
 34:   texture?: string;
 35:   colour?: RGB;
 36:   seconds?: number;
 37:   /** Diameter in tiles. */
 38:   scale?: number;
 39:   /** Scale multiplier at the end (2 = expands to double). */
 40:   grow?: number;
 41:   /** Scale multiplier at the start. */
 42:   growFrom?: number;
 43:   /** Degrees per second. */
 44:   spin?: number;
 45:   blend?: 'additive' | 'alpha';
 46:   fadeTail?: number;
 47: }
 48: 
 49: const live = new LiveList();
 50: const pools = new Map<string, TerrainDecal[]>();
 51: let seq = 0;
 52: 
 53: /** How many rings are drawn (debug). */
 54: export function ringCount(): number {
 55:   return live.size;
 56: }
 57: 
 58: function acquire(texture: string, blend: 'additive' | 'alpha'): TerrainDecal | null {
 59:   const world = Store.world;
 60:   if (!world) return null;
 61:   const key = `${texture}|${blend}`;
 62:   let pool = pools.get(key);
 63:   if (!pool) {
 64:     pool = [];
 65:     pools.set(key, pool);
 66:   }
 67:   return pool.pop() ?? new TerrainDecal(world, `fxRing${seq++}`, texture, MAX_SCALE, blend);
 68: }
 69: 
 70: /** Spawn helper other entries call directly (the level-up circle in bursts.ts). */
 71: export function spawnRing(_scene: Scene, at: Vector3, opts: RingOptions): EffectHandle {
 72:   const texture = opts.texture ?? TEX.magicCircle;
 73:   const blend = opts.blend ?? 'additive';
 74:   const decal = acquire(texture, blend);
 75:   const world = Store.world;
 76:   if (!decal || !world) return DEAD_HANDLE;
 77: 
 78:   const colour = opts.colour ?? RGBS.holy;
 79:   const seconds = opts.seconds ?? DEFAULT_SECONDS;
 80:   const scale = Math.min(MAX_SCALE, opts.scale ?? DEFAULT_SCALE);
 81:   const grow = opts.grow ?? 1;
 82:   const growFrom = opts.growFrom ?? 1;
 83:   const spin = opts.spin ?? 0;
 84:   const tail = opts.fadeTail ?? 0.35;
 85:   const x = at.x;
 86:   const z = at.z;
 87:   let t = 0;
 88: 
 89:   return live.push({
 90:     update(dt) {
 91:       t += dt;
 92:       const p = t / seconds;
 93:       if (p >= 1) return false;
 94:       const s = scale * lerp(growFrom, grow, p);
 95:       decal.setAlpha(fadeOut(p, tail));
 96:       decal.draw(world, x, z, Math.min(MAX_SCALE, s), spin * t, colour);
 97:       return true;
 98:     },
 99:     release() {
100:       decal.hide();
101:       pools.get(`${texture}|${blend}`)?.push(decal);
102:     },
103:   });
104: }
105: 
106: function update(_map: number, dt: number): void {
107:   live.update(dt);
108: }
109: 
110: function reset(): void {
111:   live.clear();
112:   // The decal meshes belong to the map that is going away.
113:   for (const pool of pools.values()) for (const d of pool) d.hide();
114:   pools.clear();
115: }
116: 
117: // ---- 3. the layer ----------------------------------------------------------
118: 
119: export const ringLayer: EffectLayer<RingOptions, 'ring'> = {
120:   name: 'ring',
121:   update,
122:   reset,
123:   spawn: spawnRing,
124: };
</file>

<file path="src/effects/sprite.ts">
  1: /**
  2:  * Sprite - a few additive billboard cards that appear at a point, grow, drift
  3:  * and fade. The original's `CreateEffect(BITMAP_*, …)` for a flash, an impact
  4:  * star, a spark cluster: each card lives a fixed number of ticks, scales
  5:  * with `Scale` and fades through `Alpha` (ZzzEffect.cpp `MoveEffect`).
  6:  *
  7:  * Driven by: `effects.spawn('sprite', …)` from the skill table and anything
  8:  * that wants a flash. Read by: nobody; it is fire-and-forget.
  9:  */
 10: import { Vector3, type Scene } from '../libs/babylon/exports';
 11: import {
 12:   LiveList,
 13:   acquireCard,
 14:   additiveMaterial,
 15:   releaseCard,
 16:   setCardCell,
 17:   fadeOut,
 18:   hash,
 19:   lerp,
 20:   pointSource,
 21:   type Card,
 22:   type PointSource,
 23:   type RGB,
 24:   type SheetCells,
 25: } from './core';
 26: import { RGBS } from './recipes';
 27: import type { EffectHandle, EffectLayer } from './layer';
 28: 
 29: // ---- 1. tuning -------------------------------------------------------------
 30: 
 31: /** Default lifetime: MU's usual 20-tick effect at 25 Hz. */
 32: const DEFAULT_SECONDS = 0.8;
 33: 
 34: /** Default card edge in tiles: 60 cm, a hand-sized flash. */
 35: const DEFAULT_SIZE = 0.6;
 36: 
 37: /** Fraction of the life spent growing from `grow.from` to the full size. */
 38: const GROW_FRACTION = 0.3;
 39: 
 40: // ---- 2. state + readers ----------------------------------------------------
 41: 
 42: export interface SpriteOptions {
 43:   /** `Effect/…` sheet (recipes.ts `TEX`). */
 44:   texture: string;
 45:   colour?: RGB;
 46:   /** Card edge in tiles. */
 47:   size?: number;
 48:   /** Lifetime in seconds. */
 49:   seconds?: number;
 50:   /** How many cards; more than one are jittered by `spread`. */
 51:   count?: number;
 52:   /** Random offset radius in tiles around `at` for each card. */
 53:   spread?: number;
 54:   /** Tiles per second upward drift (negative = fall). */
 55:   rise?: number;
 56:   /** World drift in tiles/s (the original's `Direction` per tick): a wave running along the facing. */
 57:   move?: readonly [number, number, number];
 58:   /** Size multiplier at the end of life (1 = constant, 2 = doubles). */
 59:   grow?: number;
 60:   /** Size multiplier at birth, before growing in over the first 30 %. */
 61:   growFrom?: number;
 62:   /** Radians per second the card turns on its axis. */
 63:   spin?: number;
 64:   /** Follow a moving point instead of staying where spawned. */
 65:   follow?: PointSource;
 66:   /** Tiles above `at` (or above the followed point) the cards sit. */
 67:   height?: number;
 68:   /** Non-billboard flat card laid on the ground (an impact ring). */
 69:   flat?: boolean;
 70:   /** Fade tail as a fraction of life (default 0.35). */
 71:   fadeTail?: number;
 72:   /**
 73:    * The texture is a sheet: play its cells once over the life, one card = one
 74:    * cell (BITMAP_EXPLOTION's `Frame = (20 − LifeTime) / 2`). Without this the
 75:    * whole sheet is one image - right for a single-frame flare, wrong for a
 76:    * sheet with white filler cells.
 77:    */
 78:   cells?: SheetCells;
 79: }
 80: 
 81: const live = new LiveList();
 82: 
 83: /** How many sprite cards are alive (debug). */
 84: export function spriteCount(): number {
 85:   return live.size;
 86: }
 87: 
 88: const tmp = new Vector3();
 89: let seed = 0;
 90: 
 91: function spawn(scene: Scene, at: Vector3, opts: SpriteOptions): EffectHandle {
 92:   const colour = opts.colour ?? RGBS.white;
 93:   const material = additiveMaterial(scene, opts.texture, colour);
 94:   const seconds = opts.seconds ?? DEFAULT_SECONDS;
 95:   const size = opts.size ?? DEFAULT_SIZE;
 96:   const count = Math.max(1, opts.count ?? 1);
 97:   const spread = opts.spread ?? 0;
 98:   const rise = opts.rise ?? 0;
 99:   const move = opts.move ?? [0, 0, 0];
100:   const grow = opts.grow ?? 1;
101:   const growFrom = opts.growFrom ?? 1;
102:   const spin = opts.spin ?? 0;
103:   const height = opts.height ?? 0;
104:   const tail = opts.fadeTail ?? 0.35;
105:   const cells = opts.cells;
106:   const source = opts.follow ? opts.follow : pointSource(at);
107: 
108:   const cards: Card[] = [];
109:   const offsets: Vector3[] = [];
110:   const phases: number[] = [];
111:   for (let i = 0; i < count; i++) {
112:     const card = acquireCard(scene, material, !opts.flat);
113:     if (opts.flat) card.rotation.x = Math.PI / 2;
114:     cards.push(card);
115:     const s = seed++;
116:     offsets.push(
117:       new Vector3(
118:         (hash(s) - 0.5) * 2 * spread,
119:         hash(s + 0.5) * spread * 0.5,
120:         (hash(s + 0.25) - 0.5) * 2 * spread
121:       )
122:     );
123:     phases.push(hash(s + 0.75) * Math.PI * 2);
124:   }
125: 
126:   let t = 0;
127:   // -1 until the sheet is loaded and a cell has actually been applied.
128:   let frame = -1;
129:   return live.push({
130:     update(dt) {
131:       t += dt;
132:       const p = t / seconds;
133:       if (p >= 1) return false;
134:       if (cells) {
135:         const f = Math.min(cells.count - 1, Math.floor(p * cells.count));
136:         if (f !== frame) {
137:           let applied = true;
138:           for (const c of cards) applied = setCardCell(c, cells, f) && applied;
139:           if (applied) frame = f;
140:         }
141:       }
142:       // Until the sheet is in, the card would be a solid square of the tint: hold it invisible.
143:       const ready = material.diffuseTexture ? 1 : 0;
144:       source(tmp);
145:       const grown = p < GROW_FRACTION ? lerp(growFrom, 1, p / GROW_FRACTION) : lerp(1, grow, (p - GROW_FRACTION) / (1 - GROW_FRACTION));
146:       const s = size * grown;
147:       // The original's `Alpha`: the card's colour fades to black (core.ts
148:       // `ADDITIVE_ALPHA_MODE`); it used to shrink instead.
149:       const vis = ready * fadeOut(p, tail);
150:       const y = height + rise * t;
151:       for (let i = 0; i < cards.length; i++) {
152:         const c = cards[i];
153:         const o = offsets[i];
154:         c.position.set(tmp.x + o.x + move[0] * t, tmp.y + o.y + y + move[1] * t, tmp.z + o.z + move[2] * t);
155:         c.scaling.setAll(s);
156:         c.visibility = vis;
157:         if (spin) {
158:           if (opts.flat) c.rotation.y = phases[i] + spin * t;
159:           else c.rotation.z = phases[i] + spin * t;
160:         }
161:       }
162:       return true;
163:     },
164:     release() {
165:       for (const c of cards) releaseCard(scene, c);
166:       cards.length = 0;
167:     },
168:   });
169: }
170: 
171: function update(_map: number, dt: number): void {
172:   live.update(dt);
173: }
174: 
175: function reset(): void {
176:   live.clear();
177: }
178: 
179: // ---- 3. the layer ----------------------------------------------------------
180: 
181: export const spriteLayer: EffectLayer<SpriteOptions, 'sprite'> = {
182:   name: 'sprite',
183:   update,
184:   reset,
185:   spawn,
186: };
</file>

<file path="src/events/_template.ts">
 1: /**
 2:  * TEMPLATE - copy this file to `<name>.ts`, fill in the blanks, add the layer
 3:  * to `layers.ts`. Never imported; it only exists to be copied.
 4:  *
 5:  * Every event file has the same three parts, in this order:
 6:  *
 7:  *   1. Tuning constants at the top, each with a comment saying what it is in
 8:  *      real units (seconds, maps, counts) and why it has that value.
 9:  *   2. Module state + the functions that read it. State lives here, not in
10:  *      the facade; it is a MobX `observable` so the HUD re-renders, and
11:  *      readers are plain functions (`templateTimer()`). Packet handlers
12:  *      (`EventBus.on('<PacketName>')`) resync the state; `update` counts.
13:  *   3. The exported `EventLayer` at the bottom, wiring `update` / `reset` /
14:  *      `state` and, for a ticket-opened event, `useTicket`.
15:  *
16:  * If the event has a window or HUD, draw it in
17:  * `ui/pages/worldPage/components/events/` reading this file's functions.
18:  * If an NPC opens it, add one `case` to `NpcWindowResponse` in `logic.ts`
19:  * calling a facade command. If a packet feeds it, subscribe here.
20:  */
21: import { observable, runInAction } from 'mobx';
22: import { ENUM_WORLD } from '../common/types';
23: import type { Item } from '../ecs/world';
24: import type { EventLayer } from './layer';
25: 
26: // ---- 1. tuning -------------------------------------------------------------
27: 
28: /** Maps this event runs on. */
29: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([ENUM_WORLD.WD_0LORENCIA]);
30: 
31: /** Seconds a match lasts when the server has not said otherwise. */
32: const MATCH_SECONDS = 15 * 60;
33: 
34: /** Ticket item that opens the event from the inventory. */
35: const TICKET = { group: 14, num: 0 };
36: 
37: // ---- 2. state + readers ----------------------------------------------------
38: 
39: const state = observable(
40:   {
41:     open: false,
42:     seconds: 0,
43:     running: false,
44:   },
45:   {},
46:   { deep: false }
47: );
48: 
49: /** The clock the HUD draws. */
50: export function templateTimer(): { seconds: number; running: boolean } {
51:   return { seconds: state.seconds, running: state.running };
52: }
53: 
54: export function openTemplate(): void {
55:   runInAction(() => {
56:     state.open = true;
57:   });
58: }
59: 
60: export function closeTemplate(): void {
61:   runInAction(() => {
62:     state.open = false;
63:   });
64: }
65: 
66: function useTicket(_slot: number, item: Item): boolean {
67:   if (item.group !== TICKET.group || item.num !== TICKET.num) return false;
68:   // Send the opening-state request here.
69:   return true;
70: }
71: 
72: function update(map: ENUM_WORLD, dt: number): void {
73:   if (!state.running || !MAPS.has(map)) return;
74:   runInAction(() => {
75:     state.seconds = Math.max(0, state.seconds - dt);
76:   });
77: }
78: 
79: function reset(): void {
80:   runInAction(() => {
81:     state.open = false;
82:     state.seconds = MATCH_SECONDS;
83:     state.running = false;
84:   });
85: }
86: 
87: // ---- 3. the layer ----------------------------------------------------------
88: 
89: export const templateLayer: EventLayer = {
90:   name: 'template',
91:   maps: MAPS,
92:   update,
93:   reset,
94:   state: () => ({ open: state.open, running: state.running }),
95:   useTicket,
96: };
</file>

<file path="src/events/chaosCastle.ts">
  1: import { observable, runInAction } from 'mobx';
  2: import { ENUM_WORLD } from '../common/types';
  3: import type { Item } from '../ecs/world';
  4: import { EventBus } from '../libs/eventBus';
  5: import { Store } from '../store';
  6: import {
  7:   ChaosCastleEnterRequestPacket,
  8:   MiniGameOpeningStateRequestPacket,
  9: } from '../common/packets/ClientToServerPackets';
 10: import {
 11:   BloodCastleStatePacket,
 12:   BloodCastleStateStatusEnum,
 13:   ChaosCastleEnterResultEnterResultEnum,
 14:   ChaosCastleEnterResultPacket,
 15:   MiniGameOpeningStatePacket,
 16:   MiniGameScoreTablePacket,
 17: } from '../common/packets/ServerToClientPackets';
 18: import type { EventLayer } from './layer';
 19: import { noteOpeningStateRequest, takeOpeningState } from './schedule';
 20: import {
 21:   EVENT_TEXT,
 22:   OPENING_STATE_GAME,
 23:   TICKETS,
 24:   formatText,
 25: } from './recipes';
 26: 
 27: /**
 28:  * Chaos Castle: there is no NPC window - the Armor of Guardsman in the
 29:  * inventory asks the server for the opening state, the answer is the
 30:  * `CChaosCastleTimeCheckMsgBoxLayout` prompt (`ReceiveEventZoneOpenTime`,
 31:  * Value 4) whose OK sends `ChaosCastleEnterRequest`. On the castle maps the
 32:  * timer HUD (`CNewUIChaosCastleTime`, NewUIChaosCastleTime.cpp) is fed by
 33:  * the same `BloodCastleState` packet as Blood Castle, states 5..10
 34:  * (`CNewChaosCastleSystem::SetMatchGameCommand`).
 35:  *
 36:  * Driven by: `useTicket`, `enterChaosCastle`, and the `MiniGameOpeningState`
 37:  * / `ChaosCastleEnterResult` / `BloodCastleState` / `MiniGameScoreTable`
 38:  * packets. Read by the prompt, timer and result table in
 39:  * `ui/pages/worldPage/components/events`.
 40:  *
 41:  * Not here: the shrinking arena (states 8..10 add `TW_NOGROUND` rings and
 42:  * play the falling-stone sound) - that is the map's business once the
 43:  * castle maps are staged.
 44:  */
 45: 
 46: // ---- 1. tuning -------------------------------------------------------------
 47: 
 48: /** Chaos Castle 1..6 (`WD_18CHAOS_CASTLE..WD_18CHAOS_CASTLE_END`) + the master castle. */
 49: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([
 50:   ENUM_WORLD.WD_18CHAOS_CASTLE,
 51:   ENUM_WORLD.WD_18CHAOS_CASTLE + 1,
 52:   ENUM_WORLD.WD_18CHAOS_CASTLE + 2,
 53:   ENUM_WORLD.WD_18CHAOS_CASTLE + 3,
 54:   ENUM_WORLD.WD_18CHAOS_CASTLE + 4,
 55:   ENUM_WORLD.WD_18CHAOS_CASTLE_END,
 56:   ENUM_WORLD.WD_53CAOSCASTLE_MASTER_LEVEL,
 57: ]);
 58: 
 59: /** `MAX_CHAOS_CASTLE_MEN`: the number the "castle is full" message quotes. */
 60: const MAX_MEN = 70;
 61: /** `GlobalText[1156]` third argument: the capacity the prompt shows. */
 62: const PROMPT_CAPACITY = 100;
 63: /** `MAX_KILL_MONSTER`: the server sends this when there is no count. */
 64: const NO_KILL_QUOTA = 65535;
 65: /** `SetTime`: the clock turns red under this many minutes. */
 66: const IMMINENT_MINUTES = 5;
 67: /** `SetMatchResult` drops tables of 200 rows and more. */
 68: const MAX_RANK_ROWS = 200;
 69: /** Seconds the rank table stays before it clears itself. */
 70: const RESULT_SECONDS = 20;
 71: /** How long the OK-box substitutes stay on screen. */
 72: const MESSAGE_MS = 5000;
 73: /**
 74:  * Level asked for when no ticket picked one: every castle level exists from
 75:  * 1 up, and OpenMU only reads the number when the hero fits no level range.
 76:  */
 77: const ASK_EVENT_LEVEL = 1;
 78: 
 79: // ---- 2. state + readers ----------------------------------------------------
 80: 
 81: export type ChaosCastleTimer = {
 82:   seconds: number;
 83:   /** Characters still standing (`GlobalText[1161]`). */
 84:   alive: number;
 85:   maxAlive: number;
 86:   running: boolean;
 87: };
 88: 
 89: export type ChaosCastlePrompt = {
 90:   lines: string[];
 91:   /** The gate is open right now: OK sends the enter request. */
 92:   canEnter: boolean;
 93: };
 94: 
 95: export type ChaosCastleResult = {
 96:   myRank: number;
 97:   rows: { name: string; score: number; exp: number; zen: number }[];
 98: };
 99: 
100: const state = observable(
101:   {
102:     prompt: null as ChaosCastlePrompt | null,
103:     timer: { seconds: 0, alive: 0, maxAlive: NO_KILL_QUOTA, running: false } as ChaosCastleTimer,
104:     result: null as ChaosCastleResult | null,
105:   },
106:   {},
107:   { deep: false }
108: );
109: 
110: /** The ticket the prompt was opened for: `(CastleLevel, inventory slot)`. */
111: let ticket: { level: number; slot: number } | null = null;
112: let resultLeft = 0;
113: 
114: export function chaosCastlePrompt(): ChaosCastlePrompt | null {
115:   return state.prompt;
116: }
117: 
118: export function chaosCastleTimer(): ChaosCastleTimer {
119:   return state.timer;
120: }
121: 
122: export function chaosCastleImminent(): boolean {
123:   return state.timer.seconds / 60 < IMMINENT_MINUTES;
124: }
125: 
126: export function chaosCastleResult(): ChaosCastleResult | null {
127:   return state.result;
128: }
129: 
130: export function inChaosCastle(map: ENUM_WORLD): boolean {
131:   return MAPS.has(map);
132: }
133: 
134: export function closeChaosCastlePrompt(): void {
135:   runInAction(() => {
136:     state.prompt = null;
137:   });
138:   ticket = null;
139: }
140: 
141: /** The prompt's OK: `ChaosCastleEnterRequest` for the ticket that opened it. */
142: export function enterChaosCastle(): void {
143:   const t = ticket;
144:   closeChaosCastlePrompt();
145:   if (!t) return;
146: 
147:   const packet = ChaosCastleEnterRequestPacket.createPacket();
148:   packet.CastleLevel = t.level;
149:   packet.TicketItemInventoryIndex = t.slot;
150:   Store.sendToGS(packet.buffer);
151: }
152: 
153: /**
154:  * The HUD row was clicked while the gate is open. Chaos Castle has no NPC
155:  * window: the same request the ticket sends raises the original's prompt,
156:  * with the head count on it. No ticket is held, so its OK only closes -
157:  * entering is still the Armor of Guardsman in the inventory.
158:  */
159: export function askChaosCastleOpening(): void {
160:   noteOpeningStateRequest(OPENING_STATE_GAME.chaosCastle);
161:   const packet = MiniGameOpeningStateRequestPacket.createPacket();
162:   packet.EventType = OPENING_STATE_GAME.chaosCastle;
163:   packet.EventLevel = ASK_EVENT_LEVEL;
164:   Store.sendToGS(packet.buffer);
165: }
166: 
167: /** Double-clicked Armor of Guardsman: ask for the opening state first. */
168: function useTicket(slot: number, item: Item): boolean {
169:   const t = TICKETS.armorOfGuardsman;
170:   if (item.group !== t.group || item.num !== t.num) return false;
171: 
172:   ticket = { level: item.lvl ?? 0, slot };
173:   noteOpeningStateRequest(OPENING_STATE_GAME.chaosCastle);
174:   const packet = MiniGameOpeningStateRequestPacket.createPacket();
175:   packet.EventType = OPENING_STATE_GAME.chaosCastle;
176:   packet.EventLevel = ticket.level;
177:   Store.sendToGS(packet.buffer);
178:   return true;
179: }
180: 
181: function update(map: ENUM_WORLD, dt: number): void {
182:   const t = state.timer;
183:   if (t.running && MAPS.has(map) && t.seconds > 0) {
184:     // Reassigned, not mutated: the observable is shallow.
185:     runInAction(() => {
186:       state.timer = { ...t, seconds: Math.max(0, t.seconds - dt) };
187:     });
188:   }
189: 
190:   if (state.result) {
191:     resultLeft -= dt;
192:     if (resultLeft <= 0) {
193:       runInAction(() => {
194:         state.result = null;
195:       });
196:     }
197:   }
198: }
199: 
200: function clearTimer(): void {
201:   runInAction(() => {
202:     state.timer = { seconds: 0, alive: 0, maxAlive: NO_KILL_QUOTA, running: false };
203:   });
204: }
205: 
206: function reset(): void {
207:   closeChaosCastlePrompt();
208:   clearTimer();
209:   runInAction(() => {
210:     state.result = null;
211:   });
212:   resultLeft = 0;
213: }
214: 
215: // ---- packets ---------------------------------------------------------------
216: 
217: /**
218:  * `ReceiveEventZoneOpenTime`, Value 4: `MAKEWORD(KeyL, KeyH)` minutes until
219:  * the gate opens; 0 means open now, with the head count on a second line.
220:  */
221: EventBus.on('MiniGameOpeningState', packet => {
222:   const p = new MiniGameOpeningStatePacket(packet);
223:   if (p.GameType !== OPENING_STATE_GAME.chaosCastle) return;
224: 
225:   const zone = EVENT_TEXT.chaosCastleZone;
226:   const minutes =
227:     (p.RemainingEnteringTimeMinutes << 8) | p.RemainingEnteringTimeMinutesLow;
228:   // The HUD rows ask the same question on their own timer; those answers
229:   // feed the schedule and raise no prompt.
230:   if (takeOpeningState(OPENING_STATE_GAME.chaosCastle, minutes)) return;
231: 
232:   let prompt: ChaosCastlePrompt;
233:   if (minutes === 0) {
234:     prompt = {
235:       lines: [
236:         formatText(EVENT_TEXT.enterNow, zone),
237:         formatText(EVENT_TEXT.ccEntered, zone, p.UserCount, PROMPT_CAPACITY),
238:       ],
239:       canEnter: true,
240:     };
241:   } else {
242:     const hours = Math.trunc(minutes / 60);
243:     // GlobalText[1164] + [851] as `WSclient.cpp:8234` concatenates them; the
244:     // "when %d " hour prefix only once there is an hour to name.
245:     const afterMinutes = formatText(
246:       EVENT_TEXT.enterAfterMinutes,
247:       minutes - hours * 60,
248:       zone
249:     );
250:     prompt = {
251:       lines: [
252:         hours > 0
253:           ? formatText(EVENT_TEXT.whenHour, hours) + afterMinutes
254:           : afterMinutes,
255:       ],
256:       canEnter: false,
257:     };
258:   }
259:   runInAction(() => {
260:     state.prompt = prompt;
261:   });
262: });
263: 
264: /** `ReceiveMoveToEventMatchResult2`. */
265: EventBus.on('ChaosCastleEnterResult', packet => {
266:   const p = new ChaosCastleEnterResultPacket(packet);
267:   closeChaosCastlePrompt();
268: 
269:   const zone = EVENT_TEXT.chaosCastleZone;
270:   let text: string | null = null;
271:   switch (p.Result) {
272:     case ChaosCastleEnterResultEnterResultEnum.Success:
273:       break;
274:     case ChaosCastleEnterResultEnterResultEnum.Failed:
275:       text = EVENT_TEXT.cloakLevelWrong;
276:       break;
277:     case ChaosCastleEnterResultEnterResultEnum.NotOpen:
278:       text = formatText(EVENT_TEXT.timePassed, zone);
279:       break;
280:     case ChaosCastleEnterResultEnterResultEnum.Full:
281:       text = formatText(EVENT_TEXT.capacityReached, zone, MAX_MEN);
282:       break;
283:     case ChaosCastleEnterResultEnterResultEnum.NotEnoughMoney:
284:       text = EVENT_TEXT.shortOfZen;
285:       break;
286:     case ChaosCastleEnterResultEnterResultEnum.PlayerKillerCantEnter:
287:       text = formatText(EVENT_TEXT.killersRestricted, EVENT_TEXT.chaosCastle);
288:       break;
289:     default:
290:       // 3 / 4 of the original's switch: level out of range.
291:       text =
292:         (p.Result as number) === 3 ? EVENT_TEXT.levelTooHigh : EVENT_TEXT.levelTooLow;
293:       break;
294:   }
295:   if (text) Store.addNotification(text, 'error', MESSAGE_MS);
296: });
297: 
298: /** `CNewChaosCastleSystem::SetMatchGameCommand`: states 5..10. */
299: EventBus.on('BloodCastleState', packet => {
300:   const p = new BloodCastleStatePacket(packet);
301: 
302:   switch (p.State) {
303:     case BloodCastleStateStatusEnum.ChaosCastleRunning:
304:       runInAction(() => {
305:         state.timer = {
306:           seconds: p.RemainSecond,
307:           alive: p.CurMonster,
308:           maxAlive: p.MaxMonster,
309:           running: true,
310:         };
311:       });
312:       break;
313:     case BloodCastleStateStatusEnum.ChaosCastleEnded:
314:       clearTimer();
315:       break;
316:     default:
317:       // 5 = started (no clock yet), 8..10 = arena stages; 0..4 = Blood Castle.
318:       break;
319:   }
320: });
321: 
322: /** The shared 0x93 rank table, taken only on the castle maps. */
323: EventBus.on('MiniGameScoreTable', packet => {
324:   if (!MAPS.has(Store.world?.mapIndex ?? ENUM_WORLD.WD_0LORENCIA)) return;
325: 
326:   const p = new MiniGameScoreTablePacket(packet);
327:   if (p.ResultCount >= MAX_RANK_ROWS) return;
328: 
329:   resultLeft = RESULT_SECONDS;
330:   runInAction(() => {
331:     state.result = {
332:       myRank: p.PlayerRank,
333:       rows: p.getResults().map(r => ({
334:         name: r.PlayerName,
335:         // Signed on the wire, read as uint32 by the generated packet (B12).
336:         score: r.TotalScore | 0,
337:         exp: r.BonusExperience,
338:         zen: r.BonusMoney,
339:       })),
340:     };
341:   });
342: });
343: 
344: // ---- 3. the layer ----------------------------------------------------------
345: 
346: export const chaosCastleLayer: EventLayer = {
347:   name: 'chaosCastle',
348:   maps: MAPS,
349:   update,
350:   reset,
351:   state: () => ({ open: state.prompt !== null, running: state.timer.running }),
352:   useTicket,
353: };
</file>

<file path="src/events/crywolf.ts">
  1: import { observable, runInAction } from 'mobx';
  2: import { ENUM_WORLD } from '../common/types';
  3: import { EventBus } from '../libs/eventBus';
  4: import { Store } from '../store';
  5: import {
  6:   CrywolfContractRequestPacket,
  7:   CrywolfInfoRequestPacket,
  8: } from '../common/packets/ClientToServerPackets';
  9: import {
 10:   CrywolfAltarInfoPacket,
 11:   CrywolfBenefitPacket,
 12:   CrywolfBossMonsterInfoPacket,
 13:   CrywolfContractResultPacket,
 14:   CrywolfLeftTimePacket,
 15:   CrywolfStateInfoPacket,
 16:   CrywolfStateInfoEventStateEnum as CrywolfState,
 17:   CrywolfStateInfoOccupationStateEnum as Occupation,
 18: } from '../common/packets/ServerToClientPackets';
 19: import type { EventLayer } from './layer';
 20: import { EVENT_TEXT, formatText } from './recipes';
 21: 
 22: export {
 23:   CrywolfStateInfoEventStateEnum as CrywolfState,
 24:   CrywolfStateInfoOccupationStateEnum as CrywolfOccupation,
 25: } from '../common/packets/ServerToClientPackets';
 26: 
 27: /**
 28:  * Crywolf: the fortress event's state (`M34CryWolf1st`, GMCrywolf1st.cpp),
 29:  * the interface bar's numbers (`CNewUICryWolf`, NewUICryWolf.cpp) and the
 30:  * statue contract. OpenMU defines the three 0xBD requests but implements
 31:  * none of the event (`Progress.md`: CrywolfGroup 0%), so against a stock
 32:  * server this layer stays in its peace defaults; the answers it reads are
 33:  * the S6E3 layouts (WSclient.cpp:13911-13955) for servers that send them.
 34:  *
 35:  * Driven by: `warpCompleted` (the info request, WSclient.cpp:789) and the
 36:  * `CrywolfStateInfo` / `CrywolfAltarInfo` / `CrywolfContractResult` /
 37:  * `CrywolfLeftTime` / `CrywolfBossMonsterInfo` / `CrywolfBenefit` packets.
 38:  * Read by: `CrywolfBar` in `ui/pages/worldPage/components/events` and the
 39:  * staging classes in `maps/crywolf`.
 40:  */
 41: 
 42: // ---- 1. tuning -------------------------------------------------------------
 43: 
 44: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([ENUM_WORLD.WD_34CRYWOLF_1ST]);
 45: 
 46: /** `MONSTER_WOLF_STATUS`: the wolf statue NPC the contract goes to. */
 47: const STATUE_NPC = 204;
 48: 
 49: /** `m_AltarState` boot value: every altar idle, grade 2. */
 50: const IDLE_ALTAR = 2;
 51: 
 52: /** `TotDelay` at 25 fps: how long the success/failure banner stays. */
 53: const RESULT_SECONDS = 16;
 54: 
 55: /** `GlobalText[1948]` cap: the dark elf line reads (n/12). */
 56: export const DARK_ELF_MAX = 12;
 57: 
 58: /** `GetTimeCheck(10000)`: seconds each ready-state notice page stays. */
 59: const NOTICE_PAGE_SECONDS = 10;
 60: const NOTICE_PAGES = 4;
 61: 
 62: const MESSAGE_MS = 5000;
 63: 
 64: // ---- 2. state + readers ----------------------------------------------------
 65: 
 66: export type CrywolfHud = {
 67:   occupation: Occupation;
 68:   state: CrywolfState;
 69:   /** 0..100, the statue shield the bar erodes. */
 70:   statueHp: number;
 71:   /** Packed bytes: high nibble contracted flag, low nibble grade. */
 72:   altars: readonly number[];
 73:   darkElves: number;
 74:   /** 0..100; the Balgass strip shows while > 0. */
 75:   balgassHp: number;
 76:   /** Seconds left of the war, counted down between `CrywolfLeftTime` resyncs. */
 77:   seconds: number;
 78: };
 79: 
 80: const state = observable(
 81:   {
 82:     occupation: Occupation.Peace,
 83:     state: CrywolfState.None,
 84:     statueHp: 0,
 85:     altars: [IDLE_ALTAR, IDLE_ALTAR, IDLE_ALTAR, IDLE_ALTAR, IDLE_ALTAR] as readonly number[],
 86:     darkElves: 0,
 87:     balgassHp: 0,
 88:     seconds: 0,
 89:     timeRunning: false,
 90:     /** `Suc_Or_Fail`: the end-of-war banner, or null. */
 91:     result: null as boolean | null,
 92:     noticePage: 0,
 93:   },
 94:   {},
 95:   { deep: false }
 96: );
 97: 
 98: let resultLeft = 0;
 99: let noticeLeft = NOTICE_PAGE_SECONDS;
100: 
101: /** Everything the interface bar draws. */
102: export function crywolfHud(): CrywolfHud {
103:   return state;
104: }
105: 
106: /** `g_pNewUISystem->Show(INTERFACE_CRYWOLF)`: bar up from READY until END. */
107: export function crywolfBarVisible(map: ENUM_WORLD): boolean {
108:   return (
109:     MAPS.has(map) &&
110:     state.state >= CrywolfState.Ready &&
111:     state.state < CrywolfState.EndCycle
112:   );
113: }
114: 
115: /** The end banner: true success, false failure, null none. */
116: export function crywolfResult(): boolean | null {
117:   return state.result;
118: }
119: 
120: /** `RenderNoticesCryWolf`: which four-line notice page is up (READY only). */
121: export function crywolfNoticePage(): number {
122:   return state.noticePage;
123: }
124: 
125: export function inCrywolf(map: ENUM_WORLD): boolean {
126:   return MAPS.has(map);
127: }
128: 
129: /** `SendCrywolfContractRequest`: talk to the wolf statue during READY. */
130: function useNpc(npc: { netId: number; npcType: number }): boolean {
131:   if (npc.npcType !== STATUE_NPC) return false;
132:   if (Store.world === null || !MAPS.has(Store.world.mapIndex)) return false;
133: 
134:   if (state.state === CrywolfState.Ready && !Store.isOffline) {
135:     const packet = CrywolfContractRequestPacket.createPacket();
136:     packet.StatueId = npc.netId;
137:     Store.sendToGS(packet.buffer);
138:   }
139:   // The statue never opens a server window; consume the talk either way.
140:   return true;
141: }
142: 
143: function update(map: ENUM_WORLD, dt: number): void {
144:   if (state.timeRunning && MAPS.has(map) && state.seconds > 0) {
145:     runInAction(() => {
146:       state.seconds = Math.max(0, state.seconds - dt);
147:       if (state.seconds === 0) state.timeRunning = false;
148:     });
149:   }
150: 
151:   if (state.result !== null) {
152:     resultLeft -= dt;
153:     if (resultLeft <= 0) {
154:       runInAction(() => {
155:         state.result = null;
156:       });
157:     }
158:   }
159: 
160:   if (state.state === CrywolfState.Ready && MAPS.has(map)) {
161:     noticeLeft -= dt;
162:     if (noticeLeft <= 0) {
163:       noticeLeft = NOTICE_PAGE_SECONDS;
164:       runInAction(() => {
165:         state.noticePage = (state.noticePage + 1) % NOTICE_PAGES;
166:       });
167:     }
168:   }
169: }
170: 
171: /** `CryWolfMVPInit` (WSclient.cpp:688): every warp drops the tracked event. */
172: function reset(): void {
173:   resultLeft = 0;
174:   noticeLeft = NOTICE_PAGE_SECONDS;
175:   runInAction(() => {
176:     state.occupation = Occupation.Peace;
177:     state.state = CrywolfState.None;
178:     state.statueHp = 0;
179:     state.altars = [IDLE_ALTAR, IDLE_ALTAR, IDLE_ALTAR, IDLE_ALTAR, IDLE_ALTAR];
180:     state.darkElves = 0;
181:     state.balgassHp = 0;
182:     state.seconds = 0;
183:     state.timeRunning = false;
184:     state.result = null;
185:     state.noticePage = 0;
186:   });
187: }
188: 
189: // ---- packets ---------------------------------------------------------------
190: 
191: /** WSclient.cpp:789: entering the map asks for the event state. */
192: EventBus.on('warpCompleted', ({ map }) => {
193:   if (!MAPS.has(map) || Store.isOffline) return;
194:   Store.sendToGS(CrywolfInfoRequestPacket.createPacket().buffer);
195: });
196: 
197: /** `CheckCryWolf1stMVP`: the state pair, and the end-of-war banner. */
198: EventBus.on('CrywolfStateInfo', packet => {
199:   const p = new CrywolfStateInfoPacket(packet);
200:   const occupation = p.Occupation;
201:   const next = p.State;
202:   if (occupation === state.occupation && next === state.state) return;
203: 
204:   runInAction(() => {
205:     // `if (m_CrywolfState == CRYWOLF_STATE_END)`: outside the war the banner
206:     // says whether the defence held (peace) or the fortress fell (occupied).
207:     if (next === CrywolfState.Ended && occupation !== Occupation.War) {
208:       state.result = occupation === Occupation.Peace;
209:       resultLeft = RESULT_SECONDS;
210:     }
211:     if (next !== CrywolfState.Started) state.balgassHp = 0;
212:     state.occupation = occupation;
213:     state.state = next;
214:   });
215: });
216: 
217: /** `CheckCryWolf1stMVPAltarfInfo`: statue shield plus the five altars. */
218: EventBus.on('CrywolfAltarInfo', packet => {
219:   const p = new CrywolfAltarInfoPacket(packet);
220:   runInAction(() => {
221:     state.statueHp = p.StatueHp;
222:     state.altars = [
223:       p.AltarState1,
224:       p.AltarState2,
225:       p.AltarState3,
226:       p.AltarState4,
227:       p.AltarState5,
228:     ];
229:   });
230: });
231: 
232: /** `ReceiveCrywolfAltarContract` (WSclient.cpp:11431). */
233: EventBus.on('CrywolfContractResult', packet => {
234:   const p = new CrywolfContractResultPacket(packet);
235:   if (p.Result === 1) {
236:     Store.addNotification(EVENT_TEXT.cwContractMade, 'info', MESSAGE_MS);
237:   } else {
238:     Store.addNotification(EVENT_TEXT.cwContractRefused, 'error', MESSAGE_MS);
239:   }
240: });
241: 
242: /** `M34CryWolf1st::SetTime`: only meaningful while the war runs. */
243: EventBus.on('CrywolfLeftTime', packet => {
244:   const p = new CrywolfLeftTimePacket(packet);
245:   if (state.state !== CrywolfState.Started) return;
246:   runInAction(() => {
247:     state.seconds = p.Hour * 3600 + p.Minute * 60;
248:     state.timeRunning = true;
249:   });
250: });
251: 
252: /** `Set_BossMonster`: the Balgass strip and the dark elf count. */
253: EventBus.on('CrywolfBossMonsterInfo', packet => {
254:   const p = new CrywolfBossMonsterInfoPacket(packet);
255:   if (state.state < CrywolfState.Ready || state.state >= CrywolfState.EndCycle) return;
256:   runInAction(() => {
257:     state.darkElves = p.DarkElfCount;
258:     state.balgassHp = Math.max(0, p.BossHp | 0);
259:   });
260: });
261: 
262: /** `SetPlusChaosRate`: a won event raises mix rates; surface it as a line. */
263: EventBus.on('CrywolfBenefit', packet => {
264:   const p = new CrywolfBenefitPacket(packet);
265:   if (p.ChaosRatePlus > 0) {
266:     Store.addNotification(
267:       formatText(EVENT_TEXT.cwBenefit, p.ChaosRatePlus),
268:       'info',
269:       MESSAGE_MS
270:     );
271:   }
272: });
273: 
274: // ---- 3. the layer ----------------------------------------------------------
275: 
276: export const crywolfLayer: EventLayer = {
277:   name: 'crywolf',
278:   maps: MAPS,
279:   update,
280:   reset,
281:   state: () => ({
282:     open: false,
283:     running:
284:       state.state >= CrywolfState.Ready && state.state < CrywolfState.EndCycle,
285:   }),
286:   useNpc,
287: };
</file>

<file path="src/events/doppelganger.ts">
 1: import { observable, runInAction } from 'mobx';
 2: import { ENUM_WORLD } from '../common/types';
 3: import { Store } from '../store';
 4: import { DoppelgangerEnterRequestPacket } from '../common/packets/ClientToServerPackets';
 5: import type { EventLayer } from './layer';
 6: 
 7: /**
 8:  * Doppelganger: Lugard's gate window (`CNewUIDoppelGangerWindow`,
 9:  * NewUIDoppelGangerWindow.cpp). OpenMU only defines the entry protocol -
10:  * `NpcWindowResponse` (LugardDoppelgangerEntry) opens the window, the Enter
11:  * button sends `DoppelgangerEnterRequest` - and its server answers every
12:  * Doppelganger request with "not implemented yet": no state, result or HUD
13:  * packet exists, so the in-event frame (`CNewUIDoppelGangerFrame`) is not
14:  * ported until the server runs the event.
15:  *
16:  * Driven by: `NpcWindowResponse` (LugardDoppelgangerEntry) via
17:  * `openDoppelganger`. Read by: the entry window in
18:  * `ui/pages/worldPage/components/events`, and `logic.ts` through the facade.
19:  */
20: 
21: // ---- 1. tuning -------------------------------------------------------------
22: 
23: /** The four arenas (`WD_65DOPPLEGANGER1 .. WD_68DOPPLEGANGER4`). */
24: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([
25:   ENUM_WORLD.WD_65DOPPLEGANGER1,
26:   ENUM_WORLD.WD_66DOPPLEGANGER2,
27:   ENUM_WORLD.WD_67DOPPLEGANGER3,
28:   ENUM_WORLD.WD_68DOPPLEGANGER4,
29: ]);
30: 
31: /** `BtnProcess`: "no inventory slot, take any Mirror of Dimensions". */
32: const NO_TICKET_SLOT = 0xff;
33: 
34: // ---- 2. state + readers ----------------------------------------------------
35: 
36: const state = observable(
37:   {
38:     open: false,
39:     // `SetRemainTime`: minutes until the gate opens; non-zero locks Enter.
40:     // The original reads it from a byte after the window id that OpenMU's
41:     // NpcWindowResponse does not carry, so it stays 0 (enterable).
42:     remainMinutes: 0,
43:   },
44:   {},
45:   { deep: false }
46: );
47: 
48: /** Lugard's window: whether it is up and the Entry Time it shows. */
49: export function doppelgangerWindow(): { open: boolean; remainMinutes: number } {
50:   return { open: state.open, remainMinutes: state.remainMinutes };
51: }
52: 
53: /** `OpeningProcess`: unlock the Enter button and show the window. */
54: export function openDoppelganger(): void {
55:   runInAction(() => {
56:     state.remainMinutes = 0;
57:     state.open = true;
58:   });
59: }
60: 
61: export function closeDoppelganger(): void {
62:   runInAction(() => {
63:     state.open = false;
64:   });
65: }
66: 
67: /** `SendDoppelgangerEnterRequest(0xFF)`: the Enter button. */
68: export function enterDoppelganger(): void {
69:   if (state.remainMinutes !== 0) return;
70:   const packet = DoppelgangerEnterRequestPacket.createPacket();
71:   packet.TicketItemSlot = NO_TICKET_SLOT;
72:   Store.sendToGS(packet.buffer);
73: }
74: 
75: function reset(): void {
76:   closeDoppelganger();
77: }
78: 
79: // ---- 3. the layer ----------------------------------------------------------
80: 
81: export const doppelgangerLayer: EventLayer = {
82:   name: 'doppelganger',
83:   maps: MAPS,
84:   reset,
85:   state: () => ({ open: state.open, running: false }),
86: };
</file>

<file path="src/events/duel.ts">
  1: import { observable, runInAction } from 'mobx';
  2: import type { ENUM_WORLD } from '../common/types';
  3: import { cleanName } from '../common/chat';
  4: import { EventBus } from '../libs/eventBus';
  5: import { playUiSound } from '../libs/sfx';
  6: import { Store } from '../store';
  7: import { t } from '../i18n';
  8: import {
  9:   DuelChannelJoinRequestPacket,
 10:   DuelChannelQuitRequestPacket,
 11:   DuelStartResponsePacket,
 12: } from '../common/packets/ClientToServerPackets';
 13: import {
 14:   DuelFinishedPacket,
 15:   DuelHealthUpdatePacket,
 16:   DuelInitPacket,
 17:   DuelScorePacket,
 18:   DuelSpectatorAddedPacket,
 19:   DuelSpectatorListPacket,
 20:   DuelSpectatorRemovedPacket,
 21:   DuelStartRequestPacket as DuelStartRequestS2CPacket,
 22:   DuelStartResultPacket,
 23:   DuelStatusPacket,
 24: } from '../common/packets/ServerToClientPackets';
 25: import type { EventLayer } from './layer';
 26: import {
 27:   duelStartFailureKey,
 28:   orientPair,
 29:   orientValues,
 30:   presentSpectators,
 31:   roomCountOf,
 32: } from './duelRules';
 33: 
 34: /**
 35:  * Duel (`DuelMgr.cpp`): the request prompt (`CDuelMsgBoxLayout`), the duelist
 36:  * score panel (`CNewUIDuelWindow`), the Doorkeeper Titus channel window
 37:  * (`CNewUIDuelWatchWindow`), the spectator bar and name list
 38:  * (`CNewUIDuelWatchMainFrameWindow`, `CNewUIDuelWatchUserListWindow`) and the
 39:  * result box (`CDuelResultMsgBox`).
 40:  *
 41:  * Driven by: the twelve `Duel*` S2C packets (all `0xAA`), the Titus
 42:  * `NpcWindowResponse` via `openDuelWatch`, and `commands.ts` (`/duelstart`,
 43:  * `/duelend` keep sending `DuelStartRequest` / `DuelStopRequest` unchanged).
 44:  * Read by: `ui/pages/worldPage/components/duel`, and `duelEnemyId` by
 45:  * `ecs/systems/attackSystem` for the click rules.
 46:  *
 47:  * Duel state survives `reset()`: the accept -> warp -> `DuelInit` sequence
 48:  * crosses a map change, and the original clears `g_DuelMgr` only on duel end
 49:  * or connection close (`WSclient.cpp:646`), never on warp.
 50:  */
 51: 
 52: // ---- 1. tuning -------------------------------------------------------------
 53: 
 54: /** Seconds the winner/loser box stays before it clears itself. */
 55: const RESULT_SECONDS = 10;
 56: /** How long the notification substitutes stay on screen. */
 57: const MESSAGE_MS = 5000;
 58: 
 59: // ---- 2. state + readers ----------------------------------------------------
 60: 
 61: export type DuelSide = { id: number; name: string };
 62: 
 63: export type DuelScoreboard = {
 64:   /** The hero for a duelist (`InitializeDuelPlugIn` puts the receiver first). */
 65:   side1: DuelSide;
 66:   side2: DuelSide;
 67:   score1: number;
 68:   score2: number;
 69:   /** The hero is a spectator, not one of the two sides. */
 70:   watching: boolean;
 71: };
 72: 
 73: export type DuelBars = { hp1: number; sd1: number; hp2: number; sd2: number };
 74: 
 75: export type DuelChannel = {
 76:   name1: string;
 77:   name2: string;
 78:   running: boolean;
 79:   open: boolean;
 80: };
 81: 
 82: const FULL_BARS: DuelBars = { hp1: 100, sd1: 100, hp2: 100, sd2: 100 };
 83: 
 84: const state = observable(
 85:   {
 86:     request: null as { requesterId: number; requesterName: string } | null,
 87:     duel: null as DuelScoreboard | null,
 88:     bars: null as DuelBars | null,
 89:     watchOpen: false,
 90:     channels: [] as DuelChannel[],
 91:     spectators: [] as string[],
 92:     result: null as { winner: string; loser: string } | null,
 93:   },
 94:   {},
 95:   { deep: false }
 96: );
 97: 
 98: let resultLeft = 0;
 99: 
100: /** The incoming challenge the prompt shows, or null. */
101: export function duelRequest(): { requesterId: number; requesterName: string } | null {
102:   return state.request;
103: }
104: 
105: /** Sides and scores of the running duel, or null. */
106: export function duelScoreboard(): DuelScoreboard | null {
107:   return state.duel;
108: }
109: 
110: /** Spectator HP/SD percentages; null while not watching. */
111: export function duelBars(): DuelBars | null {
112:   return state.bars;
113: }
114: 
115: /** The Titus window: whether it is up and its channel rows. */
116: export function duelWatchWindow(): { open: boolean; channels: DuelChannel[] } {
117:   return { open: state.watchOpen, channels: state.channels };
118: }
119: 
120: /** Names watching the same duel (spectator list beside the bar). */
121: export function duelSpectators(): string[] {
122:   return state.spectators;
123: }
124: 
125: /** The winner/loser box, or null when there is none. */
126: export function duelResult(): { winner: string; loser: string } | null {
127:   return state.result;
128: }
129: 
130: /**
131:  * `IsDuelPlayer(c, DUEL_ENEMY)`: the other duelist's id while the hero is
132:  * one of the two sides; null with no duel, or when the hero only watches.
133:  */
134: export function duelEnemyId(): number | null {
135:   const duel = state.duel;
136:   if (!duel || duel.watching) return null;
137:   const hero = heroNetId();
138:   if (hero === duel.side1.id) return duel.side2.id;
139:   if (hero === duel.side2.id) return duel.side1.id;
140:   return null;
141: }
142: 
143: /** `NpcWindowResponse` DoorkeeperTitusDuelWatch: rows arrive by `DuelStatus`. */
144: export function openDuelWatch(): void {
145:   runInAction(() => {
146:     state.watchOpen = true;
147:   });
148: }
149: 
150: export function closeDuelWatch(): void {
151:   runInAction(() => {
152:     state.watchOpen = false;
153:   });
154: }
155: 
156: /** `SendDuelRequestAnswer` (DuelMgr.cpp): the prompt's OK / Cancel. */
157: export function answerDuelRequest(accepted: boolean): void {
158:   const request = state.request;
159:   if (!request) return;
160:   runInAction(() => {
161:     state.request = null;
162:   });
163:   if (Store.isOffline) return;
164:   const packet = DuelStartResponsePacket.createPacket();
165:   packet.Response = accepted;
166:   packet.PlayerId = request.requesterId;
167:   packet.setPlayerName(request.requesterName);
168:   Store.sendToGS(packet.buffer);
169: }
170: 
171: /** `SendDuelChannelJoinRequest(i)`: a watch-window join button. */
172: export function joinDuelChannel(channel: number): void {
173:   if (Store.isOffline) return;
174:   const packet = DuelChannelJoinRequestPacket.createPacket();
175:   packet.ChannelId = channel;
176:   Store.sendToGS(packet.buffer);
177: }
178: 
179: /**
180:  * `SendDuelChannelQuitRequest`: the spectator bar's exit. The server answers
181:  * with a warp only, so the watching state clears here.
182:  */
183: export function quitDuelChannel(): void {
184:   if (!Store.isOffline) {
185:     Store.sendToGS(DuelChannelQuitRequestPacket.createPacket().buffer);
186:   }
187:   clearDuel();
188: }
189: 
190: function clearDuel(): void {
191:   runInAction(() => {
192:     state.duel = null;
193:     state.bars = null;
194:     state.spectators = [];
195:   });
196: }
197: 
198: function update(_map: ENUM_WORLD, dt: number): void {
199:   if (!state.result) return;
200:   resultLeft -= dt;
201:   if (resultLeft <= 0) {
202:     runInAction(() => {
203:       state.result = null;
204:     });
205:   }
206: }
207: 
208: /** Map changed: transient UI only - `duel` itself survives the arena warp. */
209: function reset(): void {
210:   runInAction(() => {
211:     state.request = null;
212:     state.watchOpen = false;
213:     state.channels = [];
214:     state.result = null;
215:   });
216:   resultLeft = 0;
217: }
218: 
219: // ---- packets ---------------------------------------------------------------
220: 
221: const ID_MASK = 0x7fff;
222: 
223: function heroNetId(): number | null {
224:   return Store.world?.playerEntity?.netId ?? null;
225: }
226: 
227: /** `ReceiveDuelRequest`: the challenge prompt. */
228: EventBus.on('DuelStartRequest', packet => {
229:   const p = new DuelStartRequestS2CPacket(packet);
230:   playUiSound('duelWindow');
231:   runInAction(() => {
232:     state.request = {
233:       requesterId: p.RequesterId & ID_MASK,
234:       requesterName: cleanName(p.RequesterName),
235:     };
236:   });
237: });
238: 
239: /** `ReceiveDuelStart`: our own request was answered (or failed early). */
240: EventBus.on('DuelStartResult', packet => {
241:   const p = new DuelStartResultPacket(packet);
242:   const name = cleanName(p.OpponentName);
243:   const failure = duelStartFailureKey(p.Result);
244:   if (failure === null) {
245:     playUiSound('duelStart');
246:     Store.addNotification(t('duel.started', { name }), 'info', MESSAGE_MS);
247:     return;
248:   }
249:   const text =
250:     failure === 'duel.refused' ? t(failure, { name }) : t(failure);
251:   Store.addNotification(text, 'error', MESSAGE_MS);
252: });
253: 
254: /** `ReceiveDuelWatchRequestReply` + duel start: sides, ids, perspective. */
255: EventBus.on('DuelInit', packet => {
256:   const p = new DuelInitPacket(packet);
257:   if (p.Result !== 0) return;
258:   const side1: DuelSide = { id: p.Player1Id & ID_MASK, name: cleanName(p.Player1Name) };
259:   const side2: DuelSide = { id: p.Player2Id & ID_MASK, name: cleanName(p.Player2Name) };
260:   const hero = heroNetId();
261:   const watching = hero !== side1.id && hero !== side2.id;
262:   playUiSound('duelStart');
263:   runInAction(() => {
264:     state.duel = { side1, side2, score1: 0, score2: 0, watching };
265:     state.bars = watching ? FULL_BARS : null;
266:     if (watching) state.watchOpen = false;
267:   });
268: });
269: 
270: /** Spectators only, right after `DuelInit`: bars back to full. */
271: EventBus.on('DuelHealthBarInit', () => {
272:   if (!state.duel?.watching) return;
273:   runInAction(() => {
274:     state.bars = FULL_BARS;
275:   });
276: });
277: 
278: /** `ReceiveDuelScore` (WSclient.cpp:8465): scores by id, not by order. */
279: EventBus.on('DuelScore', packet => {
280:   const duel = state.duel;
281:   if (!duel) return;
282:   const p = new DuelScorePacket(packet);
283:   const way = orientPair(duel.side1.id, duel.side2.id, p.Player1Id, p.Player2Id);
284:   if (!way) return;
285:   const [score1, score2] = orientValues(way, p.Player1Score, p.Player2Score);
286:   runInAction(() => {
287:     state.duel = { ...duel, score1, score2 };
288:   });
289: });
290: 
291: /** `ReceiveDuelHP`: the spectator gauges. */
292: EventBus.on('DuelHealthUpdate', packet => {
293:   const duel = state.duel;
294:   if (!duel) return;
295:   const p = new DuelHealthUpdatePacket(packet);
296:   const way = orientPair(duel.side1.id, duel.side2.id, p.Player1Id, p.Player2Id);
297:   if (!way) return;
298:   const [hp1, hp2] = orientValues(way, p.Player1HealthPercentage, p.Player2HealthPercentage);
299:   const [sd1, sd2] = orientValues(way, p.Player1ShieldPercentage, p.Player2ShieldPercentage);
300:   runInAction(() => {
301:     state.bars = { hp1, sd1, hp2, sd2 };
302:   });
303: });
304: 
305: /** `ReceiveDuelEnd`: OpenMU always sends Result 0 and no name - just clear. */
306: EventBus.on('DuelEnd', () => {
307:   if (state.duel && !state.duel.watching) {
308:     Store.addNotification(t('duel.ended'), 'info', MESSAGE_MS);
309:   }
310:   clearDuel();
311: });
312: 
313: /** `ReceiveDuelResult`: the winner/loser box. */
314: EventBus.on('DuelFinished', packet => {
315:   const p = new DuelFinishedPacket(packet);
316:   playUiSound('duelWindow');
317:   resultLeft = RESULT_SECONDS;
318:   runInAction(() => {
319:     state.result = { winner: cleanName(p.Winner), loser: cleanName(p.Loser) };
320:   });
321: });
322: 
323: /** `ReceiveDuelChannelList`: pushed every 5 s while the Titus window is open. */
324: EventBus.on('DuelStatus', packet => {
325:   const p = new DuelStatusPacket(packet);
326:   const rooms = p.getRooms(roomCountOf(packet.byteLength));
327:   runInAction(() => {
328:     state.channels = rooms.map(room => ({
329:       name1: cleanName(room.Player1Name),
330:       name2: cleanName(room.Player2Name),
331:       running: Boolean(room.DuelRunning),
332:       open: Boolean(room.DuelOpen),
333:     }));
334:   });
335: });
336: 
337: /** `ReceiveDuelWatcherJoin` / `Quit` / `List`. */
338: EventBus.on('DuelSpectatorAdded', packet => {
339:   const p = new DuelSpectatorAddedPacket(packet);
340:   const name = cleanName(p.Name);
341:   if (!name || state.spectators.includes(name)) return;
342:   runInAction(() => {
343:     state.spectators = [...state.spectators, name];
344:   });
345: });
346: 
347: EventBus.on('DuelSpectatorRemoved', packet => {
348:   const p = new DuelSpectatorRemovedPacket(packet);
349:   const name = cleanName(p.Name);
350:   runInAction(() => {
351:     state.spectators = state.spectators.filter(n => n !== name);
352:   });
353: });
354: 
355: EventBus.on('DuelSpectatorList', packet => {
356:   const p = new DuelSpectatorListPacket(packet);
357:   // OpenMU never fills Count: read every slot, keep the real names.
358:   const names = presentSpectators(p.getSpectators(10).map(s => s.Name));
359:   runInAction(() => {
360:     state.spectators = names;
361:   });
362: });
363: 
364: /** `DuelMgr.Reset()` on connection close (WSclient.cpp:646). */
365: EventBus.on('wsClosed', () => {
366:   clearDuel();
367:   reset();
368: });
369: 
370: // ---- 3. the layer ----------------------------------------------------------
371: 
372: export const duelLayer: EventLayer = {
373:   name: 'duel',
374:   update,
375:   reset,
376:   state: () => ({
377:     open: state.request !== null || state.watchOpen,
378:     running: state.duel !== null,
379:   }),
380: };
</file>

