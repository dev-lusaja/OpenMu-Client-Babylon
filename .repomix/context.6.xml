 80:   // ---- readers -----------------------------------------------------------
 81: 
 82:   /** Every entry's snapshot, by name. */
 83:   state(): Record<string, EventEntryState> {
 84:     const out: Record<string, EventEntryState> = {};
 85:     for (const layer of this.layers) out[layer.name] = layer.state();
 86:     return out;
 87:   }
 88: 
 89:   /** Any entry window or prompt is on screen (hot keys, inventory routing). */
 90:   get anyOpen(): boolean {
 91:     return this.layers.some(l => l.state().open);
