  1: import { makeAutoObservable, runInAction } from 'mobx';
  2: import { effective, type ServerProfile } from './serverConfig';
  3: 
  4: /**
  5:  * Is that world actually up?
  6:  *
  7:  * The worlds screen lists addresses; this is what turns them into somewhere a
  8:  * player can go. The client cannot open a TCP socket, so it asks the same way
  9:  * the game does - through the proxy, at `wsUrl?host=&port=`, exactly the URL
 10:  * `createSocket` builds - and then throws the connection away. Nothing is sent:
 11:  * MU's connect server greets whoever dials it, so the answer is the whole test.
 12:  *
 13:  * Two things make that reading less obvious than it looks:
 14:  *
 15:  *   1. The proxy upgrades the websocket *before* it dials TCP (`proxy/main.ts`
 16:  *      `fetch` then `websocket.open`), so an open socket proves only that the
 17:  *      proxy is alive. It closes the socket when the dial fails, which is what
 18:  *      makes a close a real "down" rather than a network hiccup.
 19:  *   2. The proxy greets every client with a weather frame of its own making
 20:  *      (`proxy/weather.ts` - `C1 04 0F xx`) the moment it accepts. So the
 21:  *      *first* message is not evidence of anything either. Any other packet is
 22:  *      the connect server itself, and that is the one that answers the question.
 23:  *
 24:  * Every verdict is therefore about the whole path - proxy, network, connect
 25:  * server - which is exactly the path entering that world would take.
 26:  */
 27: 
 28: export type Reach = 'unknown' | 'checking' | 'up' | 'down';
 29: 
 30: /** Long enough for a busy server across an ocean, short enough to page past. */
 31: const TIMEOUT_MS = 6000;
 32: 
 33: /**
 34:  * Probes in flight at once. Published worlds are other people's machines, and
 35:  * a grid that dials nine of them the frame it opens is a port scanner with a
 36:  * banner. Two at a time, only what is on screen.
 37:  */
 38: const CONCURRENCY = 2;
 39: 
 40: /** A verdict this old is re-checked; anything newer is reused. */
 41: const FRESH_MS = 60_000;
 42: 
 43: /** `C1 04 0F xx`: the proxy's own weather frame, not the server answering. */
 44: const WEATHER_CODE = 0x0f;
 45: 
 46: /** Where the code byte sits in a `C1` packet. */
 47: const CODE_OFFSET = 2;
 48: 
 49: /**
 50:  * One connection, opened and dropped. Resolves `true` only when something that
 51:  * is not the proxy's weather frame came back.
 52:  */
 53: function dial(profile: ServerProfile): Promise<boolean> {
 54:   const { csHost, csPort, wsUrl } = effective(profile);
 55: 
 56:   return new Promise(resolve => {
 57:     let socket: WebSocket;
 58: 
 59:     try {
 60:       socket = new WebSocket(`${wsUrl}?host=${csHost}&port=${csPort}`);
 61:     } catch {
 62:       // A malformed or blocked URL (mixed content on an https page) throws
 63:       // here rather than firing an event.
 64:       resolve(false);
 65:       return;
 66:     }
 67: 
 68:     socket.binaryType = 'arraybuffer';
 69: 
 70:     let settled = false;
 71: 
 72:     const finish = (up: boolean) => {
 73:       if (settled) return;
 74:       settled = true;
 75:       clearTimeout(timer);
 76: 
 77:       try {
 78:         socket.close();
 79:       } catch {
 80:         // Already closing or closed; there is nothing to undo.
 81:       }
 82: 
 83:       resolve(up);
 84:     };
 85: 
 86:     // No close and no answer: a firewall dropping the SYN looks exactly like
 87:     // this, and to a player it is the same thing as down. Declared after
 88:     // `finish` because each closes over the other; neither runs until an
 89:     // event fires, by which point both exist.
 90:     const timer = setTimeout(() => finish(false), TIMEOUT_MS);
 91: 
 92:     socket.onmessage = event => {
 93:       if (!(event.data instanceof ArrayBuffer)) return;
 94: 
 95:       const bytes = new Uint8Array(event.data);
 96: 
 97:       if (bytes.length > CODE_OFFSET && bytes[CODE_OFFSET] === WEATHER_CODE) {
 98:         return;
 99:       }
100: 
101:       finish(true);
102:     };
103: 
104:     socket.onerror = () => finish(false);
105:     socket.onclose = () => finish(false);
106:   });
107: }
108: 
109: class ServerProbeStore {
110:   /** Verdict per profile id. Session-lived: nothing here is worth storing. */
111:   reach: Record<string, Reach> = {};
112: 
113:   /** When each verdict was reached, so a stale one can be taken again. */
114:   private at: Record<string, number> = {};
115: 
116:   /** Ids being dialled right now, so a re-render cannot start a second dial. */
117:   private running = new Set<string>();
118: 
119:   constructor() {
120:     makeAutoObservable(this, {}, { autoBind: true });
121:   }
122: 
123:   of(id: string): Reach {
124:     return this.reach[id] ?? 'unknown';
125:   }
126: 
127:   private stale(id: string): boolean {
128:     const at = this.at[id];
129: 
130:     return at === undefined || Date.now() - at > FRESH_MS;
131:   }
132: 
133:   private set(id: string, reach: Reach): void {
134:     runInAction(() => {
135:       this.reach[id] = reach;
136:       if (reach === 'up' || reach === 'down') this.at[id] = Date.now();
137:     });
138:   }
139: 
140:   /**
141:    * Checks these worlds, `CONCURRENCY` at a time. Call it with the page that is
142:    * on screen: a world nobody is looking at does not need dialling, and one
143:    * checked a moment ago is not asked again unless `force` says so.
144:    */
145:   async check(profiles: ServerProfile[], force = false): Promise<void> {
146:     const queue = profiles.filter(
147:       p => !this.running.has(p.id) && (force || this.stale(p.id))
148:     );
149: 
150:     for (const profile of queue) {
151:       this.running.add(profile.id);
152:       this.set(profile.id, 'checking');
153:     }
154: 
155:     const next = async (): Promise<void> => {
156:       const profile = queue.shift();
157: 
158:       if (!profile) return;
159: 
160:       try {
161:         this.set(profile.id, (await dial(profile)) ? 'up' : 'down');
162:       } finally {
163:         this.running.delete(profile.id);
164:       }
165: 
166:       return next();
167:     };
168: 
169:     await Promise.all(
170:       Array.from({ length: Math.min(CONCURRENCY, queue.length) }, next)
171:     );
172:   }
173: 
174:   /** A refresh of the list is a refresh of what it says about itself. */
175:   forget(): void {
176:     runInAction(() => {
177:       this.reach = {};
178:       this.at = {};
179:     });
180:   }
181: }
182: 
183: export const ServerProbe = new ServerProbeStore();
</file>

