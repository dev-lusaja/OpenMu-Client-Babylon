  1: import { ENUM_WORLD } from '../types';
  2: import { ArrayCopy, castToByte } from '../binaryUtils';
  3: import { SIZE_OF_WORD, TERRAIN_SIZE } from './consts';
  4: import { convertBux, decryptMapFile } from './mapFileEncryption';
  5: 
  6: export async function parseTerrainAttribute(
  7:   file_data: Uint8Array,
  8:   map: ENUM_WORLD
  9: ) {
 10:   const iSize = file_data.length;
 11: 
 12:   // Decrypt file data
 13:   const decrypted_data = new Uint8Array(iSize);
 14:   decryptMapFile(decrypted_data, file_data, iSize);
 15: 
 16:   // Check file size
 17:   let extAtt = false;
 18: 
 19:   if (
 20:     iSize !== TERRAIN_SIZE * TERRAIN_SIZE + 4 &&
 21:     iSize !== TERRAIN_SIZE * TERRAIN_SIZE * SIZE_OF_WORD + 4
 22:   ) {
 23:     throw new Error(`size is wrong!`);
 24:   }
 25: 
 26:   if (iSize === TERRAIN_SIZE * TERRAIN_SIZE * SIZE_OF_WORD + 4) {
 27:     extAtt = true;
 28:   }
 29: 
 30:   // Extract file header
 31:   convertBux(decrypted_data, iSize);
 32:   const Version: Byte = decrypted_data[0];
 33:   // const iMap: Int = decrypted_data[1];
 34:   const Width: Byte = decrypted_data[2];
 35:   const Height: Byte = decrypted_data[3];
 36: 
 37:   const result = new Uint16Array(TERRAIN_SIZE * TERRAIN_SIZE);
 38: 
 39:   // Extract terrain attribute data
 40:   if (!extAtt) {
 41:     const TWall = new Uint8Array(TERRAIN_SIZE * TERRAIN_SIZE);
 42: 
 43:     ArrayCopy(decrypted_data, 4, TWall, 0, TERRAIN_SIZE * TERRAIN_SIZE);
 44: 
 45:     for (let i = 0; i < TERRAIN_SIZE * TERRAIN_SIZE; ++i) {
 46:       result[i] = TWall[i];
 47:     }
 48:   } else {
 49:     const dv = new DataView(decrypted_data.buffer.slice(4));
 50: 
 51:     // for (let i = 0; i < TERRAIN_SIZE; i++) {
 52:     //   const offset = i * TERRAIN_SIZE;
 53: 
 54:     //   for (let j = 0; j < TERRAIN_SIZE; j++) {
 55:     //     result[offset + j] = dv.getUint16(offset + j * 2, true);
 56:     //   }
 57:     // }
 58: 
 59:     for (let i = 0; i < TERRAIN_SIZE * TERRAIN_SIZE; i++) {
 60:       result[i] = dv.getUint16(i * 2, true);
 61:     }
 62:   }
 63: 
 64:   // Check file header
 65:   if (Version !== 0 || Width !== 255 || Height !== 255) {
 66:     throw new Error(`Invalid header!`);
 67:   }
 68: 
 69:   let hasError = false;
 70: 
 71:   switch (map) {
 72:     case ENUM_WORLD.WD_0LORENCIA:
 73:       const v = result[123 * TERRAIN_SIZE + 135];
 74:       if (v !== 5) hasError = true;
 75:       break;
 76:     case ENUM_WORLD.WD_1DUNGEON:
 77:       if (result[120 * TERRAIN_SIZE + 227] !== 4) hasError = true;
 78:       break;
 79:     case ENUM_WORLD.WD_2DEVIAS:
 80:       if (result[55 * TERRAIN_SIZE + 208] !== 5) hasError = true;
 81:       break;
 82:     case ENUM_WORLD.WD_3NORIA:
 83:       if (result[119 * TERRAIN_SIZE + 186] !== 5) hasError = true;
 84:       break;
 85:     case ENUM_WORLD.WD_4LOSTTOWER:
 86:       if (result[75 * TERRAIN_SIZE + 193] !== 5) hasError = true;
 87:       break;
 88:   }
 89: 
 90:   // The original's anti-tamper probe (`OpenTerrainAttribute`): one known tile
 91:   // per town. A mismatch means an edited or foreign `.att`, which is worth a
 92:   // note but not a bricked client - the map still loads with what it has.
 93:   if (hasError) {
 94:     console.warn(
 95:       `EncTerrain${map + 1}.att failed the attribute probe (edited or unexpected file)`
 96:     );
 97:   }
 98: 
 99:   //  for (let i = 0; i < TERRAIN_SIZE; i++) {
100:   //   const offset = i * TERRAIN_SIZE;
101: 
102:   //   for (let j = 0; j < TERRAIN_SIZE; j++) {
103:   //     result[offset + j] = result[offset + j];
104:   //   }
105:   // }
106: 
107:   for (let i = 0; i < TERRAIN_SIZE * TERRAIN_SIZE; i++) {
108:     result[i] = castToByte(result[i]);
109: 
110:     if (result[i] >= 128) {
111:       hasError = true;
112:     }
113:   }
114: 
115:   if (hasError) {
116:     throw new Error(`Another error!`);
117:   }
118: 
119:   return result;
120: }
