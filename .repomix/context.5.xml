  1: import { reaction } from 'mobx';
  2: import { t } from '../i18n';
  3: import { Store } from '../store';
  4: import { skills } from '../skills';
  5: import { GameOptions } from './gameOptions';
  6: import { Notices } from './notices';
  7: import { InventoryConstants } from './inventoryConstants';
  8: import { itemSquares, squareFits, stampSquares } from './inventoryLayout';
  9: import { calcMaxDurability, itemDef } from './itemStats';
 10: import { findHotkeyItem } from './itemHotkeys';
 11: import type { Item } from '../ecs/world';
 12: 
 13: /**
 14:  * The four things a player finds out too late: gear about to break, a full
 15:  * grid, the last potion drunk, a buff running out.
 16:  *
 17:  * All four are already in the store - this only watches them and puts a
 18:  * line on the notice banner the server messages use, once per crossing, so
 19:  * a hovering value cannot spam. Behind `GameOptions.stateWarnings`.
 20:  */
 21: 
 22: /** Durability crossings that are worth a line, high to low. */
 23: const DURABILITY_STEPS = [30, 10] as const;
 24: 
 25: /** A buff gets one warning this many seconds before it drops. */
 26: const BUFF_WARNING_SECONDS = 30;
 27: 
 28: const GRID_COLUMNS = InventoryConstants.RowSize;
 29: const GRID_ROWS = InventoryConstants.InventoryRows;
 30: const GRID_FIRST = InventoryConstants.LastEquippableItemSlotIndex + 1;
 31: 
 32: const WORN_SLOTS = Array.from(
 33:   { length: InventoryConstants.LastEquippableItemSlotIndex + 1 },
 34:   (_, slot) => slot
 35: );
 36: 
 37: function durabilityPercent(item: Item): number | null {
 38:   const def = itemDef(item.group, item.num);
 39:   if (!def) return null;
 40: 
 41:   const max = calcMaxDurability(
 42:     def,
 43:     item.lvl ?? 0,
 44:     item.isExcellent === true,
 45:     item.isAncient === true
 46:   );
 47:   if (max <= 0) return null;
 48: 
 49:   return Math.round(((item.durability ?? max) / max) * 100);
 50: }
 51: 
 52: /** Whether a 1x1 item would still find a square in the inventory grid. */
 53: function gridHasRoom(items: (Item | null)[]): boolean {
 54:   const used = new Uint8Array(GRID_COLUMNS * GRID_ROWS);
 55: 
 56:   for (let square = 0; square < GRID_COLUMNS * GRID_ROWS; square++) {
 57:     const item = items[GRID_FIRST + square];
 58:     if (!item) continue;
 59:     const { w, h } = itemSquares(item);
 60:     stampSquares(used, GRID_COLUMNS, GRID_ROWS, square, w, h);
 61:   }
 62: 
 63:   for (let square = 0; square < GRID_COLUMNS * GRID_ROWS; square++) {
 64:     if (squareFits(used, GRID_COLUMNS, GRID_ROWS, square, 1, 1)) return true;
 65:   }
 66: 
 67:   return false;
 68: }
 69: 
 70: /** The healing potions the Q/W/E/R keys would reach for, summed. */
 71: function healingPotions(items: (Item | null)[]): number {
 72:   let total = 0;
 73:   for (let hotkey = 0; hotkey < Store.itemHotkeys.length; hotkey++) {
 74:     const slot = findHotkeyItem(items, hotkey, Store.itemHotkeys[hotkey]);
 75:     if (slot < 0) continue;
 76:     total += items[slot]?.durability ?? 1;
 77:   }
 78:   return total;
 79: }
