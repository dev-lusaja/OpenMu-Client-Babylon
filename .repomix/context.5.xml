 775:   /** `ItemCraftingResult` (0x86). */
 776:   craftingResult(
 777:     result: ItemCraftingResultCraftingResultEnum,
 778:     item: Item | null
 779:   ): void {
 780:     const E = ItemCraftingResultCraftingResultEnum;
 781: 
 782:     runInAction(() => {
 783:       this.mixPending = false;
 784:       this.mixItems = emptyGrid(MIX_SLOTS);
 785:       this.mixResult = result === E.Success ? 'success' : 'failed';
 786:       if (result === E.Success && item) this.mixItems[0] = item;
 787:     });
 788: 
 789:     if (result === E.Success) {
 790:       playUiSound('mix');
 791:       Social.systemMessage(t('chaos.succeeded'));
 792:       return;
 793:     }
 794: 
 795:     playUiSound('mixFailed');
 796: 
 797:     const reason: Partial<Record<ItemCraftingResultCraftingResultEnum, TextKey>> = {
 798:       [E.Failed]: 'chaos.failed',
 799:       [E.NotEnoughMoney]: 'chaos.notEnoughZen',
 800:       [E.TooManyItems]: 'chaos.tooManyItems',
 801:       [E.CharacterLevelTooLow]: 'chaos.levelTooLow',
 802:       [E.LackingMixItems]: 'chaos.lackingItems',
 803:       [E.IncorrectMixItems]: 'chaos.incorrectItems',
 804:       [E.InvalidItemLevel]: 'chaos.invalidItemLevel',
 805:       [E.CharacterClassTooLow]: 'chaos.classTooLow',
 806:       [E.IncorrectBloodCastleItems]: 'chaos.bloodCastleItems',
 807:       [E.NotEnoughMoneyForBloodCastle]: 'chaos.bloodCastleZen',
 808:     };
 809: 
 810:     Social.errorMessage(t(reason[result] ?? 'chaos.failed'));
 811:   }
