 85: export function watchStateWarnings(): void {
 86:   /** Worn slot -> the lowest step already warned about. */
 87:   const warnedDurability = new Map<number, number>();
 88:   let warnedFull = false;
 89:   let warnedPotions = false;
 90:   const warnedBuffs = new Set<number>();
 91: 
 92:   reaction(
 93:     () =>
 94:       WORN_SLOTS.map(slot => {
 95:         const item = Store.playerData.items[slot];
 96:         return item ? durabilityPercent(item) : null;
 97:       }),
 98:     percents => {
 99:       if (!GameOptions.stateWarnings) return;
100: 
101:       percents.forEach((percent, slot) => {
102:         if (percent === null) {
103:           warnedDurability.delete(slot);
104:           return;
105:         }
106: 
107:         const step = DURABILITY_STEPS.find(limit => percent <= limit);
108:         if (step === undefined) {
109:           // Repaired back above every step: the warnings re-arm.
110:           warnedDurability.delete(slot);
111:           return;
112:         }
113: 
114:         if (warnedDurability.get(slot) === step) return;
115:         warnedDurability.set(slot, step);
116:         warn(t('warn.durability', { percent }));
117:       });
118:     },
119:     { equals: (a, b) => a.length === b.length && a.every((v, i) => v === b[i]) }
120:   );
121: 
122:   reaction(
123:     () => gridHasRoom(Store.playerData.items),
124:     room => {
125:       if (room) {
126:         warnedFull = false;
127:         return;
128:       }
129:       if (!GameOptions.stateWarnings || warnedFull) return;
130:       warnedFull = true;
131:       warn(t('warn.inventoryFull'));
132:     }
133:   );
134: 
135:   reaction(
136:     () => healingPotions(Store.playerData.items),
137:     left => {
138:       if (left > 0) {
139:         warnedPotions = false;
140:         return;
141:       }
142:       if (!GameOptions.stateWarnings || warnedPotions) return;
143:       warnedPotions = true;
144:       warn(t('warn.noPotions'));
145:     }
146:   );
147: 
148:   // Buffs: the list is observable, the remaining seconds are not, so the
149:   // check rides a slow interval rather than a reaction.
150:   setInterval(() => {
151:     if (!GameOptions.stateWarnings) return;
152: 
153:     const active = new Set<number>();
154:     for (const buff of skills.activeBuffs) {
155:       active.add(buff.id);
156:       if (buff.kind === 'debuff') continue;
157: 
158:       const remaining = skills.buffRemaining(buff.id);
159:       if (remaining === null || remaining > BUFF_WARNING_SECONDS) {
160:         // Recast: the effect id stays, the clock does not, so it may warn again.
161:         warnedBuffs.delete(buff.id);
162:         continue;
163:       }
164:       if (warnedBuffs.has(buff.id)) continue;
165: 
166:       warnedBuffs.add(buff.id);
167:       warn(t('warn.buffEnding', { name: buff.name }));
168:     }
169: 
170:     // A buff that dropped (or was recast) may warn again.
171:     for (const id of warnedBuffs) {
172:       if (!active.has(id)) warnedBuffs.delete(id);
173:     }
174:   }, 1000);
175: }
</file>

