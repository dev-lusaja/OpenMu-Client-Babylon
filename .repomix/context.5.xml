 19: /**
 20:  * Torch slots this session, from the lighting tier - see `pointLightBudget`
 21:  * for why it is fixed at startup and what it costs per pixel.
 22:  */
 23: export function pointLightPoolSize(): number {
 24:   const budget = pointLightBudget();
 25:   // Dev seam `?pool=<n>`: fewer slots this session, 0 = no pool.
 26:   const dev = devQueryNumber('pool');
 27: 
 28:   return dev === null ? budget : Math.max(0, Math.min(budget, Math.floor(dev)));
 29: }
