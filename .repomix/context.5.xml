 998:         break;
 999:       case E.FailedByFullInventory:
1000:         Social.errorMessage(t('trade.noRoom'));
1001:         break;
1002:       case E.TimedOut:
1003:         Social.errorMessage(t('trade.timedOut'));
1004:         break;
1005:       case E.FailedByItemsNotAllowedToTrade:
1006:         Social.errorMessage(t('trade.itemNotTradable'));
1007:         break;
1008:     }
