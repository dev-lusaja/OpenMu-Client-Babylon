100:   ['4:20', { angle: [-60, 0, -80], offset: [-5, 20, 0] }], // Arrow Viper Bow
101:   ['4:23', { angle: [-60, 0, -80], offset: [-5, 20, -5] }], // Stinger Bow
102:   ['4:24', { angle: [90, 0, -80], offset: [10, 20, -5] }], // Air Lyn Bow
103:   ['5:8', { angle: [70, 0, 90], offset: [-10, 5, 10] }], // Staff of Destruction
104:   ['5:9', { angle: [110, 180, 90], offset: [-10, 5, -10] }], // Dragon Soul Staff
105:   ['6:6', { angle: [30, 0, 90], offset: [-15, 0, -25] }], // Skull Shield
106:   ['6:14', { angle: [50, 0, 90], offset: [-28, 0, -25] }], // Legendary Shield
107:   ['6:15', { angle: [50, 0, 90], offset: [-28, 0, -25] }], // Grand Soul Shield
108:   ['6:16', { angle: [30, 0, 90], offset: [-20, 0, -20] }], // Elemental Shield
109: ]);
