 292:     for (let i = 0; i < perTick; i++) {
 293:       const bone = Math.floor(Math.random() * (bones - 1));
 294:       effects.spawn('sprite', c.scene, bonePos(c.caster, bone, new Vector3()), {
 295:         texture: TEX.fire,
 296:         colour: RGBS.fire,
 297:         size: 0.5,
 298:         seconds: ticks(8),
 299:         fadeTail: 0.6,
 300:       });
 301:     }
 302:   });
