156: /** The lightning tints of ZzzObject.cpp:869-893 (black flashes yellow). */
157: const FENRIRS: Readonly<Record<FenrirVariant, PetSpec>> = {
158:   red: fenrirSpec('red', [0.8, 0, 0]),
159:   blue: fenrirSpec('blue', [0.1, 0.1, 0.8]),
160:   black: fenrirSpec('black', [1.0, 1.0, 0.2]),
161:   gold: fenrirSpec('gold', [0.8, 0.8, 0.1]),
162: };
