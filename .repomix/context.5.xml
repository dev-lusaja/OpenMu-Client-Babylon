  3: 
  4: export function isPlayerAttackAction(action: PlayerAction): boolean {
  5:   return (
  6:     action >= PlayerAction.PLAYER_ATTACK_FIST &&
  7:     action < PlayerAction.PLAYER_ATTACK_END
  8:   );
  9: }
