 4: 
 5: /**
 6:  * What the browser tab says. `index.html` ships the client's own name so the
 7:  * tab reads right before any script runs; from the character list on it is the
 8:  * world the player logged into - the name its published list entry carried, or
 9:  * the one typed into the setup tab.
10:  *
11:  * The one writer of `document.title`.
12:  */
13: 
14: export const CLIENT_NAME = 'OpenMUCB';
15: 
16: /** A published name is capped at 60 chars; a typed one is not. */
17: const MAX_SERVER_NAME = 60;
18: 
19: /** Past the login form the world is known, and stays so until the way out. */
20: const LOGGED_IN = new Set([
21:   UIState.Characters,
22:   UIState.LoadingWorld,
23:   UIState.World,
24: ]);
25: 
26: export function titleFor(state: UIState, serverName: string): string {
27:   if (!LOGGED_IN.has(state)) return CLIENT_NAME;
28: 
29:   return serverName.trim().slice(0, MAX_SERVER_NAME) || CLIENT_NAME;
30: }
31: 
32: /** Call once from boot. */
33: export function watchPageTitle(): void {
34:   reaction(
35:     () =>
36:       titleFor(
37:         Store.uiState,
