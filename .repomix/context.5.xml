  1: import type { Entity, World } from '../../ecs/world';
  2: import { Vector3 } from '../../libs/babylon/exports';
  3: import { effects } from '../../effects';
  4: import { TEX } from '../../effects/recipes';
  5: import { loadGLTF } from '../modelLoader';
  6: import { ModelObject } from '../modelObject';
  7: import { TerrainDecal } from '../moveTargetEffect';
  8: import { npcModelFile } from './npcModelTable';
  9: 
 10: /**
 11:  * The Blood Castle archangels of Devias: Archangel (232, `BloodCastle01`)
 12:  * and Messenger of Archangel (233, `BloodCastle02`). See
 13:  * documentation/archangel_npcs/ARCHITECTURE.md for the original's three
 14:  * sites and what is an addition.
 15:  *
 16:  * - `RenderMesh(0, RENDER_TEXTURE | RENDER_BRIGHT)` after the lit body
 17:  *   (ZzzObject.cpp:2606): mesh 0 drawn again, additive, over itself -
 18:  *   `BrightMesh`.
 19:  * - The shadow silhouette leaves mesh 2 out (ZzzCharacter.cpp:8473) -
 20:  *   `ShadowHiddenMesh`.
 21:  * - A breathing, bluish-white `Magic_Ground2` circle 2.7 tiles wide on the
 22:  *   ground under the NPC, additive (ZzzCharacter.cpp:8486-8498): the halo.
 23:  * - Feathers, the reviewer's ask: the original has none here.
 24:  */
 25: 
 26: /**
 27:  * `RenderTerrainAlphaBitmap(BITMAP_MAGIC + 1, x, y, 2.7f, 2.7f, …)` is 2.7
 28:  * tiles centred on the NPC. The reviewer asked for the light to reach the
 29:  * ground the feathers drift over, in front of the angel: wider, and its
 30:  * centre a tile ahead.
 31:  */
 32: const HALO_TEXTURE = TEX.magicGround2;
 33: const HALO_SIZE = 4.5;
 34: const HALO_AHEAD = 1;
 35: 
 36: /** `Luminosity = sinf(WorldTime * 0.0015f) * 0.3f + 0.8f`. */
 37: const HALO_BREATHE_PER_MS = 0.0015;
 38: const HALO_BREATHE_SWING = 0.3;
 39: const HALO_BREATHE_BASE = 0.8;
 40: 
 41: /** Seconds between feathers, min and span. */
 42: const FEATHER_GAP_MIN = 0.25;
 43: const FEATHER_GAP_SPAN = 0.35;
 44: 
 45: /**
 46:  * Where a feather lets go: across the wing span, a little ahead of the
 47:  * body, at wing height. It then drifts the way the angel faces, so the
 48:  * feathers cross the ground in front of it rather than hovering at it.
 49:  */
 50: const FEATHER_SPAN = 0.7;
 51: const FEATHER_AHEAD_MIN = 0.1;
 52: const FEATHER_AHEAD_SPAN = 0.6;
 53: const FEATHER_HEIGHT_MIN = 1.5;
 54: const FEATHER_HEIGHT_SPAN = 0.9;
 55: 
 56: /** Tiles/s the feathers are carried ahead of the angel. */
 57: const FEATHER_DRIFT_AHEAD = 0.55;
 58: 
 59: const forward = new Vector3();
 60: const right = new Vector3();
 61: 
 62: const tmp = new Vector3();
 63: 
 64: let haloSeq = 0;
 65: 
 66: function archangelFactory(file: string): typeof ModelObject {
 67:   const path = npcModelFile(file);
 68: 
 69:   class Archangel extends ModelObject {
 70:     static {
 71:       Archangel.OverrideScale = 1;
 72:     }
 73: 
 74:     BrightMesh = 0;
 75:     ShadowHiddenMesh = 2;
 76: 
 77:     #world: World | null = null;
 78:     #entity: Entity | null = null;
 79:     #halo: TerrainDecal | null = null;
 80:     #nextFeather = 0;
 81: 
 82:     async init(world: World, entity: Entity) {
 83:       await super.init(world, entity);
 84: 
 85:       this.#world = world;
 86:       this.#entity = entity;
 87:       this.#halo = new TerrainDecal(
 88:         world,
 89:         `archangelHalo_${haloSeq++}`,
 90:         HALO_TEXTURE,
 91:         HALO_SIZE
 92:       );
 93: 
 94:       this.load(await loadGLTF(path, world));
 95:     }
 96: 
 97:     Update(gameTime: World['gameTime']): void {
 98:       super.Update(gameTime);
 99: 
100:       const world = this.#world;
101:       const entity = this.#entity;
102:       const halo = this.#halo;
103:       if (!this.Ready || !world || !entity || !halo) return;
104: 
105:       // The map's own walls: a tile nobody can walk is one the feathers
106:       // and the halo stop at.
107:       const open = (x: number, z: number) => world.isWalkable(x, z);
108:       const blocked = (x: number, z: number) => !world.isWalkable(x, z);
109: 
110:       if (this.OutOfView) {
111:         halo.hide();
112:         return;
113:       }
114: 
115:       const pos = entity.transform?.pos;
116:       if (!pos) return;
117: 
118:       const seconds = gameTime.TotalGameTime.TotalSeconds;
119: 
120:       const luminosity =
121:         Math.sin(seconds * 1000 * HALO_BREATHE_PER_MS) * HALO_BREATHE_SWING +
122:         HALO_BREATHE_BASE;
123: 
124:       // The way the angel faces, on the ground plane.
125:       forward.copyFrom(this.node.forward);
126:       forward.y = 0;
127:       if (forward.lengthSquared() < 1e-6) forward.set(0, 0, 1);
128:       forward.normalize();
129:       right.set(forward.z, 0, -forward.x);
130: 
131:       // `Vector(Luminosity * 0.5f, Luminosity * 0.5f, Luminosity, Light)`.
132:       // The halo drapes the ground; a wall's tiles are left dark so it does
133:       // not run on into the building the angel stands beside.
134:       halo.draw(
135:         world,
136:         pos.x + forward.x * HALO_AHEAD,
137:         pos.z + forward.z * HALO_AHEAD,
138:         HALO_SIZE,
139:         0,
140:         [luminosity * 0.5, luminosity * 0.5, luminosity],
141:         open
142:       );
143: 
144:       if (seconds < this.#nextFeather) return;
145:       this.#nextFeather = seconds + FEATHER_GAP_MIN + Math.random() * FEATHER_GAP_SPAN;
146: 
147:       const span = (Math.random() * 2 - 1) * FEATHER_SPAN;
148:       const ahead = FEATHER_AHEAD_MIN + Math.random() * FEATHER_AHEAD_SPAN;
149: 
150:       tmp.set(
151:         pos.x + right.x * span + forward.x * ahead,
152:         pos.y + FEATHER_HEIGHT_MIN + Math.random() * FEATHER_HEIGHT_SPAN,
153:         pos.z + right.z * span + forward.z * ahead
154:       );
155: 
156:       // A wing tip over a wall lets go at the body instead.
157:       if (!world.isWalkable(tmp.x, tmp.z)) {
158:         tmp.x = pos.x;
159:         tmp.z = pos.z;
160:       }
161: 
162:       effects.spawn('feathers', world.scene, tmp, {
163:         count: 1,
164:         blocked,
165:         drift: [forward.x * FEATHER_DRIFT_AHEAD, forward.z * FEATHER_DRIFT_AHEAD],
166:       });
167:     }
168: 
169:     dispose(): void {
170:       this.#halo?.dispose();
171:       this.#halo = null;
172:       super.dispose();
173:     }
174:   }
175: 
176:   Object.defineProperty(Archangel, 'name', { value: file });
177: 
178:   return Archangel;
179: }
180: 
181: // [NpcInfo(232, "Archangel")], [NpcInfo(233, "Messenger of Archangel")]
182: export const Archangel = archangelFactory('BloodCastle01');
183: export const ArchangelMessenger = archangelFactory('BloodCastle02');
</file>

