<file path="src/common/statAmounts.ts">
 1: /**
 2:  * The arithmetic behind the character info window's amount box: what a box
 3:  * may ask for, and what a run does next. Pure, so both can be checked
 4:  * without a socket; the run itself is `statAllocation.ts`.
 5:  */
 6: 
 7: /** Ceiling on one run, and on what the amount box accepts. */
 8: export const MAX_AMOUNT = 9999;
 9: 
10: /**
11:  * From this many points on, the run is confirmed before it starts. Points are
12:  * irreversible and there is no reset, so a mistyped amount has to be caught
13:  * before the first request goes out.
14:  */
15: export const CONFIRM_AMOUNT = 100;
16: 
17: /** Whether a run of this size asks the player first. */
18: export function needsConfirm(amount: number): boolean {
19:   return amount >= CONFIRM_AMOUNT;
20: }
21: 
22: /** What the box may ask for: at least one, never more than what is left. */
23: export function clampAmount(amount: number, points: number): number {
24:   if (!Number.isFinite(amount)) return 0;
25: 
26:   const available = Math.min(Math.trunc(points), MAX_AMOUNT);
27:   if (available <= 0) return 0;
28: 
29:   return Math.min(Math.max(Math.trunc(amount), 1), available);
30: }
31: 
32: export type StepDecision = 'send' | 'done' | 'spent';
33: 
34: /**
35:  * What the run does next, given what the server has confirmed and how many
36:  * points the character still has.
37:  */
38: export function nextStep(
39:   run: { added: number; wanted: number },
40:   points: number
41: ): StepDecision {
42:   if (run.added >= run.wanted) return 'done';
43:   if (points <= 0) return 'spent';
44:   return 'send';
45: }
</file>

