 478:     return GetByteValue(this.buffer.${getMethod}(${index}), 8, ${leftShifted ?? 0});
 479:   }
 480:   set ${name}(value: number) {
 481:     const oldByte = this.buffer.${getMethod}(${index});
 482:     this.buffer.${setMethod}(${index}, SetByteValue(oldByte, value, 8, ${leftShifted ?? 0}));
 483:   }
 484: `);
 485:               }
 486:               return;
 487:             }
 488:             case "Boolean": {
 489:               getMethod = "getUint8";
 490:               setMethod = "setUint8";
 491:               writer.write(`  get ${name}(){
 492:     return GetBoolean(this.buffer.getUint8(${index}), ${leftShifted ?? 0});
 493:   }
 494:   set ${name}(value: boolean){
 495:     const oldByte = this.buffer.getUint8(${index});
 496:     this.buffer.${setMethod}(${index}, SetBoolean(oldByte, value, ${leftShifted ?? 0}));
 497:   }
 498: `);
