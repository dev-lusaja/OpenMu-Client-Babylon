<file path="src/common/serverAccounts.ts">
  1: import { makeAutoObservable, runInAction } from 'mobx';
  2: import { LocalStorage } from '../libs/localStorage';
  3: import { MAX_PASSWORD_LENGTH, MAX_USERNAME_LENGTH } from '../consts';
  4: import { ServerConfig, URL_PROFILE_ID } from './serverConfig';
  5: 
  6: /**
  7:  * The accounts this player uses on each world: a list per world, and which of
  8:  * them the login window fills in.
  9:  *
 10:  * A client that plays any world cannot keep one login. The account that works
 11:  * on one world means nothing on somebody's local OpenMU, and the pre-rework
 12:  * client kept exactly one pair of credentials and handed it to whichever world
 13:  * was entered next - so the book is keyed by profile id, the same key
 14:  * `serverConfig.ts` selects and marks last-played with.
 15:  *
 16:  * More than one per world, because one per world is the same mistake a size
 17:  * smaller: a main and a mule on the same server is the ordinary case in MU, and
 18:  * a box that holds one of them turns the other into something retyped every
 19:  * session.
 20:  *
 21:  * What it stores is what the original client stored: the name, the password,
 22:  * and whether to keep them. It lives in this browser's localStorage in plain
 23:  * text, exactly as the old single-account blob did - the accounts tab says so
 24:  * out loud rather than implying a safety the client cannot provide. Turning
 25:  * "remember" off on an entry stores neither field, which is also what the
 26:  * original did.
 27:  *
 28:  * The URL profile is deliberately absent: it is a link somebody followed once
 29:  * and is gone next launch, so an account saved against it would be orphaned.
 30:  */
 31: 
 32: const ACCOUNTS_KEY = 'mu_accounts';
 33: 
 34: /** The pre-rework blob (store.ts `CONFIG_KEY`), read once to migrate. */
 35: const LEGACY_KEY = '_mu_key';
 36: 
 37: /** What the tab has room for, and more mules than anyone runs from one browser. */
 38: const MAX_PER_WORLD = 10;
 39: 
 40: export type ServerAccount = {
 41:   /** Stable key within its world; `ServerConfig` ids are the world's key. */
 42:   id: string;
 43:   username: string;
 44:   password: string;
 45:   /** Off stores neither field, and is remembered so the box stays unticked. */
 46:   remember: boolean;
 47:   /** Epoch ms of the last login the server accepted, or 0 for never. */
 48:   lastLoginAt: number;
 49: };
 50: 
 51: type WorldAccounts = {
 52:   accounts: ServerAccount[];
 53:   /** The one the login window fills in, and the one Enter is about. */
 54:   activeId: string;
 55: };
 56: 
 57: export const EMPTY_ACCOUNT: ServerAccount = {
 58:   id: '',
 59:   username: '',
 60:   password: '',
 61:   remember: true,
 62:   lastLoginAt: 0,
 63: };
 64: 
 65: const NO_ACCOUNTS: WorldAccounts = { accounts: [], activeId: '' };
 66: 
 67: const clamp = (value: unknown, max: number) =>
 68:   typeof value === 'string' ? value.slice(0, max) : '';
 69: 
 70: let counter = 0;
 71: 
 72: function newId(): string {
 73:   counter += 1;
 74: 
 75:   return `a${Date.now().toString(36)}${counter.toString(36)}`;
 76: }
 77: 
 78: /**
 79:  * What actually goes to disk. A row exists because the player put it there, so
 80:  * "remember" is about the secret rather than about the row: off keeps the name
 81:  * in the list and drops the password, and Delete is how a row goes away.
 82:  */
 83: function stored(account: ServerAccount): ServerAccount {
 84:   return {
 85:     id: account.id,
 86:     username: clamp(account.username, MAX_USERNAME_LENGTH),
 87:     password: account.remember
 88:       ? clamp(account.password, MAX_PASSWORD_LENGTH)
 89:       : '',
 90:     remember: account.remember,
 91:     lastLoginAt: account.lastLoginAt,
 92:   };
 93: }
 94: 
 95: /** A row that says nothing is dropped rather than kept as an empty line. */
 96: const worthKeeping = (account: ServerAccount) =>
 97:   !!account.username || !!account.password || account.lastLoginAt > 0;
 98: 
 99: function fromStorage(raw: unknown): ServerAccount | null {
100:   if (!raw || typeof raw !== 'object') return null;
101: 
102:   const data = raw as Partial<ServerAccount>;
103:   const username = clamp(data.username, MAX_USERNAME_LENGTH);
104:   const at = Number(data.lastLoginAt);
105: 
106:   return stored({
107:     id: clamp(data.id, 40) || newId(),
108:     username,
109:     // A stored password with no name to go with it is not a login anyone can
110:     // use; half-typed fields on screen are the store's business, not disk's.
111:     password: username ? clamp(data.password, MAX_PASSWORD_LENGTH) : '',
112:     remember: data.remember !== false,
113:     lastLoginAt: Number.isFinite(at) && at > 0 ? at : 0,
114:   });
115: }
116: 
117: /**
118:  * One world's entry, from either shape it can be on disk: the list this store
119:  * writes, or the single account the first cut of it wrote.
120:  */
121: function worldFromStorage(raw: unknown): WorldAccounts | null {
122:   if (!raw || typeof raw !== 'object') return null;
123: 
124:   const data = raw as { accounts?: unknown; activeId?: unknown };
125:   const list = Array.isArray(data.accounts)
126:     ? data.accounts
127:     : // The one-account-per-world shape, read as a list of one.
128:       [raw];
129: 
130:   const accounts = list
131:     .map(fromStorage)
132:     .filter((a): a is ServerAccount => !!a && worthKeeping(a))
133:     .slice(0, MAX_PER_WORLD);
134: 
135:   if (!accounts.length) return null;
136: 
137:   const wanted = clamp(data.activeId, 40);
138: 
139:   return {
140:     accounts,
141:     activeId: accounts.some(a => a.id === wanted) ? wanted : accounts[0].id,
142:   };
143: }
144: 
145: /**
146:  * The one account the pre-rework client had, moved to the world it was most
147:  * likely typed on: the last one actually entered, or failing that the selected
148:  * one. Run once, and the legacy blob's credential keys are cleared afterwards
149:  * so the old global login cannot come back on a later launch.
150:  */
151: function migrateLegacy(): Record<string, WorldAccounts> {
152:   try {
153:     const raw = LocalStorage.load(LEGACY_KEY);
154: 
155:     if (!raw) return {};
156: 
157:     const data = JSON.parse(raw) as Record<string, unknown>;
158:     const account = fromStorage({
159:       username: data.username,
160:       password: data.password,
161:       remember: data.rememberLogin !== false,
162:     });
163: 
164:     delete data.username;
165:     delete data.password;
166:     delete data.rememberLogin;
167:     LocalStorage.save(LEGACY_KEY, JSON.stringify(data));
168: 
169:     if (!account || !worthKeeping(account)) return {};
170: 
171:     const id = ServerConfig.lastPlayedId || ServerConfig.activeId;
172: 
173:     return id ? { [id]: { accounts: [account], activeId: account.id } } : {};
174:   } catch {
175:     return {};
176:   }
177: }
178: 
179: function load(): Record<string, WorldAccounts> {
180:   const raw = LocalStorage.load(ACCOUNTS_KEY);
181: 
182:   if (!raw) return migrateLegacy();
183: 
184:   try {
185:     const data = JSON.parse(raw) as Record<string, unknown>;
186:     const book: Record<string, WorldAccounts> = {};
187: 
188:     for (const [id, entry] of Object.entries(data)) {
189:       const world = worldFromStorage(entry);
190: 
191:       if (world) book[id] = world;
192:     }
193: 
194:     return book;
195:   } catch {
196:     return {};
197:   }
198: }
199: 
200: class ServerAccountsStore {
201:   private book: Record<string, WorldAccounts> = {};
202: 
203:   constructor() {
204:     this.book = load();
205:     makeAutoObservable(this);
206:   }
207: 
208:   /** Every account saved for that world, in the order they were added. */
209:   list(worldId: string): ServerAccount[] {
210:     return (this.book[worldId] ?? NO_ACCOUNTS).accounts;
211:   }
212: 
213:   /** Which one is chosen there; empty when the world has none. */
214:   activeId(worldId: string): string {
215:     return (this.book[worldId] ?? NO_ACCOUNTS).activeId;
216:   }
217: 
218:   /** The chosen account. Never null: a world with none reads as a blank one. */
219:   of(worldId: string): ServerAccount {
220:     const world = this.book[worldId];
221: 
222:     if (!world) return EMPTY_ACCOUNT;
223: 
224:     return world.accounts.find(a => a.id === world.activeId) ?? EMPTY_ACCOUNT;
225:   }
226: 
227:   /** Whether this world has a name saved, which is what the screens show. */
228:   has(worldId: string): boolean {
229:     return this.list(worldId).some(a => !!a.username);
230:   }
231: 
232:   /** Accounts saved across every world, for the tab's own summary. */
233:   get count(): number {
234:     return Object.values(this.book).reduce(
235:       (total, world) => total + world.accounts.filter(a => a.username).length,
236:       0
237:     );
238:   }
239: 
240:   /** Room for another on that world. */
241:   canAdd(worldId: string): boolean {
242:     return this.list(worldId).length < MAX_PER_WORLD;
243:   }
244: 
245:   /** A blank account on that world, selected. Returns its id, or empty. */
246:   add(worldId: string, patch: Partial<ServerAccount> = {}): string {
247:     if (!this.savable(worldId) || !this.canAdd(worldId)) return '';
248: 
249:     const account = stored({ ...EMPTY_ACCOUNT, ...patch, id: newId() });
250: 
251:     runInAction(() => {
252:       // Assigned first and read back after: MobX returns an observable copy of
253:       // what was stored, so pushing into the object handed to the assignment
254:       // would push into a plain array nothing is watching.
255:       if (!this.book[worldId]) this.book[worldId] = { accounts: [], activeId: '' };
256: 
257:       const world = this.book[worldId];
258: 
259:       world.accounts.push(account);
260:       world.activeId = account.id;
261:     });
262:     this.save();
263: 
264:     return account.id;
265:   }
266: 
267:   select(worldId: string, accountId: string): void {
268:     const world = this.book[worldId];
269: 
270:     if (!world?.accounts.some(a => a.id === accountId)) return;
271: 
272:     runInAction(() => {
273:       world.activeId = accountId;
274:     });
275:     this.save();
276:   }
277: 
278:   update(worldId: string, accountId: string, patch: Partial<ServerAccount>): void {
279:     if (!this.savable(worldId)) return;
280: 
281:     const world = this.book[worldId];
282:     const at = world?.accounts.findIndex(a => a.id === accountId) ?? -1;
283: 
284:     if (!world || at < 0) return;
285: 
286:     const next = stored({ ...world.accounts[at], ...patch, id: accountId });
287: 
288:     runInAction(() => {
289:       world.accounts[at] = next;
290:     });
291:     this.save();
292:   }
293: 
294:   forget(worldId: string, accountId?: string): void {
295:     const world = this.book[worldId];
296: 
297:     if (!world) return;
298: 
299:     runInAction(() => {
300:       if (accountId === undefined) {
301:         delete this.book[worldId];
302:         return;
303:       }
304: 
305:       world.accounts = world.accounts.filter(a => a.id !== accountId);
306: 
307:       if (!world.accounts.length) {
308:         delete this.book[worldId];
309:       } else if (world.activeId === accountId) {
310:         world.activeId = world.accounts[0].id;
311:       }
312:     });
313:     this.save();
314:   }
315: 
316:   /**
317:    * The login a server just accepted. It updates the account of that name when
318:    * the world already has one and adds it when it does not, so logging in with
319:    * a second account keeps the first rather than overwriting it.
320:    */
321:   record(
322:     worldId: string,
323:     login: { username: string; password: string; remember: boolean }
324:   ): void {
325:     if (!this.savable(worldId) || !login.username) return;
326: 
327:     const name = clamp(login.username, MAX_USERNAME_LENGTH);
328:     const existing = this.list(worldId).find(a => a.username === name);
329:     const patch = {
330:       username: name,
331:       password: login.password,
332:       remember: login.remember,
333:       lastLoginAt: Date.now(),
334:     };
335: 
336:     if (existing) {
337:       this.update(worldId, existing.id, patch);
338:       this.select(worldId, existing.id);
339:       return;
340:     }
341: 
342:     // "Remember" off is a request not to write this down at all, so the world
343:     // gets no new row for it - only the entry it already had is updated.
344:     if (!login.remember) return;
345: 
346:     this.add(worldId, patch);
347:   }
348: 
349:   /** Worlds that outlive the launch. The URL profile does not. */
350:   private savable(worldId: string): boolean {
351:     return !!worldId && worldId !== URL_PROFILE_ID;
352:   }
353: 
354:   private save(): void {
355:     LocalStorage.save(ACCOUNTS_KEY, JSON.stringify(this.book));
356:   }
357: }
358: 
359: export const ServerAccounts = new ServerAccountsStore();
