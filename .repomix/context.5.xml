<file path="src/common/skinTexture.ts">
 1: /**
 2:  * Which textures count as skin or hair (`LoadData.cpp:82-84`): the original
 3:  * flags a bitmap `IsSkin` when its file name starts with `ski` or `level`, and
 4:  * `IsHair` when it starts with `hair`. `HideSkin` then skips every mesh drawn
 5:  * with one (`ZzzBMD.cpp:970-978`).
 6:  *
 7:  * The `level` rule is not an accident: the mask helms paint the face with
 8:  * `level_man02`, not with a `skin` texture.
 9:  */
10: export function isSkinOrHairTexture(fileName: string): boolean {
11:   const name = fileName.toLowerCase();
12: 
13:   return (
14:     name.startsWith('ski') || name.startsWith('level') || name.startsWith('hair')
15:   );
16: }
17: 
18: /**
19:  * The hide slot (`LoadData.cpp:70-73`): a mesh whose texture name starts with
20:  * `hid` binds BITMAP_HIDE instead of a bitmap, and every RenderMesh returns
21:  * on that index (`ZzzBMD.cpp:953-956`). The name is the instruction - the
22:  * file it points at may or may not exist, and either way nothing draws.
23:  */
24: export function isHideTexture(fileName: string): boolean {
25:   return fileName.toLowerCase().startsWith('hid');
26: }
</file>

<file path="src/common/slideHelp.ts">
  1: import { makeAutoObservable } from 'mobx';
  2: 
  3: /**
  4:  * `CSlideHelpMgr` / `CUISlideHelp` (UIControls.cpp:4033-4530): the marquee
  5:  * strip along the top of the screen. Two lanes - the *help* slide (`g_hFont`)
  6:  * and the *notice* slide (`g_hFontBold`) - each with a queue of texts keyed
  7:  * by the second they are due. `ReceiveNotice` feeds them from `ServerMessage`
  8:  * types 10..15 (`AddSlide(Count, Delay, Text, Type - 10, Speed / 10, Color)`):
  9:  * 0..2 go to the help lane, 3..5 to the notice lane, and within a lane the
 10:  * sub-type 1 queues the text for right now, the others for
 11:  * `currentSecond + i * Delay` per loop; sub-type 0 (`-1` after the shift)
 12:  * is dropped if it sat in the queue for more than 60 s.
 13:  *
 14:  * A lane draws a black band (alpha `alphaRate - 25`, 1 px lines above and
 15:  * below) at y = 0 and scrolls its text in from x = 640, accelerating at
 16:  * 1 px/tick² to `Speed` px/tick (2.5 default) and decelerating while the
 17:  * mouse rests on the band. `alphaRate` ramps 30/tick up to 205 while there is
 18:  * text and back down when it has scrolled past its width; the text colour's
 19:  * alpha is scaled by `(alphaRate + 50) / 255`. The local "help" tips file
 20:  * (`OpenSlideTextFile`) is not shipped here, so the help lane is packet-only.
 21:  */
 22: 
 23: export const SLIDE_STAGE_WIDTH = 640;
 24: const TICKS_PER_SECOND = 25;
 25: const MAX_LOOPS = 30;
 26: const STALE_SECONDS = 60;
 27: const ALPHA_STEP = 30;
 28: const ALPHA_MAX = 205;
 29: const ACCEL = 1;
 30: const DEFAULT_SPEED = 2.5;
 31: 
 32: /** `(255 << 24) + (200 << 16) + (220 << 8) + 230`: R 230, G 220, B 200. */
 33: export const DEFAULT_SLIDE_COLOR = 0xffc8dce6;
 34: 
 35: export type SlideLaneKind = 'help' | 'notice';
 36: 
 37: type QueuedSlide = {
 38:   due: number;
 39:   subType: number;
 40:   text: string;
 41:   color: number;
 42:   speed: number;
 43: };
 44: 
 45: export type SlideColor = { r: number; g: number; b: number; a: number };
 46: 
 47: /** `SetTextColor(DWORD)`: R + (G << 8) + (B << 16) + (A << 24). */
 48: export function unpackSlideColor(color: number): SlideColor {
 49:   return {
 50:     r: color & 0xff,
 51:     g: (color >>> 8) & 0xff,
 52:     b: (color >>> 16) & 0xff,
 53:     a: (color >>> 24) & 0xff,
 54:   };
 55: }
 56: 
 57: export class SlideLane {
 58:   text = '';
 59:   color: number = DEFAULT_SLIDE_COLOR;
 60:   /** `m_fMovePosition`, in 640-wide stage pixels. */
 61:   position = SLIDE_STAGE_WIDTH;
 62:   speed = 0;
 63:   maxSpeed = DEFAULT_SPEED;
 64:   alphaRate = 0;
 65:   hovered = false;
 66:   /** Width of the current text in stage pixels; set by the renderer. */
 67:   textWidth = 0;
 68: 
 69:   private queue: QueuedSlide[] = [];
 70:   private currentSecond = 10;
 71:   private secondAccumulator = 0;
 72: 
 73:   constructor(readonly kind: SlideLaneKind) {
 74:     makeAutoObservable<this, 'queue' | 'currentSecond' | 'secondAccumulator'>(
 75:       this,
 76:       { queue: false, currentSecond: false, secondAccumulator: false }
 77:     );
 78:   }
 79: 
 80:   get hasText(): boolean {
 81:     return this.text !== '';
 82:   }
 83: 
 84:   get visible(): boolean {
 85:     return this.alphaRate > 0;
 86:   }
 87: 
 88:   /** `CUISlideHelp::AddSlide`. */
 89:   add(
 90:     loopCount: number,
 91:     loopDelay: number,
 92:     text: string,
 93:     subType: number,
 94:     speed: number,
 95:     color: number
 96:   ): void {
 97:     if (!text || loopCount > MAX_LOOPS) return;
 98: 
 99:     for (let i = 0; i < loopCount; i++) {
100:       this.queue.push({
101:         due: subType === 1 ? 0 : this.currentSecond + i * loopDelay,
102:         subType,
103:         text,
104:         color,
105:         speed,
106:       });
107:     }
108:     this.queue.sort((a, b) => a.due - b.due);
109:   }
110: 
111:   clear(): void {
112:     this.queue = [];
113:     this.text = '';
114:     this.alphaRate = 0;
115:     this.position = SLIDE_STAGE_WIDTH;
116:     this.speed = 0;
117:   }
118: 
119:   /**
120:    * One frame: `ManageSlide` + the movement part of `Render` (`SlideMove`,
121:    * `ComputeSpeed`, the alpha ramps). `f` is `FPS_ANIMATION_FACTOR`.
122:    */
123:   tick(f: number, dtSeconds: number, enabled: boolean): void {
124:     this.manage(dtSeconds);
125: 
126:     const fadeOut = !this.hasText || !enabled;
127: 
128:     if (!fadeOut) {
129:       this.alphaRate = Math.min(ALPHA_MAX, this.alphaRate + ALPHA_STEP * f);
130:     } else {
131:       this.alphaRate = Math.max(0, this.alphaRate - ALPHA_STEP * f);
132:     }
133: 
134:     if (this.alphaRate <= 0 || fadeOut) return;
135: 
136:     // SlideMove: once the whole text has left the strip, drop it.
137:     if (this.position < -this.textWidth) {
138:       this.text = '';
139:       this.position = SLIDE_STAGE_WIDTH;
140:       return;
141:     }
142: 
143:     // ComputeSpeed.
144:     const accel = this.hovered ? -ACCEL : ACCEL;
145:     this.speed = Math.max(0, Math.min(this.maxSpeed, this.speed + accel * f));
146:     this.position -= this.speed * f;
147:   }
148: 
149:   /** `ManageSlide` + `CheckTime`: pull the next due text once the lane is empty. */
150:   private manage(dtSeconds: number): void {
151:     if (this.hasText) return;
152: 
153:     this.secondAccumulator += dtSeconds;
154:     while (this.secondAccumulator >= 1) {
155:       this.secondAccumulator -= 1;
156:       this.currentSecond++;
157:     }
158: 
159:     while (this.queue.length > 0) {
160:       const next = this.queue[0];
161:       if (next.due > this.currentSecond) break;
162:       this.queue.shift();
163: 
164:       // Sub-type -1 entries that went stale are skipped, not shown.
165:       if (next.subType === -1 && next.due + STALE_SECONDS < this.currentSecond) {
166:         continue;
167:       }
168: 
169:       this.text = next.text;
170:       this.color = next.color;
171:       this.maxSpeed = next.speed > 0 ? next.speed : DEFAULT_SPEED;
172:       this.position = SLIDE_STAGE_WIDTH;
173:       this.speed = 0;
174:       this.textWidth = 0;
175:       break;
176:     }
177:   }
178: }
179: 
180: export const SlideHelp = new (class _SlideHelp {
181:   readonly help = new SlideLane('help');
182:   readonly notice = new SlideLane('notice');
183: 
184:   /** `CSlideHelpMgr::AddSlide(Count, Delay, Text, Result - 10, Speed / 10, Color)`. */
185:   add(
186:     loopCount: number,
187:     loopDelay: number,
188:     text: string,
189:     type: number,
190:     speed: number,
191:     color: number = DEFAULT_SLIDE_COLOR
192:   ): void {
193:     if (!text || loopCount > MAX_LOOPS) return;
194: 
195:     if (type >= 0 && type <= 2) {
196:       this.help.add(loopCount, loopDelay, text, type - 1, speed, color);
197:     } else if (type >= 3 && type <= 5) {
198:       this.notice.add(loopCount, loopDelay, text, type - 4, speed, color);
199:     }
200:   }
201: 
202:   clear(): void {
203:     this.help.clear();
204:     this.notice.clear();
205:   }
206: 
207:   /**
208:    * `CSlideHelpMgr::Render` priority: the notice lane owns the strip while
209:    * it has text; the help lane only runs while the notice lane is dark.
210:    */
211:   tick(f: number, dtSeconds: number, enabled: boolean): void {
212:     this.notice.tick(f, dtSeconds, enabled && !this.help.visible);
213:     this.help.tick(f, dtSeconds, enabled && !this.notice.hasText);
214:   }
215: 
216:   /** `Delay` is a WORD of seconds, `Speed` a BYTE of tenths of a px/tick. */
217:   static readonly TICKS_PER_SECOND = TICKS_PER_SECOND;
218: })();
</file>

<file path="src/common/statAllocation.ts">
  1: import { makeAutoObservable, observable } from 'mobx';
  2: import { EventBus } from '../libs/eventBus';
  3: import { Store } from '../store';
  4: import { clampAmount, nextStep } from './statAmounts';
  5: import type { StatType } from './characterStats';
  6: 
  7: /**
  8:  * "Add 200 points to Strength": the run behind the amount box in the
  9:  * character info window.
 10:  *
 11:  * `IncreaseCharacterStatPoint` carries no amount - the wire only ever adds
 12:  * one point - so this is the same shape as the arrange and bulk-move runs
 13:  * (`inventorySort.ts`, `bulkMove.ts`): one request in flight, the next one
 14:  * sent when the server has answered the last. Nothing new goes out.
 15:  *
 16:  * One writer: this module owns the run, the windows only read it.
 17:  */
 18: 
 19: /** A step with no answer this long is a lost request; the run ends. */
 20: const STEP_TIMEOUT = 5000;
 21: 
 22: export type StatRun = {
 23:   stat: StatType;
 24:   /** Requests sent so far. */
 25:   sent: number;
 26:   /** Points the server has confirmed. */
 27:   added: number;
 28:   /** Points asked for when the run started. */
 29:   wanted: number;
 30: };
 31: 
 32: export const StatAllocation = new (class _StatAllocation {
 33:   run: StatRun | null = null;
 34: 
 35:   private timer: ReturnType<typeof setTimeout> | null = null;
 36:   private detach: (() => void) | null = null;
 37: 
 38:   constructor() {
 39:     // The run is swapped whole rather than mutated: a reader only ever sees a
 40:     // consistent { sent, added } pair.
 41:     makeAutoObservable<this, 'timer' | 'detach'>(this, {
 42:       run: observable.ref,
 43:       timer: false,
 44:       detach: false,
 45:     });
 46:   }
 47: 
 48:   get running(): boolean {
 49:     return this.run !== null;
 50:   }
 51: 
 52:   /** True while `stat`'s own row is the one being filled. */
 53:   isRunning(stat: StatType): boolean {
 54:     return this.run?.stat === stat;
 55:   }
 56: 
 57:   start(stat: StatType, amount: number): void {
 58:     if (this.run) {
 59:       this.cancel();
 60:       return;
 61:     }
 62: 
 63:     const wanted = clampAmount(amount, Store.playerData.points);
 64:     if (wanted <= 0) return;
 65: 
 66:     this.run = { stat, sent: 0, added: 0, wanted };
 67:     this.listen();
 68:     this.step();
 69:   }
 70: 
 71:   cancel(): void {
 72:     this.clearTimer();
 73:     this.detach?.();
 74:     this.detach = null;
 75:     this.run = null;
 76:   }
 77: 
 78:   private listen(): void {
 79:     const answered = (e: { stat: number; added: number }) => this.onAnswer(e);
 80:     const lost = () => this.cancel();
 81: 
 82:     EventBus.on('statPointAnswered', answered);
 83:     EventBus.on('warpCompleted', lost);
 84:     EventBus.on('wsClosed', lost);
 85: 
 86:     this.detach = () => {
 87:       EventBus.off('statPointAnswered', answered);
 88:       EventBus.off('warpCompleted', lost);
 89:       EventBus.off('wsClosed', lost);
 90:     };
 91:   }
 92: 
 93:   private step(): void {
 94:     const run = this.run;
 95:     if (!run) return;
 96: 
 97:     if (nextStep(run, Store.playerData.points) !== 'send') {
 98:       this.cancel();
 99:       return;
100:     }
101: 
102:     this.run = { ...run, sent: run.sent + 1 };
103:     this.armTimer();
104:     Store.increaseStatRequest(run.stat);
105:   }
106: 
107:   private onAnswer(answer: { stat: number; added: number }): void {
108:     const run = this.run;
109:     if (!run || answer.stat !== run.stat) return;
110: 
111:     this.clearTimer();
112: 
113:     // A refused point means the server will refuse the rest too.
114:     if (answer.added <= 0) {
115:       this.cancel();
116:       return;
117:     }
118: 
119:     this.run = { ...run, added: run.added + answer.added };
120:     this.step();
121:   }
122: 
123:   private armTimer(): void {
124:     this.clearTimer();
125:     this.timer = setTimeout(() => this.cancel(), STEP_TIMEOUT);
126:   }
127: 
128:   private clearTimer(): void {
129:     if (this.timer === null) return;
130:     clearTimeout(this.timer);
131:     this.timer = null;
132:   }
133: })();
</file>

