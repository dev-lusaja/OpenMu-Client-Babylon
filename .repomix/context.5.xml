<file path="src/common/npcs/transformedNpc.ts">
  1: import type { Entity, World } from '../../ecs/world';
  2: import { PlayerAction } from '../objects/enum';
  3: import { loadGLTF } from '../modelLoader';
  4: import { PlayerObject } from '../playerObject';
  5: import { CharacterClassNumber } from '../types';
  6: 
  7: const cache = new Map<string, typeof PlayerObject>();
  8: 
  9: /**
 10:  * `CreateCharacter(Key, MODEL_PLAYER, …)` with `c->Object.SubType = MODEL_X`:
 11:  * a player rig whose whole body is one part file drawn by
 12:  * `RenderPartObject(&c->Object, o->SubType, …)` (ZzzCharacter.cpp:9321)
 13:  * instead of the helm/armor/… slots. The transform ring NPCs, the event
 14:  * mascots and the Cursed Temple side avatars are all this shape; the
 15:  * Skill/Skeleton0N monsters are the same mechanism with a weapon kit
 16:  * (see `monsters/skeletonWarrior.ts`, which predates this factory).
 17:  *
 18:  * The part rides the Armor slot, every other slot stays empty, and the player
 19:  * state machine (`playerAnimation`) picks the idle / walk clips.
 20:  */
 21: export function transformedNpcFactory(
 22:   dir: string,
 23:   part: string,
 24:   scale: number
 25: ): typeof PlayerObject {
 26:   const key = `${dir}${part}:${scale}`;
 27:   const cached = cache.get(key);
 28:   if (cached) return cached;
 29: 
 30:   class TransformedNpc extends PlayerObject {
 31:     /** The transforms all pose on the male knight rig (`c->Class` is never set). */
 32:     static NpcClass = CharacterClassNumber.DarkKnight;
 33: 
 34:     static {
 35:       TransformedNpc.OverrideScale = scale;
 36:     }
 37: 
 38:     async init(world: World, entity: Entity) {
 39:       this.load(await loadGLTF('Player/player.glb', world));
 40:       this.Ready = false;
 41: 
 42:       await this.loadTransformPart();
 43: 
 44:       world.addComponent(entity, 'charAppearance', {
 45:         charClass: CharacterClassNumber.DarkKnight,
 46:         helm: null,
 47:         armor: null,
 48:         pants: null,
 49:         gloves: null,
 50:         boots: null,
 51:         leftHand: null,
 52:         rightHand: null,
 53:         wings: null,
 54:         pet: null,
 55:         changed: true,
 56:       });
 57: 
 58:       this.startNpcIdle();
 59:       world.removeComponent(entity, 'monsterAnimation');
 60:       if (!entity.playerAnimation) {
 61:         world.addComponent(entity, 'playerAnimation', {
 62:           action: PlayerAction.PLAYER_SET,
 63:           run: 0,
 64:         });
 65:       }
 66: 
 67:       this.Ready = true;
 68:     }
 69: 
 70:     private loadTransformPart() {
 71:       return this.loadPartAsync(dir, this.Armor, part);
 72:     }
 73: 
 74:     // The body is the transform part alone: AppearanceSystem's "no item →
 75:     // class default" fallbacks must not dress it in the default knight kit.
 76:     override async updateBodyPartClassesAsync() {
 77:       await this.loadTransformPart();
 78:     }
 79:     override async setDefaultArmor() {
 80:       await this.loadTransformPart();
 81:     }
 82:     override async setDefaultHelm() {
 83:       this.Helm.Unload();
 84:     }
 85:     override async setDefaultMask() {
 86:       this.HelmMask.Unload();
 87:     }
 88:     override async setDefaultPants() {
 89:       this.Pants.Unload();
 90:     }
 91:     override async setDefaultGloves() {
 92:       this.Gloves.Unload();
 93:     }
 94:     override async setDefaultBoots() {
 95:       this.Boots.Unload();
 96:     }
 97:   }
 98: 
 99:   Object.defineProperty(TransformedNpc, 'name', { value: part.replace(/\.glb$/, '') });
100: 
101:   cache.set(key, TransformedNpc);
102: 
103:   return TransformedNpc;
104: }
</file>

