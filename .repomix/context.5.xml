 521:     this.buffer.${setMethod}(${index}, value, false);
 522:   }
 523: `);
 524:               return;
 525:             }
 526:             case "ShortLittleEndian": {
 527:               getMethod = "getUint16";
 528:               setMethod = "setUint16";
 529:               writer.write(`  get ${name}(){
 530:     return this.buffer.${getMethod}(${index}, true);
 531:   }
 532:   set ${name}(value: number){
 533:     this.buffer.${setMethod}(${index}, value, true);
 534:   }
 535: `);
 536:               return;
 537:             }
 538:             case "IntegerBigEndian": {
 539:               getMethod = "getUint32";
 540:               setMethod = "setUint32";
 541:               writer.write(`  get ${name}(){
 542:     return this.buffer.${getMethod}(${index}, false);
 543:   }
 544:   set ${name}(value: number){
 545:     this.buffer.${setMethod}(${index}, value, false);
 546:   }
 547: `);
 548:               return;
 549:             }
 550:             case "IntegerLittleEndian": {
 551:               getMethod = "getUint32";
 552:               setMethod = "setUint32";
 553:               writer.write(`  get ${name}(){
 554:     return this.buffer.${getMethod}(${index}, true);
 555:   }
 556:   set ${name}(value: number){
 557:     this.buffer.${setMethod}(${index}, value, true);
 558:   }
 559: `);
 560:               return;
 561:             }
 562:             case "LongBigEndian": {
 563:               getMethod = "getBigUint64";
 564:               setMethod = "setBigUint64";
 565:               writer.write(`  get ${name}(){
