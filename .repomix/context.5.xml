344:       this.playerClass
345:     );
346:   }
347: 
348:   async setBodyPartsAsync(
349:     pathPrefix: string,
350:     helmPrefix: string,
351:     armorPrefix: string,
352:     pantPrefix: string,
353:     glovePrefix: string,
354:     bootPrefix: string,
355:     skinIndex: number
356:   ) {
357:     // Format skin index to two digits (e.g., 1 -> "01", 10 -> "10")
358:     const fileSuffix = skinIndex.toString().padStart(2, '0');
359: 
360:     await Promise.all([
361:       !helmPrefix
362:         ? Promise.resolve()
363:         : this.loadPartAsync(
364:             pathPrefix,
365:             this.Helm,
366:             `${helmPrefix}${fileSuffix}.glb`
367:           ),
368:       !armorPrefix
369:         ? Promise.resolve()
370:         : this.loadPartAsync(
371:             pathPrefix,
372:             this.Armor,
373:             `${armorPrefix}${fileSuffix}.glb`
374:           ),
375:       !pantPrefix
376:         ? Promise.resolve()
377:         : this.loadPartAsync(
378:             pathPrefix,
379:             this.Pants,
380:             `${pantPrefix}${fileSuffix}.glb`
381:           ),
382:       !glovePrefix
383:         ? Promise.resolve()
384:         : this.loadPartAsync(
385:             pathPrefix,
386:             this.Gloves,
387:             `${glovePrefix}${fileSuffix}.glb`
388:           ),
389:       !bootPrefix
390:         ? Promise.resolve()
391:         : this.loadPartAsync(
392:             pathPrefix,
393:             this.Boots,
394:             `${bootPrefix}${fileSuffix}.glb`
395:           ),
396:     ]);
397:   }
398: 
399:   async loadPartAsync(
400:     dir: string,
401:     part: ModelObject,
402:     modelPath: string,
403:     itemLvl?: number,
404:     isExcellent?: boolean,
405:     tier?: ItemVisualTier
406:   ) {
407:     const seq = ++part.loadSeq;
408:     // Counted so the loading screen can tell a character that is merely
409:     // `Ready` (its rig is in) from one that is dressed: every part of a
410:     // character comes through here (`sceneGate.isStaged`).
411:     this.PartsPending++;
412:     try {
413:       const gltf = await loadGLTF(dir + modelPath, Store.world!);
414:       if (seq !== part.loadSeq) return;
415:       part.load(gltf);
416: 
417:       gltf.mesh.isPickable = this.IsInteractable;
418:       const meshes = part.getMeshes(true);
419: 
420:       meshes.forEach(mesh => {
421:         mesh.isPickable = this.IsInteractable;
422:         mesh.metadata ??= {};
423:         mesh.metadata.itemLvl = itemLvl ?? 0;
424:         mesh.metadata.isExcellent = isExcellent ?? false;
425:         // Read by the GlowLayer emissive selector (sceneLook.ts); null keeps
426:         // the default body parts off the glow pass.
427:         mesh.metadata.itemTier = tier?.active ? tier : null;
428:         mesh.metadata.timeOffset = 0;
429:         if (tier?.active) requestGlowProbe();
430:       });
431:     } finally {
432:       this.PartsPending--;
433:     }
434:   }
435: 
436:   Update(gameTime: World['gameTime']): void {
437:     super.Update(gameTime);
438: 
439:     // Update all children
440:     for (const child of this.Children) {
441:       child.Update(gameTime);
442:     }
443:   }
444: 
445:   Draw(gameTime: World['gameTime']): void {
446:     super.Draw(gameTime);
447: 
448:     // Update all children
449:     for (const child of this.Children) {
450:       child.Draw(gameTime);
451:     }
452:   }
453: }
454: 
455: /** The class a player-rig NPC factory poses as, if it declares one. */
456: export function npcClassOf(
457:   factory: typeof ModelObject
458: ): CharacterClassNumber | null {
459:   return (factory as typeof PlayerObject).NpcClass ?? null;
460: }
