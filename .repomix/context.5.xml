  1: import { afterEach, describe, expect, it } from 'vitest';
  2: import { ServerAccounts } from './serverAccounts';
  3: import { URL_PROFILE_ID } from './serverConfig';
  4: 
  5: const ONE = 'list:one.net';
  6: const TWO = 'list:two.net';
  7: 
  8: afterEach(() => {
  9:   for (const id of [ONE, TWO, URL_PROFILE_ID]) ServerAccounts.forget(id);
 10: });
 11: 
 12: /** An account with a name on it, since a blank row is not a login. */
 13: function named(worldId: string, username: string, password = 'pw'): string {
 14:   const id = ServerAccounts.add(worldId);
 15: 
 16:   ServerAccounts.update(worldId, id, { username, password });
 17: 
 18:   return id;
 19: }
 20: 
 21: describe('ServerAccounts', () => {
 22:   it('reads a world with no account as a blank one', () => {
 23:     expect(ServerAccounts.of(ONE)).toMatchObject({ username: '', password: '' });
 24:     expect(ServerAccounts.list(ONE)).toEqual([]);
 25:     expect(ServerAccounts.has(ONE)).toBe(false);
 26:   });
 27: 
 28:   it('keeps several accounts on one world, with one of them chosen', () => {
 29:     const main = named(ONE, 'main');
 30:     const mule = named(ONE, 'mule');
 31: 
 32:     expect(ServerAccounts.list(ONE).map(a => a.username)).toEqual([
 33:       'main',
 34:       'mule',
 35:     ]);
 36:     // Adding selects what was added, which is the row now being typed into.
 37:     expect(ServerAccounts.activeId(ONE)).toBe(mule);
 38: 
 39:     ServerAccounts.select(ONE, main);
 40:     expect(ServerAccounts.of(ONE).username).toBe('main');
 41:   });
 42: 
 43:   it('keeps one world of accounts apart from the next', () => {
 44:     named(ONE, 'alpha');
 45:     named(TWO, 'beta');
 46: 
 47:     expect(ServerAccounts.of(ONE).username).toBe('alpha');
 48:     expect(ServerAccounts.of(TWO).username).toBe('beta');
 49:     expect(ServerAccounts.count).toBe(2);
 50:   });
 51: 
 52:   it('keeps the name but forgets the password once "remember" is off', () => {
 53:     const id = named(ONE, 'main', 'secret');
 54: 
 55:     ServerAccounts.update(ONE, id, { remember: false });
 56: 
 57:     expect(ServerAccounts.of(ONE)).toMatchObject({
 58:       username: 'main',
 59:       password: '',
 60:       remember: false,
 61:     });
 62:   });
 63: 
 64:   it('clamps what the login packet cannot carry', () => {
 65:     named(ONE, 'waylongerthanten', 'alsowaytoolong');
 66: 
 67:     expect(ServerAccounts.of(ONE).username).toHaveLength(10);
 68:     expect(ServerAccounts.of(ONE).password).toHaveLength(10);
 69:   });
 70: 
 71:   it('refuses the URL profile, which is gone next launch anyway', () => {
 72:     expect(ServerAccounts.add(URL_PROFILE_ID)).toBe('');
 73:     expect(ServerAccounts.list(URL_PROFILE_ID)).toEqual([]);
 74:   });
 75: 
 76:   it('records a login under the account of that name, not a second one', () => {
 77:     const id = named(ONE, 'main', 'old');
 78: 
 79:     ServerAccounts.record(ONE, {
 80:       username: 'main',
 81:       password: 'new',
 82:       remember: true,
 83:     });
 84: 
 85:     expect(ServerAccounts.list(ONE)).toHaveLength(1);
 86:     expect(ServerAccounts.of(ONE)).toMatchObject({
 87:       id,
 88:       password: 'new',
 89:     });
 90:     expect(ServerAccounts.of(ONE).lastLoginAt).toBeGreaterThan(0);
 91:   });
 92: 
 93:   it('records a login with a new name as another account of that world', () => {
 94:     named(ONE, 'main');
 95: 
 96:     ServerAccounts.record(ONE, {
 97:       username: 'mule',
 98:       password: 'pw',
 99:       remember: true,
100:     });
101: 
102:     expect(ServerAccounts.list(ONE).map(a => a.username)).toEqual([
103:       'main',
104:       'mule',
105:     ]);
106:     expect(ServerAccounts.of(ONE).username).toBe('mule');
107:   });
108: 
109:   it('writes nothing down for a login the player asked not to remember', () => {
110:     ServerAccounts.record(ONE, {
111:       username: 'guest',
112:       password: 'pw',
113:       remember: false,
114:     });
115: 
116:     expect(ServerAccounts.list(ONE)).toEqual([]);
117:   });
118: 
119:   it('forgets one account, and falls back to what is left', () => {
120:     const main = named(ONE, 'main');
121: 
122:     named(ONE, 'mule');
123:     ServerAccounts.forget(ONE, ServerAccounts.activeId(ONE));
124: 
125:     expect(ServerAccounts.list(ONE).map(a => a.username)).toEqual(['main']);
126:     expect(ServerAccounts.activeId(ONE)).toBe(main);
