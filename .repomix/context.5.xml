 1: /**
 2:  * A late-bound handle on `Store` for modules that `store.ts` itself (through
 3:  * `logic.ts` → `modelFactoryPerId.ts` → the monster classes) depends on.
 4:  *
 5:  * `common/modelObject.ts` needs `Store.world` at *call* time only, but a
 6:  * value import of `../store` closed the cycle
 7:  * `monsterObject → modelObject → store → logic → modelFactoryPerId →
 8:  * genericMonster → monsterObject`; on a vite HMR re-evaluation the
 9:  * `class MonsterObject extends ModelObject` line ran before `ModelObject`
10:  * was initialised ("Cannot access 'ModelObject' before initialization",
11:  * B14). `store.ts` registers itself here once it exists; this file imports
12:  * nothing at runtime, so it can sit anywhere in the graph.
13:  */
14: import type { Store as StoreType } from '../store';
15: 
16: type StoreInstance = typeof StoreType;
17: 
18: let current: StoreInstance | null = null;
19: 
20: /** Called once by `store.ts` right after `Store` is constructed. */
21: export function registerStore(store: StoreInstance): void {
22:   current = store;
23: }
24: 
25: /** The live `Store`; throws if asked for before `store.ts` has evaluated. */
26: export function storeRef(): StoreInstance {
27:   if (!current) throw new Error('storeRef(): Store is not registered yet');
28:   return current;
29: }
