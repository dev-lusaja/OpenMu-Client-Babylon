 262:   }).join(',\n')}
 263:       };
 264:       ${structureSize != null ? `${fieldName}_StartOffset += ${estSize};` : `${fieldName}_StartOffset += ${estSize};`}
 265:     }`;
 266: }
 267: 
 268: function getEnumName(p: Packet, typeName: string): string {
 269:   if (PREDEFINED_ENUMS.has(typeName)) return typeName as any;
 270: 
 271:   const pEnum = p.enums.find(e => e.name === typeName);
 272:   if (pEnum) return `${p.name}${typeName}Enum` as any;
 273: 
 274:   const globalEnum = globalEnums.find(e => e.name === typeName);
 275:   if (globalEnum) return globalEnum.name + 'Enum';
 276: 
 277:   return `Byte`;
 278: }
 279: 
 280: function generateStructureDefinition(p: Packet, s: Structure): string {
 281:   let structureFields = '{\n';
 282: 
 283:   s.fields.forEach(({ type, name, typeName }) => {
 284:     let tsType: string = type;
 285: 
 286:     if (type === 'Enum') {
 287:       tsType = getEnumName(p, typeName ?? type);
 288:     } else if (type === 'Structure[]') {
 289:       const nested = p.structures.find(s => s.name === typeName) ?? globalStructures.find(s => s.name === typeName);
 290:       if (!nested) {
 291:         const e = new Error('no struct ' + typeName);
 292:         console.error(e);
 293:         throw e;
 294:       }
 295:       tsType = generateStructureDefinition(p, nested) + '[]';
 296:     } else if (type === 'String') {
 297:       tsType = 'string';
 298:     }
 299:     structureFields += `  ${name}: ${tsType};\n`;
 300:   });
 301: 
 302:   return structureFields + "\n}";
 303: }
