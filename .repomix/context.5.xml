<file path="src/common/staticClips.ts">
  1: import type {
  2:   Animation,
  3:   AnimationGroup,
  4:   TargetedAnimation,
  5: } from '../libs/babylon/exports';
  6: 
  7: /**
  8:  * Clips that hold still.
  9:  *
 10:  * MU's rigs key every bone on every frame of every clip, whether the bone
 11:  * moves or not: a swaying tree animates a few branch tips and writes the same
 12:  * value to its trunk sixty times a second. Babylon runs one Animatable per
 13:  * keyed bone, so the still ones are most of a map's animation work (Noria at
 14:  * the spawn: 2 288 of 2 578 running animations held one value). A still
 15:  * animation is a pose, not a motion: it is written once and taken out of the
 16:  * loop.
 17:  */
 18: 
 19: const KEY_EPSILON = 1e-6;
 20: 
 21: type WithEpsilon = {
 22:   equalsWithEpsilon?: (other: unknown, epsilon: number) => boolean;
 23: };
 24: 
 25: function sameValue(a: unknown, b: unknown): boolean {
 26:   if (typeof a === 'number') {
 27:     return typeof b === 'number' && Math.abs(a - b) <= KEY_EPSILON;
 28:   }
 29: 
 30:   const compare = (a as WithEpsilon | null)?.equalsWithEpsilon;
 31: 
 32:   if (typeof compare === 'function') return compare.call(a, b, KEY_EPSILON);
 33: 
 34:   return a === b;
 35: }
 36: 
 37: /** Every key of the animation holds one value. */
 38: export function isStillAnimation(animation: Animation): boolean {
 39:   const keys = animation.getKeys();
 40: 
 41:   for (let i = 1; i < keys.length; i++) {
 42:     if (!sameValue(keys[0].value, keys[i].value)) return false;
 43:   }
 44: 
 45:   return true;
 46: }
 47: 
 48: type Cloneable = { clone?: () => unknown };
 49: type Copyable = { copyFrom?: (value: unknown) => unknown };
 50: 
 51: /** Write the animation's one value straight onto its target. */
 52: function applyStillValue(targeted: TargetedAnimation): void {
 53:   const keys = targeted.animation.getKeys();
 54: 
 55:   if (keys.length === 0) return;
 56: 
 57:   const value: unknown = keys[0].value;
 58:   const path = targeted.animation.targetPropertyPath;
 59:   let owner = targeted.target as Record<string, unknown> | undefined;
 60: 
 61:   for (let i = 0; i < path.length - 1; i++) {
 62:     owner = owner?.[path[i]] as Record<string, unknown> | undefined;
 63:   }
 64: 
 65:   if (!owner) return;
 66: 
 67:   const property = path[path.length - 1];
 68:   const current = owner[property] as Copyable | null | undefined;
 69: 
 70:   if (current && typeof current.copyFrom === 'function') {
 71:     current.copyFrom(value);
 72:   } else if (typeof (value as Cloneable | null)?.clone === 'function') {
 73:     owner[property] = (value as Required<Cloneable>).clone();
 74:   } else {
 75:     owner[property] = value;
 76:   }
 77: }
 78: 
 79: /**
 80:  * Take the still animations out of a group. Each is written once now if the
 81:  * group is running, and again whenever the group starts, so a model that
 82:  * hands a bone from one clip to another (a door, a lever) gets its pose
 83:  * written back the way the clip would have. A running group is restarted on
 84:  * its own settings so the Animatables it holds are rebuilt without them.
 85:  *
 86:  * A group that would be left with nothing keeps one still animation: an
 87:  * empty group never starts, and the pose rides on its start. A paused group
 88:  * is left alone. Returns how many went.
 89:  */
 90: export function settleStillAnimations(group: AnimationGroup): number {
 91:   if (group.isStarted && !group.isPlaying) return 0;
 92: 
 93:   const still = group.targetedAnimations.filter(targeted =>
 94:     isStillAnimation(targeted.animation)
 95:   );
 96: 
 97:   if (still.length === group.targetedAnimations.length) still.pop();
 98:   if (still.length === 0) return 0;
 99: 
100:   const running = group.isStarted;
101:   const loop = group.loopAnimation;
102:   const speed = group.speedRatio;
103: 
104:   if (running) group.stop(true);
105: 
106:   for (const targeted of still) group.removeTargetedAnimation(targeted.animation);
107: 
108:   group.onAnimationGroupPlayObservable.add(() => {
109:     for (const targeted of still) applyStillValue(targeted);
110:   });
111: 
112:   if (running) group.start(loop, speed, group.from, group.to, group.isAdditive);
113: 
114:   return still.length;
115: }
</file>

