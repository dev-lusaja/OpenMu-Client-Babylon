1446: /**
1447:  * Fire a projectile, carrying its own light for the length of the flight.
1448:  *
1449:  * The original lights an arrow body every frame it is alive (ZzzEffect.cpp
1450:  * MoveEffect, `AddTerrainLight(..., range 2)` per arrow model);
1451:  * `lighting/skills.ts` holds the colours and decides which models light at
1452:  * all, so anything else through here - a fire ball, a summoned beast -
1453:  * simply asks and is told no. Every shot in the game goes out this way, so
1454:  * a volley, a skill shot and a plain bow shot all light the same.
1455:  */
1456: function shoot(scene: Scene, from: Vector3, skill: number, opts: ProjectileOptions): void {
1457:   const model = opts.model?.model;
1458:   const head = from.clone();
1459:   const light = model
1460:     ? lighting.arrow(scene, skill, model, out => {
1461:         out.x = head.x;
1462:         out.y = head.y;
1463:         out.z = head.z;
1464:       })
1465:     : null;
1466: 
1467:   effects.spawn('projectile', scene, from, {
1468:     ...opts,
1469:     trace: p => head.copyFrom(p),
1470:     onArrive: at => {
1471:       light?.stop();
1472:       opts.onArrive?.(at);
1473:     },
1474:     onLost: () => {
1475:       light?.stop();
1476:       opts.onLost?.();
1477:     },
1478:   });
1479: }
