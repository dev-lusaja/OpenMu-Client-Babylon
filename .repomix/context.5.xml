1482:  * `n` arrows fanning out from the caster toward `at`: `spread` radians
1483:  * between them, or the explicit angles (Triple Shot ±15°, the five-arrow
1484:  * masters ±5/10/20, Javelin's three).
1485:  */
1486: function fanArrows(at: Vector3, c: SkillContext, n: number, m: string, colour: RGB, spread: number | readonly number[] = TRIPLE_SPREAD, scale = 1): void {
1487:   const from = entityPos(c.caster, CAST_HEIGHT, new Vector3());
1488:   const dx = at.x - from.x;
1489:   const dz = at.z - from.z;
1490:   const dist = Math.hypot(dx, dz) || 1;
1491:   const base = Math.atan2(dx, dz);
1492:   // Captured now: by the time an arrow lands, another skill has been dispatched.
1493:   const skill = currentSkill;
1494:   const impact = SKILL_VISUALS[skill]?.impact ?? steelHit;
1495:   for (let i = 0; i < n; i++) {
1496:     const a = base + (typeof spread === 'number' ? (i - (n - 1) / 2) * spread : spread[i] ?? 0);
1497:     const to = new Vector3(from.x + Math.sin(a) * dist, at.y + IMPACT_HEIGHT * 0.5, from.z + Math.cos(a) * dist);
1498:     shoot(c.scene, from, baseSkill(skill), {
1499:       to,
1500:       speed: ARROW_SPEED,
1501:       model: { model: m, colour, scale },
1502:       onArrive: hit => {
1503:         currentSkill = skill;
1504:         impact(hit, c);
1505:       },
1506:     });
1507:   }
1508: }
