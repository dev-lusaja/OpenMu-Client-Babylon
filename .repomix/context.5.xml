1625: export function playTargetedSkillVisual(
1626:   scene: Scene,
1627:   skill: number,
1628:   caster: Entity,
1629:   target: Entity | null
1630: ): void {
1631:   if (caster.transform) {
1632:     currentSkill = skill;
1633:     const row = skillVisualFor(skill);
1634:     const ctx = contextFor(scene, caster, target);
1635:     const at = target?.transform ? entityPos(target, IMPACT_HEIGHT, new Vector3()) : entityPos(caster, IMPACT_HEIGHT, new Vector3());
1636:     row.cast?.(at, ctx);
1637:     if (row.travel && target?.transform) runTravel(row, ctx, target);
1638:     else if (row.impact) row.impact(at, ctx);
1639:     else if (row.area) {
1640:       at.y -= IMPACT_HEIGHT;
1641:       row.area(at, ctx);
1642:     }
1643:   }
1644: 
1645:   lighting.skillTargeted(scene, skill, caster, target);
1646: }
