 84: const BACK_BOW: BmdLink = { angle: [70, 0, 90], offset: [-10, 5, 10] };
 85: /** Crossbows branch before everything else (:6543-6551). */
 86: const BACK_CROSSBOW: BmdLink = { angle: [0, 20, 180], offset: [-10, 8, 40] };
 87: const BACK_SHIELD: BmdLink = { angle: [70, 0, 90], offset: [-10, 0, 0] };
 88: const LEFT_ITEM_FLIP: BmdLink = { angle: [145, 0, 275], offset: [0, 10, -30] };
 89: /** Rage Fighter common weapons flip at 265° with an extra +7 Y (:6743-6747). */
 90: const LEFT_ITEM_FLIP_RAGE: BmdLink = {
 91:   angle: [145, 0, 265],
 92:   offset: [0, 10, -30],
 93: };
