<file path="src/common/serverList.ts">
  1: import { makeAutoObservable, runInAction } from 'mobx';
  2: import { LocalStorage } from '../libs/localStorage';
  3: import { WS_HOST, WS_PORT } from '../consts';
  4: import {
  5:   isUsableHost,
  6:   normalizeHost,
  7:   normalizeWsUrl,
  8:   ServerConfig,
  9:   type PublishedGameServer,
 10:   type ServerProfile,
 11: } from './serverConfig';
 12: import {
 13:   CONVENTION_CS_HOST,
 14:   CONVENTION_CS_PORT,
 15:   conventionProxyUrl,
 16: } from './serverServices';
 17: 
 18: /**
 19:  * The published server list - a markdown file in the project's repository, one
 20:  * server per line:
 21:  *
 22:  *     [VERSION:NAME:DESCRIPTION:LANGUAGE:IMAGE](host:port@WSPROXY)
 23:  *
 24:  * The version says which client that world is meant to be played with - the
 25:  * token a `versions/<id>` folder gives as `gameVersion.listTag`, `S6EP3` for
 26:  * the Season 6 Episode 3 build. It matters because the base game is compiled
 27:  * against exactly one version, so a world asking for another is one this build
 28:  * cannot enter, and saying so up front beats a protocol that falls apart after
 29:  * the connect.
 30:  *
 31:  * Version, banner and proxy are all optional; a line carrying none of them is
 32:  * the original three-field form and still parses.
 33:  *
 34:  * Directly under its line, a world may list names for its game servers and
 35:  * their channels, which the connect server's protocol has no room for:
 36:  *
 37:  *     [S6EP3:Somewhere:A world:en](example.net)
 38:  *     - 0: Valhalla
 39:  *       - 0: Peaceful
 40:  *       - 1: Hard
 41:  *
 42:  * The outer id is the server group (`ServerId >> 8`) and the inner one the id
 43:  * inside it (the low byte) - the number the game server was configured with,
 44:  * which for a world that never set up groups is the whole of its `ServerId`.
 45:  * Whatever is left unnamed keeps the numbered default.
 46:  *
 47:  * *Directly* is the whole rule: the first line that is not one of these ends
 48:  * the block. Names are indented bullets and this file is prose with examples
 49:  * in it, so a run that has to touch its own entry is a run that cannot drift
 50:  * onto somebody else's world.
 51:  *
 52:  * The target is either `host:port` - the connect server as the world's proxy
 53:  * reaches it - or the world's domain on its own, which leaves the addresses to
 54:  * the convention in `serverServices.ts`.
 55:  *
 56:  * Fetched once per launch so a player who has never edited a setting still has
 57:  * somewhere to play, and cached so the launch after that shows the same list
 58:  * before the network answers (or without a network at all).
 59:  *
 60:  * It is fetched from `raw.githubusercontent.com`, not from the `blob/` page: a
 61:  * blob URL serves GitHub's HTML and no CORS header, so the browser could not
 62:  * read it even if it wanted to.
 63:  *
 64:  * The list is **untrusted text from the internet**. Every line goes through the
 65:  * same normalisers a typed field does, and a line that does not parse is
 66:  * dropped rather than repaired - a list nobody can edit into a broken client is
 67:  * worth more than one that shows every row.
 68:  */
 69: 
 70: const CACHE_KEY = 'mu_serverlist';
 71: 
 72: const DEFAULT_LIST_URL =
 73:   'https://raw.githubusercontent.com/Ignies/OpenMu-Client-Babylon/main/serverlist.md';
 74: 
 75: /** Refuse to parse a list that is not a list - a login page, an error blob. */
 76: const MAX_BYTES = 64 * 1024;
 77: 
 78: /** Enough for any real list; a longer file is a mistake or an attack. */
 79: const MAX_ENTRIES = 50;
 80: 
 81: const MAX_FIELD = 60;
 82: 
 83: /**
 84:  * The label and the target, split apart. The blurb may hold colons, so the name
 85:  * is the first field and the language the last before the image; everything
 86:  * between is the description.
 87:  */
 88: const LINE_RE = /^\s*\[([^\]]+)\]\(\s*([^)\s]+)\s*\)\s*$/;
 89: 
 90: /**
 91:  * The target, in either of two forms.
 92:  *
 93:  * `host:port`, and optionally `@` and the proxy that reaches it. The proxy is
 94:  * a URL with colons of its own, so a colon cannot also be what separates it
 95:  * from the server - `@` reads as "this server, at that proxy" and cannot be
 96:  * mistaken for part of either address.
 97:  *
 98:  * Or the world's domain alone, which says all of it at once through the
 99:  * convention in `serverServices.ts`: the proxy is `ws.<domain>`, and the
100:  * connect server is where that proxy reaches it. A world publishing itself to
101:  * strangers should not have to spell out its own internals, and a client that
102:  * plays any world cannot have been built knowing them.
103:  */
104: const TARGET_RE = /^([^:\s@]+)(?::(\d{1,5}))?(?:@(.+))?$/;
105: 
106: /**
107:  * A domain, for the short form. Two labels at least, ending in a real TLD:
108:  * a single label is a name on somebody's own network and `ws.mybox` is not a
109:  * world anyone else can reach, and an IP has no labels to hang services off at
110:  * all. `localhost:44405` and `1.2.3.4:44405` still parse - as the long form,
111:  * which is what they are.
112:  */
113: const DOMAIN_RE = /^[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}$/;
114: 
115: /**
116:  * A proxy address and nothing else: a ws scheme, a host, an optional port. No
117:  * path, query or credentials - the socket appends its own `?host=&port=`, so a
118:  * line asking for more is asking for something this client does not do.
119:  *
120:  * The scheme is required rather than defaulted. `normalizeWsUrl` would read a
121:  * bare host as one, but this is somebody else's text: a field that does not say
122:  * what it is gets dropped, like every other field here.
123:  */
124: const WS_RE = /^wss?:\/\/[A-Za-z0-9._-]+(?::\d{1,5})?\/?$/i;
125: 
126: /**
127:  * The version token a line may put first: which client that world expects to
128:  * be played with (`S6EP3`, and whatever a future `versions/<id>` calls itself
129:  * in `gameVersion.listTag`).
130:  *
131:  * It is optional, and a line that omits it still parses - so the field has to
132:  * be told apart from the name that used to be first. A version token is short,
133:  * unspaced, and contains a digit; server names in practice do not (`Test-Server`
134:  * has a hyphen, `Aida` has no digit). The cost of the guess is bounded either
135:  * way: a name mistaken for a version leaves the world unplayable-looking rather
136:  * than mis-addressed, and the fix is to publish the version field.
137:  */
138: const VERSION_RE = /^(?=.*\d)[A-Za-z0-9.]{2,12}$/;
139: 
140: /**
141:  * A name line under a world: a bullet, an id, and what to call it. Flush left
142:  * it names a game server; indented it names a channel of the game server above
143:  * it, so the nesting the markdown already shows is the nesting that is read.
144:  *
145:  * The name may be empty, which opens a game server without renaming it: a
146:  * world with one game server and several channels has nothing to say about the
147:  * group itself and should not have to invent something.
148:  */
149: const NAME_RE = /^(\s*)-\s+(\d{1,3})\s*:[ \t]*(.*)$/;
150: 
151: /** `ServerId` is a group byte and a channel byte: neither id passes one. */
152: const MAX_ID = 255;
153: 
154: /** What the picker has room for: ten game servers a side, sixteen channels. */
155: const MAX_GAME_SERVERS = 20;
156: const MAX_CHANNELS = 16;
157: 
158: export type ServerListState = 'idle' | 'loading' | 'ok' | 'error';
159: 
160: /** `?list=<url>` points the client at another list; `?list=off` skips it. */
161: function listUrl(): string | null {
162:   const fromEnv = import.meta.env.VITE_SERVER_LIST_URL as string | undefined;
163: 
164:   if (typeof location === 'undefined') return fromEnv || DEFAULT_LIST_URL;
165: 
166:   const param = new URLSearchParams(location.search).get('list');
167: 
168:   if (param === 'off') return null;
169:   if (param) return param;
170: 
171:   return fromEnv || DEFAULT_LIST_URL;
172: }
173: 
174: const trimField = (value: string) => value.trim().slice(0, MAX_FIELD);
175: 
176: /** A banner is a URL, and an absurdly long one is not. */
177: const MAX_IMAGE_URL = 2048;
178: 
179: const IMAGE_RE = /^https?:\/\/[^\s"'<>]+$/i;
180: 
181: /**
182:  * The image field is a URL, so it carries colons of its own: `https://…` splits
183:  * into `https` and `//…`. The banner therefore starts at the field that is
184:  * exactly a scheme followed by one that starts with `//`, and runs to the end
185:  * of the line. A blurb that merely mentions http is not mistaken for one.
186:  */
187: function splitImage(fields: string[]): { fields: string[]; image: string } {
188:   const at = fields.findIndex(
189:     (field, i) =>
190:       i > 0 &&
191:       /^\s*https?\s*$/i.test(field) &&
192:       fields[i + 1]?.trimStart().startsWith('//')
193:   );
194: 
195:   if (at < 0) return { fields, image: '' };
196: 
197:   const image = fields.slice(at).join(':').trim().slice(0, MAX_IMAGE_URL);
198: 
199:   return {
200:     fields: fields.slice(0, at),
201:     image: IMAGE_RE.test(image) ? image : '',
202:   };
203: }
204: 
205: /**
206:  * One line to a profile, or null. Exported for the parser's own tests - the
207:  * shape of somebody's markdown is exactly the thing worth pinning down.
208:  */
209: export function parseServerLine(line: string): ServerProfile | null {
210:   const match = LINE_RE.exec(line);
211: 
212:   if (!match) return null;
213: 
214:   const { fields: raw, image } = splitImage(match[1].split(':'));
215:   const withVersion = raw.map(trimField);
216:   const version = VERSION_RE.test(withVersion[0] ?? '') ? withVersion[0] : '';
217:   const fields = version ? withVersion.slice(1) : withVersion;
218: 
219:   if (fields.length < 2) return null;
220: 
221:   const name = fields[0];
222:   const language = fields.length > 2 ? fields[fields.length - 1] : '';
223:   const description = fields
224:     .slice(1, fields.length > 2 ? -1 : undefined)
225:     .join(': ');
226: 
227:   const target = TARGET_RE.exec(match[2]);
228: 
229:   if (!target) return null;
230: 
231:   const proxy = (target[3] ?? '').trim();
232:   // No port is the short form: the field is the world's domain, and the
233:   // convention fills in the rest of it.
234:   const domain = target[2] ? '' : normalizeHost(target[1]).toLowerCase();
235: 
236:   if (domain && !DOMAIN_RE.test(domain)) return null;
237: 
238:   const host = domain ? CONVENTION_CS_HOST : normalizeHost(target[1]);
239:   const port = domain ? CONVENTION_CS_PORT : Number(target[2]);
240: 
241:   if (!name || !isUsableHost(host)) return null;
242:   if (!Number.isInteger(port) || port < 1 || port > 65535) return null;
243: 
244:   return {
245:     // Stable across refreshes, so a selected server stays selected: the list
246:     // has no ids of its own, so a world is identified by what it published -
247:     // its domain, or the address it named.
248:     id: domain ? `list:${domain}` : `list:${host}:${port}`,
249:     name,
250:     csHost: host,
251:     csPort: port,
252:     // The proxy the line names, the convention's when it named a domain, and
253:     // this client's own (the build default, or whatever the deployment set)
254:     // when it gave neither. A published world is reached through the proxy it
255:     // was published with - the older two-field target simply says nothing
256:     // about one.
257:     wsUrl: normalizeWsUrl(
258:       WS_RE.test(proxy)
259:         ? proxy
260:         : domain
261:           ? conventionProxyUrl(domain)
262:           : `${WS_HOST}:${WS_PORT}`
263:     ),
264:     gsAddress: 'auto',
265:     listed: true,
266:     ...(domain && { domain }),
267:     ...(version && { version }),
268:     ...(description && { description }),
269:     ...(language && { language }),
270:     ...(image && { image }),
271:   };
272: }
273: 
274: /**
275:  * A name line, or null. The id is range-checked here; where the name belongs
276:  * is the caller's business, since only it knows what was written above.
277:  */
278: function parseNameLine(
279:   line: string
280: ): { indented: boolean; id: number; name: string } | null {
281:   const match = NAME_RE.exec(line);
282: 
283:   if (!match) return null;
284: 
285:   const id = Number(match[2]);
286: 
287:   if (id > MAX_ID) return null;
288: 
289:   return { indented: match[1].length > 0, id, name: trimField(match[3]) };
290: }
291: 
292: export function parseServerList(text: string): ServerProfile[] {
293:   const seen = new Set<string>();
294:   const entries: ServerProfile[] = [];
295: 
296:   // The world the name lines are being read into, and the game server they
297:   // nest under. A list is read top to bottom, and a name belongs to whatever
298:   // it was written beneath.
299:   let world: ServerProfile | null = null;
300:   let gameServer: PublishedGameServer | null = null;
301: 
302:   for (const line of text.split(/\r?\n/)) {
303:     const profile = parseServerLine(line);
304: 
305:     if (profile) {
306:       if (entries.length >= MAX_ENTRIES) break;
307: 
308:       // A world dropped as a duplicate still ends the one before it: the names
309:       // under this line were written for this line, not for that one.
310:       world = null;
311:       gameServer = null;
312: 
313:       if (seen.has(profile.id)) continue;
314: 
315:       seen.add(profile.id);
316:       entries.push(profile);
317:       world = profile;
318:       continue;
319:     }
320: 
321:     const named = parseNameLine(line);
322: 
323:     // Prose, a blank line, the end of a code fence: names run until the first
324:     // line that is not one, so the ones written in this file's own examples
325:     // stay examples.
326:     if (!named) {
327:       world = null;
328:       gameServer = null;
329:       continue;
330:     }
331: 
332:     if (!world) continue;
333: 
334:     if (named.indented) {
335:       if (!gameServer || !named.name) continue;
336:       if (gameServer.channels.length >= MAX_CHANNELS) continue;
337:       if (gameServer.channels.some(c => c.id === named.id)) continue;
338: 
339:       gameServer.channels.push({ id: named.id, name: named.name });
340:       continue;
341:     }
342: 
343:     const servers = (world.servers ??= []);
344:     // Named twice: keep the first name, and keep taking channels for it rather
345:     // than dropping the lines under the second one on the floor.
346:     const existing = servers.find(s => s.id === named.id);
347: 
348:     if (existing) {
349:       gameServer = existing;
350:       continue;
351:     }
352: 
353:     if (servers.length >= MAX_GAME_SERVERS) {
354:       gameServer = null;
355:       continue;
356:     }
357: 
358:     gameServer = { id: named.id, name: named.name, channels: [] };
359:     servers.push(gameServer);
360:   }
361: 
362:   return entries;
363: }
364: 
365: class ServerListStore {
366:   state: ServerListState = 'idle';
367: 
368:   /** Why the last fetch failed, for the picker's note line. */
369:   error: string | null = null;
370: 
371:   constructor() {
372:     makeAutoObservable(this);
373:   }
374: 
375:   set(state: ServerListState, error: string | null = null): void {
376:     runInAction(() => {
377:       this.state = state;
378:       this.error = error;
379:     });
380:   }
381: }
382: 
383: export const ServerList = new ServerListStore();
384: 
385: /**
386:  * Fetches the list and hands it to `ServerConfig`. Never throws and never
387:  * blocks anything: an unreachable list leaves the player with their saved
388:  * servers, which is exactly where they were before it existed.
389:  */
390: export async function refreshServerList(): Promise<void> {
391:   // The cached copy first, so the picker is populated on the frame it opens.
392:   const cached = LocalStorage.load(CACHE_KEY);
393: 
394:   if (cached) ServerConfig.setListed(parseServerList(cached));
395: 
396:   const url = listUrl();
397: 
398:   if (!url) return;
399: 
400:   ServerList.set('loading');
401: 
402:   try {
403:     const response = await fetch(url, { cache: 'no-cache' });
404: 
405:     if (!response.ok) throw new Error(`HTTP ${response.status}`);
406: 
407:     const text = (await response.text()).slice(0, MAX_BYTES);
408:     const entries = parseServerList(text);
409: 
410:     ServerConfig.setListed(entries);
411:     LocalStorage.save(CACHE_KEY, text);
412:     ServerList.set('ok');
413:   } catch (e) {
414:     // Offline, blocked, moved, rewritten as something that is not a list: the
415:     // saved servers still work, so this is a note in the picker, not an error
416:     // anyone has to act on.
417:     console.warn(`server list (${url}) not read:`, e);
418:     ServerList.set('error', e instanceof Error ? e.message : String(e));
419:   }
420: }
</file>

