<file path="src/common/quickItemRules.ts">
 1: import { HIGH_DROP_LEVEL } from './dropTier';
 2: import { StorageKind } from './itemStorage';
 3: import { isJewel, itemDef } from './itemStats';
 4: import type { Item } from '../ecs/world';
 5: 
 6: /**
 7:  * The decisions behind the Ctrl-click actions (`quickItemActions.ts`): where
 8:  * an item goes, whether it is worth asking about first, and when a bulk buy
 9:  * stops.
10:  *
11:  * Kept apart from the run itself, the way `inventoryLayout` is kept apart
12:  * from `inventorySort`: this half is pure, so it can be reasoned about (and
13:  * tested) without a store, a socket or a server.
14:  */
15: 
16: /** Upper bound on one bulk buy, the same order as the arrange run's. */
17: export const MAX_BULK_BUY = 120;
18: 
19: export type QuickTarget =
20:   | { kind: 'move'; to: StorageKind }
21:   | { kind: 'sell' };
22: 
23: export type OpenWindows = {
24:   /** `Economy.autoMoveTarget`: the storage grid a right click already feeds. */
25:   storage: StorageKind | null;
26:   /** `Store.npcShop`: the merchant's stall is open. */
27:   shop: boolean;
28: };
29: 
30: /**
31:  * Where a Ctrl-click in the inventory sends the item. A storage window wins
32:  * over the merchant when both are somehow up: a move can be undone, a sale
33:  * cannot.
34:  */
35: export function inventoryTarget(open: OpenWindows): QuickTarget | null {
36:   if (open.storage !== null) return { kind: 'move', to: open.storage };
37:   if (open.shop) return { kind: 'sell' };
38:   return null;
39: }
40: 
41: /** Excellent, ancient, +7 and up, or a jewel: worth asking about first. */
42: export function isValuableItem(item: Item): boolean {
43:   if (item.isExcellent || item.isAncient) return true;
44:   if ((item.lvl ?? 0) >= HIGH_DROP_LEVEL) return true;
45: 
46:   const def = itemDef(item.group, item.num);
47:   return !!def && isJewel(def);
48: }
49: 
50: export type BuyStop = 'done' | 'gone' | 'refused' | 'noZen' | 'noRoom';
51: 
52: export type BuyRunState = {
53:   bought: number;
54:   wanted: number;
55:   /** The stock entry still in that shop slot, or null once it is gone. */
56:   item: Item | null;
57:   price: number;
58:   money: number;
59:   /** `Store.findFreeSquare` on the inventory; -1 when nothing fits. */
60:   freeSquare: number;
61:   /** The merchant said no to the last purchase. */
62:   refused: boolean;
63: };
64: 
65: /** Why the bulk buy stops before the next purchase, or null to carry on. */
66: export function buyRunStop(state: BuyRunState): BuyStop | null {
67:   if (state.refused) return 'refused';
68:   if (state.bought >= state.wanted) return 'done';
69:   if (!state.item) return 'gone';
70:   if (state.money < state.price) return 'noZen';
71:   if (state.freeSquare < 0) return 'noRoom';
72:   return null;
73: }
</file>

