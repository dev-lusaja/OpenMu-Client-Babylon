 1: import { makeAutoObservable, runInAction } from 'mobx';
 2: import { LocalStorage } from '../libs/localStorage';
 3: 
 4: /**
 5:  * Starred rows of the move list (`MoveReq_eng.bmd` indices), kept at the top
 6:  * of the window so the two or three maps a character actually travels to
 7:  * stop being a scroll away.
 8:  *
 9:  * Purely local: the warp itself is the same `WarpCommandRequest` the row
10:  * always sent, so the server neither knows nor cares which rows are starred.
11:  */
12: 
13: const STORAGE_KEY = 'mu-warp-favourites';
14: 
15: function load(): number[] {
16:   try {
17:     const raw = LocalStorage.load(STORAGE_KEY);
18:     if (!raw) return [];
19:     const parsed = JSON.parse(raw) as unknown;
20:     return Array.isArray(parsed) ? parsed.filter(v => typeof v === 'number') : [];
21:   } catch {
22:     return [];
23:   }
24: }
25: 
26: export const WarpFavourites = new (class _WarpFavourites {
27:   private indices: number[] = load();
28: 
29:   constructor() {
30:     makeAutoObservable<this, 'indices'>(this, { indices: true });
31:   }
32: 
33:   has(index: number): boolean {
34:     return this.indices.includes(index);
35:   }
36: 
37:   get count(): number {
38:     return this.indices.length;
39:   }
40: 
41:   toggle(index: number): void {
42:     runInAction(() => {
43:       this.indices = this.has(index)
44:         ? this.indices.filter(i => i !== index)
45:         : [...this.indices, index];
46:     });
47:     LocalStorage.save(STORAGE_KEY, JSON.stringify(this.indices));
48:   }
49: })();
</file>

