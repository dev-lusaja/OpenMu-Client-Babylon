 96: let deltaTexture: RawTexture | null = null;
 97: 
 98: export function getTerrainLightTexture(scene: Scene): RawTexture {
 99:   if (!deltaTexture || deltaTexture.getScene() !== scene) {
100:     deltaTexture = RawTexture.CreateRGBATexture(
101:       new Uint8Array(TERRAIN_SIZE * TERRAIN_SIZE * 4),
102:       TERRAIN_SIZE,
103:       TERRAIN_SIZE,
104:       scene,
105:       false,
106:       false,
107:       Texture.BILINEAR_SAMPLINGMODE
108:     );
109: 
110:     deltaTexture.name = 'terrainDynamicLight';
111:     deltaTexture.wrapU = Texture.CLAMP_ADDRESSMODE;
112:     deltaTexture.wrapV = Texture.CLAMP_ADDRESSMODE;
113:   }
114: 
115:   return deltaTexture;
