 1: import { TERRAIN_SCALE, TERRAIN_SIZE } from './consts';
 2: import { TERRAIN_INDEX, TERRAIN_INDEX_REPEAT } from './utils';
 3: 
 4: /**
 5:  * Per-texel terrain normals, packed as 3 floats per texel.
 6:  *
 7:  * This is the original `Vector3[]` routine transcribed to plain float math
 8:  * over one `Float32Array`. Two reasons: it is 65 536 fewer allocations, and
 9:  * it makes the whole normal → light chain Babylon-free, so it can run in the
10:  * terrain worker (todo C8) and its result can be transferred rather than
11:  * cloned. The arithmetic - two face normals per texel, summed, left
12:  * un-normalised - is unchanged.
13:  *
14:  * Including the degenerate case: the original hoisted one `face_normal`
15:  * scratch vector outside both loops and `FaceNormalize` returned early
16:  * without writing to it when the cross product had zero length, so the
17:  * *previous* face's normal was added instead. `fnx/fny/fnz` below are that
18:  * same carried scratch. (With TERRAIN_SCALE = 1 the quad corners are always
19:  * distinct in XY, so this branch is unreachable in practice - it is kept
20:  * because "unreachable" is an assumption about the height data, not a
21:  * guarantee.)
22:  */
23: export function createTerrainNormal(heightBuffer: Float32Array): Float32Array {
24:   const result = new Float32Array(TERRAIN_SIZE * TERRAIN_SIZE * 3);
25: 
26:   let fnx = 0;
27:   let fny = 0;
28:   let fnz = 0;
29: 
30:   /** Cross product of (b-a)×(c-a), normalised, into the carried scratch. */
31:   const faceNormalize = (
32:     ax: number, ay: number, az: number,
33:     bx: number, by: number, bz: number,
34:     cx: number, cy: number, cz: number
35:   ) => {
36:     const nx = (by - ay) * (cz - az) - (cy - ay) * (bz - az);
37:     const ny = (bz - az) * (cx - ax) - (cz - az) * (bx - ax);
38:     const nz = (bx - ax) * (cy - ay) - (cx - ax) * (by - ay);
39: 
40:     const dot = Math.sqrt(nx * nx + ny * ny + nz * nz);
41: 
42:     if (dot === 0) return; // carries the previous face's normal, as the original does
43: 
44:     fnx = nx / dot;
45:     fny = ny / dot;
46:     fnz = nz / dot;
47:   };
48: 
49:   for (let y = 0; y < TERRAIN_SIZE; y++) {
50:     for (let x = 0; x < TERRAIN_SIZE; x++) {
51:       const o = TERRAIN_INDEX(x, y) * 3;
52: 
53:       // The quad whose lower-left corner is (x, y). The original built these
54:       // as Vector3(x * SCALE, y * SCALE, height) - z is the height axis here.
55:       const v4x = x * TERRAIN_SCALE;
56:       const v4y = y * TERRAIN_SCALE;
57:       const v4z = heightBuffer[TERRAIN_INDEX_REPEAT(x, y)];
58: 
59:       const v1x = (x + 1) * TERRAIN_SCALE;
60:       const v1y = y * TERRAIN_SCALE;
61:       const v1z = heightBuffer[TERRAIN_INDEX_REPEAT(x + 1, y)];
62: 
63:       const v2x = (x + 1) * TERRAIN_SCALE;
64:       const v2y = (y + 1) * TERRAIN_SCALE;
65:       const v2z = heightBuffer[TERRAIN_INDEX_REPEAT(x + 1, y + 1)];
66: 
67:       const v3x = x * TERRAIN_SCALE;
68:       const v3y = (y + 1) * TERRAIN_SCALE;
69:       const v3z = heightBuffer[TERRAIN_INDEX_REPEAT(x, y + 1)];
70: 
71:       let nx = 0;
72:       let ny = 0;
73:       let nz = 0;
74: 
75:       faceNormalize(v1x, v1y, v1z, v2x, v2y, v2z, v3x, v3y, v3z);
76:       nx += fnx;
77:       ny += fny;
78:       nz += fnz;
79: 
80:       faceNormalize(v3x, v3y, v3z, v4x, v4y, v4z, v1x, v1y, v1z);
81:       nx += fnx;
82:       ny += fny;
83:       nz += fnz;
84: 
85:       result[o] = nx;
86:       result[o + 1] = ny;
87:       result[o + 2] = nz;
88:     }
89:   }
90: 
91:   return result;
92: }
</file>

