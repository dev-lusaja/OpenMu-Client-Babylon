1824: /** Drop every buff look on an entity that left (despawn, out of scope). */
1825: export function clearBuffVisuals(entity: Entity): void {
1826:   const byEffect = buffHandles.get(entity);
1827:   if (!byEffect) return;
1828:   for (const h of byEffect.values()) h.stop();
1829:   buffHandles.delete(entity);
1830: }
