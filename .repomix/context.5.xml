 2: 
 3: /**
 4:  * Packet framing and the numeric casts the protocol layer needs, with no
 5:  * Babylon and no DOM behind them.
 6:  *
 7:  * Split out of `utils.ts` for the same reason `binaryUtils.ts` was: that file
 8:  * imports `Scene` / `Texture`, so anything reaching for `getPacketSize` used to
 9:  * drag the whole engine along. The proxy (`proxy/presence.ts`) runs under Bun
10:  * with no browser at all and needs exactly these functions. `utils.ts`
11:  * re-exports everything here, so client code can keep importing it from there.
12:  */
13: 
14: export function byteToString(i: number) {
15:   return i.toString(16).padStart(2, '0').toUpperCase();
16: }
17: 
18: export function getSizeOfPacketType(packetType: number) {
19:   switch (packetType) {
20:     case 0xc1:
21:     case 0xc3:
22:       return 2;
23:     case 0xc2:
24:     case 0xc4:
25:       return 3;
26:     default:
27:       return 0;
28:   }
29: }
30: 
31: export function getPacketHeaderSize(packet: Uint8Array) {
32:   const t = packet[0];
33: 
34:   return getSizeOfPacketType(t);
35: }
36: 
37: export function getPacketSize(packet: Uint8Array) {
38:   switch (packet[0]) {
39:     case 0xc1:
40:     case 0xc3:
41:       return packet[1];
42:     case 0xc2:
43:     case 0xc4:
44:       return (packet[1] << 8) | packet[2];
45:     default:
46:       return 0;
47:   }
48: }
49: 
50: export function setPacketSize(packet: Uint8Array) {
51:   const size = packet.byteLength;
52:   switch (packet[0]) {
53:     case 0xc1:
54:     case 0xc3:
55:       packet[1] = castToByte(size);
56:       break;
57:     case 0xc2:
58:     case 0xc4:
59:       packet[1] = castToByte((size & 0xff00) >> 8);
60:       packet[2] = castToByte(size & 0x00ff);
61:       break;
62:     default:
63:       throw new Error(`Unknown packet type 0x${byteToString(packet[0])}`);
64:   }
65: }
66: 
67: export function stringToBytes(str: string, count = str.length) {
68:   const bytes = new Uint8Array(count);
69:   for (let i = 0; i < str.length; i++) {
70:     bytes[i] = str.charCodeAt(i);
71:   }
72:   return bytes;
73: }
