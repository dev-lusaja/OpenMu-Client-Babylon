  1: import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
  2: import { NetStats } from './netStats';
  3: 
  4: /** Drives `performance.now()` so a pair can be closed at an exact distance. */
  5: let clock = 0;
  6: 
  7: function at(ms: number): void {
  8:   clock = ms;
  9: }
 10: 
 11: beforeEach(() => {
 12:   clock = 0;
 13:   vi.spyOn(performance, 'now').mockImplementation(() => clock);
 14:   NetStats.reset();
 15: });
 16: 
 17: afterEach(() => vi.restoreAllMocks());
 18: 
 19: /** One closed pair of `kind`, `ms` apart. */
 20: function sample(kind: 'chat' | 'itemMove' | 'warp', ms: number): void {
 21:   const start = clock;
 22:   NetStats.markSent(kind);
 23:   at(start + ms);
 24:   NetStats.markAnswered(kind);
 25: }
 26: 
 27: describe('netStats', () => {
 28:   it('has no round trip before the first sample', () => {
 29:     expect(NetStats.roundTripMs).toBeNull();
 30:     expect(NetStats.sampleCount).toBe(0);
 31:   });
 32: 
 33:   it('times a request against its answer', () => {
 34:     sample('chat', 120);
 35:     expect(NetStats.roundTripMs).toBe(120);
 36:   });
 37: 
 38:   it('ignores an answer nothing asked for', () => {
 39:     NetStats.markAnswered('warp');
 40:     expect(NetStats.roundTripMs).toBeNull();
 41:   });
 42: 
 43:   it('keeps the kinds apart', () => {
 44:     NetStats.markSent('chat');
 45:     at(300);
 46:     // The item move never went out, so its answer pairs with nothing.
 47:     NetStats.markAnswered('itemMove');
 48:     expect(NetStats.roundTripMs).toBeNull();
 49: 
 50:     NetStats.markAnswered('chat');
 51:     expect(NetStats.roundTripMs).toBe(300);
 52:   });
 53: 
 54:   it('pairs answers with the requests in the order they were sent', () => {
 55:     NetStats.markSent('chat');
 56:     at(50);
 57:     NetStats.markSent('chat');
 58:     at(100);
 59:     NetStats.markAnswered('chat'); // the first line: 100 ms
 60:     at(160);
 61:     NetStats.markAnswered('chat'); // the second line: 110 ms
 62: 
 63:     expect(NetStats.sampleCount).toBe(2);
 64:     expect(NetStats.roundTripMs).toBe(105);
 65:   });
 66: 
 67:   it('drops a request that was never answered', () => {
 68:     // Five sends with only four pending slots: the oldest is forgotten, so
 69:     // the answer pairs with the second one.
 70:     for (let i = 0; i < 5; i++) {
 71:       at(i * 10);
 72:       NetStats.markSent('warp');
 73:     }
 74:     at(1000);
 75:     NetStats.markAnswered('warp');
 76: 
 77:     expect(NetStats.roundTripMs).toBe(990);
 78:   });
 79: 
 80:   it('throws away a sample slower than the stall cap', () => {
 81:     sample('warp', 9000);
 82:     expect(NetStats.roundTripMs).toBeNull();
 83:     expect(NetStats.sampleCount).toBe(0);
 84:   });
 85: 
 86:   it('takes the median, so one spike does not move the figure', () => {
 87:     sample('chat', 100);
 88:     sample('chat', 110);
 89:     sample('chat', 4000);
 90: 
 91:     expect(NetStats.roundTripMs).toBe(110);
 92:   });
 93: 
 94:   it('averages the middle two on an even count', () => {
 95:     sample('chat', 100);
 96:     sample('chat', 200);
 97: 
 98:     expect(NetStats.roundTripMs).toBe(150);
 99:   });
100: 
101:   it('holds only the recent samples', () => {
102:     for (let i = 0; i < 7; i++) sample('chat', 1000);
103:     expect(NetStats.roundTripMs).toBe(1000);
104: 
105:     // Seven fresh ones push every 1000 out of the window.
106:     for (let i = 0; i < 7; i++) sample('chat', 40);
107:     expect(NetStats.sampleCount).toBe(7);
108:     expect(NetStats.roundTripMs).toBe(40);
109:   });
110: 
111:   it('goes back to no round trip on reset', () => {
112:     sample('chat', 80);
113:     NetStats.reset();
114: 
115:     expect(NetStats.roundTripMs).toBeNull();
116:     expect(NetStats.sampleCount).toBe(0);
