<file path="src/common/turnAngle.ts">
 1: /**
 2:  * Angle helpers transcribed from ZzzAI.cpp (`SignedAngleDelta`,
 3:  * `StepTowardsAngle`, `TurnAngle2`, `FarAngle`, `CreateAngle`), in radians.
 4:  * The original runs them once per 25 Hz tick; `approachAngle` converts the
 5:  * per-tick fraction into a frame-rate independent step.
 6:  */
 7: export const REFERENCE_TICK = 1 / 25;
 8: 
 9: const TWO_PI = Math.PI * 2;
10: 
11: export function normalizeAngle(a: number): number {
12:   a %= TWO_PI;
13:   if (a < 0) a += TWO_PI;
14:   return a;
15: }
16: 
17: /** Shortest signed delta from → to, in (-π, π]. */
18: export function signedAngleDelta(from: number, to: number): number {
19:   let delta = normalizeAngle(to) - normalizeAngle(from);
20:   if (delta > Math.PI) delta -= TWO_PI;
21:   else if (delta < -Math.PI) delta += TWO_PI;
22:   return delta;
23: }
24: 
25: /** `TurnAngle2`: step `current` towards `target` by at most `maxDelta`. */
26: export function turnAngle(current: number, target: number, maxDelta: number): number {
27:   if (maxDelta <= 0) return normalizeAngle(current);
28:   const d = signedAngleDelta(current, target);
29:   const clamped = Math.max(-maxDelta, Math.min(maxDelta, d));
30:   return normalizeAngle(current + clamped);
31: }
32: 
33: /**
34:  * The original's `TurnAngle2(a, t, FarAngle(a, t) * k)` - an exponential
35:  * approach closing `k` of the remaining gap every tick - made frame-rate
36:  * independent: the same fraction per 25 Hz tick regardless of dt.
37:  */
38: export function approachAngle(
39:   current: number,
40:   target: number,
41:   fractionPerTick: number,
42:   dt: number
43: ): number {
44:   const ticks = dt / REFERENCE_TICK;
45:   const keep = Math.pow(1 - fractionPerTick, ticks);
46:   const d = signedAngleDelta(current, target);
47:   return normalizeAngle(current + d * (1 - keep));
48: }
49: 
50: /** `CreateAngle(x1,y1,x2,y2)`: screen-space heading from p1 to p2, degrees in [0,360). */
51: export function createAngleDeg(x1: number, y1: number, x2: number, y2: number): number {
52:   const dx = x2 - x1;
53:   const dy = y2 - y1;
54:   if (Math.abs(dx) < 1e-6 && Math.abs(dy) < 1e-6) return 0;
55:   let deg = (Math.atan2(dx, -dy) * 180) / Math.PI;
56:   deg %= 360;
57:   if (deg < 0) deg += 360;
58:   return deg;
59: }
60: 
61: /** The 8-direction byte the server expects for a yaw (`SendRequestAction` rotation). */
62: export function rotationByteOf(rotYRadians: number): number {
63:   let deg = ((rotYRadians * 180) / Math.PI) % 360;
64:   if (deg < 0) deg += 360;
65:   return Math.floor(((deg + 22.5) / 360) * 8 + 1) % 8;
66: }
</file>

