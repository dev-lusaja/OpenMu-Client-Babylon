 58:   const look = lookDirector()?.state();
 59: 
 60:   return look ? look.key.sceneGain * look.key.emitterGain : 1;
 61: }
 62: 
 63: const HEIGHT_OFFSET = 0.6;
 64: 
 65: export type PointLightEmitter = {
 66:   readonly position: { x: number; y: number; z: number };
 67:   /**
 68:    * The tile-map emitter this light stands in for while it holds a slot:
 69:    * the ground then takes it per pixel (`terrainLighting.ts`) and the tile
 70:    * map carries only the share the slot's fade has not taken yet.
 71:    */
 72:   readonly terrain?: TerrainLightEmitter;
 73:   readonly heightOffset?: number;
 74:   readonly range?: number;
 75:   readonly wander?: number;
 76:   readonly gain?: number;
 77:   /** Higher wins a pool slot before distance is considered (hero gear = 2). */
 78:   readonly priority?: number;
 79:   /**
 80:    * Skip the fade-in when this emitter takes a slot. For lights that start
 81:    * on an event - a lightning strike, a skill impact - where the 0.35 s
 82:    * swell reads as lag. Fade-out on losing a slot is unchanged.
 83:    */
 84:   readonly instant?: boolean;
 85:   color(elapsedMs: number): TerrainLightColor;
 86: };
 87: 
 88: const emitters = new Set<PointLightEmitter>();
 89: 
 90: let pool: PointLight[] = [];
 91: 
 92: /** One ground light per slot, as `terrainLighting.ts` binds it. */
 93: export type GroundLight = {
 94:   x: number;
 95:   z: number;
 96:   /** Tile-map footprint radius, 0 for an empty slot. */
 97:   range: number;
 98:   falloff: number;
 99:   /** Colour with the floor gain, the fade and the dynamic gain folded in. */
100:   r: number;
101:   g: number;
102:   b: number;
103: };
104: 
105: const groundLights: GroundLight[] = [];
106: 
107: /** Terrain emitters a slot stands in for this frame, with the slot's fade. */
108: const heldTerrain = new Map<TerrainLightEmitter, number>();
109: 
110: /** The pool's lights as the ground takes them per pixel this frame. */
111: export function pointLightPoolGroundLights(): readonly GroundLight[] {
112:   return groundLights;
113: }
114: 
115: /** Tile-map emitters the pool lights per pixel this frame, and how far in. */
116: export function pointLightPoolHeldTerrain(): ReadonlyMap<TerrainLightEmitter, number> {
117:   return heldTerrain;
118: }
119: 
120: function clearGroundLight(g: GroundLight): void {
121:   g.x = 0;
122:   g.z = 0;
123:   g.range = 0;
124:   g.falloff = 1;
125:   g.r = 0;
126:   g.g = 0;
127:   g.b = 0;
128: }
129: let poolScene: Scene | null = null;
130: 
131: export function initPointLightPool(scene: Scene): void {
132:   if (poolScene === scene && pool.length) return;
133: 
134:   pool = [];
135:   poolScene = scene;
136: 
137:   for (let i = 0; i < pointLightPoolSize(); i++) {
138:     const light = new PointLight(`torchLight${i}`, Vector3.Zero(), scene);
139: 
140:     light.intensity = 0;
141:     light.range = LIGHT_RANGE;
142: 
143:     light.specular = Color3.Black();
144:   }
145:   pool = scene.lights.filter(
146:     (l): l is PointLight => l instanceof PointLight && l.name.startsWith('torchLight')
147:   );
148: }
149: 
150: /**
151:  * The pool's lights as placed this frame - position, diffuse, intensity and
152:  * range - for a shader that has no Babylon light binding of its own (the
153:  * terrain, for the reflections in standing water). An unused slot has
154:  * intensity 0; readers must treat that as "no light".
155:  */
156: export function pointLightPoolLights(): readonly PointLight[] {
157:   return pool;
158: }
159: 
160: export function registerPointLightEmitter(
161:   emitter: PointLightEmitter
162: ): () => void {
163:   emitters.add(emitter);
164: 
165:   return () => {
166:     emitters.delete(emitter);
167:   };
168: }
169: 
170: const byDistance: { emitter: PointLightEmitter; d: number }[] = [];
171: 
172: const FADE_SECONDS = 0.35;
173: 
174: const WANDER_CHASE = 6;
175: 
176: type Slot = {
177:   emitter: PointLightEmitter | null;
178:   fade: number;
179:   wx: number;
180:   wy: number;
181:   wz: number;
182: };
183: 
184: const slots: Slot[] = [];
185: 
186: let lastElapsedMs = 0;
187: 
188: const desired = new Set<PointLightEmitter>();
189: const incoming: PointLightEmitter[] = [];
190: 
191: export function updatePointLightPool(elapsedMs: number, camera: Camera): void {
192:   if (!pool.length) return;
193: 
194:   const dt = Math.min(Math.max((elapsedMs - lastElapsedMs) / 1000, 0), 0.25);
195:   lastElapsedMs = elapsedMs;
196: 
197:   while (slots.length < pool.length) {
198:     slots.push({
199:       emitter: null,
200:       fade: 0,
201:       wx: 0,
202:       wy: 0,
203:       wz: 0,
204:     });
205:   }
206: 
207:   while (groundLights.length < pool.length) {
208:     groundLights.push({ x: 0, z: 0, range: 0, falloff: 1, r: 0, g: 0, b: 0 });
209:   }
210:   heldTerrain.clear();
211: 
212:   if (!GameOptions.dynamicLights || emitters.size === 0) {
213:     for (const light of pool) light.intensity = 0;
214:     for (const slot of slots) {
215:       slot.emitter = null;
216:       slot.fade = 0;
217:     }
218:     for (const g of groundLights) clearGroundLight(g);
219:     return;
220:   }
221: 
222:   // Rank from what the player is looking *at*, not from where the camera
223:   // stands. The arc camera sits ~10 tiles back and above the hero, so
224:   // camera-distance ranking favoured emitters in the bottom of the frame -
225:   // between the lens and the hero - over the torch the hero is standing next
226:   // to. The camera target is the hero (or the login-scene focus), which is
227:   // the centre of the screen and the thing the lights are for.
228:   const focus = (camera as { target?: Vector3 }).target ?? camera.globalPosition;
229: 
230:   byDistance.length = 0;
231: 
232:   for (const emitter of emitters) {
233:     const dx = emitter.position.x - focus.x;
234:     const dy = emitter.position.y - focus.y;
235:     const dz = emitter.position.z - focus.z;
236: 
237:     byDistance.push({ emitter, d: dx * dx + dy * dy + dz * dz });
238:   }
239: 
240:   byDistance.sort(
241:     (a, b) =>
242:       (b.emitter.priority ?? 0) - (a.emitter.priority ?? 0) || a.d - b.d
243:   );
244: 
245:   const active = Math.min(pool.length, byDistance.length);
246: 
247:   desired.clear();
248:   for (let i = 0; i < active; i++) desired.add(byDistance[i].emitter);
249: 
250:   incoming.length = 0;
251: 
252:   for (let i = 0; i < active; i++) {
253:     const { emitter } = byDistance[i];
254:     let held = false;
255: 
256:     for (const slot of slots) {
257:       if (slot.emitter === emitter) {
258:         held = true;
259:         break;
260:       }
261:     }
262: 
263:     if (!held) incoming.push(emitter);
264:   }
265: 
266:   const step = FADE_SECONDS > 0 ? dt / FADE_SECONDS : 1;
267: 
268:   // `incoming` is in rank order (priority, then distance), so a freeing slot
269:   // takes the best emitter still waiting. Popping the *end* of it handed the
270:   // slot to the worst one instead, which is the emitter that had just been
271:   // pushed out.
272:   let next = 0;
273: 
274:   for (let i = 0; i < pool.length; i++) {
275:     const light = pool[i];
276:     const slot = slots[i];
277: 
278:     const keep = slot.emitter !== null && desired.has(slot.emitter);
279: 
280:     slot.fade = keep
281:       ? Math.min(1, slot.fade + step)
282:       : Math.max(0, slot.fade - step);
283: 
284:     if (!keep) {
285:       const waiting = incoming[next] ?? null;
286: 
287:       // A slot changes hands when it has faded out - except for an event
288:       // light, which asks for a slot on the frame the strike happens and is
289:       // over inside the 0.35 s that fade takes. Waiting for it meant a skill
290:       // flash never lit anything on a map with more torches than slots.
291:       // Torch to torch still cross-fades.
292:       if (waiting && (slot.fade <= 0 || waiting.instant)) {
293:         slot.emitter = waiting;
294:         next++;
295: 
296:         if (waiting.instant) slot.fade = 1;
297:       } else if (slot.fade <= 0) {
298:         slot.emitter = null;
299:       }
300:     }
301: 
302:     const ground = groundLights[i];
303: 
304:     if (!slot.emitter) {
305:       light.intensity = 0;
306:       clearGroundLight(ground);
307:       continue;
308:     }
309: 
310:     const emitter = slot.emitter;
311:     const { r, g, b } = emitter.color(elapsedMs);
312: 
313:     // The ground's share of this light: the tile emitter's own footprint,
314:     // colour and floor gain, taken per pixel instead of per tile.
315:     const terrain = emitter.terrain;
316: 
317:     if (terrain) {
318:       const tc = terrain.color(elapsedMs);
319:       const k = (terrain.floorGain ?? 1) * slot.fade * dynamicLightGain();
320: 
321:       ground.x = terrain.position.x;
322:       ground.z = terrain.position.z;
323:       ground.range = terrain.range;
324:       ground.falloff = terrain.falloff ?? 1;
325:       ground.r = tc.r * k;
326:       ground.g = tc.g * k;
327:       ground.b = tc.b * k;
328:       heldTerrain.set(terrain, slot.fade);
329:     } else {
330:       clearGroundLight(ground);
331:     }
332: 
333:     light.range = emitter.range ?? LIGHT_RANGE;
334: 
335:     const wander = emitter.wander ?? 0;
336: 
337:     if (wander > 0) {
338:       const chase = Math.min(1, dt * WANDER_CHASE);
339: 
340:       slot.wx += ((Math.random() * 2 - 1) * wander - slot.wx) * chase;
341:       slot.wy += ((Math.random() * 2 - 1) * wander - slot.wy) * chase;
342:       slot.wz += ((Math.random() * 2 - 1) * wander - slot.wz) * chase;
343:     } else {
344:       slot.wx = slot.wy = slot.wz = 0;
345:     }
346: 
347:     light.position.set(
348:       emitter.position.x + slot.wx,
349:       emitter.position.y + (emitter.heightOffset ?? HEIGHT_OFFSET) + slot.wy,
350:       emitter.position.z + slot.wz
351:     );
352: 
353:     const peak = Math.max(r, g, b, 0.001);
354: 
355:     light.diffuse.set(r / peak, g / peak, b / peak);
356:     // The Standard material has no specular term, so the pool ships black
357:     // specular; the PBR material is what makes armour glisten under a
358:     // passing torch, and only it gets to see the highlight.
359:     if (pbrMaterialsOn()) {
360:       light.specular.copyFrom(light.diffuse).scaleInPlace(specularLightScale());
361:     } else light.specular.set(0, 0, 0);
362:     light.intensity =
363:       peak *
364:       poolIntensity() *
365:       keyGain() *
366:       (emitter.gain ?? 1) *
367:       slot.fade *
368:       directLightGain() *
369:       dynamicLightGain();
370:   }
371: }
