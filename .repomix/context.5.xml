<file path="src/common/resolveUrlToDataFolder.ts">
 1: import { gameVersion } from '../version';
 2: 
 3: export function resolveUrlToDataFolder(url: string): string {
 4:   if (url.startsWith('http://') || url.startsWith('https://')) return url;
 5:   if (url.startsWith('base64:')) return url;
 6: 
 7:   // Remove the leading slash if it exists
 8:   if (url.startsWith('/') || url.startsWith('.')) {
 9:     url = url.substring(1);
10:   }
11: 
12:   // Read at call time, not module scope: this module sits on import chains
13:   // that evaluate before the version handle is assigned.
14:   return `${gameVersion.data.assets}${url}`;
15: }
