 1: export type TextureScript = {
 2:   bright: boolean;
 3:   hiddenMesh: boolean;
 4:   streamMesh: boolean;
 5:   noneBlendMesh: boolean;
 6:   shadowMesh: 0 | 1 | 2;
 7: };
 8: 
 9: const MAX_TOKEN_LENGTH = 5;
10: 
11: const NAME_LIMIT = 32;
12: 
13: export function parseTextureScript(fileName: string): TextureScript | null {
14:   const name = fileName.slice(0, NAME_LIMIT);
15: 
16:   const start = name.indexOf('_');
17:   if (start === -1) return null;
18: 
19:   const token = name.slice(start).split('.')[0];
20: 
21: const script: TextureScript = {
22:     bright: false,
23:     hiddenMesh: false,
24:     streamMesh: false,
25:     noneBlendMesh: false,
26:     shadowMesh: 0,
27:   };
28: 
29:   let isScript = false;
30:   const length = Math.min(MAX_TOKEN_LENGTH, token.length);
31: 
32:   for (let i = 1; i < length; i++) {
33:     switch (token[i]) {
34:       case 'R':
35:         script.bright = true;
36:         isScript = true;
37:         break;
38:       case 'H':
39:         script.hiddenMesh = true;
40:         isScript = true;
41:         break;
42:       case 'S':
43:         script.streamMesh = true;
44:         isScript = true;
45:         break;
46:       case 'N':
47:         script.noneBlendMesh = true;
48:         isScript = true;
49:         break;
50:       case 'D':
51:         if (token[i + 1] === 'C') {
52:           script.shadowMesh = 1;
53:           isScript = true;
54:         } else if (token[i + 1] === 'T') {
55:           script.shadowMesh = 2;
56:           isScript = true;
57:         }
58:         break;
59:       default:
60:         return null;
61:     }
62:   }
63: 
64:   return isScript ? script : null;
65: }
66: 
67: export function parseTextureScriptFromPath(
68:   texturePath: string
69: ): TextureScript | null {
70:   const baseName = texturePath.split(/[\\/]/).pop();
71:   if (!baseName) return null;
72: 
73:   return parseTextureScript(baseName);
74: }
