334: describe('the GLSL helpers', () => {
335:   it('compile under the style defines only', () => {
336:     const glsl = toonFunctionsGlsl();
337:     expect(glsl).toContain('#if defined(MU_TOON) || defined(MU_TOON_FLAT) || defined(MU_TOON_GRASS)');
338:     expect(glsl).toContain('#ifdef MU_TOON_FLAT');
339:     expect(glsl).toContain('muToonBands');
