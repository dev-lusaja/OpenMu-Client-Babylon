448: /** Which of a caster's meshes are in its silhouette. */
449: export type ShadowMeshRules = {
450:   /**
451:    * `o->BlendMesh` casts with the rest of the body. Off everywhere the
452:    * original has it off, which is everywhere - see `WingObject`.
453:    */
454:   readonly blendMesh: boolean;
455:   /**
456:    * Alpha-keyed meshes cast, cut by their own texture (SHADOW_ALPHA_CUTOFF).
457:    *
458:    * On for characters and their gear, which is what the original's shadow
459:    * pass covers and where the key *is* the shape - armour trim, robes,
460:    * skirts, a weapon's blade. Off for map objects, which are this project's
461:    * own extension of the pass and carry cards the original never meant to
462:    * cast: the pre-baked shadow decals under Lorencia's bridges would throw a
463:    * second, real shadow of themselves, and every barred gate its own bars.
464:    */
465:   readonly keyed: boolean;
466: };
467: 
468: /**
469:  * One projected blob for `slot`, or null when this caster has nothing to
470:  * project. Built on demand - every clone is a full copy of the caster's
471:  * submesh hierarchy and a second set of draw calls, so on a tier where the
472:  * slot never activates it should never exist.
473:  */
474: export function createObjectShadow(
475:   root: AbstractMesh,
476:   parent: TransformNode,
477:   originNode: TransformNode,
478:   slot: number,
479:   rules: ShadowMeshRules
480: ): AbstractMesh | null {
481:   if (!(root instanceof Mesh)) return null;
482: 
483:   return createOneShadow(root, parent, originNode, slot, rules);
484: }
485: 
486: /**
487:  * Whether one of the caster's meshes belongs in the silhouette.
488:  *
489:  * `AddMeshShadowTriangles` (ZzzBMD.cpp:2295) walks every mesh of the body
490:  * and skips exactly two: the one the object nominated as `BlendMesh` -
491:  * an additive glow card, which is light, not matter - and `HiddenMesh`,
492:  * which is not drawn at all. Everything else casts, alpha-keyed or not.
493:  * `shadowSkip` is a `HiddenMesh` set for the shadow pass alone
494:  * (`ModelObject.ShadowHiddenMesh`): the mesh is drawn, its silhouette is not.
495:  *
496:  * The rule here used to drop every mesh whose material needed alpha
497:  * blending, which after `modelLoader`'s TGA → ALPHATESTANDBLEND promotion
498:  * is most of what a character wears: the shadow lost the armour's keyed
499:  * trim and its robes, all of a BLEND-textured weapon, and every wing -
500:  * which is why it read as a thin, naked body. It survives for map objects
501:  * only, as `rules.keyed`.
502:  */
503: export function meshCasts(mesh: AbstractMesh, rules: ShadowMeshRules): boolean {
504:   const blendMesh = mesh.metadata?.brightMesh === true;
505:   const hidden =
506:     mesh.metadata?.hiddenByScript === true ||
507:     mesh.metadata?.shadowSkip === true ||
508:     mesh.isVisible === false;
509:   const keyed = mesh.material?.needAlphaBlending() === true;
510: 
511:   return !hidden && (!blendMesh || rules.blendMesh) && (!keyed || rules.keyed);
512: }
513: 
514: function createOneShadow(
515:   root: Mesh,
516:   parent: TransformNode,
517:   originNode: TransformNode,
518:   slot: number,
519:   rules: ShadowMeshRules
520: ): AbstractMesh | null {
521:   // Decide on the caster before paying for a clone. A map object built
522:   // entirely of alpha cards (Noria's fairy-forest foliage) has nothing to
523:   // cast, and cloning its hierarchy just to strip every mesh and dispose the
524:   // rest was the dominant frame cost of the whole map - see issue #6.
525:   const casts = [root, ...root.getChildMeshes(false)].some(
526:     mesh => meshCasts(mesh, rules) && mesh.getTotalVertices() > 0
527:   );
528: 
529:   if (!casts) return null;
530: 
531:   const clone = root.clone(`${root.name}_shadow${slot}`, parent, false);
532:   if (!clone) return null;
533: 
534:   const material = getShadowMaterial(root.getScene(), slot);
535: 
536:   let hasGeometry = false;
537: 
538:   for (const mesh of [clone, ...clone.getChildMeshes(false)]) {
539:     if (!meshCasts(mesh, rules)) {
540:       if (mesh !== clone) mesh.dispose(false, false);
541:       continue;
542:     }
543: 
544:     const casterTexture = mesh.metadata?.diffuseTexture as Texture | undefined;
545: 
546:     mesh.material = material;
547:     mesh.isPickable = false;
548:     mesh.receiveShadows = false;
549:     mesh.alwaysSelectAsActiveMesh = true;
550:     mesh.doNotSyncBoundingInfo = true;
551: 
552:     mesh.visibility = 1;
553: 
554:     mesh.metadata = {
555:       SkipBoundingBox: true,
556:       shadowOriginNode: originNode,
557:       diffuseTexture: casterTexture,
558:     };
559: 
560:     // The glow layer draws every mesh into its emissive pass with its own
561:     // vertex shader - no ground projection - so a clone would sit on the
562:     // character as a black, depth-writing copy and mask its glow. Keep the
563:     // clones out of every effect layer.
564:     for (const layer of root.getScene().effectLayers) {
565:       if (layer instanceof GlowLayer) layer.addExcludedMesh(mesh as Mesh);
566:     }
567: 
568:     mesh.setEnabled(blobShadowsActive());
569: 
570:     if (mesh.getTotalVertices() > 0) hasGeometry = true;
571:   }
572: 
573:   if (!hasGeometry) {
574:     clone.dispose(false, false);
575:     return null;
576:   }
577: 
578:   return clone;
579: }
</file>

