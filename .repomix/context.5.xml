<file path="src/common/terrain/mapFileEncryption.ts">
 1: import { castToByte } from "../binaryUtils";
 2: 
 3: const XOR_KEY = new Uint8Array([0xD1, 0x73, 0x52, 0xF6, 0xD2, 0x9A, 0xCB, 0x27, 0x3E, 0xAF, 0x59, 0x31, 0x37, 0xB3, 0xE7, 0xA2]);
 4: const BUX_CODE = new Uint8Array([0xFC, 0xCF, 0xAB]);
 5: 
 6: export function encryptMapFile(pbyDst: Uint8Array | null, pbySrc: Uint8Array, iSize: Int): Int {
 7:   if (!pbyDst) return iSize;
 8: 
 9:   let wMapKey = 0x5E;//WORD
10: 
11:   for (let i = 0; i < iSize; ++i) {
12:     pbyDst[i] = (pbySrc[i] + castToByte(wMapKey)) ^ XOR_KEY[i % 16];
13: 
14:     wMapKey = castToByte(pbyDst[i] + 0x3D);
15:   }
16: 
17:   return iSize;
18: }
19: 
20: export function decryptMapFile(pbyDst: Uint8Array, pbySrc: Uint8Array, iSize: Int): Int {
21:   let wMapKey = 0x5E;
22: 
23:   for (let i = 0; i < iSize; ++i) {
24:     pbyDst[i] = (pbySrc[i] ^ XOR_KEY[i % 16]) - castToByte(wMapKey);
25: 
26:     wMapKey = castToByte(pbySrc[i] + 0x3D);
27:   }
28: 
29:   return iSize;
30: }
31: 
32: export function convertBux(Buffer: Uint8Array, Size: Int): void {
33:   for (let i = 0; i < Size; ++i) {
34:     Buffer[i] ^= BUX_CODE[i % 3];
35:   }
36: }
</file>

