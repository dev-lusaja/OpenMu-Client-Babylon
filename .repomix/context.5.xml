 1: import type { World } from '../../ecs/world';
 2: import { loadGLTF } from '../modelLoader';
 3: import { PlayerObject } from '../playerObject';
 4: 
 5: // Man01.glb is a rig-only BMD conversion (0 meshes - see
 6: //  the geometry ships as
 7: // ManHead/ManUpper/ManGloves/ManBoots 01|02 part files (there is no ManLower).
 8: // The original picks the parts per NPC in ZzzCharacter.cpp:
 9: //   14062 MONSTER_ALEX (230):                     Head+0 Upper+1 Gloves+1 Boots+0
10: //   14204 MONSTER_WANDERING_MERCHANT_MARTIN (248): Head+1 Upper+1 Gloves+1 Boots+1
11: //   14224 MONSTER_WANDERING_MERCHANT_HAROLD (250): Head+0 Upper+0 Gloves+0 Boots+0
12: // (+0 = the 01 files, +1 = 02.)
13: // Idle mirrors Lumen: the entity keeps its `monsterAnimation` component and
14: // the animation system's Stop1 (= 0) plays the rig's stand clip - the
15: // PlayerAction indices `startNpcIdle()` picks don't exist on this 2-action rig.
16: abstract class MerchantMan extends PlayerObject {
17:   /** Skin (1 or 2) per part slot, from the ZzzCharacter.cpp cases above. */
18:   protected abstract readonly skins: {
19:     head: number;
20:     upper: number;
21:     gloves: number;
22:     boots: number;
23:   };
24: 
25:   async init(world: World) {
26:     const bmd = await loadGLTF('NPC/Man01.glb', world);
27: 
28:     this.load(bmd);
29: 
30:     const { head, upper, gloves, boots } = this.skins;
31:     // setBodyPartsAsync applies one skin index to every named part, so the
32:     // mixed-skin outfits load in one pass per distinct index.
33:     for (const skin of new Set([head, upper, gloves, boots])) {
34:       this.setBodyPartsAsync(
35:         'NPC/',
36:         head === skin ? 'ManHead' : '',
37:         upper === skin ? 'ManUpper' : '',
38:         '',
39:         gloves === skin ? 'ManGloves' : '',
40:         boots === skin ? 'ManBoots' : '',
41:         skin
42:       );
43:     }
44:   }
45:   // protected override void HandleClick() { }
46: }
47: 
48: // [NpcInfo(230, "Alex")]
49: export class Alex extends MerchantMan {
50:   protected readonly skins = { head: 1, upper: 2, gloves: 2, boots: 1 };
51: }
52: 
53: // [NpcInfo(248, "Wandering Merchant Martin")]
54: export class Martin extends MerchantMan {
55:   protected readonly skins = { head: 2, upper: 2, gloves: 2, boots: 2 };
56: }
57: 
58: // [NpcInfo(250, "Wandering Merchant Harold")]
59: export class Harold extends MerchantMan {
60:   protected readonly skins = { head: 1, upper: 1, gloves: 1, boots: 1 };
61: }
