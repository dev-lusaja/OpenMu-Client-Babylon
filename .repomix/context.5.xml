 256:   constructor(
 257:     readonly world: World,
 258:     readonly map: ENUM_WORLD
 259:   ) {
 260:     this.root = new TransformNode('propBatches', world.scene);
 261:     this.snow = SNOW_GROUND_MAPS.has(map);
 262:     this.mask = needsTerrainMask(map);
 263:     this.tier = lightingTier();
 264:   }
 265: 
 266:   exclusion(type: number, factory: typeof ModelObject): string | null {
 267:     let verdict = this.tableVerdicts.get(type);
 268: 
 269:     if (verdict === undefined) {
 270:       verdict = tableExclusion(this.map, type);
 271:       this.tableVerdicts.set(type, verdict);
 272:     }
 273: 
 274:     const reason = batchExclusion(factory, verdict);
 275:     if (reason !== null) this.excluded.set(type, reason);
 276: 
 277:     return reason;
 278:   }
 279: 
 280:   add(entity: Entity, factory: typeof ModelObject): void {
 281:     const transform = entity.transform;
 282:     const type = entity.modelId;
 283:     if (!transform || type === undefined) return;
 284: 
 285:     let pt = this.types.get(type);
 286: 
 287:     if (!pt) {
 288:       const emitters = lightEmittersFor(this.map, type);
 289:       const lit = (emitters?.length ?? 0) > 0;
 290:       const emitsLight =
 291:         lit && emitters!.some(emitter => recipeFromEmitter(emitter) !== null);
 292:       pt = new PropType(type, factory, lit, emitsLight);
 293:       this.types.set(type, pt);
 294:       this.createPrototype(pt, entity);
 295:     }
 296: 
 297:     const chunk = chunkOf(transform.pos.x, transform.pos.z);
 298: 
 299:     pt.placements.push({
 300:       entity,
 301:       pos: transform.pos,
 302:       rot: transform.rot,
 303:       scale: transform.scale,
 304:       chunk,
 305:     });
 306: 
 307:     entity.propBatch = { type, chunk };
 308: 
 309:     // Everything is added before any prototype resolves (createObjects is
 310:     // synchronous), so a built type only sees a late add on a reload.
 311:     if (pt.state === 'built') {
 312:       this.disposeChunks(pt);
 313:       pt.state = 'pending';
 314:     }
 315: 
 316:     this.syncHold();
 317:   }
 318: 
 319:   /**
 320:    * One real ModelObject of the type, made the way `createModelObject` makes
 321:    * one and then parked disabled: its class picks the file and the material
 322:    * tweaks, its clip plays for every chunk, its skeleton is theirs.
 323:    */
 324:   private createPrototype(pt: PropType, entity: Entity): void {
 325:     const proto = new pt.factory(this.world.scene, this.world.mapParent);
 326: 
 327:     proto.WorldIndex = this.map;
 328:     proto.Type = pt.type;
 329:     proto.IsMapObject = true;
 330:     proto.NodeNamePrefix = 'propBatchProto_';
 331: 
 332:     const blend = blendMeshFor(this.map, pt.type);
 333:     if (blend >= 0) proto.BlendMesh = blend;
 334: 
 335:     proto.node.setEnabled(false);
 336: 
 337:     pt.prototype = proto;
 338: 
 339:     proto.init(this.world, entity).then(
 340:       () => {
 341:         if (this.disposed || pt.state !== 'pending') return;
 342:         if (!proto.gltf || !proto.Ready) this.fallback(pt, 'no model');
 343:       },
 344:       error => {
 345:         if (this.disposed || pt.state !== 'pending') return;
 346:         console.error(`Prop batch ${pt.type}: prototype failed to load:`, error);
 347:         this.fallback(pt, 'load failed');
 348:       }
 349:     );
 350:   }
 351: 
 352:   /** Builds every type whose prototype has arrived. Called once a frame. */
 353:   flush(): void {
 354:     for (const pt of this.types.values()) {
 355:       if (pt.state !== 'pending') continue;
 356: 
 357:       const proto = pt.prototype;
 358:       if (!proto?.Ready || !proto.gltf) continue;
 359: 
 360:       try {
 361:         this.build(pt);
 362:       } catch (error) {
 363:         console.error(`Prop batch ${pt.type}: build failed:`, error);
 364:         this.fallback(pt, 'build failed');
 365:       }
 366:     }
 367: 
 368:     this.syncHold();
 369:   }
 370: 
 371:   private build(pt: PropType): void {
 372:     const proto = pt.prototype!;
 373:     const gltf = proto.gltf!;
 374:     const scene = this.world.scene;
 375: 
 376:     // The node at identity: every submesh's world matrix is then its
 377:     // transform under the root, basis change included.
 378:     proto.updateLocation({ x: 0, y: 0, z: 0 }, 1, { x: 0, y: 0, z: 0 });
 379:     const invNode = proto.node.computeWorldMatrix(true).clone().invert();
 380: 
 381:     const submeshes: Submesh[] = [];
 382:     const rules = { blendMesh: proto.ShadowBlendMeshCasts, keyed: false };
 383: 
 384:     for (const mesh of gltf.mesh.getChildMeshes(false)) {
 385:       if (!(mesh instanceof Mesh)) continue;
 386:       if (mesh.getTotalVertices() === 0) continue;
 387:       if (mesh.metadata?.hiddenByScript || !mesh.isVisible) continue;
 388:       if (!mesh.isEnabled(false)) continue;
 389: 
 390:       const meshToNode = mesh.computeWorldMatrix(true).multiply(invNode);
 391:       const min = Vector3.Zero();
 392:       const max = Vector3.Zero();
 393:       resetBox(min, max);
 394: 
 395:       submeshes.push({
 396:         source: mesh,
 397:         meshToNode,
 398:         min,
 399:         max,
 400:         casts: meshCasts(mesh, rules),
 401:       });
 402:     }
 403: 
 404:     if (submeshes.length === 0) {
 405:       this.fallback(pt, 'no drawable mesh');
 406:       return;
 407:     }
 408: 
 409:     this.samplePosedBounds(gltf, submeshes);
 410: 
 411:     // A submesh the ceiling fade would thin has to stay a mesh of its own.
 412:     const first = pt.placements[0];
 413:     placementMatrix(first, nodeM);
 414:     for (const sub of submeshes) {
 415:       instanceMatrix(sub.meshToNode, nodeM, instM);
 416:       resetBox(boxMin, boxMax);
 417:       extendByBox(sub.min, sub.max, instM, boxMin, boxMax);
 418: 
 419:       if (mayBeCeilingPiece(this.map, boxMin.y, boxMax.y, first.pos.y)) {
 420:         this.fallback(pt, 'ceiling piece');
 421:         return;
 422:       }
 423:     }
 424: 
 425:     pt.submeshes = submeshes;
 426: 
 427:     // What `ModelObject.load` and `applyBlendMesh` would have read off
 428:     // `Lights` on a per-object model: a lamp casts no sun shadow, and its
 429:     // flame card is light, so it takes the map's key gain.
 430:     if (pt.emitsLight) {
 431:       for (const sub of submeshes) {
 432:         sub.source.metadata ??= {};
 433:         sub.source.metadata.csmCaster = false;
 434:         if (sub.source.metadata.brightMesh) sub.source.metadata.lightCard = true;
 435:       }
 436:     }
 437: 
 438:     // Every type is chunked per cell, a dozen statues over twelve cells
 439:     // included: the cell is what holds a chunk to the render-distance ring,
 440:     // and a mesh in a cell that is off costs the walk one check.
 441:     const byChunk = new Map<number, Placement[]>();
 442:     for (const p of pt.placements) {
 443:       const key = p.chunk;
 444:       let list = byChunk.get(key);
 445:       if (!list) {
 446:         list = [];
 447:         byChunk.set(key, list);
 448:       }
 449:       list.push(p);
 450:     }
 451: 
 452:     for (const [key, placements] of byChunk) {
 453:       pt.chunks.set(key, this.buildChunk(pt, key, placements, scene));
 454:     }
 455: 
 456:     pt.state = 'built';
 457:     this.cellsDirty = true;
 458:   }
 459: 
 460:   /**
 461:    * The posed bounds of each submesh over the clip. The converter stores
 462:    * vertices relative to their bone, so the raw box collapses at the origin;
 463:    * the pose at a few frames of the (looping) clip is what the placements are
 464:    * really shaped like.
 465:    */
 466:   private samplePosedBounds(
 467:     gltf: NonNullable<ModelObject['gltf']>,
 468:     submeshes: Submesh[]
 469:   ): void {
 470:     const group = gltf.animationGroups[0];
 471:     const animated = group !== undefined && group.to > group.from;
 472:     const samples = animated ? POSE_SAMPLES : 1;
 473: 
 474:     for (let s = 0; s < samples; s++) {
 475:       if (animated) {
 476:         group.goToFrame(group.from + ((group.to - group.from) * s) / samples);
 477:       }
 478: 
 479:       for (const sub of submeshes) {
 480:         if (!extendByPosedLocalBounds(sub.source, sub.min, sub.max, true)) {
 481:           const box = sub.source.getBoundingInfo().boundingBox;
 482:           Vector3.CheckExtends(box.minimum, sub.min, sub.max);
 483:           Vector3.CheckExtends(box.maximum, sub.min, sub.max);
 484:         }
 485:       }
 486:     }
 487: 
 488:     if (animated) group.goToFrame(group.from);
 489:   }
 490: 
 491:   private buildChunk(
 492:     pt: PropType,
 493:     key: number,
 494:     placements: Placement[],
 495:     scene: World['scene']
 496:   ): Chunk {
 497:     const proto = pt.prototype!;
 498:     const subs = pt.submeshes;
 499:     const n = placements.length;
 500: 
 501:     const inst = new Float32Array(n * 4);
 502:     const matrices = subs.map(() => new Float32Array(n * 16));
 503:     const shadowLists = subs.map(() => [] as number[]);
 504:     const chunkMin = subs.map(() => new Vector3(Infinity, Infinity, Infinity));
 505:     const chunkMax = subs.map(() => new Vector3(-Infinity, -Infinity, -Infinity));
 506:     const casterHeight = subs.map(() => 0);
 507: 
 508:     const shadows = this.tier === null && proto.CastsShadow && !pt.emitsLight;
 509: 
 510:     // A roof holds still. A type whose clip moves is foliage: a tree crown
 511:     // is a thin slab a few tiles up, which is the roof test to the letter,
 512:     // and painting it took the sun off the ground under every tree in tile
 513:     // steps. The per-object scan never saw those - a skinned mesh's box
 514:     // collapses at its bone, and the batches measure the posed one.
 515:     const paintsRoofs = this.mask && !typeSways(proto);
 516: 
 517:     let minX = Infinity;
 518:     let minZ = Infinity;
 519:     let maxX = -Infinity;
 520:     let maxZ = -Infinity;
 521:     let minY = Infinity;
 522:     let maxY = -Infinity;
 523: 
 524:     for (let i = 0; i < n; i++) {
 525:       const p = placements[i];
 526: 
 527:       placementMatrix(p, nodeM);
 528:       this.packLight(p, inst, i * 4);
 529: 
 530:       resetBox(placeMin, placeMax);
 531: 
 532:       for (let j = 0; j < subs.length; j++) {
 533:         const sub = subs[j];
 534: 
 535:         instanceMatrix(sub.meshToNode, nodeM, instM);
 536:         writeInstance(instM, matrices[j], i * 16);
 537: 
 538:         resetBox(boxMin, boxMax);
 539:         extendByBox(sub.min, sub.max, instM, boxMin, boxMax);
 540: 
 541:         Vector3.CheckExtends(boxMin, chunkMin[j], chunkMax[j]);
 542:         Vector3.CheckExtends(boxMax, chunkMin[j], chunkMax[j]);
 543:         Vector3.CheckExtends(boxMin, placeMin, placeMax);
 544:         Vector3.CheckExtends(boxMax, placeMin, placeMax);
 545: 
 546:         const height = boxMax.y - boxMin.y;
 547:         if (height > casterHeight[j]) casterHeight[j] = height;
 548: 
 549:         // Batched roofs paint the same mask the object scan would.
 550:         if (paintsRoofs) {
 551:           const ground = this.world.getTerrainHeight(
 552:             (boxMin.x + boxMax.x) * 0.5,
 553:             (boxMin.z + boxMax.z) * 0.5
 554:           );
 555:           if (isRoofSlab(boxMin.y, boxMax.y, ground)) {
 556:             paintRoof({
 557:               minX: boxMin.x,
 558:               maxX: boxMax.x,
 559:               minZ: boxMin.z,
 560:               maxZ: boxMax.z,
 561:             });
 562:           }
 563:         }
 564:       }
 565: 
 566:       // The blob's size gate, on the whole model at this placement's scale
 567:       // (`ModelObject._blobShadowIsVisible`).
 568:       if (shadows) {
 569:         const height = placeMax.y - placeMin.y;
 570:         const footprint = Math.max(
 571:           placeMax.x - placeMin.x,
 572:           placeMax.z - placeMin.z
 573:         );
 574:         if (
 575:           height >= ModelObject.BLOB_SHADOW_MIN_HEIGHT &&
 576:           footprint <= ModelObject.BLOB_SHADOW_MAX_FOOTPRINT
 577:         ) {
 578:           for (let j = 0; j < subs.length; j++) {
 579:             if (subs[j].casts) shadowLists[j].push(i);
 580:           }
 581:         }
 582:       }
 583: 
 584:       if (p.pos.x < minX) minX = p.pos.x;
 585:       if (p.pos.x > maxX) maxX = p.pos.x;
 586:       if (p.pos.z < minZ) minZ = p.pos.z;
 587:       if (p.pos.z > maxZ) maxZ = p.pos.z;
 588:       if (p.pos.y < minY) minY = p.pos.y;
 589:       if (p.pos.y > maxY) maxY = p.pos.y;
 590:     }
 591: 
 592:     const meshes: Mesh[] = [];
 593:     const shadowMeshes: Mesh[] = [];
 594:     const shadowSubmesh: number[] = [];
 595:     const shadowMatrices: Float32Array[] = [];
 596:     const usedShadowLists: number[][] = [];
 597: 
 598:     for (let j = 0; j < subs.length; j++) {
 599:       const src = subs[j].source;
 600:       const mesh = this.cloneSubmesh(src, `${src.name}_pb${pt.type}_${key}`);
 601: 
 602:       mesh.metadata = {
 603:         ...src.metadata,
 604:         propBatch: true,
 605:         casterHeight: casterHeight[j],
 606:         SkipBoundingBox: true,
 607:         // The uniform stays neutral; the light is per instance.
 608:         bodyLight: undefined,
 609:         // What the culling box was built from, for the debug probes.
 610:         propBatchLocalBox: [
 611:           subs[j].min.asArray(),
 612:           subs[j].max.asArray(),
 613:         ],
 614:         propBatchMeshToNode: Array.from(subs[j].meshToNode.m),
 615:       };
 616:       mesh.material = src.material;
 617:       mesh.receiveShadows = true;
 618:       mesh.visibility = src.visibility;
 619: 
 620:       mesh.thinInstanceSetBuffer('matrix', matrices[j], 16, true);
 621:       mesh.thinInstanceSetBuffer('muInst', inst, 4, false);
 622:       this.setWorldBounds(mesh, chunkMin[j], chunkMax[j]);
 623: 
 624:       meshes.push(mesh);
 625: 
 626:       const list = shadowLists[j];
 627:       if (list.length === 0) continue;
 628: 
 629:       const data = new Float32Array(list.length * 16);
 630:       for (let k = 0; k < list.length; k++) {
 631:         data.set(matrices[j].subarray(list[k] * 16, list[k] * 16 + 16), k * 16);
 632:       }
 633: 
 634:       const shadow = this.cloneSubmesh(src, `${src.name}_pbShadow${pt.type}_${key}`);
 635:       shadow.material = getShadowMaterial(scene, 0);
 636:       shadow.metadata = {
 637:         SkipBoundingBox: true,
 638:         propBatch: true,
 639:         diffuseTexture: src.metadata?.diffuseTexture,
 640:       };
 641:       shadow.receiveShadows = false;
 642:       shadow.visibility = 1;
 643: 
 644:       for (const layer of scene.effectLayers) {
 645:         if (layer instanceof GlowLayer) layer.addExcludedMesh(shadow);
 646:       }
 647: 
 648:       shadow.thinInstanceSetBuffer('matrix', data, 16, true);
 649: 
 650:       const reach = casterHeight[j] * SHADOW_REACH_PER_TILE + SHADOW_REACH_MARGIN;
 651:       this.setWorldBounds(
 652:         shadow,
 653:         new Vector3(chunkMin[j].x - reach, minY - 1, chunkMin[j].z - reach),
 654:         new Vector3(chunkMax[j].x + reach, maxY + 1, chunkMax[j].z + reach)
 655:       );
 656:       shadow.setEnabled(blobShadowsActive());
 657: 
 658:       shadowMeshes.push(shadow);
 659:       shadowSubmesh.push(j);
 660:       shadowMatrices.push(data);
 661:       usedShadowLists.push(list);
 662:     }
 663: 
 664:     return {
 665:       key,
 666:       placements,
 667:       meshes,
 668:       cell: null,
 669:       shadows: shadowMeshes,
 670:       shadowSubmesh,
 671:       shadowLists: usedShadowLists,
 672:       inst,
 673:       matrices,
 674:       shadowMatrices,
 675:       minX,
 676:       minZ,
 677:       maxX,
 678:       maxZ,
 679:       litLastFrame: false,
 680:     };
 681:   }
 682: 
 683:   /**
 684:    * A mesh sharing the prototype submesh's geometry, skeleton and material;
 685:    * bounds and metadata are the caller's.
 686:    */
 687:   private cloneSubmesh(src: Mesh, name: string): Mesh {
 688:     const mesh = src.clone(name, this.root, true) as Mesh;
 689: 
 690:     // Babylon keeps a mesh's thin-instance buffers (`world0..3`, `muInst`)
 691:     // on its *Geometry*, and the clone shares the prototype's. Left shared,
 692:     // every chunk of a type drew whichever chunk set its buffers last. One
 693:     // geometry copy per chunk mesh is the price of per-chunk instances.
 694:     mesh.makeGeometryUnique();
 695: 
 696:     // The clone copies the source's own local transform; the instance
 697:     // matrices already carry it (`meshToNode`), so the mesh itself sits at
 698:     // the origin of its chunk root.
 699:     mesh.position.setAll(0);
 700:     mesh.rotationQuaternion = null;
 701:     mesh.rotation.setAll(0);
 702:     // The mirror every model root carries (`ModelObject.load`: scaling
 703:     // (1, -1, 1)) lives on the chunk mesh, not in the instance matrices:
 704:     // Babylon flips face culling on a negative world determinant in every
 705:     // pass (main, cascades, G-buffer, glow), and it reads the *mesh's*
 706:     // determinant, never an instance's. With the mirror inside the
 707:     // instances every single-sided prop drew inside out.
 708:     mesh.scaling.copyFrom(MIRROR_SCALING);
 709:     // Now, not later: the clone computed a world matrix under the *source's*
 710:     // parent (the model root's basis change) and left its bounds dirty, and
 711:     // Babylon's lazy bounds refresh would read that stale matrix. Then
 712:     // frozen: a chunk never moves, and the per-frame synchronisation check
 713:     // Babylon runs on every mesh is the one thing a static mesh can skip.
 714:     mesh.computeWorldMatrix(true);
 715:     mesh.freezeWorldMatrix();
 716: 
 717:     mesh.skeleton = src.skeleton;
 718:     if (mesh.skeleton) mesh.numBoneInfluencers = 1;
 719:     mesh.isVisible = true;
 720:     mesh.isPickable = false;
 721:     mesh.alwaysSelectAsActiveMesh = false;
 722:     // Bounds are set by hand in world space and the mesh sits at the origin;
 723:     // a sync would also try to derive them from the collapsed raw box.
 724:     mesh.doNotSyncBoundingInfo = true;
 725: 
 726:     return mesh;
 727:   }
 728: 
 729:   /**
 730:    * A culling box in world units on a mesh that sits at the origin. Built
 731:    * against the mesh's own (identity) world matrix and read back once, so
 732:    * the lazy refresh Babylon runs on the first `getBoundingInfo()` finds
 733:    * nothing stale to apply.
 734:    */
 735:   private setWorldBounds(mesh: Mesh, min: Vector3, max: Vector3): void {
 736:     // The box is in world units; the mesh's own world matrix is the mirror,
 737:     // so the local box is the world box mirrored in y.
 738:     const localMin = new Vector3(min.x, -max.y, min.z);
 739:     const localMax = new Vector3(max.x, -min.y, max.z);
 740: 
 741:     mesh.setBoundingInfo(
 742:       new BoundingInfo(localMin, localMax, mesh.getWorldMatrix())
 743:     );
 744:     mesh.getBoundingInfo();
 745:   }
 746: 
 747:   private packLight(p: Placement, inst: Float32Array, o: number): void {
 748:     // A placement with a light carrier in range takes the carrier's light:
 749:     // the terrain plus its own lamp, the sum `RenderSystem` keeps on it.
 750:     const carrier = p.entity.modelObject;
 751:     const light =
 752:       carrier?.Ready === true
 753:         ? carrier.Light
 754:         : this.world.getTerrainLight(p.pos.x, p.pos.z);
 755: 
 756:     packBodyLight(light.x, light.y, light.z, inst, o);
 757:     inst[o + 3] = this.snow && !isTileOpen(p.pos.x, p.pos.z) ? 0 : 1;
 758:   }
 759: 
 760:   /** Re-packs a chunk's light (the torch delta moved). */
 761:   private repackLight(chunk: Chunk): void {
 762:     const { placements, inst } = chunk;
 763: 
 764:     for (let i = 0; i < placements.length; i++) {
 765:       this.packLight(placements[i], inst, i * 4);
 766:     }
 767: 
 768:     for (const mesh of chunk.meshes) mesh.thinInstanceBufferUpdated('muInst');
 769:   }
 770: 
 771:   update(dt: number): void {
 772:     if (this.disposed) return;
 773: 
 774:     // The tier decides how the light is packed and whether the blob exists.
 775:     const tier = lightingTier();
 776:     if (tier !== this.tier) {
 777:       this.tier = tier;
 778:       this.rebuild();
 779:     }
 780: 
 781:     const serial = shadowStateVersion();
 782:     if (serial !== this.shadowSerial) {
 783:       this.shadowSerial = serial;
 784:       const on = blobShadowsActive();
 785:       for (const pt of this.types.values()) {
 786:         for (const chunk of pt.chunks.values()) {
 787:           const here = on && (chunk.cell?.enabled ?? true);
 788:           for (const shadow of chunk.shadows) shadow.setEnabled(here);
 789:         }
 790:       }
 791:     }
 792: 
 793:     if (CELL_CULLING) this.cullCells();
 794: 
 795:     // Classic: BodyLight carries the torch delta, which flickers. Only the
 796:     // chunks a torch reaches are re-packed; tiers >= 1 read the bake alone.
 797:     // A lit type's chunks re-pack while a light carrier stands in them on
 798:     // every tier: the lamp's own colour flickers into its body.
 799:     for (const pt of this.types.values()) {
 800:       if (pt.state !== 'built') continue;
 801:       for (const chunk of pt.chunks.values()) {
 802:         let repack =
 803:           this.tier === null &&
 804:           terrainLightReaches(chunk.minX, chunk.minZ, chunk.maxX, chunk.maxZ);
 805: 
 806:         if (pt.lit) {
 807:           const litNow = chunk.placements.some(
 808:             p => p.entity.modelObject?.Ready === true
 809:           );
 810:           if (litNow || chunk.litLastFrame) repack = true;
 811:           chunk.litLastFrame = litNow;
 812:         }
 813: 
 814:         if (repack) this.repackLight(chunk);
 815:       }
 816:     }
 817: 
 818:     if (this.snow) {
 819:       this.snowTimer += dt;
 820:       if (this.snowTimer >= SNOW_POLL_SECONDS) {
 821:         this.snowTimer = 0;
 822:         const mask = terrainMaskVersion();
 823:         if (mask !== this.maskVersion) {
 824:           this.maskVersion = mask;
 825:           for (const pt of this.types.values()) {
 826:             if (pt.state !== 'built') continue;
 827:             for (const chunk of pt.chunks.values()) this.repackLight(chunk);
 828:           }
 829:         }
 830:       }
 831:     }
 832:   }
 833: 
 834:   /** Every built type back to pending: the next flush rebuilds the chunks. */
 835:   private rebuild(): void {
 836:     for (const pt of this.types.values()) {
 837:       if (pt.state !== 'built') continue;
 838:       this.disposeChunks(pt);
 839:       pt.state = 'pending';
 840:     }
 841:     this.syncHold();
 842:   }
 843: 
 844:   private disposeChunks(pt: PropType): void {
 845:     for (const chunk of pt.chunks.values()) {
 846:       for (const mesh of chunk.meshes) mesh.dispose(false, false);
 847:       for (const shadow of chunk.shadows) shadow.dispose(false, false);
 848:     }
 849:     pt.chunks.clear();
 850:     this.cellsDirty = true;
 851:   }
 852: 
 853:   // --- cells -----------------------------------------------------------------
 854: 
 855:   /** The cells from the built chunks. */
 856:   private indexCells(): void {
 857:     this.cells.clear();
 858:     this.cellsDirty = false;
 859: 
 860:     for (const pt of this.types.values()) {
 861:       if (pt.state !== 'built') continue;
 862: 
 863:       for (const chunk of pt.chunks.values()) {
 864:         let cell = this.cells.get(chunk.key);
 865: 
 866:         if (!cell) {
 867:           cell = {
 868:             meshes: [],
 869:             shadows: [],
 870:             centre: new Vector3(),
 871:             radius: 0,
 872:             minX: 0,
 873:             maxX: 0,
 874:             minZ: 0,
 875:             maxZ: 0,
 876:             enabled: true,
 877:           };
 878:           this.cells.set(chunk.key, cell);
 879:         }
 880: 
 881:         chunk.cell = cell;
 882:         cell.meshes.push(...chunk.meshes);
 883:         cell.shadows.push(...chunk.shadows);
 884:       }
 885:     }
 886: 
 887:     // The sphere of each cell: the box of its meshes' world spheres.
 888:     for (const cell of this.cells.values()) {
 889:       let minX = Infinity;
 890:       let minY = Infinity;
 891:       let minZ = Infinity;
 892:       let maxX = -Infinity;
 893:       let maxY = -Infinity;
 894:       let maxZ = -Infinity;
 895: 
 896:       for (const mesh of cell.meshes) {
 897:         const sphere = mesh.getBoundingInfo().boundingSphere;
 898:         const c = sphere.centerWorld;
 899:         const r = sphere.radiusWorld;
 900:         minX = Math.min(minX, c.x - r);
 901:         minY = Math.min(minY, c.y - r);
 902:         minZ = Math.min(minZ, c.z - r);
 903:         maxX = Math.max(maxX, c.x + r);
 904:         maxY = Math.max(maxY, c.y + r);
 905:         maxZ = Math.max(maxZ, c.z + r);
 906:       }
 907: 
 908:       cell.centre.set((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2);
 909:       cell.radius =
 910:         Math.sqrt((maxX - minX) ** 2 + (maxY - minY) ** 2 + (maxZ - minZ) ** 2) /
 911:         2;
 912:       cell.minX = minX;
 913:       cell.maxX = maxX;
 914:       cell.minZ = minZ;
 915:       cell.maxZ = maxZ;
 916:     }
 917:   }
 918: 
 919:   /**
 920:    * A cell is on while it touches the render-distance ring around the hero
 921:    * - the radius the per-object path loads a map object inside, so the
 922:    * scenery ends where it always did rather than standing past the terrain's
 923:    * haze - and, inside the ring, while its sphere touches the camera frustum
 924:    * or stands within the sun's caster reach, the two reasons a mesh is drawn
 925:    * at all. The clip of a type with no chunk in an on cell is paused with
 926:    * them: nothing draws the skeleton it poses, and the sway resumes where it
 927:    * stopped when a chunk comes back.
 928:    */
 929:   private cullCells(): void {
 930:     const scene = this.world.scene;
 931:     const camera = scene.activeCamera;
 932:     const planes = scene.frustumPlanes;
 933: 
 934:     if (!camera || !planes) return;
 935:     if (this.cellsDirty) this.indexCells();
 936: 
 937:     const eye = camera.globalPosition;
 938:     const hero = this.world.playerEntity?.transform.pos ?? null;
 939:     const ring = renderDistanceRanges(GameOptions.renderDistance).nearby;
 940:     let changed = false;
 941: 
 942:     for (const cell of this.cells.values()) {
 943:       const c = cell.centre;
 944:       const r = cell.radius + CELL_MARGIN;
 945:       let on = true;
 946: 
 947:       if (hero) {
 948:         const gx = Math.max(cell.minX - hero.x, 0, hero.x - cell.maxX);
 949:         const gz = Math.max(cell.minZ - hero.z, 0, hero.z - cell.maxZ);
 950:         on = gx * gx + gz * gz <= ring * ring;
 951:       }
 952: 
 953:       if (on) {
 954:         const dx = c.x - eye.x;
 955:         const dy = c.y - eye.y;
 956:         const dz = c.z - eye.z;
 957:         const reach = CSM_CASTER_REACH + r;
 958: 
 959:         on = dx * dx + dy * dy + dz * dz <= reach * reach;
 960: 
 961:         if (!on) {
 962:           on = true;
 963:           for (let i = 0; i < 6; i++) {
 964:             if (planes[i].dotCoordinate(c) <= -r) {
 965:               on = false;
 966:               break;
 967:             }
 968:           }
 969:         }
 970:       }
 971: 
 972:       if (on === cell.enabled) continue;
 973: 
 974:       cell.enabled = on;
 975:       changed = true;
 976:       for (const mesh of cell.meshes) mesh.setEnabled(on);
 977: 
 978:       const blobs = on && blobShadowsActive();
 979:       for (const shadow of cell.shadows) shadow.setEnabled(blobs);
 980:     }
 981: 
 982:     if (changed) this.syncTypeClips();
 983:   }
 984: 
 985:   private syncTypeClips(): void {
 986:     for (const pt of this.types.values()) {
 987:       if (pt.state !== 'built') continue;
 988: 
 989:       let inReach = false;
 990:       for (const chunk of pt.chunks.values()) {
 991:         if (chunk.cell === null || chunk.cell.enabled) {
 992:           inReach = true;
 993:           break;
 994:         }
 995:       }
 996: 
 997:       if (inReach !== pt.clipPaused) continue;
 998: 
 999:       pt.clipPaused = !inReach;
1000: 
1001:       const groups = pt.prototype?.gltf?.animationGroups;
1002:       if (!groups) continue;
1003: 
1004:       for (const group of groups) {
1005:         if (!group.isStarted) continue;
1006:         if (inReach) group.restart();
1007:         else group.pause();
1008:       }
1009:     }
1010:   }
1011: 
1012:   /**
1013:    * The type goes the way it always went: its records get the model factory
1014:    * and the visibility radius, and `ModelLoaderSystem` takes it from there.
1015:    */
1016:   private fallback(pt: PropType, reason: string): void {
1017:     pt.state = 'fallback';
1018:     this.excluded.set(pt.type, reason);
1019: 
1020:     this.disposeChunks(pt);
1021:     pt.prototype?.dispose();
1022:     pt.prototype = null;
1023: 
1024:     for (const p of pt.placements) {
1025:       const entity = p.entity;
1026:       if (entity.modelId === undefined) continue;
1027: 
1028:       this.world.removeComponent(entity, 'propBatch');
1029:       this.world.addComponent(entity, 'modelFactory', pt.factory);
1030:       this.world.addComponent(entity, 'visibility', {
1031:         state: 'hidden',
1032:         lastChecked: Math.random() * 0.2,
1033:       });
1034:     }
1035: 
1036:     pt.placements.length = 0;
1037:     this.syncHold();
1038:   }
1039: 
1040:   private pendingCount(): number {
1041:     let pending = 0;
1042:     for (const pt of this.types.values()) if (pt.state === 'pending') pending++;
1043:     return pending;
1044:   }
1045: 
1046:   /** The loading screen waits for the batches the way it waits for models. */
1047:   private syncHold(): void {
1048:     const pending = this.pendingCount();
1049: 
1050:     setSceneHold(SCENE_HOLD, pending > 0);
1051: 
1052:     if (pending === 0 && !this.summarised && this.types.size > 0) {
1053:       this.summarised = true;
1054:       if (import.meta.env.DEV) {
1055:         const s = this.stats();
1056:         const excluded = [...this.excluded]
1057:           .map(([type, why]) => `${type}: ${why}`)
1058:           .join(', ');
1059:         console.info(
1060:           `prop batches, map ${this.map}: ${s.instances} placements of ` +
1061:             `${s.types} types in ${s.meshes} meshes (${s.shadowMeshes} shadow); ` +
1062:             `per object: ${excluded || 'none'}`
1063:         );
1064:       }
1065:     }
1066:   }
1067: 
1068:   stats(): PropBatchStats {
1069:     let types = 0;
1070:     let meshes = 0;
1071:     let meshesOn = 0;
1072:     let shadowMeshes = 0;
1073:     let instances = 0;
1074:     let clipsPaused = 0;
1075: 
1076:     for (const pt of this.types.values()) {
1077:       if (pt.state !== 'built') continue;
1078:       types++;
1079:       if (pt.clipPaused) clipsPaused++;
1080:       for (const chunk of pt.chunks.values()) {
1081:         meshes += chunk.meshes.length;
1082:         if (chunk.cell?.enabled ?? true) meshesOn += chunk.meshes.length;
1083:         shadowMeshes += chunk.shadows.length;
1084:         instances += chunk.placements.length;
1085:       }
1086:     }
1087: 
1088:     return {
1089:       types,
1090:       meshes,
1091:       meshesOn,
1092:       shadowMeshes,
1093:       instances,
1094:       clipsPaused,
1095:       pending: this.pendingCount(),
1096:       excluded: this.excluded,
1097:     };
1098:   }
1099: 
1100:   dispose(): void {
1101:     this.disposed = true;
1102: 
1103:     for (const pt of this.types.values()) {
1104:       this.disposeChunks(pt);
1105:       pt.prototype?.dispose();
1106:       pt.prototype = null;
1107:     }
1108: 
1109:     this.types.clear();
1110:     this.root.dispose();
1111:     setSceneHold(SCENE_HOLD, false);
1112:   }
1113: }
1114: 
1115: export type PropBatchStats = {
1116:   types: number;
1117:   meshes: number;
1118:   /** Chunk meshes in a cell that is on this frame (plus the sparse ones). */
1119:   meshesOn: number;
1120:   shadowMeshes: number;
1121:   instances: number;
1122:   /** Types whose clip is paused: no chunk of theirs is in reach. */
1123:   clipsPaused: number;
1124:   pending: number;
1125:   excluded: ReadonlyMap<number, string>;
1126: };
1127: 
1128: let batches: PropBatches | null = null;
1129: 
1130: /**
1131:  * Whether placements of this type need a `LightCarrier` beside their
1132:  * batched body: the type has light emitters in the map's table.
1133:  */
1134: export function propTypeCarriesLight(world: World, type: number): boolean {
1135:   return (lightEmittersFor(world.mapIndex, type)?.length ?? 0) > 0;
1136: }
1137: 
1138: /** The option, with `?batch=0` as the dev A/B. */
1139: export function propBatchingActive(): boolean {
1140:   return GameOptions.propBatching && devQuery('batch') !== '0';
1141: }
1142: 
1143: function batchesFor(world: World): PropBatches {
1144:   if (!batches || batches.world !== world || batches.map !== world.mapIndex) {
1145:     batches?.dispose();
1146:     batches = new PropBatches(world, world.mapIndex);
1147:   }
1148:   return batches;
1149: }
1150: 
1151: /**
1152:  * Why a record of this type would stay on the per-object path on the
1153:  * current map, or null when the batches take it.
1154:  */
1155: export function propBatchExclusion(
1156:   world: World,
1157:   type: number,
1158:   factory: typeof ModelObject
1159: ): string | null {
1160:   return batchesFor(world).exclusion(type, factory);
1161: }
1162: 
1163: /**
1164:  * Files a map record with its type's batch. The entity carries `transform`,
1165:  * `modelId` and `worldIndex` and nothing that would put it on the per-object
1166:  * path (no `modelFactory`, no `visibility`); those are added back only if the
1167:  * type falls back.
1168:  */
1169: export function addPropToBatch(
1170:   world: World,
1171:   entity: Entity,
1172:   factory: typeof ModelObject
1173: ): void {
1174:   batchesFor(world).add(entity, factory);
1175: }
1176: 
1177: /** Once a frame, before the render: build what has arrived. */
1178: export function flushPropBatches(world: World): void {
1179:   if (batches && batches.world === world) batches.flush();
1180: }
1181: 
1182: /** Once a frame: shadow state, torch light, snow. */
1183: export function updatePropBatches(world: World, dt: number): void {
1184:   if (batches && batches.world === world) batches.update(dt);
1185: }
1186: 
1187: /** Drops every batch of the map just left. */
1188: export function disposePropBatches(): void {
1189:   batches?.dispose();
1190:   batches = null;
1191: }
1192: 
1193: export function propBatchStats(): PropBatchStats | null {
1194:   return batches?.stats() ?? null;
1195: }
</file>

