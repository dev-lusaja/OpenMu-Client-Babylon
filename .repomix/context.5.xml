<file path="src/common/pbrMaps.ts">
  1: import {
  2:   Constants,
  3:   RawTexture,
  4:   Texture,
  5:   type BaseTexture,
  6:   type Scene,
  7: } from '../libs/babylon/exports';
  8: import { resolveDataUrl } from '../libs/mu/dataFolder';
  9: import { FILTER_ANISOTROPY } from './materialQuality';
 10: 
 11: /**
 12:  * PBR map sets for the Enhanced material ("authored maps").
 13:  *
 14:  * MU's art is diffuse-only, so the maps are derived from it: height-from-luma
 15:  * normals, metalness from the palette (desaturated mid/high-luma pixels are
 16:  * metal, saturated ones are cloth/leather/skin), roughness from metal +
 17:  * highlight density, and an emissive mask over saturated *bright* pixels -
 18:  * the gems and gold trim that should feed the GlowLayer.
 19:  *
 20:  * Hand-authored maps win over the derivation: `Data/PBR/manifest.json` maps a
 21:  * texture's source name to files under `Data/PBR/`. Missing manifest = all
 22:  * derived; missing entry = derived for that texture.
 23:  */
 24: 
 25: export type PbrMapSet = {
 26:   normal: BaseTexture;
 27:   metallicRoughness: BaseTexture;
 28:   /** Null when the derivation found nothing worth glowing. */
 29:   emissive: BaseTexture | null;
 30: };
 31: 
 32: export type DerivedMaps = {
 33:   normal: Uint8Array;
 34:   metallicRoughness: Uint8Array;
 35:   emissive: Uint8Array | null;
 36: };
 37: 
 38: /**
 39:  * Height scale for the normal derivation (luma 0..1 → texels of relief),
 40:  * applied to the *normalised* Sobel gradient - see `SOBEL_NORM`.
 41:  */
 42: const NORMAL_STRENGTH = 1.4;
 43: 
 44: /**
 45:  * Sobel kernel weight, which the gradient must be divided by to read as a
 46:  * per-texel slope. Without it the raw kernel output spans ±4 for luma in
 47:  * 0..1, so the old `gradient * 2.2` bent the average normal of Lorencia's
 48:  * wood and stone by 30–58° (measured over tile_wood01 / bookshelf / desk_big /
 49:  * c_wall04) and its 95th percentile past 70°. That is not relief - it is a
 50:  * per-texel randomisation of N·L, and it is why Enhanced read as blotchy,
 51:  * smeared and mis-lit next to Classic. MU's art is 128², JPEG-compressed and
 52:  * has its shading painted in, so block ringing and dither become 'geometry'
 53:  * at any real strength. Normalised, the same textures land at 4–10° average
 54:  * and 12–20° at p95 - a surface that catches the torches without fighting the
 55:  * art.
 56:  */
 57: const SOBEL_NORM = 1 / 8;
 58: 
 59: /**
 60:  * Cap on derived metalness. The palette heuristic cannot tell gold from
 61:  * warm-lit oak, and every texel it gets wrong costs diffuse (up to 17 %) and
 62:  * pays it back as a highlight nobody sees without an environment map, so
 63:  * derived metal is 0: metal comes from authored `Data/PBR` maps only
 64:  * (ARCHITECTURE §4.7).
 65:  */
 66: const METAL_MAX = 0;
 67: /** Saturation below which a texel may read as metal (1 / this slope). */
 68: const METAL_SAT_SLOPE = 5;
 69: const ROUGH_MIN = 0.55;
 70: const ROUGH_MAX = 0.95;
 71: /** Share of the texture that must be emissive before a map is worth binding. */
 72: const EMISSIVE_MIN_COVERAGE = 0.002;
 73: 
 74: type Manifest = Record<
 75:   string,
 76:   { normal?: string; metallicRoughness?: string; emissive?: string }
 77: >;
 78: 
 79: function smoothstep(e0: number, e1: number, x: number): number {
 80:   const t = Math.max(0, Math.min(1, (x - e0) / (e1 - e0)));
 81:   return t * t * (3 - 2 * t);
 82: }
 83: 
 84: /** Pure derivation over RGBA8 pixels (row-major, `width` × `height`). */
 85: export function derivePbrMaps(
 86:   rgba: Uint8Array | Uint8ClampedArray,
 87:   width: number,
 88:   height: number
 89: ): DerivedMaps {
 90:   const count = width * height;
 91:   const luma = new Float32Array(count);
 92:   const sat = new Float32Array(count);
 93: 
 94:   for (let i = 0; i < count; i++) {
 95:     const r = rgba[i * 4] / 255;
 96:     const g = rgba[i * 4 + 1] / 255;
 97:     const b = rgba[i * 4 + 2] / 255;
 98:     const max = Math.max(r, g, b);
 99:     const min = Math.min(r, g, b);
100: 
101:     luma[i] = 0.299 * r + 0.587 * g + 0.114 * b;
102:     sat[i] = max > 0 ? (max - min) / max : 0;
103:   }
104: 
105:   const normal = new Uint8Array(count * 4);
106:   const metallicRoughness = new Uint8Array(count * 4);
107:   const emissive = new Uint8Array(count * 4);
108:   let emissiveCoverage = 0;
109: 
110:   const at = (x: number, y: number) =>
111:     luma[((y + height) % height) * width + ((x + width) % width)];
112: 
113:   for (let y = 0; y < height; y++) {
114:     for (let x = 0; x < width; x++) {
115:       const i = y * width + x;
116: 
117:       // Sobel height gradient (wrapping - MU textures tile).
118:       const dx =
119:         at(x + 1, y - 1) +
120:         2 * at(x + 1, y) +
121:         at(x + 1, y + 1) -
122:         (at(x - 1, y - 1) + 2 * at(x - 1, y) + at(x - 1, y + 1));
123:       const dy =
124:         at(x - 1, y + 1) +
125:         2 * at(x, y + 1) +
126:         at(x + 1, y + 1) -
127:         (at(x - 1, y - 1) + 2 * at(x, y - 1) + at(x + 1, y - 1));
128: 
129:       let nx = -dx * SOBEL_NORM * NORMAL_STRENGTH;
130:       let ny = -dy * SOBEL_NORM * NORMAL_STRENGTH;
131:       let nz = 1;
132:       const len = Math.hypot(nx, ny, nz);
133:       nx /= len;
134:       ny /= len;
135:       nz /= len;
136: 
137:       normal[i * 4] = (nx * 0.5 + 0.5) * 255;
138:       normal[i * 4 + 1] = (ny * 0.5 + 0.5) * 255;
139:       normal[i * 4 + 2] = (nz * 0.5 + 0.5) * 255;
140:       normal[i * 4 + 3] = 255;
141: 
142:       const l = luma[i];
143:       const s = sat[i];
144: 
145:       const metal =
146:         Math.max(0, Math.min(1, 1 - s * METAL_SAT_SLOPE)) *
147:         smoothstep(0.2, 0.55, l) *
148:         METAL_MAX;
149:       const rough = Math.max(
150:         ROUGH_MIN,
151:         Math.min(
152:           ROUGH_MAX,
153:           0.9 - 0.45 * metal - 0.3 * smoothstep(0.5, 0.9, l)
154:         )
155:       );
156: 
157:       // glTF layout: G roughness, B metalness (R is free - AO, left white).
158:       metallicRoughness[i * 4] = 255;
159:       metallicRoughness[i * 4 + 1] = rough * 255;
160:       metallicRoughness[i * 4 + 2] = metal * 255;
161:       metallicRoughness[i * 4 + 3] = 255;
162: 
163:       const mask = smoothstep(0.65, 0.95, l) * smoothstep(0.55, 0.85, s);
164:       emissive[i * 4] = rgba[i * 4] * mask;
165:       emissive[i * 4 + 1] = rgba[i * 4 + 1] * mask;
166:       emissive[i * 4 + 2] = rgba[i * 4 + 2] * mask;
167:       emissive[i * 4 + 3] = 255;
168:       if (mask > 0.5) emissiveCoverage++;
169:     }
170:   }
171: 
172:   return {
173:     normal,
174:     metallicRoughness,
175:     emissive:
176:       emissiveCoverage / count >= EMISSIVE_MIN_COVERAGE ? emissive : null,
177:   };
178: }
179: 
180: // --- placeholders ----------------------------------------------------------
181: 
182: type Placeholders = {
183:   normal: RawTexture;
184:   metallicRoughness: RawTexture;
185:   black: RawTexture;
186: };
187: 
188: const placeholders = new WeakMap<Scene, Placeholders>();
189: 
190: /**
191:  * `nearest` marks the 1×1 placeholders, which have nothing to filter. Every
192:  * real derived map gets mipmaps, trilinear filtering and the albedo's
193:  * anisotropy: it is the same size as the albedo, which *is* mipped, so
194:  * leaving these unmipped meant a floor seen at a grazing angle sampled
195:  * full-resolution normal and roughness texels under a minified albedo. That
196:  * aliases into a crawling, smeared sheen. The maps are only ever bound on the
197:  * PBR variant, which is a tier >= 1 material, so they take no Classic mode.
198:  */
199: function raw(
200:   name: string,
201:   data: Uint8Array,
202:   width: number,
203:   height: number,
204:   scene: Scene,
205:   nearest: boolean
206: ): RawTexture {
207:   const texture = new RawTexture(
208:     data,
209:     width,
210:     height,
211:     Constants.TEXTUREFORMAT_RGBA,
212:     scene,
213:     !nearest,
214:     false,
215:     nearest
216:       ? Texture.NEAREST_SAMPLINGMODE
217:       : Texture.TRILINEAR_SAMPLINGMODE
218:   );
219:   texture.name = name;
220:   texture.gammaSpace = false;
221:   texture.anisotropicFilteringLevel = nearest ? 1 : FILTER_ANISOTROPY;
222:   return texture;
223: }
224: 
225: /** Flat normal, "rough dielectric", black - what a mesh gets until its maps exist. */
226: export function pbrPlaceholders(scene: Scene): Placeholders {
227:   let set = placeholders.get(scene);
228:   if (set) return set;
229: 
230:   set = {
231:     normal: raw(
232:       'pbr_flatNormal',
233:       new Uint8Array([128, 128, 255, 255]),
234:       1,
235:       1,
236:       scene,
237:       true
238:     ),
239:     metallicRoughness: raw(
240:       'pbr_flatMR',
241:       new Uint8Array([255, ROUGH_MAX * 255, 0, 255]),
242:       1,
243:       1,
244:       scene,
245:       true
246:     ),
247:     black: raw('pbr_black', new Uint8Array([0, 0, 0, 255]), 1, 1, scene, true),
248:   };
249:   placeholders.set(scene, set);
250:   return set;
251: }
252: 
253: // --- per-texture cache -----------------------------------------------------
254: 
255: const maps = new WeakMap<BaseTexture, PbrMapSet | null>();
256: const pending = new WeakSet<BaseTexture>();
257: 
258: let manifest: Promise<Manifest> | null = null;
259: 
260: function loadManifest(): Promise<Manifest> {
261:   if (manifest) return manifest;
262: 
263:   manifest = fetch(resolveDataUrl('PBR/manifest.json'))
264:     .then(r => (r.ok ? (r.json() as Promise<Manifest>) : {}))
265:     .catch(() => ({}));
266: 
267:   return manifest;
268: }
269: 
270: /** Source file name of a texture - the GLB label when loaded from one. */
271: export function textureSourceName(texture: BaseTexture): string {
272:   const internal = texture.getInternalTexture() as { label?: string } | null;
273: 
274:   return (internal?.label || texture.name).split(/[\\/]/).pop() ?? '';
275: }
276: 
277: function authored(file: string, scene: Scene): Texture {
278:   // glTF textures are stored top-down (invertY false); authored maps are
279:   // painted over the same image, so load them the same way.
280:   const texture = new Texture(
281:     resolveDataUrl(`PBR/${file}`),
282:     scene,
283:     false,
284:     false,
285:     Texture.BILINEAR_SAMPLINGMODE
286:   );
287:   texture.name = `pbr_${file}`;
288:   texture.gammaSpace = false;
289:   texture.anisotropicFilteringLevel = FILTER_ANISOTROPY;
290:   return texture;
291: }
292: 
293: async function build(
294:   texture: BaseTexture,
295:   scene: Scene
296: ): Promise<PbrMapSet | null> {
297:   const { width, height } = texture.getSize();
298:   if (!width || !height) return null;
299: 
300:   const entry = (await loadManifest())[textureSourceName(texture)];
301: 
302:   const needDerived =
303:     !entry?.normal || !entry.metallicRoughness || !entry.emissive;
304: 
305:   let derived: DerivedMaps | null = null;
306: 
307:   if (needDerived) {
308:     const pixels = (await texture.readPixels()) as Uint8Array | null;
309:     if (!pixels) return null;
310:     derived = derivePbrMaps(pixels, width, height);
311:   }
312: 
313:   // readPixels hands back the GPU layout; RawTexture with invertY=false
314:   // uploads it unchanged, so derived maps align with the albedo regardless
315:   // of how the albedo was flipped on upload.
316:   const d = (name: string, data: Uint8Array) =>
317:     raw(
318:       `${name}_${textureSourceName(texture)}`,
319:       data,
320:       width,
321:       height,
322:       scene,
323:       false
324:     );
325: 
326:   const set: PbrMapSet = {
327:     normal: entry?.normal
328:       ? authored(entry.normal, scene)
329:       : d('pbr_n', derived!.normal),
330:     metallicRoughness: entry?.metallicRoughness
331:       ? authored(entry.metallicRoughness, scene)
332:       : d('pbr_mr', derived!.metallicRoughness),
333:     emissive: entry?.emissive
334:       ? authored(entry.emissive, scene)
335:       : derived!.emissive
336:         ? d('pbr_e', derived!.emissive)
337:         : null,
338:   };
339: 
340:   texture.onDisposeObservable.addOnce(() => {
341:     set.normal.dispose();
342:     set.metallicRoughness.dispose();
343:     set.emissive?.dispose();
344:     maps.delete(texture);
345:   });
346: 
347:   return set;
348: }
349: 
350: /**
351:  * The map set for a diffuse texture, or null while it is still being built
352:  * (the build is kicked off on first ask; callers bind the placeholders
353:  * meanwhile and pick the real set up on a later frame).
354:  */
355: export function pbrMapsFor(
356:   texture: BaseTexture,
357:   scene: Scene
358: ): PbrMapSet | null {
359:   const cached = maps.get(texture);
360:   if (cached !== undefined) return cached;
361: 
362:   if (pending.has(texture) || !texture.isReady()) return null;
363: 
364:   pending.add(texture);
365: 
366:   build(texture, scene)
367:     .then(set => maps.set(texture, set))
368:     .catch(error => {
369:       console.warn(
370:         `PBR maps for ${textureSourceName(texture)} failed:`,
371:         error
372:       );
373:       maps.set(texture, null);
374:     })
375:     .finally(() => pending.delete(texture));
376: 
377:   return null;
378: }
379: 
380: /** Already-built maps only (no build kick-off) - for the GlowLayer selector. */
381: export function pbrMapsIfReady(
382:   texture: BaseTexture | undefined
383: ): PbrMapSet | null {
384:   return texture ? (maps.get(texture) ?? null) : null;
385: }
</file>

