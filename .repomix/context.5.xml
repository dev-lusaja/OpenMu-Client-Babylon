 40: export function loadEffectTexture(scene: Scene, file: string): Promise<Texture> {
 41:   const cached = textureCache.get(file);
 42:   if (cached) return cached;
 43: 
 44:   const pending = (async () => {
 45:     // A file this version's tree does not have goes through the sprite
 46:     // loader too: it hands back a 1x1 transparent pixel, so the effect draws
 47:     // nothing instead of retrying a 404 every frame (`hasDataFile`).
 48:     if (/\.ozt$/i.test(file) || !hasDataFile(file)) {
 49:       // OZT (TGA with alpha): decoded through the sprite loader.
 50:       const sprite = await loadMuSprite(file);
 51:       return await new Promise<Texture>((resolve, reject) => {
 52:         const texture = new Texture(
 53:           sprite.url,
 54:           scene,
 55:           undefined,
 56:           undefined,
 57:           undefined,
 58:           () => resolve(texture),
 59:           (message, exception) => reject(exception ?? new Error(message ?? file))
 60:         );
 61:         texture.wrapU = Texture.CLAMP_ADDRESSMODE;
 62:         texture.wrapV = Texture.CLAMP_ADDRESSMODE;
 63:       });
 64:     }
 65: 
 66:     const ozj = await downloadDataFile(file);
 67: 
 68:     const blob = new Blob([ozj.slice(OZJ_HEADER_SIZE)], {
 69:       type: 'image/jpeg',
 70:     });
 71: 
 72:     return await new Promise<Texture>((resolve, reject) => {
 73:       const texture = new Texture(
 74:         URL.createObjectURL(blob),
 75:         scene,
 76:         undefined,
 77:         undefined,
 78:         undefined,
 79:         () => resolve(texture),
 80:         (message, exception) => {
 81:           console.error(`Could not load effect texture ${file}:`, message ?? exception);
 82:           reject(exception ?? new Error(message ?? file));
 83:         }
 84:       );
 85: 
 86:       texture.wrapU = Texture.CLAMP_ADDRESSMODE;
 87:       texture.wrapV = Texture.CLAMP_ADDRESSMODE;
 88:     });
 89:   })();
 90: 
 91:   // Consumers that dispose a shared texture (particle systems do by default)
 92:   // would otherwise leave the cache handing out a dead handle for the rest of
 93:   // the session; evicting on dispose makes the next ask reload instead.
 94:   void pending.then(texture => {
 95:     texture.onDisposeObservable.addOnce(() => {
 96:       if (textureCache.get(file) === pending) textureCache.delete(file);
 97:     });
 98:   });
 99: 
100:   textureCache.set(file, pending);
101: 
102:   return pending;
103: }
