164: export function petSpec(item: Item | null | undefined): PetSpec | null {
165:   if (!item || item.group !== PET_GROUP) return null;
166:   if (item.num === HORN_OF_FENRIR) return FENRIRS[fenrirVariant(item)];
167:   return PETS[item.num] ?? null;
168: }
