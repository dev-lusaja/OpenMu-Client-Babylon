  2: import type { Item } from '../ecs/world';
  3: import { angleLinkMatrix, type BmdLink } from './boneLink';
  4: 
  5: /**
  6:  * The wing part (`c->Wing`) as the original renders it - `RenderCharacterBackItem`
  7:  * ZzzCharacter.cpp:15100-15142, the per-type passes in `ItemObjectAttribute`
  8:  * (ZzzObject.cpp:5151-5299) and `RenderPartObjectBody` (:6851-6890), and the
  9:  * bone auras in `RenderPartObjectEffect` (:9860-9925).
 10:  *
 11:  * Item groups: wings are group 12 (`ITEM_WING`), the Dark Lord capes group 13.
 12:  * `MODEL_WING + n` in the C++ is exactly `{ group: 12, num: n }` here, so the
 13:  * indices below are the C++ enum offsets (_enum.h:1918-1956).
 14:  *
 15:  * **Not ported, because the original assigns them and then never reads them:**
 16:  * the Wings of Soul / Wings of Dragon `BlendMeshLight` sines (:9816-9822) and
 17:  * the Wings of Spirits `o->Scale = 0.5` (:5277). Both land on the shared
 18:  * `g_ItemObject[Type]` whose `BlendMesh` is -1 and whose `Scale` is overwritten
 19:  * by `b->BodyScale = o->Scale` from the wearer, so neither reaches the screen.
 20:  */
 21: 
 22: export const WING_GROUP = 12;
 23: export const HELPER_GROUP = 13;
 24: 
 25: /** `w->LinkBone = 47` - the default back bone every wing hangs from. */
 26: export const WING_BONE = 47;
 27: /** Capes link to bone 19 instead (`RenderCharacterBackItem`:15132). */
 28: export const CAPE_BONE = 19;
 29: 
 30: /** Wing indices in group 12 the code below refers to by name. */
 31: export const WING_OF_ELF = 0;
 32: export const WINGS_OF_HEAVEN = 1;
 33: export const WINGS_OF_SATAN = 2;
 34: export const WINGS_OF_SPIRITS = 3;
 35: export const WINGS_OF_SOUL = 4;
 36: export const WINGS_OF_DRAGON = 5;
 37: export const WINGS_OF_DARKNESS = 6;
 38: export const WING_OF_STORM = 36;
 39: export const WING_OF_ETERNAL = 37;
 40: export const WING_OF_ILLUSION = 38;
 41: export const WING_OF_RUIN = 39;
 42: export const CAPE_OF_EMPEROR = 40;
 43: export const WING_OF_CURSE = 41;
 44: export const WINGS_OF_DESPAIR = 42;
 45: export const WING_OF_DIMENSION = 43;
 46: 
 47: /** Cape of Lord lives in the helper group (13). */
 48: export const CAPE_OF_LORD = 30;
 49: 
 50: /** A bone-anchored particle aura the wing emits (`RenderPartObjectEffect`). */
 51: export type WingWake = {
 52:   readonly kind: 'wingFlareBlue' | 'wingCloud';
 53:   /** Bone indices the sprites are placed on. */
 54:   readonly bones: readonly number[];
 55:   /** Sprite scale at `timeMs`. */
 56:   readonly scale: (timeMs: number) => number;
 57:   /** Sprite colour at `timeMs`. */
 58:   readonly light: (timeMs: number) => readonly [number, number, number];
 59:   /** Emit every n-th 25 Hz tick (the original re-creates them every frame). */
 60:   readonly every: number;
 61: };
 62: 
 63: export type WingSpec = {
 64:   /** `o->BlendMesh`: the mesh drawn as an additive glow card. -1 = none. */
 65:   readonly blendMesh: number;
 66:   /** `f->PlaySpeed` override that wins over the fly/idle rule. */
 67:   readonly playSpeed?: number;
 68:   /** `f->PlaySpeed` while a FLY clip is running (Wing of Storm halves it). */
 69:   readonly flyPlaySpeed?: number;
 70:   /** Capes are link-bound to bone 19 with an explicit matrix. */
 71:   readonly cape?: 'emperor' | 'overrule';
 72:   /**
 73:    * Clip to play inside a safe zone instead of clip 0 - the Wings of Darkness
 74:    * fold shut in town (`RenderLinkObject`, ZzzCharacter.cpp:6785).
 75:    */
 76:   readonly safeZoneAction?: number;
 77:   readonly wake?: WingWake;
 78: };
 79: 
 80: const PLAIN: WingSpec = { blendMesh: -1 };
 81: 
 82: /**
 83:  * `RenderLinkObject`'s cape matrices (ZzzCharacter.cpp:6524-6538), in BMD
 84:  * bone space: Cape of Overrule `AngleMatrix(0,90,0) + (10,-15,0)`, every
 85:  * cape at or above Cape of Emperor `AngleMatrix(0,90,0) + (-47,-7,0)`.
 86:  */
 87: const CAPE_LINKS: Record<'emperor' | 'overrule', BmdLink> = {
 88:   emperor: { angle: [0, 90, 0], offset: [-47, -7, 0] },
 89:   overrule: { angle: [0, 90, 0], offset: [10, -15, 0] },
 90: };
 91: 
 92: const WINGS: Readonly<Record<number, WingSpec>> = {
 93:   // --- 1st level. `case MODEL_WING: o->BlendMesh = 0` (ZzzObject.cpp:5284).
 94:   [WING_OF_ELF]: { blendMesh: 0 },
 95:   [WINGS_OF_HEAVEN]: PLAIN,
 96:   [WINGS_OF_SATAN]: PLAIN,
 97: 
 98:   // --- 2nd level.
 99:   [WINGS_OF_SPIRITS]: { blendMesh: 0 }, // ZzzObject.cpp:5276
100:   [WINGS_OF_SOUL]: PLAIN,
101:   [WINGS_OF_DRAGON]: PLAIN,
102:   [WINGS_OF_DARKNESS]: {
103:     blendMesh: -1,
104:     safeZoneAction: 1,
105:     wake: {
106:       kind: 'wingFlareBlue',
107:       // The two five-bone runs of ZzzObject.cpp:9868-9890 (`22 - i`, `7 - i`).
108:       bones: [22, 21, 20, 19, 18, 7, 6, 5, 4, 3],
109:       // Scale = (sinf(WorldTime*0.004)*0.3 + 0.3) * 10 + 20, drawn at /28.
110:       scale: t => ((Math.sin(t * 0.004) * 0.3 + 0.3) * 10 + 20) / 28,
111:       light: () => [0.6, 0.3, 0.8],
112:       every: 2,
113:     },
114:   },
115: 
116:   // --- 3rd level.
117:   [WING_OF_STORM]: {
118:     blendMesh: -1,
119:     flyPlaySpeed: 0.5, // ZzzCharacter.cpp:15115
120:     wake: {
121:       kind: 'wingCloud',
122:       // The 25-bone table of ZzzObject.cpp:9903-9906.
123:       bones: [
124:         9, 20, 19, 10, 18, 28, 27, 36, 35, 38, 37, 53, 48, 62, 70, 72, 71, 78,
125:         79, 80, 87, 90, 91, 106, 102,
126:       ],
127:       scale: () => 0.5,
128:       light: t => {
129:         const l = 0.5 + Math.abs(Math.sin(t * 0.0004)) * 0.4;
130:         return [l, l, l];
131:       },
132:       every: 3,
133:     },
134:   },
135:   [WING_OF_ETERNAL]: PLAIN,
136:   [WING_OF_ILLUSION]: PLAIN,
137:   [WING_OF_RUIN]: {
138:     blendMesh: -1,
139:     playSpeed: 0.15, // RenderLinkObject, ZzzCharacter.cpp:6477-6481
140:   },
141:   [CAPE_OF_EMPEROR]: { blendMesh: -1, cape: 'emperor' },
142:   [WING_OF_CURSE]: PLAIN,
143:   [WINGS_OF_DESPAIR]: PLAIN,
144:   [WING_OF_DIMENSION]: PLAIN,
145: };
146: 
147: const CAPES: Readonly<Record<number, WingSpec>> = {
148:   [CAPE_OF_LORD]: { blendMesh: -1, cape: 'emperor' },
149: };
150: 
151: /** True for the items the appearance's wing slot can legitimately hold. */
152: export function isWingItem(item: Item | null | undefined): item is Item {
153:   return wingSpec(item) !== null;
154: }
155: 
156: export function wingSpec(item: Item | null | undefined): WingSpec | null {
157:   if (!item) return null;
158:   if (item.group === WING_GROUP) return WINGS[item.num] ?? null;
159:   if (item.group === HELPER_GROUP) return CAPES[item.num] ?? null;
160:   return null;
161: }
162: 
163: /** The link matrix a cape needs, or null for a plain bone-47 wing. */
164: export function wingLinkMatrix(spec: WingSpec | null): Matrix | null {
165:   if (!spec?.cape) return null;
166:   return angleLinkMatrix(CAPE_LINKS[spec.cape]);
167: }
168: 
169: export function wingBone(spec: WingSpec | null): number {
170:   return spec?.cape ? CAPE_BONE : WING_BONE;
171: }
172: 
173: /**
174:  * Wings that move a character at 16 rather than 15 units
175:  * (`CharacterMoveSpeed`, ZzzCharacter.cpp:6205).
176:  */
177: export function isFastWing(item: Item | null | undefined): boolean {
178:   return (
179:     !!item &&
180:     item.group === WING_GROUP &&
181:     (item.num === WINGS_OF_DRAGON || item.num === WING_OF_STORM)
182:   );
183: }
</file>

