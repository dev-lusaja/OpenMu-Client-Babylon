  6: 
  7: /**
  8:  * Weapon-class rules transcribed from the original client
  9:  * (`SetPlayerStop` ZzzCharacter.cpp:255-335, `SetPlayerWalk` :549-620,
 10:  * `IsBackItem` :14937-14951). Item groups: 0 sword, 1 axe, 2 mace, 3 spear,
 11:  * 4 bow/crossbow, 5 staff (+ summoner sticks 14-20, books 21+), 6 shield.
 12:  */
 13: 
 14: export const GROUP_SWORD = 0;
 15: export const GROUP_AXE = 1;
 16: export const GROUP_MACE = 2;
 17: export const GROUP_SPEAR = 3;
 18: export const GROUP_BOW = 4;
 19: export const GROUP_STAFF = 5;
 20: export const GROUP_SHIELD = 6;
 21: 
 22: const BOLT_INDEX = 7;
 23: const ARROWS_INDEX = 15;
 24: 
 25: // MODEL__SPEAR = MODEL_SPEAR + 1, MODEL_DRAGON_LANCE = MODEL_SPEAR + 2 (_enum.h:1557)
 26: const SPEAR_POSE_INDICES = new Set([1, 2]);
 27: // Dark Reign Blade 21, Explosion Blade 23, Sword Dancer 25, Rune Blade 31 (_enum.h:1515-1523)
 28: const TWO_HAND_SWORD_TWO_INDICES = new Set([21, 23, 25, 31]);
 29: const MISTERY_STICK = 14;
 30: const ETERNAL_WING_STICK = 20;
 31: const BOOK_OF_SAHAMUTT = 21;
 32: 
 33: export type Hands = { leftHand: Item | null; rightHand: Item | null };
 34: 
 35: export function isWeaponItem(item: Item | null): item is Item {
 36:   return !!item && item.group <= GROUP_SHIELD;
 37: }
 38: 
 39: export function isAmmo(item: Item | null): boolean {
 40:   return (
 41:     !!item &&
 42:     item.group === GROUP_BOW &&
 43:     (item.num === BOLT_INDEX || item.num === ARROWS_INDEX)
 44:   );
 45: }
 46: 
 47: export function isShield(item: Item | null): boolean {
 48:   return !!item && item.group === GROUP_SHIELD;
 49: }
 50: 
 51: /**
 52:  * Summoner books (staff 21-29). `RenderLinkObject` returns before drawing
 53:  * them (ZzzCharacter.cpp:6453-6456): a book is never rendered on the
 54:  * character at all, in hand or on the back.
 55:  */
 56: export function isBook(item: Item | null): boolean {
 57:   return (
 58:     !!item &&
 59:     item.group === GROUP_STAFF &&
 60:     item.num >= BOOK_OF_SAHAMUTT &&
 61:     item.num <= 29
 62:   );
 63: }
 64: 
 65: // The Rage Fighter's glove weapons (`CMonkSystem::RegistItem`,
 66: // MonkSystem.cpp:76-89). Each is a sword-group item worn one per hand, and
 67: // each carries three models: the inventory one items.json names, and a left /
 68: // right pair worn on the character. The Phoenix Soul Star additionally trails
 69: // a pair of phoenix wings (`RenderPhoenixGloves`, :241).
 70: const SACRED_GLOVE = 32;
 71: export const PHOENIX_SOUL_STAR = 35;
 72: 
 73: /** `Item/` model stems, indexed from `SACRED_GLOVE`: [worn right, worn left]. */
 74: const SWORDFORM_GLOVE_MODELS: readonly (readonly [string, string])[] = [
 75:   ['SwordR33', 'SwordL33'], // Sacred Glove
 76:   ['SwordR34', 'SwordL34'], // Storm Hard Glove
 77:   ['SwordR35', 'SwordL35'], // Piercing Blade Glove
 78:   ['Sword36R', 'Sword36L'], // Phoenix Soul Star
 79: ];
 80: 
 81: export function isPhoenixSoulStar(item: Item | null | undefined): boolean {
 82:   return !!item && item.group === GROUP_SWORD && item.num === PHOENIX_SOUL_STAR;
 83: }
 84: 
 85: /** `IsSwordformGloves` (MonkSystem.cpp:223). */
 86: export function isSwordformGloves(item: Item | null): boolean {
 87:   return (
 88:     !!item &&
 89:     item.group === GROUP_SWORD &&
 90:     item.num >= SACRED_GLOVE &&
 91:     item.num < SACRED_GLOVE + SWORDFORM_GLOVE_MODELS.length
 92:   );
 93: }
 94: 
 95: /**
 96:  * `ModifyTypeSwordformGloves` (MonkSystem.cpp:254): the model actually worn,
 97:  * which is never the one items.json names. Slot 0 takes the right-hand model,
 98:  * slot 1 the left. `null` for anything that is not a glove weapon.
 99:  */
100: export function swordformGlovesModel(
101:   item: Item | null,
102:   slot: 0 | 1
103: ): string | null {
104:   if (!item || !isSwordformGloves(item)) return null;
105:   return `${SWORDFORM_GLOVE_MODELS[item.num - SACRED_GLOVE][slot]}.glb`;
106: }
107: 
108: /** `IsBowModel` (CharacterManager.cpp:68): 0-6, Celestial 17, Viper…Stinger 20-23, Air Lyn 24. */
109: export function isBow(item: Item | null): boolean {
110:   if (!item || item.group !== GROUP_BOW) return false;
111:   const n = item.num;
112:   return n <= 6 || n === 17 || (n >= 20 && n <= 24);
113: }
114: 
115: /** `IsCrossbowModel` (CharacterManager.cpp:76): 8-14, Saint 16, Divine CB…Great Reign 18-19. */
116: export function isCrossbow(item: Item | null): boolean {
117:   if (!item || item.group !== GROUP_BOW) return false;
118:   const n = item.num;
119:   return (n >= 8 && n <= 14) || n === 16 || n === 18 || n === 19;
120: }
121: 
122: /**
123:  * `GetEquipedBowType` (CharacterManager.cpp:267): a bow only counts from
124:  * weapon slot 1 (appearance "rightHand"), a crossbow only from slot 0.
125:  */
126: export function equippedBowType(
127:   hands: Hands | undefined
128: ): 'bow' | 'crossbow' | null {
129:   if (!hands) return null;
130:   if (isBow(hands.rightHand)) return 'bow';
131:   if (isCrossbow(hands.leftHand)) return 'crossbow';
132:   return null;
133: }
134: 
135: /**
136:  * `ItemAttribute[].TwoHand` is not in items.json; the inventory width is the
137:  * reliable proxy for swords/axes/maces (two-handers are 2 wide), spears are
138:  * always two-handed, and staffs switch at Legendary Staff (index 5) - the
139:  * summoner sticks/books are one-handed.
140:  */
141: export function isTwoHanded(item: Item): boolean {
142:   switch (item.group) {
143:     case GROUP_SWORD:
144:     case GROUP_AXE:
145:     case GROUP_MACE: {
146:       const def = ItemsDatabase.getItem(item.group, item.num);
147:       return (def?.X ?? 1) >= 2;
148:     }
149:     case GROUP_SPEAR:
150:       return true;
151:     case GROUP_STAFF:
152:       return item.num >= 5 && item.num < MISTERY_STICK;
153:     case GROUP_BOW:
154:       return !isAmmo(item);
155:     default:
156:       return false;
157:   }
158: }
159: 
160: /**
161:  * `IsBackItem` (ZzzCharacter.cpp:14937): with a bow or crossbow equipped
162:  * everything rides the back; otherwise anything sword…shield except the
163:  * summoner books - the sticks (staff 14-20) do go to the back.
164:  */
165: export function isBackItem(item: Item, hands?: Hands): boolean {
166:   if (equippedBowType(hands) !== null) return true;
167:   return item.group <= GROUP_SHIELD && !isBook(item);
168: }
169: 
170: function equippedBow(hands: Hands): Item | null {
171:   for (const h of [hands.leftHand, hands.rightHand]) {
172:     if (isBow(h) || isCrossbow(h)) return h;
173:   }
174:   return null;
175: }
