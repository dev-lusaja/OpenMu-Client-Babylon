131: function readQuery(name: string): string | null {
132:   try {
133:     return new URLSearchParams(location.search).get(name);
134:   } catch {
135:     return null;
136:   }
137: }
138: 
139: function queryTriple(name: string): [number, number, number] | null {
140:   const v = readQuery(name);
141:   if (!v) return null;
142:   const parts = v.split(',').map(Number);
143:   return parts.length === 3 && parts.every(n => !isNaN(n))
144:     ? (parts as [number, number, number])
145:     : null;
146: }
147: 
148: function withOverrides(link: BmdLink): BmdLink {
149:   return {
150:     angle: queryTriple('backRot') ?? link.angle,
151:     offset: queryTriple('backOff') ?? link.offset,
152:   };
153: }
