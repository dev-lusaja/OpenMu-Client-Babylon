 626:     const to = followEntity(c.caster, 0.9);
 627:     const centre = entityPos(c.caster, 0.9, new Vector3());
 628:     for (let i = 0; i < 3; i++) {
 629:       const a = Math.random() * Math.PI * 2;
 630:       const e = Math.random() * 0.8;
 631:       const from = new Vector3(centre.x + Math.cos(a) * 5, centre.y + e * 3, centre.z + Math.sin(a) * 5);
