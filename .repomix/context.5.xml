537: type Pin1 = {
538:   live: boolean;
539:   lifeTime: number;
540:   scale: number;
541:   alpha: number;
542:   light: [number, number, number];
543:   decal: TerrainDecal;
544: };
545: 
546: export class MoveTargetEffect {
547:   readonly #world: World;
548: 
549:   #worldTimeMs = 0;
550: 
551:   #live = false;
552:   readonly #position = new Vector3();
553:   #yaw = 0;
554:   #lifeTime = 0;
555:   #blendMeshLight = 1;
556:   #sparkDue = 0;
557:   #lastBurst = -1;
558: 
559:   #modelNode: TransformNode | null = null;
560:   #modelAnimation: AnimationGroup | null = null;
561:   #modelLight: Vector3 | null = null;
562:   #modelLoading = false;
563: 
564:   #pin2Live = false;
565:   #pin2LifeTime = 0;
566:   #pin2Scale = 0;
567:   #pin2Alpha = 1;
568:   #pin2Growing = false;
569:   readonly #pin2Light: [number, number, number] = [...ORANGE];
570:   readonly #pin2Decal: TerrainDecal;
571: 
572:   #ringLive = false;
573:   #ringLifeTime = 0;
574:   #ringScale = 0;
575:   #ringAlpha = 1;
576:   readonly #ringHeadAngle: [number, number, number] = [0, 0, 0];
577:   readonly #ringLight: [number, number, number] = [...ORANGE];
578:   readonly #ringDecals: readonly [TerrainDecal, TerrainDecal];
579: 
580:   readonly #pin1: readonly Pin1[];
581: 
582:   readonly #ribbons: readonly Ribbon[];
583: 
584:   constructor(world: World) {
585:     this.#world = world;
586: 
587:     this.#pin2Decal = new TerrainDecal(world, 'moveTargetPin2', CURSORPIN2, 1.8);
588: 
589:     this.#ringDecals = [
590:       new TerrainDecal(world, 'moveTargetRing0', EMPACT01, 0.8),
591:       new TerrainDecal(world, 'moveTargetRing1', EMPACT01, 0.96),
592:     ];
593: 
594:     this.#pin1 = [0, 1, 2].map(i => ({
595:       live: false,
596:       lifeTime: 0,
597:       scale: 0,
598:       alpha: 1,
599:       light: [...ORANGE] as [number, number, number],
600:       decal: new TerrainDecal(world, `moveTargetPin1_${i}`, CURSORPIN1, 1.2),
601:     }));
602: 
603:     this.#ribbons = [0, 1, 2, 3].map(i => new Ribbon(world, i));
604:   }
605: 
606:   spawn(x: number, y: number, z: number, yaw: number): void {
607:     this.#position.set(x, y, z);
608:     this.#yaw = yaw;
609: 
610:     this.#live = true;
611:     this.#lifeTime = 30;
612:     this.#blendMeshLight = 1;
613:     this.#sparkDue = 0;
614:     this.#lastBurst = -1;
615: 
616:     if (this.#modelAnimation) {
617:       this.#modelAnimation.stop();
618:       this.#modelAnimation.play(true);
619:     }
620: 
621:     this.#loadModel();
622: 
623:     this.#pin2Live = true;
624:     this.#pin2LifeTime = 30;
625:     this.#pin2Scale = 1.8;
626:     this.#pin2Alpha = 1;
627:     this.#pin2Growing = false;
628:     this.#pin2Light[0] = ORANGE[0];
629:     this.#pin2Light[1] = ORANGE[1];
630:     this.#pin2Light[2] = ORANGE[2];
631: 
632:     this.#ringLive = true;
633:     this.#ringLifeTime = 24;
634:     this.#ringScale = 0.8;
635:     this.#ringAlpha = 1;
636:     this.#ringHeadAngle[0] = 0;
637:     this.#ringHeadAngle[1] = 0;
638:     this.#ringHeadAngle[2] = 0;
639:     this.#ringLight[0] = ORANGE[0];
640:     this.#ringLight[1] = ORANGE[1];
641:     this.#ringLight[2] = ORANGE[2];
642: 
643:     for (const pin of this.#pin1) {
644:       pin.live = false;
645:       pin.decal.hide();
646:     }
647: 
648:     for (const ribbon of this.#ribbons) ribbon.reset();
649:   }
650: 
651:   update(deltaSeconds: number): void {
652:     this.#worldTimeMs += deltaSeconds * 1000;
653: 
654:     const f = Math.min(1, deltaSeconds * TICKS_PER_SECOND);
655: 
656:     this.#updateModel(f);
657:     this.#updatePin2(f);
658:     this.#updateRing(f);
659:     this.#updatePin1(f);
660:     this.#updateRibbons(f);
661:   }
662: 
663:   #updateModel(f: number): void {
664:     if (!this.#live) return;
665: 
666:     this.#sparkDue += f;
667:     if (this.#sparkDue > 4) this.#sparkDue = 4;
668: 
669:     while (this.#sparkDue >= 1) {
670:       this.#sparkDue -= 1;
671: 
672:       void spawnParticle(
673:         this.#world.scene,
674:         'spark03_24',
675:         {
676:           x: this.#position.x,
677:           y: this.#position.y + 110 / TILE_CM,
678:           z: this.#position.z,
679:         },
680:         this.#yaw,
681:         1,
682:         ORANGE
683:       );
684:     }
685: 
686:     const marker = Math.trunc(this.#lifeTime);
687: 
688:     if (marker % 15 === 0 && marker !== this.#lastBurst) {
689:       this.#lastBurst = marker;
690:       this.#spawnPin1();
691:     }
692: 
693:     if (this.#lifeTime <= 10) {
694:       this.#blendMeshLight -= 0.05 * f;
695:       if (this.#blendMeshLight < 0) this.#blendMeshLight = 0;
696:     }
697: 
698:     this.#lifeTime -= f;
699: 
700:     if (this.#lifeTime <= 0) {
701:       this.#live = false;
702:       this.#modelNode?.setEnabled(false);
703:       return;
704:     }
705: 
706:     const node = this.#modelNode;
707:     if (!node) return;
708: 
709:     node.position.copyFrom(this.#position);
710:     node.rotation.y = this.#yaw;
711:     node.setEnabled(true);
712: 
713:     this.#modelLight?.set(
714:       ORANGE[0] * this.#blendMeshLight,
715:       ORANGE[1] * this.#blendMeshLight,
716:       ORANGE[2] * this.#blendMeshLight
717:     );
718:   }
719: 
720:   #updatePin2(f: number): void {
721:     if (!this.#pin2Live) return;
722: 
723:     if (this.#pin2Scale >= 1.8) this.#pin2Growing = false;
724:     else if (this.#pin2Scale <= 0.8) this.#pin2Growing = true;
725: 
726:     this.#pin2Scale += (this.#pin2Growing ? 0.15 : -0.15) * f;
727: 
728:     if (this.#pin2LifeTime <= 10) {
729:       this.#pin2Alpha -= 0.05 * f;
730:       if (this.#pin2Alpha < 0) this.#pin2Alpha = 0;
731: 
732:       const gain = Math.pow(this.#pin2Alpha, f);
733:       this.#pin2Light[0] *= gain;
734:       this.#pin2Light[1] *= gain;
735:       this.#pin2Light[2] *= gain;
736:     }
737: 
738:     this.#pin2LifeTime -= f;
739: 
740:     if (this.#pin2LifeTime <= 0) {
741:       this.#pin2Live = false;
742:       this.#pin2Decal.hide();
743:       return;
744:     }
745: 
746:     this.#pin2Decal.draw(
747:       this.#world,
748:       this.#position.x,
749:       this.#position.z,
750:       this.#pin2Scale,
751:       0,
752:       this.#pin2Light
753:     );
754:   }
755: 
756:   #updateRing(f: number): void {
757:     if (!this.#ringLive) return;
758: 
759:     this.#ringHeadAngle[0] += 2 * f;
760:     this.#ringHeadAngle[1] -= 2 * f;
761:     this.#ringHeadAngle[2] += 2 * f;
762: 
763:     if (this.#ringLifeTime <= 10) {
764:       this.#ringAlpha -= 0.05 * f;
765:       if (this.#ringAlpha < 0) this.#ringAlpha = 0;
766: 
767:       const gain = Math.pow(this.#ringAlpha, f);
768:       this.#ringLight[0] *= gain;
769:       this.#ringLight[1] *= gain;
770:       this.#ringLight[2] *= gain;
771:     }
772: 
773:     this.#ringLifeTime -= f;
774: 
775:     if (this.#ringLifeTime <= 0) {
776:       this.#ringLive = false;
777:       this.#ringDecals[0].hide();
778:       this.#ringDecals[1].hide();
779:       return;
780:     }
781: 
782:     const light: [number, number, number] = [
783:       this.#ringLight[0] * this.#ringAlpha,
784:       this.#ringLight[1] * this.#ringAlpha,
785:       this.#ringLight[2] * this.#ringAlpha,
786:     ];
787: 
788:     this.#ringDecals[0].draw(
789:       this.#world,
790:       this.#position.x,
791:       this.#position.z,
792:       this.#ringScale,
793:       this.#ringHeadAngle[1],
794:       light
795:     );
796: 
797:     this.#ringDecals[1].draw(
798:       this.#world,
799:       this.#position.x,
800:       this.#position.z,
801:       this.#ringScale * 1.2,
802:       this.#ringHeadAngle[2],
803:       light
804:     );
805:   }
806: 
807:   #spawnPin1(): void {
808:     const pin = this.#pin1.find(p => !p.live);
809:     if (!pin) return;
810: 
811:     pin.live = true;
812:     pin.lifeTime = 20;
813:     pin.scale = 1.2;
814:     pin.alpha = 1;
815:     pin.light[0] = ORANGE[0];
816:     pin.light[1] = ORANGE[1];
817:     pin.light[2] = ORANGE[2];
818:   }
819: 
820:   #updatePin1(f: number): void {
821:     for (const pin of this.#pin1) {
822:       if (!pin.live) continue;
823: 
824:       pin.scale -= 0.04 * f;
825: 
826:       if (pin.lifeTime <= 10) {
827:         pin.alpha -= 0.05 * f;
828:         if (pin.alpha < 0) pin.alpha = 0;
829: 
830:         const gain = Math.pow(pin.alpha, f);
831:         pin.light[0] *= gain;
832:         pin.light[1] *= gain;
833:         pin.light[2] *= gain;
834:       }
835: 
836:       pin.lifeTime -= f;
837: 
838:       if (pin.scale <= 0.2 || pin.lifeTime <= 0) {
839:         pin.live = false;
840:         pin.decal.hide();
841:         continue;
842:       }
843: 
844:       pin.decal.draw(
845:         this.#world,
846:         this.#position.x,
847:         this.#position.z,
848:         pin.scale,
849:         0,
850:         pin.light
851:       );
852:     }
853:   }
854: 
855:   #updateRibbons(f: number): void {
856:     for (let i = 0; i < this.#ribbons.length; i++) {
857:       this.#ribbons[i].update(
858:         f,
859:         this.#worldTimeMs,
860:         i,
861:         this.#position,
862:         this.#yaw
863:       );
864:     }
865:   }
866: 
867:   #loadModel(): void {
868:     if (this.#modelNode || this.#modelLoading) return;
869: 
870:     this.#modelLoading = true;
871: 
872:     void loadGLTF('Effect/MoveTargetPosEffect.glb', this.#world).then(gltf => {
873:       const node = new TransformNode('moveTargetPin', this.#world.scene);
874:       node.setParent(this.#world.mapParent);
875:       node.rotationQuaternion = null;
876:       node.scaling.setAll(MODEL_SCALE);
877: 
878:       gltf.mesh.setParent(node);
879:       gltf.mesh.position.setAll(0);
880:       gltf.mesh.scaling.set(1, -1, 1);
881:       gltf.mesh.rotationQuaternion = Quaternion.FromEulerAngles(
882:         -Math.PI / 2,
883:         0,
884:         0
885:       );
886: 
887:       const bodyLight = new Vector3(ORANGE[0], ORANGE[1], ORANGE[2]);
888: 
889:       const bright = getMaterial(
890:         this.#world.scene,
891:         false,
892:         Material.MATERIAL_ALPHABLEND,
893:         BlendState.ALPHA_ONEOE,
894:         true
895:       );
896: 
897:       gltf.mesh.getChildMeshes(false).forEach((mesh: AbstractMesh) => {
898:         mesh.metadata ??= {};
899:         mesh.metadata.bodyLight = bodyLight;
900:         mesh.metadata.brightMesh = true;
901:         mesh.isPickable = false;
902:         mesh.alwaysSelectAsActiveMesh = true;
903:         mesh.material = bright;
904: 
905:         excludeFromGlow(this.#world, mesh);
906:       });
907: 
908:       this.#modelLight = bodyLight;
909:       this.#modelNode = node;
910:       this.#modelAnimation = gltf.animationGroups[0] ?? null;
911: 
912:       if (this.#modelAnimation) {
913:         this.#modelAnimation.speedRatio = MODEL_ANIMATION_SPEED;
914:         this.#modelAnimation.play(true);
915:       }
916: 
917:       node.setEnabled(this.#live);
918:     });
919:   }
920: }
</file>

