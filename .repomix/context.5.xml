456: 
457:     tails[0] = px - ax;
458:     tails[1] = py;
459:     tails[2] = pz - az;
460: 
461:     tails[3] = px + ax;
462:     tails[4] = py;
463:     tails[5] = pz + az;
464: 
465:     tails[6] = px;
466:     tails[7] = py - ay;
467:     tails[8] = pz;
468: 
469:     tails[9] = px;
470:     tails[10] = py + ay;
471:     tails[11] = pz;
472: 
473:     if (this.#seed) {
474:       for (let j = 1; j < RIBBON_TAILS; j++) {
475:         tails.copyWithin(j * 12, 0, 12);
476:       }
477: 
478:       this.#numTails = 1;
479:       this.#seed = false;
480:     }
481:   }
482: 
483:   #rebuild(): void {
484:     const segments = this.#textured ? this.#numTails : 0;
485: 
486:     if (segments <= 0) {
487:       this.#mesh.setEnabled(false);
488:       return;
489:     }
490: 
491:     const tails = this.#tails;
492:     const positions = this.#positions;
493:     const uvs = this.#uvs;
494: 
495:     let v = 0;
496: 
497:     const emit = (tail: number, corner: number, u: number, vCoord: number) => {
498:       const t = (tail * 4 + corner) * 3;
499: 
500:       positions[v * 3 + 0] = tails[t + 0];
501:       positions[v * 3 + 1] = tails[t + 1];
502:       positions[v * 3 + 2] = tails[t + 2];
503: 
504:       uvs[v * 2 + 0] = u;
505:       uvs[v * 2 + 1] = vCoord;
506: 
507:       v++;
508:     };
509: 
510:     for (let j = 0; j < segments; j++) {
511:       const u1 = (segments - j) / (RIBBON_TAILS - 1);
512:       const u2 = (segments - (j + 1)) / (RIBBON_TAILS - 1);
513: 
514:       emit(j, 2, u1, 1);
515:       emit(j, 3, u1, 0);
516:       emit(j + 1, 3, u2, 0);
517:       emit(j + 1, 2, u2, 1);
518: 
519:       emit(j, 0, u1, 0);
520:       emit(j, 1, u1, 1);
521:       emit(j + 1, 1, u2, 1);
522:       emit(j + 1, 0, u2, 0);
523:     }
524: 
525:     for (; v < positions.length / 3; v++) {
526:       positions[v * 3 + 0] = positions[(v - 1) * 3 + 0];
527:       positions[v * 3 + 1] = positions[(v - 1) * 3 + 1];
528:       positions[v * 3 + 2] = positions[(v - 1) * 3 + 2];
529:     }
530: 
531:     this.#mesh.updateVerticesData('position', positions);
532:     this.#mesh.updateVerticesData('uv', uvs);
533:     this.#mesh.setEnabled(true);
534:   }
535: }
