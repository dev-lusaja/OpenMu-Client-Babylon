<file path="src/common/sceneGate.ts">
 1: import type { Entity } from '../ecs/world';
 2: 
 3: /**
 4:  * Work the loading screen has to wait for besides the map itself.
 5:  *
 6:  * `sceneReadySystem` gates the screen on the map: terrain in, every visible
 7:  * object's model in. What that misses is content a system stages *after* the
 8:  * map lands - the character select line-up is spawned only once the terrain
 9:  * is up and the server's character list has arrived - so the gate lifted on
10:  * an empty scene and the characters walked in afterwards, in front of the
11:  * player. A system that owns such content holds the gate by name while its
12:  * content is still on its way; `sceneReadySystem` is the only reader.
13:  */
14: const holds = new Set<string>();
15: 
16: export function setSceneHold(name: string, held: boolean): void {
17:   if (held) holds.add(name);
18:   else holds.delete(name);
19: }
20: 
21: export function sceneHeld(): boolean {
22:   return holds.size > 0;
23: }
24: 
25: /**
26:  * Everything an entity needs before it is worth showing: the model, the body
27:  * and equipment parts loaded under it after `Ready` flips (`PartsPending`),
28:  * and the appearance pass that asks for those parts (`charAppearance.changed`
29:  * is cleared by AppearanceSystem once it has). Waiting on `Ready` alone let a
30:  * character appear in its default body and put its armour on afterwards.
31:  *
32:  * A model that failed to load counts as finished - it is never arriving.
33:  */
34: export function isStaged(entity: Entity | undefined): boolean {
35:   if (!entity) return false;
36: 
37:   const model = entity.modelObject;
38:   if (!model) return false;
39:   if (model.LoadFailed) return true;
40:   if (!model.Ready || model.PartsPending > 0) return false;
41:   return !entity.charAppearance?.changed;
42: }
</file>

