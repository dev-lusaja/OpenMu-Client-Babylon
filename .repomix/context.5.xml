1593: // ---- dispatch ---------------------------------------------------------------------
1594: 
1595: function contextFor(scene: Scene, caster: Entity, target: Entity | null): SkillContext {
1596:   return { scene, caster, target, yaw: entityYaw(caster) };
1597: }
1598: 
1599: function runTravel(row: SkillVisual, ctx: SkillContext, target: Entity): void {
1600:   const { fromSky, skyOffset, ...travel } = row.travel!;
1601:   const from = fromSky ? entityPos(target, IMPACT_HEIGHT, new Vector3()) : entityPos(ctx.caster, CAST_HEIGHT, new Vector3());
1602:   if (fromSky) {
1603:     const [ox, up, oz] = skyOffset ?? [1.5, 8, 1];
1604:     from.x += ox;
1605:     from.y += up;
1606:     from.z -= oz;
1607:   } else {
1608:     // Leave from just in front of the hands, like the original's offset along the facing.
1609:     const to = entityPos(target, IMPACT_HEIGHT, new Vector3());
1610:     const dir = to.subtract(from).normalize();
1611:     from.addInPlace(dir.scaleInPlace(0.4));
1612:   }
1613:   const skill = currentSkill;
1614:   shoot(ctx.scene, from, baseSkill(skill), {
1615:     ...travel,
1616:     to: followEntity(target, IMPACT_HEIGHT),
1617:     onArrive: at => {
1618:       if (entityGone(target)) return;
1619:       currentSkill = skill;
1620:       row.impact?.(at, ctx);
1621:     },
1622:   });
1623: }
