 428:         writer.write(`
 429:   private _readString (from :number, to: number): string {
 430:     let val = "";
 431:     for(let i = from; i < to; i++){
 432:       const ch = String.fromCharCode(this.buffer.getUint8(i));
 433: 
 434:       if (ch === "\0")break;
 435: 
 436:       val += ch;
 437:     }
 438:               
 439:     return val;
 440:   }
