<file path="src/common/playerShopBuyResult.test.ts">
 1: import { describe, expect, it } from 'vitest';
 2: import { ItemSerializer } from './itemSerializer';
 3: import {
 4:   PlayerShopBuyResultPacket,
 5:   PlayerShopBuyResultResultKindEnum,
 6: } from './packets/ServerToClientPackets';
 7: 
 8: /**
 9:  * A buy from another player's stall is answered with this packet and nothing
10:  * else - the item itself rides here (OpenMU `BuyRequestAction`), so the
11:  * offsets it is read at are the whole purchase.
12:  */
13: function serverPacket(slot: number, itemData: number[]): DataView {
14:   const bytes = new Uint8Array(21);
15:   bytes[0] = 0xc1;
16:   bytes[1] = 21;
17:   bytes[2] = 0x3f;
18:   bytes[3] = 0x06;
19:   bytes[4] = PlayerShopBuyResultResultKindEnum.Success;
20:   bytes[5] = 0x12; // SellerId, big endian
21:   bytes[6] = 0x34;
22:   bytes.set(itemData, 7);
23:   bytes[20] = slot;
24:   return new DataView(bytes.buffer);
25: }
26: 
27: describe('PlayerShopBuyResult', () => {
28:   it('reads the inventory slot the item was put in', () => {
29:     const p = new PlayerShopBuyResultPacket(serverPacket(37, []));
30: 
31:     expect(p.Result).toBe(PlayerShopBuyResultResultKindEnum.Success);
32:     expect(p.SellerId).toBe(0x1234);
33:     expect(p.ItemSlot).toBe(37);
34:   });
35: 
36:   it('carries the bought item', () => {
37:     // Excellent +13 lucky socketed item, as the seller had it.
38:     const wire = [
39:       0x2c, 0xef, 0x80, 0x61, 0x06, 0xd0, 0x02, 0x05, 0xfe, 0xff, 0xff, 0xff,
40:       0x00,
41:     ];
42:     const p = new PlayerShopBuyResultPacket(serverPacket(12, wire));
43: 
44:     const item = ItemSerializer.DeserializeItem(
45:       new Uint8Array(p.ItemData.buffer)
46:     );
47: 
48:     expect(item.group).toBe(13);
49:     expect(item.num).toBe(44);
50:     expect(item.lvl).toBe(13);
51:     expect(item.luck).toBe(true);
52:     expect(item.isExcellent).toBe(true);
53:     expect(item.socketCount).toBe(2);
54:   });
55: });
</file>

<file path="src/common/playSpeed.ts">
  1: import { MonsterActionType, PlayerAction } from './objects/enum';
  2: import { MONSTER_MODEL_TABLE } from './monsters/monsterModelTable';
  3: 
  4: /**
  5:  * Animation play speeds in the original's units: `PlaySpeed` keys per tick at
  6:  * 25 ticks/s (`ZzzBMD.cpp:382-448`, `ZzzAI.cpp:729`). Our GLB clips are
  7:  * authored at 24 keys/s, so Babylon `speedRatio = PlaySpeed * 25 / 24`
  8:  * (applied in ModelObject).
  9:  */
 10: export const BMD_KEYS_PER_SECOND = 24;
 11: export const REFERENCE_FPS = 25;
 12: export const PLAY_SPEED_TO_RATIO = REFERENCE_FPS / BMD_KEYS_PER_SECOND;
 13: 
 14: /**
 15:  * `SetAttackSpeed()` stat scaling (ZzzCharacter.cpp:738-826): the piecewise
 16:  * multiplier is the cap - there is no clamp on the result.
 17:  */
 18: export function attackSpeedFactor(attackSpeed: number): number {
 19:   if (attackSpeed >= 509 && attackSpeed <= 549) return attackSpeed * 0.0026;
 20:   if (attackSpeed >= 550 && attackSpeed <= 750) return attackSpeed * 0.0017;
 21:   return attackSpeed * 0.004;
 22: }
 23: 
 24: /** Magic-speed multiplier used by most spells (`MagicSpeed2`). */
 25: export function magicSpeedFactor(magicSpeed: number): number {
 26:   const m = magicSpeed;
 27:   if (m <= 0) return 0;
 28:   if (m < 300) return m * 0.0020;
 29:   if (m < 350) return m * 0.00247;
 30:   if (m < 400) return m * 0.0019;
 31:   if (m < 450) return m * 0.0018;
 32:   if (m < 500) return m * 0.0017;
 33:   if (m < 550) return m * 0.00163;
 34:   if (m < 600) return m * 0.00155;
 35:   if (m < 650) return m * 0.00175;
 36:   if (m < 700) return m * 0.0015;
 37:   if (m < 750) return m * 0.00145;
 38:   if (m < 800) return m * 0.0013;
 39:   if (m < 850) return m * 0.00125;
 40:   if (m < 900) return m * 0.00115;
 41:   if (m < 950) return m * 0.0009;
 42:   return m * 0.00081;
 43: }
 44: 
 45: const A = PlayerAction;
 46: 
 47: /** Player action table (ZzzOpenData.cpp:314-372 + SetAttackSpeed bases). */
 48: export function playerPlaySpeed(
 49:   action: PlayerAction,
 50:   attackSpeed = 0,
 51:   magicSpeed = 0,
 52:   isRageFighter = false
 53: ): number {
 54:   const f = attackSpeedFactor(attackSpeed);
 55: 
 56:   // --- basic attacks (SetAttackSpeed, ZzzCharacter.cpp:830-960)
 57:   if (action === A.PLAYER_ATTACK_FIST) return 0.6 + f;
 58:   if (action === A.PLAYER_ATTACK_TWO_HAND_SWORD_TWO) return 0.24 + f;
 59:   if (
 60:     action === A.PLAYER_ATTACK_BOW ||
 61:     action === A.PLAYER_ATTACK_CROSSBOW ||
 62:     action === A.PLAYER_ATTACK_FLY_BOW ||
 63:     action === A.PLAYER_ATTACK_FLY_CROSSBOW ||
 64:     action === A.PLAYER_ATTACK_RIDE_BOW ||
 65:     action === A.PLAYER_ATTACK_RIDE_CROSSBOW ||
 66:     (action >= A.PLAYER_ATTACK_BOW_UP && action <= A.PLAYER_ATTACK_RIDE_CROSSBOW_UP)
 67:   ) {
 68:     return 0.3 + f;
 69:   }
 70:   if (action >= A.PLAYER_ATTACK_SWORD_RIGHT1 && action <= A.PLAYER_ATTACK_RIDE_CROSSBOW) {
 71:     return 0.25 + f;
 72:   }
 73:   if (action >= A.PLAYER_ATTACK_SKILL_SWORD1 && action < A.PLAYER_ATTACK_END) {
 74:     return 0.3 + f;
 75:   }
 76:   if (action >= A.PLAYER_SKILL_HAND1 && action <= A.PLAYER_SKILL_WEAPON2) {
 77:     return 0.29 + magicSpeedFactor(magicSpeed);
 78:   }
 79:   // Teleport is set on its own line, past the loop above
 80:   // (ZzzCharacter.cpp:860), so it never got its magic speed here: the clip
 81:   // ran at the 0.28 default and held the cast for a full second.
 82:   if (action === A.PLAYER_SKILL_TELEPORT) return 0.3 + magicSpeedFactor(magicSpeed);
 83:   // The rest of `SetAttackSpeed`'s spell block (ZzzCharacter.cpp:860-866).
 84:   // Only Teleport above had ever been ported, so these five ran at the 0.28
 85:   // fallback at the bottom of this function - Hellfire's leap, which is the
 86:   // clip itself and not a code path, took 1.8× as long to come down as it
 87:   // does in the original.
 88:   if (action === A.PLAYER_SKILL_FLASH) return 0.4 + magicSpeedFactor(magicSpeed);
 89:   if (action === A.PLAYER_SKILL_INFERNO) return 0.6 + magicSpeedFactor(magicSpeed);
 90:   if (action === A.PLAYER_SKILL_HELL) return 0.5 + magicSpeedFactor(magicSpeed);
 91:   if (action === A.PLAYER_RIDE_SKILL) return 0.3 + magicSpeedFactor(magicSpeed);
 92:   if (action === A.PLAYER_SKILL_HELL_BEGIN) return 0.5 + magicSpeedFactor(magicSpeed);
 93: 
 94:   // --- idle
 95:   if (action >= A.PLAYER_STOP_MALE && action <= A.PLAYER_STOP_RIDE_WEAPON) {
 96:     switch (action) {
 97:       case A.PLAYER_STOP_SWORD:
 98:         return 0.26;
 99:       case A.PLAYER_STOP_TWO_HAND_SWORD:
100:       case A.PLAYER_STOP_SPEAR:
101:       case A.PLAYER_STOP_SUMMONER:
102:         return 0.24;
103:       case A.PLAYER_STOP_BOW:
104:       case A.PLAYER_STOP_CROSSBOW:
105:         return 0.22;
106:       case A.PLAYER_STOP_WAND:
107:         return 0.3;
108:       default:
109:         return 0.28;
110:     }
111:   }
112:   if (action === A.PLAYER_STOP_TWO_HAND_SWORD_TWO) return 0.24;
113: 
114:   // --- locomotion. The base table sets the whole PLAYER_WALK_MALE ..
115:   // PLAYER_RUN_RIDE_WEAPON block to 0.30, but SetPlayerWalk rewrites it every
116:   // frame it runs (ZzzCharacter.cpp:396-453): walk 0.33 (Rage Fighter 0.32)
117:   // over PLAYER_WALK_MALE..PLAYER_WALK_CROSSBOW, run 0.34 (RF 0.28) over
118:   // PLAYER_RUN..PLAYER_RUN_RIDE_WEAPON, then the two wand clips again on top.
119:   // PLAYER_WALK_WAND and PLAYER_WALK_SWIM sit *after* PLAYER_WALK_CROSSBOW in
120:   // the enum, so neither is touched by the walk loop; PLAYER_RUN_SWIM and the
121:   // two fly clips *are* inside the run loop and so end up at 0.34, overriding
122:   // the 0.35 the base table gave swimming.
123:   if (action >= A.PLAYER_WALK_MALE && action <= A.PLAYER_WALK_CROSSBOW) {
124:     return isRageFighter ? 0.32 : 0.33;
125:   }
126:   if (action === A.PLAYER_WALK_WAND) return 0.44;
127:   if (action === A.PLAYER_WALK_SWIM) return 0.35;
128:   if (action >= A.PLAYER_RUN && action <= A.PLAYER_RUN_RIDE_WEAPON) {
129:     if (action === A.PLAYER_RUN_WAND) return 0.76;
130:     return isRageFighter ? 0.28 : 0.34;
131:   }
132:   if (action === A.PLAYER_WALK_TWO_HAND_SWORD_TWO) return 0.3;
133:   if (action === A.PLAYER_RUN_TWO_HAND_SWORD_TWO) return 0.3;
134: 
135:   // --- Fenrir rider clips: 0.45 base over the whole block, run 0.71 and
136:   // stand 0.40 on top (ZzzOpenData.cpp:388-401), attacks per SetAttackSpeed
137:   // (ZzzCharacter.cpp:873-882).
138:   if (action >= A.PLAYER_FENRIR_ATTACK && action <= A.PLAYER_FENRIR_WALK_ONE_LEFT) {
139:     switch (action) {
140:       case A.PLAYER_FENRIR_ATTACK:
141:       case A.PLAYER_FENRIR_ATTACK_TWO_SWORD:
142:       case A.PLAYER_FENRIR_ATTACK_SPEAR:
143:       case A.PLAYER_FENRIR_ATTACK_ONE_SWORD:
144:       case A.PLAYER_FENRIR_ATTACK_DARKLORD_SWORD:
145:         return 0.25 + f;
146:       case A.PLAYER_FENRIR_ATTACK_CROSSBOW:
147:       case A.PLAYER_FENRIR_ATTACK_BOW:
148:         return 0.3 + f;
149:       case A.PLAYER_FENRIR_ATTACK_DARKLORD_STRIKE:
150:         return 0.2 + f;
151:       case A.PLAYER_FENRIR_ATTACK_MAGIC:
152:         return 0.37 + magicSpeedFactor(magicSpeed);
153:       case A.PLAYER_FENRIR_ATTACK_DARKLORD_FLASH:
154:         return 0.4 + magicSpeedFactor(magicSpeed);
155:       case A.PLAYER_FENRIR_ATTACK_DARKLORD_TELEPORT:
156:         return 0.3;
157:     }
158:     if (action >= A.PLAYER_FENRIR_RUN && action <= A.PLAYER_FENRIR_RUN_ONE_LEFT_ELF) return 0.71;
159:     if (action >= A.PLAYER_FENRIR_STAND && action <= A.PLAYER_FENRIR_STAND_ONE_LEFT) return 0.4;
160:     return 0.45;
161:   }
162:   // --- Rage Fighter Fenrir clips (ZzzOpenData.cpp:411-427).
163:   if (action >= A.PLAYER_RAGE_FENRIR && action <= A.PLAYER_RAGE_FENRIR_ATTACK_RIGHT) {
164:     if (action === A.PLAYER_RAGE_FENRIR_ATTACK_RIGHT) return 0.25 + f;
165:     if (action >= A.PLAYER_RAGE_FENRIR_TWO_SWORD && action <= A.PLAYER_RAGE_FENRIR_ONE_LEFT) return 0.225;
166:     if (action === A.PLAYER_RAGE_FENRIR_STAND) return 0.21;
167:     if (action >= A.PLAYER_RAGE_FENRIR_STAND_TWO_SWORD && action <= A.PLAYER_RAGE_FENRIR_STAND_ONE_LEFT) return 0.2;
168:     if (action >= A.PLAYER_RAGE_FENRIR_RUN && action <= A.PLAYER_RAGE_FENRIR_RUN_ONE_LEFT) return 0.355;
169:     return 0.45;
170:   }
171: 
172:   // --- reactions
173:   if (action >= A.PLAYER_DEFENSE1 && action <= A.PLAYER_SHOCK) return 0.32;
174:   if (action === A.PLAYER_DIE1 || action === A.PLAYER_DIE2) return 0.45;
175: 
176:   // The Rage Fighter's own stance and his Uniria clips are named overrides on
177:   // top of the 0.40 the base table gives everything from PLAYER_SIT1 up
178:   // (ZzzOpenData.cpp:339-340, :428-431). The two run clips are rewritten to
179:   // 0.34 by SetPlayerWalk every frame it runs, like the rest of the run block
180:   // (ZzzCharacter.cpp:435-437), and those clips only ever play while running.
181:   switch (action) {
182:     case A.PLAYER_STOP_RAGEFIGHTER:
183:       return 0.16;
184:     case A.PLAYER_RAGE_UNI_STOP_ONE_RIGHT:
185:       return 0.18;
186:     case A.PLAYER_RAGE_UNI_ATTACK_ONE_RIGHT:
187:       return 0.2;
188:     case A.PLAYER_RAGE_UNI_RUN:
189:     case A.PLAYER_RAGE_UNI_RUN_ONE_RIGHT:
190:       return 0.34;
191:   }
192:   if (action >= A.PLAYER_SIT1) return 0.4;
193: 
194:   return 0.28;
195: }
196: 
197: /**
198:  * `PLAYER_STOP_RAGEFIGHTER`'s rate, which the Phoenix Soul Star's own clip is
199:  * keyed to (`RenderCharacterItem`, ZzzCharacter.cpp:9922).
200:  */
201: export const RAGEFIGHTER_STOP_SPEED = 0.16;
202: 
203: /**
204:  * Wing part play speed (`RenderCharacterBackItem`, ZzzCharacter.cpp:15107-15129).
205:  * Flapping only while a FLY clip runs; the Wing of Storm beats at half rate up
206:  * there, and the Wing of Ruin is pinned to 0.15 by `RenderLinkObject` (:6477).
207:  */
208: export function wingsPlaySpeed(
209:   playerAction: PlayerAction,
210:   spec?: { playSpeed?: number; flyPlaySpeed?: number } | null
211: ): number {
212:   if (spec?.playSpeed !== undefined) return spec.playSpeed;
213: 
214:   const flying =
215:     playerAction === A.PLAYER_FLY || playerAction === A.PLAYER_FLY_CROSSBOW;
216: 
217:   if (!flying) return 0.25;
218: 
219:   return spec?.flyPlaySpeed ?? 1.0;
220: }
221: 
222: const M = MonsterActionType;
223: 
224: /** Per-model overrides (`OpenMonsterModel`, ZzzOpenData.cpp:2380-2440; ids from _enum.h:4149+). */
225: const MONSTER_OVERRIDES: Readonly<Record<number, Partial<Record<MonsterActionType, number>>>> = {
226:   2: { [M.Walk]: 0.7 }, // Budge Dragon
227:   6: { [M.Walk]: 0.6 }, // Larva
228:   8: { [M.Walk]: 0.7 }, // Hell Spider
229:   9: { [M.Walk]: 1.2 }, // Spider
230:   10: { [M.Walk]: 0.28 }, // Cyclops
231:   12: { [M.Walk]: 0.3 }, // Yeti
232:   13: { [M.Walk]: 0.28 }, // Elite Yeti
233:   17: { [M.Walk]: 0.5 }, // Worm
234:   19: { [M.Walk]: 0.6 }, // Goblin
235:   20: { [M.Walk]: 0.4 }, // Chain Scorpion
236:   21: { [M.Walk]: 0.5 }, // Beetle Monster
237:   28: { [M.Walk]: 0.3 }, // Shadow
238:   39: { [M.Walk]: 0.22 }, // Titan
239:   41: { [M.Walk]: 0.18 }, // Golden Wheel
240:   42: { [M.Attack1]: 0.35, [M.Attack2]: 0.35 }, // Tantallos
241:   44: { [M.Die]: 0.3 }, // Beam Knight
242:   63: { [M.Die]: 0.1 }, // Death Angel
243:   64: { [M.Attack1]: 0.3, [M.Attack2]: 0.25, [M.Shock]: 0.15, [M.Die]: 0.25 }, // Illusion of Kundun
244:   66: { [M.Die]: 0.1 }, // Aegis
245:   67: { [M.Attack1]: 0.2, [M.Attack2]: 0.3 }, // Death Centurion
246:   69: { [M.Die]: 0.1 }, // Shriker
247: };
248: 
249: function monsterBasePlaySpeed(action: MonsterActionType): number {
250:   switch (action) {
251:     case M.Stop1:
252:       return 0.25;
253:     case M.Stop2:
254:       return 0.2;
255:     case M.Walk:
256:       return 0.34;
257:     case M.Attack1:
258:     case M.Attack2:
259:     case M.Attack3:
260:     case M.Attack4:
261:     case M.Appear:
262:       return 0.33;
263:     case M.Shock:
264:       return 0.5;
265:     case M.Die:
266:       return 0.55;
267:     default:
268:       return 0.25;
269:   }
270: }
271: 
272: /** Monster action table keyed by *model* index (not NPC type number). */
273: export function monsterPlaySpeed(modelType: number, action: MonsterActionType): number {
274:   let speed = monsterBasePlaySpeed(action);
275:   // Type multipliers apply to STOP1..SHOCK only (the loop stops before DIE).
276:   if (action < M.Die) {
277:     if (modelType === 3) speed *= 1.2;
278:     if (modelType === 5 || modelType === 25) speed *= 0.7;
279:     if (modelType === 37 || modelType === 42) speed *= 0.4;
280:   }
281:   const override = MONSTER_OVERRIDES[modelType]?.[action];
282:   return override ?? speed;
283: }
284: 
285: export function monsterModelTypeOf(npcType: number | undefined): number {
286:   if (npcType === undefined) return -1;
287:   return MONSTER_MODEL_TABLE[npcType]?.[0] ?? -1;
288: }
289: 
290: /**
291:  * Applies the stat-scaled play speed of a player action to `model` *now*,
292:  * so that `getActionDuration`/`restartAction` called in the same frame see
293:  * the attack/cast rate rather than the stale idle/walk rate (AnimationSystem
294:  * only re-applies speeds later in the frame).
295:  */
296: export function applyPlayerActionSpeed(
297:   model: { AnimationSpeed: number; actionPlaySpeed(a: number): number | undefined },
298:   action: PlayerAction,
299:   attrs: { getValue(name: any): number } | undefined
300: ): void {
301:   model.AnimationSpeed =
302:     model.actionPlaySpeed(action) ??
303:     playerPlaySpeed(
304:       action,
305:       attrs?.getValue('attackSpeed') ?? 0,
306:       attrs?.getValue('magicSpeed') ?? 0
307:     );
308: }
309: 
310: /**
311:  * OpenMU's Speedhack Anti-Cheat (SpeedHackDetectPlugIn.AttackCheatCheckAsync)
312:  * accepts at most one hit/skill per
313:  * `max(AttackSpeedMinIntervalMs, AttackSpeedBaseDelayMs - attackSpeed * AttackSpeedScalingFactor)`
314:  * ms on a 5-token bucket; sustained faster rates earn warnings and, after
315:  * MaxWarnings, a ban. A very fast clip (high agility) must therefore never
316:  * send the next request before this interval has elapsed - the animation may
317:  * play at its stat rate, the *request* waits. Values mirror the plugin's
318:  * defaults; a small margin absorbs timer/network jitter.
319:  */
320: export const SERVER_ATTACK_BASE_DELAY_MS = 450;
321: export const SERVER_ATTACK_SCALING_FACTOR = 1.2;
322: export const SERVER_ATTACK_MIN_INTERVAL_MS = 60;
323: const SERVER_ATTACK_SAFETY_MARGIN = 1.1;
324: 
325: export function serverMinAttackInterval(attackSpeed: number): number {
326:   const ms = Math.max(
327:     SERVER_ATTACK_MIN_INTERVAL_MS,
328:     SERVER_ATTACK_BASE_DELAY_MS - attackSpeed * SERVER_ATTACK_SCALING_FACTOR
329:   );
330:   return (ms / 1000) * SERVER_ATTACK_SAFETY_MARGIN;
331: }
</file>

