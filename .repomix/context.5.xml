1543: /** The look for a skill with no row, from what the server says it is. */
1544: export function fallbackFor(def: SkillDefinition | undefined): SkillVisual {
1545:   if (!def) return NOTHING;
1546:   const area = def.type === 'AreaSkillAutomaticHits' || def.type === 'AreaSkillExplicitTarget';
1547:   switch (def.type) {
1548:     case 'PassiveBoost':
1549:       return NOTHING;
1550:     case 'Buff':
1551:       return FALLBACK_BUFF;
1552:     case 'Regeneration':
1553:       return FALLBACK_HEAL;
1554:     case 'SummonMonster':
1555:       return FALLBACK_SUMMON;
1556:     default:
1557:       break;
1558:   }
1559:   switch (def.damageType) {
1560:     case 'Wizardry':
1561:       return area ? FALLBACK_WIZARDRY_AREA : FALLBACK_WIZARDRY;
1562:     case 'Curse':
1563:       return FALLBACK_CURSE;
1564:     case 'Physical':
1565:       return area ? FALLBACK_PHYSICAL_AREA : FALLBACK_PHYSICAL;
1566:     case 'Fenrir':
1567:       return FALLBACK_FENRIR;
1568:     default:
1569:       // "None" damage with a target and no other type: a buff-ish flash.
1570:       return def.type === 'DirectHit' ? FALLBACK_BUFF : NOTHING;
1571:   }
1572: }
