 41:  * candelabra whose pools overlap read as brighter than one and not as a flat
 42:  * plateau. A hard clamp is what forced the emitters to be tuned as tight hot
 43:  * cores in the first place - see the note in devias/candleObject.ts - because
 44:  * any generous tail summed straight into the ceiling and erased the gradient
 45:  * the pools were supposed to read against.
 46:  */
 47: const DELTA_KNEE = 0.55;
 48: const DELTA_LINEAR = 255 * DELTA_KNEE;
 49: const DELTA_ROOM = 255 - DELTA_LINEAR;
 50: let deltaBytes: Uint8Array | null = null;
 51: let deltaDirty = false;
 52: 
 53: const emitters = new Set<TerrainLightEmitter>();
 54: 
 55: /** Tile each emitter last wrote from; a change rebuilds the touched set. */
 56: const emitterTiles = new Map<TerrainLightEmitter, number>();
 57: 
 58: let touched: Int32Array | null = null;
 59: let touchedDirty = true;
 60: 
 61: /** Tiles past the footprint radius kept in the touched set. */
 62: const TOUCHED_MARGIN = 1;
 63: 
 64: const tileKey = (x: number, y: number): number =>
 65:   Math.floor(x) * TERRAIN_SIZE * 4 + Math.floor(y);
 66: 
 67: export function initTerrainDynamicLight(liftedBaked: Float32Array): void {
 68:   baked = liftedBaked;
 69:   primary = liftedBaked.slice();
 70:   floor = new Float32Array(liftedBaked.length);
 71:   deltaBytes = new Uint8Array(TERRAIN_SIZE * TERRAIN_SIZE * 4);
 72:   // Alpha is not light (see writeTerrainOpenness). Open sky until something
 73:   // says otherwise, so a map whose mask has not been built yet reads as
 74:   // outdoors rather than as one enormous roof.
 75:   for (let i = 0; i < TERRAIN_SIZE * TERRAIN_SIZE; i++) {
 76:     deltaBytes[i * 4 + 3] = 255;
 77:   }
 78:   deltaDirty = true;
 79:   emitters.clear();
 80:   emitterTiles.clear();
 81:   touched = null;
 82:   touchedDirty = true;
 83: }
 84: 
 85: export function disposeTerrainDynamicLight(): void {
 86:   baked = null;
 87:   primary = null;
 88:   floor = null;
 89:   deltaBytes = null;
 90:   emitters.clear();
 91:   emitterTiles.clear();
 92:   touched = null;
 93:   touchedDirty = true;
 94: }
