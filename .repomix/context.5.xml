155: /** The link matrix `RenderLinkObject` builds for a back-bound item (:6543-6757). */
156: function backLink(
157:   item: { group: number; num: number },
158:   leftItem: boolean,
159:   rageCommon: boolean
160: ): Matrix {
161:   const key = `${item.group}:${item.num}`;
162:   const base = isCrossbow(item)
163:     ? BACK_CROSSBOW
164:     : (BACK_SPECIALS.get(key) ??
165:       (item.group === GROUP_BOW
166:         ? BACK_BOW
167:         : isShield(item)
168:           ? BACK_SHIELD
169:           : BACK_WEAPON));
170:   const matrix = angleMatrix(withOverrides(base));
171: 
172:   // Rage Fighter common weapons sit lower on the back (:6731-6736).
173:   if (rageCommon) {
174:     matrix[1][3] += 10;
175:     matrix[2][3] += 25;
176:   }
177: 
178:   // `bRightHandItem == false`, not a shield, not the Arrow Viper Bow (:6738):
179:   // R_ConcatTransforms(Matrix, mNewRot, Matrix)
180:   if (
181:     leftItem &&
182:     !isShield(item) &&
183:     !(item.group === GROUP_BOW && item.num === ARROW_VIPER_BOW)
184:   ) {
185:     if (rageCommon) matrix[1][3] += 7;
186:     const flip = rageCommon ? LEFT_ITEM_FLIP_RAGE : LEFT_ITEM_FLIP;
187:     // `?backShear=clean` A/B (dev): a non-aliased multiply instead of the
188:     // original's in-place concat, to compare against its sheared result.
189:     if (readQuery('backShear') === 'clean') {
190:       const copy = matrix.map(row => [...row]) as typeof matrix;
191:       concatTransforms(copy, angleMatrix(flip), matrix);
192:     } else {
193:       concatTransforms(matrix, angleMatrix(flip), matrix);
194:     }
195:   }
196: 
197:   // b->BodyScale = 0.9 (:6735) scales the model about its own origin, which
198:   // lands innermost of every link transform: fold it into the basis columns.
199:   if (rageCommon) {
200:     for (let r = 0; r < 3; r++) {
201:       matrix[r][0] *= 0.9;
202:       matrix[r][1] *= 0.9;
203:       matrix[r][2] *= 0.9;
204:     }
205:   }
206: 
207:   return toBabylon(matrix);
208: }
209: 
210: /**
211:  * `RenderCharacterBackItem`'s stowed-part animation (:15044-15065): every
212:  * back-bound sword…shield item holds frame 0 with PlaySpeed 0; the Stinger
213:  * Bow is the one exception, looping its clip 2 at 0.25.
214:  */
215: function backPose(item: {
216:   group: number;
217:   num: number;
218: }): PartPose {
219:   return item.group === GROUP_BOW && item.num === STINGER_BOW
220:     ? { action: 2, speed: 0.25 }
221:     : { action: 0, speed: 0 };
222: }
223: 
224: /** Holds the first frame: `PlaySpeed = 0`, `AnimationFrame = 0.001`. */
225: const HELD: PartPose = { action: 0, speed: 0 };
226: 
227: /** `PLAYER_STOP_MALE`'s rate, which every animated in-hand item is keyed to. */
228: const STOP_MALE_SPEED = 0.28;
229: 
230: /**
231:  * The Phoenix Soul Star (`RenderCharacterItem` :9919-9927): its clip runs at
232:  * one and a half times the Rage Fighter's stance rate until `AnimationFrame`
233:  * reaches 2, and is pinned there from then on - the wings spread once and
234:  * stay spread. The same pose drives the weapon and its wing part, which the
235:  * original animates off the one `PART_t`.
236:  */
237: export const PHOENIX_POSE: PartPose = {
238:   action: 0,
239:   speed: RAGEFIGHTER_STOP_SPEED * 1.5,
240:   holdFrame: 2,
241: };
242: 
243: /**
244:  * The handful of weapons `RenderCharacterItem` keeps animating in the hand
245:  * (ZzzCharacter.cpp:9895-9950). Everything else - bows included, which is
246:  * why an idle archer is not forever drawing the string - holds frame 0.
247:  * Keyed `group:num`.
248:  */
249: const HAND_CLIPS: Readonly<Record<string, PartPose>> = {
250:   '2:5': { action: 0, speed: STOP_MALE_SPEED * 2 }, // Crystal Sword
251:   '2:16': { action: 0, speed: STOP_MALE_SPEED }, // Frost Mace
252:   '2:17': { action: 0, speed: STOP_MALE_SPEED }, // Absolute Scepter
253:   '5:6': { action: 0, speed: STOP_MALE_SPEED * 15 }, // Staff of Resurrection
254:   '5:34': { action: 0, speed: STOP_MALE_SPEED }, // Raven Stick
255:   [`${GROUP_BOW}:${STINGER_BOW}`]: { action: 0, speed: STOP_MALE_SPEED },
256: };
257: 
258: /** The Flail swings its head: clip 2 under a sword swing, clip 1 at rest. */
259: const FLAIL = '2:2';
260: 
261: /** The four clips that make a weapon's own bow/crossbow clip run (:9883). */
262: function isBowDrawAction(action: PlayerAction): boolean {
263:   return (
264:     action === PlayerAction.PLAYER_ATTACK_BOW ||
265:     action === PlayerAction.PLAYER_ATTACK_CROSSBOW ||
266:     action === PlayerAction.PLAYER_ATTACK_FLY_BOW ||
267:     action === PlayerAction.PLAYER_ATTACK_FLY_CROSSBOW
268:   );
269: }
270: 
271: /**
272:  * `RenderCharacterItem`'s per-frame `w->CurrentAction` / `w->PlaySpeed`
273:  * switch (ZzzCharacter.cpp:9881-9955). `playerSpeed` is the rate of the clip
274:  * the character is playing, which is what the original hands the bow and the
275:  * Flail while they follow a swing.
276:  */
277: function handPose(
278:   item: { group: number; num: number },
279:   action: PlayerAction,
280:   playerSpeed: number
281: ): PartPose {
282:   const key = `${item.group}:${item.num}`;
283: 
284:   if (isBowDrawAction(action)) {
285:     // The draw runs for as long as the swing does; a Stinger Bow draws on
286:     // clip 1 because its idle wobble already owns clip 0.
287:     const stinger = item.group === GROUP_BOW && item.num === STINGER_BOW;
288:     return { action: stinger ? 1 : 0, speed: playerSpeed };
289:   }
290: 
291:   if (key === FLAIL) {
292:     const swinging =
293:       action >= PlayerAction.PLAYER_ATTACK_SWORD_RIGHT1 &&
294:       action <= PlayerAction.PLAYER_ATTACK_SWORD_RIGHT2;
295:     return swinging
296:       ? { action: 2, speed: playerSpeed }
297:       : { action: 1, speed: STOP_MALE_SPEED };
298:   }
299: 
300:   if (item.group === GROUP_SWORD && item.num === PHOENIX_SOUL_STAR) {
301:     return PHOENIX_POSE;
302:   }
303: 
304:   // The whole sword group keeps its clip 0 running; most of those clips are
305:   // a single frame, so this only shows on the few swords that have one.
306:   return HAND_CLIPS[key] ?? (item.group === GROUP_SWORD ? { action: 0, speed: STOP_MALE_SPEED } : HELD);
307: }
308: 
309: /** True when this slot's item is riding the back rather than the hand. */
310: function stowed(
311:   item: Item | null,
312:   hands: (Hands & { charClass?: CharacterClassNumber }) | undefined,
313:   bindBack: boolean
314: ): item is Item {
315:   return !!item && ((bindBack && isBackItem(item, hands)) || isAmmo(item));
316: }
317: 
318: /**
319:  * `RenderCharacterBackItem`: when `bindBack` is true every sword…shield item
320:  * moves to the back bone, ammo is always on the back, everything else stays
321:  * in the hands. Idempotent; call whenever the appearance or the bind state
322:  * changes. The clip each part runs is `applyWeaponPoses`, every frame.
323:  */
324: export function applyWeaponAttachments(
325:   player: PlayerObject,
326:   hands: (Hands & { charClass?: CharacterClassNumber }) | undefined,
327:   bindBack: boolean
328: ) {
329:   const main = hands && isWeaponItem(hands.leftHand) ? hands.leftHand : null;
330:   const off = hands && isWeaponItem(hands.rightHand) ? hands.rightHand : null;
331:   const rageFighter =
332:     hands?.charClass !== undefined &&
333:     getBaseClass(hands.charClass) === BaseClass.RageFighter;
334:   const rageCommon = (item: { group: number; num: number }) =>
335:     rageFighter && RAGE_FIGHTER_COMMON.has(`${item.group}:${item.num}`);
336: 
337:   // Slot 0 (appearance "leftHand") → Weapon1 → right hand (bRightHandItem).
338:   if (stowed(main, hands, bindBack)) {
339:     player.Weapon1.setBoneLink(BACK_BONE, backLink(main, false, rageCommon(main)));
340:   } else {
341:     player.Weapon1.setBoneLink(RIGHT_HAND_BONE);
342:   }
343: 
344:   // Slot 1 (appearance "rightHand") → Weapon2 → left hand.
345:   if (stowed(off, hands, bindBack)) {
346:     player.Weapon2.setBoneLink(BACK_BONE, backLink(off, true, rageCommon(off)));
347:   } else {
348:     player.Weapon2.setBoneLink(LEFT_HAND_BONE);
349:   }
350: }
351: 
352: /**
353:  * The clip each weapon part runs this frame: the stowed pose on the back,
354:  * otherwise `RenderCharacterItem`'s in-hand switch. Cheap to call every
355:  * frame - an unchanged pose is a no-op.
356:  */
357: export function applyWeaponPoses(
358:   player: PlayerObject,
359:   hands: (Hands & { charClass?: CharacterClassNumber }) | undefined,
360:   bindBack: boolean,
361:   action: PlayerAction,
362:   playerSpeed: number
363: ) {
364:   const main = hands && isWeaponItem(hands.leftHand) ? hands.leftHand : null;
365:   const off = hands && isWeaponItem(hands.rightHand) ? hands.rightHand : null;
366: 
367:   const poseFor = (item: Item | null) => {
368:     if (!item) return null;
369:     if (stowed(item, hands, bindBack)) return backPose(item);
370:     return handPose(item, action, playerSpeed);
371:   };
372: 
373:   player.Weapon1.setPartPose(poseFor(main));
374:   player.Weapon2.setPartPose(poseFor(off));
375: 
376:   // The wings run off the weapon's own clip, and the original renders them
377:   // before the back-item pass - they spread on the arms whether or not the
378:   // weapon itself is stowed.
379:   player.PhoenixWing1.setPartPose(isPhoenixSoulStar(main) ? PHOENIX_POSE : null);
380:   player.PhoenixWing2.setPartPose(isPhoenixSoulStar(off) ? PHOENIX_POSE : null);
381: }
</file>

