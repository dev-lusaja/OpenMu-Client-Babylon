 369: /** `n` streamers fanning around the up axis, `i*step` radians apart, from `at`. */
 370: const streamerFan = (
 371:   n: number,
 372:   step: number,
 373:   o: { velocity: number; seconds: number; maxTails: number; width: number; colour: RGB; pitch?: number; turn?: number; gravity?: number; blend?: JointOptions['blend']; texture?: string }
 374: ): Step => (at, c) => {
 375:   const base = entityYaw(c.caster);
 376:   const pitch = o.pitch ?? 0;
 377:   for (let i = 0; i < n; i++) {
 378:     const f = forwardOf(base + i * step);
 379:     const heading = new Vector3(f.x * Math.cos(pitch), Math.sin(pitch), f.z * Math.cos(pitch));
 380:     effects.spawn('joint', c.scene, at, { ...o, heading });
