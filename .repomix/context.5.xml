 1: import { nanoid } from 'nanoid';
 2: 
 3: const TWO_PI = Math.PI * 2;
 4: 
 5: export class Rand {
 6:   static readonly EPSILON = 0.00000001;
 7: 
 8:   static nextRandomBool(chance: number = 0.5) {
 9:     if (chance <= this.EPSILON) {
10:       return false;
11:     }
12: 
13:     const lot = Math.random();
14:     return lot <= chance;
15:   }
16: 
17:   /// <summary>
18:   /// Returns a random integer between min and max.
19:   /// </summary>
20:   /// <param name="min">The inclusive lower bound of the random number returned.</param>
21:   /// <param name="max">The exclusive upper bound of the random number returned.</param>
22:   /// <returns>A random number.</returns>
23:   static nextInt(
24:     min: number = 0,
25:     max: number = Number.MAX_SAFE_INTEGER
26:   ): number {
27:     return min + Math.floor(Math.random() * (max - min));
28:   }
29: 
30:   static nextFloat(min: number = 0, max: number = Number.MAX_VALUE): number {
31:     return min + Math.random() * (max - min);
32:   }
33: 
34:   static nextSign(plusChance: number = 0.5) {
35:     const plus = this.nextRandomBool(plusChance);
36: 
37:     return plus ? 1 : -1;
38:   }
39: 
40:   static id(): string {
41:     return nanoid(10);
42:   }
43: 
44:   static randomElement<T extends any[]>(array: T): T[0] {
45:     if (array.length === 0) return null;
46: 
47:     return array[Rand.nextInt(0, array.length)];
48:   }
49: 
50:   static nextRad() {
51:     return Math.random() * TWO_PI;
52:   }
53: 
54:   static nextHalfRad() {
55:     return Math.random() * Math.PI;
56:   }
57: }
