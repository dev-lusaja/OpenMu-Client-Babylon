126: export type FenrirVariant = 'red' | 'blue' | 'black' | 'gold';
127: 
128: /**
129:  * `GetFenrirType` (ZzzCharacter.cpp:98-108): the horn's option bits, carried
130:  * in `Helper.ExcellentFlags` - 0x01 black (Destruction), 0x02 blue
131:  * (Protection), 0x04 gold (Illusion), none red.
132:  */
133: export function fenrirVariant(item: Item | null | undefined): FenrirVariant {
134:   const flags = item?.excellentFlags ?? 0;
135:   if (flags & 0x01) return 'black';
136:   if (flags & 0x02) return 'blue';
137:   if (flags & 0x04) return 'gold';
138:   return 'red';
139: }
