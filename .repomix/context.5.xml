1574: /**
1575:  * The row a master-level skill borrows: `SKILL_VISUALS` and the lighting
1576:  * tables are keyed by the base skill, and a Strengthener / Mastery number
1577:  * must land on the same row as the skill it strengthens.
1578:  */
1579: export function baseSkill(skill: number): number {
1580:   return SKILL_VISUALS[skill] ? skill : MASTER_ALIASES[skill] ?? skill;
1581: }
1582: 
1583: /** The row for a skill, through master aliases, else its type's fallback. */
1584: export function skillVisualFor(skill: number): SkillVisual {
1585:   return SKILL_VISUALS[skill] ?? SKILL_VISUALS[MASTER_ALIASES[skill] ?? -1] ?? fallbackFor(skillDefinition(skill));
1586: }
1587: 
1588: /** How many skills have their own row (aliases included). */
1589: export function skillVisualCount(): number {
1590:   return Object.keys(SKILL_VISUALS).length + Object.keys(MASTER_ALIASES).length;
1591: }
