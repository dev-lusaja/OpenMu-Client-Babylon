<file path="src/common/netStats.ts">
 1: /**
 2:  * Server round trip, measured on request/answer pairs the client already
 3:  * exchanges.
 4:  *
 5:  * OpenMU never answers the keep-alive `Ping` (see the comment by the ping
 6:  * interval in `logic.ts`), so there is nothing to time directly. Instead the
 7:  * three requests that always draw exactly one answer mark themselves sent
 8:  * here, and the handler of that answer closes the pair: a chat line and its
 9:  * echo, an item move and `ItemMoved`, a warp and `MapChanged`. Nothing new
10:  * goes on the wire.
11:  *
12:  * One writer for the figure the performance readout prints. Deliberately not
13:  * observable: the readout polls it twice a second, so a sample can never cost
14:  * a React render.
15:  */
16: 
17: export type NetSampleKind = 'chat' | 'itemMove' | 'warp';
18: 
19: /** Slower than this is a stalled request, not a round trip. */
20: const MAX_SAMPLE_MS = 5000;
21: 
22: /** Unanswered requests remembered per kind; the oldest falls off. */
23: const MAX_PENDING = 4;
24: 
25: /** How many samples the printed figure is the median of. */
26: const WINDOW = 7;
27: 
28: function medianOf(values: readonly number[]): number {
29:   const sorted = [...values].sort((a, b) => a - b);
30:   const middle = sorted.length >> 1;
31: 
32:   return sorted.length % 2 === 1
33:     ? sorted[middle]
34:     : (sorted[middle - 1] + sorted[middle]) / 2;
35: }
36: 
37: export const NetStats = new (class _NetStats {
38:   private pending = new Map<NetSampleKind, number[]>();
39:   private samples: number[] = [];
40:   private smoothed: number | null = null;
41: 
42:   /** Median of the recent samples, null until the first pair closes. */
43:   get roundTripMs(): number | null {
44:     return this.smoothed;
45:   }
46: 
47:   /** How many samples the median currently stands on. */
48:   get sampleCount(): number {
49:     return this.samples.length;
50:   }
51: 
52:   markSent(kind: NetSampleKind): void {
53:     let queue = this.pending.get(kind);
54: 
55:     if (!queue) {
56:       queue = [];
57:       this.pending.set(kind, queue);
58:     }
59: 
60:     queue.push(performance.now());
61: 
62:     // Answers arrive in the order the requests were made, so the queue is a
63:     // FIFO; a request nobody ever answered drops off the front.
64:     while (queue.length > MAX_PENDING) queue.shift();
65:   }
66: 
67:   markAnswered(kind: NetSampleKind): void {
68:     const sentAt = this.pending.get(kind)?.shift();
69:     if (sentAt === undefined) return;
70: 
71:     const elapsed = performance.now() - sentAt;
72:     if (elapsed < 0 || elapsed > MAX_SAMPLE_MS) return;
73: 
74:     this.samples.push(elapsed);
75:     if (this.samples.length > WINDOW) this.samples.shift();
76: 
77:     this.smoothed = medianOf(this.samples);
78:   }
79: 
80:   /** A new socket is a new set of numbers. */
81:   reset(): void {
82:     this.pending.clear();
83:     this.samples.length = 0;
84:     this.smoothed = null;
85:   }
86: })();
</file>

