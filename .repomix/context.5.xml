 711:   /**
 712:    * `ClosingProcess`: the goblin refuses to close while items are still in
 713:    * the tray, so they cannot be lost. `notify` is false when the server told
 714:    * us it closed (0x87), which also overrides the refusal - the tray is gone
 715:    * on its side either way.
 716:    */
 717:   closeMix(notify = true): boolean {
 718:     if (!this.mixOpen) return true;
 719: 
 720:     if (!notify) this.returnPickedFrom(StorageKind.ChaosMachine);
 721: 
 722:     // Only what is in - or was lifted out of - the tray blocks the close; a
 723:     // jewel carried from the inventory (one a refused upgrade left on the
 724:     // cursor, say) is not the goblin's business.
 725:     const pickedFromTray = Store.pickedItem?.fromStorage === StorageKind.ChaosMachine;
 726:     if (notify && (this.mixItems.some(Boolean) || pickedFromTray)) {
 727:       Social.errorMessage(t('chaos.takeItemsOut'));
 728:       return false;
 729:     }
 730: 
 731:     if (notify && !Store.isOffline) {
 732:       Store.sendToGS(CraftingDialogCloseRequestPacket.createPacket().buffer);
 733:     }
 734: 
 735:     runInAction(() => {
 736:       this.mixOpen = false;
 737:       this.mixItems = emptyGrid(MIX_SLOTS);
 738:       this.mixPending = false;
 739:       this.mixResult = null;
 740:     });
 741:     return true;
 742:   }
