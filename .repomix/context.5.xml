 41:       action <= PlayerAction.PLAYER_RIDE_SKILL) ||
 42:     (action >= PlayerAction.PLAYER_SKILL_SLEEP &&
 43:       action <= PlayerAction.PLAYER_SKILL_LIGHTNING_SHOCK) ||
 44:     action === PlayerAction.PLAYER_RECOVER_SKILL ||
 45:     (action >= PlayerAction.PLAYER_SKILL_THRUST &&
 46:       action <= PlayerAction.PLAYER_SKILL_HP_UP_OURFORCES)
 47:   );
