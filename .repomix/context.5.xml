155:     const indices: number[] = [];
156: 
157:     for (let j = 0; j < this.#cols - 1; j++) {
158:       for (let i = 0; i < this.#cols - 1; i++) {
159:         const a = i + j * this.#cols;
160: 
161:         indices.push(a, a + 1, a + this.#cols + 1);
162:         indices.push(a, a + this.#cols + 1, a + this.#cols);
163:       }
164:     }
165: 
166:     const mesh = new Mesh(name, world.scene);
167: 
168:     const data = new VertexData();
169:     data.positions = this.#positions;
170:     data.uvs = this.#uvs;
171:     data.indices = indices;
172:     data.applyToMesh(mesh, true);
173: 
174:     mesh.setParent(world.mapParent);
175:     mesh.isPickable = false;
176: 
177:     mesh.alwaysSelectAsActiveMesh = true;
178: 
179:     mesh.material = this.#material = createAdditiveMaterial(
180:       world.scene,
181:       `${name}Material`
182:     );
183:     if (blend === 'alpha') {
184:       // EnableAlphaBlend(): straight alpha from the texture (blood, footprints).
185:       this.#material.alphaMode = Constants.ALPHA_COMBINE;
