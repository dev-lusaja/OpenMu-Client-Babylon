<file path="src/common/weaponBlur.ts">
  1: import { PlayerAction } from './objects/enum';
  2: import type { Item } from '../ecs/world';
  3: import { LEFT_HAND_BONE, RIGHT_HAND_BONE } from './weaponAttachment';
  4: import { GROUP_AXE, GROUP_MACE, GROUP_SHIELD, GROUP_SPEAR, GROUP_SWORD } from './weaponClass';
  5: import type { EffectBlend, RGB } from '../effects/core';
  6: import { TEX } from '../effects/recipes';
  7: 
  8: /**
  9:  * `CreateWeaponBlur` (ZzzCharacter.cpp:3656-3925) as a table: which swing
 10:  * clips, with which weapon in hand, leave a trail, where along the blade it
 11:  * is drawn, which sheet and which colour. The **consumer** is
 12:  * `ecs/systems/weaponTrailSystem.ts`, which asks once per clip start and
 13:  * spawns `effects.spawn('blur', …)` on the weapon's hand bone; the drawing
 14:  * is `effects/blur.ts`.
 15:  *
 16:  * The original's two knobs are `BlurType` (where on the blade: the hilt
 17:  * sample `Pos1` and the tip `Pos2`, centimetres down the link bone's Y) and
 18:  * `BlurMapping` (which `BITMAP_BLUR + n` sheet; 0 also picks the colour from
 19:  * the weapon's level). `RenderBlurs` (ZzzEffectBlurSpark.cpp:173) draws a
 20:  * levelled owner's trail with `EnableAlphaBlendMinus` - a dark smear - and
 21:  * only a level-0 owner's additively.
 22:  */
 23: 
 24: // ---- units -------------------------------------------------------------------
 25: 
 26: /** Centimetres → tiles. */
 27: const cm = (n: number): number => n / 100;
 28: 
 29: // ---- BlurType: the two samples down the link bone (`Pos1` / `Pos2`) ------------
 30: 
 31: type BlurType = 1 | 2 | 3 | 4 | 5;
 32: 
 33: /** `[hilt, tip]` in tiles along the bone's −Y, per BlurType (:3815-3831). */
 34: const BLADE_SAMPLES: Readonly<Record<BlurType, readonly [number, number]>> = {
 35:   1: [cm(20), cm(120)],
 36:   2: [cm(80), cm(120)],
 37:   3: [cm(100), cm(120)],
 38:   4: [cm(0), cm(200)],
 39:   5: [cm(0), cm(20)],
 40: };
 41: 
 42: // ---- BlurMapping: sheet + colour ----------------------------------------------
 43: 
 44: /** `BITMAP_BLUR + mapping` (RenderBlurs: 3 → BLUR2, 4 → BLUR, 5 → BLUR+3). */
 45: const MAPPING_SHEET: Readonly<Record<number, string>> = {
 46:   0: TEX.blur,
 47:   1: TEX.motionBlur,
 48:   2: TEX.motionBlurR,
 49:   3: TEX.blur2,
 50:   4: TEX.blur,
 51:   5: TEX.motionMono,
 52:   6: TEX.motionBlurR3,
 53: };
 54: 
 55: /** Mapping 0 tints by the weapon's level (:3844-3861); every other mapping is white. */
 56: const LEVEL_COLOURS: readonly (readonly [number, RGB])[] = [
 57:   [7, [1, 0.6, 0.2]],
 58:   [5, [0.2, 0.4, 1]],
 59:   [3, [1, 0.2, 0.2]],
 60:   [0, [0.8, 0.8, 0.8]],
 61: ];
 62: const WHITE: RGB = [1, 1, 1];
 63: 
 64: /** `o->AnimationFrame >= 3.f`: the trail starts three keys into the swing. */
 65: const START_KEY = 3;
 66: 
 67: /** Blow of Destruction only trails between keys 2 and 8 (:3697). */
 68: const BLOW_KEYS: readonly [number, number] = [2, 8];
 69: 
 70: // ---- the row -------------------------------------------------------------------
 71: 
 72: export type WeaponBlurRow = {
 73:   /** MU bone index the weapon hangs from (`Weapon[Hand].LinkBone`). */
 74:   bone: number;
 75:   /** Tiles down the bone's −Y for the hilt and the tip samples. */
 76:   hilt: number;
 77:   tip: number;
 78:   texture: string;
 79:   colour: RGB;
 80:   blend: EffectBlend;
 81:   /** Keys into the clip at which sampling starts / must stop. */
 82:   startKey: number;
 83:   endKey: number;
 84: };
 85: 
 86: export type Hands = { leftHand: Item | null; rightHand: Item | null } | undefined;
 87: 
 88: const A = PlayerAction;
 89: 
 90: function isMelee(item: Item | null | undefined): item is Item {
 91:   return !!item && item.group < GROUP_SHIELD;
 92: }
 93: 
 94: const inRange = (a: number, lo: number, hi: number): boolean => a >= lo && a <= hi;
 95: 
 96: /**
 97:  * The trail this swing clip leaves with these hands, or null for none. `Hand`
 98:  * 0 is the main-hand slot (`leftHand` bytes → `Weapon1` → the right-hand
 99:  * bone); the `SWORD_LEFT` clips swing the other one. `hasLevel` is the
100:  * owner's `c->Level != 0`: a character's trail darkens, a monster's glows.
101:  */
102: export function weaponBlurFor(
103:   hands: Hands,
104:   action: PlayerAction,
105:   hasLevel: boolean
106: ): WeaponBlurRow | null {
107:   // `if (c->Weapon[0].Type != -1 || c->Weapon[1].Type != -1)`: bare hands leave nothing.
108:   if (!isMelee(hands?.leftHand) && !isMelee(hands?.rightHand)) return null;
109: 
110:   const leftClip =
111:     action === A.PLAYER_ATTACK_SWORD_LEFT1 || action === A.PLAYER_ATTACK_SWORD_LEFT2;
112:   const weapon = leftClip ? hands?.rightHand : hands?.leftHand;
113:   const group = weapon?.group ?? -1;
114:   const level = weapon?.lvl ?? 0;
115: 
116:   let blurType = 0;
117:   let mapping = 0;
118:   let startKey = START_KEY;
119:   let endKey = Infinity;
120: 
121:   if (action === A.PLAYER_ATTACK_ONE_FLASH || action === A.PLAYER_ATTACK_RUSH) {
122:     blurType = 1;
123:     mapping = 2;
124:   } else if (inRange(action, A.PLAYER_ATTACK_SKILL_SWORD2, A.PLAYER_ATTACK_SKILL_SWORD4)) {
125:     blurType = 1;
126:     mapping = 2;
127:   } else if (action === A.PLAYER_ATTACK_STRIKE) {
128:     blurType = 1;
129:     mapping = 2;
130:   } else if (inRange(action, A.PLAYER_SKILL_LIGHTNING_ORB, A.PLAYER_SKILL_LIGHTNING_ORB_FENRIR)) {
131:     blurType = 1;
132:     mapping = 1;
133:   } else if (action === A.PLAYER_SKILL_BLOW_OF_DESTRUCTION) {
134:     blurType = 1;
135:     mapping = 2;
136:     [startKey, endKey] = BLOW_KEYS;
137:   } else if (action === A.PLAYER_ATTACK_SKILL_SWORD5) {
138:     blurType = 1;
139:     mapping = 2;
140:   } else if (group === GROUP_SWORD) {
141:     const twoHandTwo = action === A.PLAYER_ATTACK_TWO_HAND_SWORD_TWO;
142:     if (
143:       inRange(action, A.PLAYER_ATTACK_SWORD_RIGHT1, A.PLAYER_ATTACK_TWO_HAND_SWORD3) ||
144:       twoHandTwo
145:     ) {
146:       blurType = 1;
147:       if (action === A.PLAYER_ATTACK_TWO_HAND_SWORD3 || twoHandTwo) mapping = 1;
148:       // The "TWO" clip trails from its first key (:3658).
149:       if (twoHandTwo) startKey = 0;
150:     }
151:   } else if (group === GROUP_AXE || group === GROUP_MACE) {
152:     if (inRange(action, A.PLAYER_ATTACK_SKILL_SWORD1, A.PLAYER_ATTACK_SKILL_SWORD5)) {
153:       blurType = 1;
154:       mapping = 2;
155:     }
156:   } else if (group === GROUP_SPEAR) {
157:     if (inRange(action, A.PLAYER_ATTACK_SPEAR1, A.PLAYER_ATTACK_SCYTHE3)) {
158:       blurType = 3;
159:       if (action === A.PLAYER_ATTACK_SCYTHE3) mapping = 1;
160:     }
161:   }
162:   if (blurType === 0) return null;
163: 
164:   const [hilt, tip] = BLADE_SAMPLES[blurType as BlurType];
165:   const colour = mapping === 0 ? LEVEL_COLOURS.find(([min]) => level >= min)![1] : WHITE;
166:   return {
167:     bone: leftClip ? LEFT_HAND_BONE : RIGHT_HAND_BONE,
168:     hilt,
169:     tip,
170:     texture: MAPPING_SHEET[mapping] ?? TEX.blur,
171:     colour,
172:     blend: hasLevel ? 'subtract' : 'add',
173:     startKey,
174:     endKey,
175:   };
176: }
