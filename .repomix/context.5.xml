<file path="src/common/registerRules.ts">
 1: /**
 2:  * What a signup has to look like before anyone bothers the database.
 3:  *
 4:  * Three places ask the question: the login window's register form, the
 5:  * standalone page (`register/src`), and the service itself
 6:  * (`register/server/main.ts`), which re-checks all of it because anything can
 7:  * POST to it. The two forms share this file so a rule tightened for one is not
 8:  * quietly looser in the other.
 9:  *
10:  * It answers with a *reason*, never a sentence: the client renders it through
11:  * `t()` and the standalone page through its own English, and neither wants a
12:  * string the other chose. Engine-free, like `rateLimit.ts` beside it - nothing
13:  * here may drag Babylon or a store into a server process.
14:  */
15: 
16: /** `data."Account"."LoginName"` is `varchar(10)`; longer would truncate. */
17: export const MAX_ACCOUNT_LENGTH = 10;
18: export const MIN_ACCOUNT_LENGTH = 4;
19: export const MAX_ACCOUNT_PASSWORD_LENGTH = 10;
20: export const MIN_ACCOUNT_PASSWORD_LENGTH = 4;
21: 
22: /** MU account names are ASCII; the server rejects anything else anyway. */
23: const ACCOUNT_RE = /^[A-Za-z0-9]+$/;
24: 
25: /**
26:  * Printable ASCII, space excluded.
27:  *
28:  * The login packet carries the password as one byte per character in a
29:  * ten-byte field, and the server reads that field back as UTF-8. A byte of
30:  * 0x80 or over is not valid UTF-8 on its own, so any accented or non-Latin
31:  * character is replaced on the way in and the password the server checks is
32:  * not the one that was typed. Signing up with one produces an account that
33:  * exists and can never be logged into, which is what this stops.
34:  */
35: const PASSWORD_RE = /^[!-~]+$/;
36: 
37: export type SignupProblem =
38:   | 'empty'
39:   | 'idShort'
40:   | 'idChars'
41:   | 'passwordShort'
42:   | 'passwordChars'
43:   | 'mismatch';
44: 
45: export type Signup = {
46:   username: string;
47:   password: string;
48:   confirm: string;
49: };
50: 
51: /** The first thing wrong with this signup, or null when nothing is. */
52: export function validateSignup(signup: Signup): SignupProblem | null {
53:   const { username, password, confirm } = signup;
54: 
55:   if (!username || !password || !confirm) return 'empty';
56:   if (username.length < MIN_ACCOUNT_LENGTH) return 'idShort';
57:   if (!ACCOUNT_RE.test(username)) return 'idChars';
58:   if (password.length < MIN_ACCOUNT_PASSWORD_LENGTH) return 'passwordShort';
59:   if (!PASSWORD_RE.test(password)) return 'passwordChars';
60:   if (password !== confirm) return 'mismatch';
61: 
62:   return null;
63: }
</file>

