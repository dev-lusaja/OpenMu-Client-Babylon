 11: /**
 12:  * Actions that play once and then hand control back to the idle/walk logic.
 13:  *
 14:  * The bounds are the original's, read off the test it uses to decide whether
 15:  * the hero is still busy with a clip (ZzzInterface.cpp:7570-7580): the block
 16:  * runs `PLAYER_ATTACK_FIST … PLAYER_RIDE_SKILL`, then
 17:  * `PLAYER_SKILL_SLEEP … PLAYER_SKILL_LIGHTNING_SHOCK`, `PLAYER_RECOVER_SKILL`
 18:  * and `PLAYER_SKILL_THRUST … PLAYER_SKILL_HP_UP_OURFORCES`, and re-admits the
 19:  * stand / walk / run clips that happen to sit inside the first range. Every
 20:  * skill clip of `combat/recipes.ts` falls in one of these - a cast clip
 21:  * outside them would loop for ever instead of returning to idle, which is
 22:  * what the old `PLAYER_SKILL_HAND1 … PLAYER_SKILL_TELEPORT` bound did to
 23:  * every clip past Teleport.
 24:  */
 25: export function isPlayerSkillAction(action: PlayerAction): boolean {
 26:   // The stand / walk / run clips the original re-admits by name.
 27:   if (
 28:     (action >= PlayerAction.PLAYER_DARKLORD_STAND &&
 29:       action <= PlayerAction.PLAYER_RUN_RIDE_HORSE) ||
 30:     (action >= PlayerAction.PLAYER_FENRIR_RUN &&
 31:       action <= PlayerAction.PLAYER_FENRIR_WALK_ONE_LEFT) ||
 32:     (action >= PlayerAction.PLAYER_STOP_TWO_HAND_SWORD_TWO &&
 33:       action <= PlayerAction.PLAYER_RUN_TWO_HAND_SWORD_TWO) ||
 34:     (action >= PlayerAction.PLAYER_RAGE_FENRIR_WALK &&
 35:       action <= PlayerAction.PLAYER_RAGE_FENRIR_STAND_ONE_LEFT)
 36:   ) {
 37:     return false;
