 2: 
 3: function _readString(buffer: DataView, from: number, to: number): string {
 4:   let val = '';
 5:   for (let i = from; i < to; i++) {
 6:     const ch = String.fromCharCode(buffer.getUint8(i));
 7: 
 8:     if (ch === '\0') break;
 9: 
10:     val += ch;
11:   }
12: 
13:   return val;
14: }
15: 
16: /**
17:  * `OpenTerrainHeightNew` (ZzzLodTerrain.cpp:737-790), the 24-bit variant
18:  * three worlds use - `IsTerrainHeightExtMap` (:599): Balgas Refuge (42),
19:  * Vulcanus / PK Field (63) and Doppelganger 2 (66). The file is the same
20:  * 4-byte tag + BITMAPFILEHEADER (14) + BITMAPINFOHEADER (40), but the pixels
21:  * are 24-bit BGR with no palette, and each pixel is one 24-bit integer read
22:  * *reversed* (`pbyHeight[0] = src[2]`) plus `g_fMinHeight = -500`. No 1.5
23:  * factor on this path. Detected by size: 196666 bytes against the 8-bit
24:  * file's 66620.
25:  */
26: const EXT_PIXELS_OFFSET = 4 + 14 + 40;
27: const EXT_MIN_HEIGHT = -500;
28: 
29: export async function parseTerrainHeight(buffer: Uint8Array) {
30:   const result = new Float32Array(TERRAIN_SIZE * TERRAIN_SIZE);
31: 
32:   if (buffer.length >= EXT_PIXELS_OFFSET + TERRAIN_SIZE * TERRAIN_SIZE * 3) {
33:     for (let i = 0; i < TERRAIN_SIZE * TERRAIN_SIZE; i++) {
34:       const at = EXT_PIXELS_OFFSET + i * 3;
35:       const height =
36:         buffer[at + 2] | (buffer[at + 1] << 8) | (buffer[at] << 16);
37:       result[i] = (height + EXT_MIN_HEIGHT) / 100;
38:     }
39:     return result;
40:   }
41: 
42:   const Index = 1084;
43:   const factor = 1.5 / 100;
44: 
45:   for (let y = 0; y < TERRAIN_SIZE; y++) {
46:     for (let x = 0; x < TERRAIN_SIZE; x++) {
47:       result[y * TERRAIN_SIZE + x] =
48:         buffer[Index + y * TERRAIN_SIZE + x] * factor;
49:     }
50:   }
51: 
52:   return result;
53: }
</file>

<file path="src/common/terrain/parseTerrainLight.ts">
 1: import { liftBorderVignette } from './borderVignette';
 2: import { TERRAIN_SIZE } from './consts';
 3: import { createTerrainNormal } from './createTerrainNormal';
 4: import { TERRAIN_INDEX } from './utils';
 5: 
 6: /** Direction the bake is lit from. The original's non-Battle-Castle value. */
 7: const LIGHT_X = 0.5;
 8: const LIGHT_Y = -0.5;
 9: const LIGHT_Z = 0.5;
10: 
11: function clamp01(v: number): number {
12:   return v < 0 ? 0 : v > 1 ? 1 : v;
13: }
14: 
15: /**
16:  * The baked terrain light, packed as 3 floats per texel.
17:  *
18:  * Pure: no Babylon, no DOM, typed arrays in and out - so it runs in the
19:  * terrain worker (todo C8) and the result transfers instead of cloning.
20:  * `lightBuffer` is the decoded TerrainLight.OZJ (3 floats per texel), which
21:  * still has to be produced on the main thread because the JPEG decode goes
22:  * through the engine.
23:  *
24:  * `liftBorder` undoes the bake's border vignette first (`borderVignette.ts`).
25:  * Off on Classic, which keeps the original's fade.
26:  */
27: export function parseTerrainLightPacked(
28:   lightBuffer: Float32Array,
29:   heightData: Float32Array,
30:   liftBorder = false
31: ): Float32Array {
32:   if (liftBorder) liftBorderVignette(lightBuffer);
33: 
34:   const normals = createTerrainNormal(heightData);
35:   const result = new Float32Array(TERRAIN_SIZE * TERRAIN_SIZE * 3);
36: 
37:   for (let y = 0; y < TERRAIN_SIZE; y++) {
38:     for (let x = 0; x < TERRAIN_SIZE; x++) {
39:       const i = TERRAIN_INDEX(x, y);
40:       const o = i * 3;
41: 
42:       // Dot(normal, light) + 0.5, clamped - the original's Luminosity.
43:       const luminosity = clamp01(
44:         normals[o] * LIGHT_X +
45:           normals[o + 1] * LIGHT_Y +
46:           normals[o + 2] * LIGHT_Z +
47:           0.5
48:       );
49: 
50:       // The lightmap sample is clamped to [0,1] per channel first, then
51:       // scaled by the luminosity.
52:       result[o] = clamp01(lightBuffer[o]) * luminosity;
53:       result[o + 1] = clamp01(lightBuffer[o + 1]) * luminosity;
54:       result[o + 2] = clamp01(lightBuffer[o + 2]) * luminosity;
55:     }
56:   }
57: 
58:   return result;
59: }
</file>

