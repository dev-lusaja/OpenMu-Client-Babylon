 588:     }
 589: }
 590: `);
 591:               return;
 592:             }
 593:             case "Binary": {
 594:               writer.write(`  get ${name}(){
 595:     const to = ${length != null ? Number(index) + Number(length) : `this.buffer.byteLength`};
 596:     const i = ${index};
 597:               
 598:     return new DataView(this.buffer.buffer.slice(i,to));
