  7: /**
  8:  * Rendering style (rendering_style ARCHITECTURE): 0 is the frame as it is,
  9:  * 1 steps the sun's response on every lit model, 2 adds the ink outline
 10:  * (scenes/inkOutline.ts), a stepped rim on the figures, flat tones on the
 11:  * textures and, behind their own toggles, an ink outline on the grass
 12:  * blades (`grassOutline`) and flat, contoured skill effects
 13:  * (`animeEffects`). On the Ultra tier the Anime style also draws a hard
 14:  * highlight on the figures and hatches the darkest band (`MU_TOON_ULTRA`).
 15:  * Live on lighting tiers >= 1 only: on Classic every reader here answers
 16:  * "off", so no define, uniform or pass exists and the frame is untouched.
 17:  *
 18:  * `styleStrength` (1..9) is the dial on how far the Anime style goes:
 19:  * flatter textures, a stronger rim. The ink lines have three sliders of
 20:  * their own, `lineStrength` (1..9, how dark), `lineWidth` (1..5 texels)
 21:  * and `linePlacement` (which side of a silhouette the line sits on); the
 22:  * grass outline and the effect contours follow the first two.
 23:  *
 24:  * Dev seams: `?style=` replaces the option, `?strength=` the dial,
 25:  * `?lineStrength=` the darkness, `?lineWidth=` the width,
 26:  * `?linePlacement=` the side,
 27:  * `?shadeSteps=` the band count, `?toonSoft=` the band edge width in
 28:  * pixels, `?toonRim=strength,edge`, `?toonTex=bias,levels`,
 29:  * `?toonGrass=darkness,start`, `?grassOutline=0|1`, `?animeEffects=0|1`,
 30:  * `?toonUltra=glint,hatch`.
 31:  */
 32: export const RENDERING_STYLE_LABEL_KEYS: readonly TextKey[] = [
 33:   'options.style.classic',
 34:   'options.style.cel',
 35:   'options.style.anime',
 36: ];
 37: 
 38: export const RENDERING_STYLE_MAX = RENDERING_STYLE_LABEL_KEYS.length - 1;
 39: 
 40: export type RenderingStyle = {
 41:   /** Stepped sun on every lit model (the `MU_TOON` define). */
 42:   readonly ramp: boolean;
 43:   /** Stepped rim on the figures, in sun units at mid strength; 0 draws none. */
 44:   readonly rim: number;
 45:   /** The screen-space ink outline pass. */
 46:   readonly outline: boolean;
 47:   /** Flat tones on the textures (`MU_TOON_FLAT`). */
 48:   readonly flat: boolean;
 49:   /** The Ultra tier's extras: the highlight and the hatching (`MU_TOON_ULTRA`). */
 50:   readonly extras: boolean;
 51: };
 52: 
 53: export const RENDERING_STYLES: readonly (RenderingStyle | null)[] = [
 54:   null,
 55:   { ramp: true, rim: 0, outline: false, flat: false, extras: false },
 56:   { ramp: true, rim: 1, outline: true, flat: true, extras: true },
 57: ];
 58: 
 59: export const SHADE_STEPS_MIN = 2;
 60: export const SHADE_STEPS_MAX = 4;
 61: export const STYLE_STRENGTH_MIN = 1;
 62: export const STYLE_STRENGTH_MAX = 9;
 63: export const LINE_WIDTH_MIN = 1;
 64: export const LINE_WIDTH_MAX = 5;
 65: export const LINE_STRENGTH_MIN = 1;
 66: export const LINE_STRENGTH_MAX = 9;
 67: 
 68: /**
 69:  * Where a line sits on a silhouette. Inside it, the line eats into the thing
 70:  * it draws, which is what a near-side-only test gives and what makes a wide
 71:  * line trim a wing or a blade. Across it, half the width lands on each side.
 72:  * Outside it, the thing keeps its whole shape and the line lies on whatever
 73:  * stands behind.
 74:  */
 75: export const LINE_PLACEMENT_LABEL_KEYS: readonly TextKey[] = [
 76:   'options.linePlacement.inset',
 77:   'options.linePlacement.centered',
 78:   'options.linePlacement.outset',
 79: ];
 80: 
 81: export const LINE_PLACEMENT_MAX = LINE_PLACEMENT_LABEL_KEYS.length - 1;
 82: 
 83: /** What the pass wants: 1 inside the silhouette, 0 across it, -1 outside. */
 84: const LINE_SIDES: readonly number[] = [1, 0, -1];
 85: 
 86: /** Ink darkness per step of the line strength: 0.2 at the bottom, black at the top. */
 87: const INK_DARKNESS_STEP = 0.1;
 88: 
 89: /** Band edge width in screen pixels (fwidth units); 0 is a hard edge. */
 90: const TOON_EDGE_SOFTNESS = 1;
 91: 
 92: /** Where the stepped rim switches on, in `(1 - N.V) x lit` units. */
 93: const TOON_RIM_EDGE = 0.45;
 94: 
 95: /** Where the grass outline starts to show along the blade, root 0 to tip 1. */
 96: const GRASS_INK_START = 0.2;
 97: 
 98: /** Frame height at which one ink texel is one pixel (the ink pass's rule). */
 99: const REFERENCE_HEIGHT = 900;
100: 
101: /** The Ultra highlight: its strength in sun units, and its Blinn exponent. */
102: const ULTRA_GLINT = 1;
103: const ULTRA_GLINT_POWER = 32;
104: 
105: /**
106:  * The Ultra hatching: the share of the darkest band's light it takes, and
107:  * its period in pixels at the reference height.
108:  */
109: const ULTRA_HATCH = 0.6;
110: const ULTRA_HATCH_PERIOD = 5;
111: 
112: 
113: const styleDev = devQueryNumber('style');
114: const strengthDev = devQueryNumber('strength');
115: const widthDev = devQueryNumber('lineWidth');
116: const lineStrengthDev = devQueryNumber('lineStrength');
117: const placementDev = devQueryNumber('linePlacement');
118: const stepsDev = devQueryNumber('shadeSteps');
119: const softDev = devQueryNumber('toonSoft');
120: const rimDev = devQueryNumbers('toonRim', 2);
121: const texDev = devQueryNumbers('toonTex', 2);
122: const grassDev = devQueryNumbers('toonGrass', 2);
123: const grassOutlineDev = devQueryNumber('grassOutline');
124: const animeEffectsDev = devQueryNumber('animeEffects');
125: const ultraDev = devQueryNumbers('toonUltra', 2);
126: 
127: const clamp = (value: number, lo: number, hi: number): number =>
128:   Math.max(lo, Math.min(hi, value));
129: 
130: export function styleIndex(): number {
131:   return clamp(
132:     Math.round(styleDev ?? GameOptions.renderingStyle),
133:     0,
134:     RENDERING_STYLE_MAX
135:   );
136: }
137: 
138: /** The live style; null on Classic whatever the option says. */
139: export function renderingStyle(): RenderingStyle | null {
140:   if (lightingTier() === null) return null;
141: 
142:   return RENDERING_STYLES[styleIndex()] ?? null;
143: }
144: 
145: export function shadeSteps(): number {
146:   return clamp(
147:     Math.round(stepsDev ?? GameOptions.shadeSteps),
148:     SHADE_STEPS_MIN,
149:     SHADE_STEPS_MAX
150:   );
151: }
152: 
153: /** The dial as stored, 1..9. */
154: export function styleStrength(): number {
155:   return clamp(
156:     Math.round(strengthDev ?? GameOptions.styleStrength),
157:     STYLE_STRENGTH_MIN,
158:     STYLE_STRENGTH_MAX
159:   );
160: }
161: 
162: /** The ink lines' width as stored, 1..5 texels at the reference height. */
163: export function lineWidth(): number {
164:   return clamp(
165:     Math.round(widthDev ?? GameOptions.lineWidth),
166:     LINE_WIDTH_MIN,
167:     LINE_WIDTH_MAX
168:   );
169: }
170: 
171: /** The ink lines' darkness as stored, 1..9. */
172: export function lineStrength(): number {
173:   return clamp(
174:     Math.round(lineStrengthDev ?? GameOptions.lineStrength),
175:     LINE_STRENGTH_MIN,
176:     LINE_STRENGTH_MAX
177:   );
178: }
179: 
180: /** The grass outline toggle as stored. */
181: export function grassOutline(): boolean {
182:   return grassOutlineDev !== null
183:     ? grassOutlineDev !== 0
184:     : GameOptions.grassOutline;
185: }
186: 
187: /** The skill effects toggle as stored. */
188: export function animeEffects(): boolean {
189:   return animeEffectsDev !== null
190:     ? animeEffectsDev !== 0
191:     : GameOptions.animeEffects;
192: }
193: 
194: /** The line placement as stored, 0..2. */
195: export function linePlacement(): number {
196:   return clamp(
197:     Math.round(placementDev ?? GameOptions.linePlacement),
198:     0,
199:     LINE_PLACEMENT_MAX
200:   );
201: }
202: 
203: /** vec4: x bands, y band edge softness (px), z rim strength, w rim edge. */
204: export const TOON_UNIFORM = 'muToon';
205: 
206: /**
207:  * vec4, Ultra only: x highlight strength (sun units, 0 on a prop), y its
208:  * exponent, z hatch strength, w hatch period in pixels.
209:  */
210: export const TOON_ULTRA_UNIFORM = 'muToonUltra';
211: 
212: /**
213:  * vec2: x the key's level (the lit sum on an up face in the open), y the
214:  * floor under it as a share (the sky's ground term). The item material binds
215:  * it from the rig; the bands span the two.
216:  */
217: export const TOON_REF_UNIFORM = 'muToonRef';
218: 
219: /**
220:  * vec4: x the mip bias on the art, y its tone levels, z the grass outline's
221:  * darkness, w its width in pixels. Bound by the item materials and by the
222:  * ground's light binder (terrainLighting.ts) alike.
223:  */
224: export const TOON_FILTER_UNIFORM = 'muToonFilter';
225: 
226: /**
227:  * What the materials bind, per draw. The director refreshes it once a tick
228:  * (`syncRenderingStyle`), so the compile-time bits and the uniforms can
229:  * never disagree and a bind reads no option.
230:  */
231: const toon = {
232:   active: false,
233:   flat: false,
234:   grass: false,
235:   effects: false,
236:   ultra: false,
237:   bands: 3,
238:   soft: TOON_EDGE_SOFTNESS,
239:   rim: 0,
240:   rimEdge: TOON_RIM_EDGE,
241:   inkDarkness: 0.6,
242:   inkWidth: 2,
243:   inkSide: 0,
244:   /** One ink texel in pixels at the current frame height. */
245:   inkPixel: 1,
246:   texBias: 1.25,
247:   texLevels: 7,
248:   grassInk: 0.6,
249:   grassStart: GRASS_INK_START,
250:   glint: ULTRA_GLINT,
251:   glintPower: ULTRA_GLINT_POWER,
252:   hatch: ULTRA_HATCH,
253:   hatchPeriod: ULTRA_HATCH_PERIOD,
254: };
255: 
256: /**
257:  * `frameHeight` is the backbuffer's, so the grass outline and the hatching
258:  * scale the way the ink lines do (one texel at 900 px, two at twice it).
259:  */
260: export function syncRenderingStyle(frameHeight = REFERENCE_HEIGHT): void {
261:   const style = renderingStyle();
262:   // 0 at the bottom of the dial, 1 at the top.
263:   const t = (styleStrength() - STYLE_STRENGTH_MIN) / (STYLE_STRENGTH_MAX - STYLE_STRENGTH_MIN);
264:   const pixel = Math.max(1, Math.round(frameHeight / REFERENCE_HEIGHT));
265: 
266:   toon.active = style?.ramp === true;
267:   toon.flat = style?.flat === true;
268:   toon.grass = style?.outline === true && grassOutline();
269:   toon.effects = style?.outline === true && animeEffects();
270:   toon.ultra = style?.extras === true && tierIndex() >= 2;
271:   toon.bands = shadeSteps();
272:   toon.soft = softDev ?? TOON_EDGE_SOFTNESS;
273:   toon.rim = rimDev?.[0] ?? (style?.rim ?? 0) * (0.5 + t);
274:   toon.rimEdge = rimDev?.[1] ?? TOON_RIM_EDGE;
275:   toon.inkDarkness = (lineStrength() + 1) * INK_DARKNESS_STEP;
276:   toon.inkWidth = lineWidth();
277:   toon.inkSide = LINE_SIDES[linePlacement()] ?? 0;
278:   toon.inkPixel = pixel;
279:   toon.texBias = texDev?.[0] ?? 0.5 + 1.5 * t;
280:   toon.texLevels = texDev?.[1] ?? Math.round(9 - 4 * t);
281:   toon.grassInk = grassDev?.[0] ?? toon.inkDarkness;
282:   toon.grassStart = grassDev?.[1] ?? GRASS_INK_START;
283:   toon.glint = ultraDev?.[0] ?? ULTRA_GLINT;
284:   toon.glintPower = ULTRA_GLINT_POWER;
285:   toon.hatch = ultraDev?.[1] ?? ULTRA_HATCH;
286:   toon.hatchPeriod = ULTRA_HATCH_PERIOD * pixel;
287: }
288: 
289: // Materials can compile before the director's first tick.
290: syncRenderingStyle();
