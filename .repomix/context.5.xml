1648: /**
1649:  * `AreaSkillAnimation` carries no target, but the explicit-target area
1650:  * skills (Chain Lightning, Drain Life, Teleport Ally) draw a bolt or a
1651:  * ribbon to one: `target` is the object the caller found standing on the
1652:  * cast point (the hero's own cast knows it; for others logic.ts picks the
1653:  * nearest object to the point). Objects stand on integer tile coordinates,
1654:  * so the point is used as is.
1655:  */
1656: export function playAreaSkillVisual(
1657:   scene: Scene,
1658:   skill: number,
1659:   caster: Entity,
1660:   point: { x: number; y: number } | null,
1661:   terrainHeight: (x: number, y: number) => number,
1662:   target: Entity | null = null
1663: ): void {
1664:   const x = point ? point.x : caster.transform!.pos.x;
1665:   const z = point ? point.y : caster.transform!.pos.z;
1666:   const y = terrainHeight(x, z);
1667: 
1668:   if (caster.transform) {
1669:     currentSkill = skill;
1670:     const row = skillVisualFor(skill);
1671:     const aimed = target?.transform ? target : null;
1672:     const ctx = contextFor(scene, caster, aimed);
1673:     const at = new Vector3(x, y, z);
1674:     row.cast?.(at, ctx);
1675:     if (row.travel && aimed) runTravel(row, ctx, aimed);
1676:     else if (row.area) row.area(at, ctx);
1677:     else if (row.impact) {
1678:       if (aimed) entityPos(aimed, IMPACT_HEIGHT, at);
1679:       else at.y += IMPACT_HEIGHT;
1680:       row.impact(at, ctx);
1681:     }
1682:   }
1683: 
1684:   lighting.skillArea(scene, skill, caster, { x, y, z });
1685: }
