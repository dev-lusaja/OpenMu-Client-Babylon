  1: import { ServerConfig, type ServerProfile } from './serverConfig';
  2: 
  3: /**
  4:  * The rest of a world, worked out from its domain.
  5:  *
  6:  * A world is one domain, and its pieces sit on fixed labels beneath it:
  7:  *
  8:  *     play.<domain>      the browser client
  9:  *     ws.<domain>        the ws-to-TCP proxy every connection goes through
 10:  *     register.<domain>  the signup page the login window links to
 11:  *     api.<domain>       the cash shop and marketplace services
 12:  *
 13:  * That convention is what lets one build play any world. This client is
 14:  * compiled once and published for everyone, so a world it has never heard of
 15:  * has to be able to say where its own pieces are - and a line in
 16:  * `serverlist.md` naming `example.net` says all of it at once.
 17:  *
 18:  * `play.` is the one label nothing here derives: a client asking the question
 19:  * is already being served from it.
 20:  *
 21:  * A world that does not follow the convention publishes its addresses in full
 22:  * instead (`host:port@wss://proxy`), and gets no services it did not name. The
 23:  * build-time variables are the other way out, for a client published beside
 24:  * exactly one server.
 25:  */
 26: 
 27: const env = import.meta.env;
 28: 
 29: /**
 30:  * Where a convention world's connect server is, as its proxy reaches it. The
 31:  * proxy dials on the browser's behalf and shares a machine with the game
 32:  * server, so this is loopback and not the world's own address - the same thing
 33:  * the published `host:port` form says out loud.
 34:  */
 35: export const CONVENTION_CS_HOST = '127.0.0.1';
 36: export const CONVENTION_CS_PORT = 44405;
 37: 
 38: /** Hostname of one of the world's services. */
 39: function serviceHost(label: string, domain: string): string {
 40:   return `${label}.${domain}`;
 41: }
 42: 
 43: /** The proxy a convention world is reached through. */
 44: export function conventionProxyUrl(domain: string): string {
 45:   return `wss://${serviceHost('ws', domain)}`;
 46: }
 47: 
 48: /**
 49:  * True while this page is being served by the world it is asking about, which
 50:  * is the case that is allowed to stay same-origin.
 51:  */
 52: function servedByWorld(domain: string): boolean {
 53:   if (typeof location === 'undefined') return false;
 54: 
 55:   const host = location.hostname.toLowerCase();
 56:   const lower = domain.toLowerCase();
 57: 
 58:   return host === lower || host.endsWith(`.${lower}`);
 59: }
 60: 
 61: /**
 62:  * Where the login window's "Create account" link goes, or empty for a world
 63:  * that has not said. The world's own page wins over the build's: a client that
 64:  * ships with one server's address still has to send a player registering for
 65:  * a different world to that world's page.
 66:  */
 67: export function registerUrl(
 68:   profile: ServerProfile = ServerConfig.active
 69: ): string {
 70:   if (profile.domain) return `https://${serviceHost('register', profile.domain)}`;
 71: 
 72:   return (env.VITE_REGISTER_URL as string) || '';
 73: }
 74: 
 75: /**
 76:  * Where the login window's own register form posts, or empty when this world
 77:  * has no signup service the client may talk to.
 78:  *
 79:  * The signup page and the endpoint behind it are published together, so a
 80:  * world that has the one has the other. Note what this is *not*: a relative
 81:  * path, even for a world serving this very page. `/api` on the client's host
 82:  * is the cash shop, and a signup posted there lands on its 404 - the register
 83:  * service answers on `register.<domain>` and is reached by name from anywhere,
 84:  * which is what `CORS_ORIGIN` on that service exists to allow.
 85:  *
 86:  * A build that names a signup page but no endpoint gets nothing here on
 87:  * purpose: the window falls back to linking out to that page, which is what
 88:  * it did before it could ask itself.
 89:  */
 90: export function registerApiUrl(
 91:   profile: ServerProfile = ServerConfig.active
 92: ): string {
 93:   if (profile.domain) {
 94:     return `https://${serviceHost('register', profile.domain)}/api/register`;
 95:   }
 96: 
 97:   return (env.VITE_REGISTER_API as string) || '';
 98: }
 99: 
100: /**
101:  * Where the cash shop asks for its catalogue.
102:  *
103:  * A world being played from its own site keeps the relative path: that
104:  * deployment publishes the service under `/api` on the client's host, which
105:  * costs no CORS allowlist and no second certificate. It is only somebody
106:  * else's shop that has to be addressed by name.
107:  */
108: export function shopApiUrl(profile: ServerProfile = ServerConfig.active): string {
109:   if (profile.domain && !servedByWorld(profile.domain)) {
110:     return `https://${serviceHost('api', profile.domain)}/api`;
111:   }
112: 
113:   return (env.VITE_CASHSHOP_API as string) || '/api';
114: }
115: 
116: /**
117:  * Where the marketplace window asks for its listings.
118:  *
119:  * The same rule as the shop, and for the same reason: a world played from its
120:  * own site keeps the relative path, and only somebody else's marketplace has
121:  * to be addressed by name. It shares `api.<domain>` with the shop because a
122:  * world publishes one service host, not one per window - the two answer on
123:  * different paths behind it.
124:  */
125: export function marketApiUrl(profile: ServerProfile = ServerConfig.active): string {
126:   if (profile.domain && !servedByWorld(profile.domain)) {
127:     return `https://${serviceHost('api', profile.domain)}/api/market`;
128:   }
129: 
130:   return (env.VITE_MARKETPLACE_API as string) || '/api/market';
131: }
</file>

<file path="src/common/serverTime.ts">
 1: /**
 2:  * The one clock every client agrees on.
 3:  *
 4:  * Anything that has to look the same on two screens at the same moment -
 5:  * ambient weather episodes, timed world events - must be a pure function of
 6:  * `serverNow()` rather than of `Math.random()` or a per-client uptime, or two
 7:  * players standing next to each other see different skies.
 8:  *
 9:  * The protocol carries no timestamp today (`WeatherStatusUpdate` pushes state,
10:  * not time), so the base is UTC wall time: NTP keeps desktops within a second
11:  * or two of each other, which is far tighter than the tens of seconds an
12:  * ambient episode lasts. `setServerTimeOffset` is the seam for the day a
13:  * server-stamped packet arrives - set it once from
14:  * `serverEpochMs - Date.now()` and every consumer follows without changing.
15:  */
16: 
17: let offsetMs = 0;
18: 
19: /** Re-anchor the shared clock: `offset = serverEpochMs - Date.now()`. */
20: export function setServerTimeOffset(ms: number): void {
21:   offsetMs = Number.isFinite(ms) ? ms : 0;
22: }
23: 
24: export function getServerTimeOffset(): number {
25:   return offsetMs;
26: }
27: 
28: /** Epoch milliseconds on the shared clock. */
29: export function serverNow(): number {
30:   return Date.now() + offsetMs;
31: }
</file>

<file path="src/common/sessionExit.ts">
  1: import { makeAutoObservable, runInAction } from 'mobx';
  2: import { t } from '../i18n';
  3: import { Store, UIState } from '../store';
  4: import { Economy } from '../economy';
  5: import { Social } from '../social';
  6: import { Messenger } from '../messenger';
  7: import { quests } from '../quests';
  8: import { LogOutPacket } from './packets/ClientToServerPackets';
  9: import { SessionResume } from './sessionResume';
 10: import { allowUnload } from './browserHotkeys';
 11: 
 12: /**
 13:  * The three ways out of a session: `CSystemMenuMsgBox`'s Exit Game, Select
 14:  * Server and Switch Character (NewUICustomMessageBox.cpp:2386-2470). The
 15:  * original opens that menu with Escape; here they are the Options window's
 16:  * first tab, and Escape on a clear screen opens it - the same key, one
 17:  * window fewer.
 18:  *
 19:  * The wire side is the original's and nothing more: `SendLogOut(0|2|1)`, and
 20:  * the screen only changes once the server has answered (`ReceiveLogOut`) - it
 21:  * is the side that decides when the character is safely out of the world.
 22:  * The timeout is the one thing the original has no need for: a browser socket
 23:  * can go quiet without ever closing, and a player who asked to leave must not
 24:  * be stuck in a world they have already left.
 25:  */
 26: 
 27: export type ExitKind = 'quit' | 'servers' | 'characters';
 28: 
 29: /** `LogOutType`: 0 CloseGame, 1 BackToCharacterSelection, 2 BackToServerSelection. */
 30: const LOGOUT_TYPE: Record<ExitKind, number> = {
 31:   quit: 0,
 32:   characters: 1,
 33:   servers: 2,
 34: };
 35: 
 36: const KIND_OF_TYPE: Record<number, ExitKind> = {
 37:   0: 'quit',
 38:   1: 'characters',
 39:   2: 'servers',
 40: };
 41: 
 42: const ANSWER_TIMEOUT = 5000;
 43: 
 44: function inWorld(): boolean {
 45:   return (
 46:     Store.uiState === UIState.World || Store.uiState === UIState.LoadingWorld
 47:   );
 48: }
 49: 
 50: export const SessionExit = new (class _SessionExit {
 51:   /** The exit waiting for the server's answer, or null. */
 52:   pending: ExitKind | null = null;
 53: 
 54:   private timer: ReturnType<typeof setTimeout> | null = null;
 55: 
 56:   constructor() {
 57:     makeAutoObservable<this, 'timer'>(this, { timer: false });
 58:   }
 59: 
 60:   /** Whether this way out leads anywhere from the screen we are on. */
 61:   available(kind: ExitKind): boolean {
 62:     // Offline has no account behind it: the only way out is back to the menu.
 63:     if (Store.isOffline) return kind === 'quit';
 64: 
 65:     switch (kind) {
 66:       case 'characters':
 67:         return inWorld();
 68:       case 'servers':
 69:         return inWorld() || Store.uiState === UIState.Characters;
 70:       case 'quit':
 71:         return Store.uiState !== UIState.Preloader;
 72:     }
 73:   }
 74: 
 75:   request(kind: ExitKind): void {
 76:     if (this.pending || !this.available(kind)) return;
 77: 
 78:     // The goblin's tray is client-side until the mix is sent: leaving with
 79:     // items in it loses them, so the original refuses too (GlobalText 592).
 80:     if (Economy.mixOpen) {
 81:       Social.errorMessage(t('exit.chaosOpen'));
 82:       return;
 83:     }
 84: 
 85:     // Nobody to ask: offline, or a screen the server does not think of us as
 86:     // playing on. The transition is ours to make.
 87:     if (Store.isOffline || !inWorld()) {
 88:       this.leave(kind);
 89:       return;
 90:     }
 91: 
 92:     runInAction(() => {
 93:       this.pending = kind;
 94:     });
 95: 
 96:     this.timer = setTimeout(() => {
 97:       this.timer = null;
 98:       runInAction(() => {
 99:         this.pending = null;
100:       });
101:       Store.addNotification(t('exit.noAnswer'), 'error');
102:       this.leave(kind);
103:     }, ANSWER_TIMEOUT);
104: 
105:     const p = LogOutPacket.createPacket();
106:     p.Type = LOGOUT_TYPE[kind];
107:     Store.sendToGS(p.buffer);
108:   }
109: 
110:   /**
111:    * `ReceiveLogOut` arrived. The server sends it unprompted too (a kick, a
112:    * second login on the account), so the type on the wire decides where we
113:    * land, not what we asked for.
114:    */
115:   onResponse(type: number): void {
116:     if (this.timer) clearTimeout(this.timer);
117:     this.timer = null;
118:     runInAction(() => {
119:       this.pending = null;
120:     });
121: 
122:     this.leave(KIND_OF_TYPE[type] ?? 'servers');
123:   }
124: 
125:   private leave(kind: ExitKind): void {
126:     SessionResume.forget();
127:     Store.closeNpcShop();
128:     quests.closeAll();
129:     // The character is out of the world on all three of these; the backdrop
130:     // behind the pre-game screens is not a map it stands on.
131:     Store.world?.removeHero();
132:     runInAction(() => {
133:       Store.optionsEnabled = false;
134:     });
135: 
136:     if (kind === 'characters') {
137:       runInAction(() => {
138:         Store.uiState = UIState.Characters;
139:       });
140:       // The window sheets go with the world; decoded again on the next entry.
141:       void import('../libs/mu/preloadSprites').then(m => m.clearWorldSprites());
142:       return;
143:     }
144: 
145:     if (kind === 'servers') {
146:       Store.disconnectFromGameServer();
147:       void import('../libs/mu/preloadSprites').then(m => m.clearWorldSprites());
148:       Store.playOnline();
149:       return;
150:     }
151: 
152:     // Exit Game. A browser tab cannot close itself, so the equivalent of the
153:     // original's `DestroyWindow` is the start menu it would boot back into.
154:     // Offline rewrote the URL to `/offline`, so that one restarts instead.
155:     if (Store.isOffline) {
156:       allowUnload();
157:       location.href = '/';
158:       return;
159:     }
160: 
161:     Store.disconnectFromGameServer();
162:     Store.disconnectFromConnectServer();
163:     void import('../libs/mu/preloadSprites').then(m => m.clearWorldSprites());
164:     runInAction(() => {
165:       Store.uiState = UIState.Preloader;
166:     });
167:   }
168: })();
169: 
170: /**
171:  * Escape on a clear screen. `NewUIManager::UpdateKeyEvent` closes the top
172:  * interface with it and opens the system menu when there is none; the window
173:  * stack has already had its turn by the time this is asked (`closeTop`).
174:  *
175:  * What it still has to know about are the overlays that answer Escape
176:  * themselves without joining that stack - the yes/no boxes another player
177:  * pops up, the amount prompts, the quest windows. Escape belongs to them
178:  * first.
179:  */
180: export function openSystemMenu(): boolean {
181:   if (Store.uiState !== UIState.World) return false;
182:   if (Store.optionsEnabled) return false;
183:   if (
184:     Store.msgWin ||
185:     Store.minimapEnabled ||
186:     quests.anyWindowOpen ||
187:     Economy.prompt ||
188:     Social.anyRequest ||
189:     Messenger.friendRequest
190:   ) {
191:     return false;
192:   }
193: 
194:   runInAction(() => {
195:     Store.optionsEnabled = true;
196:   });
197:   return true;
198: }
</file>

<file path="src/common/sessionNonce.ts">
 1: /**
 2:  * One nonce per page load: what ties this browser's game socket to its cash
 3:  * shop requests.
 4:  *
 5:  * The shop is a separate service that never sees a password. Its only proof
 6:  * that a request comes from a player who is logged in is that the same random
 7:  * value went out on the game socket's URL (`createSocket`, `&session=`) and
 8:  * later arrives in `POST /api/session`: the proxy reads the login name off
 9:  * that socket and answers `/ticket/<nonce>` with it on loopback
10:  * (proxy/presence.ts), and the shop signs the answer into a ticket. Whoever
11:  * knows the nonce can therefore act as the account in the shop, which is why
12:  * it is 128 bits from `crypto.getRandomValues`, chosen here and nowhere else,
13:  * and never written to a log or the address bar.
14:  *
15:  * Drawn on first use rather than at module load: the first caller is
16:  * `createSocket`, long after the page is up, and a module-scope draw would
17:  * also run in every test that imports a neighbour.
18:  */
19: 
20: /** 32 lowercase hex characters. The proxy binds nothing that is not this. */
21: export const SESSION_NONCE_RE = /^[0-9a-f]{32}$/;
22: 
23: let nonce: string | null = null;
24: 
25: export function sessionNonce(): string {
26:   if (nonce === null) {
27:     const bytes = crypto.getRandomValues(new Uint8Array(16));
28:     nonce = Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('');
29:   }
30:   return nonce;
31: }
</file>

<file path="src/common/sessionResume.ts">
  1: import { makeAutoObservable, runInAction } from 'mobx';
  2: import { t } from '../i18n';
  3: import { Store } from '../store';
  4: import { GameOptions } from './gameOptions';
  5: 
  6: /**
  7:  * Getting back in after the connection drops.
  8:  *
  9:  * A browser client loses its socket for reasons a desktop one never sees: a
 10:  * sleeping tab, a lid closing, a proxy restart, a phone changing network.
 11:  * The old path for all of them was the same as a kick - back to the server
 12:  * list, log in again, pick the character again.
 13:  *
 14:  * This walks that flow on its own instead: dial the game server we were on,
 15:  * send the same login the form would send, then select the character we were
 16:  * playing. Nothing new goes on the wire; the packets are the ones the login
 17:  * screens already send, in the same order. Credentials are the ones already
 18:  * in the store for the session - nothing extra is written to disk.
 19:  *
 20:  * Guard rails: only after a socket we did not close ourselves went away,
 21:  * only while a character was actually in the world, a handful of attempts
 22:  * with a growing gap, and a Cancel that drops back to the server list.
 23:  */
 24: 
 25: /** Gap before each attempt, in ms; the last one repeats if needed. */
 26: const BACKOFF = [1000, 2000, 4000, 8000, 15000];
 27: 
 28: const MAX_ATTEMPTS = BACKOFF.length;
 29: 
 30: type Step = 'idle' | 'connecting' | 'logging-in' | 'selecting';
 31: 
 32: export const SessionResume = new (class _SessionResume {
 33:   /** 0 while idle; the attempt being made otherwise. */
 34:   attempt = 0;
 35:   step: Step = 'idle';
 36: 
 37:   private character = '';
 38:   private timer: ReturnType<typeof setTimeout> | null = null;
 39: 
 40:   constructor() {
 41:     makeAutoObservable<this, 'character' | 'timer'>(this, {
 42:       character: false,
 43:       timer: false,
 44:     });
 45:   }
 46: 
 47:   get active(): boolean {
 48:     return this.step !== 'idle';
 49:   }
 50: 
 51:   /** Whether a lost socket is worth resuming, rather than starting over. */
 52:   private get resumable(): boolean {
 53:     if (!GameOptions.autoReconnect) return false;
 54:     if (Store.isOffline) return false;
 55:     if (!Store.username || !Store.password) return false;
 56:     if (!Store.lastGameServer) return false;
 57:     // Only a character that was in the world: anything earlier is a screen
 58:     // the player is already looking at, and can act on themselves.
 59:     return !!this.character;
 60:   }
 61: 
 62:   /** The character is in the world: this is what a resume aims back at. */
 63:   remember(character: string): void {
 64:     this.character = character;
 65:   }
 66: 
 67:   /** Nothing to come back to (logged out, kicked, character screen). */
 68:   forget(): void {
 69:     this.character = '';
 70:     this.stop();
 71:   }
 72: 
 73:   /**
 74:    * A game-server socket went away on its own. Returns true when a resume
 75:    * took over, so the caller leaves the player where they are.
 76:    */
 77:   begin(): boolean {
 78:     if (!this.resumable) return false;
 79:     if (this.attempt >= MAX_ATTEMPTS) return false;
 80: 
 81:     this.schedule();
 82:     return true;
 83:   }
 84: 
 85:   /** The Cancel button, and anything that makes a resume pointless. */
 86:   stop(): void {
 87:     if (this.timer) clearTimeout(this.timer);
 88:     this.timer = null;
 89:     runInAction(() => {
 90:       this.attempt = 0;
 91:       this.step = 'idle';
 92:     });
 93:   }
 94: 
 95:   /** Cancel plus the ordinary "start over at the server list" path. */
 96:   giveUp(reason: 'cancelled' | 'failed'): void {
 97:     this.stop();
 98:     Store.addNotification(
 99:       t(reason === 'cancelled' ? 'resume.cancelled' : 'resume.failed'),
100:       'error'
101:     );
102:     Store.disconnectFromGameServer();
103:     Store.playOnline();
104:   }
105: 
106:   private schedule(): void {
107:     const wait = BACKOFF[Math.min(this.attempt, BACKOFF.length - 1)];
108: 
109:     runInAction(() => {
110:       this.attempt++;
111:       this.step = 'connecting';
112:     });
113: 
114:     if (this.timer) clearTimeout(this.timer);
115:     this.timer = setTimeout(() => {
116:       this.timer = null;
117:       const server = Store.lastGameServer;
118:       if (!server) {
119:         this.giveUp('failed');
120:         return;
121:       }
122:       Store.connectToGameServer(server.host, server.port, server.fallbackHost);
123:     }, wait);
124:   }
125: 
126:   /**
127:    * `GameServerEntered` arrived while resuming: send the login instead of
128:    * showing the form. Returns true when it did.
129:    */
130:   onGameServerEntered(): boolean {
131:     if (this.step !== 'connecting') return false;
132:     runInAction(() => {
133:       this.step = 'logging-in';
134:     });
135:     Store.loginRequest(Store.username, Store.password);
136:     return true;
137:   }
138: 
139:   /** The login was accepted: pick the character back up. */
140:   onLoginOk(): boolean {
141:     if (this.step !== 'logging-in') return false;
142:     runInAction(() => {
143:       this.step = 'selecting';
144:     });
145:     Store.disconnectFromConnectServer();
146:     Store.selectCharacterRequest(this.character);
147:     return true;
148:   }
149: 
150:   /**
151:    * The login was refused (wrong password after a server restart, the old
152:    * session still online). The player has to take over.
153:    */
154:   onLoginFailed(): boolean {
155:     if (this.step !== 'logging-in') return false;
156:     this.stop();
157:     return false;
158:   }
159: 
160:   /** The character is back in the world. */
161:   finish(): void {
162:     if (!this.active) return;
163:     this.stop();
164:     Store.addNotification(t('resume.done'));
165:   }
166: 
167:   /**
168:    * A resume attempt's own socket died. Try again until the attempts run
169:    * out; returns true while it is still trying.
170:    */
171:   retry(): boolean {
172:     if (!this.active) return false;
173:     if (this.attempt >= MAX_ATTEMPTS) {
174:       this.giveUp('failed');
175:       return true;
176:     }
177:     this.schedule();
178:     return true;
179:   }
180: 
181: })();
</file>

<file path="src/common/sessionStats.ts">
  1: import { makeAutoObservable, reaction, runInAction } from 'mobx';
  2: import { EventBus } from '../libs/eventBus';
  3: import { Store } from '../store';
  4: 
  5: /**
  6:  * What this sitting has been worth: experience, kills and zen since the
  7:  * counter was last reset, and the rates they imply.
  8:  *
  9:  * Everything here is derived from packets the client already handles -
 10:  * `ExperienceGained` for the exp and the killing blow, the money field for
 11:  * the zen - so it costs one event listener and one reaction. The clock only
 12:  * runs while the tracker is on screen (`tick`), so a closed panel is idle.
 13:  */
 14: 
 15: const MS_PER_HOUR = 3_600_000;
 16: 
 17: export const SessionStats = new (class _SessionStats {
 18:   /** Wall clock of the last reset. */
 19:   startedAt = Date.now();
 20:   /** Re-read once a second by the panel, so the elapsed line moves. */
 21:   now = Date.now();
 22: 
 23:   experience = 0;
 24:   kills = 0;
 25:   zen = 0;
 26: 
 27:   private money = 0;
 28:   private watching = false;
 29: 
 30:   constructor() {
 31:     makeAutoObservable(this);
 32:   }
 33: 
 34:   get elapsedMs(): number {
 35:     return Math.max(0, this.now - this.startedAt);
 36:   }
 37: 
 38:   private perHour(total: number): number {
 39:     const ms = this.elapsedMs;
 40:     // Under a minute the rates swing wildly; the panel prints a dash.
 41:     return ms < 60_000 ? 0 : (total * MS_PER_HOUR) / ms;
 42:   }
 43: 
 44:   get experiencePerHour(): number {
 45:     return this.perHour(this.experience);
 46:   }
 47: 
 48:   get killsPerHour(): number {
 49:     return this.perHour(this.kills);
 50:   }
 51: 
 52:   get zenPerHour(): number {
 53:     return this.perHour(this.zen);
 54:   }
 55: 
 56:   /**
 57:    * Milliseconds to the next level at the running rate, or null when there
 58:    * is nothing to go on yet (no rate, or the bar is already full).
 59:    */
 60:   get msToLevel(): number | null {
 61:     const rate = this.experiencePerHour;
 62:     if (rate <= 0) return null;
 63: 
 64:     const { exp, expToNextLvl } = Store.playerData;
 65:     const remaining = expToNextLvl - exp;
 66:     if (remaining <= 0) return null;
 67: 
 68:     return (remaining / rate) * MS_PER_HOUR;
 69:   }
 70: 
 71:   reset(): void {
 72:     runInAction(() => {
 73:       this.startedAt = Date.now();
 74:       this.now = this.startedAt;
 75:       this.experience = 0;
 76:       this.kills = 0;
 77:       this.zen = 0;
 78:       this.money = Store.playerData.money;
 79:     });
 80:   }
 81: 
 82:   /** Called once a second while the panel is open. */
 83:   tick(): void {
 84:     runInAction(() => {
 85:       this.now = Date.now();
 86:     });
 87:   }
 88: 
 89:   /**
 90:    * Start counting. Idempotent, and called from the panel rather than at
 91:    * import time so a client that never opens it never listens.
 92:    */
 93:   watch(): void {
 94:     if (this.watching) return;
 95:     this.watching = true;
 96:     this.money = Store.playerData.money;
 97: 
 98:     EventBus.on('experienceGained', ({ added, killedNetId }) => {
 99:       runInAction(() => {
100:         this.experience += added;
101:         // The killing blow is the client's own (`quests/killCounters.ts`
102:         // reads the same field); a share from a party mate carries none.
103:         if (killedNetId) this.kills++;
104:       });
105:     });
106: 
107:     // Zen has no packet of its own - every source writes the same field -
108:     // so income is the rises of it. Spending is not counted: this is a
109:     // "what did the hunt bring in" line, not a balance sheet.
110:     reaction(
111:       () => Store.playerData.money,
112:       money => {
113:         const gained = money - this.money;
114:         this.money = money;
115:         if (gained > 0) runInAction(() => (this.zen += gained));
116:       }
117:     );
118: 
119:     // A different character is a different session.
120:     reaction(
121:       () => Store.playerData.name,
122:       () => this.reset()
123:     );
124:   }
125: })();
</file>

<file path="src/common/skillCasting.ts">
  1: import { PlayerAction } from './objects/enum';
  2: import {
  3:   chooseAttackAction,
  4:   chooseHighBowAttackAction,
  5:   type AttackPose,
  6: } from './weaponClass';
  7: import type { SkillDefinition } from './skillsDatabase';
  8: import { magicClip, skillClip, type CastContext } from '../combat/skillClips';
  9: import { castsOnSelf } from '../combat/castTargets';
 10: 
 11: /**
 12:  * Client-side casting rules. The wire format is decided by the OpenMU skill
 13:  * type: area skills go out as AreaSkill (0x1E, the original's
 14:  * SendRequestMagicContinue), everything else as TargetedSkill (0x19,
 15:  * SendRequestMagic) - ZzzInterface.cpp:2325-2470.
 16:  */
 17: 
 18: /**
 19:  * Teleport / Teleport Ally are neither targeted nor area casts on the wire:
 20:  * OpenMU's `WizardTeleportAction` answers `EnterGateRequest` (C3 1C, gate 0,
 21:  * the target square - the original's SendRequestTeleport) and
 22:  * `TeleportTarget` (C3 B0, party member + square); it replies with a
 23:  * same-map `MapChanged` that moves the hero, or one at the old square when
 24:  * refused.
 25:  */
 26: export const TELEPORT = 6;
 27: export const TELEPORT_ALLY = 15;
 28: 
 29: /** `AT_SKILL_DEEPIMPACT`: the aimed-up bow shot, OpenMU's Starfall. */
 30: const STARFALL = 46;
 31: 
 32: export function isTeleportSkill(num: number): boolean {
 33:   return num === TELEPORT || num === TELEPORT_ALLY;
 34: }
 35: 
 36: export function isAreaSkill(def: SkillDefinition): boolean {
 37:   return (
 38:     def.type === 'AreaSkillAutomaticHits' ||
 39:     def.type === 'AreaSkillExplicitTarget'
 40:   );
 41: }
 42: 
 43: /**
 44:  * Whether a cast with nothing suitable selected lands on the hero. The rule
 45:  * itself - self-only versus party-member-or-self versus hostile - is
 46:  * `combat/castTargets`; this stays exported because the hotbar and the skill
 47:  * list ask the same question.
 48:  */
 49: export function isSelfCastable(def: SkillDefinition): boolean {
 50:   return castsOnSelf(def);
 51: }
 52: 
 53: export function isSpell(def: SkillDefinition): boolean {
 54:   return (
 55:     def.damageType === 'Wizardry' ||
 56:     def.damageType === 'Curse' ||
 57:     (def.damageType === 'None' && def.type !== 'DirectHit')
 58:   );
 59: }
 60: 
 61: /**
 62:  * The clip a cast plays, for the hero and for everyone else in scope alike.
 63:  * Four tiers, in the order the original tries them:
 64:  *
 65:  *  1. Starfall, the one skill that shoots through `SetPlayerHighBowAttack`
 66:  *     instead (`AT_SKILL_DEEPIMPACT`, ZzzInterface.cpp:2523-2527),
 67:  *  2. the per-skill clip (`combat/skillClips` - every `UseSkill*` /
 68:  *     `Attack*` / `ReceiveMagic` case, with its mount and map branches),
 69:  *  3. `SetPlayerMagic` for a spell (ZzzCharacter.cpp:1238-1262) - the
 70:  *     female hand-raise, the male HAND1/HAND2 coin toss, or the mount's own
 71:  *     cast clip,
 72:  *  4. the weapon swing, for a physical skill with no clip of its own.
 73:  */
 74: export function chooseSkillAction(
 75:   def: SkillDefinition,
 76:   pose: AttackPose,
 77:   ctx: CastContext = {}
 78: ): PlayerAction {
 79:   if (def.num === STARFALL) return chooseHighBowAttackAction(pose);
 80:   const dedicated = skillClip(def.num, ctx);
 81:   if (dedicated !== null) return dedicated;
 82:   if (isSpell(def)) return magicClip(ctx);
 83:   return chooseAttackAction(pose);
 84: }
 85: 
 86: /** AreaSkill.Rotation: (BYTE)(Angle / 360 * 256) of the hero's yaw. */
 87: export function rotationByte256(rotYRadians: number): number {
 88:   let deg = ((rotYRadians * 180) / Math.PI) % 360;
 89:   if (deg < 0) deg += 360;
 90:   return Math.round((deg / 360) * 256) & 0xff;
 91: }
 92: 
 93: // ---- skill icons -------------------------------------------------------
 94: 
 95: /**
 96:  * `CNewUISkillList::RenderSkillIcon` (NewUIMainFrameWindow.cpp:2087) draws
 97:  * every icon as a 20 x 28 cell of a 256 x 256 sheet - never 32 x 32, which is
 98:  * why the icons used to come out as quarters of four neighbours.
 99:  */
100: export const SKILL_ICON_WIDTH = 20;
101: export const SKILL_ICON_HEIGHT = 28;
102: 
103: /** `AT_SKILL_SPIRAL_SLASH`: the first skill of the second sheet. */
104: const SPIRAL_SLASH = 57;
105: /** `AT_SKILL_KILLING_BLOW`: the first skill of the Rage Fighter sheet. */
106: const KILLING_BLOW = 260;
107: /** `AT_SKILL_MASTER_BEGIN`: the master tree draws off its own 512 sheet. */
108: export const MASTER_SKILL_FIRST = 300;
109: /** `AT_SKILL_STUN` .. `AT_SKILL_REMOVAL_BUFF`: castle-siege commands. */
110: const SIEGE_FIRST = 67;
111: const SIEGE_LAST = 72;
112: /** `AT_SKILL_PLASMA_STORM_FENRIR`: the only skill on the command sheet. */
113: const PLASMA_STORM = 76;
114: 
115: /** Sheet, and the greyed copy the original swaps in for `bCantSkill`. */
116: const SHEETS = {
117:   skill1: ['newui_skill.OZJ', 'newui_non_skill.OZJ'],
118:   skill2: ['newui_skill2.OZJ', 'newui_non_skill2.OZJ'],
119:   skill3: ['newui_skill3.OZJ', 'newui_non_skill3.OZJ'],
120:   command: ['newui_command.OZJ', 'newui_non_command.OZJ'],
121: } as const;
122: 
123: /**
124:  * Sheet-2 cells the row maths cannot reach. The eight columns the generic
125:  * rule walks were full long before Season 6, so every skill added after them
126:  * has its column and row written out in `RenderSkillIcon` - this table
127:  * is that `else if` chain, `[column, row]`.
128:  */
129: const SHEET2_CELLS: Record<number, readonly [number, number]> = {
130:   214: [0, 3], // Drain Life
131:   215: [1, 3], // Chain Lightning
132:   216: [2, 3], // (Sudden Ice)
133:   217: [3, 3], // Damage Reflection
134:   219: [4, 3], // Sleep
135:   220: [5, 3], // (Blind)
136:   223: [6, 3], // Explosion
137:   224: [7, 3], // Requiem
138:   221: [8, 3], // Weakness
139:   222: [9, 3], // Innovation
140:   218: [10, 3], // Berserker
141:   225: [11, 3], // Pollution
142:   230: [2, 3], // Lightning Shock
143:   232: [7, 2], // Strike of Destruction
144:   233: [8, 2], // Expansion of Wizardry
145:   234: [9, 2], // Recovery
146:   235: [0, 8], // Multi-Shot
147:   236: [1, 8], // Flame Strike
148:   237: [2, 8], // Gigantic Storm
149:   238: [3, 8], // Chaotic Diseier
150: };
151: 
152: function cell(file: string, column: number, row: number) {
153:   return { file, x: column * SKILL_ICON_WIDTH, y: row * SKILL_ICON_HEIGHT };
154: }
155: 
156: /**
157:  * Where a skill's icon sits, and on which sheet. `disabled` is
158:  * `bCantSkill`: the original adds 6 to the texture id, which is the
159:  * `newui_non_*` copy of the same sheet - both are shipped, so the icon
160:  * is the real greyed art rather than a CSS filter.
161:  *
162:  * Master-tree skills return `null`: their cell comes from `Skill.bmd`
163:  * (`Magic_Icon`) on a sheet of its own, which `skills/masterTree` owns.
164:  */
165: export function skillIconCell(
166:   num: number,
167:   disabled = false
168: ): { file: string; x: number; y: number } | null {
169:   if (num <= 0 || num >= MASTER_SKILL_FIRST) return null;
170:   const i = disabled ? 1 : 0;
171:   if (num === PLASMA_STORM) return cell(SHEETS.command[i], 4, 0);
172:   const special = SHEET2_CELLS[num];
173:   if (special) return cell(SHEETS.skill2[i], special[0], special[1]);
174:   if (num >= KILLING_BLOW) {
175:     const n = num - KILLING_BLOW;
176:     return cell(SHEETS.skill3[i], n % 12, Math.floor(n / 12));
177:   }
178:   if (num >= SPIRAL_SLASH) {
179:     const n = num - SPIRAL_SLASH;
180:     return cell(SHEETS.skill2[i], n % 8, Math.floor(n / 8));
181:   }
182:   return cell(SHEETS.skill1[i], (num - 1) % 8, Math.floor((num - 1) / 8));
183: }
184: 
185: /**
186:  * `CNewUISkillList::Render`'s filter on the learned-skill fan: the castle
187:  * siege commands and every master-tree entry are learned skills the hero can
188:  * never put on a bar slot, so they are kept out of the fan and out of the
189:  * default hot-key layout.
190:  */
191: export function isHotbarSkill(num: number): boolean {
192:   if (num < 1 || num >= MASTER_SKILL_FIRST) return false;
193:   return num < SIEGE_FIRST || num > SIEGE_LAST;
194: }
</file>

<file path="src/common/skillItems.ts">
  1: import type { Item } from '../ecs/world';
  2: import { classCanUse, type HeroStats, type ItemStats } from './itemStats';
  3: import { skillDisplayName } from './skillNames';
  4: import { t } from '../i18n';
  5: 
  6: /**
  7:  * Learning skills from orbs, scrolls and crystals: right-click the item in
  8:  * the inventory (`CNewUIMyInventory::UseItem`, NewUIMyInventory.cpp:1865).
  9:  * Pure rules only - the packet (0x26 ConsumeItemRequest, ItemSlot = the
 10:  * orb / scroll) is sent by `Store.learnSkillItem`, the answer (`SkillAdded`
 11:  * F3 11 / `ItemConsumptionFailed`) lands in logic.ts.
 12:  *
 13:  * Server truth (OpenMU `LearnablesConsumeHandlerPlugIn`): the item's
 14:  * definition names the skill, the hero's class must be on the item's class
 15:  * list, the item's requirements must be met and the skill must not be
 16:  * known yet. Item.txt carries no skill column for these rows, so the table
 17:  * below maps item -> skill number the way OpenMU's `Orbs.cs` / `Scrolls.cs`
 18:  * seed it; the original enum names (_enum.h:2613-2853) are kept beside each
 19:  * row for cross-checking.
 20:  */
 21: 
 22: /** Orbs / crystals / Dark Lord scrolls share the wing group. */
 23: export const ORB_GROUP = 12;
 24: /** Wizard and Summoner scrolls (`ITEM_SCROLL_OF_POISON` = ITEM_ETC + 0). */
 25: export const SCROLL_GROUP = 15;
 26: 
 27: /**
 28:  * `ITEM_ORB_OF_SUMMONING` teaches Summon Goblin .. Summon Soldier by item
 29:  * level (ZzzInventory.cpp:1754: `SkillAttribute[30 + iLevel]`).
 30:  */
 31: const ORB_OF_SUMMONING = 11;
 32: const SUMMON_FIRST_SKILL = 30;
 33: const SUMMON_LAST_SKILL = 36;
 34: 
 35: /** Group 12 index -> skill number. */
 36: const ORB_SKILLS: Readonly<Record<number, number>> = {
 37:   7: 41, // ITEM_ORB_OF_TWISTING_SLASH
 38:   8: 26, // ITEM_ORB_OF_HEALING
 39:   9: 27, // ITEM_ORB_OF_GREATER_DEFENSE
 40:   10: 28, // ITEM_ORB_OF_GREATER_DAMAGE
 41:   12: 42, // ITEM_ORB_OF_RAGEFUL_BLOW
 42:   13: 47, // ITEM_ORB_OF_IMPALE
 43:   14: 48, // ITEM_ORB_OF_GREATER_FORTITUDE -> Swell Life
 44:   16: 55, // ITEM_ORB_OF_FIRE_SLASH
 45:   17: 52, // ITEM_ORB_OF_PENETRATION
 46:   18: 51, // ITEM_ORB_OF_ICE_ARROW
 47:   19: 43, // ITEM_ORB_OF_DEATH_STAB
 48:   21: 61, // ITEM_SCROLL_OF_FIREBURST
 49:   22: 63, // ITEM_SCROLL_OF_SUMMON
 50:   23: 64, // ITEM_SCROLL_OF_CRITICAL_DAMAGE
 51:   24: 65, // ITEM_SCROLL_OF_ELECTRIC_SPARK
 52:   35: 78, // ITEM_SCROLL_OF_FIRE_SCREAM
 53:   44: 232, // ITEM_CRYSTAL_OF_DESTRUCTION -> Strike of Destruction
 54:   45: 235, // ITEM_CRYSTAL_OF_MULTI_SHOT
 55:   46: 234, // ITEM_CRYSTAL_OF_RECOVERY
 56:   47: 236, // ITEM_CRYSTAL_OF_FLAME_STRIKE
 57:   48: 238, // ITEM_SCROLL_OF_CHAOTIC_DISEIER
 58: };
 59: 
 60: /** Group 15 index -> skill number. */
 61: const SCROLL_SKILLS: Readonly<Record<number, number>> = {
 62:   0: 1, // ITEM_SCROLL_OF_POISON
 63:   1: 2, // ITEM_SCROLL_OF_METEORITE
 64:   2: 3, // ITEM_SCROLL_OF_LIGHTING
 65:   3: 4, // ITEM_SCROLL_OF_FIRE_BALL
 66:   4: 5, // ITEM_SCROLL_OF_FLAME
 67:   5: 6, // ITEM_SCROLL_OF_TELEPORT
 68:   6: 7, // ITEM_SCROLL_OF_ICE
 69:   7: 8, // ITEM_SCROLL_OF_TWISTER
 70:   8: 9, // ITEM_SCROLL_OF_EVIL_SPIRIT
 71:   9: 10, // ITEM_SCROLL_OF_HELLFIRE
 72:   10: 11, // ITEM_SCROLL_OF_POWER_WAVE
 73:   11: 12, // ITEM_SCROLL_OF_AQUA_BEAM
 74:   12: 13, // ITEM_SCROLL_OF_COMETFALL
 75:   13: 14, // ITEM_SCROLL_OF_INFERNO
 76:   14: 15, // ITEM_SCROLL_OF_TELEPORT_ALLY
 77:   15: 16, // ITEM_SCROLL_OF_SOUL_BARRIER
 78:   16: 38, // ITEM_SCROLL_OF_DECAY
 79:   17: 39, // ITEM_SCROLL_OF_ICE_STORM
 80:   18: 40, // ITEM_SCROLL_OF_NOVA
 81:   // OpenMU's Scrolls.cs seeds 19 as the Chain Lightning Parchment and 20 as
 82:   // the Drain Life Parchment (the original's ITEM_CHAIN_LIGHTNING_PARCHMENT
 83:   // = ITEM_ETC + 19 / ITEM_DRAIN_LIFE_PARCHMENT = ITEM_ETC + 20). The two
 84:   // rows used to be swapped here, so the Chain Lightning scroll's tooltip
 85:   // promised Drain Life and the requirement check read the wrong skill.
 86:   19: 215, // ITEM_CHAIN_LIGHTNING_PARCHMENT
 87:   20: 214, // ITEM_DRAIN_LIFE_PARCHMENT
 88:   21: 230, // ITEM_LIGHTNING_SHOCK_PARCHMENT ("Electric Surge")
 89:   22: 217, // ITEM_DAMAGE_REFLECTION_PARCHMENT ("Reflex")
 90:   23: 218, // ITEM_BERSERKER_PARCHMENT ("Sword Power")
 91:   24: 219, // ITEM_SLEEP_PARCHMENT
 92:   // 25 is unused in the original enum and in Scrolls.cs.
 93:   26: 221, // ITEM_WEAKNESS_PARCHMENT
 94:   27: 222, // ITEM_INNOVATION_PARCHMENT
 95:   28: 233, // ITEM_SCROLL_OF_WIZARDRY_ENHANCE -> Expansion of Wizardry
 96:   29: 237, // ITEM_SCROLL_OF_GIGANTIC_STORM
 97: };
 98: 
 99: /**
100:  * The skill number `group`/`index` at item level `level` teaches, or
101:  * undefined for anything that is not a learnable.
102:  */
103: export function learnableSkillNumber(
104:   group: number,
105:   index: number,
106:   level = 0
107: ): number | undefined {
108:   if (group === ORB_GROUP) {
109:     if (index === ORB_OF_SUMMONING) {
110:       const skill = SUMMON_FIRST_SKILL + Math.max(0, level);
111:       return skill <= SUMMON_LAST_SKILL ? skill : undefined;
112:     }
113:     return ORB_SKILLS[index];
114:   }
115:   if (group === SCROLL_GROUP) return SCROLL_SKILLS[index];
116:   return undefined;
117: }
118: 
119: /** The skill number `item` teaches, or undefined when it teaches none. */
120: export function learnableSkill(item: Item): number | undefined {
121:   return learnableSkillNumber(item.group, item.num, item.lvl ?? 0);
122: }
123: 
124: /** True for every orb / scroll / crystal that teaches a skill. */
125: export function isSkillItem(item: Item): boolean {
126:   return learnableSkill(item) !== undefined;
127: }
128: 
129: /**
130:  * Why `hero` cannot learn from `item` right now, or null when the use may
131:  * go to the server. `stats` are the item's effective requirements
132:  * (`itemStats(item)`, which already folds the skill's own level / energy
133:  * in); `known` are the skill numbers on the hero's list.
134:  *
135:  * The original checks level, energy and strength in silence
136:  * (NewUIMyInventory.cpp:1899) and leaves class and "already learned" to the
137:  * server's refusal; every reason is spelled out here instead, in the order
138:  * the tooltip lists the requirements.
139:  */
140: export function learnSkillError(
141:   item: Item,
142:   stats: ItemStats,
143:   hero: HeroStats,
144:   known: readonly number[]
145: ): string | null {
146:   const number = learnableSkill(item);
147:   if (number === undefined) return t('skills.teachesNothing');
148: 
149:   const name = skillDisplayName(number) ?? t('skills.thisSkill');
150: 
151:   if (!classCanUse(stats.def, hero)) {
152:     return t('skills.classCannotLearn', { name });
153:   }
154:   if (known.includes(number)) return t('skills.alreadyKnown', { name });
155: 
156:   const short = (label: string, required: number, have: number) =>
157:     t('skills.needMore', { label, required, name, more: required - have });
158: 
159:   if (hero.level < stats.reqLvl) return short('Level', stats.reqLvl, hero.level);
160:   if (hero.str < stats.reqStr) return short('Strength', stats.reqStr, hero.str);
161:   if (hero.agi < stats.reqAgi) return short('Agility', stats.reqAgi, hero.agi);
162:   if (hero.vit < stats.reqVit) return short('Vitality', stats.reqVit, hero.vit);
163:   if (hero.ene < stats.reqEne) return short('Energy', stats.reqEne, hero.ene);
164:   if (hero.cmd < stats.reqCmd) return short('Command', stats.reqCmd, hero.cmd);
165: 
166:   return null;
167: }
</file>

