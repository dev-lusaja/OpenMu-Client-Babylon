 51: let measureContext: CanvasRenderingContext2D | null | undefined;
 52: 
 53: /** `GetTextExtentPoint32` with `g_hFontBold`, in 640×480 pixels. */
 54: function measureNoticeWidth(text: string): number {
 55:   if (measureContext === undefined) {
 56:     measureContext = document.createElement('canvas').getContext('2d');
 57:   }
 58:   if (!measureContext) return text.length * 6;
 59:   measureContext.font = '600 11px Tahoma, Verdana, sans-serif';
