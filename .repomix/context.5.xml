 14:   MAX_BULK_BUY,
 15:   type BuyStop,
 16: } from './quickItemRules';
 17: import type { Item } from '../ecs/world';
 18: 
 19: /**
 20:  * Ctrl-click transfers, the shop's bulk buy, and the yes/no before a valuable
 21:  * item leaves for good.
 22:  *
 23:  * One writer: a grid reports which square was Ctrl-clicked and decides
 24:  * nothing. Where the item goes is worked out in `quickItemRules.ts` from the
 25:  * windows that are open, and it travels by the requests a drag or a shop
 26:  * click already sends (`autoMoveItem`, `sellPickedItemToNpc`,
 27:  * `buyItemFromNpc`), through the one-move-in-flight guard
 28:  * `Store.pendingItemMove`. Nothing new goes on the wire.
 29:  */
 30: 
 31: export const QuickItemActions = new (class _QuickItemActions {
 32:   private run: { slot: number; wanted: number; bought: number } | null = null;
 33:   private disposers: (() => void)[] = [];
 34: 
 35:   get buying(): boolean {
 36:     return this.run !== null;
 37:   }
 38: 
 39:   // --- Ctrl-click transfers ------------------------------------------------
 40: 
 41:   /** Ctrl-click on an inventory square. */
 42:   fromInventory(slot: number): void {
 43:     if (!GameOptions.quickItemActions) return;
 44:     if (Store.pickedItem || Store.pendingItemMove) return;
 45: 
 46:     const item = Store.playerData.items[slot];
 47:     if (!item) return;
 48: 
 49:     const target = inventoryTarget({
 50:       storage: Economy.autoMoveTarget,
 51:       shop: !!Store.npcShop,
 52:     });
 53:     if (!target) return;
 54: 
 55:     if (target.kind === 'move') {
 56:       Store.autoMoveItem(StorageKind.Inventory, slot, target.to);
 57:       return;
 58:     }
 59: 
 60:     this.confirm(item, MsgWinCode.ConfirmSellItem, () => this.sellSlot(slot));
 61:   }
 62: 
 63:   /** Ctrl-click in the vault, the trade grid or the mix tray: send it back. */
 64:   toInventory(storage: StorageKind, slot: number): void {
 65:     if (!GameOptions.quickItemActions) return;
 66: 
 67:     Store.autoMoveItem(storage, slot, StorageKind.Inventory);
 68:   }
 69: 
 70:   // --- selling and dropping ------------------------------------------------
 71: 
 72:   /** The carried item let go over the merchant's grid. */
 73:   sellPickedItem(): void {
 74:     const item = Store.pickedItem?.item;
 75:     if (!item) return;
 76: 
 77:     this.confirm(item, MsgWinCode.ConfirmSellItem, () =>
 78:       Store.sellPickedItemToNpc()
 79:     );
 80:   }
 81: 
 82:   /** The carried item let go over the ground (`itemPickupSystem`). */
 83:   dropPickedItem(x: number, y: number): void {
 84:     const item = Store.pickedItem?.item;
 85:     if (!item) return;
 86: 
 87:     this.confirm(item, MsgWinCode.ConfirmDropItem, () =>
 88:       Store.dropPickedItem(x, y)
 89:     );
 90:   }
 91: 
 92:   private sellSlot(slot: number): void {
 93:     if (!Store.npcShop || Store.pickedItem || Store.pendingItemMove) return;
 94: 
 95:     Store.pickInventoryItem(slot);
 96:     if (!Store.pickedItem) return;
 97: 
 98:     Store.sellPickedItemToNpc();
 99: 
100:     // A refusal leaves the item hanging off the cursor: put it back.
101:     if (Store.pickedItem && !Store.pendingItemMove) Store.cancelPickedItem();
102:   }
103: 
104:   private confirm(item: Item, code: MsgWinCode, go: () => void): void {
105:     if (!GameOptions.confirmValuableItems || !isValuableItem(item)) {
106:       go();
107:       return;
108:     }
109: 
110:     Store.popUpMsgWin(code, itemDisplayName(item), go);
111:   }
112: 
113:   // --- bulk buy ------------------------------------------------------------
114: 
115:   /** Ctrl-click on a shop entry: ask how many. */
116:   promptBuy(slot: number): void {
117:     if (!GameOptions.quickItemActions) return;
118:     if (!Store.npcShop?.items[slot]) return;
119: 
120:     Economy.openPrompt({ kind: 'npc-buy-many', slot });
121:   }
122: 
123:   /** The answered quantity: buy that many, one purchase in flight. */
124:   startBuyRun(slot: number, count: number): void {
125:     this.cancel();
126: 
127:     if (!Store.npcShop?.items[slot]) return;
128: 
129:     const wanted = Math.max(1, Math.min(MAX_BULK_BUY, Math.trunc(count) || 0));
130:     this.run = { slot, wanted, bought: 0 };
131: 
132:     this.disposers.push(
133:       reaction(
134:         () => Store.shopBuyPending || !!Store.pendingItemMove,
135:         busy => {
136:           if (!busy) this.step();
137:         }
138:       ),
139:       // The player picking something up takes the shop over: the run stops,
140:       // exactly as the arrange and bulk-move runs do.
141:       reaction(
142:         () => !!Store.pickedItem,
143:         picked => {
144:           if (picked) this.cancel();
145:         }
146:       )
147:     );
148: 
149:     this.step();
150:   }
151: 
152:   cancel(): void {
153:     for (const dispose of this.disposers) dispose();
154:     this.disposers = [];
155:     this.run = null;
156:   }
157: 
158:   private step(): void {
159:     const run = this.run;
160:     if (!run) return;
161:     if (Store.shopBuyPending || Store.pendingItemMove) return;
162:     if (Store.pickedItem) {
163:       this.cancel();
164:       return;
165:     }
166: 
167:     const item = Store.npcShop?.items[run.slot] ?? null;
168: 
169:     const stop = buyRunStop({
170:       bought: run.bought,
171:       wanted: run.wanted,
172:       item,
173:       price: item ? itemValue(item, 0) : 0,
174:       money: Store.playerData.money,
175:       freeSquare: item ? Store.findFreeSquare(StorageKind.Inventory, item) : -1,
176:       refused: Store.shopBuyRefused,
177:     });
178: 
179:     if (stop) {
180:       this.finish(stop, run.bought);
181:       return;
182:     }
183: 
184:     run.bought++;
185:     Store.buyItemFromNpc(run.slot);
186: 
187:     // Offline there is no answer to wait for, so the loop runs itself.
188:     if (Store.isOffline) this.step();
189:   }
190: 
191:   private finish(stop: BuyStop, bought: number): void {
192:     this.cancel();
193: 
194:     if (bought > 0) {
195:       Store.addNotification(t('notify.itemsBought', { count: bought }));
196:     }
197: 
198:     if (stop === 'noRoom') {
199:       Store.addNotification(t('notify.noInventoryRoom'), 'error');
200:     } else if (stop === 'noZen') {
201:       Store.addNotification(t('common.notEnoughZen'), 'error');
202:     }
203:   }
204: })();
</file>

