<file path="src/common/rateLimit.ts">
  1: /**
  2:  * Who is knocking, and how often: the burst limit the loopback services share.
  3:  *
  4:  * `register/server/main.ts` and `cashshop/server/main.ts` both listen on
  5:  * loopback behind Caddy and both need "this network, so many attempts per
  6:  * window". The part that matters is `clientIp`: it decides whether a
  7:  * forwarded header can be believed, and a limit is only as good as that
  8:  * decision. It lives here once, because a fix to it that lands in one
  9:  * service and not the other leaves the other counting an address the caller
 10:  * chose - which is no limit at all.
 11:  *
 12:  * Engine-free on purpose: nothing here may drag Babylon or a store into a
 13:  * server process.
 14:  */
 15: 
 16: /** Without the `[...]` an IPv6 literal may wear, or a `%zone` suffix. */
 17: function bareAddress(address: string): string {
 18:   return address.replace(/^\[|\]$/g, '').split('%')[0];
 19: }
 20: 
 21: /**
 22:  * Expand an IPv6 address and return its first four groups - the /64.
 23:  *
 24:  * A single IPv6 address is worthless as an identity: a residential allocation
 25:  * is a /64 and every one of its 18 quintillion addresses is free to use, so
 26:  * counting per-address counts nobody. The /64 is the unit actually handed to a
 27:  * subscriber, so that is the unit that gets counted.
 28:  */
 29: export function ipv6Prefix(address: string): string {
 30:   const [head, tail = ''] = address.split('::');
 31:   const headGroups = head ? head.split(':') : [];
 32:   const tailGroups = tail ? tail.split(':') : [];
 33:   const gap = Math.max(8 - headGroups.length - tailGroups.length, 0);
 34: 
 35:   return [...headGroups, ...Array(gap).fill('0'), ...tailGroups]
 36:     .slice(0, 4)
 37:     .map(group => group.padStart(4, '0'))
 38:     .join(':');
 39: }
 40: 
 41: /** What counts as "one network" for a limit. */
 42: export function bucketFor(ip: string): string {
 43:   const bare = bareAddress(ip);
 44: 
 45:   // Plain IPv4, or IPv4-mapped IPv6 (`::ffff:1.2.3.4`) - which must not fall
 46:   // through to the prefix path, or every mapped client shares one all-zero
 47:   // bucket. IPv4 is scarce enough to count whole.
 48:   if (bare.includes('.')) return bare.slice(bare.lastIndexOf(':') + 1);
 49:   if (!bare.includes(':')) return bare;
 50: 
 51:   return `${ipv6Prefix(bare)}::/64`;
 52: }
 53: 
 54: /** `127.0.0.0/8`, `::1`, or the mapped form of the first. */
 55: export function isLoopback(address: string): boolean {
 56:   const bare = bareAddress(address);
 57: 
 58:   if (bare.includes('.')) return bare.slice(bare.lastIndexOf(':') + 1).startsWith('127.');
 59: 
 60:   return bare === '::1';
 61: }
 62: 
 63: /**
 64:  * The caller's address, as far as it can be trusted.
 65:  *
 66:  * Caddy *appends* to `X-Forwarded-For`, so a client that sends a header of its
 67:  * own arrives as `spoofed, real`: the entry Caddy added is the last one, and
 68:  * everything before it is attacker-controlled. Reading `[0]` - the usual
 69:  * shorthand - would let anyone mint a fresh identity per request and walk
 70:  * straight through the limit.
 71:  *
 72:  * The header is believed only when the socket peer is loopback. Both services
 73:  * bind 127.0.0.1 and Caddy on the same box is the only thing that reaches
 74:  * them, so a loopback peer is Caddy and the entry it appended is real. A peer
 75:  * anywhere else got to the port directly - a container mapping, a `HOSTNAME`
 76:  * override, a firewall hole - and nothing sat in front of it to append
 77:  * anything, so the header is whatever the client typed and the socket
 78:  * address is the only truth there is. Were Caddy ever moved to another host,
 79:  * every client would count as that host's one network: too strict, never too
 80:  * loose.
 81:  */
 82: // Structurally typed rather than `Bun.Server`: the pinned `bun-types` does not
 83: // export that name, and this is the only member needed.
 84: export function clientIp(
 85:   req: Request,
 86:   server: { requestIP(req: Request): { address: string } | null }
 87: ): string {
 88:   const peer = server.requestIP(req)?.address;
 89:   const forwarded = req.headers.get('x-forwarded-for');
 90: 
 91:   if (forwarded && peer && isLoopback(peer)) {
 92:     const hops = forwarded.split(',');
 93:     const nearest = hops[hops.length - 1]?.trim();
 94: 
 95:     if (nearest) return nearest;
 96:   }
 97: 
 98:   return peer || 'unknown';
 99: }
100: 
101: /**
102:  * Attempts per bucket inside a sliding window, in memory. Forgetting it on a
103:  * restart costs nothing that matters: whatever a burst limit protects is
104:  * bounded elsewhere, on disk, by the thing it fronts (register's daily quota,
105:  * the shop's daily caps).
106:  */
107: export class BurstLimit {
108:   /** bucket -> attempt timestamps inside the window. */
109:   private readonly bursts = new Map<string, number[]>();
110: 
111:   constructor(
112:     private readonly limit: number,
113:     private readonly windowMs: number
114:   ) {}
115: 
116:   /** Records the attempt and says whether it was one too many. */
117:   hammering(bucket: string, now = Date.now()): boolean {
118:     const recent = (this.bursts.get(bucket) ?? []).filter(at => now - at < this.windowMs);
119: 
120:     recent.push(now);
121:     this.bursts.set(bucket, recent);
122: 
123:     // Buckets that stopped knocking would otherwise accumulate forever.
124:     if (this.bursts.size > 10_000) {
125:       for (const [key, times] of this.bursts) {
126:         if (!times.some(at => now - at < this.windowMs)) this.bursts.delete(key);
127:       }
128:     }
129: 
130:     return recent.length > this.limit;
131:   }
132: }
</file>

<file path="src/common/renderAngles.ts">
 1: import type { IVector3Like, Vector3 } from '../libs/babylon/exports';
 2: 
 3: /**
 4:  * Entity `transform.rot` → Babylon node Euler angles.
 5:  *
 6:  * The BMD→Babylon conversion on every model root (`scaling (1,-1,1)` +
 7:  * `rotX(-90°)`, modelObject.ts) is a mirror, so the original's
 8:  * `AngleMatrix(a0,a1,a2)` (Rz·Ry·Rx, Z-up) maps to Babylon as
 9:  * `(x, y, z) = (-a0, -a2, -a1)`. The loader already negates pitch/roll; yaw is
10:  * kept "MU-positive" in `transform.rot.y` because the character code computes
11:  * it with `atan2` in that convention, and is flipped here - in exactly one
12:  * place, so `init()`-time readers of `node.rotation` (particle emitters, map
13:  * object lights) see the same value the render loop will use.
14:  *
15:  * Known approximation: Babylon evaluates `node.rotation` as Z→X→Y while the
16:  * original applies X→Z→Y after the remap; the two differ only when an object
17:  * has both a pitch *and* a roll (rare in the map data).
18:  */
19: export function toRenderAngles(rot: IVector3Like, out: Vector3): Vector3 {
20:   out.x = rot.x;
21:   out.y = Math.PI * 2 - rot.y;
22:   out.z = rot.z;
23:   return out;
24: }
</file>

<file path="src/common/renderDistance.ts">
 1: /**
 2:  * How far from the hero map objects are kept loaded, in tiles.
 3:  *
 4:  * `CalculateVisibilitySystem` held 32/40 as constants, sized for the ported
 5:  * camera's default framing - the original has no such radius, it draws every
 6:  * 16x16 object block the 2D frustum touches (`RenderObjects`,
 7:  * ZzzObject.cpp:3272). The camera facade's zoom, pitch and FOV sliders all
 8:  * push the horizon well past that pair, so the radius is a player choice
 9:  * rather than a constant: step 0 is exactly what the client always had, and
10:  * the top step is wider than the map's own diagonal (256 * sqrt(2) = 362), so
11:  * it holds every object on the map at once.
12:  *
13:  * Both rings load the model (`ModelLoaderSystem`) and only `hidden` disposes
14:  * one. `visible` is the inner ring: it loads first while the models stream in,
15:  * and it is what the systems that walk objects rather than frustum-cull them
16:  * read - the ceiling flood fill, picking, highlights.
17:  */
18: export type RenderDistanceRanges = {
19:   readonly visible: number;
20:   readonly nearby: number;
21: };
22: 
23: export const RENDER_DISTANCE_STEPS: readonly RenderDistanceRanges[] = [
24:   { visible: 32, nearby: 40 },
25:   { visible: 64, nearby: 80 },
26:   { visible: 96, nearby: 120 },
27:   { visible: 128, nearby: 160 },
28:   { visible: 160, nearby: 200 },
29:   { visible: 192, nearby: 240 },
30:   { visible: 224, nearby: 280 },
31:   { visible: 256, nearby: 320 },
32:   { visible: 320, nearby: 400 },
33:   { visible: 384, nearby: 480 },
34: ];
35: 
36: export const RENDER_DISTANCE_MAX = RENDER_DISTANCE_STEPS.length - 1;
37: 
38: export function renderDistanceRanges(step: number): RenderDistanceRanges {
39:   return (
40:     RENDER_DISTANCE_STEPS[
41:       Math.max(0, Math.min(RENDER_DISTANCE_MAX, Math.round(step)))
42:     ] ?? RENDER_DISTANCE_STEPS[0]
43:   );
44: }
</file>

