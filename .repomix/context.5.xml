177: /**
178:  * Everything `SetPlayerStop` / `SetPlayerWalk` read off the character before
179:  * they reach the weapon switch (ZzzCharacter.cpp:157-679).
180:  */
181: export type CharacterPose = {
182:   hands: Hands | undefined;
183:   baseClass: BaseClass;
184:   /**
185:    * `gCharacterManager.IsFemale(c->Class)` - elf or summoner. Kept separate
186:    * from `baseClass` because the walk branch tests it directly.
187:    */
188:   isFemale: boolean;
189:   /**
190:    * The "no weapon or safe zone" collapse:
191:    * `(Weapon[0] == -1 && Weapon[1] == -1) || (SafeZone && !InBloodCastle())`.
192:    */
193:   weaponsStowed: boolean;
194:   /** `gMapManager.InChaosCastle()`: summoners pose and walk male in there. */
195:   inChaosCastle: boolean;
196: };
197: 
198: /** `SetPlayerStop`'s unarmed branch (ZzzCharacter.cpp:271-280). */
199: function plainStop(pose: CharacterPose): PlayerAction {
200:   switch (pose.baseClass) {
201:     case BaseClass.Elf:
202:       return PlayerAction.PLAYER_STOP_FEMALE;
203:     case BaseClass.Summoner:
204:       return pose.inChaosCastle
205:         ? PlayerAction.PLAYER_STOP_MALE
206:         : PlayerAction.PLAYER_STOP_SUMMONER;
207:     case BaseClass.RageFighter:
208:       return PlayerAction.PLAYER_STOP_RAGEFIGHTER;
209:     default:
210:       return PlayerAction.PLAYER_STOP_MALE;
211:   }
212: }
213: 
214: /** `SetPlayerWalk`'s unarmed branch (ZzzCharacter.cpp:556-562). */
215: function plainWalk(pose: CharacterPose): PlayerAction {
216:   if (!pose.isFemale) return PlayerAction.PLAYER_WALK_MALE;
217:   if (pose.baseClass === BaseClass.Summoner && pose.inChaosCastle) {
218:     return PlayerAction.PLAYER_WALK_MALE;
219:   }
220:   return PlayerAction.PLAYER_WALK_FEMALE;
221: }
222: 
223: /** The two weapon slots, filtered to actual weapons. Slot 0 is the main hand. */
224: function weapons(pose: CharacterPose): [Item | null, Item | null] {
225:   const hands = pose.hands;
226:   return [
227:     hands && isWeaponItem(hands.leftHand) ? hands.leftHand : null,
228:     hands && isWeaponItem(hands.rightHand) ? hands.rightHand : null,
229:   ];
230: }
231: 
232: /** `SetPlayerStop` weapon branch. */
233: export function chooseIdleAction(pose: CharacterPose): PlayerAction {
234:   const [main, off] = weapons(pose);
235:   if (pose.weaponsStowed || (!main && !off)) return plainStop(pose);
236: 
237:   if (main) {
238:     switch (main.group) {
239:       case GROUP_SWORD:
240:       case GROUP_AXE:
241:       case GROUP_MACE:
242:         if (!isTwoHanded(main)) return PlayerAction.PLAYER_STOP_SWORD;
243:         return main.group === GROUP_SWORD && TWO_HAND_SWORD_TWO_INDICES.has(main.num)
244:           ? PlayerAction.PLAYER_STOP_TWO_HAND_SWORD_TWO
245:           : PlayerAction.PLAYER_STOP_TWO_HAND_SWORD;
246:       case GROUP_SPEAR:
247:         return SPEAR_POSE_INDICES.has(main.num)
248:           ? PlayerAction.PLAYER_STOP_SPEAR
249:           : PlayerAction.PLAYER_STOP_SCYTHE;
250:       case GROUP_STAFF:
251:         if (main.num >= MISTERY_STICK && main.num <= ETERNAL_WING_STICK) {
252:           return PlayerAction.PLAYER_STOP_WAND;
253:         }
254:         if (main.num >= BOOK_OF_SAHAMUTT) break;
255:         return isTwoHanded(main)
256:           ? PlayerAction.PLAYER_STOP_SCYTHE
257:           : PlayerAction.PLAYER_STOP_SWORD;
258:     }
259:   }
260: 
261:   const bow = equippedBow(pose.hands!);
262:   if (bow) {
263:     return isCrossbow(bow)
264:       ? PlayerAction.PLAYER_STOP_CROSSBOW
265:       : PlayerAction.PLAYER_STOP_BOW;
266:   }
267: 
268:   return plainStop(pose);
269: }
270: 
271: /** `SetPlayerWalk`'s `c->Run < 40` branch (ZzzCharacter.cpp:567-612). */
272: export function chooseWalkAction(pose: CharacterPose): PlayerAction {
273:   const [main, off] = weapons(pose);
274:   if (pose.weaponsStowed || (!main && !off)) return plainWalk(pose);
275: 
276:   if (main) {
277:     switch (main.group) {
278:       case GROUP_SWORD:
279:       case GROUP_AXE:
280:       case GROUP_MACE:
281:         if (!isTwoHanded(main)) return PlayerAction.PLAYER_WALK_SWORD;
282:         return main.group === GROUP_SWORD && TWO_HAND_SWORD_TWO_INDICES.has(main.num)
283:           ? PlayerAction.PLAYER_WALK_TWO_HAND_SWORD_TWO
284:           : PlayerAction.PLAYER_WALK_TWO_HAND_SWORD;
285:       case GROUP_STAFF:
286:         if (main.num >= MISTERY_STICK && main.num <= ETERNAL_WING_STICK) {
287:           return PlayerAction.PLAYER_WALK_WAND;
288:         }
289:         if (main.num >= BOOK_OF_SAHAMUTT) break;
290:         return isTwoHanded(main)
291:           ? PlayerAction.PLAYER_WALK_SCYTHE
292:           : PlayerAction.PLAYER_WALK_SWORD;
293:       case GROUP_SPEAR:
294:         return SPEAR_POSE_INDICES.has(main.num)
295:           ? PlayerAction.PLAYER_WALK_SPEAR
296:           : PlayerAction.PLAYER_WALK_SCYTHE;
297:     }
298:   }
299: 
300:   const bow = equippedBow(pose.hands!);
301:   if (bow) {
302:     return isCrossbow(bow)
303:       ? PlayerAction.PLAYER_WALK_CROSSBOW
304:       : PlayerAction.PLAYER_WALK_BOW;
305:   }
306: 
307:   return plainWalk(pose);
308: }
309: 
310: /**
311:  * `SetPlayerWalk`'s `c->Run >= 40` branch (ZzzCharacter.cpp:615-670).
312:  *
313:  * Three ways it differs from the walk branch, all deliberate in the original:
314:  * a second melee weapon selects the dual-wield run (a Rage Fighter runs
315:  * plain instead), a two-handed staff runs with the *spear* clip rather than
316:  * the scythe one, and the whole spear group runs with `PLAYER_RUN_SPEAR` -
317:  * there is no Dragon Lance special case up here.
318:  */
319: export function chooseRunAction(pose: CharacterPose): PlayerAction {
320:   const [main, off] = weapons(pose);
321:   if (pose.weaponsStowed || (!main && !off)) return PlayerAction.PLAYER_RUN;
322: 
323:   if (main) {
324:     switch (main.group) {
325:       case GROUP_SWORD:
326:       case GROUP_AXE:
327:       case GROUP_MACE:
328:         if (off && off.group <= GROUP_MACE) {
329:           return pose.baseClass === BaseClass.RageFighter
330:             ? PlayerAction.PLAYER_RUN
331:             : PlayerAction.PLAYER_RUN_TWO_SWORD;
332:         }
333:         if (!isTwoHanded(main)) return PlayerAction.PLAYER_RUN_SWORD;
334:         return main.group === GROUP_SWORD && TWO_HAND_SWORD_TWO_INDICES.has(main.num)
335:           ? PlayerAction.PLAYER_RUN_TWO_HAND_SWORD_TWO
336:           : PlayerAction.PLAYER_RUN_TWO_HAND_SWORD;
337:       case GROUP_STAFF:
338:         if (main.num >= MISTERY_STICK && main.num <= ETERNAL_WING_STICK) {
339:           return PlayerAction.PLAYER_RUN_WAND;
340:         }
341:         if (main.num >= BOOK_OF_SAHAMUTT) break;
342:         return isTwoHanded(main)
343:           ? PlayerAction.PLAYER_RUN_SPEAR
344:           : PlayerAction.PLAYER_RUN_SWORD;
345:       case GROUP_SPEAR:
346:         return PlayerAction.PLAYER_RUN_SPEAR;
347:     }
348:   }
349: 
350:   const bow = equippedBow(pose.hands!);
351:   if (bow) {
352:     return isCrossbow(bow)
353:       ? PlayerAction.PLAYER_RUN_CROSSBOW
354:       : PlayerAction.PLAYER_RUN_BOW;
355:   }
356: 
357:   return PlayerAction.PLAYER_RUN;
358: }
359: 
360: /** Social actions during which the original also stows weapons (`:14961`). */
361: export function isSocialAction(action: PlayerAction): boolean {
362:   return action >= PlayerAction.PLAYER_GREETING1 && action <= PlayerAction.PLAYER_SALUTE1;
363: }
364: 
365: // ---- Fenrir rider clips ----------------------------------------------------
366: // The Fenrir branch of SetPlayerStop (ZzzCharacter.cpp:164-187) and
367: // SetAction_Fenrir_Walk / _Run (ZzzAI.cpp:308-390): a two-hands weapon split,
368: // with arrows in slot 0 / bolts in slot 1 counting as an empty hand, and the
369: // run family picked per base class (Elf / Magic Gladiator / Rage Fighter).
370: 
371: function isArrows(item: Item | null): boolean {
372:   return !!item && item.group === GROUP_BOW && item.num === ARROWS_INDEX;
373: }
374: 
375: function isBolts(item: Item | null): boolean {
376:   return !!item && item.group === GROUP_BOW && item.num === BOLT_INDEX;
377: }
378: 
379: export function chooseFenrirIdleAction(pose: CharacterPose): PlayerAction {
380:   const [main, off] = weapons(pose);
381:   const rage = pose.baseClass === BaseClass.RageFighter;
382: 
383:   if (main && off) {
384:     return rage
385:       ? PlayerAction.PLAYER_RAGE_FENRIR_STAND_TWO_SWORD
386:       : PlayerAction.PLAYER_FENRIR_STAND_TWO_SWORD;
387:   }
388:   if (main) {
389:     return rage
390:       ? PlayerAction.PLAYER_RAGE_FENRIR_STAND_ONE_RIGHT
391:       : PlayerAction.PLAYER_FENRIR_STAND_ONE_RIGHT;
392:   }
393:   if (off) {
394:     return rage
395:       ? PlayerAction.PLAYER_RAGE_FENRIR_STAND_ONE_LEFT
396:       : PlayerAction.PLAYER_FENRIR_STAND_ONE_LEFT;
397:   }
398:   return rage
399:     ? PlayerAction.PLAYER_RAGE_FENRIR_STAND
400:     : PlayerAction.PLAYER_FENRIR_STAND;
401: }
402: 
403: export function chooseFenrirWalkAction(pose: CharacterPose): PlayerAction {
404:   const [main, off] = weapons(pose);
405: 
406:   if (pose.baseClass === BaseClass.RageFighter) {
407:     if (main && off) return PlayerAction.PLAYER_RAGE_FENRIR_WALK_TWO_SWORD;
408:     if (main) return PlayerAction.PLAYER_RAGE_FENRIR_WALK_ONE_RIGHT;
409:     if (off) return PlayerAction.PLAYER_RAGE_FENRIR_WALK_ONE_LEFT;
410:     return PlayerAction.PLAYER_RAGE_FENRIR_WALK;
411:   }
412: 
413:   if (main && off && !isArrows(main) && !isBolts(off)) {
414:     return PlayerAction.PLAYER_FENRIR_WALK_TWO_SWORD;
415:   }
416:   if (main && (!off || isBolts(off))) {
417:     return PlayerAction.PLAYER_FENRIR_WALK_ONE_RIGHT;
418:   }
419:   if (off && (!main || isArrows(main))) {
420:     return PlayerAction.PLAYER_FENRIR_WALK_ONE_LEFT;
421:   }
422:   return PlayerAction.PLAYER_FENRIR_WALK;
423: }
424: 
425: export function chooseFenrirRunAction(pose: CharacterPose): PlayerAction {
426:   const [main, off] = weapons(pose);
427: 
428:   const pick = (
429:     plain: PlayerAction,
430:     elf: PlayerAction,
431:     magom: PlayerAction,
432:     rage: PlayerAction
433:   ): PlayerAction => {
434:     switch (pose.baseClass) {
435:       case BaseClass.Elf:
436:         return elf;
437:       case BaseClass.MagicGladiator:
438:         return magom;
439:       case BaseClass.RageFighter:
440:         return rage;
441:       default:
442:         return plain;
443:     }
444:   };
445: 
446:   if (main && off && !isArrows(main) && !isBolts(off)) {
447:     return pick(
448:       PlayerAction.PLAYER_FENRIR_RUN_TWO_SWORD,
449:       PlayerAction.PLAYER_FENRIR_RUN_TWO_SWORD_ELF,
450:       PlayerAction.PLAYER_FENRIR_RUN_TWO_SWORD_MAGOM,
451:       PlayerAction.PLAYER_RAGE_FENRIR_RUN_TWO_SWORD
452:     );
453:   }
454:   if (main && !off) {
455:     return pick(
456:       PlayerAction.PLAYER_FENRIR_RUN_ONE_RIGHT,
457:       PlayerAction.PLAYER_FENRIR_RUN_ONE_RIGHT_ELF,
458:       PlayerAction.PLAYER_FENRIR_RUN_ONE_RIGHT_MAGOM,
459:       PlayerAction.PLAYER_RAGE_FENRIR_RUN_ONE_RIGHT
460:     );
461:   }
462:   if (main && off && isBolts(off)) {
463:     return PlayerAction.PLAYER_FENRIR_RUN_ONE_RIGHT_ELF;
464:   }
465:   if (!main && off) {
466:     return pick(
467:       PlayerAction.PLAYER_FENRIR_RUN_ONE_LEFT,
468:       PlayerAction.PLAYER_FENRIR_RUN_ONE_LEFT_ELF,
469:       PlayerAction.PLAYER_FENRIR_RUN_ONE_LEFT_MAGOM,
470:       PlayerAction.PLAYER_RAGE_FENRIR_RUN_ONE_LEFT
471:     );
472:   }
473:   if (main && off && isArrows(main)) {
474:     return PlayerAction.PLAYER_FENRIR_RUN_ONE_LEFT_ELF;
475:   }
476:   return pick(
477:     PlayerAction.PLAYER_FENRIR_RUN,
478:     PlayerAction.PLAYER_FENRIR_RUN_ELF,
479:     PlayerAction.PLAYER_FENRIR_RUN_MAGOM,
480:     PlayerAction.PLAYER_RAGE_FENRIR_RUN
481:   );
482: }
483: 
484: // ---- attack clips ----------------------------------------------------------
485: // `SetPlayerAttack` (ZzzCharacter.cpp:988-1130) and `SetPlayerHighBowAttack`
486: // (:949-985). Four families in the order the original tries them - Fenrir,
487: // Dark Horse, the two horns, then the ground switch - and the repeated clips
488: // cycle on `c->SwordCount` rather than alternating.
489: 
490: /** MODEL_DOUBLE_POLEAXE = MODEL_SPEAR + 5: the mounts split the group here. */
491: const DOUBLE_POLEAXE = 5;
492: 
493: /**
494:  * Everything `SetPlayerAttack` reads off the character that the weapon slots
495:  * do not already say.
496:  */
497: export type AttackPose = {
498:   hands: Hands | undefined;
499:   baseClass: BaseClass;
500:   /** `c->SwordCount`: swings so far. Cycles the repeated clips. */
501:   swordCount: number;
502:   /** `c->Wing.Type != -1`: the archer's swing has an airborne variant. */
503:   wings?: boolean;
504:   /** `c->Helper.Type`, already collapsed to `null` in a safe zone. */
505:   mount?: MountKind | null;
506: };
507: 
508: function rnd(n: number): number {
509:   return Math.floor(Math.random() * n);
510: }
511: 
512: /**
513:  * The swing's bow lookup. `GetEquipedBowType` reads one fixed slot per type,
514:  * but `chooseIdleAction` takes a launcher from either hand - so must this
515:  * one, or a character standing in the bow pose would swing with his fists.
516:  */
517: function attackBowType(hands: Hands | undefined): 'bow' | 'crossbow' | null {
518:   if (!hands) return null;
519:   const launcher = equippedBow(hands);
520:   if (!launcher) return null;
521:   return isCrossbow(launcher) ? 'crossbow' : 'bow';
522: }
523: 
524: /** `SwordCount % 4` for a pair of one-handers (:1078-1086). */
525: const DUAL_WIELD_CYCLE = [
526:   PlayerAction.PLAYER_ATTACK_SWORD_RIGHT1,
527:   PlayerAction.PLAYER_ATTACK_SWORD_LEFT1,
528:   PlayerAction.PLAYER_ATTACK_SWORD_RIGHT2,
529:   PlayerAction.PLAYER_ATTACK_SWORD_LEFT2,
530: ] as const;
531: 
532: /** `Type >= MODEL_SWORD && Type < MODEL_MACE + MAX_ITEM_INDEX`: groups 0-2. */
533: function isMelee(item: Item | null): boolean {
534:   return !!item && item.group <= GROUP_MACE;
535: }
536: 
537: /** `SetPlayerAttack`'s Fenrir branch (:995-1024). */
538: function fenrirAttack(pose: AttackPose, main: Item | null, off: Item | null): PlayerAction {
539:   // The Dark Lord's sword swing wins over every other Fenrir clip: the
540:   // original assigns it last, outside the ladder (:1021-1024).
541:   if (pose.baseClass === BaseClass.DarkLord) {
542:     return PlayerAction.PLAYER_FENRIR_ATTACK_DARKLORD_SWORD;
543:   }
544:   if (main && main.group === GROUP_SPEAR && main.num < DOUBLE_POLEAXE) {
545:     return PlayerAction.PLAYER_FENRIR_ATTACK_SPEAR;
546:   }
547:   const bow = attackBowType(pose.hands);
548:   if (bow === 'bow') return PlayerAction.PLAYER_FENRIR_ATTACK_BOW;
549:   if (bow === 'crossbow') return PlayerAction.PLAYER_FENRIR_ATTACK_CROSSBOW;
550: 
551:   if (main && off) return PlayerAction.PLAYER_FENRIR_ATTACK_TWO_SWORD;
552:   if (main) return PlayerAction.PLAYER_FENRIR_ATTACK_ONE_SWORD;
553:   if (off) {
554:     return pose.baseClass === BaseClass.RageFighter
555:       ? PlayerAction.PLAYER_RAGE_FENRIR_ATTACK_RIGHT
556:       : PlayerAction.PLAYER_FENRIR_ATTACK_ONE_SWORD;
557:   }
558:   return PlayerAction.PLAYER_FENRIR_ATTACK;
559: }
560: 
561: /** Horn of Uniria / Dinorant (:1030-1067). */
562: function hornAttack(pose: AttackPose, main: Item | null): PlayerAction {
563:   if (main && main.group === GROUP_SPEAR) {
564:     return main.num < DOUBLE_POLEAXE
565:       ? PlayerAction.PLAYER_ATTACK_RIDE_SPEAR
566:       : PlayerAction.PLAYER_ATTACK_RIDE_SCYTHE;
567:   }
568:   const bow = attackBowType(pose.hands);
569:   if (bow === 'bow') return PlayerAction.PLAYER_ATTACK_RIDE_BOW;
570:   if (bow === 'crossbow') return PlayerAction.PLAYER_ATTACK_RIDE_CROSSBOW;
571: 
572:   const rage = pose.baseClass === BaseClass.RageFighter;
573:   if (!main) {
574:     return rage ? PlayerAction.PLAYER_RAGE_UNI_ATTACK : PlayerAction.PLAYER_ATTACK_RIDE_SWORD;
575:   }
576:   if (!isTwoHanded(main)) {
577:     return rage ? PlayerAction.PLAYER_RAGE_UNI_ATTACK : PlayerAction.PLAYER_ATTACK_RIDE_SWORD;
578:   }
579:   return rage
580:     ? PlayerAction.PLAYER_RAGE_UNI_ATTACK_ONE_RIGHT
581:     : PlayerAction.PLAYER_ATTACK_RIDE_TWO_HAND_SWORD;
582: }
583: 
584: /** The on-foot weapon switch (:1069-1129). */
585: function groundAttack(pose: AttackPose, main: Item | null, off: Item | null): PlayerAction {
586:   if (!main && !off) return PlayerAction.PLAYER_ATTACK_FIST;
587:   const n = pose.swordCount;
588: 
589:   if (main && isMelee(main)) {
590:     if (!isTwoHanded(main)) {
591:       // A one-hander in each hand runs the four-clip cycle; alone, the two
592:       // right-hand swings alternate.
593:       if (isMelee(off)) return DUAL_WIELD_CYCLE[n % 4];
594:       return PlayerAction.PLAYER_ATTACK_SWORD_RIGHT1 + (n % 2);
595:     }
596:     if (main.group === GROUP_SWORD && TWO_HAND_SWORD_TWO_INDICES.has(main.num)) {
597:       return PlayerAction.PLAYER_ATTACK_TWO_HAND_SWORD_TWO;
598:     }
599:     return PlayerAction.PLAYER_ATTACK_TWO_HAND_SWORD1 + (n % 3);
600:   }
601: 
602:   // Reached with the main hand empty or holding something that is not a
603:   // sword/axe/mace: an off-hand blade swings on its own.
604:   if (isMelee(off)) return PlayerAction.PLAYER_ATTACK_SWORD_LEFT1 + rnd(2);
605: 
606:   if (main && main.group === GROUP_STAFF) {
607:     return isTwoHanded(main)
608:       ? PlayerAction.PLAYER_SKILL_WEAPON1 + rnd(2)
609:       : PlayerAction.PLAYER_ATTACK_SWORD_RIGHT1 + rnd(2);
610:   }
611: 
612:   if (main && main.group === GROUP_SPEAR) {
613:     return SPEAR_POSE_INDICES.has(main.num)
614:       ? PlayerAction.PLAYER_ATTACK_SPEAR1
615:       : PlayerAction.PLAYER_ATTACK_SCYTHE1 + (n % 3);
616:   }
617: 
618:   const bow = attackBowType(pose.hands);
619:   if (bow === 'bow') {
620:     return pose.wings ? PlayerAction.PLAYER_ATTACK_FLY_BOW : PlayerAction.PLAYER_ATTACK_BOW;
621:   }
622:   if (bow === 'crossbow') {
623:     return pose.wings
624:       ? PlayerAction.PLAYER_ATTACK_FLY_CROSSBOW
625:       : PlayerAction.PLAYER_ATTACK_CROSSBOW;
626:   }
627: 
628:   return PlayerAction.PLAYER_ATTACK_FIST;
629: }
630: 
631: /** `SetPlayerAttack`: the clip one basic swing plays. */
632: export function chooseAttackAction(pose: AttackPose): PlayerAction {
633:   const hands = pose.hands;
634:   const main = hands && isWeaponItem(hands.leftHand) ? hands.leftHand : null;
635:   const off = hands && isWeaponItem(hands.rightHand) ? hands.rightHand : null;
636: 
637:   switch (pose.mount) {
638:     case 'fenrir':
639:       return fenrirAttack(pose, main, off);
640:     case 'horse':
641:       return PlayerAction.PLAYER_ATTACK_RIDE_HORSE_SWORD;
642:     case 'uniria':
643:     case 'dinorant':
644:       return hornAttack(pose, main);
645:     default:
646:       return groundAttack(pose, main, off);
647:   }
648: }
649: 
650: /**
651:  * `SetPlayerHighBowAttack`: the aimed-up shot, which only Starfall uses. A
652:  * crossbow has its own clip, wings and the horns each swap the pair again,
653:  * and the Fenrir has none - a rider shoots with the ground clip.
654:  */
655: export function chooseHighBowAttackAction(pose: AttackPose): PlayerAction {
656:   const crossbow = attackBowType(pose.hands) === 'crossbow';
657: 
658:   if (pose.mount === 'uniria' || pose.mount === 'dinorant') {
659:     return crossbow
660:       ? PlayerAction.PLAYER_ATTACK_RIDE_CROSSBOW_UP
661:       : PlayerAction.PLAYER_ATTACK_RIDE_BOW_UP;
662:   }
663:   if (pose.wings) {
664:     return crossbow
665:       ? PlayerAction.PLAYER_ATTACK_FLY_CROSSBOW_UP
666:       : PlayerAction.PLAYER_ATTACK_FLY_BOW_UP;
667:   }
668:   return crossbow
669:     ? PlayerAction.PLAYER_ATTACK_CROSSBOW_UP
670:     : PlayerAction.PLAYER_ATTACK_BOW_UP;
671: }
</file>

<file path="src/common/wingObject.ts">
  1: import type { Scene } from '../libs/babylon/exports';
  2: import type { World } from '../ecs/world';
  3: import { ModelObject } from './modelObject';
  4: import {
  5:   BonedParticleEmitter,
  6:   type BonedEmission,
  7: } from './effectParticles';
  8: import { wingBone, wingLinkMatrix, type WingSpec } from './wings';
  9: 
 10: /**
 11:  * The `c->Wing` part. Beyond a plain `ModelObject` it owns two things the
 12:  * original keeps on the wing type rather than on the character: the additive
 13:  * membrane mesh (`o->BlendMesh`) and the per-bone sprite aura the 2nd/3rd
 14:  * level wings trail (`RenderPartObjectEffect`, ZzzObject.cpp:9860-9925).
 15:  */
 16: export class WingObject extends ModelObject {
 17:   spec: WingSpec | null = null;
 18: 
 19:   /**
 20:    * Wings cast a shadow here, blend mesh included.
 21:    *
 22:    * The original casts none at all: its shadow pass walks `BodyPart[]` and
 23:    * `Weapon[]` only (`RenderBodyShadow` calls in ZzzCharacter.cpp:8394-8425)
 24:    * and `c->Wing` is neither (w_CharacterInfo.h:217-219), so a winged
 25:    * character throws the same silhouette as a bare one. Deliberate deviation:
 26:    * the wings are the largest thing on the character and their absence from
 27:    * the shadow is what reads as broken.
 28:    *
 29:    * The blend-mesh exemption is the other half of it - on Wing of Elf and
 30:    * Wings of Spirits (`o->BlendMesh = 0`, ZzzObject.cpp:5276-5284) the
 31:    * additive card is the only mesh in the model, so the ordinary rule would
 32:    * leave those two wings shadowless while every other pair cast.
 33:    */
 34:   ShadowBlendMeshCasts = true;
 35: 
 36:   #wake: BonedParticleEmitter | null = null;
 37:   #wakeSpec: WingSpec | null = null;
 38:   #elapsedMs = 0;
 39: 
 40:   /**
 41:    * Applies a wing spec *before* the model is loaded - `BlendMesh` is read by
 42:    * `load()`, so it has to be in place first. Returns the bone the part should
 43:    * link to and the matrix (capes only).
 44:    */
 45:   prepare(spec: WingSpec | null): void {
 46:     this.spec = spec;
 47:     this.BlendMesh = spec?.blendMesh ?? -1;
 48:     this.setBoneLink(wingBone(spec), wingLinkMatrix(spec) ?? undefined);
 49:     // Forces the first playAction(0) after the load to actually start the
 50:     // flap clip; playAction is a no-op when the action is already current.
 51:     this.CurrentAction = -1;
 52: 
 53:     // The aura is rebuilt against the new model in the first Update after load.
 54:     this.#wake = null;
 55:     this.#wakeSpec = null;
 56:   }
 57: 
 58:   Update(gameTime: World['gameTime']): void {
 59:     super.Update(gameTime);
 60: 
 61:     if (!this.Ready || this.OutOfView) return;
 62: 
 63:     if (this.spec?.wake && this.#wakeSpec !== this.spec) {
 64:       this.#wakeSpec = this.spec;
 65:       this.#wake = this.#createWake(this.node.getScene());
 66:     }
 67: 
 68:     if (!this.#wake) return;
 69: 
 70:     this.#elapsedMs = gameTime.TotalGameTime.TotalSeconds * 1000;
 71:     this.#wake.update();
 72:   }
 73: 
 74:   #createWake(scene: Scene): BonedParticleEmitter | null {
 75:     const wake = this.spec?.wake;
 76:     const root = this.gltf?.mesh;
 77:     if (!wake || !root) return null;
 78: 
 79:     const nodeByBone = new Map<number, BonedEmission['node']>();
 80: 
 81:     for (const node of root.getDescendants(false)) {
 82:       const match = /^bone_(\d+)_/.exec(node.name);
 83:       if (match && 'getAbsolutePosition' in node) {
 84:         nodeByBone.set(Number(match[1]), node as BonedEmission['node']);
 85:       }
 86:     }
 87: 
 88:     const points: BonedEmission[] = [];
 89: 
 90:     for (const bone of wake.bones) {
 91:       const node = nodeByBone.get(bone);
 92:       if (!node) continue;
 93: 
 94:       points.push({
 95:         node,
 96:         kinds: [wake.kind],
 97:         count: 1,
 98:         scale: () => wake.scale(this.#elapsedMs),
 99:         light: () => wake.light(this.#elapsedMs),
100:         every: wake.every,
101:       });
102:     }
103: 
104:     return points.length ? new BonedParticleEmitter(scene, points) : null;
105:   }
106: }
</file>

