268: const factories = new Map<string, typeof ModelObject>();
269: 
270: /**
271:  * A `ModelObject` subclass for one pet model. Cached per model path so all
272:  * angels in scope share one class (and the loader's container cache).
273:  */
274: export function petFactoryFor(spec: PetSpec): typeof ModelObject {
275:   const cached = factories.get(spec.model);
276:   if (cached) return cached;
277: 
278:   class PetModel extends ModelObject {
279:     static {
280:       PetModel.OverrideScale = spec.scale;
281:     }
282: 
283:     async init(world: World, _entity: Entity) {
284:       if (spec.blendMesh !== undefined) this.BlendMesh = spec.blendMesh;
285:       this.load(await loadGLTF(spec.model, world));
286:     }
287:   }
288: 
289:   Object.defineProperty(PetModel, 'name', {
290:     value: spec.model.replace(/^.*\/|\.glb$/g, ''),
291:   });
292: 
293:   factories.set(spec.model, PetModel);
294: 
295:   return PetModel;
296: }
