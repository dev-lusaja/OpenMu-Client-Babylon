 63: /** `CutText`: split at the last space before the middle, else the first after. */
 64: export function cutNoticeText(text: string): [string, string] {
 65:   const half = Math.floor(text.length / 2);
 66:   let split = text.lastIndexOf(' ', half);
 67:   if (split === -1) split = text.indexOf(' ', half);
 68:   if (split === -1) return [text, ''];
 69:   return [text.slice(0, split), text.slice(split + 1)];
 70: }
 71: 
 72: export const Notices = new (class _Notices {
 73:   lines: NoticeLine[] = [];
 74:   private timer: ReturnType<typeof setTimeout> | null = null;
 75: 
 76:   constructor() {
 77:     makeAutoObservable<this, 'timer'>(this, { timer: false });
 78:   }
 79: 
 80:   /** `CreateNotice(Text, Color)`. */
 81:   create(text: string, color: number = NoticeColor.Gold): void {
 82:     if (measureNoticeWidth(text) < NOTICE_MAX_WIDTH || !text.includes(' ')) {
 83:       this.push(text, color);
 84:     } else {
 85:       const [top, bottom] = cutNoticeText(text);
 86:       this.push(top, color);
 87:       this.push(bottom, color);
 88:     }
 89:     this.restartTimer();
 90:   }
 91: 
 92:   /** Type 2: `GlobalText[483]` around the text, colour 1. */
 93:   createGuildNotice(text: string): void {
 94:     this.create(GUILD_NOTICE_FORMAT.replace('%s', text), NoticeColor.Guild);
 95:   }
 96: 
 97:   clear(): void {
 98:     this.lines = [];
 99:     if (this.timer) {
100:       clearTimeout(this.timer);
101:       this.timer = null;
102:     }
103:   }
104: 
105:   private push(text: string, color: number): void {
106:     // `ScrollNotice`: the stack holds MAX_NOTICE lines; the oldest drops.
107:     const next = [...this.lines, { text, color }];
108:     this.lines =
109:       next.length > MAX_NOTICE ? next.slice(next.length - MAX_NOTICE) : next;
110:   }
111: 
112:   /** `MoveNotices`: an empty line every NoticeTime ticks pushes the rest up. */
113:   private restartTimer(): void {
114:     if (this.timer) clearTimeout(this.timer);
115:     this.timer = setTimeout(() => this.tick(), NOTICE_TIME_MS);
116:   }
117: 
118:   private tick(): void {
119:     this.timer = null;
120:     if (this.lines.every(line => line.text === '')) {
121:       // Nothing visible is left; stop rather than push blanks forever.
122:       this.lines = [];
123:       return;
124:     }
125:     this.push('', NoticeColor.Gold);
126:     this.restartTimer();
127:   }
128: })();
</file>

