 744:   /** The mix button (`CNewUIMixInventory::Mix`). */
 745:   mix(): void {
 746:     if (!this.mixOpen || this.mixPending) return;
 747: 
 748:     if (!this.mixItems.some(Boolean)) {
 749:       Social.errorMessage(t('chaos.putItemsIn'));
 750:       return;
 751:     }
 752: 
 753:     if (Store.isOffline) {
 754:       Store.addNotification(t('notify.chaosNeedsServer'), 'info');
 755:       return;
 756:     }
 757: 
 758:     const packet = ChaosMachineMixRequestPacket.createPacket();
 759:     // The card master has no crafting menu; OpenMU resolves the mix against
 760:     // the opened NPC's craftings, so 0 asks for whatever a server configured
 761:     // there (none by default - the mix then answers IncorrectMixItems).
 762:     packet.MixType =
 763:       this.mixKind === 'chaosCard'
 764:         ? (0 as ChaosMachineMixRequestChaosMachineMixTypeEnum)
 765:         : this.mixType;
 766:     packet.SocketSlot = 0;
 767:     Store.sendToGS(packet.buffer);
 768: 
 769:     runInAction(() => {
 770:       this.mixPending = true;
 771:       this.mixResult = null;
 772:     });
 773:   }
