  1: import {
  2:   Matrix,
  3:   Quaternion,
  4:   Vector3,
  5:   type IVector3Like,
  6: } from '../libs/babylon/exports';
  7: import type { ModelObject } from './modelObject';
  8: import { TERRAIN_SIZE } from './terrain/consts';
  9: import { toRenderAngles } from './renderAngles';
 10: 
 11: /**
 12:  * The pure half of the prop batches (`propBatches.ts`): which types may be
 13:  * batched, which chunk a placement lands in, and the matrix a placement gets.
 14:  * No scene, no tables - everything that needs a map lookup is handed in.
 15:  */
 16: 
 17: /** One map record as `createObjects` reads it: tiles, radians, uniform scale. */
 18: export type PropPlacement = {
 19:   readonly pos: IVector3Like;
 20:   readonly rot: IVector3Like;
 21:   readonly scale: number;
 22: };
 23: 
 24: /**
 25:  * Tiles per chunk side. The original draws by 16-tile `ObjectBlock`; twice
 26:  * that keeps a 256-tile map at 64 chunks, so a type present everywhere (Noria's
 27:  * flowers) is 64 meshes, not 256, and the camera's view still spans only a
 28:  * handful of them.
 29:  */
 30: export const CHUNK_TILES = 32;
 31: 
 32: export const CHUNKS_PER_SIDE = TERRAIN_SIZE / CHUNK_TILES;
 33: 
 34: function chunkIndex(tile: number): number {
 35:   const i = Math.floor(tile / CHUNK_TILES);
 36:   return i < 0 ? 0 : i >= CHUNKS_PER_SIDE ? CHUNKS_PER_SIDE - 1 : i;
 37: }
 38: 
 39: /** The chunk a tile position falls in; positions off the map clamp to the edge. */
 40: export function chunkOf(x: number, z: number): number {
 41:   return chunkIndex(z) * CHUNKS_PER_SIDE + chunkIndex(x);
 42: }
 43: 
 44: /**
 45:  * Why a type stays on the per-object path, or null when its records may be
 46:  * batched. `excluded` is what the map's own tables say about the type
 47:  * (lights, emitters, doors, rest objects, room pieces), resolved by the
 48:  * caller; the class marker is the only rule that lives here.
 49:  */
 50: export function batchExclusion(
 51:   factory: typeof ModelObject,
 52:   excluded: string | null
 53: ): string | null {
 54:   if (!factory.Batchable) return 'class';
 55:   return excluded;
 56: }
 57: 
 58: const angles = Vector3.Zero();
 59: const rotation = Quaternion.Identity();
 60: const scaling = Vector3.One();
 61: const translation = Vector3.Zero();
 62: 
 63: /**
 64:  * The world matrix `RenderSystem` + `ModelObject.updateLocation` give a
 65:  * placement's node: `toRenderAngles` on the record's rotation, uniform scale,
 66:  * the record's position lifted by `yOffset` (the snow sink, negative).
 67:  * Babylon composes a node's Euler `rotation` as yaw-pitch-roll, which is what
 68:  * `FromEulerAngles` builds.
 69:  */
 70: export function placementMatrix(
 71:   p: PropPlacement,
 72:   out: Matrix,
 73:   yOffset = 0
 74: ): Matrix {
 75:   toRenderAngles(p.rot, angles);
 76:   Quaternion.FromEulerAnglesToRef(angles.x, angles.y, angles.z, rotation);
 77:   scaling.setAll(p.scale);
 78:   translation.set(p.pos.x, p.pos.y + yOffset, p.pos.z);
 79: 
 80:   return Matrix.ComposeToRef(scaling, rotation, translation, out);
 81: }
 82: 
 83: /**
 84:  * A thin instance's matrix: the submesh's own transform under its model root
 85:  * (`meshToNode`, the loader's basis change included) followed by the node's
 86:  * placement. Babylon's thin-instance shader applies the bones first, then
 87:  * this, then the (identity) chunk mesh world - the same order the per-object
 88:  * clone's `mesh.getWorldMatrix()` is built in.
 89:  */
 90: export function instanceMatrix(
 91:   meshToNode: Matrix,
 92:   node: Matrix,
 93:   out: Matrix
 94: ): Matrix {
 95:   return meshToNode.multiplyToRef(node, out);
 96: }
 97: 
 98: const corner = Vector3.Zero();
 99: 
100: /** Grows `min`/`max` by the eight corners of the local box under `m`. */
101: export function extendByBox(
102:   localMin: Vector3,
103:   localMax: Vector3,
104:   m: Matrix,
105:   min: Vector3,
106:   max: Vector3
107: ): void {
108:   for (let i = 0; i < 8; i++) {
109:     Vector3.TransformCoordinatesFromFloatsToRef(
110:       i & 1 ? localMax.x : localMin.x,
111:       i & 2 ? localMax.y : localMin.y,
112:       i & 4 ? localMax.z : localMin.z,
113:       m,
114:       corner
115:     );
116:     Vector3.CheckExtends(corner, min, max);
117:   }
118: }
</file>

