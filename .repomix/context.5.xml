<file path="src/common/terrain/borderVignette.ts">
  1: import { TERRAIN_SIZE } from './consts';
  2: 
  3: /**
  4:  * The bake's border vignette, lifted.
  5:  *
  6:  * Every shipped `TerrainLight` paints the outermost ring of the map near
  7:  * black - Lorencia's ring 0 means 0.18 luma against the 0.63 the map settles
  8:  * at ten tiles in, Noria's 0.11 against 0.63. It is not art: the original's
  9:  * camera could not reach the border and the fade is what its draw distance
 10:  * ended in. This client's camera can, and there the ring reads as a black
 11:  * band hugging the coast.
 12:  *
 13:  * Measured off the map rather than tabled, so a map with no vignette takes
 14:  * almost none (Devias, 0.35 against 0.45) and no map needs a constant. Pure:
 15:  * a float buffer in and the same buffer out, so it runs in the terrain
 16:  * worker ahead of the luminosity multiply.
 17:  */
 18: 
 19: /** Rings whose mean is the level the map has settled to. */
 20: const SETTLED_FROM = 24;
 21: const SETTLED_TO = 64;
 22: 
 23: /** A ring under this share of the settled level is still inside the vignette. */
 24: const VIGNETTE_CUT = 0.85;
 25: 
 26: /**
 27:  * Ceiling on the lift. Lorencia's ring 0 wants 3.6x and gets 3, which leaves
 28:  * it a little under the map - a coast reading slightly darker than the town
 29:  * behind it is what a coast does, and an uncapped gain would turn the one
 30:  * genuinely black corner of a map into grey mud.
 31:  */
 32: const MAX_GAIN = 3;
 33: 
 34: function ringOf(x: number, y: number): number {
 35:   return Math.min(x, y, TERRAIN_SIZE - 1 - x, TERRAIN_SIZE - 1 - y);
 36: }
 37: 
 38: /** Rec. 709 luma of one texel of the decoded bake. */
 39: function luma(light: Float32Array, o: number): number {
 40:   return 0.2126 * light[o] + 0.7152 * light[o + 1] + 0.0722 * light[o + 2];
 41: }
 42: 
 43: /**
 44:  * `light` is the decoded `TerrainLight` at 3 floats per texel, 0..1 display.
 45:  * Rewritten in place.
 46:  */
 47: export function liftBorderVignette(light: Float32Array): void {
 48:   const sums = new Float64Array(SETTLED_TO);
 49:   const counts = new Int32Array(SETTLED_TO);
 50: 
 51:   for (let y = 0; y < TERRAIN_SIZE; y++) {
 52:     for (let x = 0; x < TERRAIN_SIZE; x++) {
 53:       const ring = ringOf(x, y);
 54:       if (ring >= SETTLED_TO) continue;
 55: 
 56:       sums[ring] += luma(light, (y * TERRAIN_SIZE + x) * 3);
 57:       counts[ring]++;
 58:     }
 59:   }
 60: 
 61:   const means = new Float64Array(SETTLED_TO);
 62:   for (let r = 0; r < SETTLED_TO; r++) {
 63:     means[r] = counts[r] > 0 ? sums[r] / counts[r] : 0;
 64:   }
 65: 
 66:   let settled = 0;
 67:   for (let r = SETTLED_FROM; r < SETTLED_TO; r++) settled += means[r];
 68:   settled /= SETTLED_TO - SETTLED_FROM;
 69: 
 70:   if (settled <= 0) return;
 71: 
 72:   // The vignette's span: the outermost run of rings that never climbs back to
 73:   // the settled level. Read from the outside in, so a dark ring further in
 74:   // (a forest, a wall's shadow) is not mistaken for the border fade.
 75:   let span = -1;
 76:   for (let r = 0; r < SETTLED_FROM; r++) {
 77:     if (means[r] >= settled * VIGNETTE_CUT) break;
 78:     span = r;
 79:   }
 80: 
 81:   if (span < 0) return;
 82: 
 83:   const gains = new Float64Array(span + 1);
 84:   for (let r = 0; r <= span; r++) {
 85:     const want = means[r] > 0 ? settled / means[r] : 1;
 86:     gains[r] = Math.max(1, Math.min(MAX_GAIN, want));
 87:   }
 88: 
 89:   for (let y = 0; y < TERRAIN_SIZE; y++) {
 90:     for (let x = 0; x < TERRAIN_SIZE; x++) {
 91:       const ring = ringOf(x, y);
 92:       if (ring > span) continue;
 93: 
 94:       const gain = gains[ring];
 95:       if (gain <= 1) continue;
 96: 
 97:       const o = (y * TERRAIN_SIZE + x) * 3;
 98:       light[o] = Math.min(1, light[o] * gain);
 99:       light[o + 1] = Math.min(1, light[o + 1] * gain);
100:       light[o + 2] = Math.min(1, light[o + 2] * gain);
101:     }
102:   }
103: }
</file>

