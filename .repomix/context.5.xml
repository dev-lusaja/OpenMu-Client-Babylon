1832: // Dev hook for the live harness: no offline test character casts every skill,
1833: // so probes fire a row by hand (`window.__skillVisuals.area(9)`). `victim` is
1834: // whatever else is standing about - offline that is the second test character,
1835: // and it stands in for the object `logic.ts` finds on the cast point, so the
1836: // rows that draw at a target (a bolt, a siphon) can be shot at all.
1837: if (import.meta.env.DEV && typeof window !== 'undefined') {
1838:   const victim = (): Entity | null => {
1839:     const world = storeRef().world;
1840:     const caster = world?.playerEntity;
1841:     if (!world || !caster) return null;
1842:     const alive = (e: Entity): boolean => e !== caster && !!e.transform && !e.dying;
1843:     return world.netObjsQuery.entities.find(alive) ?? world.playersQuery.entities.find(alive) ?? null;
1844:   };
1845:   (window as unknown as { __skillVisuals: unknown }).__skillVisuals = {
1846:     area: (skill: number) => {
1847:       const world = storeRef().world;
1848:       const caster = world?.playerEntity;
1849:       if (!world || !caster?.transform) return false;
1850:       playAreaSkillVisual(world.scene, skill, caster, null, (x, y) => world.getTerrainHeight(x, y), victim());
1851:       return true;
1852:     },
1853:     targeted: (skill: number) => {
1854:       const world = storeRef().world;
1855:       const caster = world?.playerEntity;
1856:       if (!world || !caster?.transform) return false;
1857:       playTargetedSkillVisual(world.scene, skill, caster, victim());
1858:       return true;
1859:     },
1860:   };
1861: }
