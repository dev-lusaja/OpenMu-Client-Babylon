118: /**
119:  * The alpha channel of the shared terrain texture: 255 = open sky over this
120:  * tile, 0 = roofed. Written by `terrainMask.ts`, read by the ground overlays
121:  * in `terrainOverlay.ts`.
122:  *
123:  * It lives here rather than in a texture of its own for one blunt reason: the
124:  * terrain fragment shader already samples this texture, at this exact UV, for
125:  * the torch light. The mask needs the same lookup, and the shader's own
126:  * comments twice record how brittle its sampler list is - a sampler declared
127:  * but unbound, or two sampler types landing on one unit, is a GL draw error
128:  * that makes the whole terrain vanish. Riding in a channel nobody was using
129:  * costs no unit, no upload and no ordering rule.
130:  */
131: export function writeTerrainOpenness(openness: Uint8Array): void {
132:   if (!deltaBytes) return;
133: 
134:   for (let i = 0; i < TERRAIN_SIZE * TERRAIN_SIZE; i++) {
135:     deltaBytes[i * 4 + 3] = openness[i];
136:   }
137: 
138:   deltaDirty = true;
139: }
140: 
141: export function uploadTerrainLightDelta(): void {
142:   if (!deltaDirty || !deltaBytes || !deltaTexture) return;
143: 
144:   deltaDirty = false;
145:   deltaTexture.update(deltaBytes);
146: }
147: 
148: /**
149:  * Whether any registered emitter's footprint reaches into the tile box
150:  * `[minX, maxX] x [minZ, maxZ]`. The prop batches re-pack a chunk's light
151:  * only while a torch can change it.
152:  */
153: export function terrainLightReaches(
154:   minX: number,
155:   minZ: number,
156:   maxX: number,
157:   maxZ: number
158: ): boolean {
159:   for (const emitter of emitters) {
160:     const { x, z } = emitter.position;
161:     const reach = emitter.range + TOUCHED_MARGIN;
162: 
163:     if (x + reach < minX || x - reach > maxX) continue;
164:     if (z + reach < minZ || z - reach > maxZ) continue;
165: 
166:     return true;
167:   }
168: 
169:   return false;
170: }
171: 
172: export function registerTerrainLight(emitter: TerrainLightEmitter): () => void {
173:   emitters.add(emitter);
174:   touchedDirty = true;
175: 
176:   return () => {
177:     resetTouched();
178: 
179:     emitters.delete(emitter);
180:     emitterTiles.delete(emitter);
181:     touchedDirty = true;
182:   };
183: }
184: 
185: function rebuildTouched(): void {
186:   const indices = new Set<number>();
187: 
188:   for (const emitter of emitters) {
189:     const { x, z } = emitter.position;
190:     const xi = Math.floor(x);
191:     const yi = Math.floor(z);
192:     const range = Math.ceil(emitter.range) + TOUCHED_MARGIN;
193: 
194:     emitterTiles.set(emitter, tileKey(x, z));
195: 
196:     for (let y = yi - range; y <= yi + range; y++) {
197:       for (let x = xi - range; x <= xi + range; x++) {
198:         indices.add(TERRAIN_INDEX_REPEAT(x, y));
199:       }
200:     }
201:   }
202: 
203:   touched = Int32Array.from(indices);
204:   touchedDirty = false;
205: }
206: 
207: /** Clears the set last written; the rebuild that follows never precedes it. */
208: function resetTouched(): void {
209:   if (!primary || !baked || !touched) return;
210: 
211:   for (let i = 0; i < touched.length; i++) {
212:     const o = touched[i] * CHANNELS;
213: 
214:     primary[o] = baked[o];
215:     primary[o + 1] = baked[o + 1];
216:     primary[o + 2] = baked[o + 2];
217: 
218:     if (floor) {
219:       floor[o] = 0;
220:       floor[o + 1] = 0;
221:       floor[o + 2] = 0;
222:     }
223: 
224:     if (deltaBytes) {
225:       const d = touched[i] * 4;
226: 
227:       deltaBytes[d] = 0;
228:       deltaBytes[d + 1] = 0;
229:       deltaBytes[d + 2] = 0;
230:     }
231:   }
232: 
233:   deltaDirty = true;
234: }
235: 
236: function addTerrainLight(
237:   xf: number,
238:   yf: number,
239:   r: number,
240:   g: number,
241:   b: number,
242:   range: number,
243:   falloff = 1,
244:   floorGain = 1
245: ): void {
246:   if (!primary || !floor) return;
247: 
248:   const xi = Math.floor(xf);
249:   const yi = Math.floor(yf);
250: 
251:   for (let sy = yi - range; sy <= yi + range; sy++) {
252:     for (let sx = xi - range; sx <= xi + range; sx++) {
253:       const xd = xf - sx;
254:       const yd = yf - sy;
255:       const linear = (range - Math.sqrt(xd * xd + yd * yd)) / range;
256: 
257:       if (linear <= 0) continue;
258: 
259:       const lf = falloff === 1 ? linear : Math.pow(linear, falloff);
260: 
261:       const o = TERRAIN_INDEX_REPEAT(sx, sy) * CHANNELS;
262: 
263:       primary[o] = Math.max(0, primary[o] + r * lf);
264:       primary[o + 1] = Math.max(0, primary[o + 1] + g * lf);
265:       primary[o + 2] = Math.max(0, primary[o + 2] + b * lf);
266: 
267:       const ff = lf * floorGain;
268: 
269:       floor[o] += r * ff;
270:       floor[o + 1] += g * ff;
271:       floor[o + 2] += b * ff;
272:     }
273:   }
274: }
275: 
276: let wasActive = false;
277: 
278: export function updateTerrainDynamicLight(
279:   elapsedMs: number,
280:   enabled = true,
281:   /**
282:    * Emitters the point-light pool lights per pixel this frame, with the
283:    * slot's fade: the tile map stamps their remaining share, so a light
284:    * changing hands never dips. Tiers >= 1 only; Classic keeps every stamp.
285:    */
286:   held?: ReadonlyMap<TerrainLightEmitter, number>
287: ): void {
288:   if (!primary || !baked) return;
289: 
290:   const active = enabled && emitters.size > 0;
291: 
292:   if (!active) {
293:     if (wasActive) resetTouched();
294:     wasActive = false;
295:     return;
296:   }
297: 
298:   wasActive = true;
299: 
300:   resetTouched();
301: 
302:   for (const emitter of emitters) {
303:     const { x, z } = emitter.position;
304: 
305:     if (emitterTiles.get(emitter) !== tileKey(x, z)) touchedDirty = true;
306:   }
307: 
308:   if (touchedDirty) rebuildTouched();
309: 
310:   for (const emitter of emitters) {
311:     const share = 1 - (held?.get(emitter) ?? 0);
312: 
313:     if (share <= 0) continue;
314: 
315:     const { r, g, b } = emitter.color(elapsedMs);
316: 
317:     addTerrainLight(
318:       emitter.position.x,
319:       emitter.position.z,
320:       r * share,
321:       g * share,
322:       b * share,
323:       emitter.range,
324:       emitter.falloff ?? 1,
325:       emitter.floorGain ?? 1
326:     );
327:   }
328: 
329:   if (deltaBytes && touched && floor) {
330:     const encode = DELTA_ENCODE * dynamicLightGain();
331: 
332:     for (let i = 0; i < touched.length; i++) {
333:       const o = touched[i] * CHANNELS;
334:       const d = touched[i] * 4;
335: 
336:       // Hue-preserving soft shoulder. This byte texture tops out at 2.0
337:       // (decoded `* 2.0` in terrainMaterial), and MU's floor lights are almost
338:       // pure hue - the candelabra are (1, 0.66, 0.3), the hearths
339:       // (1, 0.6, 0.35) - so anything done per channel goes wrong twice over.
340:       //
341:       // A per-channel `min` pins red at the ceiling while green and blue are
342:       // still climbing, and the light *changes colour* as it gets stronger:
343:       // orange at the edge of a pool, saturated red in the middle of one,
344:       // maroon where six candelabra overlap. That is the same trap as the
345:       // per-channel clamp in `default.fragment` that made warm light read
346:       // green (clamped lighting is why warm light reads
347:       // *green*"), mirrored - clamping the top of a colour throws away the
348:       // hue, and it is the hue that reads.
349:       //
350:       // Scaling the triple by `255 / peak` fixes the colour but not the
351:       // shape: everything past the ceiling still lands *on* it, so a pool hot
352:       // enough to clip has a flat blown core with a hard rim where it drops
353:       // back into the gradient. Bend it instead. Below `DELTA_KNEE` the value
354:       // is written through; above it the excess is compressed along
355:       // `1 - exp(-x)`, which approaches the ceiling without ever touching it.
356:       // Sums stay ordered, gradients survive, and no pool ever goes flat.
357:       const r = floor[o] * encode;
358:       const g = floor[o + 1] * encode;
359:       const b = floor[o + 2] * encode;
360: 
361:       const peak = r > g ? (r > b ? r : b) : g > b ? g : b;
362: 
363:       let k = 1;
364: 
365:       if (peak > DELTA_LINEAR) {
366:         const shaped =
367:           DELTA_LINEAR +
368:           DELTA_ROOM * (1 - Math.exp(-(peak - DELTA_LINEAR) / DELTA_ROOM));
369: 
370:         k = shaped / peak;
371:       }
372: 
373:       deltaBytes[d] = r * k;
374:       deltaBytes[d + 1] = g * k;
375:       deltaBytes[d + 2] = b * k;
376:     }
377: 
378:     deltaDirty = true;
379:   }
380: }
381: 
382: /**
383:  * Samples `primary` - the bake plus this frame's dynamic emitters (torches,
384:  * +9…+15 item lamps, skills), the original's `PrimaryTerrainLight`. This is
385:  * what BodyLight reads, so a character standing by a torch or next to a
386:  * glowing drop warms up on every tier, exactly like the ground under them.
387:  * When the dynamic layer is idle `primary` equals `baked` (resetTouched).
388:  */
389: export function requestTerrainLight(
390:   x: number,
391:   y: number,
392:   out: { x: number; y: number; z: number }
393: ): boolean {
394:   return primary ? sampleBilinear(primary, x, y, out) : false;
395: }
396: 
397: /**
398:  * Samples the **baked** lightmap alone (`ZzzLodTerrain.cpp:1011-1012`), no
399:  * torch delta. The tiers >= 1 body light reads this: there the pool point
400:  * lights reach a figure per pixel, so the delta would be the same torch a
401:  * second time (ARCHITECTURE §3.2 `bake_baked_only`).
402:  */
403: export function requestBakedTerrainLight(
404:   x: number,
405:   y: number,
406:   out: { x: number; y: number; z: number }
407: ): boolean {
408:   return baked ? sampleBilinear(baked, x, y, out) : false;
409: }
410: 
411: function sampleBilinear(
412:   field: Float32Array,
413:   x: number,
414:   y: number,
415:   out: { x: number; y: number; z: number }
416: ): boolean {
417:   const xi = Math.floor(x);
418:   const yi = Math.floor(y);
419: 
420:   if (xi < 0 || yi < 0 || xi >= TERRAIN_SIZE - 1 || yi >= TERRAIN_SIZE - 1) {
421:     return false;
422:   }
423: 
424:   const i1 = TERRAIN_INDEX(xi, yi) * CHANNELS;
425:   const i2 = TERRAIN_INDEX(xi + 1, yi) * CHANNELS;
426:   const i3 = TERRAIN_INDEX(xi + 1, yi + 1) * CHANNELS;
427:   const i4 = TERRAIN_INDEX(xi, yi + 1) * CHANNELS;
428: 
429:   const xd = x - xi;
430:   const yd = y - yi;
431: 
432:   const channel = (c: number) => {
433:     const left = field[i1 + c] + (field[i4 + c] - field[i1 + c]) * yd;
434:     const right = field[i2 + c] + (field[i3 + c] - field[i2 + c]) * yd;
435: 
436:     return left + (right - left) * xd;
437:   };
438: 
439:   out.x = channel(0);
440:   out.y = channel(1);
441:   out.z = channel(2);
442: 
443:   return true;
444: }
445: 
446: export function packBakedTerrainLight(
447:   light: readonly IVector3Like[],
448:   lift: number
449: ): Float32Array {
450:   const packed = new Float32Array(TERRAIN_SIZE * TERRAIN_SIZE * CHANNELS);
451:   const scale = 1 - lift;
452: 
453:   for (let i = 0; i < TERRAIN_SIZE * TERRAIN_SIZE; i++) {
454:     const v = light[i];
455:     const o = i * CHANNELS;
456: 
457:     packed[o] = v ? lift + v.x * scale : lift;
458:     packed[o + 1] = v ? lift + v.y * scale : lift;
459:     packed[o + 2] = v ? lift + v.z * scale : lift;
460:   }
461: 
462:   return packed;
463: }
