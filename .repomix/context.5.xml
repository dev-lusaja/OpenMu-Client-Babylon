141: function fenrirSpec(
142:   variant: FenrirVariant,
143:   thunder: readonly [number, number, number]
144: ): PetSpec {
145:   // CreateMountSub: Scale 0.9; pinned to the rider like the Dark Horse
146:   // (MoveMount, GOBoid.cpp:174-266), clips driven by fenrirMountAction.
147:   return {
148:     kind: 'mount',
149:     model: `Skill/fenril_${variant}.glb`,
150:     scale: 0.9,
151:     riderClips: 'fenrir',
152:     thunder,
153:   };
