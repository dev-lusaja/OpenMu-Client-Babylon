  4: import type { Item } from '../ecs/world';
  5: import { PlayerAction } from './objects/enum';
  6: 
  7: /**
  8:  * `c->Helper` - the pet / mount slot of the appearance (group 13, indices
  9:  * 0-3). The original splits them three ways:
 10:  *
 11:  *  - **Guardian Angel** (`MODEL_GUARDIAN_ANGEL` → `MODEL_HELPER`) becomes a
 12:  *    free-flying `Mounts[]` object with its own boid AI: `CreateMountSub` +
 13:  *    `MoveMount`, GOBoid.cpp:66-660.
 14:  *  - **Imp / Satan** (`MODEL_IMP`) is *not* a mount - it is link-rendered on
 15:  *    the wearer's bone 34 every frame (`RenderCharacterBackItem`,
 16:  *    ZzzCharacter.cpp:15144-15180) with a red light sprite on top.
 17:  *  - **Horn of Uniria / Dinorant** (`MODEL_UNICON` / `MODEL_PEGASUS`) are
 18:  *    mounts pinned to the rider: same position and yaw, action 0 standing /
 19:  *    2 moving (GOBoid.cpp:494-556). The rider switches to the `*_RIDE` clips
 20:  *    and, on a Dinorant, floats 30 units off the ground
 21:  *    (`MoveCharacterPosition`, ZzzCharacter.cpp:6263-6273).
 22:  *
 23:  * `Data/Player/Helper0n.bmd` is the model behind `MODEL_HELPER + n`
 24:  * (ZzzOpenData.cpp:705) and `Data/Skill/Rider0n.bmd` behind the two mounts
 25:  * (:3969-3970) - **not** the `Item/helper0n` path items.json carries for the
 26:  * horn items, which is the inventory icon model and does not exist as a GLB.
