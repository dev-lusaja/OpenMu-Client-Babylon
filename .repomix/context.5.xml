 567: /**
 568:  * `n` JOINT_HEALING-style ribbons spiralling up round a body from ±80 cm at
 569:  * +300 z (ImproveAG's four sub10 joints; Recover's nineteen FLARE joints).
 570:  */
 571: function spiralRibbons(n: number, colour: RGB, width: number, tails: number, seconds: number): Step {
 572:   return (at, c) => {
 573:     for (let i = 0; i < n; i++) {
 574:       const phase = (i * Math.PI * 2) / n;
 575:       const t0 = fxNow();
 576:       const head: PointSource = out => {
 577:         const t = fxNow() - t0;
 578:         const a = phase + t * 4;
 579:         return out.set(at.x + Math.cos(a) * cm(80), at.y + 0.2 + t * 1.2, at.z + Math.sin(a) * cm(80));
 580:       };
 581:       effects.spawn('joint', c.scene, at, { head, maxTails: tails, width, colour, seconds, texture: TEX.jointEnergy });
 582:     }
 583:   };
 584: }
