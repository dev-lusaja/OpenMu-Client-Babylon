325:     bindToon(stub.effect, true);
326:     bindToon(stub.effect, false);
327:     bands = written(stub.setFloat4, TOON_UNIFORM);
328:     expect(bands[0][2]).toBeGreaterThan(0);
329:     expect(bands[1][2]).toBe(0);
330:     expect(written(stub.setFloat4, TOON_FILTER_UNIFORM)).toHaveLength(2);
331:   });
332: });
