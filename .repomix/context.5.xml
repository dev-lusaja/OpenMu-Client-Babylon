1795: const buffHandles = new Map<Entity, Map<number, EffectHandle>>();
1796: 
1797: /** Command: keep (or drop) the persistent look of `effectId` on `entity`. */
1798: export function setBuffVisual(scene: Scene, entity: Entity, effectId: number, active: boolean): void {
1799:   let byEffect = buffHandles.get(entity);
1800:   const have = byEffect?.get(effectId);
1801:   if (have && (!active || !have.alive)) {
1802:     have.stop();
1803:     byEffect!.delete(effectId);
1804:   }
1805:   if (!active) {
1806:     if (byEffect && byEffect.size === 0) buffHandles.delete(entity);
1807:     return;
1808:   }
1809:   if (have?.alive) return;
1810:   const recipe = BUFF_VISUALS[effectId];
1811:   if (!recipe || !entity.transform) return;
1812:   if (!byEffect) {
1813:     byEffect = new Map();
1814:     buffHandles.set(entity, byEffect);
1815:   }
1816:   const follow: PointSource = out => entityPos(entity, 0, out);
1817:   const handle = effects.spawn('aura', scene, entityPos(entity, 0, new Vector3()), {
1818:     ...recipe(follow),
1819:     until: () => entityGone(entity),
1820:   });
1821:   byEffect.set(effectId, handle);
1822: }
