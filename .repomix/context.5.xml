 52: /**
 53:  * A GPU texture from an OZJ (a JPEG behind a 24-byte header) and nothing
 54:  * else: the browser decodes the JPEG, no `readPixels` round trip. The terrain
 55:  * tiles go through here; `readOJZBufferAsJPEGBuffer` below is for the one
 56:  * caller (the terrain light map) that needs the pixels back on the CPU.
 57:  */
 58: export function createOZJTexture(
 59:   scene: Scene,
 60:   filename: string,
 61:   ozjBuffer: Uint8Array
 62: ): Promise<Texture> {
 63:   if (ozjBuffer.length < 24) {
 64:     throw new Error(`The file ${filename} is too small to be as a OZJ`);
 65:   }
 66: 
 67:   const fName = filename.split('/').at(-1)?.split('.')[0];
 68:   const tName = filename.split('/').slice(0, -1).join('_') + '-' + fName;
 69: 
 70:   return new Promise<Texture>((resolve, reject) => {
 71:     const texture = new Texture(
 72:       `data:${tName}.jpg`,
 73:       scene.getEngine()!,
 74:       true,
 75:       false,
 76:       Texture.NEAREST_NEAREST,
 77:       () => resolve(texture),
 78:       (message, exception) =>
 79:         reject(
 80:           exception ?? new Error(message ?? `Could not decode ${filename}`)
 81:         ),
 82:       ozjBuffer.slice(24),
 83:       true
 84:     );
 85:     texture.anisotropicFilteringLevel = 1;
 86:     texture.isBlocking = false;
 87:     texture.name = tName;
 88:   });
 89: }
 90: 
 91: // TODO we only need bytes buffer? Try to omit bjs dependency...
 92: export async function readOJZBufferAsJPEGBuffer(
 93:   scene: Scene,
 94:   filename: string,
 95:   ozjBuffer: Uint8Array
 96: ) {
 97:   const fileSize = ozjBuffer.length;
 98:   if (fileSize < 24) {
 99:     throw new Error(`The file ${filename} is too small to be as a OZJ`);
100:   }
101: 
102:   // Skip first 24 bytes, because these are added by the OZJ format
103:   // const jpegSize = fileSize - 24;
104: 
105:   // let jpegSubsamp = TJSAMP_444;
106:   // let jpegColorspace = TJCS_RGB;
107: 
108:   filename.split('/').slice(0, -1).join('_');
109:   const fName = filename.split('/').at(-1)?.split('.')[0];
110:   const tName = filename.split('/').slice(0, -1).join('_') + '-' + fName;
111: 
112:   const texture = new Texture(
113:     `data:${tName}.jpg`,
114:     scene.getEngine()!,
115:     true,
116:     false,
117:     Texture.NEAREST_NEAREST,
118:     null,
119:     null,
120:     ozjBuffer.slice(24),
121:     true
122:   );
123:   texture.anisotropicFilteringLevel = 1;
124:   texture.isBlocking = false;
125:   texture.name = tName;
126: 
127:   return new Promise<{ BufferFloat: Float32Array; Texture: Texture }>(r => {
128:     texture.onLoadObservable.addOnce(async texture => {
129:       const size = texture.getSize();
130:       let jpegWidth = size.width;
131:       let jpegHeight = size.height;
132: 
133:       const pixels = new Uint8Array((await texture.readPixels()!).buffer);
134: 
135:       const bufferSize = jpegWidth * jpegHeight * 3;
136:       const BufferFloat = new Float32Array(bufferSize);
137: 
138:       let j = 0;
139:       for (let i = 0; i < pixels.length; i += 4) {
140:         BufferFloat[j++] = pixels[i] / 255;
141:         BufferFloat[j++] = pixels[i + 1] / 255;
142:         BufferFloat[j++] = pixels[i + 2] / 255;
143:       }
144: 
145:       r({ BufferFloat, Texture: texture });
146:     });
147:   });
148:   // decompress into the buffer
149:   // result = tjDecompress2(tjhandle, jpegBuf, jpegSize, buffer, jpegWidth, 0, jpegHeight, TJPF_RGB, TJFLAG_BOTTOMUP);
150: }
