10:  * `c->BodyPart[]` / `c->Weapon[]` kit - the guards, doppelgangers and helper
11:  * NPCs the original dresses inline. Every one of them wears a single armour
12:  * set across all five slots, so the kit names it once by its items.json
13:  * index.
14:  */
15: export type NpcGear = {
16:   /** `c->Class`; also the rig `updateBodyPartClassesAsync` falls back to. */
17:   readonly charClass: CharacterClassNumber;
18:   readonly playerClass: PlayerClass;
19:   /** items.json index shared by helm/armor/pants/gloves/boots. */
20:   readonly set: number;
21:   /** `c->BodyPart[].Level`. */
22:   readonly level?: number;
23:   /**
24:    * Set when the original reaches the helm model directly rather than through
25:    * a named item (`MODEL_BODY_HELM + n`) and items.json has no such row.
26:    */
27:   readonly noHelm?: boolean;
28:   /** `c->Weapon[0]` - the main hand (AppearanceSystem's `leftHand` slot). */
29:   readonly mainHand?: Item | null;
30:   /** `c->Weapon[1]` - the off hand. */
31:   readonly offHand?: Item | null;
32:   /** `c->Wing` (group 12). */
33:   readonly wings?: Item | null;
34:   /** `c->Helper` (group 13): the Dark Lord's mount. */
35:   readonly pet?: Item | null;
36:   readonly scale?: number;
37: };
38: 
39: const cache = new Map<NpcGear, typeof PlayerObject>();
40: 
41: export function gearedNpcFactory(gear: NpcGear): typeof PlayerObject {
42:   const cached = cache.get(gear);
43:   if (cached) return cached;
44: 
45:   const { charClass, set, level: lvl, noHelm } = gear;
46:   const part = (group: number): Item => ({ group, num: set, lvl });
47: 
48:   class GearedNpc extends PlayerObject {
49:     static NpcClass = charClass;
50: 
51:     static {
52:       GearedNpc.OverrideScale = gear.scale ?? -1;
53:     }
54: 
55:     constructor(scene: Scene, parent: TransformNode) {
56:       super(scene, parent);
57: 
58:       this.playerClass = gear.playerClass;
59:     }
60: 
61:     async init(world: World, entity: Entity) {
62:       this.load(await loadGLTF('Player/player.glb', world));
63:       this.Ready = false;
64: 
65:       world.addComponent(entity, 'charAppearance', {
66:         charClass,
67:         helm: noHelm ? null : part(ItemGroups.Helm),
68:         armor: part(ItemGroups.Armor),
69:         pants: part(ItemGroups.Pants),
70:         gloves: part(ItemGroups.Gloves),
71:         boots: part(ItemGroups.Boots),
72:         leftHand: gear.mainHand ?? null,
73:         rightHand: gear.offHand ?? null,
74:         wings: gear.wings ?? null,
75:         pet: gear.pet ?? null,
76:         changed: true,
77:       });
78: 
79:       this.startNpcIdle();
80:       world.removeComponent(entity, 'monsterAnimation');
81:       // A player rig walks with the player state machine (AnimationSystem's
82:       // SetPlayerStop / SetPlayerWalk port): idle here, PLAYER_WALK_* when the
83:       // server walks the NPC, back to idle when the path ends.
84:       if (!entity.playerAnimation) {
85:         world.addComponent(entity, 'playerAnimation', {
86:           action: PlayerAction.PLAYER_SET,
87:           run: 0,
88:         });
89:       }
90: 
91:       this.Ready = true;
92:     }
93:   }
