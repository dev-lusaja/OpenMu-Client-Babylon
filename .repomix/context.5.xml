 399:   }
 400: `);
 401: 
 402:         writer.write(`
 403:   constructor(buffer?: DataView){
 404:     buffer && (this.buffer = buffer);
 405:   }
 406: `);
 407: 
 408:         writer.write(`
 409:   writeHeader(){
 410:     const b = this.buffer;
 411:     b.setUint8(0, ${packet.name}Packet.HeaderCode);
 412:     b.setUint8(${packet.name}Packet.DataOffset, ${packet.name}Packet.Code);
 413:   ${hasSubCode ? `b.setUint8(${packet.name}Packet.DataOffset + 1, ${packet.name}Packet.SubCode);` : ''}
 414:     return this;
 415:   }
 416: `);
 417: 
 418:         // TODO: check that size is big endian!
 419:         writer.write(`
 420:   writeLength(l: number|undefined = ${packet.name}Packet.Length){
 421:     const b = this.buffer;
 422:     l = l ?? b.byteLength;
