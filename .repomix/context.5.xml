   1: import { Vector3 } from '../libs/babylon/exports';
   2: import type { Scene } from '../libs/babylon/exports';
   3: import type { Entity } from '../ecs/world';
   4: import { lighting } from '../lighting';
   5: import { combat } from '../combat';
   6: import { weather } from '../weather';
   7: import { effects, type EffectHandle } from '../effects';
   8: import { bonePos, delay, entityGone, entityPos, entityYaw, followEntity, fxNow, type PointSource, type RGB } from '../effects/core';
   9: import type { SpriteOptions } from '../effects/sprite';
  10: import type { ModelOptions } from '../effects/model';
  11: import type { RingOptions } from '../effects/ring';
  12: import type { ParticlesOptions } from '../effects/particles';
  13: import type { ProjectileOptions } from '../effects/projectile';
  14: import type { JointOptions } from '../effects/joint';
  15: import type { AuraOptions } from '../effects/aura';
  16: import {
  17:   ARC_MOTES,
  18:   BLOOD_CHIPS,
  19:   BLOOD_MIST,
  20:   BOMB_SPARKS,
  21:   DUST,
  22:   ENERGY_CHIPS,
  23:   FIRE_PUFF,
  24:   FIRE_SPARKS,
  25:   FLAME_TONGUES,
  26:   HOLY_MOTES,
  27:   ICE_MOTES,
  28:   MODEL,
  29:   NOVA_MOTES,
  30:   POISON_SMOKE,
  31:   RGBS,
  32:   SHADE_MOTES,
  33:   SMOKE,
  34:   SNOWFALL,
  35:   SOUL_MOTES,
  36:   SPARKS,
  37:   STEEL_GLINTS,
  38:   TEX,
  39:   VENOM_MOTES,
  40:   WIND_STREAKS,
  41:   EXPLOSION_CELLS,
  42: } from '../effects/recipes';
  43: import { ItemsDatabase } from './itemsDatabase';
  44: import { skillDefinition, type SkillDefinition } from './skillsDatabase';
  45: import { storeRef } from './storeRef';
  46: 
  47: /**
  48:  * Skill → visual recipe. The **consumer** of the effects layer
  49:  * : every row in `SKILL_VISUALS` is a handful of
  50:  * `effects.spawn(...)` calls at the four moments a skill has - `cast` at the
  51:  * caster's hands, `travel` from caster to target (a projectile whose arrival
  52:  * fires `impact`), `impact` at the target, `area` at the ground point. A
  53:  * skill with no row falls back on its type (`fallbackFor`), so nothing is
  54:  * clip-only. `BUFF_VISUALS` is the persistent look of a MagicEffectStatus
  55:  * effect, kept per entity until the server cancels it.
  56:  *
  57:  * The rows follow the original's per-skill spawn table (ZzzCharacter.cpp
  58:  * `AT_SKILL_*` impact block, `AttackStage` charge stages, WSclient.cpp
  59:  * `ReceiveMagic` cast spawns; ZzzEffect.cpp `CreateEffect` / `CreateParticle`
  60:  * / `CreateJoint`): each row cites the MODEL_* / BITMAP_* it stands in for,
  61:  * lifetimes are the original's 25 Hz ticks ÷ 25, distances its centimetres
  62:  * ÷ 100, `Light` tints are the colours. Light is not decided here:
  63:  * `lighting/skills.ts` owns `SKILL_LIGHTS` and is called alongside.
  64:  */
  65: 
  66: // ---- units ------------------------------------------------------------------
  67: 
  68: /** One original tick, seconds (LifeTime is counted in these). */
  69: const TICK = 0.04;
  70: /** Ticks → seconds. */
  71: const ticks = (n: number): number => n * TICK;
  72: /** Centimetres → tiles (`TILE_CM`, common/terrain/consts.ts). */
  73: const cm = (n: number): number => n / 100;
  74: /** A per-tick `Direction` in cm → tiles/s. */
  75: const perTick = (n: number): number => (n * 25) / 100;
  76: 
  77: // ---- heights (tiles above the feet) --------------------------------------------
  78: 
  79: /** The caster's hands. */
  80: const CAST_HEIGHT = 1.1;
  81: /** A target's chest, where bolts hit. */
  82: const IMPACT_HEIGHT = 0.9;
  83: /** The weapon hand's bone (MU index; the original's `weaponBone` on a wizard staff). */
  84: const WEAPON_BONE = 37;
  85: /** Arrows: `o->Direction[1] = -70` cm a tick (ZzzEffect.cpp:1795), 17.5 tiles/s. */
  86: const ARROW_SPEED = perTick(70);
  87: /** A slash sweep: from -60° to +60° of the caster's yaw at this reach. */
  88: const SLASH_REACH = 0.9;
  89: const SLASH_SECONDS = 0.35;
  90: /** Hit particles per impact. */
  91: const HIT_COUNT = 14;
  92: /** Triple Shot's fan: ±15°; the five-arrow masters ±5/10/20. */
  93: const TRIPLE_SPREAD = (15 * Math.PI) / 180;
  94: const FIVE_SPREAD = [-20, -10, 0, 10, 20].map(d => (d * Math.PI) / 180);
  95: /**
  96:  * Evil Spirit's spirit stamps, newest first. A subtract removes `texel x colour` and the material
  97:  * clamps that term at 1, so one stamp can never take more of the frame than its own sheet does -
  98:  * and the sheet is mid grey. The original gets its black spirits by stamping a fresh MODEL_LASER
  99:  * every frame along a path that moves 0.7 tiles a tick, so consecutive stamps overlap and the
 100:  * subtraction compounds; the echoes here do the same. The last two fade, which is the display
 101:  * persistence the stamps' one-tick life leans on.
 102:  */
 103: const SPIRIT_ECHOES = [1, 1, 0.85, 0.6];
 104: /** The violet sheen over the black spirit: the same skull drawn additive on top of its own cut-out. */
 105: const SPIRIT_GLOW: RGB = [0.3, 0.07, 0.45];
 106: /** The siphon thread pulled off the cast's victim: dimmer than the spirits' own violet. */
 107: const SPIRIT_SIPHON: RGB = [0.6, 0.14, 0.95];
 108: /** Persistent-buff ribbons: the original's five MODEL_SPEARSKILL joints. */
 109: const BUFF_RIBBONS = 5;
 110: 
 111: // ---- step helpers ---------------------------------------------------------------
 112: 
 113: export interface SkillContext {
 114:   scene: Scene;
 115:   caster: Entity;
 116:   target: Entity | null;
 117:   /** The caster's yaw, radians. */
 118:   yaw: number;
 119: }
 120: 
 121: /** One thing to spawn at a point. Returns the handle so a `seq` can chain. */
 122: export type Step = (at: Vector3, ctx: SkillContext) => EffectHandle | void;
 123: 
 124: const sprite = (o: SpriteOptions): Step => (at, c) => effects.spawn('sprite', c.scene, at, o);
 125: const particles = (o: ParticlesOptions): Step => (at, c) => effects.spawn('particles', c.scene, at, o);
 126: const model = (o: ModelOptions): Step => (at, c) => effects.spawn('model', c.scene, at, o);
 127: const ring = (o: RingOptions): Step => (at, c) => effects.spawn('ring', c.scene, at, o);
 128: const seq = (...steps: Step[]): Step => (at, c) => {
 129:   for (const s of steps) s(at, c);
 130: };
 131: /** `step`, but at the caster instead of the point. */
 132: const atCaster = (step: Step, height = CAST_HEIGHT): Step => (_at, c) =>
 133:   step(entityPos(c.caster, height, new Vector3()), c);
 134: /** `step`, `n` times around `at` within `radius` tiles, staggered by `every` seconds. */
 135: const scatter = (step: Step, n: number, radius: number, every = 0): Step => (at, c) => {
 136:   for (let i = 0; i < n; i++) {
 137:     const a = (i / n) * Math.PI * 2 + Math.random();
 138:     const r = radius * (0.3 + Math.random() * 0.7);
 139:     const p = new Vector3(at.x + Math.cos(a) * r, at.y, at.z + Math.sin(a) * r);
 140:     if (every > 0 && i > 0) delay(i * every, () => step(p, c));
 141:     else step(p, c);
 142:   }
 143: };
 144: /** `step` at `n` points on a ring of `radius` tiles, evenly spaced (CreateInferno's 45° bombs). */
 145: const ringOf = (step: Step, n: number, radius: number, every = 0): Step => (at, c) => {
 146:   for (let i = 0; i < n; i++) {
 147:     const a = (i / n) * Math.PI * 2;
 148:     const p = new Vector3(at.x + Math.cos(a) * radius, at.y, at.z + Math.sin(a) * radius);
 149:     if (every > 0 && i > 0) delay(i * every, () => step(p, c));
 150:     else step(p, c);
 151:   }
 152: };
 153: /**
 154:  * `step` again after `seconds` - on the effects clock (`effects/core.ts`
 155:  * `delay`), never `setTimeout`: a warp or a death resets the layer and the
 156:  * pending step with it.
 157:  */
 158: const after = (seconds: number, step: Step): Step => (at, c) => {
 159:   const p = at.clone();
 160:   delay(seconds, () => step(p, c));
 161: };
 162: /** `step` `n` times, `every` seconds apart (a per-frame spawn over a few frames). */
 163: const repeat = (n: number, every: number, step: Step): Step => (at, c) => {
 164:   for (let i = 0; i < n; i++) {
 165:     const p = at.clone();
 166:     if (i === 0) step(p, c);
 167:     else delay(i * every, () => step(p, c));
 168:   }
 169: };
 170: /**
 171:  * The facing convention: `transform.rot.y` is `atan2(dz, dx) + π/2`
 172:  * (skillCastSystem / logic.ts), so the forward vector is (sin yaw, −cos yaw)
 173:  * - the same one deathSystem and the debris entry use.
 174:  */
 175: const forwardOf = (yaw: number): { x: number; z: number } => ({ x: Math.sin(yaw), z: -Math.cos(yaw) });
 176: /** `step`, offset from `at` by `forward` tiles along the caster's facing and `side` tiles to its right, `up` tiles higher. */
 177: const offset = (step: Step, forward: number, up = 0, side = 0): Step => (at, c) => {
 178:   const f = forwardOf(entityYaw(c.caster));
 179:   const p = new Vector3(
 180:     at.x + f.x * forward - f.z * side,
 181:     at.y + up,
 182:     at.z + f.z * forward + f.x * side
 183:   );
 184:   step(p, c);
 185: };
 186: /** The caster's facing as a unit vector (+ `turn` radians). */
 187: const facing = (c: SkillContext, turn = 0): Vector3 => {
 188:   const f = forwardOf(entityYaw(c.caster) + turn);
 189:   return new Vector3(f.x, 0, f.z);
 190: };
 191: /** Toward `to` from `at`, flat, unit. */
 192: const toward = (at: Vector3, to: Vector3): Vector3 => {
 193:   const d = new Vector3(to.x - at.x, 0, to.z - at.z);
 194:   return d.lengthSquared() > 1e-6 ? d.normalize() : new Vector3(0, 0, 1);
 195: };
 196: /** Follow a point `forward` tiles ahead of the caster at `height`. */
 197: const ahead = (caster: Entity, forward: number, height: number): PointSource => out => {
 198:   entityPos(caster, height, out);
 199:   const f = forwardOf(entityYaw(caster));
 200:   out.x += f.x * forward;
 201:   out.z += f.z * forward;
 202:   return out;
 203: };
 204: /** A point that leaves the caster along its facing at `speed` tiles/s (a MODEL with `Direction`). */
 205: const flying = (c: SkillContext, height: number, speed: number, turn = 0, startForward = 0): PointSource => {
 206:   const start = entityPos(c.caster, height, new Vector3());
 207:   const dir = facing(c, turn);
 208:   start.x += dir.x * startForward;
 209:   start.z += dir.z * startForward;
 210:   const t0 = fxNow();
 211:   return out => {
 212:     const t = fxNow() - t0;
 213:     return out.set(start.x + dir.x * speed * t, start.y, start.z + dir.z * speed * t);
 214:   };
 215: };
 216: /** Orbit the caster at `radius` tiles, `height` up, `rate` radians/s (negative = clockwise). */
 217: const orbiting = (caster: Entity, radius: number, height: number, rate: number, phase: number): PointSource => {
 218:   const t0 = fxNow();
 219:   return out => {
 220:     const a = phase + rate * (fxNow() - t0);
 221:     entityPos(caster, height, out);
 222:     out.x += Math.cos(a) * radius;
 223:     out.z += Math.sin(a) * radius;
 224:     return out;
 225:   };
 226: };
 227: /** The caster's weapon bone. */
 228: const weaponBone = (caster: Entity): PointSource => out => bonePos(caster, WEAPON_BONE, out, CAST_HEIGHT);
 229: /** A blur trail swept in front of the caster (CreateWeaponBlur on the weapon bone). */
 230: const slash = (colour: RGB = RGBS.steel, texture: string = TEX.swordBlur, reach = SLASH_REACH): Step => (_at, c) => {
 231:   const t0 = fxNow();
 232:   const sweep = (height: number, radius: number): PointSource => out => {
 233:     const p = Math.min(1, (fxNow() - t0) / SLASH_SECONDS);
 234:     const f = forwardOf(entityYaw(c.caster) + (p - 0.5) * (Math.PI * 2) / 3);
 235:     entityPos(c.caster, height + (0.5 - p) * 0.4, out);
 236:     out.x += f.x * radius;
 237:     out.z += f.z * radius;
 238:     return out;
 239:   };
 240:   effects.spawn('blur', c.scene, Vector3.Zero(), {
 241:     follow: sweep(1.1, reach),
 242:     base: sweep(0.9, reach * 0.35),
 243:     colour,
 244:     texture,
 245:     seconds: SLASH_SECONDS,
 246:   });
 247: };
 248: 
 249: /**
 250:  * The caster's weapon model file, for the skills the original renders the
 251:  * weapon BMD as the effect (RenderWheelWeapon: MODEL_SKILL_WHEEL,
 252:  * MODEL_SKILL_FURY_STRIKE). Null when the hands are empty or unknown.
 253:  */
 254: function weaponModelOf(e: Entity): string | null {
 255:   const app = e.charAppearance;
 256:   const part = app?.rightHand ?? app?.leftHand ?? null;
 257:   if (!part) return null;
 258:   const item = ItemsDatabase.getItem(part.group, part.num);
 259:   return item ? item.szModelFolder + item.szModelName : null;
 260: }
 261: 
 262: // ---- impact / cast building blocks -------------------------------------------------
 263: 
 264: const hitSparks = (recipe = SPARKS, count = HIT_COUNT): Step => particles({ recipe, count });
 265: const flash = (texture: string, colour: RGB, size = 1, seconds = 0.4): Step =>
 266:   sprite({ texture, colour, size, seconds, grow: 1.6, growFrom: 0.4, fadeTail: 0.5 });
 267: /** MODEL_STONE1 / MODEL_STONE2 chips thrown up from a ground hit - either model, rolled per chip (ZzzEffect.cpp:280). */
 268: const stones = (n: number, radius = 0.6): Step =>
 269:   scatter(
 270:     (at, c) => model({ model: Math.random() < 0.5 ? MODEL.stone : MODEL.stone2, seconds: 1, colour: RGBS.gold, rise: 2.5, spin: 6, scale: 0.7 })(at, c),
