1734: export function playBowShotVisual(scene: Scene, shooter: Entity, target: Entity): void {
1735:   const launcher = combat.equippedLauncher(shooter.charAppearance);
1736:   if (!launcher || entityGone(shooter) || entityGone(target)) return;
