170: /** True while the pet slot holds a Horn of Uniria or Dinorant. */
171: export function isRidingMount(item: Item | null | undefined): boolean {
172:   return petSpec(item)?.kind === 'mount';
173: }
174: 
175: /**
176:  * `c->Helper.Type` reduced to the four values every skill switch of the
177:  * original tests for (`MODEL_HORN_OF_UNIRIA` / `_DINORANT` / `_FENRIR` /
178:  * `MODEL_DARK_HORSE_ITEM`). `null` means on foot - and so does a safe zone,
179:  * because each of those branches is written `&& !c->SafeZone`: the caller
180:  * passes `inSafeZone` and gets the on-foot clip back inside town.
181:  */
182: export type MountKind = 'uniria' | 'dinorant' | 'horse' | 'fenrir';
183: 
184: export function mountKind(
185:   item: Item | null | undefined,
186:   inSafeZone = false
187: ): MountKind | null {
188:   if (!item || item.group !== PET_GROUP || inSafeZone) return null;
189:   switch (item.num) {
190:     case HORN_OF_UNIRIA:
191:       return 'uniria';
192:     case HORN_OF_DINORANT:
193:       return 'dinorant';
194:     case DARK_HORSE:
195:       return 'horse';
196:     case HORN_OF_FENRIR:
197:       return 'fenrir';
198:     default:
199:       return null;
200:   }
201: }
202: 
203: /** Mount clip indices (`SetAction(o, n)` in GOBoid.cpp:494-556). */
204: export const MOUNT_ACTION_STAND = 0;
205: export const MOUNT_ACTION_MOVE = 2;
206: 
207: /** fenril_*.bmd clips (_define.h:508-513). */
208: export const FENRIR_ACTION_STAND = 0;
209: export const FENRIR_ACTION_WALK = 1;
210: export const FENRIR_ACTION_RUN = 2;
211: export const FENRIR_ACTION_ATTACK = 3;
212: export const FENRIR_ACTION_SKILL = 4;
213: export const FENRIR_ACTION_DAMAGE = 5;
214: 
215: /**
216:  * The Fenrir half of `MoveMount` (GOBoid.cpp:200-266): which of its own six
217:  * clips the wolf plays under a given rider action, and the `o->Velocity` it
218:  * runs it at - attack / skill / damage mirror the rider, anything else falls
219:  * back to standing.
220:  */
221: export function fenrirMountAction(rider: number): {
222:   action: number;
223:   playSpeed: number;
224: } {
225:   const A = PlayerAction;
226:   if (
227:     (rider >= A.PLAYER_FENRIR_ATTACK && rider <= A.PLAYER_FENRIR_ATTACK_BOW) ||
228:     rider === A.PLAYER_SKILL_CHAIN_LIGHTNING_FENRIR ||
229:     rider === A.PLAYER_SKILL_LIGHTNING_ORB_FENRIR ||
230:     rider === A.PLAYER_SKILL_DRAIN_LIFE_FENRIR ||
231:     rider === A.PLAYER_RAGE_FENRIR_ATTACK_RIGHT
232:   ) {
233:     return { action: FENRIR_ACTION_ATTACK, playSpeed: 0.4 };
234:   }
235:   if (
236:     (rider >= A.PLAYER_FENRIR_SKILL &&
237:       rider <= A.PLAYER_FENRIR_SKILL_ONE_LEFT) ||
238:     (rider >= A.PLAYER_RAGE_FENRIR && rider <= A.PLAYER_RAGE_FENRIR_ONE_LEFT)
239:   ) {
240:     return { action: FENRIR_ACTION_SKILL, playSpeed: 0.4 };
241:   }
242:   if (
243:     (rider >= A.PLAYER_FENRIR_DAMAGE &&
244:       rider <= A.PLAYER_FENRIR_DAMAGE_ONE_LEFT) ||
245:     (rider >= A.PLAYER_RAGE_FENRIR_DAMAGE &&
246:       rider <= A.PLAYER_RAGE_FENRIR_DAMAGE_ONE_LEFT)
247:   ) {
248:     return { action: FENRIR_ACTION_DAMAGE, playSpeed: 0.4 };
249:   }
250:   if (
251:     (rider >= A.PLAYER_FENRIR_WALK && rider <= A.PLAYER_FENRIR_WALK_ONE_LEFT) ||
252:     (rider >= A.PLAYER_RAGE_FENRIR_WALK &&
253:       rider <= A.PLAYER_RAGE_FENRIR_WALK_TWO_SWORD)
254:   ) {
255:     return { action: FENRIR_ACTION_WALK, playSpeed: 1.0 };
256:   }
257:   if (
258:     (rider >= A.PLAYER_FENRIR_RUN &&
259:       rider <= A.PLAYER_FENRIR_RUN_ONE_LEFT_ELF) ||
260:     (rider >= A.PLAYER_RAGE_FENRIR_RUN &&
261:       rider <= A.PLAYER_RAGE_FENRIR_RUN_ONE_LEFT)
262:   ) {
263:     return { action: FENRIR_ACTION_RUN, playSpeed: 0.6 };
264:   }
265:   return { action: FENRIR_ACTION_STAND, playSpeed: 0.4 };
266: }
