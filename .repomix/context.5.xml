 383: /**
 384:  * The swarm feeding: a thin violet thread from whatever the cast landed on
 385:  * back to the caster, with shade motes lifting off the victim for as long as
 386:  * the spirits are up. Drain Life (214) is the same vocabulary. Nothing at all
 387:  * when the cast hit bare ground, which is most casts.
 388:  *
 389:  * `c.target` is the object standing on the cast point (`logic.ts objectOnTile`),
 390:  * the only victim the client is told about - the rest of the swarm's hits are
 391:  * the server's business and never reach the client as such.
 392:  */
 393: const siphonFrom = (seconds: number): Step => (_at, c) => {
 394:   const victim = c.target;
 395:   if (!victim || victim === c.caster || !victim.transform) return;
 396:   // Latches at the last seen spot: a despawned victim's `entityPos` is the
 397:   // map origin, and the thread would whip across the map to reach it.
 398:   const held = entityPos(victim, IMPACT_HEIGHT, new Vector3());
 399:   const from: PointSource = out =>
 400:     entityGone(victim) ? out.copyFrom(held) : out.copyFrom(entityPos(victim, IMPACT_HEIGHT, held));
 401:   // Low jitter and a scrolling sheet: a bolt's zigzag reads as lightning, and
 402:   // this has to look drawn *out* of the body, not struck into it - the scroll
 403:   // is what sells the direction.
 404:   effects.spawn('joint', c.scene, held.clone(), {
 405:     from,
 406:     to: followEntity(c.caster, CAST_HEIGHT),
 407:     colour: SPIRIT_SIPHON,
 408:     seconds,
 409:     width: 0.34,
 410:     jitter: 0.02,
 411:     segments: 8,
 412:     texture: TEX.jointSpirit,
 413:     textureRepeats: 3,
 414:     textureScroll: 1.2,
 415:     until: () => entityGone(c.caster),
 416:   });
 417:   effects.spawn('particles', c.scene, held.clone(), { recipe: SHADE_MOTES, rate: 14, seconds, follow: from });
 418: };
