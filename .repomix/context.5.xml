47:     // A missing model must not strand the trigger - the box is what the click
48:     // ray actually hits, so it stays live either way.
49:     try {
50:       await this.loadSpecificModel(model);
51:     } catch {
52:       this.Ready = true;
53:     }
54:   }
55: 
56:   /**
57:    * File inside `objectDir`; the numbered default suits every map but
58:    * Lorencia. Null for a type whose model the data does not ship.
59:    */
60:   protected modelName(): string | null {
61:     return `Object${(this.Type + 1).toString().padStart(2, '0')}.glb`;
62:   }
63: 
64:   protected boxHeight(): number {
