15: /**
16:  * `CreateOperate(o)` + `o->HiddenMesh = -2`: a click target with no visible
17:  * body.
18:  *
19:  * The original loads the model like any other object and simply never draws
20:  * it - `Draw_RenderObject` (ZzzObject.cpp:390) gates the whole body on
21:  * `HiddenMesh != -2`, so it is visible only in the map editor. Setting
22:  * `HiddenMesh` to `HIDDEN_MESH_ALL` reproduces that: the meshes load, leave
23:  * the render list, cast no shadow, and `UpdateBoundings` uses the fixed box
24:  * below rather than whatever the mesh happens to measure.
25:  *
26:  * Used by Noria 38, the healing spot, which keeps the default box height.
27:  */
28: export class OperateBoxObject extends ModelObject {
29:   async init() {
30:     this.HiddenMesh = HIDDEN_MESH_ALL;
31:     this.CastsShadow = false;
32: 
33:     const height = this.boxHeight();
34: 
35:     this.FixedBoundingBox = {
36:       min: new Vector3(-BOX_HALF, 0, -BOX_HALF),
37:       max: new Vector3(BOX_HALF, height, BOX_HALF),
38:     };
