292: /** True while the lit materials compile the stepped sun. */
293: export function toonRampActive(): boolean {
294:   return toon.active;
295: }
296: 
297: /** True while the textures compile flat tones. */
298: export function toonFlatActive(): boolean {
299:   return toon.flat;
300: }
301: 
302: /** True while the grass blades compile their outline. */
303: export function toonGrassActive(): boolean {
304:   return toon.grass;
305: }
306: 
307: /** True while the ink pass flattens and contours the effects. */
308: export function toonEffectsActive(): boolean {
309:   return toon.effects;
310: }
311: 
312: /** True while the lit materials compile the Ultra extras. */
313: export function toonUltraActive(): boolean {
314:   return toon.ultra;
315: }
316: 
317: /** The band count the snapshot holds, for the passes. */
318: export function toonBands(): number {
319:   return toon.bands;
320: }
321: 
322: /** Where the grass outline starts along the blade, root 0 to tip 1, for the shader text. */
323: export function grassInkStart(): number {
324:   return toon.grassStart;
325: }
326: 
327: /** How dark the ink lines are, 0..1, from its slider. */
328: export function inkDarkness(): number {
329:   return toon.inkDarkness;
330: }
331: 
332: /** How wide the ink lines are in G-buffer texels at the reference height, from its slider. */
333: export function inkWidth(): number {
334:   return toon.inkWidth;
335: }
336: 
337: /** Which side of a silhouette the lines sit on: 1 inside, 0 across, -1 outside. */
338: export function inkSide(): number {
339:   return toon.inkSide;
340: }
341: 
342: /** The ground and grass shaders' defines for the style; empty when off. */
343: export function toonTerrainDefines(): string[] {
344:   return [
345:     ...(toon.flat ? ['#define MU_TOON_FLAT'] : []),
346:     ...(toon.grass ? ['#define MU_TOON_GRASS'] : []),
347:   ];
348: }
349: 
350: /**
351:  * Per draw. The rim and the Ultra highlight are the figures' own; a prop
352:  * takes the ramp and the hatching alone.
353:  */
354: export function bindToon(effect: Effect, characterAsset: boolean): void {
355:   if (toon.active) {
356:     effect.setFloat4(
357:       TOON_UNIFORM,
358:       toon.bands,
359:       toon.soft,
360:       characterAsset ? toon.rim : 0,
361:       toon.rimEdge
362:     );
363:   }
364: 
365:   if (toon.ultra) {
366:     effect.setFloat4(
367:       TOON_ULTRA_UNIFORM,
368:       characterAsset ? toon.glint : 0,
369:       toon.glintPower,
370:       toon.hatch,
371:       toon.hatchPeriod
372:     );
373:   }
374: 
375:   bindToonFilter(effect);
376: }
377: 
378: /** Per draw, for anything that compiles `MU_TOON_FLAT` or `MU_TOON_GRASS`. */
379: export function bindToonFilter(effect: Effect): void {
380:   if (!toon.flat && !toon.grass) return;
381: 
382:   effect.setFloat4(
383:     TOON_FILTER_UNIFORM,
384:     toon.texBias,
385:     toon.texLevels,
386:     toon.grassInk,
387:     toon.inkWidth * toon.inkPixel
388:   );
389: }
390: 
391: /**
392:  * The band, threshold and flat-tone helpers, compiled under the style
393:  * defines. Each eases its edge over `soft` pixels of screen-space change
394:  * (fwidth), so a boundary is one antialiased line; they must be called from
395:  * uniform control flow.
396:  */
397: export function toonFunctionsGlsl(): string {
398:   return `
399:   #if defined(MU_TOON) || defined(MU_TOON_FLAT) || defined(MU_TOON_GRASS)
400:   // Nearest of \`bands\` levels over [0, 1]. The edge width is capped at half
401:   // a band so the ramp stays continuous where floor() steps.
402:   float muToonBands(float x, float bands, float soft) {
403:     float s = max(bands - 1.0, 1.0);
404:     float v = clamp(x, 0.0, 1.0) * s;
405:     float i = floor(v);
406:     float w = clamp(fwidth(v) * soft, 1e-4, 0.5);
407:     return (i + smoothstep(0.5 - w, 0.5 + w, v - i)) / s;
408:   }
409: 
410:   float muToonStep(float x, float edge, float soft) {
411:     float w = max(fwidth(x) * soft, 1e-4);
412:     return smoothstep(edge - w, edge + w, x);
413:   }
414:   #endif
415: 
416:   #ifdef MU_TOON_FLAT
417:   // Flat tones: the texel's luminance snapped to a few levels, hue kept.
418:   vec3 muToonFlat(vec3 c, float levels) {
419:     float l = dot(c, vec3(0.299, 0.587, 0.114));
420:     float q = muToonBands(l, levels, 1.0);
421:     return l > 1e-4 ? c * (q / l) : c;
422:   }
423:   #endif
424: `;
425: }
426: 
427: /**
428:  * The flat-tone resample of one texture, for a Standard-path hook: the art
429:  * read again with the mip bias and snapped to its levels. \`guard\` is the
430:  * define the sampler and its UV live under.
431:  */
432: export function toonTextureGlsl(
433:   sampler: string,
434:   uv: string,
435:   target: string,
436:   guard: string
437: ): string {
438:   return `
439:   #ifdef MU_TOON_FLAT
440:   #ifdef ${guard}
441:     ${target} = muToonFlat(texture2D(${sampler}, ${uv}, ${TOON_FILTER_UNIFORM}.x).rgb, ${TOON_FILTER_UNIFORM}.y);
442:   #endif
443:   #endif
444: `;
445: }
