<file path="src/band/bandSender.ts">
 1: import { BAND_LIMITS, encodeBatch, type BandMidiEvent } from '../common/bandProtocol';
 2: 
 3: /**
 4:  * Turns the sequencer's send windows into wire batches: numbers them,
 5:  * splits one that outgrows a frame, re-bases each piece's `dt`, and keeps
 6:  * the rate under what the proxy allows - so only a modified client ever
 7:  * meets the relay's limits.
 8:  */
 9: export class BandSender {
10:   private seq = 0;
11:   private readonly stamps: number[] = [];
12:   private droppedForRate = 0;
13: 
14:   constructor(
15:     private readonly send: (frame: Uint8Array) => void,
16:     private readonly now: () => number = () => performance.now()
17:   ) {}
18: 
19:   /** A new performance: the sequence starts over. */
20:   reset(): void {
21:     this.seq = 0;
22:     this.stamps.length = 0;
23:   }
24: 
25:   /** Batches the sender refused to send in this performance because they would have breached the rate. */
26:   get dropped(): number {
27:     return this.droppedForRate;
28:   }
29: 
30:   /** One send window: `dt`s are relative to `baseMs`. */
31:   push(baseMs: number, events: readonly BandMidiEvent[]): void {
32:     for (let i = 0; i < events.length; i += BAND_LIMITS.maxEventsPerBatch) {
33:       const chunk = events.slice(i, i + BAND_LIMITS.maxEventsPerBatch);
34:       const first = chunk[0].dt;
35:       const rebased = chunk.map(e => ({ ...e, dt: Math.min(1000, Math.max(0, e.dt - first)) }));
36:       this.sendBatch(baseMs + first, rebased);
37:     }
38:   }
39: 
40:   private sendBatch(baseMs: number, events: BandMidiEvent[]): void {
41:     const now = this.now();
42:     while (this.stamps.length && now - this.stamps[0] > 1000) this.stamps.shift();
43:     if (this.stamps.length >= BAND_LIMITS.clientBatchesPerSecond) {
44:       this.droppedForRate++;
45:       return;
46:     }
47:     this.stamps.push(now);
48:     this.send(encodeBatch(this.seq, baseMs, events));
49:     this.seq = (this.seq + 1) & 0xffff;
50:   }
51: }
</file>

