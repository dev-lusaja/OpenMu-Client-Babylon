<file path="src/combat/inputGate.ts">
 1: /**
 2:  * The `MouseUpdateTime` / `MouseUpdateTimeMax` input gate
 3:  * (ZzzInterface.cpp:92-93, :7510-7791): the original polls the mouse for a
 4:  * new attack / move only every `MouseUpdateTimeMax` reference ticks, and a
 5:  * swing that fires (`Action()`, :3341) opens the gate immediately so the
 6:  * next click is honoured on the very next poll. Nothing else gates a basic
 7:  * attack - the swing clip is restarted, not waited for.
 8:  *
 9:  * Driven by `attackSystem` (consumes / forces the gate); read by
10:  * `attackSystem` and `skillCastSystem` before they accept a click.
11:  */
12: import type { ENUM_WORLD } from '../common/types';
13: import { REFERENCE_FPS } from '../common/playSpeed';
14: import type { CombatLayer } from './layer';
15: 
16: // ---- 1. tuning -------------------------------------------------------------
17: 
18: /** `MouseUpdateTimeMax = 6` reference ticks at 25 Hz: the default poll gap. */
19: const MOUSE_UPDATE_TICKS_MAX = 6;
20: 
21: /** The same gap in seconds - 0.24 s, the swing-rate floor of the todo. */
22: export const MOUSE_UPDATE_SECONDS_MAX = MOUSE_UPDATE_TICKS_MAX / REFERENCE_FPS;
23: 
24: // ---- 2. state + readers ----------------------------------------------------
25: 
26: /** Seconds since the gate was last consumed; starts open. */
27: let sinceConsumed = MOUSE_UPDATE_SECONDS_MAX;
28: 
29: /** `MouseUpdateTime >= MouseUpdateTimeMax`: a click may be acted on now. */
30: export function inputGateOpen(): boolean {
31:   return sinceConsumed >= MOUSE_UPDATE_SECONDS_MAX;
32: }
33: 
34: /** Seconds until the gate opens again, 0 when open. */
35: export function inputGateRemaining(): number {
36:   return Math.max(0, MOUSE_UPDATE_SECONDS_MAX - sinceConsumed);
37: }
38: 
39: /** Command: `MouseUpdateTime = 0` - a click was acted on. */
40: export function consumeInputGate(): void {
41:   sinceConsumed = 0;
42: }
43: 
44: /** Command: `MouseUpdateTime = MouseUpdateTimeMax` - a swing fired, poll again next frame. */
45: export function forceInputGate(): void {
46:   sinceConsumed = MOUSE_UPDATE_SECONDS_MAX;
47: }
48: 
49: function update(_map: ENUM_WORLD, dt: number): void {
50:   if (sinceConsumed < MOUSE_UPDATE_SECONDS_MAX) sinceConsumed += dt;
51: }
52: 
53: function reset(): void {
54:   sinceConsumed = MOUSE_UPDATE_SECONDS_MAX;
55: }
56: 
57: // ---- 3. the layer ----------------------------------------------------------
58: 
59: export const inputGateLayer: CombatLayer = {
60:   name: 'inputGate',
61:   update,
62:   reset,
63: };
</file>

<file path="src/combat/layer.ts">
 1: import type { ENUM_WORLD } from '../common/types';
 2: 
 3: /**
 4:  * The contract every combat-timing entry implements. One file per entry, one
 5:  * exported `CombatLayer` per file, listed once in `layers.ts`. Copy `_template.ts` for the recipe.
 6:  *
 7:  * Entries own the client-side *timing* of fighting - the swing latch, the
 8:  * input gate, the skill re-use delays, a held charge, a multi-hit streak.
 9:  * They never send packets on their own initiative and never touch the
10:  * scene: the ECS systems that fight (`attackSystem`, `skillCastSystem`) read
11:  * these entries and do the sending. The layer is only the *lifecycle*.
12:  */
13: export interface CombatLayer {
14:   /** Unique camelCase, identical to the file name. */
15:   readonly name: string;
16: 
17:   /** Maps this entry exists on. Omit for every map. */
18:   readonly maps?: ReadonlySet<ENUM_WORLD>;
19: 
20:   /**
21:    * Stepped once a frame, in `layers.ts` order, before any consumer reads
22:    * the combat state. `dt` is seconds. Must be cheap: no allocation, no
23:    * scene walk.
24:    */
25:   update?(map: ENUM_WORLD, dt: number): void;
26: 
27:   /** The map changed (or the hero died / left): drop every latch and timer. */
28:   reset?(): void;
29: }
</file>

