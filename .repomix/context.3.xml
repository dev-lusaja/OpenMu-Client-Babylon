282: /* ----------------------------------------------------------------- ticket */
283: 
284: let held: Ticket | null = null;
285: 
286: /** A ticket this close to expiring is exchanged before it is used, not after it fails. */
287: const TICKET_MARGIN_MS = 30_000;
288: 
289: /**
290:  * The ticket: the nonce this page put on its game socket's URL, exchanged
291:  * through the service for a signed name. Held in a module variable rather
292:  * than the state: nothing draws it, and an observable copy of a credential
293:  * is one more place it lives.
294:  */
295: async function ensureTicket(fresh = false, signal?: AbortSignal): Promise<Ticket> {
296:   if (!fresh && held && held.expiresAt - Date.now() > TICKET_MARGIN_MS) return held;
297: 
298:   try {
299:     held = await request<Ticket>('/session', {
300:       method: 'POST',
301:       body: JSON.stringify({ session: sessionNonce() }),
302:       signal,
303:     });
304:   } catch (error) {
305:     held = null;
306: 
307:     // The caller gave up, not the service: leave the identity as it was.
308:     if (signal?.aborted) throw error;
309: 
310:     // 403 is "the proxy has no login on that socket": the service's own
311:     // sentence says so. Anything unreachable gets the shop's plain one.
312:     const reason = error instanceof ShopError ? error.message : t('cashShop.unconfirmed');
313: 
314:     runInAction(() => {
315:       CashShopState.account = null;
316:       CashShopState.unconfirmed = reason;
317:     });
318: 
319:     throw new Unconfirmed(reason);
320:   }
321: 
322:   const { account } = held;
323: 
324:   runInAction(() => {
325:     CashShopState.account = account;
326:     CashShopState.unconfirmed = null;
327:   });
328: 
329:   return held;
330: }
331: 
332: /**
333:  * A request that carries the ticket: in the query for a GET, in the body for
334:  * a POST. One 401 means the ticket went stale between the check above and
335:  * the service's clock, and is cured by exchanging once and trying again; a
336:  * second one is refused like any other answer.
337:  *
338:  * A POST is a spend - an order placed or cancelled - so it carries the
339:  * session nonce beside the ticket. The ticket says who this page was; the
340:  * nonce lets the service ask the proxy whether that socket is still logged
341:  * in as them right now, which a ticket lifted from somewhere cannot answer.
342:  */
343: async function ticketed<T>(
344:   path: string,
345:   method: 'GET' | 'POST',
346:   body: Record<string, unknown> = {},
347:   signal?: AbortSignal
348: ): Promise<T> {
349:   let ticket = await ensureTicket(false, signal);
350: 
351:   for (let attempt = 0; ; attempt++) {
352:     try {
353:       if (method === 'GET') {
354:         return await request<T>(`${path}?ticket=${encodeURIComponent(ticket.ticket)}`, { signal });
355:       }
356: 
357:       return await request<T>(path, {
358:         method,
359:         body: JSON.stringify({ ...body, ticket: ticket.ticket, session: sessionNonce() }),
360:         signal,
361:       });
362:     } catch (error) {
363:       if (attempt === 0 && error instanceof ShopError && error.status === 401) {
364:         ticket = await ensureTicket(true, signal);
365:         continue;
366:       }
367: 
368:       throw error;
369:     }
370:   }
371: }
