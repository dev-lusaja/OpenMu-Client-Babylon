<file path="src/camera/mouseLook.ts">
 1: /**
 2:  * First-person mouse look: the pointer lock, and the raw mouse deltas it
 3:  * hands back to the facade.
 4:  *
 5:  * The lock is what makes the look unbounded - without it the cursor walks
 6:  * into the window edge a quarter turn in. It costs the game its cursor
 7:  * position: while the lock is held the browser freezes `clientX/clientY` at
 8:  * wherever the pointer was when it was taken, and only `movementX/Y` are
 9:  * live. So every pick in the game has to aim at the middle of the canvas
10:  * instead, which is what `aimX`/`aimY` do - the systems that pick (pointer
11:  * input, cursor, the walk click) run their coordinates through them, and the
12:  * on-screen cursor parks itself there, crosshair-style.
13:  *
14:  * `index.ts` stays the single writer of the camera angles: this module only
15:  * reports how far the mouse moved.
16:  */
17: 
18: import { EventBus } from '../libs/eventBus';
19: 
20: let canvasElement: HTMLCanvasElement | null = null;
21: 
22: let locked = false;
23: 
24: /** Whether the mouse is looking right now (the pointer lock is held). */
25: export function isMouseLookActive(): boolean {
26:   return locked;
27: }
28: 
29: /**
30:  * Where a pick aims: the crosshair while the look is locked, the pointer's
31:  * own position otherwise. Canvas-relative, the space `scene.pick` reads.
32:  */
33: export function aimX(clientX: number): number {
34:   return locked && canvasElement ? canvasElement.clientWidth / 2 : clientX;
35: }
36: 
37: export function aimY(clientY: number): number {
38:   return locked && canvasElement ? canvasElement.clientHeight / 2 : clientY;
39: }
40: 
41: function setLocked(value: boolean): void {
42:   if (locked === value) return;
43: 
44:   locked = value;
45:   EventBus.emit('mouseLookChanged', value);
46: }
47: 
48: /**
49:  * Take the lock on the next canvas click while `canLook` holds, and feed
50:  * `onLook` the mouse deltas for as long as it is held. Escape gives it back
51:  * (the browser's own way out); `releaseMouseLook` is the game's.
52:  */
53: export function installMouseLook(
54:   canvas: HTMLCanvasElement | null,
55:   canLook: () => boolean,
56:   onLook: (dx: number, dy: number) => void
57: ): void {
58:   if (!canvas) return;
59: 
60:   canvasElement = canvas;
61: 
62:   // A lock needs a user gesture, so the click that asks for it is the same
63:   // one that swings - which is what a first-person game does anyway.
64:   canvas.addEventListener('pointerdown', () => {
65:     if (locked || !canLook()) return;
66: 
67:     // Chrome rate-limits a re-lock for about a second after Escape released
68:     // one, and rejects the promise; nothing to do but wait for the next
69:     // click.
70:     const request = canvas.requestPointerLock() as unknown as
71:       Promise<void> | undefined;
72: 
73:     request?.catch(() => {});
74:   });
75: 
76:   document.addEventListener('pointerlockchange', () => {
77:     setLocked(document.pointerLockElement === canvas);
78:   });
79: 
80:   document.addEventListener('pointerlockerror', () => setLocked(false));
81: 
82:   document.addEventListener('mousemove', ev => {
83:     if (!locked) return;
84: 
85:     onLook(ev.movementX, ev.movementY);
86:   });
87: }
88: 
89: /** Give the lock back: zoomed out of first person, or left the world. */
90: export function releaseMouseLook(): void {
91:   if (locked) document.exitPointerLock();
92: }
</file>

