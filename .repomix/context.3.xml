<file path="src/camera/heroBody.ts">
 1: /**
 2:  * The hero's body, hidden while the camera sits inside it (first person and
 3:  * the step or two before it).
 4:  *
 5:  * Same effect as `HiddenMesh = HIDDEN_MESH_ALL` (`common/modelObject.ts`),
 6:  * but reversible and applied at runtime: `isVisible` goes off, so world
 7:  * matrices keep updating and nameplates, effect anchors and the pick ray are
 8:  * unaffected - which `setEnabled(false)` would not give.
 9:  *
10:  * Only meshes this module hid are restored, so a part that was already hidden
11:  * for its own reason (an operate box, a stowed weapon) stays hidden.
12:  */
13: 
14: import type { AbstractMesh, TransformNode } from '../libs/babylon/exports';
15: import { HERO_RESCAN_SECONDS } from './recipes';
16: 
17: const hidden: AbstractMesh[] = [];
18: 
19: let node: TransformNode | null = null;
20: let sinceScan = 0;
21: 
22: function scan(root: TransformNode): void {
23:   for (const mesh of root.getChildMeshes(false)) {
24:     if (!mesh.isVisible) continue;
25: 
26:     mesh.isVisible = false;
27:     hidden.push(mesh);
28:   }
29: }
30: 
31: /**
32:  * Hide the model rooted at `root`, and keep it hidden: equipment and wings
33:  * are sub-models of the same node and can finish loading later, so the list
34:  * is re-scanned on a cadence rather than every frame.
35:  */
36: export function hideHeroBody(root: TransformNode, dt: number): void {
37:   if (node !== root) {
38:     showHeroBody();
39:     node = root;
40:     sinceScan = HERO_RESCAN_SECONDS;
41:   }
42: 
43:   sinceScan += dt;
44:   if (sinceScan < HERO_RESCAN_SECONDS) return;
45: 
46:   sinceScan = 0;
47:   scan(root);
48: }
49: 
50: /** Restore every mesh this module hid. Safe to call when nothing is hidden. */
51: export function showHeroBody(): void {
52:   for (const mesh of hidden) {
53:     if (!mesh.isDisposed()) mesh.isVisible = true;
54:   }
55: 
56:   hidden.length = 0;
57:   node = null;
58: }
</file>

