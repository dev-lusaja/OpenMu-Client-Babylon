260: async function request<T>(path: string, init?: RequestInit): Promise<T> {
261:   // Read per call, not once at load: which world is being played decides whose
262:   // shop this is, and that is not known when this module is first evaluated.
263:   const response = await fetch(`${shopApiUrl()}${path}`, {
264:     // Nothing here is cookie-authenticated, and asking for credentials on a
265:     // cross-origin call would only add a CORS requirement for no gain. The
266:     // ticket rides in the body or the query string for the same reason: the
267:     // preflight allows no header but Content-Type.
268:     credentials: 'omit',
269:     headers: { 'Content-Type': 'application/json' },
270:     ...init,
271:   });
272: 
273:   const body = await response.json().catch(() => ({}));
274: 
275:   if (!response.ok) {
276:     throw new ShopError((body as { error?: string }).error ?? `HTTP ${response.status}`, response.status);
277:   }
278: 
279:   return body as T;
280: }
