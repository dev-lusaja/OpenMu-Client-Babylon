  1: import { EventBus } from '../libs/eventBus';
  2: import { Store } from '../store';
  3: import { Social } from '../social';
  4: import { t, type TextKey } from '../i18n';
  5: import {
  6:   BAND_VERSION,
  7:   BandSub,
  8:   RefuseCause,
  9:   StopReason,
 10:   decodeRelayFrame,
 11:   encodeBandState,
 12:   encodeJoin,
 13:   encodeLeave,
 14:   encodeStart,
 15:   encodeStop,
 16: } from '../common/bandProtocol';
 17: import { instrumentById, instrumentByIndex, instrumentIndex } from '../common/instruments';
 18: import {
 19:   Band,
 20:   masterStateChanged,
 21:   memberChanged,
 22:   refused,
 23:   remoteBandState,
 24:   remoteBatch,
 25:   remoteStart,
 26:   remoteStop,
 27:   setBandAvailable,
 28:   setBandTransport,
 29:   stoppedByProxy,
 30:   type BandTransport,
 31: } from '../common/band';
 32: import { BandSender } from './bandSender';
 33: 
 34: /**
 35:  * The band system's one wire listener, and the transport it hands the
 36:  * facade. Inbound: the proxy's `BandRelay` frames (C1 FA) - a performer in
 37:  * scope starting, stopping, sending notes, a band changing, or a notice
 38:  * meant for this client. Outbound: the facade's start / stop / batch / join
 39:  * / leave / state, as frames through `Store.sendBandFrame`, only once the
 40:  * proxy has said hello - a proxy without the relay would forward the code
 41:  * to the game server, which is nobody's business.
 42:  *
 43:  * Installed once from `logic.ts`. Everything it knows about instruments it
 44:  * reads off the registry; everything it does with them goes through the
 45:  * facade.
 46:  */
 47: 
 48: const STOP_TEXT: Partial<Record<number, TextKey>> = {
 49:   [StopReason.Flood]: 'instrument.stopped.flood',
 50:   [StopReason.Order]: 'instrument.stopped.order',
 51:   [StopReason.Gone]: 'instrument.stopped.gone',
 52: };
 53: 
 54: const REFUSE_TEXT: Partial<Record<number, TextKey>> = {
 55:   [RefuseCause.Cooldown]: 'instrument.refused.cooldown',
 56:   [RefuseCause.Busy]: 'instrument.refused.busy',
 57:   [RefuseCause.Full]: 'instrument.refused.full',
 58:   [RefuseCause.Range]: 'instrument.refused.range',
 59:   [RefuseCause.Map]: 'instrument.refused.map',
 60:   [RefuseCause.NotPerforming]: 'instrument.refused.notPerforming',
 61:   [RefuseCause.Rate]: 'instrument.refused.rate',
 62: };
 63: 
 64: let installed = false;
 65: 
 66: function nameOf(netId: number): string {
 67:   return Store.world?.getByNetId(netId)?.objectNameInWorld ?? `#${netId}`;
 68: }
 69: 
 70: export function installBandNet(): void {
 71:   if (installed) return;
 72:   installed = true;
 73: 
 74:   const sender = new BandSender(frame => Store.sendBandFrame(frame));
 75:   const online = () => Band.available && !Store.isOffline;
 76: 
 77:   const transport: BandTransport = {
 78:     start(instrument) {
 79:       if (!online()) return;
 80:       sender.reset();
 81:       Store.sendBandFrame(encodeStart(instrument));
 82:     },
 83:     stop() {
 84:       if (!online()) return;
 85:       Store.sendBandFrame(encodeStop());
 86:     },
 87:     batch(baseMs, events) {
 88:       if (!online()) return;
 89:       sender.push(baseMs, events);
 90:     },
 91:     join(masterId, instrument, channelMask) {
 92:       if (!online()) return;
 93:       Store.sendBandFrame(encodeJoin(masterId, instrument, channelMask));
 94:     },
 95:     leave() {
 96:       if (!online()) return;
 97:       Store.sendBandFrame(encodeLeave());
 98:     },
 99:     state(masterMask, members) {
100:       if (!online()) return;
101:       Store.sendBandFrame(
102:         encodeBandState(
103:           masterMask,
104:           members.map(m => ({ id: m.netId, instrument: instrumentIndex(m.instrument), mask: m.channelMask }))
105:         )
106:       );
107:     },
108:   };
109:   setBandTransport(transport);
110: 
111:   // The hello arrives on the game socket. Availability is tied to that
112:   // socket, not to "a socket closed": the connect-server socket is shut
113:   // after the game socket opens, and its close can land after the hello.
114:   let helloSocket: WebSocket | null = null;
115: 
116:   EventBus.on('wsClosed', ({ socket }) => {
117:     if (socket !== helloSocket) return;
118:     helloSocket = null;
119:     setBandAvailable(false);
120:   });
121: 
122:   EventBus.on('BandRelay', view => {
123:     const msg = decodeRelayFrame(new Uint8Array(view.buffer, view.byteOffset, view.byteLength));
124:     if (!msg) return;
125: 
126:     if (msg.sub === BandSub.Hello) {
127:       helloSocket = Store.gsSocket ?? null;
128:       setBandAvailable(msg.version === BAND_VERSION);
129:       console.info(`band: relay hello, version ${msg.version} (this client speaks ${BAND_VERSION})`);
130:       return;
131:     }
132: 
133:     const self = Store.playerId ?? -1;
134: 
135:     if (msg.performerId === self) {
136:       // A notice about this client's own performance.
137:       if (msg.sub === BandSub.Stop) {
138:         const key = STOP_TEXT[msg.reason];
139:         if (key) Social.systemMessage(t(key));
140:         stoppedByProxy();
141:       } else if (msg.sub === BandSub.Refused) {
142:         const key = REFUSE_TEXT[msg.cause] ?? 'instrument.refused.busy';
143:         const text = t(key, { seconds: msg.arg });
144:         Social.systemMessage(text);
145:         refused(key);
146:       } else if (msg.sub === BandSub.Join) {
147:         // Someone joined the hero's band: the stamped id is the joiner's.
148:       }
149:       return;
150:     }
151: 
152:     const world = Store.world;
153:     if (!world) return;
154: 
155:     switch (msg.sub) {
156:       case BandSub.Start: {
157:         const def = instrumentByIndex(msg.instrument);
158:         if (!def) {
159:           console.warn(`band: #${msg.performerId} starts playing an instrument this client does not know: ignored`);
160:           return;
161:         }
162:         // The entity may not be drawn yet: the proxy relays the start the
163:         // instant the tracker sees the performer in scope, which can beat the
164:         // scope packet's own render here. The sound plays by net id regardless
165:         // and the pose attaches when the entity arrives, so never drop it.
166:         const entity = world.getByNetId(msg.performerId);
167:         const seen = entity && !entity.objOutOfScope ? entity : null;
168:         console.info(
169:           `band: #${msg.performerId} ${nameOf(msg.performerId)} starts playing the ${def.id}${seen ? '' : ' (not in view yet)'}`
170:         );
171:         remoteStart(msg.performerId, def.id, seen);
172:         Social.systemMessage(t('instrument.startsPlaying', { name: nameOf(msg.performerId), instrument: t(def.labelKey) }));
173:         return;
174:       }
175:       case BandSub.Stop: {
176:         const known = world.getByNetId(msg.performerId)?.performing;
177:         console.info(`band: #${msg.performerId} stopped, reason ${msg.reason}${known ? '' : ' (was not playing here)'}`);
178:         remoteStop(msg.performerId);
179:         if (known && msg.reason === StopReason.Ended) {
180:           Social.systemMessage(t('instrument.stopsPlaying', { name: nameOf(msg.performerId) }));
181:         }
182:         return;
183:       }
184:       case BandSub.Batch:
185:         remoteBatch(msg.performerId, msg.seq, msg.baseMs, msg.events);
186:         return;
187:       case BandSub.Join: {
188:         // The joiner is the stamped id. The proxy sends a join only to the
189:         // master it names, with the master's own local id in the body (the
190:         // joiner knew them by their public one), so any other id is a stray.
191:         if (msg.masterId !== self) return;
192:         const def = instrumentByIndex(msg.instrument);
193:         if (!def) return;
194:         memberChanged({ netId: msg.performerId, instrument: def.id, channelMask: msg.mask }, msg.performerId);
195:         Social.systemMessage(t('instrument.joinsBand', { name: nameOf(msg.performerId), master: t('instrument.you') }));
196:         return;
197:       }
198:       case BandSub.Leave:
199:         if (Band.role === 'master') {
200:           memberChanged(null, msg.performerId);
201:           Social.systemMessage(t('instrument.leavesBand', { name: nameOf(msg.performerId) }));
202:         }
203:         return;
204:       case BandSub.BandState: {
205:         const members = msg.members
206:           .map(m => {
207:             const def = instrumentByIndex(m.instrument);
208:             return def ? { netId: m.id, instrument: def.id, channelMask: m.mask } : null;
209:           })
210:           .filter((m): m is NonNullable<typeof m> => m !== null);
211:         if (Band.role === 'member' && Band.band?.masterId === msg.performerId) {
212:           masterStateChanged(msg.performerId, members);
213:         }
214:         remoteBandState(msg.performerId, members);
215:         return;
216:       }
217:       case BandSub.ChannelNames:
218:         return;
219:     }
220:   });
221: }
