  1: /**
  2:  * THE FACADE - the original client's main-scene camera, behind the
  3:  * `cameraControl` option. Copy `_template.ts` to add a map override.
  4:  *
  5:  * Ported from CameraUtility.cpp / SceneCommon.cpp: Ctrl+wheel steps the
  6:  * discrete distance levels (opening mid-range), Insert/Delete rotate the
  7:  * heading, pitch -48.5, vertical FOV 30 unless the FOV slider says otherwise.
  8:  * Ctrl+middle-button drag is the web
  9:  * client's addition: left/right rotates the heading, up/down pitches the
 10:  * view. Home is taken by the MU Helper hot key, so the frame resets on warp
 11:  * instead. `layers.ts` holds the per-map overrides.
 12:  *
 13:  * The ladder in `recipes.ts` extends past the ported five at both ends: the
 14:  * steps below 1000 blend the ported geometry toward an eye-level shot and
 15:  * the innermost one is first person, where the hero's body is hidden and,
 16:  * with the `wsadMovement` option on, the mouse looks around under a pointer
 17:  * lock (`mouseLook.ts`) - at every zoom level if `thirdPersonMouseLook` says
 18:  * so. The eye rises and falls with the hero's stride there too, unless
 19:  * `firstPersonBob` is off.
 20:  *
 21:  * Single writer of alpha/beta/radius/fov, and of the target's Y lift, while
 22:  * the option is on and the game is in the World state; `cameraFollowSystem`
 23:  * is the only caller.
 24:  * Option off: the classic framing captured at install is restored once and
 25:  * the camera is never touched again.
 26:  */
 27: 
 28: import type { ENUM_WORLD } from '../common/types';
 29: import type { ArcRotateCamera, TransformNode } from '../libs/babylon/exports';
 30: import { GameOptions } from '../common/gameOptions';
 31: import { EventBus } from '../libs/eventBus';
 32: import type { CameraLayer } from './layer';
 33: import { CAMERA_LAYERS } from './layers';
 34: import { hideHeroBody, showHeroBody } from './heroBody';
 35: import {
 36:   installMouseLook,
 37:   isMouseLookActive,
 38:   releaseMouseLook,
 39: } from './mouseLook';
 40: import {
 41:   BOB_EASE,
 42:   BOB_JUMP_MU,
 43:   BOB_RISE_MU,
 44:   BOB_STRIDE_MU,
 45:   BOB_WALK_MIN,
 46:   CAMERA_PITCH_DEG,
 47:   CLOSE_BAND_MU,
 48:   DEFAULT_CAMERA_LEVEL,
 49:   DEFAULT_HEADING_DEG,
 50:   DISTANCE_BY_LEVEL,
 51:   DISTANCE_EASE,
 52:   EYE_HEIGHT_MU,
 53:   FIRST_PERSON_MU,
 54:   FIRST_PERSON_NEAR_MU,
 55:   FIRST_PERSON_PITCH_LIMIT_DEG,
 56:   FIRST_PERSON_WIDEN_DEG,
 57:   HEIGHT_BACKOFF,
 58:   HERO_HIDE_MU,
 59:   MAX_CAMERA_LEVEL,
 60:   MIN_RADIUS_MU,
 61:   MOUSE_LOOK_DEG_PER_PX,
 62:   MU_SCALE,
 63:   PITCH_DRAG_DEG_PER_PX,
 64:   PITCH_OFFSET_MAX_DEG,
 65:   PITCH_OFFSET_MIN_DEG,
 66:   REFERENCE_FPS,
 67:   ROTATE_DRAG_DEG_PER_PX,
 68:   ROTATE_STEP_DEG,
 69: } from './recipes';
 70: 
 71: export type { CameraLayer } from './layer';
 72: export { showHeroBody } from './heroBody';
 73: export { aimX, aimY, isMouseLookActive, releaseMouseLook } from './mouseLook';
 74: 
 75: const RAD = Math.PI / 180;
 76: 
 77: const byWorld = new Map<ENUM_WORLD, CameraLayer>();
 78: 
 79: for (const layer of CAMERA_LAYERS) {
 80:   for (const world of layer.worlds) byWorld.set(world, layer);
 81: }
 82: 
 83: /** `g_shCameraLevel`, 0..4. */
 84: let level = DEFAULT_CAMERA_LEVEL;
 85: 
 86: /** `CameraAngle[2]`, degrees. */
 87: let headingDeg = DEFAULT_HEADING_DEG;
 88: 
 89: /**
 90:  * Drag pitch, degrees added to the ported frame's tilt. Zero is the
 91:  * original's fixed pitch; positive looks toward the horizon.
 92:  */
 93: let pitchOffsetDeg = 0;
 94: 
 95: /** `CameraDistance`, original units, eased toward the level's target. */
 96: let distance = DISTANCE_BY_LEVEL[DEFAULT_CAMERA_LEVEL];
 97: 
 98: let wroteCamera = false;
 99: 
100: let classic: {
101:   alpha: number;
102:   beta: number;
103:   radius: number;
104:   fov: number;
105:   minZ: number;
106: } | null = null;
107: 
108: /**
109:  * The level a map opens on. A layer's distance is the frame the original
110:  * client pinned that map to; here it only picks the opening step, so the
111:  * wheel still works once the player is standing there. The ladder holds
112:  * every pinned value exactly (1100 and 2000 are both steps), so the nearest
113:  * step is that frame, not an approximation of it.
114:  */
115: function openingLevelFor(world: ENUM_WORLD): number {
116:   const pinned = byWorld.get(world)?.distance;
117: 
118:   if (pinned === undefined) return DEFAULT_CAMERA_LEVEL;
119: 
120:   let best = DEFAULT_CAMERA_LEVEL;
121: 
122:   for (let i = 0; i < DISTANCE_BY_LEVEL.length; i++) {
123:     const closer =
124:       Math.abs(DISTANCE_BY_LEVEL[i] - pinned) <
125:       Math.abs(DISTANCE_BY_LEVEL[best] - pinned);
126: 
127:     if (closer) best = i;
128:   }
129: 
130:   return best;
131: }
132: 
133: /**
134:  * The camera is at the hero's eyes rather than behind their back - the same
135:  * band that hides the body, which is the point at which there is nothing left
136:  * on screen to orbit and the frame reads as a first-person one.
137:  */
138: export function isFirstPerson(): boolean {
139:   return GameOptions.cameraControl && distance < HERO_HIDE_MU;
140: }
141: 
142: /**
143:  * Whether the frame is one the mouse may hold the pointer lock in. Tied to
144:  * `wsadMovement` because the lock takes the cursor away and the walk keys are
145:  * what is left to move with; first person only, unless the player asked for
146:  * it in third person too. The World-state half of the gate is the caller's.
147:  */
148: function canMouseLook(): boolean {
149:   if (!GameOptions.wsadMovement) return false;
150: 
151:   return GameOptions.thirdPersonMouseLook
152:     ? GameOptions.cameraControl
153:     : isFirstPerson();
154: }
155: 
156: /**
157:  * Turn the view by a mouse movement, in pixels. Right and down are positive,
158:  * the way the browser reports them: right turns the view right, up pitches
159:  * toward the horizon. Shared by the middle-button drag and the first-person
160:  * look, which only differ in how many degrees a pixel is worth.
161:  */
162: function applyLook(
163:   dx: number,
164:   dy: number,
165:   headingDegPerPx: number,
166:   pitchDegPerPx: number
167: ): void {
168:   headingDeg -= dx * headingDegPerPx;
169:   pitchOffsetDeg -= dy * pitchDegPerPx;
170:   pitchOffsetDeg = Math.max(
171:     -FIRST_PERSON_PITCH_LIMIT_DEG,
172:     Math.min(FIRST_PERSON_PITCH_LIMIT_DEG, pitchOffsetDeg)
173:   );
174: }
175: 
176: /**
177:  * Install the input listeners and capture the classic framing to restore
178:  * when the option goes off. Once, from `cameraFollowSystem`'s factory -
179:  * before any system has moved the camera. `isActive` is the wiring's gate
180:  * (the World state), so this module stays store-free.
181:  */
182: export function installCameraControl(
183:   camera: ArcRotateCamera,
184:   isActive: () => boolean
185: ): void {
186:   classic = {
187:     alpha: camera.alpha,
188:     beta: camera.beta,
189:     radius: camera.radius,
190:     fov: camera.fov,
191:     minZ: camera.minZ,
192:   };
193: 
194:   const canvas = camera.getEngine().getRenderingCanvas();
195: 
196:   // SetViewPortLevel (SceneCommon.cpp:237-253): Ctrl+wheel, up zooms in.
197:   // Canvas only, so UI scroll areas keep their wheel; main.tsx already
198:   // preventDefaults the browser's Ctrl+wheel page zoom.
199:   window.addEventListener(
200:     'wheel',
201:     ev => {
202:       if (!ev.ctrlKey || ev.target !== canvas) return;
203:       if (!GameOptions.cameraControl || !isActive()) return;
204: 
205:       if (ev.deltaY < 0) level--;
206:       else if (ev.deltaY > 0) level++;
207: 
208:       level = Math.max(0, Math.min(MAX_CAMERA_LEVEL, level));
209:     },
210:     { passive: true }
211:   );
212: 
213:   // Ctrl + middle-button drag: left/right rotates the heading, up/down
214:   // pitches. Ctrl is only needed to start the drag; pointer capture keeps
215:   // it alive off-canvas until release.
216:   let dragPointer: number | null = null;
217:   let dragLastX = 0;
218:   let dragLastY = 0;
219: 
220:   if (canvas) {
221:     canvas.addEventListener('pointerdown', ev => {
222:       if (ev.button !== 1 || !ev.ctrlKey) return;
223:       if (!GameOptions.cameraControl || !isActive()) return;
224: 
225:       dragPointer = ev.pointerId;
226:       dragLastX = ev.clientX;
227:       dragLastY = ev.clientY;
228:       canvas.setPointerCapture(ev.pointerId);
229:       // Middle-button autoscroll would swallow the drag.
230:       ev.preventDefault();
231:     });
232: 
233:     canvas.addEventListener('pointermove', ev => {
234:       if (ev.pointerId !== dragPointer) return;
235: 
236:       applyLook(
237:         ev.clientX - dragLastX,
238:         ev.clientY - dragLastY,
239:         ROTATE_DRAG_DEG_PER_PX,
240:         PITCH_DRAG_DEG_PER_PX
241:       );
242:       dragLastX = ev.clientX;
243:       dragLastY = ev.clientY;
244:     });
245: 
246:     const endDrag = (ev: PointerEvent) => {
247:       if (ev.pointerId === dragPointer) dragPointer = null;
248:     };
249:     canvas.addEventListener('pointerup', endDrag);
250:     canvas.addEventListener('pointercancel', endDrag);
251:   }
252: 
253:   installMouseLook(
254:     canvas,
255:     () => isActive() && canMouseLook(),
256:     (dx, dy) => applyLook(dx, dy, MOUSE_LOOK_DEG_PER_PX, MOUSE_LOOK_DEG_PER_PX)
257:   );
258: 
259:   // World change resets the level (WSclient.cpp:600); heading, pitch and
260:   // distance snap with it so the new map opens on its own default frame.
261:   EventBus.on('warpCompleted', ({ map }) => {
262:     level = openingLevelFor(map);
263:     headingDeg = DEFAULT_HEADING_DEG;
264:     pitchOffsetDeg = 0;
265:     distance = DISTANCE_BY_LEVEL[level];
266:   });
267: }
268: 
269: /** Distance walked into the current stride, and how much bob is showing. */
270: let bobWalkedMu = 0;
271: let bobLevel = 0;
272: let bobLastX = 0;
273: let bobLastZ = 0;
274: let bobSeeded = false;
275: 
276: /**
277:  * The eye's rise and fall over a stride, in original units. Zero outside the
278:  * close band, with the option off, and while the hero is standing.
279:  *
280:  * `camera.target` is the hero's own position for the frame - the follow system
281:  * copies it in before this runs and only the Y lift below is ours - so the
282:  * walk is read from how far it moved rather than from movement state plumbed
283:  * through from the controller. That also means it covers every way the hero
284:  * travels, keys or click.
285:  */
286: function headBob(camera: ArcRotateCamera, close: number, dt: number): number {
287:   if (!GameOptions.firstPersonBob || close <= 0) {
288:     bobSeeded = false;
289:     bobLevel = 0;
290:     return 0;
291:   }
292: 
293:   const { x, z } = camera.target;
294: 
295:   if (!bobSeeded) {
296:     bobLastX = x;
297:     bobLastZ = z;
298:     bobSeeded = true;
299:   }
300: 
301:   const moved = Math.hypot(x - bobLastX, z - bobLastZ) * MU_SCALE;
302:   const walked = moved < BOB_JUMP_MU ? moved : 0;
303: 
304:   bobLastX = x;
305:   bobLastZ = z;
306: 
307:   const standing = dt <= 0 || walked / MU_SCALE / dt < BOB_WALK_MIN;
308: 
309:   bobLevel += ((standing ? 0 : 1) - bobLevel) * Math.min(1, BOB_EASE * dt);
310: 
311:   // Kept inside one stride: the phase is a distance that would otherwise grow
312:   // for the length of the session, and a float that large has no room left for
313:   // the centimetres this is made of.
314:   bobWalkedMu = (bobWalkedMu + walked) % BOB_STRIDE_MU;
315: 
316:   const phase = (bobWalkedMu / BOB_STRIDE_MU) * 2 * Math.PI;
317: 
318:   return Math.sin(phase) * BOB_RISE_MU * bobLevel * close;
319: }
320: 
321: /**
322:  * Per-frame write, after the follow target is set. `pressedKeys` is the
323:  * keyboard system's already-filtered set (no text-field keys in it);
324:  * `heroModel` is the local player's model node, hidden while the camera is
325:  * inside it.
326:  */
327: export function updateGameCamera(
328:   camera: ArcRotateCamera,
329:   world: ENUM_WORLD,
330:   pressedKeys: ReadonlySet<string>,
331:   heroModel: TransformNode | null,
332:   dt: number
333: ): void {
334:   // Zoomed back out, or an option went off under the lock: hand the pointer
335:   // back. The World-state half of the gate is the wiring's, which releases
336:   // the lock itself on the way out. Reads last frame's distance, which is a
337:   // frame the player spends still holding the mouse.
338:   if (isMouseLookActive() && !canMouseLook()) releaseMouseLook();
339: 
340:   if (!GameOptions.cameraControl) {
341:     if (wroteCamera && classic) {
342:       camera.alpha = classic.alpha;
343:       camera.beta = classic.beta;
344:       camera.radius = classic.radius;
345:       camera.fov = classic.fov;
346:       camera.minZ = classic.minZ;
347:       showHeroBody();
348:       wroteCamera = false;
349:     }
350:     return;
351:   }
352: 
353:   // Insert/Delete held: 15 degrees per reference frame (CameraUtility.cpp
354:   // :305-311), dt-scaled.
355:   const step = ROTATE_STEP_DEG * REFERENCE_FPS * dt;
356: 
357:   if (pressedKeys.has('Insert')) headingDeg += step;
358:   if (pressedKeys.has('Delete')) headingDeg -= step;
359:   headingDeg = ((headingDeg % 360) + 360) % 360 - 360;
360: 
361:   const layer = byWorld.get(world);
362:   const target = DISTANCE_BY_LEVEL[level];
363: 
364:   // CameraDistance += (target - CameraDistance) / 3 per 25 fps frame.
365:   distance += (target - distance) * (1 - Math.pow(1 - DISTANCE_EASE, dt * REFERENCE_FPS));
366: 
367:   // How far into the close band the eased distance sits: 0 at every ported
368:   // level and every step outside them, 1 at the eye. The ported geometry
369:   // breaks down under 150 units (the camera would sit on the ground, then
370:   // under it), so this is what carries the frame the rest of the way in.
371:   const close = Math.min(
372:     1,
373:     Math.max(0, (CLOSE_BAND_MU - distance) / (CLOSE_BAND_MU - FIRST_PERSON_MU))
374:   );
375: 
376:   // CalculateCameraPosition: back off distance*cos(pitch) horizontally and
377:   // sit distance-150 above the base height (the hero's ground, unless the
378:   // map pins it).
379:   const horizontal = distance * Math.cos(CAMERA_PITCH_DEG * RAD);
380:   let vertical = Math.max(0, distance - HEIGHT_BACKOFF);
381: 
382:   if (layer?.groundHeight !== undefined) {
383:     vertical += layer.groundHeight - camera.target.y * MU_SCALE;
384:   }
385: 
386:   // Closing in drops the camera to the target's own height while the target
387:   // rises from the hero's feet to their eyes, so the shot ends up looking
388:   // out of the head instead of down at it.
389:   vertical *= 1 - close;
390:   camera.target.y += (EYE_HEIGHT_MU * close + headBob(camera, close, dt)) / MU_SCALE;
391: 
392:   // The drag pitch orbits the ported frame around the target: same radius,
393:   // tilt added to beta, so offset 0 is the original's camera exactly. At the
394:   // eye the orbit clamp would stop the player looking up or down, so the
395:   // range opens with the band.
396:   const pitchMin =
397:     PITCH_OFFSET_MIN_DEG +
398:     (-FIRST_PERSON_PITCH_LIMIT_DEG - PITCH_OFFSET_MIN_DEG) * close;
399:   const pitchMax =
400:     PITCH_OFFSET_MAX_DEG +
401:     (FIRST_PERSON_PITCH_LIMIT_DEG - PITCH_OFFSET_MAX_DEG) * close;
402:   const pitch = Math.max(pitchMin, Math.min(pitchMax, pitchOffsetDeg));
403: 
404:   camera.radius =
405:     Math.max(MIN_RADIUS_MU, Math.hypot(horizontal, vertical)) / MU_SCALE;
406:   camera.beta = Math.atan2(horizontal, vertical) + pitch * RAD;
407:   camera.alpha = headingDeg * RAD;
408:   // The slider sets the frame the player picked and the eye widens over it,
409:   // so first person moves with the slider and the default still lands on
410:   // FIRST_PERSON_FOV_DEG.
411:   camera.fov =
412:     (GameOptions.cameraFov + FIRST_PERSON_WIDEN_DEG * close) * RAD;
413: 
414:   // Closing in walks the near plane out with the frame: at the eye it is what
415:   // keeps the hero's own aura and crackle - which emit around the body the
416:   // camera now sits in - out of the shot.
417:   if (classic) {
418:     camera.minZ =
419:       classic.minZ +
420:       (FIRST_PERSON_NEAR_MU / MU_SCALE - classic.minZ) * close;
421:   }
422: 
423:   wroteCamera = true;
424: 
425:   if (heroModel && distance < HERO_HIDE_MU) hideHeroBody(heroModel, dt);
426:   else showHeroBody();
427: }
</file>

