 59:   /** Add an entry at runtime (tools, experiments). Returns the unregister. */
 60:   register(layer: CombatLayer): () => void {
 61:     this.layers.push(layer);
 62:     return () => {
 63:       const i = this.layers.indexOf(layer);
 64:       if (i >= 0) this.layers.splice(i, 1);
 65:     };
 66:   }
