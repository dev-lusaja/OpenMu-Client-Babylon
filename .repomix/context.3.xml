<file path="src/combat/skillClips.ts">
  1: /**
  2:  * Which clip a cast plays. The `UseSkillWarrior` / `UseSkillWizard` /
  3:  * `UseSkillElf` / `UseSkillSummon` / `UseSkillRagefighter` switches, the
  4:  * `AttackKnight` / `AttackWizard` / `AttackCommon` branches and the
  5:  * `ReceiveMagic` / `ReceiveMagicContinue` ladders of the original are one
  6:  * table lookup over `recipes.ts` `SKILL_CLIPS`, plus the three things those
  7:  * switches decide at run time and a table cannot:
  8:  *
  9:  *  - the **mount** (`c->Helper.Type`, and always `&& !c->SafeZone`),
 10:  *  - the **map** - `AT_SKILL_RIDER` flies on Tarkan / Heaven / Maya,
 11:  *  - the two random picks (`rand_fps_check(2)` for the Rage Fighter party
 12:  *    buffs, `rand() % 2` for the male hand cast), which stay random.
 13:  *
 14:  * Readers only. Read by `common/skillCasting.chooseSkillAction`, which the
 15:  * hero's `skillCastSystem` and the remote `playCastAnimation` both go
 16:  * through, so everyone in scope plays the same clip for the same skill.
 17:  */
 18: import { PlayerAction } from '../common/objects/enum';
 19: import type { MountKind } from '../common/pets';
 20: import type { ENUM_WORLD } from '../common/types';
 21: import type { CombatLayer } from './layer';
 22: import {
 23:   MAGIC_CLIPS,
 24:   RAGE_BUFF_CLIPS,
 25:   RAGE_BUFF_SKILLS,
 26:   RIDER_CLIPS,
 27:   RIDER_FLY_WORLDS,
 28:   SKILL_CLIPS,
 29:   SKILL_RIDER,
 30: } from './recipes';
 31: 
 32: // ---- 1. tuning -------------------------------------------------------------
 33: 
 34: /**
 35:  * What the clip switches need to know about the caster. Everything here is
 36:  * one field of `CHARACTER` in the original: `Helper.Type` (already collapsed
 37:  * to `null` inside a safe zone by `mountKind`), `IsFemale(Class)`, and the
 38:  * active world.
 39:  */
 40: export type CastContext = {
 41:   /** `c->Helper.Type`, or `null` on foot / in a safe zone. */
 42:   readonly mount?: MountKind | null;
 43:   /** `gCharacterManager.IsFemale(c->Class)` - Elf *and* Summoner. */
 44:   readonly isFemale?: boolean;
 45:   /** `gMapManager.WorldActive`, for the one map-dependent clip. */
 46:   readonly world?: ENUM_WORLD;
 47:   /** `rand() % 2` for the male hand cast; the caller alternates it. */
 48:   readonly alternate?: boolean;
 49: };
 50: 
 51: // ---- 2. state + readers ----------------------------------------------------
 52: 
 53: /**
 54:  * `SetPlayerMagic` (ZzzCharacter.cpp:1238-1262): the generic cast clip a
 55:  * skill with no dedicated one falls back to. Uniria and Dinorant share one
 56:  * ride clip here - the four-way ladder is the castle-siege commands', not
 57:  * this - and the Dark Horse has no branch at all, so its rider keeps the
 58:  * hand clip.
 59:  */
 60: export function magicClip(ctx: CastContext = {}): PlayerAction {
 61:   switch (ctx.mount) {
 62:     case 'uniria':
 63:       return MAGIC_CLIPS.uniria;
 64:     case 'dinorant':
 65:       return MAGIC_CLIPS.dinorant;
 66:     case 'fenrir':
 67:       return MAGIC_CLIPS.fenrir;
 68:     default:
 69:       break;
 70:   }
 71:   if (ctx.isFemale) return MAGIC_CLIPS.female;
 72:   return MAGIC_CLIPS.male[ctx.alternate ? 1 : 0];
 73: }
 74: 
 75: /**
 76:  * The clip for a skill, or `null` when the skill has no dedicated clip and
 77:  * the generic rule (`magicClip` for a spell, the weapon swing for a physical
 78:  * skill) applies.
 79:  */
 80: export function skillClip(
 81:   skill: number,
 82:   ctx: CastContext = {}
 83: ): PlayerAction | null {
 84:   // The party buffs are the one skill family that picks its clip by coin
 85:   // toss rather than by caster (`rand_fps_check(2)`, :2866-2874).
 86:   if (RAGE_BUFF_SKILLS.has(skill)) {
 87:     return RAGE_BUFF_CLIPS[Math.random() < 0.5 ? 0 : 1];
 88:   }
 89: 
 90:   // Rider: the map decides, not the caster.
 91:   if (skill === SKILL_RIDER) {
 92:     return ctx.world !== undefined && RIDER_FLY_WORLDS.has(ctx.world)
 93:       ? RIDER_CLIPS.flying
 94:       : RIDER_CLIPS.ground;
 95:   }
 96: 
 97:   const set = SKILL_CLIPS[skill];
 98:   if (!set) return null;
 99:   if (ctx.mount) {
100:     const mounted = set[ctx.mount];
101:     if (mounted !== undefined) return mounted;
102:   }
103:   return set.ground;
104: }
105: 
106: /** Whether the skill has a dedicated clip (used to skip the alternate toggle). */
107: export function hasSkillClip(skill: number): boolean {
108:   return skill in SKILL_CLIPS || RAGE_BUFF_SKILLS.has(skill) || skill === SKILL_RIDER;
109: }
110: 
111: // ---- 3. the layer ----------------------------------------------------------
112: 
113: export const skillClipsLayer: CombatLayer = {
114:   name: 'skillClips',
115: };
</file>

<file path="src/combat/skillMovement.ts">
  1: /**
  2:  * What a cast does to where the hero *is*, as opposed to what it plays.
  3:  * Three separate rules of the original, none of which lived anywhere before:
  4:  *
  5:  *  - **stop** - every `UseSkill*` opens with `LetHeroStop()`
  6:  *    (ZzzInterface.cpp:1935): the path is dropped and a one-step move is sent
  7:  *    so the server puts the caster on the square he is standing on. A cast is
  8:  *    never taken mid-stride.
  9:  *  - **step in** - the Rage Fighter's contact skills relocate the caster to
 10:  *    the square one tile short of the target and send `InstantMoveRequest`
 11:  *    (`CMonkSystem::SendAttackPacket`, MonkSystem.cpp:445-485; the same maths
 12:  *    is inlined for Killing Blow / Occupy at ZzzInterface.cpp:2760-2780).
 13:  *    Beast Uppercut, Chain Drive and Dragon Slasher do it *mid-clip*, on the
 14:  *    consecutive-attack frame (`IsRageHalfwaySkillAni`), which is why they
 15:  *    read as a lunge; Killing Blow and Occupy do it as the cast starts.
 16:  *  - **root** - a clip that holds the caster's facing while it plays
 17:  *    (`bLookAtMouse = false`, :7394-7419). Everything else keeps turning to
 18:  *    the cursor.
 19:  *
 20:  * Rush (44) is the fourth skill that moves its caster, and the only one the
 21:  * client does nothing about: the server answers the cast with the new square,
 22:  * so it needs no row here.
 23:  *
 24:  * Readers only. Read by `skillCastSystem`, which owns the hero's path and yaw.
 25:  */
 26: import { PlayerAction } from '../common/objects/enum';
 27: import type { CombatLayer } from './layer';
 28: 
 29: // ---- 1. tuning -------------------------------------------------------------
 30: 
 31: /**
 32:  * `AT_SKILL_KILLING_BLOW` / `_STR` / `_MASTERY` and `AT_SKILL_OCCUPY`: the
 33:  * step lands as the cast is sent.
 34:  */
 35: const STEP_IN_ON_CAST: ReadonlySet<number> = new Set([260, 551, 554, 269]);
 36: 
 37: /**
 38:  * `CMonkSystem::IsRageHalfwaySkillAni` (MonkSystem.cpp:428-442): Beast
 39:  * Uppercut, Chain Drive and Dragon Slasher send their packet - and so take
 40:  * their step - on the consecutive-attack frame partway through the clip.
 41:  */
 42: const STEP_IN_MID_CLIP: ReadonlySet<number> = new Set([
 43:   261, 552, 555, // Beast Uppercut, Str, Mastery
 44:   262, 558, // Chain Drive, Str
 45:   265, // Dragon Slasher
 46: ]);
 47: 
 48: /**
 49:  * The animation key the mid-clip step fires on. `InitConsecutiveState` arms
 50:  * the check at 3.0 for every one of them (UseSkillRagefighter:2790-2830); the
 51:  * second window (7.0 / 12.0) is the follow-up blow, not a second step.
 52:  */
 53: export const CONSECUTIVE_ATTACK_KEY = 3;
 54: 
 55: /**
 56:  * Clips that hold the caster's facing for their whole length - the original
 57:  * skips the look-at-cursor update for them (`bLookAtMouse = false`,
 58:  * ZzzInterface.cpp:7394-7419). Rageful Blow spins in place, Chain Drive
 59:  * swings the target round, and Beast Uppercut / Dragon Slasher would
 60:  * otherwise snap away from the body they are throwing.
 61:  */
 62: const FACING_HELD_CLIPS: ReadonlySet<PlayerAction> = new Set([
 63:   PlayerAction.PLAYER_ATTACK_SKILL_FURY_STRIKE,
 64:   PlayerAction.PLAYER_SKILL_GIANTSWING,
 65: ]);
 66: 
 67: // ---- 2. state + readers ----------------------------------------------------
 68: 
 69: /**
 70:  * Whether the skill relocates the caster, and when. `null` = the caster
 71:  * stands still and only the clip plays.
 72:  */
 73: export function skillStepIn(skill: number): 'cast' | 'midClip' | null {
 74:   if (STEP_IN_ON_CAST.has(skill)) return 'cast';
 75:   if (STEP_IN_MID_CLIP.has(skill)) return 'midClip';
 76:   return null;
 77: }
 78: 
 79: /**
 80:  * The square a step-in lands on: one tile short of the target, along the
 81:  * line from the caster (`VectorNormalize` × `TERRAIN_SCALE`, subtracted from
 82:  * the target - MonkSystem.cpp:452-460). Returns `null` when caster and
 83:  * target share a square.
 84:  */
 85: export function stepInSquare(
 86:   from: { x: number; y: number },
 87:   target: { x: number; y: number }
 88: ): { x: number; y: number } | null {
 89:   const dx = target.x - from.x;
 90:   const dy = target.y - from.y;
 91:   const len = Math.hypot(dx, dy);
 92:   if (len < 1e-3) return null;
 93:   return { x: target.x - dx / len, y: target.y - dy / len };
 94: }
 95: 
 96: /** Whether the clip holds the caster's facing for its whole length. */
 97: export function clipHoldsFacing(clip: PlayerAction): boolean {
 98:   return FACING_HELD_CLIPS.has(clip);
 99: }
100: 
101: // ---- 3. the layer ----------------------------------------------------------
102: 
103: export const skillMovementLayer: CombatLayer = {
104:   name: 'skillMovement',
105: };
</file>

<file path="src/combat/weaponRange.ts">
 1: /**
 2:  * Basic-attack reach per weapon and the archer's ammunition check
 3:  * (`Action()` ZzzInterface.cpp:3283-3299, `CheckArrow()` :3148-3170):
 4:  * 1.8 tiles bare-handed or with a sword / axe / mace / staff, 2.2 with a
 5:  * spear, 6.0 with any bow or crossbow - and a bow needs arrows, a crossbow
 6:  * bolts, in the other hand with durability left.
 7:  *
 8:  * Pure readers over the hero's equipment; no per-frame state. Read by
 9:  * `attackSystem` (range + ammo gate) and `networkSystem`'s path truncation.
10:  */
11: import type { Item } from '../ecs/world';
12: import type { CombatLayer } from './layer';
13: 
14: // ---- 1. tuning -------------------------------------------------------------
15: 
16: /** `float Range = 1.8f`: melee reach in tiles, the flat default. */
17: export const MELEE_RANGE = 1.8;
18: 
19: /** Spears (`ITEM_SPEAR` group): 2.2 tiles. */
20: const SPEAR_RANGE = 2.2;
21: 
22: /** Any bow or crossbow (`BOWTYPE_NONE` excluded): 6 tiles. */
23: const RANGED_RANGE = 6;
24: 
25: /** Item groups (Item.group): 3 spear, 4 bow / crossbow / ammunition. */
26: const SPEAR_GROUP = 3;
27: const BOW_GROUP = 4;
28: 
29: /** `ITEM_BOLT` = group 4 index 7, `ITEM_ARROWS` = group 4 index 15. */
30: const BOLTS_INDEX = 7;
31: const ARROWS_INDEX = 15;
32: 
33: /** Bows are indices 0..7 of group 4 (minus the bolts), crossbows 8+ (minus the arrows). */
34: const FIRST_CROSSBOW_INDEX = 8;
35: 
36: // ---- 2. state + readers ----------------------------------------------------
37: 
38: export type Hands = { leftHand: Item | null; rightHand: Item | null } | undefined;
39: 
40: function isAmmo(item: Item | null): boolean {
41:   return (
42:     !!item &&
43:     item.group === BOW_GROUP &&
44:     (item.num === BOLTS_INDEX || item.num === ARROWS_INDEX)
45:   );
46: }
47: 
48: function isRangedWeapon(item: Item | null): item is Item {
49:   return !!item && item.group === BOW_GROUP && !isAmmo(item);
50: }
51: 
52: /** `BOWTYPE_CROSSBOW` for the launcher, `BOWTYPE_BOW` otherwise. */
53: function isCrossbow(weapon: Item): boolean {
54:   return weapon.num >= FIRST_CROSSBOW_INDEX;
55: }
56: 
57: /** The equipped launcher, if any. */
58: export function equippedLauncher(hands: Hands): Item | null {
59:   if (!hands) return null;
60:   if (isRangedWeapon(hands.leftHand)) return hands.leftHand;
61:   if (isRangedWeapon(hands.rightHand)) return hands.rightHand;
62:   return null;
63: }
64: 
65: /** Reach of a basic attack with these hands, in tiles. */
66: export function attackRange(hands: Hands): number {
67:   if (equippedLauncher(hands)) return RANGED_RANGE;
68:   const spear =
69:     (hands?.leftHand?.group === SPEAR_GROUP && !isAmmo(hands.leftHand)) ||
70:     (hands?.rightHand?.group === SPEAR_GROUP && !isAmmo(hands.rightHand));
71:   return spear ? SPEAR_RANGE : MELEE_RANGE;
72: }
73: 
74: /**
75:  * `CheckArrow()`: true when no launcher is equipped, or when the matching
76:  * ammunition sits in the other hand with durability left. A bow wants
77:  * arrows, a crossbow bolts. Unknown durability (offline test gear) counts
78:  * as loaded.
79:  */
80: export function hasAmmo(hands: Hands): boolean {
81:   const launcher = equippedLauncher(hands);
82:   if (!launcher || !hands) return true;
83:   const other = launcher === hands.leftHand ? hands.rightHand : hands.leftHand;
84:   if (!isAmmo(other)) return false;
85:   const wanted = isCrossbow(launcher) ? BOLTS_INDEX : ARROWS_INDEX;
86:   if (other!.num !== wanted) return false;
87:   return other!.durability === undefined || other!.durability > 0;
88: }
89: 
90: // ---- 3. the layer ----------------------------------------------------------
91: 
92: /** Readers only: nothing to step, nothing to drop. */
93: export const weaponRangeLayer: CombatLayer = {
94:   name: 'weaponRange',
95: };
</file>

<file path="src/commands.ts">
  1: import { t } from './i18n';
  2: import { action, makeObservable, observable, runInAction } from 'mobx';
  3: import { Store } from './store';
  4: import { Social, INVITE_RANGE_TILES } from './social';
  5: import { Economy } from './economy';
  6: import { Messenger } from './messenger';
  7: import type { Entity } from './ecs/world';
  8: import type { CommandKind } from './common/chatCommands';
  9: import { GuildRelationshipTypeEnum } from './common/packets/ClientToServerPackets';
 10: import { GuildMemberRoleEnum } from './common/packets/ServerToClientPackets';
 11: import {
 12:   DuelStartRequestPacket,
 13:   DuelStopRequestPacket,
 14: } from './common/packets/ClientToServerPackets';
 15: import { playUiSound } from './libs/sfx';
 16: import { isAttackablePlayer } from './ecs/systems/attackSystem';
 17: 
 18: /**
 19:  * `CNewUICommandWindow` (NewUICommandWindow.cpp) and the `/command` lines of
 20:  * `CheckCommand` (ZzzInterface.cpp:3990): every player-to-player action -
 21:  * trade, purchase, party, whisper, guild, alliance, hostility, add friend,
 22:  * follow, duel - run on the **character under the cursor**. The window arms
 23:  * one (`m_iCurSelectCommand`), the cursor turns into `CURSOR_IDSELECT`, and
 24:  * the next right click on a player runs it (`RunCommand`); a typed `/trade`
 25:  * runs it at once on whoever is under the cursor.
 26:  *
 27:  * `CNewUIQuickCommandWindow` (NewUIQuickCommandWindow.cpp) is the shortcut
 28:  * for the same actions: a right click on another player opens a small menu
 29:  * at the cursor whose entries run those commands straight away, with no
 30:  * arming step.
 31:  *
 32:  * The windows are the UI (ui/pages/worldPage/components/commandWindow and
 33:  * quickCommandWindow); the packets are the ones the social / economy /
 34:  * messenger stores already send.
 35:  */
 36: 
 37: /** `MAX_DISTANCE_TILE` (_define.h:597): how far the target may stand, in tiles. */
 38: const MAX_DISTANCE_TILE = 2;
 39: /** `TRADELIMITLEVEL`: no trading below this level (GlobalText 478). */
 40: const TRADE_LIMIT_LEVEL = 6;
 41: /** `CommandDual`: the duel needs level 30 (GlobalText 2704). */
 42: const DUEL_LIMIT_LEVEL = 30;
 43: /**
 44:  * `CNewUIHotKey::UpdateMouseEvent`: the quick menu opens on a player less
 45:  * than 300 world units away - three tiles. Wider than `MAX_DISTANCE_TILE`
 46:  * on purpose, the way the original is: the menu opens, and the entry that
 47:  * needs two tiles is the one that refuses.
 48:  */
 49: const QUICK_RANGE_TILES = 3;
 50: /** `OpenQuickCommand(..., MouseX + 10, MouseY - 50)`. */
 51: const QUICK_OFFSET = { x: 10, y: -50 };
 52: 
 53: export type CommandTarget = {
 54:   netId: number;
 55:   name: string;
 56:   guildRole: GuildMemberRoleEnum | undefined;
 57:   entity: Entity;
 58: };
 59: 
 60: export const Commands = new (class _Commands {
 61:   /** `INTERFACE_COMMAND` visible. */
 62:   windowOpen = false;
 63:   /** `m_iCurSelectCommand`: the entry armed for the next right click. */
 64:   pending: CommandKind | null = null;
 65:   /** `g_iFollowCharacter`: the player the hero keeps walking after. */
 66:   following: Entity | null = null;
 67:   /** `INTERFACE_QUICK_COMMAND`: the player the right-click menu is open on. */
 68:   quickTarget: Entity | null = null;
 69:   /** Where that menu sits, in screen pixels. */
 70:   quickPos = { x: 0, y: 0 };
 71: 
 72:   constructor() {
 73:     makeObservable(this, {
 74:       windowOpen: observable,
 75:       pending: observable,
 76:       following: observable.ref,
 77:       quickTarget: observable.ref,
 78:       quickPos: observable.ref,
 79:       toggleWindow: action,
 80:       closeWindow: action,
 81:       arm: action,
 82:       disarm: action,
 83:       closeQuick: action,
 84:     });
 85:   }
 86: 
 87:   toggleWindow(): void {
 88:     this.windowOpen = !this.windowOpen;
 89:     if (!this.windowOpen) this.pending = null;
 90:   }
 91: 
 92:   closeWindow(): void {
 93:     this.windowOpen = false;
 94:     this.pending = null;
 95:   }
 96: 
 97:   /** Click on a window entry: a second click on the armed one disarms it. */
 98:   arm(kind: CommandKind): void {
 99:     this.pending = this.pending === kind ? null : kind;
100:   }
101: 
102:   disarm(): void {
103:     this.pending = null;
104:   }
105: 
106:   reset(): void {
107:     runInAction(() => {
108:       this.windowOpen = false;
109:       this.pending = null;
110:       this.following = null;
111:       this.quickTarget = null;
112:     });
113:   }
114: 
115:   /**
116:    * `OpenQuickCommand`: a right click on another player within reach opens
117:    * the quick menu at the cursor instead of casting. Returns false when
118:    * there is no such player under it, so the click falls through to the
119:    * skill.
120:    */
121:   openQuickOn(
122:     entity: Entity | null | undefined,
123:     clientX: number,
124:     clientY: number
125:   ): boolean {
126:     if (!this.isQuickTarget(entity)) return false;
127:     runInAction(() => {
128:       this.quickTarget = entity!;
129:       this.quickPos = {
130:         x: clientX + QUICK_OFFSET.x,
131:         y: Math.max(0, clientY + QUICK_OFFSET.y),
132:       };
133:     });
134:     return true;
135:   }
136: 
137:   closeQuick(): void {
138:     this.quickTarget = null;
139:   }
140: 
141:   /**
142:    * The quick menu's own target test. Stricter than `targetOf` about what
143:    * counts as a player: the player-rig monsters (the skeletons, the Cursed
144:    * Wizard) carry `playerAnimation` too, and a right click on one of those
145:    * has to stay a skill cast.
146:    */
147:   isQuickTarget(entity: Entity | null | undefined): boolean {
148:     const hero = Store.world?.playerEntity;
149:     if (!entity || !hero) return false;
150:     if (entity.localPlayer || entity.netId === undefined) return false;
151:     const isPlayer = !!entity.playerAnimation || entity.skin !== undefined;
152:     if (!isPlayer || entity.npcType !== undefined) return false;
153:     if (entity.dying || entity.objOutOfScope) return false;
154:     const dx = entity.transform!.pos.x - hero.transform!.pos.x;
155:     const dy = entity.transform!.pos.z - hero.transform!.pos.z;
156:     return dx * dx + dy * dy <= QUICK_RANGE_TILES * QUICK_RANGE_TILES;
157:   }
158: 
159:   /** `Update`: the menu closes when its target dies, leaves scope or walks off. */
160:   quickTick(): void {
161:     if (this.quickTarget && !this.isQuickTarget(this.quickTarget)) this.closeQuick();
162:   }
163: 
164:   /**
165:    * `RunCommand`'s target test: a player other than the hero, alive, within
166:    * `MAX_DISTANCE_TILE`. Returns the target or a reason it is refused.
167:    */
168:   targetOf(entity: Entity | null | undefined): CommandTarget | string {
169:     const hero = Store.world?.playerEntity;
170:     if (!entity || !hero) return t('command.noPlayerUnderCursor');
171:     // A skinned player wears a monster rig, so the animation component alone
172:     // would not know it for a player.
173:     const isPlayer = !!entity.playerAnimation || entity.skin !== undefined;
174:     if (entity.localPlayer || !isPlayer || entity.netId === undefined) {
175:       return t('command.notAPlayer');
176:     }
177:     if (entity.dying) return t('command.playerDead');
178:     const dx = Math.abs(Math.floor(entity.transform!.pos.x) - Math.floor(hero.transform!.pos.x));
179:     const dy = Math.abs(Math.floor(entity.transform!.pos.z) - Math.floor(hero.transform!.pos.z));
180:     if (dx > MAX_DISTANCE_TILE || dy > MAX_DISTANCE_TILE)
181:       return t('command.playerTooFar');
182:     return {
183:       netId: entity.netId,
184:       name: entity.objectNameInWorld ?? `#${entity.netId}`,
185:       guildRole: entity.guild?.role,
186:       entity,
187:     };
188:   }
189: 
190:   /** True when `entity` would be accepted by `targetOf`; the cursor's name tag reads this. */
191:   canRunOn(entity: Entity | null | undefined): boolean {
192:     return typeof this.targetOf(entity) !== 'string';
193:   }
194: 
195:   /**
196:    * The right click while an entry is armed (`RunCommand`, `MouseRButtonPush`).
197:    * Always consumes the click and disarms; returns false when nothing was armed.
198:    */
199:   runPendingOn(entity: Entity | null | undefined): boolean {
200:     const kind = this.pending;
201:     if (!kind) return false;
202:     this.disarm();
203:     this.run(kind, entity);
204:     return true;
205:   }
206: 
207:   /** A `/command` line or a window entry, on the player under the cursor. */
208:   run(kind: CommandKind, entity: Entity | null | undefined): void {
209:     // Not a `RunCommand` entry: an attack order is the click the attack
210:     // system already understands, so it keeps the reach of a swing instead
211:     // of the two tiles the social commands share.
212:     if (kind === 'attack') {
213:       this.attack(entity);
214:       return;
215:     }
216:     const target = this.targetOf(entity);
217:     if (typeof target === 'string') {
218:       Social.errorMessage(target);
219:       playUiSound('error');
220:       return;
221:     }
222:     switch (kind) {
223:       case 'trade':
224:         if (Store.playerData.level < TRADE_LIMIT_LEVEL) {
225:           Social.systemMessage(
226:             t('command.tradeLevel', { level: TRADE_LIMIT_LEVEL })
227:           );
228:           return;
229:         }
230:         Economy.requestTrade(target);
231:         return;
232:       case 'purchase':
233:         Economy.browseShop(target);
234:         return;
235:       case 'party':
236:         Social.partyInvite(target);
237:         return;
238:       case 'whisper':
239:         Social.setWhisperTarget(target.name);
240:         Social.openChatInput();
241:         return;
242:       case 'guild':
243:         Social.guildJoin({ netId: target.netId, name: target.name, role: target.guildRole });
244:         return;
245:       case 'guildUnion':
246:         if (!this.masterCheck(target)) return;
247:         Social.guildRelationRequestSend(target, GuildRelationshipTypeEnum.Alliance, true);
248:         return;
249:       case 'rival':
250:         if (!this.masterCheck(target)) return;
251:         Social.guildRelationRequestSend(target, GuildRelationshipTypeEnum.Hostility, true);
252:         return;
253:       case 'rivalOff':
254:         if (!this.masterCheck(target)) return;
255:         Social.guildRelationRequestSend(target, GuildRelationshipTypeEnum.Hostility, false);
256:         return;
257:       case 'addFriend':
258:         Messenger.requestAddFriend(target.name);
259:         return;
260:       case 'follow':
261:         runInAction(() => {
262:           this.following = target.entity;
263:         });
264:         Social.systemMessage(t('command.following', { name: target.name }));
265:         return;
266:       case 'battle':
267:         this.duel(target);
268:         return;
269:     }
270:   }
271: 
272:   /**
273:    * The quick menu's attack entry. `isAttackableEntity` refuses every player
274:    * so an ordinary click in a crowd never starts a fight; picking the entry
275:    * is deliberate, so it gets the player-only test instead.
276:    */
277:   private attack(entity: Entity | null | undefined): void {
278:     const world = Store.world;
279:     if (!world || !entity || !isAttackablePlayer(world, entity)) {
280:       Social.errorMessage(t('command.cannotAttack'));
281:       playUiSound('error');
282:       return;
283:     }
284:     world.attackTarget = entity;
285:   }
286: 
287:   /** `CommandGuildUnion` / `CommandGuildRival`: both sides must be masters (GlobalText 1320 / 507). */
288:   private masterCheck(target: CommandTarget): boolean {
289:     if (!Social.isGuildMaster) {
290:       Social.systemMessage(t('command.onlyGuildMaster'));
291:       return false;
292:     }
293:     if (target.guildRole !== GuildMemberRoleEnum.GuildMaster) {
294:       Social.systemMessage(t('command.notGuildMaster'));
295:       return false;
296:     }
297:     return true;
298:   }
299: 
300:   /** `CommandDual`: start a duel, or stop the one running. */
301:   private duel(target: CommandTarget): void {
302:     if (Store.playerData.level < DUEL_LIMIT_LEVEL) {
303:       Social.errorMessage(t('command.duelLevel', { level: DUEL_LIMIT_LEVEL }));
304:       return;
305:     }
306:     const packet = DuelStartRequestPacket.createPacket();
307:     packet.PlayerId = target.netId;
308:     packet.setPlayerName(target.name);
309:     Store.sendToGS(packet.buffer);
310:     Social.systemMessage(t('command.duelRequestSent', { name: target.name }));
311:   }
312: 
313:   /** `/duelend`: `SendDuelStopRequest`. */
314:   duelStop(): void {
315:     Store.sendToGS(DuelStopRequestPacket.createPacket().buffer);
316:   }
317: 
318:   /**
319:    * `g_iFollowCharacter` (ZzzInterface `MoveHero`): once a second the hero
320:    * walks to the followed player's tile until it leaves scope or the hero
321:    * clicks somewhere else. Called by the command window while mounted.
322:    */
323:   followTick(): void {
324:     const target = this.following;
325:     const world = Store.world;
326:     const hero = world?.playerEntity;
327:     if (!target || !world || !hero) return;
328:     // The followed player is tested on its own components, not on
329:     // `playersQuery.has`: a miniplex query only indexes entities once
330:     // something has read its `entities` (`Query.connect`), and nothing
331:     // reads that one on every map - so `has` answered false for every
332:     // player and the first tick dropped the follow.
333:     const gone =
334:       target.dying ||
335:       target.objOutOfScope ||
336:       (target.worldIndex !== undefined && target.worldIndex !== world.mapIndex);
337:     if (gone) {
338:       runInAction(() => {
339:         this.following = null;
340:       });
341:       return;
342:     }
343:     const tx = target.transform!.pos.x;
344:     const ty = target.transform!.pos.z;
345:     const dx = Math.abs(Math.floor(tx) - Math.floor(hero.transform!.pos.x));
346:     const dy = Math.abs(Math.floor(ty) - Math.floor(hero.transform!.pos.z));
347:     if (dx <= INVITE_RANGE_TILES && dy <= INVITE_RANGE_TILES) return;
348:     const moveTo = hero.playerMoveTo;
349:     if (!moveTo) return;
350:     moveTo.point.x = tx;
351:     moveTo.point.y = ty;
352:     moveTo.handled = false;
353:     moveTo.sendToServer = true;
354:   }
355: 
356:   /**
357:    * `g_iFollowCharacter = -1`: a walk, attack or cast of the hero's own
358:    * (pointer and controller systems), on top of the tick's own tests.
359:    */
360:   stopFollowing(): void {
361:     if (!this.following) return;
362:     runInAction(() => {
363:       this.following = null;
364:     });
365:   }
366: })();
367: 
368: // A hot update that reaches this module must reload the page: Vite would
369: // otherwise re-execute it and hand later-loaded importers a second instance
370: // of this singleton (same guard as store.ts).
371: const hot = (import.meta as { hot?: { decline(): void } }).hot;
372: if (hot) hot.decline();
</file>

<file path="src/admin/catalogues.test.ts">
 1: import { describe, expect, it } from 'vitest';
 2: import {
 3:   ITEM_CATALOGUE,
 4:   buildMonsterCatalogue,
 5:   buildSkinCatalogue,
 6:   classifyRow,
