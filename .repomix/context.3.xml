  5: import {
  6:   ChatRoomCreateRequestPacket,
  7:   ChatRoomInvitationRequestPacket,
  8: } from './common/packets/ClientToServerPackets';
  9: import { CHAT_SERVER_PORT, type ChatClient } from './common/chatRoomProtocol';
 10: import { openChatRoomSocket, type ChatRoomSocket } from './libs/sockets/chatRoomSocket';
 11: import { playUiSound } from './libs/sfx';
 12: 
 13: export type ChatRoomLine = {
 14:   sender: string;
 15:   text: string;
 16:   system?: boolean;
 17: };
 18: 
 19: export type ChatRoomState = 'connecting' | 'open' | 'closed';
 20: 
 21: export type ChatRoom = {
 22:   /** Stable UI key; the server room id can change when a room is reused. */
 23:   key: number;
 24:   roomId: number;
 25:   /** The other side of the create request; the tab label. */
 26:   friendName: string;
 27:   state: ChatRoomState;
 28:   clients: ChatClient[];
 29:   lines: ChatRoomLine[];
 30:   unread: boolean;
 31: };
 32: 
 33: /** The original refuses invitations past 30 members (UIWindows.cpp). */
 34: const MAX_ROOM_CLIENTS = 30;
 35: const MAX_LINES = 200;
 36: /** An 0xCA create request the server never answered is forgotten after this. */
 37: const CREATE_TIMEOUT_MS = 10_000;
 38: 
 39: /**
 40:  * The chat rooms of MU's separate chat server: `CUIChatWindow` and the
 41:  * chat-room tab of the friend window, on OpenMU's ChatServer. The game
 42:  * server only brokers the room (0xCA/0xCB and ChatRoomConnectionInfo); the
 43:  * talking happens on a second connection owned by chatRoomSocket.ts.
 44:  */
 45: export const ChatRooms = new (class _ChatRooms {
 46:   windowEnabled = false;
 47:   rooms: ChatRoom[] = [];
 48:   activeKey = -1;
 49: 
 50:   /** Sockets by room key; not observable state. */
 51:   private sockets = new Map<number, ChatRoomSocket>();
 52:   /** In-flight 0xCA creates by friend name (`AddRequestWindow` dedupe). */
 53:   private pendingCreates = new Map<string, ReturnType<typeof setTimeout>>();
 54:   /** In-flight 0xCB invites: RequestId -> invited name. */
 55:   private pendingInvites = new Map<number, string>();
 56:   private nextKey = 1;
 57:   private nextRequestId = 1;
 58:   private stopWatching: (() => void) | null = null;
 59: 
 60:   constructor() {
 61:     makeObservable(this, {
 62:       windowEnabled: observable,
 63:       rooms: observable,
 64:       activeKey: observable,
 65:       openWindow: action,
 66:       closeWindow: action,
 67:       setActiveRoom: action,
 68:       onConnectionInfo: action,
 69:       leaveRoom: action,
 70:       reset: action,
 71:     });
 72:   }
 73: 
 74:   /**
 75:    * Rooms live on their own connections but belong to the character: gone
 76:    * with the world (relog, lost server, back to the server list). Armed
 77:    * lazily, not in the constructor: store.ts imports this module through
 78:    * logic.ts, so at module-evaluation time `Store` is still in its temporal
 79:    * dead zone and a top-level reaction throws (same as skills/buffs.ts).
 80:    */
 81:   private ensureWatching(): void {
 82:     if (this.stopWatching) return;
 83:     this.stopWatching = reaction(
 84:       () => Store.uiState,
 85:       state => {
 86:         if (state !== UIState.World) this.reset();
 87:       }
 88:     );
 89:   }
 90: 
 91:   get activeRoom(): ChatRoom | null {
 92:     return this.rooms.find(r => r.key === this.activeKey) ?? null;
 93:   }
 94: 
 95:   reset(): void {
 96:     for (const socket of this.sockets.values()) socket.leave();
 97:     this.sockets.clear();
 98:     for (const timer of this.pendingCreates.values()) clearTimeout(timer);
 99:     this.pendingCreates.clear();
100:     this.pendingInvites.clear();
101:     this.windowEnabled = false;
102:     this.rooms = [];
103:     this.activeKey = -1;
104:   }
105: 
106:   // ---- window ---------------------------------------------------------------
107: 
108:   openWindow(key?: number): void {
109:     if (this.rooms.length === 0) return;
110:     this.windowEnabled = true;
111:     const room =
112:       (key !== undefined ? this.rooms.find(r => r.key === key) : this.activeRoom) ??
113:       this.rooms[0];
114:     this.activeKey = room.key;
115:     room.unread = false;
116:   }
117: 
118:   closeWindow(): void {
119:     this.windowEnabled = false;
120:   }
121: 
122:   setActiveRoom(key: number): void {
123:     const room = this.rooms.find(r => r.key === key);
124:     if (!room) return;
125:     this.activeKey = key;
126:     room.unread = false;
127:   }
128: 
129:   get unreadRooms(): number {
130:     return this.rooms.filter(r => r.unread).length;
131:   }
132: 
133:   // ---- game server side (create / invite) ------------------------------------
134: 
135:   /**
136:    * The friend window's Talk button (`CUIFriendListTabWindow` button 3):
137:    * reuse an existing room with that friend, otherwise ask the game server
138:    * for a new one and wait for ChatRoomConnectionInfo.
139:    */
140:   openRoomWith(friendName: string): void {
141:     this.ensureWatching();
142:     const existing = this.rooms.find(
143:       r => r.friendName === friendName && r.state !== 'closed'
144:     );
145:     if (existing) {
146:       this.openWindow(existing.key);
147:       return;
148:     }
149:     if (this.pendingCreates.has(friendName)) return;
150:     this.pendingCreates.set(
151:       friendName,
152:       setTimeout(() => this.pendingCreates.delete(friendName), CREATE_TIMEOUT_MS)
153:     );
154:     const packet = ChatRoomCreateRequestPacket.createPacket();
155:     packet.setFriendName(friendName);
156:     Store.sendToGS(packet.buffer);
157:   }
158: 
159:   /** The invite list of the room window: pull one more friend in. */
160:   inviteFriend(friendName: string): void {
161:     const room = this.activeRoom;
162:     if (!room || room.state !== 'open') return;
163:     if (room.clients.some(c => c.name === friendName)) return;
164:     if (room.clients.length >= MAX_ROOM_CLIENTS) {
165:       Social.errorMessage(t('chatRoom.full'));
166:       return;
167:     }
168:     const requestId = this.nextRequestId++;
169:     this.pendingInvites.set(requestId, friendName);
170:     const packet = ChatRoomInvitationRequestPacket.createPacket();
171:     packet.setFriendName(friendName);
172:     packet.RoomId = room.roomId;
173:     packet.RequestId = requestId;
174:     Store.sendToGS(packet.buffer);
175:   }
176: 
177:   /** FriendInvitationResult echoes our RequestId; true when it was ours. */
178:   inviteResult(success: boolean, requestId: number): boolean {
179:     const name = this.pendingInvites.get(requestId);
180:     if (name === undefined) return false;
181:     this.pendingInvites.delete(requestId);
182:     if (!success) Social.errorMessage(t('chatRoom.inviteFailed', { name }));
183:     return true;
184:   }
185: 
186:   /**
187:    * ChatRoomConnectionInfo: the game server brokered a room and hands over
188:    * where to meet. `initiated` = an own create request was pending, so the
189:    * window pops open; an incoming invitation stays a tab with an alert until
190:    * it is looked at (the original's `UISTATE_READY` rooms).
191:    */
192:   onConnectionInfo(info: {
193:     host: string;
194:     roomId: number;
195:     token: number;
196:     friendName: string;
197:     success: boolean;
198:   }): void {
199:     this.ensureWatching();
200:     const pending = this.pendingCreates.get(info.friendName);
201:     const initiated = pending !== undefined;
202:     if (pending !== undefined) {
203:       clearTimeout(pending);
204:       this.pendingCreates.delete(info.friendName);
205:     }
206: 
207:     if (!info.success) {
208:       Social.errorMessage(
209:         info.friendName
210:           ? t('chatRoom.openFailedWith', { name: info.friendName })
211:           : t('chatRoom.openFailed')
212:       );
213:       return;
214:     }
215: 
216:     // A second info for the same friend reconnects the existing room with
217:     // the fresh room id and token (the original's Type 1 path).
218:     let room = this.rooms.find(r => r.friendName === info.friendName) ?? null;
219:     if (room) {
220:       this.sockets.get(room.key)?.leave();
221:       this.sockets.delete(room.key);
222:       room.roomId = info.roomId;
223:       room.state = 'connecting';
224:       room.clients = [];
225:     } else {
226:       room = {
227:         key: this.nextKey++,
228:         roomId: info.roomId,
229:         friendName: info.friendName,
230:         state: 'connecting',
231:         clients: [],
232:         lines: [],
233:         unread: false,
234:       };
235:       this.rooms.push(room);
236:     }
237: 
238:     this.connect(room.key, info.host, info.roomId, info.token);
239: 
240:     if (initiated) {
241:       this.openWindow(room.key);
242:     } else {
243:       room.unread = true;
244:       Social.systemMessage(t('chatRoom.opened', { name: info.friendName }));
245:       playUiSound('whisper');
246:     }
247:   }
248: 
249:   // ---- chat server side -------------------------------------------------------
250: 
251:   private connect(key: number, host: string, roomId: number, token: number): void {
252:     const socket = openChatRoomSocket({
253:       host,
254:       port: CHAT_SERVER_PORT,
255:       roomId,
256:       token,
257:       onEvent: event => {
258:         const room = this.rooms.find(r => r.key === key);
259:         if (!room) return;
260:         runInAction(() => {
261:           switch (event.kind) {
262:             case 'clients':
263:               // The list follows a successful authentication: the room is live.
264:               room.state = 'open';
265:               room.clients = event.clients;
266:               break;
267:             case 'joined':
268:               room.state = 'open';
269:               if (!room.clients.some(c => c.index === event.index)) {
270:                 room.clients.push({ index: event.index, name: event.name });
271:               }
272:               this.addLine(room, {
273:                 sender: '',
274:                 text: t('chatRoom.joined', { name: event.name }),
275:                 system: true,
276:               });
277:               break;
278:             case 'left':
279:               room.clients = room.clients.filter(c => c.index !== event.index);
280:               this.addLine(room, {
281:                 sender: '',
282:                 text: t('chatRoom.left', { name: event.name }),
283:                 system: true,
284:               });
285:               break;
286:             case 'message': {
287:               const sender =
288:                 room.clients.find(c => c.index === event.senderIndex)?.name ?? '?';
289:               this.addLine(room, { sender, text: event.text });
290:               if (sender !== Store.playerData.name) {
291:                 const visible =
292:                   this.windowEnabled && this.activeKey === room.key;
293:                 if (!visible) {
294:                   room.unread = true;
295:                   playUiSound('whisper');
296:                 }
297:               }
298:               break;
299:             }
300:           }
301:         });
302:       },
303:       onClose: everOpened => {
304:         const room = this.rooms.find(r => r.key === key);
305:         this.sockets.delete(key);
306:         if (!room) return;
307:         runInAction(() => {
308:           room.state = 'closed';
309:           this.addLine(room, {
310:             sender: '',
311:             text: everOpened
312:               ? t('chatRoom.connectionLost')
313:               : t('chatRoom.unreachable'),
314:             system: true,
315:           });
316:         });
317:         if (!everOpened) Social.errorMessage(t('chatRoom.unreachable'));
318:       },
319:     });
320:     this.sockets.set(key, socket);
321:   }
322: 
323:   private addLine(room: ChatRoom, line: ChatRoomLine): void {
324:     room.lines.push(line);
325:     if (room.lines.length > MAX_LINES) room.lines.splice(0, room.lines.length - MAX_LINES);
326:   }
327: 
328:   sendMessage(text: string): boolean {
329:     const room = this.activeRoom;
330:     const trimmed = text.trim();
331:     if (!room || !trimmed) return false;
332:     const socket = this.sockets.get(room.key);
333:     if (room.state !== 'open' || !socket?.isOpen) return false;
334:     // The server relays the message back to everyone in the room, the sender
335:     // included; the line is drawn when the echo arrives, like the original.
336:     socket.sendMessage(trimmed);
337:     return true;
338:   }
339: 
340:   leaveRoom(key: number): void {
341:     this.sockets.get(key)?.leave();
342:     this.sockets.delete(key);
343:     this.rooms = this.rooms.filter(r => r.key !== key);
344:     if (this.activeKey === key) {
345:       this.activeKey = this.rooms.length > 0 ? this.rooms[this.rooms.length - 1].key : -1;
346:     }
347:     if (this.rooms.length === 0) this.windowEnabled = false;
348:   }
349: })();
350: 
351: // A hot update that reaches this module must reload the page: Vite would
352: // otherwise re-execute it and hand later-loaded importers a second instance
353: // of this singleton (same guard as store.ts).
354: const hot = (import.meta as { hot?: { decline(): void } }).hot;
355: if (hot) hot.decline();
</file>

<file path="src/combat/_template.ts">
 1: /**
 2:  * TEMPLATE - copy this file to `<name>.ts`, fill in the blanks, add the layer
 3:  * to `layers.ts`. Never imported; it only exists to be copied.
 4:  *
 5:  * Every combat entry has the same three parts, in this order:
 6:  *
 7:  *   1. Tuning constants at the top, each in real units (seconds, tiles,
 8:  *      reference ticks at 25 Hz, 0…1) with a comment saying why.
 9:  *   2. Module state + the functions that read or command it. State lives
10:  *      here, not in the facade; readers are plain functions.
11:  *   3. The exported `CombatLayer` at the bottom, wiring `update` / `reset`.
12:  *
13:  * If the entry needs a packet sent, it exposes a *command* that the ECS
14:  * consumer (`attackSystem.ts`, `skillCastSystem.ts`) calls - the entry
15:  * itself never imports `Store` to send. If it needs a clip, add the row to
16:  * `recipes.ts`.
17:  */
18: import { ENUM_WORLD } from '../common/types';
19: import type { CombatLayer } from './layer';
20: 
21: // ---- 1. tuning -------------------------------------------------------------
22: 
23: /** Seconds the effect lasts once triggered. */
24: const HOLD_SECONDS = 0.5;
25: 
26: /** Maps this exists on. */
27: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([ENUM_WORLD.WD_0LORENCIA]);
28: 
29: // ---- 2. state + readers ----------------------------------------------------
30: 
31: let remaining = 0;
32: 
33: /** How much of the effect is left, 0…1. */
34: export function templateStrength(): number {
35:   return remaining / HOLD_SECONDS;
36: }
37: 
38: /** Command: trigger it now. */
39: export function triggerTemplate(): void {
40:   remaining = HOLD_SECONDS;
41: }
42: 
43: function update(map: ENUM_WORLD, dt: number): void {
44:   if (!MAPS.has(map)) {
45:     remaining = 0;
46:     return;
47:   }
48:   remaining = Math.max(0, remaining - dt);
49: }
50: 
51: function reset(): void {
52:   remaining = 0;
53: }
54: 
55: // ---- 3. the layer ----------------------------------------------------------
56: 
57: export const templateLayer: CombatLayer = {
58:   name: 'template',
59:   maps: MAPS,
60:   update,
61:   reset,
62: };
</file>

<file path="src/combat/areaHit.ts">
  1: /**
  2:  * The `AreaSkillHit` (0xDB, `PACKET_MAGIC_ATTACK`) follow-up: for a skill
  3:  * whose hits the *client* decides, an `AreaSkill` cast is followed by one
  4:  * 0xDB carrying the targets inside the area - up to the packet's byte cap -
  5:  * and a per-cast `HitCounter` / `AnimationCounter` the server uses to drop
  6:  * duplicates. OpenMU processes it only for skills typed
  7:  * `AreaSkillExplicitHits`; for `AreaSkillAutomaticHits` the server picks
  8:  * the targets itself and the packet must *not* be sent, so the gate is the
  9:  * skill's type (data) plus an explicit override set.
 10:  *
 11:  * Driven by `skillCastSystem` (`areaHitTargets` → `buildAreaHit`); this
 12:  * entry keeps the counters and the area rule, never sends.
 13:  */
 14: import { AreaSkillHitPacket } from '../common/packets/ClientToServerPackets';
 15: import type { SkillDefinition } from '../common/skillsDatabase';
 16: import type { ENUM_WORLD } from '../common/types';
 17: import type { CombatLayer } from './layer';
 18: 
 19: // ---- 1. tuning -------------------------------------------------------------
 20: 
 21: /** OpenMU's skill type whose hits are sent by the client. */
 22: const EXPLICIT_HITS_TYPE = 'AreaSkillExplicitHits';
 23: 
 24: /**
 25:  * Skills that send 0xDB whatever their database type says. Empty by
 26:  * default: this data copy types every area skill as automatic hits. Add a
 27:  * skill number here to force the follow-up for it.
 28:  */
 29: const EXPLICIT_HIT_SKILLS: ReadonlySet<number> = new Set<number>([]);
 30: 
 31: /**
 32:  * Tiles around the cast point a target counts as inside when the skill
 33:  * carries no `range` of its own. Twisting Slash / Rageful Blow reach the
 34:  * 8-neighbourhood: √2 ≈ 1.5 rounded up to the tile ring.
 35:  */
 36: const DEFAULT_AREA_TILES = 1.5;
 37: 
 38: /** Targets per packet: 0xDB is a C3 with a one-byte length; 3 bytes per target. */
 39: const MAX_TARGETS = 20;
 40: 
 41: /** Bytes before the target list: header 3 + skill 2 + x, y, hitCounter, count. */
 42: const HEADER_BYTES = 9;
 43: const BYTES_PER_TARGET = 3;
 44: 
 45: // ---- 2. state + readers ----------------------------------------------------
 46: 
 47: /** `HitCounter`: increments per cast so the server can drop replays. */
 48: let hitCounter = 0;
 49: 
 50: /** `AnimationCounter`: increments per packet, wraps at a byte. */
 51: let animationCounter = 0;
 52: 
 53: /** Whether this skill wants the client to name its hits. */
 54: export function needsAreaHit(def: SkillDefinition): boolean {
 55:   return (
 56:     (def.type as string) === EXPLICIT_HITS_TYPE ||
 57:     EXPLICIT_HIT_SKILLS.has(def.num)
 58:   );
 59: }
 60: 
 61: /** Reach of the area around the cast point, in tiles. */
 62: export function areaHitRadius(def: SkillDefinition): number {
 63:   return def.range > 0 ? def.range + 0.5 : DEFAULT_AREA_TILES;
 64: }
 65: 
 66: /**
 67:  * Command: build the 0xDB for a cast at (x, y) on these targets. Bumps the
 68:  * counters. Returns `null` when there is nothing to hit.
 69:  */
 70: export function buildAreaHit(
 71:   skill: number,
 72:   x: number,
 73:   y: number,
 74:   targetIds: readonly number[]
 75: ): AreaSkillHitPacket | null {
 76:   if (targetIds.length === 0) return null;
 77:   const ids = targetIds.slice(0, MAX_TARGETS);
 78:   hitCounter = (hitCounter + 1) & 0xff;
 79:   animationCounter = (animationCounter + 1) & 0xff;
 80: 
 81:   const size = HEADER_BYTES + ids.length * BYTES_PER_TARGET;
 82:   const packet = AreaSkillHitPacket.createPacket(size);
 83:   packet.SkillId = skill;
 84:   packet.TargetX = x;
 85:   packet.TargetY = y;
 86:   packet.HitCounter = hitCounter;
 87:   packet.TargetCount = ids.length;
 88:   const view = packet.buffer;
 89:   for (let i = 0; i < ids.length; i++) {
 90:     const at = HEADER_BYTES + i * BYTES_PER_TARGET;
 91:     view.setUint16(at, ids[i], false);
 92:     view.setUint8(at + 2, animationCounter);
 93:   }
 94:   packet.writeLength(size);
 95:   return packet;
 96: }
 97: 
 98: function update(_map: ENUM_WORLD, _dt: number): void {
 99:   // Counters only move on a cast; nothing to step.
100: }
101: 
102: function reset(): void {
103:   hitCounter = 0;
104:   animationCounter = 0;
105: }
106: 
107: // ---- 3. the layer ----------------------------------------------------------
108: 
109: export const areaHitLayer: CombatLayer = {
110:   name: 'areaHit',
111:   update,
112:   reset,
113: };
</file>

<file path="src/combat/attackTiming.ts">
  1: /**
  2:  * The hero's `AttackTime` latch (w_CharacterInfo.h:247, ZzzCharacter.cpp:4018-4025):
  3:  * a swing sets `AttackTime = 1`; every reference tick (25 Hz) adds one,
  4:  * **independent of the clip's PlaySpeed**; `AttackStage` / `AttackEffect`
  5:  * fire their sounds and sparks on `CheckAttackTime(n)` - true exactly once
  6:  * per swing when the counter passes `n` - and the swing state ends when the
  7:  * counter reaches `g_iLimitAttackTime` (15) or the clip reaches its hit key
  8:  * (`AnimationFrame >= 5`, ZzzCharacter.cpp:2755 - the frame advances by
  9:  * PlaySpeed per tick), which forces the counter to the limit.
 10:  *
 11:  * The original sends `SendHitRequest` on the click itself (ZzzInterface.cpp
 12:  * :3355, right after `AttackTime = 1`); we latch the `HitRequest` to the hit
 13:  * key instead so the packet lands with the blow: the consumer hands over a
 14:  * callback, this entry fires it once when the clip reaches the key. Because
 15:  * the key is reached at `key / PlaySpeed` ticks, a slow clip reaches it
 16:  * *after* the 15-tick limit - the limit only ends the swing once the blow
 17:  * has fired (see the table at `hitTickFor`). Driven by `attackSystem`
 18:  * (`startAttack`); read by `attackSystem`, `combatSfxSystem` and any effect
 19:  * that wants a hit-frame moment (`checkAttackTime`).
 20:  */
 21: import type { PlayerAction } from '../common/objects/enum';
 22: import { REFERENCE_FPS } from '../common/playSpeed';
 23: import type { ENUM_WORLD } from '../common/types';
 24: import type { CombatLayer } from './layer';
 25: import { DEFAULT_HIT_KEY, HIT_KEYS } from './recipes';
 26: 
 27: // ---- 1. tuning -------------------------------------------------------------
 28: 
 29: /** `g_iLimitAttackTime = 15`: ticks after which a landed swing is over regardless. */
 30: const LIMIT_ATTACK_TICKS = 15;
 31: 
 32: /** `AttackTime = 1` on the frame the swing starts. */
 33: const FIRST_TICK = 1;
 34: 
 35: /**
 36:  * Smallest play speed a clip is stepped at. A stat-scaled PlaySpeed is never
 37:  * 0 in practice (bases are 0.24…0.6); this only keeps the division finite.
 38:  */
 39: const MIN_PLAY_SPEED = 0.01;
 40: 
 41: /**
 42:  * Fallback ceiling on how long a blow may stay pending, in ticks (1.6 s).
 43:  * The slowest real clip (0.24 keys/tick, key 5) lands at tick 21.8; anything
 44:  * later means the clip was cut short (shock, death, a lost model) - the
 45:  * request is sent then so the server always sees exactly one per swing.
 46:  */
 47: const MAX_HIT_WAIT_TICKS = 40;
 48: 
 49: // ---- 2. state + readers ----------------------------------------------------
 50: 
 51: /** The running `AttackTime`, in reference ticks; 0 = no swing in flight. */
 52: let attackTicks = 0;
 53: 
 54: /** `LastAttackEffectTime`: the tick a `checkAttackTime` already fired for. */
 55: let lastEffectTick = -1;
 56: 
 57: /** Tick at which the current swing's blow lands. */
 58: let hitTick = 0;
 59: 
 60: /** Latched hit callback; fired once per swing when `attackTicks >= hitTick`. */
 61: let onHit: (() => void) | null = null;
 62: 
 63: /**
 64:  * Tick at which a clip played at `playSpeed` keys per tick reaches its hit
 65:  * key: `AttackTime` counts 1, 2, 3… at 25 Hz while `AnimationFrame` advances
 66:  * by `playSpeed` per tick, so `AnimationFrame >= key` is true at
 67:  * `1 + key / playSpeed`. The 15-tick limit must NOT cut this off:
 68:  *
 69:  * | PlaySpeed | who                        | hit tick (key 5) | seconds |
 70:  * |-----------|----------------------------|------------------|---------|
 71:  * | 0.25      | level-1 swordsman          | 21.0  (> 15)     | 0.84    |
 72:  * | 0.36      | GM / ~30 attack speed      | 14.9  (≈ limit)  | 0.60    |
 73:  * | 0.60      | fist / mid-game speed      |  9.3             | 0.37    |
 74:  * | 1.00      | end-game speed             |  6.0             | 0.24    |
 75:  *
 76:  * `clipTicks` (the clip's length in ticks at this speed) caps it: if the
 77:  * clip would end before the key, the blow lands with the clip's last frame.
 78:  */
 79: export function hitTickFor(
 80:   action: PlayerAction,
 81:   playSpeed: number,
 82:   clipTicks = Infinity
 83: ): number {
 84:   const key = HIT_KEYS[action] ?? DEFAULT_HIT_KEY;
 85:   const keyTick = FIRST_TICK + key / Math.max(MIN_PLAY_SPEED, playSpeed);
 86:   return Math.min(keyTick, FIRST_TICK + clipTicks, MAX_HIT_WAIT_TICKS);
 87: }
 88: 
 89: /** Seconds from the swing start to its blow at the given clip speed. */
 90: export function hitDelaySeconds(action: PlayerAction, playSpeed: number): number {
 91:   return (hitTickFor(action, playSpeed) - FIRST_TICK) / REFERENCE_FPS;
 92: }
 93: 
 94: /** `AttackTime`, whole ticks. 0 while no swing is in flight. */
 95: export function attackTime(): number {
 96:   return Math.floor(attackTicks);
 97: }
 98: 
 99: /** A swing is in flight (`AttackTime > 0`). */
100: export function attackInFlight(): boolean {
101:   return attackTicks > 0;
102: }
103: 
104: /** The current swing's blow has landed (hit request sent). */
105: export function attackHitLanded(): boolean {
106:   return attackTicks > 0 && onHit === null;
107: }
108: 
109: /**
110:  * `CheckAttackTime(n)`: true once per swing, on the frame the counter sits
111:  * on tick `n`. Mark it consumed with `setLastAttackEffectTime()` like the
112:  * original, so several checks on the same tick can share it.
113:  */
114: export function checkAttackTime(tick: number): boolean {
115:   return attackTime() === tick && lastEffectTick !== tick;
116: }
117: 
118: /** `SetLastAttackEffectTime()`. */
119: export function setLastAttackEffectTime(): void {
120:   lastEffectTick = attackTime();
121: }
122: 
123: /**
124:  * Command: a swing started now with `action` at `playSpeed` keys per tick.
125:  * `hit` is called once when the clip reaches its hit key - send the
126:  * `HitRequest` there. `clipSeconds` (one iteration of the clip at this
127:  * speed) is the fallback: the blow never waits past the clip's end.
128:  * Returns the seconds until that moment.
129:  */
130: export function startAttack(
131:   action: PlayerAction,
132:   playSpeed: number,
133:   hit: () => void,
134:   clipSeconds = Infinity
135: ): number {
136:   attackTicks = FIRST_TICK;
137:   lastEffectTick = -1;
138:   hitTick = hitTickFor(action, playSpeed, clipSeconds * REFERENCE_FPS);
139:   onHit = hit;
140:   return (hitTick - FIRST_TICK) / REFERENCE_FPS;
141: }
142: 
143: /** Command: drop the swing without landing it (target vanished, hero died). */
144: export function cancelAttack(): void {
145:   attackTicks = 0;
146:   lastEffectTick = -1;
147:   hitTick = 0;
148:   onHit = null;
149: }
150: 
151: function update(_map: ENUM_WORLD, dt: number): void {
152:   if (attackTicks <= 0) return;
153: 
154:   attackTicks += dt * REFERENCE_FPS;
155: 
156:   if (onHit && attackTicks >= hitTick) {
157:     const fire = onHit;
158:     onHit = null;
159:     fire();
160:     // AttackStage: the hit key forces AttackTime to the limit.
161:     attackTicks = LIMIT_ATTACK_TICKS;
162:   }
163: 
164:   // The limit ends a swing only once its blow has fired: a clip slower than
165:   // 5/14 keys per tick reaches its hit key after tick 15 and must still land.
166:   if (onHit === null && attackTicks >= LIMIT_ATTACK_TICKS) {
167:     attackTicks = 0;
168:     lastEffectTick = -1;
169:   }
170: }
171: 
172: function reset(): void {
173:   cancelAttack();
174: }
175: 
176: // ---- self-check: the table above, in code ---------------------------------
177: // Every row must land after the swing starts and before the fallback ceiling,
178: // and the slow rows must land past the 15-tick limit (the bug this guards).
179: {
180:   const rows: [number, number][] = [
181:     [0.25, 21],
182:     [0.36, 14.9],
183:     [0.6, 9.3],
184:     [1.0, 6],
185:   ];
186:   for (const [speed, expected] of rows) {
187:     const tick = hitTickFor(0 as PlayerAction, speed);
188:     const ok =
189:       Math.abs(tick - expected) < 0.1 && tick > FIRST_TICK && tick <= MAX_HIT_WAIT_TICKS;
190:     if (!ok) console.warn(`attackTiming: hit tick at PlaySpeed ${speed} = ${tick}, expected ${expected}`);
191:   }
192: }
193: 
194: // ---- 3. the layer ----------------------------------------------------------
195: 
196: export const attackTimingLayer: CombatLayer = {
197:   name: 'attackTiming',
198:   update,
199:   reset,
200: };
</file>

