 1: /**
 2:  * The Dark Knight combo. The sequence itself is judged by the server
 3:  * (OpenMU's `ComboStateMachine`: three different combo skills in a row); the
 4:  * client sends nothing extra - it only *hears* the result: a
 5:  * `SkillAnimation` carrying `AT_SKILL_COMBO` (59) (`ReceiveMagic`,
 6:  * WSclient.cpp:3763, :4436), on which the original spawns `MODEL_COMBO`,
 7:  * plays `SOUND_COMBO` and knocks the target up (`m_byDieType = COMBO`,
 8:  * ZzzCharacter.cpp:3173).
 9:  *
10:  * Driven by `logic.ts`'s `SkillAnimation` handler (`observeSkillAnimation`);
11:  * read by effects / HUD (`comboFlash`) and by the death system for the
12:  * knock-up (`comboKnockUp`).
13:  */
14: import type { Sounds } from '../libs/soundsManager';
15: import type { ENUM_WORLD } from '../common/types';
16: import type { CombatLayer } from './layer';
17: import { SKILL_COMBO } from './recipes';
18: 
19: // ---- 1. tuning -------------------------------------------------------------
20: 
21: /** `SOUND_COMBO`: eCombo.wav, once per landed combo. */
22: export const COMBO_SOUND: Sounds = 'Sound/eCombo';
23: 
24: /** Seconds the combo flash stays readable for effects (MODEL_COMBO's life). */
25: const FLASH_SECONDS = 1.0;
26: 
27: /** Seconds a knocked-up target is marked so the death clip can lift it. */
28: const KNOCK_UP_SECONDS = 0.6;
29: 
30: // ---- 2. state + readers ----------------------------------------------------
31: 
32: let flash = 0;
33: /** Target netId → seconds of knock-up left. */
34: const knockUps = new Map<number, number>();
35: /** Landed combos this session (HUD counter). */
36: let landed = 0;
37: 
38: /** 1 the frame a combo lands, fading to 0 over `FLASH_SECONDS`. */
39: export function comboFlash(): number {
40:   return flash / FLASH_SECONDS;
41: }
42: 
43: /** The target is being lifted by a combo / Nova knock-up. */
44: export function comboKnockUp(netId: number): boolean {
45:   return (knockUps.get(netId) ?? 0) > 0;
46: }
47: 
48: /** Combos landed since the last reset. */
49: export function combosLanded(): number {
50:   return landed;
51: }
52: 
53: /**
54:  * Command: a `SkillAnimation` arrived. Returns `true` when it was a combo
55:  * (the caller plays the sound at the caster).
56:  */
57: export function observeSkillAnimation(
58:   skill: number,
59:   targetNetId: number | undefined
60: ): boolean {
61:   if (skill !== SKILL_COMBO) return false;
62:   flash = FLASH_SECONDS;
63:   landed++;
64:   if (targetNetId !== undefined) knockUps.set(targetNetId, KNOCK_UP_SECONDS);
65:   return true;
66: }
67: 
68: function update(_map: ENUM_WORLD, dt: number): void {
69:   if (flash > 0) flash = Math.max(0, flash - dt);
70:   if (knockUps.size === 0) return;
71:   for (const [id, left] of knockUps) {
72:     const next = left - dt;
73:     if (next <= 0) knockUps.delete(id);
74:     else knockUps.set(id, next);
75:   }
76: }
77: 
78: function reset(): void {
79:   flash = 0;
80:   landed = 0;
81:   knockUps.clear();
82: }
83: 
84: // ---- 3. the layer ----------------------------------------------------------
85: 
86: export const comboLayer: CombatLayer = {
87:   name: 'combo',
88:   update,
89:   reset,
90: };
</file>

