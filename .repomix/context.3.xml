  1: /**
  2:  * Who a cast is aimed at when the caster presses the button - the third
  3:  * thing the original's skill switches decide and the skill table does not
  4:  * say. `Skill.bmd` / OpenMU's `target` field is no help here: Soul Barrier
  5:  * reads `Explicit` yet is cast on a party member *or* on yourself, and Swell
  6:  * Life reads `ImplicitParty` yet always goes out as `HeroKey`.
  7:  *
  8:  * The original writes it as the key it puts in `SendRequestMagic`:
  9:  *
 10:  *  - `SendRequestMagic(Skill, HeroKey)` with the selection ignored - the
 11:  *    self-only buffs (Swell Life :5658-5662, the elf summons :4841-4855,
 12:  *    Infinity Arrow :4967-4975, Improve AG :5100-5104, Berserker :2646-2656,
 13:  *    the Rage Fighter party buffs :2864-2880).
 14:  *  - the selected **player**'s key when one is picked and is a party member,
 15:  *    `HeroKey` otherwise - Soul Barrier :5851-5898, the elf party buffs and
 16:  *    Heal (`UseSkillElf` :2496-2504), Recovery :4993-5010.
 17:  *  - the selected object's key - everything else, which is every skill that
 18:  *    is aimed at something hostile.
 19:  *
 20:  * Readers only. Read by `skillCastSystem`, which picks the target entity
 21:  * before it sends, and by `common/skillCasting.isSelfCastable` for the
 22:  * hotbar's greying.
 23:  */
 24: import type { SkillDefinition } from '../common/skillsDatabase';
 25: import type { CombatLayer } from './layer';
 26: 
 27: // ---- 1. tuning -------------------------------------------------------------
 28: 
 29: /** Where a cast goes when the button is pressed. */
 30: export type CastTarget =
 31:   /** `HeroKey`, always - a selection on screen is ignored. */
 32:   | 'self'
 33:   /** The selected party member, or the caster when nothing suitable is picked. */
 34:   | 'allyOrSelf'
 35:   /** The selected object; the cast does not happen without one. */
 36:   | 'enemy';
 37: 
 38: /**
 39:  * Skills the original sends with `HeroKey` no matter what is selected.
 40:  * Strengthened / mastery ids are listed beside their base skill because the
 41:  * `case` lists name them.
 42:  */
 43: const SELF_ONLY: ReadonlySet<number> = new Set([
 44:   48, 356, 360, // Swell Life, Str, Proficiency
 45:   30, 31, 32, 33, 34, 35, 36, 37, // the elf summons (AT_SKILL_SUMMON + 0..7)
 46:   53, // Improve AG
 47:   77, 441, // Infinity Arrow, Str
 48:   218, 469, // Berserker, Str
 49:   266, // Ignore Defense
 50:   267, 573, // Increase Health, Str
 51:   268, 569, 572, // Increase Block, Str, Mastery
 52:   205, 206, 207, 208, 209, // the Halloween event skills
 53: ]);
 54: 
 55: /**
 56:  * Skills cast on the selected party member when there is one, and on the
 57:  * caster otherwise. Teleport Ally is not here: it needs a party member and
 58:  * is refused without one, which `skillCasting.castTeleport` enforces.
 59:  */
 60: const ALLY_OR_SELF: ReadonlySet<number> = new Set([
 61:   16, 403, 404, // Soul Barrier, Str, Proficiency
 62:   26, 413, // Heal, Str
 63:   27, 417, 423, // Greater Defense, Str, Mastery
 64:   28, 420, 422, // Greater Damage, Str, Mastery
 65:   234, // Recovery
 66: ]);
 67: 
 68: // ---- 2. state + readers ----------------------------------------------------
 69: 
 70: /**
 71:  * Where the cast goes. Anything the original does not name explicitly falls
 72:  * back to the skill table's own shape: a buff / regeneration / summon with
 73:  * no named rule is cast on the caster, everything else on the selection.
 74:  */
 75: export function castTarget(def: SkillDefinition): CastTarget {
 76:   if (SELF_ONLY.has(def.num)) return 'self';
 77:   if (ALLY_OR_SELF.has(def.num)) return 'allyOrSelf';
 78:   if (
 79:     def.type === 'Buff' ||
 80:     def.type === 'Regeneration' ||
 81:     def.type === 'SummonMonster' ||
 82:     def.type === 'PassiveBoost' ||
 83:     def.target === 'ImplicitParty' ||
 84:     def.target === 'ImplicitPlayer'
 85:   ) {
 86:     return 'allyOrSelf';
 87:   }
 88:   return 'enemy';
 89: }
 90: 
 91: /** Whether a cast with nothing suitable selected lands on the caster. */
 92: export function castsOnSelf(def: SkillDefinition): boolean {
 93:   return castTarget(def) !== 'enemy';
 94: }
 95: 
 96: /** Whether the selection is ignored outright (`HeroKey`, always). */
 97: export function castsOnSelfOnly(def: SkillDefinition): boolean {
 98:   return castTarget(def) === 'self';
 99: }
100: 
101: // ---- 3. the layer ----------------------------------------------------------
102: 
103: export const castTargetsLayer: CombatLayer = {
104:   name: 'castTargets',
105: };
</file>

