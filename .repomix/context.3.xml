217: /** An answer the service gave on purpose: its message is the player's to read. */
218: class ShopError extends Error {
219:   constructor(
220:     message: string,
221:     readonly status: number
222:   ) {
223:     super(message);
224:     this.name = 'ShopError';
225:   }
226: }
227: 
228: /** The service could not say who we are. A state, not a fault (see `unconfirmed`). */
229: class Unconfirmed extends Error {
230:   constructor(message: string) {
231:     super(message);
232:     this.name = 'Unconfirmed';
233:   }
234: }
