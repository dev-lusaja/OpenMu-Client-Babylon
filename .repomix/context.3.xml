  1: /**
  2:  * The shared numbers, ported from the reference client. Original-client
  3:  * units throughout (100 per tile, degrees); the facade converts once.
  4:  */
  5: 
  6: /** Original units per tile (`TERRAIN_SCALE`). */
  7: export const MU_SCALE = 100;
  8: 
  9: /**
 10:  * Innermost zoom distance: the first-person eye. Not a distance the original
 11:  * client has - it stopped at 1000 - so it is this client's own step.
 12:  */
 13: export const FIRST_PERSON_MU = 5;
 14: 
 15: /**
 16:  * The original's five wheel-zoom distances, `g_shCameraLevel` 0..4
 17:  * (CameraUtility.cpp `UpdateCameraDistance`). Kept exact: these five frame
 18:  * the hero the way the original client does.
 19:  */
 20: const PORTED_DISTANCES: readonly number[] = [1000, 1100, 1200, 1300, 1400];
 21: 
 22: /** The distance the original's default level framed the hero at. */
 23: const PORTED_DEFAULT_DISTANCE = 1200;
 24: 
 25: /**
 26:  * Camera distance per wheel-zoom level. The ported five sit in the middle;
 27:  * the steps outside them do not exist in the original client. Level 0 is the
 28:  * first-person eye, 2000 is the original's own level-5 distance
 29:  * (`CDirection.cpp:72`), and the last step frames a whole town square.
 30:  *
 31:  * Nothing sits between 300 and the eye on purpose: closer than that the hero
 32:  * fills the frame and blocks the very view the player zoomed in for, so the
 33:  * last step in glides past it into first person rather than stopping there.
 34:  */
 35: export const DISTANCE_BY_LEVEL: readonly number[] = [
 36:   FIRST_PERSON_MU,
 37:   300,
 38:   480,
 39:   660,
 40:   840,
 41:   ...PORTED_DISTANCES,
 42:   1700,
 43:   2000,
 44:   2400,
 45:   2900,
 46: ];
 47: 
 48: export const MAX_CAMERA_LEVEL = DISTANCE_BY_LEVEL.length - 1;
 49: 
 50: /**
 51:  * Level the camera opens at and returns to on warp - the original's own
 52:  * default distance, found in the ladder so it cannot drift when steps are
 53:  * added at either end.
 54:  */
 55: export const DEFAULT_CAMERA_LEVEL =
 56:   DISTANCE_BY_LEVEL.indexOf(PORTED_DEFAULT_DISTANCE);
 57: 
 58: /** `CameraDistance += (target - CameraDistance) / 3`, per 25 fps frame. */
 59: export const DISTANCE_EASE = 1 / 3;
 60: 
 61: /** The original stepped its camera math at this frame rate. */
 62: export const REFERENCE_FPS = 25;
 63: 
 64: /** Main-scene pitch, `CameraAngle[0] = -48.5` (`SetCameraAngle`). */
 65: export const CAMERA_PITCH_DEG = 48.5;
 66: 
 67: /** `CameraFOV = 30` (`SetCameraFOV`), gluPerspective vertical degrees. */
 68: export const CAMERA_FOV_DEG = 30;
 69: 
 70: /**
 71:  * Range the FOV slider offers around the original 30. The eye adds its own
 72:  * widening on top, so the slider carries first person with it: the innermost
 73:  * step runs 45 to 85 as the slider runs 20 to 60.
 74:  */
 75: export const CAMERA_FOV_MIN_DEG = 20;
 76: export const CAMERA_FOV_MAX_DEG = 60;
 77: 
 78: /**
 79:  * First-person frustum at the slider's default, vertical degrees. 30 is a
 80:  * telephoto lens on a face, so the innermost step opens up.
 81:  *
 82:  * It opened to 65, the figure the original's own tour camera uses
 83:  * (`SetCameraFOV`). That is a vertical figure and Babylon reads it as one too,
 84:  * so on a 16:9 window it is a 97 degree frustum across - wider than the wide
 85:  * end of what an FPS ships, and the outer third of the frame is stretched
 86:  * along its own radius. On the near grass and foliage, which is card geometry
 87:  * a tile from the eye, that stretch is the smearing at the edges of the shot.
 88:  * 55 is about 86 across: still open for a subject this near, and short of
 89:  * where the stretch starts to show.
 90:  */
 91: export const FIRST_PERSON_FOV_DEG = 55;
 92: 
 93: /**
 94:  * What the eye adds to the third-person frustum. Held as a difference rather
 95:  * than an absolute so the FOV slider moves both ends together - the reason
 96:  * the eye opens up is the near subject, which does not stop being true
 97:  * because the player widened their view.
 98:  */
 99: export const FIRST_PERSON_WIDEN_DEG = FIRST_PERSON_FOV_DEG - CAMERA_FOV_DEG;
100: 
101: /** Main-scene heading, `CameraAngle[2] = -45` (MainScene.cpp:117). */
102: export const DEFAULT_HEADING_DEG = -45;
103: 
104: /** Insert/Delete rotate step, degrees per reference frame while held. */
105: export const ROTATE_STEP_DEG = 15;
106: 
107: /**
108:  * Ctrl + middle-button drag, left/right: degrees of heading per pixel.
109:  * Not in the original client (it had no mouse rotate); sign matches
110:  * Babylon's default orbit feel - drag right, camera orbits clockwise.
111:  */
112: export const ROTATE_DRAG_DEG_PER_PX = 0.25;
113: 
114: /**
115:  * Ctrl + middle-button drag, up/down: degrees of pitch per pixel. Drag up
116:  * pitches the view up toward the horizon, drag down looks further down.
117:  */
118: export const PITCH_DRAG_DEG_PER_PX = 0.25;
119: 
120: /**
121:  * Pitch drag range, degrees added to the ported frame's tilt. Zero is the
122:  * original's fixed pitch; negative goes toward top-down, positive toward
123:  * the horizon. Kept narrow enough that the map edge stays out of frame.
124:  */
125: export const PITCH_OFFSET_MIN_DEG = -25;
126: export const PITCH_OFFSET_MAX_DEG = 25;
127: 
128: /**
129:  * First-person mouse look: degrees per pixel of raw mouse movement. Lower
130:  * than the drag rates above - a drag moves the cursor across the screen once,
131:  * a locked mouse keeps going, and 0.15 puts a full turn inside a mouse pad at
132:  * a typical 800 dpi.
133:  */
134: export const MOUSE_LOOK_DEG_PER_PX = 0.15;
135: 
136: /**
137:  * Pitch drag range at the eye, where the orbit clamp would leave the player
138:  * unable to look at the sky or their own feet.
139:  */
140: export const FIRST_PERSON_PITCH_LIMIT_DEG = 60;
141: 
142: /** Camera sits `CameraDistance - 150` above its base height. */
143: export const HEIGHT_BACKOFF = 150;
144: 
145: /**
146:  * Distance at which the frame starts blending out of the ported geometry
147:  * toward the eye. Equal to the ported band's floor, so every ported level
148:  * keeps its exact framing.
149:  */
150: export const CLOSE_BAND_MU = PORTED_DISTANCES[0];
151: 
152: /**
153:  * Hero eye height above the entity's ground position, original units.
154:  *
155:  * Measured off the rig, not off `playerObject.ts`: that constructor's
156:  * `BoundingBoxLocal` is a hand-drawn picking box that stops at 1.2 tiles,
157:  * which is the hero's chest, and aiming the eye there put the camera in
158:  * their ribcage. The skeleton's own head bone (`Bip01 Head`, bone 20 - the
159:  * one headTrackingSystem drives) stands at 1.61 tiles in the male idle and
160:  * 1.59 in the female one, dropping to about 1.52 in the weapon stances.
161:  */
162: export const EYE_HEIGHT_MU = 160;
163: 
164: /**
165:  * Below this the camera is behind the hero's eyes rather than behind their
166:  * back, so the body is hidden. Only the glide into the innermost step reaches
167:  * it, and it is set where the near plane below has caught up with the body -
168:  * hiding earlier would leave the hero's own aura floating in an empty frame.
169:  */
170: export const HERO_HIDE_MU = 60;
171: 
172: /**
173:  * Near plane at the eye. The hero's own item aura and crackle emit over the
174:  * body they are worn on, so at the eye they emit around the camera; half a
175:  * tile of near plane clips them without ever slicing world geometry the
176:  * player is not already standing inside.
177:  */
178: export const FIRST_PERSON_NEAR_MU = 50;
179: 
180: /**
181:  * The eased distance can land on the innermost step exactly, which would put
182:  * the camera on top of its own target and hand Babylon a zero forward vector.
183:  */
184: export const MIN_RADIUS_MU = 2;
185: 
186: /**
187:  * First-person head bob: how far the eye rises and falls, and how far the hero
188:  * covers between footfalls, in original units.
189:  *
190:  * The phase rides the distance walked rather than the clock, so it holds to
191:  * the stride at any speed, stops dead when the hero does and cannot drift on a
192:  * stutter. 70 units is about two thirds of a tile, which is a step at the
193:  * scale a 160-unit eye implies. The rise is deliberately small: what sells the
194:  * eye is not the movement, it is that the camera stops being a fixed point in
195:  * space.
196:  */
197: export const BOB_RISE_MU = 3;
198: export const BOB_STRIDE_MU = 70;
199: 
200: /** Under this, in tiles a second, the hero counts as standing. */
201: export const BOB_WALK_MIN = 0.35;
202: 
203: /** How fast the bob comes and goes at the ends of a walk, per second. */
204: export const BOB_EASE = 6;
205: 
206: /**
207:  * A step no hero takes: a warp, a teleport or a server correction moves the
208:  * target this far in one frame, and walking it into the phase would put the
209:  * bob wherever the jump happened to land.
210:  */
211: export const BOB_JUMP_MU = 200;
212: 
213: /** How often a hidden hero's mesh list is re-scanned for streamed-in parts. */
214: export const HERO_RESCAN_SECONDS = 0.25;
</file>

