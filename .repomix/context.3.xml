236: /**
237:  * Whether the service actually spoke: a refusal in its own words, or the
238:  * session exchange failing before anything was sent. Everything else - the
239:  * socket dropping, the placement ceiling in `rollGacha` - is silence, and
240:  * silence after a POST is not "no": the service writes the order before its
241:  * answer travels, so the order may well be in the queue. A spend that met
242:  * silence asks the queue (`landed`) before it tells the player anything.
243:  */
244: function answered(error: unknown): boolean {
245:   return error instanceof ShopError || error instanceof Unconfirmed;
246: }
247: 
248: /**
249:  * What the window is told of an answer. The service writes its refusals for
250:  * the player and they are shown as they are; anything else - a socket that
251:  * never connected, a body that was not JSON - is the shop being unreachable,
252:  * in the player's language rather than the browser's.
253:  */
254: function message(error: unknown): string {
255:   if (error instanceof ShopError || error instanceof Unconfirmed) return error.message;
256: 
257:   return t('cashShop.unreachable');
258: }
