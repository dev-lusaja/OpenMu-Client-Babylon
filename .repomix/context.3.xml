373: /* -------------------------------------------------------------- catalogue */
374: 
375: /** Loads the catalogue once. Safe to call on every open. */
376: export async function ensureCatalogue(): Promise<void> {
377:   if (CashShopState.status === 'loading' || CashShopState.status === 'ready') return;
378: 
379:   runInAction(() => {
380:     CashShopState.status = 'loading';
381:     CashShopState.error = null;
382:   });
383: 
384:   try {
385:     const answer = await request<{ lines: Line[]; products: Product[] }>('/catalog');
386: 
387:     runInAction(() => {
388:       CashShopState.lines = answer.lines;
389:       CashShopState.catalogue = answer.products;
390:       CashShopState.status = 'ready';
391:     });
392:   } catch (error) {
393:     runInAction(() => {
394:       CashShopState.status = 'failed';
395:       CashShopState.error = message(error);
396:     });
397:   }
398: }
399: 
400: /* ----------------------------------------------------------------- orders */
401: 
402: /**
403:  * Re-read while the window is open. Delivery happens at logout, so what this
404:  * mostly catches is the wallet moving under an order that was placed on
405:  * another device, and a queue the operator settled by hand; it does not
406:  * need to be quick.
407:  */
408: const ORDERS_POLL_MS = 30_000;
409: 
410: let ordersInFlight: Promise<void> | null = null;
411: 
412: /**
413:  * The queue, the wallet and today's counts, from the service. Called on open,
414:  * after every order and cancellation, when the drop settles, and on the poll.
415:  * Concurrent calls share one request: the answer is the same either way.
416:  */
417: export function refreshOrders(): Promise<void> {
418:   if (!ordersInFlight) {
419:     ordersInFlight = readOrders().finally(() => {
420:       ordersInFlight = null;
421:     });
422:   }
423: 
424:   return ordersInFlight;
425: }
426: 
427: async function readOrders(): Promise<void> {
428:   let view: OrdersView;
429: 
430:   try {
431:     view = await ticketed<OrdersView>('/orders', 'GET');
432:   } catch (error) {
433:     runInAction(() => {
434:       if (error instanceof Unconfirmed) {
435:         // Nothing to show and nothing wrong: `unconfirmed` carries the why.
436:         CashShopState.orders = [];
437:         CashShopState.acceptingOrders = false;
438:         CashShopState.wallet = null;
439:         CashShopState.spentToday = {};
440:         CashShopState.ordersError = null;
441:       } else {
442:         CashShopState.ordersError = message(error);
443:       }
444:     });
445: 
446:     return;
447:   }
448: 
449:   // The one sound that does not come from the drop's clock: the item is in
450:   // the bag only when the service says so, which with fulfilment rehearsing
451:   // is never, and the shop must not claim a delivery it has not made. Only a
452:   // transition counts - an order that was already delivered when the window
453:   // first read it is old news.
454:   const before = new Map(CashShopState.orders.map(order => [order.id, order.state]));
455:   const justDelivered = view.orders.some(order => {
456:     const was = before.get(order.id);
457: 
458:     // A gacha's arrival is announced by its own opening, which has a whole
459:     // score of its own; two sounds for one delivery is one too many.
460:     return order.line !== 'gacha' && order.state === 'delivered' && was !== undefined && was !== 'delivered';
461:   });
462: 
463:   // A roll is only ever sent once it is delivered, so anything here with a
464:   // roll on it has been paid for and is the player's to see.
465:   const opened = openedIds();
466:   const unopened = view.orders
467:     .filter(order => order.line === 'gacha' && order.state === 'delivered' && order.roll && !opened.has(order.id))
468:     .reverse();
469: 
470:   runInAction(() => {
471:     CashShopState.orders = view.orders;
472:     CashShopState.unopened = unopened;
473:     CashShopState.acceptingOrders = view.acceptingOrders;
474:     CashShopState.wallet = view.wallet;
475:     CashShopState.spentToday = view.spentToday;
476:     CashShopState.ordersError = null;
477: 
478:     // The settled stage's status line follows the same order as the queue.
479:     const shown = CashShopState.order;
480:     if (shown) CashShopState.order = view.orders.find(order => order.id === shown.id) ?? shown;
481:   });
482: 
483:   if (justDelivered) playUiSound('getItem');
484: }
485: 
486: /** Places one order. The service's answer is the order; its refusal is the reason. */
487: async function placeOrder(productId: string, signal?: AbortSignal): Promise<Order> {
488:   const { order } = await ticketed<{ order: Order }>('/orders', 'POST', { productId }, signal);
489: 
490:   return order;
491: }
492: 
493: /** The ids the queue held before a press, so what it gains afterwards can be told apart. */
494: const knownOrders = (): ReadonlySet<string> => new Set(CashShopState.orders.map(order => order.id));
495: 
496: /**
497:  * The order a press placed when its answer never came: after `refreshOrders`,
498:  * the one for that product the queue did not hold before the press. Null
499:  * when nothing landed - or has not landed yet; a write the service is still
500:  * slow to finish shows up on the poll, in the Orders tab.
501:  */
502: function landed(before: ReadonlySet<string>, productId: string): Order | null {
503:   return CashShopState.orders.find(order => order.productId === productId && !before.has(order.id)) ?? null;
504: }
505: 
506: /**
507:  * Buys a fixed product. The window has already asked the player to confirm;
508:  * this is the placement, and it resolves to whether the service took it. On
509:  * success the queue is re-read so the wallet and today's counts move with
510:  * it; on refusal the service's sentence lands in `buyError` as it is.
511:  */
512: export async function buy(productId: string): Promise<boolean> {
513:   if (CashShopState.buying) return false;
514: 
515:   const before = knownOrders();
516: 
517:   runInAction(() => {
518:     CashShopState.buying = productId;
519:     CashShopState.buyError = null;
520:   });
521: 
522:   let order: Order;
523: 
524:   try {
525:     order = await placeOrder(productId);
526:   } catch (error) {
527:     if (!answered(error)) {
528:       await refreshOrders();
529:       const found = landed(before, productId);
530: 
531:       runInAction(() => {
532:         CashShopState.buying = null;
533:         CashShopState.buyError = found ? null : t('cashShop.noAnswer');
534:       });
535:       playUiSound(found ? 'coin' : 'error');
536: 
537:       return found !== null;
538:     }
539: 
540:     runInAction(() => {
541:       CashShopState.buying = null;
542:       CashShopState.buyError = message(error);
543:     });
544:     playUiSound('error');
545: 
546:     return false;
547:   }
548: 
549:   runInAction(() => {
550:     CashShopState.orders = [order, ...CashShopState.orders];
551:     CashShopState.buying = null;
552:   });
553: 
554:   // The jewels are promised on the frame the order is committed.
555:   playUiSound('coin');
556:   await refreshOrders();
557: 
558:   return true;
559: }
560: 
561: /** Takes back a queued order. The service decides what may be (never a roll). */
562: export async function cancelOrder(id: string): Promise<boolean> {
563:   try {
564:     const { order } = await ticketed<{ order: Order }>('/orders/cancel', 'POST', { id });
565: 
566:     runInAction(() => {
567:       CashShopState.orders = CashShopState.orders.map(known => (known.id === order.id ? order : known));
568:       CashShopState.buyError = null;
569:     });
570:     await refreshOrders();
571: 
572:     return true;
573:   } catch (error) {
574:     if (!answered(error)) {
575:       await refreshOrders();
576:       if (CashShopState.orders.some(known => known.id === id && known.state === 'cancelled')) return true;
577:     }
578: 
579:     runInAction(() => {
580:       CashShopState.buyError = answered(error) ? message(error) : t('cashShop.noAnswer');
581:     });
582:     playUiSound('error');
583: 
584:     return false;
585:   }
586: }
587: 
588: /* ----------------------------------------------------------------- window */
589: 
590: let poll: ReturnType<typeof setInterval> | null = null;
591: 
592: export function toggleCashShopWindow(open?: boolean): void {
593:   runInAction(() => {
594:     CashShopState.windowOpen = open ?? !CashShopState.windowOpen;
595:   });
596: 
597:   if (CashShopState.windowOpen) {
598:     void ensureCatalogue();
599:     void refreshOrders().then(openOnSight);
600: 
601:     if (!poll) poll = setInterval(() => void refreshOrders(), ORDERS_POLL_MS);
602:   } else {
603:     abandonRoll();
604: 
605:     if (poll) {
606:       clearInterval(poll);
607:       poll = null;
608:     }
609:   }
610: }
611: 
612: /** Switches tab. Leaving the gacha mid-drop abandons it: the order is already the service's. */
613: export function setCashShopTab(tab: ProductLine): void {
614:   if (tab === CashShopState.tab) return;
615: 
616:   if (CashShopState.tab === 'gacha') abandonRoll();
617: 
618:   runInAction(() => {
619:     CashShopState.tab = tab;
620:     CashShopState.buyError = null;
621:   });
622: 
623:   if (tab === 'gacha') openSealed();
624: }
625: 
626: /**
627:  * Once per window open: a roll that arrived while the player was away is the
628:  * best reason the window has to be looked at, so the gacha tab is what opens.
629:  * Only here, never on the poll - a tab pulled out from under someone
630:  * mid-purchase would be a bug, however good the news.
631:  */
632: function openOnSight(): void {
633:   if (!CashShopState.windowOpen || CashShopState.unopened.length === 0) return;
634: 
635:   runInAction(() => {
636:     CashShopState.tab = 'gacha';
637:   });
638: 
639:   openSealed();
640: }
641: 
642: /* ------------------------------------------------------------------ gacha */
643: 
644: /**
645:  * The drop, run from here because this module is the only clock. Every beat
646:  * is a timer from `SEAL` / `OPEN` (or their calm tables), held in `timers`
647:  * so closing the window can clear them all: no sound may fire at a stage
648:  * nobody is looking at.
649:  *
650:  * `attempt` names the press each timer belongs to. A press, an abandon and a
651:  * refusal each bump it, so a request that answers after the window closed
652:  * still records its order - the service has committed it - but plays
653:  * nothing and runs no theatre.
654:  */
655: let timers: ReturnType<typeof setTimeout>[] = [];
656: let attempt = 0;
657: 
658: function cancelTimeline(): void {
659:   for (const timer of timers) clearTimeout(timer);
660:   timers = [];
661: }
662: 
663: /** Read per roll rather than at load: the OS setting can change mid-session. */
664: const calmDown = (): boolean =>
665:   typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
666: 
667: function setPhase(phase: Phase): void {
668:   runInAction(() => {
669:     CashShopState.phase = phase;
670:   });
671: }
672: 
673: function knock(): void {
674:   runInAction(() => {
675:     CashShopState.knock++;
676:   });
677: }
678: 
679: /** Phases a new press is taken from. */
680: const ARMED: ReadonlySet<Phase> = new Set<Phase>(['idle', 'sealed', 'prize', 'settled']);
681: 
682: /** Whether the Roll button should take a press right now. */
683: export function canRoll(): boolean {
684:   return ARMED.has(CashShopState.phase) && CashShopState.catalogue.some(product => product.line === 'gacha');
685: }
686: 
687: /**
688:  * Closing the window, leaving the tab, or re-rolling from `prize` onward. The
689:  * order is already committed server-side, so a reopened stage shows the
690:  * settled reveal rather than replaying the ceremony.
691:  */
692: export function abandonRoll(): void {
693:   cancelTimeline();
694:   attempt++;
695: 
696:   runInAction(() => {
697:     CashShopState.phase = CashShopState.roll ? 'settled' : 'idle';
698:   });
699: }
700: 
701: /**
702:  * A paid roll, up to the lock. The press mounts the box and sends the order
703:  * together; the fall and the request are awaited as one, so a fast answer
704:  * still gets the full drop and a slow one leaves the box hanging over the
705:  * floor rather than desynchronising it. Everything after the landing is
706:  * fixed-length theatre.
707:  *
708:  * What it is not is a reveal. The order that comes back carries no roll - the
709:  * service seals it until the jewels have been taken - so there is nothing
710:  * here to leak, and nothing in this half may be drawn from the outcome. The
711:  * box locks, and `openSealed` finishes the story at the next login.
712:  */
713: export async function rollGacha(): Promise<void> {
714:   if (!ARMED.has(CashShopState.phase)) return;
715: 
716:   const product = CashShopState.catalogue.find(entry => entry.line === 'gacha');
717:   if (!product) return;
718: 
719:   cancelTimeline();
720:   const mine = ++attempt;
721:   const before = knownOrders();
722:   const calm = calmDown();
723:   const at = (ms: number, run: () => void): void => {
724:     if (ms < 0) return;
725:     timers.push(
726:       setTimeout(() => {
727:         if (attempt === mine) run();
728:       }, ms)
729:     );
730:   };
731: 
732:   runInAction(() => {
733:     CashShopState.phase = 'falling';
734:     CashShopState.roll = null;
735:     CashShopState.order = null;
736:     CashShopState.rollError = null;
737:     CashShopState.calm = calm;
738:   });
739: 
740:   const S = calm ? SEAL_CALM : SEAL;
741:   const control = new AbortController();
742:   const ceiling = setTimeout(() => control.abort(), PLACE_TIMEOUT_MS);
743:   const placed = placeOrder(product.id, control.signal);
744:   const fell = new Promise<void>(resolve => setTimeout(resolve, calm ? 0 : FALL_MS));
745: 
746:   let order: Order;
747: 
748:   try {
749:     [order] = await Promise.all([placed, fell]);
750:   } catch (error) {
751:     if (answered(error)) {
752:       // Refused: no coin, the jewel never left. The box is yanked back up and
753:       // the stage goes idle with the reason where the hint was.
754:       if (attempt !== mine) return;
755: 
756:       runInAction(() => {
757:         CashShopState.phase = 'refused';
758:         CashShopState.rollError = message(error);
759:       });
760:       playUiSound('error');
761:       at(REFUSED_MS, () => setPhase('idle'));
762: 
763:       return;
764:     }
765: 
766:     // Silence (see `answered`): the roll may be committed on the far side of
767:     // it. The box is yanked and the stage says the shop did not answer, and
768:     // Roll stays down until the queue has been asked - a player told "no"
769:     // by a shop that in fact said "yes" would pay for a second box. A roll
770:     // that did land settles the stage rather than replaying the drop: the
771:     // ceremony belongs to the frame the answer arrived on, and none did.
772:     if (attempt === mine) {
773:       runInAction(() => {
774:         CashShopState.phase = 'refused';
775:         CashShopState.rollError = t('cashShop.noAnswer');
776:       });
777:       playUiSound('error');
778:     }
779: 
780:     await refreshOrders();
781:     if (attempt !== mine) return;
782: 
783:     const found = landed(before, product.id);
784: 
785:     if (found) {
786:       runInAction(() => {
787:         CashShopState.order = found;
788:         CashShopState.phase = 'sealed';
789:         CashShopState.rollError = null;
790:       });
791:     } else {
792:       at(REFUSED_MS, () => setPhase('idle'));
793:     }
794: 
795:     return;
796:   } finally {
797:     clearTimeout(ceiling);
798:   }
799: 
800:   if (attempt !== mine) {
801:     // Committed while nobody was watching. Keep the order - the service has
802:     // it either way - and play nothing.
803:     runInAction(() => {
804:       CashShopState.orders = [order, ...CashShopState.orders];
805:     });
806: 
807:     return;
808:   }
809: 
810:   // Landed. The queue gains the order now, so the wallet bar's committed sum
811:   // drops on this frame and never before.
812:   runInAction(() => {
813:     CashShopState.order = order;
814:     CashShopState.phase = 'landed';
815:     CashShopState.orders = [order, ...CashShopState.orders];
816:   });
817:   playUiSound('dropItem');
818: 
819:   at(S.feed, () => playUiSound('coin'));
820:   at(S.fed, () => {
821:     setPhase('rattling');
822:     playUiSound('gemstone');
823:   });
824:   // Quieter than the thud it echoes; only `playSfx` takes a gain.
825:   at(S.knockA, () => {
826:     knock();
827:     playSfx('Sound/pDropItem', null, { gain: 0.45, bus: UI_BUS });
828:   });
829:   at(S.knockB, () => {
830:     knock();
831:     playSfx('Sound/pDropItem', null, { gain: 0.45, bus: UI_BUS });
832:   });
833:   // The clasp. The box is the same box whatever is in it, so this is the last
834:   // thing the player is told until it is paid for.
835:   at(S.shut, () => {
836:     setPhase('sealing');
837:     playUiSound('repair');
838:   });
839:   at(S.sealed, () => {
840:     setPhase('sealed');
841:     void refreshOrders();
842:   });
843: }
844: 
845: /**
846:  * The other half: a roll that has been delivered, opened at last.
847:  *
848:  * By the time this runs the jewels are gone and the item is in the bag - the
849:  * service only sends a roll once its order is `delivered` - so there is
850:  * nothing left to shop for and the whole tier can be spent on the reveal.
851:  * The box comes back sealed, cracks in the tier's colour, slams shut on the
852:  * Chaos Machine's failure chime, and bursts after a silence whose length is
853:  * the tier.
854:  */
855: export function openSealed(): void {
856:   if (!CashShopState.windowOpen || CashShopState.tab !== 'gacha') return;
857:   if (!ARMED.has(CashShopState.phase)) return;
858: 
859:   const order = CashShopState.unopened[0];
860:   const roll = order?.roll;
861: 
862:   if (!order || !roll) return;
863: 
864:   cancelTimeline();
865:   const mine = ++attempt;
866:   const calm = calmDown();
867:   const O = calm ? OPEN_CALM : OPEN;
868:   const look = TIERS[roll.tier];
869:   const at = (ms: number, run: () => void): void => {
870:     if (ms < 0) return;
871:     timers.push(
872:       setTimeout(() => {
873:         if (attempt === mine) run();
874:       }, ms)
875:     );
876:   };
877: 
878:   // Marked before a frame of it plays. A poll landing mid-ceremony must not
879:   // queue the same box again, and a reveal the player walked out on is still
880:   // a reveal they were given - replaying it on every window open would be
881:   // worse than missing it once.
882:   markOpened(order.id);
883: 
884:   runInAction(() => {
885:     CashShopState.order = order;
886:     CashShopState.roll = roll;
887:     CashShopState.phase = 'sealed';
888:     CashShopState.rollError = null;
889:     CashShopState.calm = calm;
890:   });
891:   playUiSound('dropItem');
892: 
893:   at(O.seam, () => {
894:     setPhase('seam');
895:     playUiSound('window');
896:   });
897:   if (look.announce) {
898:     const announce = look.announce;
899:     at(O.announce, () => playUiSound(announce));
900:   }
901:   at(O.strain, () => setPhase('strain'));
902:   at(O.slam, () => {
903:     setPhase('slam');
904:     playUiSound('mixFailed');
905:   });
906:   at(O.hush, () => setPhase('hush'));
907: 
908:   const burst = calm ? O.seam + CALM_BURST_MS : O.hush + look.hold;
909: 
910:   at(burst, () => {
911:     setPhase('burst');
912:     playUiSound('win');
913:   });
914:   for (const sting of TIER_STING[roll.tier]) {
915:     at(burst + sting.at, () => playUiSound(sting.key));
916:   }
917:   // The Roll button re-arms here: a player can pay for the next box the
918:   // instant they have seen what this one held.
919:   at(burst + O.afterPrize, () => setPhase('prize'));
920:   if (!calm) {
921:     roll.options.forEach((_, index) =>
922:       at(burst + O.afterOption + index * O.optionStep, () =>
923:         playSfx('Sound/iButtonMove', null, { gain: 0.3, bus: UI_BUS })
924:       )
925:     );
926:   }
927:   // Straight on to the next, if more than one arrived while they were away.
928:   at(burst + O.afterSettle, () => {
929:     setPhase('settled');
930:     openSealed();
931:   });
932: }
933: 
934: /* ----------------------------------------------------------------- wallet */
935: 
936: /**
937:  * Jewels of Chaos the player is carrying right now.
938:  *
939:  * Inventory only: the vault is not loaded into the client unless it is open,
940:  * so counting it here would show zero for anyone who banks their jewels, which
941:  * is worse than saying plainly that this is what is on the character.
942:  */
943: export function walletOnHand(items: readonly (Item | null)[]): number {
944:   let count = 0;
945: 
946:   for (const item of items) {
947:     if (item && item.group === JEWEL_OF_CHAOS.group && item.num === JEWEL_OF_CHAOS.num) count++;
948:   }
949: 
950:   return count;
951: }
952: 
953: /** Jewels already promised to orders that have not been delivered or dropped. */
954: export function committedChaos(orders: readonly Order[] = CashShopState.orders): number {
955:   let sum = 0;
956: 
957:   for (const order of orders) {
958:     if (order.state === 'queued' || order.state === 'delivering') sum += order.chaos;
959:   }
960: 
961:   return sum;
962: }
963: 
964: /**
965:  * What the next order can spend: the service's wallet minus what the queue
966:  * has promised once it has confirmed who we are, else the bag. Never below
967:  * zero on screen - a wallet that shrank under its queue is the service's
968:  * problem to refuse, not a negative number for the player to read.
969:  */
970: export function chaosToSpend(items: readonly (Item | null)[]): number {
971:   const { wallet } = CashShopState;
972: 
973:   if (wallet) return Math.max(wallet.chaos - committedChaos(), 0);
974: 
975:   return walletOnHand(items);
976: }
977: 
978: /**
979:  * Why the window should grey a product out, or null when it should not.
980:  *
981:  * Advice, not a verdict: the service bounds every order against its own
982:  * wallet and today's counts, and its refusal - in its own words - is what the
983:  * player sees when this and the service disagree. The four reasons are
984:  * checked in the order the player can fix them.
985:  */
986: export function blockedReason(product: Product, items: readonly (Item | null)[]): string | null {
987:   const { account, unconfirmed, acceptingOrders, spentToday } = CashShopState;
988: 
989:   if (!account) return unconfirmed ?? t('cashShop.unconfirmed');
990:   if (!acceptingOrders) return t('cashShop.notAccepting');
991:   if ((spentToday[product.id] ?? 0) >= product.dailyCap) return t('cashShop.dailyCapReached');
992:   if (chaosToSpend(items) < product.chaos) return t('cashShop.notEnoughChaos');
993: 
994:   return null;
995: }
