302:   /** Next follow-up target whose 0x4A is due, or -1. */
303:   nextDarkSideHit(): number {
304:     return nextDarkSideHit();
305:   }
306: 
307:   /** Skill id for the follow-up 0x4A. */
308:   get darkSidePendingSkill(): number {
309:     return darkSidePendingSkill();
310:   }
311: 
312:   /** An `ObjectHit` flagged as a Rage Fighter streak hit arrived. */
313:   observeRageHit(isStreak: boolean, isFinal: boolean): void {
314:     observeRageHit(isStreak, isFinal);
315:   }
316: 
317:   /** Hits in the running Rage Fighter streak. */
318:   get rageStreak(): number {
319:     return rageStreak();
320:   }
321: }
322: 
323: export const combat = new Combat();
324: 
325: // A hot update that reaches this module must reload the page: Vite would
326: // otherwise re-execute it and hand later-loaded importers a second instance
327: // of this singleton (same guard as store.ts).
328: const hot = (import.meta as { hot?: { decline(): void } }).hot;
329: if (hot) hot.decline();
