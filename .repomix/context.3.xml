  6: import { Store, UIState } from './store';
  7: import { Social } from './social';
  8: import { Commands } from './commands';
  9: import { GmPanel } from './gmPanel';
 10: import { Economy } from './economy';
 11: import { weather } from './weather';
 12: import { sound, installUiWindowChime } from './sound';
 13: import { Engine } from './libs/babylon/exports';
 14: import { createEngine } from './libs/babylon/utils';
 15: import { TestScene } from './scenes/testScene';
 16: import { loadMapIntoScene } from './libs/mu/loadMapIntoScene';
 17: import { prefetchWorldTerrain } from './libs/mu/prefetchWorld';
 18: import { createWorld } from './ecs/createWorld';
 19: import { EventBus } from './libs/eventBus';
 20: import { installLoginMusic } from './libs/loginMusic';
 21: import { setKeyProfile } from './common/keyBindings';
 22: import { installBrowserHotkeyGuard } from './common/browserHotkeys';
 23: import { SessionResume } from './common/sessionResume';
 24: import { reaction } from 'mobx';
 25: import { watchStateWarnings } from './common/stateWarnings';
 26: import { watchPageTitle } from './common/pageTitle';
 27: import {
 28:   preloadPregameSprites,
 29:   preloadWorldSprites,
 30: } from './libs/mu/preloadSprites';
 31: import { installPerfOverlay, recordFrame } from './libs/perfOverlay';
 32: import { refreshServerList } from './common/serverList';
 33: 
 34: if (APP_STAGE === 'dev' || QA_ENABLED) {
 35:   import('@babylonjs/core/Legacy/legacy');
 36: }
 37: 
 38: installUiWindowChime();
 39: // Durability / full grid / last potion / buff ending, on the notice banner.
 40: watchStateWarnings();
 41: 
 42: // The browser tab: the client's name until the player is in, the world's after.
 43: watchPageTitle();
 44: 
 45: // What a lost game server socket does before falling back to the server
 46: // list. Wired here rather than in logic.ts, which the store's own module
 47: // graph reaches before `Store` exists.
 48: Store.resumeHook = () => SessionResume.retry() || SessionResume.begin();
 49: 
 50: // Hot keys are per character: the shared set is what a new one starts from.
 51: reaction(
 52:   () => Store.playerData.name,
 53:   name => setKeyProfile(name)
 54: );
 55: 
 56: const canvas = document.querySelector('canvas')!;
 57: 
 58: let useAntialiaing = false;
 59: 
 60: let engine: Engine;
 61: try {
 62:   const result = createEngine(canvas, useAntialiaing);
 63:   engine = result.engine;
 64:   engine.hideLoadingUI();
 65: } catch (e) {
 66:   console.error(e);
 67:   throw e;
 68: }
 69: 
 70: // The browser's own chords (Ctrl+W, Ctrl+R, F5, the zoom keys) taken off the
 71: // keyboard before anything else listens on it (`common/browserHotkeys.ts`).
 72: // The game's own keydown guards - page scroll keys, Tab, Alt, IME, the window
 73: // stack - live in `ecs/systems/keyboardInputSystem.ts`.
 74: installBrowserHotkeyGuard(
 75:   () =>
 76:     Store.uiState === UIState.World ||
 77:     Store.uiState === UIState.LoadingWorld ||
 78:     Store.uiState === UIState.Characters
 79: );
 80: 
 81: const ignoredIds = ['scene-explorer-host', 'inspector-host'];
 82: 
 83: // The right button is the cast button (`Attack()` with MouseRButton), and
 84: // the browser's context menu carries "Reload" - one right click that lands
 85: // on a HUD element, a window, a name tag or the page margin instead of the
 86: // canvas used to open it, and a slip from there reloaded the game. The
 87: // canvas already swallowed its own `contextmenu`; this covers everything
 88: // else on the page. Text fields keep theirs: an input's menu has no reload
 89: // entry and is how some players paste into chat.
 90: window.addEventListener('contextmenu', ev => {
 91:   let p = ev.target as HTMLElement | null;
 92:   while (p) {
 93:     if (p.isContentEditable) return;
 94:     const tag = p.tagName;
 95:     if (tag === 'INPUT' || tag === 'TEXTAREA') return;
 96:     if (p.classList && ignoredIds.includes(p.id)) return;
 97:     p = p.parentElement;
 98:   }
 99:   ev.preventDefault();
100: });
101: window.addEventListener(
102:   'wheel',
103:   ev => {
104:     let p = ev.target as HTMLElement;
105:     while (p) {
106:       if (
107:         p.classList &&
108:         (p.classList.contains('scrollable') || ignoredIds.includes(p.id))
109:       )
110:         return;
111: 
112:       p = p.parentElement as any;
113:     }
114: 
115:     ev.preventDefault();
116:   },
117:   { passive: false }
118: );
119: 
120: let _hiddenAttr = '';
121: const onVisibilityChanged = () => {
122:   const hidden = !!document[_hiddenAttr as 'hidden'];
123: 
124:   EventBus.emit('pageVisibilityChanged', !hidden);
125: };
126: 
127: if (document.hidden !== undefined) {
128:   _hiddenAttr = 'hidden';
129:   document.addEventListener('visibilitychange', onVisibilityChanged, false);
130: }
131: //@ts-ignore
132: else if (document.mozHidden !== undefined) {
133:   _hiddenAttr = 'mozHidden';
134:   document.addEventListener('mozvisibilitychange', onVisibilityChanged, false);
135: }
136: //@ts-ignore
137: else if (document.msHidden !== undefined) {
138:   _hiddenAttr = 'msHidden';
139:   document.addEventListener('msvisibilitychange', onVisibilityChanged, false);
140: }
141: //@ts-ignore
142: else if (document.webkitHidden !== undefined) {
143:   _hiddenAttr = 'webkitHidden';
144:   document.addEventListener(
145:     'webkitvisibilitychange',
146:     onVisibilityChanged,
147:     false
148:   );
149: }
150: 
151: const scene = new TestScene(engine);
152: 
153: sound.init(scene);
154: // `MUSIC_LOGIN_THEME` over the server / login / character pages.
155: installLoginMusic();
156: 
157: const { world, updateSystems } = createWorld(scene);
158: Store.world = world;
159: 
160: // Render-budget overlay: Shift+Ctrl+Alt+P. Dormant until toggled.
161: installPerfOverlay(scene);
162: 
163: (window as any).__scene = scene;
164: (window as any).__world = world;
165: (window as any).__social = Social;
166: (window as any).__commands = Commands;
167: (window as any).__gmPanel = GmPanel;
168: // Live instance for the CDP scenario scripts: a dynamic import('/src/economy.ts')
169: // gets a second module copy (vite serves the live graph as `?t=`-stamped URLs)
170: // whose state never changes.
171: (window as any).__eco = Economy;
172: (window as any).__store = Store;
173: // The sound facade, for the headless verification scripts (`sound.unlocked`,
174: // `sound.isPlaying(key)`, `sound.crackling`).
175: (window as any).__sound = sound;
176: // The weather facade, for the same reason. Fire, snow and rain are all things
177: // a screenshot has to be able to *cause* before it can show them, and the only
178: // other way in is to cast a real spell at a real monster.
179: (window as any).__weather = weather;
180: 
181: /**
182:  * Longest step any system is handed. Coming back from an alt-tab (or from a
183:  * map load that blocked the main thread) otherwise feeds a multi-second dt
184:  * into movement, fades and timers at once: characters teleport along their
185:  * path, death fades finish instantly, particle bursts skip their whole life.
186:  * 100 ms is a hard frame-rate floor of 10 fps for simulation purposes.
187:  */
188: const MAX_FRAME_DELTA = 0.1;
189: 
190: /**
191:  * Babylon queues the next animation frame only after the render function
192:  * returns: an exception out of a frame ends the render loop for good, and
193:  * the game "hangs" in the worst possible way - the canvas freezes while the
194:  * socket keeps delivering packets and the sounds keep playing (that is what
195:  * a Summoner saw when a Drain Life tether expired). A frame that throws is
196:  * logged and skipped; the next one runs. Logging is throttled so a fault
197:  * that repeats every frame does not bury the console.
198:  */
199: const FRAME_ERROR_LOG_INTERVAL_MS = 5000;
200: let lastFrameErrorAt = -Infinity;
201: let frameErrorsSinceLog = 0;
202: 
203: let lastTime = performance.now();
204: engine.runRenderLoop(() => {
205:   const now = performance.now();
206: 
207:   const frameMs = now - lastTime;
208:   const deltaTime = Math.min(frameMs / 1000, MAX_FRAME_DELTA);
209:   // Advanced before the frame runs, so a frame that throws is not replayed
210:   // as a double-length one by the next.
211:   lastTime = now;
212: 
213:   try {
214:     world.gameTime.TotalGameTime.TotalSeconds += deltaTime;
215: 
216:     const updateStarted = performance.now();
217:     updateSystems(deltaTime);
218:     recordFrame(performance.now() - updateStarted, frameMs);
219: 
220:     scene.render();
221:   } catch (err) {
222:     frameErrorsSinceLog++;
223:     if (now - lastFrameErrorAt >= FRAME_ERROR_LOG_INTERVAL_MS) {
224:       console.error(
225:         `frame threw (${frameErrorsSinceLog} since last report), continuing:`,
226:         err
227:       );
228:       lastFrameErrorAt = now;
229:       frameErrorsSinceLog = 0;
230:     }
231:   }
232: });
233: 
234: const onResize = () => engine.resize();
235: 
236: window.addEventListener('resize', onResize);
237: 
238: onResize();
239: 
240: EventBus.on('requestWarp', ({ map, pos }) => {
241:   // Every warp, the step from the login backdrop to the character one
242:   // included: that one is a full terrain swap plus the character line-up, and
243:   // skipping the screen for it meant watching both load on an open scene.
244:   Store.setSceneLoading(true);
245: 
246:   // The terrain files go out together, before the loader's first await; the
247:   // loader picks up the same promises (prefetchWorld.ts).
248:   if (map !== world.mapIndex) prefetchWorldTerrain(map);
249: 
250:   loadMapIntoScene(world, map, pos);
251: });
252: 
253: preloadPregameSprites()
254:   .finally(() => Store.setSpritesLoading(false))
255:   .then(() => preloadWorldSprites());
256: 
257: // The published server list (`common/serverList.ts`), once per launch. Nothing
258: // waits on it: it fills the picker when it lands, and the saved servers are
259: // what the client uses until then - or instead, if it never lands.
260: refreshServerList();
261: 
262: ReactDOM.createRoot(document.getElementById('root')!).render(
263:   <React.StrictMode>
264:     <App />
265:   </React.StrictMode>
266: );
267: 
268: if (Store.isOffline) {
269:   Store.playOffline();
270: }
