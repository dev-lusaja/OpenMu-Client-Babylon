<file path="src/combat/novaCharge.ts">
  1: /**
  2:  * Nova's held charge (`Attack()` ZzzInterface.cpp:6696-6770, `AttackWizard`
  3:  * :5777-5850): pressing the right button with Nova selected sends
  4:  * `AT_SKILL_NOVA_BEGIN` (58) on the hero and plays PLAYER_SKILL_HELL_BEGIN;
  5:  * the button is then held (`MouseRButtonPress++` every frame) and the
  6:  * release - or a left click, `SkillKeyPush` - sends `AT_SKILL_NOVA` (40) at
  7:  * the selected target and plays PLAYER_SKILL_HELL_START. The server scales
  8:  * the damage by how long the charge was held (`SkillStageUpdate`).
  9:  *
 10:  * Driven by `skillCastSystem` (`beginNova` / `releaseNova`); read by it and
 11:  * by the HUD / lighting that want the charge strength.
 12:  */
 13: import type { ENUM_WORLD } from '../common/types';
 14: import { SkillStageUpdatePacket } from '../common/packets/ServerToClientPackets';
 15: import { EventBus } from '../libs/eventBus';
 16: import type { CombatLayer } from './layer';
 17: import { SKILL_NOVA } from './recipes';
 18: 
 19: // ---- 1. tuning -------------------------------------------------------------
 20: 
 21: /**
 22:  * Seconds of holding for a full charge. The server reports up to 12 stages
 23:  * (`SkillStageUpdate`) and the original's `m_bySkillCount` climbs one per
 24:  * `AttackTime % 5 == 1` - five ticks (0.2 s) per stage → 2.4 s to the top.
 25:  */
 26: const FULL_CHARGE_SECONDS = 2.4;
 27: 
 28: /** Stages the server counts; the reader exposes the fraction, this the step count. */
 29: const CHARGE_STAGES = 12;
 30: 
 31: // ---- 2. state + readers ----------------------------------------------------
 32: 
 33: let charging = false;
 34: let held = 0;
 35: /**
 36:  * `o->m_bySkillCount` of every caster in scope (`ReceiveSkillCount`, 0xBA):
 37:  * the server's stage of a Nova being charged by another player, by net id.
 38:  */
 39: const remoteStages = new Map<number, number>();
 40: 
 41: /** The server-reported Nova stage (0…12) of a caster in scope; 0 when none. */
 42: export function novaStageOf(netId: number): number {
 43:   return remoteStages.get(netId & 0x7fff) ?? 0;
 44: }
 45: 
 46: /** The right button is down on a Nova charge. */
 47: export function novaCharging(): boolean {
 48:   return charging;
 49: }
 50: 
 51: /** How full the charge is, 0…1. */
 52: export function novaCharge(): number {
 53:   return Math.min(1, held / FULL_CHARGE_SECONDS);
 54: }
 55: 
 56: /** The charge as the server's stage count, 0…12. */
 57: export function novaStage(): number {
 58:   return Math.min(CHARGE_STAGES, Math.floor(novaCharge() * CHARGE_STAGES));
 59: }
 60: 
 61: /**
 62:  * Command: the right button went down with Nova selected. Returns `false`
 63:  * when a charge is already running (nothing to send).
 64:  */
 65: export function beginNova(): boolean {
 66:   if (charging) return false;
 67:   charging = true;
 68:   held = 0;
 69:   return true;
 70: }
 71: 
 72: /**
 73:  * Command: the button came up (or the left button was clicked). Returns
 74:  * the seconds held, or `-1` when no charge was running (nothing to send).
 75:  */
 76: export function releaseNova(): number {
 77:   if (!charging) return -1;
 78:   charging = false;
 79:   const seconds = held;
 80:   held = 0;
 81:   return seconds;
 82: }
 83: 
 84: function update(_map: ENUM_WORLD, dt: number): void {
 85:   if (charging) held += dt;
 86: }
 87: 
 88: function reset(): void {
 89:   charging = false;
 90:   held = 0;
 91:   remoteStages.clear();
 92: }
 93: 
 94: // `ReceiveSkillCount`: only AT_SKILL_NOVA carries a count; NOVA_BEGIN is
 95: // ignored by the original too.
 96: EventBus.on('SkillStageUpdate', packet => {
 97:   if (packet.byteLength < SkillStageUpdatePacket.Length!) return;
 98:   const p = new SkillStageUpdatePacket(packet);
 99:   if (p.SkillNumber !== SKILL_NOVA) return;
100:   const netId = p.ObjectId & 0x7fff;
101:   if (p.Stage <= 0) remoteStages.delete(netId);
102:   else remoteStages.set(netId, Math.min(CHARGE_STAGES, p.Stage));
103: });
104: 
105: // ---- 3. the layer ----------------------------------------------------------
106: 
107: export const novaChargeLayer: CombatLayer = {
108:   name: 'novaCharge',
109:   update,
110:   reset,
111: };
</file>

