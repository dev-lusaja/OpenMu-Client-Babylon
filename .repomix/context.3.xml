<file path="src/combat/playerTarget.ts">
 1: /**
 2:  * `CheckAttack`'s `KIND_PLAYER` branch (ZzzInterface.cpp:1752-1783): when
 3:  * another player is a target for a swing or a hostile cast at all. The duel
 4:  * comes first and is exclusive - while the hero fights one, the enemy is
 5:  * the target and nobody else is, Ctrl or not. Outside one an outlaw
 6:  * (`PK >= PVP_MURDERER2`) is always a target, and anyone else only while
 7:  * Ctrl is held. The guild war, rival guild, Chaos Castle and Cursed Temple
 8:  * branches are not ported.
 9:  *
10:  * Readers only. Read by `attackSystem.canAttackPlayer`, which adds the
11:  * safe-zone and liveness rules and feeds both click paths.
12:  */
13: import { PVP_MURDERER2, PVP_NEUTRAL } from '../common/nameTags';
14: import type { CombatLayer } from './layer';
15: 
16: // ---- 2. readers ------------------------------------------------------------
17: 
18: export type PlayerTargetContext = {
19:   /** The other duelist's id while the hero is fighting one, else null. */
20:   duelEnemyId: number | null;
21:   /** Ctrl is held: `CheckAttack`'s force attack. */
22:   ctrl: boolean;
23: };
24: 
25: /** A player under the cursor: the id and the `HeroState` byte (`c->PK`). */
26: export type PlayerTargetLike = { netId?: number; heroState?: number };
27: 
28: export function isHostilePlayer(
29:   target: PlayerTargetLike,
30:   ctx: PlayerTargetContext
31: ): boolean {
32:   if (ctx.duelEnemyId !== null) return target.netId === ctx.duelEnemyId;
33:   if ((target.heroState ?? PVP_NEUTRAL) >= PVP_MURDERER2) return true;
34:   return ctx.ctrl;
35: }
36: 
37: // ---- 3. the layer ----------------------------------------------------------
38: 
39: export const playerTargetLayer: CombatLayer = {
40:   name: 'playerTarget',
41: };
</file>

<file path="src/combat/rage.ts">
  1: /**
  2:  * Rage Fighter packets (MonkSystem.cpp, ZzzInterface.cpp:2835-2845,
  3:  * WSclient.cpp:14228-14233): Dark Side (263) is the one skill on its own
  4:  * wire - the cast sends `RageAttackRangeRequest` (0x4B) *and*
  5:  * `RageAttackRequest` (0x4A) at the picked target; the server answers 0x4B
  6:  * with up to five targets it chose (`ReceiveDarkside` →
  7:  * `SetDarksideTargetIndex`), and the client then lands one 0x4A per extra
  8:  * target as the clip's follow-up blows come round (`SendDarksideAtt`, one
  9:  * per `m_nDarksideCnt`). Every other Rage Fighter skill is a plain
 10:  * `TargetedSkill` / `AreaSkill` with its own clip (`SetRageSkillAni`,
 11:  * `recipes.ts`).
 12:  *
 13:  * The streak the server reports back (`ObjectHit.IsRageFighterStreakHit` /
 14:  * `…FinalHit`, the original's `bRepeatedly` / `bEndRepeatedly`) is kept here
 15:  * for the damage-number stack (`CMonkSystem::SetRepeatedly`).
 16:  *
 17:  * Driven by `skillCastSystem` (`beginDarkSide`), `logic.ts`
 18:  * (`observeDarkSideTargets`, `observeRageHit`); the pending follow-ups are
 19:  * drained by the facade's `drainDarkSideHits` from the cast system.
 20:  */
 21: import type { ENUM_WORLD } from '../common/types';
 22: import type { CombatLayer } from './layer';
 23: import { SKILL_DARK_SIDE } from './recipes';
 24: 
 25: // ---- 1. tuning -------------------------------------------------------------
 26: 
 27: /** `DARKSIDE_TARGET_MAX`: the server names at most five. */
 28: const DARK_SIDE_MAX_TARGETS = 5;
 29: 
 30: /**
 31:  * Seconds between follow-up blows. `m_fOtherAniFrame` advances
 32:  * `(AttackTime + 1) * 0.2` per hit (MonkSystem.cpp:715): one blow every
 33:  * five reference ticks.
 34:  */
 35: const DARK_SIDE_HIT_INTERVAL = 0.2;
 36: 
 37: /** Seconds a streak stays open with no further hit before it is considered done. */
 38: const STREAK_TIMEOUT = 1.0;
 39: 
 40: // ---- 2. state + readers ----------------------------------------------------
 41: 
 42: /** Dark Side skill in flight (263 or a strengthened variant), 0 = none. */
 43: let darkSideSkill = 0;
 44: /** Extra targets the server named, still to be hit. */
 45: const pendingTargets: number[] = [];
 46: /** Seconds until the next follow-up blow may go out. */
 47: let nextHitIn = 0;
 48: 
 49: /** Hits in the current streak; 0 when none is open. */
 50: let streakHits = 0;
 51: let streakOpenFor = 0;
 52: 
 53: /** Whether `skill` is Dark Side (the server sends the base id back). */
 54: export function isDarkSide(skill: number): boolean {
 55:   return skill === SKILL_DARK_SIDE;
 56: }
 57: 
 58: /** A Dark Side cast is waiting for or working through its targets. */
 59: export function darkSideActive(): boolean {
 60:   return darkSideSkill !== 0;
 61: }
 62: 
 63: /** Hits landed in the running Rage Fighter streak, 0 outside one. */
 64: export function rageStreak(): number {
 65:   return streakHits;
 66: }
 67: 
 68: /** Command: Dark Side was cast on `targetId`; the 0x4B/0x4A pair goes out now. */
 69: export function beginDarkSide(skill: number, _targetId: number): void {
 70:   darkSideSkill = skill;
 71:   pendingTargets.length = 0;
 72:   nextHitIn = DARK_SIDE_HIT_INTERVAL;
 73: }
 74: 
 75: /** Command: the 0x4B response arrived with the targets the server picked. */
 76: export function observeDarkSideTargets(skill: number, targetIds: readonly number[]): void {
 77:   if (!isDarkSide(skill) || darkSideSkill === 0) return;
 78:   pendingTargets.length = 0;
 79:   for (const id of targetIds.slice(0, DARK_SIDE_MAX_TARGETS)) pendingTargets.push(id);
 80: }
 81: 
 82: /**
 83:  * Command: pull the next follow-up target whose blow is due. Returns the
 84:  * target id, or `-1` when none is due this frame. The caller sends 0x4A.
 85:  */
 86: export function nextDarkSideHit(): number {
 87:   if (darkSideSkill === 0 || pendingTargets.length === 0 || nextHitIn > 0) return -1;
 88:   nextHitIn = DARK_SIDE_HIT_INTERVAL;
 89:   const id = pendingTargets.shift()!;
 90:   if (pendingTargets.length === 0) darkSideSkill = 0;
 91:   return id;
 92: }
 93: 
 94: /** The skill id to put in the follow-up 0x4A. */
 95: export function darkSidePendingSkill(): number {
 96:   return darkSideSkill;
 97: }
 98: 
 99: /** Command: an `ObjectHit` flagged as part of a Rage Fighter streak arrived. */
100: export function observeRageHit(isStreak: boolean, isFinal: boolean): void {
101:   if (!isStreak && !isFinal) return;
102:   streakHits++;
103:   streakOpenFor = STREAK_TIMEOUT;
104:   if (isFinal) {
105:     streakHits = 0;
106:     streakOpenFor = 0;
107:   }
108: }
109: 
110: function update(_map: ENUM_WORLD, dt: number): void {
111:   if (nextHitIn > 0) nextHitIn -= dt;
112:   if (streakOpenFor > 0) {
113:     streakOpenFor -= dt;
114:     if (streakOpenFor <= 0) streakHits = 0;
115:   }
116: }
117: 
118: function reset(): void {
119:   darkSideSkill = 0;
120:   pendingTargets.length = 0;
121:   nextHitIn = 0;
122:   streakHits = 0;
123:   streakOpenFor = 0;
124: }
125: 
126: // ---- 3. the layer ----------------------------------------------------------
127: 
128: export const rageLayer: CombatLayer = {
129:   name: 'rage',
130:   update,
131:   reset,
132: };
</file>

<file path="src/combat/recipes.ts">
  1: /**
  2:  * Pure data shared by the combat entries: the per-skill cast clip table
  3:  * (the `ExecuteSkill` / `UseSkillWarrior` / `SetRageSkillAni` switches of
  4:  * the original, ZzzInterface.cpp:4803-6700, 2049-2200, MonkSystem.cpp:389),
  5:  * the hit keys of the clips (the `AttackStage` / `AttackEffect` frame checks,
  6:  * ZzzCharacter.cpp:2510-2960) and the skill numbers the entries key on.
  7:  * No state, no imports from entries.
  8:  *
  9:  * Skill numbers are OpenMU's, which are the original's `ActionSkillType`
 10:  * (`_enum.h:300-480`); the strengthened / mastery variants share the base
 11:  * skill's clip exactly as `g_SkillPairs` maps them back.
 12:  */
 13: import { PlayerAction } from '../common/objects/enum';
 14: import { ENUM_WORLD } from '../common/types';
 15: 
 16: // ---- skill numbers the entries key on --------------------------------------
 17: 
 18: /** AT_SKILL_NOVA: the release (charged) cast. */
 19: export const SKILL_NOVA = 40;
 20: /** AT_SKILL_NOVA_BEGIN: sent when the right button goes down; starts the charge. */
 21: export const SKILL_NOVA_BEGIN = 58;
 22: /** AT_SKILL_COMBO: the server announces a landed Dark Knight combo with this id. */
 23: export const SKILL_COMBO = 59;
 24: /** AT_SKILL_DARKSIDE: the one Rage Fighter skill that uses the 0x4A/0x4B pair. */
 25: export const SKILL_DARK_SIDE = 263;
 26: /** Rage Fighter party buffs (266..268) pick one of two clips at random. */
 27: export const RAGE_BUFF_SKILLS: ReadonlySet<number> = new Set([266, 267, 268]);
 28: /** AT_SKILL_RIDER: the one skill whose clip depends on the map, not the caster. */
 29: export const SKILL_RIDER = 49;
 30: 
 31: // ---- per-skill cast clips --------------------------------------------------
 32: 
 33: const A = PlayerAction;
 34: 
 35: /**
 36:  * The clip a skill plays, and what it becomes on each mount. The original
 37:  * repeats the same `c->Helper.Type` ladder verbatim at every call site
 38:  * (`UseSkill*`, `AttackKnight` / `AttackWizard` / `AttackCommon`,
 39:  * `ReceiveMagic`, `ReceiveMagicContinue`); the repeats are the `MOUNTED_*`
 40:  * spreads below, so a row here reads as the one `case` it came from.
 41:  *
 42:  * A missing mount field means the original has no branch for it and the
 43:  * ground clip plays - that is a fact about the original, not a gap.
 44:  */
 45: export type SkillClipSet = {
 46:   /** On foot, and in a safe zone - every mount branch is written `&& !c->SafeZone`. */
 47:   readonly ground: PlayerAction;
 48:   readonly uniria?: PlayerAction;
 49:   readonly dinorant?: PlayerAction;
 50:   readonly horse?: PlayerAction;
 51:   readonly fenrir?: PlayerAction;
 52: };
 53: 
 54: /**
 55:  * Dark Lord strikes - Force, Force Wave, Fire Burst, Fire Scream, Space
 56:  * Split, Chaotic Diseier. `Helper >= UNIRIA && <= DARK_HORSE` is one branch
 57:  * (WSclient.cpp:3929-3945).
 58:  */
 59: const MOUNTED_STRIKE = {
 60:   uniria: A.PLAYER_ATTACK_RIDE_STRIKE,
 61:   dinorant: A.PLAYER_ATTACK_RIDE_STRIKE,
 62:   horse: A.PLAYER_ATTACK_RIDE_STRIKE,
 63:   fenrir: A.PLAYER_FENRIR_ATTACK_DARKLORD_STRIKE,
 64: } as const;
 65: 
 66: /** Electric Spike (ZzzInterface.cpp:5635-5648). */
