<file path="src/sound/instruments/bank.ts">
 1: import type { InstrumentId } from '../../common/instruments';
 2: import { resolveUrlToDataFolder } from '../../common/resolveUrlToDataFolder';
 3: 
 4: /**
 5:  * An instrument's notes, as `tools/instrumentSamples.ts` wrote them: one
 6:  * file per MIDI note under `Instrument/<id>/` and a manifest beside it.
 7:  * Loaded once per instrument, on first use, and kept for the session - a
 8:  * bank is a couple of megabytes and only the players who hear it pay for it.
 9:  */
10: 
11: export type BankManifest = {
12:   instrument: InstrumentId;
13:   bank: string;
14:   sustained: boolean;
15:   /** Seconds. */
16:   attack: number;
17:   release: number;
18:   /** MIDI note (as a string key, JSON) -> file name. */
19:   notes: Record<string, string>;
20: };
21: 
22: export type DecodedBank = {
23:   manifest: BankManifest;
24:   /** MIDI note -> decoded sample. */
25:   buffers: Map<number, AudioBuffer>;
26:   /** The notes present, ascending. */
27:   keys: number[];
28: };
29: 
30: export type NoteSource = { buffer: AudioBuffer; rate: number };
31: 
32: /** Where a bank's files live, through the active version's asset root. */
33: export function bankUrl(id: InstrumentId, file?: string): string {
34:   return resolveUrlToDataFolder(file ? `Instrument/${id}/${file}` : `Instrument/${id}.json`);
35: }
36: 
37: /**
38:  * The sample for `note`: its own file when the bank has it, else the nearest
39:  * note pitched by the semitone distance. MusyngKite ships every semitone
40:  * from A0 to C8, so the second branch only carries a song's stray extremes.
41:  */
42: export function noteSource(bank: DecodedBank, note: number): NoteSource | null {
43:   const own = bank.buffers.get(note);
44:   if (own) return { buffer: own, rate: 1 };
45:   if (bank.keys.length === 0) return null;
46: 
47:   let best = bank.keys[0];
48:   for (const key of bank.keys) {
49:     if (Math.abs(key - note) < Math.abs(best - note)) best = key;
50:   }
51:   const buffer = bank.buffers.get(best);
52:   return buffer ? { buffer, rate: 2 ** ((note - best) / 12) } : null;
53: }
54: 
55: /** Fetches and decodes one bank. Rejects on a missing manifest or a bank with no playable note. */
56: export async function loadBank(ctx: AudioContext, id: InstrumentId): Promise<DecodedBank> {
57:   const res = await fetch(bankUrl(id));
58:   if (!res.ok) throw new Error(`instrument bank ${id}: ${res.status}`);
59:   const manifest = (await res.json()) as BankManifest;
60: 
61:   const entries = Object.entries(manifest.notes);
62:   const decoded = await Promise.all(
63:     entries.map(async ([key, file]) => {
64:       try {
65:         const bytes = await (await fetch(bankUrl(id, file))).arrayBuffer();
66:         return [Number(key), await ctx.decodeAudioData(bytes)] as const;
67:       } catch {
68:         // One bad file loses one note, not the instrument.
69:         return null;
70:       }
71:     })
72:   );
73: 
74:   const buffers = new Map<number, AudioBuffer>();
75:   for (const entry of decoded) if (entry) buffers.set(entry[0], entry[1]);
76:   if (buffers.size === 0) throw new Error(`instrument bank ${id}: no notes decoded`);
77: 
78:   return { manifest, buffers, keys: Array.from(buffers.keys()).sort((a, b) => a - b) };
79: }
</file>

