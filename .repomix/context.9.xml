180: /** SetPlayerShock (ZzzCharacter.cpp:1339-1349). */
181: export function playerPainSound(cls: CharacterClassNumber): Sounds {
182:   if (isFemaleClass(cls)) {
183:     return rnd(2) ? 'Sound/pFemaleScream2' : 'Sound/pFemaleScream1';
184:   }
185:   if (getBaseClass(cls) === BaseClass.DarkLord && rnd(5)) {
186:     return 'Sound/pDarkPain';
187:   }
188:   return MALE_SCREAMS[rnd(3)];
189: }
