<file path="src/sound/listener.ts">
  1: import type { ENUM_WORLD } from '../common/types';
  2: import type { World } from '../ecs/world';
  3: import { SoundsManager } from '../libs/soundsManager';
  4: import { busGain, type SoundBus } from './buses';
  5: import type { Sounds } from './recipes';
  6: import type { SoundLayer } from './layer';
  7: 
  8: /**
  9:  * The listener: where the hero's ears are, and the one-shot `playSfx` every
 10:  * positioned effect goes through (the original's `PlayBuffer(sound, object)`
 11:  * - DirectSound's 3D listener sits on the hero, so a sound played "at" an
 12:  * object is attenuated by its distance to the hero; a sound with no position
 13:  * is UI / hero-local and full volume).
 14:  *
 15:  * Driven by: the ECS world attached once by `ecs/systems/soundSystem.ts`
 16:  * (`attachListener`) and the hero entity each frame; `CombatSfxSystem` also
 17:  * pins it explicitly (`setSfxListener`).
 18:  * Read by: `ambientBeds` / `footsteps` (the hero and its tile), and every
 19:  * entry or consumer that calls `playSfx`.
 20:  */
 21: 
 22: // ---- 1. tuning -------------------------------------------------------------
 23: 
 24: /** Tiles inside which a positioned sound plays at full volume. */
 25: const FULL_VOLUME_TILES = 6;
 26: /** Tiles beyond which a positioned sound is skipped entirely. */
 27: export const SILENT_TILES = 28;
 28: 
 29: /**
 30:  * The attenuation curve every positioned sound shares: 1 up to
 31:  * `FULL_VOLUME_TILES`, a straight line down to 0 at `SILENT_TILES`.
 32:  */
 33: export function distanceGain(d: number): number {
 34:   if (d >= SILENT_TILES) return 0;
 35:   if (d <= FULL_VOLUME_TILES) return 1;
 36:   return 1 - (d - FULL_VOLUME_TILES) / (SILENT_TILES - FULL_VOLUME_TILES);
 37: }
 38: /**
 39:  * Per-key throttle: the same buffer is never restarted twice within this
 40:  * window, so a pack of monsters flinching in one frame reads as one hit
 41:  * instead of a chorus (DirectSound did the same through its channel count).
 42:  */
 43: const MIN_REPEAT_MS = 40;
 44: 
 45: // ---- 2. state + readers ----------------------------------------------------
 46: 
 47: let world: World | null = null;
 48: let listenerX = 0;
 49: let listenerZ = 0;
 50: let hasListener = false;
 51: 
 52: const lastPlayed = new Map<Sounds, number>();
 53: 
 54: export type SfxPosition = { x: number; z: number };
 55: 
 56: /**
 57:  * The ECS world the sound layer listens in. Attached once per client by
 58:  * `ecs/systems/soundSystem.ts`; it outlives maps, so `reset` keeps it.
 59:  */
 60: export function attachListener(w: World): void {
 61:   world = w;
 62: }
 63: 
 64: /** The attached world, or null before the ECS is up. */
 65: export function listenerWorld(): World | null {
 66:   return world;
 67: }
 68: 
 69: /** The hero entity, or null before login / after leaving the world. */
 70: export function listenerHero(): World['playerEntity'] | null {
 71:   return world?.playerEntity ?? null;
 72: }
 73: 
 74: /** Terrain tile under the listener, -1 without a hero or terrain. */
 75: export function listenerTile(): number {
 76:   const hero = listenerHero();
 77:   if (!hero || !world?.terrain) return -1;
 78:   return world.getTerrainTile(~~hero.transform.pos.x, ~~hero.transform.pos.z);
 79: }
 80: 
 81: /** Pin the listener to tile coordinates (the hero's position). */
 82: export function setSfxListener(x: number, z: number): void {
 83:   listenerX = x;
 84:   listenerZ = z;
 85:   hasListener = true;
 86: }
 87: 
 88: /** Forget the listener: positioned sounds play at full volume again. */
 89: export function clearSfxListener(): void {
 90:   hasListener = false;
 91: }
 92: 
 93: export type SfxOptions = {
 94:   /**
 95:    * The caller's own share of the effects track (0…1), before the bus - a
 96:    * bed's one-shot sits under the SFX, a hit sits on top.
 97:    */
 98:   gain?: number;
 99:   /** Which mixer category this sound belongs to (`buses.ts`). */
100:   bus?: SoundBus;
101: };
102: 
103: /**
104:  * Plays `key` once; `at` (tile coordinates) attenuates it by distance to the
105:  * hero, and the bus slider scales what is left. A sound that names no bus is
106:  * `world`: it rides the effects slider and nothing else.
107:  */
108: export function playSfx(
109:   key: Sounds,
110:   at?: SfxPosition | null,
111:   opts?: SfxOptions
112: ): void {
113:   const bus = opts?.bus ?? 'world';
114:   const category = busGain(bus);
115:   if (category <= 0) return;
116: 
117:   let volume = (opts?.gain ?? 1) * category;
118:   if (at && hasListener) {
119:     const dx = at.x - listenerX;
120:     const dz = at.z - listenerZ;
121:     const g = distanceGain(Math.sqrt(dx * dx + dz * dz));
122:     if (g <= 0) return;
123:     volume *= g;
124:   }
125: 
126:   const now = performance.now();
127:   const last = lastPlayed.get(key);
128:   if (last !== undefined && now - last < MIN_REPEAT_MS) return;
129: 
130:   const sound = SoundsManager.loadAndPlaySoundEffect(key);
131:   if (!sound) return;
132: 
133:   lastPlayed.set(key, now);
134:   sound.setVolume(volume);
135: }
136: 
137: function update(_map: ENUM_WORLD, _dt: number): void {
138:   const hero = listenerHero();
139:   if (!hero) return;
140:   setSfxListener(hero.transform.pos.x, hero.transform.pos.z);
141: }
142: 
143: function reset(): void {
144:   hasListener = false;
145:   lastPlayed.clear();
146: }
147: 
148: // ---- 3. the layer ----------------------------------------------------------
149: 
150: export const listenerLayer: SoundLayer = { name: 'listener', update, reset };
</file>

