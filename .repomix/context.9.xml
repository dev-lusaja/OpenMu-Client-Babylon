2522:   /**
2523:    * No server to answer in the offline scene: eat the potion here so the bar
2524:    * and inventory behave (apple 10% .. large 100%, the original's tables).
2525:    */
2526:   private consumeItemOffline(slot: number): void {
2527:     const item = this.playerData.items[slot];
2528:     if (!item || item.group !== 14) return;
2529: 
2530:     const now = Date.now();
2531:     if (now < this.consumeBlockedUntil) return;
2532:     this.consumeBlockedUntil = now + 300;
2533: 
2534:     const n = item.num;
2535:     const pd = this.playerData;
2536:     const isHp = n <= 3;
2537:     const isMp = n >= 4 && n <= 6;
2538:     const isSd = n >= 35 && n <= 37;
2539:     const isComplex = n >= 38 && n <= 40;
2540:     const size = isHp ? n : isMp ? n - 3 : isSd ? n - 34 : isComplex ? n - 37 : 0;
2541:     const ratio = [0.1, 0.3, 0.5, 1][size];
2542:     const heal = (cur: number, max: number) => Math.min(max, cur + Math.ceil(max * ratio));
2543: 
2544:     runInAction(() => {
2545:       if (isHp || isComplex) pd.currentHP = heal(pd.currentHP, pd.maxHP);
2546:       if (isMp || isComplex) pd.currentMP = heal(pd.currentMP, pd.maxMP);
2547:       if (isSd || isComplex) pd.currentSD = heal(pd.currentSD, pd.maxSD);
2548: 
2549:       const left = (item.durability ?? 1) - 1;
2550:       if (left > 0) item.durability = left;
2551:       else pd.items[slot] = null;
2552:     });
2553: 
2554:     playUiSound(n === 0 ? 'eatApple' : 'drink');
2555:   }
