 3: 
 4: /**
 5:  * Pure data shared by every sound entry: the sound catalogue. `recipes.json`
 6:  * maps a sound key (`Sound/eBow`, `Music/Devias`) to its file under the data
 7:  * folder; the key set is the `Sounds` union every entry and consumer types
 8:  * against. Nothing here plays anything - the mixer
 9:  * (`libs/soundsManager.ts`) turns a key into a Babylon `Sound`.
10:  */
11: export const SOUND_FILES: Readonly<Record<string, string>> = soundFiles;
12: 
13: /** Every sound the client can ask for, by key. */
14: export type Sounds = keyof typeof soundFiles;
15: 
16: /** Keys the mixer routes to the music track instead of the effects track. */
17: const MUSIC_PREFIX = 'Music/';
18: 
19: /** All catalogue keys, for the mixer's eager preload. */
20: export const SOUND_KEYS: readonly Sounds[] = Object.keys(
21:   soundFiles
22: ) as Sounds[];
23: 
24: /** Resolved URL of a sound's file. */
25: export function soundUrl(key: Sounds): string {
26:   return resolveUrlToDataFolder(soundFiles[key]);
27: }
28: 
29: /** Whether a key is a music track (`Music/…`) rather than an effect. */
30: export function isMusicKey(key: Sounds): boolean {
31:   return key.startsWith(MUSIC_PREFIX);
32: }
</file>

