192: export function playerDeathSound(cls: CharacterClassNumber): Sounds {
193:   if (isFemaleClass(cls)) return 'Sound/pFemaleScream2';
194:   if (getBaseClass(cls) === BaseClass.DarkLord) return 'Sound/pDarkDeath';
195:   return 'Sound/pMaleDie';
