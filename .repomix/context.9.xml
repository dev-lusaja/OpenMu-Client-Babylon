137: // ---- 2. selectors + commands -----------------------------------------------
138: // Pure selectors (which key) and the commands that play them. One-shots:
139: // nothing to hold between frames.
140: 
141: const rnd = (n: number) => Math.floor(Math.random() * n);
142: 
143: export type WeaponHands =
144:   | { leftHand: Item | null; rightHand: Item | null }
145:   | null
146:   | undefined;
147: 
148: /** SetPlayerAttack (ZzzCharacter.cpp:1219-1233): the swing sound at the clip's first frame. */
149: export function playerSwingSound(hands: WeaponHands): Sounds | null {
150:   const r = hands?.rightHand ?? null;
151:   const l = hands?.leftHand ?? null;
152: 
153:   if (isBow(r) || isBow(l)) return 'Sound/eBow';
154:   if (isCrossbow(r) || isCrossbow(l)) return 'Sound/eCrossbow';
155:   if (
156:     r &&
157:     ((r.group === GROUP_SWORD && r.num === LIGHT_SABER_INDEX) ||
158:       (r.group === GROUP_SPEAR && r.num === LIGHT_SPEAR_INDEX))
159:   ) {
160:     return 'Sound/eSwingLightSword';
161:   }
162:   if (isWeaponItem(r) || isWeaponItem(l)) {
163:     return rnd(2) ? 'Sound/eSwingWeapon2' : 'Sound/eSwingWeapon1';
164:   }
165:   return null; // bare fists are silent
166: }
167: 
168: /** The hero's bow/crossbow hits use the missile-hit set (ZzzCharacter.cpp:5183). */
169: export function usesMissileWeapon(hands: WeaponHands): boolean {
170:   const r = hands?.rightHand ?? null;
171:   const l = hands?.leftHand ?? null;
172:   return isBow(r) || isBow(l) || isCrossbow(r) || isCrossbow(l);
173: }
