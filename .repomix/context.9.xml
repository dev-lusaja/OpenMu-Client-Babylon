 918:   private refreshSkillSelection() {
 919:     if (!this.skills.some(s => s.number === this.currentSkill)) {
 920:       this.currentSkill = -1;
 921:     }
 922:     // Unassigned hot keys default to the learned skills in order (1..9, 0).
 923:     const next = this.skillHotkeys.map(n =>
 924:       this.skills.some(s => s.number === n) ? n : -1
 925:     );
 926:     // Server-saved hot keys win over the defaults once the skill is learned.
 927:     for (let slot = 0; slot < 10; slot++) {
 928:       const saved = this.savedSkillHotkeys[slot];
 929:       if (saved === -1 || next[slot] === saved) continue;
 930:       if (!this.skills.some(s => s.number === saved)) continue;
 931:       const prev = next.indexOf(saved);
 932:       if (prev !== -1) next[prev] = -1;
 933:       next[slot] = saved;
 934:     }
 935:     const used = new Set(next);
 936:     // Master-tree entries and the siege commands are learned skills that never
 937:     // sit on a bar slot, so they never claim one by default either.
 938:     const free = this.skills
 939:       .map(s => s.number)
 940:       .filter(n => isHotbarSkill(n) && !used.has(n));
 941:     for (let slot = 1; slot <= 10 && free.length; slot++) {
 942:       const i = slot % 10;
 943:       if (next[i] === -1) next[i] = free.shift()!;
 944:     }
 945:     this.skillHotkeys = next;
 946:   }
