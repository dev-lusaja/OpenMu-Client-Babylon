1933:   /** MOVEMENT_TALK reached the NPC (ZzzInterface.cpp:3576): ask what it offers. */
1934:   talkToNpc(npc: NpcTarget): void {
1935:     if (this.pendingItemMove || this.npcShop) return;
1936: 
1937:     this.pendingNpcTalk = npc;
1938: 
1939:     if (this.isOffline) {
1940:       const which = this.offlineNpcWindow++ % 3;
1941: 
1942:       if (which === 1) {
1943:         this.dropNpcTalk();
1944:         this.offlineVault();
1945:         return;
1946:       }
1947:       if (which === 2) {
1948:         this.dropNpcTalk();
1949:         this.offlineMix();
1950:         return;
1951:       }
1952: 
1953:       this.openNpcShop();
1954:       this.setNpcShopItems(offlineShopStock());
1955:       return;
1956:     }
1957: 
1958:     // A previous talk that never produced a window leaves OpenMU in
1959:     // NpcDialogOpened; it ignores new talks until a CloseNpcRequest resets it.
1960:     if (this.pendingNpcTalk) {
1961:       this.sendToGS(CloseNpcRequestPacket.createPacket().buffer);
1962:     }
1963:     const packet = TalkToNpcRequestPacket.createPacket();
1964:     packet.NpcId = npc.netId;
1965:     this.sendToGS(packet.buffer);
1966:   }
