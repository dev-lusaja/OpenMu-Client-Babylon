 30: // ---- 1. tuning -------------------------------------------------------------
 31: 
 32: /** Swings, hits, screams and casts are one category (`sound/buses.ts`). */
 33: export const COMBAT_BUS: SoundBus = 'combat';
 34: 
 35: /** MODEL_LIGHT_SABER = MODEL_SWORD + 10, MODEL_SPEAR = spear group index 0 (_enum.h:1504, :1451). */
 36: const LIGHT_SABER_INDEX = 10;
