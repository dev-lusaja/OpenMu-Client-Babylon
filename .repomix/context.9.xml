 901:   /**
 902:    * `SaveOptions` (ZzzOpenData.cpp:4764): F3 30 with the ten hot keys as
 903:    * big-endian skill numbers (0xFFFF = empty) followed by the option bytes
 904:    * the client does not model yet (game options, Q/W/E/R, chat log, R,
 905:    * QWER level), left zero.
 906:    */
 907:   private saveKeyConfiguration(): void {
 908:     if (this.isOffline) return;
 909:     const packet = SaveKeyConfigurationPacket.createPacket(4 + 20 + 1 + 3 + 1 + 1 + 1);
 910:     const data = packet.buffer;
 911:     for (let i = 0; i < 10; i++) {
 912:       const number = this.skillHotkeys[i];
 913:       data.setUint16(4 + i * 2, number >= 0 ? number : 0xffff, false);
 914:     }
 915:     this.sendToGS(packet.buffer);
 916:   }
