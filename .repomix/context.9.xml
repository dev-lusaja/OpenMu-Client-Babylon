 227:     { group: 14, num: 8, lvl: 0, durability: 1 },
 228:     { group: 14, num: 10, lvl: 0, durability: 1 },
 229:     { group: 0, num: 0, lvl: 0, durability: 20 },
 230:     { group: 0, num: 1, lvl: 0, durability: 22 },
 231:     { group: 0, num: 2, lvl: 0, durability: 30 },
 232:     { group: 1, num: 0, lvl: 0, durability: 20 },
 233:     { group: 2, num: 0, lvl: 0, durability: 24 },
 234:     { group: 4, num: 0, lvl: 0, durability: 20 },
 235:     { group: 5, num: 0, lvl: 0, durability: 26 },
 236:     { group: 6, num: 0, lvl: 0, durability: 22 },
 237:     { group: 7, num: 5, lvl: 0, durability: 24 },
 238:     { group: 8, num: 5, lvl: 0, durability: 24 },
 239:     { group: 9, num: 5, lvl: 0, durability: 24 },
 240:     { group: 10, num: 5, lvl: 0, durability: 24 },
 241:     { group: 11, num: 5, lvl: 0, durability: 24 },
 242:   ];
 243: 
 244:   const grid = new Array<Item | null>(SHOP_SLOTS).fill(null);
 245:   const entries: { slot: number; item: Item }[] = [];
 246: 
 247:   for (const item of stock) {
 248:     const { w, h } = itemSize(item);
 249:     let placed = false;
 250:     for (let row = 0; row + h <= SHOP_ROWS && !placed; row++) {
 251:       for (let column = 0; column + w <= SHOP_COLUMNS && !placed; column++) {
 252:         let fits = true;
 253:         for (let y = 0; y < h && fits; y++) {
 254:           for (let x = 0; x < w; x++) {
 255:             if (grid[(row + y) * SHOP_COLUMNS + column + x]) {
 256:               fits = false;
 257:               break;
 258:             }
 259:           }
 260:         }
 261:         if (!fits) continue;
 262:         const slot = row * SHOP_COLUMNS + column;
 263:         for (let y = 0; y < h; y++) {
 264:           for (let x = 0; x < w; x++) {
 265:             grid[(row + y) * SHOP_COLUMNS + column + x] = item;
 266:           }
 267:         }
 268:         entries.push({ slot, item });
 269:         placed = true;
 270:       }
 271:     }
 272:   }
 273: 
 274:   return entries;
 275: }
 276: 
 277: function serializeItemBytes(item: Item): number[] {
 278:   if (item.raw && item.raw.length === ItemSerializer.NeededSpace) {
 279:     return item.raw;
 280:   }
 281: 
 282:   const bytes = new Uint8Array(ItemSerializer.NeededSpace);
 283:   ItemSerializer.SerializeItem(bytes, item);
 284:   return Array.from(bytes);
 285: }
