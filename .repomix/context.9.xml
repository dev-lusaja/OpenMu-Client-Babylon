1709:    * No server offline: the point is applied here, one answer per request and
1710:    * after a beat, so the window and the bulk run behave as they do in game.
1711:    */
1712:   private answerStatOffline(stat: number): void {
1713:     setTimeout(() => {
1714:       const playerData = this.playerData;
1715: 
1716:       if (playerData.points <= 0) {
1717:         EventBus.emit('statPointAnswered', { stat, added: 0 });
1718:         return;
1719:       }
1720: 
1721:       runInAction(() => {
1722:         switch (stat) {
1723:           case StatType.Strength:
1724:             playerData.str++;
1725:             break;
1726:           case StatType.Agility:
1727:             playerData.agi++;
1728:             break;
1729:           case StatType.Vitality:
1730:             playerData.sta++;
1731:             break;
1732:           case StatType.Energy:
1733:             playerData.eng++;
1734:             break;
1735:           case StatType.Leadership:
1736:             playerData.leadership++;
1737:             break;
1738:         }
1739:         playerData.points--;
1740:       });
1741: 
1742:       EventBus.emit('statPointAnswered', { stat, added: 1 });
1743:     }, OFFLINE_ANSWER_DELAY);
1744:   }
