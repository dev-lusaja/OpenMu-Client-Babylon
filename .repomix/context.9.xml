1891:   /**
1892:    * The last walk the server was told about. Read only by `heroMoveTrace`, to
1893:    * say whether a jump it just made was the end of a walk we thought we had
1894:    * stopped. Deliberately not observable: nothing renders it.
1895:    */
1896:   lastWalkRequest: { x: number; y: number; steps: number; at: number } | null =
1897:     null;
1898: 
1899:   /**
1900:    * `LetHeroStop()` (ZzzInterface.cpp:1935-1948): the walk a cast opens with.
1901:    * `SendCharacterMove` with a single path point sends the hero's own tile,
1902:    * no steps and just the facing (:1925-1932), which parks the server's
1903:    * walker where the client stopped. Without it the server keeps walking the
1904:    * path it was already handed while the client stands still casting, and
1905:    * rubber-bands the hero onto its own position once the two drift past the
1906:    * 5-tile tolerance.
1907:    */
1908:   sendWalkStop(x: number, y: number, rotYRadians: number): void {
1909:     const packet = WalkRequestPacket.createPacket(6);
1910:     packet.SourceX = Math.round(x);
1911:     packet.SourceY = Math.round(y);
1912:     packet.StepCount = 0;
1913:     packet.TargetRotation = walkDirection(rotYRadians);
1914: 
1915:     this.lastWalkRequest = {
1916:       x: packet.SourceX,
1917:       y: packet.SourceY,
1918:       steps: 0,
1919:       at: performance.now(),
1920:     };
1921:     this.sendToGS(packet.buffer);
1922:   }
