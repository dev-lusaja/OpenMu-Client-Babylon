 566: /**
 567:  * `?offline&map=noria` / `?offline&map=3`: the world the offline scene boots
 568:  * into, by number or by the `ENUM_WORLD` name after its number (a prefix is
 569:  * enough: `lost`, `atlans`, `icarus`). Lorencia when absent or unknown. Read
 570:  * before `playOffline` rewrites the URL to `/offline`.
 571:  */
 572: function offlineMapFromUrl(): ENUM_WORLD {
 573:   let raw: string | null = null;
 574:   try {
 575:     raw = new URLSearchParams(location.search).get('map');
 576:   } catch {
 577:     raw = null;
 578:   }
 579:   if (!raw) return ENUM_WORLD.WD_0LORENCIA;
 580: 
 581:   if (/^\d+$/.test(raw)) {
 582:     const n = Number(raw) as ENUM_WORLD;
 583:     return ENUM_WORLD[n] !== undefined ? n : ENUM_WORLD.WD_0LORENCIA;
 584:   }
 585: 
 586:   const want = raw.toLowerCase();
 587:   for (const key of Object.keys(ENUM_WORLD)) {
 588:     const name = key.replace(/^WD_\d+/, '');
 589:     if (name === key) continue;
 590:     if (name.toLowerCase().startsWith(want)) {
 591:       return ENUM_WORLD[key as keyof typeof ENUM_WORLD];
 592:     }
 593:   }
 594:   return ENUM_WORLD.WD_0LORENCIA;
 595: }
