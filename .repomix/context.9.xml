282: export const sound = new Sound();
283: 
284: // A hot update that reaches this module must reload the page: Vite would
285: // otherwise re-execute it and hand later-loaded importers a second instance
286: // of this singleton (same guard as store.ts).
287: const hot = (import.meta as { hot?: { decline(): void } }).hot;
288: if (hot) hot.decline();
