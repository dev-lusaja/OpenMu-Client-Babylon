416: 
417: // ---- 2. selectors + commands -----------------------------------------------
418: 
419: const rnd = (n: number) => Math.floor(Math.random() * n);
420: 
421: export function monsterIdleSound(modelType: number): Sounds | null {
422:   const slots = MONSTER_SOUNDS[modelType];
423:   if (!slots || slots[0] === null) return null;
424:   return (slots[rnd(2)] ?? slots[0]) as Sounds;
425: }
426: 
427: export function monsterAttackSound(modelType: number): Sounds | null {
428:   const slots = MONSTER_SOUNDS[modelType];
429:   if (!slots || slots[2] === null) return null;
430:   return (slots[2 + rnd(2)] ?? slots[2]) as Sounds;
431: }
432: 
433: export function monsterDeathSound(modelType: number): Sounds | null {
434:   const slots = MONSTER_SOUNDS[modelType];
435:   return (slots?.[4] ?? null) as Sounds | null;
436: }
437: 
438: /** The voice for a moment, or null when that monster is silent there. */
439: export function monsterSound(
440:   modelType: number,
441:   voice: MonsterVoice
442: ): Sounds | null {
443:   switch (voice) {
444:     case 'idle':
445:       return monsterIdleSound(modelType);
446:     case 'attack':
447:       return monsterAttackSound(modelType);
448:     case 'death':
449:       return monsterDeathSound(modelType);
450:   }
451: }
452: 
453: /** Play a monster's voice at its position; silent slots stay silent. */
454: export function playMonster(
455:   modelType: number,
456:   voice: MonsterVoice,
457:   at?: SfxPosition | null
458: ): void {
459:   const key = monsterSound(modelType, voice);
460:   if (key) playSfx(key, at, { bus: MONSTER_BUS });
461: }
462: 
463: // ---- 3. the layer ----------------------------------------------------------
464: 
465: export const monstersLayer: SoundLayer = { name: 'monsters' };
</file>

<file path="src/sound/music.ts">
  1: import {
  2:   BLOOD_CASTLE_WORLDS,
  3:   CHAOS_CASTLE_WORLDS,
  4:   KALIMA_WORLDS,
  5:   CURSED_TEMPLE_WORLDS,
  6:   EMPIRE_GUARDIAN_WORLDS,
  7:   DOPPELGANGER_WORLDS,
  8:   DEVIL_SQUARE_WORLDS,
  9:   onWorlds,
 10: } from '../common/worldAssets';
 11: import { ENUM_WORLD } from '../common/types';
 12: import { EventBus } from '../libs/eventBus';
 13: import { SoundsManager } from '../libs/soundsManager';
 14: import { busSilent, type SoundBus } from './buses';
 15: import type { Sounds } from './recipes';
 16: import type { SoundLayer } from './layer';
 17: import { listenerWorld } from './listener';
 18: 
 19: /**
 20:  * Background music: `ManageBackgroundMusic` (Scenes/SceneManager.cpp:711-839)
 21:  * - one track per world, started a beat after the warp completes. Area
 22:  * overrides (the Lorencia / Devias taverns) and the login theme
 23:  * (`libs/loginMusic.ts`) go through the same `playMusic` / `stopMusic`
 24:  * commands, so the mixer only ever has one track up.
 25:  *
 26:  * Driven by: the map index each frame plus `requestWarp` / `warpCompleted`.
 27:  * Read by: `libs/loginMusic.ts` (`currentMusic`).
 28:  */
 29: 
 30: // ---- 1. tuning -------------------------------------------------------------
 31: 
 32: /** The tracks ride their own slider, not the effects one (`sound/buses.ts`). */
 33: const BUS: SoundBus = 'music';
 34: 
 35: /** Seconds after `warpCompleted` before the map's track starts. */
 36: const MUSIC_DELAY_SECONDS = 1;
 37: 
 38: /** Worlds with no row in `ManageBackgroundMusic` fall back to the theme. */
 39: const DEFAULT_MUSIC: Sounds = 'Music/MuTheme';
 40: 
 41: /**
 42:  * Track per world. `null` is a world the original deliberately leaves
 43:  * silent, not one we forgot: the arena has no case in `ManageBackgroundMusic`
 44:  * and no ambient bed in `PlayWorldAmbientSounds` either, so the MuTheme
 45:  * fallback would be our invention.
 46:  */
 47: const MAP_MUSIC: Partial<Record<ENUM_WORLD, Sounds | null>> = {
 48:   [ENUM_WORLD.WD_0LORENCIA]: 'Music/main_theme',
 49:   [ENUM_WORLD.WD_3NORIA]: 'Music/Noria',
 50:   [ENUM_WORLD.WD_2DEVIAS]: 'Music/Devias',
 51:   [ENUM_WORLD.WD_4LOSTTOWER]: 'Music/lost_tower_a',
 52:   [ENUM_WORLD.WD_7ATLANSE]: 'Music/atlans',
 53:   [ENUM_WORLD.WD_8TARKAN]: 'Music/tarkan',
 54:   [ENUM_WORLD.WD_1DUNGEON]: 'Music/Dungeon',
 55:   [ENUM_WORLD.WD_10ICARUS]: 'Music/icarus',
 56:   [ENUM_WORLD.WD_6STADIUM]: null,
 57:   // `MUSIC_LOGIN_THEME` (LoginScene.cpp:300): the login backdrop and the
 58:   // character select are one scene under one theme - `libs/loginMusic.ts`
 59:   // starts it before the world exists; this row keeps the map loop from
 60:   // swapping it for the MuTheme fallback once the backdrop's terrain loads.
 61:   [ENUM_WORLD.WD_73NEW_LOGIN_SCENE]: 'Music/login_theme',
 62:   [ENUM_WORLD.WD_74NEW_CHARACTER_SCENE]: 'Music/login_theme',
 63:   // The three event maps have no `ManageBackgroundMusic` case either: their
 64:   // soundscape is the event loop (`iBloodCastle` / `iChaosCastle`, the Devil
 65:   // Square rain) in ambientBeds.ts, and the theme would be ours.
 66:   ...onWorlds(DEVIL_SQUARE_WORLDS, null),
 67:   ...onWorlds(BLOOD_CASTLE_WORLDS, null),
 68:   ...onWorlds(CHAOS_CASTLE_WORLDS, null),
 69: 
 70:   // ---- Season 2-6 worlds ("Later worlds"), from
 71:   // `ManageBackgroundMusic` (SceneManager.cpp:711-857) and the per-map
 72:   // `PlayBGM`s it calls; file names from _enum.h:180-216.
 73:   ...onWorlds(KALIMA_WORLDS, 'Music/kalima' as Sounds),
 74:   // `MUSIC_CASTLE_PEACE` - the siege tracks need the siege state.
 75:   [ENUM_WORLD.WD_30BATTLECASTLE]: 'Music/castle',
 76:   [ENUM_WORLD.WD_31HUNTING_GROUND]: 'Music/huntingground',
 77:   [ENUM_WORLD.WD_33AIDA]: 'Music/Aida',
 78:   // `M34CryWolf1st::ChangeBackGroundMusic`'s peace state.
 79:   [ENUM_WORLD.WD_34CRYWOLF_1ST]: 'Music/crywolf1st',
 80:   [ENUM_WORLD.WD_37KANTURU_1ST]: 'Music/kanturu_1st',
 81:   [ENUM_WORLD.WD_38KANTURU_2ND]: 'Music/kanturu_2nd',
 82:   // `M39Kanturu3rd::ChangeBackGroundMusic` outside the Maya/Nightmare fights.
 83:   [ENUM_WORLD.WD_39KANTURU_3RD]: 'Music/KanturuTower',
 84:   // No case anywhere for the GM area.
 85:   [ENUM_WORLD.WD_40AREA_FOR_GM]: null,
 86:   [ENUM_WORLD.WD_41CHANGEUP3RD_1ST]: 'Music/BalgasBarrack',
 87:   [ENUM_WORLD.WD_42CHANGEUP3RD_2ND]: 'Music/BalgasRefuge',
 88:   // `g_CursedTemple->PlayBGM()` starts on the waiting track.
 89:   ...onWorlds(CURSED_TEMPLE_WORLDS, 'Music/cursedtemplewait' as Sounds),
 90:   [ENUM_WORLD.WD_51ELBELAND]: 'Music/elbeland',
 91:   [ENUM_WORLD.WD_56MAP_SWAMP_OF_QUIET]: 'Music/SwampOfCalmness',
 92:   [ENUM_WORLD.WD_57ICECITY]: 'Music/Raklion',
 93:   [ENUM_WORLD.WD_58ICECITY_BOSS]: 'Music/Raklion_Hatchery',
 94:   [ENUM_WORLD.WD_62SANTA_TOWN]: 'Music/Santa_Village',
 95:   [ENUM_WORLD.WD_63PK_FIELD]: 'Music/PK_Field',
 96:   [ENUM_WORLD.WD_64DUELARENA]: 'Music/DuelArena',
 97:   // `CGMDoppelGanger1::PlayBGM` (GMDoppelGanger1.cpp:669-693) only plays
 98:   // while the event frame is enabled; outside it the arenas are silent.
 99:   ...onWorlds(DOPPELGANGER_WORLDS, null),
100:   ...onWorlds(EMPIRE_GUARDIAN_WORLDS, 'Music/ImperialGuardianFort' as Sounds),
101:   // `GMUnitedMarketPlace::PlayBGM` is commented out in the source.
102:   [ENUM_WORLD.WD_79UNITEDMARKETPLACE]: null,
103:   [ENUM_WORLD.WD_80KARUTAN1]: 'Music/Karutan_A',
104:   [ENUM_WORLD.WD_81KARUTAN2]: 'Music/Karutan_B',
105: };
106: 
107: // ---- 2. state + readers ----------------------------------------------------
108: 
109: /** Seconds until the map track is (re)started; Infinity once it has been. */
110: let delay = 0;
111: let wired = false;
112: 
113: /** The track the mixer is playing, or null. */
114: export function currentMusic(): Sounds | null {
115:   return SoundsManager.currentMusic;
116: }
117: 
118: /** Track a world plays, `null` for a deliberately silent one. */
119: export function mapMusic(map: ENUM_WORLD): Sounds | null {
120:   const entry = MAP_MUSIC[map];
121:   return entry === undefined ? DEFAULT_MUSIC : entry;
122: }
123: 
124: /** Start a track (no-op if it is already the one playing). */
125: export function playMusic(key: Sounds): void {
126:   SoundsManager.playMusic(key);
127: }
128: 
129: /** Stop whatever track is playing. */
130: export function stopMusic(): void {
131:   SoundsManager.stopAllMusic();
132: }
133: 
134: function wire(): void {
135:   if (wired) return;
136:   wired = true;
137:   EventBus.on('requestWarp', () => stopMusic());
138:   EventBus.on('warpCompleted', () => {
139:     delay = MUSIC_DELAY_SECONDS;
140:   });
141: }
142: 
143: function update(map: ENUM_WORLD, dt: number): void {
144:   wire();
145: 
146:   // The music slider at 0 stops the track rather than streaming it at
147:   // silence, and re-arms the start so raising the slider brings it back.
148:   if (busSilent(BUS)) {
149:     if (SoundsManager.currentMusic) stopMusic();
150:     delay = 0;
151:     return;
152:   }
153: 
154:   delay -= dt;
155:   if (delay > 0) return;
156: 
157:   if (!SoundsManager.pageInteracted) return;
158:   if (!listenerWorld()?.terrain) return;
159: 
160:   delay = Infinity;
161: 
162:   const key = mapMusic(map);
163:   if (key) playMusic(key);
164:   else stopMusic();
165: }
166: 
167: /**
168:  * A map change re-arms the track the same way `warpCompleted` does, so a map
169:  * reached without the warp events (the offline `?map=` boot, a dev reload)
170:  * still gets its music a beat after the terrain lands.
171:  */
172: function reset(): void {
173:   delay = MUSIC_DELAY_SECONDS;
174: }
175: 
176: // ---- 3. the layer ----------------------------------------------------------
177: 
178: export const musicLayer: SoundLayer = { name: 'music', update, reset };
</file>

<file path="src/sound/objectLoops.ts">
  1: import { ENUM_WORLD } from '../common/types';
