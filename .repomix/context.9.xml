 627: /**
 628:  * `?hand1=0,14` / `?hand2=none`: overrides the offline test loadout's hand
 629:  * slots (`group,num[,level]`; `none` empties the slot), for the weapon
 630:  * stow/draw screenshot matrix (lighting_rework.md §4). Slot 0 draws in the
 631:  * right hand (Weapon1), slot 1 in the left (Weapon2).
 632:  *
 633:  * `?pet=13,37` fills the pet slot the same way; its third number is the
 634:  * item's option bits instead of a level (the Fenrir colours: 1 black,
 635:  * 2 blue, 4 gold).
 636:  */
 637: function applyOfflineHandOverrides(items: (Item | null)[]): void {
 638:   const read = (name: string, slot: number, thirdIsFlags = false) => {
 639:     let raw: string | null = null;
 640:     try {
 641:       raw = new URLSearchParams(location.search).get(name);
 642:     } catch {
 643:       raw = null;
 644:     }
 645:     if (!raw) return;
 646: 
 647:     if (raw === 'none') {
 648:       items[slot] = null;
 649:       return;
 650:     }
 651: 
 652:     const [group, num, third] = raw.split(',').map(Number);
 653:     if (Number.isFinite(group) && Number.isFinite(num)) {
 654:       items[slot] = {
 655:         group,
 656:         num,
 657:         lvl: !thirdIsFlags && Number.isFinite(third) ? third : 0,
 658:         isExcellent: false,
 659:         excellentFlags: thirdIsFlags && Number.isFinite(third) ? third : 0,
 660:       };
 661:     }
 662:   };
 663: 
 664:   read('hand1', InventoryConstants.LeftHandSlot);
 665:   read('hand2', InventoryConstants.RightHandSlot);
 666:   read('pet', InventoryConstants.PetSlot, true);
 667: }
