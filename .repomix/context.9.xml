 886:   /**
 887:    * `CNewUISkillList::SetHotKey` (NewUIMainFrameWindow.cpp:1803): a skill
 888:    * sits on one key only, so the key it held before is cleared. The layout
 889:    * is sent to the server right away (the original saves it on leaving the
 890:    * world; OpenMU accepts it at any time) so it survives a relog.
 891:    */
 892:   assignSkillHotkey(slot: number, number: number) {
 893:     if (slot < 0 || slot > 9) return;
 894:     const next = this.skillHotkeys.map(n => (n === number ? -1 : n));
 895:     next[slot] = number;
 896:     this.skillHotkeys = next;
 897:     this.savedSkillHotkeys = next.slice();
