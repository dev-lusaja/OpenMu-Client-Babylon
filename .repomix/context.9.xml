202: /** Jewel pickups ring instead of clinking (WSclient.cpp:5727-5734). */
203: export function pickupSound(item: Item): 'jewel' | 'gemstone' | 'getItem' {
204:   if (item.group === 12 && item.num === 15) return 'jewel'; // Jewel of Chaos
205:   if (item.group === 14) {
206:     // Bless 13, Soul 14, Life 16, Creation 22, Guardian 31
207:     if ([13, 14, 16, 22, 31].includes(item.num)) return 'jewel';
208:     if (item.num === 41) return 'gemstone'; // Gemstone
209:   }
210:   return 'getItem';
211: }
