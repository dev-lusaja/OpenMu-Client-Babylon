 54: export type AmbientBed = {
 55:   readonly sound: Sounds;
 56:   /** Share of the effects volume. Beds sit under the SFX, never on top. */
 57:   readonly volume: number;
 58:   /**
 59:    * Silences the bed for the tile the hero is standing on. The original uses
 60:    * this to cut the wind the moment the hero walks indoors - the tile under
 61:    * their feet is the only "am I inside" test it has, and the two maps that
 62:    * use it test open-ended ranges, so this is a predicate rather than a list.
 63:    */
 64:   readonly mutedOn?: (heroTile: number) => boolean;
 65:   /** Extra condition, e.g. Lorencia's rain only while it is raining. */
 66:   readonly when?: () => boolean;
 67: };
