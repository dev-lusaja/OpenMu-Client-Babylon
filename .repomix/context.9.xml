1563:   disconnectFromGameServer() {
1564:     if (this.gsAttempt?.timer) clearTimeout(this.gsAttempt.timer);
1565:     this.gsAttempt = null;
1566:     this.gsSocket?.close();
1567:     this.gsSocket = undefined;
1568:     // A new socket is a new set of round trips.
1569:     NetStats.reset();
1570:   }
