1225:   /**
1226:    * A socket we did not close ourselves went away (`wsClosed` / `wsError`
1227:    * from `createSocket`). Deliberate closes clear `gsSocket` / `csSocket`
1228:    * first, so a close event for a socket that is no longer ours is ignored.
1229:    * Losing the game server is the original's `case 2` of `ReceiveLogOut`:
1230:    * the connection is gone, so start over at the server list, with a red
1231:    * system-log line saying why. Losing the connect server only matters while
1232:    * the server list is what we are looking at; it is reconnected in place.
1233:    */
1234:   onSocketLost(socket: WebSocket): void {
1235:     if (socket === this.gsSocket) {
1236:       this.gsSocket = undefined;
1237:       this.encryptor = undefined;
1238: 
1239:       // The proxy closes the ws when its TCP connect fails, so this is where a
1240:       // wrong `ConnectionInfo` address usually lands. One retry, then the
1241:       // ordinary lost-connection path.
1242:       if (this.retryGameServer('closed the connection')) return;
1243: 
1244:       // The session resume takes the loss over when it can (and when the
1245:       // option is on); otherwise this is the old start-over path.
1246:       if (this.resumeHook?.()) return;
1247: 
1248:       runInAction(() => {
1249:         this.connectionLost = true;
1250:         this.loginProcessing = false;
1251:       });
1252:       this.addNotification(t('notify.connectionLost'), 'error');
1253:       this.playOnline();
1254:       return;
1255:     }
1256:     if (socket === this.csSocket) {
1257:       this.csSocket = undefined;
1258:       if (this.uiState === UIState.Servers) {
1259:         this.addNotification(t('notify.serverListLost'), 'error');
1260:         this.playOnline();
1261:       }
1262:     }
1263:   }
