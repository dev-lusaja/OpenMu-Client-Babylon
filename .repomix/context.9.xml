175: /** SOUND_ATTACK_MELEE_HIT1 + rand % 4, or the missile set (+5) for archers. */
176: export function hitSound(missile: boolean): Sounds {
177:   return missile ? MISSILE_HITS[rnd(4)] : MELEE_HITS[rnd(4)];
178: }
