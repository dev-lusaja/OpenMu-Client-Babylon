2390:     fromStorage: StorageKind,
2391:     fromSlot: number,
2392:     toStorage: StorageKind,
2393:     toSlot: number,
2394:     item: Item
2395:   ): void {
2396:     // The mix tray's wire byte depends on the NPC that owns it: 3 for the
2397:     // goblin, 9 for the Chaos Card Master (economy.ts `mixWireStorage`).
2398:     const wireStorage = (storage: StorageKind): number =>
2399:       storage === StorageKind.ChaosMachine ? Economy.mixWireStorage : storage;
2400: 
2401:     const packet = ItemMoveRequestPacket.createPacket();
2402:     packet.FromStorage = wireStorage(fromStorage);
2403:     packet.FromSlot = wireSlotOf(fromStorage, fromSlot);
2404:     packet.ToStorage = wireStorage(toStorage);
2405:     packet.ToSlot = wireSlotOf(toStorage, toSlot);
2406:     packet.setItemData(serializeItemBytes(item), 12);
2407: 
