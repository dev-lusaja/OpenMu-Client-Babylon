  1: import { GameOptions } from '../../common/gameOptions';
  2: import type { InstrumentId } from '../../common/instruments';
  3: import type { ENUM_WORLD } from '../../common/types';
  4: import { Engine } from '../../libs/babylon/exports';
  5: import { SoundsManager } from '../../libs/soundsManager';
  6: import { busGain, masterGain } from '../buses';
  7: import type { SoundLayer } from '../layer';
  8: import { distanceGain, listenerHero } from '../listener';
  9: import { loadBank, type DecodedBank } from './bank';
 10: import { Sampler, type PerformerKey } from './sampler';
 11: 
 12: /**
 13:  * Instruments played by players: the band system's sound.
 14:  *
 15:  * The first Web Audio graph in the client, on the context Babylon's engine
 16:  * already owns: `voice (with the makeup) -> performer gain (distance) ->
 17:  * instruments bus -> limiter -> Engine.audioEngine.masterGain`, so the
 18:  * master slider and the background mute reach it like everything else. The two Babylon tracks stay untouched
 19:  * - their gain nodes are private - and the bus folds master x effects x
 20:  * instruments itself.
 21:  *
 22:  * Driven by: `common/band` (the sequencer for the hero, one receiver per
 23:  * remote performer) through the commands below. Positions come from
 24:  * `BandSystem` once a frame. Read by nobody else.
 25:  */
 26: 
 27: // ---- 1. tuning -------------------------------------------------------------
 28: 
 29: /** Seconds the bus takes to follow a slider or the background mute. */
 30: const BUS_RAMP = 0.1;
 31: 
 32: /** Seconds a performer's gain takes to follow their distance. */
 33: const DISTANCE_RAMP = 0.05;
 34: 
 35: /**
 36:  * Makeup gain to lift the very quiet MusyngKite renders (peak ~0.07) up to a
 37:  * normal loudness. Folded into each voice's peak (`Sampler`), ahead of the
 38:  * performer's distance gain, and capped by the limiter on the bus: a loud
 39:  * chord nearby cannot clip, and a far performer stays quiet. A makeup on the
 40:  * bus instead pushed every performer back up to the limiter's ceiling, near
 41:  * or far, which is why distance did nothing.
 42:  */
 43: const MAKEUP_GAIN = 20;
 44: 
 45: /** A performer quieter than this (by distance) does not duck the music. */
 46: const DUCK_MIN_GAIN = 0.05;
 47: 
 48: /** Seconds the music stays ducked after the last note, so it does not flap. */
 49: const DUCK_HOLD_SEC = 1.2;
 50: 
 51: // ---- 2. state + readers ----------------------------------------------------
 52: 
 53: type PerformerState = { x: number; z: number; local: boolean; gain: number };
 54: 
 55: let ctx: AudioContext | null = null;
 56: let sampler: Sampler | null = null;
 57: let bus: GainNode | null = null;
 58: let busLevel = -1;
 59: /** Audio time of the last audible note, for the music duck's release. */
 60: let lastAudible = 0;
 61: 
 62: const banks = new Map<InstrumentId, DecodedBank>();
 63: const loading = new Map<InstrumentId, Promise<boolean>>();
 64: const performers = new Map<PerformerKey, PerformerState>();
 65: 
 66: /** Causes already written to the console, as `key:cause`. */
 67: const reported = new Set<string>();
 68: 
 69: /**
 70:  * One console line per performer and cause saying why their notes are not
 71:  * heard: the thing to read on a client that stays silent.
 72:  */
 73: function report(key: PerformerKey, cause: string, text: string): void {
 74:   const tag = `${key}:${cause}`;
 75:   if (reported.has(tag)) return;
 76:   reported.add(tag);
 77:   console.warn(`band: ${key}: ${text}`);
 78: }
 79: 
 80: function forget(key: PerformerKey): void {
 81:   for (const tag of Array.from(reported)) {
 82:     if (tag.startsWith(`${key}:`)) reported.delete(tag);
 83:   }
 84: }
 85: 
 86: /** The context, once Babylon has made one; null before the scene exists. */
 87: function context(): AudioContext | null {
 88:   if (ctx) return ctx;
 89:   const engine = Engine.audioEngine;
 90:   const c = engine?.audioContext ?? null;
 91:   if (!c || !engine) return null;
 92: 
 93:   ctx = c;
 94:   bus = c.createGain();
 95:   bus.gain.value = 0;
 96:   // The MusyngKite renders are very quiet - they peak near 0.07 (about -23 dB),
 97:   // so even at full slider a note was drowned by ambient sounds. The sampler
 98:   // lifts each voice by the makeup gain; the limiter here catches the peaks
 99:   // of a loud chord so the boost never clips.
100:   const limiter = c.createDynamicsCompressor();
101:   limiter.threshold.value = -3;
102:   limiter.ratio.value = 20;
103:   limiter.knee.value = 0;
104:   limiter.attack.value = 0.003;
105:   limiter.release.value = 0.12;
106:   bus.connect(limiter);
107:   limiter.connect(engine.masterGain);
108:   sampler = new Sampler(c, bus, MAKEUP_GAIN);
109:   return ctx;
110: }
111: 
112: /** Whether a note scheduled now would be heard: the context exists and the page has been touched. */
113: export function contextReady(): boolean {
114:   return SoundsManager.pageInteracted && context() !== null;
115: }
116: 
117: /** The audio clock, seconds; 0 before the context exists. */
118: export function audioNow(): number {
119:   return context()?.currentTime ?? 0;
120: }
121: 
122: export function bankReady(id: InstrumentId): boolean {
123:   return banks.has(id);
124: }
125: 
126: /**
127:  * Loads an instrument's notes if they are not in yet. Resolves to whether
128:  * the bank is playable; a failed load resolves false and is retried on the
129:  * next call.
130:  */
131: export function ensureBank(id: InstrumentId): Promise<boolean> {
132:   if (banks.has(id)) return Promise.resolve(true);
133:   const pending = loading.get(id);
134:   if (pending) return pending;
135: 
136:   const c = context();
137:   if (!c) return Promise.resolve(false);
138: 
139:   const task = loadBank(c, id)
140:     .then(bank => {
141:       banks.set(id, bank);
142:       console.info(`band: ${id} notes ready`);
143:       return true;
144:     })
145:     .catch(err => {
146:       console.warn(`instrument bank ${id} failed to load:`, err);
147:       return false;
148:     })
149:     .finally(() => loading.delete(id));
150:   loading.set(id, task);
151:   return task;
152: }
153: 
154: function performer(key: PerformerKey): PerformerState {
155:   let p = performers.get(key);
156:   if (!p) {
157:     p = { x: 0, z: 0, local: false, gain: -1 };
158:     performers.set(key, p);
159:   }
160:   return p;
161: }
162: 
163: /** Where a performer stands, for the distance gain; `local` is the hero, always full. */
164: export function setPerformerPosition(key: PerformerKey, x: number, z: number, local = false): void {
165:   const p = performer(key);
166:   p.x = x;
167:   p.z = z;
168:   p.local = local;
169: }
170: 
171: /**
172:  * A note starts at audio time `when`. Nothing when the bank is not in, the
173:  * context is locked, or the player has turned other performers off - each
174:  * said once on the console.
175:  */
176: export function noteOn(
177:   key: PerformerKey,
178:   instrument: InstrumentId,
179:   channel: number,
180:   note: number,
181:   velocity: number,
182:   when: number
183: ): void {
184:   const p = performer(key);
185:   const bank = banks.get(instrument);
186:   if (!bank) {
187:     const state = loading.has(instrument) ? 'still loading' : 'not loaded';
188:     report(key, 'bank', `notes dropped, the ${instrument} notes are ${state}`);
189:     return;
190:   }
191:   if (!contextReady() || !sampler) {
192:     report(key, 'locked', 'notes dropped, audio is locked until the page is clicked');
193:     return;
194:   }
195:   if (!p.local && !GameOptions.hearInstruments) {
196:     report(key, 'muted', "notes dropped, other players' instruments are off in the options");
197:     return;
198:   }
199:   if (busLevel >= 0 && busLevel <= 0.001) {
200:     report(key, 'bus', 'notes play into a silent bus: a volume slider at zero, or the page in the background');
201:   }
202:   // The performer's node is made on their first note, at the level their
203:   // distance gives right now rather than full until the next frame.
204:   if (p.gain < 0) p.gain = gainFor(p);
205:   sampler.noteOn(key, bank, channel, note, velocity, when, p.gain);
206: }
207: 
208: export function noteOff(key: PerformerKey, channel: number, note: number, when: number): void {
209:   sampler?.noteOff(key, channel, note, when);
210: }
211: 
212: export function allNotesOff(key: PerformerKey): void {
213:   sampler?.allNotesOff(key);
214: }
215: 
216: /** The performer left: silence, and forget where they stood. */
217: export function dropPerformer(key: PerformerKey): void {
218:   sampler?.dropPerformer(key);
219:   performers.delete(key);
220:   forget(key);
221: }
222: 
223: /** A performer's level from where they stand; the hero is always full. */
224: function gainFor(p: PerformerState, hero = listenerHero()): number {
225:   if (p.local || !hero) return 1;
226:   const dx = p.x - hero.transform.pos.x;
227:   const dz = p.z - hero.transform.pos.z;
228:   return distanceGain(Math.sqrt(dx * dx + dz * dz));
229: }
230: 
231: /** Voices sounding right now (debug). */
232: export function instrumentVoices(): number {
233:   return sampler?.voiceCount ?? 0;
234: }
235: 
236: function update(_map: ENUM_WORLD, _dt: number): void {
237:   if (!ctx || !bus || !sampler) return;
238: 
239:   const level =
240:     masterGain() *
241:     busGain('effects') *
242:     busGain('instruments') *
243:     (SoundsManager.backgrounded ? 0 : 1);
244:   if (Math.abs(level - busLevel) > 0.001) {
245:     busLevel = level;
246:     bus.gain.setTargetAtTime(level, ctx.currentTime, BUS_RAMP);
247:   }
248: 
249:   const hero = listenerHero();
250:   let audible = 0;
251:   for (const [key, p] of performers) {
252:     const g = gainFor(p, hero);
253:     if (Math.abs(g - p.gain) > 0.01) {
254:       p.gain = g;
255:       sampler.setPerformerGain(key, g, DISTANCE_RAMP);
256:     }
257:     audible = Math.max(audible, g);
258:   }
259: 
260:   // Duck the background music while an instrument is heard nearby, and let it
261:   // rise again a moment after the last note so it does not flap between notes.
262:   const now = audioNow();
263:   if (sampler.voiceCount > 0 && audible > DUCK_MIN_GAIN) lastAudible = now;
264:   SoundsManager.setInstrumentsActive(now - lastAudible < DUCK_HOLD_SEC);
265: }
266: 
267: /** Map change: every performer is gone; the decoded banks stay. */
268: function reset(): void {
269:   if (sampler) for (const key of Array.from(performers.keys())) sampler.dropPerformer(key);
270:   performers.clear();
271:   reported.clear();
272:   lastAudible = 0;
273:   SoundsManager.setInstrumentsActive(false);
274: }
275: 
276: // ---- 3. the layer ----------------------------------------------------------
277: 
278: export const instrumentsLayer: SoundLayer = {
279:   name: 'instruments',
280:   update,
281:   reset,
282: };
