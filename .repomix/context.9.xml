<file path="src/sound/buses.ts">
 1: import { GameOptions } from '../common/gameOptions';
 2: 
 3: /**
 4:  * The mixer's categories. Pure data over `GameOptions` - no Babylon, no
 5:  * state - so anything that plays a sound can ask what its share is without
 6:  * reaching into the mixer.
 7:  *
 8:  * Two levels and no more: the master slider the original had, then `music`
 9:  * and `effects` on the two Babylon tracks, then one category under
10:  * `effects` per kind of sound. A category is *not* a track: a key belongs
11:  * to more than one of them (`eGem` is a jewel landing and a jewel going
12:  * into the bag), and the mixer keeps one `Sound` per key, so the category
13:  * is decided per play and folded into that play's volume.
14:  *
15:  * Read by: `listener.ts` (every one-shot), the three looping entries
16:  * (`ambientBeds`, `crackle`, `objectLoops`) once a frame, `music.ts`, and
17:  * `sound/index.ts` for the two track gains.
18:  */
19: 
20: // ---- 1. tuning -------------------------------------------------------------
21: 
22: /** Where a category slider stops, and where its gain is 1. */
23: export const BUS_VOLUME_MAX = 10;
24: 
25: /**
26:  * `world` is the default: a map door, a firework, a meteor - a sound that
27:  * belongs to no category in particular. It rides `effects` at gain 1 and has
28:  * no slider of its own, because `effects` is already the useful thing to say
29:  * about the group.
30:  */
31: export type SoundBus =
32:   | 'music'
33:   | 'effects'
34:   | 'combat'
35:   | 'monsters'
36:   | 'ambient'
37:   | 'steps'
38:   | 'drops'
39:   | 'ui'
40:   | 'instruments'
41:   | 'world';
42: 
43: /** The option each bus reads, `null` for the one that has no slider. */
44: export const BUS_VOLUME_OPTION = {
45:   music: 'musicVolume',
46:   effects: 'effectsVolume',
47:   combat: 'combatVolume',
48:   monsters: 'monsterVolume',
49:   ambient: 'ambientVolume',
50:   steps: 'stepsVolume',
51:   drops: 'dropVolume',
52:   ui: 'uiVolume',
53:   instruments: 'instrumentsVolume',
54:   world: null,
55: } as const satisfies Record<SoundBus, keyof typeof GameOptions | null>;
56: 
57: // ---- 2. readers ------------------------------------------------------------
58: 
59: const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
60: 
61: /** The original's slider curve: level 0..9 -> gain `level / 10` (SceneCommon.cpp:220-234). */
62: export function masterGain(): number {
63:   return clamp01(GameOptions.volume / 10);
64: }
65: 
66: /**
67:  * One category's own gain, 0..1, with the master left out - the tracks
68:  * already carry that. `world` is always 1.
69:  */
70: export function busGain(bus: SoundBus): number {
71:   const option = BUS_VOLUME_OPTION[bus];
72:   if (option === null) return 1;
73:   return clamp01(GameOptions[option] / BUS_VOLUME_MAX);
74: }
75: 
76: /** Nothing on this bus can be heard, so a loop should stop rather than run silent. */
77: export function busSilent(bus: SoundBus): boolean {
78:   return busGain(bus) <= 0;
79: }
80: 
81: /** What the two Babylon tracks are set to, master folded in. */
82: export function trackGains(): { music: number; effects: number } {
83:   const master = masterGain();
84:   return {
85:     music: master * busGain('music'),
86:     effects: master * busGain('effects'),
87:   };
88: }
</file>

