  1: import { noteSource, type DecodedBank } from './bank';
  2: 
  3: /**
  4:  * The voices. One `AudioBufferSourceNode` per sounding note, through its own
  5:  * envelope gain, into the performer's gain (distance) and on to the bus the
  6:  * layer owns. Pure Web Audio over a context and an output node handed in.
  7:  *
  8:  * A wind (`manifest.sustained`) plays its render until note-off, then a short
  9:  * release; a note held past the render simply ends - the pre-rendered notes
 10:  * have no loop points. A plucked string carries its own decay and note-off
 11:  * only damps the tail, over the bank's longer release. Polyphony is capped
 12:  * per performer and overall; the oldest voice gives way.
 13:  *
 14:  * The makeup gain that lifts the quiet renders lives in each voice's peak,
 15:  * ahead of the performer's distance gain: a far performer is a quiet one,
 16:  * and the limiter after the bus only meets the loud chords played nearby.
 17:  */
 18: 
 19: // ---- 1. tuning -------------------------------------------------------------
 20: 
 21: /** Voices one performer may hold. A guitar arpeggio with ringing tails wants a few. */
 22: const MAX_VOICES_PER_PERFORMER = 24;
 23: 
 24: /** Voices across every performer in earshot. */
 25: const MAX_VOICES = 96;
 26: 
 27: /** Seconds a stolen or retriggered voice takes to get out of the way. */
 28: const STEAL_FADE = 0.01;
 29: 
 30: /** Peak gain of a full-velocity note before the makeup; leaves headroom for the polyphony above. */
 31: const PEAK = 0.8;
 32: 
 33: /** Velocity curve: MIDI 127 is loud, 64 is a little under half. */
 34: const VELOCITY_CURVE = 1.6;
 35: 
 36: // ---- 2. the envelope -------------------------------------------------------
 37: 
 38: export type PerformerKey = string;
 39: 
 40: /** The part of a voice's envelope known ahead: 0 at `startedAt`, `peak` from `attackEnd` on. */
 41: export type Envelope = { startedAt: number; attackEnd: number; peak: number };
 42: 
 43: /**
 44:  * The envelope's level at audio time `at`, from its own schedule. An
 45:  * AudioParam's `.value` is its level *now*, and a note-off is scheduled a
 46:  * quarter second ahead: reading it there pinned the level of a note that had
 47:  * not started yet - the node's default, 1 - onto the start of the release.
 48:  */
 49: export function envelopeLevelAt(env: Envelope, at: number): number {
 50:   if (at >= env.attackEnd) return env.peak;
 51:   if (at <= env.startedAt) return 0;
 52:   return (env.peak * (at - env.startedAt)) / (env.attackEnd - env.startedAt);
 53: }
 54: 
 55: type Voice = Envelope & {
 56:   src: AudioBufferSourceNode;
 57:   env: GainNode;
 58:   performer: PerformerKey;
 59:   channel: number;
 60:   note: number;
 61:   release: number;
 62:   ended: boolean;
 63: };
 64: 
 65: // ---- 3. the sampler --------------------------------------------------------
 66: 
 67: export class Sampler {
 68:   private readonly voices = new Set<Voice>();
 69:   private readonly performers = new Map<PerformerKey, GainNode>();
 70: 
 71:   /** `makeup` multiplies every voice's peak: the renders' lift to a normal loudness. */
 72:   constructor(
 73:     private readonly ctx: AudioContext,
 74:     private readonly out: AudioNode,
 75:     private readonly makeup = 1
 76:   ) {}
 77: 
 78:   get voiceCount(): number {
 79:     return this.voices.size;
 80:   }
 81: 
 82:   /** The performer's gain node, made on first use at `initialGain`. */
 83:   performerNode(key: PerformerKey, initialGain = 1): GainNode {
 84:     let node = this.performers.get(key);
 85:     if (!node) {
 86:       node = this.ctx.createGain();
 87:       node.gain.value = initialGain;
 88:       node.connect(this.out);
 89:       this.performers.set(key, node);
 90:     }
 91:     return node;
 92:   }
 93: 
 94:   setPerformerGain(key: PerformerKey, gain: number, ramp = 0.05): void {
 95:     const node = this.performers.get(key);
 96:     if (!node) return;
 97:     node.gain.setTargetAtTime(gain, this.ctx.currentTime, ramp);
 98:   }
 99: 
100:   /** `gain` is the performer's level should this be their first note. */
101:   noteOn(
102:     key: PerformerKey,
103:     bank: DecodedBank,
104:     channel: number,
105:     note: number,
106:     velocity: number,
107:     when: number,
108:     gain = 1
109:   ): void {
110:     const source = noteSource(bank, note);
111:     if (!source) return;
112: 
113:     // The same note again on this performer and channel: the old voice goes.
114:     for (const v of this.voices) {
115:       if (v.performer === key && v.channel === channel && v.note === note) this.end(v, when, STEAL_FADE);
116:     }
117:     this.makeRoom(key, when);
118: 
119:     const { manifest } = bank;
120:     const env = this.ctx.createGain();
121:     env.connect(this.performerNode(key, gain));
122: 
123:     const src = this.ctx.createBufferSource();
124:     src.buffer = source.buffer;
125:     src.playbackRate.value = source.rate;
126:     src.connect(env);
127: 
128:     const peak = this.makeup * PEAK * Math.pow(Math.max(0, Math.min(127, velocity)) / 127, VELOCITY_CURVE);
129:     const start = Math.max(when, this.ctx.currentTime);
130:     const attackEnd = start + manifest.attack;
131:     env.gain.value = 0;
132:     env.gain.setValueAtTime(0, start);
133:     env.gain.linearRampToValueAtTime(peak, attackEnd);
134: 
135:     const voice: Voice = {
136:       src,
137:       env,
138:       performer: key,
139:       channel,
140:       note,
141:       startedAt: start,
142:       attackEnd,
143:       peak,
144:       release: manifest.release,
145:       ended: false,
146:     };
147:     this.voices.add(voice);
148: 
149:     src.onended = () => {
150:       this.voices.delete(voice);
151:       env.disconnect();
152:     };
153:     src.start(start);
154:   }
155: 
156:   noteOff(key: PerformerKey, channel: number, note: number, when: number): void {
157:     for (const v of this.voices) {
158:       if (v.performer === key && v.channel === channel && v.note === note) this.end(v, when, v.release);
159:     }
160:   }
161: 
162:   /** Every voice of a performer, or every voice at all, released now. */
163:   allNotesOff(key?: PerformerKey, when = this.ctx.currentTime): void {
164:     for (const v of this.voices) {
165:       if (key === undefined || v.performer === key) this.end(v, when, v.release);
166:     }
167:   }
168: 
169:   /** The performer is gone: silence and drop its node. */
170:   dropPerformer(key: PerformerKey): void {
171:     this.allNotesOff(key);
172:     const node = this.performers.get(key);
173:     if (node) {
174:       node.disconnect();
175:       this.performers.delete(key);
176:     }
177:   }
178: 
179:   /**
180:    * Release from `when` over `release` seconds: hold the level the envelope
181:    * has there, then ramp to nothing. A release inside the attack waits for
182:    * the attack to end - cancelling the attack ramp would drop the note to
183:    * silence for the frames in between.
184:    */
185:   private end(v: Voice, when: number, release: number): void {
186:     if (v.ended) return;
187:     v.ended = true;
188:     const at = Math.max(when, this.ctx.currentTime, v.attackEnd);
189:     const g = v.env.gain;
190:     g.cancelScheduledValues(at);
191:     g.setValueAtTime(envelopeLevelAt(v, at), at);
192:     g.linearRampToValueAtTime(0, at + release);
193:     try {
194:       v.src.stop(at + release + 0.01);
195:     } catch {
196:       // Already stopped.
197:     }
198:   }
199: 
200:   private makeRoom(key: PerformerKey, when: number): void {
201:     let mine = 0;
202:     let oldestMine: Voice | null = null;
203:     let oldest: Voice | null = null;
204:     for (const v of this.voices) {
205:       if (v.ended) continue;
206:       if (!oldest || v.startedAt < oldest.startedAt) oldest = v;
207:       if (v.performer === key) {
208:         mine++;
209:         if (!oldestMine || v.startedAt < oldestMine.startedAt) oldestMine = v;
210:       }
211:     }
212:     if (mine >= MAX_VOICES_PER_PERFORMER && oldestMine) this.end(oldestMine, when, STEAL_FADE);
213:     else if (this.voices.size >= MAX_VOICES && oldest) this.end(oldest, when, STEAL_FADE);
214:   }
215: }
</file>

