1496:   /**
1497:    * Opens the game-server socket. `fallbackHost` is the address to try if this
1498:    * one never answers - `gameServerTarget` decides which of the two addresses
1499:    * (the one the server advertised, the connect-server host) goes first.
1500:    */
1501:   connectToGameServer(ip: string, port: number, fallbackHost: string | null = null) {
1502:     runInAction(() => {
1503:       this.connectionLost = false;
1504:     });
1505: 
1506:     this.lastGameServer = { host: ip, port, fallbackHost };
1507: 
1508:     const { socket } = createSocket({
1509:       wsAddress: wsAddress(),
1510:       tcpIP: ip,
1511:       tcpPort: port,
1512:     });
1513: 
1514:     this.gsSocket = socket;
1515: 
1516:     this.encryptor = new SimpleModulusEncryptor();
1517:     this.encryptor.encryptionKeys = SimpleModulusKeys.CreateEncryptionKeys([
1518:       ...gameVersion.protocol.encryption.clientToServer,
1519:     ]);
1520: 
1521:     this.gsAttempt = { host: ip, port, fallbackHost, timer: null };
1522: 
1523:     // The proxy closes the ws when the TCP connect fails, which is the fast
1524:     // path into the retry. The timer is for the case with no close at all -
1525:     // a firewall that drops the SYN, an address that routes nowhere.
1526:     if (fallbackHost) {
1527:       this.gsAttempt.timer = setTimeout(
1528:         () => this.retryGameServer('never answered'),
1529:         GS_ANSWER_TIMEOUT
1530:       );
1531:     }
1532:   }
1533: 
1534:   /** `GameServerEntered` arrived: this address works, drop the fallback. */
1535:   onGameServerReached(): void {
1536:     if (this.gsAttempt?.timer) clearTimeout(this.gsAttempt.timer);
1537:     this.gsAttempt = null;
1538:   }
1539: 
1540:   /**
1541:    * Second and last attempt at the game server, on the connect-server host.
1542:    * Returns false when there is nothing to retry - the caller then treats the
1543:    * dead socket as a lost connection, as it always did.
1544:    */
1545:   private retryGameServer(reason: string): boolean {
1546:     const attempt = this.gsAttempt;
1547: 
1548:     if (!attempt?.fallbackHost) return false;
1549: 
1550:     if (attempt.timer) clearTimeout(attempt.timer);
1551:     this.gsAttempt = null;
1552: 
1553:     console.warn(
1554:       `game server ${attempt.host}:${attempt.port} ${reason}; retrying on ${attempt.fallbackHost}:${attempt.port}`
1555:     );
1556: 
1557:     this.disconnectFromGameServer();
1558:     this.connectToGameServer(attempt.fallbackHost, attempt.port);
1559: 
1560:     return true;
1561:   }
