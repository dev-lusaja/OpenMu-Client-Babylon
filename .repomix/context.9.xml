267: 
268: /** Every bed any map can ask for, so leaving a map can silence the lot. */
269: const ALL_BEDS: readonly Sounds[] = [
270:   ...new Set(Object.values(BEDS).flatMap(beds => beds.map(bed => bed.sound))),
271: ];
272: 
273: // ---- 2. state + readers ----------------------------------------------------
274: 
275: const playing = new Set<Sounds>();
276: /** Scratch: this frame's beds. Module-level so the update allocates nothing. */
277: const wanted = new Set<Sounds>();
278: 
279: /** The beds sounding right now (after the tile / weather gates). */
280: export function ambientBedsPlaying(): ReadonlySet<Sounds> {
281:   return playing;
282: }
283: 
284: function update(map: ENUM_WORLD, dt: number): void {
285:   const world = listenerWorld();
286:   if (!SoundsManager.pageInteracted || !world?.terrain) return;
287: 
288:   const hero = listenerHero();
289:   if (!hero) return;
290: 
291:   // The ambience slider at 0 leaves `wanted` empty, so the pass below stops
292:   // every bed rather than looping them at silence.
293:   const gain = busGain(BUS);
294:   const beds = gain > 0 ? (BEDS[map] ?? []) : [];
295: 
296:   const heroTile = world.getTerrainTile(
297:     ~~hero.transform.pos.x,
298:     ~~hero.transform.pos.z
299:   );
300: 
301:   // The beds live on the effects track, so the master volume is already
302:   // applied to them; `bed.volume` is only the mix under the SFX, and `gain`
303:   // the ambience category. (`playAmbientLoop` only touches the gain when it
304:   // changed.)
305:   wanted.clear();
306: 
307:   for (const bed of beds) {
308:     if (bed.mutedOn?.(heroTile)) continue;
309:     if (bed.when && !bed.when()) continue;
310: 
311:     wanted.add(bed.sound);
312:     SoundsManager.playAmbientLoop(bed.sound, bed.volume * gain);
313:   }
314: 
315:   // Everything this map does not want right now - including a bed this
316:   // map owns but has just muted - goes quiet.
317:   for (const sound of ALL_BEDS) {
318:     if (wanted.has(sound)) continue;
319:     if (!playing.has(sound)) continue;
320: 
321:     SoundsManager.stopAmbientLoop(sound);
322:   }
323: 
324:   playing.clear();
325:   for (const sound of wanted) playing.add(sound);
326: 
327:   for (const shot of gain > 0 ? (ONE_SHOTS[map] ?? []) : []) {
328:     // rand_fps_check(n) is a 1-in-n roll per reference frame; at any other
329:     // frame rate the same expected rate is dt * REFERENCE_FPS / n.
330:     if (Math.random() >= (dt * REFERENCE_FPS) / shot.oneIn) continue;
331: 
332:     // Through `playSfx`, the streaming path: the buffer is fetched on first
333:     // use, so a one-shot sounds the first time it is rolled rather than only
334:     // after an eager preload nobody runs.
335:     playSfx(shot.sound, shot.spread ? boidPosition(hero, shot.spread) : null, {
336:       gain: shot.volume,
337:       bus: BUS,
338:     });
339:   }
340: }
341: 
342: /** Somewhere a boid would be: `BOID_MIN_TILES`…`spread` tiles from the hero. */
343: function boidPosition(
344:   hero: NonNullable<ReturnType<typeof listenerHero>>,
345:   spread: number
346: ): SfxPosition {
347:   const angle = Math.random() * Math.PI * 2;
348:   const r = BOID_MIN_TILES + Math.random() * (spread - BOID_MIN_TILES);
349:   return {
350:     x: hero.transform.pos.x + Math.cos(angle) * r,
351:     z: hero.transform.pos.z + Math.sin(angle) * r,
352:   };
353: }
354: 
355: /** Leaving a map: its beds stop now rather than a frame into the next one. */
356: function reset(): void {
357:   for (const sound of playing) SoundsManager.stopAmbientLoop(sound);
358:   playing.clear();
359: }
360: 
361: // ---- 3. the layer ----------------------------------------------------------
362: 
363: export const ambientBedsLayer: SoundLayer = {
364:   name: 'ambientBeds',
365:   maps: MAPS,
366:   update,
367:   reset,
368: };
</file>

