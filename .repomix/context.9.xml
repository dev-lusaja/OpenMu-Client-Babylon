1858:   /**
1859:    * WalkRequest (0xD4). `x`/`y` is the tile the walk starts from - the one
1860:    * the hero is logically standing on when the first step is taken, which
1861:    * the server compares against its own position (PlayerMovement.
1862:    * IsWalkRequestValidAsync, tolerance 5 tiles). At most 15 steps fit the
1863:    * 4-bit count (MAX_PATH_FIND in the original client); longer paths are
1864:    * sent in segments by NetworkSystem.
1865:    */
1866:   sendWalkPath(x: number, y: number, dirs: number[]): void {
1867:     if (dirs.length === 0) return;
1868:     if (dirs.length > 15) dirs = dirs.slice(0, 15);
1869:     x = Math.round(x);
1870:     y = Math.round(y);
1871: 
1872:     // Two steps per byte, first step in the high nibble (see WalkRequest in
1873:     // the OpenMU packet docs); byte 5 carries rotation (high) + count (low).
1874:     const packed = new Array<number>(Math.ceil(dirs.length / 2)).fill(0);
1875:     for (let i = 0; i < dirs.length; i++) {
1876:       const shift = i % 2 === 0 ? 4 : 0;
1877:       packed[i >> 1] |= (dirs[i] & 0x0f) << shift;
1878:     }
1879: 
1880:     const packet = WalkRequestPacket.createPacket(6 + packed.length);
1881:     packet.SourceX = x;
1882:     packet.SourceY = y;
1883:     packet.StepCount = dirs.length;
1884:     packet.TargetRotation = dirs[dirs.length - 1];
1885:     packet.setDirections(packed, packed.length);
1886: 
1887:     this.lastWalkRequest = { x, y, steps: dirs.length, at: performance.now() };
1888:     this.sendToGS(packet.buffer);
1889:   }
