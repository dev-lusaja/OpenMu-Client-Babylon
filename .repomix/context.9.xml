2413:   /**
2414:    * `FindEmptySlot` on the far grid: the local index a right-click sends the
2415:    * item to (`ProcessStorageItemAutoMove`), or -1 when there is no room.
2416:    */
2417:   findFreeSquare(storage: StorageKind, item: Item): number {
2418:     const items = this.itemsOfStorage(storage);
2419:     const columns = storageColumns(storage);
2420:     const rows = storageRows(storage);
2421:     const offset = gridFirstIndex(storage);
2422:     const { w, h } = itemSize(item);
2423: 
2424:     const used = new Uint8Array(columns * rows);
2425:     for (let square = 0; square < columns * rows; square++) {
2426:       const placed = items[offset + square];
2427:       if (!placed) continue;
2428:       const size = itemSize(placed);
2429:       const column = square % columns;
2430:       const row = (square - column) / columns;
2431:       for (let y = 0; y < size.h; y++) {
2432:         for (let x = 0; x < size.w; x++) {
2433:           if (column + x < columns && row + y < rows) {
2434:             used[(row + y) * columns + column + x] = 1;
2435:           }
2436:         }
2437:       }
2438:     }
2439: 
2440:     for (let row = 0; row + h <= rows; row++) {
2441:       for (let column = 0; column + w <= columns; column++) {
2442:         let fits = true;
2443:         for (let y = 0; y < h && fits; y++) {
2444:           for (let x = 0; x < w; x++) {
2445:             if (used[(row + y) * columns + column + x]) {
2446:               fits = false;
2447:               break;
2448:             }
2449:           }
2450:         }
2451:         if (fits) return offset + row * columns + column;
2452:       }
2453:     }
2454: 
2455:     return -1;
2456:   }
