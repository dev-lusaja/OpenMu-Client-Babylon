  7: import { listenerHero, listenerWorld } from './listener';
  8: 
  9: /**
 10:  * The object loops: the sounds the original attaches to map objects from a
 11:  * world's per-object sound hook - `PlayBuffer(SOUND_x, o)` re-issued every
 12:  * frame for as long as the object is in the update set (DSPlaySound.cpp:303,
 13:  * a `Play` on an already-playing channel is a no-op, so a long sample reads
 14:  * as a loop). Elbeland's brooks and gates (`GMNewTown::PlayObjectSound`),
 15:  * Kanturu's wheel / waterfall / arc / plant, gear and incubators, the Tower's
 16:  * crystals and field (`Sound_Kanturu2nd_Object`, `M39Kanturu3rd`), Karutan's
 17:  * insects (`CGMKarutan1::PlayObjectSound`), the Barracks' cages, volcano and
 18:  * fire pillar (`CGM3rdChangeUp::PlayEffectSound`).
 19:  *
 20:  * Every instance of a registered type is a candidate; each frame the nearest
 21:  * `MAX_SOURCES` within their row's reach get a slot - an independent looping
 22:  * mixer instance (`SoundsManager.loopInstance`) at the row's gain under the
 23:  * listener's attenuation curve. The older worlds (Lorencia … Icarus) have no
 24:  * such hook in `ZzzObject.cpp`: their only object sounds are the door and
 25:  * gate one-shots, which live with the door system.
 26:  *
 27:  * Driven by: the ECS map-object entities (`modelId` + `worldIndex` +
 28:  * `transform`, read-only, rescanned every `SCAN_SECONDS`), the listener hero
 29:  * and its tile's `TW_SAFEZONE` flag.
 30:  * Read by: `sound.objectLoops` (the verification scripts).
 31:  */
 32: 
 33: // ---- 1. tuning -------------------------------------------------------------
 34: 
 35: /** Brooks, gears and gates are part of the place, so ambience (`sound/buses.ts`). */
 36: const BUS: SoundBus = 'ambient';
 37: 
 38: /**
 39:  * A registered object sound: every placed instance of `types` on the map is a
 40:  * source of `sound`.
 41:  */
 42: export type ObjectLoop = {
 43:   /** Object types (`modelId`, the world's `Object<N>` index) that carry it. */
 44:   readonly types: readonly number[];
 45:   readonly sound: Sounds;
 46:   /** Share of the effects track at the source, 0…1 - under the beds' SFX. */
 47:   readonly gain: number;
 48:   /** Tiles inside which the loop is at full `gain`. */
 49:   readonly full: number;
 50:   /** Tiles beyond which the source is silent and does not take a slot. */
 51:   readonly silent: number;
 52:   /**
 53:    * Extra gate evaluated each frame with the hero's state. Omit = always. The
 54:    * Elbeland rows are muted while the hero stands on a `TW_SAFEZONE` tile
 55:    * (`!bSafeZone`); the Barracks fire pillar breathes with the same sine that
 56:    * drives its flame.
 57:    */
 58:   readonly when?: (hero: HeroContext) => boolean;
 59: };
 60: 
 61: export type HeroContext = {
 62:   /** Whether the tile under the hero carries `TW_SAFEZONE`. */
 63:   inSafeZone: boolean;
 64:   /** Milliseconds since boot, the original's `WorldTime`. */
 65:   time: number;
 66: };
 67: 
 68: const outsideSafeZone = (h: HeroContext): boolean => !h.inSafeZone;
 69: 
 70: /**
 71:  * GM3rdChangeUp.cpp:364-367: the pillar sounds only while its flame sine
 72:  * (`(sin(WorldTime * 0.0005) + 1) / 2`) is above 0.9 - a burst every ~12.6 s.
 73:  */
 74: const firePillarBurning = (h: HeroContext): boolean =>
 75:   (Math.sin(h.time * 0.0005) + 1) * 0.5 > 0.9;
 76: 
 77: /**
 78:  * Reach of a small source (a brook, a gear): full inside a hand's reach,
 79:  * gone at 14 tiles - DirectSound's 3D rolloff on a sample that was set up to
 80:  * be heard from across a courtyard, not across the map.
 81:  */
 82: const SMALL_FULL = 2;
 83: const SMALL_SILENT = 14;
 84: /**
 85:  * Reach of a large source (a waterfall, the great wheel, the volcano): the
 86:  * original plays these unpositioned on Kanturu (`PlayBuffer(sound)` with no
 87:  * object, GM_kanturu_1st.cpp:67-115) so they carry over the whole ruin; here
 88:  * they fade over 30 tiles so two waterfalls do not stack to a roar.
 89:  */
 90: const LARGE_FULL = 6;
 91: const LARGE_SILENT = 30;
 92: 
 93: const small = (
 94:   types: readonly number[],
 95:   sound: Sounds,
 96:   gain: number,
 97:   when?: ObjectLoop['when']
 98: ): ObjectLoop => ({
 99:   types,
100:   sound,
101:   gain,
102:   full: SMALL_FULL,
103:   silent: SMALL_SILENT,
104:   when,
105: });
106: const large = (
107:   types: readonly number[],
108:   sound: Sounds,
109:   gain: number,
110:   when?: ObjectLoop['when']
111: ): ObjectLoop => ({
112:   types,
113:   sound,
114:   gain,
115:   full: LARGE_FULL,
116:   silent: LARGE_SILENT,
117:   when,
118: });
119: 
120: /**
121:  * THE table: which object types sound on which map. Pure data - the source
122:  * lines are the original's per-world sound hook.
123:  */
124: export const OBJECT_LOOPS: ReadonlyMap<ENUM_WORLD, readonly ObjectLoop[]> =
125:   new Map<ENUM_WORLD, readonly ObjectLoop[]>([
126:     // GMNewTown.cpp:193-232 (`PlayObjectSound`).
127:     [
128:       ENUM_WORLD.WD_51ELBELAND,
129:       [
130:         small([2], 'Sound/w52/SE_Obj_watersmall01', 0.35, outsideSafeZone),
131:         large([53], 'Sound/w52/SE_Amb_ravine01', 0.35, outsideSafeZone),
132:         large([56], 'Sound/w52/SE_Amb_enteratlance01', 0.35),
133:         large([59], 'Sound/w52/SE_Obj_waterfallsmall01', 0.4, outsideSafeZone),
134:         large([85], 'Sound/w52/SE_Obj_enterdevias01', 0.35),
135:         small([89], 'Sound/w52/SE_Obj_waterway01', 0.35, outsideSafeZone),
136:         large([110], 'Sound/w52/SE_Obj_villageprotection01', 0.35),
137:       ],
138:     ],
139:     // GM_kanturu_1st.cpp:60-115 (`MoveKanturu1stObject`).
140:     [
141:       ENUM_WORLD.WD_37KANTURU_1ST,
142:       [
143:         large([46], 'Sound/w37/kan_ruin_wheel', 0.35),
144:         large([77], 'Sound/w37/kan_ruin_waterfall', 0.4),
145:         small([92], 'Sound/w37/kan_ruin_elec', 0.35),
146:         small([98], 'Sound/w37/kan_ruin_plant', 0.3),
147:       ],
148:     ],
149:     // GM_Kanturu_2nd.cpp:194-210 (`Sound_Kanturu2nd_Object`).
150:     [
151:       ENUM_WORLD.WD_38KANTURU_2ND,
152:       [
153:         small([9], 'Sound/w38/kan_relic_gear', 0.35),
154:         small([31, 35, 36, 37], 'Sound/w38/kan_relic_incubator', 0.3),
155:       ],
156:     ],
157:     // GM_Kanturu_3rd.cpp:120-195 (`Sound_Kanturu3rd_Object`, idle map).
158:     [
159:       ENUM_WORLD.WD_39KANTURU_3RD,
160:       [
161:         small([25], 'Sound/w39/kan_boss_incubator', 0.3),
162:         small([40, 41, 42], 'Sound/w39/kan_boss_crystal', 0.3),
163:         small([71], 'Sound/w39/kan_boss_gear', 0.35),
164:         large([73], 'Sound/w39/kan_boss_field', 0.35),
165:       ],
166:     ],
167:     // GMKarutan1.cpp:349-357 (`PlayObjectSound`).
168:     [
169:       ENUM_WORLD.WD_80KARUTAN1,
170:       [small([58, 66], 'Sound/Karutan/Karutan_insect_env', 0.3)],
171:     ],
172:     // GM3rdChangeUp.cpp:352-371 (`PlayEffectSound`); cage01/02 are the
173:     // original's coin flip per call - one file per cage type here so the
174:     // two never fight for one channel.
175:     [
176:       ENUM_WORLD.WD_41CHANGEUP3RD_1ST,
177:       [
178:         small([74], 'Sound/w42/cage01', 0.3),
179:         small([75], 'Sound/w42/cage02', 0.3),
180:         large([79], 'Sound/w42/volcano', 0.4),
181:         small([92], 'Sound/w42/firepillar', 0.35, firePillarBurning),
182:       ],
183:     ],
184:   ]);
185: 
186: /** Maps this exists on: the keys of the table. */
187: const MAPS: ReadonlySet<ENUM_WORLD> = new Set(OBJECT_LOOPS.keys());
188: 
189: /**
190:  * Simultaneous object loops. Six covers Elbeland's brook-lined square (three
191:  * brooks, the waterway, a gate) with a slot to spare; past the sixth-nearest
192:  * the attenuation has the rest below notice.
193:  */
194: const MAX_SOURCES = 6;
195: 
196: /**
197:  * Seconds between re-reading the ECS for instances. Map objects do not move;
198:  * the scan only has to catch a map load.
199:  */
200: const SCAN_SECONDS = 0.5;
201: 
202: // ---- 2. state + readers ----------------------------------------------------
203: 
204: export type ObjectLoopSource = {
205:   readonly x: number;
206:   readonly z: number;
207:   readonly sound: Sounds;
208:   /** Share of the effects track after attenuation, 0…1. */
209:   readonly volume: number;
210: };
211: 
212: type Candidate = { x: number; z: number; row: ObjectLoop };
213: 
214: /** Every registered instance on the map, refreshed each `SCAN_SECONDS`. */
215: let candidates: Candidate[] = [];
216: let scannedMap: ENUM_WORLD | null = null;
217: let untilScan = 0;
218: 
219: /** The nearest sources, slot by slot; `sound` is what the slot is playing. */
220: const slots: {
221:   x: number;
222:   z: number;
223:   volume: number;
224:   row: ObjectLoop | null;
225:   /** The key the mixer instance in this slot was started with. */
226:   playing: Sounds | null;
227: }[] = Array.from({ length: MAX_SOURCES }, () => ({
228:   x: 0,
229:   z: 0,
230:   volume: 0,
231:   row: null,
232:   playing: null,
233: }));
234: let sounding = 0;
235: 
236: /** Scratch: the chosen sources' squared distances, ascending. */
237: const slotDist2 = new Float64Array(MAX_SOURCES);
238: 
239: const sources: ObjectLoopSource[] = [];
240: 
241: /** This frame's hero state for the `when` gates; one object, rewritten each frame. */
242: const ctx: HeroContext = { inSafeZone: false, time: 0 };
243: 
244: /** The object loops sounding right now (nearest first) with their volumes. */
245: export function objectLoopSources(): readonly ObjectLoopSource[] {
246:   sources.length = 0;
247:   for (let i = 0; i < sounding; i++) {
248:     const s = slots[i];
249:     if (!s.row) continue;
250:     sources.push({ x: s.x, z: s.z, sound: s.row.sound, volume: s.volume });
251:   }
252:   return sources;
253: }
254: 
255: /** Attenuation by distance to the hero for a row, 0…1. */
256: function gainAt(row: ObjectLoop, d: number): number {
257:   if (d >= row.silent) return 0;
258:   if (d <= row.full) return 1;
259:   return 1 - (d - row.full) / (row.silent - row.full);
260: }
261: 
262: function rescan(map: ENUM_WORLD): void {
263:   candidates = [];
264:   scannedMap = map;
265:   const rows = OBJECT_LOOPS.get(map);
266:   const world = listenerWorld();
267:   if (!rows || !world) return;
268: 
269:   const byType = new Map<number, ObjectLoop>();
270:   for (const row of rows) for (const t of row.types) byType.set(t, row);
271: 
272:   for (const e of world.with('transform', 'modelId', 'worldIndex')) {
273:     if (e.worldIndex !== map) continue;
274:     const row = byType.get(e.modelId);
275:     if (!row) continue;
276:     candidates.push({ x: e.transform.pos.x, z: e.transform.pos.z, row });
277:   }
278: }
279: 
280: /** Insert (d2, candidate) into the k-nearest scratch, keeping it sorted. */
281: function offer(d2: number, c: Candidate): void {
282:   if (sounding === MAX_SOURCES && d2 >= slotDist2[MAX_SOURCES - 1]) return;
283: 
284:   let i = Math.min(sounding, MAX_SOURCES - 1);
285:   while (i > 0 && slotDist2[i - 1] > d2) {
286:     slotDist2[i] = slotDist2[i - 1];
287:     slots[i].x = slots[i - 1].x;
288:     slots[i].z = slots[i - 1].z;
289:     slots[i].row = slots[i - 1].row;
290:     i--;
291:   }
292:   slotDist2[i] = d2;
293:   slots[i].x = c.x;
294:   slots[i].z = c.z;
295:   slots[i].row = c.row;
296:   if (sounding < MAX_SOURCES) sounding++;
297: }
298: 
299: function stopSlot(i: number): void {
300:   const slot = slots[i];
301:   if (slot.playing) SoundsManager.stopLoopInstance(slot.playing, i);
302:   slot.playing = null;
303:   slot.volume = 0;
304: }
305: 
306: function update(map: ENUM_WORLD, dt: number): void {
307:   if (!SoundsManager.pageInteracted) return;
308: 
309:   const hero = listenerHero();
310:   const world = listenerWorld();
311:   if (!hero || !world) return;
312: 
313:   untilScan -= dt;
314:   if (untilScan <= 0 || scannedMap !== map) {
315:     untilScan = SCAN_SECONDS;
316:     rescan(map);
317:   }
318: 
319:   const hx = hero.transform.pos.x;
320:   const hz = hero.transform.pos.z;
321:   ctx.inSafeZone = (world.getTerrainFlag(~~hx, ~~hz) & TW_SAFEZONE) !== 0;
322:   ctx.time = performance.now();
323: 
324:   // The ambience slider at 0 leaves nothing sounding, so the pass below
325:   // stops every slot rather than looping them at silence.
326:   const gain = busGain(BUS);
327: 
328:   sounding = 0;
329:   for (const c of gain > 0 ? candidates : []) {
330:     const dx = c.x - hx;
331:     const dz = c.z - hz;
332:     const d2 = dx * dx + dz * dz;
333:     if (d2 >= c.row.silent * c.row.silent) continue;
334:     if (c.row.when && !c.row.when(ctx)) continue;
335:     offer(d2, c);
336:   }
337: 
338:   for (let i = 0; i < MAX_SOURCES; i++) {
339:     const slot = slots[i];
340:     const row = i < sounding ? slot.row : null;
341:     if (!row) {
342:       stopSlot(i);
343:       continue;
344:     }
345: 
346:     // A slot that changes file stops the old instance first: the mixer keys
347:     // instances by (file, slot), so the two would otherwise both sound.
348:     if (slot.playing && slot.playing !== row.sound) stopSlot(i);
349: 
350:     slot.volume = row.gain * gain * gainAt(row, Math.sqrt(slotDist2[i]));
351: 
352:     const s = SoundsManager.loopInstance(row.sound, i);
353:     if (!s) continue;
354:     s.setVolume(slot.volume);
355:     if (!s.isPlaying) s.play();
356:     slot.playing = row.sound;
357:   }
358: }
359: 
360: /** Leaving a map: its objects are gone, so are their loops. */
361: function reset(): void {
362:   for (let i = 0; i < MAX_SOURCES; i++) {
363:     stopSlot(i);
364:     slots[i].row = null;
365:   }
366:   candidates = [];
367:   scannedMap = null;
368:   sounding = 0;
369:   untilScan = 0;
370: }
371: 
372: // ---- 3. the layer ----------------------------------------------------------
373: 
374: export const objectLoopsLayer: SoundLayer = {
375:   name: 'objectLoops',
376:   maps: MAPS,
377:   update,
378:   reset,
379: };
</file>

