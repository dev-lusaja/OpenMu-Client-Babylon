<file path="src/sound/crackle.ts">
  1: import type { ENUM_WORLD } from '../common/types';
  2: import { lighting } from '../lighting';
  3: import type { LightSource } from '../lighting/lightSource';
  4: import { SoundsManager } from '../libs/soundsManager';
  5: import { busGain, type SoundBus } from './buses';
  6: import type { Sounds } from './recipes';
  7: import type { SoundLayer } from './layer';
  8: import { listenerHero } from './listener';
  9: 
 10: /**
 11:  * The torch crackle: a looping fire sound under every flickering flame the
 12:  * lighting layer has lit - the Lorencia street braziers, the 120 Dungeon
 13:  * wall torches, Noria's and Lost Tower's - attenuated by its distance to the
 14:  * hero, capped to the nearest few so a corridor of torches is one warm
 15:  * chorus rather than a hundred copies of the same file.
 16:  *
 17:  * The original never did this: there is no `SOUND_FIRE` (only the skill's
 18:  * `SOUND_FIRE_SCREAM`), `CreateFire` plays nothing, and a torch was silent.
 19:  * The bed is the clone's own; it borrows the Flame skill's `sFlame` file
 20:  * because it is the one continuous burning sound in the catalogue.
 21:  *
 22:  * Driven by: the lighting layer's live sources (`lighting.emitters(map)`,
 23:  * read-only - a flame is any source whose recipe flickers) and the listener.
 24:  * Read by: `sound.crackling` (the verification scripts).
 25:  */
 26: 
 27: // ---- 1. tuning -------------------------------------------------------------
 28: 
 29: /** A burning torch is part of the place, so it is ambience (`sound/buses.ts`). */
 30: const BUS: SoundBus = 'ambient';
 31: 
 32: /** The looping fire file. */
 33: const CRACKLE: Sounds = 'Sound/sFlame';
 34: 
 35: /**
 36:  * Simultaneous crackle sources per map. Four covers a Dungeon corridor (a
 37:  * torch every few tiles both sides) without turning it into a roar; beyond
 38:  * the fourth-nearest the attenuation has already taken the rest below notice.
 39:  */
 40: const MAX_SOURCES = 4;
 41: 
 42: /** Share of the effects track a flame at the hero's feet sits at. */
 43: const VOLUME = 0.3;
 44: 
 45: /** Tiles inside which a flame is at full crackle volume - a hand's reach. */
 46: const FULL_VOLUME_TILES = 1.5;
 47: 
 48: /**
 49:  * Tiles beyond which a flame is silent. A torch is a small source; the
 50:  * generic `playSfx` 28-tile reach would have every torch in Lorencia's
 51:  * market square audible from the pub.
 52:  */
 53: const SILENT_TILES = 12;
 54: 
 55: /**
 56:  * Seconds between re-reading the lighting layer's source list. The list is
 57:  * built fresh each call (an allocation), and torches do not move: the scan
 58:  * only has to catch a map load or a candle being lit.
 59:  */
 60: const SCAN_SECONDS = 0.5;
 61: 
 62: /**
 63:  * Playback-rate spread across the slots so four copies of one short file do
 64:  * not phase-lock into a single louder loop. ±5 % keeps it a fire.
 65:  */
 66: const RATE_SPREAD = 0.05;
 67: 
 68: // ---- 2. state + readers ----------------------------------------------------
 69: 
 70: export type CrackleSource = {
 71:   readonly x: number;
 72:   readonly z: number;
 73:   /** Share of the effects track after attenuation, 0…1. */
 74:   readonly volume: number;
 75: };
 76: 
 77: /** Every flickering source on the map, refreshed each `SCAN_SECONDS`. */
 78: let flames: readonly LightSource[] = [];
 79: let untilScan = 0;
 80: 
 81: /** The nearest flames, slot by slot; entries past `sounding` are stale. */
 82: const slots: { x: number; z: number; volume: number }[] = Array.from(
 83:   { length: MAX_SOURCES },
 84:   () => ({ x: 0, z: 0, volume: 0 })
 85: );
 86: let sounding = 0;
 87: 
 88: /** Scratch: the chosen sources' squared distances, ascending. */
 89: const slotDist2 = new Float64Array(MAX_SOURCES);
 90: 
 91: const sources: CrackleSource[] = [];
 92: 
 93: /** The flames crackling right now (nearest first) with their volumes. */
 94: export function crackleSources(): readonly CrackleSource[] {
 95:   sources.length = 0;
 96:   for (let i = 0; i < sounding; i++) sources.push(slots[i]);
 97:   return sources;
 98: }
 99: 
100: /** Attenuation by distance to the hero, 0…1. */
101: function gainAt(d: number): number {
102:   if (d >= SILENT_TILES) return 0;
103:   if (d <= FULL_VOLUME_TILES) return 1;
104:   return 1 - (d - FULL_VOLUME_TILES) / (SILENT_TILES - FULL_VOLUME_TILES);
105: }
106: 
107: function rescan(map: ENUM_WORLD): void {
108:   flames = lighting.emitters(map).filter(s => s.alive && s.recipe.flicker);
109: }
110: 
111: /** Insert (d2, source) into the k-nearest scratch, keeping it sorted. */
112: function offer(d2: number, source: LightSource): void {
113:   if (sounding === MAX_SOURCES && d2 >= slotDist2[MAX_SOURCES - 1]) return;
114: 
115:   let i = Math.min(sounding, MAX_SOURCES - 1);
116:   while (i > 0 && slotDist2[i - 1] > d2) {
117:     slotDist2[i] = slotDist2[i - 1];
118:     slots[i].x = slots[i - 1].x;
119:     slots[i].z = slots[i - 1].z;
120:     i--;
121:   }
122:   slotDist2[i] = d2;
123:   slots[i].x = source.position.x;
124:   slots[i].z = source.position.z;
125:   if (sounding < MAX_SOURCES) sounding++;
126: }
127: 
128: function update(map: ENUM_WORLD, dt: number): void {
129:   if (!SoundsManager.pageInteracted) return;
130: 
131:   const hero = listenerHero();
132:   if (!hero) return;
133: 
134:   untilScan -= dt;
135:   if (untilScan <= 0) {
136:     untilScan = SCAN_SECONDS;
137:     rescan(map);
138:   }
139: 
140:   const hx = hero.transform.pos.x;
141:   const hz = hero.transform.pos.z;
142:   const silent2 = SILENT_TILES * SILENT_TILES;
143: 
144:   // The ambience slider at 0 leaves nothing sounding, so the pass below
145:   // stops every slot rather than looping them at silence.
146:   const gain = busGain(BUS);
147: 
148:   sounding = 0;
149:   for (const flame of gain > 0 ? flames : []) {
150:     if (!flame.alive) continue;
151:     const dx = flame.position.x - hx;
152:     const dz = flame.position.z - hz;
153:     const d2 = dx * dx + dz * dz;
154:     if (d2 >= silent2) continue;
155:     offer(d2, flame);
156:   }
157: 
158:   for (let i = 0; i < MAX_SOURCES; i++) {
159:     if (i < sounding) {
160:       const slot = slots[i];
161:       slot.volume = VOLUME * gain * gainAt(Math.sqrt(slotDist2[i]));
162: 
163:       const s = SoundsManager.loopInstance(CRACKLE, i);
164:       if (!s) continue;
165:       s.setVolume(slot.volume);
166:       if (!s.isPlaying) {
167:         s.setPlaybackRate(1 + (i / (MAX_SOURCES - 1) - 0.5) * 2 * RATE_SPREAD);
168:         s.play();
169:       }
170:     } else {
171:       slots[i].volume = 0;
172:       SoundsManager.stopLoopInstance(CRACKLE, i);
173:     }
174:   }
175: }
176: 
177: /** Leaving a map: the flames are gone, so is their sound. */
178: function reset(): void {
179:   for (let i = 0; i < MAX_SOURCES; i++) SoundsManager.stopLoopInstance(CRACKLE, i);
180:   flames = [];
181:   sounding = 0;
182:   untilScan = 0;
183: }
184: 
185: // ---- 3. the layer ----------------------------------------------------------
186: 
187: export const crackleLayer: SoundLayer = { name: 'crackle', update, reset };
</file>

