<file path="src/sound/drops.ts">
 1: import { GameOptions } from '../common/gameOptions';
 2: import { HIGH_DROP_LEVEL } from '../common/dropTier';
 3: import { isJewel, itemDef } from '../common/itemStats';
 4: import type { Item } from '../ecs/world';
 5: import { UI_SOUND_KEYS } from './ui';
 6: import { pickupSound } from './combat';
 7: import type { SoundBus } from './buses';
 8: import type { Sounds } from './recipes';
 9: import type { SoundLayer } from './layer';
10: import { playSfx, type SfxPosition } from './listener';
11: 
12: /**
13:  * The noise a drop makes landing: `CreateItem` / `CreateMoneyDrop`
14:  * (ZzzObject.cpp:5995-6002, :6198) - a jewel rings (SOUND_JEWEL01), a
15:  * Gemstone rings differently (SOUND_JEWEL02), zen jingles
16:  * (SOUND_DROP_GOLD01) and everything else thuds (SOUND_DROP_ITEM01).
17:  *
18:  * ...and, ours, which of those are worth hearing. On a busy hunting ground
19:  * the original's rule (every fresh drop sounds) is a continuous rattle of
20:  * 100-zen piles, so the rows can be narrowed to the drops the player is
21:  * actually there for. The vocabulary is the loot filter's
22:  * (`common/lootFilter.ts`): what is worth a name on the ground is what is
23:  * worth hearing land, and the two screens read as one idea.
24:  *
25:  * Driven by: `logic.ts` on `ItemsDropped` / `MoneyDroppedExtended` with
26:  * `IsFreshDrop` set. Command-only: no per-frame state.
27:  * Read by: nothing - it only plays.
28:  *
29:  * Picking an item up is not this: that is the player's own click and keeps
30:  * its interface chime (`ui.ts`) whatever the filter says.
31:  */
32: 
33: // ---- 1. tuning -------------------------------------------------------------
34: 
35: /** A drop landing is its own category (`sound/buses.ts`). */
36: const BUS: SoundBus = 'drops';
37: 
38: /** What `logic.ts` knows about a drop when the packet lands. */
39: export type DropSoundInfo = {
40:   isMoney: boolean;
41:   /** Parsed item, absent for zen and for a row the serializer could not read. */
42:   item?: Item;
43:   /** `ITEM_GROUP_*` and the index inside it, as sent. */
44:   group: number;
45:   num: number;
46: };
47: 
48: // ---- 2. selectors + commands -----------------------------------------------
49: 
50: /** The key a drop lands with, whatever the filter then decides. */
51: export function dropSound(drop: DropSoundInfo): Sounds {
52:   if (drop.isMoney || !drop.item) return UI_SOUND_KEYS.dropMoney;
53:   const kind = pickupSound(drop.item);
54:   return kind === 'getItem' ? UI_SOUND_KEYS.dropItem : UI_SOUND_KEYS[kind];
55: }
56: 
57: /**
58:  * Whether this drop is one the player asked to hear. Reads `GameOptions`, so
59:  * a box ticked in the Options window takes effect on the next drop.
60:  */
61: export function dropSoundAllowed(drop: DropSoundInfo): boolean {
62:   if (!GameOptions.dropSoundFilter) return true;
63: 
64:   if (drop.isMoney) return GameOptions.dropSoundZen;
65: 
66:   const item = drop.item;
67:   if (item) {
68:     if (GameOptions.dropSoundExcellent && item.isExcellent) return true;
69:     if (GameOptions.dropSoundAncient && item.isAncient) return true;
70:     if (GameOptions.dropSoundHighLevel && (item.lvl ?? 0) >= HIGH_DROP_LEVEL) {
71:       return true;
72:     }
73:   }
74: 
75:   if (GameOptions.dropSoundJewels) {
76:     const def = itemDef(drop.group, drop.num);
77:     if (def && isJewel(def)) return true;
78:   }
79: 
80:   return GameOptions.dropSoundOther;
81: }
82: 
83: /** A fresh drop landing at `at`, filter and slider applied. */
84: export function playDrop(drop: DropSoundInfo, at?: SfxPosition | null): void {
85:   if (!dropSoundAllowed(drop)) return;
86:   playSfx(dropSound(drop), at, { bus: BUS });
87: }
88: 
89: // ---- 3. the layer ----------------------------------------------------------
90: 
91: export const dropsLayer: SoundLayer = { name: 'drops' };
</file>

<file path="src/sound/footsteps.ts">
  1: import { ENUM_WORLD } from '../common/types';
  2: import { PlayerAction } from '../common/objects/enum';
  3: import { Rand } from '../common/rand';
  4: import { KALIMA_WORLDS, onWorlds } from '../common/worldAssets';
  5: import { SoundsManager } from '../libs/soundsManager';
  6: import { busGain, type SoundBus } from './buses';
  7: import type { Sounds } from './recipes';
  8: import type { SoundLayer } from './layer';
  9: import { listenerHero, listenerWorld } from './listener';
 10: 
 11: /**
 12:  * The hero's footsteps: `PlayWalkSound` picked by map + tile under the foot
 13:  * (soil, grass, snow, swim), fired at the two foot-down frames of every walk
 14:  * / run clip.
 15:  *
 16:  * Driven by: the hero's current animation frame each frame.
 17:  * Read by: nothing - it only plays.
 18:  */
 19: 
 20: // ---- 1. tuning -------------------------------------------------------------
 21: 
 22: /** The hero's own stride, its own category (`sound/buses.ts`). */
 23: const BUS: SoundBus = 'steps';
 24: 
 25: /** Clip frames at which the left / right foot lands. */
 26: const FOOT_DOWN_FRAMES: readonly [number, number] = [1.0, 9.0];
 27: 
 28: /** Pitch jitter so a run does not sound like a loop. */
 29: const PITCH_MIN = 0.95;
 30: const PITCH_MAX = 1.05;
 31: 
 32: /** Devias tiles that are *not* snow (interior floor): 3 and 10+. */
 33: const DEVIAS_SNOW = (tile: number) => tile !== 3 && tile < 10;
 34: /** Grass tile on the outdoor maps. */
 35: const GRASS_TILE = 0;
 36: const onGrass = (tile: number) => tile === GRASS_TILE;
 37: 
 38: /**
 39:  * One `PlayWalkSound` branch: the step a world plays when `on` (the tile
 40:  * under the hero) and `outsideSafeZone` (the swim rule) both hold. The
 41:  * first matching row wins; no row falls through to `DEFAULT_STEP`.
 42:  */
 43: type StepRule = {
 44:   readonly sound: Sounds;
 45:   /** Tile predicate; omit for every tile. */
 46:   readonly on?: (tile: number) => boolean;
 47:   /** `!inSafeZone`: swimming only outside the dock. */
 48:   readonly outsideSafeZone?: boolean;
 49: };
 50: 
 51: const SNOW: StepRule = { sound: 'Sound/pWalk(Snow)' };
 52: const GRASS: StepRule = { sound: 'Sound/pWalk(Grass)', on: onGrass };
 53: const SWIM: StepRule = { sound: 'Sound/pSwim', outsideSafeZone: true };
 54: 
 55: /** `PlayWalkSound`'s `else` branch. */
 56: const DEFAULT_STEP: Sounds = 'Sound/pWalk(Soil)';
 57: 
 58: /** `PlayWalkSound` (ZzzCharacter.cpp), one row per world it tests. */
 59: const STEP_BY_WORLD: Partial<Record<ENUM_WORLD, readonly StepRule[]>> = {
 60:   // `HeroTile != 3 && HeroTile < 10`: the interior floors are boards.
 61:   [ENUM_WORLD.WD_2DEVIAS]: [{ ...SNOW, on: DEVIAS_SNOW }],
 62:   [ENUM_WORLD.WD_0LORENCIA]: [GRASS],
 63:   [ENUM_WORLD.WD_3NORIA]: [GRASS],
 64:   // Atlans, the Kalima floors and Doppelganger 3 are underwater / awash:
 65:   // `SOUND_HUMAN_SWIM` wherever the hero is not in the safe zone.
 66:   [ENUM_WORLD.WD_7ATLANSE]: [SWIM],
 67:   ...onWorlds(KALIMA_WORLDS, [SWIM] as readonly StepRule[]),
 68:   [ENUM_WORLD.WD_67DOPPLEGANGER3]: [SWIM],
 69:   // `else if (isIceCity) PlayBuffer(SOUND_HUMAN_WALK_SNOW)`, and the same
 70:   // for Santa Town: snow on every tile.
 71:   [ENUM_WORLD.WD_57ICECITY]: [SNOW],
 72:   [ENUM_WORLD.WD_58ICECITY_BOSS]: [SNOW],
 73:   [ENUM_WORLD.WD_62SANTA_TOWN]: [SNOW],
 74: };
 75: 
 76: // ---- 2. state + readers ----------------------------------------------------
 77: 
 78: let foot0 = false;
 79: let foot1 = false;
 80: let lastCurrentFrame = 0;
 81: 
 82: /** `PlayWalkSound`: the step for the tile under the hero right now. */
 83: export function footstepSound(): Sounds | null {
 84:   const world = listenerWorld();
 85:   const hero = listenerHero();
 86:   if (!world || !hero) return null;
 87: 
 88:   // `if (o->CurrentAction == PLAYER_FLY || PLAYER_FLY_CROSSBOW) {}` - the
 89:   // original guards on the clip, not on a flying flag, so a winged
 90:   // character still lands a footstep when it walks in a safe zone.
 91:   const action = hero.playerAnimation?.action;
 92:   if (
 93:     action === PlayerAction.PLAYER_FLY ||
 94:     action === PlayerAction.PLAYER_FLY_CROSSBOW
 95:   ) {
 96:     return null;
 97:   }
 98: 
 99:   const map = hero.worldIndex ?? ENUM_WORLD.WD_0LORENCIA;
100:   const rules = STEP_BY_WORLD[map];
101:   if (!rules) return DEFAULT_STEP;
102: 
103:   const heroTile = world.getTerrainTile(
104:     ~~hero.transform.pos.x,
105:     ~~hero.transform.pos.z
106:   );
107:   const inSafeZone = hero.attributeSystem.isAboveZero('inSafeZone');
108: 
109:   for (const rule of rules) {
110:     if (rule.on && !rule.on(heroTile)) continue;
111:     if (rule.outsideSafeZone && inSafeZone) continue;
112:     return rule.sound;
113:   }
114:   return DEFAULT_STEP;
115: }
116: 
117: /** Play one footstep for the tile under the hero. */
118: export function playFootstep(): void {
119:   // Not through `playSfx`: a footstep is never attenuated (it is under the
120:   // listener) and it needs the per-play pitch below, which `playSfx` throttle
121:   // aside has no way to carry.
122:   const gain = busGain(BUS);
123:   if (gain <= 0) return;
124: 
125:   const sfx = footstepSound();
126:   if (!sfx) return;
127:   const sound = SoundsManager.loadAndPlaySoundEffect(sfx);
128:   if (!sound) return;
129:   sound.setVolume(gain);
130:   sound.setPlaybackRate(Rand.nextFloat(PITCH_MIN, PITCH_MAX));
131: }
132: 
133: function isWalkClip(playerAction: PlayerAction): boolean {
134:   return (
135:     (playerAction >= PlayerAction.PLAYER_WALK_MALE &&
136:       playerAction <= PlayerAction.PLAYER_RUN_RIDE_WEAPON) ||
137:     playerAction == PlayerAction.PLAYER_WALK_TWO_HAND_SWORD_TWO ||
138:     playerAction == PlayerAction.PLAYER_RUN_TWO_HAND_SWORD_TWO ||
139:     playerAction == PlayerAction.PLAYER_RUN_RIDE_HORSE ||
140:     playerAction == PlayerAction.PLAYER_RAGE_UNI_RUN ||
141:     playerAction == PlayerAction.PLAYER_RAGE_UNI_RUN_ONE_RIGHT
142:   );
143: }
144: 
145: function update(_map: ENUM_WORLD, _dt: number): void {
146:   const hero = listenerHero();
147:   if (!hero) return;
148: 
149:   const modelObject = hero.modelObject;
150:   if (!modelObject) return;
151: 
152:   const animationGroups = modelObject.gltf?.animationGroups;
153:   if (!animationGroups) return;
154: 
155:   const playerAction = hero.playerAnimation.action;
156: 
157:   const animationGroup = animationGroups[playerAction];
158:   if (!animationGroup) return;
159: 
160:   const animatable = animationGroup.animatables[0];
161:   if (!animatable) return;
162: 
163:   const anim = animatable.getAnimations()[0];
164:   if (!anim) return;
165: 
166:   const currentFrame = anim.currentFrame;
167: 
168:   if (!isWalkClip(playerAction)) {
169:     foot0 = false;
170:     foot1 = false;
171:     lastCurrentFrame = 0;
172:     return;
173:   }
174: 
175:   if (currentFrame < lastCurrentFrame) {
176:     foot0 = false;
177:     foot1 = false;
178:   }
179: 
180:   lastCurrentFrame = currentFrame;
181:   if (currentFrame >= FOOT_DOWN_FRAMES[0] && !foot0) {
182:     foot0 = true;
183:     playFootstep();
184:   }
185:   if (currentFrame >= FOOT_DOWN_FRAMES[1] && !foot1) {
186:     foot1 = true;
187:     playFootstep();
188:   }
189: }
190: 
191: function reset(): void {
192:   foot0 = false;
193:   foot1 = false;
194:   lastCurrentFrame = 0;
195: }
196: 
197: // ---- 3. the layer ----------------------------------------------------------
198: 
199: export const footstepsLayer: SoundLayer = { name: 'footsteps', update, reset };
</file>

