2621:   consumeItemRequest(slot: number, targetSlot = 0): void {
2622:     if (this.isOffline) {
2623:       this.consumeItemOffline(slot);
2624:       return;
2625:     }
2626: 
2627:     // OpenMU refuses any consume unless PlayerState == EnteredWorld: a merchant
2628:     // window still open makes a scroll / potion fail with a bare
2629:     // ItemConsumptionFailed. The original closes the shop on the use click.
2630:     if (this.npcShop) this.closeNpcShop();
2631: 
2632:     const now = Date.now();
2633:     if (now < this.consumeBlockedUntil) return;
2634:     this.consumeBlockedUntil = now + 300;
2635: 
