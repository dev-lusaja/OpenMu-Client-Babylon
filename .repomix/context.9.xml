 597: /**
 598:  * `?offline&class=elf` / `?class=20`: the offline test character's class, by
 599:  * `CharacterClassNumber` value or name prefix (`fairy` → FairyElf,
 600:  * `rage` → RageFighter). A screenshot-harness seam like `?map=`; null when
 601:  * absent or unknown (Dark Knight).
 602:  */
 603: function offlineClassFromUrl(): CharacterClassNumber | null {
 604:   let raw: string | null = null;
 605:   try {
 606:     raw = new URLSearchParams(location.search).get('class');
 607:   } catch {
 608:     raw = null;
 609:   }
 610:   if (!raw) return null;
 611: 
 612:   if (/^\d+$/.test(raw)) {
 613:     const n = Number(raw) as CharacterClassNumber;
 614:     return CharacterClassNumber[n] !== undefined ? n : null;
 615:   }
 616: 
 617:   const want = raw.toLowerCase();
 618:   for (const key of Object.keys(CharacterClassNumber)) {
 619:     if (/^\d+$/.test(key)) continue;
 620:     if (key.toLowerCase().startsWith(want)) {
 621:       return CharacterClassNumber[key as keyof typeof CharacterClassNumber];
 622:     }
 623:   }
 624:   return null;
 625: }
