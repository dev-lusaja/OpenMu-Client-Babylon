<file path="src/sound/_template.ts">
 1: /**
 2:  * TEMPLATE - copy this file to `<name>.ts`, fill in the blanks, add the layer
 3:  * to `layers.ts`. Never imported; it only exists to be copied.
 4:  *
 5:  * Every sound entry has the same three parts, in this order:
 6:  *
 7:  *   1. Tuning constants / data tables at the top, each with a comment saying
 8:  *      what it is in real units (seconds, 0…1 of the track, tiles) and why.
 9:  *   2. Module state + the readers / commands over it. State lives here, not
10:  *      in the facade. A looping entry (a bed, the music) has an `update`; a
11:  *      one-shot entry (a click, a swing) is command-only.
12:  *   3. The exported `SoundLayer` at the bottom, wiring `update` / `reset`.
13:  *
14:  * Everything audible goes through the mixer, `libs/soundsManager.ts`:
15:  * `playAmbientLoop` / `stopAmbientLoop` for beds, `playMusic` for tracks,
16:  * and `playSfx` (this folder's `listener.ts`) for positioned one-shots.
17:  */
18: import { ENUM_WORLD } from '../common/types';
19: import { SoundsManager } from '../libs/soundsManager';
20: import type { Sounds } from './recipes';
21: import type { SoundLayer } from './layer';
22: 
23: // ---- 1. tuning -------------------------------------------------------------
24: 
25: /** The bed this entry loops. */
26: const BED: Sounds = 'Sound/aWind';
27: 
28: /** Share of the effects track the bed sits at - under the SFX, never on top. */
29: const VOLUME = 0.35;
30: 
31: /** Maps this exists on. */
32: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([ENUM_WORLD.WD_0LORENCIA]);
33: 
34: // ---- 2. state + readers ----------------------------------------------------
35: 
36: let playing = false;
37: 
38: /** Whether the bed is sounding right now. */
39: export function templatePlaying(): boolean {
40:   return playing;
41: }
42: 
43: function update(map: ENUM_WORLD, _dt: number): void {
44:   // Replace with whatever drives this entry: a tile, a packet, a schedule.
45:   const wanted = MAPS.has(map) && SoundsManager.pageInteracted;
46: 
47:   if (wanted) SoundsManager.playAmbientLoop(BED, VOLUME);
48:   else if (playing) SoundsManager.stopAmbientLoop(BED);
49: 
50:   playing = wanted;
51: }
52: 
53: function reset(): void {
54:   if (playing) SoundsManager.stopAmbientLoop(BED);
55:   playing = false;
56: }
57: 
58: // ---- 3. the layer ----------------------------------------------------------
59: 
60: export const templateLayer: SoundLayer = {
61:   name: 'template',
62:   maps: MAPS,
63:   update,
64:   reset,
65: };
</file>

