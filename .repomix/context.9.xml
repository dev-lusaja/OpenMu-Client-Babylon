 91:  * music, the footsteps, the clicks, the swings, the monster voices - behind
 92:  * one object. Copy `_template.ts` when adding to it.
 93:  *
 94:  * The game talks to `sound.update` once a frame
 95:  * (`ecs/systems/soundSystem.ts`) and `sound.reset` on a map change
 96:  * (`libs/mu/loadMapIntoScene.ts`); both fan out over `SOUND_LAYERS`
 97:  * (`layers.ts`), the only list of entries. Playback itself is the mixer's
 98:  * (`libs/soundsManager.ts`: the Babylon tracks and buffers); entries decide
 99:  * *what* plays and command the mixer. The facade holds no state.
100:  */
101: class Sound {
102:   private readonly layers: SoundLayer[] = [...SOUND_LAYERS];
103: 
104:   /** Add an entry at runtime (tools, experiments). Returns the unregister. */
105:   register(layer: SoundLayer): () => void {
106:     this.layers.push(layer);
107:     return () => {
108:       const i = this.layers.indexOf(layer);
109:       if (i >= 0) this.layers.splice(i, 1);
110:     };
111:   }
112: 
113:   /** Every entry that exists on this map. */
114:   layersFor(map: ENUM_WORLD): SoundLayer[] {
115:     return this.layers.filter(l => !l.maps || l.maps.has(map));
116:   }
117: 
118:   /**
119:    * Boot the mixer on the scene (Babylon tracks + the audio-unlock gesture)
120:    * at the sliders' levels, and follow them from then on.
121:    *
122:    * Only the two track gains are pushed here. The categories under `effects`
123:    * are read per play (`buses.ts`), so a slider move reaches the one-shots
124:    * and the loops without anything being pushed at all.
125:    */
126:   init(scene: Scene): void {
127:     const boot = trackGains();
128:     SoundsManager.initializeSounds(scene, boot.music, boot.effects);
129: 
130:     let music = boot.music;
131:     let effects = boot.effects;
132: 
133:     onGameOptionsChanged(() => {
134:       const next = trackGains();
135:       if (next.music !== music || next.effects !== effects) {
136:         music = next.music;
137:         effects = next.effects;
138:         SoundsManager.setTrackGains(music, effects);
139:       }
140:     });
141: 
142:     EventBus.on('pageVisibilityChanged', visible => {
143:       SoundsManager.setBackgrounded(!visible && GameOptions.muteInBackground);
144:     });
145:   }
146: 
147:   /** Attach the ECS world the listener lives in. Once, from `soundSystem`. */
148:   attach(world: World): void {
149:     attachListener(world);
150:   }
151: 
152:   /** Step every entry. Call once a frame, after movement. */
153:   update(map: ENUM_WORLD, dt: number): void {
154:     for (const layer of this.layers) layer.update?.(map, dt);
155:   }
156: 
157:   /**
158:    * Stop what belongs to the map just left, and drop the decoded effects no
159:    * map has asked for lately. Call when the map changes.
160:    */
161:   reset(): void {
162:     for (const layer of this.layers) layer.reset?.();
163:     SoundsManager.evictStale();
164:   }
165: 
166:   // ---- readers -----------------------------------------------------------
167: 
168:   /** Whether the browser has unlocked audio (first gesture seen). */
169:   get unlocked(): boolean {
170:     return SoundsManager.pageInteracted;
171:   }
172: 
173:   /** The music track playing, or null. */
174:   get currentMusic(): Sounds | null {
175:     return currentMusic();
176:   }
177: 
178:   /** Music track gain, 0…1, master folded in. */
179:   get musicVolume(): number {
180:     return SoundsManager.musicVolume;
181:   }
182: 
183:   /**
184:    * Effects track gain, 0…1, master folded in. Beds, footsteps and one-shots
185:    * all sit on it, each scaled again by its own category (`buses.ts`).
186:    */
187:   get effectsVolume(): number {
188:     return SoundsManager.effectsVolume;
189:   }
190: 
191:   /** One category's share of the effects track, 0…1 (`buses.ts`). */
192:   busVolume(bus: SoundBus): number {
193:     return busGain(bus);
194:   }
195: 
196:   /** Whether a buffer is currently sounding. */
197:   isPlaying(key: Sounds): boolean {
198:     return SoundsManager.isPlaying(key);
199:   }
200: 
201:   /** Whether a buffer is sounding *and* set to loop (music, beds). */
202:   isLooping(key: Sounds): boolean {
203:     return SoundsManager.isLooping(key);
204:   }
205: 
206:   /** Terrain tile under the hero, -1 without one. */
207:   get heroTile(): number {
208:     return listenerTile();
209:   }
210: 
211:   /** The fires crackling right now: the nearest flames, with their volumes. */
212:   get crackling(): readonly CrackleSource[] {
213:     return crackleSources();
214:   }
215: 
216:   /** The map-object loops sounding right now: the nearest brooks, gears, gates… */
217:   get objectLoops(): readonly ObjectLoopSource[] {
218:     return objectLoopSources();
219:   }
220: 
221:   // ---- commands ----------------------------------------------------------
222: 
223:   /** An interface sound (click, error, window, pickup…). */
224:   playUi(kind: UiSound): void {
225:     playUiSound(kind);
226:   }
227: 
228:   /**
229:    * Any catalogue sound once; `at` (tiles) attenuates it by distance to the
230:    * hero. `bus` names the mixer category, `world` by default - the slider a
231:    * map door or a firework rides.
232:    */
233:   play(key: Sounds, at?: SfxPosition | null, bus?: SoundBus): void {
234:     playSfx(key, at, { bus });
235:   }
236: 
237:   /** A skill's cast sound at its caster. */
238:   playSkill(skill: number, at?: SfxPosition | null): void {
239:     playSkill(skill, at);
240:   }
241: 
242:   /** An already-selected combat sound (swing, hit, scream) at a position. */
243:   playCombat(key: Sounds | null, at?: SfxPosition | null): void {
244:     playCombat(key, at);
245:   }
246: 
247:   /** A monster's voice by model type and moment (idle / attack / death). */
248:   playMonster(
249:     modelType: number,
250:     voice: MonsterVoice,
251:     at?: SfxPosition | null
252:   ): void {
253:     playMonster(modelType, voice, at);
254:   }
255: 
256:   /** Start a music track; the previous one stops. */
257:   playMusic(key: Sounds): void {
258:     playMusic(key);
259:   }
260: 
261:   /** Stop the music. */
262:   stopMusic(): void {
263:     stopMusic();
264:   }
265: 
266:   /** Stop one buffer (a bed, a track, a loop). */
267:   stop(key: Sounds): void {
268:     SoundsManager.stopSoundEffect(key);
269:   }
270: 
271:   /** Pin the listener (hero position, tiles). */
272:   setListener(x: number, z: number): void {
273:     setSfxListener(x, z);
274:   }
275: 
276:   /** Forget the listener: positioned sounds play at full volume. */
277:   clearListener(): void {
278:     clearSfxListener();
279:   }
280: }
