<file path="src/sound/layer.ts">
 1: import type { ENUM_WORLD } from '../common/types';
 2: 
 3: /**
 4:  * The contract every sound entry implements: one file per entry, one
 5:  * exported `SoundLayer` per file, listed once in `layers.ts`. Copy `_template.ts` for the recipe.
 6:  *
 7:  * Entries own *what* is heard - which bed plays under a map, which track,
 8:  * which footstep, which swing - and command the mixer
 9:  * (`libs/soundsManager.ts`) to play it. The layer is only the *lifecycle*:
10:  * beds and music step every frame; one-shot entries (ui, combat, monsters)
11:  * are command-only and may have neither `update` nor `reset`.
12:  */
13: export interface SoundLayer {
14:   /** Unique camelCase, identical to the file name. */
15:   readonly name: string;
16: 
17:   /** Maps this entry exists on. Omit for every map. */
18:   readonly maps?: ReadonlySet<ENUM_WORLD>;
19: 
20:   /**
21:    * Stepped once a frame, in `layers.ts` order, after movement (the beds are
22:    * muted by the tile under the hero's feet). `dt` is seconds. Must be cheap:
23:    * no allocation, no scene walk.
24:    */
25:   update?(map: ENUM_WORLD, dt: number): void;
26: 
27:   /** The map changed: stop what belongs to the world just left. */
28:   reset?(): void;
29: }
</file>

