 62: /** A NPC the table has no page for (OpenMU opens the dialogue for every `NpcDialog` NPC). */
 63: const TEXT_DEFAULT_WORDS: TextKey = 'quest.dialogue.words';
 64: const TEXT_DEFAULT_QUEST: TextKey = 'quest.dialogue.accept';
 65: 
 66: /** The Gens stewards (543 Duprian, 544 Vanert): the only NPCs that show contribution. */
 67: const GENS_NPCS: ReadonlySet<number> = new Set([543, 544]);
 68: 
 69: /** `ProcessSelTextResult` request codes. */
 70: const RESULT = {
 71:   questList: 901,
 72:   buff: 902,
 73:   joinDuprian: 903,
 74:   joinVanert: 904,
 75:   leaveGens: 905,
 76:   rewardDuprian: 906,
 77:   rewardVanert: 907,
 78: } as const;
 79: 
 80: // ---- 2. state + readers ----------------------------------------------------
 81: 
 82: /** One clickable line of the lower half (`m_aszSelTexts` + its result). */
 83: export type NpcDialogueAnswer = {
 84:   text: string;
 85:   /** Page or request code; in list mode the quest key, or -1 for "Go back". */
 86:   result: number;
 87: };
 88: 
 89: const state = observable({
 90:   open: false,
 91:   /** `g_QuestMng.m_nNPCIndex`. */
 92:   npcNumber: 0,
 93:   /** `m_dwCurDlgIndex`. */
 94:   page: 0,
 95:   /** `m_aszNPCWords`, unwrapped: the window wraps to its width. */
 96:   npcLines: [] as string[],
 97:   answers: [] as NpcDialogueAnswer[],
 98:   /** `m_bQuestListMode`: the lower half lists the NPC's quests. */
 99:   questListMode: false,
100:   /** `m_dwContributePoint` (Gens stewards only). */
101:   contribution: 0,
102:   /** `m_bCanClick`: false while a request is out. */
103:   busy: false,
104: });
105: 
106: export function npcDialogueOpen(): boolean {
107:   return state.open;
108: }
109: 
110: export function npcDialogueNpcNumber(): number {
111:   return state.npcNumber;
112: }
113: 
114: /** `g_QuestMng.GetNPCName()`. */
115: export function npcDialogueNpcName(): string {
116:   return monsterDisplayName(state.npcNumber, `NPC ${state.npcNumber}`);
117: }
118: 
119: export function npcDialogueLines(): readonly string[] {
120:   return state.npcLines;
121: }
122: 
123: export function npcDialogueAnswers(): readonly NpcDialogueAnswer[] {
124:   return state.answers;
125: }
126: 
127: export function npcDialogueBusy(): boolean {
128:   return state.busy;
129: }
130: 
131: export function npcDialogueQuestListMode(): boolean {
132:   return state.questListMode;
133: }
134: 
135: /** Gens contribution to draw under the name; null unless a steward. */
136: export function npcDialogueContribution(): number | null {
137:   return GENS_NPCS.has(state.npcNumber) ? state.contribution : null;
138: }
139: 
140: // ---- commands ----------------------------------------------------------------
141: 
142: function send(buffer: DataView): boolean {
143:   if (Store.isOffline) return false;
144:   Store.sendToGS(buffer);
145:   return true;
146: }
147: 
148: /** `SetContents(page)`: the page's words and answers. */
149: function setContents(page: number): void {
150:   const entry = npcDialogueEntry(state.npcNumber, page);
151:   const lines = entry ? questWordLines(entry.npcWords) : [];
152:   const answers: NpcDialogueAnswer[] = entry
153:     ? entry.answers.map((a, i) => ({ text: `${i + 1}. ${questWords(a.words) ?? ''}`, result: a.result }))
154:     : [];
155: 
156:   runInAction(() => {
157:     state.page = page;
158:     state.questListMode = false;
159:     state.busy = false;
160:     if (entry) {
161:       state.npcLines = lines;
162:       state.answers = answers;
163:     } else {
164:       // No page for this NPC in the table: the one thing OpenMU can answer.
165:       state.npcLines = [t(TEXT_DEFAULT_WORDS)];
166:       state.answers = [
167:         { text: `1. ${t(TEXT_DEFAULT_QUEST)}`, result: RESULT.questList },
168:       ];
169:     }
170:   });
171: }
172: 
173: /**
174:  * Same reason as `legacyQuests.ts`: the page is copied out of the tables, and
175:  * a language change fetches new ones. Redraw the open page from them.
176:  */
177: reaction(
178:   () => questDataReady(),
179:   ready => {
180:     if (ready && state.open && !state.questListMode) setContents(state.page);
181:   }
182: );
183: 
184: /**
185:  * `ReceiveNPCDlgUIStart` → `Show(INTERFACE_NPC_DIALOGUE)` → `ProcessOpening`:
186:  * page 0 of this NPC. A second `OpenNpcDialog` while open is ignored.
187:  */
188: export function openNpcDialogue(npcNumber: number, contribution = 0): void {
189:   if (state.open) return;
190:   runInAction(() => {
191:     state.npcNumber = npcNumber;
192:     state.contribution = contribution;
193:     state.open = true;
194:   });
195:   setContents(0);
196:   playUiSound('window');
197: }
198: 
199: /** `ProcessClosing`: hide, tell the server (`SendCloseNpcRequest`). */
200: export function closeNpcDialogue(): void {
201:   if (!state.open) return;
202:   runInAction(() => {
203:     state.open = false;
204:     state.questListMode = false;
205:     state.busy = false;
206:     state.contribution = 0;
207:   });
208:   send(CloseNpcRequestPacket.createPacket().buffer);
209:   Store.dropNpcTalk();
210:   playUiSound('click');
211: }
212: 
213: /** Hide without the close request: another NPC window took the talk over. */
214: function hideNpcDialogue(): void {
215:   if (!state.open) return;
216:   runInAction(() => {
217:     state.open = false;
218:     state.questListMode = false;
219:     state.busy = false;
220:   });
221: }
222: 
223: function sendBusy(packet: DataView): void {
224:   if (send(packet)) {
225:     runInAction(() => {
226:       state.busy = true;
227:     });
228:   }
229: }
230: 
231: /** `ProcessSelTextResult`: the hero clicked answer `index`. */
232: export function answerNpcDialogue(index: number): void {
233:   if (!state.open || state.busy) return;
234:   const answer = state.answers[index];
235:   if (!answer) return;
236:   playUiSound('click');
237: 
238:   if (state.questListMode) {
239:     if (answer.result < 0) {
240:       setContents(0);
241:       return;
242:     }
243:     runInAction(() => {
244:       state.busy = true;
245:     });
246:     selectQuest(answer.result >>> 16, answer.result & 0xffff);
247:     return;
248:   }
249: 
250:   const result = answer.result;
251:   if (result <= LAST_PAGE_RESULT) {
252:     setContents(result);
253:     return;
254:   }
255:   switch (result) {
256:     case RESULT.questList:
257:       sendBusy(AvailableQuestsRequestPacket.createPacket().buffer);
258:       break;
259:     case RESULT.buff:
260:       send(NpcBuffRequestPacket.createPacket().buffer);
261:       closeNpcDialogue();
262:       break;
263:     case RESULT.joinDuprian:
264:     case RESULT.joinVanert: {
265:       const packet = GensJoinRequestPacket.createPacket();
266:       packet.GensType = result === RESULT.joinDuprian ? GensTypeEnum.Duprian : GensTypeEnum.Vanert;
267:       sendBusy(packet.buffer);
268:       break;
269:     }
270:     case RESULT.leaveGens:
271:       sendBusy(GensLeaveRequestPacket.createPacket().buffer);
272:       break;
273:     case RESULT.rewardDuprian:
274:     case RESULT.rewardVanert: {
275:       const packet = GensRewardRequestPacket.createPacket();
276:       packet.GensType = result === RESULT.rewardDuprian ? GensTypeEnum.Duprian : GensTypeEnum.Vanert;
277:       sendBusy(packet.buffer);
278:       break;
279:     }
280:     default:
281:       setContents(ERROR_PAGE);
282:   }
283: }
284: 
285: // ---- packet → state ----------------------------------------------------------
286: 
287: /**
288:  * `ProcessQuestListReceive`: while the dialogue is up the NPC's list goes
289:  * into it - words 1501 / 1502 above, "[Q]subject" lines and "Go back." below.
290:  */
291: EventBus.on('AvailableQuests', packet => {
292:   if (!state.open) return;
293:   const p = new AvailableQuestsPacket(packet);
294:   const quests = p.getQuests().slice(0, MAX_QUEST_LIST);
295:   const answers: NpcDialogueAnswer[] = quests.map((q, i) => {
296:     const key = questKey(q.Number, q.Group);
297:     return { text: `${i + 1}. [Q]${questSubject(key)}`, result: key };
298:   });
299:   answers.push({
300:     text: `${answers.length + 1}. ${questWords(WORDS_GO_BACK) ?? t(TEXT_GO_BACK)}`,
301:     result: -1,
302:   });
303:   const words =
304:     quests.length > 0
305:       ? (questWords(WORDS_SELECT_QUEST) ?? t(TEXT_SELECT_QUEST))
306:       : (questWords(WORDS_NO_QUEST) ?? t(TEXT_NO_QUEST));
307: 
308:   runInAction(() => {
309:     state.questListMode = true;
310:     state.npcLines = [words];
311:     state.answers = answers;
312:     state.busy = false;
313:   });
314: });
315: 
316: // The step / progress windows replace the dialogue (`CNewUISystem` shows one
317: // NPC interface at a time); a refused step (group 0xFF) just re-enables the list.
318: EventBus.on('QuestStepInfo', packet => {
319:   const p = new QuestStepInfoPacket(packet);
320:   if (p.QuestGroup === STEP_GROUP_UNAVAILABLE) {
321:     runInAction(() => {
322:       state.busy = false;
323:     });
324:     return;
325:   }
326:   hideNpcDialogue();
327: });
328: EventBus.on('QuestProgress', hideNpcDialogue);
329: EventBus.on('CharacterInformation', hideNpcDialogue);
330: 
331: function reset(): void {
332:   hideNpcDialogue();
333: }
334: 
335: function update(_map: ENUM_WORLD, _dt: number): void {
336:   // Pages resolve from the tables on demand; nothing ticks here.
337: }
338: 
339: // ---- 3. the layer ----------------------------------------------------------
340: 
341: export const npcDialogueLayer: QuestLayer = { name: 'npcDialogue', update, reset };
</file>

