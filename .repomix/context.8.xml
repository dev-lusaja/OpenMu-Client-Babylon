 12: import { devQueryNumber } from '../common/devSeams';
 13: import type { LightingTier } from '../common/lightingQuality';
 14: import type { Rgb } from '../lighting/profiles';
 15: 
 16: /**
 17:  * Sun rays (sky_atmospherics ARCHITECTURE §5): sole owner of the shaft
 18:  * post-process, between the haze and the post chain.
 19:  *
 20:  * The occluder mask is free. The G-buffer holds no blend mesh and no sky
 21:  * dome, so `depth == 0` is exactly "sky", which is the same fact the haze
 22:  * already leans on; everything solid between the camera and the sun is
 23:  * therefore an occluder with no second render of anything. The shafts are N
 24:  * radial taps of that mask toward the sun's screen position, added to the
 25:  * scene before the tone curve because they are scene light, not decoration.
 26:  *
 27:  * Dev seam: `?shafts=<weight>` replaces the option (0 = no pass).
 28:  */
 29: 
 30: const SHADER = 'muSunShafts';
 31: 
 32: /** Taps per tier index; Ultra doubles the count, nothing else changes. */
 33: const TAPS: readonly number[] = [0, 12, 24];
 34: 
 35: /** How much of the way to the sun the taps cover, and their falloff. */
 36: const DENSITY = 0.75;
 37: const DECAY = 0.94;
 38: 
 39: /** Weight at the top slider notch. */
 40: const MAX_WEIGHT = 0.55;
 41: 
 42: const SLIDER_MAX = 9;
 43: 
 44: /**
 45:  * How far outside the frame the sun may sit and still throw shafts. Past this
 46:  * the weight is zero; the falloff is what keeps a shaft from snapping on as
 47:  * the camera turns.
 48:  */
 49: const OFF_SCREEN_REACH = 1.1;
 50: 
 51: const shaftsDev = devQueryNumber('shafts');
 52: 
 53: type Runtime = {
 54:   scene: Scene;
 55:   camera: ArcRotateCamera;
 56:   taps: number;
 57:   pass: PostProcess;
 58: };
 59: 
 60: let runtime: Runtime | null = null;
 61: 
 62: const shown = {
 63:   /** Sun position in UV, and the weight after the off-screen falloff. */
 64:   u: 0.5,
 65:   v: 0.5,
 66:   weight: 0,
 67:   color: [1, 1, 1] as [number, number, number],
 68: };
 69: 
 70: function registerShader(taps: number): void {
 71:   const name = `${SHADER}${taps}`;
 72: 
 73:   if (ShaderStore.ShadersStore[`${name}FragmentShader`]) return;
 74: 
 75:   ShaderStore.ShadersStore[`${name}FragmentShader`] = `
 76:   precision highp float;
 77:   varying vec2 vUV;
 78:   uniform sampler2D textureSampler;
 79:   uniform sampler2D depthSampler;
 80:   uniform vec3 sunScreen;   // u, v, weight
 81:   uniform vec3 sunColor;
 82: 
 83:   const int TAPS = ${taps};
 84:   const float DENSITY = ${DENSITY.toFixed(3)};
 85:   const float DECAY = ${DECAY.toFixed(3)};
 86: 
 87:   void main(void) {
 88:     vec4 color = texture2D(textureSampler, vUV);
 89: 
 90:     if (sunScreen.z <= 0.0) {
 91:       gl_FragColor = color;
 92:       return;
 93:     }
 94: 
 95:     vec2 march = (vUV - sunScreen.xy) * (DENSITY / float(TAPS));
 96:     vec2 uv = vUV;
 97:     float weight = 1.0;
 98:     vec3 sum = vec3(0.0);
 99:     float total = 0.0;
100: 
101:     for (int i = 0; i < TAPS; i++) {
102:       uv -= march;
103: 
104:       // Outside the frame there is nothing sampled and nothing to add; the
105:       // clamped read would smear the frame edge along the shaft instead.
106:       float inside = step(0.0, uv.x) * step(uv.x, 1.0)
107:         * step(0.0, uv.y) * step(uv.y, 1.0);
108: 
109:       // Sky is depth 0, and sky is the only thing a shaft comes out of.
110:       float sky = 1.0 - step(1e-6, texture2D(depthSampler, uv).r);
111: 
112:       sum += texture2D(textureSampler, uv).rgb * sky * weight * inside;
113:       total += weight;
114:       weight *= DECAY;
115:     }
116: 
117:     gl_FragColor = vec4(
118:       color.rgb + sum / max(total, 1e-4) * sunColor * sunScreen.z,
119:       color.a
120:     );
121:   }
122:   `;
123: }
124: 
125: function createPass(
126:   scene: Scene,
127:   camera: ArcRotateCamera,
128:   taps: number
129: ): PostProcess {
130:   registerShader(taps);
131: 
132:   const pass = new PostProcess(
133:     'sunShafts',
134:     `${SHADER}${taps}`,
135:     ['sunScreen', 'sunColor'],
136:     ['depthSampler'],
137:     1,
138:     null,
139:     Texture.BILINEAR_SAMPLINGMODE,
140:     scene.getEngine(),
141:     false,
142:     null,
143:     Constants.TEXTURETYPE_HALF_FLOAT
144:   );
145: 
146:   pass.onApply = effect => {
147:     const gbuffer = scene.geometryBufferRenderer;
148:     if (!gbuffer) return;
149: 
150:     const index = gbuffer.getTextureIndex(
151:       GeometryBufferRenderer.DEPTH_TEXTURE_TYPE
152:     );
153: 
154:     effect.setTexture('depthSampler', gbuffer.getGBuffer().textures[index]);
155:     effect.setFloat3('sunScreen', shown.u, shown.v, shown.weight);
156:     effect.setFloat3('sunColor', shown.color[0], shown.color[1], shown.color[2]);
157:   };
158: 
159:   camera.attachPostProcess(pass);
160: 
161:   return pass;
162: }
163: 
164: export function disposeSunShafts(): void {
165:   if (!runtime) return;
166: 
167:   runtime.camera.detachPostProcess(runtime.pass);
168:   runtime.pass.dispose(runtime.camera);
169:   runtime = null;
170: }
171: 
172: const sunPoint = new Vector3();
173: const projected = new Vector3();
174: 
175: /**
176:  * The sun's screen position and the weight that follows it off frame. The sun
177:  * is a direction, so it is projected as a point a long way up that direction;
178:  * behind the camera it throws nothing.
179:  */
180: function placeSun(
181:   scene: Scene,
182:   camera: ArcRotateCamera,
183:   direction: readonly [number, number, number],
184:   slider: number
185: ): void {
186:   const norm = 1 / (Math.hypot(direction[0], direction[1], direction[2]) || 1);
187: 
188:   sunPoint.set(
189:     camera.globalPosition.x - direction[0] * norm * 4000,
190:     camera.globalPosition.y - direction[1] * norm * 4000,
191:     camera.globalPosition.z - direction[2] * norm * 4000
192:   );
193: 
194:   Vector3.TransformCoordinatesToRef(sunPoint, camera.getViewMatrix(), projected);
195: 
196:   if (projected.z <= 0) {
197:     shown.weight = 0;
198:     return;
199:   }
200: 
201:   Vector3.TransformCoordinatesToRef(sunPoint, scene.getTransformMatrix(), projected);
202: 
203:   shown.u = projected.x * 0.5 + 0.5;
204:   shown.v = projected.y * 0.5 + 0.5;
205: 
206:   // Distance from the frame in UV, 0 inside it. The weight fades over the
207:   // reach rather than switching, so a shaft never snaps on as the camera
208:   // turns.
209:   const dx = Math.max(0, Math.abs(shown.u - 0.5) - 0.5);
210:   const dy = Math.max(0, Math.abs(shown.v - 0.5) - 0.5);
211:   const out = Math.hypot(dx, dy);
212: 
213:   shown.weight =
214:     out >= OFF_SCREEN_REACH
215:       ? 0
216:       : slider * (1 - out / OFF_SCREEN_REACH) ** 2;
217: }
218: 
219: /**
220:  * Built while the map has a sky, no room owns the frame, the option is above
221:  * zero and there is a G-buffer to read the occluders from. Returns true when
222:  * the chain changed. `upstreamChanged` (a pass ahead of it was rebuilt this
223:  * tick) re-attaches the pass behind it without rebuilding it.
224:  */
225: export function syncSunShafts(
226:   scene: Scene,
227:   camera: ArcRotateCamera,
228:   tier: LightingTier | null,
229:   tierIndex: number,
230:   look: {
231:     /** The map's sun colour in linear, or null where there is no sky to shine through. */
232:     readonly sunColor: Rgb | null;
233:     readonly direction: readonly [number, number, number];
234:   },
235:   post: boolean,
236:   upstreamChanged: boolean
237: ): boolean {
238:   const slider = Math.max(
239:     0,
240:     Math.min(SLIDER_MAX, shaftsDev ?? GameOptions.sunShafts)
241:   );
242: 
243:   const wanted =
244:     tier !== null &&
245:     post &&
246:     slider > 0 &&
247:     look.sunColor !== null &&
248:     scene.geometryBufferRenderer !== null;
249: 
250:   if (wanted) {
251:     shown.color[0] = look.sunColor![0];
252:     shown.color[1] = look.sunColor![1];
253:     shown.color[2] = look.sunColor![2];
254:     placeSun(scene, camera, look.direction, (slider / SLIDER_MAX) * MAX_WEIGHT);
255:   } else {
256:     shown.weight = 0;
257:   }
258: 
259:   const taps = TAPS[tierIndex] ?? TAPS[1];
260: 
261:   if (runtime && (!wanted || runtime.scene !== scene || runtime.taps !== taps)) {
262:     disposeSunShafts();
263:     if (!wanted) return true;
264:   }
265: 
266:   if (runtime && upstreamChanged) {
267:     runtime.camera.detachPostProcess(runtime.pass);
268:     runtime.camera.attachPostProcess(runtime.pass);
269:     return true;
270:   }
271: 
272:   if (!wanted || runtime) return false;
273: 
274:   runtime = { scene, camera, taps, pass: createPass(scene, camera, taps) };
275: 
276:   return true;
277: }
278: 
279: export function sunShaftsLive(): boolean {
280:   return runtime !== null;
281: }
</file>

<file path="src/scenes/toneMap.ts">
  1: import {
  2:   Constants,
  3:   PostProcess,
  4:   ShaderStore,
  5:   Texture,
  6:   type ArcRotateCamera,
  7:   type Scene,
  8: } from '../libs/babylon/exports';
  9: import { devQueryNumber, devQueryNumbers } from '../common/devSeams';
 10: 
 11: /**
 12:  * The MU tone curve (sky_atmospherics ARCHITECTURE §2b, lighting_polish §13
 13:  * item 13): sole owner of the tone-mapping post-process, run on the linear
 14:  * HDR buffer before the rendering pipeline so bloom, sharpen and the grade
 15:  * downstream are unchanged.
 16:  *
 17:  * Why it exists. Babylon's three curves are fixed shapes and none of them
 18:  * has both a toe and a real shoulder. With `Standard` the plaza's mid grey
 19:  * lands at p50 0.435 while p95 sits at 0.694: the distribution is too wide
 20:  * at both ends, so a bright texel (a birch trunk, a plaster wall) clips to
 21:  * white while the mid tone is under its band, and no exposure closes that -
 22:  * exposure translates the distance, it never compresses it.
 23:  *
 24:  * The curve is a generalised Reinhard shoulder with a separate toe, applied
 25:  * to luminance with the chroma carried through unchanged, so it moves level
 26:  * and never hue; a small desaturation at the very top lets an emitter core
 27:  * reach white rather than a saturated flat.
 28:  */
 29: 
 30: const SHADER = 'muToneMap';
 31: 
 32: /**
 33:  * The curve, as four numbers that mean something on their own. Uchimura's GT
 34:  * operator was tried first and rejected by measurement: its shoulder is
 35:  * derived from its mid slope, so buying a toe there costs a mid expansion
 36:  * that took the plaza's p95 from 0.694 to 0.792.
 37:  *
 38:  * - `shoulder` (< 1) is the power of a generalised Reinhard, `x^s / (x^s +
 39:  *   k^s)`. Below 1 it compresses the top hard, which is the whole point: a
 40:  *   bright texel in full key sits at about 2.4 linear and has to land near
 41:  *   0.8 display rather than clipping to white.
 42:  * - `mid` is the scene value that maps to half, so it is the exposure of the
 43:  *   curve itself and the map's `ev` stays what it is.
 44:  * - `toeGamma` deepens the bottom; `toeKnee` is where it stops, so the toe
 45:  *   cannot reach the mid tone and flatten it.
 46:  */
 47: const CURVE = [0.75, 1.10, 1.30, 0.28] as const;
 48: 
 49: /** Where the highlight desaturation starts, and how much of it there is. */
 50: const DESAT = [0.8, 0.55] as const;
 51: 
 52: const gtDev = devQueryNumbers('gt', 4);
 53: const desatDev = devQueryNumbers('desat', 2);
 54: const toneDev = devQueryNumber('tone');
 55: 
 56: type Runtime = {
 57:   scene: Scene;
 58:   camera: ArcRotateCamera;
 59:   pass: PostProcess;
 60: };
 61: 
 62: let runtime: Runtime | null = null;
 63: 
 64: /** The viewer's brightness trim; the map's level is already in the key. */
 65: let exposure = 1;
 66: 
 67: function registerShader(): void {
 68:   if (ShaderStore.ShadersStore[`${SHADER}FragmentShader`]) return;
 69: 
 70:   ShaderStore.ShadersStore[`${SHADER}FragmentShader`] = `
 71:   precision highp float;
 72:   varying vec2 vUV;
 73:   uniform sampler2D textureSampler;
 74:   uniform float exposure;
 75:   uniform vec4 gtA;   // shoulder power, mid, toe gamma, toe knee
 76:   uniform vec2 gtB;   // desat start, desat amount
 77: 
 78:   const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
 79: 
 80:   float muCurve(float x) {
 81:     float s = pow(x, gtA.x);
 82:     float shoulder = s / (s + pow(gtA.y, gtA.x));
 83: 
 84:     // The toe is a gamma that fades out at the knee, so it deepens the
 85:     // bottom without touching the mid tone the shoulder just placed.
 86:     float w = 1.0 - smoothstep(0.0, gtA.w, shoulder);
 87: 
 88:     return mix(shoulder, pow(shoulder, gtA.z), w);
 89:   }
 90: 
 91:   void main(void) {
 92:     vec4 src = texture2D(textureSampler, vUV);
 93:     vec3 c = max(src.rgb, vec3(0.0)) * exposure;
 94: 
 95:     float lum = dot(c, LUMA);
 96: 
 97:     if (lum <= 1e-5) {
 98:       gl_FragColor = vec4(vec3(0.0), src.a);
 99:       return;
100:     }
101: 
102:     float mapped = muCurve(lum);
103: 
104:     // Chroma rides the luminance change, so the curve moves level only.
105:     vec3 outColor = c * (mapped / lum);
106: 
107:     // Past the shoulder an emitter core has to be able to reach white, or a
108:     // saturated flame reads as a flat orange plate instead of a hot core.
109:     float t = smoothstep(gtB.x, 1.0, mapped) * gtB.y;
110:     outColor = mix(outColor, vec3(mapped), t);
111: 
112:     gl_FragColor = vec4(min(outColor, vec3(1.0)), src.a);
113:   }
114:   `;
115: }
116: 
117: function createPass(scene: Scene, camera: ArcRotateCamera): PostProcess {
118:   registerShader();
119: 
120:   const pass = new PostProcess(
121:     'muToneMap',
122:     SHADER,
123:     ['exposure', 'gtA', 'gtB'],
124:     [],
125:     1,
126:     null,
127:     Texture.BILINEAR_SAMPLINGMODE,
128:     scene.getEngine(),
129:     false,
130:     null,
131:     Constants.TEXTURETYPE_HALF_FLOAT
132:   );
133: 
134:   const curve = gtDev ?? CURVE;
135:   const desat = desatDev ?? DESAT;
136: 
137:   pass.onApply = effect => {
138:     effect.setFloat('exposure', exposure);
139:     effect.setFloat4('gtA', curve[0], curve[1], curve[2], curve[3]);
140:     effect.setFloat2('gtB', desat[0], desat[1]);
141:   };
142: 
143:   camera.attachPostProcess(pass);
144: 
145:   return pass;
146: }
147: 
148: export function disposeToneMap(): void {
149:   if (!runtime) return;
150: 
151:   runtime.camera.detachPostProcess(runtime.pass);
152:   runtime.pass.dispose(runtime.camera);
153:   runtime = null;
154: }
155: 
156: /**
157:  * Live while the map is shaped, post is on and the viewer picked this curve
158:  * (`toneMapper` 1). Returns true when the chain changed, like the haze:
159:  * the post chain has to be re-attached behind a new pass. `upstreamChanged`
160:  * (a pass ahead of it was rebuilt this tick) re-attaches the pass behind it
161:  * without rebuilding it.
162:  *
163:  * Dev seams: `?tone=0` forces it off, `?gt=shoulder,mid,toeGamma,toeKnee`
164:  * replaces the curve, `?desat=start,amount` the highlight roll to white.
165:  */
166: export function syncToneMap(
167:   scene: Scene,
168:   camera: ArcRotateCamera,
169:   want: boolean,
170:   brightness: number,
171:   upstreamChanged: boolean
172: ): boolean {
173:   exposure = brightness;
174: 
175:   const live = want && toneDev !== 0;
176: 
177:   if (runtime && (!live || runtime.scene !== scene)) {
178:     disposeToneMap();
179:     if (!live) return true;
180:   }
181: 
182:   if (runtime && upstreamChanged) {
183:     runtime.camera.detachPostProcess(runtime.pass);
184:     runtime.camera.attachPostProcess(runtime.pass);
185:     return true;
186:   }
187: 
188:   if (!live || runtime) return false;
189: 
190:   runtime = { scene, camera, pass: createPass(scene, camera) };
191: 
192:   return true;
193: }
194: 
195: export function toneMapLive(): boolean {
196:   return runtime !== null;
197: }
</file>

<file path="src/maps/bloodcastle/gate.ts">
  1: import { TW_NOGROUND } from '../../common/terrain/consts';
  2: import { sound } from '../../sound';
  3: import { bloodCastleTimer } from '../../events/bloodCastle';
  4: import type { World } from '../../ecs/world';
  5: import { BLOOD_CASTLE_GATE_PIT } from './spec';
  6: 
  7: /**
  8:  * The Blood Castle gate's state, shared by the gate (type 36) and its two
  9:  * debris halves (9/10). This is `g_iActionObjectType / g_iActionTime /
 10:  * g_fActionObjectVelocity` (ZzzObject.cpp:50-58) narrowed to the one object
 11:  * that uses them on this map.
 12:  *
 13:  * Driven by: `BloodCastleGateObject.Update` (the tick) and two triggers -
 14:  *  - the match state `BloodCastleGateDestroyed` (the `BloodCastleState`
 15:  *    packet, read through `events/bloodCastle`), which is the animated fall:
 16:  *    `SetActionObject(world, 36, 20, 1)` - twenty ticks, pitch from 35° up to
 17:  *    90° at a velocity that grows 1.5°/tick, a smoke burst as it passes 80°,
 18:  *    `SOUND_DOWN_GATE` on the first tick (ZzzObject.cpp:96-131);
 19:  *  - the server clearing `TW_NOGROUND` on the pit (`ReceiveSetAttribute`,
 20:  *    WSclient.cpp:8333: `SetActionObject(world, 36, 0, 1)`), which is the
 21:  *    instant version: gate hidden, pit open, debris shown.
 22:  * Read by: the three object classes in this folder.
 23:  */
 24: 
 25: // ---- 1. tuning -------------------------------------------------------------
 26: 
 27: /** `SetActionObject(…, 36, 20, 1.f)`: ticks the fall takes. */
 28: const FALL_TICKS = 20;
 29: /** `o->Angle[0] = 35.f` on the first tick. */
 30: const START_PITCH_DEG = 35;
 31: /** Where it stops and vanishes: `if (o->Angle[0] >= 90.f)`. */
 32: const END_PITCH_DEG = 90;
 33: /** `g_fActionObjectVelocity = 1` to start, `+= 1.5f` a tick. */
 34: const START_VELOCITY = 1;
 35: const VELOCITY_GAIN = 1.5;
 36: /** The smoke burst fires as the pitch passes this. */
 37: const SMOKE_PITCH_DEG = 80;
 38: /** Reference tick, seconds. */
 39: const TICK = 1 / 25;
 40: 
 41: // ---- 2. state + readers ----------------------------------------------------
 42: 
 43: type Phase = 'up' | 'falling' | 'down';
 44: 
 45: let phase: Phase = 'up';
 46: let ticksLeft = 0;
 47: let pitch = 0;
 48: let velocity = 0;
 49: let smoked = false;
 50: let accumulator = 0;
 51: 
 52: /** True once the gate is gone and the pit is open. */
 53: export function bloodCastleGateDown(): boolean {
 54:   return phase === 'down';
 55: }
 56: 
 57: /** `o->Angle[0]` in MU degrees while the gate is falling, else null. */
 58: export function bloodCastleGatePitch(): number | null {
 59:   return phase === 'falling' ? pitch : null;
 60: }
 61: 
 62: /** True on the one tick the smoke burst is due. */
 63: export function bloodCastleGateSmokeDue(): boolean {
 64:   if (phase !== 'falling' || smoked || pitch < SMOKE_PITCH_DEG) return false;
 65:   smoked = true;
 66:   return true;
 67: }
 68: 
 69: /** Fresh map: the gate stands. Called from `createBloodCastle`. */
 70: export function resetBloodCastleGate(): void {
 71:   phase = 'up';
 72:   ticksLeft = 0;
 73:   pitch = 0;
 74:   velocity = 0;
 75:   smoked = false;
 76:   accumulator = 0;
 77: }
 78: 
 79: function open(world: World): void {
 80:   phase = 'down';
 81:   const p = BLOOD_CASTLE_GATE_PIT;
 82:   world.setTerrainFlags(p.x, p.y, p.w, p.h, TW_NOGROUND, false);
 83: }
 84: 
 85: function startFall(): void {
 86:   phase = 'falling';
 87:   ticksLeft = FALL_TICKS;
 88:   pitch = START_PITCH_DEG;
 89:   velocity = START_VELOCITY;
 90:   smoked = false;
 91:   sound.play('Sound/eDownGate');
 92: }
 93: 
 94: /**
 95:  * Advance by `dt` seconds. Both triggers are polled here rather than wired to
 96:  * the packet bus: the gate is the only consumer, the poll is one flag read,
 97:  * and it keeps this file free of a listener that would outlive the map.
 98:  */
 99: export function updateBloodCastleGate(world: World, dt: number): void {
100:   if (phase === 'down') return;
101: 
102:   if (phase === 'up') {
103:     const p = BLOOD_CASTLE_GATE_PIT;
104:     if (!(world.getTerrainFlag(p.x + 1, p.y + 2) & TW_NOGROUND)) {
105:       // The pit terrain flag is not set to TW_NOGROUND (e.g. cleared on load/open).
106:       open(world);
107:       return;
108:     }
109:     if (bloodCastleTimer().gateDestroyed) startFall();
110:     return;
111:   }
112: 
113:   accumulator += dt;
114:   while (accumulator >= TICK && phase === 'falling') {
115:     accumulator -= TICK;
116:     pitch = Math.min(END_PITCH_DEG, pitch + velocity);
117:     velocity += VELOCITY_GAIN;
118:     if (--ticksLeft <= 0) open(world);
119:   }
120: }
</file>

