<file path="src/maps/index.ts">
  1: import { ENUM_WORLD } from '../common/types';
  2: import type { World } from '../ecs/world';
  3: import type { Emission } from '../common/effectParticles';
  4: import type { MapLayer, Room, Spawn } from './layer';
  5: import { MAP_LAYERS } from './layers';
  6: 
  7: export type { MapLayer, Room, Spawn } from './layer';
  8: 
  9: /**
 10:  * The map system: every world the client can load, behind one object. Copy `_template.ts` when adding to it.
 11:  *
 12:  * `loadMapIntoScene` calls `maps.create(world)` once per warp and
 13:  * `maps.reset()` on a map change; both go through `MAP_LAYERS`
 14:  * (`layers.ts`), which is the only list of maps in the codebase. The readers
 15:  * below are what the renderer, the terrain loader, the weather and the sound
 16:  * tables ask about a world; every one is a lookup over the entries' declared
 17:  * data. The facade holds nothing of its own beyond the index it builds over
 18:  * the list.
 19:  */
 20: class Maps {
 21:   private readonly layers: MapLayer[] = [...MAP_LAYERS];
 22:   private readonly byWorld = new Map<ENUM_WORLD, MapLayer>();
 23:   private readonly effectOnlySets = new Map<MapLayer, ReadonlySet<number>>();
 24: 
 25:   constructor() {
 26:     this.reindex();
 27:   }
 28: 
 29:   private reindex(): void {
 30:     this.byWorld.clear();
 31:     for (const layer of this.layers) {
 32:       for (const world of layer.worlds) {
 33:         const taken = this.byWorld.get(world);
 34:         if (taken && taken !== layer) {
 35:           console.error(
 36:             `maps: ${ENUM_WORLD[world]} is claimed by both '${taken.name}' and '${layer.name}'`
 37:           );
 38:         }
 39:         this.byWorld.set(world, layer);
 40:       }
 41:     }
 42:   }
 43: 
 44:   /** Add a map at runtime (tools, experiments). Returns the unregister. */
 45:   register(layer: MapLayer): () => void {
 46:     this.layers.push(layer);
 47:     this.reindex();
 48:     return () => {
 49:       const i = this.layers.indexOf(layer);
 50:       if (i >= 0) this.layers.splice(i, 1);
 51:       this.reindex();
 52:     };
 53:   }
 54: 
 55:   /** Every entry, list order. */
 56:   get all(): readonly MapLayer[] {
 57:     return this.layers;
 58:   }
 59: 
 60:   /** The entry that serves this world, if any. */
 61:   layerFor(world: ENUM_WORLD): MapLayer | undefined {
 62:     return this.byWorld.get(world);
 63:   }
 64: 
 65:   /** The worlds an entry serves, by name; empty for an unknown name. */
 66:   worldsOf(name: string): readonly ENUM_WORLD[] {
 67:     return this.layers.find(l => l.name === name)?.worlds ?? [];
 68:   }
 69: 
 70:   /** Every world whose entry satisfies `pick`. */
 71:   worldsWhere(pick: (layer: MapLayer) => boolean): readonly ENUM_WORLD[] {
 72:     return this.layers.filter(pick).flatMap(l => l.worlds);
 73:   }
 74: 
 75:   // ---- lifecycle ---------------------------------------------------------
 76: 
 77:   /** Bind the current map's object classes and entities. Once per warp. */
 78:   async create(world: World): Promise<void> {
 79:     const layer = this.layerFor(world.mapIndex);
 80:     if (!layer) {
 81:       // The terrain still loads (folder `world + 1`), but no entry claims
 82:       // this world: no tiles list, no spawn, no object classes.
 83:       console.error(`No map entry for world ${world.mapIndex}`);
 84:       return;
 85:     }
 86:     await layer.create?.(world);
 87:   }
 88: 
 89:   /** Drop every entry's state. Call when the map changes. */
 90:   reset(): void {
 91:     for (const layer of this.layers) layer.reset?.();
 92:   }
 93: 
 94:   // ---- readers -----------------------------------------------------------
 95: 
 96:   /**
 97:    * Which `Data/World<n>` / `Data/Object<n>` folder a world draws from: the
 98:    * entry's `assetWorld`, else `world + 1` (also for a world no entry claims).
 99:    */
100:   assetWorldNum(world: ENUM_WORLD): number {
101:     return this.layerFor(world)?.assetWorld ?? world + 1;
102:   }
103: 
104:   /** Tile textures by slot; empty (and an error) for a world without an entry. */
105:   tiles(world: ENUM_WORLD): readonly string[] {
106:     const layer = this.layerFor(world);
107:     if (!layer) {
108:       console.error(`Not implemented for ${ENUM_WORLD[world]}`);
109:       return [];
110:     }
111:     return layer.tiles;
112:   }
113: 
114:   /** The `AlphaTile*` slot, the one that means "no ground here", or null. */
115:   cutoutTileFor(world: ENUM_WORLD): number | null {
116:     return this.layerFor(world)?.cutoutTile ?? null;
117:   }
118: 
119:   /** Where the offline hero lands, in tiles. */
120:   spawn(world: ENUM_WORLD): Spawn | undefined {
121:     return this.layerFor(world)?.spawn;
122:   }
123: 
124:   /** Has a sky. Whether rain may fall out of it is `canRain`. */
125:   isOutdoor(world: ENUM_WORLD): boolean {
126:     return this.layerFor(world)?.outdoor === true;
127:   }
128: 
129:   /**
130:    * Rain may fall here: the map has a sky, and its climate is not something
131:    * else. The one place that answers the question - a caller that assembles
132:    * its own version of it from the flags will drift the first time a fourth
133:    * climate is added.
134:    *
135:    * `outdoor` is necessary and not sufficient. Each climate below has its own
136:    * reason and its own other effects (snow caps and footsteps; the sea's
137:    * ambience), so they stay separate flags rather than one "dry" bit.
138:    */
139:   canRain(world: ENUM_WORLD): boolean {
140:     const layer = this.layerFor(world);
141:     if (!layer) return false;
142:     return (
143:       layer.outdoor === true &&
144:       layer.snow !== true &&
145:       layer.underwater !== true &&
146:       layer.desert !== true
147:     );
148:   }
149: 
150:   /**
151:    * The map's climate is snow. That is all it says: whether anything falls
152:    * out of it is `SNOWFALL_MAPS` and whether any of it settles is
153:    * `SNOW_GROUND_MAPS`, and the ice fields are snow-climate with neither.
154:    */
155:   isSnow(world: ENUM_WORLD): boolean {
156:     return this.layerFor(world)?.snow === true;
157:   }
158: 
159:   /** Under water - no rain, and the sea's own ambience. */
160:   isUnderwater(world: ENUM_WORLD): boolean {
161:     return this.layerFor(world)?.underwater === true;
162:   }
163: 
164:   /** `SetWorldClearColor` bytes, or undefined for black. */
165:   clearColorFor(
166:     world: ENUM_WORLD
167:   ): readonly [number, number, number] | undefined {
168:     return this.layerFor(world)?.clearColor;
169:   }
170: 
171:   /** The map's lit interiors. */
172:   roomsOf(world: ENUM_WORLD): readonly Room[] {
173:     return this.layerFor(world)?.rooms ?? [];
174:   }
175: 
176:   /** Additive mesh index for an object type, or undefined for none. */
177:   blendMeshFor(world: ENUM_WORLD, type: number): number | undefined {
178:     return this.layerFor(world)?.blendMeshes?.[type];
179:   }
180: 
181:   /** Whether an object type is an emitter with no drawn model. */
182:   isEffectOnly(world: ENUM_WORLD, type: number): boolean {
183:     const layer = this.layerFor(world);
184:     if (!layer?.effectOnly) return false;
185:     let set = this.effectOnlySets.get(layer);
186:     if (!set) {
187:       set = new Set(layer.effectOnly);
188:       this.effectOnlySets.set(layer, set);
189:     }
190:     return set.has(type);
191:   }
192: 
193:   /** Particle emissions for an object type. */
194:   emissionsFor(
195:     world: ENUM_WORLD,
196:     type: number
197:   ): readonly Emission[] | undefined {
198:     return this.layerFor(world)?.emissions?.[type];
199:   }
200: }
201: 
202: export const maps = new Maps();
203: 
204: // A hot update that reaches this module must reload the page: Vite would
205: // otherwise re-execute it and hand later-loaded importers a second instance
206: // of this singleton (same guard as store.ts).
207: const hot = (import.meta as { hot?: { decline(): void } }).hot;
208: if (hot) hot.decline();
