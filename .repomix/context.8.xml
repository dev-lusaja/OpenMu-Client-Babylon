<file path="src/maps/dungeon/create.ts">
 1: import { LeanBoxObject } from '../../common/operateBoxObject';
 2: import type { World } from '../../ecs/world';
 3: 
 4: /**
 5:  * Dungeon (World 2 / `Object2`). Almost the whole map is the default
 6:  * `MapTileObject`: `CreateObject` (ZzzObject.cpp:4605-4617) touches exactly
 7:  * two of the 61 types present in EncTerrain2.obj, and `MoveObject`
 8:  * (ZzzObject.cpp:3822-3849) another seven. Everything those cases need is
 9:  * table data and lives in `spec.ts` (blend meshes, effect-only markers,
10:  * particles, torch lights) or in `common/meshAnimation.ts` (the 22/23/24
11:  * UV scroll); this file is only the two class assignments and the notes on
12:  * what the original does here that we do not.
13:  *
14:  * Not implemented, deliberately:
15:  *
16:  *  - **Bats and rats.** `Object2/Bat01.glb` and `Object2/Rat01.glb` are
17:  *    ambient wildlife, flocked by the original's boid code rather than placed
18:  *    in the object list - which is why neither appears in EncTerrain2.obj.
19:  *    The clone has no boid system and this map is not the place to grow one.
20:  *  - **The type 52 rock-fall as real falling models.** See the long note on
21:  *    `DUNGEON_EMISSIONS` in `spec.ts`: it runs as particles until an
22:  *    effect-model system exists.
23:  *
24:  * No fog, no `clearColor` override and no camera change: the original sets
25:  * none for Dungeon. The dark is the baked `TerrainLight.OZJ` plus the 120
26:  * torch terrain lights from `DUNGEON_LIGHTS`, and adding a grade on top would
27:  * flatten exactly the contrast those torches are there to create.
28:  *
29:  * Skinned types (11, 16, 18, 22-24, 35, 40, 43) need no action start here:
30:  * `loadGLTF` reproduces the glTF loader's `animationStartMode = FIRST` and
31:  * plays clip 0 looping on every instance and clone (modelLoader.ts:471-481),
32:  * which is what the original's single-action map objects do. Their *rate* is
33:  * a separate, map-agnostic matter - `ModelObject.AnimationSpeed` defaults to
34:  * the 0.28 player idle speed where `CreateObject` gives every map object
35:  * `o->Velocity = 0.16f` (ZzzObject.cpp:4470), so every map object in the port
36:  * animates ~1.75× fast. That is shared-code work, not a Dungeon fix.
37:  */
38: export async function createDungeon(world: World) {
39:   const terrain = world.terrain;
40:   if (!terrain) return;
41: 
42:   const tiles = terrain.MapTileObjects;
43: 
44:   // Dungeon 59 (ZzzObject.cpp:4608-4610), the sittable stone ledge - 30 of
45:   // them, in clusters of three to five around the six rest spots. The
46:   // original only calls `CreateOperate(o)`: the model draws normally and the
47:   // object joins the operate list, which `ObjectCollisionCheck` uses to route
48:   // a click into the sit pose. Nothing in this clone consumes that list yet
49:   // (combat and UI work), so the default `MapTileObject` is already the whole of the
50:   // visible behaviour and the type is left unassigned on purpose - a class
51:   // that only re-loaded `Object60.glb` would be a class that does nothing.
52: 
53:   // Dungeon 60 (ZzzObject.cpp:4611-4615): `CreateOperate` + the explicit
54:   // `Vector(40.f, 40.f, 160.f, o->BoundingBoxMax)` + `HiddenMesh = -2`, the
55:   // shared lean-pose trigger. Nine of them, all at scale 0.8, each paired
56:   // with a 59 cluster.
57:   //
58:   // `Data/Object2/Object61.bmd` does not exist - Object2 stops at Object60 in
59:   // every client, and the original never notices because it draws nothing
60:   // here anyway. The pick box is what the click ray hits, so the request is
61:   // skipped up front rather than fetched and caught.
62:   tiles[60] = class DungeonLeanBoxObject extends LeanBoxObject {
63:     protected modelName(): string | null {
64:       return null;
65:     }
66:   };
67: }
</file>

