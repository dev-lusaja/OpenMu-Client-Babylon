<file path="src/maps/losttower/create.ts">
 1: import type { World } from '../../ecs/world';
 2: import { LostTowerMachineObject } from './towerMachineObject';
 3: import { LostTowerSkullObject } from './skullObject';
 4: 
 5: /**
 6:  * Lost Tower (WD_4LOSTTOWER, world 4 / `Object5`).
 7:  *
 8:  * Almost everything this map does is table data - see spec.ts for the blend
 9:  * meshes, the two hidden types and the lights, and common/meshAnimation.ts for
10:  * the UV scrolls. Only three of the 40 types need behaviour that a table
11:  * cannot hold, and they are wired here.
12:  *
13:  * Three things the original does that are deliberately not built:
14:  *
15:  *  - **Bats.** Lost Tower is the second home of `Object2/Bat01.glb` and
16:  *    `Object2/DungeonStone01.glb` (max 5 bats), flocking overhead. They are
17:  *    not map objects at all - they are a boid simulation the clone has no
18:  *    system for, and one bolted into a map module would be the wrong place
19:  *    for it. Left for whoever builds the ambient-creature system; Stadium's
20:  *    ground bugs want the same thing.
21:  *
22:  *  - **Type 9.** `RenderObjectVisual`'s `case WD_4LOSTTOWER:` has no `break`
23:  *    before `case WD_6STADIUM:` (ZzzObject.cpp:2944), so in this world a
24:  *    type-9 object also runs Stadium's `case 9` - a warm `BITMAP_LIGHT`
25:  *    sprite at bone 1, on all 200 of Lost Tower's type-9 objects.
26:  *
27:  *    Not reproduced, and it is not a close call. Stadium's `case 9` is a
28:  *    2-bone brazier; Lost Tower's type 9 is `Object10.glb`, a re_08 stone
29:  *    block with **zero bones**. `BoneTransform[1]` is a global scratch array
30:  *    left over from whatever model was drawn last, and the call reads it
31:  *    through arguments the original has swapped anyway
32:  *    (`TransformPosition(BoneTransform[1], Position, p)` writes `p` and reads
33:  *    an uninitialised `Position` - the same bug as Lorencia's merchant
34:  *    animal, ZzzObject.cpp:2770). There is no position to port: the sprite
35:  *    lands wherever the last frame's garbage put it. Treated as inert.
36:  *
37:  *  - **The chrome pass** on types 3, 4, 19 and 20 (ZzzObject.cpp:1013-1032):
38:  *    the body redrawn with `BITMAP_CHROME` and `BodyLight` forced to
39:  *    (1.0, 0.2, 0.1), then the normal textured pass over the top. The clone
40:  *    has no per-object chrome pass - materials work. Its `StreamMesh`
41:  *    half (unlit + scrolling) is already in common/meshAnimation.ts, which is
42:  *    the part that actually reads as movement.
43:  */
44: export async function createLostTower(world: World) {
45:   const terrain = world.terrain;
46:   if (!terrain) return;
47: 
48:   const tiles = terrain.MapTileObjects;
49: 
50:   // 19 red / 20 blue: the same rig, told apart by Type inside the class
51:   // (ZzzObject.cpp:2896-2905).
52:   tiles[19] = LostTowerMachineObject;
53:   tiles[20] = LostTowerMachineObject;
54: 
55:   // 38 skulls (n=777) and 39 stones (n=335), both routed to `CheckSkull`
56:   // (ZzzObject.cpp:3949-3951).
57:   tiles[38] = LostTowerSkullObject;
58:   tiles[39] = LostTowerSkullObject;
59: }
</file>

