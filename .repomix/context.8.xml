208: /** `CMuHelper::Buff` - rotate the three slots over self or the party. */
209: function buff(world: World, hero: Entity, config: MuHelperConfig): boolean {
210:   if (!config.buffs.some(n => n > 0)) return true;
211: 
212:   const partyMode = config.supportParty && Social.partyMembers.length > 0;
213:   const duration = partyMode ? config.buffDurationParty : config.buffDuration;
214:   if (
215:     !duration &&
216:     config.buffCastInterval > 0 &&
217:     secondsElapsed > 0 &&
218:     secondsElapsed % config.buffCastInterval === 0 &&
219:     lastTimerBuffSecond !== secondsElapsed
220:   ) {
221:     timerBuffOngoing = true;
222:     lastTimerBuffSecond = secondsElapsed;
223:   }
224: 
225:   const skillNum = config.buffs[buffIndex];
226:   let busy = false;
227: 
228:   if (partyMode) {
229:     const members = Social.partyMembers;
230:     const member = members[buffPartyIndex % members.length];
231:     const target = member ? findPartyEntity(world, member.name) : null;
232:     if (
233:       target &&
234:       member.mapId === world.mapIndex &&
235:       tileDistance(heroTile(hero), entityTile(target)) <= MAX_ACTIONABLE_DISTANCE
236:     ) {
237:       busy = skillNum > 0 && buffTarget(world, target, skillNum);
238:     }
239:     buffPartyIndex = (buffPartyIndex + 1) % members.length;
240:     if (buffPartyIndex === 0) {
241:       buffIndex = (buffIndex + 1) % config.buffs.length;
242:       if (buffIndex === 0) timerBuffOngoing = false;
243:     }
244:   } else {
245:     busy = skillNum > 0 && buffTarget(world, hero, skillNum);
246:     buffIndex = (buffIndex + 1) % config.buffs.length;
247:     if (buffIndex === 0) timerBuffOngoing = false;
248:   }
249: 
250:   return !busy;
251: }
252: 
253: /** `FindHealingItemIndex`: the first HP or complex potion in the bag. */
254: function findHealingPotionSlot(): number {
255:   const items = Store.playerData.items;
256:   for (let slot = InventoryConstants.EquippableSlotsCount; slot < items.length; slot++) {
257:     const item = items[slot];
258:     if (!item || item.group !== 14) continue;
259:     if (item.num <= 3 || (item.num >= 38 && item.num <= 40)) return slot;
260:   }
261:   return -1;
262: }
