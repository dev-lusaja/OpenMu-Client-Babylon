<file path="src/observableStores.test.ts">
 1: import { describe, expect, it } from 'vitest';
 2: import { readFileSync, readdirSync, statSync } from 'node:fs';
 3: import { join } from 'node:path';
 4: import { fileURLToPath } from 'node:url';
 5: 
 6: /**
 7:  * `makeAutoObservable(this, overrides)` decides each key with
 8:  * `key in overrides`, which walks the prototype chain: a store member named
 9:  * after an `Object.prototype` one (`valueOf`, `toString`, ...) is handed that
10:  * built-in function as its annotation and mobx throws inside the constructor.
11:  * The store is built at import time, so that takes the whole client down.
12:  */
13: 
14: const SRC = fileURLToPath(new URL('.', import.meta.url));
15: 
16: const RESERVED = new Set(
17:   Object.getOwnPropertyNames(Object.prototype).filter(n => n !== 'constructor')
18: );
19: 
20: /** A class member at the usual two-space indent: `foo(`, `get foo(`, `foo =`, `foo:`. */
21: const MEMBER =
22:   /^ {2}(?:(?:private|protected|public|readonly|static|declare|abstract|get|set|async|override)\s+)*([A-Za-z_$][\w$]*)\s*[(:=?]/;
23: 
24: function tsFiles(dir: string): string[] {
25:   return readdirSync(dir).flatMap(entry => {
26:     const path = join(dir, entry);
27:     if (statSync(path).isDirectory()) return tsFiles(path);
28:     return /\.tsx?$/.test(entry) && !/\.test\.tsx?$/.test(entry) ? [path] : [];
29:   });
30: }
31: 
32: describe('observable stores', () => {
33:   it('never name a member after one on Object.prototype', () => {
34:     const offenders: string[] = [];
35: 
36:     for (const file of tsFiles(SRC)) {
37:       const source = readFileSync(file, 'utf8');
38:       if (!source.includes('makeAutoObservable(')) continue;
39: 
40:       source.split('\n').forEach((line, index) => {
41:         const name = MEMBER.exec(line)?.[1];
42:         if (name && RESERVED.has(name)) {
43:           offenders.push(`${file.slice(SRC.length)}:${index + 1} ${name}`);
44:         }
45:       });
46:     }
47: 
48:     expect(offenders).toEqual([]);
49:   });
50: });
</file>

<file path="src/quests/_template.ts">
 1: /**
 2:  * TEMPLATE - copy this file to `<name>.ts`, fill in the blanks, add the layer
 3:  * to `layers.ts`. Never imported; it only exists to be copied.
 4:  *
 5:  * Every quest entry file has the same three parts, in this order:
 6:  *
 7:  *   1. Tuning constants at the top, each with a comment saying what it is in
 8:  *      real units (seconds, tiles, packet codes) and why it has that value.
 9:  *   2. Module state + the functions that read it. State lives here, not in
10:  *      the facade. State a window renders is a MobX `observable` so React
11:  *      re-renders; readers are plain functions (`templateOpen()`).
12:  *      Packet handlers are `EventBus.on('<PacketName>', …)` registered at
13:  *      module load, like `social.ts`.
14:  *   3. The exported `QuestLayer` at the bottom, wiring `update` / `reset`.
15:  *
16:  * If the entry opens a window, the window lives in
17:  * `ui/pages/worldPage/components/quests/` and reads this file's state.
18:  * If it reacts to a packet, the handler is here - never in `logic.ts`.
19:  */
20: import { observable, runInAction } from 'mobx';
21: import { ENUM_WORLD } from '../common/types';
22: import type { QuestLayer } from './layer';
23: 
24: // ---- 1. tuning -------------------------------------------------------------
25: 
26: /** Seconds between two re-checks of whatever this entry watches. */
27: const POLL_SECONDS = 1;
28: 
29: /** Maps this exists on. */
30: const MAPS: ReadonlySet<ENUM_WORLD> = new Set([ENUM_WORLD.WD_0LORENCIA]);
31: 
32: // ---- 2. state + readers ----------------------------------------------------
33: 
34: const state = observable({
35:   /** Whether the entry's window is up. */
36:   open: false,
37: });
38: 
39: let sinceLastPoll = 0;
40: 
41: /** Whether the template's window is showing. */
42: export function templateOpen(): boolean {
43:   return state.open;
44: }
45: 
46: /** Command: show / hide the window. */
47: export function showTemplate(open: boolean): void {
48:   runInAction(() => {
49:     state.open = open;
50:   });
51: }
52: 
53: function update(map: ENUM_WORLD, dt: number): void {
54:   if (!MAPS.has(map)) return;
55: 
56:   sinceLastPoll += dt;
57:   if (sinceLastPoll < POLL_SECONDS) return;
58:   sinceLastPoll = 0;
59: 
60:   // Replace with whatever this entry watches each poll.
61: }
62: 
63: function reset(): void {
64:   sinceLastPoll = 0;
65:   showTemplate(false);
66: }
67: 
68: // ---- 3. the layer ----------------------------------------------------------
69: 
70: export const templateLayer: QuestLayer = {
71:   name: 'template',
72:   maps: MAPS,
73:   update,
74:   reset,
75: };
</file>

