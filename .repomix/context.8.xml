12:  * `events/crywolf.ts` the way the Blood Castle gate polls its match state.
13:  * Against stock OpenMU the state never leaves peace, so these render their
14:  * peace look until a server actually runs the event.
15:  */
16: 
17: /** `o->Alpha = 0.2f` (MoveCryWolf1stObject :363). */
18: const DOME_ALPHA = 0.2;
19: /** `sinf(WorldTime * 0.004f)`: the war heartbeat, in rad/s. */
20: const PULSE_SPEED = 4;
21: /** `fTemp`: the beat swells tenfold once the statue is nearly down. */
22: const PULSE_CRITICAL_HP = 10;
23: /** `rand_fps_check(3)`: one vent puff about every third tick. */
24: const VENT_EVERY = 3;
25: 
26: /**
27:  * Type 81 (×1, over the wolf statue): the altar's energy dome. In peace it
28:  * is the faint constant shell; during the war the original redraws it
29:  * additively with a heartbeat that reddens and quickens as the statue HP
30:  * falls (RenderCryWolf1stObjectMesh :540-561). The clone has no per-object
31:  * chrome pass, so the beat is carried by the shell's alpha instead.
32:  */
33: export class CrywolfDomeObject extends MapTileObject {
34:   async init(world: World, entity: Entity): Promise<void> {
35:     await super.init(world, entity);
36:     this.setAlpha(DOME_ALPHA);
37:   }
38: 
39:   Update(gameTime: World['gameTime']): void {
40:     super.Update(gameTime);
41:     if (!this.Ready || this.OutOfView) return;
42: 
43:     const hud = crywolfHud();
44:     if (hud.occupation !== CrywolfOccupation.War) {
45:       if (this.Alpha !== DOME_ALPHA) this.setAlpha(DOME_ALPHA);
46:       return;
47:     }
48: 
49:     const hp = Math.min(100, Math.max(0, hud.statueHp));
50:     const amp = hp <= PULSE_CRITICAL_HP ? 0.35 : 0.1;
51:     const wave = Math.sin((performance.now() / 1000) * PULSE_SPEED);
52:     // Brighter as the shield erodes, beating on top.
53:     const alpha = 0.3 + ((100 - hp) / 100) * 0.3 + wave * amp;
54:     this.setAlpha(Math.min(0.95, Math.max(DOME_ALPHA, alpha)));
55:   }
56: }
57: 
58: /**
59:  * Types 74 (×4, visible vents) and 84 (×4, hidden vents by the altar):
60:  * `CreateParticle(BITMAP_SMOKE, …, 21)` only while the fortress is occupied
61:  * (RenderCryWolf1stObjectVisual :419-425, RenderCryWolf1stObjectMesh
62:  * :512-519). 84 stays in the map's effect-only list, so no mesh loads.
63:  */
64: export class CrywolfVentObject extends MapTileObject {
65:   #smoke: ParticleEmitter | null = null;
66: 
67:   async init(world: World, entity: Entity): Promise<void> {
68:     await super.init(world, entity);
69:     this.#smoke = new ParticleEmitter(
70:       world.scene,
71:       [{ kinds: ['smoke21'], every: VENT_EVERY }],
72:       this.node.position,
73:       this.node.rotation.y,
74:       this.node.scaling.x
75:     );
76:   }
77: 
78:   dispose(): void {
79:     this.#smoke = null;
80:     super.dispose();
81:   }
82: 
83:   Update(gameTime: World['gameTime']): void {
84:     super.Update(gameTime);
85:     if (!this.Ready || Store.world === null) return;
86:     if (crywolfHud().occupation !== CrywolfOccupation.Occupied) return;
87:     this.#smoke?.update();
88:   }
89: }
</file>

