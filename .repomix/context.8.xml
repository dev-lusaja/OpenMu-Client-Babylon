397: // ---- packet → state ----------------------------------------------------------
398: 
399: /** `GetAnswer(i)` for every answer the step offers, numbered as it is drawn. */
400: function answerLines(entry: ReturnType<typeof questProgressEntry>): string[] {
401:   const answers: string[] = [];
402:   if (!entry) return answers;
403: 
404:   for (let i = 0; i < MAX_ANSWERS; i++) {
405:     const words = entry.answers[i] ? questWords(entry.answers[i]) : undefined;
406:     if (!words) break;
407:     answers.push(`${i + 1}.${words.replace(/;/g, ' ')}`);
408:   }
409: 
410:   return answers;
411: }
412: 
413: /** The three blocks of text the window draws, out of the current tables. */
414: function progressText(key: number): Pick<typeof state, 'npcLines' | 'playerLines' | 'answers'> {
415:   const entry = questProgressEntry(key);
416:   return {
417:     npcLines: entry ? questWordLines(entry.npcWords) : [],
418:     playerLines: entry ? questWordLines(entry.playerWords) : [],
419:     answers: answerLines(entry),
420:   };
421: }
422: 
423: /** `CNewUIQuestProgress::SetContents(dwQuestIndex)`. */
424: function setProgressContents(key: number): void {
425:   const text = progressText(key);
426: 
427:   runInAction(() => {
428:     state.currentKey = key;
429:     state.npcLines = text.npcLines;
430:     state.playerLines = text.playerLines;
431:     state.answers = text.answers;
432:     state.mode = text.answers.length > 0 ? 'npcWords' : 'requestReward';
433:     state.busy = false;
434:   });
