  1: import {
  2:   Color4,
  3:   Constants,
  4:   GeometryBufferRenderer,
  5:   Material,
  6:   PostProcess,
  7:   RenderTargetTexture,
  8:   SSAO2RenderingPipeline,
  9:   ShaderStore,
 10:   SmartArray,
 11:   Texture,
 12:   Vector3,
 13:   type AbstractMesh,
 14:   type ArcRotateCamera,
 15:   type MultiRenderTarget,
 16:   type Scene,
 17:   type SubMesh,
 18: } from '../libs/babylon/exports';
 19: // Side-effect import, and the order is the whole point: this module's body is
 20: // `ShaderStore.ShadersStore['ssaoCombinePixelShader'] = <Babylon's version>`.
 21: // ESM evaluates it before this file's body, so the override below lands last;
 22: // `SSAO2RenderingPipeline` then `import()`s the same specifier, gets the
 23: // cached module, and does *not* re-run the registration over the top of ours.
 24: import '@babylonjs/core/Shaders/ssaoCombine.fragment.js';
 25: import { pipelineSamples, type LightingTier } from '../common/lightingQuality';
 26: import { devQuery, devQueryNumber, devQueryNumbers } from '../common/devSeams';
 27: import { GameOptions } from '../common/gameOptions';
 28: import { renderDistanceRanges } from '../common/renderDistance';
 29: import { CSM_CASTER_REACH, drawsSolidGeometry } from './shadows';
 30: import { driveRenderList } from './renderList';
 31: 
 32: /**
 33:  * Contact-scale SSAO2 and the effect mask (ARCHITECTURE §4.1, §4.8 step 1).
 34:  * Sole owner of the SSAO pipeline, the geometry buffer's predicate and the
 35:  * effect-mask render target; `heightFog.ts` reads the mask.
 36:  *
 37:  * Contact-scale, not ambient-scale: the baked lightmap already carries the
 38:  * near-wall darkening (that darkening is the art) and the CSM the sun, so the
 39:  * AO reads as contact tightening, never as a halo at gameplay zoom.
 40:  *
 41:  * Dev seams: `?ssao=radius,strength,base` for live tuning; `?ssao=0` builds
 42:  * none of it (G-buffer and effect mask included).
 43:  */
 44: const SSAO_RADIUS = 0.35;
 45: const SSAO_STRENGTH = 0.75;
 46: const SSAO_BASE = 0.15;
 47: const SSAO_MAX_Z = 45;
 48: const SSAO_MIN_Z_ASPECT = 0.25;
 49: 
 50: function ssaoOverride(): [number, number, number] | null {
 51:   return devQueryNumbers('ssao', 3) as [number, number, number] | null;
 52: }
 53: 
 54: function ssaoForcedOff(): boolean {
 55:   return devQuery('ssao') === '0';
 56: }
 57: 
 58: /**
 59:  * The effect mask: where the additive half of the frame landed, and how much
 60:  * of each pixel it is.
 61:  *
 62:  * The AO combine and the haze both describe a pixel by the *surface* under
 63:  * it, read from the geometry buffer, which holds only matter. Over every
 64:  * additive thing in the game (the `_R` meshes and `BlendMesh` flames, the
 65:  * flare sprites, fire and smoke particles, item auras, skill effects) the
 66:  * buffer describes whatever stands behind the flame, and both passes would
 67:  * apply it anyway. Nothing this early in the chain is HDR (SSAO2 builds its
 68:  * passes at 8 bits), so a brightness knee cannot find them; the mask draws
 69:  * them instead: one target holding only the additive geometry over black,
 70:  * composited with its own blend modes.
 71:  *
 72:  * Both readers *subtract* it rather than threshold it. An additive pass adds
 73:  * to the surface under it, so `surface = colour - mask` is that surface, and
 74:  * each half then takes its own treatment: the flame keeps its own haze
 75:  * distance and is never occluded, the water behind it keeps the haze and the
 76:  * AO it earned. A threshold cannot do that - it hands the whole pixel to
 77:  * whichever side won - and the sprite sheets are JPEG, so the "black" around
 78:  * a flame carries 1-12/255 of ringing and cleared any knee low enough to
 79:  * catch a rain streak. That is what stamped a flame's quad into the frame as
 80:  * an un-hazed dark rectangle.
 81:  *
 82:  * Hence full resolution and half float. At half resolution a one-pixel rain
 83:  * streak lands at a tenth of its brightness, and a subtraction would leave
 84:  * the other nine tenths to be hazed as far water; at 8 bits a flame brighter
 85:  * than white clamps to 1.0 and the surface left under it comes out too
 86:  * bright. Neither costs anything measurable: the pass is bound by the scene
 87:  * traversal it does, not by the pixels it fills, and its render list is a
 88:  * handful of cards, sprites and particles.
 89:  */
 90: 
 91: /** Mask resolution relative to the backbuffer. */
 92: const EFFECT_MASK_RATIO = 1;
 93: 
 94: export const EFFECT_MASK_SAMPLER = 'effectMask';
 95: 
 96: type Runtime = {
 97:   scene: Scene;
 98:   camera: ArcRotateCamera;
 99:   tier: LightingTier;
100:   /** The G-buffer's ratio: the tier's, or 1 while the ink lines read it. */
101:   gbufferRatio: number;
102:   ssao: SSAO2RenderingPipeline;
103:   mask: RenderTargetTexture;
104: };
105: 
106: let runtime: Runtime | null = null;
107: 
108: /** The live effect mask, for the haze; null while the AO is not built. */
109: export function effectMask(): RenderTargetTexture | null {
110:   return runtime?.mask ?? null;
111: }
112: 
113: /**
114:  * What SSAO and the haze see: everything the camera sees that is matter.
115:  *
116:  * The haze reads one number per pixel - this buffer's depth - so a pixel that
117:  * is missing here inherits the depth of whatever stands behind it and is
118:  * hazed for that distance instead. Alpha-keyed meshes are in
119:  * (`useMeshAlphaTestTexture` makes that safe: the G-buffer alpha-tests
120:  * against the mesh's own texture), and the whitelist is `depthOccluder`, not
121:  * `csmCaster`: an object the map marks `CastsShadow = false`, and every
122:  * torch, candle and lamp, casts no sun shadow and is still solid geometry
123:  * standing in front of the camera.
124:  *
125:  * The reach is the render distance's own, not the cascades': see `gbufferReach`.
126:  */
127: function occludes(mesh: AbstractMesh): boolean {
128:   const meta = mesh.metadata;
129: 
130:   if (!meta) return false;
131:   if (meta.terrain === true) return true;
132: 
133:   // The flattened shadow clones replace their metadata wholesale and so never
134:   // carry `depthOccluder`, which keeps them out of the depth they would
135:   // otherwise poison.
136:   if (meta.depthOccluder !== true || meta.brightMesh) return false;
137: 
138:   // A map object's alpha-keyed cards (Noria's canopies, grass, every fence
139:   // and bar) were kept out: per object they were the bulk of the G-buffer's
140:   // cost, and the haze read the depth behind them (§4.8 step 1). That is
141:   // also why a tree at the ring's edge stood crisp over the fog band - a
142:   // card against the sky carries the sky's depth, which is no haze at all.
143:   // Batched, a chunk is one instanced draw per submesh and the cells hold
144:   // the count, so the batches go in and the haze reads their own depth;
145:   // the per-object cards (doors, rest spots, the rooms) stay out as before.
146:   // A figure's keyed trim stays in: it is the body's own silhouette.
147:   if (
148:     meta.mapObject === true &&
149:     meta.propBatch !== true &&
150:     mesh.material?.transparencyMode === Material.MATERIAL_ALPHATESTANDBLEND
151:   ) {
152:     return false;
153:   }
154: 
155:   return drawsSolidGeometry(mesh, false, gbufferReach());
156: }
157: 
158: /**
159:  * How far out this buffer has to reach, squared.
160:  *
161:  * `drawsSolidGeometry` defaults to the cascades' 48 tiles, which is right for
162:  * a shadow map and wrong here: the haze reads this buffer's depth and returns
163:  * a pixel with no depth in it untouched. Every object past 48 tiles was drawn
164:  * at full contrast over terrain the haze had washed to the horizon colour - a
165:  * hard line at eye level with crisp trunks and roofs standing above it, each
166:  * one appearing whole as the render-distance ring reached it. So the reach is
167:  * that ring instead, plus the stand-off: `nearby` is measured from the hero
168:  * and this test from the camera, which orbits out behind them.
169:  *
170:  * Dev seam: `?gbreach=<tiles>`, and `?gbreach=0` restores the cascades' reach.
171:  */
172: const GBUFFER_CAMERA_STANDOFF = 32;
173: 
174: let reachStep = -1;
175: let reachSq = 0;
176: 
177: function gbufferReach(): number {
178:   const forced = devQueryNumber('gbreach');
179: 
180:   if (forced !== null) {
181:     return forced > 0 ? forced * forced : CSM_CASTER_REACH ** 2;
182:   }
183: 
184:   const step = GameOptions.renderDistance;
185: 
186:   // Per mesh per frame; the ring only moves when the player moves the slider.
187:   if (step !== reachStep) {
188:     reachStep = step;
189: 
190:     const ring =
191:       renderDistanceRanges(step).nearby + GBUFFER_CAMERA_STANDOFF;
192: 
193:     reachSq = ring * ring;
194:   }
195: 
196:   return reachSq;
197: }
198: 
199: /** Stand-in for a bucket a pass is not meant to draw this time round. */
200: const NO_SUBMESHES = new SmartArray<SubMesh>(0);
201: 
202: /**
203:  * Draw the G-buffer's alpha-keyed meshes with depth writes on.
204:  *
205:  * Babylon files anything whose material needs alpha blending - which
206:  * ALPHATESTANDBLEND does - into the *transparent* bucket, and the geometry
207:  * buffer draws that bucket last with `setDepthWrite(false)` and unsorted
208:  * (`RenderingGroup.render` hands a custom render function its buckets
209:  * unsorted), so the last keyed mesh dispatched would win every pixel it
210:  * covers whatever its distance. They are drawn a second time round through
211:  * the *opaque* slot, where depth writes are on and the depth test resolves
212:  * them; the G-buffer writes depth as a colour attachment and never blends,
213:  * so "opaque" here only means "sorted by the depth buffer".
214:  */
215: function depthWriteAlphaKeyed(gbuffer: MultiRenderTarget): void {
216:   const inner = gbuffer.customRenderFunction;
217: 
218:   if (!inner) return;
219: 
220:   gbuffer.customRenderFunction = (
221:     opaque,
222:     alphaTest,
223:     transparent,
224:     depthOnly,
225:     beforeTransparents
226:   ) => {
227:     inner(opaque, alphaTest, NO_SUBMESHES, depthOnly, beforeTransparents);
228: 
229:     if (transparent.length) {
230:       inner(transparent, NO_SUBMESHES, NO_SUBMESHES, NO_SUBMESHES);
231:     }
232:   };
233: }
234: 
235: /**
236:  * Babylon's combine pass is `sceneColor * ssaoColor` over the *finished*
237:  * frame, glow cards included; the effect mask is subtracted out of it first
238:  * and added back unoccluded, because a pixel that is itself a light source
239:  * has nothing to occlude.
240:  *
241:  * The ground keeps a floor (§4.8 step 1): the lightmap already carries the
242:  * near-wall darkening, so on an up-facing surface the AO is contact
243:  * tightening only. "Ground" is read off the G-buffer normal (view space, so
244:  * it is compared against the camera's up).
245:  */
246: const SSAO_COMBINE_SHADER = 'ssaoCombinePixelShader';
247: 
248: const GROUND_AO_FLOOR = 0.8;
249: const GROUND_NORMAL_SAMPLER = 'gbufferNormal';
250: const GROUND_UP_UNIFORM = 'upView';
251: 
252: let ssaoCombinePatched = false;
253: 
254: function patchSsaoCombine(): void {
255:   if (ssaoCombinePatched) return;
256: 
257:   ssaoCombinePatched = true;
258: 
259:   ShaderStore.ShadersStore[SSAO_COMBINE_SHADER] = `
260:   uniform sampler2D textureSampler;
261:   uniform sampler2D originalColor;
262:   uniform sampler2D ${EFFECT_MASK_SAMPLER};
263:   uniform sampler2D ${GROUND_NORMAL_SAMPLER};
264:   uniform vec4 viewport;
265:   uniform vec3 ${GROUND_UP_UNIFORM};
266:   varying vec2 vUV;
267: 
268:   const float GROUND_AO_FLOOR = ${GROUND_AO_FLOOR.toFixed(3)};
269: 
270:   void main(void) {
271:     vec2 uv = viewport.xy + vUV * viewport.zw;
272: 
273:     vec4 ssaoColor = texture2D(textureSampler, uv);
274:     vec4 sceneColor = texture2D(originalColor, uv);
275: 
276:     // The mask is rendered through the same camera viewport as the passes
277:     // above it, so it takes the same remapped uv rather than raw vUV.
278:     vec3 effect = min(texture2D(${EFFECT_MASK_SAMPLER}, uv).rgb,
279:       max(sceneColor.rgb, vec3(0.0)));
280:     vec3 surface = sceneColor.rgb - effect;
281: 
282:     vec3 normalV = texture2D(${GROUND_NORMAL_SAMPLER}, uv).xyz;
283:     float ground = smoothstep(0.7, 0.9, dot(normalV, ${GROUND_UP_UNIFORM}));
284: 
285:     vec3 ao = max(ssaoColor.rgb, vec3(ground * GROUND_AO_FLOOR));
286: 
287:     gl_FragColor = vec4(surface * ao + effect, sceneColor.a * ssaoColor.a);
288:   }
289:   `;
290: }
291: 
292: /** The additive half of the frame - everything the G-buffer refuses. */
293: function emits(mesh: AbstractMesh): boolean {
294:   return mesh.metadata?.brightMesh === true && mesh.isEnabled();
295: }
296: 
297: /**
298:  * The mask itself: the effect geometry, in its own blend modes, over black.
299:  * No depth buffer: additive compositing is order-independent, and a flame
300:  * hidden behind a wall costs a little AO and haze on the wall in front of
301:  * it, cheaper than a second depth attachment in step with the G-buffer's.
302:  */
303: function createEffectMask(
304:   scene: Scene,
305:   camera: ArcRotateCamera
306: ): RenderTargetTexture {
307:   const mask = new RenderTargetTexture(
308:     'effectMask',
309:     { ratio: EFFECT_MASK_RATIO },
310:     scene,
311:     {
312:       generateDepthBuffer: false,
313:       generateMipMaps: false,
314:       samplingMode: Texture.BILINEAR_SAMPLINGMODE,
315:       // Both readers subtract it from an HDR frame; 8 bits would clamp a
316:       // flame brighter than white and leave a surface that is too bright.
317:       type: Constants.TEXTURETYPE_HALF_FLOAT,
318:     }
319:   );
320: 
321:   mask.clearColor = new Color4(0, 0, 0, 1);
322:   mask.activeCamera = camera;
323:   driveRenderList(scene, mask, emits);
324:   mask.renderParticles = true;
325:   mask.renderSprites = true;
326:   mask.wrapU = Texture.CLAMP_ADDRESSMODE;
327:   mask.wrapV = Texture.CLAMP_ADDRESSMODE;
328: 
329:   scene.customRenderTargets.push(mask);
330: 
331:   return mask;
332: }
333: 
334: /**
335:  * Hand Babylon's combine pass the samplers and the uniform its patched shader
336:  * declares. An `Effect` binds by the names it was *compiled* with, so the
337:  * post-process is recompiled with the extra names; `onApplyObservable`
338:  * because the pipeline has already spent `onApply` on `viewport` and
339:  * `originalColor`.
340:  */
341: function bindCombine(
342:   ssao: SSAO2RenderingPipeline,
343:   camera: ArcRotateCamera,
344:   mask: RenderTargetTexture,
345:   normals: Texture | null
346: ): void {
347:   const combine = (
348:     ssao as unknown as { _ssaoCombinePostProcess: PostProcess | null }
349:   )._ssaoCombinePostProcess;
350: 
351:   if (!combine) return;
352: 
353:   combine.updateEffect(
354:     null,
355:     ['viewport', GROUND_UP_UNIFORM],
356:     ['textureSampler', 'originalColor', EFFECT_MASK_SAMPLER, GROUND_NORMAL_SAMPLER]
357:   );
358: 
359:   const upView = new Vector3();
360: 
361:   combine.onApplyObservable.add(effect => {
362:     effect.setTexture(EFFECT_MASK_SAMPLER, mask);
363:     if (normals) effect.setTexture(GROUND_NORMAL_SAMPLER, normals);
364: 
365:     Vector3.TransformNormalToRef(Vector3.UpReadOnly, camera.getViewMatrix(), upView);
366:     effect.setFloat3(GROUND_UP_UNIFORM, upView.x, upView.y, upView.z);
367:   });
368: }
369: 
370: function createSsao(
371:   scene: Scene,
372:   camera: ArcRotateCamera,
373:   tier: LightingTier,
374:   mask: RenderTargetTexture,
375:   gbufferRatio: number
376: ): SSAO2RenderingPipeline {
377:   patchSsaoCombine();
378: 
379:   // This call sizes the G-buffer. The pipeline below takes whatever exists
380:   // (`enableGeometryBufferRenderer` returns the live renderer at any ratio);
381:   // its own `ssaoRatio` sizes its blur targets only.
382:   const gbuffer = scene.enableGeometryBufferRenderer(gbufferRatio);
383:   let normals: Texture | null = null;
384: 
385:   if (gbuffer) {
386:     const target = gbuffer.getGBuffer();
387: 
388:     driveRenderList(scene, target, occludes);
389:     depthWriteAlphaKeyed(target);
390:     normals = target.textures[
391:       gbuffer.getTextureIndex(GeometryBufferRenderer.NORMAL_TEXTURE_TYPE)
392:     ] ?? null;
393:   }
394: 
395:   const ssao = new SSAO2RenderingPipeline(
396:     'enhancedSsao',
397:     scene,
398:     { ssaoRatio: tier.ssaoRatio, blurRatio: tier.ssaoRatio },
399:     [camera],
400:     true,
401:     // The combine pass carries the scene colour on: 8-bit here quantises
402:     // every linear value under display 0.05 to a hard zero.
403:     Constants.TEXTURETYPE_HALF_FLOAT
404:   );
405: 
406:   const [radius, strength, base] = ssaoOverride() ?? [
407:     SSAO_RADIUS,
408:     SSAO_STRENGTH,
409:     SSAO_BASE,
410:   ];
411:   ssao.radius = radius;
412:   ssao.totalStrength = strength;
413:   ssao.base = base;
414:   ssao.samples = tier.ssaoSamples;
415:   ssao.expensiveBlur = tier.ssaoRatio >= 1;
416:   ssao.maxZ = SSAO_MAX_Z;
417:   ssao.minZAspect = SSAO_MIN_Z_ASPECT;
418:   ssao.textureSamples = pipelineSamples();
419: 
420:   bindCombine(ssao, camera, mask, normals);
421: 
422:   return ssao;
423: }
424: 
425: export function disposeAmbientOcclusion(): void {
426:   if (!runtime) return;
427: 
428:   const { scene, ssao, mask } = runtime;
429: 
430:   ssao.dispose(true);
431: 
432:   const index = scene.customRenderTargets.indexOf(mask);
433:   if (index >= 0) scene.customRenderTargets.splice(index, 1);
434:   mask.dispose();
435: 
436:   scene.disableGeometryBufferRenderer();
437: 
438:   runtime = null;
439: }
440: 
441: /**
442:  * Build or tear down the AO to match the tier and the post option. Returns
443:  * true when the chain changed, so the director can re-order the post chain.
444:  */
445: export function syncAmbientOcclusion(
446:   scene: Scene,
447:   camera: ArcRotateCamera,
448:   tier: LightingTier | null,
449:   post: boolean,
450:   /** The G-buffer's size relative to the backbuffer: the tier's ratio unless a reader needs more. */
451:   gbufferRatio: number
452: ): boolean {
453:   const want = tier !== null && post && !ssaoForcedOff();
454: 
455:   if (
456:     runtime &&
457:     (!want ||
458:       runtime.tier !== tier ||
459:       runtime.gbufferRatio !== gbufferRatio ||
460:       runtime.scene !== scene)
461:   ) {
462:     disposeAmbientOcclusion();
463:     if (!want) return true;
464:   }
465: 
466:   if (!want || runtime) return false;
467: 
468:   const mask = createEffectMask(scene, camera);
469:   const ssao = createSsao(scene, camera, tier, mask, gbufferRatio);
470: 
471:   runtime = { scene, camera, tier, gbufferRatio, ssao, mask };
472: 
473:   return true;
474: }
</file>

<file path="src/scenes/fireflyGuard.ts">
  1: import {
  2:   Constants,
  3:   PostProcess,
  4:   ShaderStore,
  5:   Texture,
  6:   type ArcRotateCamera,
  7:   type Scene,
  8: } from '../libs/babylon/exports';
  9: import { devQueryNumber, devQueryNumbers } from '../common/devSeams';
 10: import { pipelineSamples } from '../common/lightingQuality';
 11: import { BLOOM_THRESHOLD } from './postChain';
 12: 
 13: /**
 14:  * The firefly guard: sole owner of the pass that bounds what one pixel may
 15:  * hand the bloom blur. Runs on the linear buffer ahead of the rendering
 16:  * pipeline, so `scenes/postChain.ts` keeps its bloom exactly as it is.
 17:  *
 18:  * Why it exists. Bloom spreads a pixel over a 48 px kernel, so how far it
 19:  * reaches is set by the pixel's *value* and not by the size of the thing that
 20:  * made it. One aliased fragment can therefore be drawn as a pool of light
 21:  * that nothing in the scene is emitting. The case this was written for is a
 22:  * grass blade at the far zoom
 23:  * (issues/lighting/grass_tips_bloom_into_floating_lights.md): a blade's
 24:  * albedo goes over 1, the decode squares it, and a single fragment arrives at
 25:  * the bloom pass carrying 32 while the hottest torch pixel in the same frame
 26:  * carries under 4. Zoomed in, hundreds of fragments are in that state at once
 27:  * and read as sunlit grass; zoomed out a blade is sub-pixel, a handful are
 28:  * left, and each one is drawn as its own ball that flickers with the wind.
 29:  *
 30:  * No threshold can separate those two - the artefact is the *brighter* of
 31:  * them - so this bounds instead: a pixel may exceed the bloom threshold on
 32:  * its own, but to go further than SPREAD over its brightest neighbour it has
 33:  * to be part of something. A lone spike sits on ordinary grass and comes
 34:  * down; a torch core, a flare or an emissive card is bright over an area, so
 35:  * every pixel in it has a bright neighbour and none of them move.
 36:  *
 37:  * Off when the MU curve is live (`toneMapper` 1): that one rolls the whole
 38:  * buffer into [0, 1] before the pipeline, so no pixel can hand the blur more
 39:  * than one unit and the artefact cannot happen - which is why the report only
 40:  * ever came from the other three mappers. Off with bloom off, and off on
 41:  * Classic, which has no bloom at all.
 42:  */
 43: 
 44: const SHADER = 'muFireflyGuard';
 45: 
 46: /**
 47:  * How far over its brightest neighbour a pixel may sit before it is treated
 48:  * as a spike rather than as light.
 49:  *
 50:  * The balls die at every value from 2 to 32, because what catches them is
 51:  * the floor below, not this: an aliased blade tip at the far zoom sits on
 52:  * grass that is nearly black, so `neighbour x SPREAD` never reaches the floor
 53:  * whatever SPREAD is. This number is therefore chosen for what it *protects* -
 54:  * the larger it is the more of a real gradient survives - and 4 is as far as
 55:  * it can go while still being under any one-pixel step a flame, a flare or a
 56:  * lit edge actually makes.
 57:  */
 58: const SPREAD = 4;
 59: 
 60: /**
 61:  * What a lone pixel may carry regardless of its neighbours, so a real point
 62:  * emitter against black - a spark, a distant lamp - is not clamped to the
 63:  * darkness around it.
 64:  *
 65:  * Set at the ceiling of what is actually in the frame rather than at the
 66:  * bloom threshold: sweeping the buffer this pass reads, the hottest *torch*
 67:  * pixel at the graveyard sits under 4 while the aliased blade tips reach 32,
 68:  * so four times the threshold is above everything real and a decade under the
 69:  * artefact. It has to be up here and not at the threshold itself, because at
 70:  * the near zoom hundreds of grass fragments are legitimately over the
 71:  * threshold at once: at the threshold the guard takes a little of their bloom
 72:  * with it (the 500x350 grass crop's p05 fell 0.071 -> 0.062), and at four
 73:  * times it the same crop is the control to three decimals.
 74:  */
 75: const FLOOR = BLOOM_THRESHOLD * 4;
 76: 
 77: const knobsDev = devQueryNumbers('fireflyk', 2);
 78: const guardDev = devQueryNumber('firefly');
 79: 
 80: type Runtime = {
 81:   scene: Scene;
 82:   camera: ArcRotateCamera;
 83:   pass: PostProcess;
 84: };
 85: 
 86: let runtime: Runtime | null = null;
 87: 
 88: function registerShader(): void {
 89:   if (ShaderStore.ShadersStore[`${SHADER}FragmentShader`]) return;
 90: 
 91:   ShaderStore.ShadersStore[`${SHADER}FragmentShader`] = `
 92:   precision highp float;
 93:   varying vec2 vUV;
 94:   uniform sampler2D textureSampler;
 95:   uniform vec2 texel;
 96:   uniform vec2 guard;  // spread, floor
 97: 
 98:   const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
 99: 
100:   float lumaAt(vec2 uv) {
101:     return dot(max(texture2D(textureSampler, uv).rgb, vec3(0.0)), LUMA);
102:   }
103: 
104:   void main(void) {
105:     vec4 src = texture2D(textureSampler, vUV);
106:     vec3 c = max(src.rgb, vec3(0.0));
107: 
108:     float lum = dot(c, LUMA);
109: 
110:     // The cross and not the full ring: a spike is one fragment, so four taps
111:     // find it, and the corners would cost half as much again on a
112:     // full-resolution pass for nothing.
113:     float near = max(
114:       max(lumaAt(vUV + vec2(texel.x, 0.0)), lumaAt(vUV - vec2(texel.x, 0.0))),
115:       max(lumaAt(vUV + vec2(0.0, texel.y)), lumaAt(vUV - vec2(0.0, texel.y))));
116: 
117:     float cap = max(near * guard.x, guard.y);
118: 
119:     // Scale, never replace: the chroma rides the luminance down, so a clamped
120:     // pixel keeps the colour it had.
121:     gl_FragColor = vec4(c * min(1.0, cap / max(lum, 1e-4)), src.a);
122:   }
123:   `;
124: }
125: 
126: function createPass(scene: Scene, camera: ArcRotateCamera): PostProcess {
127:   registerShader();
128: 
129:   const pass = new PostProcess(
130:     SHADER,
131:     SHADER,
132:     ['texel', 'guard'],
133:     [],
134:     1,
135:     null,
136:     Texture.BILINEAR_SAMPLINGMODE,
137:     scene.getEngine(),
138:     false,
139:     null,
140:     Constants.TEXTURETYPE_HALF_FLOAT
141:   );
142: 
143:   // The chain's own sample count, for the frames where nothing else is
144:   // attached ahead of the pipeline: the scene renders into the first pass's
145:   // target, so that pass is the one that has to be multisampled.
146:   pass.samples = pipelineSamples();
147: 
148:   const [spread, floor] = knobsDev ?? [SPREAD, FLOOR];
149: 
150:   pass.onApply = effect => {
151:     effect.setFloat2('texel', pass.texelSize.x, pass.texelSize.y);
152:     effect.setFloat2('guard', spread, floor);
153:   };
154: 
155:   camera.attachPostProcess(pass);
156: 
157:   return pass;
158: }
159: 
160: export function disposeFireflyGuard(): void {
161:   if (!runtime) return;
162: 
163:   runtime.camera.detachPostProcess(runtime.pass);
164:   runtime.pass.dispose(runtime.camera);
165:   runtime = null;
166: }
167: 
168: /**
169:  * Live while the caller wants it. Returns true when the chain changed, like
170:  * the tone curve: the post chain has to be re-attached behind a new pass.
171:  *
172:  * Dev seams: `?firefly=0` forces it off, `?fireflyk=spread,floor` replaces
173:  * the two numbers.
174:  */
175: export function syncFireflyGuard(
176:   scene: Scene,
177:   camera: ArcRotateCamera,
178:   want: boolean,
179:   /** A pass ahead of it was rebuilt this tick: re-attach behind it, no rebuild. */
180:   upstreamChanged: boolean
181: ): boolean {
182:   const live = want && guardDev !== 0;
183: 
184:   if (runtime && (!live || runtime.scene !== scene)) {
185:     disposeFireflyGuard();
186:     if (!live) return true;
187:   }
188: 
189:   if (runtime && upstreamChanged) {
190:     runtime.camera.detachPostProcess(runtime.pass);
191:     runtime.camera.attachPostProcess(runtime.pass);
192:     return true;
193:   }
194: 
195:   if (!live || runtime) return false;
196: 
197:   runtime = { scene, camera, pass: createPass(scene, camera) };
198: 
199:   return true;
200: }
</file>

<file path="src/scenes/heightFog.ts">
  1: import {
  2:   Constants,
  3:   GeometryBufferRenderer,
  4:   PostProcess,
  5:   ShaderStore,
  6:   Texture,
  7:   type ArcRotateCamera,
  8:   type Scene,
  9: } from '../libs/babylon/exports';
 10: import { EFFECT_MASK_SAMPLER, effectMask } from './ambientOcclusion';
 11: import { devQueryNumber } from '../common/devSeams';
 12: import type { LookProfile, Rgb } from '../lighting/profiles';
 13: 
 14: /**
 15:  * The distance haze (ARCHITECTURE §4.8 step 2): sole owner of the fog
 16:  * post-process. `f = cap x (1 - exp(-density x max(0, dist - start)))`, colour
 17:  * the profile's horizon decoded to linear, no exposure division - the buffer
 18:  * is linear and the tone mapper downstream sees haze and sky alike. `start`
 19:  * sits beyond the default camera's ground reach, so the hero takes none of
 20:  * it; a small height term is allowed for the water and snow maps.
 21:  */
 22: 
 23: /**
 24:  * Share of the surface's extinction the additive half of a pixel takes.
 25:  *
 26:  * The depth is the surface's, and an additive pass is drawn on top of its
 27:  * background, so the emitter sits somewhere between the camera and that
 28:  * depth and its own distance is in no buffer. A share is the estimate that
 29:  * stays monotone in distance: zero at the camera, never more than the
 30:  * surface's, so an emitter can never come out brighter than the ground it
 31:  * stands on.
 32:  *
 33:  * This was a fixed 12 tiles, which every outdoor profile's `fog.start`
 34:  * (20-25) already sits past, so the extinction was identically zero: a torch
 35:  * at the map edge burned at its full HDR value over terrain the haze had
 36:  * washed to the horizon colour, which reads as a glowing ball with nothing
 37:  * under it. Under 1 because the share is an upper bound - rain and motes a
 38:  * few tiles out are drawn over whatever the frame has behind them, and the
 39:  * far ground's whole extinction would put them out.
 40:  *
 41:  * Dev seam: `?ehaze=<share>`.
 42:  */
 43: const EFFECT_HAZE_SHARE = 0.85;
 44: 
 45: const FOG_SHADER = 'muDistanceHaze';
 46: 
 47: /**
 48:  * Where the haze stops holding anything back, in tiles.
 49:  *
 50:  * The cap is 0.9 so mid-distance ground keeps a tenth of its own colour and
 51:  * does not wash out. A map is 256 tiles across, so its edge stands a couple of
 52:  * hundred tiles off: at 250 the curve has only reached 0.75 and a quarter of
 53:  * the far terrain survives. Under the ported camera that band is off the
 54:  * bottom of the frame; at eye level it is the map ending in a hard silhouette
 55:  * against the sky, plateau and all.
 56:  *
 57:  * Past this range the cap comes off and the ground goes into the sky it was
 58:  * already fading toward. The ported camera looks down 48.5 degrees and its
 59:  * topmost ray meets the ground about 20 tiles out, so no ported framing
 60:  * reaches into this at all.
 61:  */
 62: const FOG_CLOSE_NEAR = 160;
 63: const FOG_CLOSE_FAR = 320;
 64: 
 65: /** How fast the height reference follows the camera target (per second). */
 66: const FOG_BASE_EASE = 2.5;
 67: 
 68: type Underworld = NonNullable<LookProfile['underworld']>;
 69: 
 70: const shown = {
 71:   color: [0, 0, 0] as [number, number, number],
 72:   start: 0,
 73:   density: 0,
 74:   cap: 0,
 75:   height: 0,
 76:   underworld: null as Underworld | null,
 77: };
 78: 
 79: /** The underworld's colour, decoded once per sync rather than once per bind. */
 80: const uwLinear: [number, number, number] = [0, 0, 0];
 81: 
 82: let fogBaseY = 0;
 83: let fogBaseSeeded = false;
 84: 
 85: type Runtime = {
 86:   scene: Scene;
 87:   camera: ArcRotateCamera;
 88:   fog: PostProcess;
 89: };
 90: 
 91: let runtime: Runtime | null = null;
 92: 
 93: const hazeDev = devQueryNumber('haze');
 94: const effectHazeDev = devQueryNumber('ehaze');
 95: const uwDev = devQueryNumber('uw');
 96: 
 97: /**
 98:  * Why a pixel without depth is left alone: the G-buffer holds no blend or
 99:  * alpha-blended mesh and no sky dome, so a card against the sky carries depth
100:  * 0 and there is no way from inside this shader to tell "sky" from "a card
101:  * against the sky". Hazing depth 0 to a horizon distance turned every card
102:  * against the sky into a flat grey quad and Icarus uniformly white. The dome
103:  * behind such a card is already the colour the haze fades to, so the card
104:  * blends over the horizon and nothing is missing from it.
105:  */
106: function registerFogShader(): void {
107:   if (ShaderStore.ShadersStore[`${FOG_SHADER}FragmentShader`]) return;
108: 
109:   ShaderStore.ShadersStore[`${FOG_SHADER}FragmentShader`] = `
110:   precision highp float;
111:   varying vec2 vUV;
112:   uniform sampler2D textureSampler;
113:   uniform sampler2D depthSampler;
114:   uniform sampler2D ${EFFECT_MASK_SAMPLER};
115:   uniform mat4 invView;
116:   uniform vec2 viewport;   // tan(fov/2) * aspect, tan(fov/2)
117:   uniform vec3 fogColor;   // linear
118:   uniform vec4 fogParams;  // start, density, cap, height density
119:   uniform float fogBaseY;
120:   uniform float effectShare;
121:   uniform vec4 uwParams;   // top, density at top, e-folds per tile down, on
122:   uniform vec3 uwColor;    // linear
123: 
124:   const float FOG_CLOSE_NEAR = ${FOG_CLOSE_NEAR.toFixed(1)};
125:   const float FOG_CLOSE_FAR = ${FOG_CLOSE_FAR.toFixed(1)};
126: 
127:   float hazeAt(float dist, float camY, float rdY) {
128:     float reach = max(0.0, dist - fogParams.x);
129:     float y = camY + rdY * dist;
130:     float amount = reach * (fogParams.y + fogParams.w * exp(-max(y - fogBaseY, 0.0)));
131:     float f = fogParams.z * (1.0 - exp(-amount));
132: 
133:     // Past the map's own scale the cap comes off, so the far edge dissolves
134:     // into the sky instead of standing against it.
135:     return mix(f, 1.0, smoothstep(FOG_CLOSE_NEAR, FOG_CLOSE_FAR, dist));
136:   }
137: 
138:   /**
139:    * Optical depth of the underworld fog between the camera and \`dist\`: the
140:    * integral of \`density x exp(falloff x (top - y))\` over the part of the ray
141:    * that is under \`top\`, which has a closed form because the ray is a line.
142:    *
143:    * Zero above \`top\` rather than an exponential tail that never quite ends:
144:    * a ray leaving the camera a degree above the horizon would otherwise
145:    * gather thousands of tiles of that tail and the sky over the far edge
146:    * would come back grey.
147:    */
148:   float underworldDepth(float dist, float camY, float rdY) {
149:     float top = uwParams.x;
150:     float k = uwParams.z;
151: 
152:     // Nothing to collect: the ray starts over the fog and climbs away.
153:     if (camY > top && rdY >= 0.0) return 0.0;
154: 
155:     // Where it goes under, and how far it runs after that.
156:     float t0 = camY > top ? (top - camY) / rdY : 0.0;
157:     float span = max(0.0, dist - t0);
158: 
159:     if (span <= 0.0) return 0.0;
160: 
161:     // A ray a degree under the horizon goes below \`top\` too, hundreds of
162:     // tiles out and past the end of the map's own frame, and with nothing to
163:     // stop it it collects the whole integral: a black band ruled across the
164:     // sky at eye level. Past the map's own scale - the same range the haze
165:     // gives up at - this is not a hole in the ground, it is the horizon.
166:     float reach = 1.0 - smoothstep(FOG_CLOSE_NEAR, FOG_CLOSE_FAR, t0);
167: 
168:     if (reach <= 0.0) return 0.0;
169: 
170:     // The exponent at the entry and at the far end. Clamped because a ray
171:     // that meets nothing carries \`dist\` to the far plane and \`exp\` of that
172:     // is an infinity; the transmittance is zero long before the clamp bites,
173:     // so nothing anyone can see depends on where it sits.
174:     float a = min(k * (top - min(camY, top)), 60.0);
175:     float b = min(k * (top - camY - rdY * dist), 60.0);
176: 
177:     if (abs(rdY) < 1.0e-4) return reach * uwParams.y * exp(a) * span;
178: 
179:     return reach * uwParams.y * (exp(a) - exp(b)) / (k * rdY);
180:   }
181: 
182:   void main(void) {
183:     vec4 color = texture2D(textureSampler, vUV);
184:     float depth = texture2D(depthSampler, vUV).r;
185: 
186:     // A pixel with no depth is left alone by both terms, for the reason
187:     // above: a card against the sky and a hole in the ground are the same
188:     // thing here, and this cannot tell them apart - a grass blade on a rim
189:     // would go out with the ravine behind it. What is under a hole is drawn
190:     // rather than deduced: the floor of the sky, in lighting/skyDome.ts.
191:     if (depth <= 0.0 || (fogParams.y <= 0.0 && uwParams.w <= 0.0)) {
192:       gl_FragColor = color;
193:       return;
194:     }
195: 
196:     bool hazed = fogParams.y > 0.0;
197: 
198:     vec3 viewDir = vec3((vUV.x * 2.0 - 1.0) * viewport.x, (vUV.y * 2.0 - 1.0) * viewport.y, 1.0);
199:     vec3 camPos = invView[3].xyz;
200: 
201:     // The rotation of invView, by column. Not mat3(invView): a
202:     // matrix-from-matrix constructor is a compile error under ESSL 1.00.
203:     vec3 worldDir =
204:       invView[0].xyz * viewDir.x +
205:       invView[1].xyz * viewDir.y +
206:       invView[2].xyz * viewDir.z;
207: 
208:     float dist = length(worldDir) * depth;
209:     vec3 rd = normalize(worldDir);
210: 
211:     // The depth belongs to the surface, so only the surface may be hazed by
212:     // it. The mask holds the additive pass drawn over that surface, at the
213:     // same pixels, so the rest of the pixel is the surface itself.
214:     vec3 effect = min(texture2D(${EFFECT_MASK_SAMPLER}, vUV).rgb,
215:       max(color.rgb, vec3(0.0)));
216:     vec3 surface = color.rgb - effect;
217: 
218:     // Extinction only on the emissive half: the light scattered into the ray
219:     // is already added once, by the surface term.
220:     float f = hazed ? hazeAt(dist, camPos.y, rd.y) : 0.0;
221:     float fEffect = f * effectShare;
222: 
223:     vec3 lit = mix(surface, fogColor, f);
224: 
225:     // The underworld, last of the two: the haze fades a surface toward the
226:     // horizon and this fades what is left toward the bottom of the world, so
227:     // a crevasse stays dark however much air is in front of it.
228:     //
229:     // The surface only. The additive half is drawn over whatever the frame
230:     // had behind it and is almost always in front of this - an aurora over a
231:     // ravine, snow falling into one - and putting the fog through it would
232:     // put those out with the ground they are over.
233:     if (uwParams.w > 0.0) {
234:       float uw = 1.0 - exp(-max(underworldDepth(dist, camPos.y, rd.y), 0.0));
235: 
236:       lit = mix(lit, uwColor, uw);
237:     }
238: 
239:     gl_FragColor = vec4(lit + effect * (1.0 - fEffect), color.a);
240:   }
241:   `;
242: }
243: 
244: function createFog(scene: Scene, camera: ArcRotateCamera): PostProcess {
245:   registerFogShader();
246: 
247:   const fog = new PostProcess(
248:     'distanceHaze',
249:     FOG_SHADER,
250:     [
251:       'invView',
252:       'viewport',
253:       'fogColor',
254:       'fogParams',
255:       'fogBaseY',
256:       'effectShare',
257:       'uwParams',
258:       'uwColor',
259:     ],
260:     ['depthSampler', EFFECT_MASK_SAMPLER],
261:     1,
262:     null,
263:     Texture.BILINEAR_SAMPLINGMODE,
264:     scene.getEngine(),
265:     false,
266:     null,
267:     // The buffer is linear HDR: an 8-bit target here quantises everything
268:     // under display 0.05 to zero before the tone mapper ever sees it.
269:     Constants.TEXTURETYPE_HALF_FLOAT
270:   );
271: 
272:   fog.onApply = effect => {
273:     const mask = effectMask();
274:     const gbuffer = scene.geometryBufferRenderer;
275: 
276:     if (!mask || !gbuffer) return;
277: 
278:     effect.setTexture(EFFECT_MASK_SAMPLER, mask);
279: 
280:     const depthIndex = gbuffer.getTextureIndex(
281:       GeometryBufferRenderer.DEPTH_TEXTURE_TYPE
282:     );
283: 
284:     effect.setTexture('depthSampler', gbuffer.getGBuffer().textures[depthIndex]);
285: 
286:     effect.setMatrix('invView', camera.getViewMatrix().clone().invert());
287: 
288:     const tanHalf = Math.tan(camera.fov / 2);
289: 
290:     effect.setFloat2(
291:       'viewport',
292:       tanHalf * scene.getEngine().getAspectRatio(camera, true),
293:       tanHalf
294:     );
295: 
296:     effect.setFloat3('fogColor', shown.color[0], shown.color[1], shown.color[2]);
297:     effect.setFloat4('fogParams', shown.start, shown.density, shown.cap, shown.height);
298:     effect.setFloat('fogBaseY', fogBaseY);
299:     effect.setFloat('effectShare', effectHazeDev ?? EFFECT_HAZE_SHARE);
300: 
301:     const uw = shown.underworld;
302: 
303:     effect.setFloat4(
304:       'uwParams',
305:       uw ? uw.top : 0,
306:       uw ? uw.density : 0,
307:       uw ? Math.max(uw.falloff, 1e-3) : 1,
308:       uw ? 1 : 0
309:     );
310:     effect.setFloat3('uwColor', uwLinear[0], uwLinear[1], uwLinear[2]);
311:   };
312: 
313:   camera.attachPostProcess(fog);
314: 
315:   return fog;
316: }
317: 
318: export function disposeHeightFog(): void {
319:   if (!runtime) return;
320: 
321:   runtime.camera.detachPostProcess(runtime.fog);
322:   runtime.fog.dispose(runtime.camera);
323:   runtime = null;
324: }
325: 
326: /**
327:  * The live haze: built while there is a mask to read and a density to draw,
328:  * torn down otherwise (identity when off). Returns true when the chain
329:  * changed. Colour and parameters are written every call; they are cheap and
330:  * an area blend moves them every frame.
331:  */
332: export function syncHeightFog(
333:   scene: Scene,
334:   camera: ArcRotateCamera,
335:   fog: LookProfile['fog'],
336:   colorLinear: Rgb,
337:   post: boolean,
338:   /** The map's underworld fog, or null - see `LookProfile.underworld`. */
339:   underworld: Underworld | null,
340:   /** A pass ahead of it was rebuilt this tick: re-attach behind it, no rebuild. */
341:   upstreamChanged: boolean
342: ): boolean {
343:   // Dev seam: `?haze=<density>` replaces the profile's density (0 = no pass).
344:   const density = hazeDev ?? fog.density;
345: 
346:   // Dev seam: `?uw=<density>` replaces the underworld's (0 = off), which is
347:   // both the A/B for what it is worth and the dial for how hard it bites.
348:   const uwDensity = uwDev ?? underworld?.density ?? 0;
349: 
350:   shown.underworld =
351:     underworld && uwDensity > 0 ? { ...underworld, density: uwDensity } : null;
352: 
353:   uwLinear[0] = shown.underworld?.color[0] ?? 0;
354:   uwLinear[1] = shown.underworld?.color[1] ?? 0;
355:   uwLinear[2] = shown.underworld?.color[2] ?? 0;
356: 
357:   shown.color[0] = colorLinear[0];
358:   shown.color[1] = colorLinear[1];
359:   shown.color[2] = colorLinear[2];
360:   shown.start = fog.start;
361:   shown.density = density;
362:   shown.cap = fog.cap;
363:   shown.height = fog.height;
364: 
365:   // Either fog is reason enough for the pass: a map may have holes in its
366:   // ground and no haze at all.
367:   const want =
368:     post && (density > 0 || shown.underworld !== null) && effectMask() !== null;
369: 
370:   if (runtime && (!want || runtime.scene !== scene)) {
371:     disposeHeightFog();
372:     if (!want) return true;
373:   }
374: 
375:   if (runtime && upstreamChanged) {
376:     runtime.camera.detachPostProcess(runtime.fog);
377:     runtime.camera.attachPostProcess(runtime.fog);
378:     return true;
379:   }
380: 
381:   if (!want || runtime) return false;
382: 
383:   runtime = { scene, camera, fog: createFog(scene, camera) };
384: 
385:   return true;
386: }
387: 
388: /**
389:  * Per frame: the height reference follows the camera target so the height
390:  * term hugs the ground around the hero instead of a fixed sea level - maps
391:  * step up and down by tens of tiles.
392:  */
393: export function updateHeightFog(camera: ArcRotateCamera, dt: number): void {
394:   const targetY = camera.target.y;
395: 
396:   if (!fogBaseSeeded) {
397:     fogBaseY = targetY;
398:     fogBaseSeeded = true;
399:     return;
400:   }
401: 
402:   const k = Math.min(1, dt * FOG_BASE_EASE);
403: 
404:   fogBaseY += (targetY - fogBaseY) * k;
405: }
</file>

<file path="src/scenes/shadows.ts">
  1: import {
  2:   CascadedShadowGenerator,
  3:   Frustum,
  4:   Material,
  5:   Plane,
  6:   ShadowGenerator,
  7:   type AbstractMesh,
  8:   type DirectionalLight,
  9:   type Effect,
 10:   type RenderTargetTexture,
 11:   type Scene,
 12:   type ShaderMaterial,
 13: } from '../libs/babylon/exports';
 14: import { GameOptions } from '../common/gameOptions';
 15: import { devQueryNumber } from '../common/devSeams';
 16: import { toonTerrainDefines } from '../common/renderingStyle';
 17: import { sunLightOf } from '../lighting/keyRig';
 18: import {
 19:   blobShadowRefresh,
 20:   csmState,
 21:   type LightingTier,
 22: } from '../common/lightingQuality';
 23: import type { ShadowCasters, ShadowPolicy } from '../lighting/shadowPolicy';
 24: import { driveRenderList } from './renderList';
 25: 
 26: /**
 27:  * The cascaded shadow map on the sun: sole owner of the
 28:  * `CascadedShadowGenerator` (ARCHITECTURE §4.1), and the terrain's hook into
 29:  * it. Reads the `ShadowPolicy` the director hands it; `csm.darkness` is 0 (a
 30:  * shadow removes the sun and nothing else, §3.2) and the terrain floor is
 31:  * `1 - strength`, the sky share, applied in linear by the terrain shader.
 32:  */
 33: 
 34: export const CSM_MAX_CASCADES = 3;
 35: 
 36: /**
 37:  * How far from the camera the cascades reach, in tiles. The camera sits
 38:  * ~10 tiles from the hero looking down, so the visible ground ends well
 39:  * inside this; a low lambda keeps the first cascade (the one under the hero)
 40:  * wide enough to hold the whole play area at full resolution.
 41:  */
 42: const CSM_MAX_Z = 32;
 43: 
 44: /**
 45:  * The reach inside a room (`casters: 'all'`): the far wall of the pub or the
 46:  * reading room is under 20 tiles from the camera, so the map is spent on the
 47:  * room instead of on the black past its walls. The fewest cascades the
 48:  * generator takes cover it: the room's furniture is drawn twice into the map
 49:  * rather than three times, and 20 tiles over 2048 texels is still 100 texels
 50:  * a tile.
 51:  */
 52: const CSM_ROOM_MAX_Z = 20;
 53: const CSM_ROOM_CASCADES = CascadedShadowGenerator.MIN_CASCADES_COUNT;
 54: 
 55: const CSM_LAMBDA = 0.1;
 56: 
 57: /**
 58:  * Constant bias is a fraction of a cascade's depth range (~20 tiles for the
 59:  * first), so 0.004 was 8 cm and lifted every shadow off its caster's feet;
 60:  * the normal bias (world units) carries the self-shadowing instead.
 61:  */
 62: const CSM_BIAS = 0.0006;
 63: const CSM_NORMAL_BIAS = 0.03;
 64: const CSM_BLEND = 0.08;
 65: 
 66: const biasDev = devQueryNumber('csmBias');
 67: const normalBiasDev = devQueryNumber('csmNormalBias');
 68: const softnessDev = devQueryNumber('csmSoftness');
 69: const cascadesDev = devQueryNumber('csmCascades');
 70: const mapSizeDev = devQueryNumber('csmMapSize');
 71: const refreshDev = devQueryNumber('csmRefresh');
 72: const minCasterDev = devQueryNumber('csmMinCaster');
 73: 
 74: type Runtime = {
 75:   scene: Scene;
 76:   tier: LightingTier;
 77:   csm: CascadedShadowGenerator | null;
 78:   /** `GameOptions.shadows` as of the last sync. */
 79:   shadows: boolean;
 80: };
 81: 
 82: let runtime: Runtime | null = null;
 83: 
 84: /** The terrain's bake floor under a sun shadow: the sky share, linear. */
 85: let terrainFloor = 1;
 86: 
 87: /** Who the render-list predicate admits; the policy's, as of the last sync. */
 88: let casters: ShadowCasters = 'dynamic';
 89: 
 90: // --- terrain hook ----------------------------------------------------------
 91: 
 92: export const TERRAIN_CSM_UNIFORMS = [
 93:   'csmParams',
 94:   'csmLightMatrices',
 95:   'csmFrustumZ',
 96:   'csmMapSize',
 97: ] as const;
 98: 
 99: const terrainMaterials = new Set<ShaderMaterial>();
100: 
101: /**
102:  * The terrain shader is compiled per lighting state: no shadow sampler at
103:  * all while Classic, one of the two otherwise. Every declared sampler must
104:  * be bound - an unset one defaults to unit 0, which another sampler of a
105:  * different type already uses, and that is a GL draw error (the terrain
106:  * renders flat). Switching the define recompiles the material.
107:  */
108: export function terrainCsmDefines(): string[] {
109:   const defines = [`#define CSM_MAX_CASCADES ${CSM_MAX_CASCADES}`];
110: 
111:   const csm = runtime?.csm;
112: 
113:   if (csm) {
114:     defines.push(
115:       csm.filter === ShadowGenerator.FILTER_NONE
116:         ? '#define CSM_FLOAT'
117:         : '#define CSM_PCF'
118:     );
119:   }
120: 
121:   return defines;
122: }
123: 
124: export function registerTerrainMaterial(material: ShaderMaterial): void {
125:   terrainMaterials.add(material);
126:   material.onDisposeObservable.addOnce(() => terrainMaterials.delete(material));
127: }
128: 
129: /** What the ground and the grass compile: the cascades' defines and the style's (`terrainLightDefines`). */
130: function terrainDefines(): string[] {
131:   return [...terrainCsmDefines(), ...toonTerrainDefines()];
132: }
133: 
134: let compiledTerrainDefines = '';
135: 
136: function recompileTerrainMaterials(): void {
137:   const defines = terrainDefines();
138: 
139:   compiledTerrainDefines = defines.join();
140: 
141:   for (const material of terrainMaterials) {
142:     material.options.defines = [...defines];
143:     material.markDirty(true);
144:   }
145: }
146: 
147: /**
148:  * Recompiles the ground and the grass when the style's defines moved; the
149:  * cascades' own changes come through `invalidate`. One compare a tick.
150:  */
151: export function syncTerrainDefines(): void {
152:   if (terrainDefines().join() !== compiledTerrainDefines) {
153:     recompileTerrainMaterials();
154:   }
155: }
