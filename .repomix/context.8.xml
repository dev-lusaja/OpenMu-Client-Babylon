289: /** `CMuHelper::RecoverHealth`: heal, drain life, then the potion. */
290: function recoverHealth(world: World, hero: Entity, config: MuHelperConfig): boolean {
291:   const hpPercent = heroHpPercent();
292: 
293:   if (config.autoHeal && isLearned(HEAL_SKILL)) {
294:     if (config.autoHealParty && Social.partyMembers.length > 0) {
295:       const members = Social.partyMembers;
296:       const member = members[healPartyIndex % members.length];
297:       healPartyIndex = (healPartyIndex + 1) % members.length;
298:       if (member) {
299:         if (member.name === Store.playerData.name) {
300:           if (hpPercent <= config.healThreshold && castSkill(world, HEAL_SKILL, hero)) {
301:             return false;
302:           }
303:         } else if (
304:           member.mapId === world.mapIndex &&
305:           member.healthStep >= 0 &&
306:           member.healthStep * 10 <= config.healPartyThreshold
307:         ) {
308:           const target = findPartyEntity(world, member.name);
309:           if (
310:             target &&
311:             tileDistance(heroTile(hero), entityTile(target)) <= MAX_ACTIONABLE_DISTANCE &&
312:             castSkill(world, HEAL_SKILL, target)
313:           ) {
314:             return false;
315:           }
316:         }
317:       }
318:     } else if (hpPercent <= config.healThreshold && castSkill(world, HEAL_SKILL, hero)) {
319:       return false;
320:     }
321:   }
322: 
323:   if (
324:     config.useDrainLife &&
325:     isLearned(DRAIN_LIFE_SKILL) &&
326:     hpPercent <= config.healThreshold
327:   ) {
328:     const target = nearestTarget(world, hero, distanceByRange(config.huntingRange));
329:     if (target && castSkill(world, DRAIN_LIFE_SKILL, target)) return false;
330:   }
331: 
332:   if (config.useHealPotion && hpPercent <= config.potionThreshold) {
333:     const slot = findHealingPotionSlot();
334:     if (slot >= 0) Store.consumeItemRequest(slot);
335:   }
336: 
337:   return true;
338: }
