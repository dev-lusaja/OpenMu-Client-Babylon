264: function nearestTarget(world: World, hero: Entity, maxDistance: number): Entity | null {
265:   const from = heroTile(hero);
266:   let best: Entity | null = null;
267:   let bestDist = maxDistance + 1;
268:   for (const e of world.netObjsQuery.entities) {
269:     if (!isAttackableEntity(world, e)) continue;
270:     const dist = tileDistance(from, entityTile(e));
271:     if (dist < bestDist) {
272:       bestDist = dist;
273:       best = e;
274:     }
275:   }
276:   return best;
277: }
278: 
279: function countTargetsNearby(world: World, hero: Entity, maxDistance: number): number {
280:   const from = heroTile(hero);
281:   let count = 0;
282:   for (const e of world.netObjsQuery.entities) {
283:     if (!isAttackableEntity(world, e)) continue;
284:     if (tileDistance(from, entityTile(e)) <= maxDistance) count++;
285:   }
286:   return count;
287: }
