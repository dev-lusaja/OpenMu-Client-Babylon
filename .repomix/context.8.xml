<file path="src/quests/killCounters.ts">
  1: /**
  2:  * Monster kill counters for quests - the five `m_anKillMobType /
  3:  * m_anKillMobCount` slots of `CSQuest` that `LegacyQuestMonsterKillInfo`
  4:  * (0xA4) fills when a quest NPC is opened mid-quest, plus a client-side
  5:  * mirror that counts the hero's own kills between two server refreshes so
  6:  * the window's "12 / 20" line moves as the hero fights.
  7:  *
  8:  * Driven by the 0xA4 packet (authoritative, replaces the mirror) and by
  9:  * `experienceGained` (the hero landed a killing blow). Read by
 10:  * `legacyQuests.ts` (`CheckActCondition`) and the NPC quest window.
 11:  */
 12: import { observable, runInAction } from 'mobx';
 13: import { LegacyQuestMonsterKillInfoPacket } from '../common/packets/ServerToClientPackets';
 14: import { EventBus } from '../libs/eventBus';
 15: import { Store } from '../store';
 16: import type { QuestLayer } from './layer';
 17: 
 18: // ---- 1. tuning -------------------------------------------------------------
 19: 
 20: /** `QUEST_MONSTER_SLOT_COUNT`: the packet carries five monster/count pairs. */
 21: const KILL_SLOTS = 5;
 22: 
 23: /** Monster type used for an empty slot (`SetKillMobInfo(nullptr)`). */
 24: const EMPTY_SLOT = -1;
 25: 
 26: // ---- 2. state + readers ----------------------------------------------------
 27: 
 28: /** One `m_anKillMobType[i]` / `m_anKillMobCount[i]` pair. */
 29: export type KillSlot = { monsterType: number; count: number };
 30: 
 31: const state = observable({
 32:   slots: Array.from({ length: KILL_SLOTS }, (): KillSlot => ({ monsterType: EMPTY_SLOT, count: EMPTY_SLOT })),
 33:   /** Hero kills since the last 0xA4, by monster type. */
 34:   local: new Map<number, number>(),
 35: });
 36: 
 37: /** `GetKillMobCount(type)`: server count plus the local mirror; 0 when untracked. */
 38: export function legacyKillCount(monsterType: number): number {
 39:   const slot = state.slots.find(s => s.monsterType === monsterType);
 40:   const server = slot && slot.count >= 0 ? slot.count : 0;
 41:   return server + (state.local.get(monsterType) ?? 0);
 42: }
 43: 
 44: /** The five slots, for the window. */
 45: export function legacyKillSlots(): readonly KillSlot[] {
 46:   return state.slots;
 47: }
 48: 
 49: /** `SetKillMobInfo`: the server's counts replace everything. */
 50: function setKillInfo(pairs: { monsterType: number; count: number }[] | null): void {
 51:   runInAction(() => {
 52:     for (let i = 0; i < KILL_SLOTS; i++) {
 53:       const pair = pairs?.[i];
 54:       state.slots[i].monsterType = pair ? pair.monsterType : EMPTY_SLOT;
 55:       state.slots[i].count = pair ? pair.count : EMPTY_SLOT;
 56:     }
 57:     state.local.clear();
 58:   });
 59: }
 60: 
 61: EventBus.on('LegacyQuestMonsterKillInfo', packet => {
 62:   const p = new LegacyQuestMonsterKillInfoPacket(packet);
 63:   if (p.Result !== 0) {
 64:     setKillInfo(null);
 65:     return;
 66:   }
 67:   const kills = p.getKills(KILL_SLOTS).map(k => ({
 68:     monsterType: k.MonsterNumber,
 69:     count: k.KillCount,
 70:   }));
 71:   setKillInfo(kills);
 72: });
 73: 
 74: // The hero's killing blow: `experienceGained` carries the victim's net id,
 75: // which is still in scope for the death animation.
 76: EventBus.on('experienceGained', ({ killedNetId }) => {
 77:   const world = Store.world;
 78:   if (!world || killedNetId < 0) return;
 79: 
 80:   for (const entity of world.netObjsQuery) {
 81:     if (entity.netId !== killedNetId) continue;
 82:     const type = entity.npcType;
 83:     if (type === undefined) return;
 84:     runInAction(() => {
 85:       state.local.set(type, (state.local.get(type) ?? 0) + 1);
 86:     });
 87:     return;
 88:   }
 89: });
 90: 
 91: EventBus.on('CharacterInformation', () => setKillInfo(null));
 92: 
 93: function reset(): void {
 94:   // Counts belong to the character; only the in-scope mirror is per map.
 95:   runInAction(() => state.local.clear());
 96: }
 97: 
 98: // ---- 3. the layer ----------------------------------------------------------
 99: 
100: export const killCountersLayer: QuestLayer = { name: 'killCounters', reset };
</file>

