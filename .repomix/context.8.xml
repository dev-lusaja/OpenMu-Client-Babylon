 43: 
 44: /**
 45:  * `CheckSkull(o)` - Lost Tower types 38 (n=777, the skulls) and 39 (n=335,
 46:  * the loose stones), the only props on this map the player can touch.
 47:  * `MoveObject` routes both to it (ZzzObject.cpp:3949-3951); the function
 48:  * itself is ZzzEffectFireLeave.cpp:87-111.
 49:  *
 50:  * Walk or run within half a tile and the thing skitters away from you and
 51:  * tumbles, then coasts to a stop wherever it lands and stays there for the
 52:  * rest of the visit - nothing resets it, and the map file is never written
 53:  * back, so a corridor the player has walked twice is visibly disturbed.
 54:  * Reproducing that permanence is the point of the prop; a spring-back would
 55:  * turn the map's one interactive detail into a toy.
 56:  *
 57:  * A class rather than a table entry because this is genuinely per-object
 58:  * state: a position and an angular velocity that outlive the frame that set
 59:  * them, and a distance test that only one of the 1112 candidates passes.
 60:  *
 61:  * The original moves them from `MoveObject`, i.e. once per rendered frame,
 62:  * with only the position step scaled by `FPS_ANIMATION_FACTOR` - the 0.6
 63:  * decay and the angle step are raw, so a skull travels four times as far at
 64:  * 25 fps as at 100. That is a bug, not a design, and there is no frame rate at
 65:  * which it is "correct" other than the reference 25 (ZzzAI.cpp:729,
 66:  * `FPS_ANIMATION_FACTOR = REFERENCE_FPS / FPS`). So this runs on a fixed
 67:  * 25 Hz accumulator with the factor pinned at 1: identical to the original
 68:  * running at its design frame rate, and identical to itself at any of ours.
 69:  */
 70: export class LostTowerSkullObject extends MapTileObject {
 71:   #entity: Entity | null = null;
 72: 
 73:   /** `o->Direction` x/y in tiles per tick (z is always 0 here). */
 74:   #dirX = 0;
 75:   #dirY = 0;
 76: 
 77:   /** `o->HeadAngle[0]` and `[1]`, degrees per tick. */
 78:   #head0 = 0;
 79:   #head1 = 0;
 80: 
 81:   #due = 0;
 82:   #lastSeconds = -1;
 83: 
 84:   async init(world: World, entity: Entity) {
 85:     await super.init(world, entity);
 86: 
 87:     this.#entity = entity;
 88:   }
 89: 
 90:   dispose(): void {
 91:     this.#entity = null;
 92: 
 93:     super.dispose();
 94:   }
 95: 
 96:   Update(gameTime: World['gameTime']): void {
 97:     super.Update(gameTime);
 98: 
 99:     if (!this.Ready || !this.#entity?.transform) return;
100: 
101:     const seconds = gameTime.TotalGameTime.TotalSeconds;
102:     const delta = this.#lastSeconds < 0 ? 0 : seconds - this.#lastSeconds;
103:     this.#lastSeconds = seconds;
104: 
105:     this.#due += delta * TICKS_PER_SECOND;
106: 
107:     // A tab-out or a map load can leave an arbitrary gap; catching up on all
108:     // of it would teleport a skull mid-flight.
109:     if (this.#due > MAX_TICKS_PER_FRAME) this.#due = MAX_TICKS_PER_FRAME;
110: 
111:     while (this.#due >= 1) {
112:       this.#due -= 1;
113:       this.#tick();
114:     }
115:   }
116: 
117:   #tick(): void {
118:     const transform = this.#entity?.transform;
119: 
120:     if (!transform) return;
121: 
122:     const hero = Store.world?.playerEntity;
123: 
124:     // `Hero->Object.CurrentAction` between PLAYER_WALK_MALE and
125:     // PLAYER_RUN_RIDE_WEAPON, or one of the two Rage-uniform runs
126:     // (ZzzEffectFireLeave.cpp:90-91). Note this is a *narrower* test than
127:     // sound/footsteps': CheckSkull predates the two-handed-sword-two and
128:     // ride-horse clips and was never extended to them, so a player on a horse
129:     // walks through the bones without touching them. Kept as the original has
130:     // it - the alternative is inventing behaviour for actions the function has
131:     // never seen.
132:     if (hero && hero.worldIndex === this.WorldIndex) {
133:       const action = hero.playerAnimation.action;
134: 
135:       const moving =
136:         (action >= PlayerAction.PLAYER_WALK_MALE &&
137:           action <= PlayerAction.PLAYER_RUN_RIDE_WEAPON) ||
138:         action === PlayerAction.PLAYER_RAGE_UNI_RUN ||
139:         action === PlayerAction.PLAYER_RAGE_UNI_RUN_ONE_RIGHT;
140: 
141:       // The arming test is `o->Direction[0] < 0.1f` - one axis, one-sided, and
142:       // it is the original's. A skull kicked towards +x has a large positive
143:       // Direction[0] and is locked out until it decays; one kicked towards -x
144:       // has a negative Direction[0] and passes immediately, so it can be
145:       // punted again every tick while the player stands over it. That
146:       // asymmetry is visible in game (bones chase away from you in bursts on
147:       // one side, smoothly on the other) and is left alone: it is what the
148:       // prop feels like.
149:       if (moving && this.#dirX < KICK_ARM_DIRECTION_X) {
150:         const dx = hero.transform.pos.x - transform.pos.x;
151:         const dy = hero.transform.pos.z - transform.pos.z;
152: 
153:         if (Math.hypot(dx, dy) < KICK_RANGE) {
154:           this.#dirX = -dx * KICK_SPEED;
155:           this.#dirY = -dy * KICK_SPEED;
156:           this.#head1 = -dx * KICK_SPIN;
157:           this.#head0 = -dy * KICK_SPIN;
158: 
159:           // `PlayBuffer(SOUND_BONE2, o)` - Data/Sound/mBone2.wav
160:           // (ZzzOpenData.cpp:4572). playSfx carries the same distance
161:           // attenuation PlayBuffer's 3D listener gave it, and its per-key
162:           // throttle stands in for DirectSound's channel limit when a stride
163:           // catches three skulls at once.
164:           playSfx('Sound/mBone2', { x: transform.pos.x, z: transform.pos.z });
165:         }
166:       }
167:     }
168: 
169:     if (
170:       Math.abs(this.#dirX) < SLIDE_AT_REST &&
171:       Math.abs(this.#dirY) < SLIDE_AT_REST &&
172:       Math.abs(this.#head0) < SPIN_AT_REST &&
173:       Math.abs(this.#head1) < SPIN_AT_REST
174:     ) {
175:       return;
176:     }
177: 
178:     this.#dirX *= DECAY;
179:     this.#dirY *= DECAY;
180:     this.#head0 *= DECAY;
181:     this.#head1 *= DECAY;
182: 
183:     // MU x/y are the ground plane; the clone's is x/z. Position[2] never
184:     // changes (Direction[2] is always 0), so the skull keeps the height the
185:     // map file gave it and does not re-sample the terrain - it can and does
186:     // end up hanging slightly off a step it was kicked down.
187:     transform.pos.x += this.#dirX;
188:     transform.pos.z += this.#dirY;
189: 
190:     // `VectorAdd(o->Angle, o->HeadAngle, o->Angle)`, through the same axis
191:     // mapping createObjects uses on load (loadMapIntoScene.ts): rot.x is
192:     // -radians(Angle[0]) and rot.z is -radians(Angle[1]), hence the negation
193:     // and the swap. Angle[2] (yaw) is untouched - the skull tumbles, it does
194:     // not spin on the spot.
195:     transform.rot.x -= toRadians(this.#head0);
196:     transform.rot.z -= toRadians(this.#head1);
197:   }
198: }
</file>

