338: /** Load the three tables once; safe to call on every window open. */
339: export function ensureMasterTreeData(): Promise<void> {
340:   if (!loading) {
341:     loading = Promise.all([
342:       downloadDataFile('Local/MasterSkillTreeData.bmd'),
343:       downloadLocalDataFile('MasterSkillTooltip'),
344:       downloadDataFile('Local/Skill.bmd'),
345:     ])
346:       .then(([tree, tips, skill]) => {
347:         treeRecords = parseTree(tree);
348:         tooltipRecords = parseTooltips(tips);
349:         skillAttributes = parseSkillAttributes(skill);
350:         runInAction(() => {
351:           dataState.loaded = true;
352:         });
353:       })
354:       .catch(err => {
355:         loading = null;
356:         throw err;
357:       });
358:   }
359:   return loading;
360: }
