  1: /**
  2:  * Pure data shared by the skill entries: the buff table (icon, kind, name,
  3:  * best-effort duration) keyed by the wire effect id, and the skill delay
  4:  * table keyed by skill number. No state, no imports from entries.
  5:  *
  6:  * Buff ids: OpenMU's `MagicEffectNumber` is the original client's
  7:  * `eBuffState` (`_enum.h`), which is also the record index of
  8:  * `Data/Local/BuffEffect.bmd` (127 BUX-encrypted `_BUFFINFO` records,
  9:  * `w_BuffScriptLoader.cpp`) and the icon index of `newui_statusicon*.jpg`
 10:  * (`CNewUIBuffWindow::RenderBuffIcon`). `kind` is that file's
 11:  * `s_BuffClassType` (0 buff / 1 debuff); the names here are the enum's, the
 12:  * last fallback under the catalogue and the language pack (`buffNameFile.ts`)
 13:  * - the root `Local/BuffEffect.bmd` is Japanese, the per-language ones are not.
 14:  *
 15:  * Delays: `SkillAttribute[].Delay` from `Data/Local/Skill.bmd` (600 × 80-byte
 16:  * BUX records, `Delay` at offset 44, milliseconds) - every non-zero entry.
 17:  */
 18: 
 19: import { MAGIC_EFFECTS } from '../common/magicEffects';
 20: import { localisedBuffName } from '../libs/mu/buffNameFile';
 21: import { t } from '../i18n';
 22: 
 23: export type BuffKind = 'buff' | 'debuff';
 24: 
 25: export interface BuffRecipe {
 26:   name: string;
 27:   kind: BuffKind;
 28:   /**
 29:    * Seconds the effect lasts, from the hero's total energy, when the client
 30:    * can know it (the original prints the same formula in the skill tooltip).
 31:    * Missing = unknown: the bar shows the icon without a countdown.
 32:    */
 33:   durationSeconds?: (energy: number) => number;
