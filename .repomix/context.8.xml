<file path="src/maps/chaoscastle/arena.ts">
  1: import { TW_NOGROUND } from '../../common/terrain/consts';
  2: import { inChaosCastle } from '../../common/locomotion';
  3: import { BloodCastleStatePacket } from '../../common/packets/ServerToClientPackets';
  4: import { EventBus } from '../../libs/eventBus';
  5: import { sound } from '../../sound';
  6: import { Store } from '../../store';
  7: import type { World } from '../../ecs/world';
  8: import {
  9:   CHAOS_CASTLE_STAGES,
 10:   CHAOS_CASTLE_STAGE_STATES,
 11:   CHAOS_CASTLE_OUTER_RING,
 12: } from './spec';
 13: 
 14: /**
 15:  * The shrinking arena: `g_currentCastleLevel` + `SetActionObject(world, 1,
 16:  * 40, 1)` (CSChaosCastle.cpp / NewChaosCastleSystem.cpp:83-119) as one state
 17:  * machine for the map's ring objects.
 18:  *
 19:  * Driven by: the `BloodCastleState` packet, states 8/9/10 - each one closes
 20:  * the next `TW_NOGROUND` strip, plays `SOUND_CHAOS_FALLING_STONE`
 21:  * (`eWallFall`) and starts a 40-tick drop of the ring that just lost its
 22:  * floor: ten ticks of smoke and quake, then thirty ticks of accelerating fall
 23:  * (`Position[2] = Start - (30 - t) * v; v += 0.4`), then hidden
 24:  * (`MoveChaosCastleAllObject`, CSChaosCastle.cpp:226-338).
 25:  * Read by: `ChaosCastleRingObject` (visibility, drop height, smoke tick).
 26:  *
 27:  * The original gates each state on `m_byCurrCastleLevel`, which it derives
 28:  * from the kill count (`RenderMatchTimes`: 40 < kills <= 46 → 0, 30 < kills
 29:  * <= 36 → 3, 20 < kills <= 26 → 6) to survive a repeated packet. Here the
 30:  * guard is simply "this stage has not run yet", which is the same protection
 31:  * without the client second-guessing the server's count.
 32:  *
 33:  * Not here: the quake (`EarthQuake = -0.1…-0.3` while the smoke runs) - the
 34:  * clone has no camera-shake hook yet; and `RenderTerrainVisual`'s smoke on
 35:  * the tiles of the strip about to close (one tile in eight, every frame).
 36:  */
 37: 
 38: // ---- 1. tuning -------------------------------------------------------------
 39: 
 40: /** `SetActionObject(gMapManager.WorldActive, 1, 40, 1)`: ticks per drop. */
 41: const DROP_TICKS = 40;
 42: /** `kActionTriggerTime = 30`: the fall starts here; above it, smoke only. */
 43: const FALL_START_TICK = 30;
 44: /** `g_fActionObjectVelocity` starts at 1 cm/tick and grows 0.4 a tick. */
 45: const START_VELOCITY = 1;
 46: const VELOCITY_GAIN = 0.4;
 47: /** Reference tick, seconds. */
 48: const TICK = 1 / 25;
 49: 
 50: // ---- 2. state + readers ----------------------------------------------------
 51: 
 52: type Drop = {
 53:   types: ReadonlySet<number>;
 54:   ticksLeft: number;
 55:   velocity: number;
 56:   /** cm below the start position. */
 57:   offset: number;
 58: };
 59: 
 60: /** Stages completed so far (0..3). */
 61: let stage = 0;
 62: /** The ring currently on its way down, if any. */
 63: let drop: Drop | null = null;
 64: /** Rings that have already fallen and stay hidden. */
 65: const fallen = new Set<number>();
 66: /** Rings a stage has revealed. */
 67: const shown = new Set<number>();
 68: let accumulator = 0;
 69: /** Wall-clock stamp of the last tick, so many objects share one advance. */
 70: let lastNow = -1;
 71: 
 72: /** Whether a ring object of `type` should be drawn right now. */
 73: export function chaosCastleRingVisible(type: number): boolean {
 74:   if (fallen.has(type)) return false;
 75:   if (CHAOS_CASTLE_OUTER_RING.includes(type)) return true;
 76:   return shown.has(type);
 77: }
 78: 
 79: /** cm the ring of `type` has dropped so far (0 while it stands). */
 80: export function chaosCastleRingDrop(type: number): number {
 81:   return drop && drop.types.has(type) ? drop.offset : 0;
 82: }
 83: 
 84: /** True while `type` is in the smoke-and-quake lead-in of its drop. */
 85: export function chaosCastleRingSmoking(type: number): boolean {
 86:   return (
 87:     drop !== null && drop.types.has(type) && drop.ticksLeft > FALL_START_TICK
 88:   );
 89: }
 90: 
 91: /** Fresh arena on every warp in. Called from `createChaosCastle`. */
 92: export function resetChaosCastleArena(): void {
 93:   stage = 0;
 94:   drop = null;
 95:   fallen.clear();
 96:   shown.clear();
 97:   accumulator = 0;
 98:   lastNow = -1;
 99: }
100: 
101: function advance(world: World): void {
102:   const next = CHAOS_CASTLE_STAGES[stage];
103:   if (!next) return;
104:   stage++;
105: 
106:   for (const [x, y, w, h] of next.noGround) {
107:     world.setTerrainFlags(x, y, w, h, TW_NOGROUND, true);
108:   }
109:   for (const t of next.shows) shown.add(t);
110: 
111:   // A ring still falling when the next stage lands is simply gone.
112:   if (drop) for (const t of drop.types) fallen.add(t);
113: 
114:   drop = {
115:     types: new Set(next.falls),
116:     ticksLeft: DROP_TICKS,
117:     velocity: START_VELOCITY,
118:     offset: 0,
119:   };
120: 
121:   sound.play('Sound/eWallFall');
122: }
123: 
124: /**
125:  * Advance the drop by real time. Every ring object calls this from its
126:  * `Update`; the stamp makes the first caller in a frame do the work.
127:  */
128: export function updateChaosCastleArena(now: number, dt: number): void {
129:   if (now === lastNow) return;
130:   lastNow = now;
131: 
132:   if (!drop) return;
133: 
134:   accumulator += dt;
135:   while (accumulator >= TICK && drop) {
136:     accumulator -= TICK;
137:     drop.ticksLeft--;
138: 
139:     if (drop.ticksLeft > FALL_START_TICK) continue;
140: 
141:     if (drop.ticksLeft <= 0) {
142:       for (const t of drop.types) fallen.add(t);
143:       drop = null;
144:       break;
145:     }
146: 
147:     drop.offset = (FALL_START_TICK - drop.ticksLeft) * drop.velocity;
148:     drop.velocity += VELOCITY_GAIN;
149:   }
150: }
151: 
152: // ---- 3. the trigger --------------------------------------------------------
153: 
154: EventBus.on('BloodCastleState', packet => {
155:   const world = Store.world;
156:   if (!world || !inChaosCastle(world.mapIndex)) return;
157: 
158:   const p = new BloodCastleStatePacket(packet);
159:   const index = CHAOS_CASTLE_STAGE_STATES.indexOf(p.State as number);
160:   if (index < 0) return;
161: 
162:   // Each state maps to one stage and runs once, in order.
163:   if (index === stage) advance(world);
164: });
</file>

