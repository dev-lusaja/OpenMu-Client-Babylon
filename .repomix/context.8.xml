<file path="src/maps/lorencia/houseWallObject.ts">
 1: import { ModelObject } from '../../common/modelObject';
 2: import { MODEL_HOUSE_WALL01 } from '../../common/objects/enum';
 3: import { Rand } from '../../common/rand';
 4: import { World } from '../../ecs/world';
 5: import { Scalar } from '../../libs/babylon/exports';
 6: 
 7: export class HouseWallObject extends ModelObject {
 8:   _flickerEnabled = false;
 9:   _flickerAlpha = 1;
10:   _flickerStart = 1;
11:   _flickerTarget = 1;
12:   _flickerDur = 0;
13:   _flickerElapsed = 0;
14: 
15:   async init(world: World) {
16:     await this.loadSpecificModelWithDynamicID(MODEL_HOUSE_WALL01, 'HouseWall');
17: 
18:     const idx = this.Type - MODEL_HOUSE_WALL01 + 1;
19: 
20:     if (idx === 2) {
21:       this._flickerEnabled = true;
22:       this._flickerStart = 1;
23:       this._flickerTarget = Rand.nextFloat(0.85, 1);
24:       this._flickerDur = Rand.nextFloat(0.1, 0.2);
25:       this._flickerElapsed = 0;
26:     }
27:   }
28: 
29:   Update(gameTime: World['gameTime']): void {
30:     super.Update(gameTime);
31: 
32:     if (this._flickerEnabled) {
33:       const dt = gameTime.TotalGameTime.TotalSeconds;
34:       this._flickerElapsed += dt;
35: 
36:       if (this._flickerElapsed >= this._flickerDur) {
37:         this._flickerStart = this._flickerTarget;
38:         this._flickerTarget = Rand.nextFloat(0.85, 1);
39:         this._flickerDur = Rand.nextFloat(0.1, 0.2);
40:         this._flickerElapsed = 0;
41:       }
42: 
43:       const t = Scalar.Clamp(this._flickerElapsed / this._flickerDur, 0, 1);
44:       const smoothStep = t * t * (3 - 2 * t);
45:       this._flickerAlpha = Scalar.Lerp(
46:         this._flickerStart,
47:         this._flickerTarget,
48:         smoothStep
49:       );
50:     }
51:   }
52: 
53:   DrawMesh(mesh: number): void {
54:     super.DrawMesh(mesh);
55: 
56:     if (this._flickerEnabled && mesh === this.BlendMesh) {
57:       const m = this.getMesh(mesh);
58: 
59:       if (m?.metadata) {
60:         m.metadata.blendMeshLight = this._flickerAlpha;
61:       }
62:     }
63:   }
64: }
</file>

