 2: import type { Entity, World } from '../../ecs/world';
 3: 
 4: /**
 5:  * `o->Velocity = 0.05f` (ZzzObject.cpp:4033). `Velocity` *is* the play speed
 6:  * of a map object: `PlayAnimation` is called with `fSpeed = o->Velocity`
 7:  * (:3676), in BMD keys per 25 Hz reference tick - the same units as
 8:  * `ModelObject.AnimationSpeed` (see common/playSpeed.ts). `CreateObject`
 9:  * hands every object 0.16 (:4470), so this is the anemone running at just
10:  * under a third of the speed of the kelp around it.
11:  */
12: const ANEMONE_PLAY_SPEED = 0.05;
13: 
14: /**
15:  * Atlans 40 (ZzzObject.cpp:4030-4034), ×86. The blend mesh and its breathing
16:  * `BlendMeshLight` are table data (`spec.ts` and `meshAnimation.ts`); the
17:  * only thing that needs an object is the play-speed override.
18:  *
19:  * `setAnimationSpeed` rather than a plain assignment: `MapTileObject.init`
20:  * has already loaded the model by the time this runs, and `loadGLTF` starts
21:  * clip 0 looping on load (modelLoader.ts:471-481). A plain write to
22:  * `AnimationSpeed` only reaches the next `playAction`, which for a
23:  * single-action map object never comes.
24:  *
25:  * The absolute value matters more than the ratio here: `AnimationSpeed`
26:  * defaults to 0.28, the *player* idle speed, where every map object should
27:  * start at the original's 0.16 - so the rest of the map currently animates
28:  * ~1.75x fast. Writing 0.05 sets what the C++ sets and is unaffected by that
29:  * shared-code fix when it lands.
30:  */
31: export class AtlansAnemoneObject extends MapTileObject {
32:   async init(world: World, entity: Entity): Promise<void> {
33:     await super.init(world, entity);
34: 
35:     this.setAnimationSpeed(ANEMONE_PLAY_SPEED);
36:   }
37: }
</file>

<file path="src/maps/atlans/bubbleVentObject.ts">
  1: import { MapTileObject } from '../../common/mapTileObject';
  2: import { ParticleEmitter, type Emission } from '../../common/effectParticles';
  3: import type { Entity, World } from '../../ecs/world';
  4: 
  5: /** `FPS_ANIMATION_FACTOR` normalises per-frame work to REFERENCE_FPS (ZzzAI.cpp:729). */
  6: const TICKS_PER_SECOND = 25;
  7: 
  8: /** `o->Timer += 0.1f * FPS_ANIMATION_FACTOR` per 25 Hz tick (ZzzObject.cpp:4009). */
  9: const TIMER_PER_TICK = 0.1;
 10: 
 11: /** `if (o->Timer > 10.f) o->Timer = 0.f` (:4010) - 100 ticks, 4 s at the reference rate. */
 12: const TIMER_WRAP = 10;
 13: 
 14: /** `if (o->Timer > 5.f) CreateParticleFpsChecked(...)` (:4011) - emits over the second half. */
 15: const TIMER_EMIT_ABOVE = 5;
 16: 
 17: /**
 18:  * The vent's bubbles. `BITMAP_BUBBLE` is `Object8/drop01.jpg`
 19:  * (MapManager.cpp:40) drawn as a nine-frame flipbook, spawned at SubType 0:
 20:  * `LifeTime 30+rand%10`, `Scale (rand%6+4)*0.03` - 0.12-0.27 of a 64 px
 21:  * sprite, so 8-17 world units across - and per tick
 22:  * `Position += (rand%20-10)*2.5*Scale` on X/Y with `(rand%20+10)*2.5*Scale`
 23:  * on Z: a small dot that wobbles as it climbs (ZzzEffectParticle.cpp:196,
 24:  * :4145).
 25:  *
 26:  * **There is no bubble kind in `effectParticles.ts` and this file cannot add
 27:  * one.** `smoke65` is the closest available: additive, grey, scale-aware,
 28:  * rising with a lateral sway, 45 ticks of life. At `scale` 0.5 it lands on
 29:  * 10-20 world units, which is the right size; what it is not is round, and it
 30:  * fades instead of popping. It also fixes its own colour (`lum * 0.4` grey),
 31:  * so no `light` is passed here - it would be ignored. The kind that should
 32:  * exist is:
 33:  *
 34:  * ```ts
 35:  * // TEXTURES: bubble: { file: 'Object8/drop01.OZJ', size: 64, frames: 9 },
 36:  * //   drop01 is a 3x3 flipbook inside a 4x4 UV grid - the renderer picks
 37:  * //   (Frame%3, Frame/3) * 0.25 (ZzzEffectParticle.cpp:8945) - so either the
 38:  * //   TEXTURES entry needs a cell remap [0,1,2,4,5,6,8,9,10] or the sprite
 39:  * //   manager needs cellWidth = cellHeight = size/4 with frames = 11.
 40:  * bubble: {
 41:  *   texture: 'bubble',
 42:  *   blend: 'add',
 43:  *   init(p, scale) {
 44:  *     p.lifeTime = 30 + rand(10);
 45:  *     p.scale = (rand(6) + 4) * 0.03 * scale;
 46:  *     p.frames = 9;
 47:  *   },
 48:  *   update(p, f) {
 49:  *     p.frame++;
 50:  *     p.px += (rand(20) - 10) * 2.5 * p.scale * f;
 51:  *     p.py += (rand(20) - 10) * 2.5 * p.scale * f;
 52:  *     p.pz += (rand(20) + 10) * 2.5 * p.scale * f;
 53:  *     p.lr = p.lg = p.lb = 1;
 54:  *   },
 55:  *   color: plainColor,
 56:  * } satisfies ParticleKind,
 57:  * ```
 58:  *
 59:  * `every: 5` rather than the original's every tick is a budget decision, not
 60:  * a taste one. EncTerrain8.obj places 845 vents and puts 160 of them inside
 61:  * the 32-tile load radius at the worst spot; effect-only objects are meshless
 62:  * so `updateFrustumVisibility` can never mark them `OutOfView` and they all
 63:  * emit whether or not the camera is pointed at them. One bubble per tick each
 64:  * would ask for ~2000 spawns a second against a 2048-sprite pool with a 1.8 s
 65:  * lifetime - the pool would be exhausted and which vent won would be down to
 66:  * iteration order. One per five ticks holds the worst case near 700 live
 67:  * sprites, and a vent puffing five bubbles a second still reads as a vent.
 68:  */
 69: const BUBBLES: readonly Emission[] = [
 70:   { kinds: ['smoke65'], every: 5, scale: 0.5 },
 71: ];
 72: 
 73: /**
 74:  * Atlans 22 (ZzzObject.cpp:4007-4012): a hidden marker that vents bubbles for
 75:  * two seconds in every four. 845 of them line the trenches, the palace
 76:  * courtyards and the reef walls, sitting 0-4 tiles above the seabed.
 77:  *
 78:  * The timer is reproduced in the original's own units rather than as a phase
 79:  * of `WorldTime`, because it is *per object*: `o->Timer` starts at 0 when the
 80:  * object is created, so a field of vents that streamed in as the player
 81:  * walked toward it never breathes in unison. A `WorldTime % 4000` window
 82:  * would have every vent on the map pulse together.
 83:  */
 84: export class AtlansBubbleVentObject extends MapTileObject {
 85:   #emitter: ParticleEmitter | null = null;
 86: 
 87:   #timer = 0;
 88: 
 89:   /** Previous `TotalGameTime`; `gameTime` carries no per-frame delta. */
 90:   #lastSeconds = -1;
 91: 
 92:   async init(world: World, entity: Entity): Promise<void> {
 93:     await super.init(world, entity);
 94: 
 95:     this.#emitter = new ParticleEmitter(
 96:       world.scene,
 97:       BUBBLES,
 98:       this.node.position,
 99:       this.node.rotation.y,
100:       this.node.scaling.x
101:     );
102:   }
103: 
104:   dispose(): void {
105:     this.#emitter = null;
106:     super.dispose();
107:   }
108: 
109:   Update(gameTime: World['gameTime']): void {
110:     super.Update(gameTime);
111: 
112:     const emitter = this.#emitter;
113:     if (!emitter) return;
114: 
115:     const seconds = gameTime.TotalGameTime.TotalSeconds;
116:     const delta = this.#lastSeconds < 0 ? 0 : seconds - this.#lastSeconds;
117:     this.#lastSeconds = seconds;
118: 
119:     // The emitter accumulates from its own delta, so leaving it un-ticked for
120:     // the silent half of the cycle is exactly "no bubbles" - no catch-up
121:     // burst when it resumes (ParticleEmitter clamps its backlog at 4 ticks).
122:     this.#timer += TIMER_PER_TICK * delta * TICKS_PER_SECOND;
123: 
124:     if (this.#timer > TIMER_WRAP) this.#timer = 0;
125: 
126:     if (this.#timer > TIMER_EMIT_ABOVE) emitter.update();
127:   }
128: }
</file>

