  1: import { OperateBoxObject } from '../../common/operateBoxObject';
  2: import { toRadians } from '../../common/utils';
  3: import type { World } from '../../ecs/world';
  4: import { Vector3 } from '../../libs/babylon/exports';
  5: import type { ModelObject } from '../../common/modelObject';
  6: import {
  7:   NoriaWarpHalo2Object,
  8:   NoriaWarpHalo3Object,
  9:   NoriaWarpHaloObject,
 10:   warpRingScale,
 11: } from './warpGateObject';
 12: 
 13: /**
 14:  * Noria (WD_3NORIA, World4 / Object4).
 15:  *
 16:  * Almost all of this map is data: the blend meshes, the lamp sprites and the
 17:  * forge live in `spec.ts` and reach the engine through the shared registries,
 18:  * and the UV scrolls for 18/41/42/43 are already in `meshAnimation.ts`. What
 19:  * is left here is the one operate box and the warp gate, which the original
 20:  * builds from `MapManager` rather than from EncTerrain4.obj.
 21:  *
 22:  * Deliberately not built (all verified against the reference, not assumed):
 23:  *  - Types 11-16 and 22/23/26/27/34/36 are the animated grass, flowers and
 24:  *    trees. Their sway is a BMD bone animation the converter already baked
 25:  *    into the GLB clips, so `MapTileObject` plays it with no help.
 26:  *  - Type 24 (the 6x6x7 big tree), 30 (the wooden bridge) and 31-33 (rocks)
 27:  *    have no case in `CreateObject`, `MoveObject` or `RenderObjectVisual` -
 28:  *    they are plain props.
 29:  *  - The water tiles are terrain layer 5 on the generic scroll; Noria adds no
 30:  *    terrain code of its own.
 31:  *  - `Music/Noria`, the `Sound/aWind` bed and the 1-in-512 `Sound/aForest`
 32:  *    one-shot are already wired in sound/music.ts / sound/ambientBeds.ts.
 33:  *  - Falling leaves are already Noria's: `LEAF_MAPS` in
 34:  *    ambientParticleSystem.ts lists WD_3NORIA next to Lorencia and Atlans.
 35:  *  - The 40 butterflies (`Object1/Butterfly01`, MapManager.cpp:88) need a
 36:  *    boid flock the clone has no equivalent of. Future work, not faked.
 37:  *  - The sit spot (type 8) and the healing spot (type 38) are already routed:
 38:  *    `restObjects.ts` maps them to sit/healing and `cursorSystem` picks the
 39:  *    rest cursor off `findRestObject`, so type 38 needs only its box below.
 40:  */
 41: export async function createNoria(world: World) {
 42:   const terrain = world.terrain;
 43:   if (!terrain) return;
 44: 
 45:   const tiles = terrain.MapTileObjects;
 46: 
 47:   /**
 48:    * Noria 38: `CreateOperate(o)` + `o->HiddenMesh = -2` (ZzzObject.cpp:4703),
 49:    * and - unlike every other operate box in the game - with no
 50:    * `BoundingBoxMax` override anywhere in the Noria block, so it keeps
 51:    * `CreateObject`'s default `(40, 40, 80)`. That is `OperateBoxObject`, not
 52:    * `LeanBoxObject`: the taller (40, 40, 160) variant belongs to the
 53:    * lean-on-a-wall poses, and this is the healing spot you sit down on.
 54:    */
 55:   tiles[38] = OperateBoxObject;
 56: 
 57:   createWarpGate(world);
 58: }
 59: 
 60: /**
 61:  * `MapManager.cpp:100-103`, the Noria arm of the warp-gate block: one gate at
 62:  * tile (223, 30), angle `(0, 0, 10)`, from `Data/Npc/warp01..03.bmd` - all
 63:  * three are staged as `NPC/warp0N.glb`.
 64:  *
 65:  * `CreateObject` (ZzzObject.cpp:4675-4693) turns that single record into five
 66:  * stacked effects at `z + 350`, offset along Y by 0, 4, 8, 12 and 20, in the
 67:  * order warp01, warp02, warp01, warp02, warp03. The base object is skipped -
 68:  * see the note in warpGateObject.ts: the original leaves its Z at 0 and buries
 69:  * it under 1.80 tiles of terrain.
 70:  */
 71: function createWarpGate(world: World): void {
 72:   /** `Pos[0] = 223 * TERRAIN_SCALE; Pos[1] = 30 * TERRAIN_SCALE;` */
 73:   const tileX = 223;
 74:   const tileY = 30;
 75: 
 76:   /** `Position[2] + 350.f`, in tiles. The gate floats; no terrain lookup. */
 77:   const height = 3.5;
 78: 
 79:   /** `Vector(0.f, 0.f, 10.f, Ang)` - `Angle[2]` is the MU yaw. */
 80:   const yaw = toRadians(10);
 81: 
 82:   const stack: {
 83:     factory: typeof ModelObject;
 84:     offsetY: number;
 85:     scale: number;
 86:   }[] = [
 87:     { factory: NoriaWarpHaloObject, offsetY: 0, scale: warpRingScale() },
 88:     { factory: NoriaWarpHalo2Object, offsetY: 4, scale: warpRingScale() },
 89:     { factory: NoriaWarpHaloObject, offsetY: 8, scale: warpRingScale() },
 90:     { factory: NoriaWarpHalo2Object, offsetY: 12, scale: warpRingScale() },
 91:     // `o->Scale = 0.6f` for MODEL_WARP3 (ZzzEffect.cpp:556).
 92:     { factory: NoriaWarpHalo3Object, offsetY: 20, scale: 0.6 },
 93:   ];
 94: 
 95:   for (const { factory, offsetY, scale } of stack) {
 96:     world.add({
 97:       worldIndex: world.mapIndex,
 98:       transform: {
 99:         // The Y offsets are in MU units, so 4…20 is 0.04…0.20 of a tile -
100:         // the copies are meant to sit almost inside one another and beat
101:         // against each other as they spin at different rates.
102:         pos: new Vector3(tileX, height, tileY + offsetY / world.terrainScale),
103:         // Matches what createObjects builds for a map record: MU-positive yaw
104:         // in `rot.y`, flipped once by `toRenderAngles`.
105:         rot: new Vector3(0, yaw, 0),
106:         scale,
107:       },
108:       modelFactory: factory,
109:       visibility: {
110:         state: 'hidden',
111:         lastChecked: 0,
112:       },
113:     });
114:   }
115: }
</file>

