159: function findPartyEntity(world: World, name: string): Entity | null {
160:   if (name === Store.playerData.name) return world.playerEntity ?? null;
161:   for (const e of world.playersQuery.entities) {
162:     if (e.objectNameInWorld === name && !e.dying) return e;
163:   }
164:   return null;
165: }
