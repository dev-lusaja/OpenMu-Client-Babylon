 5:  * The two per-object settings the later worlds' `MoveObject` cases write
 6:  * over and over - `o->Alpha = k` and `o->Velocity = k` - as parameterised
 7:  * classes, so a map's `index.ts` can say `tiles[41] = AlphaObject.at(0.5)`
 8:  * instead of declaring a subclass per type per map.
 9:  *
10:  * `MapTileObjects` is an array of constructors (`modelFactory`), so `at()`
11:  * returns a fresh subclass with the value baked in; the same value gives the
12:  * same class back, which keeps the factory identity stable for the ECS.
13:  */
14: 
15: const alphaClasses = new Map<number, typeof MapTileObject>();
16: const speedClasses = new Map<number, typeof MapTileObject>();
17: 
18: /**
19:  * `o->Alpha = k` (e.g. Aida 41, Kanturu 76/96, Crywolf 81, Balgas 78): a
20:  * translucent map object. `setAlpha` writes `mesh.visibility`, which is what
21:  * the original's per-mesh `Alpha` does in `RenderMesh`.
22:  */
23: export class AlphaObject extends MapTileObject {
24:   /** Subclass with `alpha` baked in. */
25:   static at(alpha: number): typeof MapTileObject {
26:     let cls = alphaClasses.get(alpha);
27:     if (!cls) {
28:       cls = class extends AlphaObject {
29:         protected alpha(): number {
30:           return alpha;
31:         }
32:       };
33:       alphaClasses.set(alpha, cls);
34:     }
35:     return cls;
36:   }
37: 
38:   protected alpha(): number {
39:     return 1;
40:   }
41: 
42:   async init(world: World, entity: Entity): Promise<void> {
43:     await super.init(world, entity);
44:     this.setAlpha(this.alpha());
45:   }
46: }
47: 
48: /**
49:  * `o->Velocity = k`: the play speed of a map object in BMD keys per 25 Hz
50:  * tick, the same units as `ModelObject.AnimationSpeed` (see
51:  * maps/atlans/anemoneObject.ts for why `setAnimationSpeed` and not a plain
52:  * assignment). `CreateObject` gives every object 0.16.
53:  */
54: export class PlaySpeedObject extends MapTileObject {
55:   /** Subclass with `speed` baked in. */
56:   static at(speed: number): typeof MapTileObject {
57:     let cls = speedClasses.get(speed);
58:     if (!cls) {
59:       cls = class extends PlaySpeedObject {
60:         protected playSpeed(): number {
61:           return speed;
62:         }
63:       };
64:       speedClasses.set(speed, cls);
65:     }
66:     return cls;
67:   }
68: 
69:   protected playSpeed(): number {
70:     return 0.16;
71:   }
72: 
73:   async init(world: World, entity: Entity): Promise<void> {
74:     await super.init(world, entity);
75:     this.setAnimationSpeed(this.playSpeed());
76:   }
77: }
</file>

