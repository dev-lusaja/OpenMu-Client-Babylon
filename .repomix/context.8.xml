437: /**
438:  * Same snapshot problem as the two dialogue windows: the step's words are
439:  * copied into `state` when the window opens, so an open window has to be
440:  * refilled from the tables a language change fetched. `mode` and `busy` are
441:  * left alone - the player is mid-conversation and did not step anywhere.
442:  */
443: reaction(
444:   () => questDataReady(),
445:   ready => {
446:     if (!ready || !state.progressOpen) return;
447:     const text = progressText(state.currentKey);
448:     runInAction(() => {
449:       state.npcLines = text.npcLines;
450:       state.playerLines = text.playerLines;
451:       state.answers = text.answers;
452:     });
453:   }
454: );
