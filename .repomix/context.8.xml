380: /** `SetMasterSkillTreeData`: the nodes of the hero's tree, in index order. */
381: export function masterTreeEntries(): MasterTreeEntry[] {
382:   const code = masterTreeClass();
383:   if (!code) return [];
384:   return treeRecords.filter(e => (e.classCode & code) !== 0);
385: }
386: 
387: function entryByIndex(index: number): MasterTreeEntry | undefined {
388:   return masterTreeEntries().find(e => e.index === index);
389: }
390: 
391: function entryBySkill(skill: number): MasterTreeEntry | undefined {
392:   return masterTreeEntries().find(e => e.skill === skill);
393: }
394: 
395: /** `SetMasterSkillToolTipData`: the tooltip strings of a node. */
396: export function masterSkillTooltip(skill: number): MasterSkillTooltip | undefined {
397:   const code = masterTreeClass();
398:   return tooltipRecords.find(t => t.skill === skill && (t.classCode & code) !== 0);
399: }
400: 
401: /** What the server said about the node, level 0 when nothing yet. */
402: export function masterSkillInfo(entry: MasterTreeEntry): MasterSkillInfo {
403:   return (
404:     infoBySkill.get(entry.skill) ??
405:     infoByIndex.get(entry.index) ?? { level: 0, value: 0, nextValue: 0 }
406:   );
407: }
408: 
409: /** The learned level of a master skill by number, 0 when not learned. */
410: export function masterSkillLevel(skill: number): number {
411:   const bySkill = infoBySkill.get(skill);
412:   if (bySkill) return bySkill.level;
413:   const entry = entryBySkill(skill);
414:   return entry ? (infoByIndex.get(entry.index)?.level ?? 0) : 0;
415: }
416: 
417: /** `CategoryPoint`: levels spent in each of the three groups. */
418: export function masterCategoryPoints(): number[] {
419:   const points = new Array<number>(MASTER_GROUPS).fill(0);
420:   for (const entry of masterTreeEntries()) {
421:     points[entry.group] += masterSkillInfo(entry).level;
422:   }
423:   return points;
424: }
425: 
426: /** The atlas cell of a master skill's icon (`Magic_Icon`, 25 per row). */
427: export function masterSkillIconCell(skill: number): { x: number; y: number } {
428:   const icon = skillAttributes[skill]?.icon ?? 0;
429:   return {
430:     x: (icon % MASTER_ICONS_PER_ROW) * MASTER_ICON_WIDTH,
431:     y: Math.floor(icon / MASTER_ICONS_PER_ROW) * MASTER_ICON_HEIGHT,
432:   };
433: }
434: 
435: function isMasterSkill(skill: number): boolean {
436:   return skill >= MASTER_SKILL_FIRST && skill <= MASTER_SKILL_LAST;
437: }
438: 
439: /** `CheckParentSkill`: every required master skill is at level 10. */
440: export function masterParentsMet(entry: MasterTreeEntry): boolean {
441:   for (const required of entry.requireSkills) {
442:     if (!required || !isMasterSkill(required)) return true;
443:     if (masterSkillLevel(required) < RANK_UNLOCK_LEVEL) return false;
444:   }
445:   return true;
446: }
447: 
448: /** `skillPoint[group][rank]`: the highest level among a rank's nodes. */
449: function rankTopLevel(group: number, rank: number): number {
450:   let top = 0;
451:   for (const entry of masterTreeEntries()) {
452:     if (entry.group === group && entry.rank === rank) {
453:       top = Math.max(top, masterSkillInfo(entry).level);
454:     }
455:   }
456:   return top;
457: }
458: 
459: /** `CheckRankPoint`: rank 1 is open; rank N needs a level-10 node in N-1. */
460: export function masterRankMet(entry: MasterTreeEntry): boolean {
461:   if (entry.rank === 1) return true;
462:   return rankTopLevel(entry.group, entry.rank - 1) >= RANK_UNLOCK_LEVEL;
463: }
464: 
465: /**
466:  * `CheckBeforeSkill`: a strengthener's base skill (`SkillBrand`) must be
467:  * learned before the first point, unless the base is innate (use type 4).
468:  */
469: export function masterBaseSkillMet(entry: MasterTreeEntry): boolean {
470:   if (masterSkillInfo(entry).level > 0) return true;
471:   const brand = skillAttributes[entry.skill]?.brand ?? 0;
472:   if (!brand) return true;
473:   if (skillAttributes[brand]?.useType === SKILL_USE_TYPE_INNATE) return true;
474:   return Store.skills.some(s => s.number === brand);
475: }
476: 
477: /**
478:  * `IsNonWeaponSkillOrIsSkillEquipped`: a strengthener of a weapon skill
479:  * needs that weapon in hand.
480:  */
481: export function masterEquipmentMet(entry: MasterTreeEntry): boolean {
482:   const brand = skillAttributes[entry.skill]?.brand ?? 0;
483:   if (!brand || !isWeaponSkill(brand)) return true;
484:   return skillRequirementsMet(brand);
485: }
486: 
487: /** `RenderIcon`'s colour test: every gate but the point cost passes. */
488: export function masterSkillOpen(entry: MasterTreeEntry): boolean {
489:   return (
490:     masterParentsMet(entry) &&
491:     masterRankMet(entry) &&
492:     masterBaseSkillMet(entry) &&
493:     masterEquipmentMet(entry)
494:   );
495: }
496: 
497: /**
498:  * `CheckAttributeArea`'s refusals, in its order; `null` when a point can be
499:  * spent on the node right now.
500:  */
501: export function masterLearnBlock(entry: MasterTreeEntry): MasterLearnBlock | null {
502:   const level = masterSkillInfo(entry).level;
503:   if (level >= entry.maxLevel) return 'maxed';
504:   if (masterLevelUpPoints() < entry.requiredPoints) return 'points';
505:   if (!masterEquipmentMet(entry)) return 'equipment';
506:   if (!masterParentsMet(entry) || !masterRankMet(entry) || !masterBaseSkillMet(entry)) {
507:     return 'requirements';
508:   }
509:   return null;
510: }
511: 
512: /**
513:  * The subset of `printf` the tooltip strings use: `%d`, `%s`, `%0.2f`,
514:  * `%6.2f`, `%I64d`, `%%`. Missing arguments print as empty, like the
515:  * original's `mu_swprintf` with a short list prints garbage nobody sees.
516:  */
517: export function formatMasterText(
518:   template: string,
519:   ...args: (number | string)[]
520: ): string {
521:   let i = 0;
522:   return template.replace(/%(\d*)(?:\.(\d+))?(I64d|d|s|f)|%%/g, (m, width, prec, kind) => {
523:     if (m === '%%') return '%';
524:     const arg = args[i++];
525:     if (arg === undefined) return '';
526:     let out: string;
527:     if (kind === 'f') out = Number(arg).toFixed(prec ? Number(prec) : 6);
528:     else if (kind === 's') out = String(arg);
529:     else out = String(Math.trunc(Number(arg)));
530:     const w = width ? Number(width) : 0;
531:     return w > out.length ? ' '.repeat(w - out.length) + out : out;
532:   });
533: }
534: 
535: function pushLines(
536:   lines: MasterTooltipLine[],
537:   text: string,
538:   color: MasterTooltipLine['color'],
539:   bold = false
540: ): void {
541:   // `#` is the original's line break; blank segments are spacer lines.
542:   for (const part of text.split('#')) {
543:     lines.push({ text: part.trim(), color, bold });
544:   }
545: }
546: 
547: /** `RenderToolTip`: the lines of a node's hover tip, coloured as drawn. */
548: export function masterSkillTooltipLines(entry: MasterTreeEntry): MasterTooltipLine[] {
549:   const tip = masterSkillTooltip(entry.skill);
550:   const lines: MasterTooltipLine[] = [];
551:   const name = skillDefinition(entry.skill)?.name ?? `Skill ${entry.skill}`;
552:   lines.push({ text: name, color: 1, bold: true });
553:   if (!tip) return lines;
554: 
555:   const { level, value, nextValue } = masterSkillInfo(entry);
556:   const [info1, info2, info3, info4, info5, info6, info7] = tip.info;
557: 
558:   lines.push({ text: formatMasterText(info1, entry.rank, level, entry.maxLevel), color: 0 });
559: 
560:   if (entry.defValue === -1) pushLines(lines, info2, 0);
561:   else pushLines(lines, formatMasterText(info2, level !== 0 ? value : entry.defValue), 0);
562: 
563:   if (level !== 0 && level < entry.maxLevel) {
564:     pushLines(lines, MASTER_TEXT.nextLevel, 4);
565:     pushLines(lines, formatMasterText(info2, nextValue), 0, true);
566:   }
567: 
568:   if (level < entry.maxLevel) {
569:     pushLines(lines, MASTER_TEXT.requirements, 1);
570:     const affordable = entry.requiredPoints <= masterLevelUpPoints();
571:     pushLines(lines, formatMasterText(info3, entry.requiredPoints), affordable ? 0 : 2, true);
572:   }
573: 
574:   if (info4) pushLines(lines, info4, masterBaseSkillMet(entry) ? 0 : 2);
575: 
576:   if (level < entry.maxLevel && entry.rank !== 1) {
577:     if (info5) pushLines(lines, info5, masterRankMet(entry) ? 0 : 2);
578:     entry.requireSkills.forEach((required, i) => {
579:       if (!required || !isMasterSkill(required)) return;
580:       const text = i === 0 ? info6 : info7;
581:       if (text) pushLines(lines, text, masterSkillLevel(required) < RANK_UNLOCK_LEVEL ? 2 : 0);
582:     });
583:   }
584: 
585:   return lines.filter((l, i, all) => l.text || (i > 0 && all[i - 1].text));
586: }
587: 
588: /**
589:  * Spend one master point on the skill: `AddMasterSkillPoint` (F3 52). The
590:  * server answers with `MasterSkillLevelUpdate`; nothing changes locally
591:  * until it does.
592:  */
593: export function learnMasterSkill(skill: number): void {
594:   const packet = AddMasterSkillPointPacket.createPacket();
595:   packet.SkillId = skill;
596:   Store.sendToGS(packet.buffer);
597: }
598: 
599: EventBus.on('MasterSkillList', packet => {
600:   const p = new MasterSkillListPacket(packet);
601:   const b = p.buffer;
602:   // The generated reader drops the two floats; read the 12-byte entries
603:   // (index, level, pad, value, next value) straight from the buffer.
604:   const count = p.MasterSkillCount;
605:   runInAction(() => {
606:     infoByIndex.clear();
607:     infoBySkill.clear();
608:     for (let i = 0, at = 12; i < count && at + 12 <= b.byteLength; i++, at += 12) {
609:       infoByIndex.set(b.getUint8(at), {
610:         level: b.getUint8(at + 1),
611:         value: b.getFloat32(at + 4, true),
612:         nextValue: b.getFloat32(at + 8, true),
613:       });
614:     }
615:   });
616: });
617: 
618: EventBus.on('MasterSkillLevelUpdate', packet => {
619:   const p = new MasterSkillLevelUpdatePacket(packet);
620:   if (!p.Success) return;
621:   const info: MasterSkillInfo = {
622:     level: p.Level,
623:     // Generated as uint32; they are IEEE floats on the wire.
624:     value: p.buffer.getFloat32(20, true),
625:     nextValue: p.buffer.getFloat32(24, true),
626:   };
627:   runInAction(() => {
628:     infoBySkill.set(p.MasterSkillNumber, info);
629:     const index = p.MasterSkillIndex || entryBySkill(p.MasterSkillNumber)?.index;
630:     if (index) infoByIndex.set(index, info);
631:   });
632:   setMasterLevelUpPoints(p.MasterLevelUpPoints);
633: });
634: 
635: function reset(): void {
636:   // The list is sent once, on entering the game; the learned levels
637:   // survive a warp. Nothing else is held: the tables are static data.
638: }
639: 
640: // ---- 3. the layer ----------------------------------------------------------
641: 
642: export const masterTreeLayer: SkillLayer = {
643:   name: 'masterTree',
644:   reset,
645: };
