 4: /**
 5:  * Aida (`WD_33AIDA`, `World34`/`Object34`) - the misty forest between Loren
 6:  * and Crywolf.
 7:  *
 8:  * `MoveAidaObject` (GMAida.cpp:38-95) is the whole runtime: the UV scrolls
 9:  * (`meshAnimation.ts`), the two glow lights and the eight hidden markers
10:  * (`spec.ts`), and two per-object settings that need a class:
11:  *
12:  *  - **41** (×21): `pObject->Alpha = 0.5f` - a translucent veil.
13:  *  - **64** (×65): `pObject->Velocity = 0.05f` - the hanging moss, played at
14:  *    a third of the default 0.16.
15:  *
16:  * Not built: the bone-anchored spark pairs on 30/71 (reduced to one flare in
17:  * `spec.ts`), the 65/66/77/78 explicit `RenderMesh` passes (:283-320, an
18:  * extra unlit draw of mesh 0 with a U scroll - the scroll is kept, the extra
19:  * pass is materials work), the butterflies on 60, and `M33Aida::CreateMist`
20:  * (the leaves slot - a weather recipe). `SOUND_AIDA_AMBIENT` is
21:  * `PlayBuffer`ed from `MoveAidaObject` every frame, i.e. a bed
22:  * (`ambientBeds.ts`); music `Music/Aida`.
23:  */
24: export async function createAida(world: World) {
25:   const terrain = world.terrain;
26:   if (!terrain) return;
27: 
28:   const tiles = terrain.MapTileObjects;
29: 
30:   // GMAida.cpp:70-73.
31:   tiles[41] = AlphaObject.at(0.5);
32:   // GMAida.cpp:87-89.
33:   tiles[64] = PlaySpeedObject.at(0.05);
34: }
</file>

