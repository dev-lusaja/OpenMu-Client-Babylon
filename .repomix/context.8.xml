<file path="src/maps/bloodcastle/bones.ts">
 1: import type { BonedEmission } from '../../common/effectParticles';
 2: import type { ModelObject } from '../../common/modelObject';
 3: 
 4: export type BoneNode = BonedEmission['node'];
 5: 
 6: /**
 7:  * The transform node the converter left for BMD bone `index`
 8:  * (`bone_<i>_<bmdName>`, tools/bmdToGlb.ts:283) - the same two-step lookup
 9:  * Stadium's brazier and the login wall torch make: the skeleton's linked node
10:  * first, the node graph by name second.
11:  */
12: export function findBone(obj: ModelObject, index: number): BoneNode | null {
13:   const gltf = obj.gltf;
14:   if (!gltf) return null;
15: 
16:   const prefix = `bone_${index}_`;
17: 
18:   for (const bone of gltf.skeleton?.bones ?? []) {
19:     const node = bone.getTransformNode();
20:     if (node?.name.startsWith(prefix)) return node;
21:   }
22: 
23:   const node = gltf.mesh
24:     .getDescendants(false)
25:     .find(n => n.name.startsWith(prefix));
26: 
27:   return node && 'getAbsolutePosition' in node ? (node as BoneNode) : null;
28: }
29: 
30: /**
31:  * BMD bone transforms only exist once a render has posed the skeleton, so a
32:  * bone that still reports the object origin is not ready to anchor a sprite.
33:  */
34: export function bonePosed(obj: ModelObject, bone: BoneNode): boolean {
35:   const origin = obj.node.getAbsolutePosition();
36:   const p = bone.getAbsolutePosition();
37: 
38:   return (
39:     Math.abs(p.x - origin.x) > 1e-3 ||
40:     Math.abs(p.y - origin.y) > 1e-3 ||
41:     Math.abs(p.z - origin.z) > 1e-3
42:   );
43: }
</file>

<file path="src/maps/bloodcastle/candelabraObject.ts">
  1: import {
  2:   createMovableFlare,
  3:   type MovableFlare,
  4: } from '../../common/effectLights';
  5: import { MapTileObject } from '../../common/mapTileObject';
  6: import { lightMapObjectWith } from '../../lighting/mapObjectLights';
  7: import { PRIORITY_TORCH, type LightSource } from '../../lighting/lightSource';
  8: import { Store } from '../../store';
  9: import type { Entity, World } from '../../ecs/world';
 10: import { findBone, bonePosed, type BoneNode } from './bones';
 11: 
 12: /**
 13:  * `wchar_t indexLight[7] = { 1, 2, 4, 6, 9, 10, 11 }` (ZzzObject.cpp:3169):
 14:  * the seven candle tips of `Object12/Object12.glb`.
 15:  */
 16: const FLAME_BONES: readonly number[] = [1, 2, 4, 6, 9, 10, 11];
 17: 
 18: /** `CreateSprite(BITMAP_LIGHT, Position, 0.5f, Light, o)`: sprite scale. */
 19: const FLARE_SCALE = 0.5;
 20: 
 21: /**
 22:  * `Luminosity = sinf((o->Angle[2] * 20 + WorldTime) * 0.001f) * 0.5f + 0.5f`
 23:  * (ZzzObject.cpp:3171): a 6.3 s breath phased by the candelabra's yaw x 20 ms,
 24:  * so eleven of them along the walls do not pulse together.
 25:  */
 26: const PULSE_SPEED = 0.001;
 27: const YAW_PHASE_MS = 20;
 28: 
 29: /** `Vector(Luminosity * 1.f, Luminosity * 0.5f, 0.f, Light)`: candle orange. */
 30: const FLARE_COLOR: readonly [number, number, number] = [1, 0.5, 0];
 31: 
 32: /**
 33:  * Ours: the original lights nothing on this map (`AddTerrainLight` is never
 34:  * called in Blood Castle), but eleven seven-flame candelabra that leave the
 35:  * stone around them black read as props. One pooled light per candelabra at
 36:  * the object, range 3 tiles, candle colour, riding the same breath.
 37:  */
 38: const LIGHT_RANGE = 3;
 39: const POINT_RANGE = 5;
 40: 
 41: /** Updates to wait for the skeleton to be posed before lighting anyway. */
 42: const POSE_WAIT_LIMIT = 120;
 43: 
 44: /**
 45:  * Blood Castle type 11, the candelabra (x11, EncTerrain12.obj): seven light
 46:  * sprites on the candle-tip bones, brightness a slow sine phased by yaw
 47:  * (ZzzObject.cpp:3165-3181). Sprites are sized once and only their
 48:  * brightness follows the sine - the same trade Stadium's brazier makes.
 49:  */
 50: export class BloodCastleCandelabraObject extends MapTileObject {
 51:   #bones: BoneNode[] = [];
 52:   #flares: MovableFlare[] = [];
 53:   #source: LightSource | null = null;
 54:   #lit = false;
 55:   #waited = 0;
 56:   #disposed = false;
 57: 
 58:   async init(world: World, entity: Entity) {
 59:     await super.init(world, entity);
 60: 
 61:     for (const index of FLAME_BONES) {
 62:       const bone = findBone(this, index);
 63:       if (bone) this.#bones.push(bone);
 64:     }
 65:   }
 66: 
 67:   /** `o->Angle[2]` in degrees, back out of the render rotation. */
 68:   #yawDegrees(): number {
 69:     return (this.node.rotation.y * 180) / Math.PI;
 70:   }
 71: 
 72:   #light(world: World): void {
 73:     this.#lit = true;
 74: 
 75:     const scale = this.node.scaling.x;
 76: 
 77:     for (const bone of this.#bones) {
 78:       void createMovableFlare(
 79:         world.scene,
 80:         FLARE_SCALE * scale,
 81:         FLARE_COLOR
 82:       ).then(flare => {
 83:         if (!flare) return;
 84:         if (this.#disposed) {
 85:           flare.dispose();
 86:           return;
 87:         }
 88:         const p = bone.getAbsolutePosition();
 89:         flare.moveTo(p.x, p.y, p.z);
 90:         this.#flares.push(flare);
 91:       });
 92:     }
 93: 
 94:     const phaseMs = (this.#yawDegrees() * YAW_PHASE_MS) | 0;
 95:     this.#source = lightMapObjectWith(
 96:       world.scene,
 97:       {
 98:         color: FLARE_COLOR,
 99:         range: LIGHT_RANGE,
100:         pointRange: POINT_RANGE,
101:         pulse: { speed: PULSE_SPEED, amount: 0.5, base: 0, phase: phaseMs },
102:         priority: PRIORITY_TORCH,
103:         instant: false,
104:       },
105:       this.node.getAbsolutePosition()
106:     );
107:   }
108: 
109:   dispose(): void {
110:     this.#disposed = true;
111:     for (const f of this.#flares) f.dispose();
112:     this.#flares = [];
113:     this.#source?.dispose();
114:     this.#source = null;
115:     this.#bones = [];
116:     super.dispose();
117:   }
118: 
119:   Update(gameTime: World['gameTime']): void {
120:     super.Update(gameTime);
121: 
122:     if (!this.Ready || this.#bones.length === 0) return;
123: 
124:     const world = Store.world;
125:     if (!world) return;
126: 
127:     if (!this.#lit) {
128:       if (
129:         bonePosed(this, this.#bones[0]) ||
130:         ++this.#waited >= POSE_WAIT_LIMIT
131:       ) {
132:         this.#light(world);
133:       }
134:       return;
135:     }
136: 
137:     if (this.OutOfView || this.#flares.length === 0) return;
138: 
139:     const worldTime = gameTime.TotalGameTime.TotalSeconds * 1000;
140:     const lumi =
141:       Math.sin((this.#yawDegrees() * YAW_PHASE_MS + worldTime) * PULSE_SPEED) *
142:         0.5 +
143:       0.5;
144: 
145:     for (const flare of this.#flares) flare.setLuminosity(lumi);
146:   }
147: }
</file>

<file path="src/maps/bloodcastle/gateObject.ts">
  1: import { MapTileObject } from '../../common/mapTileObject';
  2: import { ParticleEmitter } from '../../common/effectParticles';
  3: import { toRadians } from '../../common/utils';
  4: import { Store } from '../../store';
  5: import type { Entity, World } from '../../ecs/world';
  6: import {
  7:   bloodCastleGateDown,
  8:   bloodCastleGatePitch,
  9:   bloodCastleGateSmokeDue,
 10:   updateBloodCastleGate,
 11: } from './gate';
 12: 
 13: /**
 14:  * `for (i < 10) CreateParticleFpsChecked(BITMAP_SMOKE + 1, Position + (±150, -600…-620, 0))`
 15:  * (ZzzObject.cpp:116-124): ten puffs, spread 3 tiles across, 6 tiles *south*
 16:  * of the gate - where the top of a 90° gate lands. The one-tick emitter below
 17:  * is run for a single update, so `count` is the whole burst.
 18:  */
 19: const SMOKE_BURST_COUNT = 10;
 20: const SMOKE_SPREAD = 150;
 21: const SMOKE_SOUTH_TILES = 6;
 22: 
 23: /**
 24:  * Blood Castle type 36, the gate (x1, at 14.5/76.1, pitch 45 in the object
 25:  * list). Stands over the `TW_NOGROUND` pit until the match's gate-destroyed
 26:  * state, then swings down and vanishes (`ActionObject`, ZzzObject.cpp:96-140);
 27:  * the pit opens and the two debris halves appear. `gate.ts` holds the state;
 28:  * this class only writes the pitch and alpha it reads back.
 29:  */
 30: export class BloodCastleGateObject extends MapTileObject {
 31:   #entity: Entity | null = null;
 32:   #smoke: ParticleEmitter | null = null;
 33:   #smokeTicks = 0;
 34:   #basePitch = 0;
 35: 
 36:   async init(world: World, entity: Entity) {
 37:     await super.init(world, entity);
 38:     this.#entity = entity;
 39:     this.#basePitch = entity.transform?.rot.x ?? 0;
 40:   }
 41: 
 42:   dispose(): void {
 43:     this.#smoke = null;
 44:     this.#entity = null;
 45:     super.dispose();
 46:   }
 47: 
 48:   Update(gameTime: World['gameTime']): void {
 49:     super.Update(gameTime);
 50: 
 51:     if (!this.Ready) return;
 52: 
 53:     const world = Store.world;
 54:     if (!world) return;
 55: 
 56:     updateBloodCastleGate(world, world.scene.getEngine().getDeltaTime() / 1000);
 57: 
 58:     if (bloodCastleGateDown()) {
 59:       if (this.Alpha > 0) this.setAlpha(0);
 60:       this.#smoke = null;
 61:       return;
 62:     }
 63: 
 64:     const pitch = bloodCastleGatePitch();
 65:     const t = this.#entity?.transform;
 66:     if (pitch !== null && t) {
 67:       // The object list's pitch went in negated (loadMapIntoScene); the
 68:       // original overwrites `Angle[0]` outright, so this does the same.
 69:       t.rot.x = -toRadians(pitch);
 70:     } else if (t && t.rot.x !== this.#basePitch) {
 71:       t.rot.x = this.#basePitch;
 72:     }
 73: 
 74:     if (bloodCastleGateSmokeDue()) {
 75:       const p = this.node.position;
 76:       this.#smoke = new ParticleEmitter(
 77:         world.scene,
 78:         [{ kinds: ['smoke2'], every: 1, count: SMOKE_BURST_COUNT, jitter: SMOKE_SPREAD }],
 79:         { x: p.x, y: p.y, z: p.z - SMOKE_SOUTH_TILES },
 80:         this.node.rotation.y,
 81:         this.node.scaling.x
 82:       );
 83:       this.#smokeTicks = 2;
 84:     }
 85: 
 86:     if (this.#smoke && this.#smokeTicks > 0) {
 87:       this.#smoke.update();
 88:       if (--this.#smokeTicks === 0) this.#smoke = null;
 89:     }
 90:   }
 91: }
 92: 
 93: /**
 94:  * Blood Castle types 9 and 10, the two broken-gate halves beside the gate
 95:  * (x2 each). `MoveObject` keeps them `HiddenMesh = -2` until `PKKey == 4`,
 96:  * which `ActionObject` sets on the tick the gate is gone
 97:  * (ZzzObject.cpp:4143-4149, :84-98).
 98:  */
 99: export class BloodCastleGateDebrisObject extends MapTileObject {
100:   async init(world: World, entity: Entity) {
101:     await super.init(world, entity);
102:     if (!bloodCastleGateDown()) this.setAlpha(0);
103:   }
104: 
105:   Update(gameTime: World['gameTime']): void {
106:     super.Update(gameTime);
107:     if (!this.Ready) return;
108: 
109:     const shown = bloodCastleGateDown();
110:     if (shown && this.Alpha < 1) this.setAlpha(1);
111:     else if (!shown && this.Alpha > 0) this.setAlpha(0);
112:   }
113: }
</file>

