12: 
13: /**
14:  * The map's object records in tiles, from the same file the terrain loader
15:  * reads (a cache hit by the time a map's `create` runs).
16:  */
17: export async function loadRoomRecords(map: ENUM_WORLD): Promise<RoomRecord[]> {
18:   const worldNum = assetWorldNum(map);
19:   const bytes = await downloadDataBytesBuffer(
20:     `World${worldNum}/EncTerrain${worldNum}.obj`
21:   );
22: 
23:   return parseTerrainObjects(bytes).map(o => ({
24:     id: o.id,
25:     x: o.pos.x / 100,
26:     y: o.pos.y / 100,
27:     z: o.pos.z / 100,
28:   }));
29: }
30: 
31: export type RoomHooks = {
32:   readonly look: AreaLookName;
33:   readonly onEnter?: () => void;
34:   readonly onLeave?: () => void;
35: };
36: 
37: /**
38:  * One trigger per room: the box the mask and the roof lift read is the
39:  * trigger's own, the floor between the inner wall faces, so a hero anywhere
40:  * on it - walked in, warped in, stepped in across a corner - is in the room
41:  * and a step into the doorway is out.
42:  */
43: /** Roof and wall types of every room registered on a map. */
44: const structureTypes = new Map<ENUM_WORLD, Set<number>>();
45: 
46: const NO_TYPES: ReadonlySet<number> = new Set();
47: 
48: /**
49:  * The object types a map's rooms are built from: the pieces the map lifts
50:  * out of the way (`transform.posOffset`) or the ceiling fade thins. They
51:  * keep a model of their own, so the prop batches leave them alone.
52:  */
53: export function roomStructureTypes(map: ENUM_WORLD): ReadonlySet<number> {
54:   return structureTypes.get(map) ?? NO_TYPES;
55: }
56: 
57: export function registerRooms(
58:   world: World,
59:   rooms: readonly RoomFrame[],
60:   spec: RoomSpec,
61:   hooksFor: (room: RoomFrame) => RoomHooks
62: ): void {
63:   const map = world.mapIndex;
64: 
65:   const structure = structureTypes.get(map) ?? new Set<number>();
66:   for (const type of spec.roofTypes) structure.add(type);
67:   for (const type of spec.wallTypes) structure.add(type);
68:   structureTypes.set(map, structure);
69: 
70:   for (const room of rooms) {
71:     const hooks = hooksFor(room);
72:     const volume = roomVolumeOf(room.min, room.max, {
73:       floorY: room.base,
74:       wallHeight: spec.wallHeight,
75:       roofHeight: spec.roofHeight,
76:     });
77: 
78:     world.add({
79:       worldIndex: map,
80:       interactiveArea: {
81:         min: { x: volume.minX, y: volume.minY },
82:         max: { x: volume.maxX, y: volume.maxY },
83:         onEnter: () => {
84:           hooks.onEnter?.();
85:           setAreaMood(hooks.look, volume);
86:         },
87:         onLeave: () => {
88:           hooks.onLeave?.();
89:           setAreaMood(null);
90:         },
91:       },
92:     });
93:   }
94: }
