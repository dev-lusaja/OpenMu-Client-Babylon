 65: const DISABLE = false;
 66: 
 67: /** Measured on the pub: wall body 0.46 thick inside its line, top face 2.64 over the base, roof slabs from 2.65. */
 68: const LORENCIA_ROOM_SPEC: RoomSpec = {
 69:   roofTypes: [MODEL_HOUSE_WALL05, MODEL_HOUSE_WALL06],
 70:   roofHalf: 2.3,
 71:   wallTypes: [
 72:     MODEL_HOUSE_WALL01,
 73:     MODEL_HOUSE_WALL02,
 74:     MODEL_HOUSE_WALL03,
 75:     MODEL_HOUSE_WALL04,
 76:   ],
 77:   floorFromWallLine: 0.5,
 78:   wallHeight: 2.63,
 79:   roofHeight: 2.63,
 80: };
 81: 
 82: /** The pub floor (x 121-129, y 121-137); the cabin across the river is the other roofed room. */
 83: const PUB: Room = {
 84:   min: { x: 121, y: 121 },
 85:   max: { x: 129, y: 137 },
 86:   centre: { x: 125, z: 129 },
 87: };
 88: 
 89: /**
 90:  * The rooms: pub music and the two roof types lifted out of the way while the
 91:  * hero is in the pub (the original never hides roofs; the lift predates the
 92:  * ceiling fade and keeps Classic's pub frame as it was), the shared room row
 93:  * for the cabin. `AmbientParticleSystem`'s `LORENCIA_TAVERN` room matches the
 94:  * pub footprint.
 95:  */
 96: async function createRooms(world: World) {
 97:   const map = world.mapIndex;
 98:   const roofs = [MODEL_HOUSE_WALL05, MODEL_HOUSE_WALL06];
 99:   const liftRoof = (offset: { x: number; y: number; z: number } | undefined) => {
100:     const query = world.with('transform', 'modelId', 'worldIndex');
101:     for (const e of query) {
102:       if (e.worldIndex !== map) continue;
103:       if (roofs.includes(e.modelId)) e.transform.posOffset = offset;
104:     }
105:   };
106: 
107:   const pub: RoomHooks = {
108:     look: 'lorenciaTavern',
109:     onEnter: () => {
110:       sound.playMusic('Music/Pub');
111:       liftRoof({ x: 0, y: 100, z: 0 });
112:     },
113:     onLeave: () => {
114:       sound.playMusic(mapMusic(map) ?? 'Music/main_theme');
115:       liftRoof(undefined);
116:     },
117:   };
118: 
119:   world.add({
120:     worldIndex: map,
121:     onDispose: () => {
122:       sound.stop('Music/Pub');
123:       setAreaMood(null);
124:     },
125:   });
126: 
127:   const rooms = enumerateRooms(await loadRoomRecords(map), LORENCIA_ROOM_SPEC);
128:   registerRooms(world, rooms, LORENCIA_ROOM_SPEC, room =>
129:     sameRoom(room, PUB) ? pub : { look: 'lorenciaCabin' }
130:   );
131: }
132: 
133: export async function createLorencia(world: World) {
