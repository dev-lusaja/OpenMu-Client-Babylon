<file path="src/scenes/inkOutline.ts">
  1: import {
  2:   Constants,
  3:   GeometryBufferRenderer,
  4:   PostProcess,
  5:   ShaderStore,
  6:   Texture,
  7:   type ArcRotateCamera,
  8:   type Scene,
  9: } from '../libs/babylon/exports';
 10: import { devQueryNumbers } from '../common/devSeams';
 11: import type { LightingTier } from '../common/lightingQuality';
 12: import {
 13:   inkDarkness,
 14:   inkSide,
 15:   inkWidth,
 16:   toonBands,
 17:   toonEffectsActive,
 18:   type RenderingStyle,
 19: } from '../common/renderingStyle';
 20: import { EFFECT_MASK_SAMPLER, effectMask } from './ambientOcclusion';
 21: 
 22: /**
 23:  * Ink lines (rendering_style ARCHITECTURE §2.3): sole owner of the outline
 24:  * post-process, between the AO combine and the haze so a line fades with
 25:  * distance like the surface it sits on and is graded with the scene.
 26:  *
 27:  * The lines come from the G-buffer alone. Depth across a flat surface is not
 28:  * linear in screen space but its reciprocal is, at whatever angle the surface
 29:  * is seen, so the two neighbours on an axis predict the pixel between them by
 30:  * a straight average: their second difference is zero on any flat surface,
 31:  * positive where the pixel stands in front of what surrounds it and negative
 32:  * where it stands behind. That is the whole silhouette test, and the line
 33:  * placement decides which side of the step takes the line. A crease is a
 34:  * *sudden* turn of the normal, the second difference again, counted only
 35:  * where the depth stayed continuous: a smoothly rounded limb turns by the
 36:  * same amount from tap to tap and draws nothing.
 37:  *
 38:  * Sky is depth 0: it never inks, and as a neighbour it is infinitely far.
 39:  * The effect mask is subtracted and added back the way the haze does it, so
 40:  * the additive half of a pixel keeps its own light.
 41:  *
 42:  * The line strength, line width and line placement sliders set the darkness,
 43:  * the width and the side (renderingStyle.ts).
 44:  *
 45:  * With the skill effects toggle on (`toonEffectsActive`) the pass is built
 46:  * in its second form and treats the additive half it just subtracted the
 47:  * same way: its luminance is snapped to the shade steps, hue kept, so a
 48:  * glow becomes a few solid tones, and where a tone meets nothing (the
 49:  * effect's own edge, one line width out) the whole pixel takes the ink, so
 50:  * every flash and bolt wears a contour in its own darker colour. Below the
 51:  * first tone the glow is left as it is, a soft skirt outside the line: the
 52:  * mask has no depth, so under a flame that dips into the ground it reports
 53:  * more light than landed. The mask is depthless in the other direction too,
 54:  * holding effects the frame never drew because something opaque stood in
 55:  * front, and a pixel the frame left dimmer than the effect alone is exactly
 56:  * that: those are left to the surface, so a contour never lands on the wall
 57:  * in front of a flame. Off, the shader text is the one it always was.
 58:  * Dev seam: `?inkk=depthThreshold,normalThreshold` replaces the edge thresholds.
 59:  */
 60: 
 61: const SHADER = 'muInkOutline';
 62: 
 63: /** Tap rings per tier index; Ultra adds a second ring one texel further out. */
 64: const RINGS: readonly number[] = [0, 1, 2];
 65: 
 66: /** A depth step counts past this share of the pixel's own depth... */
 67: const DEPTH_THRESHOLD = 0.02;
 68: 
 69: /** ...and never under this many tiles, so a surface never inks its own texels. */
 70: const DEPTH_FLOOR = 0.05;
 71: 
 72: /**
 73:  * A crease counts past this much sudden turn of the normal, as the length of
 74:  * the turn it takes between one tap and the next: about 26 degrees of change
 75:  * in the rate, not in the normal itself.
 76:  */
 77: const NORMAL_THRESHOLD = 0.45;
 78: 
 79: /** Tiles over which the lines thin to nothing. */
 80: const FAR: readonly [number, number] = [80, 160];
 81: 
 82: /** One line is one G-buffer texel at this frame height, two at twice it. */
 83: const REFERENCE_HEIGHT = 900;
 84: 
 85: const knobsDev = devQueryNumbers('inkk', 2);
 86: 
 87: type Runtime = {
 88:   scene: Scene;
 89:   camera: ArcRotateCamera;
 90:   rings: number;
 91:   /** The second form, flattening and contouring the effects. */
 92:   fx: boolean;
 93:   pass: PostProcess;
 94: };
 95: 
 96: let runtime: Runtime | null = null;
 97: 
 98: const shown = { strength: 0 };
 99: 
100: /** The shader's name for its tap rings and whether it treats the effects. */
101: function shaderName(rings: number, fx: boolean): string {
102:   return `${SHADER}${rings}${fx ? 'Fx' : ''}`;
103: }
104: 
105: function registerShader(rings: number, fx: boolean): void {
106:   const name = shaderName(rings, fx);
107: 
108:   if (ShaderStore.ShadersStore[`${name}FragmentShader`]) return;
109: 
110:   ShaderStore.ShadersStore[`${name}FragmentShader`] = `
111:   precision highp float;
112:   varying vec2 vUV;
113:   uniform sampler2D textureSampler;
114:   uniform sampler2D depthSampler;    // G-buffer depth: view-space z in tiles, 0 = sky
115:   uniform sampler2D normalSampler;   // G-buffer normal: view space, signed, 0 at sky
116:   uniform sampler2D ${EFFECT_MASK_SAMPLER};
117:   uniform vec2 texel;      // one G-buffer texel at the reference height, in UV
118:   uniform float inkWidth;  // the line's width in those texels
119:   uniform float inkSide;   // 1 inside the silhouette, 0 across it, -1 outside
120:   uniform vec4 ink;        // strength, depth threshold (share of z), depth floor (tiles), normal threshold
121:   uniform vec2 inkFar;     // fade start, fade end (tiles)
122: ${
123:   fx
124:     ? `
125:   uniform float inkFx;     // tone levels
126: 
127:   // The additive half's luminance at a neighbour, for the contour.
128:   float maskLuma(vec2 uv) {
129:     return dot(texture2D(${EFFECT_MASK_SAMPLER}, uv).rgb, vec3(0.299, 0.587, 0.114));
130:   }
131: 
132:   // Nearest of \`levels\` tones over [0, 1], hard edged: an effect is a flat
133:   // shape, not a lit surface, so nothing eases here.
134:   float fxBands(float x, float levels) {
135:     float s = max(levels - 1.0, 1.0);
136:     return floor(clamp(x, 0.0, 1.0) * s + 0.5) / s;
137:   }
138: `
139:     : ''
140: }
141:   const int RINGS = ${rings};
142: 
143:   // Sky stands infinitely far behind everything, which is zero the moment
144:   // depth is read as its reciprocal.
145:   float invAt(vec2 uv) {
146:     float z = texture2D(depthSampler, uv).r;
147:     return z <= 0.0 ? 0.0 : 1.0 / z;
148:   }
149: 
150:   vec3 normalAt(vec2 uv) {
151:     return texture2D(normalSampler, uv).xyz;
152:   }
153: 
154:   // How far this pixel stands in front of the straight line between its two
155:   // neighbours, in tiles. Zero on any flat surface at any angle, which is
156:   // what a plane predicted from the shading normal could not manage: on a
157:   // card whose authored normal is not its own plane, on a smoothed limb, or
158:   // on anything seen near edge-on, that prediction was wrong across the
159:   // whole surface and the pass filled it with ink instead of tracing it.
160:   float reliefAt(vec2 uv, vec2 reach, float inv0, float scale) {
161:     return (2.0 * inv0 - invAt(uv + reach) - invAt(uv - reach)) * scale;
162:   }
163: 
164:   // The silhouette, on the side the placement asks for: inside it is the
165:   // pixel standing in front, outside it the one standing behind.
166:   float sideStep(float relief, float threshold) {
167:     float inside = smoothstep(threshold, threshold * 2.0, relief);
168:     float outside = smoothstep(threshold, threshold * 2.0, -relief);
169:     return inkSide > 0.5 ? inside : (inkSide < -0.5 ? outside : max(inside, outside));
170:   }
171: 
172:   // A crease turns the normal suddenly. A rounded surface turns it by the
173:   // same amount from tap to tap, so the second difference stays near zero
174:   // there and only the folds draw.
175:   float creaseStep(vec2 uv, vec2 reach, vec3 n0, float relief, float threshold) {
176:     float bend = length(normalAt(uv + reach) + normalAt(uv - reach) - 2.0 * n0);
177:     float continuous = 1.0 - smoothstep(threshold, threshold * 2.0, abs(relief));
178:     return smoothstep(ink.w, ink.w * 2.0, bend) * continuous;
179:   }
180: 
181:   void main(void) {
182:     vec4 color = texture2D(textureSampler, vUV);
183:     float z0 = texture2D(depthSampler, vUV).r;
184: 
185:     if (${fx ? 'ink.x <= 0.0' : 'z0 <= 0.0 || ink.x <= 0.0'}) {
186:       gl_FragColor = color;
187:       return;
188:     }
189: 
190:     float edge = 0.0;
191: 
192:     // The geometry lines belong to matter: the sky (depth 0) draws none.
193:     ${fx ? 'if (z0 > 0.0)' : ''} {
194:       vec3 n0 = normalAt(vUV);
195:       float inv0 = 1.0 / z0;
196:       // Reciprocal depth back into tiles, to first order, so the thresholds
197:       // below stay the plain distances they read as.
198:       float scale = z0 * z0;
199:       float threshold = max(ink.y * z0, ink.z);
200:       float weight = 1.0;
201: 
202:       for (int r = 1; r <= RINGS; r++) {
203:         vec2 o = texel * (inkWidth + float(r) - 1.0);
204:         vec2 reachX = vec2(o.x, 0.0);
205:         vec2 reachY = vec2(0.0, o.y);
206: 
207:         float reliefX = reliefAt(vUV, reachX, inv0, scale);
208:         float reliefY = reliefAt(vUV, reachY, inv0, scale);
209: 
210:         float step2 = max(sideStep(reliefX, threshold), sideStep(reliefY, threshold));
211: 
212:         float crease = max(
213:           creaseStep(vUV, reachX, n0, reliefX, threshold),
214:           creaseStep(vUV, reachY, n0, reliefY, threshold));
215: 
216:         edge = max(edge, max(step2, crease) * weight);
217:         weight *= 0.5;
218:       }
219: 
220:       // Far out a line covers less than a pixel of world and reads as noise.
221:       edge *= 1.0 - smoothstep(inkFar.x, inkFar.y, z0);
222:     }
223: 
224:     // The depth belongs to the surface, so only the surface takes the line.
225:     // The additive half drawn over it keeps its own light (the haze's rule).
226:     // No semicolons in these comments: the shader preprocessor splits on them.
227:     vec3 lit = max(color.rgb, vec3(0.0));
228:     vec3 effect = min(texture2D(${EFFECT_MASK_SAMPLER}, vUV).rgb, lit);
229:     vec3 surface = color.rgb - effect;
230: ${
231:   fx
232:     ? `
233:     // The mask carries every additive thing in the world, the ones the depth
234:     // test hid behind a wall included. An effect that did light this pixel
235:     // is part of what the frame holds, so a frame dimmer than the effect
236:     // alone is one where it landed somewhere else: leave those to the
237:     // surface rather than draw a contour on the wall in front of them.
238:     float rawL = maskLuma(vUV);
239:     float shownHere = step(rawL, dot(lit, vec3(0.299, 0.587, 0.114)) + 1e-4);
240: 
241:     // The effects, flat: from the first tone up their luminance is snapped
242:     // to the tone levels, hue kept, what stands above white passing through,
243:     // so a soft glow ends in a hard step. Below the first tone it is left as
244:     // it is. That step is where the contour goes: this pixel holds a tone
245:     // and a neighbour one line width away holds none, and the whole pixel
246:     // takes the ink.
247:     float fxLow = 0.5 / max(inkFx - 1.0, 1.0);
248:     float fxL = dot(effect, vec3(0.299, 0.587, 0.114));
249:     float fxQ = fxL < fxLow ? fxL : fxBands(min(fxL, 1.0), inkFx) + max(fxL - 1.0, 0.0);
250:     effect = mix(effect, fxL > 1e-4 ? effect * (fxQ / fxL) : effect, shownHere);
251: 
252:     vec2 fxO = texel * inkWidth;
253:     float fxOut = max(
254:       max(1.0 - step(fxLow, maskLuma(vUV + vec2(fxO.x, 0.0))),
255:           1.0 - step(fxLow, maskLuma(vUV - vec2(fxO.x, 0.0)))),
256:       max(1.0 - step(fxLow, maskLuma(vUV + vec2(0.0, fxO.y))),
257:           1.0 - step(fxLow, maskLuma(vUV - vec2(0.0, fxO.y)))));
258:     float contour = step(fxLow, fxL) * fxOut * shownHere;
259: 
260:     edge = max(edge, contour);
261:     effect *= 1.0 - contour * ink.x;
262: `
263:     : ''
264: }
265:     gl_FragColor = vec4(surface * (1.0 - edge * ink.x) + effect, color.a);
266:   }
267:   `;
268: }
269: 
270: function createPass(
271:   scene: Scene,
272:   camera: ArcRotateCamera,
273:   rings: number,
274:   fx: boolean
275: ): PostProcess {
276:   registerShader(rings, fx);
277: 
278:   const pass = new PostProcess(
279:     'inkOutline',
280:     shaderName(rings, fx),
281:     ['texel', 'inkWidth', 'inkSide', 'ink', 'inkFar', ...(fx ? ['inkFx'] : [])],
282:     ['depthSampler', 'normalSampler', EFFECT_MASK_SAMPLER],
283:     1,
284:     null,
285:     Texture.BILINEAR_SAMPLINGMODE,
286:     scene.getEngine(),
287:     false,
288:     null,
289:     Constants.TEXTURETYPE_HALF_FLOAT
290:   );
291: 
292:   const [depthThreshold, normalThreshold] = knobsDev ?? [
293:     DEPTH_THRESHOLD,
294:     NORMAL_THRESHOLD,
295:   ];
296: 
297:   pass.onApply = effect => {
298:     const gbuffer = scene.geometryBufferRenderer;
299:     const mask = effectMask();
300:     if (!gbuffer || !mask) return;
301: 
302:     const target = gbuffer.getGBuffer();
303: 
304:     effect.setTexture(
305:       'depthSampler',
306:       target.textures[
307:         gbuffer.getTextureIndex(GeometryBufferRenderer.DEPTH_TEXTURE_TYPE)
308:       ]
309:     );
310:     effect.setTexture(
311:       'normalSampler',
312:       target.textures[
313:         gbuffer.getTextureIndex(GeometryBufferRenderer.NORMAL_TEXTURE_TYPE)
314:       ]
315:     );
316:     effect.setTexture(EFFECT_MASK_SAMPLER, mask);
317: 
318:     // Integer texels: a fractional offset would blend depths across the very
319:     // edge the line is looking for.
320:     const width = target.getRenderWidth();
321:     const height = target.getRenderHeight();
322:     const px = Math.max(1, Math.round(height / REFERENCE_HEIGHT));
323:     effect.setFloat2('texel', px / width, px / height);
324: 
325:     // A line across the step is drawn from both sides, so each side takes
326:     // half the slider and the line comes out the width it asks for.
327:     const side = inkSide();
328:     effect.setFloat(
329:       'inkWidth',
330:       side === 0 ? Math.max(1, Math.round(inkWidth() / 2)) : inkWidth()
331:     );
332:     effect.setFloat('inkSide', side);
333: 
334:     effect.setFloat4(
335:       'ink',
336:       shown.strength,
337:       depthThreshold,
338:       DEPTH_FLOOR,
339:       normalThreshold
340:     );
341:     effect.setFloat2('inkFar', FAR[0], FAR[1]);
342: 
343:     if (fx) effect.setFloat('inkFx', toonBands());
344:   };
345: 
346:   camera.attachPostProcess(pass);
347: 
348:   return pass;
349: }
350: 
351: export function disposeInkOutline(): void {
352:   if (!runtime) return;
353: 
354:   runtime.camera.detachPostProcess(runtime.pass);
355:   runtime.pass.dispose(runtime.camera);
356:   runtime = null;
357: }
358: 
359: /**
360:  * Built while the style draws lines, post is on and the AO left a G-buffer
361:  * and an effect mask to read. Returns true when the chain changed.
362:  * `upstreamChanged` (the AO was rebuilt this tick) re-attaches the pass
363:  * behind the new SSAO passes without rebuilding it.
364:  */
365: export function syncInkOutline(
366:   scene: Scene,
367:   camera: ArcRotateCamera,
368:   tier: LightingTier | null,
369:   tierIndex: number,
370:   style: RenderingStyle | null,
371:   post: boolean,
372:   upstreamChanged: boolean
373: ): boolean {
374:   const wanted =
375:     tier !== null &&
376:     post &&
377:     style !== null &&
378:     style.outline &&
379:     effectMask() !== null;
380: 
381:   shown.strength = wanted ? inkDarkness() : 0;
382: 
383:   const rings = RINGS[tierIndex] ?? RINGS[1];
384:   const fx = toonEffectsActive();
385: 
386:   if (
387:     runtime &&
388:     (!wanted || runtime.scene !== scene || runtime.rings !== rings || runtime.fx !== fx)
389:   ) {
390:     disposeInkOutline();
391:     if (!wanted) return true;
392:   }
393: 
394:   if (runtime && upstreamChanged) {
395:     runtime.camera.detachPostProcess(runtime.pass);
396:     runtime.camera.attachPostProcess(runtime.pass);
397:     return true;
398:   }
399: 
400:   if (!wanted || runtime) return false;
401: 
402:   runtime = { scene, camera, rings, fx, pass: createPass(scene, camera, rings, fx) };
403: 
404:   return true;
405: }
406: 
407: export function inkOutlineLive(): boolean {
408:   return runtime !== null;
409: }
