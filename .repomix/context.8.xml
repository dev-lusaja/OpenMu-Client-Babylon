 95:    * `weather/ambientWeather.ts`'s `SNOWFALL_MAPS` and `weather/snowCover.ts`'s
 96:    * `SNOW_GROUND_MAPS`.
 97:    */
 98:   readonly snowfall?: boolean;
 99: 
100:   /**
101:    * The map is under water: rain never falls here however the weather byte
102:    * reads, and the ambient particles are the sea's (marine snow on the
103:    * current, bubbles off the seabed) rather than leaves. Read through
104:    * `weather/ambientWeather.ts`'s `UNDERWATER_MAPS`.
105:    *
106:    * Orthogonal to `outdoor`, which stays true for Atlans: there is a surface
107:    * far above it and god-rays coming through, it is just not a sky anything
108:    * can fall out of.
109:    */
110:   readonly underwater?: boolean;
111: 
112:   /**
113:    * Desert: it does not rain here whatever the weather byte reads. The third
114:    * climate after `snow` and `underwater`, and the plainest of them - the
115:    * sky is clear because the map's whole look is built on air with nothing
116:    * in it (Tarkan runs fog density 0.01 over a sand horizon, clouds 0.06).
117:    *
118:    * More faithful than the alternative, too: the original rains on seven
119:    * named maps and Tarkan is not one of them - it does not appear in
120:    * ZzzEffectFireLeave.cpp at all.
121:    */
122:   readonly desert?: boolean;
123: 
124:   /**
125:    * `SetWorldClearColor` (SceneManager.cpp:336-365) as the original's 0…255
126:    * bytes; omit for black. Applied by `loadMapIntoScene` before `create`.
127:    */
128:   readonly clearColor?: readonly [number, number, number];
129: 
130:   /** Lit interiors, when the map enumerates any (Devias). */
131:   readonly rooms?: readonly Room[];
132: 
133:   /**
134:    * Object type → mesh index drawn additively (`CreateObject`'s `BlendMesh`
135:    * assignments, ZzzObject.cpp:4643-4651). Read by `common/blendMeshes.ts`.
136:    */
137:   readonly blendMeshes?: Readonly<Record<number, number>>;
138: 
139:   /**
140:    * Object types that are an emitter and nothing else - the model is never
141:    * drawn, only its `emissions`. Read by `common/effectOnlyObjects.ts`.
142:    */
143:   readonly effectOnly?: readonly number[];
144: 
145:   /** Object type → particle emissions. Read by `common/effectParticles.ts`. */
146:   readonly emissions?: Partial<Record<number, readonly Emission[]>>;
147: 
148:   /**
149:    * Bind this map's object classes into `world.terrain.MapTileObjects` and
150:    * add whatever entities the map owns. Runs once per warp, after the terrain
151:    * exists and before the objects are created.
152:    *
153:    * Written as `world => import('./create').then(m => m.createX(world))`:
