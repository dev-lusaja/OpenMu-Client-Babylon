109: /** `ComputeDistanceByRange`: the diagonal of a range x range square. */
110: function distanceByRange(range: number): number {
111:   return Math.ceil(Math.sqrt(range * range * 2));
112: }
113: 
114: function tileDistance(a: Point, b: Point): number {
115:   const dx = a.x - b.x;
116:   const dy = a.y - b.y;
117:   return Math.ceil(Math.sqrt(dx * dx + dy * dy));
118: }
119: 
120: function heroTile(hero: Entity): Point {
121:   const pos = hero.transform!.pos;
122:   return { x: ~~pos.x, y: ~~pos.z };
123: }
124: 
125: function entityTile(e: Entity): Point {
126:   const pos = e.transform!.pos;
127:   return { x: ~~pos.x, y: ~~pos.z };
128: }
129: 
130: function isLearned(num: number): boolean {
131:   return num > 0 && Store.skills.some(s => s.number === num);
132: }
133: 
134: /** `(life * 100 + max - 1) / max` - the original's ceiling percent. */
135: function heroHpPercent(): number {
136:   const { currentHP, maxHP } = Store.playerData;
137:   if (maxHP <= 0 || currentHP <= 0) return 100;
138:   return Math.trunc((currentHP * 100 + maxHP - 1) / maxHP);
139: }
