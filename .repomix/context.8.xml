 83: function resetRuntime(): void {
 84:   lastHeroTile = null;
 85:   tickAccum = 0;
 86:   loopCounter = 0;
 87:   secondsElapsed = 0;
 88:   secondsAway = 0;
 89:   buffIndex = 0;
 90:   buffPartyIndex = 0;
 91:   healPartyIndex = 0;
 92:   comboState = 0;
 93:   currentTarget = null;
