34:   { id: 'accessories', labelKey: 'marketplace.cat.accessories' },
35:   { id: 'consumables', labelKey: 'marketplace.cat.consumables' },
36:   { id: 'misc', labelKey: 'marketplace.cat.misc' },
37: ];
38: 
39: 
40: const WING_INDEXES = new Set([0, 1, 2, 3, 4, 5, 6, 36, 37, 38, 39, 40, 41, 42, 43]);
41: const PET_INDEXES = new Set([0, 1, 2, 3, 4, 5]);
42: /** Capes sit with wings: same slot, same reason to shop for one. */
43: const CAPE_INDEXES = new Set([30]);
44: const ACCESSORY_INDEXES = new Set([8, 9, 10, 12, 13, 20, 21, 22, 23, 24, 25, 26, 27, 28]);
45: /** Group 14 jewels: Bless, Soul, Life, Creation, Guardian. */
46: const JEWEL_14 = new Set([13, 14, 16, 22, 31]);
47: /** Group 12 jewels: Chaos, and the compressed Bless / Soul. */
48: const JEWEL_12 = new Set([15, 30, 31]);
49: 
50: export function categoryOf(item: Item): CategoryId {
51:   const { group, num } = item;
52:   if (group <= 5) return 'weapons';
53:   if (group === 6) return 'shields';
54:   if (group >= 7 && group <= 11) return 'armour';
55:   if (group === 12) {
56:     if (WING_INDEXES.has(num)) return 'wings';
57:     if (JEWEL_12.has(num)) return 'jewels';
58:     return 'misc';
59:   }
60:   if (group === 13) {
61:     if (CAPE_INDEXES.has(num)) return 'wings';
62:     if (PET_INDEXES.has(num)) return 'pets';
63:     if (ACCESSORY_INDEXES.has(num)) return 'accessories';
64:     return 'misc';
65:   }
66:   if (group === 14) {
67:     if (JEWEL_14.has(num)) return 'jewels';
68:     return 'consumables';
69:   }
70:   if (group === 15) return 'consumables';
71:   return 'misc';
72: }
73: 
74: export function itemName(item: Item): string {
75:   return (
76:     itemBaseName(item.group, item.num) ||
77:     t('quest.itemFallback', { id: item.group * 512 + item.num })
78:   );
79: }
80: 
81: /** Grid footprint, for the card's icon box. */
82: export function itemFootprint(item: Item): { x: number; y: number } {
83:   const def = ItemsDatabase.getItem(item.group, item.num);
84:   return { x: def?.X ?? 1, y: def?.Y ?? 1 };
85: }
86: 
87: /**
88:  * The name a player reads on a card: the base name with the upgrade level and
89:  * the excellent / ancient markers the tooltip would also show.
90:  */
91: export function displayName(item: Item): string {
92:   const base = itemName(item);
93:   const level = item.lvl ? ` +${item.lvl}` : '';
94:   if (item.isAncient) return `${t('item.ancientPrefix', { name: base })}${level}`;
95:   if (item.isExcellent) return `${t('item.excellentPrefix', { name: base })}${level}`;
96:   return `${base}${level}`;
97: }
</file>

<file path="src/marketplace/dev.tsx">
 1: /**
 2:  * Standalone harness for the marketplace window.
 3:  *
 4:  * `bun run dev`, then open `/marketplace.html`. It mounts the window on its
 5:  * own against fixture data - no login, no game socket, no world - so the
 6:  * layout can be judged before any of the service behind it exists.
 7:  *
 8:  * The version bootstrap is the same two awaits `main.tsx` does, and for the
 9:  * same reason: the window draws the game's own tooltips, which read the packet
10:  * layer, and that is only assigned once a version is loaded. Everything after
11:  * it is a dynamic import so nothing in that graph is touched too early.
12:  *
13:  * Dev only. It is not an entry in the production build.
14:  */
15: import '../style.less';
16: import { loadGameVersion, versionIdForTag } from '../version';
17: 
18: async function bootstrap() {
19:   await loadGameVersion(versionIdForTag('season6'));
20: 
21:   const [React, ReactDOM, state, window_] = await Promise.all([
22:     import('react'),
23:     import('react-dom/client'),
24:     import('./state'),
25:     import('../ui/pages/worldPage/components/marketplace'),
26:   ]);
27:   const { Marketplace } = state;
28:   // Drawn off the catalogue rather than generated apart from it, so every item
29:   // in the bag has something to compare against on the sell tab.
30:   const inventory = Marketplace.listings
31:     .filter((_, i) => i % 7 === 0)
32:     .slice(0, 24)
33:     .map(l => l.item);
34: 
35:   // The harness exists to look at the window, so it always has fixtures.
36:   Marketplace.seedFixtures();
37:   Marketplace.syncFromGame(184_500_000, inventory);
38:   Marketplace.open = true;
39: 
40:   ReactDOM.createRoot(document.getElementById('root')!).render(
41:     <React.StrictMode>
42:       <div className="app">
43:         <window_.MarketplaceWindow />
44:       </div>
45:     </React.StrictMode>
46:   );
47: 
48:   // In game the window anchors above the bottom bar. Here there is no bar, so
49:   // it is centred instead: the harness exists to look at the panel.
50:   const { MuWindows } = await import('../ui/components/muWindow/windowState');
51:   requestAnimationFrame(() =>
52:     MuWindows.moveTo(
53:       window_.MARKETPLACE_ID,
54:       Math.round((innerWidth - window_.MARKETPLACE_WIDTH) / 2),
55:       Math.round((innerHeight - window_.MARKETPLACE_HEIGHT) / 2)
56:     )
57:   );
58: }
59: 
60: bootstrap().catch(e => {
61:   console.error('marketplace harness failed:', e);
62:   throw e;
63: });
</file>

