 1: import { describe, expect, it } from 'vitest';
 2: import { lookClasses, tierOf } from './tiers';
 3: 
 4: /**
 5:  * The look a listing gets is decided here and nowhere else, so the mapping
 6:  * from an item's level and kind to a class or two is pinned down.
 7:  */
 8: 
 9: const item = (o: { lvl?: number; isExcellent?: boolean; isAncient?: boolean }) =>
10:   ({ group: 0, num: 0, ...o }) as never;
11: 
12: describe('tiers by level', () => {
13:   it('start plain and step up at +4, +7 and +10, as the original glow does at +7', () => {
14:     expect(tierOf(undefined)).toBe('plain');
15:     expect(tierOf(3)).toBe('plain');
16:     expect(tierOf(4)).toBe('forged');
17:     expect(tierOf(6)).toBe('forged');
18:     expect(tierOf(7)).toBe('high');
19:     expect(tierOf(9)).toBe('high');
20:     expect(tierOf(10)).toBe('elite');
21:     expect(tierOf(15)).toBe('elite');
22:   });
23: });
24: 
25: describe('the classes a card carries', () => {
26:   it('are nothing for a plain item', () => {
27:     expect(lookClasses(item({ lvl: 0 }))).toBe('');
28:   });
29: 
30:   it('name the tier and the kind, one class each', () => {
31:     expect(lookClasses(item({ lvl: 11, isExcellent: true }))).toBe('tier-elite is-excellent');
32:     expect(lookClasses(item({ lvl: 5 }))).toBe('tier-forged');
33:     expect(lookClasses(item({ isExcellent: true }))).toBe('is-excellent');
34:   });
35: 
36:   it('let ancient win over excellent, as the name colour does', () => {
37:     expect(lookClasses(item({ lvl: 7, isExcellent: true, isAncient: true }))).toBe('tier-high is-ancient');
38:   });
39: });
