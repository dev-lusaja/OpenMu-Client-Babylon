<file path="src/maps/tarkan/lightShaftObject.ts">
 1: import { MapTileObject } from '../../common/mapTileObject';
 2: import { Vector3 } from '../../libs/babylon/exports';
 3: import type { Entity, World } from '../../ecs/world';
 4: 
 5: /**
 6:  * `Vector(1.0f, 1.0f, 1.0f, o->Light)` (ZzzObject.cpp:4126). Shared and never
 7:  * written to: `metadata.bodyLight` is only ever read.
 8:  */
 9: const FULL_LIGHT = new Vector3(1, 1, 1);
10: 
11: /**
12:  * Tarkan 82 (ZzzObject.cpp:4123-4127), ×60 - the light shafts that fall
13:  * through the temple roofs and the canyon cracks, at scales 0.78 to 1.62 and
14:  * anywhere from 0.3 to 8 tiles above the sand.
15:  *
16:  * The blend mesh half is table data (`spec.ts`). The reason this is a class
17:  * is the second line of that case: the shaft is forced to full white
18:  * *regardless of the terrain light where it stands*.
19:  *
20:  * It is not a no-op in the port. `RenderMesh` draws a blend mesh with
21:  * `glColor3f(BodyLight * BlendMeshLight)` (ZzzBMD.cpp:1594) and
22:  * `bindBodyLight` does exactly the same multiply (itemMaterial.ts:285-297) -
23:  * so `o->Light` reaches the shaft either way. And `RenderSystem` overwrites
24:  * `modelObject.Light` every frame from the terrain light under the object
25:  * (renderSystem.ts:72-79), which for a shaft standing in a dark temple would
26:  * dim the one thing in the room that is supposed to be a light source.
27:  *
28:  * Rebinding the mesh's `bodyLight` metadata to a constant is the cheapest
29:  * faithful fix: `Light` keeps tracking the terrain for anything else that
30:  * reads it, and the drawn triangles see the white the C++ writes, with no
31:  * per-frame work at all. Overriding it from `Update` could not work - the
32:  * render system writes `Light` *after* every model's `Update` and before
33:  * `Draw`, so a value written here would always be the one that got replaced.
34:  */
35: export class TarkanLightShaftObject extends MapTileObject {
36:   async init(world: World, entity: Entity): Promise<void> {
37:     await super.init(world, entity);
38: 
39:     for (const mesh of this.getMeshes(true)) {
40:       if (!mesh.metadata) continue;
41:       mesh.metadata.bodyLight = FULL_LIGHT;
42:     }
43:   }
44: }
</file>

<file path="src/maps/tarkan/spec.ts">
  1: import type { Emission } from '../../common/effectParticles';
  2: import type { LightEmitter } from '../../lighting/mapObjectLights';
  3: 
  4: /**
  5:  * Tarkan (World 9 / `Object9`), the plain-data half. Nothing in here may
  6:  * import the scene: the shared registries (`blendMeshes`, `effectOnlyObjects`,
  7:  * `effectParticles`, `effectLights`) pull these tables in, and every one of
  8:  * them is imported *by* `modelObject`/`mapTileObject` - an import back the
  9:  * other way closes the cycle. Anything that needs a `Scene` lives in
 10:  * `index.ts` or an object class instead.
 11:  *
 12:  * **`Object9` has holes.** `Object01`, `04`, `05`, `35`, `36`, `39`, `65` and
 13:  * `85` do not exist in the data, so `o->Type` 0, 3, 4, 34, 35, 38, 64 and 84
 14:  * have no model at all. Two of them carry C++ behaviour that can therefore
 15:  * never run: type 4 (a blend mesh, a V scroll and a white `AddTerrainLight`
 16:  * of range 3, ZzzObject.cpp:4044-4057) and type 64 (the red twin of the
 17:  * type-63 impact glow, :2978). EncTerrain9.obj still places one type 4 and
 18:  * two type 0 records, which fail their load and are logged; nothing else
 19:  * references the missing eight. They are no-ops here, in every table.
 20:  */
 21: 
 22: /**
 23:  * `MoveObject`, ZzzObject.cpp:4046-4128. Five live types re-declare their
 24:  * `o->BlendMesh` every frame - an additive, unlit second pass over one mesh:
 25:  *
 26:  *  - **2** (×4) the scrolling frieze, one mesh of `R.jpg`; its U scroll is in
 27:  *    `meshAnimation.ts`.
 28:  *  - **7** (×98) the red glow lamp, one mesh of `redB.jpg`. Its
 29:  *    `BlendMeshLight` is *not* in `meshAnimation.ts` and must not be: the
 30:  *    sine is phased by the lamp's own yaw, so no shared table can produce it.
 31:  *    See `glowLampObject.ts`.
 32:  *  - **61** (×2) and **65** (×1) the braziers, two meshes each - `gear` (the
 33:  *    bowl) and `gearB` (the flame sheet) - hence blend index 1. **66** is in
 34:  *    the C++ (:4098) but EncTerrain9.obj places none; kept so the table
 35:  *    matches the source rather than the map.
 36:  *  - **82** (×60) the light shaft, one mesh of `light01.jpg`. The same case
 37:  *    also forces `Vector(1.f, 1.f, 1.f, o->Light)`; see
 38:  *    `lightShaftObject.ts` for why that is a separate class and not a
 39:  *    no-op.
 40:  *
 41:  * Type 4's `o->BlendMesh = 0` is left out - there is no `Object05.bmd` for it
 42:  * to apply to (see the header note).
 43:  */
 44: export const TARKAN_BLEND_MESHES: Readonly<Record<number, number>> = {
 45:   2: 0,
 46:   7: 0,
 47:   61: 1,
 48:   65: 1,
 49:   66: 1,
 50:   82: 0,
 51: };
 52: 
 53: /**
 54:  * The dust vents: hidden markers whose entire contribution is particles.
 55:  * `o->HiddenMesh = -2` in `RenderObjectVisual` (ZzzObject.cpp:2967, :2991,
 56:  * :2998, :3005) makes `Draw_RenderObject` (:390) skip the whole body, so the
 57:  * effect-only path in `MapTileObject` skips the model load as well.
 58:  *
 59:  *  - **60** (×82) the ground dust bank - a *one-shot*, see `dustBankObject.ts`.
 60:  *  - **70** (×3) a steady leak of sand off a high ledge; the only Tarkan
 61:  *    emitter with no window, so it is pure table data (`TARKAN_EMISSIONS`).
 62:  *  - **76** (×19) a 500 ms puff once every 5 s, `ventObject.ts`.
 63:  *  - **83** (×10) the quake / rockfall vent, `ventObject.ts`.
 64:  *
 65:  * **63 is deliberately not in this list** even though `MoveObject` (:4092)
 66:  * hides it too: its sprite hangs off `BoneTransform[2]`, so the model has to
 67:  * load and animate for the effect to have a position at all. It is hidden by
 68:  * `HiddenMesh` in `impactGlowObject.ts` instead, which is what the original
 69:  * does - load, animate, draw nothing. 64 is hidden the same way and has no
 70:  * model, so it needs nothing.
 71:  */
 72: export const TARKAN_EFFECT_ONLY_TYPES: readonly number[] = [60, 70, 76, 83];
 73: 
 74: /**
 75:  * Type 70 (ZzzObject.cpp:2991-2995), ×3, at 3.5-4.9 tiles up on the cliff
 76:  * faces above the sand-falls: `rand_fps_check(5)` - a 1-in-5 chance per 25 Hz
 77:  * reference tick, i.e. five spawns a second - of a `BITMAP_SMOKE` SubType 7.
 78:  * No window and no per-object phase, so unlike the other three vents it needs
 79:  * no class.
 80:  *
 81:  * SubType 7 is a puff *thrown sideways and falling*: created with
 82:  * `Velocity = (0, (rand%4+6) * Scale, 0)` and `Scale *= (rand%20+120)*0.01`,
 83:  * then per tick `Gravity += 1`, `Position[2] -= Gravity`, `Scale += 0.03`,
 84:  * tinted `(0.725, 0.572, 0.333)` (ZzzEffectParticle.cpp:1311, :5418) - sand
 85:  * pouring off a ledge and picking up speed.
 86:  *
 87:  * `waterfall5_9` is the only kind in `effectParticles.ts` that falls at all
 88:  * (`vz = -(rand(5)+7)`, decaying upward); every fire and smoke kind rises. It
 89:  * is the same substitution `DUNGEON_EMISSIONS` makes for the ceiling
 90:  * rock-fall, and it costs the sand tint - the kind ignores `light` and holds
 91:  * itself at a flat 0.2 grey. The kind that should exist is:
 92:  *
 93:  * ```ts
 94:  * smoke7: {
 95:  *   texture: 'smoke',
 96:  *   blend: 'add',
 97:  *   init(p, scale) {
 98:  *     p.lifeTime = 30;
 99:  *     p.vy = (rand(4) + 6) * scale;
100:  *     p.gravity = rand(200) / 200;
101:  *     p.scale = scale * (rand(20) + 120) * 0.01;
102:  *     p.rotation = rand(360);
103:  *   },
104:  *   update(p, f) {
105:  *     let lum = 1;
106:  *     p.scale += f * 0.03;
107:  *     p.gravity += f;
108:  *     p.vy -= 0.1 * f;
109:  *     p.pz -= p.gravity * f;
110:  *     if (p.lifeTime < 5) {
111:  *       lum = p.lifeTime / 8;
112:  *       p.scale -= f * 0.1;
113:  *     }
114:  *     p.lr = lum * 0.725;
115:  *     p.lg = lum * 0.572;
116:  *     p.lb = lum * 0.333;
117:  *   },
118:  *   color: plainColor,
119:  * } satisfies ParticleKind,
120:  * ```
121:  */
122: export const TARKAN_EMISSIONS: Partial<Record<number, readonly Emission[]>> = {
123:   70: [{ kinds: ['waterfall5_9'], every: 5, scale: 0.3 }],
124: };
125: 
126: /**
127:  * `Luminosity = sin(WorldTime * 0.002f) * 0.35f + 0.65f;`
128:  * `AddTerrainLight(x, y, (L, L*0.6, L*0.2), 2, PrimaryTerrainLight);`
129:  * - the brazier, ZzzObject.cpp:4088-4092 (type 61) and :4102-4106 (65/66).
130:  * The flame itself is the type's blend mesh with its V scroll
131:  * (`meshAnimation.ts`), so nothing is added on top of it: no particles, no
132:  * sprite. The original creates neither, and the scrolling `gearB` sheet is
133:  * already a fire.
134:  *
135:  * The sine is ported as `flicker` rather than as a pulse because
136:  * `recipeFromEmitter` (lighting/mapObjectLights.ts) only runs its smooth `pulse` path for emitters that also
137:  * declare a `sprite`, and a brazier has no flare in the original. `flicker`
138:  * over `min` 0.3 / `max` 1.0 covers exactly the sine's range
139:  * (0.65 ± 0.35) in five steps; what is lost is the metronome - a random walk
140:  * inside that range instead of a 3.14 s breath. For a fire that is the better
141:  * of the two errors.
142:  *
143:  * `pointRange` has no C++ counterpart at all (the original has no dynamic
144:  * point lights); it feeds the Babylon pool, and 6 matches what Lorencia's
145:  * street light asks for. There are three braziers on the whole map - two 61s
146:  * at 66.7/181.9 and one 65 at 4.3/247.5, at scale ~1 and 2.98 - so this
147:  * costs nothing.
148:  *
149:  * Type 7, the red glow lamp, also calls `AddTerrainLight` (:4067) and is
150:  * *not* here: its sine is phased by `o->Angle[2] * 100`, a per-object value
151:  * this table cannot see. See `glowLampObject.ts`.
152:  */
153: const brazier: LightEmitter = {
154:   // Z only, and only for the point light: `recipeFromEmitter` (lighting/mapObjectLights.ts) reads x/z, which
155:   // the offset does not move, while `resolveEmitterPosition` lifts the pooled
156:   // light to the bowl (0.4 tiles) instead of leaving it inside the pedestal.
157:   offset: [0, 0, 40],
158:   pointRange: 6,
159:   wander: 0.06,
160:   terrain: {
161:     range: 2,
162:     color: [1, 0.6, 0.2],
163:     flicker: { min: 0.3, max: 1, steps: 5 },
164:   },
165: };
166: 
167: export const TARKAN_LIGHTS: Partial<Record<number, readonly LightEmitter[]>> = {
168:   61: [brazier],
169:   65: [brazier],
170:   66: [brazier],
171: };
</file>

<file path="src/maps/tarkan/ventObject.ts">
  1: import { MapTileObject } from '../../common/mapTileObject';
  2: import { ParticleEmitter, type Emission } from '../../common/effectParticles';
  3: import type { Entity, World } from '../../ecs/world';
  4: 
  5: const DEGREES_PER_RADIAN = 180 / Math.PI;
  6: 
  7: /**
  8:  * One vent's duty cycle: a window inside a `WorldTime % period` loop, and
  9:  * what it spits while it is open. The original writes both as literals inside
 10:  * `RenderObjectVisual`; here they are per-object because type 83 phases its
 11:  * window by the object's own yaw.
 12:  */
 13: type VentWindow = {
 14:   readonly period: number;
 15:   readonly start: number;
 16:   readonly end: number;
 17:   readonly emissions: readonly Emission[];
 18: };
 19: 
 20: /**
 21:  * The shared half of Tarkan's timed dust vents (ZzzObject.cpp:2996-3044):
 22:  * a hidden marker that emits only inside a window of a `WorldTime` loop.
 23:  *
 24:  * The window is tested against `WorldTime`, not against a per-object timer
 25:  * like Atlans' bubble vent (ZzzObject.cpp:4009) - that difference is in the
 26:  * original and is deliberate on both sides. A Tarkan quake is a *map* event:
 27:  * every type 83 within earshot goes off inside the same second, offset only
 28:  * by the yaw the designer gave it, and that is what makes it read as one
 29:  * tremor rather than as ten independent smoke pots.
 30:  *
 31:  * Leaving the emitter un-ticked outside the window is exactly "no dust":
 32:  * `ParticleEmitter` accumulates from its own delta and clamps the backlog to
 33:  * four ticks, so it cannot burst on the frame the window reopens.
 34:  */
 35: abstract class TimedVentObject extends MapTileObject {
 36:   #window: VentWindow | null = null;
 37: 
 38:   #emitter: ParticleEmitter | null = null;
 39: 
 40:   /** `o->Angle[2]` is degrees in the map record; see glowLampObject.ts. */
 41:   protected abstract vent(yawDegrees: number): VentWindow;
 42: 
 43:   async init(world: World, entity: Entity): Promise<void> {
 44:     const window = this.vent(
 45:       (entity.transform?.rot.y ?? 0) * DEGREES_PER_RADIAN
 46:     );
 47: 
 48:     this.#window = window;
 49: 
 50:     await super.init(world, entity);
 51: 
 52:     this.#emitter = new ParticleEmitter(
 53:       world.scene,
 54:       window.emissions,
 55:       this.node.position,
 56:       this.node.rotation.y,
 57:       this.node.scaling.x
 58:     );
 59:   }
 60: 
 61:   dispose(): void {
 62:     this.#emitter = null;
 63:     this.#window = null;
 64: 
 65:     super.dispose();
 66:   }
 67: 
 68:   Update(gameTime: World['gameTime']): void {
 69:     super.Update(gameTime);
 70: 
 71:     const window = this.#window;
 72:     const emitter = this.#emitter;
 73: 
 74:     if (!window || !emitter) return;
 75: 
 76:     const phase = (gameTime.TotalGameTime.TotalSeconds * 1000) % window.period;
 77: 
 78:     if (phase > window.start && phase < window.end) emitter.update();
 79:   }
 80: }
 81: 
 82: /**
 83:  * `if (((int)WorldTime % 5000) > 4500) Smoke = true;` (ZzzObject.cpp:3000) -
 84:  * half a second of dust in every five, in phase across the whole map.
 85:  */
 86: const SAND_VENT_PERIOD = 5000;
 87: const SAND_VENT_START = 4500;
 88: 
 89: /**
 90:  * `CreateParticleFpsChecked(BITMAP_SMOKE, ..., 4, o->Scale)` (:3003) - one
 91:  * per 25 Hz reference tick while the window is open, so twelve or thirteen
 92:  * puffs a burst.
 93:  *
 94:  * SubType 4 is `smoke0`'s motion exactly - `LifeTime 16`,
 95:  * `Scale (rand%32+48)*0.01` *ignoring* the `Scale` argument,
 96:  * `Luminosity = LifeTime / 8`, `Gravity += 0.2`, `Scale += 0.05`
 97:  * (ZzzEffectParticle.cpp:1146, :5395) - with one difference: it is tinted
 98:  * `(120, 100.7, 80) / 255`, a sand colour, where `smoke0` is white. `smoke0`
 99:  * ignores `Emission.light`, so the tint cannot be passed in; it wants its own
100:  * kind:
101:  *
102:  * ```ts
103:  * smoke4: {
104:  *   texture: 'smoke',
105:  *   blend: 'add',
106:  *   init(p) {
107:  *     p.lifeTime = 16;
108:  *     p.scale = (rand(32) + 48) * 0.01;
109:  *     p.rotation = rand(360);
110:  *   },
111:  *   update(p, f) {
112:  *     const lum = p.lifeTime / 8;
113:  *     p.lr = lum * (120 / 255);
114:  *     p.lg = lum * (100.7 / 255);
115:  *     p.lb = lum * (80 / 255);
116:  *     p.gravity += 0.2 * f;
117:  *     p.pz += p.gravity * f;
118:  *     p.scale += f * 0.05;
119:  *   },
120:  *   color: plainColor,
121:  * } satisfies ParticleKind,
122:  * ```
123:  */
124: const SAND_VENT_EMISSIONS: readonly Emission[] = [
125:   { kinds: ['smoke0'], every: 1 },
126: ];
127: 
128: /**
129:  * Tarkan 76 (ZzzObject.cpp:2996-3007), ×19 - the sand puffs along the dune
130:  * ridges and the buried-hand hollows, clustered eight-deep around 81.8/169.7.
131:  */
132: export class TarkanSandVentObject extends TimedVentObject {
133:   protected vent(): VentWindow {
134:     return {
135:       period: SAND_VENT_PERIOD,
136:       start: SAND_VENT_START,
137:       end: SAND_VENT_PERIOD,
138:       emissions: SAND_VENT_EMISSIONS,
139:     };
140:   }
141: }
142: 
143: /**
144:  * ```cpp
145:  * int inter  = (int)o->Angle[2] * 10;
146:  * int timing = (int)WorldTime % 10000;
147:  * if (timing > 3500 + inter && timing < 4000 + inter) Smoke = true;
148:  * ```
149:  * ZzzObject.cpp:3011-3015. Half a second of dust in every ten, offset by ten
150:  * milliseconds per degree of the object's own yaw. EncTerrain9.obj gives type
151:  * 83 five yaws - -90, -60, 0, 90, 150 - so the ten vents fire in three waves
152:  * spread over 2.4 s, which is the tremor rolling across the valley.
153:  */
154: const QUAKE_PERIOD = 10000;
155: const QUAKE_START = 3500;
156: const QUAKE_END = 4000;
157: const QUAKE_PHASE_MS_PER_DEGREE = 10;
158: 
159: /**
160:  * The quake's three streams (ZzzObject.cpp:3017-3029):
161:  *
162:  *  - `CreateParticleFpsChecked(BITMAP_SMOKE, pos, ..., 8, o->Scale)` every
163:  *    tick - the ground burst. SubType 8 throws itself along -Y at
164:  *    `(rand%8+32)*0.3`, keeps `Scale *= 0.8` of the object's scale, then
165:  *    swells and climbs (`Scale += Gravity`, `Position[2] += Gravity * 20`)
166:  *    while damping its lateral velocity to 0.42 a tick, white and fading over
167:  *    24 ticks (ZzzEffectParticle.cpp:1319, :5432). `smoke60` is the closest
168:  *    available: additive, grey, scale-aware, rising and growing. It is softer
169:  *    and much longer-lived (60 ticks), so the burst lingers where the
170:  *    original's snaps.
171:  *  - `rand_fps_check(3)` - a 1-in-3 tick - adds a SubType 4 puff at
172:  *    `(rand%128-64, rand%128-64)` around the vent at half scale. That is
173:  *    `smoke0` + `jitter: 64` (see the SubType 4 note above; SubType 4 ignores
174:  *    the scale argument in the original too, so `smoke0` ignoring
175:  *    `Emission.scale` costs nothing here).
176:  *  - the same roll spawns `MODEL_STONE1 + rand()%2`, a *falling rock model*.
177:  *    We have no effect-model system - nothing can spawn a short-lived,
178:  *    self-moving, non-entity model - so it runs as `waterfall5_9`, the one
179:  *    kind that falls, at the size a small stone would be. This is the same
180:  *    substitution `DUNGEON_EMISSIONS` makes for the ceiling rock-fall, and
181:  *    the two should be revisited together when that system exists.
182:  */
183: const QUAKE_EMISSIONS: readonly Emission[] = [
184:   { kinds: ['smoke60'], every: 1 },
185:   { kinds: ['smoke0'], every: 3, jitter: 64 },
186:   { kinds: ['waterfall5_9'], every: 3, scale: 0.15, jitter: 64 },
187: ];
188: 
189: /**
190:  * Tarkan 83 (ZzzObject.cpp:3008-3033), ×10 - the quake vents, at scales 1.0
191:  * to 2.1, eight of them inside one 32-tile radius at 108.9/237.0.
192:  */
193: export class TarkanQuakeVentObject extends TimedVentObject {
194:   protected vent(yawDegrees: number): VentWindow {
195:     // `(int)o->Angle[2]` truncates toward zero before the multiply, and the
196:     // offset is signed: a -90 deg vent fires 900 ms *early*, at 2600-3100 ms
197:     // into the loop. Every yaw the map actually uses keeps the window inside
198:     // the period; a yaw below -350 deg would push it negative and the vent
199:     // would simply never fire, which is equally true of the original.
200:     const offset = Math.trunc(yawDegrees) * QUAKE_PHASE_MS_PER_DEGREE;
201: 
202:     return {
203:       period: QUAKE_PERIOD,
204:       start: QUAKE_START + offset,
205:       end: QUAKE_END + offset,
206:       emissions: QUAKE_EMISSIONS,
207:     };
208:   }
209: }
</file>

