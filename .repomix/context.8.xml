 3: /**
 4:  * Devil Square (World 9 / `World10`, `Object10`), the plain-data half. Nothing
 5:  * in here may import the scene: the shared registries (`blendMeshes`,
 6:  * `effectOnlyObjects`, `effectParticles`) pull these tables in, and every one
 7:  * of them is imported *by* `modelObject`/`mapTileObject`.
 8:  *
 9:  * EncTerrain10.obj places 564 objects of seven types, all at scale 1: 0 (×52)
10:  * and 1 (×12) the arena walls and corner towers, 2 (×200) and 3 (×191) the two
11:  * fence/pillar runs that ring the four squares, 4 (×55), 5 (×44) and 6 (×10)
12:  * the tilted rubble and dead trees (pitch/roll up to -720°/1680°, i.e. the
13:  * designer spun them). Four identical arenas sit at x 44-87 / 118-152 by
14:  * y 72-110 / 140-184, one per Devil Square level.
15:  */
16: 
17: /**
18:  * `CreateObject` (ZzzObject.cpp) has no `case WD_9DEVILSQUARE` at all: no
19:  * blend mesh, no operate box, no hidden marker. Exported empty so the table
20:  * carries one entry per world and a reader can tell "checked, none" from "not
21:  * looked at yet".
22:  */
23: export const DEVIL_SQUARE_BLEND_MESHES: Readonly<Record<number, number>> = {};
24: 
25: /** `MoveObject` has no case either; nothing on this map is a pure marker. */
26: export const DEVIL_SQUARE_EFFECT_ONLY_TYPES: readonly number[] = [];
27: 
28: /**
29:  * `RenderObjectVisual`, ZzzObject.cpp:3030-3053, is the map's one visual: on
30:  * type 2 (the 200 fence pillars) it drops `BITMAP_RAIN_CIRCLE + 1` ripple
31:  * particles at bones 23 and 31, one in four ticks each plus one every tick -
32:  * rain splashing off the pillar caps, on the map whose rain never stops.
33:  *
34:  * **Not reproduced.** `effectParticles` has no ripple kind (every kind it
35:  * knows rises, falls or drifts; a ground-plane ring that expands and fades is
36:  * a different sprite and a different motion), and a substitute smoke or spark
37:  * on 200 pillars × 3 emitters would read as the pillars burning. The rain
38:  * itself is the weather layer's, which this map now runs at the full
39:  * `MAX_LEAVES` budget (`outdoor` on the entry). Left empty so the
40:  * table says so.
41:  */
42: export const DEVIL_SQUARE_EMISSIONS: Partial<
43:   Record<number, readonly Emission[]>
44: > = {};
</file>

