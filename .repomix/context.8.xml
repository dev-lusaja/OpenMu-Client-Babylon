<file path="src/marketplace/api.ts">
  1: import { sessionNonce } from '../common/sessionNonce';
  2: import { marketApiUrl } from '../common/serverServices';
  3: import type { Item } from '../ecs/world';
  4: 
  5: /**
  6:  * The window's side of the marketplace service.
  7:  *
  8:  * Nothing here sends an account name. The service works out who is calling
  9:  * from a ticket it minted for whoever the proxy saw log in on this page's
 10:  * game socket, so the only credential the window holds is the nonce already
 11:  * on that socket's URL. A window that asked "list this as Bob" would be
 12:  * ignored, which is the point.
 13:  */
 14: 
 15: export type ApiListing = {
 16:   id: string;
 17:   seller: string;
 18:   price: number;
 19:   item: Item;
 20:   category: string;
 21:   state: 'pending' | 'active' | 'claimed' | 'sold' | 'cancelled' | 'returning' | 'stuck';
 22:   buyer: string | null;
 23:   listedAt: number;
 24: };
 25: 
 26: export class MarketError extends Error {
 27:   constructor(
 28:     message: string,
 29:     readonly status: number,
 30:     /** The service is telling us to get a new ticket and try again. */
 31:     readonly retry = false
 32:   ) {
 33:     super(message);
 34:   }
 35: }
 36: 
 37: 
 38: async function request<T>(path: string, init?: RequestInit): Promise<T> {
 39:   const response = await fetch(`${marketApiUrl()}${path}`, {
 40:     // Nothing is cookie-authenticated, and the preflight allows no header but
 41:     // Content-Type, so the ticket rides in the body or the query string.
 42:     credentials: 'omit',
 43:     headers: { 'Content-Type': 'application/json' },
 44:     ...init,
 45:   });
 46: 
 47:   const body = (await response.json().catch(() => ({}))) as { error?: string; retry?: boolean };
 48: 
 49:   if (!response.ok) {
 50:     throw new MarketError(body.error ?? `HTTP ${response.status}`, response.status, body.retry);
 51:   }
 52:   return body as T;
 53: }
 54: 
 55: type Ticket = { ticket: string; account: string };
 56: 
 57: let held: Ticket | null = null;
 58: let heldAt = 0;
 59: 
 60: /** Re-exchanged before it can fail rather than after. */
 61: const TICKET_LIFE_MS = 9 * 60 * 1000;
 62: 
 63: /**
 64:  * Held in a module variable rather than in the observable state: nothing
 65:  * draws it, and an observable copy of a credential is one more place it lives.
 66:  */
 67: async function ticket(fresh = false): Promise<Ticket> {
 68:   if (!fresh && held && Date.now() - heldAt < TICKET_LIFE_MS) return held;
 69: 
 70:   held = await request<Ticket>('/session', {
 71:     method: 'POST',
 72:     body: JSON.stringify({ session: sessionNonce() }),
 73:   });
 74:   heldAt = Date.now();
 75:   return held;
 76: }
 77: 
 78: /** Who the service says we are, or null when it will not vouch for us. */
 79: export async function whoAmI(): Promise<string | null> {
 80:   try {
 81:     return (await ticket()).account;
 82:   } catch {
 83:     return null;
 84:   }
 85: }
 86: 
 87: /** Runs a call, exchanging the ticket once if the service says it is stale. */
 88: async function withTicket<T>(run: (t: Ticket) => Promise<T>): Promise<T> {
 89:   try {
 90:     return await run(await ticket());
 91:   } catch (error) {
 92:     if (error instanceof MarketError && error.status === 401) {
 93:       return run(await ticket(true));
 94:     }
 95:     throw error;
 96:   }
 97: }
 98: 
 99: export function browse(options: { category?: string; limit?: number; offset?: number } = {}) {
100:   return withTicket(t => {
101:     const query = new URLSearchParams({ ticket: t.ticket });
102:     if (options.category && options.category !== 'all') query.set('category', options.category);
103:     if (options.limit !== undefined) query.set('limit', String(options.limit));
104:     if (options.offset !== undefined) query.set('offset', String(options.offset));
105:     return request<{ total: number; listings: ApiListing[] }>(`/listings?${query}`);
106:   });
107: }
108: 
109: export function mine() {
110:   return withTicket(t =>
111:     request<{ listings: ApiListing[]; balance: number }>(
112:       `/mine?ticket=${encodeURIComponent(t.ticket)}`
113:     )
114:   );
115: }
116: 
117: /** Asks for a listing. It is not on sale until a bot has collected the item. */
118: export function list(item: Item, price: number, category: string, character: string) {
119:   return withTicket(t =>
120:     request<{ listing: ApiListing }>('/listings', {
121:       method: 'POST',
122:       body: JSON.stringify({ ticket: t.ticket, session: sessionNonce(), item, price, category, character }),
123:     })
124:   );
125: }
126: 
127: /** Reserves a listing. Exactly one buyer can win this. */
128: export function claim(id: string, character: string) {
129:   return withTicket(t =>
130:     request<{ listing: ApiListing }>(`/listings/${encodeURIComponent(id)}/claim`, {
131:       method: 'POST',
132:       body: JSON.stringify({ ticket: t.ticket, session: sessionNonce(), character }),
133:     })
134:   );
135: }
136: 
137: export function cancel(id: string) {
138:   return withTicket(t =>
139:     request<{ listing: ApiListing }>(`/listings/${encodeURIComponent(id)}/cancel`, {
140:       method: 'POST',
141:       body: JSON.stringify({ ticket: t.ticket, session: sessionNonce() }),
142:     })
143:   );
144: }
145: 
146: /** Asks for what is owed. A bot then meets this character to hand it over. */
147: export function requestPayout(character: string) {
148:   return withTicket(t =>
149:     request<{ owed: number; requested?: boolean }>('/payout', {
150:       method: 'POST',
151:       body: JSON.stringify({ ticket: t.ticket, session: sessionNonce(), character }),
152:     })
153:   );
154: }
155: 
156: /** One thing that happened to this player in the market, as the service tells it. */
157: export type HistoryEntry = {
158:   id: string;
159:   kind: 'sale' | 'purchase' | 'payout';
160:   item: Item | null;
161:   zen: number;
162:   /** The bot that carried it, once one did. */
163:   bot: string | null;
164:   status: 'success' | 'failed' | 'pending';
165:   note: string;
166:   at: number;
167: };
168: 
169: export function history() {
170:   return withTicket(t =>
171:     request<{ history: HistoryEntry[] }>(`/history?ticket=${encodeURIComponent(t.ticket)}`)
172:   );
173: }
</file>

