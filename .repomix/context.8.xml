 99:   /** Whether the event quest list (`QuestEventResponse`) has arrived. */
100:   get eventListReceived(): boolean {
101:     return eventQuestListReceived();
102:   }
103: 
104:   /** `getQuestState2`: 0 none, 1 in progress, 2 finished. */
105:   legacyState(index: number): number {
106:     return legacyQuestState(index);
107:   }
108: 
109:   /** Kills of a monster type counted toward the legacy quest. */
110:   killCount(monsterType: number): number {
111:     return legacyKillCount(monsterType);
112:   }
113: 
114:   /** The emoji bubble a quest NPC should carry, if any. */
115:   bubbleFor(npcType: number): 'exclaim' | 'question' | null {
116:     return questBubbleFor(npcType) as 'exclaim' | 'question' | null;
117:   }
118: 
119:   // ---- commands ----------------------------------------------------------
120: 
121:   /** Start the table download (also happens on the first frame). */
122:   load(): void {
123:     loadQuestData();
124:   }
125: 
126:   /**
127:    * `NpcWindowResponse` fell through every merchant / vault / mix case:
128:    * if the NPC the hero is talking to hands out a legacy quest, open its
129:    * dialog client-side (`ShowQuestNpcWindow`) instead of "nothing for you".
130:    * Returns true when a quest window took the talk over.
131:    */
132:   openNpcWindow(_window: NpcWindowResponseNpcWindowEnum, npcType: number): boolean {
133:     const quest = legacyQuestForNpc(npcType);
134:     if (!quest) return false;
135:     Store.dropNpcTalk();
136:     openLegacyQuestWindow(quest.index);
137:     return true;
138:   }
139: 
140:   /**
141:    * `OpenNpcDialog` (F9 01, `ReceiveNPCDlgUIStart`): the server opened the
142:    * Season 6 NPC dialogue for `npcNumber` (OpenMU sends it for NPCs whose
143:    * window is `NpcDialog` - the buff NPCs, quest givers, Gens stewards).
144:    * Opens `npcDialogue.ts`'s window on page 0 of `NPCDialogue.bmd`; a NPC
145:    * without a page but with a legacy quest gets the legacy dialog instead.
146:    * `contribution` is the Gens contribution the packet carries.
147:    */
