  4: /**
  5:  * Dungeon (World 2 / `Object2`), the plain-data half. Nothing in here may
  6:  * import the scene: the shared registries (`blendMeshes`, `effectOnlyObjects`,
  7:  * `effectParticles`, `effectLights`) pull these tables in, and every one of
  8:  * them is imported *by* `modelObject`/`mapTileObject` - an import back the
  9:  * other way closes the cycle. Anything that needs a `Scene` lives in
 10:  * `index.ts` or an object class instead.
 11:  */
 12: 
 13: /**
 14:  * `CreateObject`, ZzzObject.cpp:4605-4617. The Dungeon case sets `CreateOperate`
 15:  * on 59 and 60 and nothing else - no `o->BlendMesh = N` anywhere in the map,
 16:  * unlike Lorencia (9 types) and Devias (5). The additive second pass the other
 17:  * two towns use for glass and flame is simply not part of this art set; what
 18:  * glows here is the `StreamMesh` flesh curtain (22/23/24), which is unlit
 19:  * rather than additive and lives in `meshAnimation.ts`.
 20:  *
 21:  * Exported empty so the shared table carries one entry per world and a reader
 22:  * can tell "checked, none" from "not looked at yet".
 23:  */
 24: export const DUNGEON_BLEND_MESHES: Readonly<Record<number, number>> = {};
 25: 
 26: /**
 27:  * `MoveObject`, ZzzObject.cpp:3843-3846 (39/40/51) and :3829 (52) - every one
 28:  * of these sets `o->HiddenMesh = -2`, which `Draw_RenderObject`
 29:  * (ZzzObject.cpp:390) reads as "skip the whole body". The original still loads
 30:  * and keeps the BMD, because the map editor draws these so a designer can
 31:  * place them; in game they are pure markers.
 32:  *
 33:  *  - 39 (×27) and 40 (×26) sit in tight clusters on corridor floors - the
 34:  *    spike/blade traps, which the *server* respawns as trap characters. 40 is
 35:  *    a skinned model, so the original animates a body it never draws.
 36:  *  - 51 (×6) is the same idea at doorways.
 37:  *  - 52 (×29) is the rock-fall emitter; see DUNGEON_EMISSIONS.
 38:  *
 39:  * None of the four is ever clicked, so unlike Dungeon 59/60 there is no pick
 40:  * box worth keeping and no reason to pay for the model: the effect-only path
 41:  * in `MapTileObject` skips the load entirely. (Counts from EncTerrain2.obj.)
 42:  */
 43: export const DUNGEON_EFFECT_ONLY_TYPES: readonly number[] = [39, 40, 51, 52];
 44: 
 45: /**
 46:  * Type 52, the ceiling rock-fall (ZzzObject.cpp:3825-3830).
 47:  *
 48:  * The original spawns a *model*, not a particle: `rand_fps_check(3)` - one in
 49:  * three per 25 Hz reference tick - creates a `MODEL_DUNGEON_STONE01`
 50:  * (`Object2/DungeonStone01.glb`) at the emitter offset by
 51:  * `(rand%64-32, -(rand%32+50), rand%128+200)` at scale 0.6-1.3
 52:  * (ZzzEffect.cpp:2970-2977), which then falls under `Gravity -= 1` per tick
 53:  * and bounces off the terrain at 0.4 restitution, losing 4 lifetime a bounce
 54:  * (ZzzEffect.cpp:12146-12157). It is a rigid body with a mesh, a shadow and a
 55:  * ground collision.
 56:  *
 57:  * **This is a deliberate simplification.** We have no effect-model system -
 58:  * nothing in the clone can spawn a short-lived, self-moving, non-entity model
 59:  * - so building one for 29 emitters is out of scope here. Until it exists the
 60:  * emitters run as particles at the reference rate, and read as grit and dust
 61:  * shaken loose from the ceiling rather than as rocks:
 62:  *
 63:  *  - `waterfall5_9` is the only kind in `effectParticles` that *falls*
 64:  *    (`vz = -(rand(5)+7)`, decaying upward); every fire and smoke kind rises.
 65:  *    At `scale` 0.1 its `0.6 + scale` sizing lands on ~45 world units across,
 66:  *    which is about what a 0.6-1.3 scale DungeonStone01 measures - so the
 67:  *    silhouette is roughly honest even though the physics is not.
 68:  *  - `jitter` 32 reproduces the `rand%64-32` horizontal spread of the real
 69:  *    spawn. The vertical half of that offset (200-328 units up, i.e. the
 70:  *    ceiling) is *not* reproduced: `spawnParticle` jitters all three axes by
 71:  *    the same amount and the emitters themselves sit anywhere from 124 to 268
 72:  *    in Z, so the grit starts at the marker and falls from there.
 73:  *  - The `smoke60` puff is ours outright - the original makes no smoke at all.
 74:  *    One every 12 ticks per emitter is a faint, slow veil that sells the
 75:  *    impact the falling streak has no ground contact to show.
 76:  *
 77:  * These 29 emitters are meshless, so `updateFrustumVisibility` can never mark
 78:  * them `OutOfView` and they emit whether or not the camera is looking (the
 79:  * same deal as Lorencia 131/132). At ~10 spawns a second each that is ~300
 80:  * live sprites across two pools of 2048 - measured against Lorencia's ~95
 81:  * torch emitters, which cost more.
 82:  */
 83: export const DUNGEON_EMISSIONS: Partial<Record<number, readonly Emission[]>> = {
 84:   52: [
 85:     { kinds: ['waterfall5_9'], every: 3, scale: 0.1, jitter: 32 },
 86:     { kinds: ['smoke60'], every: 12, jitter: 32 },
 87:   ],
 88: };
 89: 
 90: /**
 91:  * `CreateFire(0, o, x, y, z)` (ZzzEffectFireLeave.cpp:54-73), the wall-torch
 92:  * flame, which every frame:
 93:  *
 94:  *  - rotates the local offset `(x, y, z)` by the object's angle, adds it to
 95:  *    the object position and jitters each axis by `rand[-8,7]`;
 96:  *  - rolls `Luminosity = rand[6,11] * 0.1` and lights with
 97:  *    `(L, L*0.6, L*0.4)`;
 98:  *  - spawns a `BITMAP_FIRE` particle on `rand_fps_check(2)`;
 99:  *  - and *unconditionally* calls `AddTerrainLight(x, y, Light, 4, primary)`.
100:  *
101:  * That is precisely the emitter `createFire()` builds in
102:  * `common/effectLights.ts` - terrain range 4, colour `[1, 0.6, 0.4]`, flicker
103:  * quantised to five steps over 0.6-1.0, one fire sprite every second tick,
104:  * jitter 8. It is module-private there and this file must stay free of scene
105:  * imports, so the recipe is restated rather than imported; if it is ever
106:  * exported, delete this and call it.
107:  *
108:  * Two knowing divergences, both inherited from the shared recipe so that a
109:  * Dungeon torch and a Lorencia torch - the same `CreateFire(0, …)` call -
110:  * cannot end up looking different:
111:  *  - the flicker tops out at 1.0 rather than the C++ 1.1, and steps in fives
112:  *    instead of running continuously;
113:  *  - `pointRange`/`wander` have no C++ counterpart at all; they feed the
114:  *    Babylon point-light pool, which the original does not have.
115:  */
116: const wallTorch = (
117:   offset: readonly [number, number, number]
118: ): LightEmitter => ({
119:   offset,
120:   pointRange: 7,
121:   wander: 0.12,
122:   terrain: {
123:     range: 4,
124:     color: [1, 0.6, 0.4],
125:     flicker: { min: 0.6, max: 1, steps: 5 },
126:   },
127:   emissions: [
128:     {
129:       kinds: ['fire0', 'fire0b'],
130:       every: 2,
131:       jitter: 8,
132:     },
133:   ],
134: });
135: 
136: /**
137:  * ZzzObject.cpp:3837-3842. The two Dungeon torches are the only lights the
138:  * original creates on this map - everything else dark is dark because
139:  * `TerrainLight.OZJ` is baked that way. 41 (×64) is the tall wall sconce, its
140:  * flame 2.4 tiles up and 0.3 back into the bracket; 42 (×56) is the floor
141:  * brazier, flame 1.9 tiles up and centred. Both are at scale 1.0 throughout
142:  * EncTerrain2.obj, so one recipe serves every instance and `emissions` can
143:  * stay an array rather than the size-dependent function Devias 66 needs.
144:  *
145:  * 120 emitters is the highest count of any map wired so far, and it was worth
146:  * checking before committing to the full recipe: Lorencia already carries ~95
147:  * (26×50 + 18×51 + 9×52 + 2×130 + 6×150 + two apiece for 55 and its 16 80s)
148:  * plus 10 street lights, on a map with far longer sightlines. The point
149:  * lights are pooled by distance and the particles pause off-screen, so the
150:  * standing cost is the terrain-light accumulation, which is bounded by the
151:  * range-4 footprint either way.
152:  */
153: export const DUNGEON_LIGHTS: Partial<Record<number, readonly LightEmitter[]>> =
154:   {
155:     41: [wallTorch([0, -30, 240])],
156: 
157:     42: [wallTorch([0, 0, 190])],
158:   };
</file>

