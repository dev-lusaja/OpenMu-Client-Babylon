185: /** One node of the tree (`_MASTER_SKILLTREE_DATA` plus its derived place). */
186: export interface MasterTreeEntry {
187:   /** Position in the class's tree; the key the packets use. */
188:   index: number;
189:   classCode: number;
190:   /** Category column 0…2. */
191:   group: number;
192:   /** Master points one level costs. */
193:   requiredPoints: number;
194:   maxLevel: number;
195:   /** `ArrowDirection` 0…8: which `new_Master_arrow0N` to draw, if any. */
196:   arrow: number;
197:   /** Master skills that must be at level 10 first (0 = none). */
198:   requireSkills: readonly [number, number];
199:   /** The wire skill number. */
200:   skill: number;
201:   /** Display value at level 0; -1 = the tooltip has no value. */
202:   defValue: number;
203:   /** Row 1…9 within the group. */
204:   rank: number;
205:   /** Column 0…3 within the rank. */
206:   column: number;
207: }
