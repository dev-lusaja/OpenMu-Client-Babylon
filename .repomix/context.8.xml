<file path="src/maps/icarus/sky.ts">
  1: import { TILE_CM } from '../../common/terrain/consts';
  2: import type { Observer, Scene } from '../../libs/babylon/exports';
  3: import type { World } from '../../ecs/world';
  4: import { createMovableFlare, type MovableFlare } from '../../common/effectLights';
  5: import { strikeThunder } from '../../lighting/sky';
  6: 
  7: /** MU units per world unit. */
  8: 
  9: /** 25 Hz, the rate `rand_fps_check(n)` counts its one-in-n against. */
 10: const TICKS_PER_SECOND = 25;
 11: 
 12: /** `MoveHeavenThunder`'s `rand_fps_check(50)` - a strike every ~2 s. */
 13: const THUNDER_CHANCE = 50;
 14: 
 15: /** `position.x = Hero->Position.x + rand()%300 - 150` (ZzzObject.cpp:4207). */
 16: const THUNDER_SPREAD_MU = 150;
 17: 
 18: /*
 19:  * The flash itself - its luminosity roll, colour, reach and decay - is the
 20:  * lighting layer's `sky` entry (`src/lighting/sky.ts`, `strikeThunder`).
 21:  */
 22: 
 23: /** `MoveObjectSetting`'s `rand_fps_check(10)` (ZzzObject.cpp:4299). */
 24: const SPARKLE_CHANCE = 10;
 25: 
 26: /** `Hero->Position + (rand()%5000 - 2500, rand()%5000 - 2500, -1000)`. */
 27: const SPARKLE_SPREAD_MU = 2500;
 28: const SPARKLE_DROP_MU = 1000;
 29: 
 30: /**
 31:  * Ring of reusable flares, and how long one lives.
 32:  *
 33:  * At one spawn per ten ticks a strike is due every 400 ms, so six flares are
 34:  * three times what a 1.2 s life needs - the spare slots absorb the run of
 35:  * consecutive hits the geometric distribution guarantees. The lifetime is
 36:  * ours: the original leaves `BITMAP_LIGHT` to its own default, and a twinkle
 37:  * is what the effect is for.
 38:  */
 39: const SPARKLE_RING = 6;
 40: const SPARKLE_LIFE_TICKS = 30;
 41: 
 42: /** `BITMAP_LIGHT` is drawn white here; only its position is randomised. */
 43: const SPARKLE_SCALE = 1.5;
 44: const SPARKLE_COLOR: readonly [number, number, number] = [1, 1, 1];
 45: 
 46: type Sparkle = {
 47:   flare: MovableFlare;
 48:   life: number;
 49: };
 50: 
 51: const rand = (n: number) => Math.floor(Math.random() * n);
 52: 
 53: /**
 54:  * The two world-level movers Icarus runs every frame, which belong to the map
 55:  * rather than to any object on it: `MoveHeavenThunder` (ZzzObject.cpp:4204)
 56:  * and the Icarus half of `MoveObjectSetting` (ZzzObject.cpp:4299). Both are
 57:  * hero-relative - they follow the player around a map with no fixed emitter to
 58:  * hang off - so they live here, created by `createIcarus` and torn down with
 59:  * the map through the entity's `onDispose`.
 60:  *
 61:  * Deliberately not reproduced:
 62:  *  - the thunder bolts themselves. `MoveHeavenThunder` picks one of four
 63:  *    randomised layouts of `CreateJoint(BITMAP_JOINT_THUNDER+1, …)` ribbons at
 64:  *    z-300, 40-49 MU wide, on the one-in-five strikes that are forked. There
 65:  *    is no `CreateJoint` equivalent in this client - joints are a trailing
 66:  *    ribbon primitive, not a sprite - and faking them with billboards would
 67:  *    read as a row of stamps rather than as a bolt.
 68:  *  - the `MODEL_CLOUD` flash plane (`CreateEffect(MODEL_CLOUD, Hero->Position,
 69:  *    …)`, `Scale` 10, `LifeTime` 2, `BlendMesh` 0), for the same reason: it
 70:  *    needs the effect-model pipeline, not a sprite. Its contribution is folded
 71:  *    into the light pulse instead - see THUNDER_RANGE.
 72:  */
 73: export class IcarusSky {
 74:   #observer: Observer<Scene> | null = null;
 75: 
 76:   #scene: Scene;
 77: 
 78:   #world: World;
 79: 
 80:   #tickDue = 0;
 81: 
 82:   /** Where the last strike landed; the strike light copies it. */
 83:   #flashPosition = { x: 0, y: 0, z: 0 };
 84: 
 85:   #sparkles: Sparkle[] = [];
 86: 
 87:   #sparkleCursor = 0;
 88: 
 89:   #disposed = false;
 90: 
 91:   constructor(world: World) {
 92:     this.#world = world;
 93:     this.#scene = world.scene;
 94: 
 95:     for (let i = 0; i < SPARKLE_RING; i++) {
 96:       void createMovableFlare(
 97:         this.#scene,
 98:         SPARKLE_SCALE,
 99:         SPARKLE_COLOR
100:       ).then(flare => {
101:         if (!flare) return;
102: 
103:         if (this.#disposed) {
104:           flare.dispose();
105:           return;
106:         }
107: 
108:         flare.setLuminosity(0);
109:         this.#sparkles.push({ flare, life: 0 });
110:       });
111:     }
112: 
113:     this.#observer = this.#scene.onBeforeRenderObservable.add(() =>
114:       this.#update()
115:     );
116:   }
117: 
118:   #update(): void {
119:     const deltaMs = this.#scene.getEngine().getDeltaTime();
120: 
121:     const hero = this.#world.playerEntity;
122:     if (!hero) return;
123: 
124:     const pos = hero.transform.pos;
125: 
126:     this.#tickDue += (deltaMs / 1000) * TICKS_PER_SECOND;
127: 
128:     // A long stall must not fire a burst of strikes on the frame it ends.
129:     if (this.#tickDue > 4) this.#tickDue = 4;
130: 
131:     while (this.#tickDue >= 1) {
132:       this.#tickDue -= 1;
133: 
134:       this.#ageSparkles();
135: 
136:       if (rand(THUNDER_CHANCE) === 0) this.#strike(pos);
137:       if (rand(SPARKLE_CHANCE) === 0) this.#sparkle(pos);
138:     }
139:   }
140: 
141:   #strike(hero: { x: number; y: number; z: number }): void {
142:     // Only x is jittered in the original, and only over ±150 MU: the strike is
143:     // meant to land on the hero, not near them.
144:     this.#flashPosition.x =
145:       hero.x + (rand(THUNDER_SPREAD_MU * 2) - THUNDER_SPREAD_MU) / TILE_CM;
146:     this.#flashPosition.y = hero.y;
147:     this.#flashPosition.z = hero.z;
148: 
149:     // Lit on the frame it is rolled (the source is `instant`), and it decays
150:     // and removes itself - the lighting layer owns the flash from here.
151:     strikeThunder(this.#scene, this.#flashPosition);
152:   }
153: 
154:   #sparkle(hero: { x: number; y: number; z: number }): void {
155:     if (this.#sparkles.length === 0) return;
156: 
157:     const sparkle = this.#sparkles[this.#sparkleCursor % this.#sparkles.length];
158: 
159:     this.#sparkleCursor++;
160: 
161:     sparkle.life = SPARKLE_LIFE_TICKS;
162: 
163:     // MU x/y are the ground plane and MU z is up, so the -1000 drop puts the
164:     // glow ten tiles below the hero - out in the void the islands float over.
165:     sparkle.flare.moveTo(
166:       hero.x +
167:         (rand(SPARKLE_SPREAD_MU * 2) - SPARKLE_SPREAD_MU) / TILE_CM,
168:       hero.y - SPARKLE_DROP_MU / TILE_CM,
169:       hero.z + (rand(SPARKLE_SPREAD_MU * 2) - SPARKLE_SPREAD_MU) / TILE_CM
170:     );
171:   }
172: 
173:   #ageSparkles(): void {
174:     for (const sparkle of this.#sparkles) {
175:       if (sparkle.life <= 0) continue;
176: 
177:       sparkle.life -= 1;
178: 
179:       // Up and back down over the life, so a glow arrives and leaves instead
180:       // of snapping on at full brightness.
181:       const t = sparkle.life / SPARKLE_LIFE_TICKS;
182: 
183:       sparkle.flare.setLuminosity(Math.sin(Math.PI * t));
184:     }
185:   }
186: 
187:   dispose(): void {
188:     this.#disposed = true;
189: 
190:     if (this.#observer) {
191:       this.#scene.onBeforeRenderObservable.remove(this.#observer);
192:       this.#observer = null;
193:     }
194: 
195:     for (const sparkle of this.#sparkles) sparkle.flare.dispose();
196:     this.#sparkles.length = 0;
197:   }
198: }
</file>

<file path="src/maps/icarus/skySprites.ts">
  1: import { TILE_CM } from '../../common/terrain/consts';
  2: import {
  3:   Constants,
  4:   Sprite,
  5:   SpriteManager,
  6:   type Scene,
  7: } from '../../libs/babylon/exports';
  8: import { downloadDataFile } from '../../libs/mu/dataFolder';
  9: 
 10: /** OZJ is a 24-byte header in front of a plain JPEG (see `effectLights.ts`). */
 11: const OZJ_HEADER_SIZE = 24;
 12: 
 13: /** MU units per world unit - the whole client divides positions by this. */
 14: 
 15: export type SkySpriteTexture = {
 16:   readonly file: string;
 17:   readonly size: number;
 18:   readonly capacity: number;
 19: };
 20: 
 21: /**
 22:  * `BITMAP_CLOUD`, the texture behind every cloud on the map. 256², so a
 23:  * particle at the original's 1.80…1.99 scale draws ~4.9 tiles across.
 24:  *
 25:  * The capacity is a budget, not the reference's count. EncTerrain11.obj holds
 26:  * 335 cloud emitters (16+21+8 of types 0-2 at 20 clouds each, 115+61+114 of
 27:  * types 3-5 at 10 each) - 3800 billboards if every one were in view at once.
 28:  * The visibility radius keeps most of them unbuilt, and `IcarusCloudField`
 29:  * spawns what it can get and lives with a thinner bank when the pool is full,
 30:  * so the first emitters built (which are the ones nearest the hero, since
 31:  * `ModelLoaderSystem` builds on the visibility transition) get their full
 32:  * count.
 33:  */
 34: export const CLOUD_TEXTURE: SkySpriteTexture = {
 35:   file: 'Effect/clouds.OZJ',
 36:   size: 256,
 37:   capacity: 1200,
 38: };
 39: 
 40: /**
 41:  * `BITMAP_CLOUD + 1` - `Effect/cloudLight.OZJ`, also 256². The glow
 42:  * `MoveObjectOnEffect` (ZzzObject.cpp:4338) hangs off a cloud object one frame
 43:  * in ten. Far fewer live at once than clouds: ~2.5 spawns a second per visible
 44:  * emitter, each lasting well under a second.
 45:  */
 46: export const CLOUD_LIGHT_TEXTURE: SkySpriteTexture = {
 47:   file: 'Effect/cloudLight.OZJ',
 48:   size: 256,
 49:   capacity: 256,
 50: };
 51: 
 52: /**
 53:  * A fixed-capacity billboard pool over one OZJ texture.
 54:  *
 55:  * `effectParticles.ts` already pools sprites, and the clouds do not use it for
 56:  * two reasons that both come down to the shape of `ParticleKind`: its blend
 57:  * modes are `add` / `subtract` only, and its update contract owns the
 58:  * particle's motion. See `ICARUS_EMISSIONS` in spec.ts for the long form.
 59:  *
 60:  * Managers are cached per scene and are *not* disposed when the map unloads,
 61:  * matching `effectLights.ts` and `effectParticles.ts` - the sprites are hidden
 62:  * and returned to the free list instead, so a return trip to Icarus reuses the
 63:  * decoded texture rather than downloading and uploading it again.
 64:  */
 65: export class SkySpritePool {
 66:   #free: Sprite[] = [];
 67: 
 68:   #alive = true;
 69: 
 70:   private constructor(
 71:     readonly manager: SpriteManager,
 72:     readonly pixelSize: number,
 73:     readonly capacity: number
 74:   ) {}
 75: 
 76:   static build(
 77:     scene: Scene,
 78:     texture: SkySpriteTexture,
 79:     jpeg: Uint8Array
 80:   ): SkySpritePool {
 81:     const blob = new Blob([jpeg], { type: 'image/jpeg' });
 82: 
 83:     const manager = new SpriteManager(
 84:       `icarusSky_${texture.file}`,
 85:       URL.createObjectURL(blob),
 86:       texture.capacity,
 87:       { width: texture.size, height: texture.size },
 88:       scene
 89:     );
 90: 
 91:     // Every sky billboard in this world is a glow over a dark navy void, and
 92:     // the source is a JPEG with no alpha channel: `ALPHA_COMBINE` would draw
 93:     // the texture's black surround as opaque black squares. The original's
 94:     // clouds are dim (`Light` = 0.1 flat) precisely because they are meant to
 95:     // accumulate, which is what one-one does.
 96:     manager.blendMode = Constants.ALPHA_ONEONE;
 97:     manager.disableDepthWrite = true;
 98:     manager.isPickable = false;
 99: 
100:     return new SkySpritePool(manager, texture.size, texture.capacity);
101:   }
102: 
103:   /** A hidden sprite from the free list, a new one, or null when full. */
104:   acquire(): Sprite | null {
105:     if (!this.#alive) return null;
106: 
107:     const reused = this.#free.pop();
108: 
109:     if (reused) {
110:       reused.isVisible = true;
111:       return reused;
112:     }
113: 
114:     if (this.manager.sprites.length >= this.capacity) return null;
115: 
116:     const sprite = new Sprite('icarusSky', this.manager);
117:     sprite.isPickable = false;
118: 
119:     return sprite;
120:   }
121: 
122:   release(sprite: Sprite): void {
123:     if (!this.#alive) return;
124: 
125:     sprite.isVisible = false;
126:     this.#free.push(sprite);
127:   }
128: 
129:   /** World size of a sprite drawn at `scale`, in tiles. */
130:   sizeFor(scale: number): number {
131:     return (this.pixelSize * scale) / TILE_CM;
132:   }
133: 
134:   dispose(): void {
135:     this.#alive = false;
136:     this.#free.length = 0;
137:     this.manager.dispose();
138:   }
139: }
140: 
141: const pools = new Map<string, SkySpritePool>();
142: const loading = new Map<string, Promise<SkySpritePool | null>>();
143: 
144: let poolScene: Scene | null = null;
145: 
146: /**
147:  * The pool for a texture, building it on first use. Concurrent callers (every
148:  * cloud emitter on the map asks at once during a load) share one download.
149:  */
150: export function getSkySpritePool(
151:   scene: Scene,
152:   texture: SkySpriteTexture
153: ): Promise<SkySpritePool | null> {
154:   // A new scene means the cached managers belong to a disposed one.
155:   if (poolScene !== scene) {
156:     poolScene = scene;
157:     pools.clear();
158:     loading.clear();
159:   }
160: 
161:   const key = texture.file;
162: 
163:   const existing = pools.get(key);
164:   if (existing) return Promise.resolve(existing);
165: 
166:   let inFlight = loading.get(key);
167: 
168:   if (!inFlight) {
169:     inFlight = downloadDataFile(texture.file)
170:       .then(ozj => {
171:         // The scene may have changed while the download was in flight.
172:         if (poolScene !== scene) return null;
173: 
174:         const pool = SkySpritePool.build(
175:           scene,
176:           texture,
177:           ozj.slice(OZJ_HEADER_SIZE)
178:         );
179: 
180:         pools.set(key, pool);
181: 
182:         return pool;
183:       })
184:       .catch(() => null);
185: 
186:     loading.set(key, inFlight);
187:   }
188: 
189:   return inFlight;
190: }
</file>

<file path="src/maps/icarus/spec.ts">
  1: import type { Emission } from '../../common/effectParticles';
  2: import type { LightEmitter } from '../../lighting/mapObjectLights';
  3: 
  4: /**
  5:  * Icarus (World 10 / `WD_10HEAVEN`, assets `Object11`/`World11`) as plain
  6:  * data. Nothing here touches the scene, so the tables can be pulled into the
  7:  * shared registries (`blendMeshes.ts`, `effectLights.ts`, …) without dragging
  8:  * Babylon in behind them.
  9:  *
 10:  * `Object11` ships 16 models, so the world runs types 0…15 - except type 11,
 11:  * which has no `Object12.bmd` at all. EncTerrain11.obj agrees: 670 records,
 12:  * every id from 0 to 15 present except 11.
 13:  */
 14: 
 15: /**
 16:  * Empty on purpose, and it is not an omission.
 17:  *
 18:  * `CreateObject` (ZzzObject.cpp:4433+) has *no* `case WD_10HEAVEN`, so no
 19:  * Icarus type is ever given an `o->BlendMesh`; likewise `MoveObject` is a bare
 20:  * `case WD_10HEAVEN: break;`. Everything the world does at runtime lives in
 21:  * `RenderObjectVisual` (ZzzObject.cpp:3052-3153) and in the two world-level
 22:  * movers (`MoveHeavenThunder`, `MoveObjectSetting`), none of which set a
 23:  * blend mesh.
 24:  *
 25:  * A model whose own BMD marks a mesh as blended still gets it - that comes off
 26:  * the mesh flags in the loader, not from this table.
 27:  */
 28: export const ICARUS_BLEND_MESHES: Readonly<Record<number, number>> = {};
 29: 
 30: /**
 31:  * Types 0-5, the six cloud emitters. All six are the same 50×50×50 MU
 32:  * `연기박스` ("smoke box") mesh - `Object01.bmd` … `Object06.bmd` are byte-for-byte
 33:  * the same 1194-byte file, and the converted `Object01.glb` bounds are
 34:  * (-0.25,-0.25,0)…(0.25,0.25,0.5) - and all six are hidden on their first
 35:  * visible frame (`o->HiddenMesh = -2`, ZzzObject.cpp:3052-3096) and replaced by
 36:  * a bank of cloud billboards.
 37:  *
 38:  * So the box is never drawn and its model is never needed. `IcarusCloudObject`
 39:  * is registered for these ids in `index.ts` and loads nothing at all, which is
 40:  * why they do not also need an entry in `common/effectOnlyObjects.ts`.
 41:  *
 42:  * Note this is *not* the same thing as `Object11/cloud.bmd`: that model is
 43:  * `MODEL_CLOUD`, an effect model loaded by `MapManager.cpp:151` and used only
 44:  * for the overhead lightning flash plane. It is not a map object, and mapping
 45:  * types 4/5 onto it draws a flash plane where a cloud bank belongs.
 46:  */
 47: export const ICARUS_EFFECT_ONLY_TYPES: readonly number[] = [0, 1, 2, 3, 4, 5];
 48: 
 49: /**
 50:  * Also empty, and also not an omission - the clouds are the map's only
 51:  * particle work, and they cannot be expressed as an `Emission`.
 52:  *
 53:  * `ParticleEmitter` re-spawns a `KindName` at a fixed cadence and each particle
 54:  * then lives out a canned life. The Icarus clouds are the opposite shape: a
 55:  * fixed bank of 20 (types 0-2) or 10 (types 3-5) billboards created once when
 56:  * the emitter first becomes visible and kept alive for as long as it stays so
 57:  * (ZzzObject.cpp:3052-3096), each one bobbing on a sine of `WorldTime` and
 58:  * turning about the view axis at its own rate. `cloud21` is the closest kind
 59:  * in `effectParticles.ts` - same `BITMAP_CLOUD` texture, same 1.80…1.99 scale
 60:  * roll, because it is the same particle with a different SubType - but its
 61:  * update rises, sinks and dies, which reads as smoke rather than as a sky.
 62:  *
 63:  * `IcarusCloudObject` therefore drives its own billboards. This table stays as
 64:  * the registration point if a bespoke kind is ever added to
 65:  * `effectParticles.ts`, and so that world 10 has the same shape as the others.
 66:  */
 67: export const ICARUS_EMISSIONS: Partial<Record<number, readonly Emission[]>> = {};
 68: 
 69: /**
 70:  * Type 10 - the only Icarus type with a light. `RenderObjectVisual`
 71:  * (ZzzObject.cpp:3126-3131) resolves bone 3 of the model and drops one
 72:  * `BITMAP_LIGHT` at it every frame:
 73:  *
 74:  *   b->TransformPosition(BoneTransform[3], (0,0,0), Position);
 75:  *   Light = (1,1,1);
 76:  *   CreateParticleFpsChecked(BITMAP_LIGHT, Position, o->Angle, Light, 0, 1.f);
 77:  *
 78:  * A re-created-every-frame particle at a fixed point on a static object is a
 79:  * static flare, so this is one sprite, not an emission - the same reduction
 80:  * `effectLights.ts` already makes for Lorencia's street lamp.
 81:  *
 82:  * The offset is bone 3's own rest translation out of `Object11.glb`
 83:  * (`bone_3_Bone01` at -1.399, -0.000, 5.006 in the BMD's z-up bone frame,
 84:  * metres), rounded to MU units - the two `Sphere01`/`Sphere02` bones sit at
 85:  * (-1.403, 0.004, 4.969) and (-1.400, 0.005, 4.976), i.e. the orb the flare is
 86:  * meant to be inside. `resolveEmitterPosition` rotates it by the object's yaw,
 87:  * so the 1.4 MU-metre lateral kick follows the pillar around.
 88:  *
 89:  * No `terrain` block: the original does not call `AddTerrainLight` here, so
 90:  * there is no terrain pool and no point light either - 180 of these stand on
 91:  * the map (EncTerrain11.obj), and giving each a real light would swamp the
 92:  * point-light pool for a glow that is a billboard in the original.
 93:  */
 94: export const ICARUS_LIGHTS: Partial<Record<number, readonly LightEmitter[]>> = {
 95:   10: [
 96:     {
 97:       offset: [-140, 0, 500],
 98:       // `Light = (1,1,1)`, ZzzObject.cpp:3128. BITMAP_LIGHT's own base size is
 99:       // not recoverable from the call (it passes Scale 1.f and the particle
100:       // supplies the rest), so the flare is sized to the orb it sits in
101:       // rather than guessed: 64 px × 2.5 ÷ 100 ≈ 1.6 tiles across.
102:       sprite: { scale: 2.5, color: [1, 1, 1] },
103:     },
104:   ],
105: };
</file>

