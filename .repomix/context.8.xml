 1: import type { Emission } from '../../common/effectParticles';
 2: 
 3: /**
 4:  * Blood Castle (worlds 11-17 + 52, all on `World12` / `Object12`), the
 5:  * plain-data half. Nothing in here may import the scene: the shared registries
 6:  * (`blendMeshes`, `effectOnlyObjects`, `effectParticles`) pull these tables
 7:  * in, and every one of them is imported *by* `modelObject`/`mapTileObject`.
 8:  *
 9:  * EncTerrain12.obj: 210 objects, 35 types, the castle running north along
10:  * x ~ 5-20. Reading south to north: 0-4 the wall segments on the approach
11:  * (y 19-67), 14/15 the bridge girders under it (z 70-95; the bridge deck is
12:  * the walkable strip at x 14, y 16-21, with `TW_NOMOVE | TW_ACTION` rails at
13:  * x 13 and 15 - the edge `deathSystem` reads for the fall), 20/25/26/27 the
14:  * gatehouse walls (y 73-76), 16/17 the gate towers, 36 the gate at
15:  * (14.5, 76.1), 9/10 the broken-gate halves, 18/19 the throne room at y 91-98
16:  * with 12 the altar and 13 its four lamps; 21/22/23 the 43 hanging banners and
17:  * chains at scale 0.22-1, 30-33 statues and candles, 5/8 rubble.
18:  */
19: 
20: /**
21:  * `CreateObject` has no Blood Castle case (ZzzObject.cpp:4698-4770 falls to
22:  * the default, which is Chaos Castle / Hellas / Battle Castle). No blend
23:  * meshes; the additive pass this art set has is on `_R` textures
24:  * (`light_R`, `light2_R`, `pan_R`, `pant01_R`, `ju01_R`) and comes through
25:  * `textureScript.ts` on its own.
26:  */
27: export const BLOOD_CASTLE_BLEND_MESHES: Readonly<Record<number, number>> = {};
28: 
29: /**
30:  * `MoveObject` (ZzzObject.cpp:4135-4150) hides 9 and 10 unless `PKKey == 4`
31:  * - but they are *not* effect-only markers: they are the gate's two broken
32:  * halves, shown once the gate is down. `BloodCastleGateDebrisObject` owns
33:  * them, so the model loads and simply starts invisible.
34:  */
35: // Type 37: `Data/Object12` stops at Object37.bmd - there is no Object38.bmd for
36: // it, so the original loads nothing and only ever runs the `RenderObjectVisual`
37: // particles. The effect-only path skips the load and keeps the emissions.
38: export const BLOOD_CASTLE_EFFECT_ONLY_TYPES: readonly number[] = [37];
39: 
40: /**
41:  * Type 37 (x9), `RenderObjectVisual` ZzzObject.cpp:3187-3204: on alternate
42:  * quarter-ticks an `ADV_SMOKE` pair and a `CLOUD` + `ADV_SMOKE` + faint pink
43:  * `FLARE` - the smoke vents. Three sit *below* the ground (z -155 … 47) under
44:  * the bridge and the approach, the rest at floor level along the throne room
45:  * walls (z 215). `rand_fps_check(2)` on a `Timer % 4` is one puff of each
46:  * group every ~8 reference ticks, which is what `every: 8` on two rows gives.
47:  * `smoke2` is the shared big grey plume, `smoke0` the small one; the pink
48:  * flare is dropped (a 0.19-scale pink card in the plume reads as an artefact
49:  * without the additive blend the original draws it with).
50:  */
51: export const BLOOD_CASTLE_EMISSIONS: Partial<
52:   Record<number, readonly Emission[]>
53: > = {
54:   37: [
55:     { kinds: ['smoke2'], every: 8, jitter: 8 },
56:     { kinds: ['smoke0'], every: 8, jitter: 8 },
57:   ],
58: };
59: 
60: /** The gate, `Object12/Object37.glb` (type 36, x1 at 14.5, 76.1). */
61: export const BLOOD_CASTLE_GATE_TYPE = 36;
62: 
63: /** The two broken-gate halves the gate leaves behind (types 9 and 10). */
64: export const BLOOD_CASTLE_GATE_DEBRIS_TYPES: readonly number[] = [9, 10];
65: 
66: /** The candelabra (x11) with seven flames on bones 1,2,4,6,9,10,11. */
67: export const BLOOD_CASTLE_CANDELABRA_TYPE = 11;
68: 
69: /** The throne-room lamp (x4) with one breathing flare on bone 3. */
70: export const BLOOD_CASTLE_LAMP_TYPE = 13;
71: 
72: /**
73:  * `AddTerrainAttributeRange(13, 70, 3, 6, TW_NOGROUND, false)`
74:  * (ZzzObject.cpp:139): the pit the gate stands over, cleared when it falls.
