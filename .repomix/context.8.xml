<file path="src/maps/roomEnumeration.ts">
  1: import type { Room } from './layer';
  2: 
  3: /**
  4:  * Every roofed building the hero can walk into, read off the map's object
  5:  * list rather than listed by hand (§13 F10): the roof slabs are grouped into
  6:  * buildings by touching, and the wall pieces standing under each roof give the
  7:  * room its frame. Pure: `rooms.ts` feeds it the records and registers what it
  8:  * finds.
  9:  */
 10: 
 11: export type RoomSpec = {
 12:   /** Object types that are a roof slab. */
 13:   readonly roofTypes: readonly number[];
 14:   /** Half the slab's footprint, tiles; two slabs closer than a full slab touch. */
 15:   readonly roofHalf: number;
 16:   /** Object types whose origin sits on the wall line (posts and wall pieces). */
 17:   readonly wallTypes: readonly number[];
 18:   /**
 19:    * From the wall line to the inner wall face, tiles: positive when the wall
 20:    * body stands inside its line (Lorencia), negative when it stands outside
 21:    * (Devias, body one tile outward of the post line).
 22:    */
 23:   readonly floorFromWallLine: number;
 24:   /**
 25:    * Wall top and roof underside over the walls' base, tiles. The wall top
 26:    * sits a hair under the measured top face, so the face itself is outside
 27:    * the mask's wall box and never reads as a rim.
 28:    */
 29:   readonly wallHeight: number;
 30:   readonly roofHeight: number;
 31: };
 32: 
 33: /** One object record, position in tiles. */
 34: export type RoomRecord = { id: number; x: number; y: number; z: number };
 35: 
 36: /** A room with the height its walls stand at: floor, wall top and roof underside hang off it. */
 37: export type RoomFrame = Room & { readonly base: number };
 38: 
 39: /** Slabs of one roof sit at one height; a piece on another storey is another roof. */
 40: const SAME_ROOF_HEIGHT = 0.6;
 41: /** Slack past a full slab for two pieces to count as touching. */
 42: const TOUCH_MARGIN = 0.3;
 43: /** How far past the roof's edge a wall origin still belongs to the building. */
 44: const WALL_REACH = 1;
 45: 
 46: const round2 = (v: number) => Math.round(v * 2) / 2;
 47: 
 48: export function enumerateRooms(
 49:   records: readonly RoomRecord[],
 50:   spec: RoomSpec
 51: ): RoomFrame[] {
 52:   const roofs = records.filter(r => spec.roofTypes.includes(r.id));
 53:   const walls = records.filter(r => spec.wallTypes.includes(r.id));
 54:   const reach = 2 * spec.roofHalf + TOUCH_MARGIN;
 55:   const used = new Set<RoomRecord>();
 56:   const rooms: RoomFrame[] = [];
 57: 
 58:   for (const seed of roofs) {
 59:     if (used.has(seed)) continue;
 60: 
 61:     const group = [seed];
 62:     used.add(seed);
 63: 
 64:     for (let i = 0; i < group.length; i++) {
 65:       const a = group[i];
 66:       for (const b of roofs) {
 67:         if (used.has(b)) continue;
 68:         if (Math.abs(a.x - b.x) > reach || Math.abs(a.y - b.y) > reach) continue;
 69:         if (Math.abs(a.z - b.z) > SAME_ROOF_HEIGHT) continue;
 70:         group.push(b);
 71:         used.add(b);
 72:       }
 73:     }
 74: 
 75:     let minX = Infinity;
 76:     let minY = Infinity;
 77:     let maxX = -Infinity;
 78:     let maxY = -Infinity;
 79:     for (const p of group) {
 80:       minX = Math.min(minX, p.x - spec.roofHalf);
 81:       maxX = Math.max(maxX, p.x + spec.roofHalf);
 82:       minY = Math.min(minY, p.y - spec.roofHalf);
 83:       maxY = Math.max(maxY, p.y + spec.roofHalf);
 84:     }
 85: 
 86:     // The wall line: the extent of the wall origins under the roof. A roof
 87:     // with no walls under it is a shed, not a room. The lowest wall sets the
 88:     // base: a wall top read off a higher one would let a ray over the low
 89:     // wall's top through.
 90:     let wMinX = Infinity;
 91:     let wMinY = Infinity;
 92:     let wMaxX = -Infinity;
 93:     let wMaxY = -Infinity;
 94:     let base = Infinity;
 95:     for (const w of walls) {
 96:       if (w.x < minX - WALL_REACH || w.x > maxX + WALL_REACH) continue;
 97:       if (w.y < minY - WALL_REACH || w.y > maxY + WALL_REACH) continue;
 98:       wMinX = Math.min(wMinX, w.x);
 99:       wMaxX = Math.max(wMaxX, w.x);
100:       wMinY = Math.min(wMinY, w.y);
101:       wMaxY = Math.max(wMaxY, w.y);
102:       base = Math.min(base, w.z);
103:     }
104:     if (wMinX === Infinity) continue;
105: 
106:     const inset = spec.floorFromWallLine;
107:     const min = { x: round2(wMinX + inset), y: round2(wMinY + inset) };
108:     const max = { x: round2(wMaxX - inset), y: round2(wMaxY - inset) };
109: 
110:     rooms.push({
111:       min,
112:       max,
113:       centre: { x: (min.x + max.x) / 2, z: (min.y + max.y) / 2 },
114:       base,
115:     });
116:   }
117: 
118:   return rooms.sort((a, b) => a.min.x - b.min.x || a.min.y - b.min.y);
119: }
120: 
121: /** Whether two footprints are the same room (an enumerated one against a known row). */
122: export function sameRoom(a: Room, b: Room): boolean {
123:   return (
124:     Math.abs(a.centre.x - b.centre.x) < 2 && Math.abs(a.centre.z - b.centre.z) < 2
125:   );
126: }
</file>

