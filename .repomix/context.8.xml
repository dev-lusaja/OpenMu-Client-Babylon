940:    * guild in the alliance are a union, the rival named by `GuildList` and the
941:    * guild we are at war with are hostile, everyone else is nobody.
942:    */
943:   guildRelationOf(guildId: number | undefined): GuildRelation {
944:     if (guildId === undefined) return GuildRelation.None;
945:     const mine = this.myGuild;
946:     if (mine && guildId === mine.id) return GuildRelation.Union;
947: 
948:     const guild = Store.guilds.get(guildId);
949:     if (!guild) return GuildRelation.None;
950: 
951:     if (this.guildRivalName && guild.name === this.guildRivalName) {
952:       return GuildRelation.Rival;
953:     }
954:     if (this.guildWar && guild.name === this.guildWar.enemyGuild) {
955:       return GuildRelation.Rival;
956:     }
957:     if (this.allianceGuilds.some(g => g.name === guild.name)) {
958:       return GuildRelation.Union;
959:     }
960: 
961:     const myAlliance = mine ? Store.guilds.get(mine.id)?.alliance : '';
962:     if (myAlliance && guild.alliance && guild.alliance === myAlliance) {
963:       return GuildRelation.Union;
964:     }
965: 
966:     return GuildRelation.None;
967:   }
