 13: /**
 14:  * The MU Helper automation loop, ported from `CMuHelper` (MuHelper.cpp). It
 15:  * drives only the seams the player's own clicks use: `world.castRequest`,
 16:  * `world.pickupTarget`, `hero.playerMoveTo` and the store commands. It never
 17:  * builds packets of its own, so combat/pickup behavior stays byte-identical
 18:  * to manual play. Active only while `Store.muHelper.active` - the
 19:  * server-driven status that `MuHelperStatusUpdate` pauses when the zen runs
 20:  * out; inactive, the whole body is a single boolean check.
 21:  */
 22: 
 23: /** `SetTimer(…, 250 ms, TimerProc)` (Winmain.cpp:1282). */
 24: const TICK_SECONDS = 0.25;
 25: /** `m_iLoopCounter++ == 4`: every 5th tick advances the seconds counters. */
 26: const TICKS_PER_SECOND = 5;
 27: const MAX_ACTIONABLE_DISTANCE = 10;
 28: /** `DEFAULT_DURABILITY_THRESHOLD` (MuHelper.cpp:21). */
 29: const REPAIR_THRESHOLD = 50;
 30: const REPAIR_INTERVAL_SECONDS = 10;
 31: /** Recast gap for buffs whose effect id the client cannot observe. */
 32: const UNMAPPED_BUFF_RECAST_SECONDS = 60;
 33: /** Seconds between stop requests while standing in a safe zone. */
 34: const STOP_REQUEST_INTERVAL = 3;
 35: /** Seconds between re-issued regroup walks. */
 36: const MOVE_REISSUE_SECONDS = 1;
 37: 
 38: const HEAL_SKILL = 26; // Heal (Elf)
 39: const DRAIN_LIFE_SKILL = 214; // Drain Life (Summoner)
