<file path="src/quests/objectives.ts">
 1: /**
 2:  * One condition of a quest as a record, and the single line it draws.
 3:  *
 4:  * `CQuestMng::GetRequestRewardText` (QuestMng.cpp) builds that line inside
 5:  * the window that shows it; here it is a pure function of the record so the
 6:  * quest log window and the HUD tracker print the same words for the same
 7:  * condition, and so it can be tested without a packet.
 8:  *
 9:  * The names are resolved by whoever builds the record (`questLog.ts` for the
10:  * Season 6 quests, `legacyQuests.ts` for the Scroll of Emperor chain), out of
11:  * the same databases the windows read.
12:  */
13: import { t } from '../i18n';
14: import { ConditionTypeEnum } from '../common/packets/ServerToClientPackets';
15: 
16: /** A condition of a running quest: what to do and how far along it is. */
17: export type QuestObjective = {
18:   /** `ConditionTypeEnum`, as the `QuestProgress` / `QuestState` packet carries it. */
19:   type: number;
20:   /** `RequirementId`: the monster type, skill number or NPC type. */
21:   id: number;
22:   /** `RequiredCount`. */
23:   required: number;
24:   /** `CurrentCount`. */
25:   current: number;
26:   /** The monster or item the condition names, through the language pack; empty when it names none. */
27:   name: string;
28: };
29: 
30: /** Whether this condition is satisfied. */
31: export function objectiveDone(objective: QuestObjective): boolean {
32:   return objective.current >= objective.required;
33: }
34: 
35: /** `x / y`, clamped at the target the way the original prints it. */
36: export function objectiveProgress(objective: QuestObjective): string {
37:   return `${Math.min(objective.current, objective.required)} / ${objective.required}`;
38: }
39: 
40: /** The line a condition draws, or null for an empty slot. */
41: export function objectiveText(objective: QuestObjective): string | null {
42:   const name = objective.name;
43:   const progress = objectiveProgress(objective);
44: 
45:   switch (objective.type) {
46:     case ConditionTypeEnum.None:
47:       return null;
48:     case ConditionTypeEnum.MonsterKills:
49:       return t('quest.req.hunt', { name, progress });
50:     case ConditionTypeEnum.Item:
51:       return t('quest.req.bring', { name, progress });
52:     case ConditionTypeEnum.Level:
53:       return t('quest.req.level', { level: objective.required });
54:     case ConditionTypeEnum.Money:
55:       return t('quest.req.money', { amount: objective.required.toLocaleString() });
56:     case ConditionTypeEnum.Skill:
57:       return t('quest.req.skill', { id: objective.id });
58:     case ConditionTypeEnum.ClientAction:
59:       return t('quest.req.tutorial');
60:     case ConditionTypeEnum.RequestBuff:
61:       return t('quest.req.buff');
62:     case ConditionTypeEnum.EventMapPlayerKills:
63:     case ConditionTypeEnum.EventMapMonsterKills:
64:       return t('quest.req.eventKills', { progress });
65:     case ConditionTypeEnum.BloodCastleGate:
66:       return t('quest.req.bloodCastleGate');
67:     case ConditionTypeEnum.WinBloodCastle:
68:       return t('quest.req.bloodCastle');
69:     case ConditionTypeEnum.WinChaosCastle:
70:       return t('quest.req.chaosCastle');
71:     case ConditionTypeEnum.WinDevilSquare:
72:       return t('quest.req.devilSquare');
73:     case ConditionTypeEnum.WinIllusionTemple:
74:       return t('quest.req.illusionTemple');
75:     case ConditionTypeEnum.DevilSquarePoints:
76:       return t('quest.req.devilSquarePoints', { progress });
77:     case ConditionTypeEnum.PvpPoints:
78:       return t('quest.req.pvpPoints', { progress });
79:     case ConditionTypeEnum.NpcTalk:
80:       return t('quest.req.talk', { name });
81:     default:
82:       return t('quest.req.other', { type: objective.type, progress });
83:   }
84: }
</file>

<file path="src/quests/questBubbles.ts">
 1: /**
 2:  * Quest state on the HUD: the exclamation / question emoji bubbles
 3:  * (`common/emojiBubbles.ts`) over quest NPCs in scope, the clone's stand-in
 4:  * for the original's lack of any marker.
 5:  *
 6:  * Driven by `legacyQuests.ts` (which NPC gives the hero's next quest, and
 7:  * whether it is in progress) and by the entities in scope. Read by nobody:
 8:  * it only *commands* `EmojiBubbleSystem` by attaching bubbles.
 9:  *
10:  * - `exclaim`: the hero's current quest is not started and this NPC gives it.
11:  * - `question`: the quest is in progress (bring the items back here).
12:  */
13: import type { ENUM_WORLD } from '../common/types';
14: import type { EmojiBubbleId } from '../common/emojiBubbles';
15: import { startEmojiBubble } from '../ecs/systems/emojiBubbleSystem';
16: import { Store } from '../store';
17: import type { QuestLayer } from './layer';
18: import { questDefinition } from './questData';
19: import {
20:   LegacyQuestState,
21:   legacyQuestCurrentIndex,
22:   legacyQuestListReceived,
23:   legacyQuestState,
24: } from './legacyQuests';
25: 
26: // ---- 1. tuning -------------------------------------------------------------
27: 
28: /**
29:  * Seconds between two bubble refreshes. The `exclaim` / `question` bubbles
30:  * live 4 s (`EMOJI_BUBBLES`), so re-arming every 3 s keeps one permanently
31:  * up without stacking pop-ins.
32:  */
33: const REFRESH_SECONDS = 3;
34: 
35: // ---- 2. state + readers ----------------------------------------------------
36: 
37: let sinceRefresh = REFRESH_SECONDS;
38: 
39: /** The bubble a quest NPC of this type should carry right now, if any. */
40: export function questBubbleFor(npcType: number): EmojiBubbleId | null {
41:   if (!legacyQuestListReceived()) return null;
42: 
43:   const index = legacyQuestCurrentIndex();
44:   const quest = questDefinition(index);
45:   if (!quest || quest.npcType !== npcType) return null;
46: 
47:   const state = legacyQuestState(index);
48:   if (state === LegacyQuestState.None) return 'exclaim';
49:   if (state === LegacyQuestState.InProgress) return 'question';
50:   return null;
51: }
52: 
53: function update(_map: ENUM_WORLD, dt: number): void {
54:   sinceRefresh += dt;
55:   if (sinceRefresh < REFRESH_SECONDS) return;
56:   sinceRefresh = 0;
57: 
58:   const world = Store.world;
59:   if (!world) return;
60: 
61:   for (const entity of world.netObjsQuery) {
62:     const type = entity.npcType;
63:     if (type === undefined || entity.localPlayer || entity.objOutOfScope) continue;
64:     const bubble = questBubbleFor(type);
65:     if (bubble) startEmojiBubble(world, entity, bubble);
66:   }
67: }
68: 
69: function reset(): void {
70:   sinceRefresh = REFRESH_SECONDS;
71: }
72: 
73: // ---- 3. the layer ----------------------------------------------------------
74: 
75: export const questBubblesLayer: QuestLayer = { name: 'questBubbles', update, reset };
</file>

<file path="src/quests/questData.ts">
  1: /**
  2:  * The quest tables - `Quest_<lang>.bmd`, `Dialog_<lang>.bmd`,
  3:  * `QuestProgress.bmd`, `QuestWords_<lang>.bmd` - loaded once (and again after
  4:  * a language change) and held here. Driven by nothing but
  5:  * the first frame; read by `legacyQuests.ts` (definitions + dialog pages),
  6:  * `questLog.ts` (progress steps + words) and the quest windows (names).
  7:  *
  8:  * The binary decoding lives in `libs/mu/questFiles.ts` next to `gates.ts`;
  9:  * this entry only owns the loaded tables and the lookups over them.
 10:  */
 11: import { observable, runInAction } from 'mobx';
 12: import type { ENUM_WORLD } from '../common/types';
 13: import { i18n, onLanguageChanged } from '../i18n';
 14: import { loadNpcNames } from '../libs/mu/npcNameFile';
 15: import {
 16:   loadQuestTables,
 17:   type DialogScript,
 18:   type NpcDialogueEntry,
 19:   type QuestDefinition,
 20:   type QuestProgressEntry,
 21:   type QuestTables,
 22: } from '../libs/mu/questFiles';
 23: import type { QuestLayer } from './layer';
 24: 
 25: // ---- 1. tuning -------------------------------------------------------------
 26: 
 27: /**
 28:  * `QuestWords` separates lines with `;` (`DivideStringByPixel` splits on it
 29:  * in the original); every reader hands lines back already split.
 30:  */
 31: const WORDS_LINE_SEPARATOR = ';';
 32: 
 33: // ---- 2. state + readers ----------------------------------------------------
 34: 
 35: /**
 36:  * The decoded tables, in an observable ref: every reader below goes through it,
 37:  * so a component that printed a quest name or a line of words re-renders by
 38:  * itself when a language change swaps the tables underneath.
 39:  */
 40: const tables = observable.box<QuestTables | null>(null, { deep: false });
 41: let requested = false;
 42: 
 43: const state = observable({
 44:   /** True once every table is decoded; the windows wait on it. */
 45:   ready: false,
 46: });
 47: 
 48: /** Kick the download off; safe to call any number of times. */
 49: export function loadQuestData(): void {
 50:   // The monster / NPC names come out of the same language pack, and the quest
 51:   // windows print them beside the quest text.
 52:   void loadNpcNames();
 53: 
 54:   if (requested) return;
 55:   requested = true;
 56: 
 57:   const wanted = i18n.language;
 58: 
 59:   loadQuestTables().then(
 60:     loaded => {
 61:       // A change while this was in flight already started its own load; the
 62:       // one that arrives late must not overwrite it.
 63:       if (i18n.language !== wanted) return;
 64: 
 65:       runInAction(() => {
 66:         tables.set(loaded);
 67:         state.ready = true;
 68:       });
 69:     },
 70:     err => {
 71:       requested = false;
 72:       console.error('Could not load the quest tables:', err);
 73:     }
 74:   );
 75: }
 76: 
 77: // The quest names, the dialogue pages and the quest words all come out of the
 78: // language pack, so a language change has to fetch them again. The windows
 79: // already wait on `ready`, so they redraw by themselves once it flips back.
 80: onLanguageChanged(() => {
 81:   if (!requested) return;
 82: 
 83:   requested = false;
 84:   runInAction(() => {
 85:     tables.set(null);
 86:     state.ready = false;
 87:   });
 88: 
 89:   loadQuestData();
 90: });
 91: 
 92: /** Whether the tables are decoded (MobX-observable). */
 93: export function questDataReady(): boolean {
 94:   return state.ready;
 95: }
 96: 
 97: /** `m_Quest[index]` - a legacy quest, or undefined before load / out of range. */
 98: export function questDefinition(index: number): QuestDefinition | undefined {
 99:   return tables.get()?.quests[index];
100: }
101: 
102: /** Every legacy quest the table holds (an empty list before load). */
103: export function questDefinitions(): readonly QuestDefinition[] {
104:   return tables.get()?.quests ?? [];
105: }
106: 
107: /** `g_DialogScript[index]`. */
108: export function dialogScript(index: number): DialogScript | undefined {
109:   return tables.get()?.dialogs[index];
110: }
111: 
112: /** `m_mapQuestProgress[(number << 16) | group]`. */
113: export function questProgressEntry(key: number): QuestProgressEntry | undefined {
114:   return tables.get()?.progress.get(key);
115: }
116: 
117: /** Every key the progress table holds, in file order. */
118: export function questProgressKeys(): readonly number[] {
119:   return [...(tables.get()?.progress.keys() ?? [])];
120: }
121: 
122: /** `m_mapNPCDialogue[npcIndex * 0x10000 + state]` (`GetNPCDlgNPCWords` / `GetNPCDlgAnswer`). */
123: export function npcDialogueEntry(npcIndex: number, dialogState: number): NpcDialogueEntry | undefined {
124:   return tables.get()?.npcDialogues.get(npcIndex * 0x10000 + dialogState);
125: }
126: 
127: /** `CQuestMng::GetWords`, raw (with the `;` line breaks left in). */
128: export function questWords(index: number): string | undefined {
129:   return tables.get()?.words.get(index);
130: }
131: 
132: /** `GetWords` split into the lines the window draws. */
133: export function questWordLines(index: number): string[] {
134:   const raw = questWords(index);
135:   if (!raw) return [];
136:   return raw.split(WORDS_LINE_SEPARATOR).map(line => line.trim());
137: }
138: 
139: function update(_map: ENUM_WORLD, _dt: number): void {
140:   loadQuestData();
141: }
