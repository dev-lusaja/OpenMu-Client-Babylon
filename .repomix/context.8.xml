<file path="src/marketplace/mockListings.ts">
  1: import type { Item } from '../ecs/world';
  2: import items from '../common/items.json';
  3: import { itemIconUrl } from '../common/itemIconPack';
  4: import { categoryOf, type CategoryId } from './categories';
  5: 
  6: /**
  7:  * Fixture listings for the UI pass. Nothing here survives the service: it
  8:  * exists so the window can be looked at and judged before any bot or database
  9:  * is built. Seeded so the catalogue is the same on every reload, which makes
 10:  * screenshots comparable.
 11:  */
 12: export type Listing = {
 13:   id: string;
 14:   item: Item;
 15:   category: CategoryId;
 16:   seller: string;
 17:   price: number;
 18:   /** Epoch ms. */
 19:   listedAt: number;
 20:   /** What the same item has been selling for, for the "deal" sort. */
 21:   median: number;
 22:   mine?: boolean;
 23:   /** What the service says it is doing. Fixtures have none. */
 24:   state?: 'pending' | 'active' | 'claimed' | 'sold' | 'cancelled' | 'returning' | 'stuck';
 25: };
 26: 
 27: const SELLERS = [
 28:   'Aurelia', 'Bloodmoon', 'Cassiel', 'Darkwynd', 'Ephemera', 'Faelan',
 29:   'Grimwald', 'Halcyon', 'Ignitus', 'Jorvik', 'Kaelthas', 'Lumen',
 30:   'Morrigan', 'Nyxaris', 'Oberon', 'Pyrrhus', 'Quintess', 'Ravenshade',
 31:   'Sable', 'Thalric', 'Umbriel', 'Vesper', 'Wraithe', 'Xanthe',
 32: ];
 33: 
 34: /** mulberry32: small, seeded, and stable across reloads. */
 35: function rng(seed: number): () => number {
 36:   let a = seed >>> 0;
 37:   return () => {
 38:     a = (a + 0x6d2b79f5) >>> 0;
 39:     let t = Math.imul(a ^ (a >>> 15), 1 | a);
 40:     t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
 41:     return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
 42:   };
 43: }
 44: 
 45: const pick = <T,>(r: () => number, list: readonly T[]): T =>
 46:   list[Math.floor(r() * list.length)];
 47: 
 48: /** Round to something a player would actually type. */
 49: function tidyPrice(zen: number): number {
 50:   if (zen >= 100_000_000) return Math.round(zen / 10_000_000) * 10_000_000;
 51:   if (zen >= 10_000_000) return Math.round(zen / 1_000_000) * 1_000_000;
 52:   if (zen >= 1_000_000) return Math.round(zen / 100_000) * 100_000;
 53:   if (zen >= 100_000) return Math.round(zen / 10_000) * 10_000;
 54:   return Math.max(1000, Math.round(zen / 1000) * 1000);
 55: }
 56: 
 57: /**
 58:  * Price from what the item is, not at random: the base item level carries most
 59:  * of it, then the upgrade level compounds, then excellent and ancient multiply.
 60:  * The point is only that the catalogue sorts sensibly and the numbers look
 61:  * plausible next to each other.
 62:  */
 63: function priceOf(item: Item, base: number, r: () => number): number {
 64:   let zen = 20_000 + base * base * 900;
 65:   if (item.lvl) zen *= 1 + item.lvl * 0.55;
 66:   if (item.isExcellent) zen *= 4.5;
 67:   if (item.isAncient) zen *= 7;
 68:   if (item.luck) zen *= 1.3;
 69:   if (item.optionLevel) zen *= 1 + item.optionLevel * 0.15;
 70:   zen *= 0.75 + r() * 0.6;
 71:   return tidyPrice(Math.min(zen, 2_000_000_000));
 72: }
 73: 
 74: const LISTING_COUNT = 180;
 75: 
 76: export function buildMockListings(seed = 20260908): Listing[] {
 77:   const r = rng(seed);
 78:   // Items worth putting on a market: not Zen itself, not the "Sword / Spear /
 79:   // Blade / Axe" style group placeholders, and nothing the icon pack has no
 80:   // picture for - a card with an empty box tells us nothing about the layout.
 81:   const sellable = items.filter(
 82:     def =>
 83:       def.ItemName &&
 84:       !def.ItemName.includes('/') &&
 85:       !(def.Group === 14 && def.Index === 15) &&
 86:       itemIconUrl({ group: def.Group, num: def.Index }) !== null
 87:   );
 88: 
 89:   // Drawn from a limited pool rather than the whole database, so the same item
 90:   // is listed several times over - which is what a real market looks like, and
 91:   // what the sell tab's price comparison needs to have anything to show.
 92:   const pool = sellable
 93:     .map(def => ({ def, order: r() }))
 94:     .sort((a, b) => a.order - b.order)
 95:     .slice(0, 64)
 96:     .map(entry => entry.def);
 97: 
 98:   const now = Date.now();
 99:   const out: Listing[] = [];
100: 
101:   for (let i = 0; i < LISTING_COUNT; i++) {
102:     const def = pick(r, pool);
103:     const gear = def.Group <= 11 || (def.Group === 12 && def.Index <= 6);
104: 
105:     const item: Item = { group: def.Group, num: def.Index };
106:     if (gear) {
107:       const roll = r();
108:       item.lvl = roll > 0.82 ? 9 + Math.floor(r() * 4) : Math.floor(r() * 9);
109:       if (r() > 0.72) item.isExcellent = true;
110:       if (r() > 0.93) item.isAncient = true;
111:       if (r() > 0.7) item.luck = true;
112:       if (r() > 0.6) item.optionLevel = 1 + Math.floor(r() * 4);
113:       if (item.isExcellent) item.excellentFlags = 1 << Math.floor(r() * 6);
114:       item.durability = def.Durability ?? 20;
115:     }
116: 
117:     const price = priceOf(item, def.ItemLvl ?? 0, r);
118:     out.push({
119:       id: `L${(1000 + i).toString(36)}`,
120:       item,
121:       category: categoryOf(item),
122:       seller: pick(r, SELLERS),
123:       price,
124:       listedAt: now - Math.floor(r() * 1000 * 60 * 60 * 72),
125:       median: tidyPrice(price * (0.75 + r() * 0.7)),
126:     });
127:   }
128: 
129:   // A handful are the player's own, one in each state the service can
130:   // answer with, so My Listings shows every pill the window can draw.
131:   const states: NonNullable<Listing['state']>[] = ['pending', 'active', 'claimed', 'returning', 'stuck'];
132:   for (const state of states) {
133:     const l = out[Math.floor(r() * out.length)];
134:     l.mine = true;
135:     l.seller = 'You';
136:     l.state = state;
137:   }
138: 
139:   return out;
140: }
</file>

