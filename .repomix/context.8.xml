<file path="src/skills/masterLevel.ts">
  1: /**
  2:  * The hero's master level, master experience and unspent master points -
  3:  * the original's `Master_Level_Data` (`nMLevel`, `lMasterLevel_Experince`,
  4:  * `lNext_MasterLevel_Experince`, `nMLevelUpMPoint`).
  5:  *
  6:  * Driven by the packets: `MasterStatsUpdate` (F3 50, on entering the game
  7:  * with a master character), `MasterCharacterLevelUpdate` (F3 51, a master
  8:  * level-up), `ExperienceGained` / `ExperienceGainedExtended` (C3 16, every
  9:  * kill share - master experience once the hero is in master progression)
 10:  * and, through `masterTree.ts`, the point count `MasterSkillLevelUpdate`
 11:  * echoes back after a point is spent.
 12:  *
 13:  * Read by the master exp bar (`ui/…/masterSkills/masterExpBar`) and the
 14:  * master tree window through `skills.masterLevel` / `skills.masterExp…`, and
 15:  * by `masterTree.ts` (the point gate).
 16:  */
 17: import { observable, runInAction } from 'mobx';
 18: import type { ENUM_WORLD } from '../common/types';
 19: import { EventBus } from '../libs/eventBus';
 20: import {
 21:   ExperienceGainedExtendedPacket,
 22:   ExperienceGainedPacket,
 23:   MasterCharacterLevelUpdateExtendedPacket,
 24:   MasterCharacterLevelUpdatePacket,
 25:   MasterStatsUpdatePacket,
 26: } from '../common/packets/ServerToClientPackets';
 27: import type { SkillLayer } from './layer';
 28: 
 29: // ---- 1. tuning -------------------------------------------------------------
 30: 
 31: /**
 32:  * `RenderExperience` / `CNewUIMasterLevel::RenderText`: a master level is
 33:  * counted on top of the 400 regular levels (400 is the cap), and the
 34:  * experience curve breaks at level 255 - the two terms of the base formula.
 35:  */
 36: const REGULAR_LEVEL_CAP = 400;
 37: const CURVE_BREAK_LEVEL = 255;
 38: /** The constant the original subtracts before halving (`iBaseExperience`). */
 39: const BASE_EXPERIENCE_OFFSET = 3892250000;
 40: /** `fExpBarNum`: the master bar is ten sub-bars, like the regular one. */
 41: export const MASTER_EXP_SUB_BARS = 10;
 42: 
 43: // ---- 2. state + readers ----------------------------------------------------
 44: 
 45: export interface MasterLevelState {
 46:   /** `nMLevel`, 0 until `MasterStatsUpdate` arrives. */
 47:   level: number;
 48:   /** `lMasterLevel_Experince`: total master experience. */
 49:   experience: number;
 50:   /** `lNext_MasterLevel_Experince`: total needed for the next master level. */
 51:   experienceOfNextLevel: number;
 52:   /** `nMLevelUpMPoint`: master points not yet spent in the tree. */
 53:   levelUpPoints: number;
 54:   /** A master packet has arrived: the hero is in master progression. */
 55:   received: boolean;
 56: }
 57: 
 58: const state = observable.object<MasterLevelState>({
 59:   level: 0,
 60:   experience: 0,
 61:   experienceOfNextLevel: 0,
 62:   levelUpPoints: 0,
 63:   received: false,
 64: });
 65: 
 66: /** The master level, 0 for a hero that has none. */
 67: export function masterLevel(): number {
 68:   return state.level;
 69: }
 70: 
 71: /** Master points waiting to be spent in the tree. */
 72: export function masterLevelUpPoints(): number {
 73:   return state.levelUpPoints;
 74: }
 75: 
 76: /** Total master experience and the total the next master level needs. */
 77: export function masterExperience(): { current: number; next: number } {
 78:   return { current: state.experience, next: state.experienceOfNextLevel };
 79: }
 80: 
 81: /**
 82:  * Whether the hero is levelling as a master - the exp bar and the tree read
 83:  * master values instead of the regular ones (`IsMasterLevel`).
 84:  */
 85: export function inMasterProgression(): boolean {
 86:   return state.received;
 87: }
 88: 
 89: /**
 90:  * `iBaseExperience`: the total experience at which the current master level
 91:  * began, from the original's two-term cubic (`RenderExperience`).
 92:  */
 93: export function masterLevelBaseExperience(level: number): number {
 94:   const total = level + REGULAR_LEVEL_CAP;
 95:   const over = total - CURVE_BREAK_LEVEL;
 96:   const a = (9 + total) * total * total * 10 + (9 + over) * over * over * 1000;
 97:   return Math.trunc((a - BASE_EXPERIENCE_OFFSET) / 2);
 98: }
 99: 
100: /** Progress through the current master level, 0…1. */
101: export function masterExpPercent(): number {
102:   if (state.experienceOfNextLevel <= 0) return 0;
103:   const base = masterLevelBaseExperience(state.level);
104:   const need = state.experienceOfNextLevel - base;
105:   const have = state.experience - base;
106:   if (need <= 0 || have <= 0) return 0;
107:   return Math.min(1, have / need);
108: }
109: 
110: /** `MasterSkillLevelUpdate` echoes the remaining points after a spend. */
111: export function setMasterLevelUpPoints(points: number): void {
112:   runInAction(() => {
113:     state.levelUpPoints = points;
114:   });
115: }
116: 
117: EventBus.on('MasterStatsUpdate', packet => {
118:   const p = new MasterStatsUpdatePacket(packet);
119:   runInAction(() => {
120:     state.level = p.MasterLevel;
121:     state.experience = Number(p.MasterExperience);
122:     state.experienceOfNextLevel = Number(p.MasterExperienceOfNextLevel);
123:     state.levelUpPoints = p.MasterLevelUpPoints;
124:     state.received = true;
125:   });
126: });
127: 
128: function levelUp(p: { MasterLevel: number; CurrentMasterPoints: number }): void {
129:   runInAction(() => {
130:     state.level = p.MasterLevel;
131:     state.levelUpPoints = p.CurrentMasterPoints;
132:     state.received = true;
133:     // The packet has no experience fields: move the bar to the new bracket
134:     // and let the next kill shares fill it (the regular bar does the same).
135:     const base = masterLevelBaseExperience(p.MasterLevel);
136:     if (state.experience < base) state.experience = base;
137:     if (state.experienceOfNextLevel <= state.experience) {
138:       state.experienceOfNextLevel = masterLevelBaseExperience(p.MasterLevel + 1);
139:     }
140:   });
141: }
142: 
143: EventBus.on('MasterCharacterLevelUpdate', packet =>
144:   levelUp(new MasterCharacterLevelUpdatePacket(packet))
145: );
146: // F3 51 extended (client >= 106.3): the same, with 32-bit maximum stats
147: // (`Receive_Master_LevelUp` reads `LPPMSG_MASTERLEVEL_UP_EXTENDED`).
148: EventBus.on('MasterCharacterLevelUpdateExtended', packet =>
149:   levelUp(new MasterCharacterLevelUpdateExtendedPacket(packet))
150: );
151: 
152: function gained(p: { AddedExperience: number }): void {
153:   if (!state.received || p.AddedExperience <= 0) return;
154:   runInAction(() => {
155:     state.experience += p.AddedExperience;
156:   });
157: }
158: 
159: EventBus.on('ExperienceGained', packet => gained(new ExperienceGainedPacket(packet)));
160: EventBus.on('ExperienceGainedExtended', packet =>
161:   gained(new ExperienceGainedExtendedPacket(packet))
162: );
163: 
164: function reset(): void {
165:   // The server sends master stats once, on entering the game, and nothing
166:   // on a warp: the level, experience and points survive the map change.
167:   // A new character's MasterStatsUpdate replaces them wholesale.
168: }
169: 
170: // ---- 3. the layer ----------------------------------------------------------
171: 
172: export const masterLevelLayer: SkillLayer = {
173:   name: 'masterLevel',
174:   reset,
175: };
</file>

