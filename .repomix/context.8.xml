151: function walkTo(hero: Entity, point: Point): void {
152:   const moveTo = hero.playerMoveTo!;
153:   moveTo.point.x = point.x;
154:   moveTo.point.y = point.y;
155:   moveTo.handled = false;
156:   moveTo.sendToServer = true;
157: }
