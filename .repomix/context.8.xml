327: // The tooltips come out of the language pack; drop them on a language change
328: // and let the next window open fetch the new ones.
329: onLanguageChanged(() => {
330:   if (!loading) return;
331: 
332:   loading = null;
333:   runInAction(() => {
334:     dataState.loaded = false;
335:   });
336: });
