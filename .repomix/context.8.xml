237: /**
238:  * Where an effect's icon sits: ids below 81 index the first atlas from 0,
239:  * the rest index the second from 81 (`RenderBuffIcon`); the third atlas,
240:  * which this Data copy ships, continues the sequence.
241:  */
242: export function buffIconCell(
243:   effectId: number
244: ): { file: string; x: number; y: number } | null {
245:   if (effectId <= 0) return null;
246:   let index: number;
247:   let atlas: number;
248:   if (effectId < BUFF_ATLAS2_FIRST) {
249:     index = effectId - 1;
250:     atlas = 0;
251:   } else {
252:     const rest = effectId - BUFF_ATLAS2_FIRST;
253:     atlas = 1 + Math.floor(rest / BUFF_ICONS_PER_ATLAS);
254:     index = rest % BUFF_ICONS_PER_ATLAS;
255:   }
256:   const file = BUFF_ATLASES[atlas];
257:   if (!file) return null;
258:   return {
259:     file,
260:     x: (index % BUFF_ICONS_PER_ROW) * BUFF_ICON_WIDTH,
261:     y: Math.floor(index / BUFF_ICONS_PER_ROW) * BUFF_ICON_HEIGHT,
262:   };
263: }
