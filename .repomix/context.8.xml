 1: import type { World } from '../../ecs/world';
 2: import { BloodCastleCandelabraObject } from './candelabraObject';
 3: import { BloodCastleLampObject } from './lampObject';
 4: import {
 5:   BloodCastleGateDebrisObject,
 6:   BloodCastleGateObject,
 7: } from './gateObject';
 8: import { resetBloodCastleGate } from './gate';
 9: import {
10:   BLOOD_CASTLE_CANDELABRA_TYPE,
11:   BLOOD_CASTLE_GATE_DEBRIS_TYPES,
12:   BLOOD_CASTLE_GATE_PIT,
13:   BLOOD_CASTLE_GATE_TYPE,
14:   BLOOD_CASTLE_LAMP_TYPE,
15: } from './spec';
16: import { TW_NOGROUND } from '../../common/terrain/consts';
17: 
18: /**
19:  * Blood Castle (`WD_11BLOODCASTLE1` … `_END` and the master-level 52 - eight
20:  * server instances on one art set, `World12` + `Object12`; see
21:  * `common/worldAssets.ts`).
22:  *
23:  * What the original does per object here, and where each piece went:
24:  *  - 11 candelabra / 13 lamps: bone-anchored light sprites on a sine
25:  *    (`RenderObjectVisual`, ZzzObject.cpp:3157-3188) - the two classes.
26:  *  - 36 the gate, 9/10 its debris: `ActionObject` (ZzzObject.cpp:60-140) -
27:  *    `gate.ts` + `gateObject.ts`. The fall opens the `TW_NOGROUND` pit under
28:  *    the gate through `world.setTerrainFlags`, which is also what the server's
29:  *    `ChangeTerrainAttributes` packet drives (libs/mu/terrainAttributeUpdates).
30:  *  - 37 smoke vents: `spec.ts` emissions.
31:  *  - 28/29 (`RenderObject`, ZzzObject.cpp:1041-1057): two statue types drawn
32:  *    normally and then *again* as a flat black shadow with `HiddenMesh = 2`.
33:  *    **Not reproduced** - the blob shadow every map object already gets is
34:  *    the same idea, and a second projected copy of a 4-mesh statue is not
35:  *    worth a render path of its own.
36:  *  - The hero's flare motes (`MoveObjectOnEffect`'s `InBloodCastle` branch,
37:  *    ZzzObject.cpp:4315-4330: a `BITMAP_FLARE` every fourth tick in a 9x9 tile
38:  *    box around the player, 2.5-3 tiles up). **Not reproduced**: it is a
39:  *    hero-relative ambient like Icarus's sparkle, and the weather system's
40:  *    sky particles are the place for it once a "motes" recipe exists.
41:  *
42:  * The bridge: `deathSystem` already reads the `TW_ACTION` rails at x 13/15
43:  * (y 16-21) and the pit's `TW_NOGROUND` to pick the fall animation
44:  * (WSclient.cpp:5440-5487); both flags are in EncTerrain12.att as shipped,
45:  * so nothing here has to set them.
46:  *
47:  * Sound: `iBloodCastle` loops from match state 0 (ambientBeds.ts); no music.
48:  * Mood: none registered - `MOOD_BY_WORLD` has no row, so the map runs on the
49:  * default grade plus its own baked lightmap, which is red-brown by design.
50:  */
51: export async function createBloodCastle(world: World) {
52:   const terrain = world.terrain;
53:   if (!terrain) return;
54: 
55:   const tiles = terrain.MapTileObjects;
56: 
57:   // A fresh instance every warp: the gate stands again.
58:   resetBloodCastleGate();
59: 
60:   // Ensure the bridge/pit approach to the gate is walkable so players can reach and attack the gate.
61:   const p = BLOOD_CASTLE_GATE_PIT;
62:   world.setTerrainFlags(p.x, p.y, p.w, p.h, TW_NOGROUND, false);
63: 
64:   tiles[BLOOD_CASTLE_CANDELABRA_TYPE] = BloodCastleCandelabraObject;
65:   tiles[BLOOD_CASTLE_LAMP_TYPE] = BloodCastleLampObject;
66:   tiles[BLOOD_CASTLE_GATE_TYPE] = BloodCastleGateObject;
67:   for (const type of BLOOD_CASTLE_GATE_DEBRIS_TYPES) {
68:     tiles[type] = BloodCastleGateDebrisObject;
69:   }
70: }
</file>

