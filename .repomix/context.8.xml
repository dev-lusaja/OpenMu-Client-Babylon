<file path="src/marketplace/catalogue.ts">
 1: import type { ApiListing } from './api';
 2: import { categoryOf } from './categories';
 3: import type { Listing } from './mockListings';
 4: import type { TextKey } from '../i18n';
 5: 
 6: /**
 7:  * What the window shows, built from the two lists the service answers with:
 8:  * the catalogue (everything on sale, anyone's) and this player's own rows in
 9:  * every state.
10:  *
11:  * Kept apart from the store so it can be tested on its own. The rule it
12:  * enforces is the one the window got wrong before: a listing is *for sale*
13:  * only when the service says `active`. A seller's own `pending` row - the
14:  * trader has not collected it yet - is theirs to watch on the My Listings
15:  * tab, and must never sit in the catalogue looking buyable.
16:  */
17: 
18: export type ListingState = NonNullable<Listing['state']>;
19: 
20: function fromApi(row: ApiListing, mine: boolean): Listing {
21:   return {
22:     id: row.id,
23:     item: row.item as Listing['item'],
24:     category: categoryOf(row.item as Listing['item']),
25:     seller: row.seller,
26:     price: row.price,
27:     listedAt: row.listedAt,
28:     // No history to compare against yet, so nothing claims to be a deal.
29:     median: row.price,
30:     mine: mine || undefined,
31:     state: row.state,
32:   };
33: }
34: 
35: /**
36:  * The catalogue plus this player's own rows. A row that appears in both -
37:  * the player's own active listing - is taken from the own list, so it is
38:  * marked as theirs and is never drawn twice.
39:  */
40: export function mergeCatalogue(catalogue: ApiListing[], own: ApiListing[]): Listing[] {
41:   const ownIds = new Set(own.map(row => row.id));
42:   return [
43:     ...own.map(row => fromApi(row, true)),
44:     ...catalogue.filter(row => !ownIds.has(row.id)).map(row => fromApi(row, false)),
45:   ];
46: }
47: 
48: /** Buyable right now. Fixtures carry no state and count as on sale. */
49: export function isOnSale(listing: Listing): boolean {
50:   return listing.state === undefined || listing.state === 'active';
51: }
52: 
53: /** The seller may still pull it: the service only allows that before a claim. */
54: export function cancellable(listing: Listing): boolean {
55:   if (!listing.mine) return false;
56:   return listing.state === undefined || listing.state === 'pending' || listing.state === 'active';
57: }
58: 
59: /** What a seller's own row is doing, in words. Null for a fixture without one. */
60: export function stateLabelKey(state: ListingState | undefined): TextKey | null {
61:   switch (state) {
62:     case 'pending':
63:       return 'marketplace.state.pending';
64:     case 'active':
65:       return 'marketplace.state.active';
66:     case 'claimed':
67:       return 'marketplace.state.claimed';
68:     case 'returning':
69:       return 'marketplace.state.returning';
70:     case 'stuck':
71:       return 'marketplace.state.stuck';
72:     default:
73:       return null;
74:   }
75: }
76: 
77: /** The same, short enough for a pill; the sentence above is its hover text. */
78: export function statePillKey(state: ListingState | undefined): TextKey | null {
79:   switch (state) {
80:     case 'pending':
81:       return 'marketplace.pill.pending';
82:     case 'active':
83:       return 'marketplace.state.active';
84:     case 'claimed':
85:       return 'marketplace.pill.claimed';
86:     case 'returning':
87:       return 'marketplace.pill.returning';
88:     case 'stuck':
89:       return 'marketplace.pill.stuck';
90:     default:
91:       return null;
92:   }
93: }
</file>

