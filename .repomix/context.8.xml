230: export interface MasterTooltipLine {
231:   text: string;
232:   /** `TextListColor`: 0 white, 1 title yellow, 2 red (unmet), 4 green (next). */
233:   color: 0 | 1 | 2 | 4;
234:   bold?: boolean;
235: }
236: 
237: export type MasterLearnBlock = 'maxed' | 'points' | 'equipment' | 'requirements';
238: 
239: let treeRecords: MasterTreeEntry[] = [];
240: let tooltipRecords: MasterSkillTooltip[] = [];
241: let skillAttributes: MasterSkillAttribute[] = [];
242: let loading: Promise<void> | null = null;
243: 
244: /** Flips once the three files are parsed, so windows re-render. */
245: const dataState = observable.object({ loaded: false });
246: 
247: /**
248:  * Node index → level/value as the server sent them. Keyed by the tree index
249:  * because `MasterSkillList` carries no skill numbers; `MasterSkillLevelUpdate`
250:  * does, and is stored under both.
251:  */
252: const infoByIndex = observable.map<number, MasterSkillInfo>();
253: const infoBySkill = observable.map<number, MasterSkillInfo>();
254: 
255: /** In the code page of the pack the tooltips came from (`localData.ts`). */
256: function cString(bytes: Uint8Array, offset: number, length: number): string {
257:   return decodeLocalText(bytes, offset, length);
258: }
259: 
260: function decodeRecords<T>(
261:   buffer: Uint8Array,
262:   size: number,
263:   count: number,
264:   read: (view: DataView, bytes: Uint8Array) => T | null
265: ): T[] {
266:   const out: T[] = [];
267:   for (let i = 0; i < count && (i + 1) * size <= buffer.length; i++) {
268:     const bytes = buffer.slice(i * size, (i + 1) * size);
269:     convertBux(bytes, size);
270:     const entry = read(new DataView(bytes.buffer, bytes.byteOffset, size), bytes);
271:     if (entry) out.push(entry);
272:   }
273:   return out;
274: }
275: 
276: function parseTree(buffer: Uint8Array): MasterTreeEntry[] {
277:   return decodeRecords(buffer, TREE_RECORD_SIZE, MAX_RECORDS, (v, b) => {
278:     const index = v.getUint16(0, true);
279:     if (!index) return null;
280:     const group = b[4];
281:     const skill = v.getInt32(16, true);
282:     if (index > MASTER_GROUPS * INDICES_PER_GROUP || group >= MASTER_GROUPS || !isMasterSkill(skill)) {
283:       console.warn(`MasterSkillTreeData: record ${index} outside the tree (group ${group}, skill ${skill})`);
284:       return null;
285:     }
286:     const within = (index - 1) % INDICES_PER_GROUP;
287:     return {
288:       index,
289:       classCode: v.getUint16(2, true),
290:       group,
291:       requiredPoints: b[5],
292:       maxLevel: b[6],
293:       arrow: b[7],
294:       requireSkills: [v.getInt32(8, true), v.getInt32(12, true)],
295:       skill,
296:       defValue: v.getFloat32(20, true),
297:       rank: Math.floor(within / MASTER_RANK_COLUMNS) + 1,
298:       column: within % MASTER_RANK_COLUMNS,
299:     };
300:   });
301: }
302: 
303: function parseTooltips(buffer: Uint8Array): MasterSkillTooltip[] {
304:   return decodeRecords(buffer, TOOLTIP_RECORD_SIZE, MAX_RECORDS, (v, b) => {
305:     const skill = v.getInt32(0, true);
306:     if (!skill) return null;
307:     if (!isMasterSkill(skill)) {
308:       console.warn(`MasterSkillTooltip: record with skill ${skill} outside the master range`);
309:       return null;
310:     }
311:     return {
312:       skill,
313:       classCode: v.getUint16(4, true),
314:       info: TOOLTIP_FIELDS.map(([offset, length]) => cString(b, offset, length)),
315:     };
316:   });
317: }
318: 
319: function parseSkillAttributes(buffer: Uint8Array): MasterSkillAttribute[] {
320:   return decodeRecords(buffer, SKILL_RECORD_SIZE, SKILL_RECORDS, (v, b) => ({
321:     icon: v.getUint16(SKILL_ICON_OFFSET, true),
322:     useType: b[SKILL_USE_TYPE_OFFSET],
323:     brand: b[SKILL_BRAND_OFFSET],
324:   }));
325: }
