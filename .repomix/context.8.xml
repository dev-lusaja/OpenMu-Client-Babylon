  1: import {
  2:   createMovableFlare,
  3:   type MovableFlare,
  4: } from '../../common/effectLights';
  5: import {
  6:   BonedParticleEmitter,
  7:   type BonedEmission,
  8: } from '../../common/effectParticles';
  9: import { MapTileObject } from '../../common/mapTileObject';
 10: import { Store } from '../../store';
 11: import type { Entity, World } from '../../ecs/world';
 12: 
 13: type BoneNode = BonedEmission['node'];
 14: 
 15: /**
 16:  * `b->TransformPosition(BoneTransform[1], …)` (ZzzObject.cpp:2951).
 17:  * `Object7/Object10.glb` has exactly two bones - bone 0 `Box01` is the pillar
 18:  * (au_03, z 0…1.08 tiles) and bone 1 `Bone01` sits in the bowl (au_04,
 19:  * z 1.08…2.38) - so bone 1 is the flame.
 20:  */
 21: const FLAME_BONE = 1;
 22: 
 23: /**
 24:  * `Vector(Luminosity * 0.6f, Luminosity * 0.3f, Luminosity * 0.1f, Light)`
 25:  * (ZzzObject.cpp:2949), carried through as written: unlike the terrain light
 26:  * in spec.ts, a sprite colour is not multiplied by anything else, so the
 27:  * original's ratios and magnitude both apply.
 28:  */
 29: const FLARE_COLOR: readonly [number, number, number] = [0.6, 0.3, 0.1];
 30: 
 31: /**
 32:  * `Scale = Luminosity * 5.f` (ZzzObject.cpp:2948) with Luminosity in
 33:  * 0.70…0.99, so 3.5…4.95. `createMovableFlare` cannot resize after creation,
 34:  * so the sprite is built at the midpoint and only its brightness is animated -
 35:  * see the note in `Update`.
 36:  */
 37: const FLARE_SCALE = 4.2;
 38: 
 39: /** `Luminosity = (float)(rand() % 30 + 70) * 0.01f` (ZzzObject.cpp:2743). */
 40: const LUMINOSITY_MIN = 0.7;
 41: const LUMINOSITY_STEPS = 30;
 42: const LUMINOSITY_STEP = 0.01;
 43: 
 44: /** Updates to wait for the skeleton to be posed before lighting anyway. */
 45: const POSE_WAIT_LIMIT = 120;
 46: 
 47: /**
 48:  * The Stadium brazier (type 9, `Object7/Object10.glb`, n=32 in
 49:  * EncTerrain7.obj). The arena's only light source and the only thing on the
 50:  * map with a `RenderObjectVisual` case of its own.
 51:  *
 52:  * **The original's bug, and what "porting the intent" means here.** The C++ is
 53:  *
 54:  * ```cpp
 55:  * b->TransformPosition(BoneTransform[1], Position, p);
 56:  * CreateSprite(BITMAP_LIGHT, p, Scale, Light, o);
 57:  * ```
 58:  *
 59:  * but `TransformPosition` takes (matrix, in, out): the arguments are swapped,
 60:  * so it transforms an **uninitialised** `Position` and the sprite lands at
 61:  * whatever the stack held. Every other caller in the file passes a `p` it has
 62:  * just filled with `Vector(…, p)` first (see ZzzObject.cpp:2760-2764). The
 63:  * same typo sits on Lorencia's merchant animal at ZzzObject.cpp:2770/2772,
 64:  * which is how you can tell it is a slip rather than a trick - nobody writes
 65:  * the same undefined read twice on purpose.
 66:  *
 67:  * What was meant is unambiguous: local (0,0,0) through bone 1, i.e. the bone's
 68:  * own world position, with a warm light sprite on it. That is what this does.
 69:  *
 70:  * The fire particles and the pose-wait are ours; the floor light is in
 71:  * spec.ts. Auto-attack and auto-targeting are disabled in this world (the same
 72:  * rule Chaos Castle runs under) - that is combat work and is not touched
 73:  * here. Music and ambience are handled centrally, and Stadium deliberately has
 74:  * neither: the arena is silent in the original.
 75:  */
 76: export class StadiumBrazierObject extends MapTileObject {
 77:   #bone: BoneNode | null = null;
 78:   #flare: MovableFlare | null = null;
 79:   #fire: BonedParticleEmitter | null = null;
 80:   #lit = false;
 81:   #waited = 0;
 82:   #disposed = false;
 83: 
 84:   async init(world: World, entity: Entity) {
 85:     await super.init(world, entity);
 86: 
 87:     if (!this.gltf) return;
 88: 
 89:     const prefix = `bone_${FLAME_BONE}_`;
 90: 
 91:     for (const bone of this.gltf.skeleton?.bones ?? []) {
 92:       const node = bone.getTransformNode();
 93: 
 94:       if (node?.name.startsWith(prefix)) {
 95:         this.#bone = node;
 96:         break;
 97:       }
 98:     }
 99: 
100:     // Not every skeleton hands its bones a linked transform node; walking the
101:     // node graph by name is the same lookup MapTileObject's wall torch uses,
102:     // and it is what the converter guarantees (`bone_<i>_<bmdName>`,
103:     // tools/bmdToGlb.ts:283).
104:     if (!this.#bone) {
105:       const node = this.gltf.mesh
106:         .getDescendants(false)
107:         .find(n => n.name.startsWith(prefix));
108: 
109:       if (node && 'getAbsolutePosition' in node) {
110:         this.#bone = node as BoneNode;
111:       }
112:     }
113: 
114:     if (!this.#bone) return;
115: 
116:     const scale = this.node.scaling.x;
117: 
118:     // Ours. 32 braziers ring the arena, so the recipe is the restrained one:
119:     // two flame sprites and a wisp of smoke every fourth tick, which fills the
120:     // bowl at this scale without spending the shared 2048-sprite pool on a map
121:     // whose whole point is what the two players in the middle are doing.
122:     this.#fire = new BonedParticleEmitter(world.scene, [
123:       {
124:         node: this.#bone,
125:         kinds: ['fire157'],
126:         count: 1,
127:         scale: scale * 0.28,
128:         light: [0.9, 0.5, 0],
129:       },
130:       {
131:         node: this.#bone,
132:         kinds: ['fire157'],
133:         count: 1,
134:         scale: scale * 0.14,
135:         light: [0.75, 0.35, 0],
136:       },
137:       {
138:         node: this.#bone,
139:         kinds: ['smoke65'],
140:         count: 1,
141:         scale: scale * 0.16,
142:         light: [1, 1, 1],
143:         every: 4,
144:       },
145:     ]);
146:   }
147: 
148:   /**
149:    * BMD bone transforms only exist once a render has posed the skeleton, so
150:    * the flare waits for bone 1 to leave the object origin - created earlier it
151:    * would spend its first frames at the foot of the pillar.
152:    */
153:   #posed(): boolean {
154:     if (!this.#bone) return false;
155: 
156:     const origin = this.node.getAbsolutePosition();
157:     const p = this.#bone.getAbsolutePosition();
158: 
159:     return (
160:       Math.abs(p.x - origin.x) > 1e-3 ||
161:       Math.abs(p.y - origin.y) > 1e-3 ||
162:       Math.abs(p.z - origin.z) > 1e-3
163:     );
164:   }
165: 
166:   #light(world: World): void {
167:     this.#lit = true;
168: 
169:     const bone = this.#bone;
170:     if (!bone) return;
171: 
172:     void createMovableFlare(
173:       world.scene,
174:       FLARE_SCALE * this.node.scaling.x,
175:       FLARE_COLOR
176:     ).then(flare => {
177:       if (!flare) return;
178: 
179:       if (this.#disposed) {
180:         flare.dispose();
181:         return;
182:       }
183: 
184:       const p = bone.getAbsolutePosition();
185:       flare.moveTo(p.x, p.y, p.z);
186: 
187:       this.#flare = flare;
188:     });
189:   }
190: 
191:   dispose(): void {
192:     this.#disposed = true;
193: 
194:     this.#flare?.dispose();
195:     this.#flare = null;
196:     this.#fire = null;
197:     this.#bone = null;
198: 
199:     super.dispose();
200:   }
201: 
202:   Update(gameTime: World['gameTime']): void {
203:     super.Update(gameTime);
204: 
205:     if (!this.Ready || !this.#bone) return;
206: 
207:     const world = Store.world;
208:     if (!world) return;
209: 
210:     if (!this.#lit) {
211:       if (this.#posed() || ++this.#waited >= POSE_WAIT_LIMIT) this.#light(world);
212:       return;
213:     }
214: 
215:     if (this.OutOfView) return;
216: 
217:     this.#fire?.update();
218: 
219:     const flare = this.#flare;
220:     if (!flare) return;
221: 
222:     // The original re-rolls Luminosity every frame and folds it into both the
223:     // sprite's colour *and* its scale, so a brazier breathes in size as well
224:     // as brightness. A pooled Babylon sprite is sized at creation and resizing
225:     // it every frame would mean touching the manager's vertex buffer for 32
226:     // objects, so only the brightness follows the roll. At a 5:1 scale ratio
227:     // of 3.5 to 4.95 the size swing is a ±8% wobble on a soft-edged disc -
228:     // invisible next to the brightness it is riding on.
229:     const lumi =
230:       LUMINOSITY_MIN +
231:       Math.floor(Math.random() * LUMINOSITY_STEPS) * LUMINOSITY_STEP;
232: 
233:     const p = this.#bone.getAbsolutePosition();
234: 
235:     flare.moveTo(p.x, p.y, p.z);
236:     flare.setLuminosity(lumi);
237:   }
238: }
</file>

