  1: import { makeAutoObservable, runInAction } from 'mobx';
  2: import * as api from './api';
  3: import type { HistoryEntry } from './api';
  4: import { CATEGORIES, categoryOf, displayName, type CategoryId } from './categories';
  5: import { isOnSale, mergeCatalogue } from './catalogue';
  6: import { buildMockListings, type Listing } from './mockListings';
  7: import { i18n, t, type TextKey } from '../i18n';
  8: 
  9: export type Tab = 'browse' | 'mine' | 'sell' | 'history';
 10: export type Sort = 'newest' | 'price-asc' | 'price-desc' | 'deal';
 11: export type View = 'list' | 'grid';
 12: 
 13: export const SORTS: { id: Sort; labelKey: TextKey }[] = [
 14:   { id: 'newest', labelKey: 'marketplace.sort.newest' },
 15:   { id: 'price-asc', labelKey: 'marketplace.sort.priceAsc' },
 16:   { id: 'price-desc', labelKey: 'marketplace.sort.priceDesc' },
 17:   { id: 'deal', labelKey: 'marketplace.sort.deal' },
 18: ];
 19: 
 20: export const PAGE_SIZE_GRID = 12;
 21: export const PAGE_SIZE_LIST = 10;
 22: 
 23: /**
 24:  * Marketplace window state.
 25:  *
 26:  * Deliberately imports no `Store`: the window must be mountable on its own so
 27:  * it can be looked at without a game session (see `marketplace.html`). What it
 28:  * needs from the game - the player's Zen and their inventory - is pushed in
 29:  * from the world page instead.
 30:  *
 31:  * Live, the listings are whatever the service answered last; in the
 32:  * standalone harness they are fixtures and the actions move local state.
 33:  */
 34: class MarketplaceStore {
 35:   open = false;
 36:   tab: Tab = 'browse';
 37:   category: CategoryId = 'all';
 38:   search = '';
 39:   sort: Sort = 'newest';
 40:   /**
 41:    * Opens on the list every time, deliberately not remembered: the list is
 42:    * the view that answers "what is for sale and what does it cost", and the
 43:    * grid is for browsing by eye.
 44:    */
 45:   view: View = 'list';
 46:   page = 0;
 47:   excellentOnly = false;
 48:   affordableOnly = false;
 49: 
 50:   /** Pushed in by the world page; the dev harness sets its own. */
 51:   zen = 0;
 52:   /** What the player could put up for sale. Pushed in the same way. */
 53:   inventory: Listing['item'][] = [];
 54:   /**
 55:    * The character a bot has to meet. Pushed in from the world page, because
 56:    * the service knows accounts and a trade happens with a character.
 57:    */
 58:   characterName = '';
 59: 
 60:   /**
 61:    * Empty until a service fills it.
 62:    *
 63:    * The fixtures are for looking at the window, and they must never reach a
 64:    * player: every one of them is invented, so a live build would offer things
 65:    * nobody is selling and take fake Zen for them. Development builds and the
 66:    * standalone harness seed them explicitly instead.
 67:    */
 68:   listings: Listing[] = [];
 69: 
 70:   /** The card the pointer is over, for the tooltip. */
 71:   hovered: { id: string; x: number; y: number } | null = null;
 72:   /** A purchase the player has clicked but not confirmed. */
 73:   confirming: Listing | null = null;
 74:   /** Set for a moment after a purchase, so the window can say so. */
 75:   flash: string | null = null;
 76:   /** Zen the service is holding for this player, from sales made while away. */
 77:   payoutOwed = 0;
 78:   /** What happened to this player's listings, purchases and payouts, newest first. */
 79:   history: HistoryEntry[] = [];
 80: 
 81:   /** Sell tab: which inventory item is picked, and the price typed for it. */
 82:   sellPick: number | null = null;
 83:   sellPrice = '';
 84: 
 85:   constructor() {
 86:     makeAutoObservable(this);
 87:     if (APP_STAGE === 'dev') this.seedFixtures();
 88:   }
 89: 
 90:   /** Fills the catalogue with invented listings. Never call this in a live build. */
 91:   seedFixtures(): void {
 92:     this.listings = buildMockListings();
 93:     // A few invented rows for the history tab, one of each kind and status.
 94:     const kinds = ['sale', 'purchase', 'payout', 'sale', 'sale', 'purchase'] as const;
 95:     const statuses = ['success', 'failed', 'pending', 'pending', 'success', 'failed'] as const;
 96:     const notes = ['sold to Faelan', 'the trade was refused', 'a trader is coming', 'waiting', 'sold to Xanthe', 'nobody bought it'];
 97:     this.history = this.listings.slice(0, 6).map((l, i) => ({
 98:       id: `H${i}`,
 99:       kind: kinds[i],
100:       item: kinds[i] === 'payout' ? null : l.item,
101:       zen: kinds[i] === 'payout' ? 12_500_000 : l.price,
102:       bot: statuses[i] === 'pending' && i === 3 ? null : `MKT00${(i % 3) + 1}`,
103:       status: statuses[i],
104:       note: notes[i],
105:       at: Date.now() - i * 3_600_000 * 5,
106:     }));
107:   }
108: 
109:   /** Pulls the history from the service. Offline, the fixtures stand. */
110:   async loadHistory(): Promise<void> {
111:     if (this.mode === 'offline') return;
112:     try {
113:       const { history } = await api.history();
114:       runInAction(() => {
115:         this.history = history;
116:       });
117:     } catch {
118:       // The catalogue's own refresh reports the service being away.
119:     }
120:   }
121: 
122:   /** No listings at all, as opposed to none matching the current filters. */
123:   get isEmpty(): boolean {
124:     return this.listings.length === 0;
125:   }
126: 
127:   /**
128:    * Whether a service is answering.
129:    *
130:    * `live` is the real marketplace. `offline` is the standalone harness and a
131:    * development build with nothing running behind them, where the fixtures
132:    * stand in. A live build that cannot reach the service stays offline with an
133:    * empty catalogue rather than inventing one.
134:    */
135:   mode: 'unknown' | 'live' | 'offline' = 'unknown';
136:   /** Set when the service refuses or cannot be reached, for the window to show. */
137:   problem: string | null = null;
138:   loading = false;
139: 
140:   toggle(): void {
141:     this.open = !this.open;
142:     if (this.open) {
143:       this.page = 0;
144:       void this.refresh();
145:     } else {
146:       this.closeTransients();
147:     }
148:   }
149: 
150:   /**
151:    * Pulls the catalogue and this player's own listings from the service.
152:    *
153:    * The window shows what the service holds and nothing else: no optimistic
154:    * rows, no local edits that survive a reload. Every action below re-reads
155:    * rather than patching state, because the service is the only thing that
156:    * knows whether a bot actually completed a handover.
157:    */
158:   async refresh(): Promise<void> {
159:     if (this.mode === 'offline') return;
160: 
161:     runInAction(() => {
162:       this.loading = true;
163:     });
164: 
165:     try {
166:       const [catalogue, own] = await Promise.all([api.browse({ limit: 200 }), api.mine()]);
167:       runInAction(() => {
168:         this.mode = 'live';
169:         this.problem = null;
170:         this.listings = mergeCatalogue(catalogue.listings, own.listings);
171:         this.payoutOwed = own.balance;
172:         this.loading = false;
173:       });
174:       if (this.tab === 'history') await this.loadHistory();
175:     } catch (error) {
176:       runInAction(() => {
177:         this.loading = false;
178:         // In a development build the fixtures are the point, so a service that
179:         // is not running is not an error - it is the harness.
180:         if (APP_STAGE === 'dev' && this.listings.length > 0) {
181:           this.mode = 'offline';
182:           return;
183:         }
184:         this.mode = 'live';
185:         this.problem = error instanceof Error ? error.message : t('marketplace.unreachable');
186:       });
187:     }
188:   }
189: 
190:   close(): void {
191:     this.open = false;
192:     this.closeTransients();
193:   }
194: 
195:   private closeTransients(): void {
196:     this.hovered = null;
197:     this.confirming = null;
198:   }
199: 
200:   setTab(tab: Tab): void {
201:     // The sell tab shares the category rail, but it opens on everything you
202:     // carry: arriving at it with a bag filtered to whatever you last browsed
203:     // reads as an empty bag.
204:     if (tab === 'sell') this.category = 'all';
205:     this.tab = tab;
206:     this.page = 0;
207:     this.confirming = null;
208:     if (tab === 'history') void this.loadHistory();
209:   }
210: 
211:   setCategory(category: CategoryId): void {
212:     this.category = category;
213:     this.page = 0;
214:   }
215: 
216:   setSearch(search: string): void {
217:     this.search = search;
218:     this.page = 0;
219:   }
220: 
221:   setSort(sort: Sort): void {
222:     this.sort = sort;
223:     this.page = 0;
224:   }
225: 
226:   setView(view: View): void {
227:     if (this.view === view) return;
228:     // Keep the player roughly where they were rather than snapping to page 1:
229:     // the two views hold different numbers of listings per page.
230:     const firstIndex = this.page * this.pageSize;
231:     this.view = view;
232:     this.page = Math.floor(firstIndex / this.pageSize);
233:     this.setPage(this.page);
234:   }
235: 
236:   get pageSize(): number {
237:     return this.view === 'grid' ? PAGE_SIZE_GRID : PAGE_SIZE_LIST;
238:   }
239: 
240:   toggleExcellentOnly(): void {
241:     this.excellentOnly = !this.excellentOnly;
242:     this.page = 0;
243:   }
244: 
245:   toggleAffordableOnly(): void {
246:     this.affordableOnly = !this.affordableOnly;
247:     this.page = 0;
248:   }
249: 
250:   setPage(page: number): void {
251:     this.page = Math.max(0, Math.min(page, this.pageCount - 1));
252:   }
253: 
254:   hover(id: string, x: number, y: number): void {
255:     this.hovered = { id, x, y };
256:   }
257: 
258:   unhover(id: string): void {
259:     if (this.hovered?.id === id) this.hovered = null;
260:   }
261: 
262:   /** How many listings sit in each rail, for the counts beside the labels. */
263:   get categoryCounts(): Record<string, number> {
264:     const counts: Record<string, number> = { all: 0 };
265:     for (const c of CATEGORIES) counts[c.id] = 0;
266:     for (const l of this.listings.filter(isOnSale)) {
267:       counts.all++;
268:       counts[l.category] = (counts[l.category] ?? 0) + 1;
269:     }
270:     return counts;
271:   }
272: 
273:   /**
274:    * The bag under the same category rail the catalogue uses, carrying each
275:    * item's real inventory index so picking one still addresses the bag.
276:    */
277:   get bagFiltered(): { item: Listing['item']; index: number }[] {
278:     return this.inventory
279:       .map((item, index) => ({ item, index }))
280:       .filter(e => this.category === 'all' || categoryOf(e.item) === this.category);
281:   }
282: 
283:   get bagCounts(): Record<string, number> {
284:     const counts: Record<string, number> = { all: this.inventory.length };
285:     for (const c of CATEGORIES) counts[c.id] ??= 0;
286:     for (const item of this.inventory) {
287:       const id = categoryOf(item);
288:       counts[id] = (counts[id] ?? 0) + 1;
289:     }
290:     return counts;
291:   }
292: 
293:   get matching(): Listing[] {
294:     const needle = this.search.trim().toLowerCase();
295:     // The catalogue is what is actually buyable. A seller's own rows in every
296:     // other state - waiting for the trader, reserved, coming back - are for
297:     // the My Listings tab only, and were the "for sale but never collected"
298:     // rows before this filter existed.
299:     const pool =
300:       this.tab === 'mine' ? this.listings.filter(l => l.mine) : this.listings.filter(isOnSale);
301: 
302:     const filtered = pool.filter(l => {
303:       if (this.tab === 'browse' && this.category !== 'all' && l.category !== this.category) {
304:         return false;
305:       }
306:       if (this.excellentOnly && !l.item.isExcellent && !l.item.isAncient) return false;
307:       if (this.affordableOnly && l.price > this.zen) return false;
308:       if (needle && !displayName(l.item).toLowerCase().includes(needle)) {
309:         if (!l.seller.toLowerCase().includes(needle)) return false;
310:       }
311:       return true;
312:     });
313: 
314:     const sorted = filtered.slice();
315:     switch (this.sort) {
316:       case 'price-asc':
317:         sorted.sort((a, b) => a.price - b.price);
318:         break;
319:       case 'price-desc':
320:         sorted.sort((a, b) => b.price - a.price);
321:         break;
322:       case 'deal':
323:         sorted.sort((a, b) => a.price / a.median - b.price / b.median);
324:         break;
325:       default:
326:         sorted.sort((a, b) => b.listedAt - a.listedAt);
327:     }
328:     return sorted;
329:   }
330: 
331:   get pageCount(): number {
332:     return Math.max(1, Math.ceil(this.matching.length / this.pageSize));
333:   }
334: 
335:   get pageItems(): Listing[] {
336:     const start = Math.min(this.page, this.pageCount - 1) * this.pageSize;
337:     return this.matching.slice(start, start + this.pageSize);
338:   }
339: 
340:   get hoveredListing(): Listing | null {
341:     if (!this.hovered) return null;
342:     return this.listings.find(l => l.id === this.hovered!.id) ?? null;
343:   }
344: 
345:   canAfford(listing: Listing): boolean {
346:     return this.zen >= listing.price;
347:   }
348: 
349:   askBuy(listing: Listing): void {
350:     this.confirming = listing;
351:   }
352: 
353:   cancelBuy(): void {
354:     this.confirming = null;
355:   }
356: 
357:   /**
358:    * Fixture purchase: the Zen and the listing move locally so the flow can be
359:    * walked end to end. The real one is a trade the game server performs.
360:    */
361:   /**
362:    * Reserves the listing. Nothing is bought here and no Zen moves: the service
363:    * holds it for this buyer, and a bot then meets them in game to make the
364:    * exchange. That is the only place goods actually change hands.
365:    */
366:   async confirmBuy(): Promise<void> {
367:     const listing = this.confirming;
368:     if (!listing || !this.canAfford(listing)) return;
369: 
370:     if (this.mode === 'offline') {
371:       // The harness has no service to reserve anything with.
372:       this.zen -= listing.price;
373:       this.listings = this.listings.filter(l => l.id !== listing.id);
374:       this.confirming = null;
375:       this.flash = t('marketplace.bought', { name: displayName(listing.item) });
376:       this.setPage(this.page);
377:       return;
378:     }
379: 
380:     runInAction(() => {
381:       this.confirming = null;
382:     });
383: 
384:     try {
385:       await api.claim(listing.id, this.characterName);
386:       runInAction(() => {
387:         this.flash = t('marketplace.reserved', { name: displayName(listing.item) });
388:       });
389:     } catch (error) {
390:       runInAction(() => {
391:         this.flash = error instanceof Error ? error.message : t('marketplace.buyRefused');
392:       });
393:     }
394:     await this.refresh();
395:   }
396: 
397:   async cancelListing(id: string): Promise<void> {
398:     const listing = this.listings.find(l => l.id === id);
399:     if (!listing) return;
400: 
401:     if (this.mode === 'offline') {
402:       this.listings = this.listings.filter(l => l.id !== id);
403:       this.flash = t('marketplace.cancelled', { name: displayName(listing.item) });
404:       this.setPage(this.page);
405:       return;
406:     }
407: 
408:     try {
409:       await api.cancel(id);
410:       runInAction(() => {
411:         this.flash = t('marketplace.cancelling', { name: displayName(listing.item) });
412:       });
413:     } catch (error) {
414:       runInAction(() => {
415:         this.flash = error instanceof Error ? error.message : t('marketplace.cancelFailed');
416:       });
417:     }
418:     await this.refresh();
419:   }
420: 
421:   pickForSale(index: number | null): void {
422:     this.sellPick = index;
423:     this.sellPrice = '';
424:   }
425: 
426:   setSellPrice(value: string): void {
427:     // Digits only, and never above the game's own Zen ceiling.
428:     const digits = value.replace(/\D/g, '').slice(0, 10);
429:     const n = Number(digits || 0);
430:     this.sellPrice = n > 2_000_000_000 ? '2000000000' : digits;
431:   }
432: 
433:   get sellPriceValue(): number {
434:     return Number(this.sellPrice || 0);
435:   }
436: 
437:   /**
438:    * What the same item is going for right now, cheapest first. Matched on the
439:    * base item rather than the exact roll: a seller wants to see every Dragon
440:    * Armor on the market, then judge their own +9 excellent against them.
441:    */
442:   get comparable(): Listing[] {
443:     const item = this.sellPick === null ? null : this.inventory[this.sellPick];
444:     if (!item) return [];
445:     return this.listings
446:       .filter(l => isOnSale(l) && l.item.group === item.group && l.item.num === item.num)
447:       .sort((a, b) => a.price - b.price);
448:   }
449: 
450:   /** The cheapest of those, which is the number a seller actually undercuts. */
451:   get comparableFloor(): number | null {
452:     return this.comparable[0]?.price ?? null;
453:   }
454: 
455:   /**
456:    * Asks the service to list the item. It is not on sale yet: a bot has to
457:    * come and take it first, and only then does anyone else see it. Saying
458:    * "listed" here would be a lie, so the wording says what actually happens.
459:    */
460:   async listForSale(): Promise<void> {
461:     const index = this.sellPick;
462:     const item = index === null ? null : this.inventory[index];
463:     if (!item || this.sellPriceValue <= 0) return;
464: 
465:     if (this.mode === 'offline') {
466:       this.listings = [
467:         {
468:           id: `L${Math.random().toString(36).slice(2, 7)}`,
469:           item,
470:           category: categoryOf(item),
471:           seller: t('marketplace.you'),
472:           price: this.sellPriceValue,
473:           listedAt: Date.now(),
474:           median: this.sellPriceValue,
475:           mine: true,
476:         },
477:         ...this.listings,
478:       ];
479:       this.inventory = this.inventory.filter((_, i) => i !== index);
480:       this.sellPick = null;
481:       this.sellPrice = '';
482:       this.flash = t('marketplace.listedFlash', { name: displayName(item) });
483:       this.setTab('mine');
484:       return;
485:     }
486: 
487:     const price = this.sellPriceValue;
488:     try {
489:       await api.list(item, price, categoryOf(item), this.characterName);
490:       runInAction(() => {
491:         this.sellPick = null;
492:         this.sellPrice = '';
493:         this.flash = t('marketplace.traderComing', { name: displayName(item) });
494:       });
495:       this.setTab('mine');
496:     } catch (error) {
497:       runInAction(() => {
498:         this.flash = error instanceof Error ? error.message : t('marketplace.listRefused');
499:       });
500:     }
501:     await this.refresh();
502:   }
503: 
504:   /** Asks for the Zen the service is holding from sales made while away. */
505:   async collectPayout(): Promise<void> {
506:     if (this.payoutOwed <= 0) return;
507:     try {
508:       const { owed, requested } = await api.requestPayout(this.characterName);
509:       runInAction(() => {
510:         // A service from before Collect was a request answers without the
511:         // flag; saying a trader is coming would then be a lie.
512:         this.flash = requested
513:           ? t('marketplace.payoutComing', { amount: formatZen(owed) })
514:           : t('marketplace.collectUnavailable');
515:       });
516:     } catch (error) {
517:       runInAction(() => {
518:         this.flash = error instanceof Error ? error.message : t('marketplace.collectFailed');
519:       });
520:     }
521:   }
522: 
523:   clearFlash(): void {
524:     this.flash = null;
525:   }
526: 
527:   /** The world page pushes the live numbers in; the harness pushes fixtures. */
528:   syncFromGame(zen: number, inventory: Listing['item'][], characterName = ''): void {
529:     if (characterName) this.characterName = characterName;
530:     this.zen = zen;
531:     this.inventory = inventory;
532:   }
533: }
534: 
535: export const Marketplace = new MarketplaceStore();
536: 
537: export const toggleMarketplaceWindow = () => Marketplace.toggle();
538: 
539: export function formatZen(zen: number): string {
540:   // Grouping follows the player's language: 1,250,000 in English, 1.250.000
541:   // in Spanish and German, 1 250 000 in French.
542:   return zen.toLocaleString(i18n.language);
543: }
544: 
545: /** "2h ago" / "3d ago", short enough for a card corner. */
546: export function sinceLabel(at: number): string {
547:   const mins = Math.max(0, Math.floor((Date.now() - at) / 60000));
548:   if (mins < 60) return t('marketplace.agoMinutes', { value: mins });
549:   const hours = Math.floor(mins / 60);
550:   if (hours < 24) return t('marketplace.agoHours', { value: hours });
551:   return t('marketplace.agoDays', { value: Math.floor(hours / 24) });
552: }
</file>

