<file path="src/skills/usability.ts">
  1: /**
  2:  * Whether the hero can cast a skill right now, and why not - the client-side
  3:  * half of `CNewUISkillList::RenderSkillIcon`'s `bCantSkill` (the greyed
  4:  * icon) plus the moment-to-moment gates the cast system checks before it
  5:  * sends (`CheckSkillUseCondition`, mana / AG, `CheckSkillDelay`).
  6:  *
  7:  * Two readers, on purpose: `skillRequirementsMet` is the *static* rule -
  8:  * class, level, energy, the weapon a weapon-skill hangs off - and is what
  9:  * greys the icon; `canUseSkill` adds the *transient* gates (mana, AG, the
 10:  * running delay, the safe zone the hero stands in) and is what the cast
 11:  * system and the tooltip ask.
 12:  *
 13:  * Driven by `Store.playerData` (stats, hands, tile, skills) and `cooldowns.ts`
 14:  * (listed before this entry). Pure readers over MobX state: no clock, so no
 15:  * `update`; nothing held, so no `reset`.
 16:  */
 17: import { CharacterClassNumber } from '../common/types';
 18: import { ItemsDatabase } from '../common/itemsDatabase';
 19: import { skillDefinition, type SkillDefinition } from '../common/skillsDatabase';
 20: import { TW_SAFEZONE } from '../common/terrain/consts';
 21: import type { Item } from '../ecs/world';
 22: import type { SkillLayer } from './layer';
 23: import { skillCooldownRemaining } from './cooldowns';
 24: import { Store } from '../store';
 25: 
 26: // ---- 1. tuning -------------------------------------------------------------
 27: 
 28: // Every threshold is a skill's own row in skillsDatabase.
 29: 
 30: /**
 31:  * Item groups 0..5 are the weapons (ITEM_SWORD … ITEM_STAFF). Orbs (12) also
 32:  * fill the `Skill` column, but that is the skill they *teach*, not grant.
 33:  */
 34: const LAST_WEAPON_GROUP = 5;
 35: 
 36: /**
 37:  * OpenMU's `CharacterClasses` flag names as they appear in `classes` of
 38:  * skillsDatabase.ts, spelled out as the wire class numbers each covers.
 39:  * A skill's expression is `A | B`; the hero needs one of them.
 40:  */
 41: const C = CharacterClassNumber;
 42: const MAGICIANS = [C.DarkWizard, C.SoulMaster, C.GrandMaster];
 43: const KNIGHTS = [C.DarkKnight, C.BladeKnight, C.BladeMaster];
 44: const ELFS = [C.FairyElf, C.MuseElf, C.HighElf];
 45: const MGS = [C.MagicGladiator, C.DuelMaster];
 46: const LORDS = [C.DarkLord, C.LordEmperor];
 47: const SUMMONERS = [C.Summoner, C.BloodySummoner, C.DimensionMaster];
 48: const FIGHTERS = [C.RageFighter, C.FistMaster];
 49: const MASTERS = [
 50:   C.GrandMaster, C.BladeMaster, C.HighElf, C.DuelMaster, C.LordEmperor,
 51:   C.DimensionMaster, C.FistMaster,
 52: ];
 53: const SECOND_CLASS = [
 54:   C.SoulMaster, C.BladeKnight, C.MuseElf, C.MagicGladiator, C.DarkLord,
 55:   C.BloodySummoner, C.RageFighter,
 56: ];
 57: 
 58: const CLASS_FLAGS: Record<string, readonly CharacterClassNumber[]> = {
 59:   None: [],
 60:   All: [...MAGICIANS, ...KNIGHTS, ...ELFS, ...MGS, ...LORDS, ...SUMMONERS, ...FIGHTERS],
 61:   AllMagicians: MAGICIANS,
 62:   AllSummoners: SUMMONERS,
 63:   AllKnights: KNIGHTS,
 64:   AllMGs: MGS,
 65:   AllLords: LORDS,
 66:   AllElfs: ELFS,
 67:   AllFighters: FIGHTERS,
 68:   AllKnightsLordsAndMGs: [...KNIGHTS, ...LORDS, ...MGS],
 69:   SoulMasterAndGrandMaster: [C.SoulMaster, C.GrandMaster],
 70:   BladeKnightAndBladeMaster: [C.BladeKnight, C.BladeMaster],
 71:   MuseElfAndHighElf: [C.MuseElf, C.HighElf],
 72:   AllMasters: MASTERS,
 73:   AllMastersAndSecondClass: [...MASTERS, ...SECOND_CLASS],
 74:   AllMastersExceptFistMaster: MASTERS.filter(c => c !== C.FistMaster),
 75:   GrandMaster: [C.GrandMaster],
 76:   BladeMaster: [C.BladeMaster],
 77:   HighElf: [C.HighElf],
 78:   DuelMaster: [C.DuelMaster],
 79:   LordEmperor: [C.LordEmperor],
 80:   DimensionMaster: [C.DimensionMaster],
 81:   FistMaster: [C.FistMaster],
 82: };
 83: 
 84: // ---- 2. state + readers ----------------------------------------------------
 85: 
 86: /** Why a skill is not castable, in the order the tooltip lists them. */
 87: export type SkillBlock =
 88:   | 'unknown'
 89:   | 'class'
 90:   | 'level'
 91:   | 'energy'
 92:   | 'weapon'
 93:   | 'mana'
 94:   | 'ag'
 95:   | 'cooldown'
 96:   | 'safezone';
 97: 
 98: export interface SkillUsability {
 99:   /** Everything passes: the cast system may send. */
100:   usable: boolean;
101:   /** `bCantSkill`: the static rules pass, so the icon is drawn in colour. */
102:   requirementsMet: boolean;
103:   blocks: SkillBlock[];
104: }
105: 
106: /**
107:  * Skill number → weapon kinds (group/index) whose `Skill` column grants it.
108:  * Built once from Item.txt: swords carry the Knight cuts (19..23), bows
109:  * Triple Shot (24), Dark Reign blades Power Slash (56), scepters Force Wave
110:  * (66), the Summoner books their curses (223..225).
111:  */
112: let weaponSkills: Set<number> | null = null;
113: 
114: function weaponSkillNumbers(): Set<number> {
115:   if (weaponSkills) return weaponSkills;
116:   weaponSkills = new Set();
117:   for (const byIndex of Object.values(ItemsDatabase.cache)) {
118:     for (const item of Object.values(byIndex)) {
119:       if (item.Skill > 0 && item.Group <= LAST_WEAPON_GROUP) {
120:         weaponSkills.add(item.Skill);
121:       }
122:     }
123:   }
124:   return weaponSkills;
125: }
126: 
127: /** Whether a skill only exists while the weapon that carries it is held. */
128: export function isWeaponSkill(num: number): boolean {
129:   return weaponSkillNumbers().has(num);
130: }
131: 
132: function handGrants(item: Item | null, num: number): boolean {
133:   if (!item || !item.hasSkill) return false;
134:   return ItemsDatabase.getItem(item.group, item.num)?.Skill === num;
135: }
136: 
137: /** The classes a skill's `classes` expression admits. */
138: export function skillClasses(def: SkillDefinition): ReadonlySet<CharacterClassNumber> {
139:   const out = new Set<CharacterClassNumber>();
140:   for (const flag of def.classes.split('|')) {
141:     for (const c of CLASS_FLAGS[flag.trim()] ?? []) out.add(c);
142:   }
143:   return out;
144: }
145: 
146: /**
147:  * The full verdict on one skill for the hero as they are right now. Reads
148:  * only observables, so an `observer` re-renders when any input moves.
149:  */
150: export function skillUsability(num: number): SkillUsability {
151:   const def = skillDefinition(num);
152:   if (!def) return { usable: false, requirementsMet: false, blocks: ['unknown'] };
153: 
154:   const pd = Store.playerData;
155:   const blocks: SkillBlock[] = [];
156: 
157:   // The server only teaches a class its own skills, so a learned skill has
158:   // already passed this; the rule matters for lists of skills not yet held.
159:   const learned = Store.skills.some(s => s.number === num);
160:   if (!learned && !skillClasses(def).has(pd.charClass)) blocks.push('class');
161:   if (def.level > 0 && pd.level < def.level) blocks.push('level');
162:   if (def.energy > 0 && pd.eng < def.energy) blocks.push('energy');
163:   if (
164:     isWeaponSkill(num) &&
165:     !handGrants(pd.leftHandSlot, num) &&
166:     !handGrants(pd.rightHandSlot, num)
167:   ) {
168:     blocks.push('weapon');
169:   }
170:   const requirementsMet = blocks.length === 0;
171: 
172:   if (def.mana > 0 && pd.currentMP < def.mana) blocks.push('mana');
173:   if (def.ag > 0 && pd.currentAG < def.ag) blocks.push('ag');
174:   if (skillCooldownRemaining(num) > 0) blocks.push('cooldown');
175:   // No skill is cast from a safe zone tile - the original breaks out of the
176:   // AT_SKILL_* branches on `c->SafeZone` (ZzzInterface.cpp:3325). Transient,
177:   // not a requirement, so the icon keeps its colour like the original's does.
178:   if ((pd.tileFlag & TW_SAFEZONE) !== 0) blocks.push('safezone');
179: 
180:   return { usable: blocks.length === 0, requirementsMet, blocks };
181: }
182: 
183: /** `bCantSkill` inverted: class / level / energy / weapon all pass. */
184: export function skillRequirementsMet(num: number): boolean {
185:   return skillUsability(num).requirementsMet;
186: }
187: 
188: /** Everything passes, mana / AG / delay included: the cast may go out. */
189: export function canUseSkill(num: number): boolean {
190:   return skillUsability(num).usable;
191: }
192: 
193: // ---- 3. the layer ----------------------------------------------------------
194: 
195: export const usabilityLayer: SkillLayer = {
196:   name: 'usability',
197: };
</file>

