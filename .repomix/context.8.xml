<file path="src/maps/lorencia/candleObject.ts">
  1: import { BonedParticleEmitter, type BonedEmission } from '../../common/effectParticles';
  2: import { ModelObject } from '../../common/modelObject';
  3: import type { Entity, World } from '../../ecs/world';
  4: 
  5: export class CandleObject extends ModelObject {
  6:   #fire: BonedParticleEmitter | null = null;
  7: 
  8:   /** Wick bones (Bone03/05/07), filled by the fire setup; world positions are valid once the skeleton has been posed. */
  9:   protected wicks: BonedEmission['node'][] = [];
 10: 
 11:   async init(world: World, entity: Entity) {
 12:     await super.init(world, entity);
 13: 
 14:     this.BlendMeshLight = 2.2;
 15: 
 16:     this.GlowBlendMesh = true;
 17: 
 18:     await this.loadSpecificModel(this.modelName());
 19: 
 20:     this.#fire = this.#createFire(world);
 21:   }
 22: 
 23:   /** Per-wick particle recipe (one table candle: 5 sprites a tick per wick). */
 24:   protected wickEmissions(
 25:     wick: BonedEmission['node'],
 26:     scale: number
 27:   ): BonedEmission[] {
 28:     return [
 29:       {
 30:         node: wick,
 31:         kinds: ['fire157'],
 32:         count: 1,
 33:         scale: scale * 0.2,
 34:         light: [0.9, 0.5, 0],
 35:       },
 36:       {
 37:         node: wick,
 38:         kinds: ['fire157'],
 39:         count: 1,
 40:         scale: scale * 0.1,
 41:         light: [0.75, 0.3, 0],
 42:       },
 43:       {
 44:         node: wick,
 45:         kinds: ['fire157'],
 46:         count: 2,
 47:         scale: scale * 0.06,
 48:         light: [0.65, 0.45, 0.02],
 49:       },
 50:       {
 51:         node: wick,
 52:         kinds: ['smoke65'],
 53:         count: 1,
 54:         scale: scale * 0.1,
 55:         light: [1, 1, 1],
 56:       },
 57:     ];
 58:   }
 59: 
 60:   /** Model file inside `objectDir`; the Devias candelabra share the rig. */
 61:   protected modelName(): string {
 62:     return `Candle01.glb`;
 63:   }
 64: 
 65:   #createFire(world: World): BonedParticleEmitter | null {
 66:     const root = this.gltf?.mesh;
 67: 
 68:     if (!root) return null;
 69: 
 70:     const scale = this.node.scaling.x;
 71:     const points: BonedEmission[] = [];
 72:     const wicks: BonedEmission['node'][] = [];
 73:     this.wicks = wicks;
 74: 
 75:     const isWick = (name: string) => /^bone_[357]_/.test(name);
 76: 
 77:     for (const bone of this.gltf?.skeleton?.bones ?? []) {
 78:       const node = bone.getTransformNode();
 79: 
 80:       if (node && isWick(node.name)) wicks.push(node);
 81:     }
 82: 
 83:     if (wicks.length === 0) {
 84:       for (const node of root.getDescendants(false)) {
 85:         if (isWick(node.name) && 'getAbsolutePosition' in node) {
 86:           wicks.push(node as BonedEmission['node']);
 87:         }
 88:       }
 89:     }
 90: 
 91:     if (wicks.length === 0) {
 92:       console.warn(
 93:         'CandleObject: no wick bones found - the candles will not burn'
 94:       );
 95:       return null;
 96:     }
 97: 
 98:     for (const wick of wicks) {
 99:       points.push(...this.wickEmissions(wick, scale));
100:     }
101: 
102:     return new BonedParticleEmitter(world.scene, points);
103:   }
104: 
105:   dispose(): void {
106:     this.#fire = null;
107:     this.wicks = [];
108:     super.dispose();
109:   }
110: 
111:   Update(gameTime: World['gameTime']): void {
112:     super.Update(gameTime);
113: 
114:     if (!this.Ready || this.OutOfView) return;
115: 
116:     this.#fire?.update();
117:   }
118: }
</file>

