 32: /**
 33:  * The quest system: the legacy Scroll-of-Emperor chain, the Season 6 quest
 34:  * log, the kill counters and the HUD bubbles, behind one object. Copy `_template.ts` when adding to it.
 35:  *
 36:  * The game talks to `quests.update` once a frame (`QuestSystem`) and
 37:  * `quests.reset` on a map change (`loadMapIntoScene`); both fan out over
 38:  * `QUEST_LAYERS` (`layers.ts`), the only list of entries in the codebase.
 39:  * The readers and commands below are the facade's public surface for
 40:  * consumers that want the whole system from one import (`logic.ts`, the
 41:  * bottom bar); every entry file stays importable directly for the windows.
 42:  */
 43: class Quests {
 44:   private readonly layers: QuestLayer[] = [...QUEST_LAYERS];
 45: 
 46:   /** Add an entry at runtime (tools, experiments). Returns the unregister. */
 47:   register(layer: QuestLayer): () => void {
 48:     this.layers.push(layer);
 49:     return () => {
 50:       const i = this.layers.indexOf(layer);
 51:       if (i >= 0) this.layers.splice(i, 1);
 52:     };
 53:   }
 54: 
 55:   /** Every entry that exists on this map. */
 56:   layersFor(map: ENUM_WORLD): QuestLayer[] {
 57:     return this.layers.filter(l => !l.maps || l.maps.has(map));
 58:   }
 59: 
 60:   /** Step every entry. Call once a frame, before anything reads the quests. */
 61:   update(map: ENUM_WORLD, dt: number): void {
 62:     for (const layer of this.layers) layer.update?.(map, dt);
 63:   }
 64: 
 65:   /** Close the NPC windows and drop per-map state. Call when the map changes. */
 66:   reset(): void {
 67:     for (const layer of this.layers) layer.reset?.();
 68:   }
