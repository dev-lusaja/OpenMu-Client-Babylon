 1: import { MapTileObject } from '../../common/mapTileObject';
 2: import { ParticleEmitter } from '../../common/effectParticles';
 3: import { Store } from '../../store';
 4: import type { Entity, World } from '../../ecs/world';
 5: import {
 6:   chaosCastleRingDrop,
 7:   chaosCastleRingSmoking,
 8:   chaosCastleRingVisible,
 9:   updateChaosCastleArena,
10: } from './arena';
11: 
12: /**
13:  * `CreateParticle(BITMAP_SMOKE + 4, Position + (±150, 0, hero z), …, 1.5f)`
14:  * every tick per slab during the lead-in (CSChaosCastle.cpp:240-248): a
15:  * 3-tile-wide curtain of grey smoke along the ring about to fall.
16:  */
17: const SMOKE_SPREAD = 150;
18: 
19: /**
20:  * A Chaos Castle floor/rim segment (types 0-5, 13-35 minus the markers): drawn
21:  * or not by the arena stage, dropped into the void by the current drop, and
22:  * smoking while its drop is imminent. All state is `arena.ts`'s; this class
23:  * only applies it to the mesh (alpha), the entity (`posOffset.y`, in tiles -
24:  * the render system adds it to the position) and its own emitter.
25:  */
26: export class ChaosCastleRingObject extends MapTileObject {
27:   #entity: Entity | null = null;
28:   #smoke: ParticleEmitter | null = null;
29:   #visible = true;
30: 
31:   async init(world: World, entity: Entity) {
32:     await super.init(world, entity);
33:     this.#entity = entity;
34:     this.#apply();
35:   }
36: 
37:   #apply(): void {
38:     const visible = chaosCastleRingVisible(this.Type);
39:     if (visible !== this.#visible || (visible && this.Alpha < 1) || (!visible && this.Alpha > 0)) {
40:       this.#visible = visible;
41:       this.setAlpha(visible ? 1 : 0);
42:     }
43:   }
44: 
45:   dispose(): void {
46:     this.#smoke = null;
47:     this.#entity = null;
48:     super.dispose();
49:   }
50: 
51:   Update(gameTime: World['gameTime']): void {
52:     super.Update(gameTime);
53:     if (!this.Ready) return;
54: 
55:     const world = Store.world;
56:     if (!world) return;
57: 
58:     const now = gameTime.TotalGameTime.TotalSeconds;
59:     updateChaosCastleArena(now, world.scene.getEngine().getDeltaTime() / 1000);
60: 
61:     this.#apply();
62:     if (!this.#visible) return;
63: 
64:     const t = this.#entity?.transform;
65:     if (t) {
66:       const dropTiles = chaosCastleRingDrop(this.Type) / world.terrainScale;
67:       if (dropTiles > 0) {
68:         t.posOffset = { x: 0, y: -dropTiles, z: 0 };
69:       } else if (t.posOffset) {
70:         t.posOffset = undefined;
71:       }
72:     }
73: 
74:     if (chaosCastleRingSmoking(this.Type)) {
75:       if (!this.#smoke) {
76:         const p = this.node.position;
77:         this.#smoke = new ParticleEmitter(
78:           world.scene,
79:           [{ kinds: ['smoke2'], every: 1, jitter: SMOKE_SPREAD }],
80:           { x: p.x, y: p.y, z: p.z },
81:           this.node.rotation.y,
82:           this.node.scaling.x
83:         );
84:       }
85:       if (!this.OutOfView) this.#smoke.update();
86:     } else if (this.#smoke) {
87:       this.#smoke = null;
88:     }
89:   }
90: }
</file>

