141: /** Issue a cast through the same seam a right-click uses. Returns busy. */
142: function castSkill(world: World, num: number, target: Entity): boolean {
143:   if (world.castRequest) return true; // the player's own cast wins
144:   if (Store.currentSkill !== num) Store.selectSkill(num);
145:   if (Store.currentSkill !== num) return false;
146:   const pos = target.transform!.pos;
147:   world.castRequest = { target, point: { x: pos.x, y: pos.z } };
148:   return true;
149: }
