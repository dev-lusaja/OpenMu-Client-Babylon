 4: /**
 5:  * Kanturu Ruins (`WD_37KANTURU_1ST`, `World38`/`Object38`).
 6:  *
 7:  * `MoveKanturu1stObject` (GM_kanturu_1st.cpp:41-125) is the runtime: the
 8:  * hidden emitters and the brazier lights (`spec.ts`), the sines and the
 9:  * waterfall scroll (`meshAnimation.ts`), and the per-object settings here:
10:  *
11:  *  - **44** (×22) `Velocity = 0.02`, **46** (×43) `Velocity = 0.01` (the
12:  *    great wheel, with its `BlendMeshLight` sine), **90** (×19) `Velocity =
13:  *    0.04`.
14:  *  - **76** (×10) and **96** (×1): `Alpha = 0.5`.
15:  *
16:  * Not built:
17:  *  - The object-attached loops - `SOUND_KANTURU_1ST_BG_WHEEL` on 46,
18:  *    `_WATERFALL` on 77, `_ELEC` on 92, `_PLANT` on 98 - are
19:  *    `PlayBuffer(sound)` with no position, i.e. they play at full volume for
20:  *    as long as the object is in the update set. The map bed
21:  *    `w37/kan_ruin_global` is in `ambientBeds.ts`; the four object loops
22:  *    need a positional-loop hook the sound system does not have yet.
23:  *  - 92's `CreateJoint` lightning between bones 1 and 2 (:213-225; no ribbon
24:  *    primitive - the same gap as Icarus), 85's chrome pass (:202-212), 96's
25:  *    alpha-test tweak (:226-236), and the butterflies on 37.
26:  *
27:  * Music `Music/kanturu_1st`.
28:  */
29: export async function createKanturu1(world: World) {
30:   const terrain = world.terrain;
31:   if (!terrain) return;
32: 
33:   const tiles = terrain.MapTileObjects;
34: 
35:   // GM_kanturu_1st.cpp:60-63, :64-69, :101-103.
36:   tiles[44] = PlaySpeedObject.at(0.02);
37:   tiles[46] = PlaySpeedObject.at(0.01);
38:   tiles[90] = PlaySpeedObject.at(0.04);
39:   // :89-91, :104-106.
40:   tiles[76] = AlphaObject.at(0.5);
41:   tiles[96] = AlphaObject.at(0.5);
42: }
</file>

