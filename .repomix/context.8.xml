<file path="src/maps/devias/candleObject.ts">
  1: import { createMovableFlare, type MovableFlare } from '../../common/effectLights';
  2: import {
  3:   DEVIAS_CANDELABRA,
  4:   lightMapObject,
  5: } from '../../lighting/mapObjectLights';
  6: import type { LightSource } from '../../lighting/lightSource';
  7: import { Store } from '../../store';
  8: import type { World } from '../../ecs/world';
  9: import type { BonedEmission } from '../../common/effectParticles';
 10: import { CandleObject } from '../lorencia/candleObject';
 11: 
 12: const FLARE_SCALE = 1.6;
 13: const FLARE_COLOR: readonly [number, number, number] = [1, 0.62, 0.22];
 14: 
 15: /** Updates to wait for a posed skeleton before giving up and lighting anyway. */
 16: const POSE_WAIT_LIMIT = 120;
 17: 
 18: /**
 19:  * Devias standing candelabra (Object3 types 54 and 56, 1.7 tiles tall).
 20:  * Same three-arm rig as Lorencia's Candle01 (Bone02/04/06 arms
 21:  * with Bone03/05/07 wicks), so the Lorencia wick-fire logic applies
 22:  * unchanged; only the model file differs. The original gives them a
 23:  * BlendMesh and nothing else (ZzzObject.cpp:4650).
 24:  *
 25:  * The light is ours - `DEVIAS_CANDELABRA` in the lighting layer's map-object
 26:  * table. Instead of a fixed table offset it sits at the wicks: BMD bone
 27:  * transforms only exist once the skeleton has been posed by a render (see
 28:  * the bounds note in the memory), so the light is created from `Update` the
 29:  * first time the wicks have left the object origin, and it keeps following
 30:  * them through the shared position object.
 31:  */
 32: export class DeviasCandleObject extends CandleObject {
 33:   #lightPos = { x: 0, y: 0, z: 0 };
 34:   #flares: MovableFlare[] = [];
 35:   #source: LightSource | null = null;
 36:   #lit = false;
 37:   #waited = 0;
 38:   #disposed = false;
 39: 
 40:   protected modelName(): string {
 41:     return `Object${(this.Type + 1).toString().padStart(2, '0')}.glb`;
 42:   }
 43: 
 44:   /**
 45:    * Lighter than the Lorencia table candle: the reading room has 18 wicks
 46:    * in view at once (six candelabra × 3), and the full recipe
 47:    * would spawn ~3000 sprites a second into a 2048 pool and starve the
 48:    * fireplace. Two flame sprites a tick, smoke every third tick.
 49:    */
 50:   protected wickEmissions(
 51:     wick: BonedEmission['node'],
 52:     scale: number
 53:   ): BonedEmission[] {
 54:     return [
 55:       {
 56:         node: wick,
 57:         kinds: ['fire157'],
 58:         count: 1,
 59:         scale: scale * 0.2,
 60:         light: [0.9, 0.5, 0],
 61:       },
 62:       {
 63:         node: wick,
 64:         kinds: ['fire157'],
 65:         count: 1,
 66:         scale: scale * 0.08,
 67:         light: [0.7, 0.42, 0.02],
 68:       },
 69:       {
 70:         node: wick,
 71:         kinds: ['smoke65'],
 72:         count: 1,
 73:         scale: scale * 0.1,
 74:         light: [1, 1, 1],
 75:         every: 3,
 76:       },
 77:     ];
 78:   }
 79: 
 80:   #wicksPosed(): boolean {
 81:     const origin = this.node.getAbsolutePosition();
 82: 
 83:     for (const wick of this.wicks) {
 84:       const p = wick.getAbsolutePosition();
 85:       if (
 86:         Math.abs(p.x - origin.x) > 1e-3 ||
 87:         Math.abs(p.y - origin.y) > 1e-3 ||
 88:         Math.abs(p.z - origin.z) > 1e-3
 89:       ) {
 90:         return true;
 91:       }
 92:     }
 93: 
 94:     return false;
 95:   }
 96: 
 97:   #updateLightPos(): void {
 98:     const pos = this.#lightPos;
 99:     pos.x = pos.y = pos.z = 0;
100: 
101:     for (const wick of this.wicks) {
102:       const p = wick.getAbsolutePosition();
103:       pos.x += p.x;
104:       pos.y += p.y;
105:       pos.z += p.z;
106:     }
107: 
108:     const n = this.wicks.length || 1;
109:     pos.x /= n;
110:     pos.y /= n;
111:     pos.z /= n;
112:   }
113: 
114:   #light(world: World): void {
115:     this.#lit = true;
116:     this.#updateLightPos();
117: 
118:     this.#source = lightMapObject(world.scene, DEVIAS_CANDELABRA, this.#lightPos);
119: 
120:     const scale = this.node.scaling.x;
121: 
122:     for (const wick of this.wicks) {
123:       void createMovableFlare(world.scene, FLARE_SCALE * scale, FLARE_COLOR).then(
124:         flare => {
125:           if (!flare) return;
126: 
127:           if (this.#disposed) {
128:             flare.dispose();
129:             return;
130:           }
131: 
132:           const p = wick.getAbsolutePosition();
133:           flare.moveTo(p.x, p.y, p.z);
134:           this.#flares.push(flare);
135:         }
136:       );
137:     }
138:   }
139: 
140:   dispose(): void {
141:     this.#disposed = true;
142: 
143:     this.#source?.dispose();
144:     this.#source = null;
145: 
146:     for (const flare of this.#flares) flare.dispose();
147:     this.#flares.length = 0;
148: 
149:     super.dispose();
150:   }
151: 
152:   Update(gameTime: World['gameTime']): void {
153:     super.Update(gameTime);
154: 
155:     if (!this.Ready || this.wicks.length === 0) return;
156: 
157:     const world = Store.world;
158:     if (!world) return;
159: 
160:     if (!this.#lit) {
161:       if (this.#wicksPosed() || ++this.#waited >= POSE_WAIT_LIMIT) {
162:         this.#light(world);
163:       }
164:       return;
165:     }
166: 
167:     if (this.OutOfView) return;
168: 
169:     this.#updateLightPos();
170: 
171:     if (this.#source && this.#flares.length) {
172:       // Same roll as the terrain light: the flare breathes with the flicker
173:       // instead of sitting as a constant disc on the flame.
174:       const c = this.#source.color;
175:       const lumi = Math.min(1, (c.r + c.g + c.b) / 1.68 + 0.4);
176: 
177:       for (let i = 0; i < this.#flares.length; i++) {
178:         const p = this.wicks[i % this.wicks.length].getAbsolutePosition();
179:         this.#flares[i].moveTo(p.x, p.y, p.z);
180:         this.#flares[i].setLuminosity(lumi);
181:       }
182:     }
183:   }
184: }
</file>

