180: /**
181:  * `CMuHelper::BuffTarget`: cast when the effect is missing (or the timer
182:  * recast is on). Buffs without a known effect id fall back to a fixed gap -
183:  * the client cannot observe those. Returns busy when a cast went out.
184:  */
185: function buffTarget(world: World, target: Entity, num: number): boolean {
186:   const def = skillDefinition(num);
187:   if (!def || !isLearned(num)) return false;
188: 
189:   const effect = BUFF_EFFECT_BY_NAME[def.name];
190:   if (effect !== undefined) {
191:     if (target.buffs?.has(effect) && !timerBuffOngoing) return false;
192:   } else {
193:     const last = lastBuffCastAt.get(num);
194:     if (
195:       last !== undefined &&
196:       secondsElapsed - last < UNMAPPED_BUFF_RECAST_SECONDS &&
197:       !timerBuffOngoing
198:     ) {
199:       return false;
200:     }
201:   }
202: 
203:   if (!castSkill(world, num, target)) return false;
204:   lastBuffCastAt.set(num, secondsElapsed);
205:   return true;
206: }
