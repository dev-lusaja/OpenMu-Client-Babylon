259:   }
260: 
261:   /** `LetterReadCheck` + `SendLetterReadRequest`: open one letter. */
262:   openLetter(index: number): void {
263:     runInAction(() => {
264:       this.selectedLetter = index;
265:       this.letterView = { kind: 'read', index };
266:     });
267:     const letter = this.letters.find(l => l.index === index);
268:     if (letter?.body !== undefined) return; // already cached
269:     const packet = LetterReadRequestPacket.createPacket();
270:     packet.LetterIndex = index;
271:     Store.sendToGS(packet.buffer);
272:   }
273: 
274:   deleteLetter(index: number): void {
275:     const packet = LetterDeleteRequestPacket.createPacket();
276:     packet.LetterIndex = index;
277:     Store.sendToGS(packet.buffer);
278:   }
279: 
280:   /** The Write button, and Reply with the sender pre-filled. */
281:   composeLetter(to = '', subject = ''): void {
282:     runInAction(() => {
283:       this.letterView = { kind: 'write', to, subject, body: '' };
284:     });
285:   }
286: 
287:   updateDraft(patch: Partial<{ to: string; subject: string; body: string }>): void {
288:     runInAction(() => {
289:       if (this.letterView?.kind !== 'write') return;
290:       this.letterView = { ...this.letterView, ...patch };
291:     });
292:   }
293: 
294:   closeLetterView(): void {
295:     runInAction(() => {
296:       this.letterView = null;
297:     });
298:   }
299: 
300:   /**
301:    * `SendLetterSendRequest`. `LetterId` is the client's own request id, which
302:    * LetterSendResponse echoes back; the original counts up from 1 and so do
303:    * we. Rotation and animation are the sender's portrait pose, which the
304:    * original picks with the two arrows next to the photo - the hero's default
305:    * pose is sent instead.
306:    */
307:   sendLetter(): boolean {
308:     const view = this.letterView;
309:     if (!view || view.kind !== 'write' || this.sending) return false;
310: 
311:     const to = view.to.trim();
312:     const subject = view.subject.trim().slice(0, MAX_LETTER_TITLE);
313:     const body = view.body.slice(0, MAX_LETTER_TEXT);
314: 
315:     if (!to || !subject) {
316:       playUiSound('error');
317:       return false;
318:     }
319:     if (to === Store.playerData.name) {
320:       Social.errorMessage(t('friends.cannotLetterSelf'));
321:       return false;
322:     }
323: 
324:     // getRequiredSize counts from the code byte: 4 (letter id) + 10 (receiver)
325:     // + 60 (title) + 1 rotation + 1 animation + 2 message length.
326:     const packet = LetterSendRequestPacket.createPacket(
327:       LetterSendRequestPacket.getRequiredSize(78 + body.length)
328:     );
329:     packet.LetterId = this.nextLetterId++;
330:     packet.setReceiver(to);
331:     packet.setTitle(subject);
332:     packet.Rotation = 0;
333:     packet.Animation = 0;
334:     packet.MessageLength = body.length;
335:     packet.setMessage(body);
336:     Store.sendToGS(packet.buffer);
337: 
338:     runInAction(() => {
339:       this.sending = true;
340:     });
341:     return true;
342:   }
343: 
344:   /** LetterSendResponse: unblock the Send button and close the sheet on success. */
345:   sendFinished(success: boolean): void {
346:     runInAction(() => {
347:       this.sending = false;
348:       if (success) this.letterView = null;
349:     });
350:   }
351: 
352:   private nextLetterId = 1;
353: })();
354: 
355: // A hot update that reaches this module must reload the page: Vite would
356: // otherwise re-execute it and hand later-loaded importers a second instance
357: // of this singleton (same guard as store.ts).
358: const hot = (import.meta as { hot?: { decline(): void } }).hot;
359: if (hot) hot.decline();
</file>

