<file path="src/maps/icarus/cloudObject.ts">
  1: import { TILE_CM } from '../../common/terrain/consts';
  2: import { Sprite, type Scene } from '../../libs/babylon/exports';
  3: import type { Entity, World } from '../../ecs/world';
  4: import { HIDDEN_MESH_ALL, ModelObject } from '../../common/modelObject';
  5: import {
  6:   CLOUD_LIGHT_TEXTURE,
  7:   CLOUD_TEXTURE,
  8:   getSkySpritePool,
  9:   type SkySpritePool,
 10: } from './skySprites';
 11: 
 12: /**
 13:  * Billboards per emitter, by type - `RenderObjectVisual` spawns 20 for types
 14:  * 0-2 and 10 for types 3-5 (ZzzObject.cpp:3052-3096). The type is also the
 15:  * particle's SubType, which is what decides the spin direction below.
 16:  */
 17: const CLOUD_COUNT: readonly number[] = [20, 20, 20, 10, 10, 10];
 18: 
 19: /** `o->Position` ± this on x/y at spawn (MU units, ZzzEffectParticle.cpp:7910). */
 20: const SPREAD_MU = 250;
 21: 
 22: /** …and `+20 … +40` on z, the only axis the spread is one-sided on. */
 23: const RISE_MIN_MU = 20;
 24: const RISE_RANGE_MU = 21;
 25: 
 26: /** `Scale = (rand()%20 + 180) * 0.01f` - 1.80 … 1.99, independent of `o->Scale`. */
 27: const SCALE_MIN = 1.8;
 28: const SCALE_RANGE = 0.2;
 29: 
 30: /**
 31:  * `Position.z = start.z + sinf((WorldTime + Gravity) / 5000.f) * 20.f`
 32:  * (ZzzEffectParticle.cpp:9157). `Gravity` is a per-particle `rand()%1000`
 33:  * phase, so a bank breathes out of step with itself; the period is
 34:  * 2π·5000 ms ≈ 31 s and the throw is 20 MU, i.e. a drift you notice only by
 35:  * looking away and back.
 36:  */
 37: const BOB_PERIOD_MS = 5000;
 38: const BOB_AMPLITUDE_MU = 20;
 39: const BOB_PHASE_RANGE_MS = 1000;
 40: 
 41: /**
 42:  * `TurningForce = o->Scale + (rand()%30) * 0.01f`, spun at `±0.02 *
 43:  * TurningForce` degrees per millisecond about the view axis - a full turn in
 44:  * roughly 15-20 s at the map's usual object scales.
 45:  */
 46: const SPIN_DEG_PER_MS = 0.02;
 47: const SPIN_JITTER = 0.3;
 48: 
 49: /** `Light = (0.1f, 0.1f, 0.1f)` (ZzzObject.cpp:3054). Dim, and meant to stack. */
 50: const CLOUD_LIGHT = 0.1;
 51: 
 52: /** MU units per world unit. */
 53: 
 54: /** 25 Hz, the rate every `rand_fps_check` in the original is counted against. */
 55: const TICKS_PER_SECOND = 25;
 56: 
 57: /** `MoveObjectOnEffect`'s `rand_fps_check(10)` - one tick in ten. */
 58: const GLOW_CHANCE = 10;
 59: 
 60: /** `CreateParticle(BITMAP_CLOUD+1, …, 0.5f)` (ZzzObject.cpp:4338-4356). */
 61: const GLOW_SCALE = 0.5;
 62: 
 63: /** `Light = (rand()%20 * 0.01f, …)` on each channel independently - 0 … 0.19. */
 64: const GLOW_LIGHT_RANGE = 0.2;
 65: 
 66: /**
 67:  * Ticks a glow lives. Not recoverable from the call site - the original leaves
 68:  * the particle's own default - so it is set to read as a blink rather than as
 69:  * a second, steadier cloud: about half a second, fading out the whole way.
 70:  */
 71: const GLOW_LIFE_TICKS = 12;
 72: 
 73: /** Concurrent glows per emitter, so a stalled frame cannot burst the pool. */
 74: const GLOW_LIMIT = 2;
 75: 
 76: type Cloud = {
 77:   readonly sprite: Sprite;
 78:   readonly baseX: number;
 79:   readonly baseY: number;
 80:   readonly baseZ: number;
 81:   readonly phase: number;
 82:   readonly spin: number;
 83:   angle: number;
 84: };
 85: 
 86: type Glow = {
 87:   readonly sprite: Sprite;
 88:   life: number;
 89:   readonly r: number;
 90:   readonly g: number;
 91:   readonly b: number;
 92: };
 93: 
 94: const rand = (n: number) => Math.floor(Math.random() * n);
 95: 
 96: /**
 97:  * Which way a cloud turns, from its emitter's type (the particle SubType) and
 98:  * its index in the bank (ZzzEffectParticle.cpp:3052). Types 1 and 4 turn one
 99:  * way, 2 and 5 the other, and 0 and 3 split their own bank down the middle so
100:  * a single emitter's clouds counter-rotate against each other.
101:  */
102: function spinSign(type: number, index: number): number {
103:   if (type === 1 || type === 4) return 1;
104:   if (type === 2 || type === 5) return -1;
105: 
106:   return index % 2 === 0 ? 1 : -1;
107: }
108: 
109: /**
110:  * Icarus types 0-5: the cloud emitters.
111:  *
112:  * All six ids carry the same 50 MU `연기박스` box mesh and all six hide it on
113:  * their first visible frame (`o->HiddenMesh = -2`) and stand a bank of cloud
114:  * billboards in its place. This object skips the model entirely rather than
115:  * loading it and setting `HiddenMesh` the way `OperateBoxObject` does: the box
116:  * is not a click target, has no bones anything hangs off, and 335 of them
117:  * stand on the map, so loading `Object01.glb` 335 times to never draw it is
118:  * pure download and pure memory. `HiddenMesh` is still set for anything that
119:  * reads it, and `Ready` is set by hand because `ModelLoaderSystem` treats an
120:  * `init()` that resolves with neither a `gltf` nor `Ready` as a load failure.
121:  *
122:  * The bank is created once, when the object is built, and released when it is
123:  * disposed - which `ModelLoaderSystem` does on the visibility transition, so
124:  * "alive while the owner is visible" falls out of the entity's own lifetime
125:  * exactly as it does in the original.
126:  */
127: export class IcarusCloudObject extends ModelObject {
128:   CastsShadow = false;
129: 
130:   #scene: Scene | null = null;
131: 
132:   #clouds: Cloud[] = [];
133: 
134:   #glows: Glow[] = [];
135: 
136:   #cloudPool: SkySpritePool | null = null;
137: 
138:   #glowPool: SkySpritePool | null = null;
139: 
140:   #tickDue = 0;
141: 
142:   #disposed = false;
143: 
144:   async init(world: World, entity: Entity) {
145:     await super.init(world, entity);
146: 
147:     this.#scene = world.scene;
148: 
149:     this.HiddenMesh = HIDDEN_MESH_ALL;
150:     this.Visible = false;
151:     this.Ready = true;
152: 
153:     const pool = await getSkySpritePool(world.scene, CLOUD_TEXTURE);
154: 
155:     // Disposed while the texture was in flight: the entity left the
156:     // visibility radius before its clouds ever appeared.
157:     if (!pool || this.#disposed) return;
158: 
159:     this.#cloudPool = pool;
160:     this.#spawnBank(pool);
161: 
162:     const glowPool = await getSkySpritePool(world.scene, CLOUD_LIGHT_TEXTURE);
163: 
164:     if (!glowPool || this.#disposed) return;
165: 
166:     this.#glowPool = glowPool;
167:   }
168: 
169:   #spawnBank(pool: SkySpritePool): void {
170:     const origin = this.node.position;
171:     const ownerScale = this.node.scaling.x;
172:     const count = CLOUD_COUNT[this.Type] ?? 0;
173: 
174:     for (let i = 0; i < count; i++) {
175:       const sprite = pool.acquire();
176: 
177:       // Budget spent (see CLOUD_TEXTURE): a thinner bank, not a dropped one.
178:       if (!sprite) break;
179: 
180:       const scale = SCALE_MIN + Math.random() * SCALE_RANGE;
181:       const size = pool.sizeFor(scale);
182: 
183:       sprite.width = size;
184:       sprite.height = size;
185:       sprite.color.set(CLOUD_LIGHT, CLOUD_LIGHT, CLOUD_LIGHT, 1);
186: 
187:       // MU x/y are the ground plane and MU z is up, so the one-sided rise goes
188:       // on Babylon's y. The original scales the offsets by the frame factor
189:       // `CreateParticleFpsChecked` was called with, which is an artefact of
190:       // spawning inside a per-frame call - a bank created once has no frame to
191:       // be a fraction of.
192:       const cloud: Cloud = {
193:         sprite,
194:         baseX: origin.x + (rand(SPREAD_MU * 2) - SPREAD_MU) / TILE_CM,
195:         baseY:
196:           origin.y + (RISE_MIN_MU + rand(RISE_RANGE_MU)) / TILE_CM,
197:         baseZ: origin.z + (rand(SPREAD_MU * 2) - SPREAD_MU) / TILE_CM,
198:         phase: rand(BOB_PHASE_RANGE_MS),
199:         spin:
200:           spinSign(this.Type, i) *
201:           SPIN_DEG_PER_MS *
202:           (ownerScale + Math.random() * SPIN_JITTER),
203:         angle: rand(360),
204:       };
205: 
206:       sprite.position.set(cloud.baseX, cloud.baseY, cloud.baseZ);
207: 
208:       this.#clouds.push(cloud);
209:     }
210:   }
211: 
212:   /**
213:    * `MoveObjectOnEffect` (ZzzObject.cpp:4338): one frame in ten, a cloud
214:    * object grows a dim `cloudLight` sprite and two thunder joints. The joints
215:    * are ribbons drawn by `CreateJoint`, which has no counterpart in this
216:    * client, so only the sprite is reproduced - which is the half that carries,
217:    * since the joints are two 40 MU wide bolts seen against a bank five tiles
218:    * across.
219:    */
220:   #spawnGlow(pool: SkySpritePool): void {
221:     if (this.#glows.length >= GLOW_LIMIT) return;
222: 
223:     const sprite = pool.acquire();
224:     if (!sprite) return;
225: 
226:     const size = pool.sizeFor(GLOW_SCALE);
227: 
228:     sprite.width = size;
229:     sprite.height = size;
230:     sprite.angle = 0;
231:     sprite.position.copyFrom(this.node.position);
232: 
233:     this.#glows.push({
234:       sprite,
235:       life: GLOW_LIFE_TICKS,
236:       r: Math.random() * GLOW_LIGHT_RANGE,
237:       g: Math.random() * GLOW_LIGHT_RANGE,
238:       b: Math.random() * GLOW_LIGHT_RANGE,
239:     });
240:   }
241: 
242:   Update(gameTime: World['gameTime']): void {
243:     super.Update(gameTime);
244: 
245:     const scene = this.#scene;
246:     if (!scene) return;
247: 
248:     const deltaMs = scene.getEngine().getDeltaTime();
249:     const worldTimeMs = gameTime.TotalGameTime.TotalSeconds * 1000;
250: 
251:     for (const cloud of this.#clouds) {
252:       cloud.angle += cloud.spin * deltaMs;
253: 
254:       cloud.sprite.position.y =
255:         cloud.baseY +
256:         (Math.sin((worldTimeMs + cloud.phase) / BOB_PERIOD_MS) *
257:           BOB_AMPLITUDE_MU) /
258:           TILE_CM;
259: 
260:       // Babylon's sprite angle is a rotation in the screen plane, which is
261:       // what the original's spin about the view axis amounts to.
262:       cloud.sprite.angle = (cloud.angle * Math.PI) / 180;
263:     }
264: 
265:     // Everything below is a `rand_fps_check`, so it is counted in the
266:     // original's 25 Hz ticks rather than in frames.
267:     this.#tickDue += (deltaMs / 1000) * TICKS_PER_SECOND;
268: 
269:     if (this.#tickDue > 4) this.#tickDue = 4;
270: 
271:     while (this.#tickDue >= 1) {
272:       this.#tickDue -= 1;
273: 
274:       for (let i = this.#glows.length - 1; i >= 0; i--) {
275:         const glow = this.#glows[i];
276: 
277:         glow.life -= 1;
278: 
279:         if (glow.life <= 0) {
280:           this.#glowPool?.release(glow.sprite);
281:           this.#glows.splice(i, 1);
282:           continue;
283:         }
284: 
285:         const fade = glow.life / GLOW_LIFE_TICKS;
286: 
287:         glow.sprite.color.set(glow.r * fade, glow.g * fade, glow.b * fade, 1);
288:       }
289: 
290:       if (this.#glowPool && rand(GLOW_CHANCE) === 0) {
291:         this.#spawnGlow(this.#glowPool);
292:       }
293:     }
294:   }
295: 
296:   dispose(): void {
297:     this.#disposed = true;
298: 
299:     for (const cloud of this.#clouds) this.#cloudPool?.release(cloud.sprite);
300:     this.#clouds.length = 0;
301: 
302:     for (const glow of this.#glows) this.#glowPool?.release(glow.sprite);
303:     this.#glows.length = 0;
304: 
305:     this.#cloudPool = null;
306:     this.#glowPool = null;
307:     this.#scene = null;
308: 
309:     super.dispose();
310:   }
311: }
</file>

<file path="src/maps/icarus/create.ts">
 1: import type { World } from '../../ecs/world';
 2: import { IcarusCloudObject } from './cloudObject';
 3: import { IcarusSky } from './sky';
 4: import { ICARUS_EFFECT_ONLY_TYPES } from './spec';
 5: 
 6: /**
 7:  * Icarus (World 10 / `WD_10HEAVEN`, assets `Object11`/`World11`) - the sky map.
 8:  * No terrain is drawn; islands, pillars and cloud banks hang in a dark navy
 9:  * void, it rains without stopping, and lightning goes off overhead.
10:  *
11:  * Almost nothing here is per-object: `CreateObject` has no `case
12:  * WD_10HEAVEN`, so no Icarus type gets a pick box, a blend mesh or an operate
13:  * flag, and `MoveObject` is a bare `case WD_10HEAVEN: break;`. Everything the
14:  * world does at runtime is either in `RenderObjectVisual`
15:  * (ZzzObject.cpp:3052-3153) - the cloud banks on types 0-5 and the orb on
16:  * type 10 - or world-level and hero-relative, which is `IcarusSky`.
17:  *
18:  * What lives outside this directory, and why:
19:  *  - `spec.ts`'s `ICARUS_LIGHTS` is the type 10 orb, registered through
20:  *    `effectLights.ts` like every other map's lights; it needs no code.
21:  *  - the clear colour is `icarusLayer.clearColor` (index.ts); the hidden
22:  *    terrain mesh is `loadMapIntoScene`'s one Icarus special case.
23:  *  - the rain is `AmbientParticleSystem`'s `RAIN` recipe, which Icarus runs
24:  *    unconditionally (`MoveLeaves` forces `RainTarget = MAX_LEAVES / 2` for
25:  *    this world, ZzzEffectFireLeave.cpp:424) rather than on the weather byte.
26:  */
27: export async function createIcarus(world: World) {
28:   const terrain = world.terrain;
29:   if (!terrain) return;
30: 
31:   // `+90.f` instead of every other map's `+30.f` (CameraUtility.cpp:103).
32:   // The terrain mesh itself is hidden - `RenderTerrain` is skipped outright
33:   // for this world (MainScene.cpp:402; `loadMapIntoScene` sets it invisible)
34:   // - but its height map is still sampled, for characters and for the rain.
35:   terrain.extraHeight = 0.9;
36: 
37:   const tiles = terrain.MapTileObjects;
38: 
39:   // Types 0-5 are six copies of one 50 MU smoke box, every one of them hidden
40:   // on sight and replaced by a bank of cloud billboards. `IcarusCloudObject`
41:   // skips the model entirely - see the class, and `ICARUS_EFFECT_ONLY_TYPES`.
42:   for (const type of ICARUS_EFFECT_ONLY_TYPES) {
43:     tiles[type] = IcarusCloudObject;
44:   }
45: 
46:   const sky = new IcarusSky(world);
47: 
48:   // `unloadMap` calls `onDispose` on every entity belonging to the world it is
49:   // leaving, which is the only teardown hook a map module gets.
50:   world.add({
51:     worldIndex: world.mapIndex,
52:     onDispose: () => sky.dispose(),
53:   });
54: }
</file>

