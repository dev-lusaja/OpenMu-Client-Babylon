50:   };
51: 
52:   // The rooms someone tuned keep their rows; the rest take the shared one.
53:   const tuned: [Room, AreaLookName][] = [
54:     [DEVIAS_READING_ROOM, 'deviasReadingRoom'],
55:     [DEVIAS_WEST_HEARTH_HOUSE, 'deviasHearthHouse'],
56:     [DEVIAS_EAST_HEARTH_HOUSE, 'deviasHearthHouse'],
57:   ];
58: 
59:   const hooksFor = (room: Room): RoomHooks => {
60:     if (sameRoom(room, DEVIAS_TAVERN)) return tavern;
61:     const row = tuned.find(([known]) => sameRoom(room, known));
62: 
63:     return { look: row ? row[1] : 'deviasGuardRoom' };
64:   };
65: 
66:   world.add({
67:     worldIndex: map,
68:     onDispose: () => {
69:       sound.stop('Music/Pub');
70:       setAreaMood(null);
71:     },
72:   });
73: 
74:   const records = await loadRoomRecords(map);
75: 
76:   // Two kits, so two passes: the houses' spec finds the roofed buildings, the
77:   // castles' finds the two halls. One spec cannot do both - the castle kit
78:   // stands a storey taller and its walls sit the other side of their line.
79:   const houses = enumerateRooms(records, DEVIAS_ROOM_SPEC);
80:   registerRooms(world, houses, DEVIAS_ROOM_SPEC, hooksFor);
81: 
82:   // A castle's wall line does not bound its floor the way a house's does (see
83:   // rooms.ts), so the enumeration is used to find the halls and read their
84:   // base, and each then takes its own floor.
85:   const hallFloor = (hall: RoomFrame): RoomFrame => {
86:     const row = DEVIAS_CASTLE_HALLS.find(known => sameRoom(hall, known));
87: 
88:     return row ? { ...row, base: hall.base } : hall;
89:   };
90: 
91:   const halls = enumerateRooms(records, DEVIAS_CASTLE_SPEC).map(hallFloor);
92:   registerRooms(world, halls, DEVIAS_CASTLE_SPEC, () => ({
93:     look: 'deviasCastleHall',
94:   }));
95: }
</file>

