167: /** `CMuHelper::ActivatePet` - the Dark Raven command, once per activation. */
168: function activatePet(config: MuHelperConfig): void {
169:   if (!config.useDarkRaven || petActivated) return;
170:   const mode =
171:     config.darkRavenMode === 1
172:       ? PetCommandModeEnum.AttackRandom
173:       : config.darkRavenMode === 2
174:         ? PetCommandModeEnum.AttackWithOwner
175:         : PetCommandModeEnum.Normal;
176:   Store.sendPetCommand(mode);
177:   petActivated = true;
178: }
