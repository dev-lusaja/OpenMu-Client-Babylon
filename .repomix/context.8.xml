204: export function buffRecipe(effectId: number): BuffRecipe {
205:   // The pack first: `BuffEffect_<lang>.bmd` is Webzen's own wording and covers
206:   // every effect, so a language that has one reads the whole bar in one voice
207:   // instead of mixing it with the catalogue. Underneath it the catalogue key
208:   // (which is what the ten languages with no pack read), then the enum's
209:   // English for the ~110 effects the client never named.
210:   const key = MAGIC_EFFECTS[effectId]?.nameKey;
