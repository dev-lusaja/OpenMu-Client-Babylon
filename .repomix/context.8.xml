155:    * this system's tables, so a static import here would be an import cycle
156:    * that resolves to a TDZ crash depending on who loads first. The dynamic
157:    * import breaks it and gives each map its own chunk as a side effect.
158:    */
159:   create?(world: World): Promise<void>;
160: 
161:   /** Map changed: drop anything belonging to the world just left. */
162:   reset?(): void;
163: }
164: 
