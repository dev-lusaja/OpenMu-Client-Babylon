340: /** `CMuHelper::ShouldObtainItem` - the pickup filters. */
341: function shouldObtain(config: MuHelperConfig, e: Entity): boolean {
342:   const drop = e.droppedItem!;
343:   if (config.pickZen && drop.isMoney) return true;
344:   if (drop.isMoney) return config.pickAllItems;
345: 
346:   const def = itemDef(drop.group, drop.num);
347:   if (config.pickJewel && def && isJewel(def)) return true;
348:   if (config.pickAncient && drop.item?.isAncient) return true;
349:   if (config.pickExcellent && drop.item?.isExcellent) return true;
350: 
351:   if (config.pickExtraItems && def) {
352:     const name = def.name.toLowerCase();
353:     if (config.extraItems.some(entry => name.includes(entry.toLowerCase()))) {
354:       return true;
355:     }
356:   }
357: 
358:   return config.pickAllItems;
359: }
360: 
361: /** `CMuHelper::ObtainItem` via the pickup seam (`world.pickupTarget`). */
362: function obtainItem(world: World, hero: Entity, config: MuHelperConfig): boolean {
363:   if (world.pickupTarget) return false; // still walking to one
364: 
365:   const maxDistance = distanceByRange(config.obtainRange);
366:   const from = heroTile(hero);
367:   let best: Entity | null = null;
368:   let bestDist = maxDistance + 1;
369:   for (const e of world.netObjsQuery.entities) {
370:     if (!e.droppedItem || e.objOutOfScope) continue;
371:     if (e.worldIndex !== undefined && e.worldIndex !== world.mapIndex) continue;
372:     if (!shouldObtain(config, e)) continue;
373:     const dist = tileDistance(from, entityTile(e));
374:     if (dist < bestDist) {
375:       bestDist = dist;
376:       best = e;
377:     }
378:   }
379: 
380:   if (!best) return true;
381:   world.pickupTarget = best;
382:   return false;
383: }
384: 
385: /** `CMuHelper::Regroup` - walk back after too long away from the anchor. */
386: function regroup(world: World, hero: Entity, config: MuHelperConfig): boolean {
387:   if (!config.returnToOriginalPosition || secondsAway <= config.maxSecondsAway) {
388:     return true;
389:   }
390: 
391:   if (tileDistance(heroTile(hero), originalPos) > 1) {
392:     if (moveReissueCooldown <= 0) {
393:       moveReissueCooldown = MOVE_REISSUE_SECONDS;
394:       walkTo(hero, originalPos);
395:     }
396:     return false;
397:   }
398: 
399:   secondsAway = 0;
400:   comboState = 0;
401:   currentTarget = null;
402:   return true;
403: }
404: 
405: /**
406:  * `CMuHelper::SelectAttackSkill`: activation skill 1/2 on their timer or
407:  * mob-count condition, else the basic skill. The "mobs attacking" basis
408:  * falls back to the nearby count - OpenMU's damage packets name the victim,
409:  * not the attacker, so the client cannot know who is attacking it.
410:  */
411: function selectAttackSkill(world: World, hero: Entity, config: MuHelperConfig): number {
412:   const nearby = countTargetsNearby(
413:     world,
414:     hero,
415:     distanceByRange(config.huntingRange)
416:   );
417: 
418:   for (const index of [1, 2] as const) {
419:     const num = config.skills[index];
420:     if (!isLearned(num)) continue;
421:     const cond = config.skillConditions[index];
422:     const interval = config.skillIntervals[index];
423:     if (cond.onTimer && interval > 0 && secondsElapsed % interval === 0) {
424:       return num;
425:     }
426:     if (cond.onCondition && nearby >= cond.minMobs) return num;
427:   }
428: 
429:   return isLearned(config.skills[0]) ? config.skills[0] : 0;
430: }
431: 
432: /** `CMuHelper::Attack` (+ `SimulateComboAttack`) through the cast seam. */
433: function attack(world: World, hero: Entity, config: MuHelperConfig): void {
434:   const huntDistance = distanceByRange(config.huntingRange);
435: 
436:   if (
437:     currentTarget &&
438:     (!isAttackableEntity(world, currentTarget) ||
439:       currentTarget.dying ||
440:       tileDistance(heroTile(hero), entityTile(currentTarget)) > huntDistance + 4)
441:   ) {
442:     currentTarget = null;
443:   }
444:   if (!currentTarget) currentTarget = nearestTarget(world, hero, huntDistance);
445:   if (!currentTarget) {
446:     comboState = 0;
447:     return;
448:   }
449: 
450:   let skillNum: number;
451:   if (config.useCombo && config.skills.every(n => isLearned(n))) {
452:     skillNum = config.skills[comboState];
453:     comboState = (comboState + 1) % 3;
454:   } else {
455:     skillNum = selectAttackSkill(world, hero, config);
456:   }
457:   if (skillNum <= 0) return;
458: 
459:   castSkill(world, skillNum, currentTarget);
460: }
461: 
462: /** `CMuHelper::RepairEquipments` at the 50% durability line, throttled. */
463: function repairEquipment(config: MuHelperConfig): void {
464:   if (!config.repairItem || repairCooldown > 0) return;
465:   repairCooldown = REPAIR_INTERVAL_SECONDS;
466: 
467:   const items = Store.playerData.items;
468:   for (let slot = 0; slot < InventoryConstants.EquippableSlotsCount; slot++) {
469:     const item = items[slot];
470:     if (!item || item.durability === undefined) continue;
471:     const def = itemDef(item.group, item.num);
472:     if (!def) continue;
473:     const max = calcMaxDurability(
474:       def,
475:       item.lvl ?? 0,
476:       item.isExcellent === true,
477:       item.isAncient === true
478:     );
479:     if (max <= 0) continue;
480:     const percent = Math.trunc((item.durability * 100 + max - 1) / max);
481:     if (percent <= REPAIR_THRESHOLD) Store.repairItemRequest(slot);
482:   }
483: }
484: 
485: /** `CMuHelper::Work` - one 250 ms tick, one action at most. */
486: function work(world: World, hero: Entity, config: MuHelperConfig): void {
487:   activatePet(config);
488:   if (!buff(world, hero, config)) return;
489:   if (!recoverHealth(world, hero, config)) return;
490:   if (!obtainItem(world, hero, config)) return;
491:   if (!regroup(world, hero, config)) return;
492:   attack(world, hero, config);
493:   repairEquipment(config);
494: }
495: 
496: export function updateMuHelperLoop(world: World, dt: number): void {
497:   if (!gameVersion.features.muHelper) return;
498:   ensureMuHelperWatching();
499: 
500:   if (!Store.muHelper.active) {
501:     if (wasActive) {
502:       resetRuntime();
503:       wasActive = false;
504:     }
505:     return;
506:   }
507: 
508:   const hero = world.playerEntity;
509:   if (!hero || hero.dying) return;
510: 
511:   if (!wasActive) {
512:     resetRuntime();
513:     originalPos = heroTile(hero);
514:     originMap = world.mapIndex;
515:     wasActive = true;
516:   }
517: 
518:   // Lost Tower 1-7 are one map, as are Devias 1-3 and every other numbered
519:   // area of the Move window: the server answers those with a same-map
520:   // `MapChanged` that only snaps the position, so the map index alone misses
521:   // the warp and Regroup walks the length of the map back to the old anchor.
522:   const tile = heroTile(hero);
523:   const jumped =
524:     lastHeroTile !== null && tileDistance(lastHeroTile, tile) > TELEPORT_TILES;
525:   lastHeroTile = tile;
526: 
527:   if (world.mapIndex !== originMap || jumped) {
528:     // Warped mid-run: re-anchor the regroup position.
529:     originalPos = tile;
530:     originMap = world.mapIndex;
531:     secondsAway = 0;
532:     currentTarget = null;
533:   }
534: 
535:   repairCooldown -= dt;
536:   stopRequestCooldown -= dt;
537:   moveReissueCooldown -= dt;
538: 
539:   // `WorkLoop`: entering a safe zone stops the helper (`TriggerStop`).
540:   if (hero.attributeSystem?.isAboveZero('inSafeZone')) {
541:     if (stopRequestCooldown <= 0) {
542:       stopRequestCooldown = STOP_REQUEST_INTERVAL;
543:       Store.toggleMuHelper();
544:     }
545:     return;
546:   }
547: 
548:   tickAccum += dt;
549:   if (tickAccum < TICK_SECONDS) return;
550:   tickAccum = Math.min(tickAccum - TICK_SECONDS, TICK_SECONDS);
551: 
552:   try {
553:     work(world, hero, MuHelperState.config);
554:   } catch {
555:     // `Work` swallows too: one bad tick must not kill the loop.
556:   }
557: 
558:   if (++loopCounter >= TICKS_PER_SECOND) {
559:     loopCounter = 0;
560:     secondsElapsed++;
561:     if (tileDistance(heroTile(hero), originalPos) > 1) secondsAway++;
562:     else secondsAway = 0;
563:   }
564: }
565: 
566: /** Test/debug seam: drop all runtime state. */
567: export function resetMuHelperLoop(): void {
568:   resetRuntime();
569:   wasActive = false;
570: }
