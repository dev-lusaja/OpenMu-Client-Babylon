  5: /**
  6:  * The contract every map entry implements. One folder per map,
  7:  * `maps/<name>/index.ts` exports one `<name>Layer`, listed once in
  8:  * `layers.ts`. Copy `_template.ts` for the recipe.
  9:  *
 10:  * A map entry is mostly *data*: which `ENUM_WORLD` values it serves, which
 11:  * `Data/World<n>` folder it draws, its tile slots, its offline spawn, its sky
 12:  * kind and the per-object-type tables (`blendMeshes`, `effectOnly`,
 13:  * `emissions`) the renderer reads. The one piece of behaviour, `create`,
 14:  * loads the map's object classes on demand - see the field.
 15:  *
 16:  * The convention's common core is `name` / `maps?` / `update?` / `reset?`. A
 17:  * map entry has no per-frame step, and "maps" would be the set of worlds it
 18:  * *is*, so the field is spelled `worlds` here; `reset?` keeps its meaning.
 19:  */
 20: export interface MapLayer {
 21:   /** Unique camelCase, identical to the folder name. */
 22:   readonly name: string;
 23: 
 24:   /**
 25:    * The `ENUM_WORLD` values this entry serves. Most maps are one world; the
 26:    * event maps are a range of server instances on one art set (Blood Castle
 27:    * 11…17 + 52, Chaos Castle 18…23 + 53, Kalima 24…29 + 36, Illusion Temple
 28:    * 45…50, Devil Square 9 + 32). A world appears in exactly one entry.
 29:    */
 30:   readonly worlds: readonly ENUM_WORLD[];
 31: 
 32:   /**
 33:    * The `Data/World<n>` / `Data/Object<n>` folder number, when it is not the
 34:    * default `world + 1` (`CMapManager::LoadWorld`, MapManager.cpp:1206-1225):
 35:    * every Blood Castle floor draws `World12`, every Chaos Castle `World19`,
 36:    * every Kalima floor `World25`, every Illusion Temple level `World47`, and
 37:    * Devil Square 5-7 (map 32) folds into `World10`.
 38:    */
 39:   readonly assetWorld?: number;
 40: 
 41:   /**
 42:    * Tile textures by slot - 0 Grass01, 1 Grass02, 2 Ground01, 3 Ground02,
 43:    * 4 Ground03, 5 Water01, 6 Wood01, 7 Rock01 … 13 Rock07 - the list
 44:    * `LoadWorld` (MapManager.cpp:1362-1420) binds from `World<n>`. A slot the
 45:    * folder cannot fill (missing file, or a `.tga` the OZJ-only loader cannot
 46:    * read) names a tile the folder *does* have, so the indices
 47:    * `EncTerrain<n>.map` uses stay put. `recipes.ts` has the common shapes.
 48:    */
 49:   readonly tiles: readonly string[];
 50: 
 51:   /**
 52:    * The slot this world fills with an `AlphaTile*.Tga` instead of a ground
 53:    * texture, when it has one. `LoadWorld` gives it to Elbeland (slot 2),
 54:    * Kanturu 3 (3), Cursed Temple (4), the Empire Guardian maps and the two
 55:    * new login scenes (10), and Karutan (12); `RenderFace`
 56:    * (ZzzLodTerrain.cpp:1394-1435) then draws that one slot through
 57:    * `EnableAlphaTest` and every other through `DisableAlphaBlend`.
 58:    *
 59:    * All thirteen of those files shipped in `Data/` are 256x256 32-bit TGAs
 60:    * that are zero in every byte, alpha included, so the alpha test leaves
 61:    * nothing of them: the slot does not mean "a see-through ground texture",
 62:    * it means *no ground here*. The maps that use it punch the terrain out
 63:    * from under a bridge span or a platform so the span reads as a span
 64:    * instead of a ribbon of ground hanging in the void.
 65:    *
