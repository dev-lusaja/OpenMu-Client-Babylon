 27:  */
 28: import { observable, reaction, runInAction } from 'mobx';
 29: import { getBaseClass, BaseClass } from '../common/characterStats';
 30: import { itemBaseName } from '../common/itemsDatabase';
 31: import { monsterDisplayName } from '../common/monstersDatabase';
 32: import {
 33:   LegacyQuestStateRequestPacket,
 34:   LegacyQuestStateSetRequestPacket,
 35: } from '../common/packets/ClientToServerPackets';
 36: import {
 37:   ConditionTypeEnum,
 38:   LegacyQuestRewardPacket,
 39:   LegacyQuestStateDialogPacket,
 40:   LegacyQuestStateListPacket,
 41:   LegacySetQuestStateResponsePacket,
 42: } from '../common/packets/ServerToClientPackets';
 43: import type { ENUM_WORLD } from '../common/types';
 44: import { EventBus } from '../libs/eventBus';
 45: import { playUiSound } from '../libs/sfx';
 46: import { MAX_QUESTS, QuestActKind, type QuestDefinition } from '../libs/mu/questFiles';
 47: import { Store } from '../store';
 48: import type { QuestLayer } from './layer';
 49: import {
 50:   dialogScript,
 51:   questDataReady,
 52:   questDefinition,
 53: } from './questData';
 54: import { legacyKillCount } from './killCounters';
 55: import type { QuestObjective } from './objectives';
 56: 
 57: // ---- 1. tuning -------------------------------------------------------------
 58: 
 59: /** Quest states, 2 bits each in the list (`_enum.h:3526`). */
 60: export const LegacyQuestState = {
 61:   /** `QUEST_NONE`: not started. */
 62:   None: 0,
 63:   /** `QUEST_ING`: accepted, bringing the items / kills. */
 64:   InProgress: 1,
 65:   /** `QUEST_END`: finished. */
 66:   Finished: 2,
 67:   /** `QUEST_NO`: rejected / not yet available (never stored, dialog-only). */
 68:   No: 3,
 69: } as const;
 70: 
 71: /** Dialog-only states `CheckQuestState` sets (`_enum.h:3530-3531`). */
 72: const DIALOG_STATE_ITEM = 4; // QUEST_ITEM: everything brought, may complete
 73: const DIALOG_STATE_ERROR = 5; // QUEST_ERROR: a request (level, zen…) failed
 74: 
 75: /** `QUEST_STATES_PER_ENTRY` / `QUEST_STATE_BIT_WIDTH` / `QUEST_STATE_MASK`. */
 76: const STATES_PER_BYTE = 4;
 77: const STATE_BITS = 2;
 78: const STATE_MASK = 0x03;
 79: 
 80: /** `QUEST_COMBO` (_enum.h:3539): finishing it unlocks the combo skill. */
 81: const QUEST_COMBO = 2;
 82: 
 83: /** `wCompleteQuestIndex` / `byType` "none" markers in the request rows. */
 84: const NO_PREREQUISITE = 65535;
 85: const REQUEST_ANY_ACT = 255;
 86: 
 87: /** `m_iReturnForAnswer` codes (`UpdateSelTextMouseEvent`). */
 88: const ANSWER_NEXT_PROGRESS = 1;
 89: const ANSWER_CLOSE = 2;
 90: const ANSWER_SET_STATE = 3;
 91: 
 92: /** `LegacyQuestStateSetRequest.NewState` the original always sends: "accept / advance". */
 93: const SET_STATE_ADVANCE = 1;
 94: 
 95: /** `NUM_LINE_CMB` / `MAX_LENGTH_CMB`: the window wraps to 7 lines of 38 chars. */
 96: export const DIALOG_MAX_LINES = 7;
 97: const DIALOG_LINE_CHARS = 38;
 98: 
 99: /** `LegacyQuestReward.Reward` codes (`ReceiveQuestPrize`). */
100: const REWARD_LEVEL_UP_POINTS = 200;
101: const REWARD_CLASS_CHANGE = 201;
102: const REWARD_COMBO_SKILL = 202;
103: const REWARD_PLUS_STATS = 203;
104: 
105: /** `MAX_ITEM_INDEX`: item `Type = group * 512 + index`. */
106: const MAX_ITEM_INDEX = 512;
107: 
108: /** GlobalText 609: the lone answer when a page has none. */
109: const DEFAULT_ANSWER_KEY: TextKey = 'common.close';
110: 
111: // ---- 2. state + readers ----------------------------------------------------
112: 
113: /** One clickable line of the dialog. */
114: export type LegacyQuestAnswer = { text: string; link: number; action: number };
115: 
116: const state = observable({
117:   /** `m_byQuestList` unpacked: one state per quest index. */
118:   states: new Array<number>(MAX_QUESTS).fill(LegacyQuestState.None),
119:   /** `m_byCurrQuestIndex`: the quest the NPC window is about. */
120:   currentIndex: 0,
121:   /** `m_byCurrQuestIndexWnd`: the quest the "Job change" tab shows. */
122:   windowIndex: 0,
123:   /** `m_byCurrState` after `CheckQuestState` (dialog state, may be 4/5). */
124:   dialogState: 0,
125:   /** `INTERFACE_NPCQUEST` visible. */
126:   npcWindowOpen: false,
127:   /** `g_iCurrentDialogScript`. */
128:   page: 0,
129:   /** `g_lpszMessageBoxCustom`: the NPC's lines, wrapped. */
130:   lines: [] as string[],
131:   /** `g_lpszDialogAnswer`: the numbered answers. */
132:   answers: [] as LegacyQuestAnswer[],
133:   /** `m_dwNeedZen`: the offering the current page asks for (0 = none). */
134:   needZen: 0,
135:   /** Whether the list arrived for this character (`m_bOnce`). */
136:   received: false,
137: });
138: 
139: /** Whether the NPC quest window is showing. */
140: export function legacyQuestWindowOpen(): boolean {
141:   return state.npcWindowOpen;
142: }
143: 
144: /** The quest the window is about. */
145: export function legacyQuestCurrentIndex(): number {
146:   return state.currentIndex;
147: }
148: 
149: /** `getQuestState2(index)`: stored state, 0…2. */
150: export function legacyQuestState(index: number): number {
151:   return state.states[index] ?? LegacyQuestState.None;
152: }
153: 
154: /** Every state, for the quest log tab. */
155: export function legacyQuestStates(): readonly number[] {
156:   return state.states;
157: }
158: 
159: /** `m_byCurrState` after the last check, including the dialog-only values. */
160: export function legacyQuestDialogState(): number {
161:   return state.dialogState;
162: }
163: 
164: /** The NPC's lines of the current page. */
165: export function legacyQuestLines(): readonly string[] {
166:   return state.lines;
167: }
168: 
169: /** The answers of the current page. */
170: export function legacyQuestAnswers(): readonly LegacyQuestAnswer[] {
171:   return state.answers;
172: }
173: 
174: /** Zen the current page is asking for; 0 when none. */
175: export function legacyQuestNeedZen(): number {
176:   return state.needZen;
177: }
178: 
179: /** `getQuestTitleWindow()`: name of the quest the log tab is about. */
180: export function legacyQuestWindowTitle(): string {
181:   return questDefinition(state.windowIndex)?.name ?? '';
182: }
183: 
184: /** The chain quests the hero is on (`QUEST_ING`), by index. */
185: export function legacyQuestsInProgress(): number[] {
186:   const running: number[] = [];
187:   for (let i = 0; i < MAX_QUESTS; i++) {
188:     if (state.states[i] === LegacyQuestState.InProgress && questDefinition(i)?.name) running.push(i);
189:   }
190:   return running;
191: }
192: 
193: /** Whether the server told us the states yet. */
194: export function legacyQuestListReceived(): boolean {
195:   return state.received;
196: }
197: 
198: /** `GetBaseClass(Hero->Class)` as the act's class column. */
199: function heroClass(): BaseClass {
200:   return getBaseClass(Store.playerData.charClass);
201: }
202: 
203: /**
204:  * `setQuestLists`: the quest indexes this class walks, in order. A Knight
205:  * takes the whole chain, the three later classes start at 4, and everyone
206:  * else skips the combo quest.
207:  */
208: function chainIndexes(cls: BaseClass, count: number): number[] {
209:   const out: number[] = [];
210:   const later =
211:     cls === BaseClass.MagicGladiator ||
212:     cls === BaseClass.DarkLord ||
213:     cls === BaseClass.RageFighter;
214:   const from = later ? 4 : 0;
215:   for (let i = from; i < count; i++) {
216:     if (cls !== BaseClass.Knight && i === QUEST_COMBO) continue;
217:     out.push(i);
218:   }
219:   return out;
220: }
221: 
222: /** `m_byCurrQuestIndex` after `setQuestLists`: the first unfinished quest of the chain. */
223: function firstOpenQuest(count: number, cls: BaseClass): number {
224:   const stateOf = (i: number) => state.states[i] ?? LegacyQuestState.None;
225:   const open = chainIndexes(cls, count).find(i => stateOf(i) !== LegacyQuestState.Finished);
226:   return open ?? count;
227: }
228: 
229: /** `setQuestLists`: the packed 2-bit list from `LegacyQuestStateList`. */
230: function setQuestList(packed: Uint8Array, count: number): void {
231:   runInAction(() => {
232:     for (let i = 0; i < MAX_QUESTS; i++) {
233:       const byte = packed[Math.floor(i / STATES_PER_BYTE)] ?? 0;
234:       const shift = (i % STATES_PER_BYTE) * STATE_BITS;
235:       state.states[i] = i < count ? (byte >> shift) & STATE_MASK : LegacyQuestState.None;
236:     }
237:     const first = firstOpenQuest(count, heroClass());
238:     state.currentIndex = first;
239:     state.windowIndex = first;
240:     state.received = true;
241:   });
242: }
243: 
244: /** `setQuestList(index, result)`: one state changed. */
245: function setQuestState(index: number, result: number): void {
246:   if (index < 0 || index >= MAX_QUESTS) return;
247:   runInAction(() => {
248:     state.states[index] = result & STATE_MASK;
249:     state.currentIndex = index;
250:     state.windowIndex = Math.max(index, state.windowIndex);
251:   });
252: }
253: 
254: /** `FindQuestItemsInInven`: how many of `count` items are still missing. */
255: function missingItems(itemType: number, count: number, level: number): number {
256:   let found = 0;
257:   for (const item of Store.playerData.items) {
258:     if (!item) continue;
259:     if (item.group * MAX_ITEM_INDEX + item.num !== itemType) continue;
260:     if (level !== -1 && (item.lvl ?? 0) !== level) continue;
261:     if (count <= ++found) return 0;
262:   }
263:   return count - found;
264: }
265: 
266: /** Which acts apply to the hero's class. */
267: function actsForHero(quest: QuestDefinition) {
268:   const cls = heroClass();
269:   return quest.acts.slice(0, quest.conditionCount).filter(act => (act.requestClass[cls] ?? 0) >= 1);
270: }
271: 
272: /**
273:  * `CheckRequestCondition`: level / prerequisite / zen rows for the acts of
274:  * this class. Returns the error page on failure, -1 when everything passes.
275:  * Zen is only enforced on `lastCheck` (the accept click); before that it is
276:  * merely remembered for the window's offering line.
277:  */
278: function checkRequests(quest: QuestDefinition, lastCheck: boolean): number {
279:   let needZen = 0;
280:   let errorPage = -1;
281: 
282:   outer: for (const act of actsForHero(quest)) {
283:     for (const req of quest.requests.slice(0, quest.requestCount)) {
284:       if (req.type !== act.requestType && req.type !== REQUEST_ANY_ACT) continue;
285: 
286:       if (req.completeQuestIndex !== NO_PREREQUISITE) {
287:         if (legacyQuestState(req.completeQuestIndex) !== LegacyQuestState.Finished) {
288:           errorPage = req.errorText;
289:           break outer;
290:         }
291:       }
292:       const level = Store.playerData.level;
293:       if (req.levelMin > 0 && req.levelMin > level) {
294:         errorPage = req.errorText;
295:         break outer;
296:       }
297:       if (req.levelMax > 0 && req.levelMax < level) {
298:         errorPage = req.errorText;
299:         break outer;
300:       }
301:       if (req.zen > 0) {
302:         needZen = req.zen;
303:         if (lastCheck && needZen > Store.playerData.money) {
304:           errorPage = req.errorText;
305:           break outer;
306:         }
307:       }
308:     }
309:   }
310: 
311:   runInAction(() => {
312:     state.needZen = needZen;
313:   });
314:   return errorPage;
315: }
316: 
317: /** `CheckActCondition`: has the hero brought everything? */
318: function actsFulfilled(quest: QuestDefinition): boolean {
319:   for (const act of actsForHero(quest)) {
320:     if (act.kind === QuestActKind.Item) {
321:       const type = act.itemType * MAX_ITEM_INDEX + act.itemSubType;
322:       if (missingItems(type, act.itemNum, act.itemLevel) > 0) return false;
323:     } else if (act.kind === QuestActKind.Monster) {
324:       if (legacyKillCount(act.itemType) < act.itemNum) return false;
325:     }
326:   }
327:   return true;
328: }
329: 
330: /**
331:  * `RenderItemMobText`: what this class still has to bring, as objective
332:  * records. The item count is the bag's, the kill count the counters', both
333:  * read the same way `CheckActCondition` reads them.
334:  */
335: export function legacyQuestObjectives(index: number): QuestObjective[] {
336:   const quest = questDefinition(index);
337:   if (!quest) return [];
338: 
339:   const objectives: QuestObjective[] = [];
340:   for (const act of actsForHero(quest)) {
341:     if (act.kind === QuestActKind.Monster) {
342:       objectives.push({
343:         type: ConditionTypeEnum.MonsterKills,
344:         id: act.itemType,
345:         required: act.itemNum,
346:         current: legacyKillCount(act.itemType),
347:         name: monsterDisplayName(act.itemType),
348:       });
349:     } else if (act.kind === QuestActKind.Item) {
350:       const type = act.itemType * MAX_ITEM_INDEX + act.itemSubType;
351:       objectives.push({
352:         type: ConditionTypeEnum.Item,
353:         id: type,
354:         required: act.itemNum,
355:         current: act.itemNum - missingItems(type, act.itemNum, act.itemLevel),
356:         name: itemBaseName(act.itemType, act.itemSubType) || t('quest.itemFallback', { id: type }),
357:       });
358:     }
359:   }
360:   return objectives;
361: }
362: 
363: /** `FindQuestContext(quest, column)`: the dialog page for this state column. */
364: function pageFor(quest: QuestDefinition, column: number): number {
365:   const act = actsForHero(quest)[0];
366:   return act ? act.startText[column] : 0;
367: }
368: 
369: /** `CheckQuestState`: pick the page and the dialog state for the current quest. */
370: function checkQuestState(): number {
371:   const quest = questDefinition(state.currentIndex);
372:   if (!quest) return 0;
373: 
374:   let dialogState: number = legacyQuestState(state.currentIndex);
375:   let page = 0;
376: 
377:   switch (dialogState) {
378:     case LegacyQuestState.None:
379:     case LegacyQuestState.No: {
380:       const error = checkRequests(quest, false);
381:       if (error >= 0) {
382:         page = error;
383:         dialogState = DIALOG_STATE_ERROR;
384:       } else {
385:         page = pageFor(quest, 0);
386:       }
387:       break;
388:     }
389:     case LegacyQuestState.InProgress: {
390:       if (actsFulfilled(quest)) {
391:         page = pageFor(quest, 2);
392:         dialogState = DIALOG_STATE_ITEM;
393:       } else {
394:         page = pageFor(quest, 1);
395:       }
396:       break;
397:     }
398:     case LegacyQuestState.Finished:
399:       page = pageFor(quest, 3);
400:       break;
401:   }
402: 
403:   runInAction(() => {
404:     state.dialogState = dialogState;
405:   });
406:   return page;
407: }
408: 
409: /** `SeparateTextIntoLines`: greedy word wrap to the window's 38 columns. */
410: export function wrapDialogText(text: string, maxLines = DIALOG_MAX_LINES, width = DIALOG_LINE_CHARS): string[] {
411:   const lines: string[] = [];
412:   let current = '';
413: 
414:   for (const word of text.split(/\s+/).filter(Boolean)) {
415:     if (!current) {
416:       current = word;
417:     } else if (current.length + 1 + word.length <= width) {
418:       current += ' ' + word;
419:     } else {
420:       lines.push(current);
421:       current = word;
422:       if (lines.length >= maxLines) break;
423:     }
424:   }
425:   if (current && lines.length < maxLines) lines.push(current);
426:   return lines;
427: }
428: 
429: /** `ShowDialogText(page)`: put a dialog page in the window. */
430: function showDialogText(page: number): void {
431:   const script = dialogScript(page);
432:   const answers: LegacyQuestAnswer[] = (script?.answers ?? []).map((a, i) => ({
433:     text: `${i + 1}) ${a.text}`,
434:     link: a.link,
435:     action: a.action,
436:   }));
437:   if (answers.length === 0) {
438:     answers.push({ text: `1) ${t(DEFAULT_ANSWER_KEY)}`, link: 0, action: ANSWER_CLOSE });
439:   }
440: 
441:   runInAction(() => {
442:     state.page = page;
443:     state.lines = wrapDialogText(script?.text ?? '');
444:     state.answers = answers;
445:   });
446: }
447: 
448: /**
449:  * A dialogue page is a snapshot: `showDialogText` copies the words and answers
450:  * out of the tables into `state`. When the language changes those tables are
451:  * fetched again (`questData.ts`), so an open window has to be redrawn from the
452:  * new ones - otherwise it keeps showing the language it was opened in.
453:  *
454:  * Keyed on `questDataReady()` rather than on the language itself: it is the
455:  * flip back to true, once the new tables are decoded, that has something to
456:  * show.
457:  */
458: reaction(
459:   () => questDataReady(),
460:   ready => {
461:     if (ready && state.npcWindowOpen) showDialogText(state.page);
462:   }
463: );
464: 
465: /** `ShowQuestNpcWindow(index)`: open the window on a quest (default: the current one). */
466: export function openLegacyQuestWindow(index = -1): void {
467:   runInAction(() => {
468:     if (index >= 0) state.currentIndex = index;
469:     state.npcWindowOpen = true;
470:   });
471:   showDialogText(checkQuestState());
472:   playUiSound('window');
473: }
474: 
475: /** `Hide(INTERFACE_NPCQUEST)` + `SendCloseNpcRequest`. */
476: export function closeLegacyQuestWindow(): void {
477:   if (!state.npcWindowOpen) return;
478:   runInAction(() => {
479:     state.npcWindowOpen = false;
480:   });
481:   Store.closeNpcShop();
482: }
483: 
484: /** `SendLegacyQuestStateSetRequest(index, 1)`. */
485: function sendSetState(index: number): void {
486:   const packet = LegacyQuestStateSetRequestPacket.createPacket();
487:   packet.QuestNumber = index;
488:   packet.NewState = SET_STATE_ADVANCE;
489:   Store.sendToGS(packet.buffer);
490: }
491: 
492: /** `ProcessNextProgress`: re-check with zen enforced, then ask the server. Returns true on error. */
493: function processNextProgress(): boolean {
494:   const quest = questDefinition(state.currentIndex);
495:   if (!quest) return true;
496: 
497:   const error = checkRequests(quest, true);
498:   if (error >= 0) {
499:     showDialogText(error);
500:     return true;
501:   }
502:   sendSetState(state.currentIndex);
503:   return false;
504: }
505: 
506: /** `UpdateSelTextMouseEvent`: the hero picked answer `i`. */
507: export function answerLegacyQuest(i: number): void {
508:   const answer = state.answers[i];
509:   if (!answer) return;
510: 
511:   let errored = false;
512:   if (answer.action === ANSWER_NEXT_PROGRESS) errored = processNextProgress();
513:   else if (answer.action === ANSWER_CLOSE) closeLegacyQuestWindow();
514:   else if (answer.action === ANSWER_SET_STATE) sendSetState(state.currentIndex);
515: 
516:   playUiSound('window');
517: 
518:   if (answer.link > 0 && !errored) showDialogText(answer.link);
519: }
520: 
521: /** `SendLegacyQuestStateRequest` (0xA0): ask for every state after entering. */
522: export function requestLegacyQuestStates(): void {
523:   if (Store.isOffline) return;
524:   Store.sendToGS(LegacyQuestStateRequestPacket.createPacket().buffer);
525: }
526: 
527: /**
528:  * Which of this NPC's quests to open on him. The original never asks: it
529:  * opens the chain where it stands (`ShowQuestNpcWindow()` with no index), and
530:  * the server is what decides the NPC. Ours has to pick both, and picking the
531:  * NPC's *first* quest meant Sebina kept re-opening the finished Scroll of the
532:  * Emperor page and never offered the Three Treasures of Mu behind it. So:
533:  * the first quest of his the hero has not finished, and his last one once
534:  * they all are, which is the page that thanks them.
535:  */
536: export function legacyQuestForNpc(npcType: number): QuestDefinition | undefined {
537:   const mine = chainIndexes(heroClass(), MAX_QUESTS)
538:     .map(i => questDefinition(i))
539:     .filter((q): q is QuestDefinition => !!q && q.npcType === npcType && !!q.name);
540:   if (!mine.length) return undefined;
541: 
542:   return (
543:     mine.find(q => legacyQuestState(q.index) !== LegacyQuestState.Finished) ??
544:     mine[mine.length - 1]
545:   );
546: }
547: 
548: /** `Hero->byExtensionSkill`: the combo is unlocked by finishing `QUEST_COMBO`. */
549: export function comboUnlocked(): boolean {
550:   return legacyQuestState(QUEST_COMBO) === LegacyQuestState.Finished;
551: }
552: 
553: // ---- packet handlers (ReceiveQuestHistory / State / Result / Prize) -------
554: 
555: EventBus.on('LegacyQuestStateList', packet => {
556:   const p = new LegacyQuestStateListPacket(packet);
557:   const count = p.QuestCount;
558:   const bytes = Math.ceil(count / STATES_PER_BYTE);
559:   const packed = new Uint8Array(bytes);
560:   for (let i = 0; i < bytes; i++) {
561:     packed[i] = packet.byteLength > LegacyQuestStateListPacket.DataOffset + 2 + i
562:       ? packet.getUint8(LegacyQuestStateListPacket.DataOffset + 2 + i)
563:       : 0;
564:   }
565:   setQuestList(packed, count);
566: });
567: 
568: EventBus.on('LegacyQuestStateDialog', packet => {
569:   const p = new LegacyQuestStateDialogPacket(packet);
570:   setQuestState(p.QuestIndex, p.State);
571:   openLegacyQuestWindow(p.QuestIndex);
572: });
573: 
574: EventBus.on('LegacySetQuestStateResponse', packet => {
575:   const p = new LegacySetQuestStateResponsePacket(packet);
576:   // `ReceiveQuestResult`: Result 0 = accepted; anything else leaves the dialog where it is.
577:   if (p.Result !== 0) {
578:     Store.addNotification(t('quest.stateFailed'), 'error');
579:     return;
580:   }
581:   setQuestState(p.QuestIndex, p.NewState);
582:   openLegacyQuestWindow(p.QuestIndex);
583: });
584: 
585: EventBus.on('LegacyQuestReward', packet => {
586:   const p = new LegacyQuestRewardPacket(packet);
587:   const hero = Store.world?.playerEntity;
588:   const isHero = !!hero && (p.PlayerId & 0x7fff) === hero.netId;
589: 
590:   switch (p.Reward as number) {
591:     case REWARD_LEVEL_UP_POINTS:
592:       if (isHero) {
593:         Store.addNotification(
594:           t('quest.rewardPoints', { count: p.Count }),
595:           'info'
596:         );
597:       }
598:       break;
599:     case REWARD_CLASS_CHANGE:
600:       if (isHero) Store.addNotification(t('quest.evolved'), 'info');
601:       break;
602:     case REWARD_COMBO_SKILL:
603:       if (isHero) Store.addNotification(t('quest.comboLearned'), 'info');
604:       break;
605:     case REWARD_PLUS_STATS:
606:       if (isHero) {
607:         Store.addNotification(
608:           t('quest.rewardStats', { count: p.Count }),
609:           'info'
610:         );
611:       }
612:       break;
613:   }
614:   if (hero && isHero) {
615:     EventBus.emit('objectEffect', { entity: hero, effect: 'levelUp' });
616:     playUiSound('levelUp');
617:   }
618: });
619: 
620: // `ReceiveQuestHistory` is only answered when asked: the original sends
621: // 0xA0 right after the character information arrives.
622: EventBus.on('CharacterInformation', () => {
623:   runInAction(() => {
624:     state.received = false;
625:     state.npcWindowOpen = false;
626:   });
627:   requestLegacyQuestStates();
628: });
629: 
630: function reset(): void {
631:   runInAction(() => {
632:     state.npcWindowOpen = false;
633:     state.needZen = 0;
634:   });
635: }
636: 
637: // ---- 3. the layer ----------------------------------------------------------
638: 
639: export const legacyQuestsLayer: QuestLayer = { name: 'legacyQuests', reset };
