157: /**
158:  * GLSL for the terrain fragment: a PCF 3x3 lookup into the sun's cascades,
159:  * mirroring Babylon's `computeShadowWithCSMPCF3`; see `terrainCsmDefines`
160:  * for the variants. Returns the sun factor, 1 lit .. 0 fully shadowed; the
161:  * caller applies the policy floor.
162:  */
163: export function terrainCsmGlsl(): string {
164:   return `
165:   uniform vec4 csmParams; // x: enabled, y: bake floor (sky share), z: cascades
166: 
167: #if defined(CSM_PCF) || defined(CSM_FLOAT)
168:   uniform mat4 csmLightMatrices[CSM_MAX_CASCADES];
169:   uniform float csmFrustumZ[CSM_MAX_CASCADES];
170:   uniform vec2 csmMapSize; // size, 1/size
171: #ifdef CSM_PCF
172:   uniform highp sampler2DArrayShadow csmShadowMap;
173: #else
174:   uniform highp sampler2DArray csmShadowMapF;
175: #endif
176: 
177:   float csmShadow(vec3 worldPos, float viewZ) {
178:     if (csmParams.x < 0.5) return 1.0;
179: 
180:     int cascade = -1;
181:     for (int i = 0; i < CSM_MAX_CASCADES; i++) {
182:       if (i >= int(csmParams.z)) break;
183:       if (csmFrustumZ[i] - viewZ >= 0.0) { cascade = i; break; }
184:     }
185:     if (cascade < 0) return 1.0;
186: 
187:     vec4 fromLight = csmLightMatrices[cascade] * vec4(worldPos, 1.0);
188:     vec3 clipSpace = fromLight.xyz / fromLight.w;
189:     vec3 uvDepth = vec3(0.5 * clipSpace + vec3(0.5));
190:     if (uvDepth.x < 0.0 || uvDepth.x > 1.0 || uvDepth.y < 0.0 || uvDepth.y > 1.0) return 1.0;
191:     uvDepth.z = clamp(uvDepth.z, 0.0, 0.99999994);
192: 
193:     vec2 uv = uvDepth.xy * csmMapSize.x + 0.5;
194:     vec2 st = fract(uv);
195:     vec2 baseUv = (floor(uv) - 0.5) * csmMapSize.y;
196:     vec2 uvw0 = 3.0 - 2.0 * st;
197:     vec2 uvw1 = 1.0 + 2.0 * st;
198:     vec2 u = vec2((2.0 - st.x) / uvw0.x - 1.0, st.x / uvw1.x + 1.0) * csmMapSize.y;
199:     vec2 v = vec2((2.0 - st.y) / uvw0.y - 1.0, st.y / uvw1.y + 1.0) * csmMapSize.y;
200:     float layer = float(cascade);
201:     float shadow = 0.0;
202: 
203: #ifdef CSM_FLOAT
204:     for (int y = -1; y <= 1; y++) {
205:       for (int x = -1; x <= 1; x++) {
206:         vec2 o = vec2(float(x), float(y)) * csmMapSize.y;
207:         float d = texture2D(csmShadowMapF, vec3(uvDepth.xy + o, layer)).r;
208:         shadow += uvDepth.z <= d ? 1.0 : 0.0;
209:       }
210:     }
211:     shadow /= 9.0;
212: #else
213:     shadow += uvw0.x * uvw0.y * texture2D(csmShadowMap, vec4(baseUv + vec2(u[0], v[0]), layer, uvDepth.z));
214:     shadow += uvw1.x * uvw0.y * texture2D(csmShadowMap, vec4(baseUv + vec2(u[1], v[0]), layer, uvDepth.z));
215:     shadow += uvw0.x * uvw1.y * texture2D(csmShadowMap, vec4(baseUv + vec2(u[0], v[1]), layer, uvDepth.z));
216:     shadow += uvw1.x * uvw1.y * texture2D(csmShadowMap, vec4(baseUv + vec2(u[1], v[1]), layer, uvDepth.z));
217:     shadow /= 16.0;
218: #endif
219: 
220:     // Soft edge at the last cascade's far end instead of a hard cut.
221:     float edge = smoothstep(0.8, 1.0, clamp(dot(clipSpace.xy, clipSpace.xy), 0.0, 1.0));
222:     return mix(shadow, 1.0, edge);
223:   }
224: #else
225:   float csmShadow(vec3 worldPos, float viewZ) { return 1.0; }
226: #endif
227:   `;
228: }
229: 
230: const lightMatrices = new Float32Array(CSM_MAX_CASCADES * 16);
231: const frustumZ = new Array<number>(CSM_MAX_CASCADES).fill(0);
232: 
233: /** Per-bind terrain uniforms; cheap no-op while Classic. */
234: export function bindTerrainCsm(effect: Effect): void {
235:   const csm = runtime?.csm;
236:   const map = csm?.getShadowMap();
237: 
238:   // Only the variant compiled for the live state carries the samplers; a
239:   // stale effect (recompile pending) must not bind what it does not declare.
240:   if (!csm || !map || !effect.defines.includes('CSM_')) {
241:     effect.setFloat4('csmParams', 0, 1, 0, 0);
242:     return;
243:   }
244: 
245:   const count = csm.numCascades;
246: 
247:   for (let i = 0; i < count; i++) {
248:     csm.getCascadeTransformMatrix(i)?.copyToArray(lightMatrices, i * 16);
249:   }
250: 
251:   // Babylon keeps the per-cascade far planes private; they are exactly what
252:   // `lightFragment` compares the view depth against.
253:   const zs = (csm as unknown as { _viewSpaceFrustumsZ: number[] })
254:     ._viewSpaceFrustumsZ;
255: 
256:   for (let i = 0; i < CSM_MAX_CASCADES; i++) {
257:     frustumZ[i] = i < count ? zs[i] : 0;
258:   }
259: 
260:   const size = map.getSize().width;
261: 
262:   const compare = csm.filter !== ShadowGenerator.FILTER_NONE;
263: 
264:   effect.setFloat4('csmParams', compare ? 1 : 2, terrainFloor, count, 0);
265:   effect.setMatrices('csmLightMatrices', lightMatrices);
266:   effect.setArray('csmFrustumZ', frustumZ);
267:   effect.setFloat2('csmMapSize', size, 1 / size);
268: 
269:   if (compare) effect.setDepthStencilTexture('csmShadowMap', map);
270:   else effect.setTexture('csmShadowMapF', map);
271: }
272: 
273: // --- casters ---------------------------------------------------------------
274: 
275: /**
276:  * Slack (tiles) past `CSM_MAX_Z` before a mesh is ruled out as a caster. The
277:  * cascades are fitted to the camera frustum out to CSM_MAX_Z, so nothing
278:  * further than that from the camera can land in any of them - but a caster
279:  * *behind* the camera still shadows what is in front of it, so the test is on
280:  * plain distance, not on the view frustum, and it keeps a wide margin.
281:  */
282: const CSM_CASTER_SLACK = 16;
283: 
284: /** How far from the camera (tiles) a mesh can stand and still cast. */
285: export const CSM_CASTER_REACH = CSM_MAX_Z + CSM_CASTER_SLACK;
286: 
287: const CSM_CASTER_RANGE_SQ = CSM_CASTER_REACH ** 2;
288: 
289: /**
290:  * A map object under this height (tiles) is ground clutter - grass, a flower,
291:  * a ground decal, a small mushroom - and its shadow is a card's noise at
292:  * gameplay zoom, while Noria stands 600 of them in one frame (22 -> 28 fps
293:  * without them). A cost rule, not a look one: inside a room the whole room is
294:  * the frame and everything standing in it casts, however small.
295:  *
296:  * It is the only thing between a map object and the cascades. What stood here
297:  * before was a bake test (§13 F1/F15): the lightmap was read for an authored
298:  * shadow under each static object and the object kept out of the map wherever
299:  * one seemed to be there. The premise does not hold - MU's bakes carry pockets
300:  * of darkening, not object shadows - so what it removed was the object's only
301:  * shadow, and half of a town cast nothing.
302:  */
303: const CLUTTER_HEIGHT = 1;
304: 
305: function isGroundClutter(mesh: AbstractMesh): boolean {
306:   // A prop batch's box is the union of every placement in its chunk; the
307:   // type's own height rides in its metadata (common/propBatches.ts).
308:   const own = mesh.metadata?.casterHeight;
309: 
310:   let height: number;
311: 
312:   if (typeof own === 'number') {
313:     height = own;
314:   } else {
315:     const box = mesh.getBoundingInfo().boundingBox;
316:     height = box.maximumWorld.y - box.minimumWorld.y;
317:   }
318: 
319:   return height < (minCasterDev ?? CLUTTER_HEIGHT);
320: }
321: 
322: function castsSunShadow(mesh: AbstractMesh): boolean {
323:   const meta = mesh.metadata;
324: 
325:   if (!meta || meta.csmCaster !== true) return false;
326: 
327:   // The blend mesh is an additive glow card - light, not matter - with one
328:   // exception: the objects that say the card *is* their body (wings,
329:   // `ModelObject.ShadowBlendMeshCasts`). A caster only; `occludes` in
330:   // ambientOcclusion.ts still keeps it out of the G-buffer.
331:   const blendCaster = meta.shadowBlendCaster === true;
332: 
333:   if (meta.brightMesh && !blendCaster) return false;
334: 
335:   if (!drawsSolidGeometry(mesh, blendCaster)) return false;
336: 
337:   return !(
338:     casters === 'dynamic' &&
339:     meta.mapObject === true &&
340:     isGroundClutter(mesh)
341:   );
342: }
343: 
344: /**
345:  * A mesh that is drawn as matter rather than as light, and is near enough to
346:  * be worth a pass over. Shared by the cascades and the G-buffer: both want
347:  * "surfaces that are really there", and both are re-run over every mesh in
348:  * the scene on every refresh (`RenderTargetTexture.render`), so the distance
349:  * test comes first as the cheapest filter available.
350:  *
351:  * They do not share a reach, though, and `rangeSq` is it, squared: a cascade
352:  * is fitted out to `CSM_MAX_Z` and cannot hold a caster past it, while the
353:  * G-buffer is where the haze reads its distance, so its reach has to be
354:  * whatever the camera actually draws.
355:  */
356: export function drawsSolidGeometry(
357:   mesh: AbstractMesh,
358:   allowBlend = false,
359:   rangeSq = CSM_CASTER_RANGE_SQ
360: ): boolean {
361:   if (!mesh.isEnabled() || !mesh.isVisible) return false;
362: 
363:   const camera = mesh.getScene().activeCamera;
364: 
365:   if (camera) {
366:     const centre = mesh.getBoundingInfo().boundingSphere.centerWorld;
367:     const dx = centre.x - camera.globalPosition.x;
368:     const dy = centre.y - camera.globalPosition.y;
369:     const dz = centre.z - camera.globalPosition.z;
370: 
371:     if (dx * dx + dy * dy + dz * dz > rangeSq) return false;
372:   }
373: 
374:   const material = mesh.material;
375:   if (!material) return false;
376: 
377:   // Pure blend meshes (effects) are light, not matter; MU's alpha-keyed
378:   // meshes are ALPHATESTANDBLEND and go through the alpha test (in the
379:   // cascades that is what `transparencyShadow` buys).
380:   return (
381:     allowBlend || material.transparencyMode !== Material.MATERIAL_ALPHABLEND
382:   );
383: }
384: 
385: function reachFor(who: ShadowCasters): number {
386:   return who === 'all' ? CSM_ROOM_MAX_Z : CSM_MAX_Z;
387: }
388: 
389: /**
390:  * Clamped to a count the generator will report back. It pulls an out-of-range
391:  * count into range without saying so, so asking for one outside it leaves
392:  * `syncShadows` re-applying the same request on every frame. The upper bound
393:  * is ours: the terrain shader sizes its cascade arrays at `CSM_MAX_CASCADES`.
394:  */
395: function cascadesFor(who: ShadowCasters, tier: LightingTier): number {
396:   const want = who === 'all' ? CSM_ROOM_CASCADES : cascadesDev ?? tier.cascades;
397: 
398:   return Math.min(
399:     Math.max(want, CascadedShadowGenerator.MIN_CASCADES_COUNT),
400:     CSM_MAX_CASCADES
401:   );
402: }
403: 
404: /** Frozen materials skip the light-dirty pass; force the rebuild once. */
405: function rebuildFrozenMaterials(scene: Scene): void {
406:   for (const material of scene.materials) {
407:     if (material.isFrozen) material.markDirty(true);
408:   }
409: }
410: 
411: // --- setup -----------------------------------------------------------------
412: 
413: /**
414:  * Who enters the map, and how often it is drawn. Both live on the shadow map
415:  * itself, and Babylon builds a *new* one on every `numCascades` change
416:  * (`recreateShadowMap`), carrying over the render list's contents but neither
417:  * the predicate that fills it nor the refresh rate. Left un-hooked, the caster
418:  * set freezes to whatever stood in it when the room was entered: nothing
419:  * loaded afterwards ever casts, and nothing already in it ever leaves.
420:  */
421: function hookShadowMap(csm: CascadedShadowGenerator, scene: Scene): void {
422:   const map = csm.getShadowMap();
423: 
424:   if (!map) return;
425: 
426:   // Not `renderListPredicate`: see scenes/renderList.ts for what that costs
427:   // per frame. The list is released with the map.
428:   driveRenderList(scene, map, castsSunShadow);
429:   cullPerCascade(csm, map);
430:   map.refreshRate = refreshDev ?? 1;
431: }
432: 
433: /** A plane every point is in front of: the slot of a test that is skipped. */
434: const PASS_PLANE = new Plane(0, 0, 0, 1);
435: 
436: /**
437:  * Babylon draws the whole caster list into every cascade. The near cascade
438:  * covers a few tiles around the hero and the middle one a few more, so most
439:  * of the list lands in the far one only: at the Noria spawn, 88 casters were
440:  * 264 draws for 159 that reach a cascade. Each cascade now takes the casters
441:  * inside its own bounds.
442:  *
443:  * Only the four side planes are tested. With `depthClamp` Babylon tightens a
444:  * cascade's near plane to the casters' box and clamps whatever stands nearer
445:  * the light, so a caster the near plane would reject still casts; and the far
446:  * plane already sits at the casters' box. Babylon's frustum test reads six
447:  * planes, so those two slots hold a plane nothing is behind.
448:  */
449: function cullPerCascade(
450:   csm: CascadedShadowGenerator,
451:   map: RenderTargetTexture
452: ): void {
453:   const planes = [0, 1, 2, 3, 4, 5].map(() => new Plane(0, 0, 0, 0));
454:   const sides = [PASS_PLANE, PASS_PLANE, planes[2], planes[3], planes[4], planes[5]];
455:   const lists: AbstractMesh[][] = [];
456: 
457:   map.getCustomRenderList = (cascade, list, length) => {
458:     const transform = csm.getCascadeTransformMatrix(cascade);
459: 
460:     if (!list || !transform) return null;
461: 
462:     Frustum.GetPlanesToRef(transform, planes);
463: 
464:     const out = (lists[cascade] ??= []);
465:     let n = 0;
466: 
467:     for (let i = 0; i < length; i++) {
468:       const mesh = list[i];
469:       if (mesh.isInFrustum(sides)) out[n++] = mesh;
470:     }
471: 
472:     out.length = n;
473: 
474:     return out;
475:   };
476: }
477: 
478: function createCsm(
479:   scene: Scene,
480:   sun: DirectionalLight,
481:   tier: LightingTier,
482:   policy: ShadowPolicy
483: ): CascadedShadowGenerator {
484:   const csm = new CascadedShadowGenerator(
485:     mapSizeDev ?? tier.shadowMapSize,
486:     sun,
487:     true
488:   );
489: 
490:   csm.numCascades = cascadesFor(policy.casters, tier);
491:   csm.lambda = CSM_LAMBDA;
492:   csm.shadowMaxZ = reachFor(policy.casters);
493:   csm.stabilizeCascades = true;
494:   csm.depthClamp = true;
495:   csm.filter = tier.pcss
496:     ? ShadowGenerator.FILTER_PCSS
497:     : ShadowGenerator.FILTER_PCF;
498:   csm.filteringQuality = ShadowGenerator.QUALITY_MEDIUM;
499:   csm.contactHardeningLightSizeUVRatio = softnessDev ?? policy.softness;
500:   csm.bias = biasDev ?? CSM_BIAS;
501:   csm.normalBias = normalBiasDev ?? CSM_NORMAL_BIAS;
502:   csm.cascadeBlendPercentage = CSM_BLEND;
503:   csm.darkness = 0;
504:   csm.frustumEdgeFalloff = 0.2;
505: 
506:   // Without this Babylon drops every *transparent* submesh from the shadow
507:   // map (`_renderForShadowMap`), and `modelLoader` promotes every
508:   // TGA-textured mesh to ALPHATESTANDBLEND - most of what a character wears.
509:   // They land in the alpha-tested depth pass, keyed by their own texture.
510:   csm.transparencyShadow = true;
511: 
512:   hookShadowMap(csm, scene);
513: 
514:   // The object materials are shared and carry a placeholder diffuse; the
515:   // real texture is per mesh (`metadata.diffuseTexture`, see itemMaterial).
516:   // The depth pass alpha-tests against `diffuseSampler`, so bind it here.
517:   let current: AbstractMesh | null = null;
518: 
519:   csm.onBeforeShadowMapRenderMeshObservable.add(mesh => {
520:     current = mesh;
521:   });
522: 
523:   csm.onBeforeShadowMapRenderObservable.add(effect => {
524:     const texture = current?.metadata?.diffuseTexture;
525: 
526:     if (texture) effect.setTexture('diffuseSampler', texture);
527: 
528:     // The normal bias pulls a caster's vertices inward along their normals so
529:     // a receiver's lit surface stays clear of its own stored depth. Only a
530:     // receiver has that problem, and only the map receives (ModelObject sets
531:     // `receiveShadows = IsMapObject`). A body is rigid bone segments that
532:     // overlap by a few centimetres (`bmdToGlb` binds each vertex to one
533:     // bone), so the same 3 cm opened a gap at every joint and a character's
534:     // shadow landed as a pile of parts. Babylon binds this uniform per
535:     // submesh just before the observer fires, so the override sticks.
536:     const normalBias = current?.receiveShadows ? csm.normalBias : 0;
537: 
538:     effect.setFloat3('biasAndScaleSM', csm.bias, normalBias, csm.depthScale);
539:   });
540: 
541:   return csm;
542: }
543: 
544: function destroyCsm(): void {
545:   if (!runtime?.csm) return;
546: 
547:   runtime.csm.dispose();
548:   runtime.csm = null;
549: }
550: 
551: function invalidate(scene: Scene): void {
552:   csmState.active = runtime !== null && runtime.csm !== null;
553: 
554:   recompileTerrainMaterials();
555:   rebuildFrozenMaterials(scene);
556:   blobShadowRefresh.fn?.(scene);
557: }
558: 
559: export function disposeShadows(): void {
560:   if (!runtime) return;
561: 
562:   const { scene } = runtime;
563: 
564:   destroyCsm();
565:   runtime = null;
566: 
567:   invalidate(scene);
568: }
569: 
570: /**
571:  * Bring the cascades in line with the tier, the shadows option and the
572:  * policy. Idempotent; called from the director's tick.
573:  *
574:  * `GameOptions.shadows` is the player's "Object shadows" toggle; it gates the
575:  * cascades and the blobs alike, so unchecking it removes every shadow. The
576:  * toggle is a rebuild rather than a flag because the CSM is compiled into
577:  * the terrain and object materials (the `CSM_` defines).
578:  */
579: export function syncShadows(
580:   scene: Scene,
581:   tier: LightingTier | null,
582:   policy: ShadowPolicy
583: ): void {
584:   terrainFloor = 1 - policy.strength;
585:   // The predicate runs on the next refresh; a room switching the set does not
586:   // need a rebuild, and the reach is a re-split, not a rebuild either.
587:   casters = policy.casters;
588: 
589:   if (runtime?.csm) {
590:     runtime.csm.shadowMaxZ = reachFor(casters);
591:     // A cascade count change recreates the map; once per room entered.
592:     const cascades = cascadesFor(casters, runtime.tier);
593: 
594:     if (runtime.csm.numCascades !== cascades) {
595:       runtime.csm.numCascades = cascades;
596:       hookShadowMap(runtime.csm, scene);
597:     }
598:   }
599: 
600:   if (!tier) {
601:     disposeShadows();
602:     return;
603:   }
604: 
605:   if (runtime && (runtime.tier !== tier || runtime.scene !== scene)) {
606:     disposeShadows();
607:   }
608: 
609:   if (!runtime) {
610:     runtime = { scene, tier, csm: null, shadows: false };
611:   }
612: 
613:   const want = GameOptions.shadows;
614: 
615:   if (want === runtime.shadows) return;
616: 
617:   runtime.shadows = want;
618: 
619:   destroyCsm();
620: 
621:   if (want) {
622:     const sun = sunLightOf(scene);
623: 
624:     // No rig to hang the cascades on yet: leave the option unapplied so the
625:     // next tick tries again instead of latching it as done.
626:     if (sun) runtime.csm = createCsm(scene, sun, tier, policy);
627:     else runtime.shadows = false;
628:   }
629: 
630:   invalidate(scene);
631: }
632: 
633: export function shadowsActive(): boolean {
634:   return runtime !== null && runtime.csm !== null;
635: }
