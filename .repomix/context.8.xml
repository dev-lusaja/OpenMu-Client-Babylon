40:   71: [{ kinds: ['fire1', 'fire2'], every: 3, light: [1, 0.6, 0.3] }],
41:   72: [{ kinds: ['smoke21'], every: 4 }],
42:   74: [{ kinds: ['smoke21'], every: 4, scale: 2 }],
43:   77: [{ kinds: ['cloud21'], every: 6, light: [0.04, 0.06, 0.03] }],
