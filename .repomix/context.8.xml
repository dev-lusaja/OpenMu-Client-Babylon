224: /** Icons per atlas row (the atlases are 200 px wide). */
225: const BUFF_ICONS_PER_ROW = 10;
226: /** Icons per atlas (200 × 224 px = 10 × 8 cells). */
227: const BUFF_ICONS_PER_ATLAS = 80;
228: /** First id of the second atlas (`eBuff_Berserker`). */
229: const BUFF_ATLAS2_FIRST = 81;
230: 
231: const BUFF_ATLASES = [
232:   'newui_statusicon.OZJ',
233:   'newui_statusicon2.OZJ',
234:   'newui_statusicon3.OZJ',
235: ];
