456: function itemName(data: DataView): string {
457:   try {
458:     const item = ItemSerializer.DeserializeItem(new Uint8Array(data.buffer));
459:     const name =
460:       itemBaseName(item.group, item.num) ||
461:       t('quest.itemFallback', { id: item.group * 512 + item.num });
462:     const level = item.lvl ? ` +${item.lvl}` : '';
463:     return `${name}${level}`;
464:   } catch {
465:     return t('quest.item');
466:   }
467: }
468: 
469: function monsterName(type: number): string {
470:   return monsterDisplayName(type);
471: }
472: 
473: /**
474:  * One condition of the packet as an objective record. The name is resolved
475:  * here rather than stored, so an open window follows a language change.
476:  */
477: function conditionRecord(c: {
478:   Type: number;
479:   RequirementId: number;
480:   RequiredCount: number;
481:   CurrentCount: number;
482:   RequiredItemData: DataView;
483: }): QuestObjective {
484:   const named =
485:     c.Type === ConditionTypeEnum.Item
486:       ? itemName(c.RequiredItemData)
487:       : c.Type === ConditionTypeEnum.MonsterKills || c.Type === ConditionTypeEnum.NpcTalk
488:         ? monsterName(c.RequirementId)
489:         : '';
490: 
491:   return {
492:     type: c.Type,
493:     id: c.RequirementId,
494:     required: c.RequiredCount,
495:     current: c.CurrentCount,
496:     name: named,
497:   };
498: }
499: 
500: /** `CQuestMng::GetRequestRewardText`: one text line per condition / reward. */
501: function describeCondition(objective: QuestObjective): QuestRequirementLine | null {
502:   const text = objectiveText(objective);
503:   return text === null ? null : { kind: 'request', done: objectiveDone(objective), text };
504: }
505: 
506: function describeReward(r: {
507:   Type: number;
508:   RewardId: number;
509:   RewardCount: number;
510:   RewardedItemData: DataView;
511: }): QuestRequirementLine | null {
512:   switch (r.Type) {
513:     case RewardTypeEnum.None:
514:       return null;
515:     case RewardTypeEnum.Experience:
516:       return {
517:         kind: 'reward',
518:         text: t('quest.reward.experience', { amount: r.RewardCount.toLocaleString() }),
519:       };
520:     case RewardTypeEnum.Money:
521:       return {
522:         kind: 'reward',
523:         text: t('quest.reward.money', { amount: r.RewardCount.toLocaleString() }),
524:       };
525:     case RewardTypeEnum.Item:
526:       return {
527:         kind: 'reward',
528:         text: t('quest.reward.item', {
529:           name: itemName(r.RewardedItemData),
530:           count: Math.max(1, r.RewardCount),
531:         }),
532:       };
533:     case RewardTypeEnum.GensContribution:
534:       return { kind: 'reward', text: t('quest.reward.gens', { amount: r.RewardCount }) };
535:     case RewardTypeEnum.Random:
536:       return { kind: 'header', text: t('quest.oneOf') };
537:     default:
538:       return {
539:         kind: 'reward',
540:         text: t('quest.reward.other', { type: r.Type, count: r.RewardCount }),
541:       };
542:   }
543: }
544: 
545: /** `SetQuestRequestReward`, drawn: headers through `t()`, monster names out of
546:  *  the language pack. Rebuilt on every read so both follow the selector. */
547: function requirementLines(objectives: QuestObjective[], rewardsRaw: RawReward[]): QuestRequirementLine[] {
548:   const lines: QuestRequirementLine[] = [];
549: 
550:   const conditions = objectives.map(describeCondition).filter((l): l is QuestRequirementLine => !!l);
551:   if (conditions.length) {
552:     lines.push({ kind: 'header', text: t('quest.requirements') });
553:     lines.push(...conditions);
554:   }
555: 
556:   const rewards = rewardsRaw.map(describeReward).filter((l): l is QuestRequirementLine => !!l);
557:   if (rewards.length) {
558:     lines.push({ kind: 'header', text: t('quest.rewards') });
559:     lines.push(...rewards);
560:   }
561: 
562:   return lines;
563: }
564: 
565: /** `SetQuestRequestReward`: cache what a `QuestProgress` / `QuestState` carried. */
566: function cacheProgress(key: number, conditions: RawCondition[], rewards: RawReward[]): void {
567:   const filled = conditions.filter(c => c.Type !== ConditionTypeEnum.None);
568:   const complete = filled.every(c => c.CurrentCount >= c.RequiredCount);
569:   const objectivesOf = () => filled.map(conditionRecord);
570: 
571:   runInAction(() => {
572:     state.progress.set(key, {
573:       key,
574:       complete,
575:       get objectives() {
576:         return objectivesOf();
577:       },
578:       get lines() {
579:         return requirementLines(objectivesOf(), rewards);
580:       },
581:     });
582:     if (!state.active.includes(key)) state.active.push(key);
583:   });
584: }
585: 
586: function storeProgress(p: QuestProgressPacket | QuestStatePacket): number {
587:   const key = questKey(p.QuestNumber, p.QuestGroup);
588:   cacheProgress(key, p.getConditions(), p.getRewards());
589:   return key;
590: }
591: 
592: function removeActive(key: number): void {
593:   requestedStates.delete(key);
594:   runInAction(() => {
595:     const i = state.active.indexOf(key);
596:     if (i >= 0) state.active.splice(i, 1);
597:     state.progress.delete(key);
598:     if (state.selectedKey === key) state.selectedKey = 0;
599:     if (state.currentKey === key) state.progressOpen = false;
600:   });
601: }
602: 
603: /** Quests whose conditions have already been asked for. */
604: const requestedStates = new Set<number>();
605: 
606: /**
607:  * `QuestStateList` names the running quests but carries no counts: the log
608:  * fetches those one quest at a time when a row is picked (`selectMyQuest`).
609:  * The tracker draws them all, so with it on the same request is sent once per
610:  * running quest. No new packet - it is the one the log's own list sends.
611:  */
612: reaction(
613:   () => (GameOptions.questTracker ? state.active.filter(key => !state.progress.has(key)) : []),
614:   keys => {
615:     for (const key of keys) {
616:       if (requestedStates.has(key)) continue;
617:       requestedStates.add(key);
618:       requestQuestState(key);
619:     }
620:   }
621: );
622: 
623: EventBus.on('AvailableQuests', packet => {
624:   const p = new AvailableQuestsPacket(packet);
625:   const available = p.getQuests().map(q => {
626:     const key = questKey(q.Number, q.Group);
627:     return {
628:       number: q.Number,
629:       group: q.Group,
630:       key,
631:       get subject() {
632:         return questSubject(key);
633:       },
634:     };
635:   });
636: 
637:   // `ProcessQuestListReceive`: while the S6 dialogue is up the list is drawn
638:   // inside it (npcDialogue.ts); the stand-alone list window is the fallback.
639:   const inDialogue = npcDialogueOpen();
640: 
641:   runInAction(() => {
642:     state.npcNumber = p.QuestNpcNumber;
643:     state.available = available;
644:     state.listOpen = !inDialogue && available.length > 0;
645:     state.busy = false;
646:   });
647: 
648:   if (inDialogue) return;
649:   if (available.length === 0) {
650:     Store.addNotification(t('quest.npcHasNone'), 'info');
651:     Store.dropNpcTalk();
652:   } else {
653:     playUiSound('window');
654:   }
655: });
656: 
657: // F6 03 - the answer to `EventQuestStateListRequest`; the original's
658: // handler is unknown / a no-op, so this only records that it came.
659: EventBus.on('QuestEventResponse', packet => {
660:   if (packet.byteLength < QuestEventResponsePacket.Length!) return;
661:   runInAction(() => {
662:     state.eventQuestsReceived = true;
663:   });
664: });
665: 
666: EventBus.on('QuestStepInfo', packet => {
667:   const p = new QuestStepInfoPacket(packet);
668: 
669:   if (p.QuestGroup === STEP_GROUP_UNAVAILABLE) {
670:     runInAction(() => {
671:       state.progressOpen = false;
672:       state.busy = false;
673:     });
674:     Store.addNotification(t(MSG_UNAVAILABLE), 'error');
675:     return;
676:   }
677: 
678:   const key = questKey(p.QuestStepNumber, p.QuestGroup);
679:   setProgressContents(key);
680:   runInAction(() => {
681:     state.listOpen = false;
682:     state.progressOpen = true;
683:   });
684:   playUiSound('window');
685: });
686: 
687: EventBus.on('QuestProgress', packet => {
688:   const p = new QuestProgressPacket(packet);
689:   const key = storeProgress(p);
690:   setProgressContents(key);
691:   runInAction(() => {
692:     state.mode = 'requestReward';
693:     state.listOpen = false;
694:     state.progressOpen = true;
695:   });
696: });
697: 
698: EventBus.on('QuestState', packet => {
699:   const p = new QuestStatePacket(packet);
700:   storeProgress(p);
701: });
702: 
703: EventBus.on('QuestCompletionResponse', packet => {
704:   const p = new QuestCompletionResponsePacket(packet);
705:   const key = questKey(p.QuestNumber, p.QuestGroup);
706: 
707:   runInAction(() => {
708:     state.busy = false;
709:   });
710: 
711:   if (p.IsQuestCompleted) {
712:     removeActive(key);
713:     runInAction(() => {
714:       state.progressOpen = false;
715:     });
716:     Store.addNotification(
717:       t('quest.completedNamed', { subject: questSubject(key) }),
718:       'info'
719:     );
720:     playUiSound('levelUp');
721:   } else {
722:     Store.addNotification(t(MSG_NOT_FULFILLED), 'error');
723:   }
724: });
725: 
726: EventBus.on('QuestCancelled', packet => {
727:   const p = new QuestCancelledPacket(packet);
728:   removeActive(questKey(p.QuestNumber, p.QuestGroup));
729: });
730: 
731: EventBus.on('QuestStateList', packet => {
732:   const p = new QuestStateListPacket(packet);
733:   const keys = p.getQuests().map(q => questKey(q.Number, q.Group));
734:   runInAction(() => {
735:     state.active = keys;
736:     for (const key of [...state.progress.keys()]) if (!keys.includes(key)) state.progress.delete(key);
737:     if (!keys.includes(state.selectedKey)) state.selectedKey = 0;
738:   });
739: });
740: 
741: EventBus.on('CharacterInformation', () => {
742:   requestedStates.clear();
743:   runInAction(() => {
744:     state.active = [];
745:     state.progress.clear();
746:     state.available = [];
747:     state.listOpen = false;
748:     state.progressOpen = false;
749:     state.myQuestOpen = false;
750:     state.selectedKey = 0;
751:     state.busy = false;
752:   });
753:   requestActiveQuests();
754: });
755: 
756: /** Used by the facade when the inventory is full on completion (`GlobalText[375]`). */
757: export function questInventoryFullMessage(): string {
758:   return t(MSG_INVENTORY_FULL);
759: }
760: 
761: function reset(): void {
762:   runInAction(() => {
763:     state.listOpen = false;
764:     state.progressOpen = false;
765:     state.busy = false;
766:   });
767: }
768: 
769: // ---- the offline dev seam ----------------------------------------------------
770: 
771: /** `?quests=<n>`: how many staged quests the offline client pretends to run. */
772: const DEV_STAGED_MAX = 4;
773: 
774: /** Kills staged per quest: enough, one short, and the last one finished. */
775: const DEV_STAGED_KILLS: readonly { monster: number; current: number; required: number }[][] = [
776:   [
777:     { monster: 3, current: 7, required: 10 },
778:     { monster: 6, current: 3, required: 5 },
779:   ],
780:   [{ monster: 14, current: 15, required: 15 }],
781:   [{ monster: 2, current: 0, required: 20 }],
782:   [{ monster: 20, current: 4, required: 8 }],
783: ];
784: 
785: let devStaged = false;
786: 
787: /**
788:  * Offline only (`?quests=<n>`): fill the log with running quests taken from
789:  * `QuestProgress.bmd`, so the tracker and the quest window can be looked at
790:  * without a server. `devQueryNumber` answers null in a production build, so
791:  * this can never stage anything a player would see.
792:  */
793: function stageDevQuests(): void {
794:   if (devStaged) return;
795: 
796:   const count = devQueryNumber('quests');
797:   if (count === null || count <= 0 || !questDataReady()) return;
798:   devStaged = true;
799: 
800:   const named = questProgressKeys().filter(key => {
801:     const entry = questProgressEntry(key);
802:     return !!entry && !!questWords(entry.subject);
803:   });
804: 
805:   named.slice(0, Math.min(count, DEV_STAGED_MAX)).forEach((key, i) => {
806:     const conditions = (DEV_STAGED_KILLS[i] ?? []).map(kill => ({
807:       Type: ConditionTypeEnum.MonsterKills as number,
808:       RequirementId: kill.monster,
809:       RequiredCount: kill.required,
810:       CurrentCount: kill.current,
811:       RequiredItemData: new DataView(new ArrayBuffer(0)),
812:     }));
813:     cacheProgress(key, conditions, []);
814:   });
815: }
816: 
817: function update(_map: ENUM_WORLD, _dt: number): void {
818:   // Titles resolve lazily once the tables are in; nothing ticks here.
819:   stageDevQuests();
820: }
821: 
822: // ---- 3. the layer ----------------------------------------------------------
823: 
824: export const questLogLayer: QuestLayer = { name: 'questLog', update, reset };
</file>

<file path="src/scenes/materialDebug.ts">
 1: import type { Scene } from '../libs/babylon/exports';
 2: import { GameOptions } from '../common/gameOptions';
 3: import { t } from '../i18n';
 4: import {
 5:   MATERIAL_QUALITY_LABEL_KEYS,
 6:   materialQuality,
 7:   pbrDetailStrength,
 8: } from '../common/materialQuality';
 9: import { livePbrMaterials } from '../common/itemMaterial';
10: import { liveTileArrays } from '../libs/mu/tileTextureArray';
11: 
12: /**
13:  * `muMat()` in the browser console: what the Materials/Detail options are
14:  * actually doing to the live scene, rather than what they are supposed to do.
15:  *
16:  * Exists because three rounds of Classic-vs-Enhanced work landed no visible
17:  * change, and the difference between "the option is wired wrong" and "the
18:  * option is wired right but pulls on the wrong thing" is not answerable by
19:  * reading the source. The last one of these was settled the same
20:  * way - by measuring instead of reasoning.
21:  */
22: export function installMaterialDebug(scene: Scene): void {
23:   (globalThis as Record<string, unknown>).muMat = () => {
24:     const tier = materialQuality();
25: 
26:     const materials = livePbrMaterials().map(m => ({
27:       name: m.name,
28:       metallic: m.metallic,
29:       roughness: m.roughness,
30:       specularIntensity: m.specularIntensity,
31:       bumpLevel: m.bumpTexture?.level ?? null,
32:       frozen: m.isFrozen,
33:     }));
34: 
35:     // Which material each drawn mesh actually ended up on, and whether it
36:     // carries the character flag `pbrCovers` routes on.
37:     const census = new Map<string, number>();
38:     let flagged = 0;
39:     let missingFlag = 0;
40: 
41:     for (const mesh of scene.meshes) {
42:       if (!mesh.isEnabled() || !mesh.material) continue;
43: 
44:       const key = mesh.material.name || mesh.material.getClassName();
45:       census.set(key, (census.get(key) ?? 0) + 1);
46: 
47:       if (mesh.metadata?.characterAsset === true) flagged++;
48:       else if (mesh.metadata?.characterAsset === undefined) missingFlag++;
49:     }
50: 
51:     const tiles = liveTileArrays().map(t => ({
52:       name: t.name,
53:       samplingMode: t.samplingMode,
54:       anisotropy: t.anisotropicFilteringLevel,
55:     }));
56: 
57:     const report = {
58:       option: {
59:         materialQuality: GameOptions.materialQuality,
60:         tier: t(MATERIAL_QUALITY_LABEL_KEYS[tier]),
61:         materialDetail: GameOptions.materialDetail,
62:         detailStrength: pbrDetailStrength(),
63:         lightingQuality: GameOptions.lightingQuality,
64:       },
65:       pbrMaterials: materials,
66:       tileArrays: tiles,
67:       meshes: {
68:         total: scene.meshes.length,
69:         withCharacterFlag: flagged,
70:         withoutCharacterFlagField: missingFlag,
71:       },
72:       materialCensus: [...census.entries()].sort((a, b) => b[1] - a[1]),
73:     };
74: 
75:     console.log(JSON.stringify(report, null, 2));
76:     return report;
77:   };
78: 
79:   console.log('[mu] material debug ready - run muMat() in the console');
80: }
</file>

<file path="src/scenes/postChain.ts">
  1: import {
  2:   ColorCurves,
  3:   DefaultRenderingPipeline,
  4:   ImageProcessingConfiguration,
  5:   type ArcRotateCamera,
  6:   type Scene,
  7: } from '../libs/babylon/exports';
  8: import { GameOptions } from '../common/gameOptions';
  9: import { pipelineSamples } from '../common/lightingQuality';
 10: import { toneMapLive } from './toneMap';
 11: import type { Rgb } from '../lighting/profiles';
 12: 
 13: /**
 14:  * The post chain (ARCHITECTURE §4.8): sole writer of the
 15:  * `DefaultRenderingPipeline` and of `scene.imageProcessingConfiguration`.
 16:  *
 17:  * bloom -> exposure -> tone mapper -> white balance -> decoration -> FXAA.
 18:  * SSAO and the haze run ahead of it in their own owners; `moveToEnd` keeps
 19:  * this pipeline last after they rebuild.
 20:  *
 21:  * The image-processing *values* are written on every call, neutral when a
 22:  * pass is off: the configuration is the scene's, and the PBR material
 23:  * composes image processing in its own fragment whenever the pass is not
 24:  * doing it, so a stale value would move onto the materials instead of
 25:  * disappearing.
 26:  */
 27: 
 28: /** What the post chain needs from the look; the director hands it over. */
 29: export type PostLook = {
 30:   /** Enhanced/Ultra: the grade runs. Classic: no image-processing pass at all. */
 31:   readonly shaped: boolean;
 32:   /** The viewer's brightness trim, `2^(brightness/10)`; the map's level is in the key. */
 33:   readonly exposure: number;
 34:   /** 0 none / 1 standard / 2 aces / 3 neutral. */
 35:   readonly toneMapper: number;
 36:   readonly whiteBalance: Rgb;
 37: };
 38: 
 39: const SLIDER_MAX = 9;
 40: 
 41: const SHARPEN_MAX_EDGE_AMOUNT = 0.4;
 42: 
 43: const GRAIN_INTENSITY = 4;
 44: 
 45: /** Chromatic aberration at the top slider notch. */
 46: const CHROMATIC_MAX = 12;
 47: 
 48: /** Multiply vignette weight at the top slider notch. */
 49: const VIGNETTE_MAX_WEIGHT = 1.2;
 50: 
 51: /**
 52:  * Bloom picks up only what exceeds scene white in the linear buffer: the
 53:  * key is normalised so an up-facing surface takes 1.0, so nothing lit by it
 54:  * blooms and emitters and torch cores do.
 55:  */
 56: export const BLOOM_THRESHOLD = 1.0;
 57: 
 58: /**
 59:  * With the MU curve live the buffer reaching bloom is already rolled into
 60:  * [0, 1], so scene white is no longer 1.0: an emitter core lands near 0.95
 61:  * and lit ground near 0.35. The threshold moves with the curve so bloom
 62:  * still picks up emitters and nothing else.
 63:  */
 64: const BLOOM_THRESHOLD_TONED = 0.85;
 65: 
 66: const BLOOM_KERNEL = 48;
 67: const BLOOM_MAX_WEIGHT = 0.6;
 68: 
 69: const TONE_MAPPING_TYPES: readonly number[] = [
 70:   ImageProcessingConfiguration.TONEMAPPING_STANDARD,
 71:   ImageProcessingConfiguration.TONEMAPPING_STANDARD,
 72:   ImageProcessingConfiguration.TONEMAPPING_ACES,
 73:   ImageProcessingConfiguration.TONEMAPPING_KHR_PBR_NEUTRAL,
 74: ];
 75: 
 76: export const TONE_MAPPER_NAMES = ['none', 'standard', 'aces', 'neutral'] as const;
 77: 
 78: export type ToneMapperName = (typeof TONE_MAPPER_NAMES)[number];
 79: 
 80: const PIPELINE_NAME = 'postChain';
 81: 
 82: /**
 83:  * A per-channel multiplier as Babylon colour curves. The curves' global term
 84:  * is `2 x HSB(hue, s, v)` with the slider values squared, so any multiplier
 85:  * whose peak channel is at least 1 has an exact (hue, density, exposure)
 86:  * triple; the balance is normalised to unit Rec709 luma first so it moves
 87:  * tint and never level. Returns false for a neutral balance.
 88:  */
 89: function whiteBalanceToCurves(curves: ColorCurves, wb: Rgb): boolean {
 90:   const luma = 0.2126 * wb[0] + 0.7152 * wb[1] + 0.0722 * wb[2];
 91:   const r = wb[0] / luma;
 92:   const g = wb[1] / luma;
 93:   const b = wb[2] / luma;
 94: 
 95:   const max = Math.max(r, g, b);
 96:   const min = Math.min(r, g, b);
 97: 
 98:   if (max - min < 1e-4) return false;
 99: 
100:   const exposure = 100 * Math.sqrt(Math.max(0, (max - 1) / 0.5));
101:   const density = Math.min(100, 100 * Math.sqrt(2 * (1 - min / max)));
102: 
103:   const d = max - min;
104:   let hue: number;
105:   if (max === r) hue = ((g - b) / d) % 6;
106:   else if (max === g) hue = (b - r) / d + 2;
107:   else hue = (r - g) / d + 4;
108:   hue *= 60;
109:   if (hue < 0) hue += 360;
110: 
111:   curves.globalHue = hue;
112:   curves.globalDensity = density;
113:   curves.globalExposure = exposure;
114:   curves.globalSaturation = 0;
115: 
116:   return true;
117: }
118: 
119: export type PostChain = {
120:   readonly pipeline: DefaultRenderingPipeline;
121:   set(look: PostLook): void;
122:   /** Re-attach behind whatever else was attached to the camera since. */
123:   moveToEnd(): void;
124:   /** Names of the passes live right now, in chain order. */
125:   passes(): string[];
126: };
127: 
128: export function createPostChain(
129:   scene: Scene,
130:   camera: ArcRotateCamera
131: ): PostChain {
132:   const pipeline = new DefaultRenderingPipeline(PIPELINE_NAME, true, scene, [
133:     camera,
134:   ]);
135: 
136:   // Every pass is driven by an option in `set`; the pipeline starts with all
137:   // of them off so nothing runs that no slider asked for.
138:   pipeline.fxaaEnabled = false;
139:   pipeline.samples = pipelineSamples();
140:   pipeline.bloomEnabled = false;
141:   pipeline.bloomScale = 0.5;
142:   pipeline.bloomKernel = BLOOM_KERNEL;
143:   pipeline.chromaticAberrationEnabled = false;
144:   pipeline.imageProcessingEnabled = false;
145:   pipeline.sharpen.colorAmount = 1;
146:   pipeline.grain.animated = true;
147: 
148:   const curves = new ColorCurves();
149: 
150:   const live: string[] = [];
151: 
152:   const set = (look: PostLook): void => {
153:     const post = GameOptions.postProcessing;
154:     const shaped = look.shaped;
155: 
156:     live.length = 0;
157: 
158:     pipeline.samples = pipelineSamples();
159: 
160:     // No image-processing pass on Classic (§3.1, K1): with it the buffer goes
161:     // linear and the blobs and effect cards blend there, lifting every dark
162:     // pixel; without it the terrain and the materials encode themselves and
163:     // the frame is post-off plus sharpen and glow. With post off the pass is
164:     // bypassed outright on every tier: an identity pass is still a resolve.
165:     const graded = post && shaped;
166: 
167:     // The MU curve (scenes/toneMap.ts) runs ahead of this pipeline and owns
168:     // the exposure and the tone mapping when it is live; the pass here then
169:     // does the white balance and the decoration only.
170:     const filmic = graded && toneMapLive();
171: 
172:     // Bloom samples the linear buffer before exposure. Off on Classic (§6).
173:     const bloom = graded ? Math.max(0, GameOptions.bloom) : 0;
174: 
175:     pipeline.bloomEnabled = bloom > 0;
176:     pipeline.bloomThreshold = filmic ? BLOOM_THRESHOLD_TONED : BLOOM_THRESHOLD;
177:     pipeline.bloomWeight = (bloom / SLIDER_MAX) * BLOOM_MAX_WEIGHT;
178:     pipeline.bloomKernel = BLOOM_KERNEL;
179:     if (bloom > 0) live.push('bloom');
180: 
181:     pipeline.imageProcessingEnabled = graded;
182: 
183:     const ip = scene.imageProcessingConfiguration;
184: 
185:     const exposure = graded && !filmic ? look.exposure : 1;
186:     ip.exposure = exposure;
187:     if (exposure !== 1) live.push('exposure');
188: 
189:     const toneMapper = graded && !filmic ? look.toneMapper : 0;
190:     ip.toneMappingEnabled = toneMapper > 0;
191:     ip.toneMappingType = TONE_MAPPING_TYPES[toneMapper];
192:     if (toneMapper > 0) live.push(`toneMapper:${TONE_MAPPER_NAMES[toneMapper]}`);
193:     if (filmic) live.push('toneMapper:mu');
194: 
195:     ip.contrast = 1;
196: 
197:     const balanced = graded && whiteBalanceToCurves(curves, look.whiteBalance);
198:     ip.colorCurves = curves;
199:     ip.colorCurvesEnabled = balanced;
200:     if (balanced) live.push('whiteBalance');
201: 
202:     const vignette = graded ? Math.max(0, GameOptions.vignette) : 0;
203:     ip.vignetteEnabled = vignette > 0;
204:     ip.vignetteWeight = (vignette / SLIDER_MAX) * VIGNETTE_MAX_WEIGHT;
205:     ip.vignetteBlendMode = ImageProcessingConfiguration.VIGNETTEMODE_MULTIPLY;
206:     ip.vignetteColor.set(0, 0, 0, 0);
207:     // The live fov: the camera runs at 30 deg while the pipeline's default
208:     // is 0.8 rad, and the falloff is computed against it.
209:     ip.vignetteCameraFov = camera.fov;
210:     if (vignette > 0) live.push('vignette');
211: 
212:     const sharpness = post ? Math.max(0, GameOptions.sharpness) : 0;
213:     pipeline.sharpenEnabled = sharpness > 0;
214:     pipeline.sharpen.edgeAmount = (sharpness / SLIDER_MAX) * SHARPEN_MAX_EDGE_AMOUNT;
215:     if (sharpness > 0) live.push('sharpen');
216: 
217:     const grain = graded ? Math.max(0, GameOptions.filmGrain) : 0;
218:     pipeline.grainEnabled = grain > 0;
219:     pipeline.grain.intensity = (grain / SLIDER_MAX) * GRAIN_INTENSITY;
220:     if (grain > 0) live.push('grain');
221: 
222:     const chromatic = graded ? Math.max(0, GameOptions.chromatic) : 0;
223:     pipeline.chromaticAberrationEnabled = chromatic > 0;
224:     pipeline.chromaticAberration.aberrationAmount =
225:       (chromatic / SLIDER_MAX) * CHROMATIC_MAX;
226:     if (chromatic > 0) live.push('chromatic');
227: 
228:     pipeline.fxaaEnabled = post && GameOptions.fxaa;
229:     if (pipeline.fxaaEnabled) live.push('fxaa');
230:   };
231: 
232:   const moveToEnd = (): void => {
233:     const manager = scene.postProcessRenderPipelineManager;
234: 
235:     if (manager.supportedPipelines.some(p => p.name === PIPELINE_NAME)) {
236:       manager.detachCamerasFromRenderPipeline(PIPELINE_NAME, camera);
237:       manager.attachCamerasToRenderPipeline(PIPELINE_NAME, camera);
238:     }
239:   };
240: 
241:   return { pipeline, set, moveToEnd, passes: () => [...live] };
242: }
</file>

<file path="src/scenes/renderList.ts">
  1: import type {
  2:   AbstractMesh,
  3:   Observer,
  4:   RenderTargetTexture,
  5:   Scene,
  6: } from '../libs/babylon/exports';
  7: 
  8: /**
  9:  * A render list filled from a predicate without Babylon's per-frame dirty
 10:  * storm.
 11:  *
 12:  * Babylon's own `renderListPredicate` rebuilds the list every frame by
 13:  * setting its length to zero and pushing every match, and it observes the
 14:  * array: on every transition between empty and non-empty it marks the
 15:  * lighting defines of *every mesh in the scene* dirty, because a shadow
 16:  * map's caster set changing is what can turn a light's shadows on or off.
 17:  * Emptying and refilling is two such transitions per pass per frame - the
 18:  * cascades, the G-buffer and the effect mask were re-dirtying 1 500 meshes
 19:  * six times a frame, and every material then re-checked its defines on the
 20:  * next draw. Measured at ~2 ms of a 19 ms Noria frame.
 21:  *
 22:  * This fills the same list in place by index, which the observer does not
 23:  * see, and raises the one notification that matters itself: when a list
 24:  * really goes from empty to holding something, or back.
 25:  */
 26: type Driven = {
 27:   readonly rt: RenderTargetTexture;
 28:   predicate: (mesh: AbstractMesh) => boolean;
 29:   readonly list: AbstractMesh[];
 30:   wasEmpty: boolean;
 31:   release: () => void;
 32: };
 33: 
 34: type SceneDrivers = {
 35:   driven: Driven[];
 36:   frame: number;
 37:   observer: Observer<Scene>;
 38: };
 39: 
 40: const drivers = new WeakMap<Scene, SceneDrivers>();
 41: 
 42: function fill(scene: Scene, d: Driven): void {
 43:   const meshes = scene.meshes;
 44:   const list = d.list;
 45:   let n = 0;
 46: 
 47:   for (let i = 0; i < meshes.length; i++) {
 48:     const mesh = meshes[i];
 49:     if (d.predicate(mesh)) list[n++] = mesh;
 50:   }
 51: 
 52:   list.length = n;
 53: 
 54:   const empty = n === 0;
 55: 
 56:   if (empty !== d.wasEmpty) {
 57:     d.wasEmpty = empty;
 58:     for (const mesh of meshes) {
 59:       (mesh as unknown as { _markSubMeshesAsLightDirty(): void })
 60:         ._markSubMeshesAsLightDirty();
 61:     }
 62:   }
 63: }
 64: 
 65: function driversFor(scene: Scene): SceneDrivers {
 66:   let entry = drivers.get(scene);
 67:   if (entry) return entry;
 68: 
 69:   const created: SceneDrivers = {
 70:     driven: [],
 71:     frame: -1,
 72:     observer: null as unknown as Observer<Scene>,
 73:   };
 74: 
 75:   // Fires before the custom targets in `render()` and again before each
 76:   // camera's own targets; one fill per frame serves both.
 77:   created.observer = scene.onBeforeRenderTargetsRenderObservable.add(() => {
 78:     const frame = scene.getFrameId();
 79:     if (frame === created.frame) return;
 80:     created.frame = frame;
 81: 
 82:     for (const d of created.driven) fill(scene, d);
 83:   });
 84: 
 85:   drivers.set(scene, created);
 86:   return created;
 87: }
 88: 
 89: /**
 90:  * Takes over `rt`'s render list: cleared of its predicate, given a list this
 91:  * module keeps filled. Returns the release, which also runs when the target
 92:  * is disposed.
 93:  */
 94: export function driveRenderList(
 95:   scene: Scene,
 96:   rt: RenderTargetTexture,
 97:   predicate: (mesh: AbstractMesh) => boolean
 98: ): () => void {
 99:   const entry = driversFor(scene);
100: 
101:   // Typed non-nullable, checked for truthiness at runtime (objectRenderer.js).
102:   (rt as unknown as { renderListPredicate: null }).renderListPredicate = null;
103: 
104:   // One driver per target, whatever the caller does. Stacking a second one
105:   // added a second sweep of every mesh in the scene to every frame, and only
106:   // the last list was ever drawn - so the extra sweeps were pure cost with
107:   // nothing to show for them. The cascades re-hook their map whenever the
108:   // caster set is re-chosen, which is once a frame while a room is the active
109:   // area, so an interior grew one dead sweep per frame for as long as the hero
110:   // stood in it.
111:   const existing = entry.driven.find(d => d.rt === rt);
112: 
113:   if (existing) {
114:     existing.predicate = predicate;
115:     rt.renderList = existing.list;
116: 
117:     return existing.release;
118:   }
119: 
120:   const d: Driven = {
121:     rt,
122:     predicate,
123:     list: [],
124:     wasEmpty: true,
125:     release: () => {},
126:   };
127: 
128:   d.release = () => {
129:     const index = entry.driven.indexOf(d);
130:     if (index >= 0) entry.driven.splice(index, 1);
131:     if (rt.renderList === d.list) rt.renderList = null;
132:   };
133: 
134:   rt.renderList = d.list;
135:   entry.driven.push(d);
136:   rt.onDisposeObservable.addOnce(d.release);
137: 
138:   return d.release;
139: }
</file>

<file path="src/scenes/roomMask.ts">
  1: import {
  2:   Constants,
  3:   Material,
  4:   PostProcess,
  5:   RawTexture,
  6:   ShaderStore,
  7:   SmartArray,
  8:   Texture,
  9:   Vector3,
 10:   type ArcRotateCamera,
 11:   type BaseTexture,
 12:   type DepthRenderer,
 13:   type RenderTargetTexture,
 14:   type Scene,
 15:   type SubMesh,
 16: } from '../libs/babylon/exports';
 17: import { devQuery } from '../common/devSeams';
 18: import { EFFECT_MASK_SAMPLER, effectMask } from './ambientOcclusion';
 19: import type { LightingTier } from '../common/lightingQuality';
 20: import type { RoomVolume } from '../lighting/profiles';
 21: 
 22: /**
 23:  * The room mask (ARCHITECTURE §13 F8): the one writer of "outside the room is
 24:  * black". One post pass on tiers >= 1 while an area with a volume is active,
 25:  * after the haze and before the post chain, whatever the post-processing
 26:  * option says. Per pixel the world position comes back from the shared depth
 27:  * and is drawn iff it lies inside the room volume (the floor between the inner
 28:  * wall faces, up to the roof underside) or the segment from the camera to it
 29:  * leaves the wall box (the same floor, up to the wall top) through one of its
 30:  * four sides: that is a view through a door or a window, and a solid wall
 31:  * would have stopped the ray. The two faces that stop nothing are the roof,
 32:  * which is lifted out of the way while the hero is inside, and the floor,
 33:  * which is one-sided and writes no depth from below - so a ray over the wall
 34:  * top reaches the world outside and a ray up through the ground reaches all
 35:  * of it, and neither is an opening. Hence the two asymmetries: only the exit
 36:  * face has to be a wall (a camera above may drop its rays in through the
 37:  * missing roof), and a camera below the floor gets no crossing at all. The
 38:  * box stops at the inner faces, so a wall's outer face and its top lie
 39:  * outside and go black with the exterior. Cards that write no depth take the
 40:  * depth behind them, so a flame over the floor stays and a torch outside the
 41:  * walls goes with the exterior behind it.
 42:  *
 43:  * The depth is the pass's own renderer, enabled for the camera while a room
 44:  * is active and released when the area ends, storing camera-space z. Not the
 45:  * G-buffer: that one refuses a map object's alpha-keyed cards on purpose, and
 46:  * a tavern's barrels, stools and racks are all of them.
 47:  *
 48:  * Dev seam: `?roomMask=0` never builds the pass.
 49:  */
 50: 
 51: const SHADER = 'muRoomMask';
 52: 
 53: /** Slack under the floor for uneven ground and the terrain's own relief. */
 54: const FLOOR_SLACK = 1.0;
 55: /**
 56:  * Slack past the inner wall faces for the inside test, tiles: the depth's
 57:  * reconstruction error on a face that sits on the box, no more. The walls
 58:  * are 0.35-0.5 thick, so their outer half and their top stay outside.
 59:  */
 60: const FACE_SLACK = 0.02;
 61: 
 62: /**
 63:  * Effect-mask value above which a depth-less pixel counts as an emitter
 64:  * rather than as the void. The mask is half resolution, so a one-pixel flame
 65:  * edge lands in it faint; the void is a hard zero, so the line can sit low.
 66:  */
 67: const EMIT_LIT = 0.002;
 68: 
 69: /**
 70:  * How far a depth-less pixel's ray is carried before asking whether it left
 71:  * through a wall. The sky is at infinity and the room box is tens of tiles,
 72:  * so anything past the map is the same answer; this is simply well past it.
 73:  */
 74: const SKY_REACH = 10000;
 75: 
 76: /** Drawn depth renders to wait for before the mask is allowed to black anything. */
 77: const READY_FRAMES = 2;
 78: 
 79: type Runtime = {
 80:   scene: Scene;
 81:   camera: ArcRotateCamera;
 82:   pass: PostProcess;
 83:   /** The depth renderer this pass enabled itself, to release when the room ends. */
 84:   ownDepth: DepthRenderer | null;
 85: };
 86: 
 87: let runtime: Runtime | null = null;
 88: 
 89: let shown: RoomVolume | null = null;
 90: 
 91: const forcedOff = devQuery('roomMask') === '0';
 92: 
 93: function registerShader(): void {
 94:   if (ShaderStore.ShadersStore[`${SHADER}FragmentShader`]) return;
 95: 
 96:   ShaderStore.ShadersStore[`${SHADER}FragmentShader`] = `
 97:   precision highp float;
 98:   varying vec2 vUV;
 99:   uniform sampler2D textureSampler;
100:   uniform sampler2D depthSampler;
101:   uniform sampler2D ${EFFECT_MASK_SAMPLER};
102:   uniform mat4 invView;
103:   uniform vec2 viewport;  // tan(fov/2) * aspect, tan(fov/2)
104:   uniform vec4 roomXZ;    // minX, minZ, maxX, maxZ
105:   uniform vec3 roomY;     // floor, wall top, roof underside
106:   uniform vec4 roomBox;   // the room's screen footprint in UV: minU, minV, maxU, maxV
107:   uniform float ready;    // 0 until the depth map holds a rendered frame
108: 
109:   const float FLOOR_SLACK = ${FLOOR_SLACK.toFixed(2)};
110:   const float FACE_SLACK = ${FACE_SLACK.toFixed(3)};
111:   const float EMIT_LIT = ${EMIT_LIT.toFixed(4)};
112: 
113:   // Segment from o to o + d against the box, true only where it leaves
114:   // through a wall. Where it comes in is not the question: the roof is out of
115:   // the way while the hero is inside, so a ray dropping into the room from
116:   // the camera above is the view the mask exists to serve. What it reaches on
117:   // the way out is: a door and a window are holes in a wall, and a ray that
118:   // leaves over the wall top or down through the floor has left the room for
119:   // the world outside, which is what goes black.
120:   bool leavesThroughWall(vec3 o, vec3 d, vec3 bmin, vec3 bmax) {
121:     vec3 inv = 1.0 / (abs(d) + vec3(1e-6)) * sign(d + vec3(1e-9));
122:     vec3 t0 = (bmin - o) * inv;
123:     vec3 t1 = (bmax - o) * inv;
124:     vec3 tn = min(t0, t1);
125:     vec3 tf = max(t0, t1);
126:     float tEnter = max(max(tn.x, tn.y), tn.z);
127:     float tExit = min(min(tf.x, tf.y), tf.z);
128: 
129:     if (tExit < max(tEnter, 0.0) || tEnter > 1.0) return false;
130: 
131:     // The pixel is in the box: the segment never left it.
132:     if (tExit >= 1.0) return true;
133: 
134:     // Y crossed last on the way out is the wall top or the floor.
135:     return tf.y > min(tf.x, tf.z);
136:   }
137: 
138:   void main(void) {
139:     vec4 color = texture2D(textureSampler, vUV);
140: 
141:     if (ready < 0.5) {
142:       gl_FragColor = color;
143:       return;
144:     }
145: 
146:     float depth = texture2D(depthSampler, vUV).r;
147: 
148:     vec3 viewDir = vec3((vUV.x * 2.0 - 1.0) * viewport.x, (vUV.y * 2.0 - 1.0) * viewport.y, 1.0);
149:     vec3 camPos = invView[3].xyz;
150:     vec3 worldDir =
151:       invView[0].xyz * viewDir.x +
152:       invView[1].xyz * viewDir.y +
153:       invView[2].xyz * viewDir.z;
154: 
155:     vec3 volMin = vec3(roomXZ.x, roomY.x - FLOOR_SLACK, roomXZ.y);
156:     vec3 volMax = vec3(roomXZ.z, roomY.z, roomXZ.w);
157:     vec3 wallMax = vec3(roomXZ.z, roomY.y, roomXZ.w);
158: 
159:     // The see-through test rests on "a solid wall would have stopped the ray",
160:     // and under the floor nothing does: the ground is one-sided, so seen from
161:     // below it writes no depth. Below the floor the inside test stands alone.
162:     bool underFloor = camPos.y < volMin.y;
163: 
164:     // The renderer clears to 1e8 where nothing was drawn, so both ends are
165:     // "no depth here".
166:     if (depth <= 0.0 || depth >= 1e7) {
167:       // No depth here, and that is not the same as "outside". Additive
168:       // geometry writes none, so a candle's own flame quads, a lamp glass and
169:       // a hearth's glow were being blacked inside the room they belong to.
170:       // The effect mask is the one buffer that does hold them: an emitter
171:       // pixel inside the room's screen footprint is the room's own and stays.
172:       vec3 emit = texture2D(${EFFECT_MASK_SAMPLER}, vUV).rgb;
173:       float lit = max(emit.r, max(emit.g, emit.b));
174:       bool framed = all(greaterThanEqual(vUV, roomBox.xy))
175:         && all(lessThanEqual(vUV, roomBox.zw));
176: 
177:       // The other thing that writes no depth is the sky, and it was going
178:       // black with everything else - so a doorway framed a black hole where
179:       // the day should be. A sky pixel is not "nothing", it is a point at
180:       // infinity, and the question to ask about it is the same one asked
181:       // about every other pixel: does the ray reach it through a wall?
182:       // Through a door or a window it does and the sky belongs there; over
183:       // the wall top it does not, which is the roof the hero is standing
184:       // under and stays black.
185:       bool skyThroughWall =
186:         !underFloor && leavesThroughWall(camPos, worldDir * ${SKY_REACH.toFixed(1)}, volMin, wallMax);
187: 
188:       gl_FragColor = (lit > EMIT_LIT && framed) || skyThroughWall
189:         ? color
190:         : vec4(0.0, 0.0, 0.0, color.a);
191:       return;
192:     }
193: 
194:     vec3 toPixel = worldDir * depth;
195:     vec3 p = camPos + toPixel;
196: 
197:     vec3 faceSlack = vec3(FACE_SLACK, 0.0, FACE_SLACK);
198:     bool inside = all(greaterThanEqual(p, volMin - faceSlack)) && all(lessThanEqual(p, volMax + faceSlack));
199: 
200:     bool seenThrough =
201:       inside || (!underFloor && leavesThroughWall(camPos, toPixel, volMin, wallMax));
202: 
203:     gl_FragColor = seenThrough ? color : vec4(0.0, 0.0, 0.0, color.a);
204:   }
205:   `;
206: }
207: 
208: const box: [number, number, number, number] = [1, 1, 0, 0];
209: 
210: const corner = new Vector3();
211: const viewed = new Vector3();
212: const projected = new Vector3();
213: 
214: /** Slack around the room's screen footprint: a glow halo reaches past its mesh. */
215: const BOX_MARGIN = 0.03;
216: 
217: /**
218:  * The room's volume as a screen-space box in UV, for the depth-less branch.
219:  * An empty box while there is no mask to read, and the whole screen whenever
220:  * a corner sits at or behind the camera plane: a wrong box would delete the
221:  * room's own emitters, which is the failure this branch exists to prevent.
222:  */
223: function screenBoxOf(
224:   volume: RoomVolume,
225:   scene: Scene,
226:   camera: ArcRotateCamera,
227:   live: boolean,
228:   out: [number, number, number, number]
229: ): void {
230:   if (!live) {
231:     out[0] = 1;
232:     out[1] = 1;
233:     out[2] = 0;
234:     out[3] = 0;
235:     return;
236:   }
237: 
238:   const view = camera.getViewMatrix();
239:   const transform = scene.getTransformMatrix();
240: 
241:   let minU = 1;
242:   let minV = 1;
243:   let maxU = 0;
244:   let maxV = 0;
245: 
246:   for (let i = 0; i < 8; i++) {
247:     corner.set(
248:       i & 1 ? volume.maxX : volume.minX,
249:       i & 2 ? volume.roofY : volume.floorY - FLOOR_SLACK,
250:       i & 4 ? volume.maxY : volume.minY
251:     );
252: 
253:     Vector3.TransformCoordinatesToRef(corner, view, viewed);
254: 
255:     if (viewed.z <= 0.1) {
256:       out[0] = 0;
257:       out[1] = 0;
258:       out[2] = 1;
259:       out[3] = 1;
260:       return;
261:     }
262: 
263:     Vector3.TransformCoordinatesToRef(corner, transform, projected);
264: 
265:     const u = projected.x * 0.5 + 0.5;
266:     const v = projected.y * 0.5 + 0.5;
267: 
268:     minU = Math.min(minU, u);
269:     minV = Math.min(minV, v);
270:     maxU = Math.max(maxU, u);
271:     maxV = Math.max(maxV, v);
272:   }
273: 
274:   out[0] = minU - BOX_MARGIN;
275:   out[1] = minV - BOX_MARGIN;
276:   out[2] = maxU + BOX_MARGIN;
277:   out[3] = maxV + BOX_MARGIN;
278: }
279: 
280: let dark: RawTexture | null = null;
281: 
282: /** Stand-in for the effect mask when there is none: every pixel reads unlit. */
283: function darkFallback(scene: Scene): RawTexture {
284:   if (dark && dark.getScene() === scene) return dark;
285: 
286:   dark = RawTexture.CreateRGBTexture(
287:     new Uint8Array([0, 0, 0]),
288:     1,
289:     1,
290:     scene,
291:     false,
292:     false,
293:     Texture.NEAREST_SAMPLINGMODE
294:   );
295: 
296:   return dark;
297: }
298: 
299: /**
300:  * The camera-space z the mask decides on. It is the pass's own renderer, not
301:  * the G-buffer: the G-buffer deliberately refuses a map object's alpha-keyed
302:  * cards (`occludes`, the bulk of its cost), and every barrel, stool, crate and
303:  * rack in a tavern is one, so reading it deleted them from the room they stand
304:  * in. This renderer takes them.
305:  */
306: function depthTexture(own: DepthRenderer | null): BaseTexture | null {
307:   return own?.getDepthMap() ?? null;
308: }
309: 
310: /** Stand-in for a bucket the depth pass is not meant to draw this time round. */
311: const NO_SUBMESHES = new SmartArray<SubMesh>(0);
312: 
313: /** The keyed matter pulled out of the transparent bucket, rebuilt per render. */
314: const keyedMatter = new SmartArray<SubMesh>(64);
315: const blendOnly = new SmartArray<SubMesh>(64);
316: 
317: /**
318:  * Whether the floor drew into the depth map on this render.
319:  *
320:  * `DepthRenderer.renderSubMesh` stamps the render id on a submesh it drew and
321:  * silently skips one whose depth effect is still compiling, so a render is no
322:  * proof the map holds anything: the pass's first frames in a room draw into an
323:  * empty map, and a mask reading an empty map takes the depth-less branch
324:  * everywhere and blacks the room down to its emitters. That is the flash on
325:  * entering. The terrain is the one surface the mask cannot be wrong about and
326:  * the one that always fills a room's floor, so it is what the gate waits for.
327:  */
328: function drewFloor(scene: Scene, bucket: SmartArray<SubMesh>): boolean {
329:   const id = scene.getRenderId();
330: 
331:   for (let i = 0; i < bucket.length; i++) {
332:     const sub = bucket.data[i];
333: 
334:     if (sub._renderId === id && sub.getMesh().metadata?.terrain === true) {
335:       return true;
336:     }
337:   }
338: 
339:   return false;
340: }
341: 
342: /**
343:  * Put the room's keyed props into the depth map, and report the renders that
344:  * actually drew into it.
345:  *
346:  * `modelLoader` promotes every TGA-textured mesh to ALPHATESTANDBLEND, which
347:  * Babylon files as *transparent*, and the depth renderer draws that bucket only
348:  * under `forceDepthWriteTransparentMeshes` - which would take the additive
349:  * effect cards with it. Every bottle, candle, stool and rack in a tavern is one
350:  * of those keyed meshes, so they wrote no depth and the mask blacked them out
351:  * of the room they stand in. They are drawn a second time round through the
352:  * opaque slot, keyed by their own texture (`useMeshAlphaTestTexture`); a pure
353:  * blend mesh is light rather than matter and still writes nothing.
354:  */
355: function takeKeyedMatter(
356:   map: RenderTargetTexture,
357:   scene: Scene,
358:   drawn: () => void
359: ): void {
360:   const inner = map.customRenderFunction;
361: 
362:   if (!inner) return;
363: 
364:   map.customRenderFunction = (
365:     opaque,
366:     alphaTest,
367:     transparent,
368:     depthOnly,
369:     beforeTransparents
370:   ) => {
371:     keyedMatter.reset();
372:     blendOnly.reset();
373: 
374:     for (let i = 0; i < transparent.length; i++) {
375:       const sub = transparent.data[i];
376: 
377:       if (sub.getMaterial()?.transparencyMode === Material.MATERIAL_ALPHABLEND) {
378:         blendOnly.push(sub);
379:       } else {
380:         keyedMatter.push(sub);
381:       }
382:     }
383: 
384:     inner(opaque, alphaTest, NO_SUBMESHES, depthOnly, beforeTransparents);
385:     inner(keyedMatter, NO_SUBMESHES, blendOnly, NO_SUBMESHES);
386: 
387:     if (drewFloor(scene, opaque) || drewFloor(scene, alphaTest)) drawn();
388:   };
389: }
390: 
391: function createPass(scene: Scene, camera: ArcRotateCamera): Runtime {
392:   registerShader();
393: 
394:   const ownDepth = scene.enableDepthRenderer(
395:     camera,
396:     false,
397:     true,
398:     Texture.NEAREST_SAMPLINGMODE,
399:     true
400:   );
401: 
402:   // The depth map is empty until the renderer has drawn into it, and an empty
403:   // map reads as "no depth" everywhere: for those frames the mask would black
404:   // the entire room except its emitters, which is the flash of glowing discs
405:   // on entering. The pass stays identity until the floor is in the map.
406:   let ready = 0;
407: 
408:   takeKeyedMatter(ownDepth.getDepthMap(), scene, () => {
409:     if (ready < READY_FRAMES) ready++;
410:   });
411: 
412:   const pass = new PostProcess(
413:     'roomMask',
414:     SHADER,
415:     ['invView', 'viewport', 'roomXZ', 'roomY', 'roomBox', 'ready'],
416:     ['depthSampler', EFFECT_MASK_SAMPLER],
417:     1,
418:     null,
419:     Texture.NEAREST_SAMPLINGMODE,
420:     scene.getEngine(),
421:     false,
422:     null,
423:     Constants.TEXTURETYPE_HALF_FLOAT
424:   );
425: 
426:   pass.onApply = effect => {
427:     const depth = depthTexture(runtime?.ownDepth ?? null);
428:     if (!depth || !shown) return;
429: 
430:     effect.setTexture('depthSampler', depth);
431:     effect.setMatrix('invView', camera.getViewMatrix().clone().invert());
432: 
433:     const tanHalf = Math.tan(camera.fov / 2);
434:     effect.setFloat2(
435:       'viewport',
436:       tanHalf * scene.getEngine().getAspectRatio(camera, true),
437:       tanHalf
438:     );
439: 
440:     effect.setFloat4('roomXZ', shown.minX, shown.minY, shown.maxX, shown.maxY);
441:     effect.setFloat3('roomY', shown.floorY, shown.wallTop, shown.roofY);
442: 
443:     const mask = effectMask();
444:     // Without a mask (post off) nothing can be told from a depth-less pixel,
445:     // so the box is empty and the old "black it" rule stands.
446:     effect.setTexture(EFFECT_MASK_SAMPLER, mask ?? darkFallback(scene));
447:     screenBoxOf(shown, scene, camera, mask !== null, box);
448:     effect.setFloat4('roomBox', box[0], box[1], box[2], box[3]);
449:     effect.setFloat('ready', ready >= READY_FRAMES ? 1 : 0);
450:   };
451: 
452:   camera.attachPostProcess(pass);
453: 
454:   return { scene, camera, pass, ownDepth };
455: }
456: 
457: export function disposeRoomMask(): void {
458:   if (!runtime) return;
459: 
460:   const { scene, camera, pass, ownDepth } = runtime;
461: 
462:   camera.detachPostProcess(pass);
463:   pass.dispose(camera);
464:   if (ownDepth) scene.disableDepthRenderer(camera);
465: 
466:   runtime = null;
467: }
468: 
469: /**
470:  * Build or tear down the pass to match the tier and the active room. Returns
471:  * whether the chain changed (the director re-orders the post chain) and
472:  * whether the pass is live. `upstreamChanged` says the AO or the haze were
473:  * rebuilt this tick: the pass then re-attaches to stay behind them, keeping
474:  * the depth renderer and the readiness gate it already has.
475:  */
476: export function syncRoomMask(
477:   scene: Scene,
478:   camera: ArcRotateCamera,
479:   tier: LightingTier | null,
480:   volume: RoomVolume | null,
481:   upstreamChanged: boolean
482: ): { changed: boolean; live: boolean } {
483:   shown = volume;
484: 
485:   const want = tier !== null && volume !== null && !forcedOff;
486: 
487:   if (runtime && (!want || runtime.scene !== scene || runtime.camera !== camera)) {
488:     disposeRoomMask();
489:     if (!want) return { changed: true, live: false };
490:   }
491: 
492:   if (runtime && upstreamChanged) {
493:     // Re-order, not rebuild. The AO and the haze attach at the end of the
494:     // camera's list when they are built, so the mask has to move behind them
495:     // again - but tearing it down takes the depth renderer and the readiness
496:     // gate with it, and the frames the gate spends refilling are identity
497:     // frames with the exterior back on screen. Entering a room ends with the
498:     // haze being disposed (a room has none), so that flash fired on every
499:     // entry, about a blend later.
500:     runtime.camera.detachPostProcess(runtime.pass);
501:     runtime.camera.attachPostProcess(runtime.pass);
502: 
503:     return { changed: true, live: true };
504:   }
505: 
506:   if (!want) return { changed: false, live: false };
507:   if (runtime) return { changed: false, live: true };
508: 
509:   runtime = createPass(scene, camera);
510: 
511:   return { changed: true, live: true };
512: }
513: 
514: export function roomMaskActive(): boolean {
515:   return runtime !== null;
516: }
</file>

<file path="src/scenes/sceneLook.ts">
  1: import {
  2:   GlowLayer,
  3:   type AbstractMesh,
  4:   type ArcRotateCamera,
  5:   type RenderTargetTexture,
  6:   type Scene,
  7:   type Texture,
  8: } from '../libs/babylon/exports';
  9: import { driveRenderList } from './renderList';
 10: import { GameOptions, onGameOptionsChanged } from '../common/gameOptions';
 11: import {
 12:   itemHaloAt,
 13:   itemGlowClock,
 14:   type ItemVisualTier,
 15: } from '../common/itemVisualTier';
 16: import { improvedItemEffectsOn } from '../common/itemEffectMode';
 17: import {
 18:   meshTakesPbrMaps,
 19:   pbrDetailStrength,
 20:   pbrMaterialsOn,
 21: } from '../common/materialQuality';
 22: import { pbrMapsIfReady } from '../common/pbrMaps';
 23: import { syncMaterialQuality } from '../common/modelLoader';
 24: import { syncPbrDetail } from '../common/itemMaterial';
 25: import { installMaterialDebug } from './materialDebug';
 26: import { lookDirector } from '../lighting/director';
 27: import type { AreaLookName, AreaRect } from '../lighting/profiles';
 28: 
 29: /**
 30:  * The glow layer and the item-tier emissive selectors, plus the area
 31:  * hand-off to the look director. The look itself - key, shadows, haze, post
 32:  * chain - is composed by `lighting/director.ts`; this file owns nothing that
 33:  * writes a light or the pipeline.
 34:  */
 35: 
 36: const SLIDER_MAX = 9;
 37: 
 38: /** GlowLayer strength at the top slider notch; the default 5/9 lands on the
 39:  * 0.25 the layer was tuned at. */
 40: const GLOW_MAX_INTENSITY = 0.45;
 41: 
 42: export type SceneLook = {
 43:   glow: GlowLayer;
 44: };
 45: 
 46: export type AreaMoodName = AreaLookName;
 47: 
 48: /** GlowLayer gain on the trim emissive map (the surface adds its own share). */
 49: const TRIM_GLOW = 0.6;
 50: 
 51: /** The PBR material's emissive map for a mesh, when it takes one and it exists. */
 52: function trimEmissive(mesh: AbstractMesh) {
 53:   // At Detail 0 the surface adds no emissive of its own, so the halo goes
 54:   // with it.
 55:   if (!meshTakesPbrMaps(mesh) || pbrDetailStrength() <= 0) return null;
 56: 
 57:   return pbrMapsIfReady(mesh.metadata?.diffuseTexture)?.emissive ?? null;
 58: }
 59: 
 60: export function applySceneLook(
 61:   scene: Scene,
 62:   _camera: ArcRotateCamera
 63: ): SceneLook {
 64:   const glow = new GlowLayer('glow', scene, {
 65:     mainTextureFixedSize: 256,
 66:     blurKernelSize: 32,
 67:   });
 68:   glow.intensity = 0;
 69: 
 70:   // Item glow: the item materials are shared and frozen with a black
 71:   // emissive, so the layer is a no-op until a mesh carries an `itemTier` -
 72:   // then it glows with the tier's pulsing colour on the shared clock.
 73:   glow.customEmissiveColorSelector = (mesh, _subMesh, _material, result) => {
 74:     const tier = mesh.metadata?.itemTier as ItemVisualTier | null | undefined;
 75: 
 76:     if (!tier || !tier.improvedActive || !improvedItemEffectsOn()) {
 77:       // Gems and trim glow through their emissive map; the texture selector
 78:       // below hands the map over, this is its gain.
 79:       if (trimEmissive(mesh)) result.set(TRIM_GLOW, TRIM_GLOW, TRIM_GLOW, 1);
 80:       else result.set(0, 0, 0, 1);
 81:       return;
 82:     }
 83: 
 84:     // The capped halo ladder, not the surface intensity: the layer floods
 85:     // the whole silhouette, and at surface strength it drowns the armor
 86:     // into one bright blob.
 87:     itemHaloAt(tier, itemGlowClock(), result);
 88:   };
 89: 
 90:   // A tier glow covers the whole mesh, so the trim map only stands in when
 91:   // no tier is active - otherwise it would mask the tier colour to the trim.
 92:   glow.customEmissiveTextureSelector = (mesh, _subMesh, material) => {
 93:     const tier = mesh.metadata?.itemTier as ItemVisualTier | null | undefined;
 94:     const own = (material as { emissiveTexture?: Texture | null }).emissiveTexture ?? null;
 95: 
 96:     // Babylon types the return as non-null but handles null (no texture).
 97:     if (tier && tier.improvedActive && improvedItemEffectsOn()) return own!;
 98: 
 99:     return ((trimEmissive(mesh) as Texture | null) ?? own)!;
100:   };
101: 
102:   const look = { glow };
103: 
104:   driveGlowList(scene, glow);
105:   syncGlowIntensity(look);
106:   syncPbrDetail();
107:   installMaterialDebug(scene);
108: 
109:   onGameOptionsChanged(() => {
110:     syncMaterialQuality(scene);
111:     syncPbrDetail();
112:     syncGlowIntensity(look);
113:   });
114: 
115:   return look;
116: }
117: 
118: function syncGlowIntensity(look: SceneLook): void {
119:   // The improved item look is drawn by the glow layer, so it stays alive
120:   // without post-processing - otherwise "Improved" is invisible.
121:   const live = GameOptions.postProcessing || improvedItemEffectsOn();
122: 
123:   look.glow.intensity = live
124:     ? (Math.max(0, GameOptions.glow) / SLIDER_MAX) * GLOW_MAX_INTENSITY
125:     : 0;
126: }
127: 
128: /**
129:  * Area (tavern) hand-off: the map's `create` calls this at the door with the
130:  * room's footprint (`areaRectOf` of its interactive area).
131:  */
132: export function setAreaMood(name: AreaMoodName | null, rect?: AreaRect): void {
133:   lookDirector()?.setArea(name, rect);
134: }
135: 
136: /**
137:  * The GlowLayer has no render list - it draws *every active mesh* into its
138:  * own render target every frame and lets the emissive selectors decide the
139:  * colour, so a scene where nothing glows still pays for a second full
140:  * geometry pass. Nothing glows unless an item tier is stamped, a blend mesh
141:  * has been handed its own material, or a PBR trim emissive map is live - so
142:  * the layer is switched off outright the rest of the time.
143:  */
144: const GLOW_PROBE_INTERVAL = 0.25;
145: 
146: let glowProbeTimer = 0;
147: let glowSourcesPresent = false;
148: 
149: /** Re-checks on the next frame instead of waiting out the interval. */
150: export function requestGlowProbe(): void {
151:   glowProbeTimer = 0;
152: }
153: 
154: // The option reads behind the source test, refreshed once per frame: the
155: // test runs per mesh per frame for the render list.
156: let glowImproved = false;
157: let glowPbr = false;
158: 
159: function syncGlowSourceOptions(): void {
160:   glowImproved = improvedItemEffectsOn();
161:   // The derivation only binds an emissive map when saturated highlights cover
162:   // enough of the texture, and most of the world's art clears that bar
163:   // nowhere, so the test asks the meshes instead of assuming.
164:   glowPbr = pbrMaterialsOn();
165: }
166: 
167: /** What the layer has any colour for: its selectors paint the rest black. */
168: function isGlowSource(mesh: AbstractMesh): boolean {
169:   const meta = mesh.metadata;
170:   if (!meta) return false;
171: 
172:   if (meta.glowOwnMaterial) return true;
173: 
174:   if (glowPbr && trimEmissive(mesh)) return true;
175: 
176:   const tier = meta.itemTier as ItemVisualTier | null | undefined;
177: 
178:   return glowImproved && tier?.improvedActive === true;
179: }
180: 
181: function anyGlowSource(scene: Scene): boolean {
182:   syncGlowSourceOptions();
183: 
184:   for (const mesh of scene.meshes) {
185:     if (isGlowSource(mesh)) return true;
186:   }
187: 
188:   return false;
189: }
190: 
191: /**
192:  * The layer's own render target has no list: it walks and draws every active
193:  * mesh and lets the emissive selectors paint most of them black, a second
194:  * full pass over the map (91 of ~700 draws at the Noria spawn). The list is
195:  * driven by the source test the gate above uses, so the pass walks and draws
196:  * the few meshes that glow. The layer rebuilds its target on a size change,
197:  * so the per-frame update re-drives it whenever it is a new one.
198:  */
199: let drivenGlowTexture: RenderTargetTexture | null = null;
200: 
201: function driveGlowList(scene: Scene, glow: GlowLayer): void {
202:   const texture = (glow as unknown as { _mainTexture?: RenderTargetTexture })
203:     ._mainTexture;
204: 
205:   if (!texture || texture === drivenGlowTexture) return;
206: 
207:   drivenGlowTexture = texture;
208:   driveRenderList(scene, texture, isGlowSource);
209: }
210: 
211: /** Per frame: the glow layer's on/off gate. */
212: export function updateSceneLook(scene: Scene, look: SceneLook | undefined): void {
213:   if (!look) return;
214: 
215:   glowProbeTimer -= scene.getEngine().getDeltaTime() / 1000;
216: 
217:   if (glowProbeTimer <= 0) {
218:     glowProbeTimer = GLOW_PROBE_INTERVAL;
219:     glowSourcesPresent = anyGlowSource(scene);
220:   } else {
221:     syncGlowSourceOptions();
222:   }
223: 
224:   driveGlowList(scene, look.glow);
225: 
226:   const enabled = glowSourcesPresent && look.glow.intensity > 0;
227: 
228:   if (look.glow.isEnabled !== enabled) look.glow.isEnabled = enabled;
229: }
</file>

<file path="src/scenes/testScene.ts">
 1: import { ArcRotateCamera, HighlightLayer } from '../libs/babylon/exports';
 2: import {
 3:   Color3,
 4:   Color4,
 5:   Engine,
 6:   Scene,
 7:   Vector3,
 8: } from '../libs/babylon/exports';
 9: import { addInspectorForScene } from '../libs/babylon/utils';
10: import { applySceneLook, type SceneLook } from './sceneLook';
11: import { initPointLightPool } from '../common/pointLightPool';
12: import { createKeyRig } from '../lighting/keyRig';
13: import { createLookDirector, type LookDirector } from '../lighting/director';
14: 
15: export class TestScene extends Scene {
16:   defaultCamera: ArcRotateCamera;
17: 
18:   readonly hl: HighlightLayer;
19: 
20:   readonly look: SceneLook | undefined;
21: 
22:   readonly director: LookDirector;
23: 
24:   constructor(engine: Engine) {
25:     super(engine);
26: 
27:     const camera = new ArcRotateCamera(
28:       'ArcRotateCamera',
29:       -Math.PI / 4,
30:       Math.PI / 4.5,
31:       10,
32:       new Vector3(0, 0, 0),
33:       this
34:     );
35: 
36:     this.hl = new HighlightLayer('hl1', this, {
37:       isStroke: true,
38:       alphaBlendingMode: 1,
39:     });
40: 
41:     this.hl.innerGlow = false;
42: 
43:     camera.minZ = 0.1;
44:     camera.maxZ = 5000;
45:     camera.position.set(135, 10, 130);
46: 
47:     this.fogEnabled = false;
48:     this.fogStart = 1;
49:     this.fogEnd = 25;
50: 
51:     this.defaultCamera = camera;
52: 
53:     // Frustum clipping on: meshes that must always draw opt in individually
54:     // (shadow clones, move-target effects, debug boxes).
55:     this.skipFrustumClipping = false;
56: 
57:     this.autoClearDepthAndStencil = true;
58:     // autoClear stays on. This scene has no skybox yet - the sky *is* the
59:     // clear colour (the look director writes it per map) - so skipping the
60:     // colour clear smears the previous frame wherever the terrain does not
61:     // cover.
62:     //
63:     // That is also why `performancePriority = Intermediate` is not set here.
64:     // The enum is exactly two assignments (Babylon scene.js:105):
65:     // `skipPointerMovePicking = true` and `autoClear = false`. The second is
66:     // the bug above; the first is already a no-op, because the input manager
67:     // only picks on pointer-move when `_registeredActions > 0` or
68:     // `constantlyUpdateMeshUnderPointer` is set, and this scene registers no
69:     // ActionManager. It is set explicitly anyway so that adding one later
70:     // cannot silently turn every mouse-move into a full-scene pick.
71:     this.autoClear = true;
72:     this.skipPointerMovePicking = true;
73: 
74:     this.clearColor = new Color4(0, 0, 0, 1);
75:     this.ambientColor = new Color3(1, 1, 1);
76: 
77:     addInspectorForScene(this);
78: 
79:     createKeyRig(this);
80: 
81:     initPointLightPool(this);
82: 
83:     this.look = applySceneLook(this, camera);
84: 
85:     // After the rig and the pool: the director writes the rig on its first
86:     // tick and the post chain sits behind the pool's lights.
87:     this.director = createLookDirector(this, camera);
88:   }
89: }
</file>

<file path="src/skills/_template.ts">
 1: /**
 2:  * TEMPLATE - copy this file to `<name>.ts`, fill in the blanks, add the layer
 3:  * to `layers.ts`. Never imported; it only exists to be copied.
 4:  *
 5:  * Every entry file has the same three parts, in this order:
 6:  *
 7:  *   1. Tuning constants at the top, each with a comment saying what it is in
 8:  *      real units (seconds, points, 0…1) and why it has that value.
 9:  *   2. Module state + the functions that read it. State lives here, not in
10:  *      the facade; readers are plain functions (`fooRemaining()`), commands
11:  *      are verbs (`startFoo()`).
12:  *   3. The exported `SkillLayer` at the bottom, wiring `update` / `reset`.
13:  *
14:  * Whatever draws the entry (a hotbar overlay, a tooltip, a window) lives in
15:  * `ui/…` and imports the readers from here or from the `skills` facade.
16:  */
17: import type { ENUM_WORLD } from '../common/types';
18: import type { SkillLayer } from './layer';
19: 
20: // ---- 1. tuning -------------------------------------------------------------
21: 
22: /** Seconds the effect lasts once started. */
23: const DURATION_SECONDS = 10;
24: 
25: // ---- 2. state + readers ----------------------------------------------------
26: 
27: let remaining = 0;
28: 
29: /** Seconds left, 0 when idle. */
30: export function templateRemaining(): number {
31:   return remaining;
32: }
33: 
34: /** Start the effect now. */
35: export function startTemplate(): void {
36:   remaining = DURATION_SECONDS;
37: }
38: 
39: function update(_map: ENUM_WORLD, dt: number): void {
40:   remaining = Math.max(0, remaining - dt);
41: }
42: 
43: function reset(): void {
44:   remaining = 0;
45: }
46: 
47: // ---- 3. the layer ----------------------------------------------------------
48: 
49: export const templateLayer: SkillLayer = {
50:   name: 'template',
51:   update,
52:   reset,
53: };
</file>

<file path="src/skills/buffs.ts">
  1: /**
  2:  * Active buffs / debuffs of the hero with the moment each one arrived.
  3:  *
  4:  * Driven by `Store.buffs` (MagicEffectStatus 0x07 / MagicEffectCancelled,
  5:  * `logic.ts`): a MobX reaction stamps every newly present effect id with the
  6:  * layer clock. OpenMU S6 sends no durations, so `buffRemaining` only counts
  7:  * down for effects whose duration formula the client knows (`recipes.ts`),
  8:  * and answers `null` otherwise.
  9:  *
 10:  * Read by the buff bar (`ui/components/buffBar`) through `skills.activeBuffs`
 11:  * / `skills.buffRemaining`, and by the usability rules (`usability.ts`).
 12:  */
 13: import { reaction } from 'mobx';
 14: import type { ENUM_WORLD } from '../common/types';
 15: import type { SkillLayer } from './layer';
 16: import { buffRecipe, type BuffKind } from './recipes';
 17: import { Store } from '../store';
 18: 
 19: // ---- 1. tuning -------------------------------------------------------------
 20: 
 21: // Nothing to tune: the clock is the frame clock and durations are recipes.
 22: 
 23: // ---- 2. state + readers ----------------------------------------------------
 24: 
 25: export interface ActiveBuff {
 26:   id: number;
 27:   name: string;
 28:   kind: BuffKind;
 29:   /** Layer-clock seconds when the effect appeared. */
 30:   startedAt: number;
 31: }
 32: 
 33: /** Seconds of `update` since the last reset - the layer's own clock. */
 34: let clock = 0;
 35: /** Effect id → clock seconds when it appeared. */
 36: const startedAt = new Map<number, number>();
 37: 
 38: function noteBuffs(ids: readonly number[] | undefined): void {
 39:   // Defensive: a reaction whose expression threw hands over `undefined`.
 40:   if (!ids) return;
 41:   for (const id of ids) if (!startedAt.has(id)) startedAt.set(id, clock);
 42:   for (const id of Array.from(startedAt.keys())) {
 43:     if (!ids.includes(id)) startedAt.delete(id);
 44:   }
 45: }
 46: 
 47: /** Disposer of the `Store.buffs` reaction once it is running. */
 48: let stopWatching: (() => void) | null = null;
 49: 
 50: /**
 51:  * Start following `Store.buffs`. Deferred to the first `update` on purpose:
 52:  * `store.ts` imports (through `logic.ts` and the facade) this very file, so
 53:  * at module-evaluation time `Store` is still in its temporal dead zone and a
 54:  * top-level reaction throws `Cannot access 'Store' before initialization`.
 55:  * By the first frame every module has finished evaluating.
 56:  *
 57:  * `Store.buffs` is replaced wholesale on every change, so the reaction fires
 58:  * once per packet; `fireImmediately` catches a hero that logged in buffed.
 59:  */
 60: function ensureWatching(): void {
 61:   if (stopWatching) return;
 62:   stopWatching = reaction(() => Store.buffs, noteBuffs, { fireImmediately: true });
 63: }
 64: 
 65: /**
 66:  * The hero's effects in the original's bar order (`CNewUIBuffWindow::
 67:  * BuffSort`): buffs first, newest leftmost; debuffs after, oldest first.
 68:  */
 69: export function activeBuffs(): ActiveBuff[] {
 70:   const buffs: ActiveBuff[] = [];
 71:   const debuffs: ActiveBuff[] = [];
 72:   for (const id of Store.buffs) {
 73:     const recipe = buffRecipe(id);
 74:     const entry: ActiveBuff = {
 75:       id,
 76:       name: recipe.name,
 77:       kind: recipe.kind,
 78:       startedAt: startedAt.get(id) ?? clock,
 79:     };
 80:     if (recipe.kind === 'debuff') debuffs.push(entry);
 81:     else buffs.unshift(entry);
 82:   }
 83:   return buffs.concat(debuffs);
 84: }
 85: 
 86: /** Whether the hero currently carries this effect. */
 87: export function hasBuff(effectId: number): boolean {
 88:   return Store.buffs.includes(effectId);
 89: }
 90: 
 91: /**
 92:  * Seconds until the effect runs out by the client's best estimate, or
 93:  * `null` when the server never told and no formula is known.
 94:  */
 95: export function buffRemaining(effectId: number): number | null {
 96:   const started = startedAt.get(effectId);
 97:   const duration = buffRecipe(effectId).durationSeconds;
 98:   if (started === undefined || !duration) return null;
 99:   const total = duration(Store.playerData.eng);
100:   return Math.max(0, total - (clock - started));
101: }
102: 
103: function update(_map: ENUM_WORLD, dt: number): void {
104:   ensureWatching();
105:   clock += dt;
106: }
107: 
108: function reset(): void {
109:   // The buffs themselves survive a warp (the server re-sends nothing), so
110:   // their start stamps do too; only the clock is rebased.
111:   const now = clock;
112:   for (const [id, at] of startedAt) startedAt.set(id, at - now);
113:   clock = 0;
114: }
115: 
116: // ---- 3. the layer ----------------------------------------------------------
117: 
118: export const buffsLayer: SkillLayer = {
119:   name: 'buffs',
120:   update,
121:   reset,
122: };
</file>

<file path="src/skills/cooldowns.ts">
  1: /**
  2:  * Skill re-use delays (`CSkillManager::CheckSkillDelay` / `CalcSkillDelay`):
  3:  * a skill with a `Delay` in Skill.bmd cannot be cast again until it has
  4:  * counted down. The server is authoritative; this is display and the
  5:  * client-side gate the cast system asks before sending.
  6:  *
  7:  * Driven by `startSkillCooldown` (the cast system, on a successful cast);
  8:  * counts down in `update`. Read by the hotbar (`bottomBar`), which sweeps
  9:  * the original's red-tinted clock overlay (`RenderSkillDelay`), and by
 10:  * `usability.ts`.
 11:  *
 12:  * Two clocks: `skillCooldowns` is observable but only changes when a delay
 13:  * *starts* or *ends*, so React learns which slots are cooling; the running
 14:  * seconds live in a plain map and are pushed to `onCooldownTick` listeners
 15:  * once a frame, which the hotbar paints straight into the sweep's `height`
 16:  * through a ref. The old design wrote the observable every frame and
 17:  * re-rendered the whole hotbar (five slots, tooltips, drag state) at frame
 18:  * rate for the duration of every delay.
 19:  */
 20: import { observable, runInAction } from 'mobx';
 21: import type { ENUM_WORLD } from '../common/types';
 22: import type { SkillLayer } from './layer';
 23: import { SKILL_DELAY_MS } from './recipes';
 24: 
 25: // ---- 1. tuning -------------------------------------------------------------
 26: 
 27: /** Skill.bmd delays are milliseconds; the layer clock is seconds. */
 28: const MS_PER_SECOND = 1000;
 29: 
 30: // ---- 2. state + readers ----------------------------------------------------
 31: 
 32: export interface SkillCooldown {
 33:   /** Seconds still to wait. */
 34:   remaining: number;
 35:   /** Seconds the full delay lasts. */
 36:   total: number;
 37:   /** remaining / total, 1 right after the cast, 0 when ready. */
 38:   fraction: number;
 39: }
 40: 
 41: /**
 42:  * Skill number → full delay in seconds, present while the skill cools.
 43:  * Observable so a slot re-renders when its delay starts or ends; the
 44:  * countdown itself is not observable (see the header).
 45:  */
 46: export const skillCooldowns = observable.map<number, number>();
 47: 
 48: /** Skill number → seconds left; the per-frame clock. */
 49: const remainingOf = new Map<number, number>();
 50: 
 51: type TickListener = () => void;
 52: const tickListeners = new Set<TickListener>();
 53: 
 54: /**
 55:  * Called once a frame while at least one skill is cooling (and once more
 56:  * when the last one ends). Listeners read `skillCooldown(num)`.
 57:  */
 58: export function onCooldownTick(listener: TickListener): () => void {
 59:   tickListeners.add(listener);
 60:   return () => {
 61:     tickListeners.delete(listener);
 62:   };
 63: }
 64: 
 65: /** The full delay of a skill in seconds, 0 when it has none. */
 66: export function skillDelaySeconds(num: number): number {
 67:   return (SKILL_DELAY_MS[num] ?? 0) / MS_PER_SECOND;
 68: }
 69: 
 70: /** Seconds left before the skill can be cast again, 0 when ready. */
 71: export function skillCooldownRemaining(num: number): number {
 72:   return remainingOf.get(num) ?? 0;
 73: }
 74: 
 75: /** The running delay of a skill, or `null` when it is ready (or has none). */
 76: export function skillCooldown(num: number): SkillCooldown | null {
 77:   const remaining = skillCooldownRemaining(num);
 78:   if (remaining <= 0) return null;
 79:   const total = skillDelaySeconds(num);
 80:   return { remaining, total, fraction: total > 0 ? remaining / total : 0 };
 81: }
 82: 
 83: /**
 84:  * Start the skill's delay after a cast. Returns `false` when the skill is
 85:  * still cooling down (the caller should not have cast) - `CheckSkillDelay`.
 86:  * Skills without a delay always return `true`.
 87:  */
 88: export function startSkillCooldown(num: number): boolean {
 89:   const total = skillDelaySeconds(num);
 90:   if (total <= 0) return true;
 91:   if (skillCooldownRemaining(num) > 0) return false;
 92:   remainingOf.set(num, total);
 93:   runInAction(() => skillCooldowns.set(num, total));
 94:   notify();
 95:   return true;
 96: }
 97: 
 98: function notify(): void {
 99:   for (const listener of tickListeners) listener();
100: }
101: 
102: function update(_map: ENUM_WORLD, dt: number): void {
103:   if (remainingOf.size === 0) return;
104: 
105:   let ended: number[] | null = null;
106:   for (const [num, left] of remainingOf) {
107:     const next = left - dt;
108:     if (next <= 0) {
109:       remainingOf.delete(num);
110:       (ended ??= []).push(num);
111:     } else {
112:       remainingOf.set(num, next);
113:     }
114:   }
115: 
116:   if (ended) {
117:     const done = ended;
118:     runInAction(() => {
119:       for (const num of done) skillCooldowns.delete(num);
120:     });
121:   }
122: 
123:   notify();
124: }
125: 
126: function reset(): void {
127:   remainingOf.clear();
