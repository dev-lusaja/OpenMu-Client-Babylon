328:    * Who is speaking, as the log will draw them. Read once, when the line
329:    * arrives: the speaker can leave scope, change guild or turn outlaw long
330:    * before the line scrolls off, and the log should still show what was true
331:    * when they said it.
332:    */
333:   private speaker(sender: string): {
334:     senderGuild?: string;
335:     senderPk?: number;
336:     senderGm?: boolean;
337:   } {
338:     const world = Store.world;
339:     if (!sender || !world) return {};
340: 
341:     // `AssignChat`: players first, then anything else wearing the name.
342:     const players = world.playersQuery.entities;
343:     const entity =
344:       players.find(e => e.objectNameInWorld === sender) ??
345:       (world.playerEntity?.objectNameInWorld === sender ? world.playerEntity : undefined);
346:     if (!entity) return {};
347: 
348:     const guild = entity.guild ? Store.guilds.get(entity.guild.id) : undefined;
349:     // For ourselves the server answered both outright (CharacterInformation);
350:     // for anyone else `isGm` is the `#` shout guess and all there is.
351:     const own = sender === Store.playerData.name;
352: 
353:     return {
354:       senderGuild: guild?.name || undefined,
355:       senderPk: own ? Store.playerData.heroState : entity.heroState,
356:       senderGm: own ? Store.playerData.isGameMaster : entity.isGm,
357:     };
