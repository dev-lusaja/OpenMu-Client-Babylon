  1: import { ParticleEmitter } from '../../common/effectParticles';
  2: import { loadGLTF } from '../../common/modelLoader';
  3: import { ModelObject } from '../../common/modelObject';
  4: import { Rand } from '../../common/rand';
  5: import type { Entity, World } from '../../ecs/world';
  6: 
  7: /** 25 Hz, the tick `FPS_ANIMATION_FACTOR` is measured in. */
  8: const TICKS_PER_SECOND = 25;
  9: 
 10: const DEGREES_TO_RADIANS = Math.PI / 180;
 11: 
 12: /**
 13:  * `o->Angle[1] += (4.0f + o->Gravity) * FPS_ANIMATION_FACTOR`
 14:  * (ZzzEffect.cpp:7186). `Gravity` is `(float)(rand() % 80) / 10.f` for
 15:  * warp01/02 (ZzzEffect.cpp:567) and untouched - so zero - for warp03
 16:  * (:552-556), giving 4…11.9 degrees a tick, i.e. 100…298 deg/s.
 17:  */
 18: const SPIN_BASE_DEGREES = 4;
 19: const SPIN_GRAVITY_MAX = 8;
 20: 
 21: /**
 22:  * `o->Scale = 1.3f + (float)(rand() % 50) / 100.f` (ZzzEffect.cpp:566).
 23:  * warp03 is a flat 0.6 (:556) and is scaled by the entity instead, so this
 24:  * only serves the four ring copies.
 25:  */
 26: const RING_SCALE_MIN = 1.3;
 27: const RING_SCALE_SPREAD = 0.5;
 28: 
 29: /**
 30:  * The Noria warp gate, `MapManager.cpp:100-103`: one `CreateObject(MODEL_WARP)`
 31:  * at `Pos = (223 * TERRAIN_SCALE, 30 * TERRAIN_SCALE, 0)`, angle `(0, 0, 10)`,
 32:  * which `CreateObject` (ZzzObject.cpp:4675-4693) answers with five stacked
 33:  * effects at `z + 350` - warp01, warp02, warp01, warp02, warp03, offset along
 34:  * Y by 0/4/8/12/20.
 35:  *
 36:  * The base object itself is not spawned here, and that is not a shortcut: its
 37:  * Z is left at 0 while TerrainHeight.OZB reads 1.80 tiles at (223, 30), and
 38:  * warp01 only reaches 1.22 tiles above its own origin, so the original buries
 39:  * the whole gate model 58 MU under the ground. Nothing of it is ever on
 40:  * screen; the five effects floating at 3.5 tiles are the visible gate.
 41:  *
 42:  * Each effect is `o->BlendMesh = -2` - the original's "additive whole body",
 43:  * which maps onto `BlendMesh = 0` here because all three warp models convert
 44:  * to exactly one mesh.
 45:  */
 46: export class NoriaWarpHaloObject extends ModelObject {
 47:   CastsShadow = false;
 48: 
 49:   /** Radians a second, from the per-instance `Gravity` roll. */
 50:   #spin = 0;
 51: 
 52:   #sparks: ParticleEmitter | null = null;
 53: 
 54:   #elapsedMs = 0;
 55: 
 56:   /** The entity rotation the render system reads back; see init(). */
 57:   #rot: { x: number; y: number; z: number } | null = null;
 58: 
 59:   /** File under `NPC/`; the stack alternates warp01 and warp02, then warp03. */
 60:   protected modelFile(): string {
 61:     return 'NPC/warp01.glb';
 62:   }
 63: 
 64:   /**
 65:    * `Gravity` is only rolled for the warp01/02 rings; warp03 spins at the
 66:    * bare 4 deg/tick.
 67:    */
 68:   protected gravity(): number {
 69:     return Rand.nextFloat(0, SPIN_GRAVITY_MAX);
 70:   }
 71: 
 72:   /**
 73:    * Where the gate's spark ring sits relative to *this* halo, in tiles, or
 74:    * null for the halos that carry none. `MoveObject` (ZzzObject.cpp:3920-3925)
 75:    * hangs it off the buried base object at `Position[1] - 50`, `z + 350`;
 76:    * since that object is not spawned, the one warp03 halo carries it and
 77:    * corrects for its own +20 MU Y offset.
 78:    */
 79:   protected sparkRingOffsetZ(): number | null {
 80:     return null;
 81:   }
 82: 
 83:   async init(world: World, entity: Entity) {
 84:     // Set before load(): applyBlendMesh runs inside it.
 85:     this.BlendMesh = 0;
 86: 
 87:     // The spin has to live on the *entity*, not on `node.rotation`: the render
 88:     // system re-derives the node's Euler angles from `transform.rot` through
 89:     // `toRenderAngles` after every Update (renderSystem.ts:81-95), so anything
 90:     // written straight onto the node is overwritten the same frame.
 91:     this.#rot = entity.transform?.rot ?? null;
 92: 
 93:     this.#spin =
 94:       (SPIN_BASE_DEGREES + this.gravity()) *
 95:       TICKS_PER_SECOND *
 96:       DEGREES_TO_RADIANS;
 97: 
 98:     this.load(await loadGLTF(this.modelFile(), world));
 99: 
100:     const sparkZ = this.sparkRingOffsetZ();
101: 
102:     if (sparkZ !== null) {
103:       const p = this.node.position;
104: 
105:       this.#sparks = new ParticleEmitter(
106:         world.scene,
107:         // `CreateParticleFpsChecked(BITMAP_SPARK + 1, …, 9, 1.4f)` - one a
108:         // tick at 25 Hz. `spark03_24` is the same Spark03 sheet; the subtype
109:         // 9 variant's own motion curve is not ported.
110:         [{ kinds: ['spark03_24'], every: 1, count: 1, light: [0.5, 0.5, 0.5] }],
111:         { x: p.x, y: p.y, z: p.z + sparkZ },
112:         0,
113:         1.4
114:       );
115:     }
116:   }
117: 
118:   dispose(): void {
119:     this.#sparks = null;
120:     this.#rot = null;
121:     super.dispose();
122:   }
123: 
124:   Update(gameTime: World['gameTime']): void {
125:     super.Update(gameTime);
126: 
127:     if (!this.Ready) return;
128: 
129:     this.#sparks?.update();
130: 
131:     if (this.OutOfView) return;
132: 
133:     const deltaSeconds = this.node.getScene().getEngine().getDeltaTime() / 1000;
134: 
135:     // `Angle[1]` is the MU Y axis, which the loader's `-toRadians(rot.y)` puts
136:     // in `transform.rot.z` and `toRenderAngles` passes through unchanged -
137:     // hence the minus. These discs face along Y, so this is the portal
138:     // spinning in its own plane. Wrapped so the accumulator keeps its
139:     // precision over a long session.
140:     if (this.#rot) {
141:       this.#rot.z =
142:         (this.#rot.z - this.#spin * deltaSeconds) % (Math.PI * 2);
143:     }
144: 
145:     const mesh = this.getMesh(0);
146:     if (!mesh?.metadata) return;
147: 
148:     // `WorldTime`, in milliseconds. It is accumulated from the engine delta
149:     // rather than read off `gameTime`, which is a fixed 0.1 s in this build
150:     // (ecs/world.ts:244) - the same reason effectParticles keeps its own.
151:     this.#elapsedMs += deltaSeconds * 1000;
152: 
153:     const t = this.#elapsedMs;
154: 
155:     // `Vector(fTemp1 + 0.01f, fTemp2 + 0.01f, fTemp3 + 0.01f, o->Light)` with
156:     // `fTempN = sinf(WorldTime * 0.0011f / 0.0017f / 0.0013f) * 0.2f`
157:     // (ZzzEffect.cpp:7182-7185): three channels drifting out of phase, which
158:     // is what washes the portal between blue, green and violet.
159:     //
160:     // The clone's blend-mesh path carries one brightness scalar per mesh, not
161:     // a colour, so the drift has to collapse. It collapses to the *brightest*
162:     // channel rather than to their mean: on an additively blended body the eye
163:     // reads the peak, and the mean would have halved an already near-black
164:     // light into nothing.
165:     const light =
166:       Math.max(
167:         Math.sin(t * 0.0011),
168:         Math.sin(t * 0.0017),
169:         Math.sin(t * 0.0013)
170:       ) *
171:         0.2 +
172:       0.01;
173: 
174:     mesh.metadata.blendMeshLight = Math.max(0, light);
175:   }
176: }
177: 
178: /** The two warp02 copies in the stack (y + 4 and y + 12). */
179: export class NoriaWarpHalo2Object extends NoriaWarpHaloObject {
180:   protected modelFile(): string {
181:     return 'NPC/warp02.glb';
182:   }
183: }
184: 
185: /**
186:  * The single warp03 copy (y + 20): a flat 5-tile disc rather than a ring, no
187:  * `Gravity` roll, and the carrier for the gate's spark ring.
188:  */
189: export class NoriaWarpHalo3Object extends NoriaWarpHaloObject {
190:   protected modelFile(): string {
191:     return 'NPC/warp03.glb';
192:   }
193: 
194:   protected gravity(): number {
195:     return 0;
196:   }
197: 
198:   protected sparkRingOffsetZ(): number | null {
199:     // -50 MU from the gate origin, minus this halo's own +20 MU.
200:     return -0.7;
201:   }
202: }
203: 
204: /** Per-instance scale for the four ring copies; warp03 is a fixed 0.6. */
205: export function warpRingScale(): number {
206:   return RING_SCALE_MIN + Rand.nextFloat(0, RING_SCALE_SPREAD);
207: }
</file>

