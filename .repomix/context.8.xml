 1: import type { World } from '../../ecs/world';
 2: import { ChaosCastleRingObject } from './ringObject';
 3: import { resetChaosCastleArena } from './arena';
 4: import {
 5:   CHAOS_CASTLE_HIDDEN_RINGS,
 6:   CHAOS_CASTLE_OUTER_RING,
 7: } from './spec';
 8: 
 9: /**
10:  * Chaos Castle (`WD_18CHAOS_CASTLE` … `_END` and the master-level 53 - seven
11:  * server instances on one art set, `World19` + `Object19`; see
12:  * `common/worldAssets.ts`).
13:  *
14:  * The map *is* its state machine: a floor in a black void that loses a ring
15:  * of slabs at each of the match's three stage states, with the strip the
16:  * server just declared `TW_NOGROUND` closing under it. That is `arena.ts`
17:  * (the `g_currentCastleLevel` / `SetActionObject` pair from CSChaosCastle.cpp
18:  * and NewChaosCastleSystem.cpp), applied by `ChaosCastleRingObject`. The
19:  * `TW_NOGROUND` tiles it writes through `world.setTerrainFlags` are what
20:  * `deathSystem` reads to drop a body straight into the pit
21:  * (WSclient.cpp:5440-5487), and what `IsWalkable` refuses.
22:  *
23:  * Elsewhere, and why:
24:  *  - 6-12 the smoke-box markers: `spec.ts` effect-only.
25:  *  - The black clear colour is the scene default; `SetWorldClearColor`
26:  *    (SceneManager.cpp:346) sets exactly that.
27:  *  - `aChaos` / `iChaosCastle` beds: `sound/ambientBeds.ts`, on the match state.
28:  *  - Auto-attack off, `c->Run = 40` forced, no wings/pets, the CC 70-72
29:  *    monster skins from `Npc/`: all in the events / locomotion / character
30:  *    lanes, none of it map data.
31:  *
32:  * Not built: the thunder pillars (0-3 with `PKKey`, a `CreateJoint` ribbon -
33:  * no ribbon primitive in the clone), the quake, and the tile smoke on the
34:  * strip about to close (`RenderTerrainVisual`). All three are listed in
35:  * `arena.ts` / `spec.ts` against their C++ lines.
36:  */
37: export async function createChaosCastle(world: World) {
38:   const terrain = world.terrain;
39:   if (!terrain) return;
40: 
41:   const tiles = terrain.MapTileObjects;
42: 
43:   // A fresh arena every warp in: every ring back where the object list put it.
44:   resetChaosCastleArena();
45: 
46:   for (const type of CHAOS_CASTLE_OUTER_RING) tiles[type] = ChaosCastleRingObject;
47:   for (const type of CHAOS_CASTLE_HIDDEN_RINGS) tiles[type] = ChaosCastleRingObject;
48: }
</file>

