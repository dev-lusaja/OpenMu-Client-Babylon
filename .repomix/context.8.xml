  1: import type { LightEmitter } from '../../lighting/mapObjectLights';
  2: import type { Emission } from '../../common/effectParticles';
  3: 
  4: /**
  5:  * Noria (WD_3NORIA, World4 / Object4). Plain data - no scene imports, so the
  6:  * shared registries can pull it in without dragging Babylon along.
  7:  *
  8:  * `Object4` ships 43 BMDs, so `o->Type` runs 0…42 (`Object4/Object{N+1}.glb`).
  9:  * EncTerrain4.obj carries 9399 records over all 44 ids: id 43 is placed once,
 10:  * at tile (181, 104.5), and has no model at all - see
 11:  * `NORIA_EFFECT_ONLY_TYPES`.
 12:  */
 13: 
 14: /**
 15:  * `CreateObject`, ZzzObject.cpp:4672-4716, plus the two blend meshes the
 16:  * original only assigns from `MoveObject` (39 at :3930, 41 at :3933) because
 17:  * they are set every frame next to a UV scroll rather than once at spawn.
 18:  *
 19:  * Every index was checked against the converted model's mesh count, since an
 20:  * out-of-range `BlendMesh` is a silent warn-and-skip in `applyBlendMesh`:
 21:  *  1  → Object02.glb, 2 meshes    9  → Object10.glb, 4 meshes
 22:  *  17 → Object18.glb, 7 meshes    18 → Object19.glb, 4 meshes
 23:  *  19 → Object20.glb, 1 mesh      37 → Object38.glb, 1 mesh
 24:  *  39 → Object40.glb, 3 meshes    41 → Object42.glb, 1 mesh
 25:  *
 26:  * 18 and 41 also appear in `meshAnimation.ts` as `kind: 'blend'`. That table
 27:  * only names the mesh the UV writes land on and never touches `BlendMesh`, so
 28:  * without the entries here the mill water and the stream would scroll a fully
 29:  * lit, opaque mesh instead of an additive one.
 30:  */
 31: export const NORIA_BLEND_MESHES: Readonly<Record<number, number>> = {
 32:   1: 1,
 33:   9: 3,
 34:   17: 0,
 35:   18: 2,
 36:   19: 0,
 37:   37: 0,
 38:   39: 1,
 39:   41: 0,
 40: };
 41: 
 42: /**
 43:  * Id 43 is the one Noria record with no model behind it: `Data/Object4` ends
 44:  * at `Object43.bmd` (type 42), and `MapManager` loads exactly that many, so
 45:  * `Models[43]` stays a zero-mesh BMD and `RenderObject` draws nothing for the
 46:  * single instance at (181, 104.5). Its `MoveObject` case (ZzzObject.cpp:3940)
 47:  * still runs - it writes `StreamMesh`/`BlendMeshTexCoordU` into that empty
 48:  * model, which is why the type looks implemented in the source.
 49:  *
 50:  * Declaring it effect-only reproduces "loads nothing, draws nothing" exactly:
 51:  * `MapTileObject.init` returns before `loadGLTF`, so the entity stays live
 52:  * (pickable-free, shadowless, no body) instead of throwing a 404 through
 53:  * `modelLoaderSystem`'s failure path on every Noria load. It emits nothing -
 54:  * see `NORIA_EMISSIONS`.
 55:  */
 56: export const NORIA_EFFECT_ONLY_TYPES: readonly number[] = [43];
 57: 
 58: /**
 59:  * `emissionsFor` is only ever consulted for effect-only types
 60:  * (`MapTileObject.init`), and Noria's only effect-only type is 43, the record
 61:  * whose model is missing. The original draws nothing there and invents no
 62:  * particles, so neither do we - putting steam or water on that spot would be
 63:  * new content, not a port.
 64:  *
 65:  * The forge's sparks are *not* here on purpose: they hang off bone 58 of
 66:  * Object40, so they ride on `NORIA_LIGHTS[39]`, where `MapObjectLights`
 67:  * places each `LightEmitter.emissions` at that emitter's own bone offset.
 68:  */
 69: export const NORIA_EMISSIONS: Partial<Record<number, readonly Emission[]>> = {};
 70: 
 71: /**
 72:  * `Luminosity` is rolled once per object per frame in `RenderObjectVisual`
 73:  * (ZzzObject.cpp:2743): `(rand() % 30 + 70) * 0.01f`, i.e. a fresh 0.70…0.99,
 74:  * and every Noria lamp colour is that value times a fixed tint.
 75:  *
 76:  * `LightEmitter.sprite.pulse` is the only per-sprite animation the shared
 77:  * emitter offers - `(sin(t * speed) + 1) * amount + base` - so `amount` 0.145
 78:  * over `base` 0.70 lands on exactly the original's 0.70…0.99 window and only
 79:  * the *shape* differs: a ~0.8 s breath instead of white noise. That is the
 80:  * better trade at this scale. The alternative, a class per lamp re-rolling
 81:  * `Math.random()` each frame, would have put a per-frame Update on the ~300
 82:  * type-1 plants that sit inside the load radius in the west of the map, to
 83:  * animate a ±15 % wobble nobody can resolve on a 32 px sprite.
 84:  *
 85:  * `elapsed` inside `createEffectLight` starts at zero per sprite and objects
 86:  * stream in as the hero walks, so the pulses desynchronise on their own.
 87:  */
 88: const LAMP_PULSE = { speed: 0.008, amount: 0.145, base: 0.7 } as const;
 89: 
 90: /** `Vector(Luminosity * 0.4f, Luminosity * 0.7f, Luminosity * 1.f, Light)`. */
 91: const LAMP_COLOR: readonly [number, number, number] = [0.4, 0.7, 1];
 92: 
 93: /**
 94:  * A Noria lamp sprite: `CreateSprite(BITMAP_LIGHT, Position, scale, Light, o)`
 95:  * at a bone, and nothing else.
 96:  *
 97:  * There is deliberately no `terrain` block. Noria is the one town map with no
 98:  * `AddTerrainLight` call anywhere - its lamps are pure additive sprites that
 99:  * do not light the ground, and `MapObjectLights` nests the point-light
100:  * registration inside the terrain one, so omitting it here reproduces both
101:  * halves. Copying Lorencia's street-light recipe would have been wrong twice
102:  * over: the colour is cold here, and 300-odd blue pools summing into the
103:  * delta texture's 2.0 clamp would flatten the whole west of the map.
104:  *
105:  * `offset` is in BMD units and `resolveEmitterPosition` maps it as
106:  * `(x, z, y)` then rotates it by the object's own yaw/pitch/roll - the same
107:  * frame the model root ends up in after `scaling(1,-1,1) · rotX(-90°)`, so a
108:  * bone's BMD rest position can be pasted in unchanged.
109:  */
110: const lamp = (
111:   offset: readonly [number, number, number],
112:   scale: number,
113:   color: readonly [number, number, number] = LAMP_COLOR
114: ): LightEmitter => ({
115:   offset,
116:   sprite: { scale, color, pulse: LAMP_PULSE },
117: });
118: 
119: /**
120:  * The forge hearth (ZzzObject.cpp:2866 sets `Light` to white before the
121:  * bone 61…65 loop, so these five are *not* tinted by `Luminosity`).
122:  */
123: const FORGE_GLOW: LightEmitter['sprite'] = {
124:   scale: 1,
125:   color: [1, 1, 1],
126: };
127: 
128: /**
129:  * Noria's map-object light sprites, `RenderObjectVisual` ZzzObject.cpp:
130:  * 2826-2890. All five entries are bone-anchored in the original; the offsets
131:  * below are those bones' rest positions read out of the converted GLBs (the
132:  * first animation key of each channel, composed down the parent chain).
133:  *
134:  * The animation moves them 5…30 MU - under a third of a tile, against
135:  * sprites 0.3…1.5 tiles across - so a fixed offset costs the slow bob and
136:  * buys back the bone lookups. Type 17's hanging lanterns swing the furthest
137:  * (~0.3 tile); with three of them on the map that is the one place a
138:  * bone-following class would still be visible, and it is noted rather than
139:  * built.
140:  */
141: export const NORIA_LIGHTS: Partial<Record<number, readonly LightEmitter[]>> = {
142:   /**
143:    * The glow plant (Object02, 2336 records - the signature blue of the
144:    * fairy forest). ZzzObject.cpp:2839-2847 draws three 0.5-scale sprites, at
145:    * bones 2/4/6 - named `light03`/`light02`/`light01` in the BMD, resting at
146:    * (-20.9, -8.7, 138.3), (13.3, -28.6, 138.4) and (24.8, 6.3, 115.1).
147:    *
148:    * One sprite, at their centroid and grown to cover the ~45 MU spread. Three
149:    * each does not fit: 309 of these plants fall inside the 40-tile load
150:    * radius around (44, 98), which is 927 sprites against the 512 the
151:    * `effectLights` manager can hold. Babylon renders the first 512 in
152:    * creation order and silently drops the rest, so *which* plants glow would
153:    * come down to load order - a worse artefact than a slightly rounder glow.
154:    * (The original hits the same wall from the other side: MAX_SPRITES is
155:    * 1000, _define.h:441, and it draws every block on screen rather than a
156:    * radius.) One each puts the peak at ~360 sprites with types 9/17/35/39.
157:    */
158:   // Reduced from 0.9 after seeing it: `createEffectLight` sizes a flare as
159:   // `64 * scale * objectScale / 100` tiles, so 0.9 was a 0.58-tile additive
160:   // disc, and 300 of them at once read as white cotton rather than as a
161:   // fairy-forest glow - they blew past the ground and each other. The
162:   // original's three sprites are 0.5 *of a BITMAP_LIGHT*, a much tighter
163:   // texture than flare01. At 0.3 this is a fifth of the area and stays a
164:   // point of light. If it still crowds the map, this constant is the dial.
165:   1: [lamp([6, -10, 131], 0.3)],
166: 
167:   /** Street lamp (Object10, 14 records): bone 1, scale 1.5 - :2829-2833. */
168:   9: [lamp([-1, 0, 179], 1.5)],
169: 
170:   /**
171:    * The lantern arch by the spawn (Object18, 3 records): bones 4, 7, 10, 13,
172:    * scale 1.0 each - :2848-2858.
173:    */
174:   17: [
175:     lamp([65, -5, 281], 1),
176:     lamp([103, -5, 280], 1),
177:     lamp([165, -5, 281], 1),
178:     lamp([196, -5, 281], 1),
179:   ],
180: 
181:   /**
182:    * Glow shrub (Object36, 228 records): bone 3, scale 1.5 - :2834-2838.
183:    *
184:    * The one type here whose records are not all 1.00 scale (EncTerrain4.obj
185:    * has them from 1.00 to 1.48), and `resolveEmitterPosition` rotates the
186:    * offset but does not scale it, so the largest shrubs carry their glow up
187:    * to ~0.5 tile low. The sprite itself does scale with the object, so this
188:    * reads as the glow sitting a little deep in the foliage rather than as a
189:    * misplaced light.
190:    */
191:   35: [lamp([-23, 0, 110], 1.5)],
192: 
193:   /**
194:    * The blacksmith forge (Object40, one record at (181, 104.5)), the busiest
195:    * object on the map: ZzzObject.cpp:2859-2890.
196:    *
197:    * Not reproduced, for want of a system rather than a decision:
198:    *  - bone 57's two BITMAP_LIGHTNING+1 sprites at +Rotation and -Rotation
199:    *    (`(int)(WorldTime * 0.1f) % 360`). `createEffectLight` draws one
200:    *    flare01 quad with no angle, so the counter-rotating pair collapses to
201:    *    a single steady sprite of the same 1.0 scale and (0.4, 0.8, 1.0) tint.
202:    *  - the 1-in-32 BITMAP_SHINY pair at each of bones 61…65. There is no
203:    *    shiny kind; five independent 1-in-32 rolls average one pair every 6.4
204:    *    ticks, which the hearth's `ember` emission below stands in for at
205:    *    `every: 6`.
206:    *  - `CreateJoint(BITMAP_JOINT_SPARK, …)`, the ribbon trailing each of the
207:    *    eight anvil sparks. The clone has no joint/ribbon system at all; the
208:    *    embers alongside the sparks carry the arc instead.
209:    */
210:   39: [
211:     // bone 57 (light01) - the lightning pair, flattened to one sprite.
212:     lamp([-18, 0, 152], 1, [0.4, 0.8, 1]),
213: 
214:     // bones 61…65 (light06/04/03/05/02) - BITMAP_LIGHT, white, scale 1.
215:     { offset: [-186, -42, 85], sprite: FORGE_GLOW },
216:     {
217:       offset: [-178, 9, 92],
218:       sprite: FORGE_GLOW,
219:       /**
220:        * Stated deviation: Noria has no `AddTerrainLight` anywhere, so this
221:        * ground glow is ours. It is confined to the single forge - one object
222:        * on a 9399-object map - because a smithy whose sparks light nothing
223:        * reads as a prop rather than a fire, and because the cost and the
224:        * clamp argument that rule the light out for the 2500-odd lamps do not
225:        * apply to one instance. Side effect worth knowing: `emitsLight` makes
226:        * `load()` clear `csmCaster`, so the forge stops casting a sun shadow,
227:        * the same trade Lorencia's braziers make.
228:        */
