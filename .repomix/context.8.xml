 1: import { autorun } from 'mobx';
 2: import type { Item } from '../ecs/world';
 3: import { Store } from '../store';
 4: import { InventoryConstants } from '../common/inventoryConstants';
 5: import { Marketplace } from './state';
 6: 
 7: /**
 8:  * The one place the marketplace touches the game.
 9:  *
10:  * `state.ts` deliberately knows nothing about `Store`, so the window can be
11:  * mounted on its own (`marketplace.html`) without the packet layer or the
12:  * world behind it. This module is the adapter: it reads the live Zen and bag
13:  * and pushes them in.
14:  */
15: function bagItems(): Item[] {
16:   const items = Store.playerData.items;
17:   const start = InventoryConstants.EquippableSlotsCount;
18:   const out: Item[] = [];
19:   for (let i = start; i < items.length; i++) {
20:     const item = items[i];
21:     if (item) out.push(item);
22:   }
23:   return out;
24: }
25: 
26: export function syncMarketplaceFromGame(): void {
27:   Marketplace.syncFromGame(Store.playerData.money, bagItems(), Store.playerData.name);
28: }
29: 
30: export function toggleMarketplace(): void {
31:   if (!Marketplace.open) syncMarketplaceFromGame();
32:   Marketplace.toggle();
33: }
34: 
35: // Kept current while the window is open: the trader collecting a listing
36: // takes the item out of the bag, and a purchase changes the wallet. Read
37: // once at opening, both were stale until the window was closed and reopened.
38: autorun(() => {
39:   if (!Marketplace.open) return;
40:   syncMarketplaceFromGame();
41: });
