 27: const RED_LIGHT: readonly [number, number, number] = [1, 0.2, 0];
 28: 
 29: /** `Vector(Luminosity * 0.4f, Luminosity * 0.8f, Luminosity * 1.f, Light)` (ZzzObject.cpp:2904). */
 30: const BLUE_LIGHT: readonly [number, number, number] = [0.4, 0.8, 1];
 31: 
 32: /** Type 19 is the red machine, 20 the blue one (ZzzObject.cpp:2896-2905). */
 33: const RED_MACHINE = 19;
 34: 
 35: /** `Luminosity = (float)(rand() % 30 + 70) * 0.01f` (ZzzObject.cpp:2743). */
 36: const LUMINOSITY_MIN = 0.7;
 37: const LUMINOSITY_STEPS = 30;
 38: const LUMINOSITY_STEP = 0.01;
 39: 
 40: /** Updates to wait for the skeleton to be posed before lighting anyway. */
 41: const POSE_WAIT_LIMIT = 120;
 42: 
 43: /**
 44:  * The two Lost Tower machines (types 19 and 20, `Object5/Object20.glb` and
 45:  * `Object21.glb`; n=14 and n=6 in EncTerrain5.obj). They are the same 22-bone
 46:  * rig in two colours - the red one is powered by `BITMAP_MAGIC + 1`, the blue
 47:  * one by `BITMAP_LIGHTNING + 1` (ZzzObject.cpp:2896-2905) - and they are the
 48:  * only things in the tower that are unambiguously *on*.
 49:  *
 50:  * `MoveObject` gives them `BlendMesh = 4` and the U scroll (both tabled
 51:  * elsewhere); this class is the `RenderObjectVisual` half, which the tables
 52:  * cannot express because the sprites hang off bones and re-roll their
 53:  * brightness every frame.
 54:  *
 55:  * Two things the original does that are not reproduced, both because the
 56:  * clone's flare is a radially symmetric disc (Effect/flare01) rather than the
 57:  * original's directional star and bolt bitmaps:
 58:  *
 59:  *  - Each bone gets *two* sprites, at `+Rotation` and `-Rotation` with
 60:  *    `Rotation = (int)(WorldTime * 0.1f) % 360`. Counter-rotating a
 61:  *    four-pointed star against itself is how the original builds a symmetric,
 62:  *    shimmering flare out of an asymmetric texture; on a disc the rotation is
 63:  *    a no-op and the pair is just the same sprite drawn twice. One sprite per
 64:  *    bone, then - doubling it would only double the additive brightness, and
 65:  *    that is a colour decision, not a fidelity one.
 66:  *  - `Draw_RenderObject` (ZzzObject.cpp:1013-1022) additionally redraws the
 67:  *    body with `StreamMesh = 2`, `BITMAP_CHROME` and `BodyLight` forced to
 68:  *    (1.0, 0.2, 0.1), then lays the normal textured pass over it. The clone
 69:  *    has no per-object chrome pass; that is materials work. The `stream`
 70:  *    half of it - unlit, UV-scrolled - is already handled by
 71:  *    common/meshAnimation.ts.
 72:  *
 73:  * The floor light these throw is in spec.ts: `addTerrainLight` is an x/z
 74:  * footprint and the bones sit straight above the object origin, so anchoring
 75:  * it would move it nowhere the terrain could see.
 76:  */
 77: export class LostTowerMachineObject extends MapTileObject {
 78:   #bones: { node: BoneNode; flare: MovableFlare | null; scale: number }[] = [];
 79:   #color: readonly [number, number, number] = RED_LIGHT;
 80:   #lit = false;
 81:   #waited = 0;
 82:   #disposed = false;
 83: 
 84:   async init(world: World, entity: Entity) {
 85:     await super.init(world, entity);
 86: 
 87:     this.#color = this.Type === RED_MACHINE ? RED_LIGHT : BLUE_LIGHT;
 88: 
 89:     const root = this.gltf?.mesh;
 90:     if (!root) return;
 91: 
 92:     const byBone = new Map<number, BoneNode>();
 93: 
 94:     for (const bone of this.gltf?.skeleton?.bones ?? []) {
 95:       const node = bone.getTransformNode();
 96:       const match = node && /^bone_(\d+)_/.exec(node.name);
 97: 
 98:       if (match) byBone.set(Number(match[1]), node);
 99:     }
100: 
101:     // Not every skeleton hands its bones a linked transform node; walking the
102:     // node graph by name is the same lookup MapTileObject's chandelier fire
103:     // uses, and it is what the converter guarantees (`bone_<i>_<bmdName>`,
104:     // tools/bmdToGlb.ts:283).
105:     if (byBone.size === 0) {
106:       for (const node of root.getDescendants(false)) {
107:         const match = /^bone_(\d+)_/.exec(node.name);
108: 
109:         if (match && 'getAbsolutePosition' in node) {
110:           byBone.set(Number(match[1]), node as BoneNode);
111:         }
112:       }
113:     }
114: 
115:     for (const { bone, scale } of EMITTER_BONES) {
116:       const node = byBone.get(bone);
117:       if (!node) continue;
118: 
119:       this.#bones.push({ node, flare: null, scale });
120:     }
121:   }
122: 
123:   /**
124:    * BMD bone transforms only exist once a render has posed the skeleton, so
125:    * the flares are created from `Update` the first time a bone has left the
126:    * object origin - otherwise all three would spawn stacked at the machine's
127:    * feet and stay there for a frame.
128:    */
129:   #posed(): boolean {
130:     const origin = this.node.getAbsolutePosition();
131: 
132:     for (const { node } of this.#bones) {
133:       const p = node.getAbsolutePosition();
134: 
135:       if (
136:         Math.abs(p.x - origin.x) > 1e-3 ||
137:         Math.abs(p.y - origin.y) > 1e-3 ||
138:         Math.abs(p.z - origin.z) > 1e-3
139:       ) {
140:         return true;
141:       }
142:     }
143: 
144:     return false;
145:   }
146: 
147:   #light(world: World): void {
148:     this.#lit = true;
149: 
150:     const objectScale = this.node.scaling.x;
151: 
152:     for (const emitter of this.#bones) {
153:       void createMovableFlare(
154:         world.scene,
155:         emitter.scale * objectScale,
156:         this.#color
157:       ).then(flare => {
158:         if (!flare) return;
159: 
160:         if (this.#disposed) {
161:           flare.dispose();
162:           return;
163:         }
164: 
165:         const p = emitter.node.getAbsolutePosition();
166:         flare.moveTo(p.x, p.y, p.z);
167: 
168:         emitter.flare = flare;
169:       });
170:     }
171:   }
172: 
173:   dispose(): void {
174:     this.#disposed = true;
175: 
176:     for (const emitter of this.#bones) emitter.flare?.dispose();
177:     this.#bones = [];
178: 
179:     super.dispose();
180:   }
181: 
182:   Update(gameTime: World['gameTime']): void {
183:     super.Update(gameTime);
184: 
185:     if (!this.Ready || this.#bones.length === 0) return;
186: 
187:     const world = Store.world;
188:     if (!world) return;
189: 
190:     if (!this.#lit) {
191:       if (this.#posed() || ++this.#waited >= POSE_WAIT_LIMIT) this.#light(world);
192:       return;
193:     }
194: 
195:     if (this.OutOfView) return;
196: 
197:     // `RenderObjectVisual` re-rolls Luminosity per object per frame, and every
198:     // sprite it creates that frame shares the roll - so the three emitters
199:     // pulse together rather than sparkling independently. One roll here, then.
200:     const lumi =
201:       LUMINOSITY_MIN +
202:       Math.floor(Math.random() * LUMINOSITY_STEPS) * LUMINOSITY_STEP;
203: 
204:     for (const emitter of this.#bones) {
205:       const flare = emitter.flare;
206:       if (!flare) continue;
207: 
208:       const p = emitter.node.getAbsolutePosition();
209: 
210:       flare.moveTo(p.x, p.y, p.z);
211:       flare.setLuminosity(lumi);
212:     }
213:   }
214: }
</file>

