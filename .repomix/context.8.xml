362:     const at = Date.now();
363:     const speaker = this.speaker(sender);
364:     // The optional clock column is ours, and it takes width off the line;
365:     // without it in the budget a timestamped line clips again.
366:     const width =
367:       CHAT_LOG_CLIENT_WIDTH -
368:       (GameOptions.chatTimestamps ? chatTextWidth(`${chatTimestamp(at)} `) : 0);
369: 
370:     const prefix = chatSenderPrefix({ sender, ...speaker });
371:     const parts = splitChatLine(prefix, text, width, chatTextWidth);
