373:     const rows: ChatLine[] = parts.map((part, index) => ({
374:       id: this.nextLineId++,
375:       // `Create(L"", strText2, ...)`: the carried half has no sender.
376:       sender: index === 0 ? sender : '',
377:       ...(index === 0 ? speaker : {}),
378:       continued: index > 0,
379:       text: part,
380:       type,
381:       at,
382:     }));
383: 
384:     const next = this.chatLines.concat(rows);
385:     // `RemoveFrontLine` once MAX_NUMBER_OF_LINES is reached.
386:     this.chatLines =
