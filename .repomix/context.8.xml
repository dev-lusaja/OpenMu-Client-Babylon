66: /**
67:  * `SaveConfig` (NewUIMuHelper.cpp:1095-1116): apply the draft and send
68:  * `MuHelperSaveDataRequest`; the server echoes `MuHelperConfigurationData`.
69:  * Offline the config only applies locally.
70:  */
71: export function saveMuHelperConfig(): void {
72:   const blob = encodeMuHelperConfig(MuHelperState.draft);
73:   runInAction(() => {
74:     MuHelperState.config = decodeMuHelperConfig(blob);
75:     MuHelperState.windowOpen = false;
76:   });
