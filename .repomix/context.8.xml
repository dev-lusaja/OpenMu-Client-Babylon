<file path="src/maps/tarkan/bannerObject.ts">
 1: import { MapTileObject } from '../../common/mapTileObject';
 2: import type { Entity, World } from '../../ecs/world';
 3: 
 4: /**
 5:  * `fSpeed = o->Velocity; if (WorldActive == WD_8TARKAN && o->Type == 8)`
 6:  * `fSpeed *= pow(4.0f, FPS_ANIMATION_FACTOR);` (ZzzObject.cpp:3676-3684).
 7:  *
 8:  * `Velocity` *is* the play speed of a map object - `PlayAnimation` takes it
 9:  * directly, in BMD keys per 25 Hz reference tick, the same units as
10:  * `ModelObject.AnimationSpeed` (common/playSpeed.ts) - and `CreateObject`
11:  * hands every object 0.16 (:4470). `FPS_ANIMATION_FACTOR` is
12:  * `REFERENCE_FPS / FPS` clamped to 1 (ZzzAI.cpp:729), so at the reference
13:  * rate the exponent is 1 and the multiplier is a flat 4. Above 25 fps it
14:  * shrinks toward 1, which is the original compensating for calling
15:  * `PlayAnimation` more often per second; the port advances clips on wall
16:  * clock, so the reference value is the one to use.
17:  *
18:  * 0.16 x 4 = 0.64.
19:  */
20: const BANNER_PLAY_SPEED = 0.64;
21: 
22: /**
23:  * Tarkan 8 (ZzzObject.cpp:3679-3683), ×10 - the cloth banners on the temple
24:  * poles, at scales 0.6 to 1.78. This is the only per-type animation-rate
25:  * override in either map's C++, and it is the difference between cloth
26:  * snapping in a desert wind and cloth stirring underwater.
27:  *
28:  * `setAnimationSpeed` rather than a plain assignment: `MapTileObject.init`
29:  * has already loaded the model, and `loadGLTF` starts clip 0 looping on load
30:  * (modelLoader.ts:471-481), so a plain write to `AnimationSpeed` would only
31:  * reach a `playAction` that never comes for a single-action map object.
32:  */
33: export class TarkanBannerObject extends MapTileObject {
34:   async init(world: World, entity: Entity): Promise<void> {
35:     await super.init(world, entity);
36: 
37:     this.setAnimationSpeed(BANNER_PLAY_SPEED);
38:   }
39: }
</file>

<file path="src/maps/tarkan/create.ts">
 1: import type { World } from '../../ecs/world';
 2: import { TarkanBannerObject } from './bannerObject';
 3: import { TarkanDustBankObject } from './dustBankObject';
 4: import { TarkanGlowLampObject } from './glowLampObject';
 5: import { TarkanImpactGlowObject } from './impactGlowObject';
 6: import { TarkanLightShaftObject } from './lightShaftObject';
 7: import { TarkanQuakeVentObject, TarkanSandVentObject } from './ventObject';
 8: 
 9: /**
10:  * Tarkan (World 9 / `Object9`), the desert. `CreateObject`
11:  * (ZzzObject.cpp:4727-4736) touches exactly one of the 88 types, `MoveObject`
12:  * (:4036-4129) fourteen and `RenderObjectVisual` (:2956-3034) six. The UV
13:  * scrolls and the unphased `BlendMeshLight` sines are in
14:  * `common/meshAnimation.ts`; the blend meshes, the effect-only markers, the
15:  * type 70 emitter and the brazier lights are in `spec.ts`. This file is the
16:  * seven class assignments and the notes.
17:  *
18:  * Type identities, from EncTerrain9.obj and the models: 1/5 giant buried
19:  * hands, 2 scrolling frieze, 7 red glow lamp, 8 flapping banner, 11/12/13 and
20:  * 72/73/75/79 the sand-falls, 14/54 giant buried faces, 15-19 palm and dead
21:  * trees, 52/55/58/59 sarcophagi, 60 dust bank, 61/65 braziers, 63 impact
22:  * glow, 68/69/71/74 giant statues, 70/76/83 dust vents, 78 sit object, 82
23:  * light shaft, 85-87 later-season props with no code behind them.
24:  *
25:  * **`Object9` has holes**: no `Object01/04/05/35/36/39/65/85`, so types 0, 3,
26:  * 4, 34, 35, 38, 64 and 84 have no model. Two of them carry C++ behaviour
27:  * that can therefore never run - type 4's blend mesh, V scroll and white
28:  * range-3 terrain light (:4044-4057), and type 64, the red twin of the type
29:  * 63 impact glow (:2978-2986). Both are no-ops here. EncTerrain9.obj still
30:  * places one type 4 and two type 0 records; their loads fail and are logged.
31:  *
32:  * **Not implemented, deliberately:**
33:  *
34:  *  - **The sandstorm overlay.** `ZzzInterface.cpp:8463` draws two
35:  *    full-screen scrolling `sand01`/`sand02` layers tinted `(0.3, 0.3, 0.25)`
36:  *    over everything in this world. It is the single loudest thing about
37:  *    Tarkan and it is a screen-space pass, not an object - UI/post work.
38:  *  - **The terrain wind and water rates.** Tarkan runs the terrain's wind
39:  *    oscillation ten times faster (`ZzzLodTerrain.cpp:2411`) and its
40:  *    `WaterMove` at half rate - a 40 s loop instead of 20 s (:2615). Both are
41:  *    per-world constants inside the terrain, not map objects.
42:  *  - **Scorpion boids** (`Object9/Bug02.glb` is placed by the boid code, not
43:  *    by EncTerrain9.obj - which is why it has no type number).
44:  *  - **The Dinorant `+90` height.** `ZzzCharacter.cpp:6263-6273` lifts a
45:  *    Dinorant rider by 90 rather than 30 in Tarkan and Heaven; that is
46:  *    `ModelObject.HoverHeight` on the *player*, set from the map.
47:  *  - **Type 81's chrome pass.** `Draw_RenderObject` (:1034) renders the two
48:  *    81s twice, the second time with `RENDER_CHROME5` over `BITMAP_CHROME2`.
49:  *    The port has no per-object chrome pass; materials work, and the
50:  *    same note already stands on Lost Tower 3/4 in `meshAnimation.ts`.
51:  *
52:  * Music (`Music/tarkan`) and the `Sound/desert` ambient bed are wired
53:  * elsewhere.
54:  */
55: export async function createTarkan(world: World) {
56:   const terrain = world.terrain;
57:   if (!terrain) return;
58: 
59:   const tiles = terrain.MapTileObjects;
60: 
61:   // Tarkan 7 (ZzzObject.cpp:4058-4069), x98: the red glow lamp. Blend mesh
62:   // and terrain light both pulse on a sine phased by the lamp's own yaw,
63:   // which no shared table can express.
64:   tiles[7] = TarkanGlowLampObject;
65: 
66:   // Tarkan 8 (ZzzObject.cpp:3679-3683), x10: the banner, at 4x play speed.
67:   tiles[8] = TarkanBannerObject;
68: 
69:   // Tarkan 60 (ZzzObject.cpp:2959-2969), x82: a one-shot burst of 20 dust
70:   // puffs, then hidden forever. Effect-only (spec.ts), so the class is all
71:   // there is of it.
72:   tiles[60] = TarkanDustBankObject;
73: 
74:   // Tarkan 63 (ZzzObject.cpp:2971-2977), x18: model loaded, body hidden,
75:   // a pulsing glow hung off bone 2 of the skeleton it never draws.
76:   tiles[63] = TarkanImpactGlowObject;
77: 
78:   // Tarkan 76 (ZzzObject.cpp:2996-3007), x19, and 83 (:3008-3033), x10: the
79:   // two windowed dust vents. Both effect-only; 83 phases its window by yaw.
80:   tiles[76] = TarkanSandVentObject;
81:   tiles[83] = TarkanQuakeVentObject;
82: 
83:   // Tarkan 82 (ZzzObject.cpp:4123-4127), x60: the light shaft, pinned to full
84:   // white rather than lit by the terrain it stands on.
85:   tiles[82] = TarkanLightShaftObject;
86: 
87:   // Tarkan 78 (ZzzObject.cpp:4730-4734), x13 - the sittable step, and the
88:   // only type in the map's `CreateObject` case. It is `CreateOperate(o)` and
89:   // nothing else: no `HiddenMesh`, no `BoundingBoxMax` override, so unlike
90:   // Atlans 39 the model draws normally and keeps the default
91:   // `(-40,-40,0)…(40,40,80)` pick box. `libs/mu/restObjects.ts` already maps
92:   // World 9 type 78 to `sit(false)` and `RestObjectSystem` reads that from
93:   // the entity's `modelId`, so the click behaviour is wired without a class.
94:   // The default `MapTileObject` is the whole of the visible behaviour, and a
95:   // subclass that only re-loaded `Object79.glb` would be a class that does
96:   // nothing.
97: }
</file>

<file path="src/maps/tarkan/dustBankObject.ts">
  1: import { MapTileObject } from '../../common/mapTileObject';
  2: import { spawnParticle } from '../../common/effectParticles';
  3: import type { Scene } from '../../libs/babylon/exports';
  4: import type { Entity, World } from '../../ecs/world';
  5: 
  6: /** `for (int i = 0; i < 20; ++i) CreateParticleFpsChecked(...)` (ZzzObject.cpp:2962). */
  7: const BURST_COUNT = 20;
  8: 
  9: /**
 10:  * `Luminosity = 0.6f; Vector(L*0.6, L*0.5, L*0.4, o->Light)`
 11:  * (ZzzEffectParticle.cpp:5416) - the SubType 6 dust colour, fixed, ignoring
 12:  * whatever light was passed in.
 13:  */
 14: const DUST_LIGHT: readonly [number, number, number] = [0.36, 0.3, 0.24];
 15: 
 16: /**
 17:  * `cloud21` sizes itself `(rand(20) + 180) * 0.01 * scale` off a 256 px
 18:  * texture; SubType 6 sizes itself `(rand%20+180)*0.01` off a 64 px one and
 19:  * then oscillates between 1.3 and 2.3 (:5414). Matching the *world* size -
 20:  * ~1.3 tiles across - means scaling the bigger texture down by 64/256 and a
 21:  * little more for the oscillation midpoint. Without this the bank would be
 22:  * five tiles wide per sprite, twenty sprites deep, and would cost more fill
 23:  * rate than the rest of the map together.
 24:  */
 25: const CLOUD_SCALE = 0.27;
 26: 
 27: /**
 28:  * Tarkan 60 (ZzzObject.cpp:2959-2969), ×82 - the low dust banks that sit in
 29:  * the hollows all over the desert, at scales 0.74 to ~1.3.
 30:  *
 31:  * ```cpp
 32:  * case 60:
 33:  *     if (o->HiddenMesh != -2)
 34:  *         for (int i = 0; i < 20; ++i)
 35:  *             CreateParticleFpsChecked(BITMAP_SMOKE, o->Position, o->Angle, o->Light, 6, o->Scale);
 36:  *     o->HiddenMesh = -2;
 37:  *     break;
 38:  * ```
 39:  *
 40:  * A one-shot: 20 puffs the first frame the object is drawn, then hidden for
 41:  * good. That reads like a burst and is not one - SubType 6 puffs are
 42:  * **immortal**. Their move case re-pins `o->LifeTime = 10` every frame
 43:  * (ZzzEffectParticle.cpp:5411) and only bobs them:
 44:  * `Position[2] = Rotation + sin((WorldTime + Gravity) / 5000) * 20` with a
 45:  * per-sprite `Gravity` phase, scale breathing on a 3 minute period. So the
 46:  * original spends 20 particles, once, to build a permanent patch of ground
 47:  * haze about two tiles wide, and never touches it again.
 48:  *
 49:  * **Two divergences, both forced by there being no immortal kind to spawn.**
 50:  * `cloud21` is the closest available - its `init` is nearly SubType 6's
 51:  * (`px/py += rand(200) - 100`, scale `(rand(20)+180)*0.01`, tinted by the
 52:  * passed light) - but it lives 100 ticks and then dies, so our bank fades
 53:  * after ~4 s instead of standing forever. And because the marker is
 54:  * effect-only (meshless), it is never `OutOfView`, so the burst fires when
 55:  * the object enters the 32-tile load radius rather than when it is first
 56:  * *rendered* - dust can appear behind the camera. A `smoke6` kind fixes the
 57:  * first and makes the second harmless:
 58:  *
 59:  * ```ts
 60:  * smoke6: {
 61:  *   texture: 'smoke',
 62:  *   blend: 'add',
 63:  *   init(p, scale) {
 64:  *     p.lifeTime = 10;
 65:  *     p.gravity = rand(1000);          // per-sprite phase, ms
 66:  *     p.scale = (rand(20) + 180) * 0.01;
 67:  *     p.px += (rand(200) - 100) * scale;
 68:  *     p.py += (rand(200) - 100) * scale;
 69:  *     p.pz += rand(20) + 20;
 70:  *     p.angleZ = p.pz;                 // base height; velocity is zero here,
 71:  *     p.rotation = rand(360);          // so angleZ is free (the original
 72:  *   },                                 // parks it in Rotation and spins)
 73:  *   update(p, _f, t) {
 74:  *     p.lifeTime = 10;                 // pinned: these never expire
 75:  *     p.pz = p.angleZ + Math.sin((t + p.gravity) / 5000) * 20;
 76:  *     p.scale =
 77:  *       Math.sin((((p.gravity + t) % 1800) * 0.1 * Math.PI) / 180) * 0.5 + 1.8;
 78:  *     p.lr = 0.36; p.lg = 0.3; p.lb = 0.24;
 79:  *   },
 80:  *   color: plainColor,
 81:  * } satisfies ParticleKind,
 82:  * ```
 83:  *
 84:  * Note that an immortal kind needs a disposal story the pool does not have
 85:  * today (nothing frees a particle that never dies), which is the other reason
 86:  * it is not being smuggled in here.
 87:  */
 88: export class TarkanDustBankObject extends MapTileObject {
 89:   #scene: Scene | null = null;
 90: 
 91:   #burned = false;
 92: 
 93:   async init(world: World, entity: Entity): Promise<void> {
 94:     await super.init(world, entity);
 95: 
 96:     this.#scene = world.scene;
 97:   }
 98: 
 99:   dispose(): void {
100:     this.#scene = null;
101:     super.dispose();
102:   }
103: 
104:   Update(gameTime: World['gameTime']): void {
105:     super.Update(gameTime);
106: 
107:     const scene = this.#scene;
108: 
109:     if (this.#burned || !scene) return;
110: 
111:     // `o->HiddenMesh = -2` runs whether or not the burst did, so the flag is
112:     // set before the spawn loop, not after it: one burst per lifetime of the
113:     // object, exactly as in the C++.
114:     this.#burned = true;
115: 
116:     const scale = this.node.scaling.x * CLOUD_SCALE;
117: 
118:     for (let i = 0; i < BURST_COUNT; i++) {
119:       void spawnParticle(
120:         scene,
121:         'cloud21',
122:         this.node.position,
123:         this.node.rotation.y,
124:         scale,
125:         DUST_LIGHT
126:       );
127:     }
128:   }
129: }
</file>

<file path="src/maps/tarkan/glowLampObject.ts">
 1: import { MapTileObject } from '../../common/mapTileObject';
 2: import {
 3:   lightMapObjectWith,
 4:   tarkanGlowLamp,
 5: } from '../../lighting/mapObjectLights';
 6: import type { LightSource } from '../../lighting/lightSource';
 7: import type { AbstractMesh } from '../../libs/babylon/exports';
 8: import type { Entity, World } from '../../ecs/world';
 9: 
10: /**
11:  * `sinf((WorldTime + (o->Angle[2] * 100)) * 0.002f) * 0.35f + 0.65f`
12:  * (ZzzObject.cpp:4060). One sine, used twice: as the lamp's own
13:  * `BlendMeshLight` and as the luminosity of its terrain light.
14:  *
15:  * The `* 100` is the whole reason this is a class. `o->Angle[2]` is the map
16:  * record's yaw in degrees, so each lamp's sine is offset by its own
17:  * orientation - EncTerrain9.obj gives type 7 eighteen distinct yaws between
18:  * -660 deg and +330 deg, i.e. offsets from -66 s to +33 s against a 3.14 s
19:  * period. The 98 lamps pulse out of step with each other, which is what the
20:  * `phase` on the recipe's pulse carries (`tarkanGlowLamp` in the lighting
21:  * layer's map-object table); the table in `meshAnimation.ts` cannot express
22:  * it, because it builds its functions from `WorldTime` alone.
23:  */
24: const PHASE_MS_PER_DEGREE = 100;
25: 
26: const DEGREES_PER_RADIAN = 180 / Math.PI;
27: 
28: /**
29:  * Tarkan 7 (ZzzObject.cpp:4058-4069), ×98 - the red glow lamp that lines the
30:  * temple approaches and the sunken stairs, at scales from 0.12 to 1.5. The
31:  * densest cluster (7.7/229.9) has 27 inside the 32-tile load radius, all
32:  * pulsing on different phases.
33:  *
34:  * The terrain colour `(L, L*0.6, L*0.2)` is the same warm ramp the braziers
35:  * use; the lamp reads red because `redB.jpg` on its blend mesh is red, not
36:  * because the light is.
37:  */
38: export class TarkanGlowLampObject extends MapTileObject {
39:   #blendMesh: AbstractMesh | null = null;
40: 
41:   #source: LightSource | null = null;
42: 
43:   async init(world: World, entity: Entity): Promise<void> {
44:     // `entity.transform.rot.y` is `toRadians(Angle[2])` straight off the map
45:     // record (loadMapIntoScene.createObjects). Not `node.rotation.y`: that
46:     // has been through `toRenderAngles`, which mirrors the yaw for the
47:     // left-handed scene and would phase every lamp backwards.
48:     const yawDegrees = (entity.transform?.rot.y ?? 0) * DEGREES_PER_RADIAN;
49:     const phaseMs = yawDegrees * PHASE_MS_PER_DEGREE;
50: 
51:     await super.init(world, entity);
52: 
53:     this.#blendMesh = this.getMesh(this.BlendMesh) ?? null;
54: 
55:     this.#source = lightMapObjectWith(
56:       world.scene,
57:       tarkanGlowLamp(phaseMs),
58:       this.node.position
59:     );
60:   }
61: 
62:   dispose(): void {
63:     this.#source?.dispose();
64:     this.#source = null;
65:     this.#blendMesh = null;
66: 
67:     super.dispose();
68:   }
69: 
70:   Update(gameTime: World['gameTime']): void {
71:     super.Update(gameTime);
72: 
73:     // `metadata.blendMeshLight` is what `bindBodyLight` multiplies the body
74:     // light by (itemMaterial.ts:285-297) - the port's `BlendMeshLight`. The
75:     // light's red channel *is* the sine (colour `(L, 0.6L, 0.2L)`), so the
76:     // mesh reads it from the source and the two can never drift apart. Off
77:     // screen only the mesh write is skipped, because a terrain light behind
78:     // the camera still lights tiles the camera sees.
79:     if (this.OutOfView || !this.#blendMesh?.metadata || !this.#source) return;
80: 
81:     this.#blendMesh.metadata.blendMeshLight = this.#source.color.r;
82:   }
83: }
</file>

<file path="src/maps/tarkan/impactGlowObject.ts">
  1: import { MapTileObject } from '../../common/mapTileObject';
  2: import { HIDDEN_MESH_ALL } from '../../common/modelObject';
  3: import { createMovableFlare, type MovableFlare } from '../../common/effectLights';
  4: import type { TransformNode } from '../../libs/babylon/exports';
  5: import type { Entity, World } from '../../ecs/world';
  6: 
  7: /**
  8:  * `Luminosity = sinf((WorldTime + (o->Angle[2] * 5)) * 0.002f) * 0.3f + 0.7f;`
  9:  * (ZzzObject.cpp:2972). Same shape as the type 7 lamp but shallower - 0.4 to
 10:  * 1.0 - and phased by the object's own yaw twenty times more weakly
 11:  * (`* 5` rather than `* 100`), so the 18 glows drift apart by up to a second
 12:  * rather than by half a minute.
 13:  */
 14: const RATE = 0.002;
 15: const AMPLITUDE = 0.3;
 16: const BASE = 0.7;
 17: const PHASE_MS_PER_DEGREE = 5;
 18: 
 19: const DEGREES_PER_RADIAN = 180 / Math.PI;
 20: 
 21: /**
 22:  * `Vector(Luminosity / 1.7f, Luminosity, Luminosity, Light)` (:2975) - a
 23:  * cyan-white, held here as the unit colour with the luminosity applied by
 24:  * `setLuminosity`.
 25:  */
 26: const GLOW_COLOR: readonly [number, number, number] = [1 / 1.7, 1, 1];
 27: 
 28: /**
 29:  * `Scale = Luminosity * 1.5f` (:2974). `MovableFlare` fixes a sprite's size
 30:  * at creation and only its colour can be changed afterwards, so the sprite is
 31:  * built at the mid-luminosity size and the pulse is carried entirely by
 32:  * brightness. Against an additive sprite the two read almost the same; a
 33:  * resizable flare would be a change to `effectLights`, not to this map.
 34:  */
 35: const FLARE_SCALE = 1.5 * BASE;
 36: 
 37: /** `b->TransformPosition(BoneTransform[2], p, Position)` (:2976). */
 38: const BONE_PREFIX = 'bone_2_';
 39: 
 40: /**
 41:  * Tarkan 63 (ZzzObject.cpp:2971-2977 with :4092-4094), ×18 - the pale glows
 42:  * on the temple faces and inside the sunken arches, at scales 0.69 to 1.55.
 43:  *
 44:  * `MoveObject` sets `o->HiddenMesh = -2`, so `Object64.glb` is loaded,
 45:  * animated and never drawn; `RenderObjectVisual` then hangs a `BITMAP_IMPACT`
 46:  * sprite off bone 2 of that invisible skeleton every frame. That is why this
 47:  * type is *not* in `TARKAN_EFFECT_ONLY_TYPES` - the effect-only path skips
 48:  * the model load, and without the model there is no bone 2 and no position
 49:  * for the sprite. `Object64.glb` carries exactly three bones
 50:  * (`bone_0_Box01`, `bone_1_Bone01`, `bone_2_Bone02`) and one clip.
 51:  *
 52:  * Two knowing substitutions: the sprite is `Effect/flare01.OZJ` (the shared
 53:  * flare the port's effect lights use) rather than `Object9/Impack03.jpg`,
 54:  * because `createMovableFlare` is the only movable-sprite primitive there is;
 55:  * and no light of any kind is registered, because the original registers
 56:  * none - 63 calls `CreateSprite`, never `AddTerrainLight`.
 57:  */
 58: export class TarkanImpactGlowObject extends MapTileObject {
 59:   #phaseMs = 0;
 60: 
 61:   #bone: TransformNode | null = null;
 62: 
 63:   #flare: MovableFlare | null = null;
 64: 
 65:   #disposed = false;
 66: 
 67:   async init(world: World, entity: Entity): Promise<void> {
 68:     // Set before the load: `ModelObject.load` runs `applyWholeBodyHide` at
 69:     // the end (modelObject.ts:730), so the meshes leave the render list the
 70:     // moment they arrive instead of flashing for a frame.
 71:     this.HiddenMesh = HIDDEN_MESH_ALL;
 72: 
 73:     // Raw map yaw in degrees; see the note in glowLampObject.ts on why this
 74:     // comes off the entity rather than off `node.rotation`.
 75:     this.#phaseMs =
 76:       (entity.transform?.rot.y ?? 0) * DEGREES_PER_RADIAN * PHASE_MS_PER_DEGREE;
 77: 
 78:     await super.init(world, entity);
 79: 
 80:     const bone = this.gltf?.mesh
 81:       .getDescendants(false)
 82:       .find(node => node.name.startsWith(BONE_PREFIX));
 83: 
 84:     this.#bone =
 85:       bone && 'getAbsolutePosition' in bone ? (bone as TransformNode) : null;
 86: 
 87:     const flare = await createMovableFlare(
 88:       world.scene,
 89:       FLARE_SCALE * this.node.scaling.x,
 90:       GLOW_COLOR
 91:     );
 92: 
 93:     if (!flare) return;
 94: 
 95:     if (this.#disposed) {
 96:       flare.dispose();
 97:       return;
 98:     }
 99: 
100:     this.#flare = flare;
101:   }
102: 
103:   dispose(): void {
104:     this.#disposed = true;
105:     this.#flare?.dispose();
106:     this.#flare = null;
107:     this.#bone = null;
108: 
109:     super.dispose();
110:   }
111: 
112:   Update(gameTime: World['gameTime']): void {
113:     super.Update(gameTime);
114: 
115:     const flare = this.#flare;
116:     if (!flare) return;
117: 
118:     const elapsedMs = gameTime.TotalGameTime.TotalSeconds * 1000;
119:     const lumi = Math.sin((elapsedMs + this.#phaseMs) * RATE) * AMPLITUDE + BASE;
120: 
121:     flare.setLuminosity(lumi);
122: 
123:     const anchor = this.#bone;
124: 
125:     if (anchor) {
126:       // The body is hidden, so Babylon never walks this branch of the graph
127:       // for rendering and the bone's absolute position would stay at whatever
128:       // the last active-mesh pass left. Forcing the recompute is what makes
129:       // the glow follow the clip instead of sitting at the object origin.
130:       anchor.computeWorldMatrix(true);
131: 
132:       const p = anchor.getAbsolutePosition();
133:       flare.moveTo(p.x, p.y, p.z);
134:     } else {
135:       const p = this.node.position;
136:       flare.moveTo(p.x, p.y, p.z);
137:     }
138:   }
139: }
</file>

