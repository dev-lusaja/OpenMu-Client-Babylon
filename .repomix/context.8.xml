<file path="src/muHelper/config.ts">
  1: /**
  2:  * MU Helper config domain model and the 257-byte blob codec.
  3:  *
  4:  * The layout is `PRECEIVE_MUHELPER_DATA` (WSclient.h:3592-3642, pack(1),
  5:  * MSVC bitfields = LSB first) as written by `ConfigDataSerDe`
  6:  * (MuHelperData.cpp). OpenMU stores the blob opaquely, so this layout is the
  7:  * client-to-client contract: a config saved by the reference client decodes
  8:  * here and vice versa. The C++ struct covers bytes 0-244; OpenMU's field is
  9:  * 257 bytes, the tail stays zero.
 10:  */
 11: 
 12: export const MU_HELPER_BLOB_SIZE = 257;
 13: 
 14: export const MAX_HUNTING_RANGE = 6;
 15: export const MAX_OBTAINING_RANGE = 8;
 16: export const MAX_EXTRA_ITEMS = 12;
 17: /** 15-byte ANSI slots, NUL-terminated: 14 usable characters. */
 18: export const MAX_EXTRA_ITEM_CHARS = 14;
 19: 
 20: export type SkillConditionBasis = 'nearby' | 'attacking';
 21: 
 22: /** Activation rule of skill slot 2 / 3 (`ESkillActivation*`, MuHelperData.h). */
 23: export interface ActivationCondition {
 24:   /** `ON_TIMER`: cast every `interval` seconds. */
 25:   onTimer: boolean;
 26:   /** `ON_CONDITION`: cast by mob count. */
 27:   onCondition: boolean;
 28:   /** `ON_MOBS_NEARBY` vs `ON_MOBS_ATTACKING`. */
 29:   basis: SkillConditionBasis;
 30:   /** `ON_MORE_THAN_*`: at least this many mobs (2-5). */
 31:   minMobs: number;
 32: }
 33: 
 34: export type DarkRavenMode = 0 | 1 | 2; // cease / auto / together
 35: 
 36: export interface MuHelperConfig {
 37:   huntingRange: number;
 38:   longRangeCounterAttack: boolean;
 39:   returnToOriginalPosition: boolean;
 40:   maxSecondsAway: number;
 41: 
 42:   /** [basic, activation 1, activation 2] wire skill numbers, 0 = empty. */
 43:   skills: [number, number, number];
 44:   /** Timer intervals in seconds; index 0 unused. */
 45:   skillIntervals: [number, number, number];
 46:   /** Conditions; index 0 unused. */
 47:   skillConditions: [ActivationCondition, ActivationCondition, ActivationCondition];
 48:   useCombo: boolean;
 49: 
 50:   buffs: [number, number, number];
 51:   /** Recast only when the buff dropped (vs on the interval timer). */
 52:   buffDuration: boolean;
 53:   buffDurationParty: boolean;
 54:   buffCastInterval: number;
 55: 
 56:   autoHeal: boolean;
 57:   healThreshold: number;
 58:   supportParty: boolean;
 59:   autoHealParty: boolean;
 60:   healPartyThreshold: number;
 61: 
 62:   useHealPotion: boolean;
 63:   potionThreshold: number;
 64:   useDrainLife: boolean;
 65: 
 66:   useDarkRaven: boolean;
 67:   darkRavenMode: DarkRavenMode;
 68: 
 69:   repairItem: boolean;
 70: 
 71:   obtainRange: number;
 72:   pickAllItems: boolean;
 73:   pickSelectedItems: boolean;
 74:   pickJewel: boolean;
 75:   pickZen: boolean;
 76:   pickAncient: boolean;
 77:   pickExcellent: boolean;
 78:   pickExtraItems: boolean;
 79:   extraItems: string[];
 80: }
 81: 
 82: export function defaultActivationCondition(): ActivationCondition {
 83:   return { onTimer: false, onCondition: false, basis: 'nearby', minMobs: 2 };
 84: }
 85: 
 86: /** `CNewUIMuHelper::Reset` (NewUIMuHelper.cpp:971-1012). */
 87: export function defaultMuHelperConfig(): MuHelperConfig {
 88:   return {
 89:     huntingRange: 6,
 90:     longRangeCounterAttack: false,
 91:     returnToOriginalPosition: true,
 92:     maxSecondsAway: 10,
 93:     skills: [0, 0, 0],
 94:     skillIntervals: [0, 0, 0],
 95:     skillConditions: [
 96:       defaultActivationCondition(),
 97:       defaultActivationCondition(),
 98:       defaultActivationCondition(),
 99:     ],
100:     useCombo: false,
101:     buffs: [0, 0, 0],
102:     buffDuration: true,
103:     buffDurationParty: true,
104:     buffCastInterval: 0,
105:     autoHeal: false,
106:     healThreshold: 60,
107:     supportParty: false,
108:     autoHealParty: false,
109:     healPartyThreshold: 60,
110:     useHealPotion: false,
111:     potionThreshold: 40,
112:     useDrainLife: false,
113:     useDarkRaven: false,
114:     darkRavenMode: 0,
115:     repairItem: false,
116:     obtainRange: 8,
117:     pickAllItems: false,
118:     pickSelectedItems: false,
119:     pickJewel: false,
120:     pickZen: false,
121:     pickAncient: false,
122:     pickExcellent: false,
123:     pickExtraItems: false,
124:     extraItems: [],
125:   };
126: }
127: 
128: const bit = (v: boolean, n: number) => (v ? 1 << n : 0);
129: const nib = (v: number) => v & 0x0f;
130: 
131: /** A name fits a slot when every char survives the ANSI narrowing. */
132: function extraItemBytes(name: string): number[] | null {
133:   const trimmed = name.slice(0, MAX_EXTRA_ITEM_CHARS);
134:   const bytes: number[] = [];
135:   for (let i = 0; i < trimmed.length; i++) {
136:     const code = trimmed.charCodeAt(i);
137:     // wcstombs fails on non-ANSI input and the C++ zeroes the slot.
138:     if (code === 0 || code > 0xff) return null;
139:     bytes.push(code);
140:   }
141:   return bytes;
142: }
143: 
144: export function encodeMuHelperConfig(config: MuHelperConfig): Uint8Array {
145:   const out = new Uint8Array(MU_HELPER_BLOB_SIZE);
146:   const view = new DataView(out.buffer);
147: 
148:   out[1] =
149:     bit(config.pickJewel, 3) |
150:     // The C++ Serialize writes this bit from pickAll (MuHelperData.cpp:122,
151:     // a bug); Deserialize reads it as the ancient filter, so the intent wins.
152:     bit(config.pickAncient, 4) |
153:     bit(config.pickExcellent, 5) |
154:     bit(config.pickZen, 6) |
155:     bit(config.pickExtraItems, 7);
156:   out[2] = nib(config.huntingRange) | (nib(config.obtainRange) << 4);
157:   view.setUint16(3, config.maxSecondsAway & 0x0f, true);
158: 
159:   view.setUint16(5, config.skills[0] & 0xffff, true);
160:   view.setUint16(7, config.skills[1] & 0xffff, true);
161:   view.setUint16(9, config.skillIntervals[1] & 0xffff, true);
162:   view.setUint16(11, config.skills[2] & 0xffff, true);
163:   view.setUint16(13, config.skillIntervals[2] & 0xffff, true);
164:   view.setUint16(15, config.buffCastInterval & 0xffff, true);
165:   view.setUint16(17, config.buffs[0] & 0xffff, true);
166:   view.setUint16(19, config.buffs[1] & 0xffff, true);
167:   view.setUint16(21, config.buffs[2] & 0xffff, true);
168: 
169:   out[23] =
170:     nib(Math.trunc(config.potionThreshold / 10)) |
171:     (nib(Math.trunc(config.healThreshold / 10)) << 4);
172:   // High nibble (`HPStatusDrainLife`) mirrors the heal threshold on write
173:   // and is ignored on read, like the reference serializer.
174:   out[24] =
175:     nib(Math.trunc(config.healPartyThreshold / 10)) |
176:     (nib(Math.trunc(config.healThreshold / 10)) << 4);
177: 
178:   out[25] =
179:     bit(config.useHealPotion, 0) |
180:     bit(config.autoHeal, 1) |
181:     bit(config.useDrainLife, 2) |
182:     bit(config.longRangeCounterAttack, 3) |
183:     bit(config.returnToOriginalPosition, 4) |
184:     bit(config.useCombo, 5) |
185:     bit(config.supportParty, 6) |
186:     bit(config.autoHealParty, 7);
187: 
188:   const cond1 = config.skillConditions[1];
189:   const cond2 = config.skillConditions[2];
190:   const subCon = (c: ActivationCondition) =>
191:     Math.min(3, Math.max(0, c.minMobs - 2));
192: 
193:   out[26] =
194:     bit(config.buffDurationParty, 0) |
195:     bit(config.useDarkRaven, 1) |
196:     bit(config.buffDuration, 2) |
197:     bit(cond1.onTimer, 3) |
198:     bit(cond1.onCondition, 4) |
199:     bit(cond1.basis === 'attacking', 5) |
200:     (subCon(cond1) << 6);
201: 
202:   out[27] =
203:     bit(cond2.onTimer, 0) |
204:     bit(cond2.onCondition, 1) |
205:     bit(cond2.basis === 'attacking', 2) |
206:     (subCon(cond2) << 3) |
207:     bit(config.repairItem, 5) |
208:     bit(config.pickAllItems, 6) |
209:     bit(config.pickSelectedItems, 7);
210: 
211:   out[28] = config.darkRavenMode & 0xff;
212: 
213:   for (let slot = 0; slot < MAX_EXTRA_ITEMS; slot++) {
214:     const name = config.extraItems[slot];
215:     if (!name) continue;
216:     const bytes = extraItemBytes(name);
217:     if (!bytes) continue;
218:     out.set(bytes, 65 + slot * 15);
219:   }
220: 
221:   return out;
222: }
223: 
224: function decodeCondition(byte: number, shift: number): ActivationCondition {
225:   const bits = byte >> shift;
226:   return {
227:     onTimer: (bits & 0x01) !== 0,
228:     onCondition: (bits & 0x02) !== 0,
229:     basis: (bits & 0x04) !== 0 ? 'attacking' : 'nearby',
230:     minMobs: ((bits >> 3) & 0x03) + 2,
231:   };
232: }
233: 
234: export function decodeMuHelperConfig(blob: Uint8Array): MuHelperConfig {
235:   const config = defaultMuHelperConfig();
236:   if (blob.length < 245) return config;
237:   const view = new DataView(blob.buffer, blob.byteOffset, blob.byteLength);
238: 
239:   config.pickJewel = (blob[1] & 0x08) !== 0;
240:   config.pickAncient = (blob[1] & 0x10) !== 0;
241:   config.pickExcellent = (blob[1] & 0x20) !== 0;
242:   config.pickZen = (blob[1] & 0x40) !== 0;
243:   config.pickExtraItems = (blob[1] & 0x80) !== 0;
244: 
245:   config.huntingRange = blob[2] & 0x0f;
246:   config.obtainRange = (blob[2] >> 4) & 0x0f;
247:   config.maxSecondsAway = view.getUint16(3, true);
248: 
249:   config.skills = [
250:     view.getUint16(5, true),
251:     view.getUint16(7, true),
252:     view.getUint16(11, true),
253:   ];
254:   config.skillIntervals = [
255:     0,
256:     view.getUint16(9, true),
257:     view.getUint16(13, true),
258:   ];
259:   config.buffCastInterval = view.getUint16(15, true);
260:   config.buffs = [
261:     view.getUint16(17, true),
262:     view.getUint16(19, true),
263:     view.getUint16(21, true),
264:   ];
265: 
266:   config.potionThreshold = (blob[23] & 0x0f) * 10;
267:   config.healThreshold = ((blob[23] >> 4) & 0x0f) * 10;
268:   config.healPartyThreshold = (blob[24] & 0x0f) * 10;
269: 
270:   config.useHealPotion = (blob[25] & 0x01) !== 0;
271:   config.autoHeal = (blob[25] & 0x02) !== 0;
272:   config.useDrainLife = (blob[25] & 0x04) !== 0;
273:   config.longRangeCounterAttack = (blob[25] & 0x08) !== 0;
274:   config.returnToOriginalPosition = (blob[25] & 0x10) !== 0;
275:   config.useCombo = (blob[25] & 0x20) !== 0;
276:   config.supportParty = (blob[25] & 0x40) !== 0;
277:   config.autoHealParty = (blob[25] & 0x80) !== 0;
278: 
279:   config.buffDurationParty = (blob[26] & 0x01) !== 0;
280:   config.useDarkRaven = (blob[26] & 0x02) !== 0;
281:   config.buffDuration = (blob[26] & 0x04) !== 0;
282:   config.skillConditions = [
283:     defaultActivationCondition(),
284:     decodeCondition(blob[26], 3),
285:     decodeCondition(blob[27], 0),
286:   ];
287: 
288:   config.repairItem = (blob[27] & 0x20) !== 0;
289:   config.pickAllItems = (blob[27] & 0x40) !== 0;
290:   config.pickSelectedItems = (blob[27] & 0x80) !== 0;
291: 
292:   const raven = blob[28];
293:   config.darkRavenMode = raven === 1 || raven === 2 ? raven : 0;
294: 
295:   config.extraItems = [];
296:   for (let slot = 0; slot < MAX_EXTRA_ITEMS; slot++) {
297:     const from = 65 + slot * 15;
298:     let name = '';
299:     for (let i = 0; i < 15; i++) {
300:       const code = blob[from + i];
301:       if (!code) break;
302:       name += String.fromCharCode(code);
303:     }
304:     if (name) config.extraItems.push(name);
305:   }
306: 
307:   return config;
308: }
</file>

<file path="src/muHelper/state.ts">
 1: import { observable, reaction, runInAction } from 'mobx';
 2: import { Store } from '../store';
 3: import { MuHelperSaveDataRequestPacket } from '../common/packets/ClientToServerPackets';
 4: import {
 5:   decodeMuHelperConfig,
 6:   defaultMuHelperConfig,
 7:   encodeMuHelperConfig,
 8:   type MuHelperConfig,
 9: } from './config';
10: 
11: /**
12:  * MU Helper state: the live config the loop follows and the window's draft.
13:  * Single writer of both; `logic.ts` keeps landing the raw blob in
14:  * `Store.muHelper.config` and a reaction decodes it here (the deferred
15:  * pattern of `skills/buffs.ts` - at module evaluation `Store` is still in
16:  * its temporal dead zone).
17:  */
18: export const MuHelperState = observable({
19:   windowOpen: false,
20:   config: defaultMuHelperConfig() as MuHelperConfig,
21:   draft: defaultMuHelperConfig() as MuHelperConfig,
22: });
23: 
24: /** Canonical clone: what survives the wire is what the copy holds. */
25: function cloneConfig(config: MuHelperConfig): MuHelperConfig {
26:   return decodeMuHelperConfig(encodeMuHelperConfig(config));
27: }
28: 
29: let stopWatching: (() => void) | null = null;
30: 
31: /** Start following the stored blob. Safe to call every frame/render. */
32: export function ensureMuHelperWatching(): void {
33:   if (stopWatching) return;
34:   stopWatching = reaction(
35:     () => Store.muHelper.config,
36:     blob => {
37:       if (!blob) return;
38:       runInAction(() => {
39:         MuHelperState.config = decodeMuHelperConfig(blob);
40:         // A save echo while the window is up must not stomp live edits.
41:         if (!MuHelperState.windowOpen) {
42:           MuHelperState.draft = cloneConfig(MuHelperState.config);
43:         }
44:       });
45:     },
46:     { fireImmediately: true }
47:   );
48: }
49: 
50: export function toggleMuHelperWindow(open?: boolean): void {
51:   ensureMuHelperWatching();
52:   runInAction(() => {
53:     const next = open ?? !MuHelperState.windowOpen;
54:     if (next) MuHelperState.draft = cloneConfig(MuHelperState.config);
55:     MuHelperState.windowOpen = next;
56:   });
57: }
