<file path="src/marketplace/tiers.ts">
 1: import type { Listing } from './mockListings';
 2: 
 3: /**
 4:  * How a listing looks, from what its item is.
 5:  *
 6:  * The original game tells a player's eye what an item is worth before they
 7:  * read a word: an excellent item's name is blue, an ancient's is gold, and a
 8:  * high-level item glows. The window does the same on its cards and rows.
 9:  * Two independent things decide it:
10:  *
11:  * - the **tier**, from the item's level: plain up to +3, forged from +4,
12:  *   high from +7 (where the original starts its glow), elite from +10;
13:  * - the **kind**: excellent or ancient, which get a foil edge and sparkles
14:  *   whatever their level.
15:  *
16:  * Pure, so the mapping is tested and the styling is only ever one class
17:  * per axis - `tier-high is-excellent`, never a pile of ad hoc flags.
18:  */
19: 
20: export type Tier = 'plain' | 'forged' | 'high' | 'elite';
21: 
22: export function tierOf(level: number | undefined): Tier {
23:   const lvl = level ?? 0;
24:   if (lvl >= 10) return 'elite';
25:   if (lvl >= 7) return 'high';
26:   if (lvl >= 4) return 'forged';
27:   return 'plain';
28: }
29: 
30: /** The classes a card or row carries for this item; empty for a plain one. */
31: export function lookClasses(item: Listing['item']): string {
32:   const classes: string[] = [];
33:   const tier = tierOf(item.lvl);
34:   if (tier !== 'plain') classes.push(`tier-${tier}`);
35:   if (item.isAncient) classes.push('is-ancient');
36:   else if (item.isExcellent) classes.push('is-excellent');
37:   return classes.join(' ');
38: }
</file>

