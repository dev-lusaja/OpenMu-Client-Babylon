367: /** The tree the hero's class line uses, `None` for an unknown class. */
368: export function masterTreeClass(charClass = Store.playerData.charClass): MasterTreeClass {
369:   return TREE_CLASS[charClass] ?? MasterTreeClass.None;
370: }
371: 
372: /** Class name and the three category headings of the hero's tree. */
373: export function masterTreeText(): {
374:   className: string;
375:   categories: readonly [string, string, string];
376: } {
377:   return TREE_TEXT[masterTreeClass()];
378: }
