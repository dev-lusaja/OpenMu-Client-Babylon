481:   /**
482:    * Enter in the input box (NewUIChatInputBox.cpp:505). A whisper goes to
483:    * the name in the whisper field; everything else is public chat with the
484:    * party/guild prefix of the current mode. `/commands` go through untouched:
485:    * OpenMU parses them on the server.
486:    */
487:   sendChat(rawText: string): boolean {
488:     const text = rawText.replace(/[\r\n]/g, '').slice(0, MAX_CHAT_LENGTH);
489:     if (!text.trim()) return false;
490: 
491:     const now = performance.now();
492:     if (now - this.lastChatTime < CHAT_COOLDOWN_MS) return false;
493:     this.lastChatTime = now;
494: 
495:     const heroName = Store.playerData.name;
496:     // A `/command` is never a whisper, whatever the whisper field holds
497:     // (the original checks the slash before the whisper id).
498:     const whisperTo =
499:       this.whisperEnabled && !text.startsWith('/') ? this.whisperTarget.trim() : '';
500: 
501:     if (whisperTo) {
502:       // Name (10) + message: getRequiredSize counts from the code byte.
503:       const packet = WhisperMessagePacket.createPacket(
504:         WhisperMessagePacket.getRequiredSize(10 + text.length)
505:       );
506:       packet.setReceiverName(whisperTo);
507:       packet.setMessage(text);
508:       Store.sendToGS(packet.buffer);
509:       // The original logs an outgoing whisper under the hero's name.
510:       this.addChatLine(heroName, text, ChatLineType.Whisper);
511:       this.remember(this.whisperHistory, whisperTo);
512:       return true;
513:     }
514: 
515:     // `CheckCommand` (ZzzInterface.cpp:3990): `/trade`, `/party`, `/guild`,
516:     // `/union`… act on the player under the cursor and are never sent.
517:     const local = localCommandOf(text);
518:     if (local?.local) {
519:       if (local.name === '/duelend') Commands.duelStop();
520:       else Commands.run(local.local, Store.world?.currentPointerTarget);
521:       this.remember(this.chatHistory, text);
522:       return true;
523:     }
524: 
525:     const prefix = text.startsWith('/') ? '' : CHAT_INPUT_PREFIX[this.chatInputMode];
526:     const message = (prefix + text).slice(0, MAX_CHAT_LENGTH);
527: 
528:     // `CheckChatText` (NewUIChatInputBox.cpp:571) runs on the typed line
529:     // before it is sent, and only for public chat - never for a whisper and
530:     // never for a `/command`. The original also skipped it while riding a
531:     // mount outside a safe zone; mounts are not ported, so that gate is moot.
532:     if (!text.startsWith('/')) {
533:       const emote = matchEmoteWord(text);
534:       if (emote && Store.world) Store.world.emoteRequest = emote;
535: 
536:       // A line that is nothing but an emoji token pops the bubble here too.
537:       // Everyone else gets it from this very message (the ChatMessage handler
538:       // in logic.ts), and waiting for the server to echo it back would show
539:       // the sender their own bubble a round trip late. Public chat only: a
540:       // party line reaches members three maps away, where a bubble would hang
541:       // over nobody.
542:       const bubble = prefix ? null : matchEmojiBubbleWord(text);
543:       if (bubble && Store.world) Store.world.emojiRequest = bubble;
544:     }
545: 
546:     const packet = PublicChatMessagePacket.createPacket(
547:       PublicChatMessagePacket.getRequiredSize(10 + message.length)
548:     );
549:     packet.setCharacter(heroName);
550:     packet.setMessage(message);
551:     // The server echoes our own line back, which is the one request/answer
552:     // pair a player can trigger on demand (common/netStats.ts).
553:     NetStats.markSent('chat');
554:     Store.sendToGS(packet.buffer);
555: 
556:     this.remember(this.chatHistory, text);
557:     return true;
558:   }
559: 
560:   /**
561:    * The radial menu picked an emoji bubble: send it as the plain chat line its
562:    * token stands for (common/emojiBubbles.ts). Always public chat, never the
563:    * prefix of the current input mode - the bubble is drawn over a body in the
564:    * world, so it has to go to the players who can see that body.
565:    *
566:    * It is not routed through `sendChat`: that one whispers when a whisper
567:    * target is set, and a heart popped from the wheel is not a whisper.
568:    *
569:    * Returns false when the cooldown refuses the line, so the caller can drop
570:    * the whole thing rather than show the sender a bubble nobody else gets.
571:    */
572:   broadcastEmojiBubble(id: EmojiBubbleId): boolean {
573:     // Offline there is nothing to send to, and the local bubble is the point.
574:     if (Store.isOffline) return true;
575: 
576:     const now = performance.now();
577:     if (now - this.lastChatTime < CHAT_COOLDOWN_MS) return false;
578:     this.lastChatTime = now;
579: 
580:     const token = emojiBubbleToken(id);
581:     const packet = PublicChatMessagePacket.createPacket(
582:       PublicChatMessagePacket.getRequiredSize(10 + token.length)
583:     );
584:     packet.setCharacter(Store.playerData.name);
585:     packet.setMessage(token);
586:     Store.sendToGS(packet.buffer);
587: 
588:     return true;
589:   }
