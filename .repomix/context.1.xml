181: export const SIGNAL_PREFIXES: readonly (readonly [string, Signal])[] = [
182:   [
183:     'Animation count out of sync - hacker?',
184:     { id: 'animation-count-desync', label: 'Animation count out of sync', severity: 'soft' },
185:   ],
186:   [
187:     'Hit count out of sync - hacker?',
188:     { id: 'hit-count-desync', label: 'Hit count out of sync', severity: 'soft' },
189:   ],
190:   [
