  1: import type { Tracker } from './tracker';
  2: import type { TrackedSession } from './session';
  3: import { WireEncoder } from './wire';
  4: import {
  5:   characterInformation,
  6:   characterList,
  7:   chat,
  8:   experience,
  9:   gameServerEntered,
 10:   hit,
 11:   itemAdded,
 12:   itemBytes,
 13:   itemsDropped,
 14:   levelUpdate,
 15:   mapChanged,
 16:   moneyUpdate,
 17:   npcsInScope,
 18:   objectKilled,
 19:   pickup,
 20:   respawn,
 21:   selectCharacter,
 22:   serverMessage,
 23:   walk,
 24:   whisper,
 25: } from './packets';
 26: 
 27: /**
 28:  * `ADMIN_DEMO=on`: a handful of players who are not there.
 29:  *
 30:  * Every one of them is a real `TrackedSession` fed real frames - encrypted
 31:  * the way the client and the server encrypt them - so the panel is looking
 32:  * at the tracker, not at a stub of it. That is what makes it usable to
 33:  * build and screenshot the panel with no game server, and it doubles as a
 34:  * soak of the decoders.
 35:  */
 36: 
 37: type Bot = {
 38:   account: string;
 39:   name: string;
 40:   cls: number;
 41:   level: number;
 42:   map: number;
 43:   x: number;
 44:   y: number;
 45:   gm?: boolean;
 46: };
 47: 
 48: const BOTS: Bot[] = [
 49:   { account: 'gmaster', name: 'Aeris', cls: 7, level: 400, map: 0, x: 130, y: 120, gm: true },
 50:   { account: 'bob01', name: 'Bobby', cls: 4, level: 62, map: 0, x: 140, y: 130 },
 51:   { account: 'lina', name: 'Lina', cls: 8, level: 88, map: 2, x: 220, y: 60 },
 52:   { account: 'karl', name: 'Karl', cls: 0, level: 133, map: 3, x: 175, y: 120 },
 53:   { account: 'dave', name: 'DaveSM', cls: 2, level: 210, map: 7, x: 24, y: 20 },
 54:   { account: 'mia', name: 'Mia', cls: 20, level: 45, map: 4, x: 208, y: 78 },
 55:   { account: 'rex', name: 'RexDL', cls: 16, level: 300, map: 10, x: 42, y: 100 },
 56:   { account: 'zoe', name: 'Zoe', cls: 12, level: 150, map: 8, x: 100, y: 160 },
 57: ];
 58: 
 59: const MAPS = [0, 2, 3, 4, 7, 8, 10];
 60: const MONSTERS = [0, 1, 2, 3, 6, 7, 10, 12, 14, 20, 33, 44, 55];
 61: const LINES = [
 62:   'anyone selling a +9 pendant?',
 63:   'lf party lost tower 5',
 64:   'gg',
 65:   'brb',
 66:   'wts jewels pm me',
 67:   'where is the bc entrance?',
 68:   'lol',
 69:   'trade?',
 70: ];
 71: const ITEMS = [itemBytes(0, 0, 3), itemBytes(0, 1, 7), itemBytes(14, 0), itemBytes(12, 0), itemBytes(7, 2, 9)];
 72: 
 73: const DIR_DX = [-1, 0, 1, 1, 1, 0, -1, -1];
 74: const DIR_DY = [-1, -1, -1, 0, 1, 1, 1, 0];
 75: 
 76: const TICK_MS = 600;
 77: 
 78: type Runner = {
 79:   bot: Bot;
 80:   session: TrackedSession;
 81:   wire: WireEncoder;
 82:   objectId: number;
 83:   heading: number;
 84:   npcs: { id: number; type: number }[];
 85:   money: number;
 86:   dead: boolean;
 87: };
 88: 
 89: function pick<T>(list: readonly T[]): T {
 90:   return list[Math.floor(Math.random() * list.length)];
 91: }
 92: 
 93: function server(runner: Runner, packet: Uint8Array): void {
 94:   runner.session.feedServer(runner.wire.server(packet));
 95: }
 96: 
 97: function client(runner: Runner, packet: Uint8Array): void {
 98:   runner.session.feedClient(runner.wire.client(packet));
 99: }
100: 
101: function populate(runner: Runner): void {
102:   const { bot } = runner;
103:   runner.npcs = MONSTERS.slice(0, 5).map((type, k) => ({ id: 2000 + runner.objectId * 10 + k, type }));
104:   server(
105:     runner,
106:     npcsInScope(
107:       runner.npcs.map(npc => ({
108:         id: npc.id,
109:         type: npc.type,
110:         x: Math.min(250, bot.x + 3),
111:         y: Math.min(250, bot.y + 3),
112:       }))
113:     )
114:   );
115: }
116: 
117: function enter(runner: Runner): void {
118:   const { bot } = runner;
119:   server(runner, gameServerEntered(runner.objectId));
120:   runner.session.setAccount(bot.account);
121:   server(runner, characterList([{ name: bot.name, cls: bot.cls, level: bot.level, status: bot.gm ? 32 : 0 }]));
122:   client(runner, selectCharacter(bot.name));
123:   server(
124:     runner,
125:     characterInformation({
126:       x: bot.x,
127:       y: bot.y,
128:       map: bot.map,
129:       money: runner.money,
130:       status: bot.gm ? 32 : 0,
131:       hp: 800,
132:       maxHp: 1000,
133:     })
134:   );
135:   populate(runner);
136: }
137: 
138: function step(runner: Runner): void {
139:   const { bot } = runner;
140: 
141:   if (runner.dead) return;
142: 
143:   const roll = Math.random();
144: 
145:   if (roll < 0.55) {
146:     if (Math.random() < 0.15) runner.heading = Math.floor(Math.random() * 8);
147:     const dirs: number[] = [];
148:     const steps = 1 + Math.floor(Math.random() * 6);
149:     let x = bot.x;
150:     let y = bot.y;
151:     for (let i = 0; i < steps; i++) {
152:       let dir = runner.heading;
153:       let nx = x + DIR_DX[dir];
154:       let ny = y + DIR_DY[dir];
155:       if (nx < 12 || nx > 243 || ny < 12 || ny > 243) {
156:         runner.heading = (runner.heading + 4) % 8;
157:         dir = runner.heading;
158:         nx = x + DIR_DX[dir];
159:         ny = y + DIR_DY[dir];
160:       }
161:       dirs.push(dir);
162:       x = nx;
163:       y = ny;
164:     }
165:     client(runner, walk(bot.x, bot.y, dirs));
166:     bot.x = x;
167:     bot.y = y;
168:     return;
169:   }
170: 
171:   if (roll < 0.63) {
172:     client(runner, chat(bot.name, pick(LINES)));
173:     return;
174:   }
175: 
176:   if (roll < 0.66) {
177:     const other = pick(BOTS.filter(b => b.name !== bot.name));
178:     client(runner, whisper(other.name, pick(LINES)));
179:     return;
180:   }
181: 
182:   if (roll < 0.78) {
183:     client(runner, hit(pick(runner.npcs).id));
184:     return;
185:   }
186: 
187:   if (roll < 0.86) {
188:     const npc = pick(runner.npcs);
189:     server(runner, objectKilled(npc.id, runner.objectId));
190:     server(runner, experience(npc.id, 50 + Math.floor(Math.random() * 900)));
191:     return;
192:   }
193: 
194:   if (roll < 0.9) {
195:     const item = pick(ITEMS);
196:     const id = 3000 + Math.floor(Math.random() * 1000);
197:     server(runner, itemsDropped([{ id, x: bot.x, y: bot.y, item }]));
198:     client(runner, pickup(id));
199:     server(runner, itemAdded(20 + Math.floor(Math.random() * 40), item));
200:     return;
201:   }
202: 
203:   if (roll < 0.93) {
204:     runner.money += Math.floor(Math.random() * 5000) - 1000;
205:     server(runner, moneyUpdate(Math.max(0, runner.money)));
206:     return;
207:   }
208: 
209:   if (roll < 0.95) {
210:     bot.level += 1;
211:     server(runner, levelUpdate(bot.level));
212:     return;
213:   }
214: 
215:   if (roll < 0.97) {
216:     bot.map = pick(MAPS.filter(m => m !== bot.map));
217:     bot.x = 20 + Math.floor(Math.random() * 200);
218:     bot.y = 20 + Math.floor(Math.random() * 200);
219:     server(runner, mapChanged(bot.map, bot.x, bot.y));
220:     populate(runner);
221:     return;
222:   }
223: 
224:   if (roll < 0.985) {
225:     server(runner, serverMessage(`[${bot.name}] You have been idle for a while.`));
226:     return;
227:   }
228: 
229:   // A death, and a respawn a moment later.
230:   runner.dead = true;
231:   server(runner, objectKilled(runner.objectId, pick(runner.npcs).id));
232:   setTimeout(() => {
233:     runner.dead = false;
234:     bot.x = 20 + Math.floor(Math.random() * 200);
235:     bot.y = 20 + Math.floor(Math.random() * 200);
236:     server(runner, respawn(bot.map, bot.x, bot.y, runner.money));
237:     populate(runner);
238:   }, 2000);
239: }
240: 
241: export function startDemo(tracker: Tracker): () => void {
242:   const runners: Runner[] = BOTS.map((bot, i) => ({
243:     bot: { ...bot },
244:     session: tracker.open(null, 55901),
245:     wire: new WireEncoder(),
246:     objectId: 1000 + i,
247:     heading: Math.floor(Math.random() * 8),
248:     npcs: [],
249:     money: 10_000 + i * 12_345,
250:     dead: false,
251:   }));
252: 
253:   for (const runner of runners) enter(runner);
254: 
255:   const timer = setInterval(() => {
256:     for (const runner of runners) if (Math.random() < 0.45) step(runner);
257:   }, TICK_MS);
258: 
259:   console.warn(`admin demo: ${runners.length} synthetic players are being tracked - not for a public proxy`);
260: 
261:   return () => {
262:     clearInterval(timer);
263:     for (const runner of runners) tracker.close(runner.session);
264:   };
265: }
