 96: export class TradeSession {
 97:   /** Items the partner has put on the table, by trade slot. */
 98:   readonly theirItems = new Map<number, Uint8Array>();
 99:   /** Trade slots the server has confirmed *our* items into. */
100:   readonly myItems = new Set<number>();
101:   /**
102:    * Bag slots the server put items into during this trade, in arrival order.
103:    *
104:    * Where a collected item lands is the server's choice, not ours, and it is
105:    * only ever said here. Guessing it and writing the guess down is what left
106:    * deliveries offering an empty slot.
107:    */
108:   readonly receivedSlots: number[] = [];
109:   theirMoney = 0;
110:   theirConfirm = false;
111:   /** Zen the server confirmed is on our side of the table. */
112:   myMoney = 0;
113:   /** The last amount we asked to put up, until the server answers. */
114:   private offeredMoney = 0;
115:   partner: string | null = null;
116: 
117:   private open = false;
118:   private finished: ((outcome: TradeOutcome) => void) | null = null;
119:   private readonly unsubscribe: () => void;
120: 
121:   constructor(
122:     private readonly connection: BotConnection,
123:     private readonly log: (message: string) => void = () => {}
124:   ) {
125:     this.unsubscribe = connection.on(frame => this.handle(frame));
126:   }
127: 
128:   dispose(): void {
129:     this.unsubscribe();
130:   }
131: 
132:   get isOpen(): boolean {
133:     return this.open;
134:   }
