  2: import { Xor32Decryptor } from "../src/common/encryption/xor32";
  3: import { Xor3Byte } from "../src/common/encryption/xor3";
  4: import { getPacketSize, getSizeOfPacketType } from "../src/common/wireUtils";
  5: import { SESSION_NONCE_RE } from "../src/common/sessionNonce";
  6: 
  7: /**
  8:  * Who is connected right now, answered on loopback.
  9:  *
 10:  * OpenMU keeps login state in memory only (`LoginServer.cs` is a plain
 11:  * `Dictionary<string, byte>`), so nothing in its database says who is playing.
 12:  * The proxy is the one process that knows: every browser client reaches the
 13:  * game server through it, so a live websocket *is* a live session.
 14:  *
 15:  * The cash shop's safety gate asks this before writing to an account, because
 16:  * writing to one that is loaded in the game server's memory either dupes the
 17:  * jewels it spends or corrupts the inventory slot it writes. This is only
 18:  * authoritative while the game server's TCP port is unreachable from outside -
 19:  * a player on the original .exe would bypass the proxy entirely - which is why
 20:  * the gate probes that port itself rather than trusting the answer here alone.
 21:  *
 22:  * Keys are Season 6's. A version with different SimpleModulus keys would
 23:  * decode nothing here and every account would read as offline, so the gate
 24:  * treats "no login ever seen on a live socket" as a reason to refuse rather
 25:  * than a reason to proceed.
 26:  *
 27:  * A socket is named by the game server, not by the client. The login frame
 28:  * the client sends is a claim - anyone can put any name in one - so it is
 29:  * only held as pending until the server's `LoginResponse` comes back the
 30:  * other way, and only an Okay turns it into this connection's account. A
 31:  * wrong password, an unknown account, a full server: the claim is dropped
 32:  * and the socket stays nameless. That is the whole reason the sniffer reads
 33:  * both directions.
 34:  *
 35:  * `/ticket/<nonce>` is strictly more sensitive than `/presence/<account>`.
 36:  * Presence says whether a name is playing, which anyone standing next to the
 37:  * player could tell. The ticket route turns a nonce the browser chose for
 38:  * itself (src/common/sessionNonce.ts, sent on the socket URL by
 39:  * `createSocket`) into the account that logged in over it, and the cash shop
 40:  * signs that answer into a bearer ticket: whoever can reach this server with
 41:  * a nonce in hand is that account in the shop. Loopback-only is not tidiness
 42:  * for that route, it is the whole authentication.
 43:  */
 44: 
 45: const PRESENCE_ENABLED = (process.env.PRESENCE ?? "on") !== "off";
 46: /** Where the loopback server binds; exported so the relay can refuse to dial it. */
 47: export const PRESENCE_PORT = Number(process.env.PRESENCE_PORT ?? 3001);
 48: export const PRESENCE_HOST = process.env.PRESENCE_HOST ?? "127.0.0.1";
 49: 
 50: /**
 51:  * How much client-to-server traffic to decrypt before giving up on finding a
 52:  * login. The connect-server socket never carries one, and a game-server socket
 53:  * sends it within the first few frames, so this only bounds the pathological
 54:  * case.
 55:  */
 56: const MAX_SNIFF_BYTES = Number(process.env.PRESENCE_SNIFF_LIMIT ?? 65536);
 57: 
 58: /**
 59:  * `LoginShortPassword` / `LoginLongPassword`: C3, code 0xF1, sub 0x01. The
 60:  * server's `LoginResponse` answers with the same code and sub-code on a C1,
 61:  * which is never encrypted in either direction, so reading it needs no key.
 62:  */
 63: const LOGIN_CODE = 0xf1;
 64: const LOGIN_SUB_CODE = 0x01;
 65: /** `LoginResponseLoginResultEnum.Okay`; every other value is a refusal. */
 66: const LOGIN_OKAY = 0x01;
 67: /** `[C1, 05, F1, 01, result]`. */
 68: const LOGIN_RESPONSE_LENGTH = 5;
 69: /** `setUsername` writes 10 bytes at offset 4, Xor3-encoded over the padding too. */
 70: const NAME_OFFSET = 4;
 71: const NAME_LENGTH = 10;
 72: 
 73: const HEADERS = new Set([0xc1, 0xc2, 0xc3, 0xc4]);
 74: 
 75: /** Matches register's rule for what a login name may contain. */
 76: const ACCOUNT_RE = /^[A-Za-z0-9]{1,10}$/;
 77: 
 78: const startedAt = Date.now();
 79: 
 80: /** account (lowercased) -> the sockets currently logged in as it. */
 81: const live = new Map<string, Set<ConnectionPresence>>();
 82: /** account (lowercased) -> when its last socket went away. */
 83: const lastSeen = new Map<string, number>();
 84: /** Every open connection, named or not. */
 85: const open = new Set<ConnectionPresence>();
 86: /**
 87:  * session nonce -> every socket that carried it. A Set, not one connection:
 88:  * `createSocket` runs at least twice per page load (`src/store.ts`
 89:  * `connectToConnectServer` and `connectToGameServer`, then again on the
 90:  * fallback retry), every one of those sockets carries the same nonce, and
 91:  * only the game-server socket ever sends a login. Keeping the last to arrive
 92:  * would let the connect-server socket shadow it and answer 404 forever.
 93:  */
 94: const bySession = new Map<string, Set<ConnectionPresence>>();
 95: 
 96: export interface PresenceAnswer {
 97:   account: string;
 98:   online: boolean;
 99:   connections: number;
100:   /**
101:    * The game server ports the account's live sockets dialled, without
102:    * repeats. A bot that plays on one port reaches only the players on it.
103:    */
104:   ports: number[];
105:   /** Now while online; when the last socket closed otherwise; null if never seen. */
106:   lastSeenAt: number | null;
107:   /**
108:    * When this proxy started. Every session it did not witness died with the
109:    * previous process, so an account unknown to it is genuinely logged out -
110:    * but the game server needs a moment to notice and finish saving, so the
111:    * gate applies its cooldown from this timestamp too.
112:    */
113:   startedAt: number;
114:   now: number;
115:   /**
116:    * Open sockets that have carried encrypted (C3/C4) traffic without ever
117:    * yielding a login name - a game-server session this process cannot put a
118:    * name to, because the stream desynced or the keys are not this version's.
119:    *
120:    * It is deliberately global rather than per account: an unreadable session
121:    * could belong to *anyone*, so while this is above zero the gate must refuse
122:    * every account. Otherwise a connection the sniffer failed on would read as
123:    * "offline", which is the one wrong answer that costs jewels.
124:    */
125:   unidentifiedConnections: number;
126: }
127: 
128: const EMPTY: Uint8Array = new Uint8Array(0);
129: 
130: function append(queue: Uint8Array, chunk: Uint8Array): Uint8Array {
131:   const merged = new Uint8Array(queue.length + chunk.length);
132:   merged.set(queue, 0);
133:   merged.set(chunk, queue.length);
134:   return merged;
135: }
136: 
137: /**
138:  * Hands every complete frame at the front of `queue` to `onFrame` and returns
139:  * what is left. A byte that is not a header is dropped and the scan resumes
140:  * after it, so one bad byte cannot jam the stream forever. Only the header
141:  * is read here, and the header is plain in both directions.
142:  */
143: function drain(queue: Uint8Array, onFrame: (wire: Uint8Array) => void): Uint8Array {
144:   while (queue.length > 0) {
145:     const type = queue[0];
146: 
147:     if (!HEADERS.has(type)) {
148:       queue = queue.subarray(1);
149:       continue;
150:     }
151: 
152:     const headerSize = getSizeOfPacketType(type);
153: 
154:     if (queue.length < headerSize + 1) break;
155: 
156:     const length = getPacketSize(queue);
157: 
158:     if (length < headerSize + 1) {
159:       queue = queue.subarray(1);
160:       continue;
161:     }
162: 
163:     if (queue.length < length) break;
164: 
165:     onFrame(queue.slice(0, length));
166:     queue = queue.subarray(length);
167:   }
168: 
169:   return queue;
170: }
171: 
172: /**
173:  * Reads the account name out of one connection's client-to-server stream,
174:  * and waits for the server-to-client stream to confirm it.
175:  *
176:  * The client sends Xor32 then SimpleModulus for headers >= 0xC3
177:  * (`src/store.ts` `sendToGS`), so this reverses both, in that order. The
178:  * decryptor's default keys are `DefaultServerKey` - the server side of the
179:  * client-to-server direction, which is exactly this - so it needs no
180:  * configuration. The server's answer is a C1, and C1 is plain.
181:  *
182:  * Every byte handled here is a copy. The proxy forwards the caller's buffer
183:  * untouched, and both decryptors work in place.
184:  */
185: export class ConnectionPresence {
186:   private readonly modulus = new SimpleModulusDecryptor();
187:   private readonly xor32 = new Xor32Decryptor();
188:   private queue = EMPTY;
189:   private serverQueue = EMPTY;
190:   private sniffed = 0;
191:   private serverSniffed = 0;
192:   private finished = false;
193:   /** The name the client put in its login frame, until the server rules on it. */
194:   private pending: string | null = null;
195:   /** The server refused the last claim, so a nameless socket here is a known logged-out one. */
196:   private refused = false;
197:   /** A second claim arrived while one still awaited its answer. */
198:   private ambiguous = false;
199:   private account: string | null = null;
200:   private sawEncrypted = false;
201:   /** The page's nonce, when the socket URL carried a well-formed one. */
202:   private readonly session: string | null;
203: 
204:   /**
205:    * @param targetPort The game server port this socket dialled, when known.
206:    * The marketplace's bots each live on one game server, and a player is
207:    * only reachable by the bot on theirs; this is how presence says which.
208:    */
209:   constructor(session: string | null = null, readonly targetPort: number | null = null) {
210:     open.add(this);
211: 
212:     // The proxy screens the query string before it gets here, but the map
213:     // key's shape is this class's invariant, so it is enforced where the map
214:     // lives: a nonce that is not 32 lowercase hex binds nothing, and the
215:     // socket carries on as one that never named a session.
216:     this.session = session !== null && SESSION_NONCE_RE.test(session) ? session : null;
217: 
218:     if (this.session !== null) bind(this.session, this);
219:   }
220: 
221:   /**
222:    * A live socket that has spoken the encrypted protocol but never named
223:    * itself. The connect-server socket is C1 throughout and never counts;
224:    * a game-server socket only looks like this if decryption went wrong - or
225:    * while a login is in flight and the server has not answered yet, which the
226:    * gate is right to treat the same way. A socket whose last login the server
227:    * refused is not unidentified: it is known to be nobody.
228:    */
229:   get unidentified(): boolean {
230:     return this.sawEncrypted && this.account === null && !this.refused;
231:   }
232: 
233:   /**
234:    * Feeds client-to-server bytes. Returns the name the client claimed, the
235:    * first time a login frame is read - a claim, not an identity. `loginName`
236:    * stays null until `feedFromServer` sees the game server accept it.
237:    */
238:   feed(chunk: Uint8Array): string | null {
239:     if (this.finished) return null;
240: 
241:     this.sniffed += chunk.length;
242: 
243:     if (this.sniffed > MAX_SNIFF_BYTES) return this.giveUp();
244: 
245:     this.queue = append(this.queue, chunk);
246: 
247:     return this.scan();
248:   }
249: 
250:   /**
251:    * Feeds server-to-client bytes, for the one frame that matters: the game
252:    * server's answer to the login. Only an Okay for a pending claim names the
253:    * socket; anything else drops the claim, and the client is free to try
254:    * again with another name, which starts the wait over. Returns the account
255:    * the moment it is confirmed.
256:    */
257:   feedFromServer(chunk: Uint8Array): string | null {
258:     if (this.finished) return null;
259: 
260:     this.serverSniffed += chunk.length;
261: 
262:     if (this.serverSniffed > MAX_SNIFF_BYTES) return this.giveUp();
263: 
264:     let confirmed: string | null = null;
265: 
266:     this.serverQueue = drain(append(this.serverQueue, chunk), wire => {
267:       if (confirmed !== null) return;
268:       if (wire[0] !== 0xc1 || wire.length < LOGIN_RESPONSE_LENGTH) return;
269:       if (wire[2] !== LOGIN_CODE || wire[3] !== LOGIN_SUB_CODE) return;
270: 
271:       // Two claims in flight: whatever the server answered, it cannot be
272:       // pinned to a name. A real client waits for the answer before trying
273:       // again; two at once is a forged stream hoping the answer to its own
274:       // login lands on somebody else's name. The socket stays unidentified
275:       // for its life, like a stream the sniffer could not read, so the shop
276:       // gate refuses rather than guesses.
277:       if (this.ambiguous) {
278:         this.finished = true;
279:         this.pending = null;
280:         this.ambiguous = false;
281:         return;
282:       }
283: 
284:       if (wire[4] === LOGIN_OKAY && this.pending !== null) {
285:         confirmed = this.pending;
286:       } else {
287:         this.pending = null;
288:         this.refused = true;
289:       }
290:     });
291: 
292:     if (this.finished && confirmed === null) {
293:       this.queue = EMPTY;
294:       this.serverQueue = EMPTY;
295:       return null;
296:     }
297: 
298:     if (confirmed !== null) {
299:       this.account = confirmed;
300:       this.pending = null;
301:       this.finished = true;
302:       this.queue = EMPTY;
303:       this.serverQueue = EMPTY;
304:       register(confirmed, this);
305:     }
306: 
307:     return confirmed;
308:   }
309: 
310:   /** The account this connection logged in as, if the server ever accepted one. */
311:   get loginName(): string | null {
312:     return this.account;
313:   }
314: 
315:   /** The stream is too long to be a fresh session; stop reading both directions. */
316:   private giveUp(): null {
317:     this.finished = true;
318:     this.queue = EMPTY;
319:     this.serverQueue = EMPTY;
320:     return null;
321:   }
322: 
323:   private scan(): string | null {
324:     let claimed: string | null = null;
325: 
326:     this.queue = drain(this.queue, wire => {
327:       if (wire[0] >= 0xc3) this.sawEncrypted = true;
328: 
329:       const name = this.readLogin(wire);
330: 
331:       if (name) {
332:         if (this.pending !== null) this.ambiguous = true;
333:         this.pending = name;
334:         this.refused = false;
335:         claimed = name;
336:       }
337:     });
338: 
339:     return claimed;
340:   }
341: 
342:   /** One framed packet in, an account name out if it was the login. */
343:   private readLogin(wire: Uint8Array): string | null {
344:     let packet: Uint8Array;
345: 
346:     try {
347:       const [ok, decrypted] = this.modulus.Decrypt(wire);
348:       if (!ok) return null;
349:       packet = decrypted;
350:     } catch {
351:       // A malformed frame must never take the proxy down with it: this is a
352:       // side channel, and the bytes have already been forwarded.
353:       return null;
354:     }
355: 
356:     this.xor32.Decrypt(packet);
357: 
358:     const codeIndex = getSizeOfPacketType(packet[0]);
359: 
360:     if (packet.length < codeIndex + 2) return null;
361:     if (packet[codeIndex] !== LOGIN_CODE) return null;
362:     if (packet[codeIndex + 1] !== LOGIN_SUB_CODE) return null;
363:     if (packet.length < NAME_OFFSET + NAME_LENGTH) return null;
364: 
365:     const name = packet.slice(NAME_OFFSET, NAME_OFFSET + NAME_LENGTH);
366:     Xor3Byte(name);
367: 
368:     // `stringToBytes` zero-pads to 10 before the Xor3, so the padding decodes
369:     // back to zeros and the name is whatever precedes the first one.
370:     const end = name.indexOf(0);
371:     const text = new TextDecoder("ascii").decode(
372:       end === -1 ? name : name.subarray(0, end)
373:     );
374: 
375:     return ACCOUNT_RE.test(text) ? text : null;
376:   }
377: 
378:   /** The socket closed. */
379:   close(): void {
380:     this.finished = true;
381:     this.queue = EMPTY;
382:     this.serverQueue = EMPTY;
383:     open.delete(this);
384: 
385:     if (this.account) unregister(this.account, this);
386:     if (this.session !== null) unbind(this.session, this);
387:   }
388: }
389: 
390: function bind(session: string, connection: ConnectionPresence): void {
391:   let set = bySession.get(session);
392: 
393:   if (!set) {
394:     set = new Set();
395:     bySession.set(session, set);
396:   }
397: 
398:   set.add(connection);
399: }
400: 
401: function unbind(session: string, connection: ConnectionPresence): void {
402:   const set = bySession.get(session);
403: 
404:   if (!set) return;
405: 
406:   set.delete(connection);
407: 
408:   if (set.size === 0) bySession.delete(session);
409: }
410: 
411: /**
412:  * The account that logged in over a socket carrying this nonce, or null while
413:  * none has. A name only lands once the game server has accepted the login
414:  * (`feedFromServer`), so a fresh page load answers null through the login
415:  * screen and the first frames of its game-server connection; and a nonce
416:  * whose sockets have all closed answers null again. That does not recall a
417:  * ticket the shop already signed - it expires on its own clock - which is why
418:  * the shop asks here again before it lets a ticket spend anything.
419:  */
420: export function sessionAccount(session: string): string | null {
421:   const set = bySession.get(session);
422: 
423:   if (!set) return null;
424: 
425:   for (const connection of set) {
426:     if (connection.loginName !== null) return connection.loginName;
427:   }
428: 
429:   return null;
430: }
431: 
432: function register(account: string, connection: ConnectionPresence): void {
433:   const key = account.toLowerCase();
434:   let set = live.get(key);
435: 
436:   if (!set) {
437:     set = new Set();
438:     live.set(key, set);
439:   }
440: 
441:   set.add(connection);
442:   console.log(`presence: ${account} online (${set.size} connection(s))`);
443: }
444: 
445: function unregister(account: string, connection: ConnectionPresence): void {
446:   const key = account.toLowerCase();
447:   const set = live.get(key);
448: 
449:   if (!set) return;
450: 
451:   set.delete(connection);
452: 
453:   if (set.size === 0) {
454:     live.delete(key);
455:     lastSeen.set(key, Date.now());
456:     console.log(`presence: ${account} offline`);
457:   }
458: }
459: 
460: export function lookup(account: string): PresenceAnswer {
461:   const key = account.toLowerCase();
462:   const set = live.get(key);
463:   const connections = set ? set.size : 0;
464:   const now = Date.now();
465: 
466:   const ports = set
467:     ? [...new Set([...set].map(c => c.targetPort).filter((p): p is number => p !== null))].sort(
468:         (a, b) => a - b
469:       )
470:     : [];
471: 
472:   return {
473:     account,
474:     online: connections > 0,
475:     connections,
476:     ports,
477:     lastSeenAt: connections > 0 ? now : (lastSeen.get(key) ?? null),
478:     startedAt,
479:     now,
480:     unidentifiedConnections: unidentifiedConnections(),
481:   };
482: }
483: 
484: /** Every account with a live socket, for the ops view. */
485: export function onlineAccounts(): string[] {
486:   return [...live.keys()].sort();
487: }
488: 
489: /** Open sockets that spoke the encrypted protocol without ever naming themselves. */
490: export function unidentifiedConnections(): number {
491:   let count = 0;
492:   for (const connection of open) if (connection.unidentified) count++;
493:   return count;
494: }
495: 
496: function json(body: unknown, status = 200): Response {
497:   return new Response(JSON.stringify(body), {
498:     status,
499:     headers: { "Content-Type": "application/json" },
500:   });
501: }
502: 
503: /** One request against the presence server. Separate from the port so the routes can be tested without one. */
504: export function handlePresenceRequest(req: Request): Response {
505:   const url = new URL(req.url);
506: 
507:   if (req.method !== "GET") return json({ error: "Method not allowed" }, 405);
508: 
509:   if (url.pathname === "/presence") {
510:     return json({
511:       startedAt,
512:       now: Date.now(),
513:       online: onlineAccounts(),
514:       openConnections: open.size,
515:       unidentifiedConnections: unidentifiedConnections(),
516:     });
517:   }
518: 
519:   // Before the presence routes' 404, which swallows every other path. A
520:   // malformed nonce is answered exactly like an unknown one: this route
521:   // never says which of the two it saw.
522:   const ticket = url.pathname.match(/^[/]ticket[/]([^/]+)$/);
523: 
524:   if (ticket) {
525:     const account = SESSION_NONCE_RE.test(ticket[1]) ? sessionAccount(ticket[1]) : null;
526:     return account === null ? json({ error: "Not found" }, 404) : json({ account });
527:   }
528: 
529:   const match = url.pathname.match(/^\/presence\/([^/]+)$/);
530: 
531:   if (!match) return json({ error: "Not found" }, 404);
532: 
533:   const account = decodeURIComponent(match[1]);
534: 
535:   if (!ACCOUNT_RE.test(account)) {
536:     return json({ error: "Malformed account name" }, 400);
537:   }
538: 
539:   return json(lookup(account));
540: }
541: 
542: /**
543:  * Loopback only, no auth. It answers "is this account playing", which is not
544:  * a secret to anyone who can already reach the box, but it must never be
545:  * published by Caddy: it would otherwise let anyone enumerate who is online -
546:  * and, through `/ticket/<nonce>`, mint a cash-shop ticket for anyone whose
547:  * nonce they hold.
548:  */
549: export function startPresenceServer(): void {
550:   if (!PRESENCE_ENABLED) {
551:     console.log("presence: off");
552:     return;
553:   }
554: 
555:   Bun.serve({
556:     port: PRESENCE_PORT,
557:     hostname: PRESENCE_HOST,
558:     fetch: handlePresenceRequest,
559:   });
560: 
561:   console.log(`presence: listening on ${PRESENCE_HOST}:${PRESENCE_PORT}`);
562: }
</file>

