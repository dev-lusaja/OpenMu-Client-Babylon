168: /**
169:  * The escrow handovers, driven against a second bot standing in for a player.
170:  *
171:  * `escrow list` is the one to run first: the seller hands an item over and the
172:  * bot gives nothing back, so no Zen is ever on the table and the server's
173:  * cancel bug cannot bite.
174:  */
175: async function escrow(password: string): Promise<void> {
176:   const which = arg('op', 'list')!;
177:   const botName = arg('bot', 'MKT001')!;
178:   const playerName = arg('player', 'MKT002')!;
179:   const slot = Number(arg('slot', '14'));
180:   const price = Number(arg('price', '1000000'));
181: 
182:   const bot = await connectBot(botName, password);
183:   const player = await connectBot(playerName, password);
184: 
185:   const context: EscrowContext = {
186:     session: bot.session,
187:     trade: bot.trade,
188:     scope: bot.scope,
189:     wallet: bot.wallet,
190:     ledger: new Ledger(undefined, (m: string) => log(`[ledger] ${m}`)),
191:     botName: bot.name,
192:     log: (message: string) => log(`[escrow] ${message}`),
193:   };
194: 
195:   try {
196:     await sleep(2000);
197: 
198:     // The stand-in accepts whatever the bot asks for, and plays the human's
199:     // half of the handover.
200:     const playerSide = player.connection
201:       .expect({ code: TRADE_REQUEST_CODE }, 30_000, 'an invitation to trade')
202:       .then(async () => {
203:         await player.trade.accept();
204:         log(`[${player.name}] accepted the trade`);
205:         if (which === 'list') {
206:           player.trade.offerItem(slot, 0);
207:         } else if (which === 'buy') {
208:           // Wait for the bot's item to appear before paying, which is the
209:           // order a real buyer's client will use too.
210:           await player.trade.waitForTerms({ expectItems: 1 }, 30_000);
211:           player.trade.setMoney(price);
212:         }
213:         // Confirm second: the server completes on whichever confirm is last,
214:         // and the bot has already checked the table by then.
215:         await sleep(1500);
216:         // What the stand-in should see on the table depends on the operation:
217:         // an item when buying, the payment when being paid out, and nothing at
218:         // all when listing, because the bot gives nothing back for a listing.
219:         const expected =
220:           which === 'buy'
221:             ? { expectItems: 1 }
222:             : which === 'payout'
223:               ? { expectMoney: price, expectItems: 0 }
224:               : { expectMoney: 0, expectItems: 0 };
225:         // --refuse makes the stand-in walk away with the bot's Zen already on
226:         // the table, which is the case the ledger exists to catch.
227:         if (process.argv.includes('--refuse')) {
228:           log(`[${player.name}] refusing on purpose`);
229:           player.trade.cancel();
230:           return;
231:         }
232:         const refused = player.trade.armConfirm(expected);
233:         if (refused) log(`[${player.name}] refused to confirm: ${refused}`);
234:       });
235: 
236:     let result;
237:     if (which === 'list') {
238:       result = await collectListing(context, player.name, 1);
239:     } else if (which === 'buy') {
240:       result = await deliverPurchase(context, player.name, slot, price);
241:     } else if (which === 'payout') {
242:       result = await payOut(context, player.name, price);
243:     } else {
244:       throw new Error(`unknown --op "${which}" (list, buy or payout)`);
245:     }
246: 
247:     await playerSide.catch(() => {});
248:     log(`${which}: ${result.ok ? 'ok' : `failed - ${result.reason}`}`);
249:   } finally {
250:     await disposeBot(player);
251:     await disposeBot(bot);
252:   }
253: }
