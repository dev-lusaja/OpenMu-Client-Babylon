<file path="proxy/track/admin.ts">
  1: import {
  2:   EVENT_KINDS,
  3:   type AdminClientMessage,
  4:   type AdminServerMessage,
  5:   type EventKind,
  6:   type LogQuery,
  7:   type RefusalReason,
  8: } from '../../src/common/adminProtocol';
  9: import { clampLimit, type Journal } from './journal';
 10: import type { Tracker } from './tracker';
 11: 
 12: /**
 13:  * The game master's stream: one subscriber per admin websocket.
 14:  *
 15:  * A socket gets the snapshot the moment it attaches, then every player
 16:  * change, move, leave and journal line as the tracker reports them. The only
 17:  * thing it can ask for is history, answered from the journal.
 18:  *
 19:  * Takes plain send / close callbacks rather than Bun's socket, so the tests
 20:  * can attach a fake and read what it was sent.
 21:  */
 22: 
 23: export interface AdminSocket {
 24:   send(text: string): void;
 25:   close(): void;
 26: }
 27: 
 28: export type AdminAuth = 'ok' | RefusalReason;
 29: 
 30: const KNOWN_KINDS = new Set<string>(EVENT_KINDS);
 31: const MAX_NAME = 32;
 32: 
 33: export class AdminHub {
 34:   private readonly clients = new Set<AdminSocket>();
 35:   private unsubscribe: (() => void) | null = null;
 36: 
 37:   constructor(
 38:     private readonly tracker: Tracker,
 39:     private readonly journal: Journal,
 40:     private readonly options: { open: boolean }
 41:   ) {}
 42: 
 43:   /**
 44:    * Who may stream: a socket whose nonce names a game master in the world,
 45:    * or anyone on loopback when the dev seam is open. A missing nonce and a
 46:    * wrong one are told apart only in the reason sent before the close.
 47:    */
 48:   authorise(nonce: string | null, loopback: boolean): AdminAuth {
 49:     if (this.options.open && loopback) return 'ok';
 50:     if (!nonce) return 'no-session';
 51:     return this.tracker.isGameMasterSession(nonce) ? 'ok' : 'not-gm';
 52:   }
 53: 
 54:   attach(socket: AdminSocket): void {
 55:     this.clients.add(socket);
 56: 
 57:     if (!this.unsubscribe) {
 58:       this.unsubscribe = this.tracker.subscribe({
 59:         player: player => this.broadcast({ t: 'player', player }),
 60:         move: (id, map, x, y) => this.broadcast({ t: 'move', id, map, x, y }),
 61:         leave: id => this.broadcast({ t: 'leave', id }),
 62:         event: (id, event) => this.broadcast({ t: 'event', id, event }),
 63:       });
 64:     }
 65: 
 66:     this.sendTo(socket, { t: 'snapshot', now: Date.now(), players: this.tracker.snapshot() });
 67:   }
 68: 
 69:   detach(socket: AdminSocket): void {
 70:     this.clients.delete(socket);
 71: 
 72:     // Nobody listening: stop turning every tick into JSON.
 73:     if (this.clients.size === 0 && this.unsubscribe) {
 74:       this.unsubscribe();
 75:       this.unsubscribe = null;
 76:     }
 77:   }
 78: 
 79:   receive(socket: AdminSocket, text: string): void {
 80:     let message: AdminClientMessage;
 81:     try {
 82:       message = JSON.parse(text) as AdminClientMessage;
 83:     } catch {
 84:       return;
 85:     }
 86:     if (!message || typeof message !== 'object') return;
 87: 
 88:     switch (message.t) {
 89:       case 'ping':
 90:         this.sendTo(socket, { t: 'pong' });
 91:         return;
 92:       case 'log': {
 93:         const query = this.sanitise(message);
 94:         if (!query) return;
 95:         const { events, more } = this.journal.query(query);
 96:         this.sendTo(socket, {
 97:           t: 'log',
 98:           reqId: Number(message.reqId) || 0,
 99:           character: query.character,
100:           events,
101:           more,
102:         });
103:         return;
104:       }
105:     }
106:   }
107: 
108:   get clientCount(): number {
109:     return this.clients.size;
110:   }
111: 
112:   /** Refuse before the upgrade: say why, then close. */
113:   static refusal(reason: RefusalReason): string {
114:     return JSON.stringify({ t: 'refused', reason } satisfies AdminServerMessage);
115:   }
116: 
117:   private sanitise(message: LogQuery): LogQuery | null {
118:     const character = String(message.character ?? '').trim().slice(0, MAX_NAME);
119:     if (!character) return null;
120: 
121:     const kinds = Array.isArray(message.kinds)
122:       ? (message.kinds.filter(k => KNOWN_KINDS.has(String(k))) as EventKind[])
123:       : undefined;
124:     const before = typeof message.before === 'number' && Number.isFinite(message.before)
125:       ? message.before
126:       : undefined;
127: 
128:     return {
129:       character,
130:       ...(before !== undefined ? { before } : {}),
131:       ...(kinds?.length ? { kinds } : {}),
132:       limit: clampLimit(message.limit),
133:     };
134:   }
135: 
136:   private sendTo(socket: AdminSocket, message: AdminServerMessage): void {
137:     try {
138:       socket.send(JSON.stringify(message));
139:     } catch {
140:       this.clients.delete(socket);
141:     }
142:   }
143: 
144:   private broadcast(message: AdminServerMessage): void {
145:     if (this.clients.size === 0) return;
146:     const text = JSON.stringify(message);
147:     for (const client of this.clients) {
148:       try {
149:         client.send(text);
150:       } catch {
151:         this.clients.delete(client);
152:       }
153:     }
154:   }
155: }
</file>

<file path="proxy/track/frames.ts">
  1: import {
  2:   SimpleModulusDecryptor,
  3:   SimpleModulusKeys,
  4: } from '../../src/common/encryption/simpleModulus';
  5: import { Xor32Decryptor } from '../../src/common/encryption/xor32';
  6: import { getPacketSize, getSizeOfPacketType } from '../../src/common/wireUtils';
  7: import { gameVersion } from '../../versions/season6';
  8: 
  9: /**
 10:  * One direction of one socket, turned from bytes into decrypted frames.
 11:  *
 12:  * The client encrypts with Xor32 and then SimpleModulus for headers >= 0xC3
 13:  * (`Store.sendToGS`); the server uses SimpleModulus alone with the other key
 14:  * set (`createSocket.ts`). C1 and C2 are plain both ways. Every frame handed
 15:  * out is a copy: the bytes the proxy forwards are never touched.
 16:  *
 17:  * A frame that does not decrypt is dropped and the stream carries on - the
 18:  * decryptor's counter resyncs on the next one, as the client's does.
 19:  */
 20: 
 21: export type Direction = 'client' | 'server';
 22: 
 23: export type Frame = {
 24:   /** The wire header byte: C1..C4. */
 25:   header: number;
 26:   code: number;
 27:   /** The byte after the code, or -1 for a frame too short to have one. */
 28:   subCode: number;
 29:   /** The decrypted packet, header included, starting at byte 0. */
 30:   view: DataView;
 31:   bytes: Uint8Array;
 32: };
 33: 
 34: const HEADERS = new Set([0xc1, 0xc2, 0xc3, 0xc4]);
 35: 
 36: /** Bounds what one connection can make the reader buffer. */
 37: const MAX_QUEUE = 1 << 16;
 38: 
 39: const EMPTY = new Uint8Array(0);
 40: 
 41: export class FrameReader {
 42:   private queue: Uint8Array = EMPTY;
 43:   private readonly modulus = new SimpleModulusDecryptor();
 44:   private readonly xor32: Xor32Decryptor | null;
 45: 
 46:   constructor(readonly direction: Direction) {
 47:     if (direction === 'server') {
 48:       this.modulus.decryptionKeys = SimpleModulusKeys.CreateDecryptionKeys([
 49:         ...gameVersion.protocol.encryption.serverToClient,
 50:       ]);
 51:       this.xor32 = null;
 52:     } else {
 53:       // The decryptor's default keys are the server's side of the
 54:       // client-to-server direction, which is exactly this.
 55:       this.xor32 = new Xor32Decryptor();
 56:     }
 57:   }
 58: 
 59:   feed(chunk: Uint8Array, onFrame: (frame: Frame) => void): void {
 60:     if (this.queue.length + chunk.length > MAX_QUEUE) this.queue = EMPTY;
 61: 
 62:     const merged = new Uint8Array(this.queue.length + chunk.length);
 63:     merged.set(this.queue, 0);
 64:     merged.set(chunk, this.queue.length);
 65:     this.queue = merged;
 66: 
 67:     while (this.queue.length > 0) {
 68:       const header = this.queue[0];
 69: 
 70:       if (!HEADERS.has(header)) {
 71:         this.queue = this.queue.subarray(1);
 72:         continue;
 73:       }
 74: 
 75:       const headerSize = getSizeOfPacketType(header);
 76:       if (this.queue.length < headerSize + 1) break;
 77: 
 78:       const length = getPacketSize(this.queue);
 79:       if (length < headerSize + 1) {
 80:         this.queue = this.queue.subarray(1);
 81:         continue;
 82:       }
 83:       if (this.queue.length < length) break;
 84: 
 85:       const wire = this.queue.slice(0, length);
 86:       this.queue = this.queue.subarray(length);
 87: 
 88:       const frame = this.decode(header, headerSize, wire);
 89:       if (frame) onFrame(frame);
 90:     }
 91: 
 92:     // Drop the consumed prefix rather than growing a view over a dead buffer.
 93:     if (this.queue.length === 0) this.queue = EMPTY;
 94:   }
 95: 
 96:   private decode(header: number, headerSize: number, wire: Uint8Array): Frame | null {
 97:     let bytes = wire;
 98: 
 99:     if (header >= 0xc3) {
100:       try {
101:         const [ok, decrypted] = this.modulus.Decrypt(wire);
102:         if (!ok) return null;
103:         bytes = decrypted;
104:       } catch {
105:         return null;
106:       }
107:     }
108:     // The client XORs every frame, plain headers included (Store.sendToGS).
109:     if (this.xor32) this.xor32.Decrypt(bytes);
110: 
111:     const codeIndex = headerSize === 3 ? 3 : 2;
112:     if (bytes.length <= codeIndex) return null;
113: 
114:     // The generated packet classes read view-relative offsets from 0.
115:     const copy = bytes.slice(0, bytes.length);
116:     const view = new DataView(copy.buffer, copy.byteOffset, copy.byteLength);
117: 
118:     return {
119:       header,
120:       code: bytes[codeIndex],
121:       subCode: bytes.length > codeIndex + 1 ? bytes[codeIndex + 1] : -1,
122:       view,
123:       bytes: copy,
124:     };
125:   }
126: }
</file>

<file path="proxy/track/journal.ts">
 1: import type { LogQuery, TrackEvent } from '../../src/common/adminProtocol';
 2: 
 3: /**
 4:  * Where journal lines go and come back from. The SQLite one (`store.ts`)
 5:  * needs `bun:sqlite`, which vitest cannot load, so the interface lives here
 6:  * with a memory-backed one for tests and for `TRACK=off`.
 7:  */
 8: export interface Journal {
 9:   append(event: TrackEvent): void;
10:   /** Newest first. One more than `limit` is asked for, so `more` is honest. */
11:   query(query: LogQuery): { events: TrackEvent[]; more: boolean };
12:   close(): void;
13: }
14: 
15: export const DEFAULT_LOG_LIMIT = 100;
16: export const MAX_LOG_LIMIT = 500;
17: 
18: export function clampLimit(limit: number | undefined): number {
19:   if (!limit || !Number.isFinite(limit)) return DEFAULT_LOG_LIMIT;
20:   return Math.max(1, Math.min(MAX_LOG_LIMIT, Math.floor(limit)));
21: }
22: 
23: export class MemoryJournal implements Journal {
24:   private readonly rows: TrackEvent[] = [];
25:   private nextId = 1;
26: 
27:   constructor(private readonly capacity = 20_000) {}
28: 
29:   append(event: TrackEvent): void {
30:     this.rows.push({ ...event, id: this.nextId++ });
31:     if (this.rows.length > this.capacity) this.rows.splice(0, this.rows.length - this.capacity);
32:   }
33: 
34:   query(query: LogQuery): { events: TrackEvent[]; more: boolean } {
35:     const limit = clampLimit(query.limit);
36:     const wanted = query.character.toLowerCase();
37:     const kinds = query.kinds?.length ? new Set(query.kinds) : null;
38:     const found: TrackEvent[] = [];
39: 
40:     for (let i = this.rows.length - 1; i >= 0 && found.length <= limit; i--) {
41:       const row = this.rows[i];
42:       if ((row.character ?? '').toLowerCase() !== wanted) continue;
43:       if (query.before !== undefined && row.at >= query.before) continue;
44:       if (kinds && !kinds.has(row.kind)) continue;
45:       found.push(row);
46:     }
47: 
48:     return { events: found.slice(0, limit), more: found.length > limit };
49:   }
50: 
51:   close(): void {}
52: }
</file>

<file path="proxy/track/names.ts">
