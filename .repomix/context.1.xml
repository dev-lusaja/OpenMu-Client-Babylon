 928:   /**
 929:    * Orders a previous process claimed and never settled. A claim and its
 930:    * settlement happen in one pass, so anything still `delivering` at boot
 931:    * was cut off - by a deploy's restart, most likely - and whether its
 932:    * transaction committed is a fact only OpenMU's database holds. Requeueing
 933:    * would deliver twice if it did; failing would tell the player nothing was
 934:    * spent if it was. So they are named, loudly, and left for a person and
 935:    * `cashshop-orders`.
 936:    */
 937:   private reportInterrupted(): void {
 938:     const interrupted = deliveringOrders();
 939: 
 940:     if (interrupted.length === 0) return;
 941: 
 942:     for (const order of interrupted) {
 943:       explainDelivering(order.id, 'Delivery was interrupted. Someone will check it.');
 944:       audit('found delivering at boot', { account: order.account, orderId: order.id });
 945:     }
 946: 
 947:     console.error(
 948:       `${interrupted.length} order(s) were left delivering by a previous run ` +
 949:         'and need a person to settle them (bun run cashshop-orders): ' +
 950:         interrupted.map(order => `${order.id} for ${order.account}`).join(', ')
 951:     );
 952:   }
 953: 
 954:   stop(): void {
 955:     this.stopped = true;
 956:     if (this.timer) clearTimeout(this.timer);
 957:     if (this.sweeper) clearInterval(this.sweeper);
 958:     this.timer = null;
 959:     this.sweeper = null;
 960:   }
 961: 
 962:   private schedule(delay: number): void {
 963:     if (this.stopped) return;
 964:     this.timer = setTimeout(() => void this.tick(), delay);
 965:     this.timer.unref();
 966:   }
