317: /**
318:  * Warps the seller to the buyer and waits until they can see each other.
319:  *
320:  * Mutual visibility is the real precondition, not distance: `TradeRequest` is
321:  * resolved against the requester's observers, so the partner has to be one.
322:  * The warp is retried because a player who is still entering the world will
323:  * not notice someone arriving on top of them.
324:  */
325: async function meetUp(seller: Bot, buyer: Bot, attempts = 4) {
326:   // Check before warping. A warp is a leave-and-re-enter, so tracing to
327:   // someone already in view drops the bot out of *their* scope and it is not
328:   // put back - which leaves the pair one-way visible and the trade refused.
329:   const already = seller.scope.byName(buyer.name);
330:   if (already && buyer.scope.byName(seller.name)) {
331:     log(`${seller.name} and ${buyer.name} already see each other, no warp needed`);
332:     return already;
333:   }
334: 
335:   for (let attempt = 1; attempt <= attempts; attempt++) {
336:     log(`${seller.name} tracing to ${buyer.name} (attempt ${attempt})`);
337:     await seller.session.warpTo(buyer.name);
338: 
339:     // The warp gets the bot there but does not announce it: it is a map
340:     // change, so it drops out of the buyer's scope and the buyer is never told
341:     // it came back. An ordinary in-map move onto their tile is broadcast the
342:     // way walking is, and that is what makes the pair mutually visible.
343:     for (let waited = 0; waited < 4000; waited += 500) {
344:       await sleep(500);
345:       const here = seller.scope.byName(buyer.name);
346:       if (here) {
347:         seller.session.teleportTo(here.x, here.y);
348:         break;
349:       }
350:     }
351: 
352:     for (let waited = 0; waited < 5000; waited += 500) {
353:       await sleep(500);
354:       const partner = seller.scope.byName(buyer.name);
355:       const mutual = buyer.scope.byName(seller.name);
356:       if (partner && mutual) return partner;
357:     }
358: 
359:     log(
360:       `not mutual yet - ${seller.name} sees ` +
361:         `${JSON.stringify(seller.scope.all.map(p => p.name))}, ${buyer.name} sees ` +
362:         `${JSON.stringify(buyer.scope.all.map(p => p.name))}`
363:     );
364:   }
365:   throw new Error(`${seller.name} and ${buyer.name} never came into view of each other`);
366: }
