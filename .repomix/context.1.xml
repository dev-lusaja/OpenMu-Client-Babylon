 823:   /**
 824:    * Resolves the schema and the configuration once, so a database that does
 825:    * not look as expected is refused at boot, loudly, and not on the first
 826:    * order. Retried on every poll until it succeeds, because the database may
 827:    * simply not be up yet. The schema is the gate's own resolution: one walk
 828:    * of `information_schema` per process, and no way for the two to disagree.
 829:    */
 830:   async resolveOnce(): Promise<Resolved> {
 831:     if (this.resolved) return this.resolved;
 832: 
 833:     const schema = await this.gate.schemaOnce();
 834:     const gameConfigurationId = await resolveGameConfiguration(this.sql, schema);
 835:     const excellentTypeId = await resolveExcellentType(this.sql, schema);
 836:     const partial = { schema, gameConfigurationId, excellentTypeId, chaosDefinitionId: '' };
 837:     const chaos = await findDefinition(this.sql, partial, JEWEL_OF_CHAOS.group, JEWEL_OF_CHAOS.num);
 838: 
 839:     if (!chaos) {
 840:       throw new Error(
 841:         'the game configuration has no Jewel of Chaos ' +
 842:           `(${JEWEL_OF_CHAOS.group}/${JEWEL_OF_CHAOS.num}) definition`
 843:       );
 844:     }
 845: 
 846:     this.resolved = { ...partial, chaosDefinitionId: chaos.id };
 847:     console.info(
 848:       `cash shop fulfilment ${this.mode}: schema resolved, ` +
 849:         `game configuration ${gameConfigurationId}, chaos definition ${chaos.id}`
 850:     );
 851: 
 852:     return this.resolved;
 853:   }
