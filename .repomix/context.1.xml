189:   /** One client ws message that starts `C1 ?? FA`, still Xor32'd. Never throws. */
190:   receive(peer: BandPeer, wire: Uint8Array): void {
191:     const state = this.peers.get(peer);
192:     if (!state) return;
193:     const now = this.now();
194: 
195:     if (wire.length < 4 || wire.length > 255 || wire[1] !== wire.length) {
196:       this.strike(state, now, 'malformed');
197:       return;
198:     }
199: 
200:     if (state.bytes.add(now, wire.length) > BAND_LIMITS.maxBytesPerSecond) {
201:       if (state.performing) this.endPerformance(state.performing, StopReason.Flood);
202:       else this.strike(state, now, 'rate');
203:       return;
204:     }
205: 
206:     const decoded = this.decode(state, wire);
207:     if (!decoded) {
208:       this.strike(state, now, 'malformed');
209:       return;
210:     }
211: 
212:     const { message, plain } = decoded;
213:     const track = state.peer.track;
214:     if (!track.inWorld || track.objectId === null) return;
215: 
216:     switch (message.sub) {
217:       case BandSub.Start:
218:         this.onStart(state, message, plain, now);
219:         return;
220:       case BandSub.Stop:
221:         // Putting the instrument away ends both: the performance (the pose
222:         // others see) and any band membership.
223:         if (state.performing) {
224:           this.endPerformance(state.performing, StopReason.Ended);
225:           state.cooldownUntil = now + BAND_LIMITS.cooldownAfterEndMs;
226:         }
227:         if (state.memberOf) this.leave(state, false);
228:         return;
229:       case BandSub.Batch:
230:         this.onBatch(state, message, plain, now);
231:         return;
232:       case BandSub.Join:
233:         this.onJoin(state, message, now);
234:         return;
235:       case BandSub.Leave:
236:         if (state.memberOf) this.leave(state, false);
237:         return;
238:       case BandSub.BandState: {
239:         const perf = state.performing;
240:         if (!perf) return;
241:         if (perf.states.add(now) > 2) {
242:           this.strike(state, now, 'rate');
243:           return;
244:         }
245:         perf.stateFrame = stampPerformer(plain, perf.id);
246:         this.relay(perf, perf.stateFrame, now);
247:         return;
248:       }
249:       case BandSub.ChannelNames: {
250:         const perf = state.performing;
251:         if (!perf) return;
252:         if (now - perf.lastNamesAt < NAMES_INTERVAL_MS) {
253:           this.strike(state, now, 'rate');
254:           return;
255:         }
256:         perf.lastNamesAt = now;
257:         this.relay(perf, stampPerformer(plain, perf.id), now);
258:         return;
259:       }
260:     }
261:   }
262: 
263:   /**
264:    * Performers who left their map, members who wandered off. Every few
265:    * seconds. A performer whose song is over stays: an instrument held out
266:    * costs nothing, and a dead socket ends its performance in `detach`.
267:    */
268:   sweep(now = this.now()): void {
269:     for (const perf of Array.from(this.performers.values())) {
270:       this.refreshReceivers(perf, now, true);
271:       if (!this.performers.has(perf.state)) continue;
272:       for (const member of Array.from(perf.members)) {
273:         const t = member.peer.track;
274:         if (!t.inWorld || t.map !== perf.map || chebyshev(t, perf.state.peer.track) > BAND_LIMITS.joinRangeTiles) {
