<file path="proxy/track/store.ts">
  1: import { Database } from 'bun:sqlite';
  2: import { mkdirSync } from 'node:fs';
  3: import { homedir } from 'node:os';
  4: import { dirname, join } from 'node:path';
  5: import { migrate } from '../../tools/sqliteMigrate';
  6: import type { LogQuery, TrackEvent } from '../../src/common/adminProtocol';
  7: import { clampLimit, type Journal } from './journal';
  8: 
  9: /**
 10:  * The journal on disk.
 11:  *
 12:  * Its own file, not OpenMU's database and not any other service's: this is
 13:  * what was *observed* on the wire, and nothing here can reach an account.
 14:  * The schema is `migrations/001_character_events.sql`, applied here on a
 15:  * fresh box and by hand on a live one - the same file both times.
 16:  *
 17:  * Lines are written in batches: they queue in memory and land in one
 18:  * transaction every half second, so a busy hour is a few hundred inserts
 19:  * rather than a few hundred fsyncs.
 20:  */
 21: 
 22: export const DEFAULT_TRACK_DB = join(homedir(), '.mu-proxy', 'track.sqlite');
 23: 
 24: const FLUSH_MS = 500;
 25: const PRUNE_MS = 60 * 60 * 1000;
 26: const DAY_MS = 24 * 60 * 60 * 1000;
 27: 
 28: type Row = {
 29:   id: number;
 30:   at: number;
 31:   account: string | null;
 32:   character: string | null;
 33:   kind: string;
 34:   text: string;
 35:   data: string | null;
 36: };
 37: 
 38: export class SqliteJournal implements Journal {
 39:   private readonly db: Database;
 40:   private readonly insert;
 41:   private pending: TrackEvent[] = [];
 42:   private flushTimer: ReturnType<typeof setTimeout> | null = null;
 43:   private readonly pruneTimer: ReturnType<typeof setInterval>;
 44: 
 45:   constructor(path: string, private readonly retainDays: number) {
 46:     mkdirSync(dirname(path), { recursive: true });
 47:     this.db = new Database(path, { create: true });
 48:     this.db.run('PRAGMA journal_mode = WAL');
 49: 
 50:     const applied = migrate(this.db, join(import.meta.dir, '..', 'migrations'));
 51:     if (applied.length > 0) {
 52:       console.info(`track: applied ${applied.length} migration(s): ${applied.join(', ')}`);
 53:     }
 54: 
 55:     this.insert = this.db.query<unknown, [number, string | null, string | null, string, string, string | null]>(
 56:       'INSERT INTO character_events (at, account, character, kind, text, data) VALUES (?, ?, ?, ?, ?, ?)'
 57:     );
 58: 
 59:     this.prune();
 60:     this.pruneTimer = setInterval(() => this.prune(), PRUNE_MS);
 61:   }
 62: 
 63:   append(event: TrackEvent): void {
 64:     this.pending.push(event);
 65:     if (!this.flushTimer) this.flushTimer = setTimeout(() => this.flush(), FLUSH_MS);
 66:   }
 67: 
 68:   flush(): void {
 69:     if (this.flushTimer) {
 70:       clearTimeout(this.flushTimer);
 71:       this.flushTimer = null;
 72:     }
 73:     if (this.pending.length === 0) return;
 74: 
 75:     const batch = this.pending;
 76:     this.pending = [];
 77: 
 78:     try {
 79:       this.db.transaction(() => {
 80:         for (const event of batch) {
 81:           this.insert.run(
 82:             event.at,
 83:             event.account,
 84:             event.character,
 85:             event.kind,
 86:             event.text,
 87:             event.data ? JSON.stringify(event.data) : null
 88:           );
 89:         }
 90:       })();
 91:     } catch (error) {
 92:       console.error('track: journal write failed:', error);
 93:     }
 94:   }
 95: 
 96:   query(query: LogQuery): { events: TrackEvent[]; more: boolean } {
 97:     const limit = clampLimit(query.limit);
 98:     const where: string[] = ['character = ? COLLATE NOCASE'];
 99:     const params: (string | number)[] = [query.character];
100: 
101:     if (query.before !== undefined) {
102:       where.push('at < ?');
103:       params.push(query.before);
104:     }
105:     if (query.kinds?.length) {
106:       where.push(`kind IN (${query.kinds.map(() => '?').join(', ')})`);
107:       params.push(...query.kinds);
108:     }
109: 
110:     // The queue is flushed first so a line written a moment ago is in the answer.
111:     this.flush();
112: 
113:     const rows = this.db
114:       .query<Row, (string | number)[]>(
115:         `SELECT id, at, account, character, kind, text, data FROM character_events
116:          WHERE ${where.join(' AND ')}
117:          ORDER BY at DESC, id DESC
118:          LIMIT ?`
119:       )
120:       .all(...params, limit + 1);
121: 
122:     const events = rows.slice(0, limit).map(row => {
123:       const event: TrackEvent = {
124:         id: row.id,
125:         at: row.at,
126:         account: row.account,
127:         character: row.character,
128:         kind: row.kind as TrackEvent['kind'],
129:         text: row.text,
130:       };
131:       if (row.data) {
132:         try {
133:           event.data = JSON.parse(row.data) as Record<string, unknown>;
134:         } catch {
135:           /* a line nobody can parse is still a line */
136:         }
137:       }
138:       return event;
139:     });
140: 
141:     return { events, more: rows.length > limit };
142:   }
143: 
144:   private prune(): void {
145:     if (!(this.retainDays > 0)) return;
146:     try {
147:       this.db.run('DELETE FROM character_events WHERE at < ?', [Date.now() - this.retainDays * DAY_MS]);
148:     } catch (error) {
149:       console.error('track: prune failed:', error);
150:     }
151:   }
152: 
153:   close(): void {
154:     clearInterval(this.pruneTimer);
155:     this.flush();
156:     this.db.close();
157:   }
158: }
</file>

<file path="proxy/track/tracker.ts">
  1: import type { TrackEvent, TrackedPlayer } from '../../src/common/adminProtocol';
  2: import { TrackedSession, type SessionOptions } from './session';
  3: 
  4: /**
  5:  * Every tracked socket, and the one place the admin stream and the journal
  6:  * subscribe to.
  7:  *
  8:  * Changes are coalesced: a socket reports a health tick or a walk on every
  9:  * packet, and a panel needs neither more than four times a second. Moves and
 10:  * snapshot changes queue per session and flush together on a short timer;
 11:  * events go out as they happen, since each one is a line somebody reads.
 12:  */
 13: 
 14: export type TrackerListener = {
 15:   player?(player: TrackedPlayer): void;
 16:   move?(id: string, map: number | null, x: number, y: number): void;
 17:   leave?(id: string): void;
 18:   event?(id: string, event: TrackEvent): void;
 19: };
 20: 
 21: const FLUSH_MS = 250;
 22: 
 23: export class Tracker {
 24:   private readonly sessions = new Set<TrackedSession>();
 25:   private readonly listeners = new Set<TrackerListener>();
 26:   private readonly pendingPlayers = new Map<string, TrackedSession>();
 27:   private readonly pendingMoves = new Map<string, TrackedSession>();
 28:   private timer: ReturnType<typeof setTimeout> | null = null;
 29: 
 30:   constructor(private readonly options: SessionOptions = {}) {}
 31: 
 32:   /** A socket opened; feed it and `close` it when the socket goes. */
 33:   open(nonce: string | null, port: number | null): TrackedSession {
 34:     const session = new TrackedSession(
 35:       nonce,
 36:       port,
 37:       {
 38:         event: (s, event) => {
 39:           if (!s.identified) return;
 40:           for (const listener of this.listeners) listener.event?.(s.id, event);
 41:         },
 42:         change: s => {
 43:           if (!s.identified) return;
 44:           this.pendingPlayers.set(s.id, s);
 45:           this.schedule();
 46:         },
 47:         move: s => {
 48:           if (!s.identified) return;
 49:           this.pendingMoves.set(s.id, s);
 50:           this.schedule();
 51:         },
 52:       },
 53:       this.options
 54:     );
 55: 
 56:     this.sessions.add(session);
 57:     return session;
 58:   }
 59: 
 60:   close(session: TrackedSession): void {
 61:     const wasIdentified = session.identified;
 62:     session.close();
 63:     this.sessions.delete(session);
 64:     this.pendingPlayers.delete(session.id);
 65:     this.pendingMoves.delete(session.id);
 66:     if (wasIdentified) for (const listener of this.listeners) listener.leave?.(session.id);
 67:   }
 68: 
 69:   /** Every socket the game server has put a name to. */
 70:   snapshot(): TrackedPlayer[] {
 71:     const players: TrackedPlayer[] = [];
 72:     for (const session of this.sessions) {
 73:       if (session.identified) players.push(session.snapshot());
 74:     }
 75:     return players;
 76:   }
 77: 
 78:   /**
 79:    * The auth question: does a socket carrying this nonce hold a character the
 80:    * server itself flagged as a game master, in the world right now?
 81:    */
 82:   isGameMasterSession(nonce: string): boolean {
 83:     for (const session of this.sessions) {
 84:       if (session.nonce === nonce && session.gameMaster && session.inWorld) return true;
 85:     }
 86:     return false;
 87:   }
 88: 
 89:   subscribe(listener: TrackerListener): () => void {
 90:     this.listeners.add(listener);
 91:     return () => {
 92:       this.listeners.delete(listener);
 93:     };
 94:   }
 95: 
 96:   get size(): number {
 97:     return this.sessions.size;
 98:   }
 99: 
100:   private schedule(): void {
101:     if (this.timer) return;
102:     this.timer = setTimeout(() => {
103:       this.timer = null;
104:       this.flush();
105:     }, FLUSH_MS);
106:   }
107: 
108:   /** Send what is queued now. Tests call it instead of waiting on the timer. */
109:   flush(): void {
110:     if (this.timer) {
111:       clearTimeout(this.timer);
112:       this.timer = null;
113:     }
114: 
115:     const changed = [...this.pendingPlayers.values()];
116:     const moved = [...this.pendingMoves.values()].filter(s => !this.pendingPlayers.has(s.id));
117:     this.pendingPlayers.clear();
118:     this.pendingMoves.clear();
119: 
120:     for (const session of changed) {
121:       if (!this.sessions.has(session)) continue;
122:       const player = session.snapshot();
123:       for (const listener of this.listeners) listener.player?.(player);
124:     }
125: 
126:     for (const session of moved) {
127:       if (!this.sessions.has(session)) continue;
128:       for (const listener of this.listeners) {
129:         listener.move?.(session.id, session.map, session.x, session.y);
130:       }
131:     }
132:   }
133: }
</file>

<file path="proxy/track/wire.ts">
 1: import {
 2:   SimpleModulusEncryptor,
 3:   SimpleModulusKeys,
 4: } from '../../src/common/encryption/simpleModulus';
 5: import { Xor32Encryptor } from '../../src/common/encryption/xor32';
 6: import { gameVersion } from '../../versions/season6';
 7: 
 8: /**
 9:  * Frames as the two ends put them on the wire, for the demo and the tests:
10:  * the client's way (`Store.sendToGS`: Xor32 over everything, SimpleModulus
11:  * for headers >= 0xC3) and the server's (SimpleModulus alone, with its own
12:  * key set). One encoder per fake socket, since the modulus counter runs per
13:  * stream.
14:  */
15: 
16: /** OpenMU `PipelinedSimpleModulusEncryptor.DefaultServerKey` - the public default. */
17: const SERVER_TO_CLIENT_ENCRYPTION_KEYS = [
18:   73326, 109989, 98843, 171058, 13169, 19036, 35482, 29587, 62004, 64409, 35374, 64599,
19: ];
20: 
21: export class WireEncoder {
22:   private readonly clientModulus = new SimpleModulusEncryptor();
23:   private readonly serverModulus = new SimpleModulusEncryptor();
24:   private readonly xor32 = new Xor32Encryptor();
25: 
26:   constructor() {
27:     this.clientModulus.encryptionKeys = SimpleModulusKeys.CreateEncryptionKeys([
28:       ...gameVersion.protocol.encryption.clientToServer,
29:     ]);
30:     this.serverModulus.encryptionKeys = SimpleModulusKeys.CreateEncryptionKeys(
31:       SERVER_TO_CLIENT_ENCRYPTION_KEYS
32:     );
33:   }
34: 
35:   client(packet: Uint8Array): Uint8Array {
36:     const copy = packet.slice();
37:     this.xor32.Encrypt(copy);
38:     return copy[0] >= 0xc3 ? this.clientModulus.Encrypt(copy) : copy;
39:   }
40: 
41:   server(packet: Uint8Array): Uint8Array {
42:     const copy = packet.slice();
43:     return copy[0] >= 0xc3 ? this.serverModulus.Encrypt(copy) : copy;
44:   }
45: }
46: 
47: /** The bytes of a generated packet, whole. */
48: export function packetBytes(packet: { buffer: DataView }): Uint8Array {
49:   const view = packet.buffer;
50:   return new Uint8Array(view.buffer, view.byteOffset, view.byteLength).slice();
51: }
52: 
53: /** A raw frame by hand: header, length, then the body. */
54: export function rawFrame(header: number, body: number[]): Uint8Array {
55:   const headerSize = header === 0xc2 || header === 0xc4 ? 3 : 2;
56:   const length = headerSize + body.length;
57:   const bytes = new Uint8Array(length);
58:   bytes[0] = header;
59:   if (headerSize === 2) {
60:     bytes[1] = length;
61:   } else {
62:     bytes[1] = length >> 8;
63:     bytes[2] = length & 0xff;
64:   }
65:   bytes.set(body, headerSize);
66:   return bytes;
67: }
68: 
69: /** A name padded with zeros to the wire's fixed width. */
70: export function nameBytes(name: string, width: number): number[] {
71:   const out = new Array<number>(width).fill(0);
72:   for (let i = 0; i < Math.min(width, name.length); i++) out[i] = name.charCodeAt(i) & 0xff;
73:   return out;
74: }
