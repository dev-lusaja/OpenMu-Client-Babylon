<file path="marketplace/server/fleet.ts">
 1: /**
 2:  * Which bot does a piece of work. Pure, so it can be tested without a game
 3:  * server behind it.
 4:  *
 5:  * A fleet is several bots in one process on one game server. Any idle bot
 6:  * can collect a listing; a claim or a return is finished only by the bot
 7:  * holding the item, because only it has the item; a payout goes to an idle
 8:  * bot that actually carries the Zen, the richest first, so the float is
 9:  * spent where it is.
10:  */
11: 
12: export type Runner = {
13:   name: string;
14:   busy: boolean;
15:   /** Zen the server last reported for this bot, null until it said. */
16:   zen: number | null;
17:   /** Whether the item in question would fit in its bag. Absent means yes. */
18:   hasRoom?: boolean;
19: };
20: 
21: /**
22:  * The bot to send for a listing, or null with the reason nobody can go.
23:  *
24:  * A collection needs an idle bot with room for the item: a bot whose bag is
25:  * full is passed over for one that is not, rather than sent to open a trade
26:  * the server will fail. A claim or a return can only be the holder's.
27:  */
28: export function pickForListing(
29:   bots: Runner[],
30:   holder: string | null
31: ): { bot: Runner } | { bot: null; reason: string } {
32:   if (holder !== null) {
33:     const own = bots.find(b => b.name === holder);
34:     if (!own) return { bot: null, reason: `bot ${holder} holds the item and is not online` };
35:     if (own.busy) return { bot: null, reason: `bot ${holder} holds the item and is busy` };
36:     return { bot: own };
37:   }
38:   const idle = bots.filter(b => !b.busy);
39:   if (idle.length === 0) return { bot: null, reason: 'every bot is busy' };
40:   const roomy = idle.find(b => b.hasRoom !== false);
41:   return roomy ? { bot: roomy } : { bot: null, reason: 'every idle bot is full' };
42: }
43: 
44: /** The bot to send with `amount` Zen, or null with the reason nobody can. */
45: export function pickForPayout(
46:   bots: Runner[],
47:   amount: number
48: ): { bot: Runner } | { bot: null; reason: string } {
49:   const able = bots
50:     .filter(b => !b.busy && b.zen !== null && b.zen >= amount)
51:     .sort((a, b) => (b.zen ?? 0) - (a.zen ?? 0));
52:   if (able.length > 0) return { bot: able[0] };
53: 
54:   const richest = Math.max(0, ...bots.map(b => b.zen ?? 0));
55:   if (richest < amount) {
56:     return { bot: null, reason: `no bot holds ${amount} Zen (the richest has ${richest})` };
57:   }
58:   return { bot: null, reason: 'every bot with enough Zen is busy' };
59: }
</file>

<file path="marketplace/server/holdingsCli.ts">
  1: import items from '../../src/common/items.json';
  2: import { db } from './db';
  3: 
  4: /**
  5:  * Who holds what: every listing the service has a bot carrying, by bot.
  6:  *
  7:  *   MARKETPLACE_DB=/home/mu/.mu-marketplace/market.sqlite bun run marketplace-holdings
  8:  *
  9:  * The service's own record, not the game's: `holder` and `holder_slot` are
 10:  * what the worker wrote when it collected, and the worker checks them
 11:  * against the bot's actual bag before every delivery. A row here with no bot
 12:  * online to match is the first thing to look at when a listing is stuck.
 13:  */
 14: 
 15: type Row = {
 16:   id: string;
 17:   state: string;
 18:   holder: string | null;
 19:   holder_slot: number | null;
 20:   seller: string;
 21:   seller_char: string;
 22:   buyer_char: string | null;
 23:   price: number;
 24:   item_group: number;
 25:   item_number: number;
 26:   item_level: number;
 27:   updated_at: number;
 28: };
 29: 
 30: const names = new Map<string, string>();
 31: for (const entry of items as { Group: number; Index: number; ItemName: string }[]) {
 32:   names.set(`${entry.Group}/${entry.Index}`, entry.ItemName);
 33: }
 34: 
 35: const itemName = (row: Row) =>
 36:   `${names.get(`${row.item_group}/${row.item_number}`) ?? `item ${row.item_group}/${row.item_number}`}` +
 37:   (row.item_level ? ` +${row.item_level}` : '');
 38: 
 39: const age = (at: number) => {
 40:   const mins = Math.floor((Date.now() - at) / 60_000);
 41:   return mins < 60 ? `${mins}m` : mins < 24 * 60 ? `${Math.floor(mins / 60)}h` : `${Math.floor(mins / 1440)}d`;
 42: };
 43: 
 44: const rows = db
 45:   .query(
 46:     `SELECT id, state, holder, holder_slot, seller, seller_char, buyer_char, price,
 47:             item_group, item_number, item_level, updated_at
 48:      FROM listings WHERE state IN ('active', 'claimed', 'returning', 'stuck')
 49:      ORDER BY holder, holder_slot`
 50:   )
 51:   .all() as Row[];
 52: 
 53: const byBot = new Map<string, Row[]>();
 54: for (const row of rows) {
 55:   const key = row.holder ?? '(no bot)';
 56:   byBot.set(key, [...(byBot.get(key) ?? []), row]);
 57: }
 58: 
 59: if (byBot.size === 0) console.log('no bot holds anything');
 60: for (const [holder, held] of [...byBot.entries()].sort()) {
 61:   console.log(`${holder}: ${held.length} item(s)`);
 62:   for (const row of held) {
 63:     const slot = row.holder_slot === null ? 'slot ?' : `slot ${String(row.holder_slot).padStart(3)}`;
 64:     const who = row.state === 'claimed' ? `for ${row.buyer_char}` : `from ${row.seller_char}`;
 65:     console.log(
 66:       `  ${slot}  ${row.state.padEnd(9)} ${itemName(row).padEnd(28)} ${String(row.price).padStart(11)} Zen  ${who}  ${age(row.updated_at)} ago  ${row.id.slice(0, 8)}`
 67:     );
 68:   }
 69: }
 70: 
 71: const pending = db.query(`SELECT count(*) AS n FROM listings WHERE state = 'pending'`).get() as { n: number };
 72: if (pending.n > 0) console.log(`\n${pending.n} listing(s) waiting to be collected`);
 73: 
 74: const balances = db.query('SELECT account, zen FROM balances WHERE zen > 0 ORDER BY zen DESC').all() as {
 75:   account: string;
 76:   zen: number;
 77: }[];
 78: if (balances.length > 0) {
 79:   console.log('\nowed to sellers:');
 80:   for (const b of balances) console.log(`  ${b.account.padEnd(12)} ${String(b.zen).padStart(11)} Zen`);
 81: }
 82: 
 83: const requests = db.query('SELECT account, character, requested_at FROM payout_requests').all() as {
 84:   account: string;
 85:   character: string;
 86:   requested_at: number;
 87: }[];
 88: if (requests.length > 0) {
 89:   console.log('\ncollect requests:');
 90:   for (const r of requests) console.log(`  ${r.account.padEnd(12)} via ${r.character}  ${age(r.requested_at)} ago`);
 91: }
 92: 
 93: const leases = db.query('SELECT key, worker, until FROM leases WHERE until >= ?').all(Date.now()) as {
 94:   key: string;
 95:   worker: string;
 96:   until: number;
 97: }[];
 98: if (leases.length > 0) {
 99:   console.log('\nin hand right now:');
100:   for (const l of leases) console.log(`  ${l.worker.padEnd(8)} ${l.key}`);
101: }
102: 
103: db.close();
