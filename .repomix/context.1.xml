 11: /**
 12:  * The cash shop service.
 13:  *
 14:  * The shop is an in-game window (`src/ui/pages/worldPage/components/cashShop`)
 15:  * opened from the item shop button on the bottom bar, so there is no page to
 16:  * serve and no sign-in: the player is already authenticated to the game
 17:  * server, and the proxy that carries their socket is what vouches for them
 18:  * here (`tickets.ts`). What this process owns is everything a client must
 19:  * not: the catalogue and its prices, the gacha draw, the order queue, and the
 20:  * one transaction in the repository that writes to OpenMU's database.
 21:  *
 22:  * Four things happen here, in four files:
 23:  *
 24:  *   identity     POST /api/session turns the websocket nonce into a ticket by
 25:  *                asking the proxy's loopback presence server who logged in on
 26:  *                it. Every other request carries that ticket in its body or
 27:  *                query string - never a cookie, never a custom header, because
 28:  *                the window fetches with `credentials: 'omit'` and the
 29:  *                preflight below allows only `Content-Type`. The ticket names
 30:  *                the account; the client's own claim is never read. Anything
 31:  *                that spends - placing, cancelling - carries the nonce as
 32:  *                well, and the proxy is asked again whether that socket is
 33:  *                still logged in as that account: a ticket reads, a live
 34:  *                session spends.
 35:  *   placement    POST /api/orders bounds the spend against the database
 36:  *                wallet and the daily caps and writes the order to the
 37:  *                service's own SQLite (`orders.ts`, `db.ts`). A gacha order is
 38:  *                rolled and committed in that same write, so the window can
 39:  *                play the reveal the moment the player pays and nobody can
 40:  *                shop for an outcome by cancelling.
 41:  *   fulfilment   A worker drains the queue whenever the safety gate says an
 42:  *                account is safe to write to (`fulfilment.ts`, `gate.ts`).
 43:  *                `CASHSHOP_FULFIL=off`, the default, rehearses the whole thing
 44:  *                and writes nothing.
 45:  *   the catalog  GET /api/catalog, public and read-only.
 46:  *
 47:  * Listens on loopback. Caddy publishes it under `/api` on the client host,
 48:  * which keeps it same-origin with the game; `vite.config.ts` proxies the same
 49:  * path in dev. It can also live on a host of its own, in which case
 50:  * `CORS_ORIGIN` names the client and every answer carries the CORS headers.
 51:  */
 52: 
 53: const PORT = Number(process.env.PORT || 3200);
 54: const HOSTNAME = process.env.HOSTNAME || '127.0.0.1';
 55: 
 56: /**
 57:  * `postgres://user:pass@host:port/db`, as register and the gate CLI. The
 58:  * database is bound to loopback by the compose file, so this is a local
 59:  * connection.
 60:  */
 61: const DATABASE_URL =
 62:   process.env.DATABASE_URL || 'postgres://postgres:admin@127.0.0.1:5432/openmu';
 63: 
 64: /**
 65:  * Origins allowed to call this from a browser, comma separated, matched
 66:  * exactly.
 67:  *
 68:  * Unset by default, which is the same-origin deployment: Caddy publishes the
 69:  * service under `/api` on the client's own host, the window fetches a relative
 70:  * path, and no CORS header is involved at all.
 71:  *
 72:  * Set it when the service gets a host of its own (`api.example.net`), and
 73:  * build the client with `VITE_CASHSHOP_API` pointing there. Exact origins
 74:  * only, never `*`: every order carries a ticket, and a wildcard is how a page
 75:  * on any origin gets to spend a player's jewels with a ticket it found.
 76:  */
 77: const ALLOWED_ORIGINS = new Set(
 78:   (process.env.CORS_ORIGIN ?? '')
 79:     .split(',')
 80:     .map(origin => origin.trim())
 81:     .filter(Boolean)
 82: );
 83: 
 84: /**
 85:  * The free roll that returns a real result from the real tables. It existed so
 86:  * the reveal could be built before ordering was, and it stays available for
 87:  * that - but only when asked for, because a paid gacha next to a free one that
 88:  * draws from the same tables is hollow: anyone could sample the weights for
 89:  * nothing, and a client could show a "real" roll without ever having placed an
 90:  * order. Off unless `CASHSHOP_PREVIEW=on`, and never on in production.
 91:  */
 92: const PREVIEW_OPEN = process.env.CASHSHOP_PREVIEW === 'on';
 93: 
 94: /**
 95:  * Attempts per bucket per window, in memory. Forgetting them on a restart
 96:  * costs nothing: the daily caps, which are what actually bound the damage,
 97:  * are on disk in the order store.
 98:  *
 99:  * The session exchange is counted per network and nothing else, because no
100:  * account is known until the presence server answers. A page load costs one
101:  * and the window re-exchanges once every ten minutes, so 30 in a window is a
102:  * household of players reloading their tabs, and the bucket is its own: a
103:  * neighbour's shopping must not make a player's login fail to exchange.
104:  *
105:  * Everything that carries a ticket - reading the queue, placing, cancelling -
106:  * is counted per account, which is the identity a ticket actually proves,
107:  * with a per-network bucket behind it only as a backstop against one address
108:  * driving many tickets. The account number comes from what the window does:
109:  * it polls the queue every 30 s (`ORDERS_POLL_MS` in `src/cashShop/state.ts`),
110:  * which is 20 reads a window doing nothing, refreshes after every order, and
111:  * the caps in `catalog.ts` allow about 140 orders a day of which the gacha's
112:  * 12 is the most a player places in one sitting. 120 lets a player buy the
113:  * whole day's allowance inside one window and still holds one ticket to a
114:  * fifth of a request a second - two Postgres reads each, on the database the
115:  * game server shares. The network backstop is loose on purpose: a shared
116:  * address is a LAN party or a campus NAT, and one player must never spend
117:  * the neighbours' allowance.
118:  */
119: const BURST_WINDOW_MS = Number(process.env.BURST_WINDOW_MS || 10 * 60 * 1000);
120: const SESSION_BURST_LIMIT = Number(process.env.SESSION_BURST_LIMIT || 30);
121: const ACCOUNT_BURST_LIMIT = Number(process.env.ACCOUNT_BURST_LIMIT || 120);
122: const NETWORK_BURST_LIMIT = Number(process.env.NETWORK_BURST_LIMIT || 1000);
123: 
124: const sql = postgres(DATABASE_URL);
125: const gateConfig = loadGateConfig();
126: const gate = new SafetyGate(sql, gateConfig);
127: const fulfilment = new Fulfilment(sql, gate, loadFulfilmentConfig());
128: const orders = new Orders(fulfilment);
129: 
130: const sessionExchanges = new BurstLimit(SESSION_BURST_LIMIT, BURST_WINDOW_MS);
131: const accountRequests = new BurstLimit(ACCOUNT_BURST_LIMIT, BURST_WINDOW_MS);
132: const networkRequests = new BurstLimit(NETWORK_BURST_LIMIT, BURST_WINDOW_MS);
133: 
134: /* --------------------------------------------------------------- answers */
135: 
136: /** The CORS headers for this caller, or nothing when it is same-origin. */
137: function corsHeaders(req: Request): Record<string, string> {
138:   const origin = req.headers.get('origin');
139: 
140:   if (!origin || !ALLOWED_ORIGINS.has(origin)) return {};
141: 
142:   return {
143:     'Access-Control-Allow-Origin': origin,
144:     // The answer differs by origin, so a shared cache must not reuse one for
145:     // another.
146:     Vary: 'Origin',
147:     'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
148:     'Access-Control-Allow-Headers': 'Content-Type',
149:     'Access-Control-Max-Age': '86400',
150:   };
151: }
152: 
153: function json(
154:   body: unknown,
155:   status = 200,
156:   extra: Record<string, string> = {}
157: ): Response {
158:   return new Response(JSON.stringify(body), {
159:     status,
160:     headers: { 'Content-Type': 'application/json', ...extra },
161:   });
162: }
163: 
164: const TOO_MANY = 'Too many requests. Please slow down.';
165: 
166: /** Caddy is in front, so the real client is in the forwarded header; `clientIp` knows when to believe it. */
167: function networkHammering(
168:   req: Request,
169:   server: { requestIP(req: Request): { address: string } | null }
170: ): boolean {
171:   return networkRequests.hammering(bucketFor(clientIp(req, server)));
172: }
173: 
174: /**
175:  * The account a ticket names, with its bucket charged, or the answer to send
176:  * instead. 401 for anything but a good ticket: the client treats 401 as
177:  * "exchange again", and every failure here - malformed, forged, expired - is
178:  * cured by exactly that, so they are not told apart on the wire. The account
179:  * bucket is charged only after the ticket verifies, because before that
180:  * there is no account to charge and a forged ticket could name anyone's.
181:  */
182: function accountFor(
183:   ticket: unknown,
184:   cors: Record<string, string>
185: ): { account: string } | { answer: Response } {
186:   const verified = verifyTicket(ticket);
187: 
188:   if (!verified.ok) {
189:     return { answer: json({ error: 'Your session has expired. Please try again.' }, 401, cors) };
190:   }
191: 
192:   if (accountRequests.hammering(verified.account)) {
193:     return { answer: json({ error: TOO_MANY }, 429, cors) };
194:   }
195: 
196:   return { account: verified.account };
197: }
198: 
199: /**
200:  * The status for a spend the proxy would not vouch for. Not 401: that tells
201:  * the client to exchange its ticket, and a fresh ticket would be refused for
202:  * the same reason. `unknown` and `someoneElse` are the player's to fix by
203:  * logging in; `unreachable` is ours.
204:  */
205: function liveStatus(reason: 'malformed' | 'unknown' | 'unreachable' | 'someoneElse'): number {
206:   return reason === 'malformed' ? 400 : reason === 'unreachable' ? 503 : 403;
207: }
208: 
209: /** The request body as an object, or null for anything that is not one. */
210: async function bodyOf(req: Request): Promise<Record<string, unknown> | null> {
211:   try {
212:     const body: unknown = await req.json();
213:     return body !== null && typeof body === 'object' && !Array.isArray(body) ? (body as Record<string, unknown>) : null;
214:   } catch {
215:     return null;
216:   }
217: }
218: 
219: /* ------------------------------------------------------------------ serve */
220: 
221: Bun.serve({
222:   port: PORT,
223:   hostname: HOSTNAME,
224:   async fetch(req, server) {
225:     const url = new URL(req.url);
226:     const path = url.pathname;
227:     const cors = corsHeaders(req);
228: 
229:     // The preflight a browser sends before a cross-origin POST. Answered here
230:     // rather than falling through to the 404 below.
231:     if (req.method === 'OPTIONS') {
232:       const allowed = cors['Access-Control-Allow-Origin'] !== undefined;
233:       return new Response(null, { status: allowed ? 204 : 403, headers: cors });
234:     }
235: 
236:     try {
237:       if (path === '/api/catalog' && req.method === 'GET') {
238:         return json(
239:           { lines: LINES, products: CATALOG, gachaPoolSize: GACHA_POOL.length },
240:           200,
241:           cors
242:         );
243:       }
244: 
245:       if (path === '/api/session' && req.method === 'POST') {
246:         // Checked before the presence server is asked, so a spent allowance
247:         // costs nothing upstream.
248:         if (sessionExchanges.hammering(bucketFor(clientIp(req, server)))) {
249:           return json({ error: TOO_MANY }, 429, cors);
250:         }
251: 
252:         const body = await bodyOf(req);
253: 
254:         if (!body) return json({ error: 'Malformed request.' }, 400, cors);
255: 
256:         const exchange = await exchangeSession(body.session);
257: 
258:         if (exchange.ok) return json(exchange.ticket, 200, cors);
259: 
260:         // Not 401: that status tells the client its ticket is stale and to
261:         // exchange again, and here there is no ticket yet - answering 401 to
262:         // the exchange itself would have the window exchanging in a loop.
263:         // `unknown` is the player's to fix (log in, then try again);
264:         // `unreachable` is ours.
265:         const status = exchange.reason === 'malformed' ? 400 : exchange.reason === 'unknown' ? 403 : 503;
266: 
267:         return json({ error: exchange.message }, status, cors);
268:       }
269: 
270:       if (path === '/api/orders' && req.method === 'GET') {
271:         // Limited like a spend: every read is two Postgres queries against
272:         // OpenMU's database (`Fulfilment.wallet`), and nothing else bounds
273:         // how many of them a ticket can drive.
274:         if (networkHammering(req, server)) return json({ error: TOO_MANY }, 429, cors);
275: 
276:         const who = accountFor(url.searchParams.get('ticket'), cors);
277: 
278:         if ('answer' in who) return who.answer;
279: 
280:         return json(await orders.list(who.account), 200, cors);
281:       }
282: 
283:       if (path === '/api/orders' && req.method === 'POST') {
284:         if (networkHammering(req, server)) return json({ error: TOO_MANY }, 429, cors);
285: 
286:         const body = await bodyOf(req);
287: 
288:         if (!body) return json({ error: 'Malformed request.' }, 400, cors);
289: 
290:         const who = accountFor(body.ticket, cors);
291: 
292:         if ('answer' in who) return who.answer;
293: 
294:         const live = await confirmLive(body.session, who.account);
295: 
296:         if (!live.ok) return json({ error: live.message }, liveStatus(live.reason), cors);
297: 
298:         const order = await orders.place(who.account, body.productId);
299: 
300:         console.info(
301:           `order ${order.id}: ${who.account} bought ${order.productName} for ${order.chaos} chaos` +
302:             (order.roll ? ` (seed ${order.roll.seed}, ${order.roll.tier})` : '')
303:         );
304: 
305:         return json({ order }, 200, cors);
306:       }
307: 
308:       if (path === '/api/orders/cancel' && req.method === 'POST') {
309:         if (networkHammering(req, server)) return json({ error: TOO_MANY }, 429, cors);
310: 
311:         const body = await bodyOf(req);
312: 
313:         if (!body) return json({ error: 'Malformed request.' }, 400, cors);
314: 
315:         const who = accountFor(body.ticket, cors);
316: 
317:         if ('answer' in who) return who.answer;
318: 
319:         const live = await confirmLive(body.session, who.account);
320: 
321:         if (!live.ok) return json({ error: live.message }, liveStatus(live.reason), cors);
322: 
323:         const order = orders.cancel(who.account, body.id);
324: 
325:         console.info(`order ${order.id}: ${who.account} cancelled ${order.productName}`);
326: 
327:         return json({ order }, 200, cors);
328:       }
329: 
330:       if (path === '/api/gacha/preview' && req.method === 'POST') {
331:         // A 404 rather than a 403: when the preview is closed, the route does
332:         // not exist, and the answer should not confirm that it could.
333:         if (!PREVIEW_OPEN) return json({ error: 'Not found' }, 404, cors);
334: 
335:         // A real roll from the real tables, on a fresh seed, that spends
336:         // nothing and writes nothing. Unauthenticated: it tells the caller
337:         // nothing about any player.
338:         return json({ preview: true, roll: roll(newSeed()) }, 200, cors);
339:       }
340: 
341:       return json({ error: 'Not found' }, 404, cors);
342:     } catch (error) {
343:       if (error instanceof Refusal) return json({ error: error.message }, error.status, cors);
344: 
345:       // Never surface the error itself: it would leak the schema, and the
346:       // player can do nothing with it either way.
347:       console.error(`${req.method} ${path} failed:`, error);
348:       return json({ error: 'Something went wrong. Please try again.' }, 500, cors);
349:     }
350:   },
351: });
352: 
353: /* ------------------------------------------------------------------- boot */
354: 
355: console.info(`cash shop api listening on ${HOSTNAME}:${PORT}`);
356: console.info(`  orders          ${DB_PATH}`);
357: console.info(`  fulfilment      ${fulfilment.mode}`);
358: console.info(`  ticket secret   ${process.env.CASHSHOP_TICKET_SECRET ? 'configured' : 'random per boot (set CASHSHOP_TICKET_SECRET)'}`);
359: console.info(`  preview         ${PREVIEW_OPEN ? 'open (CASHSHOP_PREVIEW=on; development only)' : 'closed'}`);
360: console.info(`  cors            ${ALLOWED_ORIGINS.size > 0 ? [...ALLOWED_ORIGINS].join(', ') : 'same-origin only'}`);
361: console.info(`  presence        ${gateConfig.presenceUrl}`);
362: 
363: if (!gateConfig.gameHost || !gateConfig.gamePort) {
364:   console.warn(
365:     '  GAME_PROBE_HOST / GAME_PROBE_PORT are unset, so the port probe will refuse and nothing will be delivered.' +
366:       ' Set them to the address a player\'s client would dial.'
367:   );
368: }
369: 
370: // Said once at boot, in the resolver's own words, rather than discovered on
371: // the first order: a database that is down or does not look like OpenMU's is
372: // the difference between a shop that will sell and one that will only queue.
373: // The worker keeps retrying on its own, so this is a report, not a verdict.
374: fulfilment
375:   .resolveOnce()
376:   .catch(error =>
377:     console.error(
378:       `  OpenMU's database cannot be written to yet, so orders will queue: ${error instanceof Error ? error.message : error}`
379:     )
380:   );
381: 
382: fulfilment.start();
</file>

