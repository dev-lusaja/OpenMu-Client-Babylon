<file path="marketplace/server/listings.ts">
  1: import { randomUUID } from 'node:crypto';
  2: import { audit, db, type ListingRow, type ListingState } from './db';
  3: 
  4: /**
  5:  * What the service knows about what is for sale.
  6:  *
  7:  * The rule this file exists to enforce: **a listing is claimed before any bot
  8:  * is sent out.** Two buyers pressing Buy on the same item at the same moment
  9:  * must not both get a bot dispatched, or one of them stands there waiting for
 10:  * an item that has already gone. The claim is a conditional UPDATE - it either
 11:  * moves the row out of `active` or it does not, and only the winner is told to
 12:  * go and collect.
 13:  */
 14: 
 15: export type Item = {
 16:   group: number;
 17:   num: number;
 18:   lvl?: number;
 19:   isExcellent?: boolean;
 20:   isAncient?: boolean;
 21:   [key: string]: unknown;
 22: };
 23: 
 24: export type Listing = {
 25:   id: string;
 26:   seller: string;
 27:   /** The character a bot has to meet to collect or return this. */
 28:   sellerCharacter: string;
 29:   price: number;
 30:   item: Item;
 31:   category: string;
 32:   state: ListingState;
 33:   buyer: string | null;
 34:   buyerCharacter: string | null;
 35:   listedAt: number;
 36:   /** When the state last changed; what the dispatch deadlines count from. */
 37:   updatedAt: number;
 38:   /** The bot account holding the item, once collected; its work from then on. */
 39:   holder: string | null;
 40: };
 41: 
 42: const toListing = (row: ListingRow): Listing => ({
 43:   id: row.id,
 44:   seller: row.seller,
 45:   sellerCharacter: row.seller_char,
 46:   price: row.price,
 47:   item: JSON.parse(row.item_json) as Item,
 48:   category: row.category,
 49:   state: row.state,
 50:   buyer: row.buyer,
 51:   buyerCharacter: row.buyer_char,
 52:   listedAt: row.created_at,
 53:   updatedAt: row.updated_at,
 54:   holder: row.holder,
 55: });
 56: 
 57: /**
 58:  * Records a seller's intent to list. The row starts `pending`: nothing is on
 59:  * sale until a bot has the item in hand.
 60:  */
 61: export function createPending(input: {
 62:   seller: string;
 63:   sellerCharacter: string;
 64:   price: number;
 65:   item: Item;
 66:   category: string;
 67: }): Listing {
 68:   if (!Number.isInteger(input.price) || input.price <= 0) {
 69:     throw new Error('price must be a positive whole number of Zen');
 70:   }
 71:   if (input.price > 2_000_000_000) {
 72:     throw new Error('price is above what a character can hold');
 73:   }
 74: 
 75:   const now = Date.now();
 76:   const id = randomUUID();
 77: 
 78:   db.query(
 79:     `INSERT INTO listings
 80:        (id, seller, seller_char, price, item_group, item_number, item_level,
 81:         item_json, category, state, created_at, updated_at)
 82:      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?, ?)`
 83:   ).run(
 84:     id,
 85:     input.seller,
 86:     input.sellerCharacter,
 87:     input.price,
 88:     input.item.group,
 89:     input.item.num,
 90:     input.item.lvl ?? 0,
 91:     JSON.stringify(input.item),
 92:     input.category,
 93:     now,
 94:     now
 95:   );
 96: 
 97:   audit('listing pending', { listing: id, account: input.seller, detail: { price: input.price } });
 98:   return byId(id)!;
 99: }
100: 
101: /** The bot has the item: the listing goes on sale. */
102: export function activate(
103:   id: string,
104:   holder: string,
105:   /** Null when the server never said where it put the item; see CollectResult. */
106:   holderSlot: number | null
107: ): boolean {
108:   const changed = db
109:     .query(
110:       `UPDATE listings SET state = 'active', holder = ?, holder_slot = ?, updated_at = ?
111:        WHERE id = ? AND state = 'pending'`
112:     )
113:     .run(holder, holderSlot, Date.now(), id).changes;
114: 
115:   if (changed) audit('listing active', { listing: id, detail: { holder, holderSlot } });
116:   return changed > 0;
117: }
118: 
119: /**
120:  * Reserves a listing for one buyer.
121:  *
122:  * Conditional on the row still being `active`, so of two buyers racing, SQLite
123:  * decides and exactly one gets `true`. Everything after this - dispatching a
124:  * bot, meeting the buyer - happens only for the winner.
125:  */
126: export function claim(id: string, buyer: string, buyerCharacter: string): boolean {
127:   const changed = db
128:     .query(
129:       `UPDATE listings SET state = 'claimed', buyer = ?, buyer_char = ?, updated_at = ?
130:        WHERE id = ? AND state = 'active'`
131:     )
132:     .run(buyer, buyerCharacter, Date.now(), id).changes;
133: 
134:   audit(changed ? 'listing claimed' : 'claim refused', { listing: id, account: buyer });
135:   return changed > 0;
136: }
137: 
138: /** The buyer walked away or the handover failed: back on sale. */
139: export function release(id: string, why: string): boolean {
140:   const changed = db
141:     .query(
142:       `UPDATE listings SET state = 'active', buyer = NULL, buyer_char = NULL, updated_at = ?
143:        WHERE id = ? AND state = 'claimed'`
144:     )
145:     .run(Date.now(), id).changes;
146: 
147:   if (changed) audit('claim released', { listing: id, detail: { why } });
148:   return changed > 0;
149: }
150: 
151: /**
152:  * The buyer has the item and the money is in. The price becomes the seller's
153:  * to collect - it is not delivered, because they are usually not online.
154:  */
155: export function settleSale(id: string): boolean {
156:   const row = byRow(id);
157:   if (!row || row.state !== 'claimed') return false;
158: 
159:   db.transaction(() => {
160:     db.query(`UPDATE listings SET state = 'sold', updated_at = ? WHERE id = ?`).run(
161:       Date.now(),
162:       id
163:     );
164:     credit(row.seller, row.price);
165:   })();
166: 
167:   audit('listing sold', {
168:     listing: id,
169:     account: row.seller,
170:     detail: { buyer: row.buyer, price: row.price },
171:   });
172:   return true;
173: }
174: 
175: /**
176:  * A `pending` listing that will not be collected: the seller refused or
177:  * cancelled the trade, walked away from it, or never turned up. Nothing left
178:  * their bag, so there is nothing to give back; the row just stops being work,
179:  * and the bot does not come asking again.
180:  */
181: export function drop(id: string, why: string): boolean {
182:   const changed = db
183:     .query(
184:       `UPDATE listings SET state = 'cancelled', updated_at = ?
185:        WHERE id = ? AND state = 'pending'`
186:     )
187:     .run(Date.now(), id).changes;
188: 
189:   if (changed) audit('listing dropped', { listing: id, detail: { why } });
190:   return changed > 0;
191: }
192: 
193: /**
194:  * A seller who asked for their item back and then refused the trade that
195:  * returns it. The item stays the bot's and goes back on sale at the same
196:  * price; they can cancel again when they want it.
197:  */
198: export function backOnSale(id: string, why: string): boolean {
199:   const changed = db
200:     .query(
201:       `UPDATE listings SET state = 'active', updated_at = ?
202:        WHERE id = ? AND state = 'returning'`
203:     )
204:     .run(Date.now(), id).changes;
205: 
206:   if (changed) audit('return refused', { listing: id, detail: { why } });
207:   return changed > 0;
208: }
209: 
210: /**
211:  * The bot cannot find the item the service says it holds. Off sale, and
212:  * left for a person rather than offered to the next buyer to fail on.
213:  */
214: export function markStuck(id: string, why: string): boolean {
215:   const changed = db
216:     .query(
217:       `UPDATE listings SET state = 'stuck', buyer = NULL, buyer_char = NULL, updated_at = ?
218:        WHERE id = ? AND state IN ('active', 'claimed', 'returning')`
219:     )
220:     .run(Date.now(), id).changes;
221: 
222:   if (changed) audit('listing stuck', { listing: id, detail: { why } });
223:   return changed > 0;
224: }
225: 
226: /** The bot found the held item somewhere else in its bag: write that down. */
227: export function adoptSlot(id: string, slot: number): void {
228:   db.query('UPDATE listings SET holder_slot = ?, updated_at = ? WHERE id = ?').run(
229:     slot,
230:     Date.now(),
231:     id
232:   );
233:   audit('slot adopted', { listing: id, detail: { slot } });
234: }
235: 
236: /** Which bot holds this listing's item, and where. Null holder: never collected. */
237: export function holderOf(id: string): { holder: string | null; slot: number | null } {
238:   const row = db
239:     .query('SELECT holder, holder_slot AS slot FROM listings WHERE id = ?')
240:     .get(id) as { holder: string | null; slot: number | null } | undefined;
241:   return { holder: row?.holder ?? null, slot: row?.slot ?? null };
242: }
243: 
244: /**
245:  * Every bag slot this bot account is recorded as holding an item in, so a
246:  * bag search for one listing's item never lands on another listing's.
247:  */
248: export function heldSlots(holder: string): Set<number> {
249:   const rows = db
250:     .query(
251:       `SELECT holder_slot AS slot FROM listings
252:        WHERE holder = ? AND holder_slot IS NOT NULL
253:          AND state IN ('active', 'claimed', 'returning', 'stuck')`
254:     )
255:     .all(holder) as { slot: number }[];
256:   return new Set(rows.map(r => r.slot));
257: }
258: 
259: /** The seller wants it back. Only possible while nobody has claimed it. */
260: export function cancel(id: string, seller: string): boolean {
261:   const changed = db
262:     .query(
263:       `UPDATE listings SET state = 'returning', updated_at = ?
264:        WHERE id = ? AND seller = ? AND state IN ('pending', 'active')`
265:     )
266:     .run(Date.now(), id, seller).changes;
267: 
268:   if (changed) audit('listing cancelled', { listing: id, account: seller });
269:   return changed > 0;
270: }
271: 
272: export function byId(id: string): Listing | null {
273:   const row = byRow(id);
274:   return row ? toListing(row) : null;
275: }
276: 
277: function byRow(id: string): ListingRow | null {
278:   return (db.query('SELECT * FROM listings WHERE id = ?').get(id) as ListingRow) ?? null;
279: }
280: 
281: export type BrowseQuery = {
282:   category?: string;
283:   search?: string;
284:   limit?: number;
285:   offset?: number;
286: };
287: 
288: /** What a browsing player sees: only what the service actually holds. */
289: export function browse(query: BrowseQuery = {}): { total: number; listings: Listing[] } {
290:   const where: string[] = [`state = 'active'`];
291:   const params: (string | number)[] = [];
292: 
293:   if (query.category && query.category !== 'all') {
294:     where.push('category = ?');
295:     params.push(query.category);
296:   }
297: 
298:   const clause = where.join(' AND ');
299:   const total = (
300:     db.query(`SELECT count(*) AS n FROM listings WHERE ${clause}`).get(...params) as {
301:       n: number;
302:     }
303:   ).n;
304: 
305:   const rows = db
306:     .query(
307:       `SELECT * FROM listings WHERE ${clause} ORDER BY created_at DESC LIMIT ? OFFSET ?`
308:     )
309:     .all(...params, Math.min(query.limit ?? 50, 200), query.offset ?? 0) as ListingRow[];
310: 
311:   return { total, listings: rows.map(toListing) };
312: }
313: 
314: /** Everything a seller has in the market, whatever state it is in. */
315: export function bySeller(seller: string): Listing[] {
316:   const rows = db
317:     .query(
318:       `SELECT * FROM listings WHERE seller = ? AND state NOT IN ('sold', 'cancelled')
319:        ORDER BY created_at DESC`
320:     )
321:     .all(seller) as ListingRow[];
322:   return rows.map(toListing);
323: }
324: 
325: /** Work for the bots: handovers that are waiting to happen. */
326: export function pendingWork(): Listing[] {
327:   const rows = db
328:     .query(
329:       `SELECT * FROM listings WHERE state IN ('pending', 'claimed', 'returning')
330:        ORDER BY updated_at ASC`
331:     )
332:     .all() as ListingRow[];
333:   return rows.map(toListing);
334: }
335: 
336: export function balance(account: string): number {
337:   const row = db.query('SELECT zen FROM balances WHERE account = ?').get(account) as
338:     | { zen: number }
339:     | undefined;
340:   return row?.zen ?? 0;
341: }
342: 
343: export function credit(account: string, zen: number): void {
344:   db.query(
345:     `INSERT INTO balances (account, zen) VALUES (?, ?)
346:      ON CONFLICT(account) DO UPDATE SET zen = zen + excluded.zen`
347:   ).run(account, zen);
348:   audit('balance credited', { account, detail: { zen } });
349: }
350: 
351: /**
352:  * Takes the whole balance for paying out. Returns what was taken, so the
353:  * caller pays exactly that - and if the handover then fails, it is credited
354:  * back rather than quietly lost.
355:  */
356: export function takeBalance(account: string): number {
357:   const owed = balance(account);
358:   if (owed <= 0) return 0;
359:   db.query('UPDATE balances SET zen = 0 WHERE account = ?').run(account);
360:   audit('balance taken for payout', { account, detail: { zen: owed } });
361:   return owed;
362: }
363: 
364: // ---- payouts ---------------------------------------------------------------
365: 
366: export type PayoutRequest = { account: string; character: string; requestedAt: number };
367: 
368: /**
369:  * A seller asked for what they are owed. One open request per account; the
370:  * character is who the bot has to meet, and asking again just moves it to
371:  * whichever character they are on now.
372:  */
373: export function requestPayout(account: string, character: string): void {
374:   db.query(
375:     `INSERT INTO payout_requests (account, character, requested_at) VALUES (?, ?, ?)
376:      ON CONFLICT(account) DO UPDATE SET character = excluded.character,
377:                                        requested_at = excluded.requested_at`
378:   ).run(account, character, Date.now());
379:   audit('payout requested', { account, detail: { character } });
380: }
381: 
382: /** Every open request whose account is still owed something, oldest first. */
383: export function payoutRequests(): PayoutRequest[] {
384:   const rows = db
385:     .query(
386:       `SELECT p.account, p.character, p.requested_at AS requestedAt
387:        FROM payout_requests p JOIN balances b ON b.account = p.account
388:        WHERE b.zen > 0 ORDER BY p.requested_at ASC`
389:     )
390:     .all() as PayoutRequest[];
391:   return rows;
392: }
393: 
394: /** Paid, or given up on: the request is done either way. */
395: export function clearPayoutRequest(account: string): void {
396:   db.query('DELETE FROM payout_requests WHERE account = ?').run(account);
397: }
398: 
399: // ---- leases ----------------------------------------------------------------
400: 
401: /**
402:  * Takes every key for `worker`, for `ttlMs`, or none of them.
403:  *
404:  * Several bots read the same rows, and a handover is not a thing two of them
405:  * can do at once. Keys are `listing:<id>`, `payout:<account>` and
406:  * `customer:<character>` - the customer too, because two bots at one player
407:  * would have the second trade request refused by the server, and a refusal
408:  * reads as the player saying no. A lease lapses on its own after `ttlMs`,
409:  * for a bot that died holding it; the row's own state is still what the next
410:  * bot works from. A worker may retake its own lease.
411:  */
412: export function acquireLeases(keys: string[], worker: string, ttlMs: number): boolean {
413:   const now = Date.now();
414:   const until = now + ttlMs;
415:   try {
416:     db.transaction(() => {
417:       for (const key of keys) {
418:         const changed = db
419:           .query(
420:             `INSERT INTO leases (key, worker, until) VALUES (?, ?, ?)
421:              ON CONFLICT(key) DO UPDATE SET worker = excluded.worker, until = excluded.until
422:              WHERE leases.until < ? OR leases.worker = excluded.worker`
423:           )
424:           .run(key, worker, until, now).changes;
425:         if (!changed) throw new Error('taken');
426:       }
427:     })();
428:     return true;
429:   } catch {
430:     return false;
431:   }
432: }
433: 
434: /** Gives the keys back; only the worker holding them can. */
435: export function releaseLeases(keys: string[], worker: string): void {
436:   for (const key of keys) {
437:     db.query('DELETE FROM leases WHERE key = ? AND worker = ?').run(key, worker);
438:   }
439: }
440: 
441: /** Who holds a key right now, or null when nobody does or it has lapsed. */
442: export function leaseHolder(key: string): string | null {
443:   const row = db.query('SELECT worker, until FROM leases WHERE key = ?').get(key) as
444:     | { worker: string; until: number }
445:     | undefined;
446:   return row && row.until >= Date.now() ? row.worker : null;
447: }
448: 
449: // ---- history ---------------------------------------------------------------
450: 
451: export type HistoryStatus = 'success' | 'failed' | 'pending';
452: 
453: export type HistoryEntry = {
454:   id: string;
455:   /** What the player was in it: seller, buyer, or the one collecting Zen. */
456:   kind: 'sale' | 'purchase' | 'payout';
457:   item: Item | null;
458:   /** The price of a listing, or the Zen of a payout. */
459:   zen: number;
460:   /** The bot that carried it, once one did. */
461:   bot: string | null;
462:   status: HistoryStatus;
463:   /** The service's own words for how it ended, or where it is. */
464:   note: string;
465:   at: number;
466: };
467: 
468: const HISTORY_LIMIT = 100;
469: 
470: /** The last thing the audit says about a listing, for the note. */
471: function lastWord(listing: string): string | null {
472:   const row = db
473:     .query(
474:       `SELECT event, detail FROM audit WHERE listing = ?
475:          AND event IN ('listing dropped', 'listing cancelled', 'claim released', 'listing stuck',
476:                        'listing sold', 'return refused', 'listing active')
477:        ORDER BY id DESC LIMIT 1`
478:     )
479:     .get(listing) as { event: string; detail: string | null } | undefined;
480:   if (!row) return null;
481:   try {
482:     const detail = row.detail ? (JSON.parse(row.detail) as { why?: unknown }) : {};
483:     if (typeof detail.why === 'string') return detail.why;
484:   } catch {
485:     // The event name is enough.
486:   }
487:   return row.event;
488: }
489: 
490: function statusOf(state: ListingState): HistoryStatus {
491:   if (state === 'sold') return 'success';
492:   if (state === 'cancelled' || state === 'stuck') return 'failed';
493:   return 'pending';
494: }
495: 
496: /**
497:  * Everything this account has been part of, newest first: what they sold or
498:  * tried to sell, what they bought, and what they were paid. Every row names
499:  * the bot that carried it, so "the trader never came" has a name to look
500:  * for in the worker's log.
501:  */
502: export function historyFor(account: string): HistoryEntry[] {
503:   const listings = db
504:     .query(
505:       `SELECT * FROM listings WHERE seller = ? OR buyer = ?
506:        ORDER BY updated_at DESC LIMIT ?`
507:     )
508:     .all(account, account, HISTORY_LIMIT) as ListingRow[];
509: 
510:   const entries: HistoryEntry[] = listings.map(row => {
511:     const purchase = row.buyer === account && row.seller !== account;
512:     const state = row.state;
513:     let note = lastWord(row.id) ?? state;
514:     if (state === 'sold') note = purchase ? 'bought' : `sold to ${row.buyer_char ?? row.buyer ?? 'somebody'}`;
515:     if (state === 'cancelled' && note === 'listing cancelled') note = 'returned to you';
516:     return {
517:       id: row.id,
518:       kind: purchase ? 'purchase' : 'sale',
519:       item: JSON.parse(row.item_json) as Item,
520:       zen: row.price,
521:       bot: row.holder,
522:       status: statusOf(state),
523:       note,
524:       at: row.updated_at,
525:     };
526:   });
527: 
528:   const payouts = db
529:     .query(
530:       `SELECT id, at, event, detail FROM audit WHERE account = ?
531:          AND event IN ('payout paid', 'payout failed')
532:        ORDER BY id DESC LIMIT ?`
533:     )
534:     .all(account, HISTORY_LIMIT) as { id: number; at: number; event: string; detail: string | null }[];
535:   for (const row of payouts) {
536:     let zen = 0;
537:     let note = row.event === 'payout paid' ? 'paid out' : 'could not be paid';
538:     try {
539:       const detail = row.detail ? (JSON.parse(row.detail) as { zen?: unknown }) : {};
540:       if (typeof detail.zen === 'number') zen = detail.zen;
541:       else if (typeof row.detail === 'string' && row.event === 'payout failed') note = row.detail.replace(/^"|"$/g, '');
542:     } catch {
543:       // The event name is enough.
544:     }
545:     entries.push({
546:       id: `payout-${row.id}`,
547:       kind: 'payout',
548:       item: null,
549:       zen,
550:       bot: null,
551:       status: row.event === 'payout paid' ? 'success' : 'failed',
552:       note,
553:       at: row.at,
554:     });
555:   }
556: 
557:   const open = db.query('SELECT character, requested_at FROM payout_requests WHERE account = ?').get(account) as
558:     | { character: string; requested_at: number }
559:     | undefined;
560:   if (open) {
561:     entries.push({
562:       id: 'payout-open',
563:       kind: 'payout',
564:       item: null,
565:       zen: balance(account),
566:       bot: null,
567:       status: 'pending',
568:       note: `a trader is coming to ${open.character}`,
569:       at: open.requested_at,
570:     });
571:   }
572: 
573:   return entries.sort((a, b) => b.at - a.at).slice(0, HISTORY_LIMIT);
574: }
</file>

<file path="marketplace/server/main.ts">
  1: import { BurstLimit, bucketFor, clientIp } from '../../src/common/rateLimit';
  2: import { confirmLive, exchangeSession, verifyTicket } from './identity';
  3: import * as store from './listings';
  4: 
  5: /**
  6:  * The marketplace's HTTP face.
  7:  *
  8:  * Two rules run through every route here, and both exist because the caller is
  9:  * a browser nobody controls:
 10:  *
 11:  * 1. **The account never comes from the request.** It comes from the ticket,
 12:  *    which this service minted for whoever the proxy said was logged in. A
 13:  *    body saying `seller: "someone-else"` is ignored, not honoured.
 14:  * 2. **Anything that commits also proves the socket is still live.** A ticket
 15:  *    is a bearer token with a ten minute life; it is enough to look at your
 16:  *    own listings with, and deliberately not enough to list, buy, cancel or
 17:  *    collect with.
 18:  */
 19: 
 20: const PORT = Number(process.env.MARKETPLACE_API_PORT ?? 3300);
 21: const HOSTNAME = process.env.MARKETPLACE_API_HOST ?? '127.0.0.1';
 22: 
 23: const ALLOWED_ORIGINS = new Set(
 24:   (process.env.MARKETPLACE_CORS_ORIGIN ?? 'https://play.ignies.net')
 25:     .split(',')
 26:     .map(o => o.trim())
 27:     .filter(Boolean)
 28: );
 29: 
 30: const TOO_MANY = 'Too many requests. Wait a moment and try again.';
 31: 
 32: /** Exchanges are cheap for us and expensive upstream, so they are limited hardest. */
 33: const sessionExchanges = new BurstLimit(10, 60_000);
 34: /** Anything that commits: listing, buying, cancelling, collecting. */
 35: const commits = new BurstLimit(30, 60_000);
 36: /** Reads. Generous, because browsing pages through the catalogue. */
 37: const reads = new BurstLimit(240, 60_000);
 38: 
 39: function corsHeaders(req: Request): Record<string, string> {
 40:   const origin = req.headers.get('origin');
 41:   if (!origin || !ALLOWED_ORIGINS.has(origin)) return {};
 42:   return {
 43:     'Access-Control-Allow-Origin': origin,
 44:     'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
 45:     'Access-Control-Allow-Headers': 'Content-Type',
 46:     'Access-Control-Max-Age': '600',
 47:   };
 48: }
 49: 
 50: function json(body: unknown, status = 200, cors: Record<string, string> = {}): Response {
 51:   return new Response(JSON.stringify(body), {
 52:     status,
 53:     headers: { 'Content-Type': 'application/json', ...cors },
 54:   });
 55: }
 56: 
 57: async function readBody(req: Request): Promise<Record<string, unknown>> {
 58:   try {
 59:     const body = await req.json();
 60:     return body && typeof body === 'object' ? (body as Record<string, unknown>) : {};
 61:   } catch {
 62:     return {};
 63:   }
 64: }
 65: 
 66: /** The account this request may act as, or a response saying why not. */
 67: function authenticate(
 68:   body: Record<string, unknown>,
 69:   url: URL,
 70:   cors: Record<string, string>
 71: ): { account: string } | { error: Response } {
 72:   const verified = verifyTicket(body.ticket ?? url.searchParams.get('ticket'));
 73:   if (!verified.ok) {
 74:     return { error: json({ error: 'Your session expired.', retry: true }, 401, cors) };
 75:   }
 76:   return { account: verified.account };
 77: }
 78: 
 79: /**
 80:  * The extra proof required to commit: the socket behind the nonce must still
 81:  * be logged in as the ticket's account, right now.
 82:  */
 83: async function authorizeCommit(
 84:   body: Record<string, unknown>,
 85:   account: string,
 86:   cors: Record<string, string>
 87: ): Promise<Response | null> {
 88:   const live = await confirmLive(body.session, account);
 89:   return live.ok ? null : json({ error: live.message, retry: live.reason === 'unknown' }, 403, cors);
 90: }
 91: 
 92: Bun.serve({
 93:   port: PORT,
 94:   hostname: HOSTNAME,
 95:   async fetch(req, server) {
 96:     const url = new URL(req.url);
 97:     const path = url.pathname;
 98:     const cors = corsHeaders(req);
 99:     const ip = bucketFor(clientIp(req, server));
100: 
101:     if (req.method === 'OPTIONS') {
102:       const allowed = cors['Access-Control-Allow-Origin'] !== undefined;
103:       return new Response(null, { status: allowed ? 204 : 403, headers: cors });
104:     }
105: 
106:     try {
107:       // ---- identity ------------------------------------------------------
108: 
109:       if (path === '/api/market/session' && req.method === 'POST') {
110:         if (sessionExchanges.hammering(ip)) return json({ error: TOO_MANY }, 429, cors);
111: 
112:         const body = await readBody(req);
113:         const exchange = await exchangeSession(body.session);
114:         if (!exchange.ok) {
115:           return json({ error: exchange.message, retry: exchange.reason === 'unknown' }, 401, cors);
116:         }
117:         return json(
118:           { ticket: exchange.ticket.ticket, account: exchange.ticket.account },
119:           200,
120:           cors
121:         );
122:       }
123: 
124:       // ---- reads ---------------------------------------------------------
125: 
126:       if (path === '/api/market/listings' && req.method === 'GET') {
127:         if (reads.hammering(ip)) return json({ error: TOO_MANY }, 429, cors);
128: 
129:         const auth = authenticate({}, url, cors);
130:         if ('error' in auth) return auth.error;
131: 
132:         const page = store.browse({
133:           category: url.searchParams.get('category') ?? undefined,
134:           limit: Number(url.searchParams.get('limit') ?? 50),
135:           offset: Number(url.searchParams.get('offset') ?? 0),
136:         });
137:         return json(page, 200, cors);
138:       }
139: 
140:       if (path === '/api/market/history' && req.method === 'GET') {
141:         if (reads.hammering(ip)) return json({ error: TOO_MANY }, 429, cors);
142: 
143:         const auth = authenticate({}, url, cors);
144:         if ('error' in auth) return auth.error;
145: 
146:         return json({ history: store.historyFor(auth.account) }, 200, cors);
147:       }
148: 
149:       if (path === '/api/market/mine' && req.method === 'GET') {
150:         if (reads.hammering(ip)) return json({ error: TOO_MANY }, 429, cors);
151: 
152:         const auth = authenticate({}, url, cors);
153:         if ('error' in auth) return auth.error;
154: 
155:         return json(
156:           { listings: store.bySeller(auth.account), balance: store.balance(auth.account) },
157:           200,
158:           cors
159:         );
160:       }
161: 
162:       // ---- commits -------------------------------------------------------
163: 
164:       if (path === '/api/market/listings' && req.method === 'POST') {
165:         if (commits.hammering(ip)) return json({ error: TOO_MANY }, 429, cors);
166: 
167:         const body = await readBody(req);
168:         const auth = authenticate(body, url, cors);
169:         if ('error' in auth) return auth.error;
170:         const refused = await authorizeCommit(body, auth.account, cors);
171:         if (refused) return refused;
172: 
173:         // The character the bot has to meet. It is the one field the browser
174:         // supplies that the ticket cannot vouch for, so it is shape-checked
175:         // here and the handover itself is the real check: a wrong name simply
176:         // never completes, because that player has to accept the trade and put
177:         // the item up themselves.
178:         const character = body.character;
179:         if (typeof character !== 'string' || !/^[A-Za-z0-9]{1,10}$/.test(character)) {
180:           return json({ error: 'Log in to a character first.' }, 400, cors);
181:         }
182: 
183:         const item = body.item as store.Item | undefined;
184:         const price = Number(body.price);
185:         const category = typeof body.category === 'string' ? body.category : 'misc';
186: 
187:         if (!item || typeof item.group !== 'number' || typeof item.num !== 'number') {
188:           return json({ error: 'That item is not one the marketplace can read.' }, 400, cors);
189:         }
190: 
191:         try {
192:           // The seller is the ticket's account, never the body's.
193:           const listing = store.createPending({
194:             seller: auth.account,
195:             sellerCharacter: character,
196:             price,
197:             item,
198:             category,
199:           });
200:           return json({ listing }, 201, cors);
201:         } catch (e) {
202:           return json({ error: e instanceof Error ? e.message : 'That listing was refused.' }, 400, cors);
203:         }
204:       }
205: 
206:       const claimMatch = path.match(/^\/api\/market\/listings\/([\w-]+)\/(claim|cancel)$/);
207:       if (claimMatch && req.method === 'POST') {
208:         if (commits.hammering(ip)) return json({ error: TOO_MANY }, 429, cors);
209: 
210:         const [, id, action] = claimMatch;
211:         const body = await readBody(req);
212:         const auth = authenticate(body, url, cors);
213:         if ('error' in auth) return auth.error;
214:         const refused = await authorizeCommit(body, auth.account, cors);
215:         if (refused) return refused;
216: 
217:         const character = body.character;
218:         if (action === 'claim' && (typeof character !== 'string' || !/^[A-Za-z0-9]{1,10}$/.test(character))) {
219:           return json({ error: 'Log in to a character first.' }, 400, cors);
220:         }
221: 
222:         if (action === 'claim') {
223:           const listing = store.byId(id);
224:           if (!listing) return json({ error: 'That listing is gone.' }, 404, cors);
225:           if (listing.seller === auth.account) {
226:             return json({ error: 'That is your own listing.' }, 400, cors);
227:           }
228:           if (!store.claim(id, auth.account, character as string)) {
229:             return json({ error: 'Somebody else got there first.' }, 409, cors);
230:           }
231:           return json({ listing: store.byId(id) }, 200, cors);
232:         }
233: 
234:         // cancel: the store checks it is this seller's, so a forged id fails.
235:         if (!store.cancel(id, auth.account)) {
236:           return json({ error: 'That listing cannot be cancelled now.' }, 409, cors);
237:         }
238:         return json({ listing: store.byId(id) }, 200, cors);
239:       }
240: 
241:       if (path === '/api/market/payout' && req.method === 'POST') {
242:         if (commits.hammering(ip)) return json({ error: TOO_MANY }, 429, cors);
243: 
244:         const body = await readBody(req);
245:         const auth = authenticate(body, url, cors);
246:         if ('error' in auth) return auth.error;
247:         const refused = await authorizeCommit(body, auth.account, cors);
248:         if (refused) return refused;
249: 
250:         const owed = store.balance(auth.account);
251:         if (owed <= 0) return json({ error: 'You have nothing to collect.' }, 400, cors);
252: 
253:         // The character the bot has to meet, checked the same way a listing's
254:         // is. Recorded as a request rather than taken: the money only leaves
255:         // the balance when a bot is actually about to hand it over, so a
256:         // request that never reaches a handover cannot lose it.
257:         const character = body.character;
258:         if (typeof character !== 'string' || !/^[A-Za-z0-9]{1,10}$/.test(character)) {
259:           return json({ error: 'Log in to a character first.' }, 400, cors);
260:         }
261:         store.requestPayout(auth.account, character);
262:         // `requested` is how the window tells this service from an older one
263:         // that answered the same route without sending anybody.
264:         return json({ owed, requested: true }, 200, cors);
265:       }
266: 
267:       return json({ error: 'No such route.' }, 404, cors);
268:     } catch (error) {
269:       console.error('marketplace: unhandled error', error);
270:       return json({ error: 'Something went wrong.' }, 500, cors);
271:     }
272:   },
273: });
274: 
275: console.log(`marketplace: serving on http://${HOSTNAME}:${PORT}`);
