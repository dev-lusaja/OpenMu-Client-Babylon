  1: import items from '../../src/common/items.json';
  2: import { hasItemIconFile } from '../../src/common/itemIconPack';
  3: 
  4: /**
  5:  * The gacha roll: a random armour piece, +0 to +12, usually plain and now and
  6:  * then excellent.
  7:  *
  8:  * The tier is the thing rolled. It is drawn first from a weight table, and it
  9:  * decides everything else about the piece: the level range, whether it is
 10:  * excellent at all, and how many options it carries. The old shape - draw a
 11:  * level, derive a label from it, stamp every piece excellent - is inverted
 12:  * because the tier is what the reveal shows, what the player remembers and
 13:  * what an operator tunes; the level is a consequence of it.
 14:  *
 15:  * Rolled from a seed and nothing else, so a roll can be replayed exactly from
 16:  * what the order stored. That matters twice: a player disputing a result can be
 17:  * shown the same roll reproduced, and the reveal the page plays is the server's
 18:  * answer rather than something the page made up. The roll is drawn and
 19:  * committed when the order is placed, so from the first real order on the
 20:  * tables and the draw order below are part of the replay contract.
 21:  *
 22:  * The same function serves fulfilment's audit trail and, in development, the
 23:  * preview. A preview spends nothing and writes nothing.
 24:  */
 25: 
 26: interface ItemRow {
 27:   Group: number;
 28:   Index: number;
 29:   ItemName: string;
 30:   X: number;
 31:   Y: number;
 32: }
 33: 
 34: /** Helm, armour, pants, gloves, boots. */
 35: const ARMOUR_GROUPS = [7, 8, 9, 10, 11];
 36: 
 37: const GROUP_LABEL: Record<number, string> = {
 38:   7: 'Helm',
 39:   8: 'Armour',
 40:   9: 'Pants',
 41:   10: 'Gloves',
 42:   11: 'Boots',
 43: };
 44: 
 45: export interface PoolEntry {
 46:   group: number;
 47:   num: number;
 48:   name: string;
 49:   slot: string;
 50:   width: number;
 51:   height: number;
 52: }
 53: 
 54: /**
 55:  * Every armour piece the icon pack can draw both plain and excellent, at every
 56:  * tint. Both filters stay because a roll can land either way: a plain roll
 57:  * needs the plain icon, an excellent roll the excellent one.
 58:  *
 59:  * Filtered rather than listed: the pack is uneven, and a rolled item with no
 60:  * icon would be a blank square at the one moment the page is trying to be
 61:  * exciting. The game's own configuration is the other list an item has to be
 62:  * on, and placement checks each roll against it before committing the seed
 63:  * (`Orders.grantableRoll`), rolling again on a miss - so a paid roll is never
 64:  * one the game cannot hand over.
 65:  */
 66: export const GACHA_POOL: PoolEntry[] = (items as unknown as ItemRow[])
 67:   .filter(row => ARMOUR_GROUPS.includes(row.Group))
 68:   .filter(row => typeof row.ItemName === 'string' && row.ItemName.length > 0)
 69:   .filter(row => hasItemIconFile(row.Group, row.Index, 15, '_e'))
 70:   .filter(row => hasItemIconFile(row.Group, row.Index, 0, ''))
 71:   .map(row => ({
 72:     group: row.Group,
 73:     num: row.Index,
 74:     name: row.ItemName,
 75:     slot: GROUP_LABEL[row.Group] ?? 'Armour',
 76:     width: row.X,
 77:     height: row.Y,
 78:   }));
 79: 
 80: /**
 81:  * The six excellent options a defensive item can carry in Season 6. Which of
 82:  * them a given definition actually offers comes from its own
 83:  * `PossibleItemOptions` at fulfilment; these are the labels the reveal shows.
 84:  */
 85: export const EXCELLENT_OPTIONS = [
 86:   'Increase Zen after hunt +40%',
 87:   'Defense success rate +10%',
 88:   'Reflect damage +5%',
 89:   'Damage decrease +4%',
 90:   'Increase maximum mana +4%',
 91:   'Increase maximum life +4%',
 92: ];
 93: 
 94: export type Tier = 'common' | 'rare' | 'epic' | 'legendary';
 95: 
 96: export interface TierSpec {
 97:   tier: Tier;
 98:   /** Per 1000 pulls. */
 99:   weight: number;
100:   /** Inclusive; drawn uniformly. */
101:   levels: [min: number, max: number];
102:   excellent: boolean;
103:   /** Inclusive; drawn uniformly. [0, 0] for a plain piece. */
104:   options: [min: number, max: number];
105: }
106: 
107: /**
108:  * The economic lever of the whole shop, per 1000 pulls. Common is the usual
109:  * and plain outcome; rare is a good plain piece (a +9 costs about six Bless
110:  * and six Soul by hand); epic and legendary are the only excellent ones, and
111:  * legendary sits at the levels the Chaos Machine charges for - +10 and above
112:  * normally costs attempts that reset the item on failure, and an excellent
113:  * one cannot be made at all, only dropped. Excellent overall is 6.5%, one in
114:  * about fifteen pulls; legendary is one in two hundred.
115:  *
116:  * Levels and option counts are uniform inside a tier, so the weights carry
117:  * all the shaping and these four lines are the whole table. Tune here and
118:  * nowhere else - and only with the replay contract in mind, because every
119:  * committed seed replays through whatever is written here.
120:  */
121: export const TIERS: TierSpec[] = [
122:   { tier: 'common', weight: 700, levels: [0, 4], excellent: false, options: [0, 0] },
123:   { tier: 'rare', weight: 235, levels: [5, 9], excellent: false, options: [0, 0] },
124:   { tier: 'epic', weight: 60, levels: [3, 9], excellent: true, options: [1, 2] },
125:   { tier: 'legendary', weight: 5, levels: [10, 12], excellent: true, options: [2, 3] },
126: ];
127: 
128: const TIER_TABLE: [TierSpec, number][] = TIERS.map(spec => [spec, spec.weight]);
129: 
130: /**
131:  * mulberry32: small, fast, and good enough that a player cannot predict the
132:  * next roll from the last. The seed is what gets stored, so the whole sequence
133:  * is reproducible from it.
134:  */
135: function rng(seed: number): () => number {
136:   let state = seed >>> 0;
137: 
138:   return () => {
139:     state = (state + 0x6d2b79f5) >>> 0;
140:     let t = state;
141:     t = Math.imul(t ^ (t >>> 15), t | 1);
142:     t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
143:     return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
144:   };
145: }
146: 
147: function weighted<T>(next: () => number, table: [T, number][]): T {
148:   const total = table.reduce((sum, [, weight]) => sum + weight, 0);
149:   let roll = next() * total;
150: 
151:   for (const [value, weight] of table) {
152:     roll -= weight;
153:     if (roll < 0) return value;
154:   }
155: 
156:   return table[table.length - 1][0];
157: }
158: 
159: function uniformInt(next: () => number, [min, max]: [number, number]): number {
160:   return min + Math.floor(next() * (max - min + 1));
161: }
162: 
163: export interface Roll {
164:   seed: number;
165:   group: number;
166:   num: number;
167:   name: string;
168:   slot: string;
169:   width: number;
170:   height: number;
171:   level: number;
172:   tier: Tier;
173:   /** Decided by the tier, never by the level. */
174:   excellent: boolean;
175:   /** Empty for a plain piece. */
176:   options: string[];
177: }
178: 
179: export function newSeed(): number {
180:   const bytes = new Uint32Array(1);
181:   crypto.getRandomValues(bytes);
182:   return bytes[0];
183: }
184: 
185: /**
186:  * The roll. Same seed in, same item out, for as long as the tables hold.
187:  *
188:  * The draw order is the replay contract, and every draw consumes exactly one
189:  * number from the generator whether or not its result is used:
190:  *
191:  *   1. the pool entry, uniform over GACHA_POOL in items.json order;
192:  *   2. the tier, weighted by TIERS;
193:  *   3. the level, uniform over the tier's range;
194:  *   4. the option count, uniform over the tier's range - a plain tier's range
195:  *      is [0, 0], and the draw still happens, so every roll has consumed the
196:  *      same four numbers by this point;
197:  *   5. the options, without replacement from EXCELLENT_OPTIONS, one draw each.
198:  *
199:  * Reordering these, or growing the pool anywhere but at its end, changes what
200:  * a stored seed replays to.
201:  */
202: export function roll(seed: number): Roll {
203:   if (GACHA_POOL.length === 0) {
204:     throw new Error('gacha: no armour in the pool has both plain and excellent icons');
205:   }
206: 
207:   const next = rng(seed);
208:   const entry = GACHA_POOL[Math.floor(next() * GACHA_POOL.length)];
209:   const spec = weighted(next, TIER_TABLE);
210:   const level = uniformInt(next, spec.levels);
211:   const count = uniformInt(next, spec.options);
212: 
213:   // Draw without replacement: an item cannot carry the same option twice.
214:   const remaining = [...EXCELLENT_OPTIONS];
215:   const options: string[] = [];
216: 
217:   for (let i = 0; i < count && remaining.length > 0; i++) {
218:     options.push(remaining.splice(Math.floor(next() * remaining.length), 1)[0]);
219:   }
220: 
221:   return {
222:     seed,
223:     group: entry.group,
224:     num: entry.num,
225:     name: entry.name,
226:     slot: entry.slot,
227:     width: entry.width,
228:     height: entry.height,
229:     level,
230:     tier: spec.tier,
231:     excellent: spec.excellent,
232:     options: options.sort(),
233:   };
234: }
235: 
236: /**
237:  * One line for the audit log, with everything a person needs to recognise
238:  * the piece and everything a replay needs to check it:
239:  *
240:  *   seed 2864434397 legendary: Excellent Dragon Armor +11 (8/1, 2x3) [Damage decrease +4%, Reflect damage +5%]
241:  */
242: export function describeRoll(roll: Roll): string {
243:   const name = `${roll.excellent ? 'Excellent ' : ''}${roll.name} +${roll.level}`;
244:   const shape = `${roll.group}/${roll.num}, ${roll.width}x${roll.height}`;
245:   const options = roll.options.length > 0 ? ` [${roll.options.join(', ')}]` : '';
246: 
247:   return `seed ${roll.seed} ${roll.tier}: ${name} (${shape})${options}`;
248: }
</file>

