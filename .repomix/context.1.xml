 61:   { host: PRESENCE_HOST, port: PRESENCE_PORT },
 62: ];
 63: 
 64: /**
 65:  * The tracker (documentation/admin_console/ARCHITECTURE.md): every session's
 66:  * live state and journal, streamed to a game master's panel on
 67:  * `/admin/stream`. `TRACK=off` removes it whole - no decoding, no journal,
 68:  * and the stream refuses everyone. `TRACK_DB_PATH=memory` keeps the journal
 69:  * in memory for the life of the process.
 70:  */
 71: const TRACK_ENABLED = (process.env.TRACK ?? "on") !== "off";
 72: const TRACK_DB_PATH = process.env.TRACK_DB_PATH || DEFAULT_TRACK_DB;
 73: const TRACK_RETAIN_DAYS = Number(process.env.TRACK_RETAIN_DAYS ?? 30);
 74: const TRACK_WHISPERS = (process.env.TRACK_WHISPERS ?? "on") !== "off";
