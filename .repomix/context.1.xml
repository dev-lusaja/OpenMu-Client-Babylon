194:     expect(store.acquireLeases(['listing:a', 'customer:bob'], 'MKT001', 60_000)).toBe(true);
195:     expect(store.acquireLeases(['listing:b', 'customer:bob'], 'MKT002', 60_000)).toBe(false);
196:     // Refused as a whole: the key that was free was not kept either.
