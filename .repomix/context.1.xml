  1: import {
  2:   CharacterInformationPacket,
  3:   CharacterLevelUpdatePacket,
  4:   ExperienceGainedPacket,
  5:   GameServerEnteredPacket,
  6:   InventoryMoneyUpdatePacket,
  7:   ItemAddedToInventoryPacket,
  8:   MapChangedPacket,
  9:   ObjectGotKilledPacket,
 10:   RespawnAfterDeathPacket,
 11:   ServerMessagePacket,
 12: } from '../../src/common/packets/ServerToClientPackets';
 13: import {
 14:   HitRequestPacket,
 15:   PickupItemRequestPacket,
 16:   PublicChatMessagePacket,
 17:   SelectCharacterPacket,
 18:   WalkRequestPacket,
 19:   WhisperMessagePacket,
 20: } from '../../src/common/packets/ClientToServerPackets';
 21: import { nameBytes, packetBytes, rawFrame } from './wire';
 22: 
 23: /**
 24:  * Plain (unencrypted) packets the way the two ends build them, for the demo
 25:  * and the tests. Anything the generated classes can write goes through
 26:  * their setters; the list-shaped ones they can only read are laid out by
 27:  * hand from the same offsets their readers use.
 28:  */
 29: 
 30: /* ----------------------------------------------------------------- server */
 31: 
 32: export function gameServerEntered(playerId: number): Uint8Array {
 33:   const p = GameServerEnteredPacket.createPacket();
 34:   p.Success = true;
 35:   p.PlayerId = playerId;
 36:   return packetBytes(p);
 37: }
 38: 
 39: export type ListedCharacter = { name: string; cls: number; level: number; status?: number };
 40: 
 41: /** `CharacterList` (F3 00): 34 bytes per character from byte 8. */
 42: export function characterList(characters: ListedCharacter[]): Uint8Array {
 43:   const body: number[] = [0xf3, 0x00, 0, 0, characters.length, 0];
 44:   characters.forEach((c, slot) => {
 45:     const entry = new Array<number>(34).fill(0);
 46:     entry[0] = slot;
 47:     entry.splice(1, 10, ...nameBytes(c.name, 10));
 48:     entry[12] = c.level & 0xff;
 49:     entry[13] = c.level >> 8;
 50:     entry[14] = (c.status ?? 0) & 0x0f;
 51:     // Appearance byte 0: the class number in the high five bits.
 52:     entry[15] = c.cls << 3;
 53:     body.push(...entry);
 54:   });
 55:   return rawFrame(0xc1, body);
 56: }
 57: 
 58: export type CharacterInfo = {
 59:   x: number;
 60:   y: number;
 61:   map: number;
 62:   money?: number;
 63:   heroState?: number;
 64:   status?: number;
 65:   hp?: number;
 66:   maxHp?: number;
 67: };
 68: 
 69: export function characterInformation(info: CharacterInfo): Uint8Array {
 70:   const p = CharacterInformationPacket.createPacket();
 71:   p.X = info.x;
 72:   p.Y = info.y;
 73:   p.MapId = info.map;
 74:   p.Money = info.money ?? 0;
 75:   p.HeroState = info.heroState ?? 3;
 76:   p.Status = info.status ?? 0;
 77:   p.CurrentHealth = info.hp ?? 100;
 78:   p.MaximumHealth = info.maxHp ?? 100;
 79:   return packetBytes(p);
 80: }
 81: 
 82: export type ScopedNpc = { id: number; type: number; x: number; y: number };
 83: 
 84: /** `AddNpcsToScope` (C2 13): 10 bytes per NPC from byte 5. */
 85: export function npcsInScope(npcs: ScopedNpc[]): Uint8Array {
 86:   const body: number[] = [0x13, npcs.length];
 87:   for (const npc of npcs) {
 88:     body.push(npc.id >> 8, npc.id & 0xff, npc.type >> 8, npc.type & 0xff, npc.x, npc.y, npc.x, npc.y, 0, 0);
 89:   }
 90:   return rawFrame(0xc2, body);
 91: }
 92: 
 93: export type ScopedPlayer = { id: number; name: string; x: number; y: number };
 94: 
 95: /** `AddCharactersToScope` (C2 12): 36 bytes per character from byte 5, no effects. */
 96: export function playersInScope(players: ScopedPlayer[]): Uint8Array {
 97:   const body: number[] = [0x12, players.length];
 98:   for (const player of players) {
 99:     const entry = new Array<number>(36).fill(0);
100:     entry[0] = player.id >> 8;
101:     entry[1] = player.id & 0xff;
102:     entry[2] = player.x;
103:     entry[3] = player.y;
104:     entry.splice(22, 10, ...nameBytes(player.name, 10));
105:     entry[32] = player.x;
106:     entry[33] = player.y;
107:     entry[34] = 3;
108:     body.push(...entry);
109:   }
110:   return rawFrame(0xc2, body);
111: }
112: 
113: export function mapChanged(map: number, x: number, y: number, isMapChange = true): Uint8Array {
114:   const p = MapChangedPacket.createPacket();
115:   p.IsMapChange = isMapChange;
116:   p.MapNumber = map;
117:   p.PositionX = x;
118:   p.PositionY = y;
119:   return packetBytes(p);
120: }
121: 
122: export function respawn(map: number, x: number, y: number, money = 0): Uint8Array {
123:   const p = RespawnAfterDeathPacket.createPacket();
124:   p.MapNumber = map;
125:   p.PositionX = x;
126:   p.PositionY = y;
127:   p.Money = money;
128:   return packetBytes(p);
129: }
130: 
131: export function objectKilled(killedId: number, killerId: number, skillId = 0): Uint8Array {
132:   const p = ObjectGotKilledPacket.createPacket();
133:   p.KilledId = killedId;
134:   p.KillerId = killerId;
135:   p.SkillId = skillId;
136:   return packetBytes(p);
137: }
138: 
139: export function experience(fromId: number, amount: number): Uint8Array {
140:   const p = ExperienceGainedPacket.createPacket();
141:   p.KilledObjectId = fromId;
142:   p.AddedExperience = amount;
143:   p.DamageOfLastHit = 0;
144:   return packetBytes(p);
145: }
146: 
147: export function levelUpdate(level: number): Uint8Array {
148:   const p = CharacterLevelUpdatePacket.createPacket();
149:   p.Level = level;
150:   return packetBytes(p);
151: }
152: 
153: export function moneyUpdate(money: number): Uint8Array {
154:   const p = InventoryMoneyUpdatePacket.createPacket();
155:   p.Money = money;
156:   return packetBytes(p);
157: }
158: 
159: /** 12 wire bytes of a plain item: group, number, level. */
160: export function itemBytes(group: number, number: number, level = 0): number[] {
161:   return [number & 0xff, (level & 0x0f) << 3, 255, number > 255 ? 0x80 : 0, 0, group << 4, 0, 0xff, 0xff, 0xff, 0xff, 0xff];
162: }
163: 
164: /** `ItemsDropped` (C2 20): 16 bytes per drop from byte 5, fresh flag in the id's high bit. */
165: export function itemsDropped(drops: { id: number; x: number; y: number; item: number[]; fresh?: boolean }[]): Uint8Array {
166:   const body: number[] = [0x20, drops.length];
167:   for (const drop of drops) {
168:     body.push(((drop.id >> 8) & 0x7f) | (drop.fresh === false ? 0 : 0x80), drop.id & 0xff, drop.x, drop.y, ...drop.item);
169:   }
170:   return rawFrame(0xc2, body);
171: }
172: 
173: export function itemAdded(slot: number, item: number[]): Uint8Array {
174:   const p = ItemAddedToInventoryPacket.createPacket(16);
175:   p.InventorySlot = slot;
176:   p.setItemData(item, 12);
177:   return packetBytes(p);
178: }
179: 
180: export function serverMessage(text: string, type = 1): Uint8Array {
181:   const p = ServerMessagePacket.createPacket(4 + text.length + 1);
182:   p.Type = type;
183:   p.setMessage(text, text.length);
184:   return packetBytes(p);
185: }
186: 
187: /* ----------------------------------------------------------------- client */
188: 
189: export function selectCharacter(name: string): Uint8Array {
190:   const p = SelectCharacterPacket.createPacket();
191:   p.setName(name, 10);
192:   return packetBytes(p);
193: }
194: 
195: /** `WalkRequest` (D4): directions two per byte, the first in the high nibble. */
196: export function walk(x: number, y: number, dirs: number[]): Uint8Array {
197:   const packed = new Array<number>(Math.ceil(dirs.length / 2)).fill(0);
198:   dirs.forEach((dir, i) => {
199:     packed[i >> 1] |= (dir & 0x0f) << (i % 2 === 0 ? 4 : 0);
200:   });
201:   const p = WalkRequestPacket.createPacket(6 + packed.length);
202:   p.SourceX = x;
203:   p.SourceY = y;
204:   p.StepCount = dirs.length;
205:   p.TargetRotation = dirs[dirs.length - 1] ?? 0;
206:   p.setDirections(packed, packed.length);
207:   return packetBytes(p);
208: }
209: 
210: export function chat(sender: string, text: string): Uint8Array {
211:   const p = PublicChatMessagePacket.createPacket(13 + text.length + 1);
212:   p.setCharacter(sender, 10);
213:   p.setMessage(text, text.length);
214:   return packetBytes(p);
215: }
216: 
217: export function whisper(to: string, text: string): Uint8Array {
218:   const p = WhisperMessagePacket.createPacket(13 + text.length + 1);
219:   p.setReceiverName(to, 10);
220:   p.setMessage(text, text.length);
221:   return packetBytes(p);
222: }
223: 
224: export function hit(targetId: number): Uint8Array {
225:   const p = HitRequestPacket.createPacket();
226:   p.TargetId = targetId;
227:   p.AttackAnimation = 120;
228:   p.LookingDirection = 0;
229:   return packetBytes(p);
230: }
231: 
232: export function pickup(itemId: number): Uint8Array {
233:   const p = PickupItemRequestPacket.createPacket();
234:   p.ItemId = itemId;
235:   return packetBytes(p);
236: }
