  2: import { BotCrypto, FrameReader, codeOf } from './wire';
  3: import {
  4:   SimpleModulusDecryptor,
  5:   SimpleModulusEncryptor,
  6: } from '../../src/common/encryption/simpleModulus';
  7: import { Xor32Decryptor } from '../../src/common/encryption/xor32';
  8: 
  9: /**
 10:  * The server's side of each direction.
 11:  *
 12:  * Encryption and decryption key lists are derived *pairs*, not the same
 13:  * numbers: `CreateDecryptionKeys(clientToServer)` does not reverse
 14:  * `CreateEncryptionKeys(clientToServer)`. The server's halves are exactly the
 15:  * two constructor defaults, which is the same reasoning `proxy/presence.ts`
 16:  * relies on to read a login frame.
 17:  */
 18: const serverSideDecryptor = () => new SimpleModulusDecryptor();
 19: const serverSideEncryptor = () => new SimpleModulusEncryptor();
 20: 
 21: const plain = () => new Uint8Array([0xc1, 0x04, 0xf3, 0x00]);
 22: const encrypted = () => new Uint8Array([0xc3, 0x05, 0xf3, 0x00, 0x07]);
 23: 
 24: describe('BotCrypto', () => {
 25:   it('encrypts an outgoing C3 the way the game server reads it', () => {
 26:     const crypto = new BotCrypto();
 27:     const wire = crypto.encrypt(encrypted());
 28: 
 29:     // The server reverses SimpleModulus first, then Xor32.
 30:     const [ok, unmodulus] = serverSideDecryptor().Decrypt(wire);
 31:     expect(ok).toBe(true);
 32:     const [, recovered] = new Xor32Decryptor().Decrypt(unmodulus);
 33: 
 34:     expect(Array.from(recovered)).toEqual(Array.from(encrypted()));
 35:   });
 36: 
 37:   it('leaves a plain C1 unencrypted but still Xor32s the body', () => {
 38:     const wire = new BotCrypto().encrypt(plain());
 39:     expect(wire[0]).toBe(0xc1);
 40:     const [, recovered] = new Xor32Decryptor().Decrypt(wire.slice());
 41:     expect(Array.from(recovered)).toEqual(Array.from(plain()));
 42:   });
 43: 
 44:   it('decrypts an incoming C3 built with the server-to-client keys', () => {
 45:     const body = new Uint8Array([0xc3, 0x06, 0xf3, 0x03, 0x01, 0x02]);
 46:     const wire = serverSideEncryptor().Encrypt(body.slice());
 47: 
 48:     const decrypted = new BotCrypto().decrypt(wire);
 49:     expect(decrypted).not.toBeNull();
 50:     expect(Array.from(decrypted!.subarray(2, 6))).toEqual([0xf3, 0x03, 0x01, 0x02]);
 51:   });
 52: 
 53:   it('returns null rather than throwing on an undecryptable frame', () => {
 54:     const junk = new Uint8Array(16).fill(0xab);
 55:     junk[0] = 0xc3;
 56:     junk[1] = 16;
 57:     expect(new BotCrypto().decrypt(junk)).toBeNull();
 58:   });
 59: 
 60:   it('passes an incoming plain frame straight through', () => {
 61:     const wire = plain();
 62:     expect(new BotCrypto().decrypt(wire)).toBe(wire);
 63:   });
 64: });
 65: 
 66: describe('FrameReader', () => {
 67:   it('reassembles a frame split across chunks', () => {
 68:     const reader = new FrameReader();
 69:     reader.push(new Uint8Array([0xc1, 0x05, 0xf1]));
 70:     expect([...reader.frames()]).toEqual([]);
 71: 
 72:     reader.push(new Uint8Array([0x01, 0x01]));
 73:     const frames = [...reader.frames()];
 74:     expect(frames).toHaveLength(1);
 75:     expect(Array.from(frames[0])).toEqual([0xc1, 0x05, 0xf1, 0x01, 0x01]);
 76:   });
 77: 
 78:   it('splits several frames delivered in one chunk', () => {
 79:     const reader = new FrameReader();
 80:     reader.push(new Uint8Array([0xc1, 0x04, 0xf3, 0x00, 0xc1, 0x04, 0xf3, 0x01]));
 81:     const frames = [...reader.frames()];
 82:     expect(frames.map(f => f[3])).toEqual([0x00, 0x01]);
 83:   });
 84: 
 85:   it('reads a C2 two-byte length', () => {
 86:     const body = new Uint8Array(300);
 87:     body[0] = 0xc2;
 88:     body[1] = 300 >> 8;
 89:     body[2] = 300 & 0xff;
 90:     body[3] = 0xf3;
 91:     const reader = new FrameReader();
 92:     reader.push(body);
 93:     expect([...reader.frames()]).toHaveLength(1);
 94:   });
 95: 
 96:   it('resyncs past a byte that is not a header instead of jamming', () => {
 97:     const reader = new FrameReader();
 98:     reader.push(new Uint8Array([0x00, 0xff, 0xc1, 0x04, 0xf3, 0x09]));
 99:     const frames = [...reader.frames()];
100:     expect(frames).toHaveLength(1);
101:     expect(frames[0][3]).toBe(0x09);
102:   });
103: 
104:   it('keeps a partial frame for the next chunk', () => {
105:     const reader = new FrameReader();
106:     reader.push(new Uint8Array([0xc1, 0x08, 0xf3]));
107:     expect([...reader.frames()]).toEqual([]);
108:     reader.push(new Uint8Array([0x00, 0x01, 0x02, 0x03, 0x04]));
109:     expect([...reader.frames()]).toHaveLength(1);
110:   });
111: });
112: 
113: describe('codeOf', () => {
114:   it('reads code and sub-code from a C1 frame', () => {
115:     expect(codeOf(new Uint8Array([0xc1, 0x05, 0xf1, 0x01, 0x01]))).toEqual({
116:       code: 0xf1,
117:       sub: 0x01,
118:     });
119:   });
120: 
121:   it('reads them past the two-byte length of a C2 frame', () => {
122:     expect(codeOf(new Uint8Array([0xc2, 0x00, 0x06, 0xf3, 0x03, 0x00]))).toEqual({
123:       code: 0xf3,
124:       sub: 0x03,
125:     });
126:   });
127: });
