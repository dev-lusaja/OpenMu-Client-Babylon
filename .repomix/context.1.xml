272: Bun.serve<WebSocketData>({
273:   port: PORT,
274:   hostname: HOSTNAME,
275:   fetch(req, server) {
276:     const url = new URL(req.url);
277:     const searchParams = url.searchParams;
278: 
279:     if (url.pathname === ADMIN_STREAM_PATH) {
280:       if (!hub) return new Response("tracking is off", { status: 404 });
281: 
282:       const origin = (req.headers.get("origin") ?? "").toLowerCase();
283:       const rawSession = searchParams.get("session") ?? "";
284:       const session = SESSION_NONCE_RE.test(rawSession) ? rawSession : null;
285: 
286:       let refused: RefusalReason | null = null;
287:       if (ADMIN_ORIGINS.length && !ADMIN_ORIGINS.includes(origin)) refused = "origin";
288:       else {
289:         const auth = hub.authorise(session, isLoopback(server, req));
290:         if (auth !== "ok") refused = auth;
291:       }
292: 
293:       // Refused requests are still upgraded, so the panel can be told why
294:       // before the close: a plain 403 reaches a browser websocket as an
295:       // error with no body.
296:       if (server.upgrade(req, { data: { kind: "admin", refused, socket: null } satisfies AdminData })) {
297:         return;
298:       }
299:       return new Response("Upgrade failed :(", { status: 500 });
300:     }
301: 
302:     const targetHost = searchParams.get("host")?.trim().toLowerCase() ?? "";
303:     const targetPort = parseInt(searchParams.get("port") ?? "0");
304: 
305:     // Refuse here rather than in `open`: a bad target used to upgrade and then
306:     // fail inside Bun.connect, which the client sees as a socket that closed
307:     // for no reason.
308:     if (!targetHost || !(targetPort > 0 && targetPort <= 65535)) {
309:       return new Response("host and port query parameters are required", {
310:         status: 400,
311:       });
312:     }
313: 
314:     if (!targetAllowed(ALLOW_RULES, targetHost, targetPort, RESERVED_TARGETS)) {
315:       console.warn(`refused target ${targetHost}:${targetPort}`);
316:       return new Response("target not allowed", { status: 403 });
317:     }
318: 
319:     // The page's session nonce (src/common/sessionNonce.ts), which lets the
320:     // cash shop put an account to this socket through the presence server's
321:     // /ticket/<nonce>. Absent or malformed is not a refusal: it only means
322:     // this socket can never be named by ticket, and the game must connect
323:     // with a broken shop. It is a bearer credential and is never logged.
324:     const rawSession = searchParams.get("session") ?? "";
325:     const session = SESSION_NONCE_RE.test(rawSession) ? rawSession : null;
326: 
327:     // Built before the upgrade is known to have happened, so a request that
328:     // turns out not to be a websocket handshake has to close it: otherwise it
329:     // sits in the presence registry, and with a nonce in the ticket map, for
330:     // the life of the process.
331:     const presence = new ConnectionPresence(session, targetPort);
332:     const track = tracker ? tracker.open(session, targetPort) : null;
333: 
334:     const data: RelayData = { kind: "relay", targetHost, targetPort, presence, track, band: null };
335: 
336:     // upgrade the request to a WebSocket
337:     if (server.upgrade(req, { data })) {
338:       return; // do not return a Response
339:     }
340: 
341:     presence.close();
342:     if (track) tracker?.close(track);
343:     return new Response("Upgrade failed :(", { status: 500 });
344:   },
345:   websocket: {
346:     sendPings: false,
347:     open(ws) {
348:       if (ws.data.kind === "admin") {
349:         const data = ws.data;
350:         if (data.refused || !hub) {
351:           ws.send(AdminHub.refusal(data.refused ?? "no-session"));
352:           ws.close();
353:           return;
354:         }
355:         data.socket = { send: text => ws.send(text), close: () => ws.close() };
356:         hub.attach(data.socket);
357:         return;
358:       }
359: 
360:       const relay = ws as ServerWebSocket<RelayData>;
361: 
362:       console.log(
363:         `client connected, target ${relay.data.targetHost}:${relay.data.targetPort}`
364:       );
365: 
366:       if (WEATHER_ENABLED) {
367:         clients.add(relay);
368:         // The heartbeat would reach them within 20 s anyway, but a player who
369:         // logs into a downpour should not walk through the first seconds of it
370:         // under a clear sky.
371:         sendWeather(relay, weather);
372:       }
373: 
374:       // The relay needs the ws to send with, so the peer is made here rather
375:       // than in fetch. The hello tells the client instruments work on this
376:       // connection; a client that never gets one keeps them off.
377:       if (band && relay.data.track) {
378:         const peer: BandPeer = { track: relay.data.track, send: frame => relay.send(frame) };
379:         relay.data.band = peer;
380:         band.attach(peer);
381:         relay.send(BandHub.hello());
382:       }
383: 
384:       // Connect to TCP server
385:       Bun.connect({
386:         hostname: relay.data.targetHost,
387:         port: relay.data.targetPort,
388:         socket: {
389:           data(socket, data) {
390:             if (LOG_PACKETS) console.log("data from tcp:", stringifyPacket(data));
391: 
392:             const forwarded = asBufferSource(data);
393: 
394:             relay.send(forwarded);
395: 
396:             // The server's side of the login: the sniffer names a socket only
397:             // once the game server has said yes, never off the client's own
398:             // claim. Same copy discipline as the other direction.
399:             if (typeof forwarded !== "string") {
400:               const copy = new Uint8Array(forwarded);
401:               const confirmed = relay.data.presence.feedFromServer(copy);
402:               const track = relay.data.track;
403:               if (track) {
404:                 if (confirmed) track.setAccount(confirmed);
405:                 track.feedServer(copy);
406:               }
407:             }
408:           },
409:           open(socket) {
410:             relay.data.tcpSocket = socket;
411:           },
412:           close(socket) { },
413:           drain(socket) { },
414:           error(socket, error) {
415:             console.log(`tcp error:`, error);
416:             relay.data.tcpSocket = undefined;
417:             relay.close();
418:           },
419: 
420:           // client-specific handlers
421:           connectError(socket, error) {
422:             console.log(
423:               `tcp connect error(${relay.data.targetHost}:${relay.data.targetPort}):`,
424:               error
425:             );
426:             // Tell the client now. Left open, the ws just sits there and the
427:             // player waits on a game server that was never reached - which is
428:             // also what the client's address fallback keys off.
429:             relay.close();
430:           }, // connection failed
431:           end(socket) {
432:             relay.data.tcpSocket = undefined;
433:             relay.close();
434:           }, // connection closed by server
435:           timeout(socket) { }, // connection timed out
436:         },
437:       });
438:     },
439:     message(ws, message) {
440:       if (ws.data.kind === "admin") {
441:         if (ws.data.socket && hub && typeof message === "string") hub.receive(ws.data.socket, message);
442:         return;
443:       }
444: 
445:       const relay = ws as ServerWebSocket<RelayData>;
446: 
447:       // A band frame is the proxy's to handle and never the game server's:
448:       // swallowed whether the relay is on or off, before the log and the
449:       // write, and never shown to the sniffers.
450:       if (typeof message !== "string") {
451:         const bytes = asBufferSource(message) as Uint8Array;
452:         if (isBandFrame(bytes)) {
453:           if (band && relay.data.band) band.receive(relay.data.band, bytes);
454:           return;
455:         }
456:       }
457: 
458:       const socket = relay.data.tcpSocket;
459:       if (socket) {
460:         if (LOG_PACKETS) console.log("data from ws:", stringifyPacket(message));
461: 
462:         const forwarded = asBufferSource(message);
463: 
464:         socket.write(forwarded);
465:         socket.flush();
466: 
467:         // After the write, and on its own copy: the sniffer decrypts in place
468:         // and must never touch what goes to the game server.
469:         if (typeof forwarded !== "string") {
470:           const copy = new Uint8Array(forwarded);
471:           relay.data.presence.feed(copy);
472:           relay.data.track?.feedClient(copy);
473:         }
474:       }
475:     },
476:     close(ws, code, message) {
477:       if (ws.data.kind === "admin") {
478:         if (ws.data.socket && hub) hub.detach(ws.data.socket);
479:         return;
480:       }
481: 
482:       const relay = ws as ServerWebSocket<RelayData>;
483:       clients.delete(relay);
484:       relay.data.presence.close();
485:       // Before the tracker closes the session: the gone / leave notices
486:       // still need its map and scope.
487:       if (relay.data.band) band?.detach(relay.data.band);
488:       if (relay.data.track) tracker?.close(relay.data.track);
489: 
490:       const socket = relay.data.tcpSocket;
491:       if (socket) {
492:         socket.flush();
493:         socket.end();
494:         relay.data.tcpSocket = undefined;
495:       }
496:     },
497:   },
498: });
499: 
500: console.log(`Listening...`);
</file>

