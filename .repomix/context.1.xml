<file path="marketplace/server/identity.ts">
  1: import { createHmac, randomBytes, timingSafeEqual } from 'node:crypto';
  2: import { SESSION_NONCE_RE } from '../../src/common/sessionNonce';
  3: 
  4: /**
  5:  * Who is asking.
  6:  *
  7:  * The window runs inside a session the game server already authenticated. The
  8:  * player typed a password at login and must not type it again, so this service
  9:  * cannot ask for one - and it must never trust a name the browser sends,
 10:  * because anyone can type a name. Without this the marketplace would let
 11:  * anybody list, buy or collect a balance as anybody else.
 12:  *
 13:  * The one process that knows which account owns a socket is the proxy. It
 14:  * reads the login off every connection and waits for the *game server* to
 15:  * accept it (`proxy/presence.ts`; the client's own login frame is a claim,
 16:  * not proof), then binds the result to the nonce the page put on the
 17:  * websocket URL. The nonce is 128 random bits chosen by the page, so holding
 18:  * it is proof of holding the socket.
 19:  *
 20:  * The browser cannot ask the proxy itself: the presence server is loopback
 21:  * only and answers "is this account playing" to anyone who reaches it. So the
 22:  * window posts its nonce here, this asks presence over loopback, and mints a
 23:  * ticket for the account it names.
 24:  *
 25:  * A ticket reads. It is deliberately not enough to *commit* anything: it
 26:  * outlives the socket, so one lifted from a request log would still work for
 27:  * its ten minutes. Anything that moves goods or money asks presence again
 28:  * (`confirmLive`) and refuses if the socket is gone or is now somebody else.
 29:  */
 30: 
 31: /** The presence server's own rule for a login name (`ACCOUNT_RE` there). */
 32: const ACCOUNT_RE = /^[A-Za-z0-9]{1,10}$/;
 33: 
 34: /** Short, because a ticket is a bearer token; the client re-exchanges on a 401. */
 35: export const TICKET_TTL_MS = 10 * 60 * 1000;
 36: 
 37: /** A base64url SHA-256 digest is always this long. */
 38: const MAC_LENGTH = 43;
 39: 
 40: const PRESENCE_URL = process.env.PRESENCE_URL ?? 'http://127.0.0.1:3001';
 41: const PRESENCE_TIMEOUT_MS = Number(process.env.PRESENCE_TIMEOUT_MS ?? 2000);
 42: 
 43: /**
 44:  * Set `MARKETPLACE_TICKET_SECRET` in production. Without it every restart
 45:  * invalidates every ticket, which is survivable - clients re-exchange - but
 46:  * it is a warning worth seeing, because it also means two processes behind a
 47:  * load balancer would not accept each other's.
 48:  */
 49: const SECRET: Uint8Array = (() => {
 50:   const configured = process.env.MARKETPLACE_TICKET_SECRET;
 51:   if (configured) return new TextEncoder().encode(configured);
 52:   console.warn(
 53:     'marketplace: MARKETPLACE_TICKET_SECRET is not set; signing with a random per-boot secret, ' +
 54:       'so every ticket is invalidated on restart.'
 55:   );
 56:   return new Uint8Array(randomBytes(32));
 57: })();
 58: 
 59: export type Ticket = { ticket: string; account: string; expiresAt: number };
 60: 
 61: export type Verification =
 62:   | { ok: true; account: string; expiresAt: number }
 63:   | { ok: false; reason: 'malformed' | 'forged' | 'expired' };
 64: 
 65: export type SessionFailure = 'malformed' | 'unknown' | 'unreachable';
 66: 
 67: export type Exchange =
 68:   | { ok: true; ticket: Ticket }
 69:   | { ok: false; reason: SessionFailure; message: string };
 70: 
 71: type Named = { ok: true; account: string } | { ok: false; reason: SessionFailure; message: string };
 72: 
 73: function sign(account: string, expiresAt: number): string {
 74:   return createHmac('sha256', SECRET).update(`${account}|${expiresAt}`).digest('base64url');
 75: }
 76: 
 77: /**
 78:  * Lowercased, because OpenMU's login is case-insensitive: "Player" and
 79:  * "PLAYER" are one account, and a balance keyed under two spellings would be
 80:  * two balances.
 81:  */
 82: export function mintTicket(account: string, now = Date.now()): Ticket {
 83:   if (!ACCOUNT_RE.test(account)) throw new Error(`refusing to mint a ticket for "${account}"`);
 84: 
 85:   const canonical = account.toLowerCase();
 86:   const expiresAt = now + TICKET_TTL_MS;
 87:   return { ticket: `${canonical}.${expiresAt}.${sign(canonical, expiresAt)}`, account: canonical, expiresAt };
 88: }
 89: 
 90: /**
 91:  * Never throws; the caller turns a failure into a 401 and the client
 92:  * exchanges again. The MAC comparison is constant-time, so a forger learns
 93:  * nothing from how fast a wrong one is refused.
 94:  */
 95: export function verifyTicket(ticket: unknown, now = Date.now()): Verification {
 96:   if (typeof ticket !== 'string') return { ok: false, reason: 'malformed' };
 97: 
 98:   const parts = ticket.split('.');
 99:   if (parts.length !== 3) return { ok: false, reason: 'malformed' };
100: 
101:   const [account, expiry, mac] = parts;
102:   if (!ACCOUNT_RE.test(account)) return { ok: false, reason: 'malformed' };
103:   if (!/^\d{1,16}$/.test(expiry)) return { ok: false, reason: 'malformed' };
104:   if (mac.length !== MAC_LENGTH) return { ok: false, reason: 'malformed' };
105: 
106:   const expiresAt = Number(expiry);
107:   const encoder = new TextEncoder();
108:   const expected = encoder.encode(sign(account, expiresAt));
109:   const given = encoder.encode(mac);
110: 
111:   if (expected.length !== given.length || !timingSafeEqual(expected, given)) {
112:     return { ok: false, reason: 'forged' };
113:   }
114:   if (expiresAt <= now) return { ok: false, reason: 'expired' };
115: 
116:   return { ok: true, account, expiresAt };
117: }
118: 
119: /**
120:  * Who the proxy says is logged in on the socket carrying this nonce.
121:  *
122:  * Fails closed: a presence server that is down, slow, or answering nonsense
123:  * names nobody. It never returns a name it did not hear from presence.
124:  */
125: async function whoIsOn(nonce: unknown): Promise<Named> {
126:   if (typeof nonce !== 'string' || !SESSION_NONCE_RE.test(nonce)) {
127:     return { ok: false, reason: 'malformed', message: 'That session is not one the marketplace recognises.' };
128:   }
129: 
130:   let answer: { account?: unknown };
131:   try {
132:     const response = await fetch(`${PRESENCE_URL}/ticket/${nonce}`, {
133:       signal: AbortSignal.timeout(PRESENCE_TIMEOUT_MS),
134:     });
135: 
136:     if (response.status === 404) {
137:       // Bound but not yet named: the account is known only once the game
138:       // server has accepted the login.
139:       return { ok: false, reason: 'unknown', message: 'Log in to the game first.' };
140:     }
141:     if (!response.ok) {
142:       console.error(`marketplace: presence answered HTTP ${response.status}`);
143:       return { ok: false, reason: 'unreachable', message: 'Cannot confirm who you are right now.' };
144:     }
145:     answer = (await response.json()) as { account?: unknown };
146:   } catch (error) {
147:     // `PRESENCE=off` on the proxy lands here as a refused connection, and the
148:     // marketplace then serves nobody, which is the intended failure.
149:     console.error('marketplace: presence unreachable:', error instanceof Error ? error.message : error);
150:     return { ok: false, reason: 'unreachable', message: 'Cannot confirm who you are right now.' };
151:   }
152: 
153:   const account = answer.account;
154:   if (typeof account !== 'string' || !ACCOUNT_RE.test(account)) {
155:     console.error('marketplace: presence named an account this refuses to sign for');
156:     return { ok: false, reason: 'unreachable', message: 'Cannot confirm who you are right now.' };
157:   }
158: 
159:   return { ok: true, account };
160: }
161: 
162: /** Turns the websocket nonce into a ticket for whoever the proxy says is on it. */
163: export async function exchangeSession(nonce: unknown): Promise<Exchange> {
164:   const named = await whoIsOn(nonce);
165:   return named.ok ? { ok: true, ticket: mintTicket(named.account) } : named;
166: }
167: 
168: export type Liveness =
169:   | { ok: true }
170:   | { ok: false; reason: SessionFailure | 'someoneElse'; message: string };
171: 
172: /**
173:  * Whether the socket behind `nonce` is, right now, logged in as the account
174:  * the ticket names. Asked before anything commits: the ticket proves this
175:  * service once vouched for the account, this proves the player is still
176:  * sitting at it. A ticket presented with somebody else's nonce buys nothing.
177:  */
178: export async function confirmLive(nonce: unknown, account: string): Promise<Liveness> {
179:   const named = await whoIsOn(nonce);
180: 
181:   if (!named.ok) {
182:     return named.reason === 'unknown'
183:       ? { ok: false, reason: 'unknown', message: 'Your game session has ended. Log in again.' }
184:       : named;
185:   }
186:   if (named.account.toLowerCase() !== account.toLowerCase()) {
187:     return { ok: false, reason: 'someoneElse', message: 'Your game session has ended. Log in again.' };
188:   }
189: 
190:   return { ok: true };
191: }
</file>

