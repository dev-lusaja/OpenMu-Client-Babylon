246:   /** Resolves when the server reports the trade closed, either way. */
247:   waitForFinish(timeoutMs = 60_000): Promise<TradeOutcome> {
248:     return new Promise<TradeOutcome>(resolve => {
249:       const timer = setTimeout(() => {
250:         this.finished = null;
251:         this.cancel();
252:         resolve({ ok: false, reason: `trade did not finish within ${timeoutMs}ms` });
