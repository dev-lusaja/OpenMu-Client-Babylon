365: const placeInTransaction = db.transaction(
366:   (input: NewOrder, admit: (seen: PlacementView) => string | null): Placement => {
367:     const seen: PlacementView = {
368:       committed: chaosCommittedBy(input.account),
369:       spentToday: spentTodayBy(input.account)[input.productId] ?? 0,
