 217:   );
 218: 
 219:   for (const wanted of EXCELLENT_TYPE_NAMES) {
 220:     const exact = rows.filter(row => row.name === wanted);
 221:     if (exact.length === 1) return exact[0].id;
 222:   }
 223: 
 224:   const prefixed = rows.filter(row => /^excellent/i.test(row.name));
 225: 
 226:   if (prefixed.length === 1) return prefixed[0].id;
 227: 
 228:   throw new Error(
 229:     'cannot tell which ItemOptionType is the excellent one ' +
 230:       `(looked for ${EXCELLENT_TYPE_NAMES.join(', ')}; ` +
 231:       `the table has ${rows.map(row => row.name).sort().join(', ')})`
 232:   );
 233: }
 234: 
 235: async function findDefinition(
 236:   sql: Sql | TransactionSql,
 237:   resolved: Resolved,
 238:   group: number,
 239:   number: number
 240: ): Promise<DefinitionRow | null> {
 241:   const { itemDefinition: d } = resolved.schema;
 242:   const rows = await sql.unsafe<DefinitionRow[]>(
 243:     `SELECT ${d.col.id} AS id, ${d.col.name} AS name,
 244:             ${d.col.width} AS width, ${d.col.height} AS height,
 245:             ${d.col.durability} AS durability, ${d.col.maximumLevel} AS "maximumLevel"
 246:        FROM ${d.ref}
 247:       WHERE ${d.col.configuration} = $1 AND ${d.col.group} = $2 AND ${d.col.number} = $3
 248:       LIMIT 2`,
 249:     [resolved.gameConfigurationId, group, number]
 250:   );
 251: 
 252:   if (rows.length > 1) {
 253:     throw new Error(
 254:       `item ${group}/${number} has ${rows.length} definitions in the game configuration`
 255:     );
 256:   }
 257: 
 258:   return rows[0] ?? null;
 259: }
 260: 
 261: /**
 262:  * The excellent options a definition can carry, by number, through its own
 263:  * `PossibleItemOptions`. Resolving through the item's definition rather than
 264:  * a hardcoded id is what keeps a granted item legal: an option that does not
 265:  * belong to the item is one OpenMU can load but never produce.
 266:  */
 267: async function excellentOptionsOf(
 268:   sql: Sql | TransactionSql,
 269:   resolved: Resolved,
 270:   definitionId: string
 271: ): Promise<Map<number, string>> {
 272:   const { definitionOptions: j, increasableOption: o } = resolved.schema;
 273:   const rows = await sql.unsafe<{ number: number; id: string }[]>(
 274:     `SELECT o.${o.col.number} AS number, o.${o.col.id} AS id
 275:        FROM ${o.ref} o
 276:        JOIN ${j.ref} j ON j.${j.col.optionDefinition} = o.${o.col.optionDefinition}
 277:       WHERE j.${j.col.definition} = $1 AND o.${o.col.type} = $2`,
 278:     [definitionId, resolved.excellentTypeId]
 279:   );
 280: 
 281:   const byNumber = new Map<number, string>();
 282:   for (const row of rows) byNumber.set(Number(row.number), row.id);
 283:   return byNumber;
 284: }
 285: 
 286: function excellentNumberOf(label: string): number {
 287:   const hits = EXCELLENT_NUMBERS.filter(([pattern]) => pattern.test(label));
 288: 
 289:   if (hits.length !== 1) {
 290:     throw new Refusal(
 291:       `The option "${label}" is not one the game knows. Nothing was spent.`,
 292:       'failed'
 293:     );
 294:   }
 295: 
 296:   return hits[0][1];
 297: }
 298: 
 299: /* --------------------------------------------------------------------- fit */
 300: 
 301: interface PlacedRow extends Footprint {
 302:   id: string;
 303: }
 304: 
 305: /**
 306:  * `InventoryConstants` knows about the four purchasable extensions, four rows
 307:  * each, but the client does not draw them: `PlayerData.items` is 76 entries
 308:  * (`src/store.ts`) and the inventory window is 8x8. An item fitted into an
 309:  * extension row would exist and be invisible, so the fit stops at the base
 310:  * grid until the client can show more. Flip this when it can.
 311:  */
 312: const DELIVER_INTO_EXTENSIONS = false;
 313: 
 314: /**
 315:  * How many grid rows a delivery may use. The search over them is
 316:  * `findFreeSlot`, the client's own loop, so that the slot chosen here is the
 317:  * slot the client would have chosen; rows the personal store uses (from
 318:  * `FirstStoreItemSlotIndex`) share the storage and lie outside the grid, as
 319:  * do the twelve equipment slots.
 320:  */
 321: function gridRows(inventoryExtensions: number): number {
 322:   const extensions = DELIVER_INTO_EXTENSIONS
 323:     ? Math.max(Math.min(inventoryExtensions, InventoryConstants.MaximumNumberOfExtensions), 0)
 324:     : 0;
 325: 
 326:   return InventoryConstants.InventoryRows + InventoryConstants.RowsOfOneExtension * extensions;
 327: }
 328: 
 329: /* ------------------------------------------------------------------ wallet */
 330: 
 331: interface JewelRow {
 332:   id: string;
 333:   storage: 'inventory' | 'vault';
 334:   slot: number;
 335: }
 336: 
 337: /**
 338:  * Every Jewel of Chaos the account owns, in the bag and in the vault, in the
 339:  * order they would be spent. `FOR UPDATE` inside the transaction so that two
 340:  * deliveries cannot both count the same jewel; a plain read outside it for
 341:  * the wallet the placement route shows.
 342:  */
 343: async function chaosRows(
 344:   sql: Sql | TransactionSql,
 345:   resolved: Resolved,
 346:   inventoryId: string | null,
 347:   vaultId: string | null,
 348:   lock: boolean
 349: ): Promise<JewelRow[]> {
 350:   const { item: i } = resolved.schema;
 351:   const storages: [string, JewelRow['storage']][] = [];
 352: 
 353:   if (inventoryId) storages.push([inventoryId, 'inventory']);
 354:   if (vaultId) storages.push([vaultId, 'vault']);
 355:   if (storages.length === 0) return [];
 356: 
 357:   const rows = await sql.unsafe<{ id: string; storage: string; slot: number }[]>(
 358:     `SELECT i.${i.col.id} AS id, i.${i.col.storage} AS storage, i.${i.col.slot} AS slot
 359:        FROM ${i.ref} i
 360:       WHERE i.${i.col.definition} = $1 AND i.${i.col.storage} = ANY($2::uuid[])
 361:       ORDER BY i.${i.col.slot}${lock ? ' FOR UPDATE OF i' : ''}`,
 362:     [resolved.chaosDefinitionId, sql.array(storages.map(([id]) => id))]
 363:   );
 364: 
 365:   const kindOf = new Map(storages);
 366:   const jewels = rows.map(row => ({
 367:     id: row.id,
 368:     storage: kindOf.get(row.storage) ?? 'vault',
 369:     slot: Number(row.slot),
 370:   }));
 371: 
 372:   return jewels.sort(
 373:     (a, b) => SPEND_ORDER.indexOf(a.storage) - SPEND_ORDER.indexOf(b.storage) || a.slot - b.slot
 374:   );
 375: }
 376: 
 377: /* --------------------------------------------------------------- the order */
 378: 
 379: interface CharacterRow {
 380:   id: string;
 381:   name: string;
 382:   inventoryId: string;
 383:   slot: number;
 384:   inventoryExtensions: number;
 385: }
 386: 
 387: /** What one delivery resolved before it touched anything, for the audit row. */
 388: interface Grant {
 389:   definitionId: string;
 390:   definitionName: string;
 391:   level: number;
 392:   width: number;
 393:   height: number;
 394:   durability: number;
 395:   /** `IncreasableItemOption` ids, in option-number order. */
 396:   optionIds: string[];
 397:   seed: number | null;
 398: }
 399: 
 400: interface Delivery {
 401:   character: string;
 402:   slot: number;
 403:   spent: JewelRow[];
 404:   walletBefore: number;
 405:   grant: Grant;
 406:   itemId: string | null;
 407: }
 408: 
 409: /**
 410:  * A refusal the player will read. `queued` means try again next time - the
 411:  * order keeps its place - and `failed` means the order is over and nothing
 412:  * was spent. Every path through the transaction that is not a commit ends in
 413:  * one of these, in words rather than a stack trace.
 414:  */
 415: class Refusal extends Error {
 416:   constructor(
 417:     message: string,
 418:     readonly outcome: 'queued' | 'failed'
 419:   ) {
 420:     super(message);
 421:   }
 422: }
 423: 
 424: /**
 425:  * Wraps whatever the transaction callback threw, so the caller can tell
 426:  * "before COMMIT" from "around it".
 427:  */
 428: class BeforeCommit extends Error {
 429:   constructor(readonly inner: unknown) {
 430:     super('before commit');
 431:   }
 432: }
 433: 
 434: /** Thrown at the end of a rehearsal so the transaction rolls back with its reads done. */
 435: class Rehearsed extends Error {
 436:   constructor(readonly delivery: Delivery) {
 437:     super('rehearsal');
 438:   }
 439: }
 440: 
 441: /** The order's product, or the grant a fixed product resolves to on the catalogue. */
 442: function productOf(order: Order): Product {
 443:   const product = productById(order.productId);
 444: 
 445:   if (!product) {
 446:     throw new Refusal(
 447:       `The shop no longer sells "${order.productName}". Nothing was spent.`,
 448:       'failed'
 449:     );
 450:   }
 451: 
 452:   return product;
 453: }
 454: 
 455: /**
 456:  * What to insert. A fixed product is its catalogue entry at its level; a
 457:  * gacha order is its stored roll, granted exactly - the seed is in the audit
 458:  * row so the item can be checked against `roll(seed)` later. Both are checked
 459:  * against the game's own definition: the footprint the shop fitted must be the
 460:  * footprint the game will draw, and the level must be one the definition
 461:  * allows.
 462:  */
 463: async function resolveGrant(tx: TransactionSql, resolved: Resolved, order: Order): Promise<Grant> {
 464:   const product = productOf(order);
 465:   let group: number;
 466:   let number: number;
 467:   let level: number;
 468:   let width: number;
 469:   let height: number;
 470:   let labels: string[] = [];
 471:   let seed: number | null = null;
 472: 
 473:   if (order.line === 'gacha') {
 474:     const roll: Roll | null = order.roll;
 475: 
 476:     if (!roll) {
 477:       throw new Refusal(
 478:         'This roll was never recorded, so it cannot be delivered. Nothing was spent.',
 479:         'failed'
 480:       );
 481:     }
 482: 
 483:     ({ group, num: number, level, width, height, seed } = roll);
 484:     labels = roll.excellent ? roll.options : [];
 485:   } else {
 486:     if (product.group === null || product.number === null) {
 487:       throw new Refusal(`"${product.name}" is not an item the shop can place in a bag.`, 'failed');
 488:     }
 489: 
 490:     ({ group, number, level, width, height } = product);
 491:   }
 492: 
 493:   const definition = await findDefinition(tx, resolved, group, number);
 494: 
 495:   if (!definition) {
 496:     throw new Refusal(
 497:       `The game has no item ${group}/${number} to give you. Nothing was spent.`,
 498:       'failed'
 499:     );
 500:   }
 501: 
 502:   if (definition.width !== width || definition.height !== height) {
 503:     throw new Refusal(
 504:       `The game says "${definition.name}" is ${definition.width}x${definition.height}, ` +
 505:         `the shop thought ${width}x${height}. Nothing was spent.`,
 506:       'failed'
 507:     );
 508:   }
 509: 
 510:   if (level > definition.maximumLevel) {
 511:     throw new Refusal(
 512:       `"${definition.name}" cannot be +${level}; ` +
 513:         `the game allows up to +${definition.maximumLevel}. Nothing was spent.`,
 514:       'failed'
 515:     );
 516:   }
 517: 
 518:   const optionIds: string[] = [];
 519: 
 520:   if (labels.length > 0) {
 521:     const available = await excellentOptionsOf(tx, resolved, definition.id);
 522:     const numbers = [...new Set(labels.map(excellentNumberOf))].sort((a, b) => a - b);
 523: 
 524:     for (const n of numbers) {
 525:       const id = available.get(n);
 526: 
 527:       if (!id) {
 528:         throw new Refusal(
 529:           `"${definition.name}" cannot carry excellent option ${n} in this game. ` +
 530:             'Nothing was spent.',
 531:           'failed'
 532:         );
 533:       }
 534: 
 535:       optionIds.push(id);
 536:     }
 537:   }
 538: 
 539:   return {
 540:     definitionId: definition.id,
 541:     definitionName: definition.name,
 542:     level,
 543:     width,
 544:     height,
 545:     durability: Number(definition.durability),
 546:     optionIds,
 547:     seed,
 548:   };
 549: }
 550: 
 551: /**
 552:  * The character whose bag takes a delivery and whose jewels pay for it - the
 553:  * same character for both on purpose, because the fit treats the bag jewels
 554:  * about to be spent as free squares, and that only holds when the spend and
 555:  * the delivery are one bag.
 556:  *
 557:  * ARCHITECTURE.md says "the selected character's inventory", and OpenMU has
 558:  * no such thing to read: `Character` (`DataModel/Entities/Character.cs`)
 559:  * carries `CharacterSlot` and `CreateDate` but no last-played time, `Account`
 560:  * names no current character, and which character a player is on lives in
 561:  * the game server's memory. So the rule is the lowest `CharacterSlot` - the
 562:  * first on the select screen, which the player made first and sees first.
 563:  * `Fulfilment.wallet` counts the same character's bag plus the vault, so the
 564:  * balance the window shows is the balance delivery will spend from. Whatever
 565:  * lands there can be moved through the vault to any other character.
 566:  */
 567: async function deliveryCharacter(
 568:   sql: Sql | TransactionSql,
 569:   resolved: Resolved,
 570:   accountId: string
 571: ): Promise<CharacterRow | null> {
 572:   const { character: c } = resolved.schema;
 573:   const rows = await sql.unsafe<CharacterRow[]>(
 574:     `SELECT ${c.col.id} AS id, ${c.col.name} AS name, ${c.col.inventory} AS "inventoryId",
 575:             ${c.col.slot} AS slot, ${c.col.inventoryExtensions} AS "inventoryExtensions"
 576:        FROM ${c.ref}
 577:       WHERE ${c.col.account} = $1 AND ${c.col.inventory} IS NOT NULL
 578:       ORDER BY ${c.col.slot} ASC, ${c.col.id} ASC
 579:       LIMIT 1`,
 580:     [accountId]
 581:   );
 582: 
 583:   if (!rows[0]) return null;
 584: 
 585:   return {
 586:     ...rows[0],
 587:     slot: Number(rows[0].slot),
 588:     inventoryExtensions: Number(rows[0].inventoryExtensions),
 589:   };
 590: }
 591: 
 592: /**
 593:  * Steps 6 to 13. Everything in here runs on the transaction's own connection;
 594:  * a statement on the module-level `sql` would run outside the advisory lock
 595:  * and outside the rollback.
 596:  *
 597:  * The order of the steps is the safety: the wallet is read under lock, the
 598:  * item is resolved and fitted, and only then is anything deleted - so a
 599:  * refusal at any point, including a bag with no room, has cost nothing. The
 600:  * fit treats the bag jewels about to be spent as free squares, since the
 601:  * delete that frees them is in this same transaction; that is what lets a
 602:  * bag full of chaos take the item it is paying for.
 603:  */
 604: async function deliverInTransaction(
 605:   tx: TransactionSql,
 606:   resolved: Resolved,
 607:   account: AccountRow,
 608:   order: Order,
 609:   rehearse: boolean
 610: ): Promise<Delivery> {
 611:   const { item: i, itemOptionLink: l, itemDefinition: d } = resolved.schema;
 612: 
 613:   await tx.unsafe('SELECT pg_advisory_xact_lock(hashtextextended($1::text, 0))', [account.id]);
 614: 
 615:   const character = await deliveryCharacter(tx, resolved, account.id);
 616: 
 617:   if (!character) {
 618:     throw new Refusal(
 619:       'You have no character to deliver to. Create one and the order will be delivered.',
 620:       'queued'
 621:     );
 622:   }
 623: 
 624:   const jewels = await chaosRows(tx, resolved, character.inventoryId, account.vaultId, true);
 625: 
 626:   if (jewels.length < order.chaos) {
 627:     throw new Refusal(
 628:       `You have ${jewels.length} Jewel${jewels.length === 1 ? '' : 's'} of Chaos ` +
 629:         `and this costs ${order.chaos}. Nothing was spent.`,
 630:       'failed'
 631:     );
 632:   }
 633: 
 634:   const spent = jewels.slice(0, order.chaos);
 635:   const spentIds = new Set(spent.map(jewel => jewel.id));
 636:   const grant = await resolveGrant(tx, resolved, order);
 637: 
 638:   const placed = await tx.unsafe<PlacedRow[]>(
 639:     `SELECT i.${i.col.id} AS id, i.${i.col.slot} AS slot,
 640:             d.${d.col.width} AS width, d.${d.col.height} AS height
 641:        FROM ${i.ref} i
 642:        JOIN ${d.ref} d ON d.${d.col.id} = i.${i.col.definition}
 643:       WHERE i.${i.col.storage} = $1 AND i.${i.col.slot} >= $2 AND i.${i.col.slot} < $3`,
 644:     [
 645:       character.inventoryId,
 646:       InventoryConstants.LastEquippableItemSlotIndex + 1,
 647:       InventoryConstants.FirstStoreItemSlotIndex,
 648:     ]
 649:   );
 650:   const occupied: Footprint[] = placed
 651:     .filter(row => !spentIds.has(row.id))
 652:     .map(row => ({
 653:       slot: Number(row.slot),
 654:       width: Number(row.width),
 655:       height: Number(row.height),
 656:     }));
 657:   const rows = gridRows(character.inventoryExtensions);
 658:   const slot = findFreeSlot(occupied, rows, grant.width, grant.height);
 659: 
 660:   if (slot < 0) {
 661:     // The one refusal that is nobody's fault, and for a gacha the one that
 662:     // must not void a roll committed at placement: it waits for the next
 663:     // logout with room in the bag. A fixed product can simply be bought
 664:     // again, so it fails and gives its daily-cap slot back.
 665:     throw new Refusal(
 666:       `No room in ${character.name}'s bag for a ${grant.width}x${grant.height} item. ` +
 667:         `Make ${grant.width * grant.height} squares free and log out again. Nothing was spent.`,
 668:       order.line === 'gacha' ? 'queued' : 'failed'
 669:     );
 670:   }
 671: 
 672:   const delivery: Delivery = {
 673:     character: character.name,
 674:     slot,
 675:     spent,
 676:     walletBefore: jewels.length,
 677:     grant,
 678:     itemId: null,
 679:   };
 680: 
 681:   if (rehearse) throw new Rehearsed(delivery);
 682: 
 683:   const ids = tx.array(spent.map(jewel => jewel.id));
 684: 
 685:   // Option rows first, then the items: a jewel has none, but a foreign key is
 686:   // not a thing to find out about mid-transaction.
 687:   await tx.unsafe(`DELETE FROM ${l.ref} WHERE ${l.col.item} = ANY($1::uuid[])`, [ids]);
 688:   const deleted = await tx.unsafe(`DELETE FROM ${i.ref} WHERE ${i.col.id} = ANY($1::uuid[])`, [ids]);
 689: 
 690:   if (deleted.count !== spent.length) {
 691:     throw new Error(`expected to delete ${spent.length} jewels, deleted ${deleted.count}`);
 692:   }
 693: 
 694:   const itemColumns = [
 695:     i.col.id,
 696:     i.col.storage,
 697:     i.col.definition,
 698:     i.col.slot,
 699:     i.col.durability,
 700:     i.col.level,
 701:     i.col.hasSkill,
 702:     i.col.socketCount,
 703:     i.col.petExperience,
 704:   ];
 705:   assertInsertable(i, itemColumns);
 706: 
 707:   const inserted = await tx.unsafe<{ id: string }[]>(
 708:     `INSERT INTO ${i.ref} (${itemColumns.join(', ')})
 709:      VALUES (gen_random_uuid(), $1, $2, $3, $4, $5, false, 0, 0)
 710:      RETURNING ${i.col.id} AS id`,
 711:     [character.inventoryId, grant.definitionId, slot, grant.durability, grant.level]
 712:   );
 713:   const itemId = inserted[0]?.id;
 714: 
 715:   if (!itemId) throw new Error('the item INSERT returned no id');
 716: 
 717:   if (grant.optionIds.length > 0) {
 718:     const linkColumns = [l.col.id, l.col.item, l.col.option, l.col.level, l.col.index];
 719:     assertInsertable(l, linkColumns);
 720: 
 721:     for (const optionId of grant.optionIds) {
 722:       await tx.unsafe(
 723:         `INSERT INTO ${l.ref} (${linkColumns.join(', ')})
 724:          VALUES (gen_random_uuid(), $1, $2, $3, $4)`,
 725:         [itemId, optionId, OPTION_LINK_LEVEL, OPTION_LINK_INDEX]
 726:       );
 727:     }
 728:   }
 729: 
 730:   return { ...delivery, itemId };
 731: }
 732: 
 733: /* ----------------------------------------------------------------- reasons */
 734: 
 735: /**
 736:  * The gate's refusal, in the words the delivery tab shows. The signal names
 737:  * and their technical reasons go to the audit log; the player gets told what
 738:  * to do about it.
 739:  */
 740: function playerWords(verdict: GateVerdict): string {
 741:   const refused = verdict.signals.filter(signal => !signal.safe);
 742:   const named = (name: SignalResult['name']) => refused.find(signal => signal.name === name);
 743: 
 744:   const presence = named('presence');
 745:   if (presence) {
 746:     if (/logged in/.test(presence.reason)) {
 747:       return 'You are logged in. Log out and it will be delivered within a minute.';
 748:     }
 749:     if (/logged out/.test(presence.reason)) {
 750:       return 'You logged out a moment ago. It will be delivered within a minute.';
 751:     }
 752:     return 'The shop cannot see who is online right now. It will keep trying.';
 753:   }
 754: 
 755:   if (named('writeRecency')) {
 756:     return (
 757:       'Your characters were saved a moment ago, so you may still be playing. ' +
 758:       'It will be delivered once the game has been quiet for a few minutes.'
 759:     );
 760:   }
 761: 
 762:   if (named('personalStore')) {
 763:     return 'A character on your account has a personal store open. Close it and log out.';
 764:   }
 765: 
 766:   return 'Deliveries are paused while the server is checked. Your order keeps its place.';
 767: }
 768: 
 769: function describe(error: unknown): string {
 770:   return error instanceof Error ? error.message : String(error);
 771: }
 772: 
 773: /** The audit's view of a verdict: every signal, safe or not. */
 774: function signalsOf(verdict: GateVerdict): Record<string, { safe: boolean; reason: string }> {
 775:   const out: Record<string, { safe: boolean; reason: string }> = {};
 776:   for (const signal of verdict.signals) out[signal.name] = { safe: signal.safe, reason: signal.reason };
 777:   return out;
 778: }
 779: 
 780: /* ------------------------------------------------------------------ worker */
 781: 
 782: /**
 783:  * The delivery worker. One per process, sharing the one `SafetyGate`: the
 784:  * gate's sampling fallback and probe cache live on the instance, and a fresh
 785:  * gate per order would refuse forever on a database without commit
 786:  * timestamps.
 787:  *
 788:  * One account at a time, and all of an account's queued orders in one pass
 789:  * under one gate verdict and one State lock. That is not only faster: the
 790:  * write-recency signal reads `data."Item"`, so the shop's own commit looks
 791:  * like a save for the next three minutes, and delivering twelve gacha rolls
 792:  * one pass apiece would take the better part of an hour.
 793:  */
 794: export class Fulfilment {
 795:   private resolved: Resolved | null = null;
 796:   private timer: ReturnType<typeof setTimeout> | null = null;
 797:   private sweeper: ReturnType<typeof setInterval> | null = null;
 798:   private running = false;
 799:   private stopped = false;
 800:   /** Accounts whose `State` this process holds locked right now, by id, for the sweep. */
 801:   private readonly inFlight = new Set<string>();
 802:   /**
 803:    * `group/number` -> whether the game configuration defines it. Definitions
 804:    * do not change while the server runs.
 805:    */
 806:   private readonly grantableByKey = new Map<string, boolean>();
 807: 
 808:   constructor(
 809:     private readonly sql: Sql,
 810:     private readonly gate: SafetyGate,
 811:     private readonly config: FulfilmentConfig = loadFulfilmentConfig()
 812:   ) {}
 813: 
 814:   get mode(): 'on' | 'off' {
 815:     return this.config.fulfil ? 'on' : 'off';
 816:   }
 817: 
 818:   /** Whether the service can honestly tell the window it will deliver. */
 819:   get acceptingOrders(): boolean {
 820:     return this.resolved !== null;
 821:   }
