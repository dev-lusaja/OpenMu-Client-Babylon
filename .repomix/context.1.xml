18: export function monsterName(type: number): string {
19:   return MONSTER_NAMES.get(type) ?? `Monster ${type}`;
20: }
21: 
22: export function mapName(map: number): string {
23:   return gmMapName(map);
24: }
25: 
26: /**
27:  * An item's name from its 12 wire bytes (`ItemSerializer.DeserializeItem`'s
28:  * layout): number in byte 0 plus bit 7 of byte 3, level in bits 3-6 of byte
29:  * 1, the excellent bits in byte 3, the group in the high nibble of byte 5.
30:  */
31: export function itemName(data: Uint8Array): string {
32:   if (data.length < 6) return 'an item';
33: 
34:   const number = data[0] + ((data[3] & 0x80) << 1);
35:   const group = (data[5] & 0xf0) >> 4;
36:   const level = (data[1] & 0x78) >> 3;
37:   const excellent = (data[3] & 0x3f) !== 0;
38:   const luck = (data[1] & 0x04) !== 0;
39:   const skill = (data[1] & 0x80) !== 0;
40: 
41:   // Zen travels as an item too (group 14, number 15) with the amount in the
42:   // durability and option bytes.
43:   if (group === 14 && number === 15) {
44:     const amount = data[2] + (data[4] << 8) + (data[1] << 16);
45:     return `${amount} zen`;
46:   }
47: 
48:   const base = ITEM_NAMES.get(group * 512 + number) ?? `item ${group}/${number}`;
49:   const marks = [
50:     level > 0 ? `+${level}` : '',
51:     excellent ? 'exc' : '',
52:     luck ? 'luck' : '',
53:     skill ? 'skill' : '',
54:   ].filter(Boolean);
55: 
56:   return marks.length ? `${base} ${marks.join(' ')}` : base;
57: }
58: 
59: /** `ItemMoveRequest` storage kinds, as the inventory windows name them. */
60: const STORAGES: Readonly<Record<number, string>> = {
61:   0: 'inventory',
62:   2: 'vault',
63:   3: 'chaos machine',
64:   4: 'trade',
65:   5: 'store',
66:   7: 'pet trainer',
67:   8: 'refinery',
68:   9: 'smelting',
69:   10: 'item restore',
70:   11: 'chaos card',
71:   12: 'cherry blossom',
72:   13: 'seed crafting',
73:   14: 'seed sphere',
74:   15: 'seed apply',
75:   16: 'seed remove',
76: };
77: 
78: export function storageName(kind: number): string {
79:   return STORAGES[kind] ?? `storage ${kind}`;
80: }
</file>

