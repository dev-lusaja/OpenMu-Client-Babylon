 66: 
 67: /** Refusal causes as the log names them. */
 68: const REFUSE_NAMES: Record<number, string> = {
 69:   [RefuseCause.Cooldown]: 'cooldown',
 70:   [RefuseCause.Busy]: 'busy',
 71:   [RefuseCause.Full]: 'full',
 72:   [RefuseCause.Range]: 'out of range',
 73:   [RefuseCause.Map]: 'another map',
 74:   [RefuseCause.NotPerforming]: 'not performing',
 75:   [RefuseCause.Rate]: 'too fast',
