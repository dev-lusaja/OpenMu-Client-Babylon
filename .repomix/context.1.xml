  1: import { describe, expect, it } from 'vitest';
  2: import { TradeSession } from './trade';
  3: import type { BotConnection, Frame, FrameHandler, Match } from './connection';
  4: import {
  5:   TradeButtonStateChangedPacket,
  6:   TradeButtonStateChangedTradeButtonStateEnum,
  7:   TradeFinishedPacket,
  8:   TradeFinishedTradeResultEnum,
  9:   TradeItemAddedPacket,
 10:   TradeMoneyUpdatePacket,
 11:   TradeMoneySetResponsePacket,
 12:   TradeRequestAnswerPacket,
 13:   ItemMovedPacket,
 14:   ItemAddedToInventoryPacket,
 15: } from '../../src/common/packets/ServerToClientPackets';
 16: import { codeOf } from './wire';
 17: 
 18: /**
 19:  * The trade machine is the one part of the bot that can lose real property, so
 20:  * these test the invariant that matters: it never ticks its accept box unless
 21:  * what is on the table is what was agreed.
 22:  */
 23: class FakeConnection {
 24:   readonly sent: { code: number; sub: number }[] = [];
 25:   private readonly handlers: FrameHandler[] = [];
 26:   private readonly waiters: { match: Match; resolve: (f: Frame) => void }[] = [];
 27: 
 28:   send(buffer: DataView | Uint8Array): void {
 29:     const bytes =
 30:       buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer.buffer.slice(0));
 31:     this.sent.push(codeOf(bytes));
 32:   }
 33: 
 34:   on(handler: FrameHandler): () => void {
 35:     this.handlers.push(handler);
 36:     return () => {
 37:       const i = this.handlers.indexOf(handler);
 38:       if (i >= 0) this.handlers.splice(i, 1);
 39:     };
 40:   }
 41: 
 42:   expect(match: Match): Promise<Frame> {
 43:     return new Promise(resolve => this.waiters.push({ match, resolve }));
 44:   }
 45: 
 46:   /** Delivers a server frame to the session, as the socket would. */
 47:   deliver(packet: { buffer: DataView }): void {
 48:     const bytes = new Uint8Array(packet.buffer.buffer.slice(0));
 49:     const { code, sub } = codeOf(bytes);
 50:     const frame: Frame = { code, sub, bytes };
 51: 
 52:     for (let i = this.waiters.length - 1; i >= 0; i--) {
 53:       if (this.waiters[i].match.code !== code) continue;
 54:       this.waiters.splice(i, 1)[0].resolve(frame);
 55:     }
 56:     for (const handler of [...this.handlers]) handler(frame);
 57:   }
 58: 
 59:   asConnection(): BotConnection {
 60:     return this as unknown as BotConnection;
 61:   }
 62: }
 63: 
 64: const CONFIRM_CODE = 0x3c;
 65: /** Client-to-server cancel is 0x3D, which is also the server's TradeFinished. */
 66: const CANCEL_CODE = 0x3d;
 67: 
 68: function moneyUpdate(amount: number) {
 69:   const p = TradeMoneyUpdatePacket.createPacket();
 70:   p.writeHeader().writeLength();
 71:   p.MoneyAmount = amount;
 72:   return p;
 73: }
 74: 
 75: function itemAdded(slot: number, data?: Uint8Array) {
 76:   const p = TradeItemAddedPacket.createPacket(data ? 16 : 12);
 77:   p.writeHeader().writeLength();
 78:   p.ToSlot = slot;
 79:   if (data) p.setItemData(data, data.length);
 80:   return p;
 81: }
 82: 
 83: /** Twelve wire bytes: number in byte 0, level in byte 1, group in byte 5. */
 84: function wireItem(group: number, num: number, lvl = 0): Uint8Array {
 85:   const b = new Uint8Array(12);
 86:   b[0] = num;
 87:   b[1] = lvl << 3;
 88:   b[5] = group << 4;
 89:   return b;
 90: }
 91: 
 92: /** The server's answer to one of our own moves. */
 93: function itemMoved(targetSlot: number, storage: number) {
 94:   const p = ItemMovedPacket.createPacket(16);
 95:   p.writeHeader().writeLength();
 96:   p.TargetSlot = targetSlot;
 97:   p.TargetStorageType = storage;
 98:   return p;
 99: }
100: 
101: function itemReceived(inventorySlot: number) {
102:   const p = ItemAddedToInventoryPacket.createPacket(16);
103:   p.writeHeader().writeLength();
104:   p.InventorySlot = inventorySlot;
105:   return p;
106: }
107: 
108: /** The server's yes to our own money offer. */
109: function moneySet() {
110:   const p = TradeMoneySetResponsePacket.createPacket();
111:   p.writeHeader().writeLength();
112:   return p;
113: }
114: 
115: function finished(result: TradeFinishedTradeResultEnum) {
116:   const p = TradeFinishedPacket.createPacket();
117:   p.writeHeader().writeLength();
118:   p.Result = result;
119:   return p;
120: }
121: 
122: function opened() {
123:   const p = TradeRequestAnswerPacket.createPacket();
124:   p.writeHeader().writeLength();
125:   p.Accepted = true;
126:   p.setName('Buyer');
127:   return p;
128: }
129: 
130: function buttonState(state: TradeButtonStateChangedTradeButtonStateEnum) {
131:   const p = TradeButtonStateChangedPacket.createPacket();
132:   p.writeHeader().writeLength();
133:   p.State = state;
134:   return p;
135: }
136: 
137: function session(): { fake: FakeConnection; trade: TradeSession } {
138:   const fake = new FakeConnection();
139:   return { fake, trade: new TradeSession(fake.asConnection()) };
140: }
141: 
142: describe('TradeSession table tracking', () => {
143:   it('records the partner money and items put on the table', () => {
144:     const { fake, trade } = session();
145:     fake.deliver(moneyUpdate(74_000_000));
146:     fake.deliver(itemAdded(3));
147: 
148:     expect(trade.theirMoney).toBe(74_000_000);
149:     expect(trade.theirItems.size).toBe(1);
150:     expect(trade.theirItems.has(3)).toBe(true);
151:   });
152: 
153:   it('clears the partner accept mark whenever the offer changes', () => {
154:     const { fake, trade } = session();
155:     fake.deliver(buttonState(TradeButtonStateChangedTradeButtonStateEnum.Checked));
156:     expect(trade.theirConfirm).toBe(true);
157: 
158:     fake.deliver(moneyUpdate(1));
159:     expect(trade.theirConfirm).toBe(false);
160: 
161:     fake.deliver(buttonState(TradeButtonStateChangedTradeButtonStateEnum.Checked));
162:     fake.deliver(itemAdded(0));
163:     expect(trade.theirConfirm).toBe(false);
164:   });
165: });
166: 
167: describe('TradeSession.mismatch on which item', () => {
168:   const gloves = wireItem(10, 1, 7);
169:   const boots = wireItem(11, 1, 7);
170:   const isGloves = (data: Uint8Array) => data[5] === gloves[5] && data[0] === gloves[0] && data[1] === gloves[1];
171: 
172:   it('accepts the listed item', () => {
173:     const { fake, trade } = session();
174:     fake.deliver(itemAdded(0, gloves));
175:     expect(trade.mismatch({ expectItems: 1, expectMoney: 0, expectItemMatching: isGloves })).toBeNull();
176:   });
177: 
178:   it('refuses another item, and never ticks the box for it', async () => {
179:     const { fake, trade } = session();
180:     const opening = trade.requestWith(7);
181:     fake.deliver(opened());
182:     await opening;
183:     fake.deliver(itemAdded(0, boots));
184: 
185:     expect(trade.mismatch({ expectItems: 1, expectMoney: 0, expectItemMatching: isGloves })).toMatch(
186:       /not the one listed/
187:     );
188:     const refused = trade.armConfirm({ expectItems: 1, expectMoney: 0, expectItemMatching: isGloves });
189:     expect(refused).toMatch(/not the one listed/);
190:     expect(fake.sent.some(s => s.code === CONFIRM_CODE)).toBe(false);
191:     expect(fake.sent.some(s => s.code === CANCEL_CODE)).toBe(true);
192:   });
193: 
194:   it('is satisfied once the seller swaps in the right one', async () => {
195:     const { fake, trade } = session();
196:     const opening = trade.requestWith(7);
197:     fake.deliver(opened());
198:     await opening;
199:     fake.deliver(itemAdded(0, boots));
200:     const waiting = trade.waitForTerms({ expectItems: 1, expectMoney: 0, expectItemMatching: isGloves }, 2000);
201:     // The table is replaced, not appended to: the server re-sends the slot.
202:     trade.theirItems.clear();
203:     fake.deliver(itemAdded(0, gloves));
204:     await expect(waiting).resolves.toBeUndefined();
205:   });
206: });
207: 
208: describe('a request nobody answered', () => {
209:   it('is withdrawn with the server\'s cancel, so the partner is not left waiting', () => {
210:     const { fake, trade } = session();
211:     void trade.requestWith(7).catch(() => {});
212:     expect(fake.sent.some(s => s.code === CANCEL_CODE)).toBe(false);
213: 
214:     // Nothing came back. A plain cancel would do nothing, since no trade opened.
215:     trade.cancel();
216:     expect(fake.sent.some(s => s.code === CANCEL_CODE)).toBe(false);
217: 
218:     trade.abandonRequest();
219:     expect(fake.sent.some(s => s.code === CANCEL_CODE)).toBe(true);
220:     expect(trade.isOpen).toBe(false);
221:   });
222: });
223: 
224: describe('an item that arrives with the answer', () => {
225:   it('is kept: the table is cleared when the request goes out, not when it is answered', async () => {
226:     const { fake, trade } = session();
227:     fake.deliver(itemAdded(0)); // a stale entry from some earlier trade
228:     const opening = trade.requestWith(7);
229:     expect(trade.theirItems.size).toBe(0);
230:     // The answer and the partner's item in one chunk: the item is recorded
231:     // before the answer's continuation runs.
232:     fake.deliver(opened());
233:     fake.deliver(itemAdded(3));
234:     await opening;
235:     expect(trade.theirItems.has(3)).toBe(true);
236:   });
237: });
238: 
239: describe('TradeSession.mismatch on our own Zen', () => {
240:   it('does not count Zen the server never acknowledged', async () => {
241:     const { fake, trade } = session();
242:     const opening = trade.requestWith(7);
243:     fake.deliver(opened());
244:     await opening;
245: 
246:     trade.setMoney(5000);
247:     expect(trade.mismatch({ expectOwnMoney: 5000 })).toMatch(/expected 5000 of our Zen/);
248:     // A bot without the Zen gets silence, and a confirm now would close a
249:     // trade with nothing on it.
250:     expect(trade.armConfirm({ expectOwnMoney: 5000 })).toMatch(/our Zen/);
251:     expect(fake.sent.some(s => s.code === CONFIRM_CODE)).toBe(false);
252:   });
253: 
254:   it('counts it once the server says it took the offer', async () => {
255:     const { fake, trade } = session();
256:     const opening = trade.requestWith(7);
257:     fake.deliver(opened());
258:     await opening;
259: 
260:     trade.setMoney(5000);
261:     fake.deliver(moneySet());
262:     expect(trade.myMoney).toBe(5000);
263:     expect(trade.mismatch({ expectOwnMoney: 5000 })).toBeNull();
264:   });
265: });
266: 
267: describe('TradeSession.mismatch', () => {
268:   it('accepts a table that matches the terms', () => {
269:     const { fake, trade } = session();
270:     fake.deliver(moneyUpdate(500));
271:     fake.deliver(itemAdded(0));
272:     expect(trade.mismatch({ expectMoney: 500, expectItems: 1 })).toBeNull();
273:   });
274: 
275:   it('names the wrong amount of money', () => {
276:     const { fake, trade } = session();
277:     fake.deliver(moneyUpdate(499));
278:     expect(trade.mismatch({ expectMoney: 500 })).toMatch(/expected 500 Zen.*found 499/);
279:   });
280: 
281:   it('names the wrong number of items', () => {
282:     const { fake, trade } = session();
283:     fake.deliver(itemAdded(0));
284:     fake.deliver(itemAdded(1));
285:     expect(trade.mismatch({ expectItems: 1 })).toMatch(/expected 1 item\(s\).*found 2/);
286:   });
287: 
288:   it('treats an empty table as a mismatch when something was expected', () => {
289:     const { trade } = session();
290:     expect(trade.mismatch({ expectMoney: 10 })).not.toBeNull();
291:     expect(trade.mismatch({ expectItems: 1 })).not.toBeNull();
292:   });
293: });
294: 
295: describe('TradeSession.settle', () => {
296:   it('cancels instead of confirming when the table does not match', async () => {
297:     const { fake, trade } = session();
298:     const accepted = trade.accept();
299:     fake.deliver(opened());
300:     await accepted;
301:     fake.deliver(moneyUpdate(10));
302: 
303:     const outcome = await trade.settle({ expectMoney: 74_000_000 });
304: 
305:     expect(outcome.ok).toBe(false);
306:     expect(fake.sent.some(s => s.code === CONFIRM_CODE)).toBe(false);
307:     expect(fake.sent.some(s => s.code === CANCEL_CODE)).toBe(true);
308:   });
309: 
310:   it('confirms and reports success when the table matches', async () => {
311:     const { fake, trade } = session();
312:     const accepted = trade.accept();
313:     fake.deliver(opened());
314:     await accepted;
315: 
316:     fake.deliver(moneyUpdate(500));
317: 
318:     const settled = trade.settle({ expectMoney: 500 });
319:     // The confirm goes out before the server rules on it.
320:     expect(fake.sent.some(s => s.code === CONFIRM_CODE)).toBe(true);
321: 
322:     fake.deliver(finished(TradeFinishedTradeResultEnum.Success));
323:     expect(await settled).toEqual({ ok: true });
324:   });
325: 
326:   it('reports the server reason when the trade fails', async () => {
327:     const { fake, trade } = session();
328:     const accepted = trade.accept();
329:     fake.deliver(opened());
330:     await accepted;
331:     fake.deliver(moneyUpdate(500));
332: 
333:     const settled = trade.settle({ expectMoney: 500 });
334:     fake.deliver(finished(TradeFinishedTradeResultEnum.FailedByFullInventory));
335: 
336:     const outcome = await settled;
337:     expect(outcome.ok).toBe(false);
338:     expect(outcome).toMatchObject({ reason: 'FailedByFullInventory' });
339:   });
340: 
341:   it('closes the session when the server finishes the trade', async () => {
342:     const { fake, trade } = session();
343:     const accepted = trade.accept();
344:     fake.deliver(opened());
345:     await accepted;
346:     expect(trade.isOpen).toBe(true);
347: 
348:     fake.deliver(finished(TradeFinishedTradeResultEnum.Cancelled));
349:     expect(trade.isOpen).toBe(false);
350:   });
351: });
352: 
353: /**
354:  * The bot's own half of the table.
355:  *
356:  * Everything else here reads what the partner has offered. Nothing read what
357:  * *we* had offered, and an item move the server refuses is silent - so a
358:  * delivery whose item never left the bag asked the buyer for money anyway,
359:  * and would have taken it.
360:  */
361: describe('TradeSession, its own side', () => {
362:   const TRADE = 1;
363:   const INVENTORY = 0;
364: 
365:   it('counts an item the server confirmed onto the table', () => {
366:     const { fake, trade } = session();
367:     fake.deliver(itemMoved(0, TRADE));
368: 
369:     expect(trade.myItems.size).toBe(1);
370:     expect(trade.mismatch({ expectOwnItems: 1 })).toBeNull();
371:   });
372: 
373:   it('refuses terms when our item never made it', () => {
374:     const { fake, trade } = session();
375:     fake.deliver(moneyUpdate(50));
376: 
377:     // The buyer has paid and we are giving nothing. This is the case that
378:     // must never confirm.
379:     expect(trade.mismatch({ expectMoney: 50, expectOwnItems: 1 })).toBe(
380:       'expected 1 of our item(s) on the table, found 0'
381:     );
382:   });
383: 
384:   it('cancels rather than confirm a table we are not on', async () => {
385:     const { fake, trade } = session();
386:     const accepted = trade.accept();
387:     fake.deliver(opened());
388:     await accepted;
389:     fake.deliver(moneyUpdate(50));
390: 
391:     // The buyer has paid for an item that never left the bag. Confirming
392:     // here would complete the trade and take the money for nothing.
393:     expect(trade.armConfirm({ expectMoney: 50, expectOwnItems: 1 })).not.toBeNull();
394:     expect(fake.sent.some(s => s.code === CONFIRM_CODE)).toBe(false);
395:     expect(fake.sent.some(s => s.code === CANCEL_CODE)).toBe(true);
396:   });
397: 
398:   it('drops an item taken back off the table', () => {
399:     const { fake, trade } = session();
400:     fake.deliver(itemMoved(0, TRADE));
401:     fake.deliver(itemMoved(0, INVENTORY));
402: 
403:     expect(trade.myItems.size).toBe(0);
404:   });
405: 
406:   it('records where the server put an item it gave us', () => {
407:     const { fake, trade } = session();
408:     fake.deliver(itemReceived(19));
409: 
410:     expect(trade.receivedSlots).toEqual([19]);
411:   });
412: });
</file>

<file path="marketplace/bot/trade.ts">
  1: import {
  2:   ItemMoveRequestPacket,
  3:   SetTradeMoneyPacket,
  4:   TradeButtonStateChangePacket,
  5:   TradeButtonStateEnum,
  6:   TradeCancelPacket,
  7:   TradeRequestPacket,
  8:   TradeRequestResponsePacket,
  9: } from '../../src/common/packets/ClientToServerPackets';
 10: import {
 11:   TradeButtonStateChangedPacket,
 12:   TradeButtonStateChangedTradeButtonStateEnum,
 13:   TradeFinishedPacket,
 14:   TradeFinishedTradeResultEnum,
 15:   TradeItemAddedPacket,
 16:   TradeMoneyUpdatePacket,
 17:   TradeRequestAnswerPacket,
 18:   TradeRequestPacket as IncomingTradeRequestPacket,
 19:   ItemMovedPacket,
 20:   ItemAddedToInventoryPacket,
 21: } from '../../src/common/packets/ServerToClientPackets';
 22: import { StorageKind } from '../../src/common/storageKind';
 23: import type { BotConnection, Frame } from './connection';
 24: import { view } from './session';
 25: 
 26: /**
 27:  * The bot's half of an in-game trade.
 28:  *
 29:  * The game server owns the exchange: it validates both sides and moves the
 30:  * goods atomically, so the worst a bug here can do is fail a trade, never
 31:  * duplicate an item or take payment without delivering. That property is why
 32:  * the marketplace hands everything over this way instead of writing to the
 33:  * database, and it is worth not undermining: this class never confirms
 34:  * without first checking that what is on the table is what was agreed.
 35:  */
