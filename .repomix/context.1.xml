 37: const CODE = {
 38:   request: { code: 0x36 },
 39:   answer: { code: 0x37 },
 40:   itemAdded: { code: 0x39 },
 41:   moneyUpdate: { code: 0x3b },
 42:   buttonState: { code: 0x3c },
 43:   finished: { code: 0x3d },
 44:   /** The server took the Zen we asked to put up. Silence means it did not. */
 45:   moneySet: { code: 0x3a },
 46:   /** Our own item move landed; `TargetStorageType` says where. */
