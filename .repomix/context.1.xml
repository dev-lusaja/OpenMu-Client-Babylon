210: function openJournal(): { journal: Journal; where: string } {
211:   if (TRACK_DB_PATH === "memory") return { journal: new MemoryJournal(), where: "in memory" };
212:   try {
213:     return { journal: new SqliteJournal(TRACK_DB_PATH, TRACK_RETAIN_DAYS), where: TRACK_DB_PATH };
214:   } catch (error) {
215:     console.error(`track: cannot open the journal at ${TRACK_DB_PATH}, keeping it in memory:`, error);
216:     return { journal: new MemoryJournal(), where: "in memory (fallback)" };
217:   }
218: }
