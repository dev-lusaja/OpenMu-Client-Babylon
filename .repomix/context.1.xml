699:   private onServerMessage(p: ServerMessagePacket): void {
700:     const text = cleanName(p.Message);
701:     if (!text) return;
702:     this.emit('server', text, { type: p.Type });
703:   }
704: 
705:   private onTradeAnswer(p: TradeRequestAnswerPacket): void {
706:     const partner = cleanName(p.Name);
707:     this.emit(
708:       'trade',
709:       p.Accepted ? `${partner} accepted the trade` : `${partner} declined the trade`,
710:       { partner, accepted: !!p.Accepted }
711:     );
712:   }
713: 
714:   private onGuildMembers(p: AssignCharacterToGuildPacket): void {
715:     for (const member of p.getMembers()) {
716:       if ((member.PlayerId & ID_MASK) !== this.objectId) continue;
717:       this.guildId = member.GuildId;
718:       const name = this.guildNames.get(member.GuildId) ?? null;
719:       if (name !== this.guild) {
720:         this.guild = name;
721:         this.sink.change(this);
722:       }
723:     }
724:   }
725: 
726:   private onGuildInformation(p: GuildInformationPacket): void {
727:     const name = cleanName(p.GuildName);
728:     this.guildNames.set(p.GuildId, name);
729:     if (p.GuildId === this.guildId && name !== this.guild) {
730:       this.guild = name;
731:       this.sink.change(this);
732:     }
733:   }
