276:         }
277:       }
278:     }
279:   }
280: 
281:   stats(): BandStats {
282:     let members = 0;
283:     for (const perf of this.performers.values()) members += perf.members.size;
284:     return { ...this.counters, dropped: { ...this.counters.dropped }, stopped: { ...this.counters.stopped }, performers: this.performers.size, members };
285:   }
286: 
287:   /* ------------------------------------------------------------- decoding */
288: 
289:   private decode(state: PeerState, wire: Uint8Array): { message: BandClientMessage; plain: Uint8Array } | null {
290:     const order: Key[] = state.key === 'pre' ? ['pre', 's6'] : ['s6', 'pre'];
291:     for (const key of order) {
292:       const plain = wire.slice();
293:       (key === 's6' ? this.s6 : this.pre).Decrypt(plain);
294:       const message = decodeClientFrame(plain);
295:       if (message) {
296:         state.key = key;
297:         return { message, plain };
298:       }
299:     }
300:     return null;
301:   }
302: 
303:   private strike(state: PeerState, now: number, why: 'malformed' | 'rate'): void {
304:     this.counters.dropped[why]++;
305:     if (state.strikes.add(now) > BAND_LIMITS.maxStrikes && state.performing) {
306:       this.endPerformance(state.performing, StopReason.Flood);
307:     }
308:   }
309: 
310:   /* ------------------------------------------------------------ performing */
311: 
312:   private refuse(state: PeerState, what: number, cause: number, arg = 0): void {
313:     this.counters.refused++;
314:     const id = state.peer.track.objectId ?? 0;
315:     this.log(`band: #${id} refused (${what === RefuseWhat.Start ? 'start' : 'join'}, ${REFUSE_NAMES[cause] ?? cause})`);
316:     this.trySend(state, encodeRefused(id, what, cause, arg), this.now());
317:   }
318: 
319:   /**
320:    * `start` is "instrument out": the pose and the model everyone sees. A
321:    * performer sending it again has switched instruments, so the old
322:    * performance ends quietly for them (the receivers get the stop and the
323:    * new start); a band member may hold an instrument too, that is how they
324:    * are seen playing.
325:    */
326:   private onStart(state: PeerState, message: Extract<BandClientMessage, { sub: 1 }>, plain: Uint8Array, now: number): void {
327:     const track = state.peer.track;
328:     if (message.version !== BAND_VERSION) {
329:       this.strike(state, now, 'malformed');
330:       return;
331:     }
332:     const previous = state.performing;
333:     if (!previous && now < state.cooldownUntil) {
334:       this.refuse(state, RefuseWhat.Start, RefuseCause.Cooldown, Math.min(255, Math.ceil((state.cooldownUntil - now) / 1000)));
335:       return;
336:     }
337:     if (!previous) {
338:       if (this.performers.size >= this.maxPerformers) {
339:         this.refuse(state, RefuseWhat.Start, RefuseCause.Full);
340:         return;
341:       }
342:       let onMap = 0;
343:       for (const perf of this.performers.values()) if (perf.map === track.map) onMap++;
