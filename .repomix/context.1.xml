435:   claimQueued.run(Date.now(), id);
436:   return changed() ? orderById(id) : null;
437: }
438: 
439: /**
440:  * The worker's verdict on an order it claimed: `delivered` with the id of the
441:  * item row it inserted, `failed` with why, or back to `queued` for the one
442:  * failure that is nobody's fault - no room in the bag - because a gacha roll
443:  * is committed at placement and a player whose roll was voided for space would
444:  * rightly be furious. Only a `delivering` order can be settled, and only by
445:  * a worker that knows what happened: an order whose transaction may or may
446:  * not have committed is not settled at all (`explainDelivering`).
447:  */
448: export function settle(
449:   id: string,
450:   state: 'delivered' | 'failed' | 'queued',
451:   reason: string | null,
452:   itemId: string | null = null
453: ): Order | null {
454:   const now = Date.now();
455: 
456:   settleDelivering.run(state, reason, itemId, now, state === 'delivered' ? now : null, id);
457: 
458:   if (!changed()) return null;
459: 
460:   const order = orderById(id);
461: 
462:   audit(`settled ${state}`, { orderId: id, detail: { reason, itemId } });
