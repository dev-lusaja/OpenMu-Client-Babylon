 880:   /**
 881:    * The wallet as the database has it: the delivery character's bag plus the
 882:    * vault (`deliveryCharacter` says why that character and no other), which
 883:    * is the placement route's bound. Null when the account is unknown or the
 884:    * schema is not resolved yet, which the route should treat as "cannot
 885:    * accept orders", never as zero.
 886:    */
 887:   async wallet(loginName: string): Promise<{ chaos: number } | null> {
 888:     try {
 889:       const resolved = await this.resolveOnce();
 890:       const account = await this.gate.findAccount(loginName);
 891: 
 892:       if (!account) return null;
 893: 
 894:       const character = await deliveryCharacter(this.sql, resolved, account.id);
 895:       const jewels = await chaosRows(
 896:         this.sql,
 897:         resolved,
 898:         character?.inventoryId ?? null,
 899:         account.vaultId,
 900:         false
 901:       );
 902: 
 903:       return { chaos: jewels.length };
 904:     } catch (error) {
 905:       console.error(`wallet read for ${loginName} failed:`, error);
 906:       return null;
 907:     }
 908:   }
