 48: function makePeer(id: number, opts: { map?: number; x?: number; y?: number; sees?: number[]; world?: boolean } = {}): Fake {
 49:   const { map = 2, x = 100, y = 100, sees = [], world = true } = opts;
 50:   const session = new TrackedSession(`n${id}`, 55901, { event() {}, change() {}, move() {} }, { now });
 51:   const wire = new WireEncoder();
 52:   if (world) {
 53:     session.feedServer(wire.server(gameServerEntered(id)));
 54:     session.setAccount(`acc${id}`);
 55:     session.feedServer(wire.server(characterList([{ name: `P${id}`, cls: 7, level: 1, status: 0 }])));
 56:     session.feedClient(wire.client(selectCharacter(`P${id}`)));
 57:     session.feedServer(wire.server(characterInformation({ x, y, map, money: 0, status: 0, hp: 1, maxHp: 1 })));
 58:     if (sees.length) session.feedServer(wire.server(playersInScope(sees.map(s => ({ id: s, x, y, name: `P${s}` })))));
 59:   }
 60:   const sent: BandRelayMessage[] = [];
 61:   const raw: Uint8Array[] = [];
 62:   const status = { value: 1 };
 63:   const peer: BandPeer = {
 64:     track: session,
 65:     send: f => {
 66:       raw.push(f);
 67:       const m = decodeRelayFrame(f);
 68:       if (m) sent.push(m);
 69:       return status.value;
 70:     },
 71:   };
 72:   return { peer, session, sent, raw, status };
 73: }
