  1: import { describe, expect, it } from 'vitest';
  2: import type { TrackEvent } from '../../src/common/adminProtocol';
  3: import { TrackedSession, type SessionOptions } from './session';
  4: import { WireEncoder } from './wire';
  5: import {
  6:   characterInformation,
  7:   characterList,
  8:   chat,
  9:   experience,
 10:   gameServerEntered,
 11:   hit,
 12:   itemAdded,
 13:   itemBytes,
