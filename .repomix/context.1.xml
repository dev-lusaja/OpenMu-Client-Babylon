  1: import net from 'node:net';
  2: import type { Sql } from 'postgres';
  3: 
  4: /**
  5:  * The safety gate: may the shop write to this account right now?
  6:  *
  7:  * OpenMU holds a logged-in account in a private EF Core context and writes it
  8:  * back on save, so its database is never the live state. Writing to an account
  9:  * the game server has in memory either dupes the jewels the write spends (they
 10:  * were already spent in game, unsaved) or corrupts an inventory slot the player
 11:  * meanwhile filled.
 12:  *
 13:  * Nothing in the database says who is playing - `LoginServer.cs` is a plain
 14:  * in-memory dictionary - so the gate asks four independent questions and lets
 15:  * any one of them refuse. They are chosen to cover each other's blind spots:
 16:  *
 17:  *   presence      sockets, including a player sitting at character select
 18:  *                 (who is never periodically saved). Blind to offline players
 19:  *                 and to anyone bypassing the proxy.
 20:  *   writeRecency  anything in-world, because `PeriodicSaveProgressPlugIn`
 21:  *                 saves every in-world player once a minute. This is what
 22:  *                 catches OpenMU's offline levelling, which has no socket at
 23:  *                 all. Blind to a live account that changes nothing.
 24:  *   personalStore a character parked with a store open - the idle-but-live
 25:  *                 case the other two miss.
 26:  *   portProbe     whether the game port is reachable from outside. Presence is
 27:  *                 only authoritative while the proxy is the only way in, so
 28:  *                 that gets verified rather than assumed.
 29:  *
 30:  * Every signal fails closed. An error, an unreachable service and a missing
 31:  * configuration all read as "refuse", never as "safe". The one reading that
 32:  * looks like an exception - the port probe's timeout - is argued at `tcpProbe`.
 33:  */
 34: 
 35: export type SignalName = 'presence' | 'writeRecency' | 'personalStore' | 'portProbe';
 36: 
 37: export interface SignalResult {
 38:   name: SignalName;
 39:   safe: boolean;
 40:   /** Always populated, including when safe, so the audit log records what was seen. */
 41:   reason: string;
 42:   detail?: Record<string, unknown>;
 43: }
 44: 
 45: export interface GateVerdict {
 46:   account: string;
 47:   safe: boolean;
 48:   /** Why not. Empty when safe. */
 49:   refusals: string[];
 50:   signals: SignalResult[];
 51:   checkedAt: number;
 52: }
 53: 
 54: export interface GateConfig {
 55:   presenceUrl: string;
 56:   /** How long after the last socket closed before a write is allowed. */
 57:   offlineCooldownMs: number;
 58:   /** `PeriodicSaveProgressPlugIn`'s interval. Its default is one minute. */
 59:   saveIntervalMs: number;
 60:   /** Margin on top of two save intervals before recent writes stop counting. */
 61:   recencyMarginMs: number;
 62:   /** The public address of the game server, as a player's .exe would dial it. */
 63:   gameHost: string | null;
 64:   gamePort: number | null;
 65:   probeTimeoutMs: number;
 66:   probeCacheMs: number;
 67:   requestTimeoutMs: number;
 68: }
 69: 
 70: export function loadGateConfig(env: Record<string, string | undefined> = process.env): GateConfig {
 71:   const port = Number(env.GAME_PROBE_PORT ?? 0);
 72: 
 73:   return {
 74:     presenceUrl: env.PRESENCE_URL ?? 'http://127.0.0.1:3001',
 75:     offlineCooldownMs: Number(env.OFFLINE_COOLDOWN_MS ?? 60_000),
 76:     saveIntervalMs: Number(env.SAVE_INTERVAL_MS ?? 60_000),
 77:     recencyMarginMs: Number(env.RECENCY_MARGIN_MS ?? 60_000),
 78:     gameHost: env.GAME_PROBE_HOST ?? null,
 79:     gamePort: port > 0 && port <= 65535 ? port : null,
 80:     probeTimeoutMs: Number(env.GAME_PROBE_TIMEOUT_MS ?? 3_000),
 81:     probeCacheMs: Number(env.GAME_PROBE_CACHE_MS ?? 60_000),
 82:     requestTimeoutMs: Number(env.GATE_REQUEST_TIMEOUT_MS ?? 5_000),
 83:   };
 84: }
 85: 
 86: /* ------------------------------------------------------------------- schema */
 87: 
 88: /**
 89:  * OpenMU's tables are generated by EF Core, so the column names are convention
 90:  * rather than something this repo can read off a model. Two are confirmed
 91:  * (`Item."DefinitionId"` in `Item.Generated.cs`, `Account."VaultId"` by the
 92:  * register service's INSERT); the rest follow the same `<Navigation>Id` rule,
 93:  * and the many-to-many join between an item definition and its option
 94:  * definitions follows EF's `<Owner><Target>` rule, which is why that one
 95:  * carries alternatives.
 96:  *
 97:  * Rather than hardcode the guess, the gate resolves them from
 98:  * `information_schema` on first use and says exactly what is missing when the
 99:  * database disagrees - which is far easier to act on than a syntax error deep
100:  * inside a query.
101:  *
102:  * Every table the shop will ever name is listed here, the fulfilment
103:  * transaction's included, although the gate itself reads only the first
104:  * three. One registry and one resolver means `bun run cashshop-gate --schema`
105:  * shows exactly what the worker will use, and there is no second identifier
106:  * whitelist to relax by accident.
107:  */
108: export interface TableSpec {
109:   schema: string;
110:   /** One name, or candidates best first. */
111:   table: string | string[];
112:   /** logical name -> the column names that would satisfy it, best first. */
113:   columns: Record<string, string[]>;
114: }
115: 
116: const TABLES = {
117:   account: {
118:     schema: 'data',
119:     table: 'Account',
120:     columns: {
121:       id: ['Id'],
122:       loginName: ['LoginName'],
123:       state: ['State'],
124:       vault: ['VaultId'],
125:     },
126:   },
127:   character: {
128:     schema: 'data',
129:     table: 'Character',
130:     columns: {
131:       id: ['Id'],
132:       name: ['Name'],
133:       account: ['AccountId'],
134:       inventory: ['InventoryId'],
135:       slot: ['CharacterSlot'],
136:       storeOpened: ['IsStoreOpened'],
137:       inventoryExtensions: ['InventoryExtensions'],
138:     },
139:   },
140:   item: {
141:     schema: 'data',
142:     table: 'Item',
143:     columns: {
144:       id: ['Id'],
145:       storage: ['ItemStorageId'],
146:       definition: ['DefinitionId'],
147:       slot: ['ItemSlot'],
148:       durability: ['Durability'],
149:       level: ['Level'],
150:       hasSkill: ['HasSkill'],
151:       socketCount: ['SocketCount'],
152:       petExperience: ['PetExperience'],
153:     },
154:   },
155:   itemOptionLink: {
156:     schema: 'data',
157:     table: 'ItemOptionLink',
158:     columns: {
159:       id: ['Id'],
160:       item: ['ItemId'],
161:       option: ['ItemOptionId'],
162:       level: ['Level'],
163:       index: ['Index'],
164:     },
165:   },
166:   itemDefinition: {
167:     schema: 'config',
168:     table: 'ItemDefinition',
169:     columns: {
170:       id: ['Id'],
171:       configuration: ['GameConfigurationId'],
172:       group: ['Group'],
173:       number: ['Number'],
174:       name: ['Name'],
175:       width: ['Width'],
176:       height: ['Height'],
177:       durability: ['Durability'],
178:       maximumLevel: ['MaximumItemLevel'],
179:     },
180:   },
181:   /** `ItemDefinition.PossibleItemOptions`, a many-to-many. */
182:   definitionOptions: {
183:     schema: 'config',
184:     table: ['ItemDefinitionItemOptionDefinition', 'ItemOptionDefinitionItemDefinition'],
185:     columns: {
186:       definition: ['ItemDefinitionId'],
187:       optionDefinition: ['ItemOptionDefinitionId', 'PossibleItemOptionsId'],
188:     },
189:   },
190:   /** `ItemOptionDefinition.PossibleOptions`, one-to-many, so the option carries the key. */
191:   increasableOption: {
192:     schema: 'config',
193:     table: 'IncreasableItemOption',
194:     columns: {
195:       id: ['Id'],
196:       number: ['Number'],
197:       type: ['OptionTypeId'],
198:       optionDefinition: ['ItemOptionDefinitionId'],
199:     },
200:   },
201:   itemOptionType: {
202:     schema: 'config',
203:     table: 'ItemOptionType',
204:     columns: { id: ['Id'], name: ['Name'] },
205:   },
206:   gameConfiguration: {
207:     schema: 'config',
208:     table: 'GameConfiguration',
209:     columns: { id: ['Id'] },
210:   },
211:   gameServerDefinition: {
212:     schema: 'config',
213:     table: 'GameServerDefinition',
214:     columns: { id: ['Id'], configuration: ['GameConfigurationId'] },
215:   },
216: } satisfies Record<string, TableSpec>;
217: 
218: export type TableName = keyof typeof TABLES;
219: 
220: type Columns<K extends TableName> = Record<keyof (typeof TABLES)[K]['columns'], string>;
221: 
222: export interface ResolvedTable<K extends TableName = TableName> {
223:   schema: string;
224:   table: string;
225:   /** Ready to interpolate: `"schema"."Table"`. */
226:   ref: string;
227:   /** logical name -> the column as the database names it, for printing. */
228:   columns: Columns<K>;
229:   /** logical name -> that column quoted, ready to interpolate. */
230:   col: Columns<K>;
231:   /** NOT NULL columns with no default: everything an INSERT must supply. */
232:   required: Set<string>;
233: }
234: 
235: export type ResolvedSchema = { [K in TableName]: ResolvedTable<K> };
236: 
237: /** Identifiers are interpolated into SQL, so nothing exotic may pass. */
238: const IDENTIFIER_RE = /^[A-Za-z][A-Za-z0-9_]*$/;
239: 
240: export function quote(name: string): string {
241:   if (!IDENTIFIER_RE.test(name)) {
242:     throw new Error(`refusing to use "${name}" as a SQL identifier`);
243:   }
244:   return `"${name}"`;
245: }
246: 
247: interface ColumnRow {
248:   table_schema: string;
249:   table_name: string;
250:   column_name: string;
251:   is_nullable: 'YES' | 'NO';
252:   column_default: string | null;
253: }
254: 
255: function candidatesOf(spec: TableSpec): string[] {
256:   return Array.isArray(spec.table) ? spec.table : [spec.table];
257: }
258: 
259: export async function resolveSchema(sql: Sql): Promise<ResolvedSchema> {
260:   const specs = Object.values(TABLES) as TableSpec[];
261:   const schemas = [...new Set(specs.map(spec => spec.schema))];
262:   const tables = [...new Set(specs.flatMap(candidatesOf))];
263: 
264:   /**
265:    * Two ordinary array parameters, not a row-constructor `IN` over pairs.
266:    *
267:    * postgres.js renders an array of pairs as `($1,$2),($3,$4)` - the shape an
268:    * INSERT's VALUES wants - and `IN` needs one more pair of parentheses around
269:    * that. The pair form is therefore a syntax error the moment it reaches
270:    * Postgres, and nothing before that point can catch it: it type-checks, and
271:    * the fragment is only assembled inside the driver. This resolver runs once
272:    * at boot and is the first thing that talks to OpenMU, so it took the whole
273:    * shop down with it.
274:    *
275:    * The cost of asking this way is that a table name that also exists in the
276:    * other schema comes back too. Every consumer keys on `schema.table`, so
277:    * those rows are read by nobody. `::text` because these columns are
278:    * `information_schema.sql_identifier`, a domain over `name`, and comparing
279:    * one to a text array should not depend on an implicit cast.
280:    */
281:   const rows = await sql<ColumnRow[]>`
282:     SELECT table_schema, table_name, column_name, is_nullable, column_default
283:     FROM information_schema.columns
284:     WHERE table_schema::text = ANY(${schemas}) AND table_name::text = ANY(${tables})
285:   `;
286: 
287:   const present = new Map<string, ColumnRow[]>();
288:   for (const row of rows) {
289:     const key = `${row.table_schema}.${row.table_name}`;
290:     present.set(key, [...(present.get(key) ?? []), row]);
291:   }
292: 
293:   const resolved: Partial<Record<TableName, ResolvedTable>> = {};
294:   const missing: string[] = [];
295: 
296:   for (const [logicalTable, spec] of Object.entries(TABLES) as [TableName, TableSpec][]) {
297:     const candidates = candidatesOf(spec);
298:     const table = candidates.find(candidate => present.has(`${spec.schema}.${candidate}`));
299: 
300:     if (!table) {
301:       missing.push(`no table ${spec.schema}.${candidates.join(' or ')}`);
302:       continue;
303:     }
304: 
305:     const key = `${spec.schema}.${table}`;
306:     const columns = present.get(key) ?? [];
307:     const names = new Set(columns.map(column => column.column_name));
308:     const picked: Record<string, string> = {};
309:     const col: Record<string, string> = {};
310: 
311:     for (const [logicalColumn, options] of Object.entries(spec.columns)) {
312:       const found = options.find(candidate => names.has(candidate));
313: 
314:       if (found) {
315:         picked[logicalColumn] = found;
316:         col[logicalColumn] = quote(found);
317:       } else {
318:         missing.push(
319:           `${key} has no column for ${logicalColumn} (looked for ${options.join(', ')}; ` +
320:             `it has ${[...names].sort().join(', ')})`
321:         );
322:       }
323:     }
324: 
325:     resolved[logicalTable] = {
326:       schema: spec.schema,
327:       table,
328:       ref: `${quote(spec.schema)}.${quote(table)}`,
329:       columns: picked,
330:       col,
331:       required: new Set(
332:         columns
333:           .filter(column => column.is_nullable === 'NO' && column.column_default === null)
334:           .map(column => column.column_name)
335:       ),
336:     };
337:   }
338: 
339:   if (missing.length) {
340:     throw new Error(`OpenMU schema does not look as expected:\n  ${missing.join('\n  ')}`);
341:   }
342: 
343:   return resolved as ResolvedSchema;
344: }
345: 
346: /* -------------------------------------------------------------------- gate */
347: 
348: export interface AccountRow {
349:   id: string;
350:   loginName: string;
351:   state: number;
352:   vaultId: string | null;
353: }
354: 
355: interface PresenceAnswer {
356:   online: boolean;
357:   connections: number;
358:   lastSeenAt: number | null;
359:   startedAt: number;
360:   now: number;
361:   unidentifiedConnections: number;
362: }
363: 
364: interface RecencySample {
365:   fingerprint: string;
366:   takenAt: number;
367: }
368: 
369: export class SafetyGate {
370:   private schema: ResolvedSchema | null = null;
371:   private probe: { at: number; outcome: ProbeOutcome; detail: string } | null = null;
372:   /** Only used when `track_commit_timestamp` is off. account id -> last sample. */
373:   private readonly samples = new Map<string, RecencySample>();
374:   private commitTimestamps: boolean | null = null;
375: 
376:   constructor(
377:     private readonly sql: Sql,
378:     private readonly config: GateConfig = loadGateConfig()
379:   ) {}
380: 
381:   /** How long a write must be absent before it stops meaning "someone is playing". */
382:   private get recencyWindowMs(): number {
383:     return this.config.saveIntervalMs * 2 + this.config.recencyMarginMs;
384:   }
385: 
386:   async schemaOnce(): Promise<ResolvedSchema> {
387:     return (this.schema ??= await resolveSchema(this.sql));
388:   }
389: 
390:   async findAccount(loginName: string): Promise<AccountRow | null> {
391:     const a = (await this.schemaOnce()).account;
392:     const rows = await this.sql.unsafe<AccountRow[]>(
393:       `SELECT ${a.col.id} AS id, ${a.col.loginName} AS "loginName",
394:               ${a.col.state} AS state, ${a.col.vault} AS "vaultId"
395:          FROM ${a.ref}
396:         WHERE lower(${a.col.loginName}) = lower($1)
397:         LIMIT 1`,
398:       [loginName]
399:     );
400: 
401:     return rows[0] ?? null;
402:   }
403: 
404:   /**
405:    * The verdict for one account. Signals run together - three of the four are
406:    * independent - and every one of them is reported, safe or not, so the audit
407:    * log can record the whole picture rather than the first refusal.
408:    */
409:   async check(loginName: string): Promise<GateVerdict> {
410:     const checkedAt = Date.now();
411: 
412:     let account: AccountRow | null = null;
413:     let lookupError: string | null = null;
414: 
415:     try {
416:       account = await this.findAccount(loginName);
417:     } catch (error) {
418:       lookupError = describe(error);
419:     }
420: 
421:     const dbSignals: Promise<SignalResult[]> =
422:       lookupError !== null
423:         ? Promise.resolve([
424:             refuse('writeRecency', `account lookup failed: ${lookupError}`),
425:             refuse('personalStore', `account lookup failed: ${lookupError}`),
426:           ])
427:         : account === null
428:           ? Promise.resolve([
429:               refuse('writeRecency', `no account named ${loginName}`),
430:               refuse('personalStore', `no account named ${loginName}`),
431:             ])
432:           : Promise.all([this.writeRecency(account), this.personalStore(account)]);
433: 
434:     const [presence, [writeRecency, personalStore], portProbe] = await Promise.all([
435:       this.presence(loginName),
436:       dbSignals,
437:       this.portProbe(),
438:     ]);
439: 
440:     const signals = [presence, writeRecency, personalStore, portProbe];
441:     const refusals = signals.filter(signal => !signal.safe).map(signal => `${signal.name}: ${signal.reason}`);
442: 
443:     return { account: loginName, safe: refusals.length === 0, refusals, signals, checkedAt };
444:   }
445: 
446:   /* ---------------------------------------------------------- signal: sockets */
447: 
448:   private async presence(loginName: string): Promise<SignalResult> {
449:     let answer: PresenceAnswer;
450: 
451:     try {
452:       const response = await fetch(
453:         `${this.config.presenceUrl}/presence/${encodeURIComponent(loginName)}`,
454:         { signal: AbortSignal.timeout(this.config.requestTimeoutMs) }
455:       );
456: 
457:       if (!response.ok) {
458:         return refuse('presence', `presence service answered HTTP ${response.status}`);
459:       }
460: 
461:       answer = (await response.json()) as PresenceAnswer;
462:     } catch (error) {
463:       // The proxy being down does not mean nobody is playing - it means we
464:       // cannot tell, and the whole point of the gate is not to guess.
465:       return refuse('presence', `presence service unreachable: ${describe(error)}`);
466:     }
467: 
468:     const detail = {
469:       connections: answer.connections,
470:       lastSeenAt: answer.lastSeenAt,
471:       unidentifiedConnections: answer.unidentifiedConnections,
472:     };
473: 
474:     if (answer.unidentifiedConnections > 0) {
475:       return refuse(
476:         'presence',
477:         `${answer.unidentifiedConnections} open socket(s) could not be identified, so any of them could be this account`,
478:         detail
479:       );
480:     }
481: 
482:     if (answer.online) {
483:       return refuse('presence', `logged in on ${answer.connections} connection(s)`, detail);
484:     }
485: 
486:     // A session this proxy never witnessed died with the previous process, and
487:     // the game server needs a moment to notice and finish saving - so its
488:     // start counts as a sighting for the length of the cooldown.
489:     const since = Math.max(answer.lastSeenAt ?? 0, answer.startedAt);
490:     const quiet = answer.now - since;
491: 
492:     if (quiet < this.config.offlineCooldownMs) {
493:       return refuse(
494:         'presence',
495:         `logged out ${Math.round(quiet / 1000)}s ago, waiting ${Math.round(this.config.offlineCooldownMs / 1000)}s`,
496:         detail
497:       );
498:     }
499: 
500:     return allow('presence', `no socket for ${Math.round(quiet / 1000)}s`, detail);
501:   }
502: 
503:   /* ----------------------------------------------------- signal: write recency */
504: 
505:   private async writeRecency(account: AccountRow): Promise<SignalResult> {
506:     try {
507:       if (this.commitTimestamps === null) {
508:         const [row] = await this.sql<{ setting: string }[]>`SHOW track_commit_timestamp`;
509:         this.commitTimestamps = row?.setting === 'on';
510:       }
511: 
512:       return this.commitTimestamps
513:         ? await this.recencyByCommitTimestamp(account)
514:         : await this.recencyBySampling(account);
515:     } catch (error) {
516:       return refuse('writeRecency', `could not read write recency: ${describe(error)}`);
517:     }
518:   }
519: 
520:   /** The direct answer, when Postgres is keeping commit timestamps. */
521:   private async recencyByCommitTimestamp(account: AccountRow): Promise<SignalResult> {
522:     const rows = await this.sql.unsafe<{ last_write: Date | null }[]>(
523:       `SELECT max(pg_xact_commit_timestamp(t.xmin)) AS last_write FROM (${this.rowsOfAccountSql()}) t`,
524:       [account.id]
525:     );
526: 
527:     const lastWrite = rows[0]?.last_write ?? null;
528: 
529:     if (lastWrite === null) {
530:       return allow('writeRecency', 'no character or item rows to have been written');
531:     }
532: 
533:     const age = Date.now() - lastWrite.getTime();
534:     const detail = { lastWrite: lastWrite.toISOString(), ageMs: age, windowMs: this.recencyWindowMs };
535: 
536:     return age < this.recencyWindowMs
537:       ? refuse(
538:           'writeRecency',
539:           `written ${Math.round(age / 1000)}s ago, which is inside the ${Math.round(this.recencyWindowMs / 1000)}s window`,
540:           detail
541:         )
542:       : allow('writeRecency', `last written ${Math.round(age / 1000)}s ago`, detail);
543:   }
544: 
545:   /**
546:    * The fallback when `track_commit_timestamp` is off: compare the rows'
547:    * transaction ids across two samples more than one save interval apart. An
548:    * in-world player is saved every minute, so anything that changed between
549:    * the samples is being played.
550:    *
551:    * The first call can only ever answer "not yet" - it has nothing to compare
552:    * against. That is the cost of not enabling the setting.
553:    */
554:   private async recencyBySampling(account: AccountRow): Promise<SignalResult> {
555:     const rows = await this.sql.unsafe<{ fingerprint: string | null }[]>(
556:       `SELECT md5(string_agg(t.xmin::text, ',' ORDER BY t.xmin::text)) AS fingerprint
557:          FROM (${this.rowsOfAccountSql()}) t`,
558:       [account.id]
559:     );
560: 
561:     const fingerprint = rows[0]?.fingerprint ?? 'empty';
562:     const now = Date.now();
563:     const previous = this.samples.get(account.id);
564:     const needed = this.config.saveIntervalMs + this.config.recencyMarginMs;
565: 
566:     if (!previous) {
567:       this.samples.set(account.id, { fingerprint, takenAt: now });
568:       return refuse(
569:         'writeRecency',
570:         `track_commit_timestamp is off, so this needs a second sample in ${Math.round(needed / 1000)}s`,
571:         { fingerprint, sampled: 1 }
572:       );
573:     }
574: 
575:     if (previous.fingerprint !== fingerprint) {
576:       this.samples.set(account.id, { fingerprint, takenAt: now });
577:       return refuse('writeRecency', 'rows changed since the last sample, so someone is playing', {
578:         fingerprint,
579:         sampled: 2,
580:       });
581:     }
582: 
583:     const held = now - previous.takenAt;
584: 
585:     if (held < needed) {
586:       return refuse(
587:         'writeRecency',
588:         `unchanged for only ${Math.round(held / 1000)}s, need ${Math.round(needed / 1000)}s`,
589:         { fingerprint, heldMs: held }
590:       );
591:     }
592: 
593:     return allow('writeRecency', `unchanged for ${Math.round(held / 1000)}s`, {
594:       fingerprint,
595:       heldMs: held,
596:     });
597:   }
598: 
599:   /**
600:    * Every character row of the account, plus every item in those characters'
601:    * inventories and in the account vault. `$1` is the account id.
602:    */
603:   private rowsOfAccountSql(): string {
604:     if (!this.schema) throw new Error('schema not resolved');
605: 
606:     const { account: a, character: c, item: i } = this.schema;
607: 
608:     return `
609:       SELECT c.xmin FROM ${c.ref} c WHERE c.${c.col.account} = $1
610:       UNION ALL
611:       SELECT i.xmin FROM ${i.ref} i
612:        WHERE i.${i.col.storage} IN (
613:          SELECT c2.${c.col.inventory} FROM ${c.ref} c2 WHERE c2.${c.col.account} = $1
614:          UNION ALL
615:          SELECT a.${a.col.vault} FROM ${a.ref} a WHERE a.${a.col.id} = $1
616:        )`;
617:   }
618: 
619:   /* ---------------------------------------------------- signal: personal store */
620: 
621:   private async personalStore(account: AccountRow): Promise<SignalResult> {
622:     try {
623:       const { character: c } = await this.schemaOnce();
624:       const rows = await this.sql.unsafe<{ name: string }[]>(
625:         `SELECT ${c.col.name} AS name
626:            FROM ${c.ref}
627:           WHERE ${c.col.account} = $1 AND ${c.col.storeOpened} = true`,
628:         [account.id]
629:       );
630: 
631:       return rows.length
632:         ? refuse('personalStore', `store open on ${rows.map(row => row.name).join(', ')}`, {
633:             characters: rows.map(row => row.name),
634:           })
635:         : allow('personalStore', 'no character has a store open');
636:     } catch (error) {
637:       return refuse('personalStore', `could not read store flags: ${describe(error)}`);
638:     }
639:   }
640: 
641:   /* --------------------------------------------------------- signal: port probe */
642: 
643:   /**
644:    * Socket presence is only worth anything while the proxy is the only way in.
645:    * If the game port answers from its public address, a player on the original
646:    * client can play without the proxy ever seeing them - so the shop stops
647:    * writing entirely rather than trusting a signal it knows is bypassable.
648:    */
649:   private async portProbe(): Promise<SignalResult> {
650:     const { gameHost, gamePort } = this.config;
651: 
652:     if (!gameHost || !gamePort) {
653:       return refuse(
654:         'portProbe',
655:         'GAME_PROBE_HOST / GAME_PROBE_PORT are not set, so the proxy cannot be shown to be the only way in'
656:       );
657:     }
658: 
659:     const target = `${gameHost}:${gamePort}`;
660:     const now = Date.now();
661:     let probe = this.probe;
662: 
663:     if (!probe || now - probe.at >= this.config.probeCacheMs) {
664:       probe = { at: now, ...(await tcpProbe(gameHost, gamePort, this.config.probeTimeoutMs)) };
665:       this.probe = probe;
666:     }
667: 
668:     const detail = `${probe.at === now ? '' : '(cached) '}${probe.detail}`;
669:     const seen = { target, probedAt: probe.at };
670: 
671:     if (probe.outcome === 'open') {
672:       return refuse('portProbe', `${target} is reachable from outside: ${detail}`, seen);
673:     }
674: 
675:     if (probe.outcome === 'inconclusive') {
676:       return refuse('portProbe', `${target} could not be probed: ${detail}`, seen);
677:     }
678: 
679:     return allow('portProbe', `${target} is closed to the outside: ${detail}`, seen);
680:   }
681: }
682: 
683: /* ------------------------------------------------------------------ helpers */
684: 
685: function allow(name: SignalName, reason: string, detail?: Record<string, unknown>): SignalResult {
686:   return { name, safe: true, reason, detail };
687: }
688: 
689: function refuse(name: SignalName, reason: string, detail?: Record<string, unknown>): SignalResult {
690:   return { name, safe: false, reason, detail };
691: }
692: 
693: function describe(error: unknown): string {
694:   return error instanceof Error ? error.message : String(error);
695: }
696: 
697: export type ProbeOutcome = 'open' | 'closed' | 'inconclusive';
698: 
699: /**
700:  * Dials the port once. Three answers, and only two of them say anything
701:  * about the port:
702:  *
703:  *   open          the handshake completed: something is listening.
704:  *   closed        the SYN was answered with a reset (ECONNREFUSED: nothing
705:  *                 listens, or the firewall REJECTs), or nobody answered it at
706:  *                 all within the timeout.
707:  *   inconclusive  anything else - a name that does not resolve, no route, a
708:  *                 permission or descriptor limit. The probe never reached the
709:  *                 network at the address it was asked about, so it proves
710:  *                 nothing, and the gate refuses. A typo in `GAME_PROBE_HOST`
711:  *                 is the likeliest way here, and it must not read as "closed".
712:  *
713:  * Silence is `closed`, and that needs arguing next to "fail closed". The
714:  * probe exists to show the game port unreachable from where a player's client
715:  * would dial it, and the ordinary way an operator makes a port unreachable -
716:  * a cloud security group, `iptables -P INPUT DROP`, ufw - is to drop the SYN,
717:  * which from the dialling side is silence until the timer runs out. A reset
718:  * is the rarer posture. Were silence inconclusive, the common deployment
719:  * would never deliver anything, and the only way an operator could then get
720:  * a delivery is to point `GAME_PROBE_HOST` at something that resets, which
721:  * would trade an honest reading for a rigged one. Silence is trusted because
722:  * what else it could mean is ruled out: a host with no route fails at once
723:  * (ENETUNREACH, EHOSTUNREACH), a name that does not resolve fails at once
724:  * (ENOTFOUND), and both are `inconclusive`. What silence cannot rule out is a
725:  * probe run from somewhere the firewall treats differently from the internet
726:  * - the game box behind a NAT that does not hairpin its own public address -
727:  * which is why the address is the one a player dials and the probe has to
728:  * run from a host whose path to it is the internet's.
729:  *
730:  * `node:net` rather than `Bun.connect`, because Bun reports every failure to
731:  * connect as ECONNREFUSED, an unresolvable name and an unroutable address
732:  * included, and that would make the typo above read as a closed port. Node's
733:  * socket keeps the real code.
734:  */
735: export function tcpProbe(
736:   host: string,
737:   port: number,
738:   timeoutMs: number
739: ): Promise<{ outcome: ProbeOutcome; detail: string }> {
740:   return new Promise(resolve => {
741:     const socket = net.connect({ host, port });
742:     let settled = false;
743: 
744:     const finish = (outcome: ProbeOutcome, detail: string) => {
745:       if (settled) return;
746:       settled = true;
747:       clearTimeout(timer);
748:       socket.destroy();
749:       resolve({ outcome, detail });
750:     };
751: 
752:     const timer = setTimeout(() => finish('closed', `no answer in ${timeoutMs}ms`), timeoutMs);
753: 
754:     socket.once('connect', () => finish('open', 'connected'));
755:     socket.once('error', (error: NodeJS.ErrnoException) => {
756:       if (error.code === 'ECONNREFUSED') {
757:         finish('closed', 'connection refused');
758:       } else {
759:         finish('inconclusive', `${error.code ?? 'error'}: ${describe(error)}`);
760:       }
761:     });
762:   });
763: }
