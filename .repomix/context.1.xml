379:     this.performers.set(state, perf);
380:     state.performing = perf;
381:     this.counters.performers = this.performers.size;
382:     // The performer's own socket only knows its local id (0x200); the id
383:     // others address it by is recovered from a peer that sees it.
384:     this.resolvePublicId(perf);
385:     track.note('band', `starts playing instrument ${message.instrument}`, { instrument: message.instrument });
