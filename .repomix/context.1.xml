 8:     for (let i = 0; i < 10; i++) {
 9:       w.add(now, 3);
10:       now += 100;
11:     }
12:     // now = 6000: the first bucket (5000-5099) has just fallen out.
13:     expect(w.sum(now)).toBe(27);
14:     now += 500;
