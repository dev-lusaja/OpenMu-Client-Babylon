  1: import {
  2:   PlayerShopClosePacket,
  3:   PlayerShopOpenPacket,
  4:   PlayerShopSetItemPricePacket,
  5:   ItemMoveRequestPacket,
  6: } from '../../src/common/packets/ClientToServerPackets';
  7: import {
  8:   PlayerShopItemSoldToPlayerPacket,
  9:   PlayerShopOpenSuccessfulPacket,
 10:   PlayerShopSetItemPriceResponsePacket,
 11:   PlayerShopSetItemPriceResponseItemPriceSetResultEnum as PriceResult,
 12:   ItemMovedPacket,
 13: } from '../../src/common/packets/ServerToClientPackets';
 14: import { StorageKind } from '../../src/common/storageKind';
 15: import { InventoryConstants } from '../../src/common/inventoryConstants';
 16: import type { BotConnection, Frame } from './connection';
 17: import { view } from './session';
 18: 
 19: /**
 20:  * The bot's personal shop, which is how it sells.
 21:  *
 22:  * A trade is a negotiation: two tables, four states, and a confirm from each
 23:  * side that has to arrive in the right order. Every failure the delivery had
 24:  * lived in that choreography - an item that never reached the table, a side
 25:  * nobody checked, a cancel that destroys the Zen standing on it.
 26:  *
 27:  * A shop has none of it. `BuyRequestAction` checks the buyer's money, moves
 28:  * the item and moves the payment inside one server-side operation with no
 29:  * cancel path: either the buyer walks away with the item and the bot with the
 30:  * Zen, or nothing happened. The bot does not confirm anything, so it cannot
 31:  * confirm the wrong thing, and a second buyer arriving late is refused by the
 32:  * server rather than charged.
 33:  *
 34:  * What it costs is that a shop can only *sell*. Taking an item from a seller
 35:  * and paying a seller what they are owed both still need a trade.
 36:  */
 37: 
 38: /** Every shop packet is 0x3F; the sub code says which. */
 39: const CODE = {
 40:   price: { code: 0x3f, sub: 0x01 },
 41:   opened: { code: 0x3f, sub: 0x02 },
 42:   closed: { code: 0x3f, sub: 0x03 },
 43:   sold: { code: 0x3f, sub: 0x08 },
 44:   /** The server's answer to an item move, whichever box it went to. */
 45:   moved: { code: 0x24 },
 46: } as const;
 47: 
 48: /**
 49:  * Shop slots are inventory slots, not a box of their own numbering.
 50:  *
 51:  * `ShopStorage` is a window onto the inventory starting at
 52:  * `FirstStoreItemSlotIndex`, and both `SetItemPriceAction` and the item move
 53:  * address it by absolute slot - so the first shop square is 204, not 0. The
 54:  * comment on OpenMU's own `SetPriceAsync` says "0 to 31" and is describing an
 55:  * older layout; the code beneath it looks the item up by `ItemSlot`.
 56:  */
 57: export const FIRST_SHOP_SLOT = InventoryConstants.FirstStoreItemSlotIndex;
 58: export const SHOP_SLOTS = InventoryConstants.StoreSize;
 59: 
 60: /** A character below this cannot open a shop at all (`SetItemPriceAction`). */
 61: export const MINIMUM_SHOP_LEVEL = 6;
 62: 
 63: export type Sale = { slot: number; buyer: string };
 64: 
 65: export class ShopSession {
 66:   private open = false;
 67:   private readonly unsubscribe: () => void;
 68:   private readonly sales: Sale[] = [];
 69:   private watchers: ((sale: Sale) => void)[] = [];
 70: 
 71:   constructor(
 72:     private readonly connection: BotConnection,
 73:     private readonly log: (message: string) => void = () => {}
 74:   ) {
 75:     this.unsubscribe = connection.on(frame => this.handle(frame));
 76:   }
 77: 
 78:   dispose(): void {
 79:     this.unsubscribe();
 80:   }
 81: 
 82:   get isOpen(): boolean {
 83:     return this.open;
 84:   }
 85: 
 86:   /**
 87:    * Moves a held item out of the bag and into the shop window.
 88:    *
 89:    * The move is confirmed rather than assumed: the server answers with
 90:    * `ItemMoved` naming where the item actually went, and a refused move
 91:    * answers with the same code and an all-ones sub code. Pricing a slot that
 92:    * never received the item would otherwise open a shop selling nothing.
 93:    *
 94:    * The stall is a window onto the inventory, and OpenMU's `ItemMovedPlugIn`
 95:    * says so on the wire: a move into it comes back as storage *Inventory* at
 96:    * the absolute slot (204 and up), never as the shop storage the request
 97:    * named. Expecting the shop storage here read every successful stocking as
 98:    * a failure - and, since a failure was not put back, left the item stranded
 99:    * in the stall where the next delivery could not find it.
100:    */
101:   async stockItem(inventorySlot: number, shopSlot: number, timeoutMs = 8000): Promise<void> {
102:     const answer = this.connection.expect(CODE.moved, timeoutMs, 'ItemMoved');
103:     const packet = ItemMoveRequestPacket.createPacket();
104:     packet.FromStorage = StorageKind.Inventory;
105:     packet.FromSlot = inventorySlot;
106:     packet.ToStorage = StorageKind.PersonalShop;
107:     packet.ToSlot = shopSlot;
108:     packet.setItemData(new Uint8Array(12), 12);
109:     this.connection.send(packet.buffer);
110: 
111:     const moved = new ItemMovedPacket(view(await answer));
112:     const landedInStall =
113:       (moved.TargetStorageType === StorageKind.Inventory ||
114:         moved.TargetStorageType === StorageKind.PersonalShop) &&
115:       moved.TargetSlot === shopSlot;
116:     if (!landedInStall) {
117:       throw new Error(
118:         `the item did not reach shop slot ${shopSlot} from bag slot ${inventorySlot}`
119:       );
120:     }
121:   }
122: 
123:   /**
124:    * Puts an item back in the bag, for a listing nobody bought.
125:    *
126:    * Same confirmation, and it matters more here: an item stranded in the shop
127:    * window is one the bot still holds but can no longer find.
128:    */
129:   async unstockItem(shopSlot: number, inventorySlot: number, timeoutMs = 8000): Promise<void> {
130:     const answer = this.connection.expect(CODE.moved, timeoutMs, 'ItemMoved');
131:     const packet = ItemMoveRequestPacket.createPacket();
132:     packet.FromStorage = StorageKind.PersonalShop;
133:     packet.FromSlot = shopSlot;
134:     packet.ToStorage = StorageKind.Inventory;
135:     packet.ToSlot = inventorySlot;
136:     packet.setItemData(new Uint8Array(12), 12);
137:     this.connection.send(packet.buffer);
138: 
139:     const moved = new ItemMovedPacket(view(await answer));
140:     if (moved.TargetStorageType !== StorageKind.Inventory || moved.TargetSlot !== inventorySlot) {
141:       throw new Error(`the item is stranded in shop slot ${shopSlot}`);
142:     }
143:   }
144: 
145:   /**
146:    * Prices one shop slot. Must happen while the shop is shut: OpenMU refuses
147:    * a price change on an open store, which is also what stops a buyer paying
148:    * yesterday's price for today's item.
149:    */
150:   async setPrice(shopSlot: number, price: number, timeoutMs = 8000): Promise<void> {
151:     const answer = this.connection.expect(CODE.price, timeoutMs, 'ItemPriceResponse');
152:     const packet = PlayerShopSetItemPricePacket.createPacket();
153:     packet.ItemSlot = shopSlot;
154:     packet.Price = price;
155:     this.connection.send(packet.buffer);
156: 
157:     const response = new PlayerShopSetItemPriceResponsePacket(view(await answer));
158:     if (response.Result !== PriceResult.Success) {
159:       throw new Error(
160:         `the server refused the price for slot ${shopSlot}: ${
161:           PriceResult[response.Result] ?? response.Result
162:         }`
163:       );
164:     }
165:   }
166: 
167:   /** Opens the shop under a name passers-by can read. */
168:   async openWith(name: string, timeoutMs = 8000): Promise<void> {
169:     const answer = this.connection.expect(CODE.opened, timeoutMs, 'ShopOpened');
170:     const packet = PlayerShopOpenPacket.createPacket();
171:     packet.setStoreName(name);
172:     this.connection.send(packet.buffer);
173: 
174:     const response = new PlayerShopOpenSuccessfulPacket(view(await answer));
175:     if (!response.Success) throw new Error('the server refused to open the shop');
176:     this.open = true;
177:     this.log(`shop open as "${name}"`);
178:   }
179: 
180:   /**
181:    * Shuts the shop. Sent unconditionally rather than only when we believe it
182:    * is open: the belief is the thing most likely to be wrong after a crash,
183:    * and a close on a shut shop costs nothing.
184:    */
185:   close(): void {
186:     this.connection.send(PlayerShopClosePacket.createPacket().buffer);
187:     this.open = false;
188:   }
189: 
190:   /**
191:    * Waits for a particular slot to sell.
192:    *
193:    * Resolves with the buyer's name, which the server volunteers - so who
194:    * bought it is known rather than assumed, and a listing claimed by one
195:    * person but bought by another is visible instead of silently mis-booked.
196:    */
197:   waitForSale(shopSlot: number, timeoutMs: number): Promise<Sale> {
198:     const already = this.sales.find(s => s.slot === shopSlot);
199:     if (already) return Promise.resolve(already);
200: 
201:     return new Promise<Sale>((resolve, reject) => {
202:       const timer = setTimeout(() => {
203:         this.watchers = this.watchers.filter(w => w !== watcher);
204:         reject(new Error(`nobody bought it within ${Math.round(timeoutMs / 1000)}s`));
205:       }, timeoutMs);
206: 
207:       const watcher = (sale: Sale) => {
208:         if (sale.slot !== shopSlot) return;
209:         clearTimeout(timer);
210:         this.watchers = this.watchers.filter(w => w !== watcher);
211:         resolve(sale);
212:       };
213:       this.watchers.push(watcher);
214:     });
215:   }
216: 
217:   /** Forgets past sales, so a new listing does not resolve on an old one. */
218:   reset(): void {
219:     this.sales.length = 0;
220:   }
221: 
222:   private handle(frame: Frame): void {
223:     if (frame.code !== CODE.sold.code) return;
224: 
225:     if (frame.sub === CODE.sold.sub) {
226:       const packet = new PlayerShopItemSoldToPlayerPacket(view(frame));
227:       const sale: Sale = { slot: packet.InventorySlot, buyer: packet.BuyerName };
228:       this.sales.push(sale);
229:       this.log(`slot ${sale.slot} sold to ${sale.buyer}`);
230:       for (const watcher of [...this.watchers]) watcher(sale);
231:       return;
232:     }
233: 
234:     if (frame.sub === CODE.closed.sub) {
235:       // The server can shut the shop without being asked - the last item
236:       // selling does it - so this is the only reliable word on the matter.
237:       this.open = false;
238:     }
239:   }
240: }
</file>

