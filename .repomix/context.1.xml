 39: export interface BandPeer {
 40:   readonly track: TrackedSession;
 41:   /** Bun's `ws.send` status: 0 dropped (closed), -1 backpressure, else bytes. Must not throw. */
 42:   send(frame: Uint8Array): number;
 43: }
 44: 
 45: export type BandHubOptions = {
 46:   now?: () => number;
 47:   maxPerformers?: number;
 48:   maxPerformersPerMap?: number;
 49:   maxReceivers?: number;
 50:   log?: (line: string) => void;
 51: };
