  1: import { auditFor, deliveringOrders, orderById, ordersFor, queuedOrders, settle, DB_PATH } from './db';
  2: 
  3: /**
  4:  * The operator's view of the order store, for the one case the worker is
  5:  * built not to decide on its own: an order left `delivering` because the
  6:  * process died mid-transaction or Postgres went away around COMMIT. Whether
  7:  * that write landed is a fact in OpenMU's database, not in this one, so a
  8:  * person looks (`\d data."Item"` for the slot and definition the audit row
  9:  * names) and then says which it was.
 10:  *
 11:  *   bun run cashshop-orders                     what is queued and what is stuck
 12:  *   bun run cashshop-orders show <id>           one order and every audit line about it
 13:  *   bun run cashshop-orders account <name>      one account's orders, newest first
 14:  *   bun run cashshop-orders requeue <id>        it did not commit: let the worker try again
 15:  *   bun run cashshop-orders fail <id> <reason>  it did not commit and must not: tell the player why
 16:  *   bun run cashshop-orders delivered <id> <itemId>
 17:  *                                               it did commit: record the item row it left
 18:  *
 19:  * Reads and writes the shop's own SQLite only; it never touches OpenMU.
 20:  */
 21: 
 22: const DIM = '\x1b[2m';
 23: const BOLD = '\x1b[1m';
 24: const RED = '\x1b[31m';
 25: const RESET = '\x1b[0m';
 26: 
 27: function usage(): never {
 28:   console.error(
 29:     'usage: bun run cashshop-orders ' +
 30:       '[show <id> | account <name> | requeue <id> | fail <id> <reason> | delivered <id> <itemId>]'
 31:   );
 32:   process.exit(2);
 33: }
 34: 
 35: function stamp(at: number): string {
 36:   return new Date(at).toISOString().replace('T', ' ').slice(0, 19);
 37: }
 38: 
 39: function line(order: ReturnType<typeof orderById>): string {
 40:   if (!order) return '';
 41:   const roll = order.roll ? ` ${order.roll.tier} ${order.roll.name} +${order.roll.level}` : '';
 42:   return (
 43:     `${DIM}${stamp(order.placedAt)}${RESET} ${order.id} ${order.state.padEnd(10)} ` +
 44:     `${order.productName}${roll} ${DIM}${order.chaos} chaos${RESET}`
 45:   );
 46: }
 47: 
 48: function overview(): void {
 49:   const stuck = deliveringOrders();
 50:   const queued = queuedOrders();
 51: 
 52:   console.info(`${BOLD}orders in ${DB_PATH}${RESET}`);
 53: 
 54:   if (stuck.length) {
 55:     console.info(
 56:       `\n${RED}${stuck.length} delivering - interrupted, a person has to settle each one:${RESET}`
 57:     );
 58:     for (const order of stuck) console.info(`  ${order.account.padEnd(10)} ${line(order)}`);
 59:   } else {
 60:     console.info(`\nnothing stuck in delivering`);
 61:   }
 62: 
 63:   console.info(`\n${queued.length} queued:`);
 64:   for (const order of queued) console.info(`  ${order.account.padEnd(10)} ${line(order)}`);
 65: }
 66: 
 67: function show(id: string): void {
 68:   const order = orderById(id);
 69: 
 70:   if (!order) {
 71:     console.error(`no order ${id}`);
 72:     process.exit(1);
 73:   }
 74: 
 75:   console.info(line(order));
 76:   if (order.reason) console.info(`  ${order.reason}`);
 77:   if (order.roll) console.info(`  roll ${JSON.stringify(order.roll)}`);
 78: 
 79:   for (const entry of auditFor(id)) {
 80:     console.info(`\n${DIM}${stamp(entry.at)}${RESET} ${BOLD}${entry.event}${RESET}`);
 81:     if (entry.detail !== null) console.info(`  ${JSON.stringify(entry.detail)}`);
 82:   }
 83: }
 84: 
 85: function resolve(
 86:   id: string,
 87:   state: 'queued' | 'failed' | 'delivered',
 88:   reason: string,
 89:   itemId: string | null
 90: ): void {
 91:   const order = orderById(id);
 92: 
 93:   if (!order) {
 94:     console.error(`no order ${id}`);
 95:     process.exit(1);
 96:   }
 97: 
 98:   if (order.state !== 'delivering') {
 99:     console.error(
100:       `order ${id} is ${order.state}, not delivering; only a delivering order can be settled by hand`
101:     );
102:     process.exit(1);
103:   }
104: 
105:   const settled = settle(id, state, reason, itemId);
106: 
107:   if (!settled) {
108:     console.error(`order ${id} could not be settled`);
109:     process.exit(1);
110:   }
111: 
112:   console.info(line(settled));
113: }
114: 
115: const [command, ...rest] = process.argv.slice(2);
116: 
117: switch (command) {
118:   case undefined:
119:     overview();
120:     break;
121:   case 'show':
122:     if (!rest[0]) usage();
123:     show(rest[0]);
124:     break;
125:   case 'account':
126:     if (!rest[0]) usage();
127:     for (const order of ordersFor(rest[0].toLowerCase())) console.info(line(order));
128:     break;
129:   case 'requeue':
130:     if (!rest[0]) usage();
131:     resolve(rest[0], 'queued', 'Checked by hand: not delivered yet, and queued again.', null);
132:     break;
133:   case 'fail':
134:     if (!rest[0] || !rest[1]) usage();
135:     resolve(rest[0], 'failed', rest.slice(1).join(' '), null);
136:     break;
137:   case 'delivered':
138:     if (!rest[0] || !rest[1]) usage();
139:     resolve(rest[0], 'delivered', 'Checked by hand: delivered.', rest[1]);
140:     break;
141:   default:
142:     usage();
143: }
</file>

<file path="cashshop/server/tickets.ts">
  1: import { createHmac, randomBytes, timingSafeEqual } from 'node:crypto';
  2: import { loadGateConfig } from './gate';
  3: import { SESSION_NONCE_RE } from '../../src/common/sessionNonce';
  4: 
  5: /**
  6:  * Who is asking: the ticket that gives a shop request its account.
  7:  *
  8:  * The window runs inside a session the game server already authenticated.
  9:  * The player typed a password at login and must not type it again, so the
 10:  * shop cannot ask for one - and it cannot trust a name the browser sends,
 11:  * because anyone can type a name. The one process that knows which account
 12:  * owns a socket is the proxy: it reads the login off every connection, waits
 13:  * for the game server to accept it (`proxy/presence.ts` - the client's login
 14:  * frame alone is a claim anyone can make), and binds the result to the
 15:  * `session` nonce the client put on the websocket URL
 16:  * (`src/libs/sockets/createSocket.ts`). The nonce is 128 random bits chosen
 17:  * by the page, so holding it is proof of holding the socket.
 18:  *
 19:  * The browser can never ask the proxy directly: the presence server is
 20:  * loopback only and must never be published, because it answers "is this
 21:  * account playing" to anyone who reaches it. So the exchange goes through
 22:  * this service - the window posts its nonce, this asks the presence server
 23:  * over loopback, and mints a ticket for the account it names. From then on
 24:  * every request carries the ticket in its body or query string; never a
 25:  * cookie and never a custom header, because the window fetches with
 26:  * `credentials: 'omit'` and the CORS preflight in `main.ts` allows only
 27:  * `Content-Type`.
 28:  *
 29:  * The ticket is stateless: `<account>.<expiresAtMs>.<mac>`, where the MAC is
 30:  * HMAC-SHA256 over `${account}|${expiresAt}`. Nothing is stored, so a restart
 31:  * of this service invalidates nothing and a verify costs one hash.
 32:  *
 33:  * It is enough to read with, and not enough to spend with. A ticket outlives
 34:  * the socket, so within its ten minutes a ticket lifted from a request log
 35:  * could still read the order tab; that is the reason the TTL is short. But an
 36:  * order is a promise to take jewels out of the account's bag, and the gate
 37:  * that guards that write only asks whether the account is safe to write to,
 38:  * never whether the order was the player's - so placing or cancelling one
 39:  * also has to prove the socket is still there and still logged in as that
 40:  * account (`confirmLive`), and a ticket alone, however fresh, cannot.
 41:  */
 42: 
 43: /**
 44:  * The presence server's own rule for a login name (`ACCOUNT_RE` in
 45:  * `proxy/presence.ts`). Letters and digits only, which is what makes the
 46:  * ticket format unambiguous: neither the `.` that separates its three fields
 47:  * nor the `|` under the MAC can appear in a name that passes this.
 48:  */
 49: const ACCOUNT_RE = /^[A-Za-z0-9]{1,10}$/;
 50: 
 51: /**
 52:  * Ten minutes. Long enough that a browsing session rarely sees it, short
 53:  * enough that a ticket lifted from a request log is worth little; the client
 54:  * re-exchanges silently on a 401.
 55:  */
 56: export const TICKET_TTL_MS = 10 * 60 * 1000;
 57: 
 58: /** A base64url SHA-256 digest is always this long, so a MAC of any other length is malformed before it is compared. */
 59: const MAC_LENGTH = 43;
 60: 
 61: /**
 62:  * The signing secret. Set `CASHSHOP_TICKET_SECRET` in production: without it
 63:  * every boot signs with a fresh random key, which is safe - nobody else holds
 64:  * it either - but every restart logs every player out of the shop until they
 65:  * re-exchange, and a second instance of the service could not verify the
 66:  * first one's tickets.
 67:  */
 68: const SECRET: Uint8Array = (() => {
 69:   const configured = process.env.CASHSHOP_TICKET_SECRET;
 70: 
 71:   if (configured) return new TextEncoder().encode(configured);
 72: 
 73:   console.warn(
 74:     'cash shop: CASHSHOP_TICKET_SECRET is not set; signing tickets with a random per-boot secret, ' +
 75:       'so every restart invalidates every ticket'
 76:   );
 77: 
 78:   return new Uint8Array(randomBytes(32));
 79: })();
 80: 
 81: export interface Ticket {
 82:   ticket: string;
 83:   account: string;
 84:   expiresAt: number;
 85: }
 86: 
 87: export type Verification =
 88:   | { ok: true; account: string; expiresAt: number }
 89:   | { ok: false; reason: 'malformed' | 'forged' | 'expired' };
 90: 
 91: /**
 92:  * `malformed`: the nonce is not what the client mints, so nothing was asked.
 93:  * `unknown`: the presence server has no logged-in socket under it - not yet
 94:  * logged in, logged out, or a nonce it never saw. `unreachable`: the presence
 95:  * server did not answer, and nothing may be decided on a guess.
 96:  */
 97: export type SessionFailure = 'malformed' | 'unknown' | 'unreachable';
 98: 
 99: export type Exchange =
100:   | { ok: true; ticket: Ticket }
101:   | { ok: false; reason: SessionFailure; message: string };
102: 
103: type Named = { ok: true; account: string } | { ok: false; reason: SessionFailure; message: string };
104: 
105: function sign(account: string, expiresAt: number): string {
106:   return createHmac('sha256', SECRET).update(`${account}|${expiresAt}`).digest('base64url');
107: }
108: 
109: /**
110:  * The account goes into the ticket lowercased. OpenMU's login is
111:  * case-insensitive (`SafetyGate.findAccount` matches on `lower()`, as the
112:  * game does), so "Player" and "PLAYER" are one account; the order store keys
113:  * on this string, and a cap counted under two spellings would be two caps.
114:  */
115: export function mintTicket(account: string, now = Date.now()): Ticket {
116:   if (!ACCOUNT_RE.test(account)) {
117:     throw new Error(`refusing to mint a ticket for "${account}"`);
118:   }
119: 
120:   const canonical = account.toLowerCase();
121:   const expiresAt = now + TICKET_TTL_MS;
122: 
123:   return {
124:     ticket: `${canonical}.${expiresAt}.${sign(canonical, expiresAt)}`,
125:     account: canonical,
126:     expiresAt,
127:   };
128: }
129: 
130: /**
131:  * Never throws: the caller turns a failure into a 401 and the client
132:  * exchanges again. The MAC comparison is constant-time so a forger learns
133:  * nothing from how quickly a wrong one is refused; the shape checks before
134:  * it only reject strings that could not have been minted here at all.
135:  */
136: export function verifyTicket(ticket: unknown, now = Date.now()): Verification {
137:   if (typeof ticket !== 'string') return { ok: false, reason: 'malformed' };
138: 
139:   const parts = ticket.split('.');
140: 
141:   if (parts.length !== 3) return { ok: false, reason: 'malformed' };
142: 
143:   const [account, expiry, mac] = parts;
144: 
145:   if (!ACCOUNT_RE.test(account)) return { ok: false, reason: 'malformed' };
146:   if (!/^\d{1,16}$/.test(expiry)) return { ok: false, reason: 'malformed' };
147:   if (mac.length !== MAC_LENGTH) return { ok: false, reason: 'malformed' };
148: 
149:   const expiresAt = Number(expiry);
150:   const encoder = new TextEncoder();
151:   const expected = encoder.encode(sign(account, expiresAt));
152:   const given = encoder.encode(mac);
153: 
154:   if (expected.length !== given.length || !timingSafeEqual(expected, given)) {
155:     return { ok: false, reason: 'forged' };
156:   }
157: 
158:   if (expiresAt <= now) return { ok: false, reason: 'expired' };
159: 
160:   return { ok: true, account, expiresAt };
161: }
162: 
163: /**
164:  * Asks the proxy who is logged in over the socket carrying this nonce. Same
165:  * base URL and timeout as the safety gate's presence signal
166:  * (`SafetyGate.presence`), because it is the same server and a second knob
167:  * would only drift.
168:  *
169:  * Fails closed the way the gate does: a presence server that is down, slow
170:  * or answering nonsense names nobody, never a name this did not hear from it.
171:  */
172: async function whoIsOn(nonce: unknown): Promise<Named> {
173:   // The page's own rule for what it mints, checked before the nonce is ever
174:   // put in a URL.
175:   if (typeof nonce !== 'string' || !SESSION_NONCE_RE.test(nonce)) {
176:     return { ok: false, reason: 'malformed', message: 'That session is not one this shop recognises.' };
177:   }
178: 
179:   const { presenceUrl, requestTimeoutMs } = loadGateConfig();
180:   let answer: { account?: unknown };
181: 
182:   try {
183:     const response = await fetch(`${presenceUrl}/ticket/${nonce}`, {
184:       signal: AbortSignal.timeout(requestTimeoutMs),
185:     });
186: 
187:     if (response.status === 404) {
188:       // Bound, but not yet named: the account is only known once the game
189:       // server has accepted the login, and the connect-server socket never
190:       // sends one. The client retries after it is in the world.
191:       return { ok: false, reason: 'unknown', message: 'Log in to the game first.' };
192:     }
193: 
194:     if (!response.ok) {
195:       console.error(`ticket exchange: presence server answered HTTP ${response.status}`);
196:       return { ok: false, reason: 'unreachable', message: 'The shop cannot confirm who you are right now.' };
197:     }
198: 
199:     answer = (await response.json()) as { account?: unknown };
200:   } catch (error) {
201:     // `PRESENCE=off` on the proxy lands here too, as a refused connection.
202:     // The shop then sells to nobody, which is the intended failure.
203:     console.error('ticket exchange: presence server unreachable:', error instanceof Error ? error.message : error);
204:     return { ok: false, reason: 'unreachable', message: 'The shop cannot confirm who you are right now.' };
205:   }
206: 
207:   const account = answer.account;
208: 
209:   if (typeof account !== 'string' || !ACCOUNT_RE.test(account)) {
210:     console.error('ticket exchange: presence server named an account this refuses to sign for');
211:     return { ok: false, reason: 'unreachable', message: 'The shop cannot confirm who you are right now.' };
212:   }
213: 
214:   return { ok: true, account };
215: }
216: 
217: /** Turns the websocket nonce into a ticket for whoever the proxy says logged in on it. */
218: export async function exchangeSession(nonce: unknown): Promise<Exchange> {
219:   const named = await whoIsOn(nonce);
220: 
221:   return named.ok ? { ok: true, ticket: mintTicket(named.account) } : named;
222: }
223: 
224: export type Liveness =
225:   | { ok: true }
226:   | { ok: false; reason: SessionFailure | 'someoneElse'; message: string };
227: 
228: /**
229:  * Whether the socket behind `nonce` is, right now, logged in as the account a
230:  * ticket names. Asked before anything is placed or cancelled: a ticket proves
231:  * this service once vouched for the account, this proves the player is still
232:  * sitting at it. A page whose game socket dropped is told to log in again,
233:  * and a ticket presented with somebody else's nonce buys nothing.
234:  */
235: export async function confirmLive(nonce: unknown, account: string): Promise<Liveness> {
236:   const named = await whoIsOn(nonce);
237: 
238:   if (!named.ok) {
239:     return named.reason === 'unknown'
240:       ? { ok: false, reason: 'unknown', message: 'Your game session has ended. Log in again to buy.' }
241:       : named;
242:   }
243: 
244:   if (named.account.toLowerCase() !== account.toLowerCase()) {
245:     return { ok: false, reason: 'someoneElse', message: 'Your game session has ended. Log in again to buy.' };
246:   }
247: 
248:   return { ok: true };
249: }
</file>

