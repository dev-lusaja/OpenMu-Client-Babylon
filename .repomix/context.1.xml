<file path="cashshop/server/catalog.ts">
  1: import items from '../../src/common/items.json';
  2: 
  3: /**
  4:  * What the shop sells, and for how many Jewels of Chaos.
  5:  *
  6:  * Data, not code: prices and caps are meant to be tuned without touching
  7:  * anything else. Names and grid footprints are looked up in the client's own
  8:  * `items.json` rather than restated here, so the shop and the game can never
  9:  * disagree about what an entry actually is.
 10:  *
 11:  * The one currency is the Jewel of Chaos (12/15). It is the right sink for
 12:  * three reasons. It is the fuel of the Chaos Machine - every wing, every +10,
 13:  * every fruit and feather mix burns one - so it already has a value the
 14:  * server sets and every player understands. It is the common jewel: it drops
 15:  * from Chaos Goblins, from boxes, from ordinary hunting, so a mid-level
 16:  * character can pay the shop from a session's pickups where a Bless-and-Soul
 17:  * price would gate the shop behind the rarest drops in the game. And it has
 18:  * no compressed form (Bless and Soul do: 12/30 and 12/31), so unlike them it
 19:  * piles up loose in bags and vaults with nowhere to go once a character's
 20:  * mixes are done; a second use for it takes jewels out of the economy that
 21:  * would otherwise sit or be dumped on the market for zen.
 22:  *
 23:  * That last point bounds every price here. A jewel is one inventory square
 24:  * and nothing stacks, and the wallet the service checks is the database
 25:  * inventory plus vault - 64 squares (up to 192 extended) and 120 - so a
 26:  * price is paid in squares rather than in value, and a three-figure price is
 27:  * one nobody can carry.
 28:  *
 29:  * The prices below sit far under that ceiling: a session's pickups covers
 30:  * any single one of them. That is deliberate, and it moves the work of
 31:  * bounding what the shop gives away off the price and onto the daily caps -
 32:  * one pair of wings a day whatever the buyer has banked. A cap is the honest
 33:  * lever for that, because a rich player cannot defeat it, and it is the
 34:  * number to change first if the shop turns out to be too generous.
 35:  */
 36: 
 37: interface ItemRow {
 38:   Group: number;
 39:   Index: number;
 40:   ItemName: string;
 41:   X: number;
 42:   Y: number;
 43: }
 44: 
 45: const byKey = new Map<string, ItemRow>();
 46: 
 47: for (const row of items as unknown as ItemRow[]) {
 48:   byKey.set(`${row.Group}/${row.Index}`, row);
 49: }
 50: 
 51: export type ProductLine = 'wings' | 'quest' | 'gacha';
 52: 
 53: export interface Product {
 54:   id: string;
 55:   line: ProductLine;
 56:   name: string;
 57:   /** Null for the gacha, which picks its item when the order is placed. */
 58:   group: number | null;
 59:   number: number | null;
 60:   level: number;
 61:   width: number;
 62:   height: number;
 63:   /** Jewels of Chaos (12/15). One jewel is one inventory square, so the ceiling is squares, not value. */
 64:   chaos: number;
 65:   /** Per account, per day. */
 66:   dailyCap: number;
 67:   note?: string;
 68: }
 69: 
 70: interface Spec {
 71:   line: ProductLine;
 72:   group: number;
 73:   number: number;
 74:   level?: number;
 75:   chaos: number;
 76:   dailyCap: number;
 77:   /** Overrides the name from `items.json`, for entries whose level renames them. */
 78:   name?: string;
 79:   note?: string;
 80: }
 81: 
 82: const SPECS: Spec[] = [
 83:   // Level 1 wings. A Chaos Machine milestone - a chaos weapon mix and then
 84:   // the wing mix, 40-50M zen in expectation plus the failed ingredients -
 85:   // sold here as a shortcut priced within a day's pickups rather than at what
 86:   // those mixes cost. The one a day is therefore what keeps wings from
 87:   // flooding a server where they are the first big goal: the cap is the lever
 88:   // on this line, not the number beside it. Fairy sits a step under the other
 89:   // three. Big footprints, too - Wings of Angel is 5x3 in an 8-wide grid.
 90:   { line: 'wings', group: 12, number: 0, chaos: 9, dailyCap: 1 },
 91:   { line: 'wings', group: 12, number: 1, chaos: 12, dailyCap: 1 },
 92:   { line: 'wings', group: 12, number: 2, chaos: 12, dailyCap: 1 },
 93:   { line: 'wings', group: 13, number: 30, chaos: 12, dailyCap: 1 },
 94: 
 95:   // The second and third quest chains: convenience buys for drops people
 96:   // otherwise farm for hours, at a few jewels each so a session's pickups
 97:   // covers several. The second chain's pieces are each wanted once, which is
 98:   // what the cap of five is for; the third's are wanted in quantity, and five
 99:   // Symbols make a Lost Map.
100:   //
101:   // Devil Eye, Devil Key and Symbol of Kundun are sold at level 0, and in
102:   // Season 6 those are +1..+7 tickets - level 0 is not a ticket the game
103:   // recognises. Priced as they stand; the level is a separate decision.
104:   { line: 'quest', group: 14, number: 23, chaos: 5, dailyCap: 5 },
105:   { line: 'quest', group: 14, number: 24, chaos: 4, dailyCap: 5 },
106:   { line: 'quest', group: 14, number: 25, chaos: 4, dailyCap: 5 },
107:   { line: 'quest', group: 14, number: 26, chaos: 4, dailyCap: 5 },
108:   { line: 'quest', group: 14, number: 17, chaos: 3, dailyCap: 10 },
109:   { line: 'quest', group: 14, number: 18, chaos: 3, dailyCap: 10 },
110:   { line: 'quest', group: 14, number: 29, chaos: 5, dailyCap: 10 },
111: ];
112: 
113: function build(spec: Spec): Product {
114:   const key = `${spec.group}/${spec.number}`;
115:   const row = byKey.get(key);
116: 
117:   if (!row) throw new Error(`catalog: no item ${key} in items.json`);
118: 
119:   const level = spec.level ?? 0;
120: 
121:   return {
122:     id: `${spec.line}-${spec.group}-${spec.number}-${level}`,
123:     line: spec.line,
124:     name: spec.name ?? row.ItemName,
125:     group: spec.group,
126:     number: spec.number,
127:     level,
128:     width: row.X,
129:     height: row.Y,
130:     chaos: spec.chaos,
131:     dailyCap: spec.dailyCap,
132:     note: spec.note,
133:   };
134: }
135: 
136: /**
137:  * The gacha: one price, one roll, rolled and committed when the order is
138:  * placed, so the outcome is bound to a stored seed before the player sees it
139:  * and cannot be shopped for by ordering and cancelling.
140:  *
141:  * Ten chaos is ten squares, still payable straight from the bag, and about a
142:  * hunting session's pickups for a mid-level character. Twelve of them is 120
143:  * chaos, which takes a banked vault as well - but the cap is shaped by the
144:  * bag rather than the wallet: every roll is a 2x2 or 2x3 piece delivered at
145:  * logout into the same inventory, and twelve need about 51 free squares of
146:  * 64. This is the one line whose price does the bounding rather than its cap,
147:  * because it is the only thing here bought for its own sake rather than for
148:  * a fixed need.
149:  *
150:  * The 2x2 here is only the catalogue tile. The real footprint is the roll's
151:  * own width and height, known at placement, and that is what fulfilment fits
152:  * - 31 of the 54 body armours in the pool are 2x3.
153:  */
154: const GACHA: Product = {
155:   id: 'gacha-armour',
156:   line: 'gacha',
157:   name: 'Chaos Armour Roll',
158:   group: null,
159:   number: null,
160:   level: 0,
161:   width: 2,
162:   height: 2,
163:   chaos: 10,
164:   dailyCap: 12,
165:   note: 'A random helm, armour, pants, gloves or boots, +0 to +12. Most are plain; some are excellent.',
166: };
167: 
168: export const CATALOG: Product[] = [...SPECS.map(build), GACHA];
169: 
170: export const LINES: { id: ProductLine; label: string }[] = [
171:   { id: 'wings', label: 'Wings' },
172:   { id: 'quest', label: 'Quest Items' },
173:   { id: 'gacha', label: 'Gacha' },
174: ];
175: 
176: export function productById(id: string): Product | undefined {
177:   return CATALOG.find(product => product.id === id);
178: }
</file>

<file path="cashshop/server/db.ts">
  1: import { Database } from 'bun:sqlite';
  2: import { mkdirSync } from 'node:fs';
  3: import os from 'node:os';
  4: import path from 'node:path';
  5: import type { ProductLine } from './catalog';
  6: import type { Roll } from './gacha';
  7: 
  8: /**
  9:  * The shop's own storage: the order queue, the account-lock journal and the
 10:  * audit log.
 11:  *
 12:  * Deliberately not OpenMU's database, for the same reason the register
 13:  * service keeps its signup log apart: nothing here is game state, and a
 14:  * service that adds tables to a schema EF Core owns and migrates is a service
 15:  * that breaks on the next OpenMU upgrade. The only writes to OpenMU happen
 16:  * inside the fulfilment transaction, one order at a time.
 17:  *
 18:  * Every piece of SQL the shop runs against its own database lives in this
 19:  * file. The rest of the service sees typed `Order`s, never rows.
 20:  */
 21: 
 22: /**
 23:  * Where the file lives. The default is outside the repo on purpose: the
 24:  * production update runs `git clean -fdx` in the checkout
 25:  * (`update_server_igniesDOTnet.md`), which would take a database kept under
 26:  * `cashshop/` with it, orders and all. The path is logged at boot so an
 27:  * operator can find their orders without reading this.
 28:  */
 29: export const DB_PATH = process.env.CASHSHOP_DB || path.join(os.homedir(), '.mu-cashshop', 'shop.sqlite');
 30: 
 31: mkdirSync(path.dirname(DB_PATH), { recursive: true });
 32: 
 33: const db = new Database(DB_PATH, { create: true });
 34: 
 35: // WAL so a CLI can read the queue and the audit log while the server serves.
 36: db.run('PRAGMA journal_mode = WAL');
 37: 
 38: db.run(`
 39:   CREATE TABLE IF NOT EXISTS orders (
 40:     id           TEXT PRIMARY KEY,
 41:     account      TEXT NOT NULL,
 42:     product_id   TEXT NOT NULL,
 43:     product_name TEXT NOT NULL,
 44:     line         TEXT NOT NULL,
 45:     chaos        INTEGER NOT NULL,
 46:     state        TEXT NOT NULL,
 47:     reason       TEXT,
 48:     seed         INTEGER,
 49:     roll_json    TEXT,
 50:     item_id      TEXT,
 51:     placed_at    INTEGER NOT NULL,
 52:     updated_at   INTEGER NOT NULL,
 53:     delivered_at INTEGER
 54:   )
 55: `);
 56: // The delivery tab, the committed-chaos sum and the daily caps all ask by account.
 57: db.run('CREATE INDEX IF NOT EXISTS orders_account_placed ON orders (account, placed_at)');
 58: // The worker asks for the queue in placement order.
 59: db.run('CREATE INDEX IF NOT EXISTS orders_state_placed ON orders (state, placed_at)');
 60: 
 61: db.run(`
 62:   CREATE TABLE IF NOT EXISTS state_locks (
 63:     account_id     TEXT PRIMARY KEY,
 64:     original_state INTEGER NOT NULL,
 65:     locked_at      INTEGER NOT NULL
 66:   )
 67: `);
 68: 
 69: db.run(`
 70:   CREATE TABLE IF NOT EXISTS audit (
 71:     id       INTEGER PRIMARY KEY AUTOINCREMENT,
 72:     at       INTEGER NOT NULL,
 73:     account  TEXT,
 74:     order_id TEXT,
 75:     event    TEXT NOT NULL,
 76:     detail   TEXT
 77:   )
 78: `);
 79: db.run('CREATE INDEX IF NOT EXISTS audit_order ON audit (order_id)');
 80: db.run('CREATE INDEX IF NOT EXISTS audit_at ON audit (at)');
 81: 
 82: console.info(`cash shop orders in ${DB_PATH}`);
 83: 
 84: /* ------------------------------------------------------------------- types */
 85: 
 86: export type OrderState = 'queued' | 'delivering' | 'delivered' | 'failed' | 'cancelled';
 87: 
 88: export interface Order {
 89:   id: string;
 90:   productId: string;
 91:   productName: string;
 92:   line: ProductLine;
 93:   /**
 94:    * The price paid, copied from the catalogue at placement so a later
 95:    * repricing never changes an order already placed.
 96:    */
 97:   chaos: number;
 98:   state: OrderState;
 99:   reason: string | null;
100:   /**
101:    * Committed at placement for the gacha (`roll.seed` is the replay key);
102:    * null for a fixed product.
103:    */
104:   roll: Roll | null;
105:   placedAt: number;
106:   updatedAt: number;
107: }
108: 
109: /** An order as the worker needs it: the wire shape plus whose it is. */
110: export type QueuedOrder = Order & { account: string };
111: 
112: /** What the placement route knows; everything else in the row is derived here. */
113: export interface NewOrder {
114:   account: string;
115:   productId: string;
116:   productName: string;
117:   line: ProductLine;
118:   chaos: number;
119:   roll: Roll | null;
120: }
121: 
122: export interface StateLock {
123:   accountId: string;
124:   originalState: number;
125:   lockedAt: number;
126: }
127: 
128: interface OrderRow {
129:   id: string;
130:   account: string;
131:   product_id: string;
132:   product_name: string;
133:   line: string;
134:   chaos: number;
135:   state: string;
136:   reason: string | null;
137:   seed: number | null;
138:   roll_json: string | null;
139:   item_id: string | null;
140:   placed_at: number;
141:   updated_at: number;
142:   delivered_at: number | null;
143: }
144: 
145: /** The row-to-order boundary: the one place `roll_json` is parsed. */
146: function toOrder(row: OrderRow): Order {
147:   return {
148:     id: row.id,
149:     productId: row.product_id,
150:     productName: row.product_name,
151:     line: row.line as ProductLine,
152:     chaos: row.chaos,
153:     state: row.state as OrderState,
154:     reason: row.reason,
155:     roll: row.roll_json === null ? null : (JSON.parse(row.roll_json) as Roll),
156:     placedAt: row.placed_at,
157:     updatedAt: row.updated_at,
158:   };
159: }
160: 
161: /* -------------------------------------------------------------- statements */
162: 
163: const ORDER_COLUMNS =
164:   'id, account, product_id, product_name, line, chaos, state, reason, seed, roll_json, ' +
165:   'item_id, placed_at, updated_at, delivered_at';
166: 
167: const selectOrder = db.query<OrderRow, [string]>(
168:   `SELECT ${ORDER_COLUMNS} FROM orders WHERE id = ?`
169: );
170: 
171: const selectOrdersFor = db.query<OrderRow, [string]>(
172:   `SELECT ${ORDER_COLUMNS} FROM orders WHERE account = ? ORDER BY placed_at DESC, id DESC`
173: );
174: 
175: const selectQueued = db.query<OrderRow, []>(
176:   `SELECT ${ORDER_COLUMNS} FROM orders WHERE state = 'queued' ORDER BY placed_at ASC, id ASC`
177: );
178: 
179: const selectDelivering = db.query<OrderRow, []>(
180:   `SELECT ${ORDER_COLUMNS} FROM orders WHERE state = 'delivering' ORDER BY updated_at ASC, id ASC`
181: );
182: 
183: interface AuditRow {
184:   id: number;
185:   at: number;
186:   account: string | null;
187:   event: string;
188:   detail: string | null;
