 10: /**
 11:  * Drives one bot by hand, for proving the stack against a real server.
 12:  *
 13:  * The bot dials a game server port directly rather than going through the
 14:  * connect server, deliberately: the connect server hands out the address the
 15:  * server config advertises, which on a local box is the operator's public IP,
 16:  * not localhost.
 17:  *
 18:  *   bun run marketplace/bot/cli.ts enter  --account MKT001
 19:  *   bun run marketplace/bot/cli.ts watch  --account MKT001 --seconds 30
 20:  *   bun run marketplace/bot/cli.ts trace  --account MKT001 --target <character>
 21:  *   bun run marketplace/bot/cli.ts simulate --seller MKT001 --buyer MKT002
 22:  *   bun run marketplace/bot/cli.ts escrow --op list --bot MKT001 --player MKT002
 23:  *   bun run marketplace/bot/cli.ts ledger
 24:  *   bun run marketplace/bot/cli.ts return --account MKT001 --to <character>
 25:  */
 26: 
 27: const HOST = process.env.GAME_HOST ?? '127.0.0.1';
 28: const PORT = Number(process.env.GAME_PORT ?? 55901);
 29: 
 30: function arg(name: string, fallback?: string): string | undefined {
 31:   const i = process.argv.indexOf(`--${name}`);
 32:   return i >= 0 && process.argv[i + 1] ? process.argv[i + 1] : fallback;
 33: }
