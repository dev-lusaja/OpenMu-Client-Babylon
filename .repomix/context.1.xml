  1: import { describe, expect, it } from 'vitest';
  2: import { ServerMessages } from './serverMessages';
  3: import type { BotConnection, Frame, FrameHandler } from './connection';
  4: import {
  5:   ServerMessagePacket,
  6:   ServerMessageMessageTypeEnum,
  7: } from '../../src/common/packets/ServerToClientPackets';
  8: import { codeOf } from './wire';
  9: 
 10: /**
 11:  * These exist because the silence they replace cost a night. A `/trace` that
 12:  * the server refused looked exactly like a `/trace` that was never sent, and
 13:  * the one thing that could tell the two apart was the message the bot was
 14:  * throwing away.
 15:  */
 16: class FakeConnection {
 17:   private readonly handlers: FrameHandler[] = [];
 18: 
 19:   on(handler: FrameHandler): () => void {
 20:     this.handlers.push(handler);
 21:     return () => {
 22:       const i = this.handlers.indexOf(handler);
 23:       if (i >= 0) this.handlers.splice(i, 1);
 24:     };
 25:   }
 26: 
 27:   deliver(bytes: Uint8Array): void {
 28:     const { code, sub } = codeOf(bytes);
 29:     for (const handler of [...this.handlers]) handler({ code, sub, bytes });
 30:   }
 31: }
 32: 
 33: function serverMessage(text: string, type = ServerMessageMessageTypeEnum.BlueNormal) {
 34:   // Header, length, code, type, then the text. The generated getRequiredSize
 35:   // counts from the code and leaves no room for the type byte between them.
 36:   const packet = ServerMessagePacket.createPacket(4 + text.length);
 37:   packet.Type = type;
 38:   const bytes = new Uint8Array(packet.buffer.buffer);
 39:   // The message is the tail of the packet, one byte past the type.
 40:   for (let i = 0; i < text.length; i++) bytes[4 + i] = text.charCodeAt(i);
 41:   return bytes;
 42: }
 43: 
 44: const setup = () => {
 45:   const connection = new FakeConnection();
 46:   const lines: string[] = [];
 47:   const messages = new ServerMessages(
 48:     connection as unknown as BotConnection,
 49:     (m: string) => lines.push(m)
 50:   );
 51:   return { connection, lines, messages };
 52: };
 53: 
 54: describe('ServerMessages', () => {
 55:   it('writes what the server said into the log', () => {
 56:     const { connection, lines } = setup();
 57: 
 58:     connection.deliver(serverMessage('Character not found.'));
 59: 
 60:     expect(lines).toHaveLength(1);
 61:     expect(lines[0]).toContain('Character not found.');
 62:   });
 63: 
 64:   it('keeps the last one, for a failure that wants to quote it', () => {
 65:     const { connection, messages } = setup();
 66: 
 67:     connection.deliver(serverMessage('First.'));
 68:     connection.deliver(serverMessage('Character not found.'));
 69: 
 70:     expect(messages.latest).toBe('Character not found.');
 71:   });
 72: 
 73:   it('says which kind it was, because golden and blue mean different things', () => {
 74:     const { connection, lines } = setup();
 75: 
 76:     connection.deliver(
 77:       serverMessage('Server restarting.', ServerMessageMessageTypeEnum.GoldenCenter)
 78:     );
 79: 
 80:     expect(lines[0]).toContain('golden');
 81:   });
 82: 
 83:   it('ignores every other packet', () => {
 84:     const { connection, lines } = setup();
 85: 
 86:     // A scope update, which shares nothing with 0x0D but the header byte.
 87:     connection.deliver(new Uint8Array([0xc1, 0x08, 0x12, 0x01, 0, 0, 0, 0]));
 88: 
 89:     expect(lines).toHaveLength(0);
 90:   });
 91: 
 92:   it('stops listening once disposed', () => {
 93:     const { connection, lines, messages } = setup();
 94: 
 95:     messages.dispose();
 96:     connection.deliver(serverMessage('Character not found.'));
 97: 
 98:     expect(lines).toHaveLength(0);
 99:   });
100: });
