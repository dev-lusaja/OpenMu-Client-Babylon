  1: import {
  2:   CharacterInformationPacket,
  3:   InventoryMoneyUpdatePacket,
  4:   ItemAddedToInventoryPacket,
  5: } from '../../src/common/packets/ServerToClientPackets';
  6: import type { BotConnection, Frame } from './connection';
  7: import { view } from './session';
  8: 
  9: /**
 10:  * What the bot is holding, as the server last reported it.
 11:  *
 12:  * The bot needs its own balance for one reason: to check afterwards that a
 13:  * handover moved what it was supposed to move. The server destroys Zen left on
 14:  * a cancelled trade
 15:  * (`issues/trade/zen_destroyed_when_a_trade_is_cancelled.md`), and a bot
 16:  * carrying a float has no way to notice that from its own books unless it is
 17:  * watching the number the server reports.
 18:  *
 19:  * `InventoryMoneyUpdate` (0x22/0xFE) is the server telling us the balance
 20:  * outright, so nothing here adds up deltas of its own - the whole point is to
 21:  * compare our arithmetic against the server's truth.
 22:  */
 23: 
 24: const CODE = {
 25:   moneyUpdate: { code: 0x22, sub: 0xfe },
 26:   itemAdded: { code: 0x22 },
 27:   /** Sent on entering the world, and the only packet that states the opening balance. */
 28:   characterInformation: { code: 0xf3, sub: 0x03 },
 29: } as const;
 30: 
 31: export class Wallet {
 32:   /** Zen the server last told us we have; null until it has said so. */
 33:   zen: number | null = null;
 34:   /** Items the server has told us arrived, since the last reset. */
 35:   itemsReceived = 0;
 36: 
 37:   private readonly unsubscribe: () => void;
 38: 
 39:   constructor(
 40:     connection: BotConnection,
 41:     private readonly log: (message: string) => void = () => {}
 42:   ) {
 43:     this.unsubscribe = connection.on(frame => this.handle(frame));
 44:   }
 45: 
 46:   dispose(): void {
 47:     this.unsubscribe();
 48:   }
 49: 
 50:   resetItemCount(): void {
 51:     this.itemsReceived = 0;
 52:   }
 53: 
 54:   /**
 55:    * Waits for the server to state a balance. Called once after entering the
 56:    * world: a bot that starts a handover without knowing its balance cannot
 57:    * reconcile it afterwards, and would rather refuse than guess.
 58:    */
 59:   async waitForBalance(timeoutMs = 15_000): Promise<number> {
 60:     const deadline = Date.now() + timeoutMs;
 61:     while (this.zen === null) {
 62:       if (Date.now() >= deadline) {
 63:         throw new Error('the server never reported the wallet balance');
 64:       }
 65:       await new Promise(resolve => setTimeout(resolve, 200));
 66:     }
 67:     return this.zen;
 68:   }
 69: 
 70:   private handle(frame: Frame): void {
 71:     // The opening balance. `InventoryMoneyUpdate` is only sent when the money
 72:     // *changes*, so without this the bot would not know what it holds until
 73:     // its first trade moved some - too late to reconcile that trade.
 74:     if (
 75:       frame.code === CODE.characterInformation.code &&
 76:       frame.sub === CODE.characterInformation.sub
 77:     ) {
 78:       try {
 79:         const money = new CharacterInformationPacket(view(frame)).Money;
 80:         this.zen = money;
 81:         this.log(`wallet: opening balance ${money} Zen`);
 82:       } catch {
 83:         // A layout we cannot read; `waitForBalance` will time out and say so.
 84:       }
 85:       return;
 86:     }
 87: 
 88:     if (frame.code === CODE.moneyUpdate.code && frame.sub === CODE.moneyUpdate.sub) {
 89:       const money = new InventoryMoneyUpdatePacket(view(frame)).Money;
 90:       if (this.zen !== money) this.log(`wallet: ${this.zen ?? '?'} -> ${money} Zen`);
 91:       this.zen = money;
 92:       return;
 93:     }
 94: 
 95:     // Same code, no sub-code: an item landed in the bag.
 96:     if (frame.code === CODE.itemAdded.code && frame.sub !== CODE.moneyUpdate.sub) {
 97:       try {
 98:         new ItemAddedToInventoryPacket(view(frame));
 99:         this.itemsReceived++;
100:       } catch {
101:         // Not the layout we expected; the money check is the one that matters.
102:       }
103:     }
104:   }
105: }
</file>

