290:       return mismatch;
291:     }
292:     this.setConfirm(true);
293:     return null;
294:   }
295: 
296:   /**
297:    * Waits for the partner to put up what was agreed.
298:    *
299:    * A person takes seconds to drag an item across, so every escrow operation
300:    * has to wait rather than read the table once and refuse. Resolves as soon
301:    * as the table matches; rejects on the deadline, and the caller cancels.
302:    */
303:   async waitForTerms(terms: TradeTerms, timeoutMs = 60_000): Promise<void> {
304:     const deadline = Date.now() + timeoutMs;
305:     for (;;) {
306:       if (this.mismatch(terms) === null) return;
307:       if (!this.open) throw new Error('the trade closed before the terms were met');
308:       if (Date.now() >= deadline) {
309:         throw new Error(`the terms were not met within ${Math.round(timeoutMs / 1000)}s`);
310:       }
311:       await new Promise(resolve => setTimeout(resolve, 250));
312:     }
313:   }
314: 
315:   /** Why the table does not match the terms, or null when it does. */
316:   mismatch(terms: TradeTerms): string | null {
317:     if (terms.expectMoney !== undefined && this.theirMoney !== terms.expectMoney) {
318:       return `expected ${terms.expectMoney} Zen on the table, found ${this.theirMoney}`;
319:     }
320:     if (terms.expectItems !== undefined && this.theirItems.size !== terms.expectItems) {
321:       return `expected ${terms.expectItems} item(s) on the table, found ${this.theirItems.size}`;
322:     }
323:     if (terms.expectOwnItems !== undefined && this.myItems.size !== terms.expectOwnItems) {
324:       return `expected ${terms.expectOwnItems} of our item(s) on the table, found ${this.myItems.size}`;
325:     }
326:     if (terms.expectItemMatching !== undefined) {
327:       for (const data of this.theirItems.values()) {
328:         if (!terms.expectItemMatching(data)) return 'the item on the table is not the one listed';
329:       }
330:     }
331:     if (terms.expectOwnMoney !== undefined && this.myMoney !== terms.expectOwnMoney) {
332:       return `expected ${terms.expectOwnMoney} of our Zen on the table, found ${this.myMoney}`;
333:     }
334:     return null;
335:   }
336: 
337:   private handle(frame: Frame): void {
338:     switch (frame.code) {
339:       case CODE.itemAdded.code: {
340:         const p = new TradeItemAddedPacket(view(frame));
341:         this.theirItems.set(p.ToSlot, new Uint8Array(p.ItemData.buffer.slice(0)));
342:         // Any change clears both accept boxes server side; mirror it so we
343:         // never believe a stale agreement.
344:         this.theirConfirm = false;
345:         break;
346:       }
347:       case CODE.itemMoved.code: {
348:         // The server's answer to our own move. It is only ever sent for a
349:         // move that happened, so a refused one leaves the table as it was and
350:         // `expectOwnItems` catches it.
351:         const p = new ItemMovedPacket(view(frame));
352:         if (p.TargetStorageType === StorageKind.Trade) {
353:           this.myItems.add(p.TargetSlot);
354:           this.theirConfirm = false;
355:         } else {
356:           // Moved back off the table, or somewhere else entirely.
357:           this.myItems.delete(p.TargetSlot);
358:         }
359:         break;
360:       }
361:       case CODE.itemReceived.code: {
362:         if (frame.sub === MONEY_SUB) break;
363:         const p = new ItemAddedToInventoryPacket(view(frame));
364:         this.receivedSlots.push(p.InventorySlot);
365:         break;
366:       }
367:       case CODE.moneyUpdate.code: {
368:         const p = new TradeMoneyUpdatePacket(view(frame));
369:         this.theirMoney = p.MoneyAmount;
370:         this.theirConfirm = false;
371:         break;
372:       }
373:       case CODE.moneySet.code: {
374:         // Only ever sent for an offer the server accepted.
375:         this.myMoney = this.offeredMoney;
376:         this.theirConfirm = false;
377:         break;
378:       }
379:       case CODE.buttonState.code: {
380:         // The two directions have their own enums with the same values; this
381:         // one is the server's.
382:         const p = new TradeButtonStateChangedPacket(view(frame));
383:         this.theirConfirm = p.State === TradeButtonStateChangedTradeButtonStateEnum.Checked;
384:         break;
385:       }
386:       case CODE.finished.code: {
387:         const result = new TradeFinishedPacket(view(frame)).Result;
388:         this.open = false;
389:         const ok = result === TradeFinishedTradeResultEnum.Success;
390:         this.log(`trade finished: ${TradeFinishedTradeResultEnum[result] ?? result}`);
391:         this.finished?.(
392:           ok
393:             ? { ok: true }
394:             : {
395:                 ok: false,
396:                 result,
397:                 reason: TradeFinishedTradeResultEnum[result] ?? `result ${result}`,
398:               }
399:         );
400:         break;
401:       }
402:       default:
403:         break;
404:     }
405:   }
406: }
