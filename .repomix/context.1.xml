<file path="ops/server/migrations/001_cheat_warnings.sql">
 1: -- The cheat-warning log.
 2: --
 3: -- OpenMU already notices around two dozen things a normal client cannot do -
 4: -- attacking from a safe zone, repairing without an NPC, combining jewels
 5: -- without Lahap - and writes each one through Serilog as a warning. The stock
 6: -- deployment sends those to rolling text files, which roll away and cannot be
 7: -- asked a question. This table is where they are kept and counted.
 8: --
 9: -- Apply with:
10: --   sqlite3 /var/lib/mu-ops/ops.sqlite < 001_cheat_warnings.sql
11: --
12: -- Idempotent: safe to re-apply.
13: 
14: -- `template` is OpenMU's Serilog message template, which is a literal in its
15: -- source and therefore a stable key for "which check tripped". `message` is
16: -- that template with its values filled in, kept so an operator reads a
17: -- sentence rather than a template. `properties` is the raw JSON of the
18: -- structured values, so a question nobody thought to ask yet can still be
19: -- answered.
20: CREATE TABLE IF NOT EXISTS cheat_warnings (
21:   id         INTEGER PRIMARY KEY AUTOINCREMENT,
22:   at         INTEGER NOT NULL,
23:   signal     TEXT NOT NULL,
24:   severity   TEXT NOT NULL,
25:   account    TEXT,
26:   character  TEXT,
27:   message    TEXT NOT NULL,
28:   template   TEXT NOT NULL,
29:   properties TEXT NOT NULL
30: );
31: 
32: CREATE INDEX IF NOT EXISTS cheat_warnings_at ON cheat_warnings (at DESC);
33: CREATE INDEX IF NOT EXISTS cheat_warnings_signal ON cheat_warnings (signal, at DESC);
34: CREATE INDEX IF NOT EXISTS cheat_warnings_account ON cheat_warnings (account, at DESC);
35: CREATE INDEX IF NOT EXISTS cheat_warnings_character ON cheat_warnings (character, at DESC);
36: 
37: -- Where the reader had got to in each log file, so a restart does not
38: -- re-ingest what it already has. Keyed by file, because Serilog rolls daily
39: -- and on size.
40: CREATE TABLE IF NOT EXISTS ingest_progress (
41:   file    TEXT PRIMARY KEY,
42:   offset  INTEGER NOT NULL,
43:   seen_at INTEGER NOT NULL
44: );
</file>

<file path="ops/server/db.ts">
  1: import { Database } from 'bun:sqlite';
  2: import { join } from 'node:path';
  3: import { migrate } from '../../tools/sqliteMigrate';
  4: import type { CheatEvent } from './ingest';
  5: 
  6: /**
  7:  * The operations console's own storage.
  8:  *
  9:  * Deliberately not OpenMU's database and not the register service's: this
 10:  * holds what was *observed*, which is neither game state nor a gate, and
 11:  * keeping it separate means nothing here can corrupt an account.
 12:  *
 13:  * The schema lives in `migrations/`. Those files are the exact statements to
 14:  * run against the production database, and the same ones this applies on a
 15:  * fresh box, so the two cannot drift.
 16:  */
 17: 
 18: const DB_PATH = process.env.OPS_DB_PATH || '/var/lib/mu-ops/ops.sqlite';
 19: 
 20: export const db = new Database(DB_PATH, { create: true });
 21: 
 22: db.run('PRAGMA journal_mode = WAL');
 23: 
 24: const applied = migrate(db, join(import.meta.dir, 'migrations'));
 25: if (applied.length > 0) {
 26:   console.info(`applied ${applied.length} migration(s): ${applied.join(', ')}`);
 27: }
 28: 
 29: /* ---------------------------------------------------------- cheat warnings */
 30: 
 31: export type CheatWarningRow = CheatEvent & { id: number };
 32: 
 33: const insertWarning = db.query<
 34:   unknown,
 35:   [number, string, string, string | null, string | null, string, string, string]
 36: >(`
 37:   INSERT INTO cheat_warnings (at, signal, severity, account, character, message, template, properties)
 38:   VALUES (?, ?, ?, ?, ?, ?, ?, ?)
 39: `);
 40: 
 41: export function recordCheatWarnings(events: readonly CheatEvent[]): number {
 42:   if (events.length === 0) return 0;
 43: 
 44:   // One transaction for the batch: a log read either lands whole or not at
 45:   // all, which is what makes the saved offset safe to trust.
 46:   db.transaction(() => {
 47:     for (const event of events) {
 48:       insertWarning.run(
 49:         event.at,
 50:         event.signal,
 51:         event.severity,
 52:         event.account,
 53:         event.character,
 54:         event.message,
 55:         event.template,
 56:         event.properties
 57:       );
 58:     }
 59:   })();
 60: 
 61:   return events.length;
 62: }
 63: 
 64: const recentWarnings = db.query<CheatWarningRow, [number]>(
 65:   'SELECT * FROM cheat_warnings ORDER BY at DESC LIMIT ?'
 66: );
 67: 
 68: const warningsBySignal = db.query<CheatWarningRow, [string, number]>(
 69:   'SELECT * FROM cheat_warnings WHERE signal = ? ORDER BY at DESC LIMIT ?'
 70: );
 71: 
 72: const warningsByWho = db.query<CheatWarningRow, [string, string, number]>(`
 73:   SELECT * FROM cheat_warnings
 74:   WHERE lower(account) = lower(?) OR lower(character) = lower(?)
 75:   ORDER BY at DESC LIMIT ?
 76: `);
 77: 
 78: export function readCheatWarnings(
 79:   limit: number,
 80:   filter?: { signal?: string; who?: string }
 81: ): CheatWarningRow[] {
 82:   if (filter?.who) return warningsByWho.all(filter.who, filter.who, limit);
 83:   if (filter?.signal) return warningsBySignal.all(filter.signal, limit);
 84:   return recentWarnings.all(limit);
 85: }
 86: 
 87: /** Who tripped the most checks lately - the question an operator actually asks. */
 88: const offenders = db.query<
 89:   { who: string; hits: number; hard: number; last_at: number },
 90:   [number, number]
 91: >(`
 92:   SELECT
 93:     COALESCE(character, account) AS who,
 94:     COUNT(*) AS hits,
 95:     SUM(CASE WHEN severity = 'hard' THEN 1 ELSE 0 END) AS hard,
 96:     MAX(at) AS last_at
 97:   FROM cheat_warnings
 98:   WHERE at > ? AND COALESCE(character, account) IS NOT NULL
 99:   GROUP BY who
100:   ORDER BY hard DESC, hits DESC
101:   LIMIT ?
102: `);
103: 
104: export function readOffenders(since: number, limit: number) {
105:   return offenders.all(since, limit);
106: }
107: 
108: /* -------------------------------------------------------- ingest progress */
109: 
110: const readProgress = db.query<{ offset: number }, [string]>(
111:   'SELECT offset FROM ingest_progress WHERE file = ?'
112: );
113: 
114: const writeProgress = db.query<unknown, [string, number, number]>(`
115:   INSERT INTO ingest_progress (file, offset, seen_at) VALUES (?, ?, ?)
116:   ON CONFLICT (file) DO UPDATE SET offset = excluded.offset, seen_at = excluded.seen_at
117: `);
118: 
119: export function offsetOf(file: string): number {
120:   return readProgress.get(file)?.offset ?? 0;
121: }
122: 
123: export function rememberOffset(file: string, offset: number): void {
124:   writeProgress.run(file, offset, Date.now());
125: }
</file>

