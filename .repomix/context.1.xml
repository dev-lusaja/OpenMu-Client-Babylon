<file path="ops/server/ingest.ts">
  1: import { signalFor } from './signals';
  2: 
  3: /**
  4:  * Turning OpenMU's log into rows.
  5:  *
  6:  * OpenMU logs through Serilog. The stock deployment writes rolling **text**
  7:  * files, which a person can read and nothing can query - so the deployment
  8:  * gains one more sink writing Serilog's compact JSON, one event per line, and
  9:  * this reads that. It is a configuration change on the server host
 10:  * (`appsettings.json`), not a fork: see `documentation/ops_console/ARCHITECTURE.md`.
 11:  *
 12:  * Nothing here trusts the log's *text*. Classification is by `@mt`, the
 13:  * message template, which is a literal in OpenMU's source - so a player named
 14:  * "Probably Hacker" cannot write themselves into this table by saying their
 15:  * own name.
 16:  */
 17: 
 18: /** One line of Serilog's compact JSON. */
 19: type CompactEvent = {
 20:   /** Timestamp, ISO 8601. */
 21:   '@t'?: unknown;
 22:   /** Message template. */
 23:   '@mt'?: unknown;
 24:   /** Level; absent means Information. */
 25:   '@l'?: unknown;
 26:   [property: string]: unknown;
 27: };
 28: 
 29: export type CheatEvent = {
 30:   at: number;
 31:   signal: string;
 32:   severity: string;
 33:   account: string | null;
 34:   character: string | null;
 35:   message: string;
 36:   template: string;
 37:   properties: string;
 38: };
 39: 
 40: /** Serilog property placeholders: `{Name}`, `{0}`, `{@Thing}`, `{Name,-10:000}`. */
 41: const PLACEHOLDER = /\{([@$]?)([A-Za-z0-9_]+)(?:,-?\d+)?(?::[^}]*)?\}/g;
 42: 
 43: /**
 44:  * The template with its values filled in, so a reader gets a sentence.
 45:  * `{{` and `}}` are Serilog's escapes for literal braces.
 46:  */
 47: export function render(template: string, properties: Record<string, unknown>): string {
 48:   return template
 49:     .replace(PLACEHOLDER, (whole, _sigil: string, name: string) => {
 50:       const value = properties[name];
 51:       if (value === undefined || value === null) return whole;
 52:       return typeof value === 'object' ? JSON.stringify(value) : String(value);
 53:     })
 54:     .replace(/\{\{/g, '{')
 55:     .replace(/\}\}/g, '}');
 56: }
 57: 
 58: /**
 59:  * The player names in `{Player}` are the whole player object, which OpenMU
 60:  * renders as `character (account)` or just the account before a character is
 61:  * selected. Pulled apart so the table can be asked about either.
 62:  */
 63: function splitPlayer(rendered: string): { character: string | null; account: string | null } {
 64:   const match = /^(.*?)\s*\(([^()]*)\)\s*$/.exec(rendered.trim());
 65:   if (!match) return { character: rendered.trim() || null, account: null };
 66:   return { character: match[1] || null, account: match[2] || null };
 67: }
 68: 
 69: /** Read one JSON line into a row, or nothing when it is not a cheat warning. */
 70: export function parseLine(line: string): CheatEvent | null {
 71:   const trimmed = line.trim();
 72:   if (!trimmed) return null;
 73: 
 74:   let event: CompactEvent;
 75:   try {
 76:     event = JSON.parse(trimmed) as CompactEvent;
 77:   } catch {
 78:     // A half-written last line while the server is mid-flush. The offset is
 79:     // only advanced past complete lines, so it will be read again whole.
 80:     return null;
 81:   }
 82: 
 83:   const template = typeof event['@mt'] === 'string' ? event['@mt'] : null;
 84:   if (!template) return null;
 85: 
 86:   const signal = signalFor(template);
 87:   if (!signal) return null;
 88: 
 89:   const properties: Record<string, unknown> = {};
 90:   for (const [key, value] of Object.entries(event)) {
 91:     if (!key.startsWith('@')) properties[key] = value;
 92:   }
 93: 
 94:   const at = typeof event['@t'] === 'string' ? Date.parse(event['@t']) : Number.NaN;
 95: 
 96:   let account = signal.account ? stringOf(properties[signal.account]) : null;
 97:   let character = signal.character ? stringOf(properties[signal.character]) : null;
 98: 
 99:   // `{Player}` is the player object, not a name.
100:   if (character && !account && /\(.*\)/.test(character)) {
101:     const split = splitPlayer(character);
102:     character = split.character;
103:     account = split.account;
104:   }
105: 
106:   return {
107:     at: Number.isFinite(at) ? at : Date.now(),
108:     signal: signal.id,
109:     severity: signal.severity,
110:     account,
111:     character,
112:     message: render(template, properties),
113:     template,
114:     properties: JSON.stringify(properties),
115:   };
116: }
117: 
118: function stringOf(value: unknown): string | null {
119:   if (value === undefined || value === null) return null;
120:   const text = String(value).trim();
121:   return text || null;
122: }
123: 
124: /** Every cheat warning in a chunk of log, and how many bytes were consumed. */
125: export function parseChunk(text: string): { events: CheatEvent[]; consumed: number } {
126:   const events: CheatEvent[] = [];
127:   let consumed = 0;
128: 
129:   // Only whole lines: a trailing partial line is left for the next read, so a
130:   // record split across two reads is never dropped or counted twice.
131:   let start = 0;
132:   for (;;) {
133:     const end = text.indexOf('\n', start);
134:     if (end < 0) break;
135: 
136:     const event = parseLine(text.slice(start, end));
137:     if (event) events.push(event);
138: 
139:     start = end + 1;
140:     consumed = Buffer.byteLength(text.slice(0, start), 'utf8');
141:   }
142: 
143:   return { events, consumed };
144: }
</file>

<file path="ops/server/opsCli.ts">
 1: import { readAccountLog } from '../../register/server/db';
 2: import { readCheatWarnings, readOffenders } from './db';
 3: import { ingestOnce, follow } from './reader';
 4: 
 5: /**
 6:  * The operations console from a terminal.
 7:  *
 8:  * The console's HTTP service and its in-game window come with the identity
 9:  * decision that gates them (`documentation/ops_console/ARCHITECTURE.md`).
10:  * Until then the data is already being collected, and this is how an operator
11:  * reads it: over ssh, as the person who already has the box.
12:  *
13:  *   bun run ops-ingest              one pass over the log, then stop
14:  *   bun run ops-follow              keep following the log
15:  *   bun run ops warnings [n]        the newest cheat warnings
16:  *   bun run ops who [days] [n]      who tripped the most checks
17:  *   bun run ops accounts [n]        the newest registrations
18:  */
19: 
20: const [command, ...args] = process.argv.slice(2);
21: 
22: const num = (value: string | undefined, fallback: number): number => {
23:   const parsed = Number(value);
24:   return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;
25: };
26: 
27: const when = (at: number): string => new Date(at).toISOString().replace('T', ' ').slice(0, 19);
28: 
29: switch (command) {
30:   case 'ingest': {
31:     const filed = await ingestOnce();
32:     console.info(`filed ${filed} cheat warning(s)`);
33:     break;
34:   }
35: 
36:   case 'follow':
37:     follow();
38:     break;
39: 
40:   case 'warnings': {
41:     const rows = readCheatWarnings(num(args[0], 30));
42:     if (rows.length === 0) console.info('nothing recorded');
43:     for (const row of rows) {
44:       const who = row.character ?? row.account ?? '?';
45:       console.info(`${when(row.at)}  ${row.severity.padEnd(4)}  ${who.padEnd(14)}  ${row.message}`);
46:     }
47:     break;
48:   }
49: 
50:   case 'who': {
51:     const since = Date.now() - num(args[0], 7) * 24 * 60 * 60 * 1000;
52:     const rows = readOffenders(since, num(args[1], 20));
53:     if (rows.length === 0) console.info('nobody tripped a check in that window');
54:     for (const row of rows) {
55:       console.info(
56:         `${row.who.padEnd(16)}  ${String(row.hits).padStart(4)} hits  ${String(row.hard).padStart(4)} hard  last ${when(row.last_at)}`
57:       );
58:     }
59:     break;
60:   }
61: 
62:   case 'accounts': {
63:     const rows = readAccountLog(num(args[0], 30));
64:     if (rows.length === 0) console.info('no registrations recorded yet');
65:     for (const row of rows) {
66:       console.info(`${when(row.at)}  ${row.login_name.padEnd(14)}  ${row.bucket}`);
67:     }
68:     break;
69:   }
70: 
71:   default:
