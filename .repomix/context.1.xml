136: let weather: WeatherState = CLEAR;
137: let lastBroadcast = 0;
138: 
139: function sendWeather(ws: ServerWebSocket<RelayData>, state: WeatherState) {
140:   ws.send(weatherPacket(state));
141: }
142: 
143: function tickWeather() {
144:   const now = Date.now();
145:   const next = currentWeather(now);
146:   const changed = next.kind !== weather.kind || next.variation !== weather.variation;
147: 
148:   if (changed) {
149:     console.log(
150:       `weather: ${next.kind === 0 ? "clear" : `rain ${next.variation}/15`}`
151:     );
152:   }
153: 
154:   weather = next;
155: 
156:   if (!changed && now - lastBroadcast < WEATHER_HEARTBEAT_MS) return;
157: 
158:   lastBroadcast = now;
159:   for (const ws of clients) sendWeather(ws, weather);
160: }
161: 
162: if (WEATHER_ENABLED) {
163:   weather = currentWeather(Date.now());
164:   setInterval(tickWeather, WEATHER_TICK_MS);
165:   console.log(
166:     weatherForced
