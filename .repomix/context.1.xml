196: /** The signal a message template stands for, or nothing when it is not one. */
197: export function signalFor(template: string): Signal | undefined {
198:   const exact = SIGNALS[template];
199:   if (exact) return exact;
200: 
201:   return SIGNAL_PREFIXES.find(([prefix]) => template.startsWith(prefix))?.[1];
202: }
