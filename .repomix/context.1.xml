262: 
263:   /**
264:    * Confirms only when the table matches `terms`, then waits for the server's
265:    * verdict. This is the check that makes an automated trade safe to run
266:    * without a human watching it: a partner who changes the offer after we
267:    * agreed clears both accept boxes server side, and we re-check before
268:    * ticking ours again.
269:    */
270:   async settle(terms: TradeTerms, timeoutMs = 60_000): Promise<TradeOutcome> {
271:     const finish = this.waitForFinish(timeoutMs);
272:     const mismatch = this.armConfirm(terms);
273:     if (mismatch !== null) return { ok: false, reason: mismatch };
274:     return finish;
275:   }
276: 
277:   /**
278:    * Ticks the accept box if the table matches, and cancels if it does not.
279:    * Returns the reason it refused, or null when the confirm went out.
280:    *
281:    * Split from `settle` because the two sides must confirm one after the
282:    * other, not together: the server finishes the trade on whichever confirm
283:    * arrives second, and it only sees the second one if the first has already
284:    * moved that player into `TradeButtonPressed`.
