 994:   /**
 995:    * Steps 1 to 5 and 14 to 15 for one account, with every one of its queued
 996:    * orders run through steps 6 to 13 in between, oldest first.
 997:    */
 998:   private async deliverAccount(loginName: string, orders: QueuedOrder[]): Promise<void> {
 999:     const resolved = await this.resolveOnce();
1000:     const first = await this.gate.check(loginName);
1001: 
1002:     if (!first.safe) {
1003:       this.defer(loginName, orders, first, 'delivery deferred');
1004:       return;
1005:     }
1006: 
1007:     const account = await this.gate.findAccount(loginName);
1008: 
1009:     if (!account) {
1010:       const words = 'The shop cannot find your account right now. It will keep trying.';
1011:       for (const order of orders) this.wait(order, words);
1012:       return;
1013:     }
1014: 
1015:     if (account.state !== ACCOUNT_NORMAL) {
1016:       // A GM, a spectator or a banned account is refused outright: the lock
1017:       // below rewrites State, and the shop must never be able to unban.
1018:       const words = 'Your account is not in a state the shop can deliver to.';
1019:       for (const order of orders) this.wait(order, words);
1020:       audit('delivery refused', {
1021:         account: loginName,
1022:         detail: { state: account.state, orders: orders.map(order => order.id) },
1023:       });
1024:       return;
1025:     }
1026: 
1027:     const locked = this.config.fulfil ? await this.lock(account) : true;
1028: 
1029:     if (!locked) {
1030:       const words = 'Your account changed while the shop was checking it. It will try again.';
1031:       for (const order of orders) this.wait(order, words);
1032:       return;
1033:     }
1034: 
1035:     let pass: { verdict: GateVerdict; committed: number } | null;
1036: 
1037:     try {
1038:       pass = await this.deliverLocked(resolved, account, loginName, orders);
1039:     } finally {
1040:       if (this.config.fulfil) await this.unlock(account);
1041:     }
1042: 
1043:     if (!pass) return;
1044: 
1045:     // Step 15: the same three questions again. The write-recency signal is
1046:     // expected to have flipped - the commits above are writes to this
1047:     // account's items - so it is recorded rather than flagged; presence and
1048:     // the store flag changing is what would mean a session slipped through.
1049:     const after = await this.gate.check(loginName);
1050:     const flipped = after.signals
1051:       .filter(signal => signal.name === 'presence' || signal.name === 'personalStore')
1052:       .filter(signal => !signal.safe);
1053: 
1054:     audit(flipped.length ? 'post-commit anomaly' : 'post-commit check', {
1055:       account: loginName,
1056:       detail: { committed: pass.committed, before: signalsOf(pass.verdict), after: signalsOf(after) },
1057:     });
1058: 
1059:     if (flipped.length) {
1060:       console.error(
1061:         `post-commit anomaly for ${loginName}: ` +
1062:           flipped.map(signal => `${signal.name}: ${signal.reason}`).join('; ')
1063:       );
1064:     }
1065:   }
1066: 
1067:   /**
1068:    * Steps 6 to 13 for each order, behind the reading that counts. The check
1069:    * before the lock bought a cheap refusal and nothing more: its presence
1070:    * answer was taken seconds before `State` changed, and a login whose frame
1071:    * passed the proxy in between is loaded by OpenMU with `State` still
1072:    * Normal, which the lock does not undo. Now that no login can start, every
1073:    * session that did start is one the proxy already knows about, one way or
1074:    * the other: a login OpenMU has answered is named (the proxy names a socket
1075:    * off the server's Okay, and reads it in the same handler that forwards
1076:    * it), and one it has accepted but not yet answered is still a pending
1077:    * claim, which the proxy counts as unidentified and the gate refuses for
1078:    * everyone. So a second reading is authoritative. It fails closed like the
1079:    * first, and the whole pass waits for the next poll.
1080:    */
1081:   private async deliverLocked(
1082:     resolved: Resolved,
1083:     account: AccountRow,
1084:     loginName: string,
1085:     orders: QueuedOrder[]
1086:   ): Promise<{ verdict: GateVerdict; committed: number } | null> {
1087:     const verdict = await this.gate.check(loginName);
1088: 
1089:     if (!verdict.safe) {
1090:       this.defer(loginName, orders, verdict, 'delivery deferred after lock');
1091:       return null;
1092:     }
1093: 
1094:     let committed = 0;
1095: 
1096:     for (const order of orders) {
1097:       if (this.stopped) break;
1098:       if (await this.deliverOrder(resolved, account, order, verdict)) committed++;
1099:     }
1100: 
1101:     return { verdict, committed };
1102:   }
1103: 
1104:   /** Every order of the pass told the gate's words, and the whole verdict on one audit row. */
1105:   private defer(loginName: string, orders: QueuedOrder[], verdict: GateVerdict, event: string): void {
1106:     const words = playerWords(verdict);
1107: 
1108:     for (const order of orders) this.wait(order, words);
1109: 
1110:     audit(event, {
1111:       account: loginName,
1112:       detail: {
1113:         orders: orders.map(order => order.id),
1114:         refusals: verdict.refusals,
1115:         signals: signalsOf(verdict),
1116:       },
1117:     });
1118:   }
1119: 
1120:   /**
1121:    * Step 5: journal, then lock. The journal comes first so a crash between
1122:    * the two leaves a record, not a mystery.
1123:    */
1124:   private async lock(account: AccountRow): Promise<boolean> {
1125:     const { account: a } = (await this.resolveOnce()).schema;
1126: 
1127:     journalLock(account.id, account.state);
1128: 
1129:     const result = await this.sql.unsafe(
1130:       `UPDATE ${a.ref} SET ${a.col.state} = $1 WHERE ${a.col.id} = $2 AND ${a.col.state} = $3`,
1131:       [ACCOUNT_TEMPORARILY_BANNED, account.id, ACCOUNT_NORMAL]
1132:     );
1133: 
1134:     if (result.count !== 1) {
1135:       clearLock(account.id);
1136:       return false;
1137:     }
1138: 
1139:     this.inFlight.add(account.id);
1140: 
1141:     return true;
1142:   }
1143: 
1144:   /**
1145:    * Step 14: restore, whatever happened, then clear the journal. Only a row
1146:    * still holding the lock's value is touched.
1147:    */
1148:   private async unlock(account: AccountRow): Promise<void> {
1149:     try {
1150:       const { account: a } = (await this.resolveOnce()).schema;
1151: 
1152:       await this.sql.unsafe(
1153:         `UPDATE ${a.ref} SET ${a.col.state} = $1 WHERE ${a.col.id} = $2 AND ${a.col.state} = $3`,
1154:         [account.state, account.id, ACCOUNT_TEMPORARILY_BANNED]
1155:       );
1156:       clearLock(account.id);
1157:     } catch (error) {
1158:       // The journal entry stays, and the sweep restores it within the minute.
1159:       console.error(
1160:         `could not restore State for ${account.loginName}; the sweep will:`,
1161:         describe(error)
1162:       );
1163:     } finally {
1164:       this.inFlight.delete(account.id);
1165:     }
1166:   }
1167: 
1168:   /**
1169:    * One order, claimed and settled. True when a row was committed. The claim
1170:    * is conditional on the order still being queued, so a cancel that landed
1171:    * between the poll and now wins and the order is skipped.
1172:    */
1173:   private async deliverOrder(
1174:     resolved: Resolved,
1175:     account: AccountRow,
1176:     queued: QueuedOrder,
1177:     verdict: GateVerdict
1178:   ): Promise<boolean> {
1179:     const order = claimForDelivery(queued.id);
1180: 
1181:     if (!order) return false;
1182: 
1183:     const rehearse = !this.config.fulfil;
1184:     let delivery: Delivery;
1185: 
1186:     try {
1187:       // Anything thrown by the callback itself is thrown before COMMIT was
1188:       // sent, and Postgres rolls back: nothing was written and the order can
1189:       // safely go back to the queue. Anything that escapes `begin` without
1190:       // that wrapper came from the machinery around the callback - the COMMIT
1191:       // itself, or a connection that dropped after it was sent - and whether
1192:       // the write landed is unknowable from here.
1193:       delivery = await this.sql.begin(async tx => {
1194:         try {
1195:           return await deliverInTransaction(tx, resolved, account, order, rehearse);
1196:         } catch (inner) {
1197:           throw new BeforeCommit(inner);
1198:         }
1199:       });
1200:     } catch (thrown) {
1201:       const error = thrown instanceof BeforeCommit ? thrown.inner : thrown;
1202: 
1203:       if (!(thrown instanceof BeforeCommit)) {
1204:         // The one outcome this must never turn into a retry: a delivery that
1205:         // did commit would be delivered again, and the jewels taken twice.
1206:         // The order stays `delivering`, the player is told, the audit row
1207:         // carries the error, and `cashshop-orders` is how a person decides.
1208:         explainDelivering(
1209:           order.id,
1210:           'The shop could not tell whether this was delivered. Someone will check it.'
1211:         );
1212:         audit('delivery outcome unknown', {
1213:           account: account.loginName,
1214:           orderId: order.id,
1215:           detail: { error: describe(error), signals: signalsOf(verdict) },
1216:         });
1217:         console.error(
1218:           `order ${order.id} for ${account.loginName}: ` +
1219:             'COMMIT outcome unknown, left as delivering for review:',
1220:           error
1221:         );
1222:         return false;
1223:       }
1224: 
1225:       if (error instanceof Rehearsed) {
1226:         const { delivery } = error;
1227:         const where = delivery.spent.map(jewel => `${jewel.storage}:${jewel.slot}`).join(', ');
1228: 
1229:         settle(order.id, 'queued', REHEARSAL_WORDS);
1230:         audit('rehearsed', {
1231:           account: account.loginName,
1232:           orderId: order.id,
1233:           detail: this.auditDetail(order, delivery, verdict),
1234:         });
1235:         console.info(
1236:           `rehearsed order ${order.id} for ${account.loginName}/${delivery.character}: ` +
1237:             `would DELETE ${delivery.spent.length} chaos (${where}) ` +
1238:             `and INSERT ${this.describeGrant(order, delivery)} at slot ${delivery.slot}`
1239:         );
1240:         return false;
1241:       }
1242: 
1243:       if (error instanceof Refusal) {
1244:         settle(order.id, error.outcome, error.message);
1245:         audit(`delivery ${error.outcome === 'failed' ? 'failed' : 'deferred'}`, {
1246:           account: account.loginName,
1247:           orderId: order.id,
1248:           detail: { reason: error.message, signals: signalsOf(verdict) },
1249:         });
1250:         console.info(`order ${order.id} for ${account.loginName} ${error.outcome}: ${error.message}`);
1251:         return false;
1252:       }
1253: 
1254:       // Anything else is the database, not the player, and it happened
1255:       // before COMMIT: the order keeps its place, the operator gets the real
1256:       // error, the player gets a sentence.
1257:       settle(order.id, 'queued', 'The shop hit a problem delivering this. It will try again.');
1258:       audit('delivery error', {
1259:         account: account.loginName,
1260:         orderId: order.id,
1261:         detail: { error: describe(error), signals: signalsOf(verdict) },
1262:       });
1263:       console.error(`order ${order.id} for ${account.loginName} errored:`, error);
1264:       return false;
1265:     }
1266: 
1267:     // Committed. From here on nothing may send the order back to the queue:
1268:     // the item is in the bag and the jewels are gone. A bookkeeping failure
1269:     // leaves it `delivering`, which the boot check and the CLI surface, and
1270:     // is the right side to err on.
1271:     try {
1272:       settle(order.id, 'delivered', `Delivered to ${delivery.character}'s bag.`, delivery.itemId);
1273:       audit('delivered', {
1274:         account: account.loginName,
1275:         orderId: order.id,
1276:         detail: this.auditDetail(order, delivery, verdict),
1277:       });
1278:       console.info(
1279:         `delivered order ${order.id} to ${account.loginName}/${delivery.character}: ` +
1280:           `${this.describeGrant(order, delivery)} at slot ${delivery.slot} ` +
1281:           `for ${delivery.spent.length} chaos`
1282:       );
1283:     } catch (error) {
1284:       console.error(
1285:         `order ${order.id} for ${account.loginName} was delivered (item ${delivery.itemId}) ` +
1286:           'but could not be recorded; it stays delivering for review:',
1287:         error
1288:       );
1289:     }
1290: 
1291:     return true;
1292:   }
1293: 
1294:   private describeGrant(order: Order, delivery: Delivery): string {
1295:     const { grant } = delivery;
1296:     const options = grant.optionIds.length ? ` with ${grant.optionIds.length} excellent option(s)` : '';
1297:     const roll = order.roll ? ` [${describeRoll(order.roll)}]` : '';
1298: 
1299:     return `${grant.definitionName} +${grant.level} (${grant.width}x${grant.height})${options}${roll}`;
1300:   }
