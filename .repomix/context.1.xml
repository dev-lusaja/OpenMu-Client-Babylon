 910:   start(): void {
 911:     if (this.timer || this.sweeper) return;
 912:     this.stopped = false;
 913: 
 914:     console.info(
 915:       `cash shop fulfilment is ${this.mode}` +
 916:         (this.config.fulfil
 917:           ? ''
 918:           : ' (rehearsing: nothing will be written; set CASHSHOP_FULFIL=on)')
 919:     );
 920: 
 921:     this.reportInterrupted();
 922:     void this.sweep();
 923:     this.sweeper = setInterval(() => void this.sweep(), this.config.sweepMs);
 924:     this.sweeper.unref();
 925:     this.schedule(0);
 926:   }
