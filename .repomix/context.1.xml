<file path="proxy/band/window.ts">
 1: /**
 2:  * A count over the last second, kept as a ring of buckets: O(1) to add and
 3:  * to read, no per-event allocation. `src/common/rateLimit.ts` filters a
 4:  * timestamp array per call, which is right for a login form and wrong for a
 5:  * thousand notes a second.
 6:  */
 7: export class SlidingWindow {
 8:   private readonly counts: number[];
 9:   private readonly stamps: number[];
10: 
11:   constructor(
12:     private readonly bucketMs = 100,
13:     buckets = 10
14:   ) {
15:     this.counts = new Array<number>(buckets).fill(0);
16:     this.stamps = new Array<number>(buckets).fill(-1);
17:   }
18: 
19:   /** The window's span in milliseconds. */
20:   get spanMs(): number {
21:     return this.bucketMs * this.counts.length;
22:   }
23: 
24:   private slot(now: number): number {
25:     const bucket = Math.floor(now / this.bucketMs);
26:     const i = bucket % this.counts.length;
27:     if (this.stamps[i] !== bucket) {
28:       this.stamps[i] = bucket;
29:       this.counts[i] = 0;
30:     }
31:     return i;
32:   }
33: 
34:   add(now: number, n = 1): number {
35:     this.counts[this.slot(now)] += n;
36:     return this.sum(now);
37:   }
38: 
39:   /** Everything counted within the last span. */
40:   sum(now: number): number {
41:     const bucket = Math.floor(now / this.bucketMs);
42:     const oldest = bucket - this.counts.length + 1;
43:     let total = 0;
44:     for (let i = 0; i < this.counts.length; i++) {
45:       if (this.stamps[i] >= oldest && this.stamps[i] <= bucket) total += this.counts[i];
46:     }
47:     return total;
48:   }
49: 
50:   reset(): void {
51:     this.counts.fill(0);
52:     this.stamps.fill(-1);
53:   }
54: }
</file>

