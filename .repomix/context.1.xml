 968:   /** One look at the queue. Never overlaps itself: a slow gate check must not stack. */
 969:   async tick(): Promise<void> {
 970:     if (this.running) return;
 971:     this.running = true;
 972: 
 973:     try {
 974:       const byAccount = new Map<string, QueuedOrder[]>();
 975: 
 976:       for (const order of queuedOrders()) {
 977:         byAccount.set(order.account, [...(byAccount.get(order.account) ?? []), order]);
 978:       }
 979: 
 980:       if (byAccount.size > 0) await this.resolveOnce();
 981: 
 982:       for (const [account, orders] of byAccount) {
 983:         if (this.stopped) break;
 984:         await this.deliverAccount(account, orders);
 985:       }
 986:     } catch (error) {
 987:       console.error('fulfilment pass failed:', describe(error));
 988:     } finally {
 989:       this.running = false;
 990:       this.schedule(this.config.pollMs);
 991:     }
 992:   }
