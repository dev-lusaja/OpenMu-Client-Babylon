390:   }
391: 
392:   /**
393:    * Recover the id other clients see this performer by, from the tracker: the
394:    * performer's own socket calls its hero 0x200, but every socket that has the
395:    * performer in scope knows them by their real id under their name. Sets
396:    * `perf.id` and re-stamps the cached start when it changes.
397:    */
398:   private resolvePublicId(perf: Performer): void {
399:     const name = perf.state.peer.track.character;
400:     if (!name) return;
401:     for (const other of this.peers.values()) {
402:       if (other === perf.state) continue;
403:       const id = other.peer.track.idByName(name);
404:       if (id === null) continue;
405:       if (id !== perf.id) {
406:         perf.id = id;
407:         perf.startFrame = stampPerformer(perf.startPlain, id);
408:       }
409:       return;
410:     }
411:   }
412: 
413:   private onBatch(state: PeerState, message: Extract<BandClientMessage, { sub: 3 }>, plain: Uint8Array, now: number): void {
414:     const perf = state.performing;
415:     if (!perf) return;
416:     this.counters.batchesIn++;
417: 
418:     if (perf.batches.add(now) > BAND_LIMITS.maxBatchesPerSecond) {
419:       this.endPerformance(perf, StopReason.Flood);
420:       return;
421:     }
422:     if (perf.events.add(now, message.events.length) > BAND_LIMITS.maxEventsPerSecond) {
423:       this.endPerformance(perf, StopReason.Flood);
424:       return;
425:     }
426: 
427:     if (perf.seq !== null && ((perf.seq + 1) & 0xffff) !== message.seq) {
428:       perf.dropped++;
429:       if (perf.dropped > BAND_LIMITS.maxDroppedBatches) {
430:         this.endPerformance(perf, StopReason.Order);
431:         return;
432:       }
433:     }
434:     perf.seq = message.seq;
435: 
436:     // `baseMs` runs on the performer's clock from their start; the difference
437:     // to ours should stay put. Growing means they are sending late (lagged);
438:     // shrinking means notes from the future - a pre-buffered flood.
439:     const offset = now - perf.startedAt - message.baseMs;
440:     if (perf.offset0 === null) perf.offset0 = offset;
441:     else if (offset > perf.offset0 + BAND_LIMITS.lagToleranceMs) {
442:       perf.lagged++;
443:       if (perf.lagged >= BAND_LIMITS.maxLaggedBatches) {
444:         this.endPerformance(perf, StopReason.Order);
445:         return;
446:       }
447:     } else if (offset < perf.offset0 - BAND_LIMITS.lagToleranceMs) {
448:       this.strike(state, now, 'rate');
449:       if (!this.performers.has(perf.state)) return;
450:     }
451: 
452:     this.refreshReceivers(perf, now, false);
453:     if (!this.performers.has(perf.state)) return;
454:     this.relay(perf, stampPerformer(plain, perf.id), now);
455:     this.counters.batchesRelayed++;
456:   }
457: 
458:   /**
459:    * A member keeps their own performance (their instrument is out, that is
460:    * their pose on every screen) and doubles the master's notes on it; the
461:    * master's client learns who joined and pushes the band state to everyone
462:    * in earshot.
463:    */
464:   private onJoin(state: PeerState, message: Extract<BandClientMessage, { sub: 4 }>, now: number): void {
465:     const track = state.peer.track;
466:     if (now - state.lastJoinAt < BAND_LIMITS.joinIntervalMs) {
467:       this.refuse(state, RefuseWhat.Join, RefuseCause.Rate);
468:       return;
469:     }
470:     state.lastJoinAt = now;
471:     // The joiner names the master by the id they see them under - the master's
472:     // public id, not the master's own 0x200 - so find the performance with
473:     // that resolved id.
474:     const wanted = message.masterId & 0x7fff;
475:     let master: Performer | undefined;
476:     for (const perf of this.performers.values()) {
477:       this.resolvePublicId(perf);
478:       if (perf.id === wanted) {
479:         master = perf;
480:         break;
481:       }
482:     }
483:     if (!master) {
484:       this.refuse(state, RefuseWhat.Join, RefuseCause.NotPerforming);
485:       return;
486:     }
487:     if (master.state === state) {
488:       this.refuse(state, RefuseWhat.Join, RefuseCause.Busy);
489:       return;
490:     }
491:     if (master.map !== track.map) {
492:       this.refuse(state, RefuseWhat.Join, RefuseCause.Map);
493:       return;
494:     }
495:     if (chebyshev(track, master.state.peer.track) > BAND_LIMITS.joinRangeTiles) {
496:       this.refuse(state, RefuseWhat.Join, RefuseCause.Range);
497:       return;
498:     }
499:     if (state.memberOf && state.memberOf !== master) this.leave(state, false);
500:     if (!master.members.has(state) && master.members.size >= BAND_LIMITS.maxBandMembers) {
501:       this.refuse(state, RefuseWhat.Join, RefuseCause.Full);
502:       return;
503:     }
504:     master.members.add(state);
505:     state.memberOf = master;
506:     // The master's client must learn the joiner by the id it sees them under.
507:     const joinerId = this.memberIdFor(master, state);
508:     track.note('band', `joins the band of #${master.id}`, { master: master.id, instrument: message.instrument });
509:     this.log(`band: #${joinerId} joins the band of #${master.id} with instrument ${message.instrument}`);
510:     // The joiner named the master by the master's public id; the master's own
511:     // client knows itself only by its local one (0x200), so the relay says
512:     // that - a frame naming any other id is a stray on that client.
513:     this.trySend(master.state, stampPerformer(encodeJoin(master.selfId, message.instrument, message.mask), joinerId), now);
514:   }
515: 
516:   /** The id the master's client sees `member` under, falling back to the member's local id. */
517:   private memberIdFor(master: Performer, member: PeerState): number {
518:     const name = member.peer.track.character;
519:     const seen = name ? master.state.peer.track.idByName(name) : null;
520:     return seen ?? member.peer.track.objectId ?? 0;
521:   }
522: 
523:   private leave(state: PeerState, quiet: boolean): void {
524:     const master = state.memberOf;
525:     if (!master) return;
526:     master.members.delete(state);
527:     state.memberOf = null;
528:     const id = this.memberIdFor(master, state);
529:     this.trySend(master.state, encodeLeaveNotice(id), this.now());
530:     if (!quiet) state.peer.track.note('band', `leaves the band of #${master.id}`, { master: master.id });
531:     this.log(`band: #${id} leaves the band of #${master.id}`);
532:   }
533: 
534:   /** `notifyPerformer` false: the performer is switching instruments and is not to put the new one away. */
535:   private endPerformance(perf: Performer, reason: number, notifyPerformer = true): void {
536:     if (this.performers.get(perf.state) !== perf) return;
537:     this.performers.delete(perf.state);
538:     perf.state.performing = null;
539:     this.counters.performers = this.performers.size;
540:     const now = this.now();
541: 
542:     if (reason === StopReason.Flood) this.counters.stopped.flood++;
543:     else if (reason === StopReason.Order) this.counters.stopped.order++;
544:     else if (reason === StopReason.Gone) this.counters.stopped.gone++;
545:     if (reason === StopReason.Flood || reason === StopReason.Order) {
546:       perf.state.cooldownUntil = now + BAND_LIMITS.cooldownAfterStopMs;
547:     }
548: 
549:     // One notice each: a member is usually a receiver too.
550:     const notice = encodeStopNotice(perf.id, reason);
551:     const told = new Set<PeerState>();
552:     for (const receiver of perf.receivers) {
553:       this.trySend(receiver, notice, now);
554:       told.add(receiver);
555:     }
556:     perf.receivers.clear();
557:     for (const member of Array.from(perf.members)) {
558:       member.memberOf = null;
559:       if (!told.has(member)) this.trySend(member, notice, now);
560:     }
561:     perf.members.clear();
562:     if (notifyPerformer) this.trySend(perf.state, notice, now);
563: 
564:     const why = reason === StopReason.Flood ? 'too many notes' : reason === StopReason.Order ? 'notes out of order' : reason === StopReason.Gone ? 'gone' : 'ended';
565:     perf.state.peer.track.note('band', `stops playing (${why})`, { reason });
566:     this.log(`band: #${perf.id} stopped (${why})`);
567:   }
568: 
569:   /* -------------------------------------------------------------- relaying */
570: 
571:   /**
572:    * Who hears this performer: every peer on the same map whose own scope
573:    * holds them, nearest first past the cap. Recomputed at most every
574:    * `receiversTtlMs`; a peer coming in gets the cached start and band state
575:    * first, one going out gets a stop.
576:    */
577:   private refreshReceivers(perf: Performer, now: number, force: boolean): void {
578:     if (!force && now - perf.receiversAt < BAND_LIMITS.receiversTtlMs) return;
579:     const first = perf.receiversAt === 0;
580:     perf.receiversAt = now;
581: 
582:     const me = perf.state.peer.track;
583:     if (!me.inWorld || me.map !== perf.map || me.objectId !== perf.selfId) {
584:       this.endPerformance(perf, StopReason.Gone);
585:       return;
586:     }
587: 
588:     // A peer that just came into scope may be the first to know this
589:     // performer's public id; a performer whose own id is still the local
590:     // 0x200 has no receivers, since nobody addresses anyone by 0x200.
591:     this.resolvePublicId(perf);
592:     const name = me.character;
593: 
594:     let candidates: PeerState[] = [];
595:     for (const state of this.peers.values()) {
596:       if (state === perf.state) continue;
597:       const t = state.peer.track;
598:       if (!t.inWorld || t.objectId === null || t.map !== perf.map) continue;
599:       // The receiver must actually see this performer - by their name, since
600:       // the performer's own id (0x200) is every peer's own hero id too.
601:       if (!name || t.idByName(name) === null) continue;
602:       candidates.push(state);
603:     }
604:     if (candidates.length > this.maxReceivers) {
605:       candidates = candidates
606:         .map(state => ({ state, d: chebyshev(state.peer.track, me) }))
607:         .sort((a, b) => a.d - b.d)
608:         .slice(0, this.maxReceivers)
609:         .map(c => c.state);
610:     }
611: 
612:     const next = new Set(candidates);
613:     let changed = false;
614:     for (const state of perf.receivers) {
615:       if (!next.has(state)) {
616:         this.trySend(state, encodeStopNotice(perf.id, StopReason.Gone), now);
617:         changed = true;
618:       }
619:     }
620:     for (const state of next) {
621:       if (!perf.receivers.has(state)) {
622:         this.trySend(state, perf.startFrame, now);
623:         if (perf.stateFrame) this.trySend(state, perf.stateFrame, now);
624:         changed = true;
625:       }
626:     }
627:     perf.receivers = next;
628:     if (changed && !first) this.log(`band: #${perf.id} now has ${next.size} receivers`);
629:   }
630: 
631:   private relay(perf: Performer, frame: Uint8Array, now: number): void {
632:     for (const receiver of perf.receivers) this.trySend(receiver, frame, now);
633:   }
634: 
635:   private trySend(state: PeerState, frame: Uint8Array, now: number): void {
636:     if (now - state.backpressuredAt < BACKPRESSURE_SKIP_MS) {
637:       this.counters.dropped.backpressure++;
638:       return;
639:     }
640:     let status: number;
641:     try {
642:       status = state.peer.send(frame);
643:     } catch {
644:       this.counters.dropped.closed++;
645:       return;
646:     }
647:     if (status === -1) {
648:       state.backpressuredAt = now;
649:       this.counters.dropped.backpressure++;
650:     } else if (status === 0) {
651:       this.counters.dropped.closed++;
652:     } else {
653:       this.counters.framesSent++;
654:     }
655:   }
656: }
