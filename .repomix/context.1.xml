 40: async function main(): Promise<void> {
 41:   const command = process.argv[2] ?? 'enter';
 42:   const account = arg('account', 'MKT001')!;
 43:   const password = arg('password', process.env.MARKETPLACE_BOT_PASSWORD);
 44: 
 45:   if (command === 'ledger') {
 46:     const rows = new Ledger().summary();
 47:     if (rows.length === 0) {
 48:       log('the ledger is empty');
 49:       return;
 50:     }
 51:     for (const r of rows) {
 52:       log(
 53:         `${r.bot}: ${r.handovers} handover(s), ${r.mismatches} mismatch(es), ` +
 54:           `drift ${r.drift >= 0 ? '+' : ''}${r.drift} Zen`
 55:       );
 56:     }
 57:     return;
 58:   }
 59: 
 60:   if (!password) {
 61:     console.error('no password: pass --password or set MARKETPLACE_BOT_PASSWORD');
 62:     process.exit(1);
 63:   }
 64: 
 65:   if (command === 'simulate') {
 66:     await simulate(password);
 67:     return;
 68:   }
 69: 
 70:   if (command === 'escrow') {
 71:     await escrow(password);
 72:     return;
 73:   }
 74: 
 75:   const connection = new BotConnection(HOST, PORT, log);
 76:   const scope = new Scope(connection, log);
 77:   const trade = new TradeSession(connection, log);
 78:   const session = new BotSession(
 79:     connection,
 80:     {
 81:       account,
 82:       password,
 83:       character: arg('character', account),
 84:       createIfMissing: true,
 85:     },
 86:     log
 87:   );
 88: 
 89:   await connection.connect();
 90: 
 91:   try {
 92:     const character = await session.enterWorld();
 93:     // So the bot is not offered as its own trade partner.
 94:     scope.selfName = character.Name;
 95:     log(`ready as ${character.Name} (level ${character.Level})`);
 96: 
 97:     switch (command) {
 98:       case 'enter':
 99:         // Give the server a moment to send the surrounding scope, so the run
100:         // says something useful about what the bot can actually see.
101:         await sleep(3000);
102:         report(scope);
103:         break;
104: 
105:       case 'watch': {
106:         const seconds = Number(arg('seconds', '30'));
107:         log(`watching for ${seconds}s`);
108:         for (let i = 0; i < seconds; i++) {
109:           await sleep(1000);
110:           if (i % 5 === 4) report(scope);
111:         }
112:         break;
113:       }
114: 
115:       case 'return': {
116:         const target = arg('to');
117:         if (!target) throw new Error('return needs --to <character name>');
118:         await returnEverything({ session, trade, scope, log }, target);
119:         break;
120:       }
121: 
122:       case 'trace': {
123:         const target = arg('target');
124:         if (!target) throw new Error('trace needs --target <character name>');
125:         log(`tracing to ${target}`);
126:         await session.warpTo(target);
127:         await sleep(3000);
128:         report(scope);
129:         const found = scope.byName(target);
130:         log(found ? `${target} is in scope at ${found.x},${found.y}` : `${target} is NOT in scope`);
131:         break;
132:       }
133: 
134:       case 'trade': {
135:         const target = arg('target');
136:         if (!target) throw new Error('trade needs --target <character name>');
137:         await session.warpTo(target);
138:         await sleep(3000);
139: 
140:         const partner = scope.byName(target);
141:         if (!partner) throw new Error(`${target} is not in scope, cannot trade`);
142: 
143:         log(`requesting a trade with ${partner.name} (id ${partner.id})`);
144:         await trade.requestWith(partner.id);
145:         log('trade opened; waiting for the other side to put something up');
146:         await sleep(15000);
147:         log(`table: ${trade.theirItems.size} item(s), ${trade.theirMoney} Zen`);
148:         trade.cancel();
149:         break;
150:       }
151: 
152:       default:
153:         throw new Error(`unknown command "${command}"`);
154:     }
155:   } finally {
156:     try {
157:       session.logOut();
158:       await sleep(400);
159:     } catch {
160:       // Already disconnected.
161:     }
162:     trade.dispose();
163:     scope.dispose();
164:     connection.close();
165:   }
166: }
