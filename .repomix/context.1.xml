355: export type Placement = { ok: true; order: Order } | { ok: false; reason: string };
356: 
357: /** What placement has to bound against, read inside the same transaction that would write. */
358: export interface PlacementView {
359:   /** Chaos already committed by this account's open orders. */
360:   committed: number;
361:   /** Orders of this product placed today, cancellations and failures excluded. */
362:   spentToday: number;
