136:   /** Asks a player in view to trade. Their id only exists while they are visible. */
137:   async requestWith(playerId: number, timeoutMs = 20_000): Promise<void> {
138:     this.clearTable();
139:     const answer = this.connection.expect(CODE.answer, timeoutMs, 'TradeRequestAnswer');
140:     const packet = TradeRequestPacket.createPacket();
141:     packet.PlayerId = playerId;
142:     this.connection.send(packet.buffer);
143:     this.readAnswer(await answer);
144:   }
145: 
146:   /** Accepts a trade the partner opened. */
147:   async accept(timeoutMs = 20_000): Promise<void> {
148:     this.clearTable();
149:     const answer = this.connection.expect(CODE.answer, timeoutMs, 'TradeRequestAnswer');
150:     const packet = TradeRequestResponsePacket.createPacket();
151:     packet.TradeAccepted = true;
152:     this.connection.send(packet.buffer);
153:     this.readAnswer(await answer);
154:   }
155: 
156:   /**
157:    * Forgets the last trade's table, before asking for the next one - never
158:    * on the answer. A partner who puts their item up the instant the trade
159:    * opens has it arrive in the same chunk as the answer; the item is
160:    * recorded as the chunk is read, and the answer's continuation runs after.
161:    * Clearing there wiped an item that was already on the table, and the bot
162:    * then waited a minute for an item it had just forgotten.
163:    */
164:   private clearTable(): void {
165:     this.theirItems.clear();
166:     this.myItems.clear();
167:     this.receivedSlots.length = 0;
168:     this.theirMoney = 0;
169:     this.myMoney = 0;
170:     this.offeredMoney = 0;
171:     this.theirConfirm = false;
172:   }
173: 
174:   private readAnswer(frame: Frame): void {
175:     const answer = new TradeRequestAnswerPacket(view(frame));
176:     if (!answer.Accepted) throw new Error('the trade was refused');
177:     this.open = true;
178:     this.partner = answer.Name;
179:     this.log(`trading with ${this.partner}`);
180:   }
181: 
182:   /** Puts Zen on the table. `myMoney` says whether the server agreed. */
183:   setMoney(amount: number): void {
184:     this.offeredMoney = amount;
185:     const packet = SetTradeMoneyPacket.createPacket();
186:     packet.Amount = amount;
187:     this.connection.send(packet.buffer);
188:   }
189: 
190:   /**
191:    * Moves an item from the bag onto the trade table.
192:    *
193:    * `inventorySlot` is the wire slot, so the bag starts at 12 - the first
194:    * twelve are the equipment slots. The storage values come from `StorageKind`,
195:    * *not* from the generated `StorageTypeEnum`: those are two different enums
196:    * and they disagree. The wire wants OpenMU's `ItemStorageKind`, where trade
197:    * is 1; `StorageTypeEnum.TradeOwn` is 2, which the server reads as the vault
198:    * and refuses. The item's binary is sent zeroed: OpenMU's
199:    * move handler resolves the item from the slot it is in and ignores the
200:    * payload ("we don't transmit the item binary data anymore in this extended
201:    * message"), so inventing a serialisation here would only be a way to get it
202:    * wrong.
203:    */
204:   offerItem(inventorySlot: number, tradeSlot: number): void {
205:     const packet = ItemMoveRequestPacket.createPacket();
206:     packet.FromStorage = StorageKind.Inventory;
207:     packet.FromSlot = inventorySlot;
208:     packet.ToStorage = StorageKind.Trade;
209:     packet.ToSlot = tradeSlot;
210:     packet.setItemData(new Uint8Array(12), 12);
211:     this.connection.send(packet.buffer);
212:   }
213: 
214:   /**
215:    * Ticks our accept box. Any change on either side clears both boxes server
216:    * side, so this is only ever sent once the table already matches the terms.
217:    */
218:   private setConfirm(checked: boolean): void {
219:     const packet = TradeButtonStateChangePacket.createPacket();
220:     packet.NewState = checked
221:       ? TradeButtonStateEnum.Checked
222:       : TradeButtonStateEnum.Unchecked;
223:     this.connection.send(packet.buffer);
224:   }
225: 
226:   cancel(): void {
227:     if (!this.open) return;
228:     this.connection.send(TradeCancelPacket.createPacket().buffer);
229:     this.open = false;
230:   }
231: 
232:   /**
233:    * Withdraws a request nobody answered.
234:    *
235:    * Asking puts the partner into the server's "trade requested" state, and
236:    * they stay there until they answer or the asker cancels. A bot that just
237:    * walked away left the customer stuck: every later request, from any bot,
238:    * was refused in silence. The server's cancel frees both sides, so it is
239:    * sent even though no trade ever opened.
240:    */
241:   abandonRequest(): void {
242:     this.connection.send(TradeCancelPacket.createPacket().buffer);
243:     this.open = false;
244:   }
