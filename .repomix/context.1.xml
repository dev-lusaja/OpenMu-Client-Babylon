345:         this.refuse(state, RefuseWhat.Start, RefuseCause.Full);
346:         return;
347:       }
348:     }
349: 
350:     // The same socket sending start again has switched instruments: the old
351:     // performance ends quietly for them (receivers get the stop and the new
352:     // start). A socket is one performer, so the map is keyed by socket and no
353:     // two performers can collide even when their local ids are the same 0x200.
354:     if (previous) this.endPerformance(previous, StopReason.Ended, false);
355: 
356:     const selfId = track.objectId ?? 0;
357:     const perf: Performer = {
358:       state,
359:       id: selfId,
360:       selfId,
361:       map: track.map ?? -1,
362:       instrument: message.instrument,
363:       startedAt: now,
364:       seq: null,
365:       offset0: null,
366:       dropped: 0,
367:       lagged: 0,
368:       batches: new SlidingWindow(100, 10),
369:       events: new SlidingWindow(100, 10),
370:       states: new SlidingWindow(100, 10),
371:       lastNamesAt: 0,
372:       startPlain: plain,
373:       startFrame: stampPerformer(plain, selfId),
374:       stateFrame: null,
375:       members: new Set(),
376:       receivers: new Set(),
377:       receiversAt: 0,
