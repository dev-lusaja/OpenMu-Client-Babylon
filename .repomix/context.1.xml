1327:   /**
1328:    * A queued order told why it is waiting. Claimed and handed straight back so
1329:    * the reason lands on the row; only when the reason changed, because every
1330:    * settle is an audit row and a player who stays online is polled all night.
1331:    */
1332:   private wait(order: QueuedOrder, reason: string): void {
1333:     if (order.reason === reason) return;
1334:     if (claimForDelivery(order.id)) settle(order.id, 'queued', reason);
1335:   }
1336: 
1337:   /**
1338:    * Restores `State` on any account a dead process left locked. Runs at boot
1339:    * and every `sweepMs`, so a SIGKILL mid-transaction costs a player about a
1340:    * minute of "temporarily blocked" and never a permanent lockout. Only a row
1341:    * still holding the lock's value is touched: an operator who changed the
1342:    * state meanwhile is not overruled.
1343:    *
1344:    * A lock this process holds is left alone whatever its age. The journal
1345:    * row's age cannot tell a dead holder from a slow one: a pass delivers all
1346:    * of an account's orders under one lock, and twelve gacha rolls behind a
1347:    * stalled Postgres can honestly outlive `LOCK_STALE_MS`. Restoring `State`
1348:    * under such a pass would reopen login for the rest of it - the very race
1349:    * the lock exists to close - so `inFlight` is consulted first. A process
1350:    * that died has no set to consult, which is the case the sweep is for.
1351:    */
1352:   async sweep(): Promise<void> {
1353:     const stale = staleLocks().filter(lock => !this.inFlight.has(lock.accountId));
1354: 
1355:     if (stale.length === 0) return;
1356: 
1357:     let schema: ResolvedSchema;
1358: 
1359:     try {
1360:       schema = (await this.resolveOnce()).schema;
1361:     } catch (error) {
1362:       console.error(`${stale.length} stale account lock(s) cannot be restored yet:`, describe(error));
1363:       return;
1364:     }
1365: 
1366:     const { account: a } = schema;
1367: 
1368:     for (const lock of stale) {
1369:       const age = Math.round((Date.now() - lock.lockedAt) / 1000);
1370: 
1371:       try {
1372:         const result = await this.sql.unsafe(
1373:           `UPDATE ${a.ref} SET ${a.col.state} = $1 WHERE ${a.col.id} = $2 AND ${a.col.state} = $3`,
1374:           [lock.originalState, lock.accountId, ACCOUNT_TEMPORARILY_BANNED]
1375:         );
1376:         clearLock(lock.accountId);
1377:         audit('stale lock restored', {
1378:           detail: { accountId: lock.accountId, lockedAt: lock.lockedAt, restored: result.count === 1 },
1379:         });
1380:         console.warn(
1381:           `restored State on account ${lock.accountId} locked ${age}s ago` +
1382:             (result.count === 1 ? '' : ' (it was no longer locked)')
1383:         );
1384:       } catch (error) {
1385:         console.error(`could not restore State on account ${lock.accountId}:`, describe(error));
1386:       }
1387:     }
1388:   }
1389: }
