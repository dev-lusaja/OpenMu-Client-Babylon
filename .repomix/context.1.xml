  1: import postgres from 'postgres';
  2: import { SafetyGate, loadGateConfig, resolveSchema } from './gate';
  3: 
  4: /**
  5:  * Prints the safety gate's verdict for an account, so the gate can be checked
  6:  * against real players long before any shop code exists.
  7:  *
  8:  *   bun run cashshop-gate <account>       the verdict, one line per signal
  9:  *   bun run cashshop-gate <account> -w    re-check every 10s until interrupted
 10:  *   bun run cashshop-gate --schema        what it resolved OpenMU's columns to
 11:  *
 12:  * Read-only from end to end: it never writes to OpenMU's database.
 13:  */
 14: 
 15: const DATABASE_URL =
 16:   process.env.DATABASE_URL || 'postgres://postgres:admin@127.0.0.1:5432/openmu';
 17: 
 18: const WATCH_INTERVAL_MS = Number(process.env.GATE_WATCH_INTERVAL_MS ?? 10_000);
 19: 
 20: const GREEN = '\x1b[32m';
 21: const RED = '\x1b[31m';
 22: const DIM = '\x1b[2m';
 23: const BOLD = '\x1b[1m';
 24: const RESET = '\x1b[0m';
 25: 
 26: function usage(): never {
 27:   console.error('usage: bun run cashshop-gate <account> [--watch] | --schema');
 28:   process.exit(2);
 29: }
 30: 
 31: async function printSchema(sql: postgres.Sql): Promise<void> {
 32:   const schema = await resolveSchema(sql);
 33: 
 34:   console.info(`${BOLD}Resolved OpenMU columns${RESET}`);
 35:   for (const [logical, table] of Object.entries(schema)) {
 36:     console.info(`  ${logical} -> ${table.schema}."${table.table}"`);
 37:     for (const [name, column] of Object.entries(table.columns)) {
 38:       console.info(`      ${name.padEnd(20)} "${column}"`);
 39:     }
 40:   }
 41: }
 42: 
 43: async function printVerdict(gate: SafetyGate, account: string): Promise<void> {
 44:   const verdict = await gate.check(account);
 45:   const stamp = new Date(verdict.checkedAt).toISOString().slice(11, 19);
 46:   const headline = verdict.safe
 47:     ? `${GREEN}SAFE${RESET}    the shop may write to ${account}`
 48:     : `${RED}REFUSED${RESET} the shop must not write to ${account}`;
 49: 
 50:   console.info(`\n${DIM}${stamp}${RESET} ${headline}`);
 51: 
 52:   for (const signal of verdict.signals) {
 53:     const mark = signal.safe ? `${GREEN}ok  ${RESET}` : `${RED}no  ${RESET}`;
 54:     console.info(`  ${mark} ${signal.name.padEnd(14)} ${signal.reason}`);
 55: 
 56:     if (signal.detail) {
 57:       console.info(`       ${DIM}${JSON.stringify(signal.detail)}${RESET}`);
 58:     }
 59:   }
 60: }
 61: 
 62: async function main(): Promise<void> {
 63:   const args = process.argv.slice(2);
 64:   const wantsSchema = args.includes('--schema');
 65:   const watch = args.includes('--watch') || args.includes('-w');
 66:   const account = args.find(arg => !arg.startsWith('-'));
 67: 
 68:   if (!wantsSchema && !account) usage();
 69: 
 70:   const sql = postgres(DATABASE_URL);
 71: 
 72:   try {
 73:     if (wantsSchema) {
 74:       await printSchema(sql);
 75:       return;
 76:     }
 77: 
 78:     if (account === undefined) usage();
 79: 
 80:     const config = loadGateConfig();
 81: 
 82:     if (!config.gameHost || !config.gamePort) {
 83:       console.warn(
 84:         `${DIM}GAME_PROBE_HOST / GAME_PROBE_PORT are unset, so the port probe will refuse.` +
 85:           ` Set them to the address a player's client would dial.${RESET}`
 86:       );
 87:     }
 88: 
 89:     const gate = new SafetyGate(sql, config);
 90: 
 91:     await printVerdict(gate, account);
 92: 
 93:     if (!watch) return;
 94: 
 95:     console.info(`${DIM}watching every ${Math.round(WATCH_INTERVAL_MS / 1000)}s, ctrl-c to stop${RESET}`);
 96: 
 97:     for (;;) {
 98:       await new Promise(resolve => setTimeout(resolve, WATCH_INTERVAL_MS));
 99:       await printVerdict(gate, account);
100:     }
101:   } finally {
102:     await sql.end({ timeout: 5 });
103:   }
104: }
105: 
106: main().catch(error => {
107:   console.error(`${RED}gate check failed:${RESET}`, error instanceof Error ? error.message : error);
108:   process.exit(1);
109: });
</file>

