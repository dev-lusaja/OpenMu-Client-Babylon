130: export class BandHub {
131:   private readonly peers = new Map<BandPeer, PeerState>();
132:   /** Keyed by the performer's socket, so two performers never share a key even when their local ids do. */
133:   private readonly performers = new Map<PeerState, Performer>();
134:   private readonly now: () => number;
135:   private readonly maxPerformers: number;
136:   private readonly maxPerformersPerMap: number;
137:   private readonly maxReceivers: number;
138:   private readonly log: (line: string) => void;
139:   private readonly s6 = new Xor32Decryptor();
140:   private readonly pre = new Xor32Decryptor();
141:   private readonly counters: BandStats = {
142:     performers: 0,
143:     members: 0,
144:     batchesIn: 0,
145:     batchesRelayed: 0,
146:     framesSent: 0,
147:     dropped: { malformed: 0, rate: 0, order: 0, backpressure: 0, closed: 0 },
148:     stopped: { flood: 0, order: 0, gone: 0 },
149:     refused: 0,
150:   };
151: 
152:   constructor(options: BandHubOptions = {}) {
153:     this.now = options.now ?? Date.now;
154:     this.maxPerformers = options.maxPerformers ?? BAND_LIMITS.maxPerformers;
155:     this.maxPerformersPerMap = options.maxPerformersPerMap ?? BAND_LIMITS.maxPerformersPerMap;
156:     this.maxReceivers = options.maxReceivers ?? BAND_LIMITS.maxReceivers;
157:     this.log = options.log ?? (() => {});
158:     this.pre.xor32Key = preSeason6.protocol.encryption.xor32Key;
159:   }
