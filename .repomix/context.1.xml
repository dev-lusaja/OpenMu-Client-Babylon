184: // Bun hands us Node Buffers; re-view them as plain Uint8Arrays (no copy) so
185: // they match the `string | BufferSource` signatures on ws.send / socket.write.
186: function asBufferSource(data: string | Buffer): string | Uint8Array {
187:   return typeof data === "string"
188:     ? data
189:     : new Uint8Array(data.buffer as ArrayBuffer, data.byteOffset, data.byteLength);
190: }
