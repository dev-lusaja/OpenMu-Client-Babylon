<file path="marketplace/server/presence.ts">
 1: /**
 2:  * Whether an account is logged in, and on which game server, as the proxy's
 3:  * presence server says.
 4:  *
 5:  * The worker asks this before it sets off: a `/trace` at somebody who is not
 6:  * online costs a warp that never comes, ten seconds of waiting for it, three
 7:  * times over - and with a few such listings in the queue the bot spent whole
 8:  * minutes chasing ghosts while a real customer stood waiting. Presence is a
 9:  * loopback call that answers in milliseconds.
10:  *
11:  * The ports matter as much as the answer: OpenMU runs a copy of every map
12:  * per game server, so a bot on one port can only ever reach the players on
13:  * that port. A player who is online elsewhere is another bot's customer.
14:  *
15:  * The answer is `null` when presence cannot be reached, and the caller then
16:  * tries anyway: an outage of the proxy's side channel must not stop the
17:  * marketplace, it only takes away the shortcut.
18:  */
19: 
20: const PRESENCE_URL = process.env.PRESENCE_URL ?? 'http://127.0.0.1:3001';
21: const PRESENCE_TIMEOUT_MS = Number(process.env.PRESENCE_TIMEOUT_MS ?? 2000);
22: 
23: /** A verdict this fresh is reused rather than asked for again. */
24: const CACHE_MS = 3000;
25: 
26: export type Seen = {
27:   online: boolean;
28:   /** Game server ports the account is on; null from a presence too old to say. */
29:   ports: number[] | null;
30: };
31: 
32: const cache = new Map<string, { seen: Seen; at: number }>();
33: 
34: export async function presenceOf(account: string): Promise<Seen | null> {
35:   const key = account.toLowerCase();
36:   const cached = cache.get(key);
37:   if (cached && Date.now() - cached.at < CACHE_MS) return cached.seen;
38: 
39:   try {
40:     const response = await fetch(`${PRESENCE_URL}/presence/${encodeURIComponent(key)}`, {
41:       signal: AbortSignal.timeout(PRESENCE_TIMEOUT_MS),
42:     });
43:     if (!response.ok) return null;
44:     const answer = (await response.json()) as { online?: unknown; ports?: unknown };
45:     if (typeof answer.online !== 'boolean') return null;
46:     const ports = Array.isArray(answer.ports)
47:       ? answer.ports.filter((p): p is number => typeof p === 'number')
48:       : null;
49:     const seen: Seen = { online: answer.online, ports };
50:     cache.set(key, { seen, at: Date.now() });
51:     return seen;
52:   } catch {
53:     return null;
54:   }
55: }
56: 
57: /** Whether the account is on this bot's game server; null when nobody can say. */
58: export function onServer(seen: Seen | null, port: number): boolean | null {
59:   if (seen === null || seen.ports === null) return null;
60:   if (!seen.online) return false;
61:   return seen.ports.includes(port);
62: }
