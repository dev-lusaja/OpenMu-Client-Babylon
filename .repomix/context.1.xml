161:   static hello(): Uint8Array {
162:     return encodeHello();
163:   }
164: 
165:   attach(peer: BandPeer): void {
166:     if (this.peers.has(peer)) return;
167:     this.peers.set(peer, {
168:       peer,
169:       performing: null,
170:       memberOf: null,
171:       cooldownUntil: 0,
172:       lastJoinAt: 0,
173:       key: null,
174:       backpressuredAt: 0,
175:       strikes: new SlidingWindow(1000, 10),
176:       bytes: new SlidingWindow(100, 10),
177:     });
178:   }
179: 
180:   detach(peer: BandPeer): void {
181:     const state = this.peers.get(peer);
182:     if (!state) return;
183:     if (state.performing) this.endPerformance(state.performing, StopReason.Gone);
184:     if (state.memberOf) this.leave(state, true);
185:     for (const perf of this.performers.values()) perf.receivers.delete(state);
186:     this.peers.delete(peer);
187:   }
