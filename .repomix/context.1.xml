<file path="marketplace/bot/wire.ts">
  1: import {
  2:   SimpleModulusDecryptor,
  3:   SimpleModulusEncryptor,
  4:   SimpleModulusKeys,
  5: } from '../../src/common/encryption/simpleModulus';
  6: import { Xor32Encryptor } from '../../src/common/encryption/xor32';
  7: import { getPacketSize, getSizeOfPacketType } from '../../src/common/wireUtils';
  8: import { gameVersion } from '../../versions/season6';
  9: 
 10: /**
 11:  * The bot speaks the game server's own protocol, so it encrypts and frames
 12:  * exactly as the browser client does. Both directions are the client's side of
 13:  * the pipe:
 14:  *
 15:  * - **Out** (`Store.sendToGS`): Xor32 over the whole packet, then SimpleModulus
 16:  *   with the client-to-server keys, and only for headers >= 0xC3.
 17:  * - **In** (`createSocket`'s queue): SimpleModulus with the server-to-client
 18:  *   keys for headers >= 0xC3, and no Xor32 - that direction never has it.
 19:  *
 20:  * Getting either side backwards produces garbage that still frames correctly,
 21:  * so `wire.test.ts` round-trips against the client's own encoders rather than
 22:  * against hand-written bytes.
 23:  */
 24: 
 25: /** C1/C3 carry a one-byte length, C2/C4 a two-byte one. */
 26: export const HEADERS = new Set([0xc1, 0xc2, 0xc3, 0xc4]);
 27: 
 28: /** Above this the packet is encrypted; below it, plain. */
 29: export const ENCRYPTED_FROM = 0xc3;
 30: 
 31: export class BotCrypto {
 32:   private readonly encryptor = new SimpleModulusEncryptor();
 33:   private readonly decryptor = new SimpleModulusDecryptor();
 34:   private readonly xor32 = new Xor32Encryptor();
 35: 
 36:   constructor() {
 37:     this.encryptor.encryptionKeys = SimpleModulusKeys.CreateEncryptionKeys([
 38:       ...gameVersion.protocol.encryption.clientToServer,
 39:     ]);
 40:     this.decryptor.decryptionKeys = SimpleModulusKeys.CreateDecryptionKeys([
 41:       ...gameVersion.protocol.encryption.serverToClient,
 42:     ]);
 43:   }
 44: 
 45:   /** A packet as the client would put it on the wire. Encrypts in place. */
 46:   encrypt(packet: Uint8Array): Uint8Array {
 47:     const header = packet[0];
 48:     const xored = this.xor32.Encrypt(packet);
 49:     return header >= ENCRYPTED_FROM ? this.encryptor.Encrypt(xored) : xored;
 50:   }
 51: 
 52:   /**
 53:    * One complete server frame, decrypted. Returns null when the frame could
 54:    * not be decrypted, which the caller must treat as "drop it and carry on":
 55:    * SimpleModulus is a stream with a counter, so a frame that fails leaves the
 56:    * counter where it was and every later frame would fail with it.
 57:    */
 58:   decrypt(wire: Uint8Array): Uint8Array | null {
 59:     if (wire[0] < ENCRYPTED_FROM) return wire;
 60:     try {
 61:       const [ok, decrypted] = this.decryptor.Decrypt(wire);
 62:       return ok ? decrypted : null;
 63:     } catch {
 64:       return null;
 65:     }
 66:   }
 67: 
 68:   /** Why the last decrypt failed, for the log. */
 69:   get lastError(): string | null {
 70:     return this.decryptor.lastError ?? null;
 71:   }
 72: }
 73: 
 74: /**
 75:  * Splits a TCP byte stream into whole MU frames.
 76:  *
 77:  * A socket hands over arbitrary chunks, so a frame can arrive in pieces or
 78:  * several can arrive at once. Bytes that are not a header are dropped one at a
 79:  * time to resync rather than jamming the stream.
 80:  */
 81: export class FrameReader {
 82:   private buffer = new Uint8Array(0);
 83: 
 84:   push(chunk: Uint8Array): void {
 85:     if (this.buffer.length === 0) {
 86:       this.buffer = chunk.slice();
 87:       return;
 88:     }
 89:     const merged = new Uint8Array(this.buffer.length + chunk.length);
 90:     merged.set(this.buffer, 0);
 91:     merged.set(chunk, this.buffer.length);
 92:     this.buffer = merged;
 93:   }
 94: 
 95:   /** Every complete frame available now, in order, as raw (still encrypted) wire. */
 96:   *frames(): Generator<Uint8Array> {
 97:     while (this.buffer.length > 0) {
 98:       const header = this.buffer[0];
 99: 
100:       if (!HEADERS.has(header)) {
101:         this.buffer = this.buffer.subarray(1);
102:         continue;
103:       }
104: 
105:       const headerSize = getSizeOfPacketType(header);
106:       if (this.buffer.length < headerSize + 1) return;
107: 
108:       const length = getPacketSize(this.buffer);
109:       if (length < headerSize + 1) {
110:         this.buffer = this.buffer.subarray(1);
111:         continue;
112:       }
113:       if (this.buffer.length < length) return;
114: 
115:       yield this.buffer.slice(0, length);
116:       this.buffer = this.buffer.subarray(length);
117:     }
118:   }
119: }
120: 
121: /** Code and sub-code of a decrypted frame, for dispatch. */
122: export function codeOf(packet: Uint8Array): { code: number; sub: number } {
123:   const index = getSizeOfPacketType(packet[0]) === 3 ? 3 : 2;
124:   return {
125:     code: packet[index] ?? -1,
126:     sub: packet.length > index + 1 ? packet[index + 1] : -1,
127:   };
128: }
</file>

<file path="marketplace/server/schema/000_base.sql">
 1: -- The marketplace's own SQLite. Applied at every service start (each
 2: -- statement is idempotent) and, on a live box, by hand after a deploy:
 3: --
 4: --   sqlite3 /home/mu/.mu-marketplace/market.sqlite < marketplace/server/schema/000_base.sql
 5: --
 6: -- Listings: one row per item a seller asked to sell. `state` is the whole
 7: -- story (see db.ts, ListingState); `holder` and `holder_slot` say which bot
 8: -- account has the item and in which bag slot.
 9: CREATE TABLE IF NOT EXISTS listings (
10:   id            TEXT PRIMARY KEY,
11:   seller        TEXT NOT NULL,
12:   seller_char   TEXT NOT NULL,
13:   price         INTEGER NOT NULL,
14:   item_group    INTEGER NOT NULL,
15:   item_number   INTEGER NOT NULL,
16:   item_level    INTEGER NOT NULL DEFAULT 0,
17:   item_json     TEXT NOT NULL,
18:   category      TEXT NOT NULL,
19:   state         TEXT NOT NULL,
20:   holder        TEXT,
21:   holder_slot   INTEGER,
22:   buyer         TEXT,
23:   buyer_char    TEXT,
24:   created_at    INTEGER NOT NULL,
25:   updated_at    INTEGER NOT NULL
26: );
27: 
28: CREATE INDEX IF NOT EXISTS listings_state ON listings (state);
29: CREATE INDEX IF NOT EXISTS listings_seller ON listings (seller);
30: CREATE INDEX IF NOT EXISTS listings_item ON listings (item_group, item_number);
31: 
32: -- Zen owed to sellers from sales made while they were away.
33: CREATE TABLE IF NOT EXISTS balances (
34:   account   TEXT PRIMARY KEY,
35:   zen       INTEGER NOT NULL DEFAULT 0
36: );
37: 
38: -- One row for everything that moves.
39: CREATE TABLE IF NOT EXISTS audit (
40:   id        INTEGER PRIMARY KEY AUTOINCREMENT,
41:   at        INTEGER NOT NULL,
42:   listing   TEXT,
43:   account   TEXT,
44:   event     TEXT NOT NULL,
45:   detail    TEXT
46: );
</file>

<file path="marketplace/server/schema/001_payout_requests.sql">
 1: -- A seller pressing Collect. The bot pays a balance out only when somebody
 2: -- has asked for it and is standing in the world to receive it, so the ask is
 3: -- recorded here with the character the bot has to meet. One open request per
 4: -- account; paid or dropped, the row goes.
 5: --
 6: --   sqlite3 /home/mu/.mu-marketplace/market.sqlite < marketplace/server/schema/001_payout_requests.sql
 7: CREATE TABLE IF NOT EXISTS payout_requests (
 8:   account       TEXT PRIMARY KEY,
 9:   character     TEXT NOT NULL,
10:   requested_at  INTEGER NOT NULL
11: );
</file>

<file path="marketplace/server/schema/002_leases.sql">
 1: -- Work one bot has taken for the length of a handover, so another bot on the
 2: -- same rows leaves it alone. `key` is `listing:<id>`, `payout:<account>` or
 3: -- `customer:<character>`; `until` is when the lease lapses on its own, for a
 4: -- bot that died holding it.
 5: --
 6: --   sqlite3 /home/mu/.mu-marketplace/market.sqlite < marketplace/server/schema/002_leases.sql
 7: CREATE TABLE IF NOT EXISTS leases (
 8:   key       TEXT PRIMARY KEY,
 9:   worker    TEXT NOT NULL,
10:   until     INTEGER NOT NULL
11: );
</file>

<file path="marketplace/server/db.ts">
  1: import { Database } from 'bun:sqlite';
  2: import { mkdirSync, readdirSync, readFileSync } from 'node:fs';
  3: import os from 'node:os';
  4: import path from 'node:path';
  5: 
  6: /**
  7:  * The marketplace's own storage: listings, what each seller is owed, and an
  8:  * audit row for everything that moves.
  9:  *
 10:  * Deliberately not OpenMU's database, for the same reason the cash shop keeps
 11:  * its queue apart: none of this is game state, and a service that adds tables
 12:  * to a schema EF Core owns and migrates is a service that breaks on the next
 13:  * OpenMU upgrade. Items in flight are held on accounts the service owns, and
 14:  * the only thing that ever moves goods is an in-game trade.
 15:  *
 16:  * Every piece of SQL lives in this file. The rest of the service sees typed
 17:  * records, never rows.
 18:  */
 19: 
 20: /**
 21:  * Outside the checkout on purpose: the production update runs
 22:  * `git clean -fdx` in it, which would take the listings and every seller's
 23:  * unpaid balance with it.
 24:  */
 25: export const DB_PATH =
 26:   process.env.MARKETPLACE_DB || path.join(os.homedir(), '.mu-marketplace', 'market.sqlite');
 27: 
 28: mkdirSync(path.dirname(DB_PATH), { recursive: true });
 29: 
 30: const db = new Database(DB_PATH, { create: true });
 31: 
 32: // WAL so a CLI can read the listings while the server is serving them.
 33: db.run('PRAGMA journal_mode = WAL');
 34: // Enforced rather than assumed: a claim that points at a listing that is gone
 35: // is a bug worth failing on, not one worth carrying.
 36: db.run('PRAGMA foreign_keys = ON');
 37: 
 38: /**
 39:  * The schema lives in `schema/*.sql`, numbered, and every statement in them
 40:  * is idempotent. They are applied here on every start so a fresh box works,
 41:  * and they are what an operator runs by hand on a live one after a deploy -
 42:  * a table that only ever came into being as a side effect of a service
 43:  * booting would be invisible to whoever has to reproduce it.
 44:  */
 45: const SCHEMA_DIR = path.join(import.meta.dir, 'schema');
 46: for (const file of readdirSync(SCHEMA_DIR).filter(f => f.endsWith('.sql')).sort()) {
 47:   db.exec(readFileSync(path.join(SCHEMA_DIR, file), 'utf8'));
 48: }
 49: 
 50: export { db };
 51: 
 52: /**
 53:  * A listing's life.
 54:  *
 55:  * `pending` is the important one: a listing exists the moment a seller asks
 56:  * for it, but it is not on sale until a bot has physically taken the item, and
 57:  * a seller who never completes that handover leaves a `pending` row that never
 58:  * becomes visible to anybody. Showing it earlier would advertise an item the
 59:  * service does not hold.
 60:  *
 61:  * `stuck` is the one state a bot cannot leave on its own: the service says a
 62:  * bot holds the item in a slot, and the bot's bag says that slot is empty and
 63:  * nothing like it is anywhere else. It is off sale, still the seller's, and
 64:  * waits for a person - `bun run marketplace-bot return --to <seller>` hands
 65:  * the bot's whole bag back.
 66:  */
 67: export type ListingState =
 68:   | 'pending'
 69:   | 'active'
 70:   | 'claimed'
 71:   | 'sold'
 72:   | 'cancelled'
 73:   | 'returning'
 74:   | 'stuck';
 75: 
 76: export type ListingRow = {
 77:   id: string;
 78:   seller: string;
 79:   seller_char: string;
 80:   price: number;
 81:   item_group: number;
 82:   item_number: number;
 83:   item_level: number;
 84:   item_json: string;
 85:   category: string;
 86:   state: ListingState;
 87:   holder: string | null;
 88:   holder_slot: number | null;
 89:   buyer: string | null;
 90:   buyer_char: string | null;
 91:   created_at: number;
 92:   updated_at: number;
 93: };
 94: 
 95: export function audit(
 96:   event: string,
 97:   fields: { listing?: string; account?: string; detail?: unknown } = {}
 98: ): void {
 99:   db.query(
100:     'INSERT INTO audit (at, listing, account, event, detail) VALUES (?, ?, ?, ?, ?)'
101:   ).run(
102:     Date.now(),
103:     fields.listing ?? null,
104:     fields.account ?? null,
105:     event,
106:     fields.detail === undefined ? null : JSON.stringify(fields.detail)
107:   );
108: }
</file>

<file path="marketplace/server/dispatch.test.ts">
  1: import { describe, expect, test } from 'bun:test';
  2: import { Backoff, CLAIM_TTL_MS, PENDING_TTL_MS, decide } from './dispatch';
  3: 
  4: /**
  5:  * The policy that keeps one dead listing from starving the queue: what the
  6:  * worker does with a piece of work given the listing's state, whether the
  7:  * person it has to meet is online, and how long the row has been waiting.
  8:  */
  9: 
 10: const NOW = 1_700_000_000_000;
 11: const fresh = (state: 'pending' | 'claimed' | 'returning') => ({
 12:   id: 'L1',
 13:   state,
 14:   updatedAt: NOW - 1000,
 15: });
 16: 
 17: describe('a pending listing', () => {
 18:   test('is collected when the seller is online', () => {
 19:     expect(decide(fresh('pending'), true, NOW)).toEqual({ kind: 'go' });
 20:   });
 21: 
 22:   test('is tried anyway when presence cannot say', () => {
 23:     expect(decide(fresh('pending'), null, NOW)).toEqual({ kind: 'go' });
 24:   });
 25: 
 26:   test('waits while the seller is offline, and costs no warp', () => {
 27:     expect(decide(fresh('pending'), false, NOW).kind).toBe('wait');
 28:   });
 29: 
 30:   test('expires once the seller has had long enough, online or not', () => {
 31:     const old = { ...fresh('pending'), updatedAt: NOW - PENDING_TTL_MS - 1 };
 32:     expect(decide(old, true, NOW).kind).toBe('expire');
 33:     expect(decide(old, false, NOW).kind).toBe('expire');
 34:   });
 35: });
 36: 
 37: describe('a claimed listing', () => {
 38:   test('is delivered when the buyer is online', () => {
 39:     expect(decide(fresh('claimed'), true, NOW)).toEqual({ kind: 'go' });
 40:   });
 41: 
 42:   test('is released at once when the buyer is offline: the claim blocks the catalogue', () => {
 43:     expect(decide(fresh('claimed'), false, NOW).kind).toBe('release');
 44:   });
 45: 
 46:   test('is released when the buyer never came, even if they are online', () => {
 47:     const old = { ...fresh('claimed'), updatedAt: NOW - CLAIM_TTL_MS - 1 };
 48:     expect(decide(old, true, NOW).kind).toBe('release');
 49:   });
 50: });
 51: 
 52: describe('a player on another game server', () => {
 53:   test('is another bot\'s customer: the work waits, whatever its state', () => {
 54:     for (const state of ['pending', 'claimed', 'returning'] as const) {
 55:       const d = decide(fresh(state), true, NOW, false);
 56:       expect(d.kind).toBe('wait');
 57:       expect((d as { reason: string }).reason).toMatch(/another game server/);
 58:     }
 59:   });
 60: 
 61:   test('is served when they are here, or when presence cannot say where', () => {
 62:     expect(decide(fresh('pending'), true, NOW, true)).toEqual({ kind: 'go' });
 63:     expect(decide(fresh('pending'), true, NOW, null)).toEqual({ kind: 'go' });
 64:   });
 65: 
 66:   test('still loses a claim to its own deadline', () => {
 67:     const old = { ...fresh('claimed'), updatedAt: NOW - CLAIM_TTL_MS - 1 };
 68:     expect(decide(old, true, NOW, false).kind).toBe('release');
 69:   });
 70: });
 71: 
 72: describe('a returning listing', () => {
 73:   test('waits for the seller and never expires: the item is theirs', () => {
 74:     const old = { ...fresh('returning'), updatedAt: NOW - 100 * PENDING_TTL_MS };
 75:     expect(decide(old, false, NOW).kind).toBe('wait');
 76:     expect(decide(old, true, NOW)).toEqual({ kind: 'go' });
 77:   });
 78: });
 79: 
 80: describe('backoff', () => {
 81:   test('unknown work is due at once', () => {
 82:     expect(new Backoff().due('x', NOW)).toBe(true);
 83:   });
 84: 
 85:   test('a failure pushes the next try out, and each failure doubles the wait', () => {
 86:     const b = new Backoff();
 87:     b.failed('x', NOW);
 88:     expect(b.due('x', NOW)).toBe(false);
 89:     const first = b.remaining('x', NOW);
 90:     expect(first).toBeGreaterThan(0);
 91: 
 92:     b.failed('x', NOW);
 93:     expect(b.remaining('x', NOW)).toBe(first * 2);
 94:   });
 95: 
 96:   test('the wait is capped', () => {
 97:     const b = new Backoff();
 98:     for (let i = 0; i < 20; i++) b.failed('x', NOW);
 99:     expect(b.remaining('x', NOW)).toBeLessThanOrEqual(5 * 60_000);
100:   });
101: 
102:   test('success clears it', () => {
103:     const b = new Backoff();
104:     b.failed('x', NOW);
105:     b.succeeded('x');
106:     expect(b.due('x', NOW)).toBe(true);
107:   });
108: 
109:   test('work that left the queue is forgotten', () => {
110:     const b = new Backoff();
111:     b.failed('gone', NOW);
112:     b.failed('kept', NOW);
113:     b.keepOnly(['kept']);
114:     expect(b.due('gone', NOW)).toBe(true);
115:     expect(b.due('kept', NOW)).toBe(false);
116:   });
117: });
</file>

<file path="marketplace/server/dispatch.ts">
  1: /**
  2:  * When the bot should go, wait, or give up on a piece of work.
  3:  *
  4:  * Pure: it is fed the listing, what presence said, and the clock, and it
  5:  * answers. The worker used to walk the queue oldest first and try everything
  6:  * on every poll, which meant one seller who logged off mid-listing cost every
  7:  * customer behind them half a minute of warps at nobody, poll after poll,
  8:  * for ever. This is the policy that stops that.
  9:  */
 10: 
 11: export type WorkState = 'pending' | 'claimed' | 'returning';
 12: 
 13: export type Work = {
 14:   id: string;
 15:   state: WorkState;
 16:   /** When the row last changed state. */
 17:   updatedAt: number;
 18: };
 19: 
 20: export type Decision =
 21:   /** Go and do the handover. */
 22:   | { kind: 'go' }
 23:   /** Not now; the reason is for the log. */
 24:   | { kind: 'wait'; reason: string }
 25:   /** A claim to undo: the buyer is not there to be delivered to. */
 26:   | { kind: 'release'; reason: string }
 27:   /** A listing nobody will ever collect for: drop it. */
 28:   | { kind: 'expire'; reason: string };
 29: 
 30: /**
 31:  * A listing waits this long for the seller to actually hand the item over.
 32:  * They asked for it; if they walked away, the row would otherwise sit in the
 33:  * queue for ever, and the item never left their bag so nothing is lost.
 34:  */
 35: export const PENDING_TTL_MS = Number(process.env.MARKETPLACE_PENDING_TTL_MS ?? 30 * 60_000);
 36: 
 37: /**
 38:  * A claim holds the item out of the catalogue. A buyer who claimed and never
 39:  * showed gets this long before somebody else may have it.
 40:  */
 41: export const CLAIM_TTL_MS = Number(process.env.MARKETPLACE_CLAIM_TTL_MS ?? 10 * 60_000);
 42: 
 43: /**
 44:  * What to do with one piece of work.
 45:  *
 46:  * `online` is presence's answer for the person the bot has to meet - the
 47:  * buyer of a claim, the seller otherwise - or null when presence could not
 48:  * say, in which case the bot goes and finds out the expensive way.
 49:  */
 50: export function decide(
 51:   work: Work,
 52:   online: boolean | null,
 53:   now: number,
 54:   /** Whether they are on this bot's game server; null when presence cannot say. */
 55:   here: boolean | null = null
 56: ): Decision {
 57:   const age = now - work.updatedAt;
 58:   const who = work.state === 'claimed' ? 'the buyer' : 'the seller';
 59: 
 60:   // Online, but in another game server's copy of the world: another bot's
 61:   // customer. Nothing here is released or dropped for that - the claim keeps
 62:   // its own deadline - the bot simply does not set off.
 63:   const elsewhere = online === true && here === false;
 64: 
 65:   if (work.state === 'claimed') {
 66:     if (online === false) return { kind: 'release', reason: 'the buyer is not online' };
 67:     if (age > CLAIM_TTL_MS) return { kind: 'release', reason: 'the buyer never came' };
 68:     if (elsewhere) return { kind: 'wait', reason: `${who} is on another game server` };
 69:     return { kind: 'go' };
 70:   }
 71: 
 72:   if (work.state === 'pending') {
 73:     if (age > PENDING_TTL_MS) return { kind: 'expire', reason: 'the seller never handed it over' };
 74:     if (online === false) return { kind: 'wait', reason: 'the seller is not online' };
 75:     if (elsewhere) return { kind: 'wait', reason: `${who} is on another game server` };
 76:     return { kind: 'go' };
 77:   }
 78: 
 79:   // returning: the item is the bot's to give back whenever the seller is
 80:   // next seen. Nothing to expire; it waits.
 81:   if (online === false) return { kind: 'wait', reason: 'the seller is not online' };
 82:   if (elsewhere) return { kind: 'wait', reason: `${who} is on another game server` };
 83:   return { kind: 'go' };
 84: }
 85: 
 86: /** The pause after the first failure; it doubles from there. */
 87: const FIRST_DELAY_MS = 15_000;
 88: const MAX_DELAY_MS = 5 * 60_000;
 89: 
 90: /**
 91:  * Failed work is retried later and later, so a handover that keeps failing
 92:  * (a customer on another game server, a character the server cannot trace)
 93:  * does not take its full cost out of every poll.
 94:  */
 95: export class Backoff {
 96:   private readonly entries = new Map<string, { failures: number; notBefore: number }>();
 97: 
 98:   /** True when this id may be tried now. */
 99:   due(id: string, now: number): boolean {
100:     const entry = this.entries.get(id);
101:     return !entry || now >= entry.notBefore;
102:   }
103: 
104:   /** How long until this id may be tried again, for the log. 0 when due. */
105:   remaining(id: string, now: number): number {
106:     const entry = this.entries.get(id);
107:     return entry ? Math.max(0, entry.notBefore - now) : 0;
108:   }
109: 
110:   failed(id: string, now: number): void {
111:     const failures = (this.entries.get(id)?.failures ?? 0) + 1;
112:     const delay = Math.min(MAX_DELAY_MS, FIRST_DELAY_MS * 2 ** (failures - 1));
113:     this.entries.set(id, { failures, notBefore: now + delay });
114:   }
115: 
116:   succeeded(id: string): void {
117:     this.entries.delete(id);
118:   }
119: 
120:   /** Forgets ids no longer in the queue, so the map does not grow for ever. */
121:   keepOnly(ids: Iterable<string>): void {
122:     const keep = new Set(ids);
123:     for (const id of [...this.entries.keys()]) if (!keep.has(id)) this.entries.delete(id);
124:   }
125: }
</file>

