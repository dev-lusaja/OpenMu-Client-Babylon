368: /**
369:  * Two bots trading with each other, which is the escrow handover in miniature:
370:  * the seller hands an item over and the buyer pays for it, in one exchange the
371:  * game server performs.
372:  */
373: async function simulate(password: string): Promise<void> {
374:   const sellerName = arg('seller', 'MKT001')!;
375:   const buyerName = arg('buyer', 'MKT002')!;
376:   const itemSlot = Number(arg('slot', '12'));
377:   const price = Number(arg('price', '0'));
378: 
379:   const seller = await connectBot(sellerName, password);
380:   const buyer = await connectBot(buyerName, password);
381: 
382:   try {
383:     // The seller goes to the buyer rather than the other way round. `/trace`
384:     // is a game master warp, which is why the bot accounts need that status.
385:     // Both sides have to settle into the world before the warp, and the trade
386:     // needs them to see *each other*: the server resolves a trade partner out
387:     // of the requester's own observers, so one-way visibility is refused with
388:     // "Trade partner not found". Warping in on top of a player who is still
389:     // entering leaves exactly that.
390:     await sleep(2000);
391: 
392:     const partner = await meetUp(seller, buyer);
393:     log(`${buyer.name} is in scope at ${partner.x},${partner.y} (id ${partner.id})`);
394: 
395:     // Armed before the request goes out, so the invitation cannot be missed.
396:     const accepted = buyer.connection
397:       .expect({ code: TRADE_REQUEST_CODE }, 20_000, 'an invitation to trade')
398:       .then(async frame => {
399:         log(`${buyer.name} was asked to trade by ${incomingRequestName(frame)}`);
400:         await buyer.trade.accept();
401:       });
402: 
403:     await seller.trade.requestWith(partner.id);
404:     await accepted;
405:     log('trade is open on both sides');
406: 
407:     seller.trade.offerItem(itemSlot, 0);
408:     if (price > 0) buyer.trade.setMoney(price);
409:     await sleep(2000);
410: 
411:     log(
412:       `table: buyer sees ${buyer.trade.theirItems.size} item(s); ` +
413:         `seller sees ${seller.trade.theirMoney} Zen`
414:     );
415: 
416:     // Cancel with Zen still on the table, without either side confirming.
417:     if (process.argv.includes('--cancel-early')) {
418:       log('cancelling with money on the table, before any confirm');
419:       const finish = buyer.trade.waitForFinish(15_000);
420:       buyer.trade.cancel();
421:       log(`cancel outcome: ${JSON.stringify(await finish)}`);
422:       const hold = Number(arg('hold', '0'));
423:       if (hold > 0) {
424:         log(`holding the session open for ${hold}s so a periodic save can run`);
425:         await sleep(hold * 1000);
426:       }
427:       return;
428:     }
429: 
430:     // Both sides check the table against what was agreed before confirming,
431:     // and they confirm one after the other: the server completes the trade on
432:     // whichever confirm lands second, so the two must not race.
433:     const sellerFinish = seller.trade.waitForFinish();
434:     const buyerFinish = buyer.trade.waitForFinish();
435: 
436:     const sellerRefused = seller.trade.armConfirm({ expectMoney: price });
437:     if (sellerRefused) log(`seller refused to confirm: ${sellerRefused}`);
438:     await sleep(500);
439: 
440:     const buyerRefused = buyer.trade.armConfirm({ expectItems: 1 });
441:     if (buyerRefused) log(`buyer refused to confirm: ${buyerRefused}`);
442: 
443:     const [sellerOutcome, buyerOutcome] = await Promise.all([sellerFinish, buyerFinish]);
444: 
445:     log(`seller: ${sellerOutcome.ok ? 'ok' : `failed - ${sellerOutcome.reason}`}`);
446:     log(`buyer: ${buyerOutcome.ok ? 'ok' : `failed - ${buyerOutcome.reason}`}`);
447:   } finally {
448:     await disposeBot(buyer);
449:     await disposeBot(seller);
450:   }
451: }
