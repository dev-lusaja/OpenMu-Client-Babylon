 31: /** `Store.loginRequest`: Xor3 over the zero-padded name and password. */
 32: function loginFrame(encryptor: SimpleModulusEncryptor, xor32: Xor32Encryptor, name: string): Uint8Array {
 33:   const packet = new Uint8Array(50);
 34:   packet[0] = 0xc3;
 35:   packet[1] = 50;
 36:   packet[2] = 0xf1;
 37:   packet[3] = 0x01;
 38: 
 39:   const username = stringToBytes(name, 10);
 40:   Xor3Byte(username);
 41:   packet.set(username, 4);
 42: 
 43:   const password = stringToBytes('secret', 10);
 44:   Xor3Byte(password);
 45:   packet.set(password, 14);
 46: 
 47:   packet.set(stringToBytes('10404', 5), 28);
 48:   packet.set(stringToBytes('k1Pk2jcET48mxL3b', 16), 33);
 49: 
 50:   return encryptor.Encrypt(xor32.Encrypt(packet));
 51: }
