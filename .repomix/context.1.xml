  1: import {
  2:   ClientReadyAfterMapChangePacket,
  3:   LogOutPacket,
  4:   CreateCharacterPacket,
  5:   LoginShortPasswordPacket,
  6:   PublicChatMessagePacket,
  7:   RequestCharacterListPacket,
  8:   SelectCharacterPacket,
  9: } from '../../src/common/packets/ClientToServerPackets';
 10: import { CharacterClassNumber } from '../../src/common/types';
 11: import {
 12:   CharacterCreationSuccessfulPacket,
 13:   CharacterInformationPacket,
 14:   CharacterListPacket,
 15:   LoginResponseLoginResultEnum,
 16:   LoginResponsePacket,
 17: } from '../../src/common/packets/ServerToClientPackets';
 18: import { Xor3Byte } from '../../src/common/encryption/xor3';
 19: import { stringToBytes } from '../../src/common/wireUtils';
 20: import { gameVersion } from '../../versions/season6';
 21: import { BotConnection, type Frame } from './connection';
 22: 
 23: /**
 24:  * Getting a bot from a socket to a character standing in the world.
 25:  *
 26:  * Every step is request-then-await with a deadline, in the order the browser
 27:  * client does them (`Store.loginRequest`, `refreshCharactersListRequest`,
 28:  * `selectCharacterRequest`). A step that does not get its answer throws rather
 29:  * than leaving a half-logged-in bot for the escrow queue to trip over.
 30:  */
 31: 
 32: /** `CharacterStatus.GameMaster`, a bit in `CharacterInformation.Status`. */
 33: const GAME_MASTER_STATUS = 32;
 34: 
 35: /** The client's own field widths for the login frame. */
 36: const MAX_USERNAME_LENGTH = 10;
 37: const MAX_PASSWORD_LENGTH = 10;
 38: 
 39: const CODE = {
 40:   loginResponse: { code: 0xf1, sub: 0x01 },
 41:   characterList: { code: 0xf3, sub: 0x00 },
 42:   characterInformation: { code: 0xf3, sub: 0x03 },
 43:   characterCreated: { code: 0xf3, sub: 0x01 },
 44:   mapChanged: { code: 0x1c, sub: 0x0f },
 45:   magicEffectStatus: { code: 0x07 },
 46: } as const;
 47: 
 48: /** How long the server gets to confirm `/hide` before it is called ineffective. */
 49: const HIDE_ACK_MS = 3000;
 50: 
 51: /** A generated packet class reads from byteOffset 0, so the frame is copied. */
 52: export function view(frame: Frame): DataView {
 53:   return new DataView(
 54:     frame.bytes.buffer.slice(
 55:       frame.bytes.byteOffset,
 56:       frame.bytes.byteOffset + frame.bytes.length
 57:     )
 58:   );
 59: }
 60: 
 61: export type CharacterEntry = ReturnType<CharacterListPacket['getCharacters']>[number];
 62: 
 63: export type BotIdentity = {
 64:   account: string;
 65:   password: string;
 66:   /** Which character to play. Defaults to the lowest slot. */
 67:   character?: string;
 68:   /** Create the character when the account has none. Bot accounts do. */
 69:   createIfMissing?: boolean;
 70:   characterClass?: CharacterClassNumber;
 71: };
 72: 
 73: export class BotSession {
 74:   character: CharacterEntry | null = null;
 75:   /**
 76:    * Whether the character entered the world as a game master. Read from
 77:    * `CharacterInformation`, the packet the server answers a select with: the
 78:    * character list also names a status, but in four bits, and the game
 79:    * master value is 32.
 80:    */
 81:   gameMaster = false;
 82: 
 83:   constructor(
 84:     private readonly connection: BotConnection,
 85:     private readonly identity: BotIdentity,
 86:     private readonly log: (message: string) => void = () => {}
 87:   ) {}
 88: 
 89:   /** Socket to standing in the world. Throws on any refusal or silence. */
 90:   async enterWorld(): Promise<CharacterEntry> {
 91:     await this.login();
 92:     const characters = await this.listCharacters();
 93:     const chosen = this.choose(characters);
 94:     await this.select(chosen);
 95:     this.character = chosen;
 96:     return chosen;
 97:   }
 98: 
 99:   private async login(): Promise<void> {
100:     const username = stringToBytes(this.identity.account, MAX_USERNAME_LENGTH);
101:     const password = stringToBytes(this.identity.password, MAX_PASSWORD_LENGTH);
102:     Xor3Byte(username);
103:     Xor3Byte(password);
104: 
105:     const packet = LoginShortPasswordPacket.createPacket();
106:     packet.setUsername(username, username.length);
107:     packet.setPassword(password, password.length);
108:     packet.setClientVersion(gameVersion.clientVersionBytes);
109:     packet.setClientSerial(gameVersion.serialBytes);
110: 
111:     const answer = this.connection.expect(CODE.loginResponse, 15_000, 'LoginResponse');
112:     this.connection.send(packet.buffer);
113: 
114:     const result = new LoginResponsePacket(view(await answer)).Success;
115:     if (result !== LoginResponseLoginResultEnum.Okay) {
116:       throw new Error(
117:         `login refused for ${this.identity.account}: ${LoginResponseLoginResultEnum[result] ?? result}`
118:       );
119:     }
120:     this.log(`logged in as ${this.identity.account}`);
121:   }
122: 
123:   private async listCharacters(): Promise<CharacterEntry[]> {
124:     const packet = RequestCharacterListPacket.createPacket();
125:     packet.Language = 0;
126: 
127:     const answer = this.connection.expect(CODE.characterList, 15_000, 'CharacterList');
128:     this.connection.send(packet.buffer);
129: 
130:     const characters = new CharacterListPacket(view(await answer)).getCharacters();
131:     if (characters.length > 0) return characters;
132: 
133:     // A fresh bot account has none. Rather than making a person go and click
134:     // through character creation for every mule, the bot makes its own through
135:     // the protocol, so the server applies its own rules to it.
136:     if (!this.identity.createIfMissing) {
137:       throw new Error(`${this.identity.account} has no characters`);
138:     }
139:     return this.createCharacter();
140:   }
141: 
142:   private async createCharacter(): Promise<CharacterEntry[]> {
143:     const name = this.identity.character ?? this.identity.account;
144:     this.log(`no characters on ${this.identity.account}, creating "${name}"`);
145: 
146:     const packet = CreateCharacterPacket.createPacket();
147:     packet.setName(name);
148:     packet.Class = this.identity.characterClass ?? CharacterClassNumber.DarkKnight;
149: 
150:     const created = this.connection.expect(
151:       CODE.characterCreated,
152:       15_000,
153:       'CharacterCreationSuccessful'
154:     );
155:     this.connection.send(packet.buffer);
156: 
157:     const answer = new CharacterCreationSuccessfulPacket(view(await created));
158:     if (!answer.Success) throw new Error(`the server refused to create "${name}"`);
159: 
160:     // The answer carries the character, so it is read from there rather than
161:     // by asking for the list again: the server does not answer a second
162:     // `RequestCharacterList` in this state, and waiting for one hangs until
163:     // it drops the connection.
164:     this.log(`created "${answer.CharacterName}" in slot ${answer.CharacterSlot}`);
165:     return [
166:       {
167:         SlotIndex: answer.CharacterSlot,
168:         Name: answer.CharacterName,
169:         Level: answer.Level,
170:         Status: answer.CharacterStatus,
171:         IsItemBlockActive: false,
172:         Appearance: answer.PreviewData,
173:         GuildPosition: 0,
174:       } as CharacterEntry,
175:     ];
176:   }
177: 
178:   /**
179:    * Sends a chat line. The bot's own commands go this way too: `/trace <name>`
180:    * warps a game master to a player, which is how it reaches someone rather
181:    * than making them walk to it.
182:    */
183:   say(message: string): void {
184:     const name = this.character?.Name ?? this.identity.account;
185:     const packet = PublicChatMessagePacket.createPacket(
186:       PublicChatMessagePacket.getRequiredSize(10 + message.length)
187:     );
188:     packet.setCharacter(name);
189:     packet.setMessage(message);
190:     this.connection.send(packet.buffer);
191:   }
192: 
193:   /**
194:    * `/trace <character>`: game-master warp to wherever that player is standing.
195:    *
196:    * A warp is a map change even when the destination is the map the bot is
197:    * already on. `PlayerMapTransitions.WarpToAsync` clears `CurrentMap` and
198:    * parks the player in `ChangingMap` either way, then waits for the client to
199:    * say it has finished loading - and until that acknowledgement the server
200:    * sends nothing at all. No players, no monsters, no scope.
201:    *
202:    * So a bot that warps and then waits to see somebody waits forever, and
203:    * every warp after the first is made from limbo. This is the same handshake
204:    * `enterWorld` performs after selecting a character, for the same reason.
205:    *
206:    * Rejects when no map change arrives, which is what `/trace` on a name
207:    * nobody is using looks like from here.
208:    */
209:   async warpTo(characterName: string): Promise<void> {
210:     const changed = this.connection.expect(CODE.mapChanged, 10_000, 'MapChanged');
211:     this.say(`/trace ${characterName}`);
212:     await changed;
213:     this.connection.send(ClientReadyAfterMapChangePacket.createPacket().buffer);
214:   }
215: 
216:   /**
217:    * `/skin <monster>`: wears a monster's appearance.
218:    *
219:    * Cosmetic, and the point is honesty rather than decoration: a bot that
220:    * looks like an ordinary character standing in a bar is a stranger warping
221:    * onto people and opening shops. One that looks like the Budge Dragon
222:    * reads as what it is - the marketplace's courier - at a glance and
223:    * without a word of explanation.
224:    *
225:    * The number is a `MonsterDefinition.Number`; 2 is the Budge Dragon.
226:    */
227:   skinAs(monsterNumber: number): void {
228:     this.say(`/skin ${monsterNumber}`);
229:   }
230: 
231:   /**
232:    * `/hide`: a game master steps out of everybody's view.
233:    *
234:    * The server drops the bot from every observer and refuses new ones, so a
235:    * bot parked between handovers is not a stranger standing on somebody's
236:    * tile. It still sees the world itself, which is what a warp needs.
237:    */
238:   hide(): void {
239:     // The server answers a hide that took with the Invisible effect going
240:     // active on us. A database from before that effect existed answers
241:     // nothing at all, and the bot stands in plain sight believing it is
242:     // hidden - so the silence is written down, once.
243:     const ack = this.connection.expect(CODE.magicEffectStatus, HIDE_ACK_MS, 'MagicEffectStatus');
244:     this.say('/hide');
245:     ack.then(
246:       () => {
247:         this.hideConfirmed = true;
248:       },
249:       () => {
250:         if (this.hideConfirmed || this.hideWarned) return;
251:         this.hideWarned = true;
252:         this.log(
253:           'the server did not confirm /hide; the bot is probably visible. ' +
254:             'The Invisible magic effect is missing from the game database ' +
255:             '(OpenMU adds it with its duel configuration update)'
256:         );
257:       }
258:     );
259:   }
260: 
261:   private hideConfirmed = false;
262:   private hideWarned = false;
263: 
264:   /**
265:    * `/unhide`: back into view, announced properly.
266:    *
267:    * The server re-spawns the bot on its map, so everyone nearby gets a fresh
268:    * scope entry - the one thing a warp alone never does. This is what puts
269:    * the bot on the customer's screen, and in the skin it is wearing.
270:    */
271:   unhide(): void {
272:     this.say('/unhide');
273:   }
274: 
275:   /**
276:    * `/teleport <x> <y>`: a game-master move within the current map.
277:    *
278:    * This exists because a warp does not announce the bot to the people already
279:    * standing there. `/trace` is a map change: it takes the bot out of the world
280:    * and puts it back, which removes it from the target's scope, and the target
281:    * is never told it returned - so the two end up one-way visible and the
282:    * server refuses the trade. An in-map move is broadcast to observers the
283:    * ordinary way, the same as walking, so following the warp with one is what
284:    * actually puts the bot on the customer's screen.
285:    */
286:   teleportTo(x: number, y: number): void {
287:     this.say(`/teleport ${x} ${y}`);
288:   }
289: 
290:   /**
291:    * Logs out properly instead of just dropping the socket.
292:    *
293:    * Worth doing every time: the server keeps an account connected for a while
294:    * after its socket dies, and the next login is refused with
295:    * `AccountAlreadyConnected` until it gives up. A bot that exits by closing
296:    * the socket locks itself out of its own account for the next run.
297:    */
298:   logOut(): void {
299:     this.connection.send(LogOutPacket.createPacket().buffer);
300:   }
301: 
302:   /**
303:    * The named character, or the lowest slot. Named is what production uses:
304:    * a mule's slots are ours to arrange, and a bot that silently picks a
305:    * different character would deliver from the wrong inventory.
306:    */
307:   private choose(characters: CharacterEntry[]): CharacterEntry {
308:     const wanted = this.identity.character;
309:     if (wanted === undefined) {
310:       return [...characters].sort((a, b) => a.SlotIndex - b.SlotIndex)[0];
311:     }
312: 
313:     const found = characters.find(c => c.Name === wanted);
314:     if (!found) {
315:       const names = characters.map(c => c.Name).join(', ');
316:       throw new Error(`${this.identity.account} has no character "${wanted}" (has: ${names})`);
317:     }
318:     return found;
319:   }
320: 
321:   private async select(character: CharacterEntry): Promise<void> {
322:     const packet = SelectCharacterPacket.createPacket();
323:     packet.setName(character.Name);
324: 
325:     const answer = this.connection.expect(
326:       CODE.characterInformation,
327:       15_000,
328:       'CharacterInformation'
329:     );
330:     this.connection.send(packet.buffer);
331: 
332:     const info = new CharacterInformationPacket(view(await answer));
333:     this.gameMaster = (Number(info.Status) & GAME_MASTER_STATUS) !== 0;
334: 
335:     // Without this the server never starts streaming the world: it holds the
336:     // player until the client says it has finished loading the map
337:     // (`CharacterClientReadyPacketHandlerPlugIn` -> `ClientReadyAfterMapChange`).
338:     // A bot that skips it stands in an empty world, sees nobody, and can never
339:     // trade, because a trade partner has to be in scope.
340:     this.connection.send(ClientReadyAfterMapChangePacket.createPacket().buffer);
341: 
342:     this.log(
343:       `entered the world as ${character.Name} on map ${info.MapId} at ${info.X},${info.Y}`
344:     );
345:   }
346: }
</file>

