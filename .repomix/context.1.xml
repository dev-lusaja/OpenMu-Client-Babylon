 855:   /**
 856:    * Whether the running game configuration defines this item at all, so a
 857:    * gacha roll can be checked before it is committed rather than failing the
 858:    * player at delivery with an item the game cannot hand over. Null when the
 859:    * database cannot be asked, which the caller must treat as "do not roll".
 860:    */
 861:   async grantable(group: number, number: number): Promise<boolean | null> {
 862:     const key = `${group}/${number}`;
 863:     const known = this.grantableByKey.get(key);
 864: 
 865:     if (known !== undefined) return known;
 866: 
 867:     try {
 868:       const resolved = await this.resolveOnce();
 869:       const found = (await findDefinition(this.sql, resolved, group, number)) !== null;
 870: 
 871:       this.grantableByKey.set(key, found);
 872: 
 873:       return found;
 874:     } catch (error) {
 875:       console.error(`definition lookup for ${key} failed:`, describe(error));
 876:       return null;
 877:     }
 878:   }
