184:     level,
185:     bot: {
186:       name: character.Name,
187:       connection,
188:       session,
189:       bag,
190:       shop,
191:       busy: false,
192:       context: {
193:         session,
194:         trade,
195:         scope,
196:         wallet,
197:         shop: shopUsable ? shop : undefined,
198:         bag,
199:         messages,
200:         stealth: STEALTH,
201:         ledger: new Ledger(undefined, (m: string) => log(`[ledger] ${m}`)),
202:         botName: character.Name,
203:         log: (m: string) => log(`[${name}] ${m}`),
204:       },
205:     },
206:   };
207: }
208: 
209: /**
210:  * Keeps one bot in the world for as long as the process runs.
211:  *
212:  * A character the bot has just made is not a game master until the database
213:  * says so, and `/hide`, `/skin` and `/trace` are game master commands; with
214:  * `DATABASE_URL` the fleet promotes it and logs in again, without it the bot
215:  * is left out and the log says why.
216:  */
217: async function runBot(name: string): Promise<never> {
218:   for (;;) {
219:     let bot: Bot | null = null;
220:     try {
221:       const entered = await connect(name);
222:       const short = !entered.gameMaster || entered.level < OUTFIT.level;
223:       if (short && DATABASE_URL) {
224:         // Written while the bot is out: a logged-in character is saved back
225:         // over anything written underneath it. The server saves on logout,
226:         // so the write waits for that, and the login waits for the account
227:         // to be let go.
228:         log(
229:           `[${name}] ${entered.gameMaster ? `is level ${entered.level}` : 'is not a game master yet'}; ` +
230:             `outfitting the character and logging in again`
231:         );
232:         entered.bot.session.logOut();
233:         await sleep(8_000);
234:         entered.bot.connection.close();
235:         await outfitBotCharacters(DATABASE_URL, OUTFIT);
236:         await sleep(12_000);
237:         continue;
238:       }
239:       if (!entered.gameMaster) {
240:         log(
241:           `[${name}] is not a game master and DATABASE_URL is not set, so it cannot hide, ` +
242:             `dress or reach anybody: run createAccounts.ts, then it will serve`
243:         );
244:         entered.bot.session.logOut();
245:         await sleep(500);
246:         entered.bot.connection.close();
247:         await sleep(5 * 60_000);
248:         continue;
249:       }
250: 
251:       bot = entered.bot;
252:       fleet.set(name, bot);
253:       log(`${name} ready; ${fleet.size} of ${NAMES.length} bot(s) up`);
254:       while (bot.connection.connected) await sleep(1000);
255:       log(`[${name}] connection lost; reconnecting`);
256:     } catch (error) {
257:       log(`[${name}] error: ${error instanceof Error ? error.message : error}`);
258:     } finally {
259:       if (bot) {
260:         fleet.delete(name);
261:         try {
262:           bot.session.logOut();
263:           await sleep(500);
264:         } catch {
265:           // Already gone.
266:         }
267:         bot.connection.close();
268:       }
269:     }
270: 
271:     // The account stays connected server side for a moment after a socket
272:     // drops, so reconnecting immediately would be refused.
273:     await sleep(15_000);
274:   }
275: }
276: 
277: /**
278:  * The one bag slot holding this listing's item, when the bag can say.
279:  *
280:  * Slots already written down against other listings are ruled out first, so
281:  * two listings of the same kind of item never resolve to the same square.
282:  * Null when there is no candidate or more than one: guessing is what put
283:  * empty slots up for sale.
284:  */
285: function findHeld(bot: Bot, listing: store.Listing): number | null {
286:   if (!bot.bag.known) return null;
287:   const taken = store.heldSlots(bot.name);
288:   const candidates = bot.bag
289:     .slotsWhere(bytes => sameItem(bytes, listing.item as ListedItem))
290:     .filter(slot => !taken.has(slot));
291:   return candidates.length === 1 ? candidates[0] : null;
292: }
293: 
294: /** True when the recorded slot holds the listed item itself, not merely something. */
295: function holdsListed(bot: Bot, slot: number, listing: store.Listing): boolean {
296:   const bytes = bot.bag.slots.get(slot);
297:   return bytes !== undefined && sameItem(bytes, listing.item as ListedItem);
298: }
299: 
300: /**
301:  * The slot to offer from: the recorded one, or the bag's answer, or none.
302:  *
303:  * The recorded slot is trusted only while it holds the item the listing
304:  * describes: what goes out to a buyer is checked against what they were
305:  * shown, never taken on the slot number's word. An item can also be sitting
306:  * in the stall grid: an earlier run stocked the shop, misread the server's
307:  * answer as a refusal, and never put it back. That one is brought back into
308:  * the bag first - an item is only ever offered from a bag slot - and the
309:  * listing learns its new home.
310:  */
311: async function slotFor(bot: Bot, listing: store.Listing): Promise<number | null> {
312:   const { holder, slot } = store.holderOf(listing.id);
313:   if (holder !== null && holder !== bot.name) return null;
314:   if (slot !== null && !bot.bag.known) return slot;
315:   if (slot !== null && holdsListed(bot, slot, listing)) return slot;
316:   if (slot !== null && bot.bag.slots.has(slot)) {
317:     log(`[${bot.name}] "${listing.id}": bag slot ${slot} holds something other than the listed item`);
318:   }
319: 
320:   let found = findHeld(bot, listing);
321:   if (found === null) found = await recoverFromStall(bot, listing);
322:   if (found !== null && found !== slot) {
323:     log(`[${bot.name}] "${listing.id}" is in slot ${found}, not ${slot ?? 'unknown'}; adopting it`);
324:     store.adoptSlot(listing.id, found);
325:   }
326:   return found;
327: }
328: 
329: /** Moves a stranded item from the stall back into the bag; the new bag slot, or null. */
330: async function recoverFromStall(bot: Bot, listing: store.Listing): Promise<number | null> {
331:   const stranded = bot.bag.stallSlotsWhere(bytes => sameItem(bytes, listing.item as ListedItem));
332:   if (stranded.length !== 1) return null;
333: 
334:   // A shop that is open refuses every move out of it.
335:   bot.shop.close();
336:   for (const free of bot.bag.freeBagSlots().slice(0, 8)) {
337:     try {
338:       await bot.shop.unstockItem(stranded[0], free);
339:       log(`[${bot.name}] "${listing.id}" was stranded in stall slot ${stranded[0]}; back in bag slot ${free}`);
340:       audit('recovered from stall', { listing: listing.id, detail: { from: stranded[0], to: free } });
341:       return free;
342:     } catch {
343:       // That square did not fit it; the next one may.
344:     }
345:   }
346:   log(`[${bot.name}] "${listing.id}" is stranded in stall slot ${stranded[0]} and no bag square would take it`);
347:   return null;
348: }
349: 
350: /** A seller is handing an item over, so it can go on sale. Returns done. */
351: async function collect(bot: Bot, listing: store.Listing): Promise<boolean> {
352:   log(`[${bot.name}] collecting "${listing.id}" from ${listing.sellerCharacter}`);
353:   const result = await collectListing(
354:     bot.context,
355:     listing.sellerCharacter,
356:     1,
357:     listing.item as ListedItem
358:   );
359: 
360:   if (!result.ok) {
361:     if (result.declined) {
362:       // The seller said no, cancelled the trade, or left it open: it is their
363:       // item and their call, and the bot does not come back asking.
364:       log(`[${bot.name}] "${listing.id}" dropped: ${result.reason}`);
365:       store.drop(listing.id, result.reason);
366:       return true;
367:     }
368:     log(`[${bot.name}] could not collect "${listing.id}": ${result.reason}`);
369:     audit('collect failed', { listing: listing.id, detail: result.reason });
370:     return false;
371:   }
372:   // Recorded as held before anything else can go wrong. The item has left
373:   // the seller's bag; if this row is not written the next poll treats the
374:   // listing as uncollected and takes another one.
375:   store.activate(listing.id, bot.name, result.slot);
376: 
377:   if (result.slot === null) {
378:     // The bag may still know: the item is the only one of its kind that is
379:     // not already spoken for.
380:     const found = findHeld(bot, listing);
381:     if (found !== null) {
382:       store.adoptSlot(listing.id, found);
383:       log(`[${bot.name}] "${listing.id}" is on sale, held in slot ${found} (found in the bag)`);
384:       return true;
385:     }
386:     // Held, but nobody can say where. Off sale rather than sold and then
387:     // never delivered; a person sorts it out.
388:     store.markStuck(listing.id, 'collected without a known slot');
389:     log(`[${bot.name}] "${listing.id}" is held but its slot is unknown; it is marked stuck`);
390:     return true;
391:   }
392:   log(`[${bot.name}] "${listing.id}" is on sale, held in slot ${result.slot}`);
393:   return true;
394: }
395: 
396: /**
397:  * Whether a refused shop delivery is worth trying as a trade.
398:  *
399:  * Only for the reasons a shop is structurally unable to help with. "Nobody
400:  * bought it" is not one: the buyer had three minutes and did not come, and
401:  * opening a trade window at them instead would be pestering, not delivering.
402:  */
403: function shopUnavailable(reason: string): boolean {
404:   return (
405:     reason.includes('no shop') ||
406:     reason.includes('CharacterLevelTooLow') ||
407:     reason.includes('ItemIsBlocked') ||
408:     reason.includes('would not open') ||
409:     reason.includes('would not take it') ||
410:     reason.includes('did not reach shop slot')
411:   );
412: }
413: 
414: /** A buyer has reserved something: hand it over and take the price. */
415: async function deliver(bot: Bot, listing: store.Listing): Promise<boolean> {
416:   if (!listing.buyerCharacter) {
417:     store.release(listing.id, 'claimed without a buyer character');
418:     return true;
419:   }
420: 
421:   const slot = await slotFor(bot, listing);
422:   if (slot === null) {
423:     store.markStuck(listing.id, 'held item not found in the bag');
424:     log(`[${bot.name}] "${listing.id}" cannot be delivered: the held item is not in the bag; marked stuck`);
425:     return true;
426:   }
427: 
428:   log(`[${bot.name}] delivering "${listing.id}" to ${listing.buyerCharacter} for ${listing.price}`);
429:   // Through the shop, because the server pairs item and payment there in one
430:   // step: no table to leave empty, no confirm to get wrong, and no cancel to
431:   // destroy the buyer's Zen. Trading stays the fallback for what a shop
432:   // cannot sell - a Harmony item, or a bot too low to open one.
433:   let result: EscrowResult = await deliverViaShop(
434:     bot.context,
435:     listing.buyerCharacter,
436:     slot,
437:     listing.price
438:   );
439:   if (!result.ok && shopUnavailable(result.reason)) {
440:     log(`[${bot.name}] shop delivery refused (${result.reason}); trading instead`);
441:     result = await deliverPurchase(bot.context, listing.buyerCharacter, slot, listing.price);
442:   }
443: 
444:   if (!result.ok) {
445:     if (result.reason.startsWith(HELD_ITEM_MISSING)) {
446:       store.markStuck(listing.id, result.reason);
447:       log(`[${bot.name}] "${listing.id}": ${result.reason}; marked stuck`);
448:       return true;
449:     }
450:     // Back on sale rather than stuck: the buyer never paid, so nobody is owed
451:     // anything and somebody else can have it.
452:     log(`[${bot.name}] could not deliver "${listing.id}": ${result.reason}; back on sale`);
453:     store.release(listing.id, result.reason);
454:     return false;
455:   }
456:   store.settleSale(listing.id);
457:   log(`[${bot.name}] "${listing.id}" sold; ${listing.seller} is owed ${listing.price}`);
458:   return true;
459: }
460: 
461: /** A cancelled listing nobody ever collected: nothing to return, the row just closes. */
462: function closeUncollected(listing: store.Listing): void {
463:   db.query(`UPDATE listings SET state = 'cancelled', updated_at = ? WHERE id = ?`).run(
464:     Date.now(),
465:     listing.id
466:   );
467: }
468: 
469: /** A seller cancelled: give it back. */
470: async function giveBack(bot: Bot, listing: store.Listing): Promise<boolean> {
471:   const slot = await slotFor(bot, listing);
472:   if (slot === null) {
473:     store.markStuck(listing.id, 'held item not found in the bag');
474:     log(`[${bot.name}] "${listing.id}" cannot be returned: the held item is not in the bag; marked stuck`);
475:     return true;
476:   }
477: 
478:   log(`[${bot.name}] returning "${listing.id}" to ${listing.sellerCharacter}`);
479:   const result = await deliverPurchase(bot.context, listing.sellerCharacter, slot, 0);
480:   if (!result.ok) {
481:     if (result.reason.startsWith(HELD_ITEM_MISSING)) {
482:       store.markStuck(listing.id, result.reason);
483:       return true;
484:     }
485:     if (result.declined) {
486:       // They asked for it back and then would not take it. Back on sale at
487:       // the same price; cancelling again is one click.
488:       log(`[${bot.name}] "${listing.id}" back on sale: ${result.reason}`);
489:       store.backOnSale(listing.id, result.reason);
490:       return true;
491:     }
492:     log(`[${bot.name}] could not return "${listing.id}": ${result.reason}`);
493:     audit('return failed', { listing: listing.id, detail: result.reason });
494:     return false;
495:   }
496:   closeUncollected(listing);
497:   return true;
498: }
499: 
500: /** A seller who pressed Collect. Returns done (whether or not they got paid). */
501: async function pay(bot: Bot, request: store.PayoutRequest): Promise<boolean> {
502:   const taken = store.takeBalance(request.account);
503:   if (taken <= 0) {
504:     store.clearPayoutRequest(request.account);
505:     return true;
506:   }
507: 
508:   log(`[${bot.name}] paying ${request.account} ${taken} Zen via ${request.character}`);
509:   const result = await payOut(bot.context, request.character, taken);
510:   if (!result.ok) {
511:     // Credited back rather than lost: the money never left the bot.
512:     store.credit(request.account, taken);
513:     log(`[${bot.name}] could not pay ${request.account} ${taken} Zen: ${result.reason}; credited back`);
514:     audit('payout failed', { account: request.account, detail: result.reason });
515:     if (result.declined) {
516:       // They refused the Zen. The request is done; Collect asks again.
517:       store.clearPayoutRequest(request.account);
518:       return true;
519:     }
520:     return false;
521:   }
522:   store.clearPayoutRequest(request.account);
523:   audit('payout paid', { account: request.account, detail: { zen: taken } });
524:   return true;
525: }
526: 
527: /**
528:  * The fleet as the scheduler sees it, right now. With an item, each bot also
529:  * says whether that item would fit in its bag; a bag the server has not
530:  * listed yet is given the benefit of the doubt.
531:  */
532: function runners(item?: store.Item): Runner[] {
533:   return [...fleet.values()]
534:     .filter(b => b.connection.connected)
535:     .map(b => ({
536:       name: b.name,
537:       busy: b.busy,
538:       zen: b.context.wallet?.zen ?? null,
539:       hasRoom: item && b.bag.known ? b.bag.canHold(item) : true,
540:     }));
541: }
542: 
543: /**
544:  * Runs one job on one bot, and gives everything back afterwards: the leases,
545:  * the bot, and the record of whether it worked.
546:  */
547: async function runJob(
548:   bot: Bot,
549:   key: string,
550:   leases: string[],
551:   job: () => Promise<boolean>
552: ): Promise<void> {
553:   let done = false;
554:   try {
555:     done = await job();
556:   } catch (error) {
557:     log(`[${bot.name}] ${key} failed: ${error instanceof Error ? error.message : error}`);
558:   } finally {
559:     store.releaseLeases(leases, bot.name);
560:     bot.busy = false;
561:   }
562: 
563:   if (done) backoff.succeeded(key);
564:   else {
565:     backoff.failed(key, Date.now());
566:     log(`${key} will be tried again in ${Math.round(backoff.remaining(key, Date.now()) / 1000)}s`);
567:   }
568: }
569: 
570: /**
571:  * One pass over the work: every job that can go now is handed to a bot and
572:  * runs on its own; the next pass sees the rest.
573:  */
574: async function tick(): Promise<void> {
575:   const work = store.pendingWork();
576:   const requests = store.payoutRequests();
577:   backoff.keepOnly([...work.map(l => l.id), ...requests.map(r => `payout:${r.account}`)]);
578: 
579:   for (const listing of work) {
580:     const now = Date.now();
581:     const key = `"${listing.id}"`;
582:     if (!backoff.due(listing.id, now)) continue;
583:     // In hand already: this fleet's, or another's on the same rows.
584:     if (store.leaseHolder(`listing:${listing.id}`) !== null) continue;
585: 
586:     // A cancellation of something never collected needs nobody: the item is
587:     // still in the seller's bag, and the row just closes.
588:     if (listing.state === 'returning' && listing.holder === null) {
589:       closeUncollected(listing);
590:       continue;
591:     }
592: 
593:     const pick = pickForListing(runners(listing.item), listing.holder);
594:     if (!pick.bot) {
595:       noteWaiting(key, pick.reason);
596:       continue;
597:     }
598:     const bot = fleet.get(pick.bot.name)!;
599: 
600:     // Who the bot has to meet: the buyer of a claim, the seller otherwise.
601:     const who = listing.state === 'claimed' ? listing.buyer : listing.seller;
602:     const character = listing.state === 'claimed' ? listing.buyerCharacter : listing.sellerCharacter;
603:     const seen = who ? await presenceOf(who) : null;
604:     const decision = decide(
605:       { id: listing.id, state: listing.state as 'pending' | 'claimed' | 'returning', updatedAt: listing.updatedAt },
606:       seen?.online ?? null,
607:       now,
608:       onServer(seen, PORT)
609:     );
610: 
611:     if (decision.kind === 'wait') {
612:       noteWaiting(key, decision.reason);
613:       continue;
614:     }
615:     if (decision.kind === 'release') {
616:       log(`releasing ${key}: ${decision.reason}`);
617:       store.release(listing.id, decision.reason);
618:       continue;
619:     }
620:     if (decision.kind === 'expire') {
621:       log(`dropping ${key}: ${decision.reason}`);
622:       store.drop(listing.id, decision.reason);
623:       continue;
624:     }
625: 
626:     // The job and its customer are this bot's for the length of the
627:     // handover: two bots at one player would have the second trade request
628:     // refused by the server, and a refusal reads as the player saying no.
629:     const leases = [`listing:${listing.id}`];
630:     if (character) leases.push(`customer:${character.toLowerCase()}`);
631:     if (!store.acquireLeases(leases, bot.name, LEASE_MS)) {
632:       noteWaiting(key, 'its customer is with another bot');
633:       continue;
634:     }
635:     noteWaiting(key, null);
636:     bot.busy = true;
637:     void runJob(bot, listing.id, leases, () => {
638:       if (listing.state === 'pending') return collect(bot, listing);
639:       if (listing.state === 'claimed') return deliver(bot, listing);
640:       return giveBack(bot, listing);
641:     });
642:   }
643: 
644:   for (const request of requests) {
645:     const now = Date.now();
646:     const key = `payout:${request.account}`;
647:     if (!backoff.due(key, now)) continue;
648:     if (store.leaseHolder(key) !== null) continue;
649: 
650:     if (now - request.requestedAt > PAYOUT_REQUEST_TTL_MS) {
651:       store.clearPayoutRequest(request.account);
652:       audit('payout request dropped', { account: request.account, detail: 'older than a day' });
653:       continue;
654:     }
655:     const owed = store.balance(request.account);
656:     if (owed <= 0) {
657:       store.clearPayoutRequest(request.account);
658:       continue;
659:     }
660: 
661:     const seen = await presenceOf(request.account);
662:     if (seen?.online === false) {
663:       noteWaiting(key, `${request.account} is not online`);
664:       continue;
665:     }
666:     if (onServer(seen, PORT) === false) {
667:       noteWaiting(key, `${request.account} is on another game server`);
668:       continue;
669:     }
670: 
671:     const pick = pickForPayout(runners(), owed);
672:     if (!pick.bot) {
673:       noteWaiting(key, pick.reason);
674:       continue;
675:     }
676:     const bot = fleet.get(pick.bot.name)!;
677: 
678:     const leases = [key, `customer:${request.character.toLowerCase()}`];
679:     if (!store.acquireLeases(leases, bot.name, LEASE_MS)) {
680:       noteWaiting(key, 'their character is with another bot');
681:       continue;
682:     }
683:     noteWaiting(key, null);
684:     bot.busy = true;
685:     void runJob(bot, key, leases, () => pay(bot, request));
686:   }
687: }
688: 
689: async function main(): Promise<void> {
690:   if (!PASSWORD) {
691:     console.error('MARKETPLACE_BOT_PASSWORD is not set');
692:     process.exit(1);
693:   }
694: 
695:   log(`fleet of ${NAMES.length}: ${NAMES.join(', ')} on ${HOST}:${PORT}`);
696: 
697:   if (DATABASE_URL) {
698:     try {
699:       // The password is reset on the accounts too: they are the fleet's own,
700:       // nothing else logs them in, and a bot that cannot log in serves nobody.
701:       const made = await ensureBotAccounts({
702:         databaseUrl: DATABASE_URL,
703:         names: NAMES,
704:         password: PASSWORD,
705:         reset: true,
706:         outfit: OUTFIT,
707:       });
708:       if (made.created.length) log(`created bot accounts ${made.created.join(', ')}`);
709:       if (made.promoted.length) log(`outfitted and made game master: ${made.promoted.join(', ')}`);
710:     } catch (error) {
711:       log(`could not provision bot accounts: ${error instanceof Error ? error.message : error}`);
712:     }
713:   } else {
714:     log('DATABASE_URL is not set: bots are not created here; run createAccounts.ts for any that are missing');
715:   }
716: 
717:   // Said once, because a presence server that cannot be reached makes every
718:   // dispatch a blind try and one that is reachable decides who gets visited.
719:   const probe = await presenceOf(NAMES[0]);
720:   log(
721:     probe === null
722:       ? `presence at ${process.env.PRESENCE_URL ?? 'http://127.0.0.1:3001'} is unreachable; dispatching blind`
723:       : probe.ports === null
724:         ? 'presence answers, but not which game server a player is on; serving everyone'
725:         : `presence answers with game servers; this fleet serves port ${PORT}`
726:   );
727: 
728:   for (const name of NAMES) {
729:     void runBot(name);
730:     // One login at a time is kinder to the server than five at once.
731:     await sleep(2000);
732:   }
733: 
734:   for (;;) {
735:     try {
736:       await tick();
737:     } catch (error) {
738:       log(`scheduler error: ${error instanceof Error ? error.message : error}`);
739:     }
740:     await sleep(POLL_MS);
741:   }
742: }
743: 
744: main().catch(e => {
745:   console.error(e);
746:   process.exit(1);
747: });
