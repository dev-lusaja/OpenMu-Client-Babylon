  1: import type { Socket } from 'bun';
  2: import { BotCrypto, FrameReader, codeOf } from './wire';
  3: 
  4: /**
  5:  * The bot's socket to a game server.
  6:  *
  7:  * Headless by construction: a TCP socket, the client's own encryption, and the
  8:  * client's own generated packet classes. There is no renderer, no DOM and no
  9:  * engine anywhere in this module's graph, so it runs as a service next to the
 10:  * proxy rather than as a browser pretending to be one.
 11:  *
 12:  * Frames arrive decrypted and are handed to whoever is waiting. Two ways to
 13:  * wait, and the difference matters:
 14:  *
 15:  * - `on` registers a standing handler, for anything the server sends
 16:  *   unprompted (a trade request, an item appearing).
 17:  * - `expect` waits once for a specific frame with a deadline, for the
 18:  *   request-and-answer steps of logging in. It never waits forever: a game
 19:  *   server that goes quiet must fail the step, not hang the bot.
 20:  */
 21: 
 22: export type Frame = {
 23:   code: number;
 24:   sub: number;
 25:   /** The decrypted packet, header included. */
 26:   bytes: Uint8Array;
 27: };
 28: 
 29: export type FrameHandler = (frame: Frame) => void;
 30: 
 31: /** Matches a frame by code, and by sub-code when the packet has one. */
 32: export type Match = { code: number; sub?: number };
 33: 
 34: const matches = (frame: Frame, m: Match): boolean =>
 35:   frame.code === m.code && (m.sub === undefined || frame.sub === m.sub);
 36: 
 37: export class BotConnection {
 38:   private socket: Socket<undefined> | null = null;
 39:   private readonly crypto = new BotCrypto();
 40:   private readonly reader = new FrameReader();
 41:   private readonly handlers: FrameHandler[] = [];
 42:   private readonly waiters: {
 43:     match: Match;
 44:     resolve: (frame: Frame) => void;
 45:     reject: (error: Error) => void;
 46:     timer: ReturnType<typeof setTimeout>;
 47:   }[] = [];
 48:   private closedReason: string | null = null;
 49: 
 50:   constructor(
 51:     readonly host: string,
 52:     readonly port: number,
 53:     private readonly log: (message: string) => void = () => {}
 54:   ) {}
 55: 
 56:   get connected(): boolean {
 57:     return this.socket !== null && this.closedReason === null;
 58:   }
 59: 
 60:   async connect(): Promise<void> {
 61:     this.socket = await Bun.connect({
 62:       hostname: this.host,
 63:       port: this.port,
 64:       socket: {
 65:         data: (_s, chunk) => this.receive(new Uint8Array(chunk)),
 66:         close: () => this.dropped('closed by the server'),
 67:         error: (_s, error) => this.dropped(`socket error: ${error.message}`),
 68:         connectError: (_s, error) => this.dropped(`connect failed: ${error.message}`),
 69:       },
 70:     });
 71:     this.closedReason = null;
 72:     this.log(`connected to ${this.host}:${this.port}`);
 73:   }
 74: 
 75:   /** Sends a packet built by a generated packet class. Encrypts in place. */
 76:   send(buffer: DataView | Uint8Array): void {
 77:     if (!this.socket) throw new Error('not connected');
 78:     const packet =
 79:       buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer.buffer.slice(0));
 80:     this.socket.write(this.crypto.encrypt(packet));
 81:   }
 82: 
 83:   on(handler: FrameHandler): () => void {
 84:     this.handlers.push(handler);
 85:     return () => {
 86:       const i = this.handlers.indexOf(handler);
 87:       if (i >= 0) this.handlers.splice(i, 1);
 88:     };
 89:   }
 90: 
 91:   /**
 92:    * The next frame matching `match`, or a rejection once `timeoutMs` passes.
 93:    * Registered before the request is sent, so an answer that arrives in the
 94:    * same tick is not missed.
 95:    */
 96:   expect(match: Match, timeoutMs = 10_000, what = 'frame'): Promise<Frame> {
 97:     return new Promise<Frame>((resolve, reject) => {
 98:       const entry = {
 99:         match,
100:         resolve,
101:         reject,
102:         timer: setTimeout(() => {
103:           this.drop(entry);
104:           reject(new Error(`timed out after ${timeoutMs}ms waiting for ${what}`));
105:         }, timeoutMs),
106:       };
107:       this.waiters.push(entry);
108:     });
109:   }
110: 
111:   close(): void {
112:     this.socket?.end();
113:     this.dropped('closed by us');
114:   }
115: 
116:   private dropped(reason: string): void {
117:     if (this.closedReason !== null) return;
118:     this.closedReason = reason;
119:     this.socket = null;
120:     this.log(`disconnected: ${reason}`);
121:     // Anything still waiting can never be answered now.
122:     for (const waiter of this.waiters.splice(0)) {
123:       clearTimeout(waiter.timer);
124:       waiter.reject(new Error(`connection ${reason}`));
125:     }
126:   }
127: 
128:   private drop(entry: (typeof this.waiters)[number]): void {
129:     const i = this.waiters.indexOf(entry);
130:     if (i >= 0) this.waiters.splice(i, 1);
131:   }
132: 
133:   private receive(chunk: Uint8Array): void {
134:     this.reader.push(chunk);
135: 
136:     for (const wire of this.reader.frames()) {
137:       const bytes = this.crypto.decrypt(wire);
138:       if (bytes === null) {
139:         // A frame that will not decrypt is dropped rather than retried: the
140:         // stream carries a counter, so re-reading it would desync everything
141:         // after it too.
142:         this.log(`undecryptable frame dropped (${this.crypto.lastError ?? 'no reason given'})`);
143:         continue;
144:       }
145: 
146:       const { code, sub } = codeOf(bytes);
147:       const frame: Frame = { code, sub, bytes };
148: 
149:       for (let i = this.waiters.length - 1; i >= 0; i--) {
150:         const waiter = this.waiters[i];
151:         if (!matches(frame, waiter.match)) continue;
152:         this.waiters.splice(i, 1);
153:         clearTimeout(waiter.timer);
154:         waiter.resolve(frame);
155:       }
156: 
157:       // A copy, so a handler that unsubscribes does not skip its neighbour.
158:       for (const handler of [...this.handlers]) {
159:         try {
160:           handler(frame);
161:         } catch (e) {
162:           this.log(`handler threw on 0x${code.toString(16)}: ${e}`);
163:         }
164:       }
165:     }
166:   }
167: }
</file>

<file path="marketplace/bot/createAccounts.ts">
 1: import { DEFAULT_DATABASE_URL, MAX_PASSWORD_LENGTH, botName, ensureBotAccounts } from './accounts';
 2: 
 3: /**
 4:  * Creates the marketplace's bot accounts by hand.
 5:  *
 6:  *   bun run marketplace/bot/createAccounts.ts --count 5 --password <9 chars>
 7:  *
 8:  * The worker does the same on its own at startup when `DATABASE_URL` is set,
 9:  * for as many bots as `MARKETPLACE_BOTS` asks for; this is for a box where
10:  * it is not, or to change the password (`--reset`). Re-running is safe and
11:  * is expected: a character only exists after the bot has logged in once, so
12:  * running this again afterwards promotes the characters too.
13:  */
14: 
15: function arg(name: string, fallback?: string): string | undefined {
16:   const i = process.argv.indexOf(`--${name}`);
17:   return i >= 0 && process.argv[i + 1] ? process.argv[i + 1] : fallback;
18: }
19: 
20: async function main(): Promise<void> {
21:   const count = Number(arg('count', '5'));
22:   const first = Number(arg('first', '1'));
23:   const password = arg('password');
24:   const reset = process.argv.includes('--reset');
25: 
26:   if (!password) {
27:     console.error(`--password is required (max ${MAX_PASSWORD_LENGTH} characters)`);
28:     process.exit(1);
29:   }
30:   if (password.length > MAX_PASSWORD_LENGTH) {
31:     console.error(`--password must be at most ${MAX_PASSWORD_LENGTH} characters`);
32:     process.exit(1);
33:   }
34:   if (!Number.isInteger(count) || count < 1 || count > 99) {
35:     console.error('--count must be between 1 and 99');
36:     process.exit(1);
37:   }
38: 
39:   const names = Array.from({ length: count }, (_, i) => botName(first + i));
40:   const result = await ensureBotAccounts({
41:     databaseUrl: process.env.DATABASE_URL || DEFAULT_DATABASE_URL,
42:     names,
43:     password,
44:     reset,
45:   });
46: 
47:   if (result.promoted.length > 0) console.log(`outfitted and made game master: ${result.promoted.join(", ")}`);
48:   if (result.created.length > 0) console.log(`created: ${result.created.join(', ')}`);
49:   if (result.updated.length > 0) console.log(`password reset: ${result.updated.join(', ')}`);
50:   if (result.skipped.length > 0) console.log(`already existed, left alone: ${result.skipped.join(', ')}`);
51: }
52: 
53: main().catch(e => {
54:   console.error(e instanceof Error ? e.message : e);
55:   process.exit(1);
56: });
