 75: const xor = (plain: Uint8Array, key?: Uint8Array): Uint8Array => {
 76:   const enc = new Xor32Encryptor();
 77:   if (key) enc.xor32Key = key;
 78:   return enc.Encrypt(plain.slice());
 79: };
