<file path="ops/server/reader.ts">
 1: import { readdirSync, statSync } from 'node:fs';
 2: import { open } from 'node:fs/promises';
 3: import { join } from 'node:path';
 4: import { parseChunk } from './ingest';
 5: import { offsetOf, recordCheatWarnings, rememberOffset } from './db';
 6: 
 7: /**
 8:  * Follows OpenMU's JSON log and files what it finds.
 9:  *
10:  * Serilog rolls its files daily and on size, so there is never one file to
11:  * watch: every file in the folder is followed, each with its own remembered
12:  * offset. A file that shrank was replaced by a new one under the same name
13:  * (Serilog's `retainedFileCountLimit` reusing it), so its offset restarts.
14:  *
15:  * Polling, not `fs.watch`: the log is written by another process, often in a
16:  * container with a bind mount, where watches are unreliable and a missed event
17:  * is a silently empty console. A read every few seconds costs nothing.
18:  */
19: 
20: const LOG_DIR = process.env.OPENMU_LOG_DIR || '/srv/openmu/logs';
21: 
22: /** Serilog's JSON sink writes these; the plain text `log.txt` is left alone. */
23: const LOG_PATTERN = /^events.*\.jsonl?$/i;
24: 
25: const POLL_MS = Number(process.env.OPS_INGEST_POLL_MS ?? 5000);
26: 
27: /** One read of one file, from where we left off. Returns rows filed. */
28: async function readFile(path: string): Promise<number> {
29:   const size = statSync(path).size;
30:   const from = offsetOf(path);
31: 
32:   // Truncated or replaced: start over rather than reading from the middle of
33:   // a record and filing nonsense.
34:   const start = size < from ? 0 : from;
35:   if (size === start) return 0;
36: 
37:   const handle = await open(path, 'r');
38:   try {
39:     const length = size - start;
40:     const buffer = new Uint8Array(length);
41:     await handle.read(buffer, 0, length, start);
42: 
43:     const { events, consumed } = parseChunk(new TextDecoder().decode(buffer));
44:     const filed = recordCheatWarnings(events);
45:     // Only past whole lines: a partial tail is read again next time.
46:     rememberOffset(path, start + consumed);
47:     return filed;
48:   } finally {
49:     await handle.close();
50:   }
51: }
52: 
53: /** One pass over every log file. Returns how many warnings were filed. */
54: export async function ingestOnce(dir: string = LOG_DIR): Promise<number> {
55:   let files: string[];
56:   try {
57:     files = readdirSync(dir).filter(name => LOG_PATTERN.test(name));
58:   } catch (error) {
59:     console.error(`ops: cannot read ${dir}:`, error);
60:     return 0;
61:   }
62: 
63:   let filed = 0;
64:   for (const name of files.sort()) {
65:     try {
66:       filed += await readFile(join(dir, name));
67:     } catch (error) {
68:       // One unreadable file must not stop the others: a log mid-roll is
69:       // briefly missing, and the next pass will pick it up.
70:       console.error(`ops: cannot follow ${name}:`, error);
71:     }
72:   }
73: 
74:   return filed;
75: }
76: 
77: /** Follow forever. Errors are logged and the loop continues. */
78: export function follow(dir: string = LOG_DIR): void {
79:   console.info(`ops: following ${dir} every ${POLL_MS}ms`);
80: 
81:   const tick = async () => {
82:     const filed = await ingestOnce(dir);
83:     if (filed > 0) console.info(`ops: filed ${filed} cheat warning(s)`);
84:   };
85: 
86:   void tick();
87:   setInterval(() => void tick(), POLL_MS);
88: }
</file>

