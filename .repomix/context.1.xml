  1: import { productById, type Product } from './catalog';
  2: import {
  3:   cancel as cancelInStore,
  4:   ordersFor,
  5:   placeOrder,
  6:   spentTodayBy,
  7:   type Order,
  8:   type PlacementView,
  9: } from './db';
 10: import { newSeed, roll, type Roll } from './gacha';
 11: import type { Fulfilment } from './fulfilment';
 12: 
 13: /**
 14:  * Placement: the rules between the HTTP routes and the order store.
 15:  *
 16:  * `db.ts` knows how to write an order and what this account has already
 17:  * committed; `fulfilment.ts` knows what the account's bag and vault hold in
 18:  * OpenMU's database. Neither knows the catalogue or what makes an order
 19:  * admissible, and that is what lives here: which product, at what price,
 20:  * whether the wallet and the daily cap have room for it, and - for the gacha
 21:  * - the roll itself, made here so that the seed and its outcome go into the
 22:  * order row in the same transaction that creates the row.
 23:  *
 24:  * Every bound here is a courtesy, and the comments say so where it matters.
 25:  * The wallet this reads is the database's copy of the inventory, which is a
 26:  * save behind a player who is online, and it is read before the transaction
 27:  * rather than inside it because it lives in another database. The
 28:  * authoritative check is fulfilment's: it re-reads the wallet under the
 29:  * advisory lock and refuses there, with nothing spent, if the jewels are
 30:  * gone. Placement exists so the window can say no immediately and honestly
 31:  * in the common case, not so fulfilment can trust it.
 32:  */
 33: 
 34: /**
 35:  * A reason the order was not placed, with the status the route answers. The
 36:  * message is shown to the player as it is - the window has no translation for
 37:  * a reason it cannot predict - so each one says what to do about it.
 38:  */
 39: export class Refusal extends Error {
 40:   constructor(
 41:     message: string,
 42:     readonly status: number
 43:   ) {
 44:     super(message);
 45:     this.name = 'Refusal';
 46:   }
 47: }
 48: 
 49: /**
 50:  * What the player may see of their own order.
 51:  *
 52:  * A gacha roll is drawn and committed when the order is placed - that is what
 53:  * stops an outcome being shopped for by ordering and cancelling - but the
 54:  * jewels for it are not taken until the account is offline and the delivery
 55:  * transaction runs. Between those two moments the roll is sealed, and this is
 56:  * where that is enforced: it never leaves the service.
 57:  *
 58:  * Showing it earlier is not a small leak, it is the whole line. A player who
 59:  * saw a roll they did not want could spend or trade their Jewels of Chaos
 60:  * before logging out; the delivery would then fail for want of them, and a
 61:  * failed order costs nothing and hands its daily-cap slot back
 62:  * (`spentTodayBy` counts neither). The roll could be re-drawn until it was
 63:  * liked, which is exactly the free re-roll the placement-time draw was
 64:  * supposed to prevent.
 65:  *
 66:  * The seed and the outcome are in the row throughout, so nothing is lost: an
 67:  * audit can replay any roll from the moment it was placed, and the player
 68:  * sees the same one the moment it is theirs.
 69:  */
 70: function forPlayer(order: Order): Order {
 71:   return order.line === 'gacha' && order.state !== 'delivered' ? { ...order, roll: null } : order;
 72: }
 73: 
 74: /** What GET /api/orders answers: the queue, and what the window needs to explain it. */
 75: export interface OrdersView {
 76:   orders: Order[];
 77:   /**
 78:    * Whether an order placed now would be taken. False when the service
 79:    * cannot see the wallet, which is the one condition under which placement
 80:    * refuses everything.
 81:    */
 82:   acceptingOrders: boolean;
 83:   /** Bag plus vault as the database has them, or null when they cannot be read. */
 84:   wallet: { chaos: number } | null;
 85:   /** productId -> orders placed today that still count against its cap. */
 86:   spentToday: Record<string, number>;
 87: }
 88: 
 89: /**
 90:  * How many times a roll may miss the game's definitions before placement
 91:  * gives up. The pool and the configuration overlap almost entirely, so one
 92:  * miss is rare and eight in a row means the configuration is not the one the
 93:  * pool was built for, which is worth refusing over rather than looping.
 94:  */
 95: const ROLL_ATTEMPTS = 8;
 96: 
 97: export class Orders {
 98:   constructor(private readonly fulfilment: Fulfilment) {}
 99: 
100:   /**
101:    * Places an order for `account`, or throws a `Refusal` saying why not.
102:    *
103:    * The gacha is rolled here, before the transaction, from a seed nobody has
104:    * seen: the roll is a pure function of the seed, so it can be made anywhere,
105:    * and `placeOrder` writes seed and outcome in the statement that creates
106:    * the order. The player learns the result from the order that comes back,
107:    * after it is already committed, which is what makes cancelling a gacha
108:    * pointless and why `db.ts` refuses to.
109:    */
110:   async place(account: string, productId: unknown): Promise<Order> {
111:     const product = typeof productId === 'string' ? productById(productId) : undefined;
112: 
113:     if (!product) throw new Refusal('That item is not for sale.', 404);
114: 
115:     // A wallet the service cannot read is a refusal, not a zero: the
116:     // difference between "you have no jewels" and "the shop cannot see your
117:     // jewels" is the difference between a player's fault and ours, and the
118:     // message has to say which.
119:     const wallet = await this.fulfilment.wallet(account);
120: 
121:     if (!wallet) throw new Refusal('The shop cannot see your jewels right now. Please try again later.', 503);
122: 
123:     const placed = placeOrder(
124:       {
125:         account,
126:         productId: product.id,
127:         productName: product.name,
128:         line: product.line,
129:         chaos: product.chaos,
130:         roll: product.line === 'gacha' ? await this.grantableRoll() : null,
131:       },
132:       seen => admit(product, wallet.chaos, seen)
133:     );
134: 
135:     if (!placed.ok) throw new Refusal(placed.reason, 409);
136: 
137:     return forPlayer(placed.order);
138:   }
139: 
140:   /**
141:    * A roll the game can actually hand over. The pool is built from the icon
142:    * pack, the game's items from its own configuration, and the two are not
143:    * the same list; a roll committed for an item the game does not define
144:    * would be a paid, revealed prize that delivery has to void. So each roll
145:    * is checked against the definitions before it is kept, and rolled again
146:    * on a fresh seed if not - the seed stored is the one that produced the
147:    * item granted, so replaying it still reproduces the order exactly.
148:    * Refuses rather than guesses when the definitions cannot be read.
149:    */
150:   private async grantableRoll(): Promise<Roll> {
151:     for (let attempt = 0; attempt < ROLL_ATTEMPTS; attempt++) {
152:       const candidate = roll(newSeed());
153:       const grantable = await this.fulfilment.grantable(candidate.group, candidate.num);
154: 
155:       if (grantable === null) {
156:         throw new Refusal("The shop cannot see the game's items right now. Please try again later.", 503);
157:       }
158: 
159:       if (grantable) return candidate;
160: 
161:       console.warn(`gacha: ${candidate.group}/${candidate.num} (${candidate.name}) is not in the game configuration; rolling again`);
162:     }
163: 
164:     throw new Refusal('The shop could not find an item to give you. Please try again later.', 503);
165:   }
166: 
167:   /**
168:    * Cancels one of the caller's own queued orders. The store owns the rules
169:    * (queued only, never a gacha, never someone else's); this only names the
170:    * status each refusal deserves.
171:    */
172:   cancel(account: string, id: unknown): Order {
173:     if (typeof id !== 'string' || id.length === 0) throw new Refusal('No such order.', 404);
174: 
175:     const cancelled = cancelInStore(id, account);
176: 
177:     if (cancelled.ok) return forPlayer(cancelled.order);
178: 
179:     switch (cancelled.reason) {
180:       case 'notFound':
181:         throw new Refusal('No such order.', 404);
182:       case 'gacha':
183:         throw new Refusal('A roll cannot be cancelled: its result was decided when it was paid for.', 409);
184:       case 'notQueued':
185:         throw new Refusal('That order is no longer waiting, so it cannot be cancelled.', 409);
186:     }
187:   }
188: 
189:   /** The delivery tab: newest first, with the wallet and the caps so the window can explain a refusal before making one. */
190:   async list(account: string): Promise<OrdersView> {
191:     const wallet = await this.fulfilment.wallet(account);
192: 
193:     return {
194:       orders: ordersFor(account).map(forPlayer),
195:       acceptingOrders: wallet !== null,
196:       wallet,
197:       spentToday: spentTodayBy(account),
198:     };
199:   }
200: }
201: 
202: /**
203:  * The placement bounds, answered inside the store's transaction so two
204:  * requests from one account cannot both see the same jewels as free.
205:  *
206:  * Both are courtesies. The daily cap is counted here and nowhere else, so it
207:  * is exact; but the wallet is the database's copy, read before the
208:  * transaction, and fulfilment re-reads it under the lock and is the check
209:  * that counts. What placement can promise is that a queued order never asks
210:  * for more than the database showed minus what earlier orders already claim,
211:  * so a player cannot queue ten wings on one wing's worth of jewels.
212:  */
213: function admit(product: Product, chaosInWallet: number, seen: PlacementView): string | null {
214:   if (seen.spentToday >= product.dailyCap) {
215:     return product.dailyCap === 1
216:       ? `${product.name} is limited to one a day. Try again tomorrow.`
217:       : `${product.name} is limited to ${product.dailyCap} a day, and you have had them. Try again tomorrow.`;
218:   }
219: 
220:   const free = chaosInWallet - seen.committed;
221: 
222:   if (free < product.chaos) {
223:     const committed =
224:       seen.committed > 0 ? ` (${chaosInWallet} in your bag and vault, ${seen.committed} already promised to queued orders)` : '';
225: 
226:     return `Not enough Jewels of Chaos: this costs ${product.chaos} and you have ${Math.max(free, 0)} free${committed}.`;
227:   }
228: 
229:   return null;
230: }
