<file path="marketplace/bot/accounts.ts">
  1: import bcrypt from 'bcryptjs';
  2: import postgres from 'postgres';
  3: 
  4: /**
  5:  * The marketplace's bot accounts, made and kept by the service itself.
  6:  *
  7:  * Bot accounts are named `MKT###` so they are obvious in the admin panel and
  8:  * in any audit of the account table. They are the only accounts the service
  9:  * ever owns, and the only ones it is ever safe for it to write to directly -
 10:  * because it is the only thing that logs them in, they have no live state in
 11:  * the game server to contradict.
 12:  *
 13:  * The insert mirrors `register/server/main.ts` exactly, including the `$2a$`
 14:  * rewrite: what lands here has to be byte-identical to what OpenMU writes
 15:  * itself, or the login it accepts from a person would not be the login it
 16:  * accepts from a bot.
 17:  *
 18:  * A character only exists once the bot has logged in and made one, so
 19:  * promoting characters to game master is a step of its own, run again after
 20:  * that first login.
 21:  */
 22: 
 23: export const PREFIX = 'MKT';
 24: 
 25: /**
 26:  * Nine, not ten, and the reason is a real trap.
 27:  *
 28:  * The client sends `LoginShortPassword`, which is 50 bytes. OpenMU dispatches
 29:  * on the packet length (`LogInHandlerPlugIn`): anything 42 bytes or longer is
 30:  * parsed as `LoginLongPassword`, whose password field is 20 bytes from offset
 31:  * 14 rather than 10. It survives only because `ExtractString` stops at the
 32:  * first zero byte, and a password shorter than ten leaves one in the padding.
 33:  *
 34:  * A password of exactly ten characters has no terminator, so the server reads
 35:  * on into the client version and serial that follow it and the password never
 36:  * matches. Nine keeps the terminator inside the field.
 37:  */
 38: export const MAX_PASSWORD_LENGTH = 9;
 39: const MAX_ACCOUNT_LENGTH = 10;
 40: 
 41: const BCRYPT_COST = 11;
 42: const BCRYPT_VARIANT = '$2a$';
 43: 
 44: /** `AccountState.GameMaster` and `CharacterStatus.GameMaster` in OpenMU. */
 45: const ACCOUNT_GAME_MASTER = 2;
 46: export const CHARACTER_GAME_MASTER = 32;
 47: 
 48: /** The all-in-one compose publishes Postgres on 5433, not the default. */
 49: export const DEFAULT_DATABASE_URL = 'postgres://postgres:admin@127.0.0.1:5433/openmu';
 50: 
 51: /** `MKT001`, `MKT002`, ... the convention every bot follows. */
 52: export function botName(n: number): string {
 53:   const name = `${PREFIX}${String(n).padStart(3, '0')}`;
 54:   if (name.length > MAX_ACCOUNT_LENGTH) throw new Error(`bot name ${name} is too long`);
 55:   return name;
 56: }
 57: 
 58: async function hashPassword(password: string): Promise<string> {
 59:   const hash = await bcrypt.hash(password, BCRYPT_COST);
 60:   if (hash.startsWith(BCRYPT_VARIANT)) return hash;
 61:   return BCRYPT_VARIANT + hash.slice(hash.indexOf('$', 1) + 1);
 62: }
 63: 
 64: export type Provisioned = {
 65:   created: string[];
 66:   updated: string[];
 67:   skipped: string[];
 68:   promoted: string[];
 69: };
 70: 
 71: /** What a fresh bot character is given, so it can work from its first login. */
 72: export type Outfit = {
 73:   /** OpenMU refuses a shop below level 6; twelve leaves room. */
 74:   level: number;
 75:   /** The float a bot pays sellers from before its own sales have filled it. */
 76:   zen: number;
 77: };
 78: 
 79: export const DEFAULT_OUTFIT: Outfit = { level: 12, zen: 1_000_000 };
 80: 
 81: /**
 82:  * Makes sure every named account exists as a game master, and that every
 83:  * character on an MKT account is one too. Safe to run as often as wanted.
 84:  * `reset` changes the password on accounts that already exist.
 85:  */
 86: export async function ensureBotAccounts(options: {
 87:   databaseUrl: string;
 88:   names: string[];
 89:   password: string;
 90:   reset?: boolean;
 91:   outfit?: Outfit;
 92: }): Promise<Provisioned> {
 93:   const { databaseUrl, names, password, reset = false } = options;
 94:   if (password.length === 0 || password.length > MAX_PASSWORD_LENGTH) {
 95:     throw new Error(`the bot password must be 1 to ${MAX_PASSWORD_LENGTH} characters`);
 96:   }
 97: 
 98:   const sql = postgres(databaseUrl);
 99:   const result: Provisioned = { created: [], updated: [], skipped: [], promoted: [] };
100: 
101:   try {
102:     for (const login of names) {
103:       if (!login.startsWith(PREFIX) || login.length > MAX_ACCOUNT_LENGTH) {
104:         throw new Error(`"${login}" is not a bot account name`);
105:       }
106: 
107:       const existing = await sql`
108:         SELECT 1 FROM data."Account" WHERE lower("LoginName") = lower(${login}) LIMIT 1
109:       `;
110:       if (existing.length > 0) {
111:         if (!reset) {
112:           result.skipped.push(login);
113:           continue;
114:         }
115:         await sql`
116:           UPDATE data."Account"
117:           SET "PasswordHash" = ${await hashPassword(password)}
118:           WHERE lower("LoginName") = lower(${login})
119:         `;
120:         result.updated.push(login);
121:         continue;
122:       }
123: 
124:       await sql`
125:         INSERT INTO data."Account" (
126:           "Id", "LoginName", "PasswordHash", "SecurityCode", "EMail",
127:           "RegistrationDate", "State", "TimeZone", "VaultPassword", "IsVaultExtended"
128:         ) VALUES (
129:           gen_random_uuid(), ${login}, ${await hashPassword(password)}, '', '',
130:           now(), ${ACCOUNT_GAME_MASTER}, 0, '', false
131:         )
132:       `;
133:       result.created.push(login);
134:     }
135: 
136:     result.promoted = await outfitWith(sql, options.outfit ?? DEFAULT_OUTFIT);
137:   } finally {
138:     await sql.end();
139:   }
140: 
141:   return result;
142: }
143: 
144: /**
145:  * Every character on an MKT account becomes a game master, is at least the
146:  * outfit's level, and - the first time, while it is still an ordinary
147:  * character - carries the outfit's Zen. Needed once per character, after the
148:  * bot has made it: `/hide`, `/skin` and `/trace` are game master commands,
149:  * a shop needs level 6, and a payout needs a float.
150:  *
151:  * Written only while the bot is logged out: OpenMU keeps a logged-in
152:  * character in memory and writes it back on save, which would undo all of
153:  * this. The fleet logs a fresh bot out, calls this, and logs it in again.
154:  */
155: export async function outfitBotCharacters(
156:   databaseUrl: string,
157:   outfit: Outfit = DEFAULT_OUTFIT
158: ): Promise<string[]> {
159:   const sql = postgres(databaseUrl);
160:   try {
161:     return await outfitWith(sql, outfit);
162:   } finally {
163:     await sql.end();
164:   }
165: }
166: 
167: async function outfitWith(sql: ReturnType<typeof postgres>, outfit: Outfit): Promise<string[]> {
168:   // The float first, while "not yet a game master" still marks a new
169:   // character: an existing bot's Zen is its own books and is left alone.
170:   await sql`
171:     UPDATE data."ItemStorage" i
172:     SET "Money" = ${outfit.zen}
173:     FROM data."Character" c JOIN data."Account" a ON c."AccountId" = a."Id"
174:     WHERE i."Id" = c."InventoryId"
175:       AND a."LoginName" LIKE ${PREFIX + '%'}
176:       AND c."CharacterStatus" <> ${CHARACTER_GAME_MASTER}
177:       AND i."Money" < ${outfit.zen}
178:   `;
179: 
180:   // The level is a stat attribute row, found by its definition's name.
181:   await sql`
182:     UPDATE data."StatAttribute" s
183:     SET "Value" = ${outfit.level}
184:     FROM config."AttributeDefinition" d, data."Character" c
185:       JOIN data."Account" a ON c."AccountId" = a."Id"
186:     WHERE s."DefinitionId" = d."Id" AND d."Designation" = 'Level'
187:       AND s."CharacterId" = c."Id"
188:       AND a."LoginName" LIKE ${PREFIX + '%'}
189:       AND s."Value" < ${outfit.level}
190:   `;
191: 
192:   const promoted = await sql`
193:     UPDATE data."Character" c
194:     SET "CharacterStatus" = ${CHARACTER_GAME_MASTER}
195:     FROM data."Account" a
196:     WHERE c."AccountId" = a."Id"
197:       AND a."LoginName" LIKE ${PREFIX + '%'}
198:       AND c."CharacterStatus" <> ${CHARACTER_GAME_MASTER}
199:     RETURNING c."Name"
200:   `;
201:   return promoted.map(row => row.Name as string);
202: }
</file>

<file path="marketplace/bot/bag.test.ts">
  1: import { describe, expect, it } from 'vitest';
  2: import { Bag } from './bag';
  3: import type { BotConnection, Frame, FrameHandler } from './connection';
  4: import { codeOf } from './wire';
  5: 
  6: /**
  7:  * The bag is how the bot learns where a collected item landed: the server
  8:  * lists the whole inventory after every trade, and the slot that is full now
  9:  * and was empty before is the one. Guessing it - or writing null down - is
 10:  * what left listings on sale that could never be delivered.
 11:  */
 12: class FakeConnection {
 13:   private readonly handlers: FrameHandler[] = [];
 14: 
 15:   on(handler: FrameHandler): () => void {
 16:     this.handlers.push(handler);
 17:     return () => {
 18:       const i = this.handlers.indexOf(handler);
 19:       if (i >= 0) this.handlers.splice(i, 1);
 20:     };
 21:   }
 22: 
 23:   deliver(bytes: Uint8Array): void {
 24:     const { code, sub } = codeOf(bytes);
 25:     const frame: Frame = { code, sub, bytes };
 26:     for (const handler of [...this.handlers]) handler(frame);
 27:   }
 28: 
 29:   asConnection(): BotConnection {
 30:     return this as unknown as BotConnection;
 31:   }
 32: }
 33: 
 34: /** A 12-byte item as the server serialises it: number in byte 0, level in byte 1, group in byte 5. */
 35: function item(group: number, num: number, level = 0): Uint8Array {
 36:   const data = new Uint8Array(12);
 37:   data[0] = num & 0xff;
 38:   data[1] = (level & 0x0f) << 3;
 39:   data[5] = (group & 0x0f) << 4;
 40:   return data;
 41: }
 42: 
 43: /** C4 F3 10: count at byte 5, then 13-byte entries of slot + item. */
 44: function inventory(entries: { slot: number; data: Uint8Array }[]): Uint8Array {
 45:   const size = 6 + entries.length * 13;
 46:   const b = new Uint8Array(size);
 47:   b[0] = 0xc4;
 48:   b[1] = (size >> 8) & 0xff;
 49:   b[2] = size & 0xff;
 50:   b[3] = 0xf3;
 51:   b[4] = 0x10;
 52:   b[5] = entries.length;
 53:   let at = 6;
 54:   for (const e of entries) {
 55:     b[at] = e.slot;
 56:     b.set(e.data, at + 1);
 57:     at += 13;
 58:   }
 59:   return b;
 60: }
 61: 
 62: const jewel = item(14, 13);
 63: const sword = item(0, 1, 5);
 64: 
 65: describe('the bag', () => {
 66:   it('knows nothing until the server has listed the inventory', () => {
 67:     const bag = new Bag(new FakeConnection().asConnection());
 68:     expect(bag.known).toBe(false);
 69:     expect(bag.snapshot().size).toBe(0);
 70:   });
 71: 
 72:   it('keeps bag slots only, not equipment and not the stall', () => {
 73:     const connection = new FakeConnection();
 74:     const bag = new Bag(connection.asConnection());
 75:     connection.deliver(
 76:       inventory([
 77:         { slot: 0, data: sword }, // worn
 78:         { slot: 12, data: jewel }, // first bag square
 79:         { slot: 40, data: sword },
 80:         { slot: 204, data: jewel }, // first stall square
 81:       ])
 82:     );
 83:     expect(bag.known).toBe(true);
 84:     expect([...bag.snapshot()].sort((a, b) => a - b)).toEqual([12, 40]);
 85:   });
 86: 
 87:   it('says which slot appeared since a snapshot', () => {
 88:     const connection = new FakeConnection();
 89:     const bag = new Bag(connection.asConnection());
 90:     connection.deliver(inventory([{ slot: 12, data: jewel }]));
 91:     const before = bag.snapshot();
 92: 
 93:     connection.deliver(inventory([{ slot: 12, data: jewel }, { slot: 21, data: sword }]));
 94: 
 95:     expect(bag.newSince(before)).toEqual([21]);
 96:     expect(bag.version).toBe(2);
 97:   });
 98: 
 99:   it('finds a slot by the exact bytes the trade showed', () => {
100:     const connection = new FakeConnection();
101:     const bag = new Bag(connection.asConnection());
102:     connection.deliver(inventory([{ slot: 12, data: jewel }, { slot: 21, data: sword }]));
103:     expect(bag.slotOf(sword)).toBe(21);
104:     expect(bag.slotOf(item(14, 14))).toBeNull();
105:   });
106: 
107:   it('finds slots by kind, level included', () => {
108:     const connection = new FakeConnection();
109:     const bag = new Bag(connection.asConnection());
110:     connection.deliver(
111:       inventory([
112:         { slot: 12, data: jewel },
113:         { slot: 13, data: jewel },
114:         { slot: 21, data: sword },
115:       ])
116:     );
117:     expect(bag.slotsMatching({ group: 14, num: 13 })).toEqual([12, 13]);
118:     expect(bag.slotsMatching({ group: 0, num: 1, lvl: 5 })).toEqual([21]);
119:     expect(bag.slotsMatching({ group: 0, num: 1, lvl: 0 })).toEqual([]);
120:   });
121: 
122:   it('resolves a wait once a newer list arrives', async () => {
123:     const connection = new FakeConnection();
124:     const bag = new Bag(connection.asConnection());
125:     const waited = bag.waitForUpdate(0, 1000);
126:     connection.deliver(inventory([]));
127:     await expect(waited).resolves.toBeUndefined();
128:   });
129: 
130:   it('gives up waiting when no list comes', async () => {
131:     const bag = new Bag(new FakeConnection().asConnection());
132:     await expect(bag.waitForUpdate(0, 250)).rejects.toThrow();
133:   });
134: });
135: 
136: describe('room in the bag', () => {
137:   // Items in the fixture table: a jewel is 1x1, a Kris (0/0) 1x2, a Small
138:   // Shield (6/0) 2x2.
139:   const kris = item(0, 0);
140:   const shield = item(6, 0);
141: 
142:   it('is judged by rectangles, not by empty squares', () => {
143:     const connection = new FakeConnection();
144:     const bag = new Bag(connection.asConnection());
145:     // Every other square of every row taken by a jewel: 32 free squares,
146:     // none of them adjacent.
147:     const entries = [];
148:     for (let slot = 12; slot < 76; slot += 2) entries.push({ slot, data: jewel });
149:     connection.deliver(inventory(entries));
150: 
151:     expect(bag.canHold({ group: 14, num: 13 })).toBe(true);
152:     expect(bag.canHold({ group: 6, num: 0 })).toBe(false);
153:   });
154: 
155:   it('sees a tall item cover the rows beneath its slot', () => {
156:     const connection = new FakeConnection();
157:     const bag = new Bag(connection.asConnection());
158:     // A Kris in the first square covers the square below it too.
159:     connection.deliver(inventory([{ slot: 12, data: kris }]));
160:     expect(bag.occupiedCells().has(0)).toBe(true);
161:     expect(bag.occupiedCells().has(8)).toBe(true);
162:     expect(bag.occupiedCells().has(1)).toBe(false);
163:   });
164: 
165:   it('says a full bag is full', () => {
166:     const connection = new FakeConnection();
167:     const bag = new Bag(connection.asConnection());
168:     const entries = [];
169:     for (let slot = 12; slot < 76; slot++) entries.push({ slot, data: jewel });
170:     connection.deliver(inventory(entries));
171:     expect(bag.canHold({ group: 14, num: 13 })).toBe(false);
172:     void shield;
173:   });
174: });
</file>

<file path="marketplace/bot/bag.ts">
  1: import {
  2:   CharacterInventoryPacket,
  3:   ItemMovedPacket,
  4: } from '../../src/common/packets/ServerToClientPackets';
  5: import { InventoryConstants } from '../../src/common/inventoryConstants';
  6: import { StorageKind } from '../../src/common/storageKind';
  7: import type { BotConnection, Frame } from './connection';
  8: import { footprintOf } from './footprint';
  9: import { decodeItem } from './itemMatch';
 10: import { view } from './session';
 11: 
 12: /**
 13:  * What the bot is carrying, slot by slot, as the server last said.
 14:  *
 15:  * The server never says where a traded item landed: a completed trade sends
 16:  * no item-appear notice at all. What it does send, after every trade and on
 17:  * entering the world, is the whole inventory (`CharacterInventory`, F3 10).
 18:  * So the slot of a collected item is found the reliable way - the bag before
 19:  * the trade against the bag after it - and a listing is only put on sale once
 20:  * that slot is known. Guessing it, or writing null down, is what left items
 21:  * on sale that could never be delivered.
 22:  *
 23:  * Between lists, the bot's own moves are followed from the server's
 24:  * `ItemMoved` answers, so the bag stays right through a trade or a stocking.
 25:  * The stall grid (slots 204 and up) is kept apart from the bag: an item
 26:  * stranded there by an earlier run is findable, and never mistaken for one
 27:  * that can be offered straight from a bag slot.
 28:  */
 29: 
 30: const CODE = {
 31:   inventory: { code: 0xf3, sub: 0x10 },
 32:   /** The server's answer to a move; sub 0xFF is the refusal. */
 33:   moved: { code: 0x24 },
 34: } as const;
 35: 
 36: const MOVE_FAILED_SUB = 0xff;
 37: 
 38: /** The first bag square; below it are the equipment slots. */
 39: const FIRST_BAG_SLOT = InventoryConstants.EquippableSlotsCount;
 40: /** The stall grid sits behind this in the same storage and is not the bag. */
 41: const FIRST_STORE_SLOT = InventoryConstants.FirstStoreItemSlotIndex;
 42: const LAST_STORE_SLOT = FIRST_STORE_SLOT + InventoryConstants.StoreSize - 1;
 43: 
 44: /** The bag grid a bot has: no extensions, so the base rows only. */
 45: const COLUMNS = InventoryConstants.RowSize;
 46: const ROWS = InventoryConstants.InventoryRows;
 47: 
 48: export type BagItem = { slot: number; data: Uint8Array };
 49: 
 50: export type ItemShape = { group: number; num: number; lvl?: number };
 51: 
 52: export class Bag {
 53:   /** Bag slot -> the item's wire bytes. Equipment and the stall are left out. */
 54:   readonly slots = new Map<number, Uint8Array>();
 55:   /** Stall slot (204 and up) -> the item's wire bytes. */
 56:   readonly stall = new Map<number, Uint8Array>();
 57:   /** Bumped on every list the server sends, so a caller can wait for the next. */
 58:   version = 0;
 59: 
 60:   private readonly unsubscribe: () => void;
 61: 
 62:   constructor(
 63:     connection: BotConnection,
 64:     private readonly log: (message: string) => void = () => {}
 65:   ) {
 66:     this.unsubscribe = connection.on(frame => this.handle(frame));
 67:   }
 68: 
 69:   dispose(): void {
 70:     this.unsubscribe();
 71:   }
 72: 
 73:   /** True once the server has listed the inventory at least once. */
 74:   get known(): boolean {
 75:     return this.version > 0;
 76:   }
 77: 
 78:   /** The occupied bag slots right now, for a before-and-after comparison. */
 79:   snapshot(): Set<number> {
 80:     return new Set(this.slots.keys());
 81:   }
 82: 
 83:   /** Resolves once a list newer than `sinceVersion` has arrived, or rejects. */
 84:   async waitForUpdate(sinceVersion: number, timeoutMs = 5000): Promise<void> {
 85:     const deadline = Date.now() + timeoutMs;
 86:     while (this.version <= sinceVersion) {
 87:       if (Date.now() >= deadline) {
 88:         throw new Error('the server did not list the inventory in time');
 89:       }
 90:       await new Promise(resolve => setTimeout(resolve, 100));
 91:     }
 92:   }
 93: 
 94:   /** Slots occupied now that were empty in `before`. */
 95:   newSince(before: Set<number>): number[] {
 96:     return [...this.slots.keys()].filter(slot => !before.has(slot)).sort((a, b) => a - b);
 97:   }
 98: 
 99:   /** The bag slot holding exactly these bytes, or null. */
100:   slotOf(data: Uint8Array): number | null {
101:     for (const [slot, bytes] of this.slots) {
102:       if (sameBytes(bytes, data)) return slot;
103:     }
104:     return null;
105:   }
106: 
107:   /** Every bag slot whose item is this kind (group, number and level). */
108:   slotsMatching(shape: ItemShape): number[] {
109:     return matching(this.slots, shape);
110:   }
111: 
112:   /** Every stall slot whose item is this kind. */
113:   stallSlotsMatching(shape: ItemShape): number[] {
114:     return matching(this.stall, shape);
115:   }
116: 
117:   /** Every bag slot whose item satisfies `pred` - the listing's own test, say. */
118:   slotsWhere(pred: (data: Uint8Array) => boolean): number[] {
119:     return where(this.slots, pred);
120:   }
121: 
122:   /** Every stall slot whose item satisfies `pred`. */
123:   stallSlotsWhere(pred: (data: Uint8Array) => boolean): number[] {
124:     return where(this.stall, pred);
125:   }
126: 
127:   /**
128:    * Empty bag squares, lowest first. A square is not a guarantee - a wide
129:    * item needs its neighbours free too - so a caller tries them in turn and
130:    * lets the server refuse the ones that do not fit.
131:    */
132:   freeBagSlots(): number[] {
133:     const out: number[] = [];
134:     for (let slot = FIRST_BAG_SLOT; slot < FIRST_STORE_SLOT; slot++) {
135:       if (!this.slots.has(slot)) out.push(slot);
136:     }
137:     return out;
138:   }
139: 
140:   /**
141:    * The bag's squares that something is standing on, each item covering
142:    * its footprint from its slot. Squares are numbered from the first bag
143:    * slot, row by row.
144:    */
145:   occupiedCells(): Set<number> {
146:     const cells = new Set<number>();
147:     for (const [slot, bytes] of this.slots) {
148:       const item = decodeItem(bytes);
149:       const { w, h } = item ? footprintOf(item.group, item.num) : { w: 1, h: 1 };
150:       const origin = slot - FIRST_BAG_SLOT;
151:       const row = Math.floor(origin / COLUMNS);
152:       const col = origin % COLUMNS;
153:       for (let r = row; r < Math.min(ROWS, row + h); r++) {
154:         for (let c = col; c < Math.min(COLUMNS, col + w); c++) cells.add(r * COLUMNS + c);
155:       }
156:     }
157:     return cells;
158:   }
159: 
160:   /**
161:    * Whether an item of this kind would fit anywhere in the bag right now.
162:    *
163:    * The server decides where it lands; this only answers whether there is a
164:    * rectangle of the item's size left. A bot that says no is not sent to
165:    * collect - another one is - instead of opening a trade the server then
166:    * fails for a full inventory, which the bot used to read as the seller
167:    * backing out.
168:    */
169:   canHold(shape: ItemShape): boolean {
170:     const { w, h } = footprintOf(shape.group, shape.num);
171:     const taken = this.occupiedCells();
172:     for (let row = 0; row + h <= ROWS; row++) {
173:       for (let col = 0; col + w <= COLUMNS; col++) {
174:         let free = true;
175:         for (let r = row; r < row + h && free; r++) {
176:           for (let c = col; c < col + w; c++) {
177:             if (taken.has(r * COLUMNS + c)) {
178:               free = false;
179:               break;
180:             }
181:           }
182:         }
183:         if (free) return true;
184:       }
185:     }
186:     return false;
187:   }
188: 
189:   /** What is in a bag slot, or null when it is empty. */
190:   itemAt(slot: number): (ItemShape & { isExcellent?: boolean }) | null {
191:     const bytes = this.slots.get(slot) ?? this.stall.get(slot);
192:     return bytes ? decode(bytes) : null;
193:   }
194: 
195:   private handle(frame: Frame): void {
196:     if (frame.code === CODE.inventory.code && frame.sub === CODE.inventory.sub) {
197:       this.list(frame);
198:       return;
199:     }
200:     if (frame.code === CODE.moved.code && frame.sub !== MOVE_FAILED_SUB) {
201:       this.follow(frame);
202:     }
203:   }
204: 
205:   private list(frame: Frame): void {
206:     let entries;
207:     try {
208:       const packet = new CharacterInventoryPacket(view(frame));
209:       entries = packet.getItems(packet.ItemCount);
210:     } catch {
211:       this.log('could not read a CharacterInventory frame');
212:       return;
213:     }
214: 
215:     this.slots.clear();
216:     this.stall.clear();
217:     for (const entry of entries) {
218:       const bytes = copy(entry.ItemData);
219:       if (entry.ItemSlot >= FIRST_BAG_SLOT && entry.ItemSlot < FIRST_STORE_SLOT) {
220:         this.slots.set(entry.ItemSlot, bytes);
221:       } else if (entry.ItemSlot >= FIRST_STORE_SLOT && entry.ItemSlot <= LAST_STORE_SLOT) {
222:         this.stall.set(entry.ItemSlot, bytes);
223:       }
224:     }
225:     this.version++;
226:     this.log(
227:       `bag: ${this.slots.size} item(s) in ${[...this.slots.keys()].join(',') || 'no slots'}` +
228:         (this.stall.size ? `; stall: ${[...this.stall.keys()].join(',')}` : '')
229:     );
230:   }
231: 
232:   /**
233:    * One of our moves landed. The packet names where the item is now and
234:    * carries its bytes, not where it came from, so the old entry is found by
235:    * those bytes. A move onto the trade table or into the vault takes it out
236:    * of both maps; the list after the trade puts things right regardless.
237:    */
238:   private follow(frame: Frame): void {
239:     let moved;
240:     try {
241:       moved = new ItemMovedPacket(view(frame));
242:     } catch {
243:       return;
244:     }
245:     const bytes = copy(moved.ItemData);
246:     for (const map of [this.slots, this.stall]) {
247:       for (const [slot, held] of map) {
248:         if (sameBytes(held, bytes)) map.delete(slot);
249:       }
250:     }
251:     // The stall is reported as inventory storage at its absolute slot.
252:     if (moved.TargetStorageType !== StorageKind.Inventory) return;
253:     if (moved.TargetSlot >= FIRST_STORE_SLOT && moved.TargetSlot <= LAST_STORE_SLOT) {
254:       this.stall.set(moved.TargetSlot, bytes);
255:     } else if (moved.TargetSlot >= FIRST_BAG_SLOT && moved.TargetSlot < FIRST_STORE_SLOT) {
256:       this.slots.set(moved.TargetSlot, bytes);
257:     }
258:   }
259: }
260: 
261: function matching(map: Map<number, Uint8Array>, shape: ItemShape): number[] {
262:   return where(map, bytes => {
263:     const item = decodeItem(bytes);
264:     if (!item) return false;
265:     if (item.group !== shape.group || item.num !== shape.num) return false;
266:     return shape.lvl === undefined || item.lvl === shape.lvl;
267:   });
268: }
269: 
270: function where(map: Map<number, Uint8Array>, pred: (data: Uint8Array) => boolean): number[] {
271:   const out: number[] = [];
272:   for (const [slot, bytes] of map) if (pred(bytes)) out.push(slot);
273:   return out.sort((a, b) => a - b);
274: }
275: 
276: /** The listing-facing fields of an item, decoded without the client's serializer. */
277: function decode(bytes: Uint8Array): (ItemShape & { isExcellent?: boolean }) | null {
278:   const item = decodeItem(bytes);
279:   if (!item) return null;
280:   return { group: item.group, num: item.num, lvl: item.lvl, isExcellent: item.excellentFlags !== 0 };
281: }
282: 
283: function copy(data: DataView): Uint8Array {
284:   return new Uint8Array(data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength));
285: }
286: 
287: function sameBytes(a: Uint8Array, b: Uint8Array): boolean {
288:   if (a.length !== b.length) return false;
289:   for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
290:   return true;
291: }
