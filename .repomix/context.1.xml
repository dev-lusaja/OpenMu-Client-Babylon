  1: /**
  2:  * The band relay end to end, on the real proxy process: a fake game server,
  3:  * the proxy spawned against it, two ws clients that log in the way the
  4:  * client does, one of which starts an instrument and plays. Checks the
  5:  * hello, the scope-based relay of start / batch / stop, that a garbage
  6:  * frame is dropped, and that a flood is stopped with a cooldown - without a
  7:  * browser or an OpenMU.
  8:  *
  9:  *   bun run proxy/band/_e2e.ts
 10:  *
 11:  * Not a vitest test: it needs Bun's sockets. Exit code 0 when every check
 12:  * passes.
 13:  */
 14: import { LoginShortPasswordPacket } from '../../src/common/packets/ClientToServerPackets';
 15: import { Xor3Byte } from '../../src/common/encryption/xor3';
 16: import {
 17:   BAND_LIMITS,
 18:   BandSub,
 19:   RefuseCause,
 20:   StopReason,
 21:   decodeRelayFrame,
 22:   encodeBandState,
 23:   encodeBatch,
 24:   encodeJoin,
 25:   encodeStart,
 26:   encodeStop,
 27:   isBandFrame,
 28:   type BandRelayMessage,
 29: } from '../../src/common/bandProtocol';
 30: import { FrameReader } from '../track/frames';
 31: import { characterInformation, characterList, gameServerEntered, playersInScope, selectCharacter } from '../track/packets';
 32: import { WireEncoder } from '../track/wire';
 33: 
 34: const GS_PORT = 55999;
 35: const PROXY_PORT = 3010;
 36: const PRESENCE_PORT = 3011;
 37: 
 38: const failures: string[] = [];
 39: function check(ok: boolean, what: string): void {
 40:   console.log(`${ok ? 'ok  ' : 'FAIL'} ${what}`);
 41:   if (!ok) failures.push(what);
 42: }
 43: 
 44: const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));
 45: 
 46: /* ---------------------------------------------------- the fake game server */
 47: 
 48: type Conn = { id: number; name: string; reader: FrameReader; wire: WireEncoder; selected: boolean; socket: import('bun').Socket<Conn> };
 49: const conns = new Set<Conn>();
 50: let nextId = 101;
 51: 
 52: Bun.listen<Conn>({
 53:   hostname: '127.0.0.1',
 54:   port: GS_PORT,
 55:   socket: {
 56:     open(socket) {
 57:       const id = nextId++;
 58:       const conn: Conn = { id, name: `P${id}`, reader: new FrameReader('client'), wire: new WireEncoder(), selected: false, socket };
 59:       socket.data = conn;
 60:       conns.add(conn);
 61:       socket.write(conn.wire.server(gameServerEntered(id)));
 62:     },
 63:     data(socket, chunk) {
 64:       const conn = socket.data;
 65:       conn.reader.feed(new Uint8Array(chunk), frame => {
 66:         if (frame.header === 0xc3 && frame.code === 0xf1 && frame.subCode === 0x01) {
 67:           socket.write(new Uint8Array([0xc1, 5, 0xf1, 0x01, 0x01]));
 68:           socket.write(conn.wire.server(characterList([{ name: conn.name, cls: 7, level: 1, status: 0 }])));
 69:         } else if (frame.code === 0xf3 && frame.subCode === 0x03) {
 70:           socket.write(conn.wire.server(characterInformation({ x: 100, y: 100, map: 2, money: 0, status: 0, hp: 1, maxHp: 1 })));
 71:           conn.selected = true;
 72:           // Everyone in the world sees everyone else, a beat later.
 73:           setTimeout(() => {
 74:             for (const a of conns) {
 75:               if (!a.selected) continue;
 76:               const others = Array.from(conns).filter(b => b !== a && b.selected).map(b => ({ id: b.id, x: 101, y: 100, name: b.name }));
 77:               if (others.length) a.socket.write(a.wire.server(playersInScope(others)));
 78:             }
 79:           }, 300);
 80:         }
 81:       });
 82:     },
 83:     close(socket) {
 84:       conns.delete(socket.data);
 85:     },
 86:     error() {},
 87:   },
 88: });
 89: 
 90: /* ------------------------------------------------------------- the proxy */
 91: 
 92: const proxy = Bun.spawn(['bun', 'run', 'proxy/main.ts'], {
 93:   cwd: `${import.meta.dir}/../..`,
 94:   env: {
 95:     ...process.env,
 96:     PORT: String(PROXY_PORT),
 97:     PRESENCE_PORT: String(PRESENCE_PORT),
 98:     ALLOW_TARGETS: `127.0.0.1:${GS_PORT}`,
 99:     TRACK_DB_PATH: 'memory',
100:     LOG_PACKETS: 'off',
101:     WEATHER: 'off',
102:   },
103:   stdout: 'pipe',
104:   stderr: 'pipe',
105: });
106: 
107: let proxyLog = '';
108: async function pump(stream: ReadableStream<Uint8Array>): Promise<void> {
109:   const reader = stream.getReader();
110:   const decoder = new TextDecoder();
111:   for (;;) {
112:     const { done, value } = await reader.read();
113:     if (done) return;
114:     proxyLog += decoder.decode(value);
115:   }
116: }
117: void pump(proxy.stdout);
118: void pump(proxy.stderr);
119: 
120: for (let i = 0; i < 100 && !proxyLog.includes('Listening'); i++) await sleep(100);
121: check(proxyLog.includes('Listening'), 'proxy started');
122: check(proxyLog.includes('band: on'), 'proxy reports the band relay on');
123: 
124: /* ------------------------------------------------------------ the clients */
125: 
126: type Client = { ws: WebSocket; wire: WireEncoder; got: BandRelayMessage[]; name: string };
127: 
128: function login(name: string): Uint8Array {
129:   const p = LoginShortPasswordPacket.createPacket();
130:   const account = new Uint8Array(10);
131:   account.set(new TextEncoder().encode(name));
132:   Xor3Byte(account, 10);
133:   p.setUsername(account, 10);
134:   return new Uint8Array(p.buffer.buffer);
135: }
136: 
137: function connect(name: string): Promise<Client> {
138:   return new Promise((resolve, reject) => {
139:     const nonce = name.padEnd(32, '0').slice(0, 32).replace(/[^0-9a-f]/g, 'a');
140:     const ws = new WebSocket(`ws://127.0.0.1:${PROXY_PORT}/?host=127.0.0.1&port=${GS_PORT}&session=${nonce}`);
141:     ws.binaryType = 'arraybuffer';
142:     const client: Client = { ws, wire: new WireEncoder(), got: [], name };
143:     ws.onmessage = ev => {
144:       const bytes = new Uint8Array(ev.data as ArrayBuffer);
145:       if (!isBandFrame(bytes)) return;
146:       const msg = decodeRelayFrame(bytes);
147:       if (msg) client.got.push(msg);
148:     };
149:     ws.onopen = () => resolve(client);
150:     ws.onerror = () => reject(new Error(`${name}: ws error`));
151:   });
152: }
153: 
154: const send = (c: Client, plain: Uint8Array) => c.ws.send(c.wire.client(plain));
155: 
156: const a = await connect('acca');
157: const b = await connect('accb');
158: await sleep(200);
159: 
160: check(a.got.some(m => m.sub === BandSub.Hello && m.version === 1), 'A got the hello');
161: check(b.got.some(m => m.sub === BandSub.Hello), 'B got the hello');
162: 
163: send(a, login('acca'));
164: send(b, login('accb'));
165: await sleep(300);
166: send(a, selectCharacter('P101'));
167: send(b, selectCharacter('P102'));
168: await sleep(800);
169: 
170: const note = (n: number, dt = 0) => ({ dt, status: 0x90, d1: n, d2: 100 });
171: 
172: send(a, encodeStart(0));
173: await sleep(200);
174: send(a, encodeBatch(0, 250, [note(60), note(64, 120)]));
175: await sleep(300);
176: 
177: const bStart = b.got.find(m => m.sub === BandSub.Start);
178: check(!!bStart && bStart.performerId === 101 && bStart.instrument === 0, 'B got A\'s start with A\'s id');
179: const bBatch = b.got.find(m => m.sub === BandSub.Batch);
180: check(!!bBatch && bBatch.performerId === 101 && bBatch.events.length === 2 && bBatch.events[1].dt === 120, 'B got A\'s batch intact');
181: check(!a.got.some(m => m.sub === BandSub.Batch), 'A does not hear its own batch back');
182: 
183: // Garbage with the band code: dropped, nothing breaks.
184: a.ws.send(new Uint8Array([0xc1, 9, 0xfa, 0x03, 1, 2, 3, 4, 5]));
185: await sleep(100);
186: send(a, encodeBatch(1, 600, [note(67)]));
187: await sleep(200);
188: check(b.got.filter(m => m.sub === BandSub.Batch).length === 2, 'the stream continues after a garbage frame');
189: 
190: send(a, encodeStop());
191: await sleep(200);
192: const bStop = b.got.find(m => m.sub === BandSub.Stop);
193: check(!!bStop && bStop.reason === StopReason.Ended, 'B got A\'s stop');
194: 
195: // A band: B takes an instrument out (a performer too), joins A and doubles
196: // A's stream on it. A learns who joined; the master stopping dissolves it.
197: await sleep(BAND_LIMITS.cooldownAfterEndMs + 100);
198: send(a, encodeStart(0));
199: send(b, encodeStart(2));
200: await sleep(200);
201: send(b, encodeJoin(101, 2, 0xffff));
202: await sleep(200);
203: const aJoin = a.got.find(m => m.sub === BandSub.Join);
204: check(!!aJoin && aJoin.performerId === 102 && aJoin.masterId === 101 && aJoin.mask === 0xffff, "A got B's join");
205: check(!b.got.some(m => m.sub === BandSub.Refused), 'B was not refused for having an instrument out');
206: send(a, encodeBandState(0xffff, [{ id: 102, instrument: 2, mask: 0xffff }]));
207: await sleep(200);
208: check(b.got.some(m => m.sub === BandSub.BandState && m.performerId === 101 && m.members.length === 1), "B got A's band state");
209: send(a, encodeStop());
210: await sleep(200);
211: check(b.got.filter(m => m.sub === BandSub.Stop && m.performerId === 101).length === 2, "B got A's stop once, as a member and receiver");
212: send(b, encodeStop());
213: await sleep(200);
214: 
215: // A flood: more batches in a second than the relay allows.
216: await sleep(BAND_LIMITS.cooldownAfterEndMs + 100);
217: send(a, encodeStart(1));
218: await sleep(150);
219: for (let i = 0; i < BAND_LIMITS.maxBatchesPerSecond + 2; i++) send(a, encodeBatch(i, i * 10, [note(60)]));
220: await sleep(400);
221: const flood = a.got.find(m => m.sub === BandSub.Stop && m.reason === StopReason.Flood);
222: check(!!flood, 'A was stopped for flooding');
223: send(a, encodeStart(1));
224: await sleep(200);
225: const refused = a.got.find(m => m.sub === BandSub.Refused);
226: check(!!refused && refused.cause === RefuseCause.Cooldown, 'A is refused during the cooldown');
227: 
228: a.ws.close();
229: b.ws.close();
230: await sleep(200);
231: proxy.kill();
232: 
233: const bandLines = proxyLog.split('\n').filter(l => l.includes('band:')).join('\n');
234: console.log(bandLines);
235: 
236: if (failures.length) {
237:   console.error(`${failures.length} check(s) failed`);
238:   process.exit(1);
239: }
240: console.log('all checks passed');
241: process.exit(0);
</file>

