302: async function disposeBot(bot: Bot): Promise<void> {
303:   // Log out first: a dropped socket leaves the account connected server side
304:   // and the next run cannot log in.
305:   try {
306:     bot.session.logOut();
307:     await sleep(400);
308:   } catch {
309:     // Already gone; closing below is all that is left to do.
310:   }
311:   bot.trade.dispose();
312:   bot.scope.dispose();
313:   bot.wallet.dispose();
314:   bot.connection.close();
315: }
