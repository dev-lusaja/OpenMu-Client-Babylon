453: /** The first bag square; below it is worn equipment, which is not ours to give. */
454: const FIRST_BAG_SLOT = 12;
455: 
456: /** Bag squares to sweep. 64 ordinary plus the extension rows above them. */
457: const LAST_BAG_SLOT = 203;
458: 
459: /**
460:  * Hands a bot's entire bag back to a person, in as many trades as it takes.
461:  *
462:  * For clearing up after the service has lost track of what it is holding: the
463:  * listings table records a slot per listing, and when that record is wrong or
464:  * missing there is no way to work out which item belonged to whom. Everything
465:  * in the bag goes back to one named person, and sorting out who was owed what
466:  * is left to people.
467:  *
468:  * The bag is not read, it is *probed*. There is no packet that asks the server
469:  * what a character is carrying outside of login, so every square is offered in
470:  * turn and the ones holding something answer with `ItemMoved`. An empty square
471:  * is refused silently, which is exactly the signal needed, and costs one
472:  * packet.
473:  */
474: async function returnEverything(
475:   bot: { session: BotSession; trade: TradeSession; scope: Scope; log: (m: string) => void },
476:   target: string
477: ): Promise<void> {
478:   const { session, trade, scope } = bot;
479:   let slot = FIRST_BAG_SLOT;
480:   let trips = 0;
481:   let given = 0;
482: 
483:   while (slot <= LAST_BAG_SLOT) {
484:     await session.warpTo(target).catch(() => log(`could not warp to ${target}`));
485:     await sleep(1500);
486: 
487:     const partner = scope.byName(target);
488:     if (!partner) throw new Error(`${target} is not in view; stand somewhere reachable`);
489:     session.teleportTo(partner.x, partner.y);
490:     await sleep(1500);
491: 
492:     await trade.requestWith(partner.id, 20_000);
493:     log(`trade ${++trips} open with ${target}`);
494: 
495:     // Fill the table, skipping the squares that turn out to be empty.
496:     const before = slot;
497:     while (slot <= LAST_BAG_SLOT && trade.myItems.size < TRADE_SLOTS) {
498:       trade.offerItem(slot, trade.myItems.size);
499:       slot++;
500:       await sleep(120);
501:     }
502:     log(`offered ${trade.myItems.size} item(s) from squares ${before}-${slot - 1}`);
503: 
504:     if (trade.myItems.size === 0) {
505:       trade.cancel();
506:       continue;
507:     }
508: 
509:     // The partner puts up nothing; this is a gift, not an exchange.
510:     log(`waiting for ${target} to accept`);
511:     const outcome = await trade.settle({ expectMoney: 0, expectItems: 0 }, 120_000);
512:     if (!outcome.ok) throw new Error(`trade ${trips} failed: ${outcome.reason}`);
513: 
514:     given += trade.myItems.size;
515:     log(`trade ${trips} done; ${given} item(s) returned so far`);
516:     await sleep(2000);
517:   }
518: 
519:   log(`returned ${given} item(s) to ${target} in ${trips} trade(s)`);
520: }
521: 
522: function report(scope: Scope): void {
523:   const players = scope.all;
524:   if (players.length === 0) {
525:     log('scope: nobody in view');
526:     return;
527:   }
528:   log(
529:     `scope: ${players.length} in view - ` +
530:       players.map(p => `${p.name}#${p.id}@${p.x},${p.y}`).join(', ')
531:   );
532: }
533: 
534: main().catch(e => {
535:   console.error(e instanceof Error ? e.message : e);
536:   process.exit(1);
537: });
</file>

