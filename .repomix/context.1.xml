255: /** One connected bot, standing in the world. */
256: type Bot = {
257:   name: string;
258:   connection: BotConnection;
259:   scope: Scope;
260:   trade: TradeSession;
261:   session: BotSession;
262:   wallet: Wallet;
263: };
264: 
265: async function connectBot(account: string, password: string): Promise<Bot> {
266:   const tag = (message: string) => log(`[${account}] ${message}`);
267:   const connection = new BotConnection(HOST, PORT, tag);
268:   const scope = new Scope(connection, tag);
269:   const trade = new TradeSession(connection, tag);
270:   const wallet = new Wallet(connection, tag);
271:   const session = new BotSession(
272:     connection,
273:     { account, password, character: account, createIfMissing: true },
274:     tag
275:   );
276: 
277:   // The server answers a refused action with a blue message rather than an
278:   // error packet, so it is the only place a reason ever appears.
279:   connection.on(f => {
280:     if (f.code === 0x0d) {
281:       // The message is zero-padded to the frame width, so it is cut at the
282:       // first NUL rather than trimmed with a regex over control characters.
283:       const body = f.bytes.subarray(4);
284:       const end = body.indexOf(0);
285:       const text = new TextDecoder().decode(end === -1 ? body : body.subarray(0, end));
286:       tag(`server says: ${text.trim()}`);
287:     }
288:     if (process.env.VERBOSE) {
289:       tag(`<- 0x${f.code.toString(16).padStart(2, '0')}/0x${f.sub.toString(16)} len ${f.bytes.length}`);
290:     }
291:   });
292: 
293:   await connection.connect();
294:   const character = await session.enterWorld();
295:   scope.selfName = character.Name;
296:   // A bot that does not know its balance cannot reconcile a handover, so it
297:   // waits for the server to state one before it is handed any work.
298:   await wallet.waitForBalance().catch(() => tag('no balance reported; handovers will not reconcile'));
299:   return { name: character.Name, connection, scope, trade, session, wallet };
300: }
