466: 
467: /**
468:  * Words on an order that stays `delivering` because its outcome is unknown -
469:  * the process died mid-transaction, or Postgres went away between COMMIT and
470:  * its reply. The state does not move: `queued` could deliver twice, `failed`
471:  * could tell a player nothing was spent when it was. The player reads this,
472:  * the audit row has the rest, and `cashshop-orders` is how a person settles it.
473:  */
474: export function explainDelivering(id: string, reason: string): void {
475:   annotateDelivering.run(reason, Date.now(), id);
476: }
477: 
478: export type Cancellation =
479:   | { ok: true; order: Order }
480:   | { ok: false; reason: 'notFound' | 'notQueued' | 'gacha' };
481: 
482: const cancelInTransaction = db.transaction((id: string, account: string): Cancellation => {
483:   const row = selectOrder.get(id);
484: 
485:   // An order that belongs to someone else reads as absent: the id is not a
486:   // secret, but whether it exists is nobody else's business.
487:   if (!row || row.account !== account) return { ok: false, reason: 'notFound' };
488:   if (row.line === 'gacha') return { ok: false, reason: 'gacha' };
489:   if (row.state !== 'queued') return { ok: false, reason: 'notQueued' };
490: 
491:   cancelQueued.run('Cancelled by the player.', Date.now(), id);
492: 
493:   if (!changed()) return { ok: false, reason: 'notQueued' };
494: 
495:   audit('cancelled', { account, orderId: id });
496: 
497:   const order = orderById(id);
498: 
499:   if (!order) throw new Error(`order ${id} vanished inside its own transaction`);
500: 
501:   return { ok: true, order };
502: });
503: 
504: /**
505:  * The player changing their mind, while the order is still only a promise.
506:  * Never a gacha: its roll was committed when it was paid for, and a cancel
507:  * would be the outcome-shopping the placement-time roll exists to prevent.
508:  */
509: export function cancel(id: string, account: string): Cancellation {
510:   return cancelInTransaction(id, account);
511: }
512: 
513: /* ------------------------------------------------------------- state locks */
514: 
515: /**
516:  * How long a lock may stand before the sweep treats its holder as dead. A
517:  * delivery is one short write per order, so a lock older than this that no
518:  * running worker owns (`Fulfilment.sweep` knows its own) belongs to a process
519:  * that was killed with the account still set to TemporarilyBanned
520:  * (`LoginAction.ValidateAccountStateAsync` refuses it at login), and the
521:  * sweep runs at this interval so that costs a player about a minute.
522:  */
523: export const LOCK_STALE_MS = 30_000;
524: 
525: /**
526:  * Written before `Account.State` is changed, so a crash between the two
527:  * leaves a journal entry and not a mystery. `INSERT OR REPLACE` rather than a
528:  * plain insert: the worker journals in a `try` whose `finally` clears, so a
529:  * stale entry only exists if that `finally` never ran, and the sweep is what
530:  * clears those.
531:  */
532: export function journalLock(accountId: string, originalState: number): void {
533:   insertLock.run(accountId, originalState, Date.now());
534: }
535: 
536: export function clearLock(accountId: string): void {
537:   deleteLock.run(accountId);
538: }
539: 
540: function toLock(row: LockRow): StateLock {
541:   return { accountId: row.account_id, originalState: row.original_state, lockedAt: row.locked_at };
542: }
543: 
544: export function lockFor(accountId: string): StateLock | null {
545:   const row = selectLock.get(accountId);
546:   return row ? toLock(row) : null;
547: }
548: 
549: /** Locks older than `LOCK_STALE_MS`, oldest first, for the sweep to restore. */
550: export function staleLocks(now = Date.now()): StateLock[] {
551:   return selectStaleLocks.all(now - LOCK_STALE_MS).map(toLock);
552: }
