1302:   /**
1303:    * Everything ARCHITECTURE.md asks an audit row to name: account, character,
1304:    * product, jewels, item, seed, gate readings.
1305:    */
1306:   private auditDetail(order: Order, delivery: Delivery, verdict: GateVerdict): Record<string, unknown> {
1307:     return {
1308:       productId: order.productId,
1309:       productName: order.productName,
1310:       line: order.line,
1311:       character: delivery.character,
1312:       slot: delivery.slot,
1313:       chaos: order.chaos,
1314:       walletBefore: delivery.walletBefore,
1315:       spent: delivery.spent.map(jewel => ({ id: jewel.id, storage: jewel.storage, slot: jewel.slot })),
1316:       itemId: delivery.itemId,
1317:       definitionId: delivery.grant.definitionId,
1318:       definitionName: delivery.grant.definitionName,
1319:       level: delivery.grant.level,
1320:       optionIds: delivery.grant.optionIds,
1321:       seed: delivery.grant.seed,
1322:       roll: order.roll,
1323:       signals: signalsOf(verdict),
1324:     };
1325:   }
