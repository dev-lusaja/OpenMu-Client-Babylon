 26: 
 27: /**
 28:  * Every frame here is built by the client's and the server's own encoders
 29:  * and read back through the session's decoders, so what is asserted is the
 30:  * whole path: the bytes a real socket would carry, the state and the lines
 31:  * they turn into.
 32:  */
 33: 
 34: function harness(options: SessionOptions = {}) {
 35:   const events: TrackEvent[] = [];
 36:   let changes = 0;
 37:   let moves = 0;
 38:   let clock = 1_000_000;
 39:   const session = new TrackedSession(
 40:     'a'.repeat(32),
 41:     55901,
 42:     {
 43:       event: (_s, e) => events.push(e),
 44:       change: () => changes++,
 45:       move: () => moves++,
 46:     },
 47:     { now: () => clock, ...options }
 48:   );
 49:   const wire = new WireEncoder();
 50: 
 51:   return {
 52:     session,
 53:     events,
 54:     get changes() {
 55:       return changes;
 56:     },
 57:     get moves() {
 58:       return moves;
 59:     },
 60:     tick(ms: number) {
 61:       clock += ms;
 62:     },
 63:     server(packet: Uint8Array) {
 64:       session.feedServer(wire.server(packet));
 65:     },
 66:     client(packet: Uint8Array) {
 67:       session.feedClient(wire.client(packet));
 68:     },
 69:     /** The usual way in: entered, logged in, listed, picked, placed. */
 70:     enter(gm = false) {
 71:       this.server(gameServerEntered(77));
 72:       session.setAccount('tester');
 73:       this.server(characterList([{ name: 'Aeris', cls: 7, level: 400, status: gm ? 32 : 0 }]));
 74:       this.client(selectCharacter('Aeris'));
 75:       this.server(characterInformation({ x: 130, y: 120, map: 2, money: 500, status: gm ? 32 : 0, hp: 800, maxHp: 1000 }));
 76:     },
 77:     kinds() {
 78:       return events.map(e => e.kind);
 79:     },
 80:     last() {
 81:       return events[events.length - 1];
 82:     },
 83:   };
 84: }
 85: 
 86: describe('TrackedSession', () => {
 87:   it('reads the account, the character and where it stands off the login sequence', () => {
 88:     const h = harness();
 89:     expect(h.session.identified).toBe(false);
 90: 
 91:     h.enter(true);
 92: 
 93:     const snap = h.session.snapshot();
 94:     expect(snap.account).toBe('tester');
 95:     expect(snap.character).toBe('Aeris');
 96:     expect(snap.cls).toBe(7);
 97:     expect(snap.level).toBe(400);
 98:     expect(snap.map).toBe(2);
 99:     expect(snap.x).toBe(130);
100:     expect(snap.y).toBe(120);
101:     expect(snap.money).toBe(500);
102:     expect(snap.hp).toBe(800);
103:     expect(snap.maxHp).toBe(1000);
104:     expect(snap.gm).toBe(true);
105:     expect(h.session.inWorld).toBe(true);
106:     expect(h.session.objectId).toBe(77);
107: 
108:     expect(h.kinds()).toEqual(['login', 'select']);
109:     expect(h.last().text).toBe('entered the world as Aeris (Blade Master, level 400) in Devias at 130, 120');
110:   });
111: 
112:   it('is not a game master on the server status alone being absent', () => {
113:     const h = harness();
114:     h.enter(false);
115:     expect(h.session.gameMaster).toBe(false);
116:   });
117: 
118:   it('replays a walk request to the tile the server was asked for', () => {
119:     const h = harness();
120:     h.enter();
121:     const movesBefore = h.moves;
122: 
123:     // S, S, SE, E: (130,120) -> (131,119) -> (132,118) -> (133,118) -> (134,119)
124:     h.client(walk(130, 120, [2, 2, 3, 4]));
125: 
126:     expect(h.session.x).toBe(134);
127:     expect(h.session.y).toBe(119);
