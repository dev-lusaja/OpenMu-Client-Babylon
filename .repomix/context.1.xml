<file path="marketplace/bot/session.test.ts">
  1: import { describe, expect, it } from 'vitest';
  2: import { BotSession } from './session';
  3: import type { BotConnection, Frame, FrameHandler, Match } from './connection';
  4: import { MapChangedPacket } from '../../src/common/packets/ServerToClientPackets';
  5: import { codeOf } from './wire';
  6: 
  7: /**
  8:  * The warp handshake, which is the whole of what these cover.
  9:  *
 10:  * `/trace` is a map change even onto the map the bot is already standing on,
 11:  * and OpenMU sends nothing at all - no players, no monsters - between the map
 12:  * change and the client saying it has finished loading. A bot that warps
 13:  * without answering is not slow to see the player; it never sees anything
 14:  * again.
 15:  */
 16: class FakeConnection {
 17:   readonly sent: { code: number; sub: number }[] = [];
 18:   private readonly handlers: FrameHandler[] = [];
 19:   private readonly waiters: { match: Match; resolve: (f: Frame) => void }[] = [];
 20: 
 21:   send(buffer: DataView | Uint8Array): void {
 22:     const bytes =
 23:       buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer.buffer.slice(0));
 24:     this.sent.push(codeOf(bytes));
 25:   }
 26: 
 27:   on(handler: FrameHandler): () => void {
 28:     this.handlers.push(handler);
 29:     return () => {
 30:       const i = this.handlers.indexOf(handler);
 31:       if (i >= 0) this.handlers.splice(i, 1);
 32:     };
 33:   }
 34: 
 35:   expect(match: Match): Promise<Frame> {
 36:     return new Promise(resolve => this.waiters.push({ match, resolve }));
 37:   }
 38: 
 39:   /** True once the bot is waiting on something matching this code. */
 40:   waitingFor(code: number): boolean {
 41:     return this.waiters.some(w => w.match.code === code);
 42:   }
 43: 
 44:   deliver(packet: { buffer: DataView }): void {
 45:     const bytes = new Uint8Array(packet.buffer.buffer.slice(0));
 46:     const { code, sub } = codeOf(bytes);
 47:     const frame: Frame = { code, sub, bytes };
 48: 
 49:     for (let i = this.waiters.length - 1; i >= 0; i--) {
 50:       if (this.waiters[i].match.code !== code) continue;
 51:       this.waiters.splice(i, 1)[0].resolve(frame);
 52:     }
 53:     for (const handler of [...this.handlers]) handler(frame);
 54:   }
 55: 
 56:   asConnection(): BotConnection {
 57:     return this as unknown as BotConnection;
 58:   }
 59: }
 60: 
 61: const CHAT_CODE = 0x00;
 62: const READY_CODE = 0xf3;
 63: const MAP_CHANGED_CODE = 0x1c;
 64: 
 65: const mapChanged = () => MapChangedPacket.createPacket();
 66: 
 67: const setup = () => {
 68:   const connection = new FakeConnection();
 69:   const session = new BotSession(
 70:     connection.asConnection(),
 71:     { account: 'MKT001', password: 'x', character: 'MKT001' },
 72:     () => {}
 73:   );
 74:   return { connection, session };
 75: };
 76: 
 77: describe('warpTo', () => {
 78:   it('waits for the map change before saying it is ready', async () => {
 79:     const { connection, session } = setup();
 80: 
 81:     const warp = session.warpTo('Ignies');
 82:     await Promise.resolve();
 83: 
 84:     // The chat has gone out and nothing else has: answering before the server
 85:     // has changed our map would be answering a question it never asked.
 86:     expect(connection.sent.map(s => s.code)).toEqual([CHAT_CODE]);
 87:     expect(connection.waitingFor(MAP_CHANGED_CODE)).toBe(true);
 88: 
 89:     connection.deliver(mapChanged());
 90:     await warp;
 91: 
 92:     expect(connection.sent.map(s => s.code)).toEqual([CHAT_CODE, READY_CODE]);
 93:   });
 94: 
 95:   it('never says it is ready when the server has not moved us', async () => {
 96:     const { connection, session } = setup();
 97: 
 98:     void session.warpTo('Nobody');
 99:     await Promise.resolve();
100:     await Promise.resolve();
101: 
102:     // `/trace` on a name nobody holds is accepted and then quietly does
103:     // nothing, so no map change ever arrives. Answering regardless would tell
104:     // the server the bot had finished loading a map it was never sent to.
105:     expect(connection.sent.map(s => s.code)).toEqual([CHAT_CODE]);
106:   });
107: });
</file>

<file path="marketplace/bot/shop.test.ts">
  1: import { describe, expect, it } from 'vitest';
  2: import { ShopSession, FIRST_SHOP_SLOT } from './shop';
  3: import type { BotConnection, Frame, FrameHandler, Match } from './connection';
  4: import {
  5:   PlayerShopItemSoldToPlayerPacket,
  6:   PlayerShopOpenSuccessfulPacket,
  7:   PlayerShopSetItemPriceResponsePacket,
  8:   PlayerShopSetItemPriceResponseItemPriceSetResultEnum as PriceResult,
  9:   ItemMovedPacket,
 10: } from '../../src/common/packets/ServerToClientPackets';
 11: import { StorageKind } from '../../src/common/itemStorage';
 12: import { codeOf } from './wire';
 13: 
 14: /**
 15:  * The shop is how the bot sells, and the reason it sells this way is that the
 16:  * server does the whole exchange itself. So what is worth testing here is not
 17:  * the sale - nothing on this side can get that wrong - but every step that
 18:  * sets it up, each of which fails silently if it is believed rather than
 19:  * checked.
 20:  *
 21:  * Every shop packet is 0x3F and they are told apart only by sub code, so this
 22:  * fake matches on both. One that matched on code alone would resolve a price
 23:  * response with a shop-opened waiter and pass tests that mean nothing.
 24:  */
 25: class FakeConnection {
 26:   readonly sent: { code: number; sub: number }[] = [];
 27:   private readonly handlers: FrameHandler[] = [];
 28:   private readonly waiters: { match: Match; resolve: (f: Frame) => void }[] = [];
 29: 
 30:   send(buffer: DataView | Uint8Array): void {
 31:     const bytes =
 32:       buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer.buffer.slice(0));
 33:     this.sent.push(codeOf(bytes));
 34:   }
 35: 
 36:   on(handler: FrameHandler): () => void {
 37:     this.handlers.push(handler);
 38:     return () => {
 39:       const i = this.handlers.indexOf(handler);
 40:       if (i >= 0) this.handlers.splice(i, 1);
 41:     };
 42:   }
 43: 
 44:   expect(match: Match): Promise<Frame> {
 45:     return new Promise(resolve => this.waiters.push({ match, resolve }));
 46:   }
 47: 
 48:   deliver(packet: { buffer: DataView }): void {
 49:     const bytes = new Uint8Array(packet.buffer.buffer.slice(0));
 50:     const { code, sub } = codeOf(bytes);
 51:     const frame: Frame = { code, sub, bytes };
 52: 
 53:     for (let i = this.waiters.length - 1; i >= 0; i--) {
 54:       const m = this.waiters[i].match;
 55:       if (m.code !== code) continue;
 56:       if (m.sub !== undefined && m.sub !== sub) continue;
 57:       this.waiters.splice(i, 1)[0].resolve(frame);
 58:     }
 59:     for (const handler of [...this.handlers]) handler(frame);
 60:   }
 61: 
 62:   asConnection(): BotConnection {
 63:     return this as unknown as BotConnection;
 64:   }
 65: }
 66: 
 67: function priceResponse(slot: number, result: PriceResult) {
 68:   const p = PlayerShopSetItemPriceResponsePacket.createPacket();
 69:   p.writeHeader().writeLength();
 70:   p.InventorySlot = slot;
 71:   p.Result = result;
 72:   return p;
 73: }
 74: 
 75: function shopOpened(success: boolean) {
 76:   const p = PlayerShopOpenSuccessfulPacket.createPacket();
 77:   p.writeHeader().writeLength();
 78:   p.Success = success;
 79:   return p;
 80: }
 81: 
 82: function sold(slot: number, buyer: string) {
 83:   const p = PlayerShopItemSoldToPlayerPacket.createPacket();
 84:   p.writeHeader().writeLength();
 85:   p.InventorySlot = slot;
 86:   p.setBuyerName(buyer);
 87:   return p;
 88: }
 89: 
 90: function itemMoved(targetSlot: number, storage: number) {
 91:   const p = ItemMovedPacket.createPacket(16);
 92:   p.writeHeader().writeLength();
 93:   p.TargetSlot = targetSlot;
 94:   p.TargetStorageType = storage;
 95:   return p;
 96: }
 97: 
 98: const setup = () => {
 99:   const fake = new FakeConnection();
100:   return { fake, shop: new ShopSession(fake.asConnection()) };
101: };
102: 
103: describe('ShopSession.stockItem', () => {
104:   it('accepts an item the server put in the shop window, reported as the inventory slot it is', async () => {
105:     const { fake, shop } = setup();
106:     const stocking = shop.stockItem(19, FIRST_SHOP_SLOT);
107: 
108:     // What OpenMU actually answers: the stall is a window onto the
109:     // inventory, so the move comes back as storage 0 at slot 204.
110:     fake.deliver(itemMoved(FIRST_SHOP_SLOT, StorageKind.Inventory));
111: 
112:     await expect(stocking).resolves.toBeUndefined();
113:   });
114: 
115:   it('still accepts a server that names the shop storage', async () => {
116:     const { fake, shop } = setup();
117:     const stocking = shop.stockItem(19, FIRST_SHOP_SLOT);
118: 
119:     fake.deliver(itemMoved(FIRST_SHOP_SLOT, StorageKind.PersonalShop));
120: 
121:     await expect(stocking).resolves.toBeUndefined();
122:   });
123: 
124:   it('refuses when the item went somewhere else', async () => {
125:     const { fake, shop } = setup();
126:     const stocking = shop.stockItem(19, FIRST_SHOP_SLOT);
127: 
128:     // The move was rejected and the item stayed in the bag. Pricing the shop
129:     // slot after this would open a shop selling nothing.
130:     fake.deliver(itemMoved(19, StorageKind.Inventory));
131: 
132:     await expect(stocking).rejects.toThrow(/did not reach shop slot/);
133:   });
134: });
135: 
136: describe('ShopSession.setPrice', () => {
137:   it('carries the server refusal, by name', async () => {
138:     const { fake, shop } = setup();
139:     const pricing = shop.setPrice(FIRST_SHOP_SLOT, 15_000);
140: 
141:     fake.deliver(priceResponse(FIRST_SHOP_SLOT, PriceResult.CharacterLevelTooLow));
142: 
143:     await expect(pricing).rejects.toThrow(/CharacterLevelTooLow/);
144:   });
145: 
146:   it('is happy with a success', async () => {
147:     const { fake, shop } = setup();
148:     const pricing = shop.setPrice(FIRST_SHOP_SLOT, 15_000);
149: 
150:     fake.deliver(priceResponse(FIRST_SHOP_SLOT, PriceResult.Success));
151: 
152:     await expect(pricing).resolves.toBeUndefined();
153:   });
154: });
155: 
156: describe('ShopSession.openWith', () => {
157:   it('is only open once the server says so', async () => {
158:     const { fake, shop } = setup();
159:     const opening = shop.openWith('Marketplace');
160:     expect(shop.isOpen).toBe(false);
161: 
162:     fake.deliver(shopOpened(true));
163:     await opening;
164: 
165:     expect(shop.isOpen).toBe(true);
166:   });
167: 
168:   it('stays shut when the server refuses', async () => {
169:     const { fake, shop } = setup();
170:     const opening = shop.openWith('Marketplace');
171: 
172:     fake.deliver(shopOpened(false));
173: 
174:     await expect(opening).rejects.toThrow(/refused to open/);
175:     expect(shop.isOpen).toBe(false);
176:   });
177: });
