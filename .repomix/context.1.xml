735:   /* ----------------------------------------------------------- the client */
736: 
737:   private onClientFrame(frame: Frame): void {
738:     const { code, subCode, view, bytes } = frame;
739: 
740:     switch (code) {
741:       case 0xf3:
742:         if (subCode === 0x03) {
743:           this.claimCharacter(cleanName(new SelectCharacterPacket(view).Name));
744:         } else if (subCode === 0x01) {
745:           const p = new CreateCharacterPacket(view);
746:           this.emit('select', `created the character ${cleanName(p.Name)} (${className(p.Class)})`, {
747:             name: cleanName(p.Name),
748:             cls: p.Class,
749:           });
750:         } else if (subCode === 0x02) {
751:           const name = cleanName(new DeleteCharacterPacket(view).Name);
752:           this.emit('select', `deleted the character ${name}`, { name });
753:         }
754:         return;
755:       case 0xf1:
756:         // The logout is journaled on the server's answer; nothing to do here.
757:         return;
758:       case 0xb1: {
759:         // A map-server switch re-authenticates with the character's name,
760:         // Xor3-encoded like the login's; no character list comes with it.
761:         if (subCode !== 0x01) return;
762:         const encoded = bytesOf(new ServerChangeAuthenticationPacket(view).CharacterNameXor3 as DataView).slice();
763:         Xor3Byte(encoded);
764:         this.claimCharacter(cleanName(new TextDecoder('ascii').decode(encoded)));
765:         return;
766:       }
767:       case 0xd4:
768:         this.onWalk(new WalkRequestPacket(view), bytes);
769:         return;
770:       case 0x15: {
771:         const p = new InstantMoveRequestPacket(view);
772:         this.moved(p.TargetX, p.TargetY);
773:         this.emit('teleport', withAt('jumped', p.TargetX, p.TargetY), { x: p.TargetX, y: p.TargetY });
774:         return;
775:       }
776:       case 0x00:
777:         this.onChat(cleanName(new PublicChatMessagePacket(view).Message));
778:         return;
779:       case 0x02: {
780:         const p = new WhisperMessagePacket(view);
781:         const to = cleanName(p.ReceiverName);
782:         const text = cleanName(p.Message);
783:         this.emit(
784:           'whisper',
785:           this.whispers ? `whispered to ${to}: ${text}` : `whispered to ${to}`,
786:           this.whispers ? { to, text } : { to }
787:         );
788:         return;
789:       }
790:       case 0x11:
791:         this.onHit(new HitRequestPacket(view));
792:         return;
793:       case 0x19:
794:         this.onSkill(new TargetedSkillPacket(view));
795:         return;
796:       case 0x1e:
797:         this.onAreaSkill(new AreaSkillPacket(view));
798:         return;
799:       case 0x22:
800:         this.pendingPickupAt = this.now();
801:         return;
802:       case 0x23: {
803:         const p = new DropItemRequestPacket(view);
804:         this.pendingDrop = { at: this.now(), x: p.TargetX, y: p.TargetY };
805:         return;
806:       }
807:       case 0x24:
808:         this.onItemMove(new ItemMoveRequestPacket(view));
809:         return;
810:       case 0x26:
811:         this.onConsume(new ConsumeItemRequestPacket(view));
812:         return;
813:       case 0x30: {
814:         const npc = this.scope.get(new TalkToNpcRequestPacket(view).NpcId & ID_MASK);
815:         this.emit('npc', `talked to ${npc?.name ?? 'an NPC'}`, { npc: npc?.name ?? null });
816:         return;
817:       }
818:       case 0x32:
819:         this.pendingBuyAt = this.now();
820:         return;
821:       case 0x33:
822:         this.pendingSell = { at: this.now(), slot: new SellItemToNpcRequestPacket(view).ItemSlot };
823:         return;
824:       case 0x34: {
825:         const slot = new ItemRepairPacket(view).InventoryItemSlot;
826:         this.emit('repair', slot === 0xff ? 'repaired everything' : `repaired the item in slot ${slot}`, {
827:           slot,
828:         });
829:         return;
830:       }
831:       case 0x36: {
832:         const partner = this.nameOf(new TradeRequestPacket(view).PlayerId);
833:         this.emit('trade', `asked ${partner} to trade`, { partner });
834:         return;
835:       }
836:       case 0x37: {
837:         const accepted = !!new TradeRequestResponsePacket(view).TradeAccepted;
838:         this.emit('trade', accepted ? 'accepted a trade request' : 'declined a trade request', {
839:           accepted,
840:         });
841:         return;
842:       }
843:       case 0x3f:
844:         this.onShopFrame(subCode, view);
845:         return;
846:       case 0x40: {
847:         const who = this.nameOf(new PartyInviteRequestPacket(view).TargetPlayerId);
848:         this.emit('party', `invited ${who} to the party`, { who });
849:         return;
850:       }
851:       case 0x50: {
852:         const who = this.nameOf(new GuildJoinRequestPacket(view).GuildMasterPlayerId);
853:         this.emit('guild', `asked ${who} to join their guild`, { who });
854:         return;
855:       }
856:       case 0x8e:
857:         if (subCode === 0x02) {
858:           const index = new WarpCommandRequestPacket(view).WarpInfoIndex;
859:           this.emit('warp', `used the warp list (entry ${index})`, { index });
860:         }
861:         return;
862:       case 0x1c: {
863:         const gate = new EnterGateRequestPacket(view).GateNumber;
864:         this.emit('warp', `entered gate ${gate}`, { gate });
865:         return;
866:       }
867:     }
868:   }
869: 
870:   private onWalk(p: WalkRequestPacket, bytes: Uint8Array): void {
871:     let x = p.SourceX;
872:     let y = p.SourceY;
873:     const steps = Math.min(p.StepCount, 15);
874: 
875:     // Two steps per byte from offset 6, the first in the high nibble
876:     // (`Store.sendWalkPath`).
877:     for (let i = 0; i < steps; i++) {
878:       const byte = bytes[6 + (i >> 1)];
879:       if (byte === undefined) break;
880:       const dir = i % 2 === 0 ? byte >> 4 : byte & 0x0f;
881:       if (dir > 7) break;
882:       x += DIR_DX[dir];
883:       y += DIR_DY[dir];
884:     }
885: 
886:     this.moved(x, y);
887: 
888:     const now = this.now();
889:     if (now - this.lastWalkEventAt >= WALK_EVENT_MS) {
890:       this.lastWalkEventAt = now;
891:       this.emit('walk', withAt('walked', this.x, this.y), { x: this.x, y: this.y });
892:     }
893:   }
894: 
895:   private onChat(text: string): void {
896:     if (!text) return;
897: 
898:     if (text.startsWith('/')) {
899:       this.emit('command', text, { line: text });
900:       return;
901:     }
902: 
903:     const first = text[0];
904:     if (first === '~') this.emit('party', `party: ${text.slice(1)}`, { text: text.slice(1) });
905:     else if (first === '@') this.emit('guild', `guild: ${text.slice(1)}`, { text: text.slice(1) });
906:     else if (first === '!' || first === '#') this.emit('shout', `shout: ${text.slice(1)}`, { text: text.slice(1) });
907:     else this.emit('chat', text, { text });
908:   }
909: 
910:   private onHit(p: HitRequestPacket): void {
911:     const target = p.TargetId & ID_MASK;
912:     const now = this.now();
913:     if (target === this.lastAttack.target && now - this.lastAttack.at < ATTACK_EVENT_MS) {
914:       this.lastAttack.at = now;
915:       return;
916:     }
917:     this.lastAttack = { target, at: now };
918:     const entry = this.scope.get(target);
919:     this.emit('attack', `attacked ${entry?.name ?? `#${target}`}`, {
920:       target: entry?.name ?? null,
921:       player: entry?.kind === 'player',
922:     });
923:   }
924: 
925:   private onSkill(p: TargetedSkillPacket): void {
926:     const target = p.TargetId & ID_MASK;
927:     const now = this.now();
928:     if (
929:       p.SkillId === this.lastSkill.skill &&
930:       target === this.lastSkill.target &&
931:       now - this.lastSkill.at < ATTACK_EVENT_MS
932:     ) {
933:       this.lastSkill.at = now;
934:       return;
935:     }
936:     this.lastSkill = { skill: p.SkillId, target, at: now };
937:     const entry = this.scope.get(target);
938:     this.emit('skill', `cast skill ${p.SkillId} on ${entry?.name ?? `#${target}`}`, {
939:       skill: p.SkillId,
940:       target: entry?.name ?? null,
941:       player: entry?.kind === 'player',
942:     });
943:   }
944: 
945:   private onAreaSkill(p: AreaSkillPacket): void {
946:     const now = this.now();
947:     if (p.SkillId === this.lastSkill.skill && this.lastSkill.target === -1 && now - this.lastSkill.at < ATTACK_EVENT_MS) {
948:       this.lastSkill.at = now;
949:       return;
950:     }
951:     this.lastSkill = { skill: p.SkillId, target: -1, at: now };
952:     this.emit('skill', withAt(`cast skill ${p.SkillId}`, p.TargetX, p.TargetY), {
953:       skill: p.SkillId,
954:       x: p.TargetX,
955:       y: p.TargetY,
956:     });
957:   }
958: 
959:   private onItemMove(p: ItemMoveRequestPacket): void {
960:     if (p.FromStorage === p.ToStorage) return;
961:     const name = itemName(bytesOf(p.ItemData as DataView));
962:     const from = storageName(p.FromStorage);
963:     const to = storageName(p.ToStorage);
964:     this.emit('item', `moved ${name} from the ${from} to the ${to}`, {
965:       item: name,
966:       from: p.FromStorage,
967:       to: p.ToStorage,
968:     });
969:   }
970: 
971:   private onConsume(p: ConsumeItemRequestPacket): void {
972:     const slot = p.ItemSlot;
973:     const now = this.now();
974:     if (slot === this.lastConsume.slot && now - this.lastConsume.at < CONSUME_EVENT_MS) return;
975:     this.lastConsume = { slot, at: now };
976:     this.emit('item', `used the item in slot ${slot}`, { slot });
977:   }
978: 
979:   private onShopFrame(subCode: number, view: DataView): void {
980:     if (subCode === 0x02) {
981:       const name = cleanName(new PlayerShopOpenPacket(view).StoreName);
982:       this.emit('shop', `opened the shop "${name}"`, { name });
983:     } else if (subCode === 0x03) {
984:       this.emit('shop', 'closed the shop');
985:     } else if (subCode === 0x06) {
986:       const p = new PlayerShopItemBuyRequestPacket(view);
987:       const seller = cleanName(p.PlayerName) || this.nameOf(p.PlayerId);
988:       this.emit('buy', `bought slot ${p.ItemSlot} from ${seller}'s shop`, {
989:         seller,
990:         slot: p.ItemSlot,
991:       });
992:     }
993:   }
