 53: export type BandStats = {
 54:   performers: number;
 55:   members: number;
 56:   batchesIn: number;
 57:   batchesRelayed: number;
 58:   framesSent: number;
 59:   dropped: { malformed: number; rate: number; order: number; backpressure: number; closed: number };
 60:   stopped: { flood: number; order: number; gone: number };
 61:   refused: number;
 62: };
