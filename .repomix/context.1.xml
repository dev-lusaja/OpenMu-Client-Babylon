<file path="marketplace/bot/footprint.ts">
 1: import items from '../../src/common/items.json';
 2: 
 3: /**
 4:  * How many bag squares an item takes, by kind.
 5:  *
 6:  * The bag is a grid, and an item is a rectangle on it: a jewel is one
 7:  * square, a sword one wide and two or three tall, a piece of armour two by
 8:  * two or more. Whether a bot has room for a listing is a question about
 9:  * rectangles, not about how many squares happen to be empty. The sizes come
10:  * from the item table the client draws from, `X` across and `Y` down.
11:  */
12: 
13: export type Footprint = { w: number; h: number };
14: 
15: const ONE: Footprint = { w: 1, h: 1 };
16: 
17: const sizes = new Map<string, Footprint>();
18: for (const entry of items as { Group: number; Index: number; X?: number; Y?: number }[]) {
19:   const w = Number(entry.X ?? 1);
20:   const h = Number(entry.Y ?? 1);
21:   sizes.set(`${entry.Group}/${entry.Index}`, { w: w > 0 ? w : 1, h: h > 0 ? h : 1 });
22: }
23: 
24: /** One square for anything the table does not know. */
25: export function footprintOf(group: number, num: number): Footprint {
26:   return sizes.get(`${group}/${num}`) ?? ONE;
27: }
</file>

<file path="marketplace/bot/itemMatch.test.ts">
 1: import { describe, expect, it } from 'vitest';
 2: import { decodeItem, sameItem } from './itemMatch';
 3: 
 4: /**
 5:  * The check that stops a seller handing over something other than what they
 6:  * listed. The one that let boots go out as gloves was "one item on the
 7:  * table"; this is "the item on the table".
 8:  */
 9: 
10: /** Twelve wire bytes for an item, the way the server serialises one. */
11: function wire(o: {
12:   group: number;
13:   num: number;
14:   lvl?: number;
15:   luck?: boolean;
16:   skill?: boolean;
17:   option?: number;
18:   excellent?: number;
19:   ancient?: number;
20:   durability?: number;
21: }): Uint8Array {
22:   const b = new Uint8Array(12);
23:   b[0] = o.num & 0xff;
24:   b[1] = ((o.lvl ?? 0) << 3) | (o.skill ? 0x80 : 0) | (o.luck ? 0x04 : 0) | ((o.option ?? 0) & 0x03);
25:   b[2] = o.durability ?? 20;
26:   b[3] = ((o.num & 0x100) >> 1) | ((o.option ?? 0) >= 4 ? 0x40 : 0) | ((o.excellent ?? 0) & 0x3f);
27:   b[4] = o.ancient ?? 0;
28:   b[5] = (o.group & 0x0f) << 4;
29:   return b;
30: }
31: 
32: const gloves = { group: 10, num: 1, lvl: 7 };
33: const boots = { group: 11, num: 1, lvl: 7 };
34: 
35: describe('decodeItem', () => {
36:   it('reads the fields a listing is matched on', () => {
37:     const item = decodeItem(wire({ group: 10, num: 257, lvl: 9, luck: true, skill: true, option: 5, excellent: 0x21, ancient: 2 }));
38:     expect(item).toMatchObject({
39:       group: 10,
40:       num: 257,
41:       lvl: 9,
42:       luck: true,
43:       hasSkill: true,
44:       optionLevel: 5,
45:       excellentFlags: 0x21,
46:       ancientDiscriminator: 2,
47:     });
48:   });
49: });
50: 
51: describe('sameItem by fields', () => {
52:   it('accepts the listed item', () => {
53:     expect(sameItem(wire(gloves), gloves)).toBe(true);
54:   });
55: 
56:   it('refuses another item of the same level', () => {
57:     expect(sameItem(wire(boots), gloves)).toBe(false);
58:   });
59: 
60:   it('refuses the same item at another level', () => {
61:     expect(sameItem(wire({ ...gloves, lvl: 9 }), gloves)).toBe(false);
62:   });
63: 
64:   it('refuses a plain item against an excellent listing, and the other way round', () => {
65:     expect(sameItem(wire(gloves), { ...gloves, isExcellent: true, excellentFlags: 4 })).toBe(false);
66:     expect(sameItem(wire({ ...gloves, excellent: 4 }), gloves)).toBe(false);
67:   });
68: 
69:   it('refuses when luck, skill or option differ', () => {
70:     expect(sameItem(wire({ ...gloves, luck: true }), gloves)).toBe(false);
71:     expect(sameItem(wire(gloves), { ...gloves, hasSkill: true })).toBe(false);
72:     expect(sameItem(wire({ ...gloves, option: 4 }), { ...gloves, optionLevel: 3 })).toBe(false);
73:     expect(sameItem(wire({ ...gloves, option: 4 }), { ...gloves, optionLevel: 4 })).toBe(true);
74:   });
75: 
76:   it('ignores durability: it wears down between listing and handover', () => {
77:     expect(sameItem(wire({ ...gloves, durability: 3 }), gloves)).toBe(true);
78:   });
79: });
80: 
81: describe('sameItem by raw bytes', () => {
82:   it('compares the bytes the window sent, durability aside', () => {
83:     const listed = { ...gloves, raw: Array.from(wire({ ...gloves, luck: true, durability: 20 })) };
84:     expect(sameItem(wire({ ...gloves, luck: true, durability: 4 }), listed)).toBe(true);
85:     expect(sameItem(wire({ ...gloves, luck: false }), listed)).toBe(false);
86:     expect(sameItem(wire({ ...boots, luck: true }), listed)).toBe(false);
87:   });
88: 
89:   it('falls back to the fields when raw is not a byte array', () => {
90:     expect(sameItem(wire(gloves), { ...gloves, raw: 'nonsense' })).toBe(true);
91:     expect(sameItem(wire(gloves), { ...gloves, raw: [1, 2, 3] })).toBe(true);
92:     expect(sameItem(wire(gloves), { ...gloves, raw: Array(12).fill(999) })).toBe(true);
93:   });
94: });
</file>

<file path="marketplace/bot/itemMatch.ts">
 1: /**
 2:  * Whether an item on the wire is the item a listing describes.
 3:  *
 4:  * A listing is created from what the seller's window sent: a description of
 5:  * the item they picked. The handover is where the bot is actually handed
 6:  * something, and until this existed the two were never compared - the bot
 7:  * confirmed whatever single item was put on the table, so a seller who
 8:  * listed gloves and handed over boots sold boots as gloves. The catalogue
 9:  * showed the description; the buyer got the bytes.
10:  *
11:  * Twelve bytes describe an item on the wire (the layout
12:  * `src/common/itemSerializer.ts` reads in full). The client's own reading of
13:  * an inventory carries those bytes as `raw`, so when a listing has them the
14:  * comparison is byte for byte, durability aside - it wears down between the
15:  * listing and the handover. Without `raw` the fields a listing states are
16:  * compared one by one, with an absent field meaning none.
17:  */
18: 
19: export type DecodedItem = {
20:   group: number;
21:   num: number;
22:   lvl: number;
23:   hasSkill: boolean;
24:   luck: boolean;
25:   optionLevel: number;
26:   excellentFlags: number;
27:   ancientDiscriminator: number;
28:   durability: number;
29: };
30: 
31: /** What a listing says about its item. Sent by a browser, so nothing is trusted as typed. */
32: export type ListedItem = {
33:   group: number;
34:   num: number;
35:   [key: string]: unknown;
36: };
37: 
38: const DURABILITY_BYTE = 2;
39: const ITEM_BYTES = 12;
40: 
41: export function decodeItem(bytes: Uint8Array): DecodedItem | null {
42:   if (bytes.length < 6) return null;
43:   return {
44:     num: bytes[0] + ((bytes[3] & 0x80) << 1),
45:     group: (bytes[5] & 0xf0) >> 4,
46:     lvl: (bytes[1] & 0x78) >> 3,
47:     hasSkill: (bytes[1] & 0x80) !== 0,
48:     luck: (bytes[1] & 0x04) !== 0,
49:     optionLevel: (bytes[1] & 0x03) + ((bytes[3] & 0x40) !== 0 ? 4 : 0),
50:     excellentFlags: bytes[3] & 0x3f,
51:     ancientDiscriminator: bytes[4] & 0x03,
52:     durability: bytes[2],
53:   };
54: }
55: 
56: const num = (value: unknown, fallback = 0): number =>
57:   typeof value === 'number' && Number.isFinite(value) ? value : fallback;
58: const bool = (value: unknown): boolean => value === true;
59: 
60: /** The listing's own wire bytes, when the window sent them and they look like bytes. */
61: function rawOf(listed: ListedItem): number[] | null {
62:   const raw = listed.raw;
63:   if (!Array.isArray(raw) || raw.length < ITEM_BYTES) return null;
64:   if (!raw.every(b => typeof b === 'number' && Number.isInteger(b) && b >= 0 && b <= 0xff)) return null;
65:   return raw as number[];
66: }
67: 
68: export function sameItem(bytes: Uint8Array, listed: ListedItem): boolean {
69:   const raw = rawOf(listed);
70:   if (raw) {
71:     if (bytes.length < ITEM_BYTES) return false;
72:     for (let i = 0; i < ITEM_BYTES; i++) {
73:       if (i === DURABILITY_BYTE) continue;
74:       if (raw[i] !== bytes[i]) return false;
75:     }
76:     return true;
77:   }
78: 
79:   const item = decodeItem(bytes);
80:   if (!item) return false;
81:   return (
82:     item.group === listed.group &&
83:     item.num === listed.num &&
84:     item.lvl === num(listed.lvl) &&
85:     item.excellentFlags === num(listed.excellentFlags) &&
86:     item.optionLevel === num(listed.optionLevel) &&
87:     item.luck === bool(listed.luck) &&
88:     item.hasSkill === bool(listed.hasSkill) &&
89:     item.ancientDiscriminator === num(listed.ancientDiscriminator)
90:   );
91: }
</file>

<file path="marketplace/bot/ledger.ts">
  1: import { appendFileSync, mkdirSync, readFileSync } from 'node:fs';
  2: import { homedir } from 'node:os';
  3: import { dirname, join } from 'node:path';
  4: 
  5: /**
  6:  * An append-only record of every handover, and whether the money moved by
  7:  * exactly what it should have.
  8:  *
  9:  * This exists because the server destroys Zen left on a cancelled trade
 10:  * (`issues/trade/zen_destroyed_when_a_trade_is_cancelled.md`). A bot carrying
 11:  * a float cannot notice that from its own arithmetic - its books would say one
 12:  * thing and the server another, and nobody would find out until the float ran
 13:  * dry. So every handover states what it expected to happen, and is checked
 14:  * against the balance the server reports afterwards.
 15:  *
 16:  * A mismatch is never corrected automatically. It is written down, loudly, and
 17:  * a person decides: silently topping a bot back up would hide exactly the
 18:  * thing this is here to surface.
 19:  *
 20:  * The file lives outside the checkout on purpose. The deploy runs
 21:  * `git clean -fdx` in it, which would take the audit trail with it.
 22:  */
 23: 
 24: export type HandoverKind = 'list' | 'buy' | 'payout';
 25: 
 26: export type LedgerEntry = {
 27:   at: string;
 28:   bot: string;
 29:   partner: string;
 30:   kind: HandoverKind;
 31:   /** What the handover was meant to do to the bot's Zen. */
 32:   expectedZenDelta: number;
 33:   zenBefore: number | null;
 34:   zenAfter: number | null;
 35:   outcome: 'ok' | 'failed';
 36:   reason?: string;
 37:   /** Set only when the money did not move by the expected amount. */
 38:   discrepancy?: number;
 39: };
 40: 
 41: const DEFAULT_PATH = join(homedir(), '.mu-marketplace', 'ledger.jsonl');
 42: 
 43: export class Ledger {
 44:   constructor(
 45:     private readonly path: string = process.env.MARKETPLACE_LEDGER ?? DEFAULT_PATH,
 46:     private readonly log: (message: string) => void = () => {}
 47:   ) {}
 48: 
 49:   /**
 50:    * Records a handover and returns the discrepancy, or null when the books
 51:    * balance. A failed handover is expected to move nothing, so it is checked
 52:    * just as strictly as a successful one - that is the case the cancel bug
 53:    * actually bites in.
 54:    */
 55:   record(entry: Omit<LedgerEntry, 'at' | 'discrepancy'>): number | null {
 56:     const expected = entry.outcome === 'ok' ? entry.expectedZenDelta : 0;
 57: 
 58:     let discrepancy: number | null = null;
 59:     if (entry.zenBefore !== null && entry.zenAfter !== null) {
 60:       const actual = entry.zenAfter - entry.zenBefore;
 61:       if (actual !== expected) discrepancy = actual - expected;
 62:     }
 63: 
 64:     const row: LedgerEntry = {
 65:       at: new Date().toISOString(),
 66:       ...entry,
 67:       ...(discrepancy !== null ? { discrepancy } : {}),
 68:     };
 69: 
 70:     this.write(row);
 71: 
 72:     if (discrepancy !== null) {
 73:       this.log(
 74:         `LEDGER MISMATCH on ${entry.kind} with ${entry.partner}: ` +
 75:           `expected ${expected >= 0 ? '+' : ''}${expected} Zen, ` +
 76:           `saw ${(entry.zenAfter ?? 0) - (entry.zenBefore ?? 0)} ` +
 77:           `(off by ${discrepancy}). Recorded, not corrected.`
 78:       );
 79:     }
 80: 
 81:     return discrepancy;
 82:   }
 83: 
 84:   /** Every entry written so far, oldest first. Skips lines it cannot parse. */
 85:   read(): LedgerEntry[] {
 86:     let text: string;
 87:     try {
 88:       text = readFileSync(this.path, 'utf8');
 89:     } catch {
 90:       return [];
 91:     }
 92:     const rows: LedgerEntry[] = [];
 93:     for (const line of text.split('\n')) {
 94:       if (!line.trim()) continue;
 95:       try {
 96:         rows.push(JSON.parse(line) as LedgerEntry);
 97:       } catch {
 98:         // A torn last line from a killed process; the rest still counts.
 99:       }
100:     }
101:     return rows;
102:   }
103: 
104:   /**
105:    * What each bot is out by, and on which handovers.
106:    *
107:    * The total is the number that matters when topping a bot's float back up:
108:    * it is how much Zen the service has lost that it did not intend to spend.
109:    */
110:   summary(): { bot: string; drift: number; mismatches: number; handovers: number }[] {
111:     const byBot = new Map<string, { drift: number; mismatches: number; handovers: number }>();
112:     for (const row of this.read()) {
113:       const entry = byBot.get(row.bot) ?? { drift: 0, mismatches: 0, handovers: 0 };
114:       entry.handovers++;
115:       if (row.discrepancy !== undefined) {
116:         entry.drift += row.discrepancy;
117:         entry.mismatches++;
118:       }
119:       byBot.set(row.bot, entry);
120:     }
121:     return [...byBot.entries()].map(([bot, e]) => ({ bot, ...e }));
122:   }
123: 
124:   private write(row: LedgerEntry): void {
125:     try {
126:       mkdirSync(dirname(this.path), { recursive: true });
127:       appendFileSync(this.path, `${JSON.stringify(row)}\n`, 'utf8');
128:     } catch (e) {
129:       // Losing the audit line must not take the handover down with it, but it
130:       // has to be visible: this is the record of real money moving.
131:       this.log(`could not write the ledger at ${this.path}: ${e}`);
132:     }
133:   }
134: }
</file>

<file path="marketplace/bot/scope.test.ts">
 1: import { describe, expect, it } from 'vitest';
 2: import { Scope } from './scope';
 3: import type { BotConnection, Frame, FrameHandler } from './connection';
 4: import { codeOf } from './wire';
 5: 
 6: /**
 7:  * The scope has to see a customer whichever packet the server announced
 8:  * them with. A player wearing a transformation ring (or a game master's
 9:  * `/skin`) arrives as 0x45 rather than 0x12, and until that was read the
10:  * bot could stand next to somebody and swear nobody was there.
11:  */
12: class FakeConnection {
13:   private readonly handlers: FrameHandler[] = [];
14: 
15:   on(handler: FrameHandler): () => void {
16:     this.handlers.push(handler);
17:     return () => {
18:       const i = this.handlers.indexOf(handler);
19:       if (i >= 0) this.handlers.splice(i, 1);
20:     };
21:   }
22: 
23:   deliver(bytes: Uint8Array): void {
24:     const { code, sub } = codeOf(bytes);
25:     const frame: Frame = { code, sub, bytes };
26:     for (const handler of [...this.handlers]) handler(frame);
27:   }
28: 
29:   asConnection(): BotConnection {
30:     return this as unknown as BotConnection;
31:   }
32: }
33: 
34: /** C2 45: count, then 38-byte blocks (id, x, y, skin, name, target, rot, appearance, effects). */
35: function transformedScope(entries: { id: number; x: number; y: number; skin: number; name: string }[]) {
36:   const size = 5 + entries.length * 38;
37:   const b = new Uint8Array(size);
38:   b[0] = 0xc2;
39:   b[1] = (size >> 8) & 0xff;
40:   b[2] = size & 0xff;
41:   b[3] = 0x45;
42:   b[4] = entries.length;
43:   let at = 5;
44:   for (const e of entries) {
45:     b[at] = (e.id >> 8) & 0xff;
46:     b[at + 1] = e.id & 0xff;
47:     b[at + 2] = e.x;
48:     b[at + 3] = e.y;
49:     b[at + 4] = (e.skin >> 8) & 0xff;
50:     b[at + 5] = e.skin & 0xff;
51:     for (let i = 0; i < 10; i++) b[at + 6 + i] = i < e.name.length ? e.name.charCodeAt(i) : 0;
52:     b[at + 16] = e.x;
53:     b[at + 17] = e.y;
54:     b[at + 37] = 0;
55:     at += 38;
56:   }
57:   return b;
58: }
59: 
60: describe('a transformed player', () => {
61:   it('is in scope by name, with the spawn flag stripped from the id', () => {
62:     const connection = new FakeConnection();
63:     const scope = new Scope(connection.asConnection());
64: 
65:     connection.deliver(transformedScope([{ id: 0x8003, x: 120, y: 140, skin: 547, name: 'Buyer' }]));
66: 
67:     const seen = scope.byName('buyer');
68:     expect(seen).not.toBeNull();
69:     expect(seen!.id).toBe(3);
70:     expect(seen!.x).toBe(120);
71:     expect(seen!.y).toBe(140);
72:   });
73: 
74:   it('is still never the bot itself', () => {
75:     const connection = new FakeConnection();
76:     const scope = new Scope(connection.asConnection());
77:     scope.selfName = 'MKT001';
78: 
79:     connection.deliver(transformedScope([{ id: 7, x: 1, y: 1, skin: 547, name: 'MKT001' }]));
80: 
81:     expect(scope.byName('MKT001')).toBeNull();
82:     expect(scope.all).toEqual([]);
83:   });
84: });
</file>

<file path="marketplace/bot/scope.ts">
  1: import {
  2:   AddCharactersToScopePacket,
  3:   AddTransformedCharactersToScopePacket,
  4:   MapObjectOutOfScopePacket,
  5:   ObjectMovedPacket,
  6:   ObjectWalkedPacket,
  7: } from '../../src/common/packets/ServerToClientPackets';
  8: import type { BotConnection, Frame } from './connection';
  9: import { view } from './session';
 10: 
 11: /**
 12:  * Who the bot can currently see, and where they are.
 13:  *
 14:  * This exists because a trade cannot be opened by name: `TradeRequest` carries
 15:  * a `PlayerId`, which is the in-world object id, and OpenMU resolves it with
 16:  * `GetObservingPlayerWithIdAsync` - so the partner must already be in the
 17:  * bot's scope. The bot gets them there with `/trace`, which warps a game
 18:  * master to a player, rather than making the player come to it.
 19:  *
 20:  * Object ids are reused as players come and go, so nothing here is cached
 21:  * beyond the current scope: a name that has left is forgotten rather than
 22:  * remembered at a stale id.
 23:  */
 24: 
 25: /**
 26:  * Scope packets set the top bit of an object id as a "just spawned" flag
 27:  * (`NewPlayersInScopePlugIn`: `playerBlock.Id |= 0x8000`). Every other packet,
 28:  * `TradeRequest` included, wants the bare id, and a request carrying the flag
 29:  * resolves to nobody and is answered with silence.
 30:  */
 31: const OBJECT_ID_MASK = process.env.NO_ID_MASK ? 0xffff : 0x7fff;
 32: 
 33: const CODE = {
 34:   addCharacters: 0x12,
 35:   /** A player wearing a monster skin arrives in its own packet. */
 36:   addTransformed: 0x45,
 37:   outOfScope: 0x14,
 38:   moved: 0x15,
 39:   walked: 0xd4,
 40: } as const;
 41: 
 42: /** A name field is fixed width; whatever pads it is not part of the name. */
 43: const cleanName = (name: string) => name.replace(/[\s\0]+$/, '');
 44: 
 45: export type ScopePlayer = {
 46:   id: number;
 47:   rawId: number;
 48:   name: string;
 49:   x: number;
 50:   y: number;
 51: };
 52: 
 53: export class Scope {
 54:   private readonly players = new Map<number, ScopePlayer>();
 55:   private readonly unsubscribe: () => void;
 56: 
 57:   /**
 58:    * The bot's own character. The server puts it in scope like anyone else, and
 59:    * it must never be offered as a trade partner: a bot that traced to itself
 60:    * would sit there waiting for a partner that is never coming.
 61:    */
 62:   selfName: string | null = null;
 63: 
 64:   constructor(
 65:     connection: BotConnection,
 66:     private readonly log: (message: string) => void = () => {}
 67:   ) {
 68:     this.unsubscribe = connection.on(frame => this.handle(frame));
 69:   }
 70: 
 71:   dispose(): void {
 72:     this.unsubscribe();
 73:   }
 74: 
 75:   private isSelf(player: ScopePlayer): boolean {
 76:     return (
 77:       this.selfName !== null && player.name.toLowerCase() === this.selfName.toLowerCase()
 78:     );
 79:   }
 80: 
 81:   /** Everyone in view except the bot itself. */
 82:   get all(): ScopePlayer[] {
 83:     return [...this.players.values()].filter(p => !this.isSelf(p));
 84:   }
 85: 
 86:   byId(id: number): ScopePlayer | null {
 87:     return this.players.get(id) ?? null;
 88:   }
 89: 
 90:   /** Case-insensitive: a character name is typed by a person somewhere. */
 91:   byName(name: string): ScopePlayer | null {
 92:     const wanted = name.toLowerCase();
 93:     for (const player of this.players.values()) {
 94:       if (player.name.toLowerCase() === wanted && !this.isSelf(player)) return player;
 95:     }
 96:     return null;
 97:   }
 98: 
 99:   /**
100:    * Chebyshev distance, which is how MU measures a tile range: the map is a
101:    * grid and a diagonal step costs the same as a straight one.
102:    */
103:   static distance(a: { x: number; y: number }, b: { x: number; y: number }): number {
104:     return Math.max(Math.abs(a.x - b.x), Math.abs(a.y - b.y));
105:   }
106: 
107:   private handle(frame: Frame): void {
108:     switch (frame.code) {
109:       case CODE.addCharacters: {
110:         // The extended layout shares this code; it carries one character and a
111:         // different appearance width, so a parse that disagrees with the
112:         // frame length is dropped rather than guessed at.
113:         let entries;
114:         try {
115:           entries = new AddCharactersToScopePacket(view(frame)).getCharacters();
116:         } catch {
117:           this.log('could not read an AddCharactersToScope frame');
118:           return;
119:         }
120:         if (process.env.VERBOSE) this.log(`scope frame len ${frame.bytes.length}: ${JSON.stringify(entries.map(e => [e.Name, e.Id, e.CurrentPositionX, e.CurrentPositionY]))}`);
121:         for (const entry of entries) {
122:           const id = entry.Id & OBJECT_ID_MASK;
123:           this.players.set(id, {
124:             id,
125:             rawId: entry.Id,
126:             name: cleanName(entry.Name),
127:             x: entry.CurrentPositionX,
128:             y: entry.CurrentPositionY,
129:           });
130:         }
131:         break;
132:       }
133:       case CODE.addTransformed: {
134:         // Same shape with a skin number in it; a customer wearing a
135:         // transformation ring would otherwise be invisible to the bot.
136:         let entries;
137:         try {
138:           entries = new AddTransformedCharactersToScopePacket(view(frame)).getCharacters();
139:         } catch {
140:           this.log('could not read an AddTransformedCharactersToScope frame');
141:           return;
142:         }
143:         for (const entry of entries) {
144:           const id = entry.Id & OBJECT_ID_MASK;
145:           this.players.set(id, {
146:             id,
147:             rawId: entry.Id,
148:             name: cleanName(entry.Name),
149:             x: entry.CurrentPositionX,
150:             y: entry.CurrentPositionY,
151:           });
152:         }
153:         break;
154:       }
155:       case CODE.outOfScope: {
156:         const p = new MapObjectOutOfScopePacket(view(frame));
157:         for (const object of p.getObjects()) this.players.delete(object.Id & OBJECT_ID_MASK);
158:         break;
159:       }
160:       case CODE.moved: {
161:         const p = new ObjectMovedPacket(view(frame));
162:         const player = this.players.get(p.ObjectId & OBJECT_ID_MASK);
163:         if (player) {
164:           player.x = p.PositionX;
165:           player.y = p.PositionY;
166:         }
167:         break;
168:       }
169:       case CODE.walked: {
170:         const p = new ObjectWalkedPacket(view(frame));
171:         const player = this.players.get(p.ObjectId & OBJECT_ID_MASK);
172:         if (player) {
173:           player.x = p.TargetX;
174:           player.y = p.TargetY;
175:         }
176:         break;
177:       }
178:       default:
179:         break;
180:     }
181:   }
182: }
</file>

