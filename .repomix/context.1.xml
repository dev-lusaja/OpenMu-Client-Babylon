426:         return;
427:       case 0x37:
428:         if (bytes.length === 20) this.onTradeAnswer(new TradeRequestAnswerPacket(view));
429:         return;
430:       case 0x3d: {
431:         const result = new TradeFinishedPacket(view).Result;
432:         this.emit('trade', `trade ${TRADE_RESULTS[result] ?? `ended (${result})`}`, { result });
433:         return;
434:       }
435:       case 0x65:
436:         this.onGuildMembers(new AssignCharacterToGuildPacket(view));
437:         return;
438:       case 0x66:
439:         this.onGuildInformation(new GuildInformationPacket(view));
440:         return;
441:     }
442:   }
443: 
444:   private onGameServerEntered(p: GameServerEnteredPacket): void {
445:     if (!p.Success) return;
446:     this.objectId = p.PlayerId & ID_MASK;
447:   }
448: 
449:   private onLogoutResponse(p: LogoutResponsePacket): void {
450:     const type = p.Type;
451:     if (this.character) this.emit('logout', LOGOUT_TEXT[type] ?? `logged out (${type})`, { type });
452:     if (type === 1 || type === 2) this.leaveWorld();
453:   }
454: 
455:   private onCharacterFrame(subCode: number, view: DataView, bytes: Uint8Array): void {
456:     switch (subCode) {
457:       case 0x00:
458:         this.onCharacterList(new CharacterListPacket(view));
459:         return;
460:       case 0x03:
461:         if (bytes.length === CharacterInformationPacket.Length) {
462:           this.onCharacterInformation(new CharacterInformationPacket(view));
463:         }
464:         return;
465:       case 0x04:
466:         this.onRespawn(new RespawnAfterDeathPacket(view));
467:         return;
468:       case 0x05: {
469:         const level = new CharacterLevelUpdatePacket(view).Level;
470:         if (level !== this.level) {
471:           this.level = level;
472:           this.emit('level', `reached level ${level}`, { level });
473:           this.sink.change(this);
474:         }
475:         return;
476:       }
477:       case 0x08: {
478:         const p = new HeroStateChangedPacket(view);
479:         if ((p.PlayerId & ID_MASK) !== this.objectId) return;
480:         this.heroState = p.NewState;
481:         this.emit('state', `is now ${heroStateName(p.NewState)}`, { heroState: p.NewState });
482:         this.sink.change(this);
483:         return;
484:       }
485:     }
486:   }
487: 
488:   /**
489:    * The name the client says it is picking. Only a name the server listed on
490:    * this account is believed - the list is the server's, the claim is the
491:    * client's, and a forged claim would file this socket's doings under
492:    * somebody else's character. Two claims in flight when the server answers
493:    * name nobody, for the same reason presence names nobody then. A socket
494:    * that never saw a list (a map-server switch re-authenticates without one)
495:    * has nothing to check the name against and takes it, still subject to
496:    * the two-in-flight rule.
497:    */
498:   private claimCharacter(name: string): void {
499:     if (!name) return;
500:     if (this.characters.size > 0 && !this.characters.has(name)) return;
501:     if (this.pendingSelect !== null) this.selectAmbiguous = true;
502:     this.pendingSelect = name;
503:   }
504: 
505:   private onCharacterList(p: CharacterListPacket): void {
506:     this.characters.clear();
507:     this.pendingSelect = null;
508:     this.selectAmbiguous = false;
509:     for (const c of p.getCharacters()) {
510:       // The class travels in the appearance's first byte, high five bits.
511:       const appearance = bytesOf(c.Appearance as DataView);
512:       const cls = appearance.length ? appearance[0] >> 3 : 0;
513:       this.characters.set(cleanName(c.Name), { cls, level: c.Level, status: c.Status });
514:     }
515:   }
516: 
517:   private onCharacterInformation(p: CharacterInformationPacket): void {
518:     const ambiguous = this.selectAmbiguous;
519:     const name = ambiguous ? null : (this.pendingSelect ?? this.character);
520:     this.pendingSelect = null;
521:     this.selectAmbiguous = false;
522: 
523:     const known = name ? this.characters.get(name) : undefined;
524:     this.character = name;
525:     this.cls = known?.cls ?? this.cls;
526:     this.level = known?.level ?? this.level;
527:     this.map = p.MapId;
528:     this.money = p.Money;
529:     this.heroState = p.HeroState;
530:     this.hp = p.CurrentHealth;
531:     this.maxHp = p.MaximumHealth;
532:     this.gameMaster = (p.Status & GAME_MASTER_STATUS) !== 0;
533:     this.moved(p.X, p.Y);
534: 
535:     const who = name ?? (ambiguous ? 'an unverified character' : 'a character');
536:     const detail = [className(this.cls), this.level ? `level ${this.level}` : '']
537:       .filter(Boolean)
538:       .join(', ');
539:     this.emit(
540:       'select',
541:       withAt(
542:         `entered the world as ${who}${detail ? ` (${detail})` : ''} in ${mapName(p.MapId)}`,
543:         p.X,
544:         p.Y
545:       ),
546:       {
547:         map: p.MapId,
548:         x: p.X,
549:         y: p.Y,
550:         cls: this.cls,
551:         level: this.level,
552:         gm: this.gameMaster,
553:         ...(ambiguous ? { unverified: true } : {}),
554:       }
555:     );
556:     this.sink.change(this);
557:   }
558: 
559:   private onRespawn(p: RespawnAfterDeathPacket): void {
560:     this.map = p.MapNumber;
561:     this.money = p.Money;
562:     this.moved(p.PositionX, p.PositionY);
563:     this.emit(
564:       'map',
565:       withAt(`respawned in ${mapName(p.MapNumber)}`, p.PositionX, p.PositionY),
566:       { map: p.MapNumber, x: p.PositionX, y: p.PositionY }
567:     );
568:     this.sink.change(this);
569:   }
570: 
571:   private onMapChanged(p: MapChangedPacket): void {
572:     const map = p.MapNumber;
573:     const changed = p.IsMapChange || map !== this.map;
574:     this.map = map;
575:     this.moved(p.PositionX, p.PositionY);
576: 
577:     if (changed) {
578:       this.scope.clear();
579:       this.drops.clear();
580:       this.emit('map', withAt(`entered ${mapName(map)}`, p.PositionX, p.PositionY), {
581:         map,
582:         x: p.PositionX,
583:         y: p.PositionY,
584:       });
585:       this.sink.change(this);
586:     } else {
587:       this.emit('teleport', withAt('was moved', p.PositionX, p.PositionY), {
588:         x: p.PositionX,
589:         y: p.PositionY,
590:       });
591:     }
592:   }
593: 
594:   private onObjectMoved(p: ObjectMovedPacket): void {
595:     if ((p.ObjectId & ID_MASK) !== this.objectId) return;
596:     this.moved(p.PositionX, p.PositionY);
597:     this.emit('teleport', withAt('was moved', p.PositionX, p.PositionY), {
598:       x: p.PositionX,
599:       y: p.PositionY,
600:     });
601:   }
602: 
603:   private onKilled(p: ObjectGotKilledPacket): void {
604:     const killed = p.KilledId & ID_MASK;
605:     const killer = p.KillerId & ID_MASK;
606: 
607:     if (killed === this.objectId) {
608:       const by = this.scope.get(killer);
609:       this.emit('death', by ? `was killed by ${by.name}` : 'died', {
610:         killer: by?.name ?? null,
611:         skill: p.SkillId,
612:       });
613:     } else if (killer === this.objectId) {
614:       const victim = this.scope.get(killed);
615:       const what = victim ? (victim.kind === 'player' ? `player ${victim.name}` : victim.name) : `#${killed}`;
616:       this.emit('kill', `killed ${what}`, {
617:         victim: victim?.name ?? null,
618:         player: victim?.kind === 'player',
619:         skill: p.SkillId,
620:       });
621:     }
622:   }
623: 
624:   private onExperience(p: ExperienceGainedPacket): void {
625:     const exp = p.AddedExperience;
626:     if (!exp) return;
627:     const from = this.scope.get(p.KilledObjectId & ID_MASK);
628:     this.emit('exp', `+${exp} exp${from ? ` (${from.name})` : ''}`, {
629:       exp,
630:       from: from?.name ?? null,
631:     });
632:   }
633: 
634:   private onItemsDropped(p: ItemsDroppedPacket): void {
635:     const now = this.now();
636:     for (const drop of p.getItems()) {
637:       const name = itemName(bytesOf(drop.ItemData as DataView));
638:       if (this.drops.size >= MAX_DROPS) this.drops.clear();
639:       this.drops.set(drop.Id & ID_MASK, name);
640: 
641:       const pending = this.pendingDrop;
642:       if (
643:         drop.IsFreshDrop &&
644:         pending &&
645:         now - pending.at < PENDING_MS &&
646:         Math.abs(drop.PositionX - pending.x) <= 2 &&
647:         Math.abs(drop.PositionY - pending.y) <= 2
648:       ) {
649:         this.pendingDrop = null;
650:         this.emit('drop', withAt(`dropped ${name}`, drop.PositionX, drop.PositionY), {
651:           item: name,
652:           x: drop.PositionX,
653:           y: drop.PositionY,
654:         });
655:       }
656:     }
657:   }
658: 
659:   private onItemAdded(p: ItemAddedToInventoryPacket): void {
660:     const name = itemName(bytesOf(p.ItemData as DataView));
661:     if (this.now() - this.pendingPickupAt < PENDING_MS) {
662:       this.pendingPickupAt = 0;
663:       this.emit('pickup', `picked up ${name}`, { item: name, slot: p.InventorySlot });
664:     } else {
665:       this.emit('item', `received ${name}`, { item: name, slot: p.InventorySlot });
666:     }
667:   }
668: 
669:   private onMoney(money: number): void {
670:     const delta = money - this.money;
671:     this.money = money;
672:     if (delta !== 0) {
673:       const sign = delta > 0 ? '+' : '';
674:       this.emit('money', `money is now ${money} (${sign}${delta})`, { money, delta });
675:     }
676:     this.sink.change(this);
677:   }
678: 
679:   private onItemBought(p: ItemBoughtPacket): void {
680:     const name = itemName(bytesOf(p.ItemData as DataView));
681:     this.pendingBuyAt = 0;
682:     this.emit('buy', `bought ${name}`, { item: name, slot: p.InventorySlot });
683:   }
684: 
685:   private onSold(p: NpcItemSellResultPacket): void {
686:     const pending = this.pendingSell;
687:     this.pendingSell = null;
688:     if (!p.Success) return;
689:     const slot = pending && this.now() - pending.at < PENDING_MS ? pending.slot : null;
690:     this.money = p.Money;
691:     this.emit(
692:       'sell',
693:       `sold the item${slot !== null ? ` in slot ${slot}` : ''} (money is now ${p.Money})`,
694:       { slot, money: p.Money }
695:     );
696:     this.sink.change(this);
697:   }
