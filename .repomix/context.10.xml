213:     const anchorHeight = number.entity.screenPosition.worldOffsetZ * MU_SCALE;
214: 
215:     const step = (now: number) => {
216:       const factor = Math.min(((now - last) / 1000) * REFERENCE_FPS, 1);
217:       last = now;
