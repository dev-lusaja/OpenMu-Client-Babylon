 1: // `RenderBoolean`: each line is a box of the balloon's full width (the
 2: // widest line, the name +3px), text left-aligned, one `FontHeight` (12px at
 3: // 480 lines) tall. The balloon's bottom sits on the owner's anchor.
 4: .name-tags {
 5:   position: absolute;
 6:   inset: 0;
 7:   pointer-events: none;
 8:   overflow: hidden;
 9: 
10:   .name-tag {
11:     position: absolute;
12:     left: 0;
13:     top: 0;
14:     display: flex;
15:     flex-direction: column;
16:     align-items: stretch;
17:     transform: translate(-10000px, -10000px);
18:     contain: layout;
19:     white-space: nowrap;
20: 
21:     .line {
22:       padding: 0 3px 0 2px;
23:       font-size: 12px;
24:       line-height: 13px;
25:       text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.6);
26:     }
27: 
28:     // The 8x8 guild mark in front of the name, the size the guild lists draw
29:     // it at (`RenderBitmap(BITMAP_GUILD, x, y, 8, 8)`, UIControls.cpp:1214).
30:     // Sized here, not on the tag: `.app img { width: 100%; height: 100% }`
31:     // (style.less) outranks the width/height attributes.
32:     .line .name-tag-mark {
33:       display: inline-block;
34:       width: 8px;
35:       height: 8px;
36:       margin-right: 3px;
37:       vertical-align: baseline;
38:       image-rendering: pixelated;
39:     }
40: 
41:     // `g_pRenderText->SetFont(g_hFontBold)`: the GM name and a shop title.
42:     .line.bold {
43:       font-weight: bold;
44:     }
45: 
46:     // The safe-zone hover blink of `RenderBoolean`: the name swaps its text
47:     // and background colours. The original flips on `WorldTime % 24 < 12`,
48:     // i.e. every ~12 ms; that samples down to a per-frame strobe, so the swap
49:     // is slowed to 480 ms here.
50:     .line.blink {
51:       animation: name-tag-blink 0.48s steps(1, end) infinite;
52:     }
53:   }
54: }
55: 
56: @keyframes name-tag-blink {
57:   50% {
58:     color: var(--tag-bg);
59:     background-color: var(--tag-text);
60:   }
61: }
