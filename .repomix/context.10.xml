 69:     case 1:
 70:       return { colour: [0, 1, 1], scale: BIG_SCALE };
 71:     case 2:
 72:       return { colour: [0, 1, 0.6], scale: BIG_SCALE };
 73:     case 3:
 74:       return { colour: [0, 0.6, 1], scale: BIG_SCALE };
 75:     case 4:
 76:       return { colour: [1, 0, 1], scale: NORMAL_SCALE };
 77:     case 5:
