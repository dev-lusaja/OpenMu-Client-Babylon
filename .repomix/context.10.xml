<file path="src/ui/components/slideHelp/index.tsx">
  1: import './style.less';
  2: import { useEffect, useLayoutEffect, useRef } from 'react';
  3: import { observer } from 'mobx-react-lite';
  4: import { runInAction } from 'mobx';
  5: import {
  6:   SlideHelp as SlideStore,
  7:   type SlideLane,
  8:   unpackSlideColor,
  9: } from '../../../common/slideHelp';
 10: import { GameOptions } from '../../../common/gameOptions';
 11: import { MU_FONT_CLASS } from '../muText';
 12: import { useUiStageScale } from '../uiStage';
 13: 
 14: /**
 15:  * `CUISlideHelp::Render`: the marquee band at the top of the screen. The
 16:  * lane state (position, speed, alpha) is simulated in `common/slideHelp.ts`
 17:  * at the original's 25 Hz factors; this component only paints it, measures
 18:  * the text width the simulation needs, and reports mouse hover (which
 19:  * decelerates the scroll).
 20:  *
 21:  * The paint is not a React render: the clock below steps the simulation and
 22:  * writes the per-frame values (position, alpha) straight into the lane's
 23:  * elements through refs. React only renders a lane when its text changes.
 24:  */
 25: 
 26: const TICKS_PER_SECOND = 25;
 27: const MAX_FACTOR = 2;
 28: /** `GetTextExtentPoint32(L"Z")`: Tahoma 11 px is 13 px tall. */
 29: const FONT_HEIGHT = 13;
 30: 
 31: type LaneElements = {
 32:   root: HTMLDivElement | null;
 33:   band: HTMLDivElement | null;
 34:   text: HTMLSpanElement | null;
 35: };
 36: 
 37: /** The elements of each lane, for the painter. */
 38: const laneElements = new Map<SlideLane, LaneElements>();
 39: 
 40: function paint(lane: SlideLane, scale: number): void {
 41:   const els = laneElements.get(lane);
 42:   if (!els?.root) return;
 43: 
 44:   // `visible` is `alphaRate > 0`; read outside a reaction, so untracked.
 45:   const alpha = lane.alphaRate;
 46:   if (alpha <= 0) {
 47:     if (els.root.style.display !== 'none') els.root.style.display = 'none';
 48:     return;
 49:   }
 50:   if (els.root.style.display !== '') els.root.style.display = '';
 51: 
 52:   const bandAlpha = Math.max(0, alpha - 25) / 255;
 53:   const lineAlpha = (alpha > 180 ? alpha : Math.max(0, alpha - 25)) / 255;
 54:   if (els.band) {
 55:     els.band.style.background = `rgba(0,0,0,${bandAlpha.toFixed(3)})`;
 56:     els.band.style.borderBottom = `${Math.max(1, scale)}px solid rgba(0,0,0,${lineAlpha.toFixed(3)})`;
 57:   }
 58: 
 59:   if (els.text) {
 60:     const color = unpackSlideColor(lane.color);
 61:     const textAlpha = Math.min(
 62:       1,
 63:       (color.a / 255) *
 64:         (((alpha > 180 ? alpha : Math.max(0, alpha - 25)) + 50) / 255)
 65:     );
 66:     els.text.style.left = `${lane.position * scale}px`;
 67:     els.text.style.color = `rgba(${color.r},${color.g},${color.b},${textAlpha.toFixed(3)})`;
 68:   }
 69: }
 70: 
 71: function useSlideClock(scale: number): void {
 72:   const scaleRef = useRef(scale);
 73:   scaleRef.current = scale;
 74: 
 75:   useEffect(() => {
 76:     let frame = 0;
 77:     let last = performance.now();
 78: 
 79:     const tick = (now: number) => {
 80:       const dt = Math.max(0, (now - last) / 1000);
 81:       last = now;
 82:       const f = Math.min(MAX_FACTOR, dt * TICKS_PER_SECOND);
 83:       runInAction(() => SlideStore.tick(f, dt, GameOptions.slideHelp));
 84:       paint(SlideStore.notice, scaleRef.current);
 85:       paint(SlideStore.help, scaleRef.current);
 86:       frame = requestAnimationFrame(tick);
 87:     };
 88: 
 89:     frame = requestAnimationFrame(tick);
 90:     return () => cancelAnimationFrame(frame);
 91:   }, []);
 92: }
 93: 
 94: /**
 95:  * One lane: renders when its text / colour / kind change, is painted by the
 96:  * clock otherwise. Reads none of the per-frame fields (`position`,
 97:  * `alphaRate`, `speed`, `visible`) so the simulation's writes do not reach
 98:  * React.
 99:  */
100: const Lane = observer(({ lane, scale }: { lane: SlideLane; scale: number }) => {
101:   const els = useRef<LaneElements>({ root: null, band: null, text: null });
102: 
103:   useEffect(() => {
104:     laneElements.set(lane, els.current);
105:     return () => {
106:       laneElements.delete(lane);
107:     };
108:   }, [lane]);
109: 
110:   const text = lane.text;
111:   const hasText = lane.hasText;
112: 
113:   // The simulation ends a slide once it has scrolled past its own width.
114:   useLayoutEffect(() => {
115:     const el = els.current.text;
116:     if (!el || !hasText) return;
117:     const width = el.getBoundingClientRect().width / scale;
118:     if (width !== lane.textWidth) {
119:       runInAction(() => {
120:         lane.textWidth = width;
121:       });
122:     }
123:     paint(lane, scale);
124:   }, [lane, text, hasText, scale]);
125: 
126:   const color = unpackSlideColor(lane.color);
127:   const bandHeight = (FONT_HEIGHT + 4) * scale;
128: 
129:   return (
130:     <div
131:       ref={el => (els.current.root = el)}
132:       className="slide-help-lane"
133:       style={{ height: bandHeight + 3 * scale, display: 'none' }}
134:       onMouseEnter={() => runInAction(() => (lane.hovered = true))}
135:       onMouseLeave={() => runInAction(() => (lane.hovered = false))}
136:     >
137:       <div
138:         ref={el => (els.current.band = el)}
139:         className="slide-help-band"
140:         style={{ top: 0, height: bandHeight }}
141:       />
142:       {hasText && (
143:         <span
144:           ref={el => (els.current.text = el)}
145:           className={`slide-help-text ${MU_FONT_CLASS[lane.kind === 'notice' ? 'bold' : 'normal']}`}
146:           style={{
147:             top: 2 * scale,
148:             color: `rgba(${color.r},${color.g},${color.b},0)`,
149:             transform: `scale(${scale})`,
150:           }}
151:         >
152:           {text}
153:         </span>
154:       )}
155:     </div>
156:   );
157: });
158: 
159: export const SlideHelpBar = observer(() => {
160:   const scale = useUiStageScale();
161:   useSlideClock(scale);
162: 
163:   return (
164:     <div className="slide-help">
165:       <Lane lane={SlideStore.notice} scale={scale} />
166:       <Lane lane={SlideStore.help} scale={scale} />
167:     </div>
168:   );
169: });
