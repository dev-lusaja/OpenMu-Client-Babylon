 5: 
 6: /** Pieces more than one tab uses. */
 7: 
 8: const HERO_STATE: Record<number, TextKey> = {
 9:   0: 'gm.heroState.new',
10:   1: 'gm.heroState.hero',
11:   2: 'gm.heroState.hero',
12:   3: 'gm.heroState.normal',
13:   4: 'gm.heroState.outlaw',
14:   5: 'gm.heroState.murderer',
15:   6: 'gm.heroState.murderer',
16: };
17: 
18: export function heroStateLabel(state: number): string {
19:   return HERO_STATE[state] ? t(HERO_STATE[state]) : String(state);
20: }
21: 
22: /** "3m", "1h 12m", "2d 4h": how long a socket has been on. */
23: export function sinceText(since: number): string {
24:   const seconds = Math.max(0, Math.floor((Date.now() - since) / 1000));
25:   const minutes = Math.floor(seconds / 60);
26:   const hours = Math.floor(minutes / 60);
27:   const days = Math.floor(hours / 24);
28:   if (days > 0) return `${days}d ${hours % 24}h`;
29:   if (hours > 0) return `${hours}h ${minutes % 60}m`;
30:   if (minutes > 0) return `${minutes}m`;
31:   return `${seconds}s`;
32: }
33: 
34: /** "14:05:33" in the reader's clock. */
35: export function clockText(at: number): string {
36:   return new Date(at).toLocaleTimeString([], {
37:     hour: '2-digit',
38:     minute: '2-digit',
39:     second: '2-digit',
40:     hour12: false,
41:   });
42: }
43: 
44: export function playerMatches(player: TrackedPlayer, query: string): boolean {
45:   const needle = query.trim().toLowerCase();
46:   if (!needle) return true;
47:   return (
48:     (player.character ?? '').toLowerCase().includes(needle) ||
49:     (player.account ?? '').toLowerCase().includes(needle) ||
50:     (player.guild ?? '').toLowerCase().includes(needle)
51:   );
52: }
