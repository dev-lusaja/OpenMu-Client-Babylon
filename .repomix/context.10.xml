100:     spawns.push({
101:       value: MISS,
102:       colour: onSelf ? MISS_SELF_COLOUR : MISS_OTHER_COLOUR,
103:       scale: NORMAL_SCALE,
104:       height: 0,
105:     });
106:   } else {
107:     const look = lookFor(kind, onSelf);
108:     const colour = look.colour;
109:     const scale = isTriple ? BIG_SCALE : look.scale;
110: 
111:     if (isTriple) {
112:       spawns.push({ value: healthDamage, colour: shade(colour, 0.4), scale, height: 0 });
113:       spawns.push({ value: healthDamage, colour: shade(colour, 0.2), scale: scale + 5, height: 10 });
114:       spawns.push({ value: healthDamage, colour, scale: scale + 10, height: 20 });
115:     } else if (isDouble) {
116:       spawns.push({ value: healthDamage, colour: shade(colour, 0.4), scale, height: 0 });
117:       spawns.push({ value: healthDamage, colour: shade(colour, 0.2), scale: scale + 5, height: 10 });
118:     }
119: 
120:     spawns.push({ value: healthDamage, colour, scale, height: 0 });
121:   }
122: 
123:   if (shieldDamage > 0) {
124:     spawns.push({
125:       value: shieldDamage,
126:       colour: SHIELD_COLOUR,
127:       scale: NORMAL_SCALE,
128:       height: 25,
129:     });
130:   }
131: 
132:   return spawns;
