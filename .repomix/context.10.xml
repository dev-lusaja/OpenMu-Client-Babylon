 1: import {
 2:   GameOptions,
 3:   setGameOption,
 4:   type GameOptions as GameOptionsType,
 5: } from '../../../common/gameOptions';
 6: import { LIGHTING_QUALITY_LABEL_KEYS } from '../../../common/lightingQuality';
 7: import type { TextKey } from '../../../i18n';
 8: 
 9: /**
10:  * One click per tier: both quality tiers plus the Image group at the §6
11:  * defaults. Classic ignores the tone mapper and bloom (no image-processing
12:  * pass, no bloom on tier 0), so its row keeps the shared defaults rather
13:  * than zeros that would follow the player up to Enhanced. The Rendering
14:  * checks are left alone: they are the player's own costs, not part of a look,
15:  * and so is the rendering style.
16:  */
17: export type TierPreset = Pick<
18:   GameOptionsType,
19:   | 'lightingQuality'
20:   | 'materialQuality'
21:   | 'materialDetail'
22:   | 'toneMapper'
23:   | 'brightness'
24:   | 'bloom'
25:   | 'glow'
26:   | 'sharpness'
27:   | 'filmGrain'
28:   | 'chromatic'
29:   | 'vignette'
30:   | 'fxaa'
31: >;
32: 
33: const IMAGE_DEFAULTS = {
34:   toneMapper: 1,
35:   brightness: 0,
36:   bloom: 3,
37:   glow: 5,
38:   sharpness: 2,
39:   filmGrain: 0,
40:   chromatic: 0,
41:   vignette: 0,
42:   fxaa: false,
43: } as const;
44: 
45: export const TIER_PRESETS: readonly TierPreset[] = [
46:   { ...IMAGE_DEFAULTS, lightingQuality: 0, materialQuality: 0, materialDetail: 6 },
47:   { ...IMAGE_DEFAULTS, lightingQuality: 1, materialQuality: 1, materialDetail: 6 },
48:   { ...IMAGE_DEFAULTS, lightingQuality: 2, materialQuality: 2, materialDetail: 6 },
49: ];
50: 
51: /** The presets share the tier names. */
52: export const TIER_PRESET_LABEL_KEYS: readonly TextKey[] = LIGHTING_QUALITY_LABEL_KEYS;
53: 
54: const PRESET_KEYS = Object.keys(TIER_PRESETS[0]) as (keyof TierPreset)[];
55: 
56: export function applyTierPreset(preset: TierPreset): void {
57:   for (const key of PRESET_KEYS) setGameOption(key, preset[key]);
58: }
59: 
60: /** Index of the preset every stored value matches, -1 while none does. */
61: export function activeTierPreset(): number {
62:   return TIER_PRESETS.findIndex(preset =>
63:     PRESET_KEYS.every(key => GameOptions[key] === preset[key])
64:   );
65: }
</file>

