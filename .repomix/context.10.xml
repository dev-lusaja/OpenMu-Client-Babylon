213:   const open = Store.isOffline && DebugMenu.open;
214: 
215:   useEventBus('keyPressed', key => {
216:     if (!Store.isOffline) return;
217:     if (key === TOGGLE_KEY) DebugMenu.toggle();
218:   });
219: 
220:   useEffect(() => {
221:     if (!open) return;
222:     const timer = setInterval(() => setTick(t => t + 1), REFRESH_MS);
223:     return () => clearInterval(timer);
224:   }, [open]);
225: 
226:   const chrome = useWindowChrome(WINDOW_ID, {
227:     width: WIN_WIDTH,
228:     height: WIN_HEIGHT,
229:     onClose: () => DebugMenu.close(),
230:   });
