254:         }}
255:       >
256:         <MuSpriteFrame
257:           file="op1_stone.OZJ"
258:           width={WIN_WIDTH - 6}
259:           height={WIN_HEIGHT - 6}
260:           style={{
261:             position: 'absolute',
262:             left: 3,
263:             top: 3,
264:             backgroundRepeat: 'repeat',
265:           }}
266:         />
267:         <MuSpriteFrame
268:           file="op1_back3.OZJ"
269:           width={5}
270:           height={WIN_HEIGHT - TOP_HEIGHT - BOTTOM_HEIGHT}
271:           style={{
272:             position: 'absolute',
273:             left: 0,
274:             top: TOP_HEIGHT,
275:             backgroundRepeat: 'repeat-y',
276:           }}
277:         />
278:         <MuSpriteFrame
279:           file="op1_back4.OZJ"
280:           width={5}
281:           height={WIN_HEIGHT - TOP_HEIGHT - BOTTOM_HEIGHT}
282:           style={{
283:             position: 'absolute',
284:             right: 0,
285:             top: TOP_HEIGHT,
286:             backgroundRepeat: 'repeat-y',
287:           }}
288:         />
289:         {[false, true].map(mirrored => (
290:           <MuSpriteFrame
291:             key={`top-${mirrored}`}
292:             file="op2_back1.OZT"
293:             width={ART_WIDTH}
294:             height={TOP_HEIGHT}
295:             style={{
296:               position: 'absolute',
297:               left: mirrored ? ART_WIDTH : 0,
298:               top: 0,
299:               ...(mirrored && { transform: 'scaleX(-1)' }),
300:             }}
301:           />
302:         ))}
303:         {[false, true].map(mirrored => (
304:           <MuSpriteFrame
305:             key={`bottom-${mirrored}`}
306:             file="op1_back2.OZT"
307:             width={ART_WIDTH}
308:             height={BOTTOM_HEIGHT}
309:             style={{
310:               position: 'absolute',
311:               left: mirrored ? ART_WIDTH : 0,
312:               bottom: 0,
