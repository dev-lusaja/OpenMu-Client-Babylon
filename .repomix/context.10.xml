140: export const DamageNumbers = () => {
141:   const [numbers, setNumbers] = useState<FloatingNumber[]>([]);
142:   const nextId = useRef(0);
143: 
144:   const font = useMuSprite(FONT_FILE);
145: 
146:   useEventBus('objectDamaged', event => {
147:     const onSelf = event.entity.localPlayer === true;
148: 
149:     const spawned = spawnsFor(event, onSelf).map(spawn => ({
150:       ...spawn,
151:       id: nextId.current++,
152:       entity: event.entity,
153:     }));
154: 
155:     // The newest numbers win when the cap is hit (`slice(0, …)` kept the
156:     // oldest and dropped every fresh hit in a crowded fight).
157:     setNumbers(previous =>
158:       [...previous, ...spawned].slice(-MAX_POINTS)
159:     );
160:   });
161: 
162:   // Expiries are batched: a burst of numbers spawned together also ends
163:   // together, and one `setState` per frame beats one per number.
164:   const expired = useRef(new Set<number>());
165:   const flush = useRef(0);
166:   useEffect(() => () => cancelAnimationFrame(flush.current), []);
167:   const remove = useCallback((id: number) => {
168:     expired.current.add(id);
169:     if (flush.current) return;
170:     flush.current = requestAnimationFrame(() => {
171:       flush.current = 0;
172:       const gone = expired.current;
173:       expired.current = new Set();
174:       setNumbers(previous => previous.filter(number => !gone.has(number.id)));
175:     });
176:   }, []);
