 10:  * A screen never restates a command's parameters - it names the command and
 11:  * these read its shape from the catalogue, so the order and the required flags
 12:  * stay the ones checked against the server's argument classes.
 13:  *
 14:  * `overrides` is how a purpose-built screen supplies a value the operator
 15:  * should not have to type: the map number a picker chose, the character a row
 16:  * in Nearby names, your own coordinates. An overridden parameter is not drawn.
 17:  */
 18: 
 19: export type Overrides = Record<string, string>;
 20: 
 21: const Field = observer(
 22:   ({ command, param, bare }: { command: GmCommand; param: GmParam; bare?: boolean }) => {
 23:     const own = GmPanel.valueFor(command, param.name);
 24:     // A blank character field means the shared target, so say whose name is
 25:     // about to be used rather than sending it somewhere the operator has to
 26:     // guess at.
 27:     const standIn =
 28:       param.name === 'characterName' && !own && GmPanel.target ? GmPanel.target : null;
 29: 
 30:     return (
 31:       <label className="gm-field">
 32:         {/* A row that already names the value (the read/write pairs) passes
 33:             `bare`, so the label is not printed twice on one line. */}
 34:         {bare ? null : (
 35:           <span className="gm-field-label">
 36:             {t(param.labelKey)}
 37:             {param.required ? <b className="gm-required">*</b> : null}
 38:             {standIn ? (
 39:               <em className="gm-standin">{t('gm.using', { name: standIn })}</em>
 40:             ) : null}
 41:           </span>
 42:         )}
 43: 
 44:         {param.validValues ? (
 45:           <div className="gm-choice">
 46:             {param.validValues.map(option => (
 47:               <button
 48:                 key={option}
 49:                 type="button"
 50:                 className={`gm-choice-option${own === option ? ' is-active' : ''}`}
 51:                 onClick={uiClick(() =>
 52:                   GmPanel.setValue(command, param.name, own === option ? '' : option)
 53:                 )}
 54:               >
 55:                 {option}
 56:               </button>
 57:             ))}
 58:           </div>
 59:         ) : (
 60:           <input
 61:             className="gm-input"
 62:             type="text"
 63:             // Not type="number": these same fields hold character names and map
 64:             // names, and spinners on a level make no sense. `inputMode` only
 65:             // picks which keyboard a phone offers.
 66:             inputMode={param.type === 'number' ? 'numeric' : 'text'}
 67:             value={own}
 68:             placeholder={standIn ?? (param.hintKey ? t(param.hintKey) : '')}
 69:             spellCheck={false}
 70:             autoComplete="off"
 71:             onChange={e => GmPanel.setValue(command, param.name, e.target.value)}
 72:             onKeyDown={e => {
 73:               // Enter runs it, the way every form works. Stopped from bubbling
 74:               // so the chat box does not also open behind the panel.
 75:               if (e.key !== 'Enter') return;
 76:               e.preventDefault();
 77:               e.stopPropagation();
 78:               GmPanel.run(command);
 79:             }}
 80:           />
 81:         )}
 82:       </label>
 83:     );
 84:   }
 85: );
 86: 
 87: export const CommandFields = observer(
 88:   ({
 89:     command,
 90:     hide,
 91:     bare,
 92:   }: {
 93:     command: GmCommand;
 94:     hide?: readonly string[];
 95:     bare?: boolean;
 96:   }) => (
 97:     <>
 98:       {(command.params ?? [])
 99:         .filter(param => !hide?.includes(param.name))
100:         .map(param => (
101:           <Field key={param.name} command={command} param={param} bare={bare} />
102:         ))}
103:     </>
104:   )
105: );
106: 
107: /** The line as it will be sent, so nothing is a surprise. */
108: export const CommandPreview = observer(
109:   ({ command, overrides }: { command: GmCommand; overrides?: Overrides }) => (
110:     <output className="gm-preview">{GmPanel.preview(command, overrides)}</output>
111:   )
112: );
113: 
114: /**
115:  * Run, or Confirm when the command takes something away. Arming remembers the
116:  * whole line, so changing any field disarms it - a confirm always answers the
117:  * line that is on screen.
118:  */
119: export const RunButton = observer(
120:   ({
121:     command,
122:     overrides,
123:     labelKey,
124:     text,
125:     compact,
126:   }: {
127:     command: GmCommand;
128:     overrides?: Overrides;
129:     labelKey?: TextKey;
130:     /** A name the server owns (a map), which is never translated. */
131:     text?: string;
132:     compact?: boolean;
133:   }) => {
134:     const armed = GmPanel.isArmed(command, overrides);
135: 
136:     return (
137:       <button
138:         type="button"
139:         className={`gm-btn${compact ? ' gm-btn-compact' : ''}${
140:           command.confirm ? ' gm-btn-heavy' : ''
141:         }${armed ? ' is-armed' : ''}`}
142:         title={t(command.helpKey)}
143:         onClick={uiClick(() => GmPanel.run(command, overrides))}
144:       >
145:         {armed ? t('gm.confirm') : (text ?? t(labelKey ?? 'gm.run'))}
146:       </button>
147:     );
148:   }
149: );
150: 
151: /** A whole command as one block: title, help, fields, preview, run. */
152: export const CommandCard = observer(
153:   ({
154:     command,
155:     overrides,
156:     hide,
157:     labelKey,
158:   }: {
159:     command: GmCommand;
160:     overrides?: Overrides;
161:     hide?: readonly string[];
162:     labelKey?: TextKey;
163:   }) => (
164:     <section className="gm-card">
165:       <header className="gm-card-head">
166:         <h4>{t(labelKey ?? command.labelKey)}</h4>
167:         <code>{command.command}</code>
168:       </header>
169:       <p className="gm-help">{t(command.helpKey)}</p>
170:       <CommandFields command={command} hide={hide} />
171:       <CommandPreview command={command} overrides={overrides} />
172:       <div className="gm-card-actions">
173:         <RunButton command={command} overrides={overrides} />
174:       </div>
175:     </section>
176:   )
177: );
178: 
179: /** The one-press commands: no fields, just a labelled button. */
180: export const QuickButton = observer(
181:   ({ command, overrides }: { command: GmCommand; overrides?: Overrides }) => (
182:     <RunButton command={command} overrides={overrides} labelKey={command.labelKey} compact />
183:   )
184: );
</file>

<file path="src/ui/components/guildMarks/index.tsx">
 1: import './style.less';
 2: import { useEffect, useMemo, useRef } from 'react';
 3: import type { With } from 'miniplex';
 4: import { Store } from '../../../store';
 5: import { useRenderId } from '../../../hooks';
 6: import { onScreenPosition } from '../../../libs/screenPositionBus';
 7: import type { Entity } from '../../../ecs/world';
 8: import { guildMarkDataUrl, isEmptyGuildMark } from '../../../common/guildMark';
 9: 
10: type MarkEntity = With<Entity, 'guild' | 'screenPosition'>;
11: 
12: const MARK_PX = 16;
13: /** `RenderGuildMark`: the mark floats a little above the name balloon anchor. */
14: const MARK_OFFSET_Y = 22;
15: 
16: /**
17:  * The guild mark the original draws over every guild member's head
18:  * (`RenderGuildMark` in ZzzInterface.cpp). Positions come from the same
19:  * `entityScreenPositionUpdated` stream the name tags use; the image is the
20:  * 8x8 GuildInformation logo scaled with nearest-neighbour.
21:  */
22: const GuildMark = ({ entity }: { entity: MarkEntity }) => {
23:   const ref = useRef<HTMLImageElement>(null);
24: 
25:   useEffect(() => {
26:     const handler = (screenPosition: { x: number; y: number }) => {
27:       const el = ref.current;
28:       if (!el) return;
29:       const visible =
30:         screenPosition.x * screenPosition.x + screenPosition.y * screenPosition.y >= 0.1;
31:       el.style.transform = visible
32:         ? `translate(${Math.floor(screenPosition.x - MARK_PX / 2)}px, ${Math.floor(
33:             screenPosition.y - MARK_OFFSET_Y - MARK_PX
34:           )}px)`
35:         : 'translate(-10000px, -10000px)';
36:     };
37:     return onScreenPosition(entity, handler);
38:   }, [entity]);
39: 
40:   const guild = Store.guilds.get(entity.guild.id);
41:   if (!guild || !guild.logo.length || isEmptyGuildMark(guild.logo)) return null;
42: 
43:   return (
44:     <img
45:       ref={ref}
46:       className="guild-mark-tag"
47:       width={MARK_PX}
48:       height={MARK_PX}
49:       alt=""
50:       title={guild.name}
51:       src={guildMarkDataUrl(guild.logo)}
52:     />
53:   );
54: };
55: 
56: const entityIds = new WeakMap<object, number>();
57: let nextEntityId = 1;
58: function keyOf(entity: Entity): number {
59:   let id = entityIds.get(entity);
60:   if (id === undefined) {
61:     id = nextEntityId++;
62:     entityIds.set(entity, id);
63:   }
64:   return id;
65: }
66: 
67: export const GuildMarks = () => {
68:   const world = Store.world!;
69:   const { refresh } = useRenderId();
70:   const query = useMemo(() => world.with('guild', 'screenPosition'), [world]);
71: 
72:   useEffect(() => {
73:     const a = query.onEntityAdded.subscribe(refresh);
74:     const b = query.onEntityRemoved.subscribe(refresh);
75:     // GuildInformation can arrive after the member did; re-check every so
76:     // often so a mark that had no logo yet shows up.
77:     const id = window.setInterval(refresh, 2000);
78:     return () => {
79:       a();
80:       b();
81:       window.clearInterval(id);
82:     };
83:   }, [query]);
84: 
85:   return (
86:     <div className="guild-marks">
87:       {query.entities.map(entity => (
88:         <GuildMark key={keyOf(entity)} entity={entity as MarkEntity} />
89:       ))}
90:     </div>
91:   );
92: };
</file>

