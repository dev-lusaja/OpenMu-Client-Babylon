<file path="src/ui/components/loadingScreen/art.tsx">
 1: import './style.less';
 2: import { useEffect, useState, type CSSProperties } from 'react';
 3: import { MuSpriteFrame } from '../muSprite';
 4: 
 5: /**
 6:  * The loading artwork itself - `LSBg01..04`, the four 400×300 quarters of the
 7:  * 800×600 sheet the original draws while a map loads.
 8:  *
 9:  * Split out of the loading screen because two places want the picture and only
10:  * one wants the screen: the loading screen covers everything opaquely, while
11:  * the start menu uses the same art as its own backdrop until the 3D login
12:  * scene behind it is ready.
13:  */
14: 
15: const SHEET_ASPECT = 800 / 600;
16: 
17: const TILE_WIDTH = '50%';
18: const TALL_HEIGHT = `${(512 / 600) * 100}%`;
19: const SHORT_HEIGHT = `${(88 / 600) * 100}%`;
20: 
21: export type ArtSize = { width: number; height: number };
22: 
23: /**
24:  * The sheet sized two ways for the current window: `contain` is the whole
25:  * picture, `cover` fills the window for the blurred copy behind it.
26:  */
27: export function useSheetSizes(): { contain: ArtSize; cover: ArtSize } {
28:   const measure = () => {
29:     const vw = window.innerWidth;
30:     const vh = window.innerHeight;
31:     const wide = vw / vh > SHEET_ASPECT;
32: 
33:     return {
34:       contain: wide
35:         ? { width: vh * SHEET_ASPECT, height: vh }
36:         : { width: vw, height: vw / SHEET_ASPECT },
37:       cover: wide
38:         ? { width: vw, height: vw / SHEET_ASPECT }
39:         : { width: vh * SHEET_ASPECT, height: vh },
40:     };
41:   };
42: 
43:   const [sizes, setSizes] = useState(measure);
44: 
45:   useEffect(() => {
46:     const onResize = () => setSizes(measure());
47: 
48:     window.addEventListener('resize', onResize);
49:     onResize();
50: 
51:     return () => window.removeEventListener('resize', onResize);
52:   }, []);
53: 
54:   return sizes;
55: }
56: 
57: const tile = (left: string, top: string, height: string): CSSProperties => ({
58:   position: 'absolute',
59:   left,
60:   top,
61:   width: TILE_WIDTH,
62:   height,
63:   backgroundSize: '100% 100%',
64: });
65: 
66: export const LoadingArt = ({
67:   size,
68:   className,
69: }: {
70:   size: ArtSize;
71:   className?: string;
72: }) => (
73:   <div className={className} style={size}>
74:     <MuSpriteFrame file="LSBg01.OZJ" style={tile('0', '0', TALL_HEIGHT)} />
75:     <MuSpriteFrame file="LSBg02.OZJ" style={tile('50%', '0', TALL_HEIGHT)} />
76:     <MuSpriteFrame file="LSBg03.OZJ" style={tile('0', TALL_HEIGHT, SHORT_HEIGHT)} />
77:     <MuSpriteFrame
78:       file="LSBg04.OZJ"
79:       style={tile('50%', TALL_HEIGHT, SHORT_HEIGHT)}
80:     />
81:   </div>
82: );
</file>

