  1: import './style.less';
  2: import { observer } from 'mobx-react-lite';
  3: import { memo, useEffect, useMemo, useRef, useState, type CSSProperties } from 'react';
  4: import type { Item } from '../../../ecs/world';
  5: import { ItemsDatabase } from '../../../common/itemsDatabase';
  6: import { Store } from '../../../store';
  7: import { ItemIcon } from '../itemIcon';
  8: import { ItemTooltip, type TooltipContext } from '../itemTooltip';
  9: import { MuSpriteFrame } from '../muSprite';
 10: import { MuTableFrame } from '../muWindow';
 11: import { stableKeyOf } from '../partyBars/stableKey';
 12: 
 13: export const SQUARE = 20;
 14: export const SQUARE_SPRITE = 'newui_item_box.OZT';
 15: export const SQUARE_SPRITE_SIZE = 21;
 16: 
 17: const WND_TOP_EDGE = 3;
 18: const WND_LEFT_EDGE = 4;
 19: const WND_BOTTOM_EDGE = 8;
 20: const WND_RIGHT_EDGE = 9;
 21: const TABLE_CORNER = 14;
 22: 
 23: /** The `newui_item_table*` frame the original draws around every grid. */
 24: export function gridFrame(
 25:   left: number,
 26:   top: number,
 27:   columns: number,
 28:   rows: number
 29: ) {
 30:   return {
 31:     left: left - WND_LEFT_EDGE,
 32:     top: top - WND_TOP_EDGE,
 33:     width: columns * SQUARE - WND_RIGHT_EDGE + WND_LEFT_EDGE + TABLE_CORNER,
 34:     height: rows * SQUARE - WND_BOTTOM_EDGE + WND_TOP_EDGE + TABLE_CORNER,
 35:   };
 36: }
 37: 
 38: export function itemSize(item: Item): { w: number; h: number } {
 39:   const config = ItemsDatabase.getItem(item.group, item.num);
 40:   return { w: config?.X ?? 1, h: config?.Y ?? 1 };
 41: }
 42: 
 43: export type Placed = {
 44:   square: number;
 45:   item: Item;
 46:   column: number;
 47:   row: number;
 48:   w: number;
 49:   h: number;
 50: };
 51: 
 52: /** `m_pdwItemCheckBox`: which square belongs to which item. */
 53: export function buildOccupancy(
 54:   items: (Item | null)[],
 55:   offset: number,
 56:   columns: number,
 57:   rows: number
 58: ) {
 59:   const squares: (Placed | null)[] = new Array(columns * rows).fill(null);
 60:   const placed: Placed[] = [];
 61: 
 62:   for (let square = 0; square < columns * rows; square++) {
 63:     const item = items[offset + square];
 64:     if (!item) continue;
 65: 
 66:     const column = square % columns;
 67:     const row = (square - column) / columns;
 68:     const { w, h } = itemSize(item);
 69: 
 70:     // `square` addresses the grid; `entry.square` is the local array index
 71:     // the callbacks report back.
 72:     const entry: Placed = { square: offset + square, item, column, row, w, h };
 73:     placed.push(entry);
 74: 
 75:     for (let y = 0; y < h; y++) {
 76:       for (let x = 0; x < w; x++) {
 77:         if (column + x >= columns || row + y >= rows) continue;
 78:         squares[square + y * columns + x] = entry;
 79:       }
 80:     }
 81:   }
 82: 
 83:   return { squares, placed };
 84: }
 85: 
 86: /**
 87:  * What the occupancy depends on, as a string: which squares hold which item
 88:  * object (by identity - a fresh object from a refresh must rebuild) at what
 89:  * level. Reading it inside an observer is what subscribes the grid to the
 90:  * items, and it is the memo key for `buildOccupancy`.
 91:  */
 92: export function occupancyStamp(
 93:   items: (Item | null)[],
 94:   offset: number,
 95:   count: number
 96: ): string {
 97:   let stamp = '';
 98:   for (let square = 0; square < count; square++) {
 99:     const item = items[offset + square];
100:     if (!item) continue;
101:     stamp += `${square}:${stableKeyOf(item)}/${item.group}/${item.num}/${item.lvl ?? 0};`;
102:   }
103:   return stamp;
104: }
105: 
106: export function canPlace(
107:   squares: (Placed | null)[],
108:   columns: number,
109:   rows: number,
110:   column: number,
111:   row: number,
112:   w: number,
113:   h: number
114: ): boolean {
115:   if (column < 0 || row < 0) return false;
116:   if (column + w > columns || row + h > rows) return false;
117: 
118:   for (let y = 0; y < h; y++) {
119:     for (let x = 0; x < w; x++) {
120:       if (squares[(row + y) * columns + column + x]) return false;
121:     }
122:   }
123: 
124:   return true;
125: }
126: 
127: // ---- the square sheet -------------------------------------------------------
128: 
129: /** Hoisted per-square `style` objects so `MuSpriteFrame`'s memo holds. */
130: const squareStyles = new Map<number, CSSProperties[]>();
131: 
132: function squareStyle(columns: number, square: number): CSSProperties {
133:   let styles = squareStyles.get(columns);
134:   if (!styles) {
135:     styles = [];
136:     squareStyles.set(columns, styles);
137:   }
138:   let style = styles[square];
139:   if (!style) {
140:     style = {
141:       left: (square % columns) * SQUARE,
142:       top: Math.floor(square / columns) * SQUARE,
143:     };
144:     styles[square] = style;
145:   }
146:   return style;
147: }
148: 
149: /** One `newui_item_box` per square; memoised on the used / hovered masks. */
150: export const GridSquares = memo(function GridSquares({
151:   columns,
152:   rows,
153:   used,
154:   hovered,
155:   squareClass,
156: }: {
157:   columns: number;
158:   rows: number;
159:   /** One char per square, '1' when an item covers it. */
160:   used: string;
161:   /** One char per square, '1' for the squares of the hovered item. */
162:   hovered: string;
163:   squareClass: string;
164: }) {
165:   return (
166:     <>
167:       {Array.from({ length: columns * rows }, (_, square) => (
168:         <MuSpriteFrame
169:           key={square}
170:           file={SQUARE_SPRITE}
171:           width={SQUARE_SPRITE_SIZE}
172:           height={SQUARE_SPRITE_SIZE}
173:           className={`${squareClass}${used[square] === '1' ? ' used' : ''}${
174:             hovered[square] === '1' ? ' hovered' : ''
175:           }`}
176:           style={squareStyle(columns, square)}
177:         />
178:       ))}
179:     </>
180:   );
181: });
