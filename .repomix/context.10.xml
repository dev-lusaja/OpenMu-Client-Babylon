<file path="src/ui/components/partyBars/index.tsx">
  1: import './style.less';
  2: import { observer } from 'mobx-react-lite';
  3: import { useEffect, useMemo, useRef, useState } from 'react';
  4: import type { With } from 'miniplex';
  5: import { Store } from '../../../store';
  6: import { Social } from '../../../social';
  7: import { useRenderId } from '../../../hooks';
  8: import { onScreenPosition } from '../../../libs/screenPositionBus';
  9: import type { Entity } from '../../../ecs/world';
 10: import { stableKeyOf } from './stableKey';
 11: 
 12: type PartyEntity = With<Entity, 'objectNameInWorld' | 'screenPosition'>;
 13: 
 14: /** `RenderPartyHP` (ZzzInterface.cpp:8724): ten 3x2 pips in a 42x5 trough. */
 15: const STEPS = 10;
 16: const STEP_WIDTH = 4;
 17: const PIP_WIDTH = 3;
 18: const PIP_HEIGHT = 2;
 19: const BAR_WIDTH = 38;
 20: const BORDER = 2;
 21: const TOTAL_WIDTH = BAR_WIDTH + BORDER * 2;
 22: const TOTAL_HEIGHT = 5;
 23: /** The bar sits over the head, a little above the balloon anchor. */
 24: const OFFSET_Y = 30;
 25: 
 26: /**
 27:  * The party bar the original draws over every party member in scope
 28:  * (`RenderPartyHP`): a ten-step health bar fed by `PartyHealthUpdate`'s
 29:  * tenths, with the member's name and `HP : N0%` shown while the cursor is on
 30:  * it. The original has no hit box for the name, only for the bar; the
 31:  * hovered readout here is the same rectangle.
 32:  *
 33:  * `p->index <= -1 continue`: only members the client has actually found in
 34:  * scope get a bar, so the hero (index -3) and members on another map are
 35:  * skipped - which is what matching by `objectNameInWorld` does below.
 36:  */
 37: const PartyBar = observer(
 38:   ({ entity, step }: { entity: PartyEntity; step: number }) => {
 39:     const ref = useRef<HTMLDivElement>(null);
 40:     const [hovered, setHovered] = useState(false);
 41:     const hoveredRef = useRef(false);
 42: 
 43:     useEffect(() => {
 44:       const handler = (screenPosition: { x: number; y: number }) => {
 45:         const el = ref.current;
 46:         if (!el) return;
 47:         const visible =
 48:           screenPosition.x * screenPosition.x +
 49:             screenPosition.y * screenPosition.y >=
 50:           0.1;
 51:         el.style.transform = visible
 52:           ? `translate(${Math.floor(screenPosition.x - TOTAL_WIDTH / 2)}px, ${Math.floor(
 53:               screenPosition.y - OFFSET_Y
 54:             )}px)`
 55:           : 'translate(-10000px, -10000px)';
 56: 
 57:         const now = Store.world?.currentPointerTarget === entity;
 58:         if (now !== hoveredRef.current) {
 59:           hoveredRef.current = now;
 60:           setHovered(now);
 61:         }
 62:       };
 63:       return onScreenPosition(entity, handler);
 64:     }, [entity]);
 65: 
 66:     const filled = Math.max(0, Math.min(STEPS, step));
 67: 
 68:     return (
 69:       <div ref={ref} className="party-bar">
 70:         {hovered && (
 71:           <div className="party-bar-label">
 72:             {entity.objectNameInWorld} HP : {filled}0%
 73:           </div>
 74:         )}
 75:         <div
 76:           className="party-bar-back"
 77:           style={{ width: TOTAL_WIDTH, height: TOTAL_HEIGHT }}
 78:         />
 79:         <div
 80:           className="party-bar-rail"
 81:           style={{ left: BORDER, top: BORDER, width: BAR_WIDTH, height: 1 }}
 82:         />
 83:         {Array.from({ length: filled }, (_, k) => (
 84:           <div
 85:             key={k}
 86:             className="party-bar-pip"
 87:             style={{
 88:               left: BORDER + k * STEP_WIDTH,
 89:               top: BORDER,
 90:               width: PIP_WIDTH,
 91:               height: PIP_HEIGHT,
 92:             }}
 93:           />
 94:         ))}
 95:       </div>
 96:     );
 97:   }
 98: );
 99: 
100: export const PartyBars = observer(() => {
101:   const world = Store.world!;
102:   const { refresh } = useRenderId();
103:   const query = useMemo(
104:     () => world.with('objectNameInWorld', 'screenPosition', 'playerAnimation'),
105:     [world]
106:   );
107: 
108:   useEffect(() => {
109:     const a = query.onEntityAdded.subscribe(refresh);
110:     const b = query.onEntityRemoved.subscribe(refresh);
111:     return () => {
112:       a();
113:       b();
114:     };
115:   }, [query]);
116: 
117:   if (!Social.inParty) return null;
118: 
119:   // `Party[j].index`: the party list is matched to the objects in scope by
120:   // name, the hero included (the original skips it, `index == -3`).
121:   const heroName = Store.playerData.name;
122:   const steps = new Map(
123:     Social.partyMembers
124:       .filter(m => m.name !== heroName)
125:       .map(m => [
126:         m.name,
127:         m.healthStep >= 0
128:           ? m.healthStep
129:           : m.maximumHealth > 0
130:             ? Math.round((m.currentHealth / m.maximumHealth) * STEPS)
131:             : STEPS,
132:       ])
133:   );
134: 
135:   return (
136:     <div className="party-bars">
137:       {query.entities
138:         .filter(e => steps.has(e.objectNameInWorld))
139:         .map(entity => (
140:           <PartyBar
141:             key={stableKeyOf(entity)}
142:             entity={entity as PartyEntity}
143:             step={steps.get(entity.objectNameInWorld)!}
144:           />
145:         ))}
146:     </div>
147:   );
148: });
</file>

<file path="src/ui/components/partyBars/stableKey.ts">
 1: /**
 2:  * Stable React keys for objects that carry no id of their own (miniplex
 3:  * entities, notice lines, items): the first time an object is seen it is
 4:  * numbered, and it keeps that number for as long as it lives. Keying a list
 5:  * by index instead re-mounts every node after a head removal and restarts
 6:  * their CSS animations.
 7:  */
 8: const ids = new WeakMap<object, number>();
 9: let next = 1;
10: 
11: export function stableKeyOf(target: object): number {
12:   let id = ids.get(target);
13:   if (id === undefined) {
14:     id = next++;
15:     ids.set(target, id);
16:   }
17:   return id;
18: }
</file>

