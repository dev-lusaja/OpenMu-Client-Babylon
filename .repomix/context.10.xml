112:             <i className="gm-dot gm-dot-player is-gm" /> {t('gm.map.legendGm')}
113:             <i className="gm-dot gm-dot-hero" /> {t('gm.map.you')}
114:             <i className="gm-dot gm-dot-monster" /> {t('gm.map.legendScope')}
115:           </span>
116:         </header>
117: 
118:         <FeedNotice />
119: 
120:         <MapView
121:           map={map}
122:           players={onThisMap}
123:           hero={hero && hero.map === map ? { x: hero.x, y: hero.y } : null}
124:           scope={hero && hero.map === map ? view.nearby.filter(e => e.kind !== 'player') : []}
125:           selectedId={GmPanel.selectedPlayerId}
126:           onPick={pick}
127:           onTile={
128:             hero
129:               ? (x, y) =>
130:                   GmPanel.run(move, {
131:                     target: hero.name,
132:                     mapIdOrName: String(map),
133:                     x: String(x),
134:                     y: String(y),
135:                   })
136:               : undefined
