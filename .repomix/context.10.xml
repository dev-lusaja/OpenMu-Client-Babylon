 62: function lookFor(kind: number, onSelf: boolean): { colour: Rgb; scale: number } {
 63:   switch (kind) {
 64:     case 0:
 65:       return {
 66:         colour: onSelf ? [1, 0, 0] : [1, 0.6, 0],
 67:         scale: NORMAL_SCALE,
