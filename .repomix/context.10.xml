162:   file: string;
163:   alt?: string;
164:   className?: string;
165:   style?: CSSProperties;
166:   scale?: number;
167: };
168: 
169: export const MuSprite = memo(function MuSprite({
170:   file,
171:   alt = '',
172:   className,
173:   style,
174:   scale = 1,
