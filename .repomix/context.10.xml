 89:               className="gm-btn gm-btn-compact"
 90:               onClick={uiClick(() => GmPanel.run(move, { target: hero.name, mapIdOrName: String(map) }))}
 91:             >
 92:               {t('gm.map.goHere')}
 93:             </button>
 94:           ) : null}
 95:           {hero && GmPanel.target && GmPanel.target !== hero.name ? (
 96:             <button
 97:               type="button"
 98:               className="gm-btn gm-btn-compact"
 99:               onClick={uiClick(() =>
100:                 GmPanel.run(move, {
101:                   target: GmPanel.target,
102:                   mapIdOrName: String(map),
103:                   ...(hero.map === map ? { x: String(hero.x), y: String(hero.y) } : {}),
104:                 })
105:               )}
106:             >
107:               {t('gm.map.bringTarget', { name: GmPanel.target })}
108:             </button>
109:           ) : null}
110:           <span className="gm-legend">
