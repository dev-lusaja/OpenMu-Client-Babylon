<file path="src/ui/components/itemTooltip/placement.ts">
  1: import { CURSOR_HOTSPOT, CURSOR_SIZE } from '../gameCursor/cursors';
  2: 
  3: const MARGIN = 2;
  4: /** Breathing room between the cursor art and the box. */
  5: const GAP = 4;
  6: 
  7: // The pointer is drawn by GameCursor, not the OS: a CURSOR_SIZE sprite hanging
  8: // down-right from the hotspot. Anything closer than that is behind the cursor,
  9: // which is what used to swallow the item's name.
 10: export const BELOW_CURSOR = CURSOR_SIZE - CURSOR_HOTSPOT + GAP;
 11: export const ABOVE_CURSOR = CURSOR_HOTSPOT + GAP;
 12: 
 13: export type Viewport = { width: number; height: number };
 14: 
 15: export type Placement = { left: number; top: number };
 16: 
 17: export type BoxSize = { width: number; height: number };
 18: 
 19: /** The cursor sprite's footprint in viewport pixels (gameCursor/index.tsx). */
 20: function cursorBox(x: number, y: number) {
 21:   const left = x - CURSOR_HOTSPOT;
 22:   const top = y - CURSOR_HOTSPOT;
 23:   return { left, top, right: left + CURSOR_SIZE, bottom: top + CURSOR_SIZE };
 24: }
 25: 
 26: /**
 27:  * `RenderItemInfo` placement: centred on the cursor's x, hanging clear below
 28:  * the cursor art, flipped above when it would leave the bottom, kept inside
 29:  * the viewport. Pure arithmetic on a measured size so it can run per pointer
 30:  * move without touching layout.
 31:  */
 32: export function place(
 33:   x: number,
 34:   y: number,
 35:   width: number,
 36:   height: number,
 37:   viewport: Viewport
 38: ): Placement {
 39:   let left = x - width / 2;
 40:   let top = y + BELOW_CURSOR;
 41: 
 42:   if (left + width > viewport.width - MARGIN) {
 43:     left = viewport.width - MARGIN - width;
 44:   }
 45:   if (left < MARGIN) left = MARGIN;
 46: 
 47:   if (top + height > viewport.height - MARGIN) {
 48:     top = y - ABOVE_CURSOR - height;
 49:   }
 50:   if (top < MARGIN) top = MARGIN;
 51: 
 52:   // A box too tall for the room above and below gets clamped back over the
 53:   // cursor: step it aside so the sprite never sits on the text.
 54:   const cursor = cursorBox(x, y);
 55:   if (
 56:     top < cursor.bottom &&
 57:     top + height > cursor.top &&
 58:     left < cursor.right &&
 59:     left + width > cursor.left
 60:   ) {
 61:     left =
 62:       cursor.right + GAP + width <= viewport.width - MARGIN
 63:         ? cursor.right + GAP
 64:         : cursor.left - GAP - width;
 65:     if (left < MARGIN) left = MARGIN;
 66:   }
 67: 
 68:   return { left: Math.round(left), top: Math.round(top) };
 69: }
 70: 
 71: function hidesCursor(
 72:   left: number,
 73:   top: number,
 74:   size: BoxSize,
 75:   cursor: ReturnType<typeof cursorBox>
 76: ): boolean {
 77:   return (
 78:     top < cursor.bottom &&
 79:     top + size.height > cursor.top &&
 80:     left < cursor.right &&
 81:     left + size.width > cursor.left
 82:   );
 83: }
 84: 
 85: /**
 86:  * The hovered box where it always goes, and the worn item's box beside it:
 87:  * to its right, mirrored to its left when the right edge is too close, and
 88:  * clamped inside the viewport either way. Neither box lands on the cursor.
 89:  */
 90: export function placePair(
 91:   x: number,
 92:   y: number,
 93:   primary: BoxSize,
 94:   second: BoxSize | null,
 95:   viewport: Viewport
 96: ): { primary: Placement; second: Placement | null } {
 97:   const first = place(x, y, primary.width, primary.height, viewport);
 98:   if (!second || second.width === 0) return { primary: first, second: null };
 99: 
100:   const rightOf = first.left + primary.width + GAP;
101:   const leftOf = first.left - GAP - second.width;
102:   const fitsRight = rightOf + second.width <= viewport.width - MARGIN;
103:   const fitsLeft = leftOf >= MARGIN;
104: 
105:   let left = fitsRight ? rightOf : fitsLeft ? leftOf : rightOf;
106: 
107:   let top = first.top;
108:   if (top + second.height > viewport.height - MARGIN) {
109:     top = viewport.height - MARGIN - second.height;
110:   }
111:   if (top < MARGIN) top = MARGIN;
112: 
113:   // Only reachable once one of the boxes was clamped: step to the free side.
114:   const cursor = cursorBox(x, y);
115:   if (hidesCursor(left, top, second, cursor)) {
116:     const other = left === rightOf ? leftOf : rightOf;
117:     if (!hidesCursor(other, top, second, cursor)) left = other;
118:   }
119: 
120:   left = Math.max(MARGIN, Math.min(viewport.width - MARGIN - second.width, left));
121: 
122:   return { primary: first, second: { left: Math.round(left), top: Math.round(top) } };
123: }
</file>

