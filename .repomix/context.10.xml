<file path="src/ui/components/debugMenu/modules/info.ts">
 1: import { registerDebugModule, type DebugRow } from '../../../../common/debugMenu';
 2: import { ENUM_WORLD } from '../../../../common/types';
 3: import { Store } from '../../../../store';
 4: 
 5: /**
 6:  * Info: read-only counters off the live scene and engine - the perfOverlay's
 7:  * numbers (Shift+Ctrl+Alt+P) in window form, plus where the hero stands.
 8:  * The rows are closures the window re-reads on its 2 Hz tick; nothing here
 9:  * runs while the menu is closed.
10:  */
11: 
12: function row(label: string, value: () => string): DebugRow {
13:   return { kind: 'info', id: label, label, value };
14: }
15: 
16: /** A value off the scene, '-' while no world is loaded. */
17: function scene(read: (scene: NonNullable<typeof Store.world>['scene']) => string): () => string {
18:   return () => {
19:     const world = Store.world;
20:     return world ? read(world.scene) : '-';
21:   };
22: }
23: 
24: registerDebugModule({
25:   id: 'info',
26:   title: 'Info',
27:   order: 40,
28:   rows: () => [
29:     { kind: 'section', id: 'frame', label: 'Frame' },
30:     row('FPS', scene(s => s.getEngine().getFps().toFixed(0))),
31:     row('Frame time', scene(s => `${s.getEngine().getDeltaTime().toFixed(1)} ms`)),
32:     row(
33:       'Draw calls',
34:       scene(s => {
35:         // `_drawCalls` is internal but always counted; fall back quietly.
36:         const calls = (
37:           s.getEngine() as unknown as { _drawCalls?: { current: number } }
38:         )._drawCalls?.current;
39:         return calls === undefined ? '?' : String(calls);
40:       })
41:     ),
42:     { kind: 'section', id: 'scene', label: 'Scene' },
43:     row(
44:       'Meshes',
45:       scene(s => {
46:         let enabled = 0;
47:         for (const mesh of s.meshes) if (mesh.isEnabled(false)) enabled++;
48:         return `${s.getActiveMeshes().length} act / ${enabled} on / ${s.meshes.length}`;
49:       })
50:     ),
51:     row('Triangles', scene(s => String((s.getActiveIndices() / 3) | 0))),
52:     row('Lights', scene(s => String(s.lights.length))),
53:     row('Particles', scene(s => String(s.particleSystems.length))),
54:     row(
55:       'Materials',
56:       scene(s => `${s.materials.length} / ${s.textures.length} textures`)
57:     ),
58:     { kind: 'section', id: 'world', label: 'World' },
59:     row('Map', () => {
60:       const world = Store.world?.mapIndex;
61:       return world === undefined ? '-' : `${ENUM_WORLD[world]} (${world})`;
62:     }),
63:     row('Hero tile', () => {
64:       const pos = Store.world?.playerEntity?.transform?.pos;
65:       return pos ? `${pos.x.toFixed(1)}, ${pos.z.toFixed(1)}` : '-';
66:     }),
67:   ],
68: });
</file>

<file path="src/ui/components/debugMenu/modules/move.ts">
 1: import { ENUM_WORLD } from '../../../../common/types';
 2: import { registerDebugModule } from '../../../../common/debugMenu';
 3: import { maps } from '../../../../maps';
 4: import { EventBus } from '../../../../libs/eventBus';
 5: import { Store } from '../../../../store';
 6: 
 7: /**
 8:  * Move: one row per map entry the client stages, current map highlighted.
 9:  * A click emits `requestWarp` - the same seam the offline move window uses -
10:  * and rewrites the `?map=` query so a dev-server reload lands on the same
11:  * map (the `playOffline` contract). The menu stays open: map-hopping is the
12:  * use case.
13:  */
14: 
15: /** Menu scenes; warping the world hero into them makes no sense. */
16: const PREGAME_WORLDS: ReadonlySet<ENUM_WORLD> = new Set([
17:   ENUM_WORLD.WD_55LOGINSCENE,
18:   ENUM_WORLD.WD_73NEW_LOGIN_SCENE,
19:   ENUM_WORLD.WD_74NEW_CHARACTER_SCENE,
20: ]);
21: 
22: function warpTo(map: ENUM_WORLD): void {
23:   EventBus.emit('requestWarp', { map });
24: 
25:   const search = new URLSearchParams(location.search);
26:   search.set('map', String(map));
27:   history.replaceState(null, '', '/offline?' + search.toString());
28: }
29: 
30: registerDebugModule({
31:   id: 'move',
32:   title: 'Move',
33:   order: 10,
34:   rows: () => [
35:     {
36:       kind: 'info',
37:       id: 'current',
38:       label: 'Current map',
39:       value: () => {
40:         const world = Store.world?.mapIndex;
41:         return world === undefined ? '-' : `${ENUM_WORLD[world]} (${world})`;
42:       },
43:     },
44:     {
45:       kind: 'list',
46:       id: 'maps',
47:       items: () =>
48:         maps.all.flatMap(layer => {
49:           const target = layer.worlds.find(w => !PREGAME_WORLDS.has(w));
50:           if (target === undefined) return [];
51:           return [
52:             {
53:               id: layer.name,
54:               label: `${layer.name.charAt(0).toUpperCase()}${layer.name.slice(1)} (${target})`,
55:               active: () =>
56:                 Store.world !== null &&
57:                 layer.worlds.includes(Store.world.mapIndex),
58:               onClick: () => warpTo(target),
59:             },
60:           ];
61:         }),
62:     },
63:   ],
64: });
</file>

