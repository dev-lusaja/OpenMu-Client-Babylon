<file path="src/ui/components/debugMenu/modules/lighting.ts">
 1: import {
 2:   registerDebugModule,
 3:   type DebugRow,
 4: } from '../../../../common/debugMenu';
 5: import {
 6:   BRIGHTNESS_MAX,
 7:   BRIGHTNESS_MIN,
 8:   GameOptions,
 9:   TONE_MAPPER_MAX,
10:   setGameOption,
11: } from '../../../../common/gameOptions';
12: import { ENUM_WORLD } from '../../../../common/types';
13: import { lookDirector, type LookState } from '../../../../lighting/director';
14: 
15: /**
16:  * Lighting: the director's `LookState` read live, plus the two image knobs
17:  * a tuner turns while reading it. Both are written through `setGameOption`,
18:  * the exact writes the Options window makes, so this tab adds no writer of
19:  * its own.
20:  */
21: 
22: const TIER_NAMES = ['Classic', 'Enhanced', 'Ultra'];
23: 
24: const TONE_MAPPER_LABELS = ['None', 'Standard', 'ACES', 'Neutral'];
25: 
26: const STYLE_NAMES = ['Classic', 'Cel', 'Anime'];
27: 
28: const signed = (value: number): string =>
29:   value === 0 ? 'off' : value > 0 ? `+${value}` : String(value);
30: 
31: /** A `LookState` field, '-' while no director is live. */
32: const state = (label: string, read: (s: LookState) => string): DebugRow => ({
33:   kind: 'info',
34:   id: `state-${label}`,
35:   label,
36:   value: () => {
37:     const s = lookDirector()?.state();
38:     return s ? read(s) : '-';
39:   },
40: });
41: 
42: const rect = (s: LookState): string =>
43:   s.area
44:     ? `${s.area.name} [${s.area.rect.minX},${s.area.rect.minY} - ${s.area.rect.maxX},${s.area.rect.maxY}]${s.area.volume ? ' vol' : ''}`
45:     : 'none';
46: 
47: const room = (s: LookState): string =>
48:   s.area
49:     ? `key ${s.key.roomShare.toFixed(2)} candles ${s.key.emitterGain.toFixed(2)}`
50:     : '-';
51: 
52: registerDebugModule({
53:   id: 'lighting',
54:   title: 'Light',
55:   order: 30,
56:   rows: () => [
57:     { kind: 'section', id: 'image', label: 'Image' },
58:     {
59:       kind: 'slider',
60:       id: 'toneMapper',
61:       label: 'Tone mapper',
62:       max: TONE_MAPPER_MAX,
63:       get: () => GameOptions.toneMapper,
64:       set: value => setGameOption('toneMapper', value),
65:       display: value => TONE_MAPPER_LABELS[value] ?? String(value),
66:     },
67:     {
68:       kind: 'slider',
69:       id: 'brightness',
70:       label: 'Brightness',
71:       min: BRIGHTNESS_MIN,
72:       max: BRIGHTNESS_MAX,
73:       get: () => GameOptions.brightness,
74:       set: value => setGameOption('brightness', value),
75:       display: signed,
76:     },
77:     { kind: 'section', id: 'state', label: 'Look state' },
78:     state('World', s => `${ENUM_WORLD[s.world]} (${s.world})`),
79:     state('Area', rect),
80:     state('Room', room),
81:     state('Tier', s => `${TIER_NAMES[s.tier]} (${s.tier})`),
82:     state(
83:       'Level',
84:       s =>
85:         `ev ${s.ev.toFixed(2)} gain ${s.keyGain.toFixed(3)} scene ${s.key.sceneGain.toFixed(3)} exposure ${s.exposure.toFixed(3)}`
86:     ),
87:     state('Tone mapper', s => s.toneMapper),
88:     state('Style', s => `${STYLE_NAMES[s.style] ?? s.style} (${s.style})`),
89:     state(
90:       'Shadow',
91:       s =>
92:         `${s.shadow.casters} x${s.shadow.strength.toFixed(2)} soft ${s.shadow.softness}`
93:     ),
94:     state('Passes', s => (s.passes.length ? s.passes.join(' ') : 'none')),
95:   ],
96: });
</file>

