230: const GridFrame = memo(MuTableFrame);
231: 
232: /**
233:  * Screen → grid coordinates for a grid element. The window's CSS scale is
234:  * folded out through the measured width.
235:  */
236: export function gridPointOf(
237:   grid: HTMLElement | null,
238:   columns: number,
239:   clientX: number,
240:   clientY: number
241: ) {
242:   const rect = grid?.getBoundingClientRect();
243:   if (!rect) return null;
244: 
245:   const scale = rect.width / (columns * SQUARE);
246:   if (!scale) return null;
247: 
248:   return {
249:     rect,
250:     x: (clientX - rect.left) / scale,
251:     y: (clientY - rect.top) / scale,
252:   };
253: }
254: 
255: type HoverInfo = { entry: Placed; x: number; y: number; price?: number };
256: type Target = { column: number; row: number };
257: 
258: export type ItemGridProps = {
259:   items: (Item | null)[];
260:   columns: number;
261:   rows: number;
262:   left: number;
263:   top: number;
264:   /**
265:    * Local array index of square 0 (`gridFirstIndex`). The callbacks report
266:    * local indices, so a caller with an offset grid never has to add it back.
267:    */
268:   offset?: number;
269:   className?: string;
270:   /** Greys the grid out and swallows clicks (`LockInventory`). */
271:   disabled?: boolean;
272:   /** Tint under a carried item: blue when it may land here, red when banned. */
273:   dropTint?: 'none' | 'ok' | 'ban';
274:   /** Left click on an occupied square with an empty cursor. */
275:   onPick?: (square: number, item: Item) => void;
276:   /** Left click while carrying something; `square` is the top-left target. */
277:   onPlace?: (square: number) => void;
278:   /** Right click on an occupied square. */
279:   onUse?: (square: number, item: Item) => void;
280:   /** Ctrl + left click on an occupied square (`common/quickItemActions.ts`). */
281:   onQuickAction?: (square: number, item: Item) => void;
282:   tooltipContext?: TooltipContext;
283:   /** Personal-shop asking price shown in the tooltip and under the icon. */
284:   priceOf?: (square: number) => number | undefined;
285:   /** Squares to ring: what changed in a trade after we had accepted. */
286:   marked?: (square: number) => boolean;
287:   /** Items the find box does not match; drawn faded, still clickable. */
288:   dimmed?: (item: Item) => boolean;
289:   frame?: boolean;
290: };
291: 
292: /**
293:  * `CNewUIInventoryCtrl`: the square sheet every item window is built from -
294:  * occupancy from the item sizes, the 20px hit test, the drop preview under a
295:  * carried item and the tooltip. The inventory keeps its own copy because it
296:  * also carries the equipment dolls; vault, trade, chaos machine and the
297:  * personal shop all share this one.
298:  *
299:  * Pointer moves never render: the position lives in a ref, and state only
300:  * changes when the *hovered item* or the *drop target square* changes. The
301:  * tooltip follows the pointer on its own (itemTooltip).
302:  */
303: export const ItemGrid = observer(
304:   ({
305:     items,
306:     columns,
307:     rows,
308:     left,
309:     top,
310:     offset = 0,
311:     className,
312:     disabled = false,
313:     dropTint = 'none',
314:     onPick,
315:     onPlace,
316:     onUse,
317:     onQuickAction,
318:     tooltipContext = 'plain',
319:     priceOf,
320:     marked,
321:     dimmed,
322:     frame = true,
323:   }: ItemGridProps) => {
324:     const gridRef = useRef<HTMLDivElement>(null);
325:     const pointer = useRef<{ x: number; y: number } | null>(null);
326:     const [hover, setHover] = useState<HoverInfo | null>(null);
327:     const [target, setTarget] = useState<Target | null>(null);
328: 
329:     const picked = Store.pickedItem;
330:     const pickedSize = picked ? itemSize(picked.item) : null;
331: 
332:     const count = columns * rows;
333:     const stamp = occupancyStamp(items, offset, count);
334:     const { squares, placed } = useMemo(
335:       () => buildOccupancy(items, offset, columns, rows),
336:       // `stamp` stands in for the item contents.
337:       // eslint-disable-next-line react-hooks/exhaustive-deps
338:       [items, offset, columns, rows, stamp]
339:     );
340: 
341:     // The handlers read the latest occupancy without being recreated.
342:     const latest = useRef({ squares, pickedSize });
343:     latest.current = { squares, pickedSize };
344: 
345:     const squareAt = (clientX: number, clientY: number) => {
346:       const point = gridPointOf(gridRef.current, columns, clientX, clientY);
347:       if (!point) return -1;
348: 
349:       const column = Math.floor(point.x / SQUARE);
350:       const row = Math.floor(point.y / SQUARE);
351: 
352:       if (column < 0 || column >= columns || row < 0 || row >= rows) return -1;
353:       return row * columns + column;
354:     };
355: 
356:     /** `GetTargetLinealPos`: the item is centred on the cursor. */
357:     const targetFor = (clientX: number, clientY: number): Target | null => {
358:       const size = latest.current.pickedSize;
359:       if (!size) return null;
360: 
361:       const point = gridPointOf(gridRef.current, columns, clientX, clientY);
362:       if (!point) return null;
363: 
364:       const { rect } = point;
365:       if (
366:         clientX < rect.left ||
367:         clientX >= rect.right ||
368:         clientY < rect.top ||
369:         clientY >= rect.bottom
370:       ) {
371:         return null;
372:       }
373: 
374:       const x = point.x - ((size.w - 1) * SQUARE) / 2;
375:       const y = point.y - ((size.h - 1) * SQUARE) / 2;
376: 
377:       return { column: Math.floor(x / SQUARE), row: Math.floor(y / SQUARE) };
378:     };
379: 
380:     const updateTarget = (clientX: number, clientY: number) => {
381:       const next = targetFor(clientX, clientY);
382:       setTarget(current =>
383:         current === next ||
384:         (current && next && current.column === next.column && current.row === next.row)
385:           ? current
386:           : next
387:       );
388:     };
389: 
390:     // The carried item is dragged across this grid from anywhere on the page.
391:     useEffect(() => {
392:       if (!picked) {
393:         setTarget(null);
394:         return;
395:       }
396:       const onMove = (event: PointerEvent) => {
397:         pointer.current = { x: event.clientX, y: event.clientY };
398:         updateTarget(event.clientX, event.clientY);
399:       };
400:       if (pointer.current) updateTarget(pointer.current.x, pointer.current.y);
401:       window.addEventListener('pointermove', onMove, { passive: true });
402:       return () => window.removeEventListener('pointermove', onMove);
403:       // eslint-disable-next-line react-hooks/exhaustive-deps
404:     }, [!!picked, columns, rows]);
405: 
406:     const targetOk =
407:       !!target &&
408:       !!pickedSize &&
409:       dropTint !== 'ban' &&
410:       canPlace(
411:         squares,
412:         columns,
413:         rows,
414:         target.column,
415:         target.row,
416:         pickedSize.w,
417:         pickedSize.h
418:       );
419: 
420:     const onPointerDown = (event: React.PointerEvent) => {
421:       if (event.button !== 0 || disabled) return;
422:       const { squares, pickedSize } = latest.current;
423: 
424:       if (picked && pickedSize) {
425:         const at = targetFor(event.clientX, event.clientY);
426:         if (!at) return;
427:         if (
428:           !canPlace(
429:             squares,
430:             columns,
431:             rows,
432:             at.column,
433:             at.row,
434:             pickedSize.w,
435:             pickedSize.h
436:           )
437:         ) {
438:           return;
439:         }
440:         onPlace?.(offset + at.row * columns + at.column);
441:         return;
442:       }
443: 
444:       const square = squareAt(event.clientX, event.clientY);
445:       if (square < 0) return;
446: 
447:       const entry = squares[square];
448:       if (!entry) return;
449: 
450:       if (event.ctrlKey) {
451:         onQuickAction?.(entry.square, entry.item);
452:         return;
453:       }
454: 
455:       onPick?.(entry.square, entry.item);
456:     };
457: 
458:     const onContextMenu = (event: React.MouseEvent) => {
459:       event.preventDefault();
460:       if (disabled) return;
461: 
462:       if (picked) {
463:         Store.cancelPickedItem();
464:         return;
465:       }
466: 
467:       const square = squareAt(event.clientX, event.clientY);
468:       if (square < 0) return;
469: 
470:       const entry = latest.current.squares[square];
471:       if (!entry) return;
472: 
473:       onUse?.(entry.square, entry.item);
474:     };
475: 
476:     const onPointerMove = (event: React.PointerEvent) => {
477:       pointer.current = { x: event.clientX, y: event.clientY };
478:       const square = squareAt(event.clientX, event.clientY);
479:       const entry = square >= 0 ? latest.current.squares[square] : null;
480:       setHover(current => {
481:         if (!entry) return current === null ? current : null;
482:         if (current && current.entry === entry) return current;
483:         return {
484:           entry,
485:           x: event.clientX,
486:           y: event.clientY,
487:           price: priceOf?.(entry.square),
488:         };
489:       });
490:     };
491: 
492:     const onPointerLeave = () => {
493:       pointer.current = null;
494:       setHover(null);
495:       if (!picked) setTarget(null);
496:     };
497: 
498:     // The hovered entry may have been rebuilt by a refresh: re-resolve by square.
499:     const hoveredEntry =
500:       hover && squares[hover.entry.square - offset] === hover.entry
501:         ? hover.entry
502:         : hover
503:           ? squares[hover.entry.square - offset] ?? null
504:           : null;
505: 
506:     const classes = [
507:       'mu-item-grid',
508:       className ?? '',
509:       disabled ? 'busy' : '',
510:       picked && dropTint === 'ok' ? 'drop-ok' : '',
511:       picked && dropTint === 'ban' ? 'drop-ban' : '',
512:     ]
513:       .filter(Boolean)
514:       .join(' ');
515: 
516:     const box = gridFrame(left, top, columns, rows);
517:     const used = useMemo(() => usedMask(squares), [squares]);
518:     const hoveredSquares = useMemo(
519:       () => hoveredMask(squares, picked ? null : hoveredEntry),
520:       [squares, hoveredEntry, picked]
521:     );
522: 
523:     return (
524:       <>
525:         {frame && (
526:           <GridFrame
527:             left={box.left}
528:             top={box.top}
529:             width={box.width}
530:             height={box.height}
531:           />
532:         )}
533: 
534:         <div
535:           ref={gridRef}
536:           className={classes}
537:           data-no-drag="true"
538:           style={{ left, top, width: columns * SQUARE, height: rows * SQUARE }}
539:           onPointerDown={onPointerDown}
540:           onContextMenu={onContextMenu}
541:           onPointerMove={onPointerMove}
542:           onPointerLeave={onPointerLeave}
543:         >
544:           <GridSquares
545:             columns={columns}
546:             rows={rows}
547:             used={used}
548:             hovered={hoveredSquares}
549:             squareClass="mu-grid-square"
550:           />
551: 
552:           {placed.map(entry => (
553:             <GridItem
554:               key={entry.square}
555:               entry={entry}
556:               price={priceOf?.(entry.square)}
557:               marked={marked?.(entry.square) ?? false}
558:               dimmed={dimmed?.(entry.item) ?? false}
559:             />
560:           ))}
561: 
562:           {!!target && !!pickedSize && (
563:             <div
564:               className={`mu-grid-drop-target${targetOk ? '' : ' warning'}`}
565:               style={{
566:                 left: target.column * SQUARE,
567:                 top: target.row * SQUARE,
568:                 width: pickedSize.w * SQUARE,
569:                 height: pickedSize.h * SQUARE,
570:               }}
571:             />
572:           )}
573:         </div>
574: 
575:         {!picked && !!hover && !!hoveredEntry && (
576:           <ItemTooltip
577:             item={hoveredEntry.item}
578:             x={hover.x}
579:             y={hover.y}
580:             context={tooltipContext}
581:             price={hover.price}
582:             slot={hoveredEntry.square}
583:           />
584:         )}
585:       </>
586:     );
587:   }
588: );
</file>

