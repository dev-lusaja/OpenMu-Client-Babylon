  2: import { useEffect, useRef, useState } from 'react';
  3: import { observer } from 'mobx-react-lite';
  4: import { Store } from '../../../store';
  5: import { MuSpriteFrame } from '../muSprite';
  6: import { MuButton } from '../muButton';
  7: import { TEXT_COLOR } from '../../pages/serversPage/layout';
  8: import { MSG_WIN_MESSAGES, MsgWinCode, MsgWinType } from '../../../common/msgWin';
  9: import {
 10:   BACK_SPRITE,
 11:   BTN_BOTH_CANCEL_X,
 12:   BTN_BOTH_OK_X,
 13:   BTN_HEIGHT,
 14:   BTN_INPUT_CANCEL_X,
 15:   BTN_INPUT_OK_X,
 16:   BTN_SINGLE_X,
 17:   BTN_WIDTH,
 18:   BTN_Y,
 19:   CANCEL_SPRITE,
 20:   INPUT_HEIGHT,
 21:   INPUT_SPRITE,
 22:   INPUT_TEXT_INSET_X,
 23:   INPUT_TEXT_INSET_Y,
 24:   INPUT_WIDTH,
 25:   INPUT_X,
 26:   INPUT_Y,
 27:   OK_SPRITE,
 28:   SECURITY_CODE_MAX_LENGTH,
 29:   TEXT_INSET_X,
 30:   TEXT_LINE_HEIGHT,
 31:   TEXT_LINES,
 32:   TEXT_TOP,
 33:   TEXT_TOP_NO_BUTTONS,
 34:   WIN_HEIGHT,
 35:   WIN_WIDTH,
 36: } from './layout';
 37: 
 38: export const MsgWindow = observer(() => {
 39:   const state = Store.msgWin;
 40:   const code = state?.code;
 41:   const type = code === undefined ? null : MSG_WIN_MESSAGES[code].type;
 42: 
 43:   const [securityCode, setSecurityCode] = useState('');
 44: 
 45:   useEffect(() => {
 46:     if (code !== MsgWinCode.DeleteCharacterResident) setSecurityCode('');
 47:   }, [code]);
 48: 
 49:   const onOk = () => {
 50:     if (!code) return;
 51: 
 52:     // Boxes raised with a Yes handler (the valuable-item confirmations) carry
 53:     // it here; the rest answer by their code.
 54:     const confirmed = Store.takeMsgWinOk();
 55: 
 56:     Store.closeMsgWin();
 57: 
 58:     switch (code) {
 59:       case MsgWinCode.DeleteCharacterConfirm:
 60:         Store.popUpMsgWin(MsgWinCode.DeleteCharacterResident);
 61:         break;
 62: 
 63:       case MsgWinCode.DeleteCharacterResident: {
 64:         const name = Store.focusedChar;
 65:         if (!name) break;
 66: 
 67:         Store.deleteCharacterRequest(name, securityCode);
 68: 
 69:         Store.popUpMsgWin(MsgWinCode.Wait);
 70:         break;
 71:       }
 72: 
 73:       default:
 74:         confirmed?.();
 75:         break;
 76:     }
 77:   };
 78: 
 79:   const onCancel = () => Store.closeMsgWin();
 80: 
 81:   // The handlers close over `securityCode`; the ref keeps the one listener
 82:   // (registered once per window type) calling the current pair.
 83:   const actions = useRef({ onOk, onCancel });
 84:   useEffect(() => {
 85:     actions.current = { onOk, onCancel };
 86:   });
 87: 
 88:   useEffect(() => {
 89:     if (type === null) return;
 90: 
 91:     const handler = (e: KeyboardEvent) => {
 92:       if (e.isComposing || e.keyCode === 229) return;
 93:       const { onOk, onCancel } = actions.current;
 94:       if (e.key === 'Enter') {
 95:         if (type > MsgWinType.Cancel) onOk();
 96:         else if (type === MsgWinType.Cancel) onCancel();
 97:       } else if (e.key === 'Escape') {
 98:         if (type === MsgWinType.Ok) onOk();
 99:         else if (type > MsgWinType.None) onCancel();
100:       } else {
101:         return;
102:       }
103: 
104:       e.preventDefault();
105:     };
106: 
107:     window.addEventListener('keydown', handler);
108: 
109:     return () => window.removeEventListener('keydown', handler);
110:   }, [type]);
111: 
112:   if (!state || type === null) return null;
113: 
114:   const showOk = type === MsgWinType.Ok || type >= MsgWinType.Both;
115:   const showCancel = type === MsgWinType.Cancel || type >= MsgWinType.Both;
116: 
117:   let okX = BTN_SINGLE_X;
118:   let cancelX = BTN_SINGLE_X;
119: 
120:   if (type === MsgWinType.Both) {
121:     okX = BTN_BOTH_OK_X;
122:     cancelX = BTN_BOTH_CANCEL_X;
123:   } else if (type === MsgWinType.StrInput) {
124:     okX = BTN_INPUT_OK_X;
125:     cancelX = BTN_INPUT_CANCEL_X;
126:   }
127: 
128:   return (
129:     <div className="msg-window-layer">
130:       {}
131:       <MuSpriteFrame
132:         file={BACK_SPRITE}
133:         width={WIN_WIDTH}
134:         height={WIN_HEIGHT}
135:         className="msg-window"
136:       >
137:         <div
138:           className="msg-window-text"
139:           style={{
140:             left: TEXT_INSET_X,
141:             right: TEXT_INSET_X,
142:             top: type === MsgWinType.None ? TEXT_TOP_NO_BUTTONS : TEXT_TOP,
143:             height: TEXT_LINE_HEIGHT * TEXT_LINES,
144:             lineHeight: `${TEXT_LINE_HEIGHT}px`,
145:           }}
146:         >
147:           {state.text}
148:         </div>
149: 
150:         {type === MsgWinType.StrInput && (
151:           <MuSpriteFrame
152:             file={INPUT_SPRITE}
153:             width={INPUT_WIDTH}
154:             height={INPUT_HEIGHT}
155:             style={{ position: 'absolute', left: INPUT_X, top: INPUT_Y }}
156:           >
157:             {}
158:             <input
159:               className="msg-window-input"
160:               type="password"
161:               autoFocus
162:               value={securityCode}
163:               onChange={e => setSecurityCode(e.target.value)}
164:               maxLength={SECURITY_CODE_MAX_LENGTH}
165:               style={{
166:                 paddingLeft: INPUT_TEXT_INSET_X,
167:                 paddingTop: INPUT_TEXT_INSET_Y,
168:               }}
169:             />
170:           </MuSpriteFrame>
171:         )}
172: 
173:         {showOk && (
174:           <MuButton
175:             file={OK_SPRITE}
176:             width={BTN_WIDTH}
177:             height={BTN_HEIGHT}
178:             frames={{ up: 0, active: 1, down: 2 }}
179:             color={TEXT_COLOR.brightGray}
180:             activeColor={TEXT_COLOR.white}
181:             onClick={onOk}
182:             style={{ position: 'absolute', left: okX, top: BTN_Y }}
183:           />
184:         )}
185:         {showCancel && (
186:           <MuButton
187:             file={CANCEL_SPRITE}
188:             width={BTN_WIDTH}
189:             height={BTN_HEIGHT}
190:             frames={{ up: 0, active: 1, down: 2 }}
191:             color={TEXT_COLOR.brightGray}
192:             activeColor={TEXT_COLOR.white}
193:             onClick={onCancel}
194:             style={{ position: 'absolute', left: cancelX, top: BTN_Y }}
195:           />
196:         )}
197:       </MuSpriteFrame>
198:     </div>
199:   );
200: });
