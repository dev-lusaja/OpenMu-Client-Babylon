<file path="src/ui/components/muSprite/index.tsx">
  1: import React, { memo, useEffect, useState, type CSSProperties } from 'react';
  2: import {
  3:   loadInterfaceSprite,
  4:   loadMuSprite,
  5:   peekInterfaceSprite,
  6:   peekMuSprite,
  7:   type MuSprite as Sprite,
  8: } from '../../../libs/mu/sprites';
  9: 
 10: // A `Data/`-rooted name (`Data/Logo/MU-logo.OZT`) is loaded from Data as-is; anything
 11: // else (bare or with a subfolder, `partCharge1/newui_menu03.OZJ`) is an Interface sprite.
 12: const DATA_PREFIX = 'Data/';
 13: 
 14: function peek(fileName: string): Sprite | null {
 15:   return fileName.startsWith(DATA_PREFIX)
 16:     ? peekMuSprite(fileName.slice(DATA_PREFIX.length))
 17:     : peekInterfaceSprite(fileName);
 18: }
 19: 
 20: function load(fileName: string): Promise<Sprite> {
 21:   return fileName.startsWith(DATA_PREFIX)
 22:     ? loadMuSprite(fileName.slice(DATA_PREFIX.length))
 23:     : loadInterfaceSprite(fileName);
 24: }
 25: 
 26: /** Joins a candidate list into one dependency-stable key. */
 27: const SEP = '|';
 28: 
 29: /** The first candidate already decoded, or null. */
 30: function peekAny(names: readonly string[]): Sprite | null {
 31:   for (const name of names) {
 32:     const cached = peek(name);
 33:     if (cached) return cached;
 34:   }
 35:   return null;
 36: }
 37: 
 38: /**
 39:  * The decoded sprite for `fileName`. A sprite the preloader already holds is
 40:  * returned synchronously on the first render (no empty paint, no state
 41:  * update), so the 100-odd squares of a grid mount without a hundred effects
 42:  * firing `setState`.
 43:  *
 44:  * Several names are tried in order and the first that decodes wins, which is
 45:  * how a picture that a language pack may or may not ship is asked for: the
 46:  * pack's own art, then English. Same rule as `localDataCandidates` uses for
 47:  * the tables, per file rather than per language.
 48:  */
 49: export function useMuSprite(
 50:   fileName: string | readonly string[] | undefined
 51: ): Sprite | null {
 52:   // Joined, so an inline array literal does not restart the load on every
 53:   // render the way its identity would. No asset name holds a `|`.
 54:   const key = typeof fileName === 'string' ? fileName : (fileName?.join(SEP) ?? '');
 55: 
 56:   const [sprite, setSprite] = useState<Sprite | null>(() =>
 57:     key ? peekAny(key.split(SEP)) : null
 58:   );
 59: 
 60:   useEffect(() => {
 61:     if (!key) {
 62:       setSprite(null);
 63:       return;
 64:     }
 65: 
 66:     const names = key.split(SEP);
 67:     const cached = peekAny(names);
 68:     if (cached) {
 69:       setSprite(current => (current === cached ? current : cached));
 70:       return;
 71:     }
 72: 
 73:     let cancelled = false;
 74: 
 75:     void (async () => {
 76:       for (const [at, name] of names.entries()) {
 77:         try {
 78:           const loaded = await load(name);
 79:           if (!cancelled) setSprite(loaded);
 80:           return;
 81:         } catch (err) {
 82:           // Only the last one failing is news: the ones before it missing is
 83:           // the fallback doing its job.
 84:           if (at === names.length - 1) {
 85:             console.error(`Could not load sprite ${name}:`, err);
 86:           }
 87:         }
 88:       }
 89:     })();
 90: 
 91:     return () => {
 92:       cancelled = true;
 93:     };
 94:   }, [key]);
 95: 
 96:   return sprite;
 97: }
 98: 
 99: type MuSpriteFrameProps = {
100:   file: string;
101:   x?: number;
102:   y?: number;
103:   width?: number;
104:   height?: number;
105:   className?: string;
106:   style?: CSSProperties;
107:   title?: string;
108:   onClick?: () => void;
109:   /**
110:    * Marks the frame as something the window drag must not start on. The drag
111:    * takes a pointer capture on the window root (`useWindowChrome`), which
112:    * retargets the rest of the pointer sequence away from whatever was pressed
113:    * - so an interactive frame without this never sees its own click.
114:    */
115:   noDrag?: boolean;
116:   children?: React.ReactNode;
117: };
118: 
119: /**
120:  * A crop of a sprite sheet as a `div` background. Memoised: a grid draws
121:  * 60–120 of these and only the hovered one changes between renders, so
122:  * callers should hoist their `style` objects where they can (a fresh object
123:  * literal defeats the memo for that frame).
124:  */
125: export const MuSpriteFrame = memo(function MuSpriteFrame({
126:   file,
127:   x = 0,
128:   y = 0,
129:   width,
130:   height,
131:   className,
132:   style,
133:   title,
134:   onClick,
135:   noDrag,
136:   children,
137: }: MuSpriteFrameProps) {
138:   const sprite = useMuSprite(file);
139: 
140:   return (
141:     <div
142:       className={className}
143:       title={title}
144:       onClick={onClick}
145:       data-no-drag={noDrag ? 'true' : undefined}
146:       style={{
147:         ...(width !== undefined && { width }),
148:         ...(height !== undefined && { height }),
149:         backgroundImage: sprite ? `url(${sprite.url})` : undefined,
150:         backgroundPosition: `-${x}px -${y}px`,
151:         backgroundRepeat: 'no-repeat',
152:         imageRendering: 'pixelated',
153:         ...style,
154:       }}
155:     >
156:       {children}
157:     </div>
158:   );
159: });
