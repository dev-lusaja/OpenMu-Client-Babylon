29:  * tree loads lazily - the load is kicked off here so a master skill sitting
30:  * on a bar slot draws without the tree window ever being opened, and the
31:  * component is an observer so it repaints when the tables land.
32:  */
33: export const SkillIcon = observer(
34:   ({ number, disabled = false }: { number: number; disabled?: boolean }) => {
35:     const master = number >= MASTER_SKILL_FIRST;
36:     const loaded = masterTreeDataLoaded();
37: 
38:     useEffect(() => {
39:       if (master && !loaded) void skills.loadMasterTree().catch(() => {});
40:     }, [master, loaded]);
41: 
42:     const name = skillDefinition(number)?.name ?? `#${number}`;
43: 
44:     if (master) {
45:       if (!loaded) return null;
46:       const { x, y } = masterSkillIconCell(number);
47:       return (
48:         <MuSpriteFrame
49:           file={MASTER_SHEET[disabled ? 1 : 0]}
50:           x={x}
51:           y={y}
52:           width={MASTER_ICON_WIDTH}
53:           height={MASTER_ICON_HEIGHT}
54:           title={name}
55:         />
56:       );
57:     }
58: 
59:     const cell = skillIconCell(number, disabled);
60: 
61:     if (!cell) {
62:       return (
63:         <div
64:           className="skill-icon-text"
65:           title={name}
66:           style={{ width: SKILL_ICON_WIDTH, height: SKILL_ICON_HEIGHT }}
67:         >
68:           {name.slice(0, 3)}
69:         </div>
70:       );
71:     }
72: 
73:     return (
74:       <MuSpriteFrame
75:         file={cell.file}
76:         x={cell.x}
77:         y={cell.y}
78:         width={SKILL_ICON_WIDTH}
79:         height={SKILL_ICON_HEIGHT}
80:         title={name}
81:       />
