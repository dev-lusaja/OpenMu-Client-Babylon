  1: import './style.less';
  2: import { useEffect, useMemo, useRef } from 'react';
  3: import type { With } from 'miniplex';
  4: import { Store } from '../../../store';
  5: import { useRenderId } from '../../../hooks';
  6: import { onScreenPosition } from '../../../libs/screenPositionBus';
  7: import {
  8:   BUBBLE_FADE_SECONDS,
  9:   emojiBubbleById,
 10: } from '../../../common/emojiBubbles';
 11: import type { Entity } from '../../../ecs/world';
 12: 
 13: type BubbleEntity = With<Entity, 'emojiBubble' | 'screenPosition'>;
 14: 
 15: const OFF_SCREEN = 'translate(-10000px, -10000px)';
 16: 
 17: /**
 18:  * A character's emoji bubble (`common/emojiBubbles.ts`).
 19:  *
 20:  * Both placements ride their own projected world anchor - over the head, or
 21:  * on the shoulder `EmojiBubbleSystem` picks as the one facing the camera.
 22:  * Position and fade are driven straight from the
 23:  * per-frame screen-position callback - no React re-render per frame, only a
 24:  * transform write, the same way the name tags and guild marks work.
 25:  */
 26: const EmojiBubble = ({ entity }: { entity: BubbleEntity }) => {
 27:   const ref = useRef<HTMLDivElement>(null);
 28: 
 29:   const bubble = entity.emojiBubble;
 30:   const def = emojiBubbleById(bubble.id);
 31:   const isSide = def.placement === 'side';
 32: 
 33:   useEffect(() => {
 34:     const element = ref.current;
 35:     if (element) element.style.transform = OFF_SCREEN;
 36: 
 37:     return onScreenPosition(entity, () => {
 38:       const el = ref.current;
 39:       if (!el) return;
 40: 
 41:       const current = entity.emojiBubble;
 42:       if (!current) return;
 43: 
 44:       // Both placements ride their own projected world anchor, so the bubble
 45:       // keeps its distance from the body as the camera zooms.
 46:       if (!current.onScreen) {
 47:         el.style.transform = OFF_SCREEN;
 48:         return;
 49:       }
 50: 
 51:       el.style.transform = `translate(${Math.round(
 52:         current.screenX
 53:       )}px, ${Math.round(current.screenY)}px)`;
 54: 
 55:       // Fade over the tail of the lifetime; the pop-in is a CSS animation.
 56:       el.style.opacity =
 57:         current.life < BUBBLE_FADE_SECONDS
 58:           ? Math.max(0, current.life / BUBBLE_FADE_SECONDS).toFixed(2)
 59:           : '1';
 60:     });
 61:   }, [entity, isSide]);
 62: 
 63:   return (
 64:     <div ref={ref} className={`emoji-bubble ${isSide ? 'side' : 'head'}`}>
 65:       <span className="glyph">{def.glyph}</span>
 66:     </div>
 67:   );
 68: };
 69: 
 70: const entityIds = new WeakMap<object, number>();
 71: let nextEntityId = 1;
 72: 
 73: function keyOf(entity: Entity): number {
 74:   let id = entityIds.get(entity);
 75:   if (id === undefined) {
 76:     id = nextEntityId++;
 77:     entityIds.set(entity, id);
 78:   }
 79:   return id;
 80: }
 81: 
 82: export const EmojiBubbles = () => {
 83:   const world = Store.world!;
 84:   const { refresh } = useRenderId();
 85: 
 86:   const query = useMemo(
 87:     () => world.with('emojiBubble', 'screenPosition'),
 88:     [world]
 89:   );
 90: 
 91:   useEffect(() => {
 92:     const added = query.onEntityAdded.subscribe(refresh);
 93:     const removed = query.onEntityRemoved.subscribe(refresh);
 94:     return () => {
 95:       added();
 96:       removed();
 97:     };
 98:   }, [query]);
 99: 
100:   return (
101:     <div className="emoji-bubbles">
102:       {query.entities.map(entity => (
103:         // The serial in the key remounts on a re-trigger, which is what
104:         // replays the pop-in animation and swaps the glyph.
105:         <EmojiBubble
106:           key={`${keyOf(entity)}_${entity.emojiBubble.serial}`}
107:           entity={entity as BubbleEntity}
108:         />
109:       ))}
110:     </div>
111:   );
112: };
</file>

<file path="src/ui/components/emojiBubbles/style.less">
 1: .emoji-bubbles {
 2:   position: absolute;
 3:   inset: 0;
 4:   pointer-events: none;
 5:   overflow: hidden;
 6: }
 7: 
 8: .emoji-bubble {
 9:   position: absolute;
10:   left: 0;
11:   top: 0;
12:   pointer-events: none;
13:   // The JS-driven transform places the anchor; the glyph inside owns every
14:   // animated transform, so the two never fight over the property.
15:   transform: translate(-10000px, -10000px);
16:   will-change: transform, opacity;
17: 
18:   .glyph {
19:     display: block;
20:     font-size: 26px;
21:     line-height: 1;
22:     // Colour emoji fonts first, then the platform fallbacks.
23:     font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji',
24:       sans-serif;
25:     filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.75));
26:   }
27: 
28:   // Two animations per glyph: the pop-in plays once, then the idle loop takes
29:   // over. During the pop the loop is still in its delay with no fill, so the
30:   // pop's `both` value is what applies; after it, the loop wins as the later
31:   // animation on the same property.
32:   &.head .glyph {
33:     animation:
34:       emoji-pop-head 240ms cubic-bezier(0.2, 1.6, 0.4, 1) both,
35:       emoji-float 1.5s 240ms ease-in-out infinite;
36:   }
37: 
38:   &.side .glyph {
39:     font-size: 22px;
40:     animation:
41:       emoji-pop-side 200ms cubic-bezier(0.2, 1.7, 0.4, 1) both,
42:       emoji-throb 0.75s 200ms ease-in-out infinite;
43:   }
44: }
45: 
46: @keyframes emoji-pop-head {
47:   0% {
48:     transform: translate(-50%, -20%) scale(0.35);
49:   }
50:   70% {
51:     transform: translate(-50%, -58%) scale(1.15);
52:   }
53:   100% {
54:     transform: translate(-50%, -50%) scale(1);
55:   }
56: }
57: 
58: @keyframes emoji-pop-side {
59:   0% {
60:     transform: translate(-50%, -50%) scale(0.3) rotate(-18deg);
61:   }
62:   60% {
63:     transform: translate(-50%, -50%) scale(1.2) rotate(8deg);
64:   }
65:   100% {
66:     transform: translate(-50%, -50%) scale(1) rotate(0deg);
67:   }
68: }
69: 
70: // Head bubbles bob gently, the way a status icon hovers over a character.
71: @keyframes emoji-float {
72:   0% {
73:     transform: translate(-50%, -50%) scale(1);
74:   }
75:   50% {
76:     transform: translate(-50%, -66%) scale(1.06);
77:   }
78:   100% {
79:     transform: translate(-50%, -50%) scale(1);
80:   }
81: }
82: 
83: // The anger mark pulses and twitches instead - it reads as an impact, not a
84: // floating icon.
85: @keyframes emoji-throb {
86:   0% {
87:     transform: translate(-50%, -50%) scale(1) rotate(-5deg);
88:   }
89:   35% {
90:     transform: translate(-50%, -50%) scale(1.22) rotate(6deg);
91:   }
92:   70% {
93:     transform: translate(-50%, -50%) scale(1.02) rotate(-3deg);
94:   }
95:   100% {
96:     transform: translate(-50%, -50%) scale(1) rotate(-5deg);
97:   }
98: }
