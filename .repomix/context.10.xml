  1: import { makeAutoObservable, runInAction } from 'mobx';
  2: import { LocalStorage } from '../../../libs/localStorage';
  3: import { getUiViewport, onUiViewportChanged } from '../uiStage';
  4: import { GameOptions, uiScaleFactor } from '../../../common/gameOptions';
  5: 
  6: const STORAGE_KEY = 'mu-windows';
  7: 
  8: export type WindowPlacement = {
  9:   x: number | null;
 10:   y: number | null;
 11:   scale: number;
 12: };
 13: 
 14: export const DEFAULT_SCALE = 1.5;
 15: export const MIN_SCALE = 1;
 16: export const MAX_SCALE = 3;
 17: 
 18: const DEFAULT_SCALES: Record<string, number> = {
 19:   'bottom-bar': 1,
 20:   // Laid out at 760x500 rather than the item window's 190x429, so it opens at
 21:   // its own size instead of the 1.5x every small window wants.
 22:   marketplace: 1,
 23: };
 24: 
 25: export const defaultScaleOf = (id: string): number =>
 26:   DEFAULT_SCALES[id] ?? DEFAULT_SCALE;
 27: 
 28: /** At least this many screen pixels of a window stay reachable on every side. */
 29: export const EDGE_MARGIN = 32;
 30: 
 31: /** Screen pixels kept free around a window when fitting its scale to the viewport. */
 32: export const FIT_MARGIN = 12;
 33: 
 34: /**
 35:  * z-index of the bottom window. Every stacked window sits at base + its
 36:  * position in `order`, so the windows always lie in `[WINDOW_Z_BASE,
 37:  * WINDOW_Z_SHEETS)`. Full-screen sheets (minimap, emote menu, master tree)
 38:  * sit at `WINDOW_Z_SHEETS`, modal prompts at `WINDOW_Z_MODAL`, and the
 39:  * overlays that must never be covered (picked item, tooltips, cursor) at
 40:  * 1000 and up in their own `.less`.
 41:  */
 42: export const WINDOW_Z_BASE = 100;
 43: export const WINDOW_Z_SHEETS = 500;
 44: export const WINDOW_Z_MODAL = 600;
 45: 
 46: /**
 47:  * What Escape does to a window: close it and return nothing (or `true`), or
 48:  * return `false` to say "nothing to close here, try the window below".
 49:  */
 50: export type WindowCloser = () => boolean | void;
 51: 
 52: type WindowSize = { width: number; height: number };
 53: 
 54: export const MuWindows = new (class _MuWindows {
 55:   private placements: Record<string, WindowPlacement> = {};
 56:   /** Open windows, bottom to top. */
 57:   order: string[] = [];
 58:   private closers = new Map<string, WindowCloser>();
 59:   private sizes = new Map<string, WindowSize>();
 60:   /** Observable mirror of the stage size, so scales re-fit on resize. */
 61:   private viewport = getUiViewport();
 62: 
 63:   constructor() {
 64:     makeAutoObservable(this, {
 65:       order: true,
 66:     });
 67:     this.load();
 68:     onUiViewportChanged(() => {
 69:       runInAction(() => {
 70:         this.viewport = { ...getUiViewport() };
 71:       });
 72:       this.clampAll();
 73:     });
 74:   }
 75: 
 76:   placement(id: string): WindowPlacement {
 77:     return (
 78:       this.placements[id] ?? { x: null, y: null, scale: defaultScaleOf(id) }
 79:     );
 80:   }
 81: 
 82:   /**
 83:    * The largest scale at which the whole window still fits on screen (with
 84:    * `FIT_MARGIN` left on each side). Unknown sizes fit anything.
 85:    */
 86:   fitScaleOf(id: string): number {
 87:     const size = this.sizes.get(id);
 88:     if (!size) return MAX_SCALE;
 89:     const { width, height } = this.viewport;
 90:     const fit = Math.min(
 91:       (width - FIT_MARGIN * 2) / size.width,
 92:       (height - FIT_MARGIN * 2) / size.height
 93:     );
 94:     return Math.min(MAX_SCALE, Math.max(fit, 0.25));
 95:   }
 96: 
 97:   /**
 98:    * The scale the window is drawn at: the saved scale times the interface
 99:    * scale from the options, capped so the whole window still fits.
100:    */
101:   scaleOf(id: string): number {
102:     const wanted = this.placement(id).scale * uiScaleFactor(GameOptions.uiScale);
103:     return Math.min(wanted, this.fitScaleOf(id));
104:   }
105: 
106:   /** Every window back to its default corner and size. */
107:   resetAll(): void {
108:     runInAction(() => {
109:       this.placements = {};
110:     });
111:     this.save();
112:   }
113: 
114:   // ---- the stack ----------------------------------------------------------
115: 
116:   /** A window came on screen: it joins the stack on top. */
117:   register(id: string, size?: WindowSize, onClose?: WindowCloser): void {
118:     if (size) this.sizes.set(id, size);
119:     if (onClose) this.closers.set(id, onClose);
120:     else this.closers.delete(id);
121:     runInAction(() => {
122:       if (!this.order.includes(id)) this.order = [...this.order, id];
123:     });
124:     this.clamp(id);
125:   }
126: 
127:   unregister(id: string): void {
128:     this.closers.delete(id);
129:     this.sizes.delete(id);
130:     runInAction(() => {
131:       if (this.order.includes(id)) this.order = this.order.filter(w => w !== id);
132:     });
133:   }
134: 
135:   /** Brings `id` to the top; a click on any window does this. */
136:   raise(id: string): void {
137:     const at = this.order.indexOf(id);
138:     if (at < 0 || at === this.order.length - 1) return;
139:     runInAction(() => {
140:       this.order = [...this.order.filter(w => w !== id), id];
141:     });
142:   }
143: 
144:   get topId(): string | null {
145:     return this.order.length ? this.order[this.order.length - 1] : null;
146:   }
147: 
148:   isTop(id: string): boolean {
149:     return this.topId === id;
150:   }
151: 
152:   zIndexOf(id: string): number {
153:     const at = this.order.indexOf(id);
154:     return WINDOW_Z_BASE + (at < 0 ? 0 : at + 1);
155:   }
156: 
157:   /**
158:    * Escape: closes the topmost window that has something to close. Returns
159:    * false when the stack is empty or its top has no closer of its own, so
160:    * the caller can fall back to broadcasting the key.
161:    */
162:   closeTop(): boolean {
163:     for (let i = this.order.length - 1; i >= 0; i--) {
164:       const closer = this.closers.get(this.order[i]);
165:       if (!closer) return false;
166:       if (closer() !== false) return true;
167:     }
168:     return false;
169:   }
170: 
171:   // ---- placement ----------------------------------------------------------
172: 
173:   moveTo(id: string, x: number, y: number): void {
174:     const current = this.placement(id);
175: 
176:     runInAction(() => {
177:       this.placements[id] = { ...current, ...this.clamped(id, x, y) };
178:     });
179: 
180:     this.save();
181:   }
182: 
183:   setScale(id: string, scale: number): void {
184:     const current = this.placement(id);
185:     // A viewport smaller than MIN_SCALE * size wins: fitting beats the floor.
186:     const max = Math.min(MAX_SCALE, this.fitScaleOf(id));
187:     const min = Math.min(MIN_SCALE, max);
188: 
189:     runInAction(() => {
190:       this.placements[id] = {
191:         ...current,
192:         scale: Math.max(min, Math.min(max, scale)),
193:       };
194:     });
195: 
196:     // Growing a window near the right/bottom edge must not push it out.
197:     this.clamp(id);
198:     this.save();
199:   }
200: 
201:   reset(id: string): void {
202:     runInAction(() => {
203:       this.placements[id] = { x: null, y: null, scale: defaultScaleOf(id) };
204:     });
205: 
206:     this.save();
207:   }
208: 
209:   /**
210:    * Keeps the whole window inside the viewport when its size is known (the
211:    * fit-capped scale guarantees it can fit); otherwise keeps the top-left
212:    * `EDGE_MARGIN` reachable. Restored placements from a bigger monitor and
213:    * windows left near an edge before a resize both land back in reach.
214:    */
215:   private clamped(id: string, x: number, y: number): { x: number; y: number } {
216:     const { width, height } = this.viewport;
217:     const size = this.sizes.get(id);
218:     if (!size) {
219:       return {
220:         x: Math.min(Math.max(x, 0), width - EDGE_MARGIN),
221:         y: Math.min(Math.max(y, 0), height - EDGE_MARGIN),
222:       };
223:     }
224:     const scale = this.scaleOf(id);
225:     return {
226:       x: Math.min(Math.max(x, 0), Math.max(0, width - size.width * scale)),
227:       y: Math.min(Math.max(y, 0), Math.max(0, height - size.height * scale)),
228:     };
229:   }
230: 
231:   private clamp(id: string): void {
232:     const current = this.placements[id];
233:     if (!current || current.x === null || current.y === null) return;
234:     const next = this.clamped(id, current.x, current.y);
235:     if (next.x === current.x && next.y === current.y) return;
236:     runInAction(() => {
237:       this.placements[id] = { ...current, ...next };
238:     });
239:   }
240: 
241:   private clampAll(): void {
242:     for (const id of Object.keys(this.placements)) this.clamp(id);
243:   }
244: 
245:   private load(): void {
246:     try {
247:       const raw = LocalStorage.load(STORAGE_KEY);
248:       if (!raw) return;
249: 
250:       const parsed = JSON.parse(raw) as Record<string, WindowPlacement>;
251: 
252:       runInAction(() => {
253:         for (const [id, placement] of Object.entries(parsed)) {
254:           const scale = Math.max(
255:             MIN_SCALE,
256:             Math.min(MAX_SCALE, Number(placement?.scale) || defaultScaleOf(id))
257:           );
258:           const free =
259:             typeof placement?.x === 'number' && typeof placement?.y === 'number';
260:           this.placements[id] = {
261:             ...(free
262:               ? this.clamped(id, placement.x!, placement.y!)
263:               : { x: null, y: null }),
264:             scale,
265:           };
266:         }
267:       });
268:     } catch (err) {
269:       console.error('Could not read the saved window placements:', err);
270:     }
271:   }
272: 
273:   private save(): void {
274:     LocalStorage.save(STORAGE_KEY, JSON.stringify(this.placements));
275:   }
276: })();
</file>

