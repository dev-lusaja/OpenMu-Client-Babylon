310:                   {t('gm.targetIs', { name: GmPanel.target })}
311:                   <button
312:                     type="button"
313:                     className="gm-chip-x"
314:                     aria-label={t('gm.clear')}
315:                     onClick={uiClick(() => GmPanel.setTarget(''))}
316:                   >
317:                     ×
318:                   </button>
319:                 </>
320:               ) : (
321:                 t('gm.noTarget')
322:               )}
323:             </span>
324: 
325:             <button
