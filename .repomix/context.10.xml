<file path="src/ui/components/gmPanel/mapView.tsx">
  1: import { useEffect, useState } from 'react';
  2: import { observer } from 'mobx-react-lite';
  3: import { t } from '../../../i18n';
  4: import type { TrackedPlayer } from '../../../common/adminProtocol';
  5: import type { ENUM_WORLD } from '../../../common/types';
  6: import { loadWorldMinimap, type WorldMinimap } from '../../../libs/mu/minimap';
  7: import type { Nearby } from '../../../gmWorld';
  8: 
  9: /**
 10:  * One world's minimap picture with every tracked player on it.
 11:  *
 12:  * The picture is the world's `mini_map.ozt`, drawn flat (the original spins
 13:  * it 45 degrees about the hero; this is an instrument, not scenery). Its
 14:  * horizontal axis runs along tile Y and its vertical axis along tile X, the
 15:  * way the sheet places its markers (`minimap/sheet.tsx`), so a dot for tile
 16:  * (x, y) sits at left = y / 256, top = x / 256.
 17:  *
 18:  * Dots are ordinary elements with a transition, so a walking player slides
 19:  * between the tracker's updates instead of jumping.
 20:  */
 21: 
 22: const TERRAIN_SIZE = 256;
 23: 
 24: export type MapViewProps = {
 25:   map: number;
 26:   players: readonly TrackedPlayer[];
 27:   /** The game master's own tile on this map, if standing on it. */
 28:   hero: { x: number; y: number } | null;
 29:   /** What the client itself has in scope on this map. */
 30:   scope: readonly Nearby[];
 31:   selectedId: string | null;
 32:   onPick: (player: TrackedPlayer) => void;
 33:   onTile?: (x: number, y: number) => void;
 34: };
 35: 
 36: function percent(tile: number): string {
 37:   return `${(Math.min(TERRAIN_SIZE, Math.max(0, tile)) / TERRAIN_SIZE) * 100}%`;
 38: }
 39: 
 40: export const MapView = observer(function MapView({
 41:   map,
 42:   players,
 43:   hero,
 44:   scope,
 45:   selectedId,
 46:   onPick,
 47:   onTile,
 48: }: MapViewProps) {
 49:   const [picture, setPicture] = useState<WorldMinimap | null | undefined>(undefined);
 50: 
 51:   useEffect(() => {
 52:     let alive = true;
 53:     setPicture(undefined);
 54:     loadWorldMinimap(map as ENUM_WORLD)
 55:       .then(loaded => {
 56:         if (alive) setPicture(loaded);
 57:       })
 58:       .catch(() => {
 59:         if (alive) setPicture(null);
 60:       });
 61:     return () => {
 62:       alive = false;
 63:     };
 64:   }, [map]);
 65: 
 66:   return (
 67:     <div
 68:       className={`gm-map${picture ? '' : ' is-blank'}`}
 69:       style={picture ? { backgroundImage: `url(${picture.image.url})` } : undefined}
 70:       onClick={event => {
 71:         if (!onTile) return;
 72:         const box = event.currentTarget.getBoundingClientRect();
 73:         const y = Math.floor(((event.clientX - box.left) / box.width) * TERRAIN_SIZE);
 74:         const x = Math.floor(((event.clientY - box.top) / box.height) * TERRAIN_SIZE);
 75:         onTile(Math.max(0, Math.min(255, x)), Math.max(0, Math.min(255, y)));
 76:       }}
 77:     >
 78:       {picture === null ? <span className="gm-map-note">{t('gm.map.noPicture')}</span> : null}
 79: 
 80:       {scope.map(entry => (
 81:         <span
 82:           key={`s${entry.netId}`}
 83:           className={`gm-map-scope gm-map-scope-${entry.kind}`}
 84:           style={{ left: percent(entry.y), top: percent(entry.x) }}
 85:           title={`${entry.name} (${entry.x}, ${entry.y})`}
 86:         />
 87:       ))}
 88: 
 89:       {players.map(player => (
 90:         <button
 91:           key={player.id}
 92:           type="button"
 93:           className={`gm-map-dot${player.gm ? ' is-gm' : ''}${player.id === selectedId ? ' is-selected' : ''}`}
 94:           style={{ left: percent(player.y), top: percent(player.x) }}
 95:           title={`${player.character ?? player.account ?? player.id} (${player.x}, ${player.y})`}
 96:           onClick={event => {
 97:             event.stopPropagation();
 98:             onPick(player);
 99:           }}
100:         >
101:           <span className="gm-map-label">{player.character ?? player.account}</span>
102:         </button>
103:       ))}
104: 
105:       {hero ? (
106:         <span
107:           className="gm-map-hero"
108:           style={{ left: percent(hero.y), top: percent(hero.x) }}
109:           title={`${t('gm.map.you')} (${hero.x}, ${hero.y})`}
110:         />
111:       ) : null}
112:     </div>
113:   );
114: });
</file>

