 3: import { useLayoutEffect, useRef } from 'react';
 4: import { Store } from '../../../store';
 5: import { ItemsDatabase } from '../../../common/itemsDatabase';
 6: import { ItemIcon } from '../itemIcon';
 7: import { MuWindows } from '../muWindow/windowState';
 8: import { SQUARE } from '../itemGrid';
 9: 
10: /**
11:  * The last place the pointer was pressed or moved. Tracked at all times so
12:  * the picked item can appear under the cursor on the very click that lifted
13:  * it - on touch there is no `pointermove` before the tap, and waiting for
14:  * one left the item invisible until the finger moved.
15:  */
16: const lastPointer = { x: -10000, y: -10000 };
17: 
18: if (typeof window !== 'undefined') {
19:   const track = (event: PointerEvent) => {
20:     lastPointer.x = event.clientX;
21:     lastPointer.y = event.clientY;
22:   };
23:   window.addEventListener('pointerdown', track, { capture: true, passive: true });
24:   window.addEventListener('pointermove', track, { capture: true, passive: true });
25: }
26: 
27: /**
28:  * `CNewUIPickedItem`: the item hanging off the cursor. It belongs to no
29:  * window in the original either - it survives the inventory being hidden and
30:  * follows the mouse over the vault, the trade tray and the world.
31:  *
32:  * Renders once per pick: the position is written straight to the element's
33:  * `transform` on every pointer move (no state, no React render per event).
34:  */
35: export const PickedItemCursor = observer(() => {
36:   const picked = Store.pickedItem;
37:   const ref = useRef<HTMLDivElement>(null);
38:   const item = picked?.item ?? null;
39: 
40:   const config = item ? ItemsDatabase.getItem(item.group, item.num) : null;
41:   const w = config?.X ?? 1;
42:   const h = config?.Y ?? 1;
43: 
44:   // The icon is drawn at the scale of the window it came out of.
45:   const square = SQUARE * MuWindows.scaleOf('inventory');
46:   const width = w * square;
47:   const height = h * square;
48: 
49:   useLayoutEffect(() => {
50:     const el = ref.current;
51:     if (!el || !item) return;
52: 
53:     const moveTo = (x: number, y: number) => {
54:       el.style.transform = `translate(${x - width / 2}px, ${y - height / 2}px)`;
55:     };
56: 
57:     moveTo(lastPointer.x, lastPointer.y);
58: 
59:     let frame = 0;
60:     let next: { x: number; y: number } | null = null;
61:     const onMove = (event: PointerEvent) => {
62:       next = { x: event.clientX, y: event.clientY };
63:       if (frame) return;
64:       frame = requestAnimationFrame(() => {
65:         frame = 0;
66:         if (next) moveTo(next.x, next.y);
67:       });
68:     };
69: 
70:     window.addEventListener('pointermove', onMove, { passive: true });
71:     return () => {
72:       window.removeEventListener('pointermove', onMove);
73:       if (frame) cancelAnimationFrame(frame);
74:     };
75:   }, [item, width, height]);
76: 
77:   if (!item) return null;
78: 
79:   return (
80:     <div
81:       ref={ref}
82:       className="mu-picked-item"
83:       style={{ left: 0, top: 0, width, height }}
84:     >
85:       <ItemIcon item={item} />
86:     </div>
87:   );
88: });
</file>

