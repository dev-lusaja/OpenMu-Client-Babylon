 932: /** Tall enough, and flush, to reach the bottom of the header art. */
 933: const TAB_HEIGHT = 32;
 934: const TAB_GAP = 0;
 935: /** The categories share the 426 px window, whatever there are of them. */
 936: const TAB_WIDTH = Math.floor(
 937:   (WIN_WIDTH - (TABS.length - 1) * TAB_GAP) / TABS.length
 938: );
 939: 
 940: function rowHeight(row: Row): number {
 941:   switch (row.kind) {
 942:     case 'check':
 943:       return CHECK_ROW_H;
 944:     case 'key':
 945:       return KEY_ROW_H;
 946:     case 'button':
 947:     case 'exit':
 948:       return BUTTON_ROW_H;
 949:     case 'language':
 950:       return LANGUAGE_ROW_H;
 951:     case 'presets':
 952:       return PRESET_ROW_H;
 953:     default:
 954:       return SLIDER_ROW_H;
 955:   }
 956: }
 957: 
 958: function columnHeight(sections: Section[]): number {
 959:   return sections.reduce(
 960:     (total, section) =>
 961:       total +
 962:       SECTION_HEADER_H +
 963:       section.rows.reduce((h, row) => h + rowHeight(row), 0) +
 964:       SECTION_GAP,
 965:     0
 966:   );
 967: }
 968: 
 969: const CONTENT_HEIGHT = Math.max(
 970:   ...allScreens(TABS).flatMap(sub => sub.columns.map(columnHeight))
 971: );
 972: 
 973: const WIN_HEIGHT =
 974:   Math.ceil(
 975:     (TAB_TOP + TAB_HEIGHT + 6 + 20 + 10 + CONTENT_HEIGHT + 20) / SIDE_TILE_HEIGHT
 976:   ) *
 977:     SIDE_TILE_HEIGHT +
 978:   BOTTOM_HEIGHT;
 979: 
 980: const CLOSE_Y = WIN_HEIGHT - 47;
 981: 
 982: /** The subtab strip sits directly under the tabs; the rows start under it. */
 983: const SUBTAB_TOP = TAB_TOP + TAB_HEIGHT + 6;
 984: const SUBTAB_HEIGHT = 20;
 985: const SUBTAB_GAP = 4;
 986: 
 987: const TAB_CONTENT_TOP = SUBTAB_TOP + SUBTAB_HEIGHT + 10;
 988: /** Where a tab's rows have to stop: the Close button owns the rest. */
 989: const TAB_CONTENT_BOTTOM = CLOSE_Y - 12;
 990: 
 991: const HOT_KEY = 'options';
 992: 
 993: export const OptionsWindow = observer(() => {
 994:   const [activeTab, setActiveTab] = useState(TABS[0].id);
 995:   const [activeSub, setActiveSub] = useState(TABS[0].subtabs[0].id);
 996: 
 997:   // Key being rebound: the next key press goes to it instead of the game.
 998:   const [capturing, setCapturing] = useState<KeyAction | null>(null);
 999: 
1000:   // The way out waiting to be confirmed. The original's system menu is its
1001:   // own confirmation - a click here is one row away from the sliders, so it
1002:   // asks.
1003:   const [confirming, setConfirming] = useState<ExitKind | null>(null);
1004: 
1005:   useEffect(() => {
1006:     setCapturingKey(capturing !== null);
1007:     if (capturing === null) return;
1008: 
1009:     const onKeyDown = (e: KeyboardEvent) => {
1010:       e.preventDefault();
1011:       e.stopImmediatePropagation();
1012:       if (e.code !== 'Escape' && !isReservedKey(e.code)) {
1013:         setKeyBinding(capturing, e.code);
1014:       }
1015:       setCapturing(null);
1016:     };
1017: 
1018:     document.addEventListener('keydown', onKeyDown, true);
1019:     return () => {
1020:       document.removeEventListener('keydown', onKeyDown, true);
1021:       setCapturingKey(false);
1022:     };
1023:   }, [capturing]);
1024: 
1025:   useEventBus('keyPressed', key => {
1026:     if (isKey(HOT_KEY, key)) {
1027:       Store.optionsEnabled = !Store.optionsEnabled;
1028:     }
1029:   });
1030: 
1031:   // A stack member: Escape reaches it through the window stack (`onClose`).
1032:   const chrome = useWindowChrome(WINDOW_ID, {
1033:     width: WIN_WIDTH,
1034:     height: WIN_HEIGHT,
1035:     onClose: () => {
1036:       Store.optionsEnabled = false;
1037:     },
1038:   });
1039: 
1040:   useEffect(() => {
1041:     if (Store.optionsEnabled) return;
1042:     setCapturing(null);
1043:     setConfirming(null);
1044:     // Every open starts on the first tab: Escape is meant to reach the ways
1045:     // out in one press, not wherever the sliders were left.
1046:     setActiveTab(TABS[0].id);
1047:     setActiveSub(TABS[0].subtabs[0].id);
1048:   }, [Store.optionsEnabled]);
1049: 
1050:   if (!Store.optionsEnabled) return null;
1051: 
1052:   const tab = TABS.find(t => t.id === activeTab) ?? TABS[0];
1053:   const sub = tab.subtabs.find(s => s.id === activeSub) ?? tab.subtabs[0];
1054: 
1055:   /** A category and the screen it opens on, together: they change as one. */
1056:   const openTab = (next: Tab) => {
1057:     setActiveTab(next.id);
1058:     setActiveSub(next.subtabs[0].id);
1059:   };
1060: 
1061:   const set = <K extends keyof GameOptionsType>(
1062:     key: K,
1063:     value: GameOptionsType[K]
1064:   ) => {
1065:     setGameOption(key, value);
1066: 
1067:     if (key === 'shadows') {
1068:       // Each ModelObject re-applies its own slots next frame; `shadowSlotActive`
1069:       // already reads GameOptions.shadows.
1070:       invalidateShadowState();
1071:     }
1072: 
1073:     if (key === 'propBatching') {
1074:       // Which path a record takes is decided when it is created.
1075:       void reloadMapObjects();
1076:     }
1077:   };
1078: 
1079:   const close = () => {
1080:     Store.optionsEnabled = false;
1081:   };
1082: 
1083:   return (
1084:     <div className="options-window-page">
1085:       <div
1086:         ref={chrome.ref as React.Ref<HTMLDivElement>}
1087:         className="options-window"
1088:         style={{
1089:           ...chrome.style,
1090:           position: chrome.anchored ? 'relative' : 'absolute',
1091:           transformOrigin: chrome.anchored ? 'center' : '0 0',
1092:         }}
1093:       >
1094:         {}
1095:         <MuSpriteFrame
1096:           file="op1_stone.OZJ"
1097:           width={WIN_WIDTH - 6}
1098:           height={WIN_HEIGHT - 6}
1099:           style={{
1100:             position: 'absolute',
1101:             left: 3,
1102:             top: 3,
1103:             backgroundRepeat: 'repeat',
1104:           }}
1105:         />
1106:         <MuSpriteFrame
1107:           file="op1_back3.OZJ"
1108:           width={5}
1109:           height={WIN_HEIGHT - TOP_HEIGHT - BOTTOM_HEIGHT}
1110:           style={{
1111:             position: 'absolute',
1112:             left: 0,
1113:             top: TOP_HEIGHT,
1114:             backgroundRepeat: 'repeat-y',
1115:           }}
1116:         />
1117:         <MuSpriteFrame
1118:           file="op1_back4.OZJ"
1119:           width={5}
1120:           height={WIN_HEIGHT - TOP_HEIGHT - BOTTOM_HEIGHT}
1121:           style={{
1122:             position: 'absolute',
1123:             right: 0,
1124:             top: TOP_HEIGHT,
1125:             backgroundRepeat: 'repeat-y',
1126:           }}
1127:         />
1128:         {}
1129:         {[false, true].map(mirrored => (
1130:           <MuSpriteFrame
1131:             key={`top-${mirrored}`}
1132:             file="op2_back1.OZT"
1133:             width={ART_WIDTH}
1134:             height={TOP_HEIGHT}
1135:             style={{
1136:               position: 'absolute',
1137:               left: mirrored ? ART_WIDTH : 0,
1138:               top: 0,
1139:               ...(mirrored && { transform: 'scaleX(-1)' }),
1140:             }}
1141:           />
1142:         ))}
1143:         {[false, true].map(mirrored => (
1144:           <MuSpriteFrame
1145:             key={`bottom-${mirrored}`}
1146:             file="op1_back2.OZT"
1147:             width={ART_WIDTH}
1148:             height={BOTTOM_HEIGHT}
1149:             style={{
1150:               position: 'absolute',
1151:               left: mirrored ? ART_WIDTH : 0,
1152:               bottom: 0,
1153:               ...(mirrored && { transform: 'scaleX(-1)' }),
1154:             }}
1155:           />
1156:         ))}
1157: 
1158:         {}
1159:         <div
1160:           className="options-title"
1161:           style={{ top: 10, cursor: 'move' }}
1162:           onPointerDown={chrome.onPointerDown}
1163:         >
1164:           {t('options.title')}
1165:         </div>
1166: 
1167:         {}
1168:         {TABS.map((tab, i) => {
1169:           const stripWidth =
1170:             TABS.length * TAB_WIDTH + (TABS.length - 1) * TAB_GAP;
1171:           const x =
1172:             Math.floor((WIN_WIDTH - stripWidth) / 2) +
1173:             i * (TAB_WIDTH + TAB_GAP);
1174: 
1175:           return (
1176:             <div
1177:               key={tab.id}
1178:               className={`options-tab${tab.id === activeTab ? ' is-active' : ''}`}
1179:               style={{
1180:                 left: x,
1181:                 top: TAB_TOP,
1182:                 width: TAB_WIDTH,
1183:                 height: TAB_HEIGHT,
