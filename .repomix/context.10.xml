183: export function usedMask(squares: readonly (object | null)[]): string {
184:   let mask = '';
185:   for (const entry of squares) mask += entry ? '1' : '0';
186:   return mask;
187: }
188: 
189: export function hoveredMask<T extends object>(
190:   squares: readonly (T | null)[],
191:   entry: T | null
192: ): string {
193:   let mask = '';
194:   for (const at of squares) mask += at && at === entry ? '1' : '0';
195:   return mask;
196: }
197: 
198: /** One placed item: its icon (and stall price) at its squares. */
199: const GridItem = memo(function GridItem({
200:   entry,
201:   price,
202:   marked,
203:   dimmed,
204: }: {
205:   entry: Placed;
206:   price: number | undefined;
207:   marked: boolean;
208:   dimmed: boolean;
