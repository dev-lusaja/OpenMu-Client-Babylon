  1: import './style.less';
  2: import { useEffect, useLayoutEffect, useRef, useState } from 'react';
  3: import { Store } from '../../../store';
  4: import { useEventBus } from '../../../hooks/useEventBus';
  5: import { aimX, aimY } from '../../../camera';
  6: import { loadInterfaceSprite, type MuSprite } from '../../../libs/mu/sprites';
  7: import {
  8:   CURSOR_FILES,
  9:   CURSOR_FRAME_SIZE,
 10:   CURSOR_HOTSPOT,
 11:   CURSOR_SIZE,
 12:   talkCursorFrame,
 13:   type CursorKind,
 14: } from './cursors';
 15: 
 16: type Sprites = Record<CursorKind, MuSprite>;
 17: 
 18: function isOverUI(target: EventTarget | null): boolean {
 19:   return !(target instanceof HTMLCanvasElement);
 20: }
 21: 
 22: export const GameCursor = () => {
 23:   const ref = useRef<HTMLDivElement>(null);
 24: 
 25:   const [sprites, setSprites] = useState<Sprites | null>(null);
 26:   const [kind, setKind] = useState<CursorKind>('normal');
 27:   const [frame, setFrame] = useState(() => talkCursorFrame(0));
 28: 
 29:   const pointer = useRef({ x: 0, y: 0, pressed: false, overUI: true });
 30: 
 31:   const [visible, setVisible] = useState(false);
 32: 
 33:   useEffect(() => {
 34:     let cancelled = false;
 35: 
 36:     const files = Object.entries(CURSOR_FILES) as [CursorKind, string][];
 37: 
 38:     Promise.all(
 39:       files.map(([cursor, file]) =>
 40:         loadInterfaceSprite(file).then(sprite => [cursor, sprite] as const)
 41:       )
 42:     ).then(
 43:       loaded => {
 44:         if (!cancelled) {
 45:           setSprites(Object.fromEntries(loaded) as Sprites);
 46:         }
 47:       },
 48:       err => console.error('Could not load the cursors:', err)
 49:     );
 50: 
 51:     return () => {
 52:       cancelled = true;
 53:     };
 54:   }, []);
 55: 
 56:   const applyTransform = () => {
 57:     const el = ref.current;
 58:     if (!el) return;
 59: 
 60:     // `aimX/aimY`: under the first-person pointer lock the browser freezes
 61:     // the pointer position, and the game aims at the middle of the canvas
 62:     // instead - so the cursor parks there too and reads as the crosshair,
 63:     // still showing what it is over (attack, talk, pick up).
 64:     const { x, y } = pointer.current;
 65: 
 66:     el.style.transform = `translate3d(${aimX(x) - CURSOR_HOTSPOT}px, ${
 67:       aimY(y) - CURSOR_HOTSPOT
 68:     }px, 0)`;
 69:   };
 70: 
 71:   useLayoutEffect(applyTransform);
 72: 
 73:   // Taking or giving back the lock moves the cursor without the pointer
 74:   // having moved.
 75:   useEventBus('mouseLookChanged', applyTransform);
 76: 
 77:   useEffect(() => {
 78:     const onMove = (ev: PointerEvent) => {
 79:       pointer.current.x = ev.clientX;
 80:       pointer.current.y = ev.clientY;
 81:       pointer.current.overUI = isOverUI(ev.target);
 82: 
 83:       applyTransform();
 84:       setVisible(true);
 85:     };
 86: 
 87:     const onDown = (ev: PointerEvent) => {
 88:       if (ev.button !== 0) return;
 89:       pointer.current.pressed = true;
 90:       pointer.current.overUI = isOverUI(ev.target);
 91:     };
 92: 
 93:     const onUp = (ev: PointerEvent) => {
 94:       if (ev.button !== 0) return;
 95:       pointer.current.pressed = false;
 96:     };
 97: 
 98:     const onRelease = () => {
 99:       pointer.current.pressed = false;
100:     };
101: 
102:     const onOut = (ev: PointerEvent) => {
103:       if (ev.relatedTarget) return;
104:       setVisible(false);
105:     };
106: 
107:     window.addEventListener('pointermove', onMove, true);
108:     window.addEventListener('pointerdown', onDown, true);
109:     window.addEventListener('pointerup', onUp, true);
110:     window.addEventListener('pointercancel', onRelease, true);
111:     window.addEventListener('pointerout', onOut, true);
112:     window.addEventListener('blur', onRelease);
113: 
114:     return () => {
115:       window.removeEventListener('pointermove', onMove, true);
116:       window.removeEventListener('pointerdown', onDown, true);
117:       window.removeEventListener('pointerup', onUp, true);
118:       window.removeEventListener('pointercancel', onRelease, true);
119:       window.removeEventListener('pointerout', onOut, true);
120:       window.removeEventListener('blur', onRelease);
121:     };
122:   }, []);
123: 
124:   useEffect(() => {
125:     if (!sprites || !visible) return;
126: 
127:     document.body.classList.add('mu-cursor-hidden');
128: 
129:     return () => document.body.classList.remove('mu-cursor-hidden');
130:   }, [!!sprites, visible]);
131: 
132:   useEffect(() => {
133:     let raf = 0;
134: 
135:     const tick = () => {
136:       const { pressed, overUI } = pointer.current;
137: 
138:       const hover = overUI ? null : Store.world?.cursorHover ?? null;
139: 
140:       let next: CursorKind;
141: 
142:       if (Store.repairMode) {
143:         // CURSOR_REPAIR: the hammer stays up, over the UI too, until the
144:         // repair mode is left.
145:         next = 'repair';
146:       } else if (hover) {
147:         next = hover;
148:       } else if (!pressed) {
149:         next = 'normal';
150:       } else if (!overUI && Store.world?.cursorBlocked) {
151:         next = 'dontMove';
152:       } else {
153:         next = 'push';
154:       }
155: 
156:       setKind(previous => (previous === next ? previous : next));
157: 
158:       if (next === 'talk') {
159:         const now = talkCursorFrame(performance.now());
160: 
161:         setFrame(previous =>
162:           previous.x === now.x && previous.y === now.y ? previous : now
163:         );
164:       }
165: 
166:       raf = requestAnimationFrame(tick);
167:     };
168: 
169:     raf = requestAnimationFrame(tick);
170: 
171:     return () => cancelAnimationFrame(raf);
172:   }, []);
173: 
174:   if (!sprites || !visible) return null;
175: 
176:   const sprite = sprites[kind];
177:   const scale = CURSOR_SIZE / CURSOR_FRAME_SIZE;
178: 
179:   const animated = kind === 'talk';
180: 
181:   return (
182:     <div
183:       ref={ref}
184:       className="mu-cursor"
185:       style={{
186:         width: CURSOR_SIZE,
187:         height: CURSOR_SIZE,
188:         backgroundImage: `url(${sprite.url})`,
189:         backgroundSize: `${sprite.width * scale}px ${sprite.height * scale}px`,
190:         backgroundPosition: animated
191:           ? `-${frame.x * CURSOR_SIZE}px -${frame.y * CURSOR_SIZE}px`
192:           : '0 0',
193:       }}
194:     />
195:   );
196: };
</file>

