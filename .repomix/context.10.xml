  1: import { t } from '../../../i18n';
  2: import './style.less';
  3: import { observer } from 'mobx-react-lite';
  4: import { useLayoutEffect, useRef } from 'react';
  5: import { createPortal } from 'react-dom';
  6: import { skillDefinition } from '../../../common/skillsDatabase';
  7: import { skillDisplayName } from '../../../common/skillNames';
  8: import { skills, type SkillBlock } from '../../../skills';
  9: import { skillDelaySeconds } from '../../../skills/cooldowns';
 10: 
 11: export type TipLine = {
 12:   text: string;
 13:   color: 'white' | 'blue' | 'darkRed' | 'gray';
 14:   bold?: boolean;
 15:   blank?: boolean;
 16: };
 17: 
 18: type Line = TipLine;
 19: 
 20: /** `RenderSkillInfo`'s dark-red requirement lines, one per failed gate. */
 21: const BLOCK_TEXT: Record<SkillBlock, (req: { level: number; energy: number; mana: number; ag: number }) => string> = {
 22:   unknown: () => t('skills.tooltip.unknown'),
 23:   class: () => t('skills.tooltip.class'),
 24:   level: r => t('skills.tooltip.level', { level: r.level }),
 25:   energy: r => t('skills.tooltip.energy', { energy: r.energy }),
 26:   weapon: () => t('skills.tooltip.weapon'),
 27:   mana: r => t('skills.tooltip.mana', { mana: r.mana }),
 28:   ag: r => t('skills.tooltip.ag', { ag: r.ag }),
 29:   cooldown: () => t('skills.tooltip.cooldown'),
 30:   safezone: () => t('skills.tooltip.safezone'),
 31: };
 32: 
 33: /**
 34:  * The lines of `RenderSkillInfo` (ZzzInventory.cpp:6024) for one hotbar
 35:  * skill: a blank, the name in bold blue, a blank, then damage / distance
 36:  * (GlobalText 170, 174), mana (175), AG (360), and every requirement the
 37:  * hero fails in dark red, the delay last. Pure data so the skill-list window
 38:  * can reuse it.
 39:  */
 40: export function buildSkillTooltip(number: number, level = 0): Line[] {
 41:   const def = skillDefinition(number);
 42:   if (!def) {
 43:     return [
 44:       { text: t('skills.unnamed', { number }), color: 'blue', bold: true },
 45:     ];
 46:   }
 47: 
 48:   const skillName = skillDisplayName(number) ?? def.name;
 49:   const { blocks } = skills.usability(number);
 50:   const lines: Line[] = [
 51:     { text: '', color: 'white', blank: true },
 52:     {
 53:       text: level > 0 ? t('skills.named', { name: skillName, level }) : skillName,
 54:       color: 'blue',
 55:       bold: true,
 56:     },
 57:     { text: '', color: 'white', blank: true },
 58:   ];
 59: 
 60:   if (def.damage > 0) {
 61:     lines.push({ text: t('skills.damage', { value: def.damage }), color: 'white' });
 62:   }
 63:   if (def.distance > 0) {
 64:     lines.push({ text: t('skills.distance', { value: def.distance }), color: 'white' });
 65:   }
 66:   lines.push({ text: t('skills.mana', { value: def.mana }), color: 'white' });
 67:   if (def.ag > 0) {
 68:     lines.push({ text: t('skills.ag', { value: def.ag }), color: 'white' });
 69:   }
 70: 
 71:   const delay = skillDelaySeconds(number);
 72:   if (delay > 0) {
 73:     const cd = skills.cooldown(number);
 74:     lines.push({
 75:       text: cd
 76:         ? t('skills.readyIn', { seconds: cd.remaining.toFixed(1) })
 77:         : t('skills.delay', { seconds: delay }),
 78:       color: cd ? 'gray' : 'white',
 79:     });
 80:   }
 81: 
 82:   for (const block of blocks) {
 83:     if (block === 'cooldown') continue; // already the "Ready in" line
 84:     lines.push({ text: BLOCK_TEXT[block](def), color: 'darkRed' });
 85:   }
 86: 
 87:   return lines;
 88: }
 89: 
 90: /**
 91:  * `RenderTipTextList` (ZzzInventory.cpp:282): the black 80% box hanging off
 92:  * the cursor, kept inside the viewport, portalled so no window clips it.
 93:  * Every hover tip on the bottom bar is drawn by this one component.
 94:  */
 95: export const MuTipList = observer(({ lines, x, y }: { lines: TipLine[]; x: number; y: number }) => {
 96:   const ref = useRef<HTMLDivElement>(null);
 97: 
 98:   useLayoutEffect(() => {
 99:     const box = ref.current;
100:     if (!box) return;
101:     const rect = box.getBoundingClientRect();
102:     const margin = 2;
103:     let left = x - rect.width / 2;
104:     // The bar sits at the bottom: the tip hangs above the cursor by default.
105:     let top = y - 8 - rect.height;
106:     if (left + rect.width > window.innerWidth - margin) left = window.innerWidth - margin - rect.width;
107:     if (left < margin) left = margin;
108:     if (top < margin) top = y + 16;
109:     box.style.left = `${Math.round(left)}px`;
110:     box.style.top = `${Math.round(top)}px`;
111:   });
112: 
113:   return createPortal(
114:     <div ref={ref} className="mu-skill-tooltip">
115:       {lines.map((line, i) =>
116:         line.blank ? (
117:           <div key={i} className="mu-skill-tooltip-gap" />
118:         ) : (
119:           <div key={i} className={`mu-skill-tooltip-line color-${line.color}${line.bold ? ' bold' : ''}`}>
120:             {line.text}
121:           </div>
122:         )
123:       )}
124:     </div>,
125:     document.body
126:   );
127: });
128: 
129: /** `RenderSkillInfo` for one hotbar skill, in the box above. */
130: export const SkillTooltip = observer(
131:   ({ number, level = 0, x, y }: { number: number; level?: number; x: number; y: number }) => (
132:     <MuTipList lines={buildSkillTooltip(number, level)} x={x} y={y} />
133:   )
134: );
</file>

