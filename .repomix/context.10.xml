<file path="src/ui/components/optionsWindow/languageSelect.tsx">
  1: /**
  2:  * The language picker on Options → Game.
  3:  *
  4:  * A `<select>` would be the browser's chrome dropped into the middle of a
  5:  * stone window, so this is the window's own: a closed plate with the current
  6:  * flag and the language's own name for itself, and a list that drops over the
  7:  * rows below it in the same gold-on-black the tabs and key boxes use.
  8:  *
  9:  * It commands `i18n.setLanguage`; the choice is stored by the facade and every
 10:  * `observer` on screen redraws itself.
 11:  */
 12: 
 13: import { useEffect, useRef, useState } from 'react';
 14: import { observer } from 'mobx-react-lite';
 15: import { uiClick } from '../../../libs/sfx';
 16: import { i18n, t } from '../../../i18n';
 17: import { MuFlag } from '../muFlag';
 18: 
 19: const ROW_HEIGHT = 18;
 20: const PLATE_HEIGHT = 18;
 21: const FLAG_WIDTH = 18;
 22: 
 23: /** How many languages the list shows before it scrolls. */
 24: const VISIBLE_ROWS = 8;
 25: 
 26: export const LanguageSelect = observer(
 27:   ({ left, top, width }: { left: number; top: number; width: number }) => {
 28:     const [open, setOpen] = useState(false);
 29:     const root = useRef<HTMLDivElement>(null);
 30: 
 31:     // A click anywhere else closes the list, the way the emote menu does.
 32:     useEffect(() => {
 33:       if (!open) return;
 34: 
 35:       const onDown = (e: PointerEvent) => {
 36:         if (!root.current?.contains(e.target as Node)) setOpen(false);
 37:       };
 38: 
 39:       document.addEventListener('pointerdown', onDown, true);
 40:       return () => document.removeEventListener('pointerdown', onDown, true);
 41:     }, [open]);
 42: 
 43:     const current = i18n.current;
 44: 
 45:     return (
 46:       <div
 47:         ref={root}
 48:         className="options-language"
 49:         style={{ left, top, width }}
 50:       >
 51:         <span className="options-label" style={{ left: 0, top: 0 }}>
 52:           {t('options.tab.language')}
 53:         </span>
 54: 
 55:         <div
 56:           className={`options-combo${open ? ' is-open' : ''}`}
 57:           style={{ top: 12, width, height: PLATE_HEIGHT }}
 58:           title={t('options.languageHint')}
 59:           onClick={uiClick(() => setOpen(v => !v))}
 60:         >
 61:           <MuFlag region={current.region} width={FLAG_WIDTH} />
 62:           <span className="options-combo-name">{current.label}</span>
 63:           <span className="options-combo-arrow">{open ? '▲' : '▼'}</span>
 64:         </div>
 65: 
 66:         {open && (
 67:           <div
 68:             className="options-combo-list scrollable"
 69:             style={{
 70:               top: 12 + PLATE_HEIGHT + 2,
 71:               width,
 72:               maxHeight: VISIBLE_ROWS * ROW_HEIGHT + 4,
 73:             }}
 74:           >
 75:             {i18n.languages.map(language => (
 76:               <div
 77:                 key={language.code}
 78:                 className={`options-combo-row${
 79:                   language.code === current.code ? ' is-active' : ''
 80:                 }`}
 81:                 style={{ height: ROW_HEIGHT }}
 82:                 title={t(
 83:                   language.dataPack ? 'options.packHint' : 'options.noPackHint'
 84:                 )}
 85:                 onClick={uiClick(() => {
 86:                   i18n.setLanguage(language.code);
 87:                   setOpen(false);
 88:                 })}
 89:               >
 90:                 <MuFlag region={language.region} width={FLAG_WIDTH} />
 91:                 <span className="options-combo-name">{language.label}</span>
 92:                 {language.dataPack && (
 93:                   <span className="options-combo-mark">
 94:                     {t('options.packMark')}
 95:                   </span>
 96:                 )}
 97:               </div>
 98:             ))}
 99:           </div>
100:         )}
101:       </div>
102:     );
103:   }
104: );
</file>

