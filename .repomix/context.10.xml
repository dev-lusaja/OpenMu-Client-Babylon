  1: import './style.less';
  2: import { observer } from 'mobx-react-lite';
  3: import { useEffect, useState } from 'react';
  4: import { Store } from '../../../store';
  5: import { isNpcOrTrapType } from '../../../ecs/systems/attackSystem';
  6: 
  7: const STEPS = 20;
  8: const BORDER_WIDTH = 2;
  9: const WIDTH_PER_STEP = 4;
 10: const STEP_SEPARATOR_WIDTH = 1;
 11: const STEPS_WIDTH = STEPS * WIDTH_PER_STEP - 2 * STEP_SEPARATOR_WIDTH;
 12: const TOTAL_WIDTH = STEPS_WIDTH + BORDER_WIDTH * 2;
 13: const BAR_Y = 15;
 14: const BAR_HEIGHT = 5;
 15: const NAME_Y = 2;
 16: 
 17: const FRAME_COLOUR = 'rgb(51, 0, 0)';
 18: const TRACK_COLOUR = 'rgb(50, 10, 0)';
 19: const FILL_COLOUR = 'rgb(250, 10, 0)';
 20: 
 21: /**
 22:  * What the panel shows: the target's name, and its health in whole steps when
 23:  * anything knows it. `showBar` is the original's `HealthStatus > 0` - the name
 24:  * is unconditional, the bar is not (NewUINameWindow.cpp:138-144).
 25:  */
 26: type Target = { name: string; steps: number; showBar: boolean };
 27: 
 28: /**
 29:  * Reads the current target into the scratch record without allocating.
 30:  * Returns `false` when there is nothing to show.
 31:  */
 32: const scratch: Target = { name: '', steps: 0, showBar: false };
 33: 
 34: function readTarget(out: Target): boolean {
 35:   const world = Store.world;
 36:   if (!world) return false;
 37: 
 38:   const entity = world.currentPointerTarget ?? world.attackTarget;
 39: 
 40:   if (!entity || entity.localPlayer) return false;
 41:   if (entity.dying) return false; // SelectedCharacter is cleared once Dead > 0
 42: 
 43:   // `Kind == KIND_MONSTER`: players and NPCs get the floating name balloon
 44:   // instead. The animation rig is deliberately not the test - the Skeleton
 45:   // line and the Doppelganger set are monsters drawn on the player rig, and
 46:   // asking for `monsterAnimation` left every one of them nameless.
 47:   const type = entity.npcType;
 48:   if (type === undefined || isNpcOrTrapType(type)) return false;
 49: 
 50:   const name = entity.objectNameInWorld;
 51:   if (!name) return false;
 52: 
 53:   const attributes = entity.attributeSystem;
 54:   const max = attributes ? attributes.getValue('maxHealth') : 0;
 55:   const current = attributes ? attributes.getValue('currentHealth') : 0;
 56:   const health = max > 0 ? Math.min(1, Math.max(0, current / max)) : 0;
 57: 
 58:   out.name = name;
 59:   out.steps = Math.trunc(health * STEPS);
 60:   out.showBar = health > 0;
 61:   return true;
 62: }
 63: 
 64: /** Hoisted pip styles: the bar shows at most STEPS of them. */
 65: const PIP_STYLES = Array.from({ length: STEPS }, (_, k) => ({
 66:   left: BORDER_WIDTH + k * WIDTH_PER_STEP,
 67:   top: BORDER_WIDTH,
 68:   width: WIDTH_PER_STEP - STEP_SEPARATOR_WIDTH,
 69:   height: 2,
 70:   backgroundColor: FILL_COLOUR,
 71: }));
 72: 
 73: const BAR_STYLE = { top: BAR_Y, width: TOTAL_WIDTH, height: BAR_HEIGHT };
 74: const NAME_STYLE = { top: NAME_Y };
 75: const FRAME_STYLE = { backgroundColor: FRAME_COLOUR };
 76: const TRACK_STYLE = {
 77:   left: BORDER_WIDTH,
 78:   top: BORDER_WIDTH,
 79:   width: STEPS_WIDTH,
 80:   height: 1,
 81:   backgroundColor: TRACK_COLOUR,
 82: };
 83: 
 84: /**
 85:  * The target's name and twenty-step health bar over the screen centre. The
 86:  * pointer target is plain per-frame state, so it is polled once a frame -
 87:  * into a reused record, and React only hears about it when the name or the
 88:  * step count actually changes.
 89:  */
 90: export const TargetHealthBar = observer(() => {
 91:   const [target, setTarget] = useState<Target | null>(null);
 92: 
 93:   useEffect(() => {
 94:     let frame = 0;
 95:     let shown: Target | null = null;
 96: 
 97:     const poll = () => {
 98:       frame = requestAnimationFrame(poll);
 99: 
100:       if (!readTarget(scratch)) {
101:         if (shown) {
102:           shown = null;
103:           setTarget(null);
104:         }
105:         return;
106:       }
107: 
108:       if (
109:         shown &&
110:         shown.name === scratch.name &&
111:         shown.steps === scratch.steps &&
112:         shown.showBar === scratch.showBar
113:       ) {
114:         return;
115:       }
116: 
117:       shown = { name: scratch.name, steps: scratch.steps, showBar: scratch.showBar };
118:       setTarget(shown);
119:     };
120: 
121:     frame = requestAnimationFrame(poll);
122: 
123:     return () => cancelAnimationFrame(frame);
124:   }, []);
125: 
126:   if (!target) return null;
127: 
128:   return (
129:     <div className="target-health-bar">
130:       <div className="target-name" style={NAME_STYLE}>
131:         {target.name}
132:       </div>
133: 
134:       {target.showBar && (
135:         <div className="target-bar" style={BAR_STYLE}>
136:           <div className="bar-shadow" />
137:           <div className="bar-frame" style={FRAME_STYLE} />
138:           <div className="bar-track" style={TRACK_STYLE} />
139:           {PIP_STYLES.slice(0, target.steps).map((style, k) => (
140:             <div key={k} className="bar-step" style={style} />
141:           ))}
142:         </div>
143:       )}
144:     </div>
145:   );
146: });
</file>

