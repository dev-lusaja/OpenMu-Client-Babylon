<file path="src/ui/components/muLogo/style.less">
 1: // The MU logo of `LoginScene::Render`: glow under mark, centred on x,
 2: // `g_fMULogoAlpha` += 0.02 a frame ≈ 0.8 s to full at 60 fps.
 3: .mu-logo {
 4:   position: absolute;
 5:   left: 50%;
 6:   transform: translateX(-50%);
 7:   pointer-events: none;
 8:   animation: mu-logo-in 0.8s linear both;
 9: 
10:   .mu-logo-glow,
11:   .mu-logo-mark {
12:     position: absolute;
13:     inset: 0;
14:     width: 100%;
15:     height: 100%;
16:   }
17: 
18:   // `glColor4f(alpha - 0.3)` on the glow: it trails the mark. A version whose
19:   // tree has only the JPEG draws it alone, at full strength.
20:   .mu-logo-glow.is-only {
21:     opacity: 1;
22:   }
23: 
24:   .mu-logo-glow {
25:     opacity: 0.7;
26:     background-size: 100% 100%;
27:     // Luminance self-mask: the JPEG's black is fully transparent, its bright
28:     // glow fully opaque - the additive look without needing to blend against
29:     // the canvas.
30:     -webkit-mask-size: 100% 100%;
31:     mask-size: 100% 100%;
32:     -webkit-mask-mode: luminance;
33:     mask-mode: luminance;
34:   }
35: }
36: 
37: @keyframes mu-logo-in {
38:   from {
39:     opacity: 0;
40:   }
41:   to {
42:     opacity: 1;
43:   }
44: }
