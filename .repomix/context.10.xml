<file path="src/ui/components/muButton/index.tsx">
 1: import { useState, type CSSProperties } from 'react';
 2: import { MuSpriteFrame } from '../muSprite';
 3: import { uiClick } from '../../../libs/sfx';
 4: 
 5: export type MuButtonFrames = {
 6:   up: number;
 7:   active?: number;
 8:   down?: number;
 9:   check?: number;
10: };
11: 
12: type MuButtonProps = {
13:   file: string;
14:   width: number;
15:   height: number;
16:   frames: MuButtonFrames;
17:   label?: string;
18:   color?: string;
19:   activeColor?: string;
20:   checked?: boolean;
21:   disabled?: boolean;
22:   onClick?: () => void;
23:   style?: CSSProperties;
24:   labelStyle?: CSSProperties;
25:   children?: React.ReactNode;
26: };
27: 
28: export const MuButton = ({
29:   file,
30:   width,
31:   height,
32:   frames,
33:   label,
34:   color = '#e2e2e2',
35:   activeColor = '#ffffff',
36:   checked = false,
37:   disabled = false,
38:   onClick,
39:   style,
40:   labelStyle,
41:   children,
42: }: MuButtonProps) => {
43:   const [hovered, setHovered] = useState(false);
44:   const [pressed, setPressed] = useState(false);
45: 
46:   let frame = frames.up;
47: 
48:   if (checked && frames.check !== undefined) frame = frames.check;
49:   if (!disabled && hovered && frames.active !== undefined) frame = frames.active;
50:   if (!disabled && pressed && frames.down !== undefined) frame = frames.down;
51: 
52:   return (
53:     <MuSpriteFrame
54:       file={file}
55:       y={frame * height}
56:       width={width}
57:       height={height}
58:       // A button is never a drag handle. Without this the window's own
59:       // pointerdown starts a drag and captures the pointer, and the click
60:       // lands on the window root instead of here - the button looks alive and
61:       // does nothing. Every caller used to wrap itself in a `data-no-drag`
62:       // div to avoid that; the ones that forgot were simply broken.
63:       noDrag
64:       style={{
65:         position: 'relative',
66:         pointerEvents: 'auto',
67:         cursor: disabled ? 'default' : 'pointer',
68:         opacity: disabled ? 0.5 : 1,
69:         ...style,
70:       }}
71:       onClick={disabled ? undefined : uiClick(onClick)}
72:     >
73:       <div
74:         onMouseEnter={() => setHovered(true)}
75:         onMouseLeave={() => {
76:           setHovered(false);
77:           setPressed(false);
78:         }}
79:         onMouseDown={() => setPressed(true)}
80:         onMouseUp={() => setPressed(false)}
81:         style={{
82:           position: 'absolute',
83:           inset: 0,
84:           display: 'flex',
85:           alignItems: 'center',
86:           justifyContent: 'center',
87:           paddingTop: pressed && !disabled ? 2 : 0,
88:           color: hovered && !disabled ? activeColor : color,
89:           ...labelStyle,
90:         }}
91:       >
92:         {label}
93:         {children}
94:       </div>
95:     </MuSpriteFrame>
96:   );
97: };
</file>

<file path="src/ui/components/muFlag/index.tsx">
  1: /**
  2:  * The flag beside a language in the Options selector.
  3:  *
  4:  * Drawn as inline SVG rather than a flag emoji on purpose: Windows ships no
  5:  * regional-indicator glyphs, so `🇪🇸` renders as the letters "ES" in every
  6:  * browser on the platform most of the players are on. Twelve rectangles and a
  7:  * few paths cost nothing and look the same everywhere.
  8:  *
  9:  * One entry per `FlagRegion` in `i18n/layer.ts`; adding a language with a new
 10:  * region means adding its shape to `SHAPES` here.
 11:  */
 12: 
 13: import type { CSSProperties, ReactNode } from 'react';
 14: import type { FlagRegion } from '../../../i18n';
 15: 
 16: /** The 3:2 field every flag is drawn in. */
 17: const W = 24;
 18: const H = 16;
 19: 
 20: /** A five-pointed star, point up, as a path - China's are the only ones. */
 21: function star(cx: number, cy: number, r: number, rotation = 0): string {
 22:   const points: string[] = [];
 23: 
 24:   for (let i = 0; i < 10; i++) {
 25:     const radius = i % 2 === 0 ? r : r * 0.382;
 26:     const angle = rotation + (Math.PI / 5) * i - Math.PI / 2;
 27:     points.push(
 28:       `${(cx + Math.cos(angle) * radius).toFixed(2)},${(cy + Math.sin(angle) * radius).toFixed(2)}`
 29:     );
 30:   }
 31: 
 32:   return `M${points.join('L')}Z`;
 33: }
 34: 
 35: /** Horizontal bands, top to bottom, as a share of the height. */
 36: function bands(colors: readonly string[]): ReactNode {
 37:   const h = H / colors.length;
 38:   return colors.map((fill, i) => (
 39:     <rect key={i} x={0} y={i * h} width={W} height={h} fill={fill} />
 40:   ));
 41: }
 42: 
 43: /** Vertical bands, hoist to fly. */
 44: function stripes(colors: readonly string[]): ReactNode {
 45:   const w = W / colors.length;
 46:   return colors.map((fill, i) => (
 47:     <rect key={i} x={i * w} y={0} width={w} height={H} fill={fill} />
 48:   ));
 49: }
 50: 
 51: const SHAPES: Record<FlagRegion, ReactNode> = {
 52:   // Union Jack: the white saltire under a narrower red one, then the cross.
 53:   GB: (
 54:     <>
 55:       <rect x={0} y={0} width={W} height={H} fill="#012169" />
 56:       <path d="M0,0 L24,16 M24,0 L0,16" fill="none" stroke="#ffffff" strokeWidth={3.4} />
 57:       <path d="M0,0 L24,16 M24,0 L0,16" fill="none" stroke="#c8102e" strokeWidth={1.5} />
 58:       <rect x={9.2} y={0} width={5.6} height={H} fill="#ffffff" />
 59:       <rect x={0} y={5.2} width={W} height={5.6} fill="#ffffff" />
 60:       <rect x={10.4} y={0} width={3.2} height={H} fill="#c8102e" />
 61:       <rect x={0} y={6.4} width={W} height={3.2} fill="#c8102e" />
 62:     </>
 63:   ),
 64: 
 65:   // 1:2:1 bands; the coat of arms is far below the size this renders at.
 66:   ES: (
 67:     <>
 68:       <rect x={0} y={0} width={W} height={H} fill="#c60b1e" />
 69:       <rect x={0} y={4} width={W} height={8} fill="#ffc400" />
 70:     </>
 71:   ),
 72: 
 73:   FR: stripes(['#002395', '#ffffff', '#ed2939']),
