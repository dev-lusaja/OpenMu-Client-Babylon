1185:               onClick={uiClick(() => openTab(tab))}
1186:             >
1187:               {t(tab.labelKey)}
1188:             </div>
1189:           );
1190:         })}
1191: 
1192:         {/* One strip per category; a category with one screen draws none. */}
1193:         {tab.subtabs.length > 1 &&
1194:           tab.subtabs.map((entry, i) => {
1195:             const width = Math.floor(
1196:               (COLUMN_WIDTH * 2 - SUBTAB_GAP * (tab.subtabs.length - 1)) /
1197:                 tab.subtabs.length
1198:             );
1199:             const stripWidth =
1200:               tab.subtabs.length * width + (tab.subtabs.length - 1) * SUBTAB_GAP;
1201:             const x =
1202:               Math.floor((WIN_WIDTH - stripWidth) / 2) + i * (width + SUBTAB_GAP);
1203: 
1204:             return (
1205:               <div
1206:                 key={entry.id}
1207:                 className={`options-subtab${entry.id === sub.id ? ' is-active' : ''}`}
1208:                 style={{
1209:                   left: x,
1210:                   top: SUBTAB_TOP,
1211:                   width,
1212:                   height: SUBTAB_HEIGHT,
1213:                 }}
1214:                 onClick={uiClick(() => setActiveSub(entry.id))}
1215:               >
1216:                 {t(entry.labelKey)}
1217:               </div>
1218:             );
1219:           })}
1220: 
1221:         {sub.columns.map((sections, columnIndex) => {
1222:           const alone = sub.columns.length === 1;
1223:           const x = alone
1224:             ? Math.floor((WIN_WIDTH - COLUMN_WIDTH) / 2)
1225:             : COLUMN_X[columnIndex];
1226: 
1227:           let y = TAB_CONTENT_TOP;
1228:           if (alone) {
1229:             const room = TAB_CONTENT_BOTTOM - TAB_CONTENT_TOP;
1230:             y += Math.max(0, Math.floor((room - columnHeight(sections)) / 2));
1231:           }
1232: 
1233:           return (
1234:             <div key={columnIndex}>
1235:               {sections.map(section => {
1236:                 const headerY = y;
1237:                 y += SECTION_HEADER_H;
1238: 
1239:                 const body = section.rows.map(row => {
1240:                   const rowY = y;
1241:                   y += rowHeight(row);
1242: 
1243:                   if (row.kind === 'check') {
1244:                     const checked = GameOptions[row.key] as boolean;
1245: 
1246:                     const dim =
1247:                       (row.needsPostProcessing === true &&
1248:                         !GameOptions.postProcessing) ||
1249:                       (row.needsWsadMovement === true &&
1250:                         !GameOptions.wsadMovement) ||
1251:                       (row.needsTier === true &&
1252:                         GameOptions.lightingQuality === 0) ||
1253:                       (row.needsStyle !== undefined &&
1254:                         !renderingStyle()?.[row.needsStyle]);
