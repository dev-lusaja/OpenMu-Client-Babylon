10:   | 'repair';
11: 
12: export const CURSOR_FILES: Record<CursorKind, string> = {
13:   normal: 'Cursor.ozt',
14:   repair: 'CursorRepair.OZT',
15:   push: 'CursorPush.ozt',
16:   attack: 'CursorAttack.ozt',
17:   get: 'CursorGet.ozt',
18:   talk: 'CursorTalk.ozt',
19:   lean: 'CursorLeanAgainst.ozt',
20:   sit: 'CursorSitDown.ozt',
21:   dontMove: 'CursorDontMove.OZT',
22: };
23: 
24: export const CURSOR_SPRITES: readonly string[] = Object.values(CURSOR_FILES);
25: 
26: export const CURSOR_FRAME_SIZE = 32;
27: 
28: export const CURSOR_SCALE = 1.5;
29: 
30: export const CURSOR_SIZE = 24 * CURSOR_SCALE;
31: 
32: export const CURSOR_HOTSPOT = 2 * CURSOR_SCALE;
33: 
34: export function talkCursorFrame(worldTimeMs: number): { x: number; y: number } {
35:   const frame = Math.floor(worldTimeMs * 0.01) % 6;
36: 
37:   return {
38:     x: frame === 1 || frame === 3 || frame === 5 ? 1 : 0,
39:     y: frame === 2 || frame === 3 || frame === 4 ? 1 : 0,
40:   };
41: }
