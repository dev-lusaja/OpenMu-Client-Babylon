 11: import { onScreenPosition } from '../../../libs/screenPositionBus';
 12: import { DROP_TIER_COLOURS, dropTier } from '../../../common/dropTier';
 13: import { dropPassesLootFilter } from '../../../common/lootFilter';
 14: import { GameOptions } from '../../../common/gameOptions';
 15: import { ItemTooltip } from '../itemTooltip';
 16: import type { Entity } from '../../../ecs/world';
 17: import { stableKeyOf } from '../partyBars/stableKey';
 18: 
 19: const isAlt = (code: string) => code === 'AltLeft' || code === 'AltRight';
 20: 
 21: /** How long the cursor has to rest on a drop before its tooltip opens. */
 22: const DROP_TOOLTIP_DELAY_MS = 250;
 23: 
 24: /**
 25:  * CNewUINameWindow (NewUINameWindow.cpp:74, :201): pressing ALT toggles the
 26:  * names over every drop on the ground, and they also show for as long as ALT
 27:  * is held. Returns whether the overlay is on right now.
 28:  */
 29: function useDropNamesOverlay(): { overlay: boolean; showAll: boolean } {
 30:   const [held, setHeld] = useState(false);
 31: 
 32:   useEventBus('keyPressed', code => {
 33:     if (!isAlt(code)) return;
 34:     setHeld(true);
 35:     Store.toggleDropNames();
 36:   });
 37:   useEventBus('keyReleased', code => {
 38:     if (isAlt(code)) setHeld(false);
 39:   });
 40: 
 41:   // Held ALT is the escape hatch: it names every drop, filter or not.
 42:   return { overlay: Store.showDropNames || held, showAll: held };
 43: }
 44: 
 45: type DropEntity = With<Entity, 'transform' | 'screenPosition' | 'droppedItem'>;
 46: 
 47: type Point = { x: number; y: number };
 48: 
 49: /**
 50:  * Where the box opens. `ItemTooltip` keeps itself clear of the cursor art and
 51:  * then follows the pointer, so it is handed the cursor.
 52:  *
 53:  * On the label, that is where the pointer came in: the scene stops hearing
 54:  * moves the moment the cursor leaves the canvas, so its own reading is stale
 55:  * there. Otherwise the scene's reading is the one the pick itself used, and
 56:  * the canvas fills the window, so those coordinates are the viewport's.
 57:  */
 58: function tooltipAnchor(entity: DropEntity, onLabel: Point | null): Point {
 59:   if (onLabel) return onLabel;
 60: 
 61:   const scene = Store.world?.scene;
 62: 
 63:   if (scene && (scene.pointerX !== 0 || scene.pointerY !== 0)) {
 64:     return { x: scene.pointerX, y: scene.pointerY };
 65:   }
 66: 
 67:   return { x: entity.screenPosition.x, y: entity.screenPosition.y };
 68: }
 69: 
 70: /**
 71:  * A drop's name: drawn over the item while the ALT overlay is on or the
 72:  * cursor is on the item (SelectedItem), and clickable - the original's
 73:  * ALT-mode `SelectItem()` lets players pull one item out of a loot pile.
 74:  */
 75: const DropLabel = observer(({
 76:   entity,
 77:   overlay,
 78:   showAll,
 79: }: {
 80:   entity: DropEntity;
 81:   overlay: boolean;
 82:   showAll: boolean;
 83: }) => {
 84:   const [hovered, setHovered] = useState(false);
 85:   const hoveredRef = useRef(false);
 86:   const [onLabel, setOnLabel] = useState(false);
 87:   const labelPointer = useRef<Point | null>(null);
 88:   const [anchor, setAnchor] = useState<Point | null>(null);
 89: 
 90:   // `currentPointerTarget` is plain state sampled per frame; piggyback on the
 91:   // per-frame screen-position event instead of polling.
 92:   useEffect(
 93:     () =>
 94:       onScreenPosition(entity, () => {
 95:         const now = Store.world?.currentPointerTarget === entity;
 96:         if (now !== hoveredRef.current) {
 97:           hoveredRef.current = now;
 98:           setHovered(now);
 99:         }
100:       }),
101:     [entity]
102:   );
103: 
104:   const named = overlay && (showAll || dropPassesLootFilter(entity.droppedItem));
105:   const visible = named || hovered;
106: 
107:   // Money is its own name ("Zen 1234") and a drop whose bytes did not decode
108:   // has nothing to show, so both keep the label alone.
109:   const item = entity.droppedItem.isMoney ? undefined : entity.droppedItem.item;
110:   const wanted = GameOptions.dropTooltips && !!item && visible && (hovered || onLabel);
111: 
112:   useEffect(() => {
113:     if (!wanted) {
114:       setAnchor(null);
115:       return;
116:     }
117:     const timer = setTimeout(
118:       () => setAnchor(tooltipAnchor(entity, labelPointer.current)),
119:       DROP_TOOLTIP_DELAY_MS
120:     );
121: 
122:     return () => clearTimeout(timer);
123:   }, [wanted, entity]);
124: 
125:   // A latch turned off under a resting cursor takes the label away without a
126:   // leave event, so the flag is cleared with the element it belongs to.
127:   useEffect(() => {
128:     if (!visible) {
129:       labelPointer.current = null;
130:       setOnLabel(false);
131:     }
132:   }, [visible]);
133: 
134:   if (!visible) return null;
135: 
136:   return (
137:     <>
138:       <WorldLabel
139:         entity={entity}
140:         text={entity.objectNameInWorld ?? ''}
141:         colour={DROP_TIER_COLOURS[dropTier(entity.droppedItem)]}
142:         className="drop"
143:         onPointerDown={ev => {
144:           if (ev.button !== 0) return;
145:           ev.stopPropagation();
146:           const world = Store.world;
147:           if (!world || Store.pickedItem || Store.pendingItemMove) return;
148:           world.pickupTarget = entity;
149:         }}
150:         onPointerEnter={ev => {
151:           labelPointer.current = { x: ev.clientX, y: ev.clientY };
152:           setOnLabel(true);
153:         }}
154:         onPointerLeave={() => {
155:           labelPointer.current = null;
156:           setOnLabel(false);
157:         }}
158:       />
159:       {anchor && item && (
160:         <ItemTooltip item={item} x={anchor.x} y={anchor.y} context="plain" />
161:       )}
162:     </>
163:   );
164: });
165: 
166: /**
167:  * Drop names here; character and NPC names are the original's hover/chat
168:  * balloons (`RenderBooleans`), owned by NameTagSystem and drawn by NameTags -
169:  * the original never draws a character's name permanently.
170:  */
