  1: import './style.less';
  2: import { observer } from 'mobx-react-lite';
  3: import { useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react';
  4: import { createPortal } from 'react-dom';
  5: import type { Item } from '../../../ecs/world';
  6: import { Store } from '../../../store';
  7: import { buildItemTooltip, type TooltipLine } from '../../../common/itemTooltip';
  8: import {
  9:   comparedItem,
 10:   compareTooltipsOn,
 11:   CompareTooltips,
 12: } from '../../../common/itemCompare';
 13: import { GameOptions } from '../../../common/gameOptions';
 14: import type { HeroStats } from '../../../common/itemStats';
 15: import { PET_GROUP } from '../../../common/pets';
 16: import { PetTypeEnum } from '../../../common/packets/ClientToServerPackets';
 17: import { t } from '../../../i18n';
 18: import {
 19:   isRepairBanned,
 20:   isSellingBanned,
 21:   itemValue,
 22:   needsRepair,
 23:   repairCost,
 24:   withTax,
 25: } from '../../../common/itemValue';
 26: import { placePair } from './placement';
 27: 
 28: /** The hero as `RenderItemInfo` compares against (`CharacterAttribute`). */
 29: export function heroStats(): HeroStats {
 30:   return Store.heroStats();
 31: }
 32: 
 33: /**
 34:  * Where the item sits: the hero's inventory, a merchant's stock, a player's
 35:  * stall (`TOOLTIP_TYPE_MY_SHOP`) or one of the storage grids, which add no
 36:  * price line of their own.
 37:  */
 38: export type TooltipContext = 'inventory' | 'shop' | 'playerShop' | 'plain';
 39: 
 40: const zen = (gold: number) => `${gold.toLocaleString('en-US')} Zen`;
 41: 
 42: /**
 43:  * The price lines `RenderItemInfo` adds while a shop is open (GlobalText
 44:  * 63 / 1620, ZzzInventory.cpp:2228) and the repair line of the repair
 45:  * cursor (`RenderRepairInfo`, GlobalText 238), in the name's colour, right
 46:  * under the name.
 47:  */
 48: function priceLines(
 49:   item: Item,
 50:   context: TooltipContext,
 51:   color: TooltipLine['color'],
 52:   price?: number
 53: ): TooltipLine[] {
 54:   const shop = Store.npcShop;
 55:   const lines: TooltipLine[] = [];
 56: 
 57:   // `CNewUIPurchaseShopInventory`: the seller's asking price, in gold.
 58:   if (context === 'playerShop') {
 59:     lines.push({
 60:       text:
 61:         price !== undefined && price > 0
 62:           ? t('shop.price', { amount: zen(price) })
 63:           : t('shop.noPrice'),
 64:       color,
 65:       bold: true,
 66:     });
 67:     lines.push({ text: '', color, bold: false, blank: true });
 68:     return lines;
 69:   }
 70: 
 71:   if (context === 'shop' && shop) {
 72:     const price = itemValue(item, 0);
 73:     const taxed = withTax(price, shop.taxRate);
 74:     lines.push({
 75:       text:
 76:         shop.taxRate > 0
 77:           ? t('shop.priceTaxed', { taxed: zen(taxed), base: zen(price) })
 78:           : t('shop.price', { amount: zen(price) }),
 79:       color,
 80:       bold: false,
 81:     });
 82:   } else if (context === 'inventory' && shop && !isSellingBanned(item)) {
 83:     lines.push({
 84:       text: t('shop.sellPrice', { amount: zen(itemValue(item, 1)) }),
 85:       color,
 86:       bold: false,
 87:     });
 88:   }
 89: 
 90:   if (context === 'inventory' && Store.repairMode && !isRepairBanned(item)) {
 91:     const cost = needsRepair(item) ? repairCost(item, Store.isSelfRepair) : 0;
 92:     lines.push({ text: t('shop.repairCost', { amount: zen(cost) }), color, bold: true });
 93:   }
 94: 
 95:   if (lines.length > 0) lines.push({ text: '', color, bold: false, blank: true });
 96: 
 97:   return lines;
 98: }
 99: 
100: // ---- pets (`giPetManager::RenderPetItemInfo`) ------------------------------
101: 
102: /** Item indexes of group 13 that are pets with a level: 4 Dark Horse, 5 Dark Raven. */
103: const PET_ITEM_TYPE: Readonly<Record<number, PetTypeEnum>> = {
104:   4: PetTypeEnum.DarkHorse,
105:   5: PetTypeEnum.DarkRaven,
106: };
107: /** `debouncedPetInfoRequest`: one `PetInfoRequest` a second per slot. */
108: const PET_INFO_REQUEST_INTERVAL_MS = 1000;
109: /** `m_wLife` is durability as life, out of 255 (`GlobalText[358]`). */
110: const PET_MAX_LIFE = 255;
111: const lastPetInfoRequest = new Map<number, number>();
112: 
113: function petTypeOf(item: Item): PetTypeEnum | undefined {
114:   return item.group === PET_GROUP ? PET_ITEM_TYPE[item.num] : undefined;
115: }
116: 
117: /** The pet's level / experience / life once `PetInfoResponse` answered for this slot. */
118: function petLines(pet: PetTypeEnum, slot: number): TooltipLine[] {
119:   const info = Store.petInfo;
120:   if (!info || info.pet !== pet || info.slot !== slot) return [];
121:   return [
122:     { text: '\n', color: 'white', bold: false, blank: true },
123:     { text: t('petInfo.tipLevel', { level: info.level }), color: 'white', bold: false },
124:     {
125:       text: t('petInfo.tipExperience', {
126:         value: info.experience.toLocaleString('en-US'),
127:       }),
128:       color: 'white',
129:       bold: false,
130:     },
131:     {
132:       text: t('petInfo.tipLife', {
133:         current: Math.min(info.health, PET_MAX_LIFE),
134:         max: PET_MAX_LIFE,
135:       }),
136:       color: 'white',
137:       bold: false,
138:     },
139:   ];
140: }
141: 
142: // ---- compare with the worn item -------------------------------------------
143: 
144: /** Shift, watched only while the option is the Hold Shift step. */
145: function useShiftHeld(enabled: boolean): boolean {
146:   const [held, setHeld] = useState(false);
147: 
148:   useEffect(() => {
149:     if (!enabled) return;
150: 
151:     const update = (event: KeyboardEvent) => setHeld(event.shiftKey);
152:     const clear = () => setHeld(false);
153: 
154:     window.addEventListener('keydown', update);
155:     window.addEventListener('keyup', update);
156:     window.addEventListener('blur', clear);
157: 
158:     return () => {
159:       window.removeEventListener('keydown', update);
160:       window.removeEventListener('keyup', update);
161:       window.removeEventListener('blur', clear);
162:     };
163:   }, [enabled]);
164: 
165:   // Never cleared on the way out: the mask below is what the caller reads.
166:   return enabled && held;
167: }
168: 
169: function tooltipRows(lines: TooltipLine[]) {
170:   return lines.map((line, index) =>
171:     line.blank ? (
172:       <div key={index} className="mu-item-tooltip-gap" />
173:     ) : (
174:       <div
175:         key={index}
176:         className={`mu-item-tooltip-line color-${line.color}${
177:           line.bold ? ' bold' : ''
178:         }`}
179:       >
180:         {line.text}
181:         {!!line.delta && (
182:           <span className={`mu-item-tooltip-delta color-${line.delta.color}`}>
183:             {line.delta.text}
184:           </span>
185:         )}
186:       </div>
187:     )
188:   );
189: }
190: 
191: /**
192:  * `RenderItemInfo` + `RenderTipTextList`: the black 80% box with the
193:  * coloured text lines, centred on the cursor's x and hanging below it, kept
194:  * inside the viewport. Portalled onto the body so no window clips it.
195:  *
196:  * With `compareTooltips` on, a second box of the same kind stands beside it
197:  * with the worn item of the slot this one would take.
198:  *
199:  * `x` / `y` are only the *initial* cursor position: once mounted the box
200:  * follows the pointer itself through a `transform`, so the grid that owns
201:  * it re-renders when the hovered item changes, not per pointer move. The
202:  * text (`buildItemTooltip`, ~40 lines of stat maths) is memoised on the
203:  * item's fields and the hero's stats.
204:  */
205: export const ItemTooltip = observer(
206:   ({
207:     item,
208:     x,
209:     y,
210:     context = 'inventory',
211:     price,
212:     slot,
213:   }: {
214:     item: Item;
215:     x: number;
216:     y: number;
217:     context?: TooltipContext;
218:     price?: number;
219:     /** Inventory slot the item sits in (pets ask the server by slot). */
220:     slot?: number;
221:   }) => {
222:     const ref = useRef<HTMLDivElement>(null);
223:     const wornRef = useRef<HTMLDivElement>(null);
224:     const size = useRef({ width: 0, height: 0 });
225:     const wornSize = useRef({ width: 0, height: 0 });
226:     const cursor = useRef({ x, y });
227: 
228:     const shiftHeld = useShiftHeld(
229:       Math.round(GameOptions.compareTooltips) === CompareTooltips.HoldShift
230:     );
231:     const worn = compareTooltipsOn(shiftHeld)
232:       ? comparedItem(item, Store.playerData.items, Store.heroStats())
233:       : null;
234: 
235:     // Every field an item can change is part of the stamp, so a +1 or a
236:     // durability tick rebuilds and anything else reuses the lines.
237:     const hero = heroStats();
238:     const itemStamp = JSON.stringify(item);
239:     const heroStamp = JSON.stringify(hero);
240:     const wornStamp = worn ? JSON.stringify(worn) : '';
241:     const data = useMemo(
242:       () => buildItemTooltip(item, hero, worn),
243:       // eslint-disable-next-line react-hooks/exhaustive-deps
244:       [itemStamp, heroStamp, wornStamp]
245:     );
246: 
247:     const wornLines = useMemo(() => {
248:       const built = worn ? buildItemTooltip(worn, hero) : null;
249:       if (!built) return null;
250:       return [
251:         { text: t('item.equipped'), color: 'gray', bold: false },
252:         { text: '', color: 'white', bold: false, blank: true },
253:         ...built.lines,
254:       ] as TooltipLine[];
255:       // eslint-disable-next-line react-hooks/exhaustive-deps
256:     }, [wornStamp, heroStamp]);
257: 
258:     const pet = context === 'inventory' ? petTypeOf(item) : undefined;
259:     const petSlot =
260:       pet === undefined ? -1 : slot ?? Store.playerData.items.indexOf(item);
261: 
262:     // ZzzInventory.cpp:2116: hovering a Dark Horse / Raven asks the server for its stats.
263:     useEffect(() => {
264:       if (pet === undefined || petSlot < 0) return;
265:       const now = performance.now();
266:       if (now - (lastPetInfoRequest.get(petSlot) ?? -Infinity) < PET_INFO_REQUEST_INTERVAL_MS) return;
267:       lastPetInfoRequest.set(petSlot, now);
268:       Store.requestPetInfo(pet, petSlot);
269:     }, [pet, petSlot]);
270: 
271:     const lines = useMemo(() => {
272:       if (!data) return null;
273:       const [name, ...rest] = data.lines;
274:       const all = name
275:         ? [name, ...priceLines(item, context, name.color, price), ...rest]
276:         : [...data.lines];
277:       if (pet !== undefined && petSlot >= 0) all.push(...petLines(pet, petSlot));
278:       return all;
279:       // Tracked observables (shop, repair mode, pet info) re-run the observer,
280:       // and the stamps cover the item itself.
281:       // eslint-disable-next-line react-hooks/exhaustive-deps
282:     }, [data, context, price, pet, petSlot, Store.npcShop, Store.repairMode, Store.petInfo]);
283: 
284:     const move = (clientX: number, clientY: number) => {
285:       cursor.current = { x: clientX, y: clientY };
286:       const box = ref.current;
287:       if (!box) return;
288:       const second = wornRef.current;
289:       const spot = placePair(
290:         clientX,
291:         clientY,
292:         size.current,
293:         second ? wornSize.current : null,
294:         { width: window.innerWidth, height: window.innerHeight }
295:       );
296:       box.style.transform = `translate(${spot.primary.left}px, ${spot.primary.top}px)`;
297:       if (second && spot.second) {
298:         second.style.transform = `translate(${spot.second.left}px, ${spot.second.top}px)`;
299:       }
300:     };
301: 
302:     // Measure once per content change (the one layout read), then place.
303:     useLayoutEffect(() => {
304:       const box = ref.current;
305:       if (!box) return;
306:       const rect = box.getBoundingClientRect();
307:       size.current = { width: rect.width, height: rect.height };
308: 
309:       const second = wornRef.current;
310:       const wornRect = second?.getBoundingClientRect();
311:       wornSize.current = wornRect
312:         ? { width: wornRect.width, height: wornRect.height }
313:         : { width: 0, height: 0 };
314: 
315:       move(cursor.current.x, cursor.current.y);
316:       // eslint-disable-next-line react-hooks/exhaustive-deps
317:     }, [lines, wornLines]);
318: 
319:     // The initial position from the props, then the pointer itself.
320:     useLayoutEffect(() => {
321:       move(x, y);
322:       // eslint-disable-next-line react-hooks/exhaustive-deps
323:     }, [x, y]);
324: 
325:     useEffect(() => {
326:       let frame = 0;
327:       let pending: { x: number; y: number } | null = null;
328:       const onMove = (event: PointerEvent) => {
329:         pending = { x: event.clientX, y: event.clientY };
330:         if (frame) return;
331:         frame = requestAnimationFrame(() => {
332:           frame = 0;
333:           if (pending) move(pending.x, pending.y);
334:         });
335:       };
336:       window.addEventListener('pointermove', onMove);
337:       return () => {
338:         window.removeEventListener('pointermove', onMove);
339:         if (frame) cancelAnimationFrame(frame);
340:       };
341:       // eslint-disable-next-line react-hooks/exhaustive-deps
342:     }, []);
343: 
344:     if (!lines) return null;
345: 
346:     return createPortal(
347:       <>
348:         <div ref={ref} className="mu-item-tooltip">
349:           {tooltipRows(lines)}
350:         </div>
351:         {!!wornLines && (
352:           <div ref={wornRef} className="mu-item-tooltip">
353:             {tooltipRows(wornLines)}
354:           </div>
355:         )}
356:       </>,
357:       document.body
358:     );
359:   }
360: );
</file>

