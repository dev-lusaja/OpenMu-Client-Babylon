 6: /**
 7:  * `LoginScene::Render` in tour mode (Scenes/LoginScene.cpp:410-421): the glow
 8:  * `MU-logo_g.jpg` then `MU-logo.tga`, both 256×128 drawn at 0.8 - so
 9:  * 204.8×102.4 - centred on x 320, y 25 of the 640×480 stage, fading in by 0.02
10:  * a frame (`g_fMULogoAlpha`), about 0.8 s at 60 fps.
11:  *
12:  * Which art, and how big, is the version's answer (`pregame.logo`): the
13:  * wordmark art moved between versions and 0.97d has no separate glow sheet.
14:  *
15:  * Shared: the start menu and the login window both crown themselves with it.
16:  */
17: 
18: const LOGO_TOP = 25;
19: 
20: export const MuLogo = ({ top = LOGO_TOP }: { top?: number }) => {
21:   const stageScale = useUiStageScale();
22:   const ui = useVersionUi();
23:   // The glow is a JPEG (no alpha) the original draws additively. CSS blending
24:   // cannot reach the WebGL canvas through the overlay's stacking context, so
25:   // the JPEG masks itself by luminance: black surround → transparent.
26:   const logoGlow = useMuSprite(ui?.pregame.logo.glow);
27: 
28:   if (!ui) return null;
29: 
30:   const logo = ui.pregame.logo;
31: 
32:   return (
33:     <div
34:       className="mu-logo"
35:       style={{
36:         top: top * stageScale,
37:         width: logo.width * stageScale,
38:         height: logo.height * stageScale,
39:       }}
40:     >
41:       {logoGlow && (
42:         <div
43:           className={logo.mark ? 'mu-logo-glow' : 'mu-logo-glow is-only'}
44:           style={{
45:             backgroundImage: `url(${logoGlow.url})`,
46:             WebkitMaskImage: `url(${logoGlow.url})`,
47:             maskImage: `url(${logoGlow.url})`,
48:           }}
49:         />
50:       )}
51:       {logo.mark && <MuSprite file={logo.mark} className="mu-logo-mark" />}
52:     </div>
53:   );
54: };
