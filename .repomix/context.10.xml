 21: import { ModerationTab } from './tabs/moderation';
 22: import { EventsTab } from './tabs/events';
 23: import { ConsoleTab } from './tabs/console';
 24: 
 25: /**
 26:  * The game master panel (documentation/admin_console/ARCHITECTURE.md): one
 27:  * window, a sidebar of tabs, and the server as the proxy's tracker sees it.
 28:  *
 29:  * Everything it sends is a `/line` a game master could type
 30:  * (`common/gmCommands.ts` -> `gmPanel.ts` -> `Social.sendChat`). The panel
 31:  * grants nothing; the server re-checks `CharacterStatus` on every command it
 32:  * receives, so hiding this from a normal player is presentation, not security.
 33:  * What it *shows* of other players comes from the proxy's stream
 34:  * (`admin/feed.ts`), which the proxy only opens for a socket whose character
 35:  * the server flagged as a game master.
 36:  *
 37:  * Not the original's window chrome, on purpose: that art is fixed-size, and
 38:  * this is an instrument with tables, a map and a log. It still joins
 39:  * `MuWindows`, so Escape closes it before the windows underneath and the
 40:  * z-order stays honest. F8 toggles it, and there is a plate for the people
 41:  * who do not know that. Game masters only: everybody else renders null.
 42:  */
 43: 
 44: const WINDOW_ID = 'gm-panel';
 45: 
 46: const TOGGLE_KEY = 'F8';
 47: 
 48: /**
 49:  * How often the game master's own position is re-read while the panel is
 50:  * open. `transform.pos` is written every frame and is not observable, so it
 51:  * is polled - only while open, and only this one dot.
 52:  */
 53: const POLL_MS = 250;
 54: 
 55: /** How long after a send the footer keeps showing the server's answers. */
 56: const REPLY_WINDOW_MS = 20_000;
 57: 
 58: const MAX_REPLIES = 4;
 59: 
 60: /**
 61:  * The server's answers. A command replies with a blue message
 62:  * (`ShowBlueMessageAsync` -> `ServerMessage` type 1), which already lands in
 63:  * the chat log as a system line, so those are read back from there rather than
 64:  * counted twice. A refused command replies with nothing at all, which is why
 65:  * what was sent is listed beside them.
 66:  */
 67: const Transcript = observer(() => {
 68:   if (GmPanel.sent.length === 0 && !GmPanel.error) return null;
 69: 
 70:   const since = GmPanel.sent[GmPanel.sent.length - 1]?.at ?? 0;
 71:   const cutoff = Math.max(since, Date.now() - REPLY_WINDOW_MS);
 72: 
 73:   const replies = Social.chatLines
 74:     .filter(line => line.type === ChatLineType.System && line.at >= cutoff)
 75:     .slice(-MAX_REPLIES);
 76: 
 77:   return (
 78:     <footer className="gm-foot">
 79:       {GmPanel.error ? <p className="gm-error">{GmPanel.error}</p> : null}
 80:       {GmPanel.sent.length > 0 ? (
 81:         <div className="gm-foot-row">
 82:           <span className="gm-foot-label">{t('gm.transcript.sent')}</span>
 83:           <ul className="gm-foot-lines">
 84:             {GmPanel.sent.slice(-3).map(entry => (
 85:               <li key={entry.id}>
 86:                 <code>{entry.line}</code>
 87:               </li>
 88:             ))}
 89:           </ul>
 90:         </div>
 91:       ) : null}
 92:       {replies.length > 0 ? (
 93:         <div className="gm-foot-row">
 94:           <span className="gm-foot-label">{t('gm.transcript.serverSaid')}</span>
 95:           <ul className="gm-foot-lines gm-replies">
 96:             {replies.map(line => (
 97:               <li key={line.id}>{line.text}</li>
 98:             ))}
 99:           </ul>
100:         </div>
101:       ) : null}
102:     </footer>
103:   );
104: });
105: 
106: /**
107:  * The way in. A function key alone is undiscoverable - a game master logging in
108:  * would have to be told the panel exists - so there is a plate as well, in the
109:  * top right where nothing else lives.
110:  */
111: const GmTab = observer(() => {
112:   if (!GmPanel.available) return null;
113: 
114:   return (
115:     <button
116:       type="button"
117:       className={`gm-tab-plate${GmPanel.open ? ' is-active' : ''}`}
118:       title={t('gm.tabHint', { key: TOGGLE_KEY })}
119:       onClick={uiClick(() => GmPanel.toggle())}
120:     >
121:       {t('gm.tabPlate')}
122:     </button>
123:   );
124: });
125: 
126: const FeedStatus = observer(() => {
127:   const status = AdminFeed.status;
128:   let text: string;
129:   switch (status) {
130:     case 'open':
131:       text = t('gm.feed.live');
132:       break;
133:     case 'connecting':
134:       text = t('gm.feed.connecting');
135:       break;
136:     case 'refused':
137:       text =
138:         AdminFeed.reason === 'not-gm'
139:           ? t('gm.feed.refusedGm')
140:           : AdminFeed.reason === 'origin'
141:             ? t('gm.feed.refusedOrigin')
142:             : t('gm.feed.refusedSession');
143:       break;
144:     case 'closed':
145:       text = t('gm.feed.closed');
146:       break;
147:     case 'error':
148:       text = t('gm.feed.offline');
149:       break;
150:     default:
151:       text = '';
152:   }
153: 
154:   return (
155:     <span className={`gm-feed gm-feed-${status}`} title={text}>
156:       <i className="gm-feed-dot" />
157:       {text}
158:     </span>
159:   );
160: });
161: 
162: const Tab = observer(({ view }: { view: WorldView }) => {
163:   switch (GmPanel.section) {
164:     case 'live':
165:       return <LiveTab view={view} />;
166:     case 'map':
167:       return <MapTab view={view} />;
168:     case 'logs':
169:       return <LogsTab />;
170:     case 'skins':
171:       return <SkinsTab />;
172:     case 'spawn':
173:       return <SpawnTab view={view} />;
174:     case 'character':
175:       return <CharacterTab />;
176:     case 'moderation':
177:       return <ModerationTab />;
178:     case 'events':
179:       return <EventsTab view={view} />;
180:     case 'console':
181:       return <ConsoleTab />;
182:   }
183: });
184: 
185: const SideButton = observer(({ id, active, onPick }: { id: GmSection; active: boolean; onPick: () => void }) => {
186:   const entry = GM_SECTIONS.find(s => s.id === id) ?? GM_SECTIONS[0];
187:   const badge = id === 'live' && AdminFeed.status === 'open' ? AdminFeed.inWorldCount : null;
188: 
189:   return (
190:     <button
191:       type="button"
192:       className={`gm-side-btn${active ? ' is-active' : ''}`}
193:       title={t(entry.hintKey)}
194:       onClick={uiClick(onPick)}
195:     >
196:       <TabIcon id={id} />
197:       <span className="gm-side-label">{t(entry.titleKey)}</span>
198:       {badge !== null && badge > 0 ? <span className="gm-side-badge">{badge}</span> : null}
199:     </button>
200:   );
201: });
202: 
203: export const GmPanelWindow = observer(() => {
204:   const open = GmPanel.available && GmPanel.open;
205:   const [view, setView] = useState<WorldView>(() => worldView());
206: 
207:   useEventBus('keyPressed', key => {
208:     if (!GmPanel.available) return;
209:     if (key === TOGGLE_KEY) GmPanel.toggle();
210:   });
211: 
212:   // Joins the window stack while open: Escape closes this before the windows
213:   // underneath, and `zIndexOf` keeps it ordered with them.
214:   useEffect(() => {
215:     if (!open) return;
216: 
217:     MuWindows.register(WINDOW_ID, undefined, () => {
218:       GmPanel.close();
219:       return true;
220:     });
221:     MuWindows.raise(WINDOW_ID);
222: 
223:     return () => MuWindows.unregister(WINDOW_ID);
224:   }, [open]);
225: 
226:   // The stream is open exactly as long as the panel is.
227:   useEffect(() => {
228:     if (!open) return;
229:     AdminFeed.start();
230:     return () => AdminFeed.stop();
231:   }, [open]);
232: 
233:   useEffect(() => {
234:     if (!open) return;
235: 
236:     setView(worldView());
237:     const timer = setInterval(() => setView(worldView()), POLL_MS);
238:     return () => clearInterval(timer);
239:   }, [open]);
240: 
241:   if (!GmPanel.available) return null;
242:   if (!open) return <GmTab />;
243: 
244:   const section = GM_SECTIONS.find(s => s.id === GmPanel.section) ?? GM_SECTIONS[0];
245: 
246:   return (
247:     <>
248:       <GmTab />
249:       <div
250:         className="gm-window"
251:         style={{ zIndex: MuWindows.zIndexOf(WINDOW_ID) }}
252:         aria-label={t('gm.title')}
253:         onPointerDown={() => MuWindows.raise(WINDOW_ID)}
254:       >
255:         <aside className="gm-side">
256:           <div className="gm-brand">
257:             <span className="gm-brand-mark">GM</span>
258:             <span className="gm-brand-text">
259:               <b>{t('gm.title')}</b>
260:               <FeedStatus />
261:             </span>
262:           </div>
263: 
264:           <nav className="gm-side-nav" aria-label={t('gm.sections')}>
265:             {GM_SECTIONS.map(entry => (
266:               <SideButton
267:                 key={entry.id}
268:                 id={entry.id}
269:                 active={entry.id === section.id}
270:                 onPick={() => GmPanel.setSection(entry.id)}
271:               />
272:             ))}
273:           </nav>
274: 
275:           <div className="gm-side-foot">
276:             {view.hero ? (
277:               <span className="gm-side-where">
278:                 <b>{mapName(view.hero.map)}</b>
279:                 <span className="gm-mono">
280:                   {view.hero.x}, {view.hero.y}
281:                 </span>
282:               </span>
283:             ) : (
284:               <span className="gm-side-where">{t('gm.notInWorld')}</span>
285:             )}
286:             <span className="gm-side-key">{t('gm.keyToClose', { key: TOGGLE_KEY })}</span>
287:           </div>
288:         </aside>
289: 
290:         <div className="gm-main">
291:           <header className="gm-top">
292:             <div className="gm-top-title">
293:               <h2>{t(section.titleKey)}</h2>
294:               <p>{t(section.hintKey)}</p>
295:             </div>
296: 
297:             <input
298:               className="gm-search gm-top-search"
299:               type="search"
300:               value={GmPanel.search}
301:               placeholder={t('gm.live.searchPlayers')}
302:               spellCheck={false}
303:               autoComplete="off"
304:               onChange={e => GmPanel.setSearch(e.target.value)}
305:             />
306: 
307:             <span className={`gm-target-chip${GmPanel.target ? ' is-set' : ''}`}>
308:               {GmPanel.target ? (
