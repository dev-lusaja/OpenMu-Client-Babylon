 1: import './style.less';
 2: import { useState } from 'react';
 3: import { itemDisplayName } from '../../../common/itemTooltip';
 4: import { t } from '../../../i18n';
 5: import type { Item } from '../../../ecs/world';
 6: 
 7: /**
 8:  * The find box over an item grid: type a few letters and everything that
 9:  * does not match dims. Nothing is hidden or moved - the grid is the
10:  * server's layout - so a search is only ever a way of looking at it.
11:  *
12:  * `useItemSearch` owns the query; the box draws it and `matcher` is what a
13:  * grid passes to `dimmed`.
14:  */
15: 
16: export type ItemSearch = {
17:   query: string;
18:   setQuery: (value: string) => void;
19:   /** True while something is typed: the grid should dim non-matches. */
20:   active: boolean;
21:   matches: (item: Item) => boolean;
22: };
23: 
24: export function itemMatchesQuery(item: Item, query: string): boolean {
25:   const needle = query.trim().toLowerCase();
26:   if (!needle) return true;
27:   return itemDisplayName(item).toLowerCase().includes(needle);
28: }
29: 
30: export function useItemSearch(): ItemSearch {
31:   const [query, setQuery] = useState('');
32:   return {
33:     query,
34:     setQuery,
35:     active: query.trim().length > 0,
36:     matches: item => itemMatchesQuery(item, query),
37:   };
38: }
39: 
40: export const ItemSearchBox = ({
41:   search,
42:   left,
43:   top,
44:   width,
45: }: {
46:   search: ItemSearch;
47:   left: number;
48:   top: number;
49:   width: number;
50: }) => (
51:   <input
52:     className="item-search"
53:     data-no-drag="true"
54:     type="text"
55:     spellCheck={false}
56:     value={search.query}
57:     placeholder={t('search.placeholder')}
58:     title={t('search.hint')}
59:     style={{ left, top, width }}
60:     onChange={event => search.setQuery(event.target.value)}
61:     onKeyDown={event => {
62:       if (event.key === 'Escape') {
63:         event.stopPropagation();
64:         search.setQuery('');
65:         (event.target as HTMLInputElement).blur();
66:       }
67:     }}
68:   />
69: );
</file>

