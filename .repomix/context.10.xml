 31:     .sort((a, b) => b[1].length - a[1].length || a[0] - b[0]);
 32:   const populatedSet = new Set(populated.map(([number]) => number));
 33:   const rest = GM_MAPS.filter(entry => !populatedSet.has(entry.number));
 34: 
 35:   const pick = (player: TrackedPlayer) => {
 36:     GmPanel.selectPlayer(player.id === GmPanel.selectedPlayerId ? null : player.id);
