<file path="src/ui/components/loadingScreen/style.less">
  1: .loading-screen {
  2:   position: absolute;
  3:   inset: 0;
  4:   overflow: hidden;
  5: 
  6:   // Opaque and above everything: the whole point is that nothing behind it is
  7:   // visible until the scene is finished.
  8:   background: #000;
  9:   z-index: 100;
 10: 
 11:   // Swallow clicks so a button underneath can't be hit through the screen.
 12:   pointer-events: auto;
 13: }
 14: 
 15: .loading-art {
 16:   position: absolute;
 17:   left: 50%;
 18:   top: 50%;
 19:   transform: translate(-50%, -50%);
 20: }
 21: 
 22: // The copy behind the readable one, scaled to cover and blurred. Fills a
 23: // widescreen window without cropping the map or leaving black bars, and echoes
 24: // the blurred backdrop the artwork already has baked into it.
 25: .loading-art-blur {
 26:   filter: blur(28px) brightness(0.45) saturate(0.8);
 27: 
 28:   // Blur samples past the element's edge and fades out there, which would show
 29:   // as a bright rim against the black. Overscaling pushes that rim off screen.
 30:   transform: translate(-50%, -50%) scale(1.12);
 31: }
 32: 
 33: // Centres with grid rather than `translateX(-50%)` on purpose. A transform
 34: // creates a stacking context, which isolates blending - the glow inside would
 35: // then composite against this wrapper instead of the artwork behind it.
 36: .loading-bar-wrap {
 37:   position: absolute;
 38:   left: 0;
 39:   right: 0;
 40:   bottom: 9%;
 41:   display: grid;
 42:   place-items: center;
 43: }
 44: 
 45: // Both layers share one grid cell so they sit exactly on top of each other.
 46: .loading-bar-wrap > * {
 47:   grid-area: 1 / 1;
 48: }
 49: 
 50: // The light the bar throws onto the map. Blurred well past the bar's own
 51: // edges, additive, and outside the bar's isolated group so it actually
 52: // reaches the artwork.
 53: .loading-bar-glow {
 54:   position: relative;
 55:   mix-blend-mode: screen;
 56:   filter: blur(9px);
 57:   pointer-events: none;
 58: }
 59: 
 60: .loading-bar-glow-fill {
 61:   position: absolute;
 62:   left: 0;
 63:   top: 0;
 64:   height: 100%;
 65:   background: linear-gradient(
 66:     90deg,
 67:     rgba(255, 186, 64, 0.5) 0%,
 68:     rgba(255, 214, 120, 0.7) 70%,
 69:     rgba(255, 240, 190, 0.95) 100%
 70:   );
 71:   transition: width 0.25s ease-out;
 72: }
 73: 
 74: .loading-bar {
 75:   position: relative;
 76: 
 77:   // Keeps the fill's blend inside the bar, so it lights up the bronze trough
 78:   // instead of punching through to the map. The trough itself stays opaque -
 79:   // blending it as well washed it out against the parchment and the bar lost
 80:   // its background.
 81:   isolation: isolate;
 82: }
 83: 
 84: // Clips the fill sprite rather than scaling it, so the art keeps its
 85: // proportions as the bar grows.
 86: .loading-bar-fill {
 87:   position: absolute;
 88:   left: 0;
 89:   top: 0;
 90:   height: 100%;
 91:   overflow: hidden;
 92: 
 93:   // Additive, within the bar's group. `Progress.OZJ` is a gold line on black;
 94:   // screen makes the black vanish and the gold glow over the trough, which is
 95:   // how the original draws it. Without this the fill is a black slab - which
 96:   // is exactly what it looked like.
 97:   mix-blend-mode: screen;
 98: 
 99:   // Only the leading edge moves per frame, so animating the width directly
100:   // would step visibly at low progress.
101:   transition: width 0.25s ease-out;
102: }
103: 
104: .loading-bar-shimmer {
105:   position: absolute;
106:   inset: 0;
107:   background: linear-gradient(
108:     90deg,
109:     transparent 0%,
110:     rgba(255, 232, 160, 0) 35%,
111:     rgba(255, 240, 190, 0.75) 50%,
112:     rgba(255, 232, 160, 0) 65%,
113:     transparent 100%
114:   );
115:   mix-blend-mode: screen;
116:   animation: loading-bar-sweep 1.5s linear infinite;
117: }
118: 
119: @keyframes loading-bar-sweep {
120:   from {
121:     transform: translateX(-100%);
122:   }
123:   to {
124:     transform: translateX(100%);
125:   }
126: }
127: 
128: // Respect the OS setting - a looping sweep is exactly the kind of motion this
129: // is meant to suppress.
130: @media (prefers-reduced-motion: reduce) {
131:   .loading-bar-shimmer {
132:     animation: none;
133:   }
134: }
</file>

