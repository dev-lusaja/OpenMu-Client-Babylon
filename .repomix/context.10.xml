<file path="src/ui/components/gmPanel/commands.test.ts">
 1: import { describe, expect, it } from 'vitest';
 2: import { readFileSync, readdirSync } from 'node:fs';
 3: import { join } from 'node:path';
 4: import { fileURLToPath } from 'node:url';
 5: import { GM_COMMANDS, gmCommand } from '../../../common/gmCommands';
 6: import { GM_MAPS } from '../../../common/gmMaps';
 7: 
 8: /**
 9:  * The panel's screens name the commands they send as strings, and a name that
10:  * is not in the catalogue throws when the screen renders - which is to say, in
11:  * front of a game master, in the middle of a job.
12:  *
13:  * This reads the names back out of the source and resolves every one. It is
14:  * the check that catches a command being dropped from the catalogue while a
15:  * screen still calls for it, which is exactly how `/move` broke once: it was
16:  * removed for being gated at Normal rather than GameMaster, and the Travel
17:  * screen went on asking for it.
18:  */
19: 
20: const HERE = fileURLToPath(new URL('.', import.meta.url));
21: 
22: // The tabs live one folder down; a screen moved there must stay covered.
23: const sources = [HERE, join(HERE, 'tabs')].flatMap(dir =>
24:   readdirSync(dir)
25:     .filter(name => /\.tsx?$/.test(name) && !/\.test\.tsx?$/.test(name))
26:     .map(name => readFileSync(join(dir, name), 'utf8'))
27: );
28: 
29: const referenced = [
30:   ...new Set(
31:     sources.flatMap(source =>
32:       [...source.matchAll(/gmCommand\(\s*['"]([^'"]+)['"]\s*\)/g)].map(match => match[1])
33:     )
34:   ),
35: ].sort();
36: 
37: describe('the commands the panel names', () => {
38:   it('finds some at all, or this test is checking nothing', () => {
39:     expect(referenced.length).toBeGreaterThan(20);
40:   });
41: 
42:   it('resolves every one against the catalogue', () => {
43:     const missing = referenced.filter(name => !GM_COMMANDS.some(c => c.command === name));
44:     expect(missing).toEqual([]);
45:   });
46: 
47:   it('resolves them through gmCommand without throwing', () => {
48:     for (const name of referenced) {
49:       expect(() => gmCommand(name)).not.toThrow();
50:     }
51:   });
52: 
53:   it('refuses a name that is not a command', () => {
54:     expect(() => gmCommand('/nonesuch')).toThrow(/unknown game master command/);
55:   });
56: });
57: 
58: describe('the parameters the panel supplies', () => {
59:   /**
60:    * A screen that supplies a value under the wrong name silently sends the
61:    * command without it - the server then reads its arguments positionally and
62:    * acts on something else. `/move`'s map goes in `mapIdOrName`, not `map`;
63:    * its character in `target`, not `characterName`.
64:    */
65:   const overrideKeys = sources.flatMap(source =>
66:     [...source.matchAll(/overrides=\{\{([^}]*)\}\}/g)].flatMap(match =>
67:       [...match[1].matchAll(/([A-Za-z_$][\w$]*)\s*:/g)].map(key => key[1])
68:     )
69:   );
70: 
71:   it('only names parameters some command actually declares', () => {
72:     const known = new Set(
73:       GM_COMMANDS.flatMap(command => (command.params ?? []).map(param => param.name))
74:     );
75:     const unknown = [...new Set(overrideKeys)].filter(key => !known.has(key));
76:     expect(unknown).toEqual([]);
77:   });
78: });
79: 
80: describe('the map picker', () => {
81:   it('has no duplicate map numbers', () => {
82:     const numbers = GM_MAPS.map(map => map.number);
83:     expect(new Set(numbers).size).toBe(numbers.length);
84:   });
85: 
86:   it('names every map', () => {
87:     for (const map of GM_MAPS) {
88:       expect(map.name.trim()).not.toBe('');
89:       expect(map.number).toBeGreaterThanOrEqual(0);
90:     }
91:   });
92: });
</file>

