<file path="src/ui/components/itemIcon/index.tsx">
 1: import { memo, useEffect, useState } from 'react';
 2: import { observer } from 'mobx-react-lite';
 3: import type { Item } from '../../../ecs/world';
 4: import { itemIconKey, itemIconPackChain } from '../../../common/itemIconPack';
 5: import { ITEM_ICON_FIT } from '../../../common/itemIconFit';
 6: 
 7: /**
 8:  * `<img fetchpriority>` is not a React 18 prop (it arrives with React 19), so
 9:  * it goes to the DOM as a plain lowercase attribute. High: an icon is what the
10:  * player is waiting on; the world's model / texture fetches are already high
11:  * and would otherwise starve it (see itemIconPack.ts).
12:  */
13: const IMG_PRIORITY = { fetchpriority: 'high' } as const;
14: 
15: /**
16:  * The pack renders every item at one world scale into a canvas sized by its
17:  * inventory footprint, so a small item covers a small part of its own PNG and
18:  * fitting that canvas to the square left a jewel a few pixels across. The
19:  * measured zoom (tools/itemIconFit.ts) blows the opaque box back up to the
20:  * square; the translate takes off the render's drift off centre first, since
21:  * the zoom is about the canvas centre and would scale that drift too.
22:  *
23:  * The zoom never overflows: it is capped by the canvas, and the canvas is
24:  * what `max-width/height: 100%` has already fitted into the box.
25:  */
26: function fitTransform(item: { group: number; num: number }): string | undefined {
27:   const fit = ITEM_ICON_FIT[`${item.group}_${item.num}`];
28:   if (!fit) return undefined;
29:   const [zoom, dx, dy] = fit;
30:   return `scale(${zoom}) translate(${dx * 100}%, ${dy * 100}%)`;
31: }
32: 
33: /**
34:  * An item's icon from the pre-rendered pack (itemIconPack.ts).
35:  *
36:  * An observer leaf taking the item itself: only the fields the file name
37:  * depends on (`itemIconKey`) are read here, so a durability tick or an
38:  * option change on one item re-renders nothing - the grid above passes the
39:  * same `item` reference and this memo skips. (The old `{...item}` spread
40:  * subscribed the whole grid to all fourteen fields of every item.)
41:  */
42: export const ItemIcon = memo(
43:   observer(function ItemIcon({ item }: { item: Item }) {
44:     const key = itemIconKey(item);
45:     /** Which URL of the pack chain is showing; past the end = no file at all. */
46:     const [fallbackStep, setFallbackStep] = useState(0);
47:     useEffect(() => {
48:       setFallbackStep(0);
49:     }, [key]);
50:     const chain = itemIconPackChain(item);
51: 
52:     if (fallbackStep >= chain.length) {
53:       return (
54:         <div
55:           className="item-icon item-icon-missing"
56:           title={`item ${item.group}/${item.num}`}
57:         />
58:       );
59:     }
60: 
61:     return (
62:       <img
63:         src={chain[fallbackStep]}
64:         className="item-icon"
65:         style={{ transform: fitTransform(item) }}
66:         alt=""
67:         draggable={false}
68:         decoding="async"
69:         {...IMG_PRIORITY}
70:         onError={() => setFallbackStep(step => step + 1)}
71:       />
72:     );
73:   })
74: );
</file>

