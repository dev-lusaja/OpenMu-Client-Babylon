  1: import { observer } from 'mobx-react-lite';
  2: import { Store } from '../../../store';
  3: import { useEffect, useMemo, useRef, useState } from 'react';
  4: import type { With } from 'miniplex';
  5: import { WorldLabel } from '../worldLabel';
  6: import { NameTags } from '../nameTags';
  7: import { PartyBars } from '../partyBars';
  8: import { EmojiBubbles } from '../emojiBubbles';
  9: import { useRenderId } from '../../../hooks';
