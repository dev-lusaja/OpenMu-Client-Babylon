139:         <p className="gm-hint">{t('gm.map.warpHint')}</p>
140: 
141:         {onThisMap.length > 0 ? (
142:           <ul className="gm-rows gm-maptab-players">
143:             {onThisMap.map(player => (
144:               <li
145:                 key={player.id}
