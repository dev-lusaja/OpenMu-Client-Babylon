30: 
31:   useEffect(() => {
32:     if (!active) {
33:       setDim(false);
34:       return;
35:     }
36:     const id = setInterval(() => setDim(d => !d), NOTICE_BLINK_MS);
37:     return () => clearInterval(id);
38:   }, [active]);
39: 
40:   return dim;
41: }
42: 
43: export const Notices = observer(() => {
44:   const lines = NoticeStore.lines;
45:   const anyBlinking = lines.some(line => NOTICE_STYLE[line.color]?.blink);
46:   const dim = useBlink(anyBlinking);
47: 
48:   if (lines.length === 0) return null;
49: 
50:   return (
51:     <div
52:       className="notices"
53:       style={{ top: `${(NOTICE_Y / UI_STAGE_HEIGHT) * 100}%` }}
54:     >
55:       {lines.map(line => {
56:         const style = NOTICE_STYLE[line.color] ?? NOTICE_STYLE[0];
57:         // The stack scrolls from the head: keyed by the line object, a
58:         // scroll moves nodes instead of re-propping every one of them.
59:         const key = stableKeyOf(line);
60:         if (line.text === '') {
61:           return <div key={key} className="notice-line" style={LINE_STYLE} />;
62:         }
63:         return (
64:           <div key={key} className="notice-line" style={LINE_STYLE}>
65:             <MuText
66:               face="bold"
67:               text={line.text}
68:               color={style.color}
69:               background={NOTICE_BACKGROUND}
70:               style={{
71:                 opacity: style.blink && dim ? 128 / 255 : 1,
72:                 transform: `scale(${SCALE})`,
73:                 transformOrigin: 'center top',
74:               }}
75:             />
76:           </div>
77:         );
78:       })}
79:     </div>
80:   );
81: });
</file>

