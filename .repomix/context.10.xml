  1: import {
  2:   useCallback,
  3:   useEffect,
  4:   useRef,
  5:   type CSSProperties,
  6:   type PointerEvent,
  7:   type Ref,
  8: } from 'react';
  9: import { observer } from 'mobx-react-lite';
 10: import { MuWindows, type WindowCloser } from './windowState';
 11: import { GameOptions } from '../../../common/gameOptions';
 12: import { t } from '../../../i18n';
 13: 
 14: export type WindowChrome = {
 15:   style: CSSProperties;
 16:   onPointerDown: (event: PointerEvent) => void;
 17:   /** Put on the window's root: joins the stack while the element is mounted. */
 18:   ref: Ref<HTMLElement>;
 19:   scale: number;
 20:   anchored: boolean;
 21: };
 22: 
 23: export type WindowChromeOptions = {
 24:   width: number;
 25:   height: number;
 26:   /** What Escape does while this is the top window. */
 27:   onClose?: WindowCloser;
 28: };
 29: 
 30: /**
 31:  * Membership of the window stack for something that draws its own chrome
 32:  * (the chat, the emote menu, a full-screen sheet). Registered while `open`,
 33:  * raised by `MuWindows.raise`, closed by Escape through `onClose`.
 34:  */
 35: export function useWindowStackEntry(
 36:   id: string,
 37:   open: boolean,
 38:   onClose?: WindowCloser
 39: ): void {
 40:   const closerRef = useRef(onClose);
 41:   closerRef.current = onClose;
 42:   const closer = useCallback<WindowCloser>(() => closerRef.current?.(), []);
 43: 
 44:   useEffect(() => {
 45:     if (!open) return;
 46:     MuWindows.register(id, undefined, closer);
 47:     return () => MuWindows.unregister(id);
 48:   }, [id, open, closer]);
 49: }
 50: 
 51: export function useWindowChrome(
 52:   id: string,
 53:   { width, height, onClose }: WindowChromeOptions
 54: ): WindowChrome {
 55:   const placement = MuWindows.placement(id);
 56:   const dragging = useRef<{
 57:     pointerId: number;
 58:     offsetX: number;
 59:     offsetY: number;
 60:   } | null>(null);
 61: 
 62:   const closerRef = useRef(onClose);
 63:   closerRef.current = onClose;
 64: 
 65:   // Mounted root = open window. A callback ref, not an effect, because some
 66:   // callers run this hook while closed (they return null after it).
 67:   const ref = useCallback(
 68:     (el: HTMLElement | null) => {
 69:       if (el) {
 70:         MuWindows.register(id, { width, height }, () => closerRef.current?.());
 71:       } else {
 72:         MuWindows.unregister(id);
 73:       }
 74:     },
 75:     [id, width, height]
 76:   );
 77: 
 78:   const onPointerDown = (event: PointerEvent) => {
 79:     MuWindows.raise(id);
 80: 
 81:     if (event.button !== 0 || GameOptions.lockWindows) return;
 82: 
 83:     const target = event.target as HTMLElement;
 84:     if (target.closest('[data-no-drag]')) return;
 85: 
 86:     const root = event.currentTarget as HTMLElement;
 87:     const rect = root.getBoundingClientRect();
 88: 
 89:     dragging.current = {
 90:       pointerId: event.pointerId,
 91:       offsetX: event.clientX - rect.left,
 92:       offsetY: event.clientY - rect.top,
 93:     };
 94: 
 95:     root.setPointerCapture(event.pointerId);
 96:     event.preventDefault();
 97: 
 98:     const onMove = (move: globalThis.PointerEvent) => {
 99:       const drag = dragging.current;
100:       if (!drag || move.pointerId !== drag.pointerId) return;
101:       // `moveTo` clamps to the viewport.
102:       MuWindows.moveTo(id, move.clientX - drag.offsetX, move.clientY - drag.offsetY);
103:     };
104: 
105:     const onUp = (up: globalThis.PointerEvent) => {
106:       if (dragging.current?.pointerId !== up.pointerId) return;
107: 
108:       dragging.current = null;
109:       root.releasePointerCapture(up.pointerId);
110:       root.removeEventListener('pointermove', onMove);
111:       root.removeEventListener('pointerup', onUp);
112:       root.removeEventListener('pointercancel', onUp);
113:     };
114: 
115:     root.addEventListener('pointermove', onMove);
116:     root.addEventListener('pointerup', onUp);
117:     root.addEventListener('pointercancel', onUp);
118:   };
119: 
120:   const anchored = placement.x === null || placement.y === null;
121: 
122:   // The saved scale capped so the whole window fits the viewport, so a
123:   // resized window can never leave the screen bounds.
124:   const scale = MuWindows.scaleOf(id);
125: 
126:   const style: CSSProperties = {
127:     width,
128:     height,
129:     zIndex: MuWindows.zIndexOf(id),
130:     transform: `scale(${scale})`,
131:     transformOrigin: anchored ? '100% 100%' : '0 0',
132:     ...(anchored ? {} : { left: placement.x!, top: placement.y!, right: 'auto', bottom: 'auto' }),
133:   };
134: 
135:   return { style, onPointerDown, ref, scale, anchored };
136: }
137: 
138: export const MuResizeGrip = observer(
139:   ({ id, width }: { id: string; width: number }) => {
140:     const start = useRef<{
141:       pointerId: number;
142:       x: number;
143:       scale: number;
144:     } | null>(null);
145: 
146:     const onPointerDown = (event: PointerEvent) => {
147:       if (event.button !== 0) return;
148: 
149:       const grip = event.currentTarget as HTMLElement;
150: 
151:       start.current = {
152:         pointerId: event.pointerId,
153:         x: event.clientX,
154:         scale: MuWindows.scaleOf(id),
155:       };
156: 
157:       grip.setPointerCapture(event.pointerId);
158:       event.preventDefault();
159:       event.stopPropagation();
160: 
161:       const onMove = (move: globalThis.PointerEvent) => {
162:         const from = start.current;
163:         if (!from || move.pointerId !== from.pointerId) return;
164: 
165:         MuWindows.setScale(id, from.scale + (move.clientX - from.x) / width);
166:       };
167: 
168:       const onUp = (up: globalThis.PointerEvent) => {
169:         if (start.current?.pointerId !== up.pointerId) return;
170: 
171:         start.current = null;
172:         grip.releasePointerCapture(up.pointerId);
173:         grip.removeEventListener('pointermove', onMove);
174:         grip.removeEventListener('pointerup', onUp);
175:         grip.removeEventListener('pointercancel', onUp);
176:       };
177: 
178:       grip.addEventListener('pointermove', onMove);
179:       grip.addEventListener('pointerup', onUp);
180:       grip.addEventListener('pointercancel', onUp);
181:     };
182: 
183:     if (GameOptions.lockWindows) return null;
184: 
185:     return (
186:       <div
187:         className="mu-resize-grip"
188:         data-no-drag="true"
189:         title={t('window.resizeHint')}
190:         onPointerDown={onPointerDown}
191:         onDoubleClick={() => MuWindows.reset(id)}
192:       />
193:     );
194:   }
195: );
</file>

