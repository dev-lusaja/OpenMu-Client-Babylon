<file path="src/ui/components/uiStage/index.ts">
 1: import { useSyncExternalStore } from 'react';
 2: 
 3: /**
 4:  * The original lays every widget out in a 640×480 space and stretches it to
 5:  * the window (`ConvertX` / `ConvertY`, `g_fScreenRate_x/y`). Full-screen
 6:  * sheets such as the minimap keep that space here and scale it uniformly by
 7:  * the smaller window ratio, so the art stays square on wide screens.
 8:  *
 9:  * One observer watches the canvas (the same rect
10:  * `calculateScreenPositionSystem` projects into, so the UI and the world
11:  * agree to the pixel even with a scrollbar) and every reader subscribes to
12:  * it, instead of a `resize` listener per hook call.
13:  */
14: 
15: export const UI_STAGE_WIDTH = 640;
16: export const UI_STAGE_HEIGHT = 480;
17: 
18: export type UiViewport = { width: number; height: number; scale: number };
19: 
20: type Listener = () => void;
21: 
22: const listeners = new Set<Listener>();
23: let viewport: UiViewport = measure();
24: let watching = false;
25: 
26: function stageElement(): HTMLElement | null {
27:   return typeof document === 'undefined' ? null : document.querySelector('canvas');
28: }
29: 
30: function measure(): UiViewport {
31:   const el = stageElement();
32:   const width = el?.clientWidth || (typeof window === 'undefined' ? UI_STAGE_WIDTH : window.innerWidth);
33:   const height = el?.clientHeight || (typeof window === 'undefined' ? UI_STAGE_HEIGHT : window.innerHeight);
34:   return {
35:     width,
36:     height,
37:     scale: Math.min(width / UI_STAGE_WIDTH, height / UI_STAGE_HEIGHT),
38:   };
39: }
40: 
41: function refresh(): void {
42:   const next = measure();
43:   if (
44:     next.width === viewport.width &&
45:     next.height === viewport.height &&
46:     next.scale === viewport.scale
47:   ) {
48:     return;
49:   }
50:   viewport = next;
51:   for (const listener of listeners) listener();
52: }
53: 
54: function watch(): void {
55:   if (watching || typeof window === 'undefined') return;
56:   watching = true;
57:   window.addEventListener('resize', refresh);
58:   const el = stageElement();
59:   if (el && typeof ResizeObserver !== 'undefined') {
60:     new ResizeObserver(refresh).observe(el);
61:   }
62: }
63: 
64: /** The stage's size and the 640×480 → screen ratio, as of the last resize. */
65: export function getUiViewport(): UiViewport {
66:   watch();
67:   return viewport;
68: }
69: 
70: export function getUiStageScale(): number {
71:   return getUiViewport().scale;
72: }
73: 
74: /** Called after every change of the stage's size; returns the unsubscribe. */
75: export function onUiViewportChanged(listener: Listener): () => void {
76:   watch();
77:   listeners.add(listener);
78:   return () => {
79:     listeners.delete(listener);
80:   };
81: }
82: 
83: export function useUiViewport(): UiViewport {
84:   return useSyncExternalStore(onUiViewportChanged, getUiViewport, getUiViewport);
85: }
86: 
87: export function useUiStageScale(): number {
88:   return useUiViewport().scale;
89: }
</file>

