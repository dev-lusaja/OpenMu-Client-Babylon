19: /** `new_Master_Icon` / its greyed copy: the master tree's own 512 sheet. */
20: const MASTER_SHEET = ['new_Master_Icon.OZJ', 'new_Master_non_Icon.OZJ'];
21: 
22: /**
23:  * A skill's icon, at the original's own size (`RenderSkillIcon`: a 20 x 28
24:  * cell of `newui_skill*.jpg`, never square). `disabled` is `bCantSkill` and
25:  * picks the shipped `newui_non_*` sheet, the way the original swaps the
26:  * texture id.
