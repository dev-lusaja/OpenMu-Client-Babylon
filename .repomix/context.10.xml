210:   return (
211:     <div
212:       className={`mu-grid-item${marked ? ' marked' : ''}${dimmed ? ' dimmed' : ''}`}
213:       style={{
214:         left: entry.column * SQUARE,
215:         top: entry.row * SQUARE,
216:         width: entry.w * SQUARE,
217:         height: entry.h * SQUARE,
218:       }}
219:     >
220:       <ItemIcon item={entry.item} />
221:       {price !== undefined && (
222:         <span className={`mu-grid-price${price > 0 ? '' : ' unset'}`}>
223:           {price > 0 ? price.toLocaleString('en-US') : '?'}
224:         </span>
225:       )}
226:     </div>
227:   );
228: });
