 10: import type { Entity } from '../../../ecs/world';
 11: import {
 12:   CHAT_FADE_TICKS,
 13:   CHAT_TEXT,
 14:   GM_BG,
 15:   GM_CHAT_TEXT,
 16:   GM_GUILD_TEXT,
 17:   GM_NAME_TEXT,
 18:   GuildRelation,
 19:   HERO_BG,
 20:   HERO_TEXT,
 21:   SELF_DEFENSE_COLOUR,
 22:   SHOP_TITLE_PREFIX,
 23:   chatLineBg,
 24:   guildLine,
 25:   pkTextColour,
 26:   relationStyle,
 27:   shopTitleColours,
 28:   shopTitleSummary,
 29:   unionLine,
 30: } from '../../../common/nameTags';
 31: import { Social } from '../../../social';
 32: import { guildMarkDataUrl, isEmptyGuildMark } from '../../../common/guildMark';
 33: import { Economy } from '../../../economy';
 34: import { GuildMemberRoleEnum } from '../../../common/packets/ServerToClientPackets';
 35: 
 36: type TagEntity = With<Entity, 'nameTag' | 'screenPosition'>;
 37: 
 38: /** `RenderBitmap(BITMAP_GUILD, x, y, 8, 8)` (UIControls.cpp:1214) - the mark is
 39:  * drawn 8x8 in the guild lists, and the same size in front of the name.
 40:  * Inline, because `.app img { width: 100%; height: 100% }` (style.less) beats
 41:  * both the attributes and any class rule that loads after it. */
 42: const MARK_PX = 8;
 43: 
 44: type Line = {
 45:   text: string;
 46:   colour: string;
 47:   bg: string;
 48:   alpha?: number;
 49:   bold?: boolean;
 50:   /** The name line: the only one the safe-zone hover blink inverts. */
 51:   isName?: true;
 52:   /** The `[Store] ` half of a shop-title line, drawn in its own colour. */
 53:   prefix?: { text: string; colour: string };
 54:   /** The guild mark, drawn 8x8 in front of the text (the guild lists' `RenderBitmap(BITMAP_GUILD, x, y, 8, 8)`, UIControls.cpp:1214). */
 55:   mark?: string;
 56: };
 57: 
 58: /**
 59:  * `RenderBoolean` (ZzzInterface.cpp:787): the balloon is a stack of
 60:  * equal-width boxes - the shop title *or* the union and guild lines, the
 61:  * name, then the chat lines, each with its own background.
 62:  *
 63:  * Colours follow the owner: a GM takes the dark grey box with the cyan name,
 64:  * the hero is yellow-green on olive, a guild mate or an ally takes the union
 65:  * colours, a rival the red ones and anyone else the GR_NONE blue-grey; the
 66:  * name itself is then tinted by PK (`SetPlayerColor`). The chat lines below
 67:  * are backed by `GuildColor`, so a member of the guild we are at war with
 68:  * gets the dark red box.
 69:  */
 70: function buildLines(entity: TagEntity): Line[] {
 71:   const tag = entity.nameTag;
 72:   const hero = Store.world?.playerEntity;
 73:   const isHero = entity === hero;
 74:   const isGm = !!entity.isGm;
 75: 
 76:   const relation = isHero
 77:     ? GuildRelation.Union
 78:     : Social.guildRelationOf(entity.guild?.id);
 79: 
 80:   let box = relationStyle(relation);
 81:   if (isGm) box = { text: GM_GUILD_TEXT, bg: GM_BG };
 82:   if (isHero) box = { text: HERO_TEXT, bg: HERO_BG };
 83: 
 84:   const lines: Line[] = [];
 85: 
 86:   // `IsShopInViewport(c->Owner)`: a player with a stall up shows its title
 87:   // instead of the guild lines.
 88:   const shopTitle =
 89:     entity.netId !== undefined ? Economy.shopTitles.get(entity.netId) : undefined;
 90: 
 91:   if (shopTitle) {
 92:     const shop = shopTitleColours(tag.color, relation);
 93:     lines.push({
 94:       text: shopTitleSummary(shopTitle),
 95:       colour: shop.title,
 96:       bg: shop.bg,
 97:       bold: true,
 98:       prefix: { text: SHOP_TITLE_PREFIX, colour: shop.prefix },
 99:     });
100:   } else {
101:     const guild = entity.guild ? Store.guilds.get(entity.guild.id) : undefined;
102:     if (guild?.alliance) {
103:       lines.push({
104:         text: unionLine(
105:           guild.alliance,
106:           relation,
107:           entity.guild!.role === GuildMemberRoleEnum.GuildMaster
108:         ),
109:         colour: box.text,
110:         bg: box.bg,
111:       });
112:     }
113:     if (guild && entity.guild) {
114:       lines.push({
115:         text: guildLine(guild.name, entity.guild.role),
116:         colour: box.text,
117:         bg: box.bg,
118:       });
119:     }
120:   }
121: 
122:   const ownMark = entity.guild ? Store.guilds.get(entity.guild.id)?.logo : undefined;
123:   // Self-defense outranks the PK tint for its 60s: the aggressor is marked
124:   // to the victim (violet in the official client; the state itself comes
125:   // from OpenMU's blue message, social.ts trackSelfDefense).
126:   const nameColour = isGm
127:     ? GM_NAME_TEXT
128:     : Social.isSelfDefenseActive(entity.objectNameInWorld)
129:       ? SELF_DEFENSE_COLOUR
130:       : pkTextColour(tag.color);
131:   lines.push({
132:     text: entity.objectNameInWorld ?? '',
133:     colour: nameColour,
134:     bg: box.bg,
135:     bold: isGm,
136:     isName: true,
137:     mark:
138:       ownMark && ownMark.length > 0 && !isEmptyGuildMark(ownMark)
139:         ? guildMarkDataUrl(ownMark)
140:         : undefined,
141:   });
142: 
143:   const chatBg = chatLineBg(Social.guildTeamOf(entity.guild?.id), isGm);
144:   const chatColour = isGm ? GM_CHAT_TEXT : CHAT_TEXT;
145:   const alphaOf = (life: number) =>
146:     life > 0 && life < CHAT_FADE_TICKS ? 128 / 255 : 1;
147: 
148:   if (tag.life[1] > 0) {
149:     lines.push({
150:       text: tag.text[1],
151:       colour: chatColour,
152:       bg: chatBg,
153:       alpha: alphaOf(tag.life[1]),
154:     });
155:   }
156:   if (tag.life[0] > 0) {
157:     lines.push({
158:       text: tag.text[0],
159:       colour: chatColour,
160:       bg: chatBg,
161:       alpha: alphaOf(tag.life[0]),
162:     });
163:   }
164: 
165:   return lines;
166: }
167: 
168: /**
169:  * The hover blink of `RenderBoolean` (ZzzInterface.cpp:915): while the hero
170:  * stands in a safe zone and the cursor is on somebody else's balloon, the
171:  * name swaps its text and background colours every other frame
172:  * (`WorldTime % 24 < 12`). We drive it from `currentPointerTarget` - the
173:  * original tests the balloon's own screen rect, but our tags never take the
174:  * pointer - and from a CSS animation rather than per-frame state, at a 480 ms
175:  * period instead of 24 ms so it reads as a blink and not as a strobe.
176:  */
177: function shouldBlink(entity: TagEntity): boolean {
178:   const world = Store.world;
179:   if (!world) return false;
180:   if (world.currentPointerTarget !== entity) return false;
181:   if (entity === world.playerEntity) return false;
182:   return !!world.playerEntity?.attributeSystem.isAboveZero('inSafeZone');
183: }
184: 
185: // Stable React keys for entities (miniplex entities carry no id).
186: const entityIds = new WeakMap<object, number>();
187: let nextEntityId = 1;
188: function keyOf(entity: Entity): number {
189:   let id = entityIds.get(entity);
190:   if (id === undefined) {
191:     id = nextEntityId++;
192:     entityIds.set(entity, id);
193:   }
194:   return id;
195: }
196: 
197: const linesKey = (lines: Line[], blink: boolean) =>
198:   `${blink ? 'B' : ''}\n` +
199:   lines
200:     .map(
201:       l =>
202:         `${l.mark ? 'M' : ''}${l.prefix?.text ?? ''}${l.text}|${l.colour}|${l.bg}|${l.alpha ?? 1}|${
203:           l.bold ? 'b' : ''
204:         }|${l.prefix?.colour ?? ''}`
205:     )
206:     .join('\n');
207: 
208: type Slot = {
209:   entity: TagEntity;
210:   el: HTMLDivElement;
211:   x: number;
212:   y: number;
213:   width: number;
214:   height: number;
215:   visible: boolean;
216: };
217: 
218: /**
219:  * `RenderBooleans` (ZzzInterface.cpp:8777): every balloon is centred on its
220:  * owner's anchor with its bottom edge on it, then balloons that overlap are
221:  * pushed above or below each other (one bubble pass), and finally clamped to
222:  * the screen. Positions come from CalculateScreenPositionSystem per entity;
223:  * the layout runs once per frame after the last of them.
224:  */
225: function layout(slots: Map<Entity, Slot>, viewW: number, viewH: number) {
226:   const list: Slot[] = [];
227:   for (const s of slots.values()) {
228:     if (!s.visible) {
229:       s.el.style.transform = 'translate(-10000px, -10000px)';
230:       continue;
231:     }
232:     s.width = s.el.offsetWidth;
233:     s.height = s.el.offsetHeight;
234:     s.x = s.entity.screenPosition.x - s.width / 2;
235:     s.y = s.entity.screenPosition.y - s.height;
236:     list.push(s);
237:   }
238: 
239:   for (const ci of list) {
240:     for (const cj of list) {
241:       if (ci === cj) continue;
242:       if (
243:         ci.x + ci.width > cj.x &&
244:         ci.x < cj.x + cj.width &&
245:         ci.y + ci.height > cj.y &&
246:         ci.y < cj.y + cj.height
247:       ) {
248:         if (ci.y < cj.y + cj.height / 2) ci.y = cj.y - ci.height;
249:         else ci.y = cj.y + cj.height;
250:       }
251:     }
252:   }
253: 
254:   for (const s of list) {
255:     if (s.x < 0) s.x = 0;
256:     if (s.x >= viewW - s.width) s.x = viewW - s.width;
257:     if (s.y < 0) s.y = 0;
258:     if (s.y >= viewH - s.height) s.y = viewH - s.height;
259:     s.el.style.transform = `translate(${Math.floor(s.x)}px, ${Math.floor(s.y)}px)`;
260:   }
261: }
262: 
263: const NameTag = ({
264:   entity,
265:   register,
266: }: {
267:   entity: TagEntity;
268:   register: (entity: TagEntity, el: HTMLDivElement | null) => void;
269: }) => {
270:   const [state, setState] = useState<{ lines: Line[]; blink: boolean }>(() => ({
271:     lines: buildLines(entity),
272:     blink: shouldBlink(entity),
273:   }));
274:   const keyRef = useRef(linesKey(state.lines, state.blink));
275: 
276:   // Content can change every tick (chat fade, new lines, guild info
277:   // arriving); re-render only when the rendered text/colours differ.
278:   useEffect(() => {
279:     const handler = () => {
280:       if (!entity.nameTag) return;
281:       const next = { lines: buildLines(entity), blink: shouldBlink(entity) };
282:       const key = linesKey(next.lines, next.blink);
283:       if (key !== keyRef.current) {
284:         keyRef.current = key;
285:         setState(next);
286:       }
287:     };
288:     return onScreenPosition(entity, handler);
289:   }, [entity]);
290: 
291:   return (
292:     <div className="name-tag" ref={el => register(entity, el)}>
293:       {state.lines.map((line, i) => (
294:         <div
295:           key={i}
296:           className={`line${line.bold ? ' bold' : ''}${
297:             state.blink && line.isName ? ' blink' : ''
298:           }`}
299:           style={{
300:             color: line.colour,
301:             backgroundColor: line.bg,
302:             opacity: line.alpha ?? 1,
303:             // The blink swaps text and background; CSS reads them back off
304:             // these variables so the animation needs no second render.
305:             ['--tag-text' as string]: line.colour,
306:             ['--tag-bg' as string]: line.bg,
307:           }}
308:         >
309:           {line.mark && (
310:             <img
311:               className="name-tag-mark"
312:               src={line.mark}
313:               alt=""
314:               width={MARK_PX}
315:               height={MARK_PX}
316:               style={{ width: MARK_PX, height: MARK_PX }}
317:             />
318:           )}
319:           {line.prefix && (
320:             <span style={{ color: line.prefix.colour }}>{line.prefix.text}</span>
321:           )}
322:           {line.text}
323:         </div>
324:       ))}
325:     </div>
326:   );
327: };
328: 
329: export const NameTags = () => {
330:   const world = Store.world!;
331:   const { refresh } = useRenderId();
332:   const query = useMemo(
333:     () => world.with('nameTag', 'screenPosition'),
334:     [world]
335:   );
336: 
337:   useEffect(() => {
338:     const a = query.onEntityAdded.subscribe(refresh);
339:     const b = query.onEntityRemoved.subscribe(refresh);
340:     return () => {
341:       a();
342:       b();
343:     };
344:   }, [query]);
345: 
346:   const rootRef = useRef<HTMLDivElement>(null);
347:   const slotsRef = useRef(new Map<Entity, Slot>());
348: 
349:   const register = useMemo(
350:     () => (entity: TagEntity, el: HTMLDivElement | null) => {
351:       const slots = slotsRef.current;
352:       if (!el) {
353:         slots.delete(entity);
354:         return;
355:       }
356:       const slot = slots.get(entity);
357:       if (slot) slot.el = el;
358:       else
359:         slots.set(entity, {
360:           entity,
361:           el,
362:           x: 0,
363:           y: 0,
364:           width: 0,
365:           height: 0,
366:           visible: false,
367:         });
368:     },
369:     []
370:   );
371: 
372:   // One layout per frame, after the per-entity position events.
373:   useEffect(() => {
374:     let scheduled = false;
375:     const flush = () => {
376:       scheduled = false;
377:       const root = rootRef.current;
378:       if (!root) return;
379:       layout(slotsRef.current, root.clientWidth, root.clientHeight);
380:     };
381:     const handler = (
382:       entity: Entity,
383:       screenPosition: { x: number; y: number }
384:     ) => {
385:       const slot = slotsRef.current.get(entity);
386:       if (!slot) return;
387:       slot.visible =
388:         screenPosition.x * screenPosition.x +
389:           screenPosition.y * screenPosition.y >=
390:         0.1;
391:       if (!scheduled) {
392:         scheduled = true;
393:         requestAnimationFrame(flush);
394:       }
395:     };
396:     return onAnyScreenPosition(handler);
397:   }, []);
398: 
399:   return (
400:     <div className="name-tags" ref={rootRef}>
401:       {query.entities.map(entity => (
402:         <NameTag
403:           key={keyOf(entity)}
404:           entity={entity as TagEntity}
405:           register={register}
406:         />
407:       ))}
408:     </div>
409:   );
410: };
</file>

