<file path="register/src/muSprite.tsx">
  1: import { memo, useEffect, useState, type CSSProperties, type ReactNode } from 'react';
  2: import { decodeTGA } from '../../src/libs/mu/tga';
  3: 
  4: /**
  5:  * A standalone copy of the client's sprite loader, cut down to what a form
  6:  * needs.
  7:  *
  8:  * The game's `libs/mu/sprites.ts` would do this already, but it reaches
  9:  * `Data/` through `common/utils.ts`, which imports Babylon's `Texture` as a
 10:  * value - so importing it here would pull the whole engine into a page that
 11:  * draws six sprites and a text box. The decode itself is small enough to
 12:  * restate; `decodeTGA` is shared, since that part is neither small nor
 13:  * engine-bound.
 14:  *
 15:  * Keep the two header sizes in step with `libs/mu/sprites.ts` if the formats
 16:  * are ever revisited.
 17:  */
 18: 
 19: const OZJ_HEADER_SIZE = 24;
 20: const OZT_HEADER_SIZE = 4;
 21: 
 22: /**
 23:  * Where `Data/` lives. This page is served from its own origin
 24:  * (`register.ignies.net`), so by default it borrows the client's already
 25:  * published tree rather than shipping a second 88 MB copy of it. That is a
 26:  * cross-origin fetch and needs CORS on the client host - see README.
 27:  */
 28: const DATA_URL = (import.meta.env.VITE_DATA_URL || './Data/').replace(
 29:   /\/*$/,
 30:   '/'
 31: );
 32: 
 33: export type MuSprite = { url: string; width: number; height: number };
 34: 
 35: const cache = new Map<string, Promise<MuSprite>>();
 36: 
 37: function load(fileName: string): Promise<MuSprite> {
 38:   const key = fileName.toLowerCase();
 39:   let pending = cache.get(key);
 40: 
 41:   if (!pending) {
 42:     pending = decode(fileName).catch(err => {
 43:       // Drop the rejection so a transient failure can be retried on remount
 44:       // rather than being cached forever.
 45:       cache.delete(key);
 46:       throw err;
 47:     });
 48:     cache.set(key, pending);
 49:   }
 50: 
 51:   return pending;
 52: }
 53: 
 54: async function decode(fileName: string): Promise<MuSprite> {
 55:   const response = await fetch(`${DATA_URL}Interface/${fileName}`);
 56: 
 57:   if (!response.ok) {
 58:     throw new Error(`${fileName}: HTTP ${response.status}`);
 59:   }
 60: 
 61:   const buffer = new Uint8Array(await response.arrayBuffer());
 62:   const ext = fileName.split('.').pop()?.toLowerCase();
 63: 
 64:   if (ext === 'ozj') return fromJPEG(fileName, buffer);
 65:   if (ext === 'ozt') return fromTGA(fileName, buffer);
 66: 
 67:   throw new Error(`Unsupported sprite format for ${fileName}`);
 68: }
 69: 
 70: async function fromJPEG(
 71:   fileName: string,
 72:   buffer: Uint8Array
 73: ): Promise<MuSprite> {
 74:   const jpeg = buffer.slice(OZJ_HEADER_SIZE);
 75: 
 76:   if (jpeg[0] !== 0xff || jpeg[1] !== 0xd8) {
 77:     throw new Error(`${fileName} has no JPEG marker`);
 78:   }
 79: 
 80:   const blob = new Blob([jpeg], { type: 'image/jpeg' });
 81:   // The client parses the SOF header to avoid a second decode; six sprites do
 82:   // not justify carrying that scanner, so this measures the simple way.
 83:   const bitmap = await createImageBitmap(blob);
 84: 
 85:   try {
 86:     return {
 87:       url: URL.createObjectURL(blob),
 88:       width: bitmap.width,
 89:       height: bitmap.height,
 90:     };
 91:   } finally {
 92:     bitmap.close();
 93:   }
 94: }
 95: 
 96: async function fromTGA(fileName: string, buffer: Uint8Array): Promise<MuSprite> {
 97:   const { width, height, pixels } = decodeTGA(
 98:     fileName,
 99:     buffer.slice(OZT_HEADER_SIZE)
100:   );
101: 
102:   const canvas = document.createElement('canvas');
103:   canvas.width = width;
104:   canvas.height = height;
105: 
106:   const ctx = canvas.getContext('2d');
107: 
108:   if (!ctx) throw new Error(`No 2d context to decode ${fileName}`);
109: 
110:   ctx.putImageData(new ImageData(pixels, width, height), 0, 0);
111: 
112:   const blob = await new Promise<Blob | null>(resolve =>
113:     canvas.toBlob(resolve, 'image/png')
114:   );
115: 
116:   if (!blob) throw new Error(`Could not encode ${fileName} as PNG`);
117: 
118:   return { url: URL.createObjectURL(blob), width, height };
119: }
120: 
121: export function useMuSprite(fileName: string): MuSprite | null {
122:   const [sprite, setSprite] = useState<MuSprite | null>(null);
123: 
124:   useEffect(() => {
125:     let cancelled = false;
126: 
127:     load(fileName).then(
128:       loaded => {
129:         if (!cancelled) setSprite(loaded);
130:       },
131:       err => console.error(`Could not load sprite ${fileName}:`, err)
132:     );
133: 
134:     return () => {
135:       cancelled = true;
136:     };
137:   }, [fileName]);
138: 
139:   return sprite;
140: }
141: 
142: type MuSpriteFrameProps = {
143:   file: string;
144:   x?: number;
145:   y?: number;
146:   width?: number;
147:   height?: number;
148:   className?: string;
149:   style?: CSSProperties;
150:   onClick?: () => void;
151:   children?: ReactNode;
152: };
153: 
154: /** A crop of a sprite sheet as a `div` background. */
155: export const MuSpriteFrame = memo(function MuSpriteFrame({
156:   file,
157:   x = 0,
158:   y = 0,
159:   width,
160:   height,
161:   className,
162:   style,
163:   onClick,
164:   children,
165: }: MuSpriteFrameProps) {
166:   const sprite = useMuSprite(file);
167: 
168:   return (
169:     <div
170:       className={className}
171:       onClick={onClick}
172:       style={{
173:         ...(width !== undefined && { width }),
174:         ...(height !== undefined && { height }),
175:         backgroundImage: sprite ? `url(${sprite.url})` : undefined,
176:         backgroundPosition: `-${x}px -${y}px`,
177:         backgroundRepeat: 'no-repeat',
178:         imageRendering: 'pixelated',
179:         ...style,
180:       }}
181:     >
182:       {children}
183:     </div>
184:   );
185: });
</file>

