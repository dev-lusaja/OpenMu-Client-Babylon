  1: import { useState } from 'react';
  2: import {
  3:   MAX_ACCOUNT_LENGTH,
  4:   MAX_ACCOUNT_PASSWORD_LENGTH,
  5:   MIN_ACCOUNT_LENGTH,
  6:   MIN_ACCOUNT_PASSWORD_LENGTH,
