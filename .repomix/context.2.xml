 3: 
 4: /**
 5:  * The register page is its own Vite app, not a route in the client: it is
 6:  * served from its own host, and it must not drag in Babylon, the packet
 7:  * layer, or the 800 MB asset tree to draw one window.
 8:  *
 9:  * It shares exactly one module with the client - `libs/mu/tga` - which is why
10:  * `server.fs.allow` reaches up to the repo root in dev.
11:  *
12:  * Build:  bun run --cwd register build   ->  dist-register/
13:  */
14: 
15: const root = fileURLToPath(new URL('.', import.meta.url));
16: const repoRoot = fileURLToPath(new URL('..', import.meta.url));
17: 
18: export default defineConfig({
19:   root,
20:   base: './',
