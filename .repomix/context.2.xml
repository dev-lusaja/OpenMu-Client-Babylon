<file path="register/server/main.ts">
  1: import postgres from 'postgres';
  2: import bcrypt from 'bcryptjs';
  3: import { forgetSignupsBefore, recordAccount, recordSignup, signupsSince } from './db';
  4: import { BurstLimit, bucketFor, clientIp } from '../../src/common/rateLimit';
  5: import { isReservedName } from '../../src/common/reservedNames';
  6: 
  7: /**
  8:  * The account-creation endpoint behind `register.ignies.net`.
  9:  *
 10:  * It writes straight into OpenMU's database rather than going through the game
 11:  * server, because OpenMU has no public "create account" call - the admin panel
 12:  * does it in-process. That makes this file the *only* thing outside OpenMU that
 13:  * writes to `data."Account"`, so the column list below has to stay in step with
 14:  * that table (see `docs` in README for the `\d` output it was written from).
 15:  *
 16:  * Listens on loopback only. Caddy publishes it under `/api` on the register
 17:  * host, which keeps it same-origin with the standalone page. The client's own
 18:  * register window is not same-origin - it is served from `play.<domain>` -
 19:  * which is what `CORS_ORIGIN` is for.
 20:  */
 21: 
 22: const PORT = Number(process.env.PORT || 3100);
 23: const HOSTNAME = process.env.HOSTNAME || '127.0.0.1';
 24: 
 25: /**
 26:  * `postgres://user:pass@host:port/db`. The database is bound to loopback by the
 27:  * compose file, so this is a local connection.
 28:  */
 29: const DATABASE_URL =
 30:   process.env.DATABASE_URL ||
 31:   'postgres://postgres:admin@127.0.0.1:5432/openmu';
 32: 
 33: /**
 34:  * One account per network per day.
 35:  *
 36:  * This page is open to the internet with nothing in front of it, so this is the
 37:  * only thing between it and a script. It is kept on disk rather than in memory
 38:  * because `mu-update.sh` restarts this service on every deploy, and an
 39:  * in-memory counter would hand out a fresh allowance each time - a limit anyone
 40:  * could reset by waiting for a push.
 41:  */
 42: const RATE_LIMIT = Number(process.env.RATE_LIMIT || 1);
 43: const RATE_WINDOW_MS = Number(
 44:   process.env.RATE_WINDOW_MS || 24 * 60 * 60 * 1000
 45: );
 46: 
 47: /**
 48:  * A separate, much looser cap on *attempts* rather than successes, so a client
 49:  * that has spent its daily account cannot sit there hammering the endpoint.
 50:  * In memory is fine for this one: forgetting it on restart costs nothing.
 51:  */
 52: const BURST_LIMIT = Number(process.env.BURST_LIMIT || 20);
 53: const BURST_WINDOW_MS = Number(process.env.BURST_WINDOW_MS || 10 * 60 * 1000);
 54: 
 55: const MIN_USERNAME_LENGTH = 4;
 56: /** `data."Account"."LoginName"` is `varchar(10)` - longer would truncate. */
 57: const MAX_USERNAME_LENGTH = 10;
 58: const MIN_PASSWORD_LENGTH = 4;
 59: const MAX_PASSWORD_LENGTH = 10;
 60: 
 61: /**
 62:  * Printable ASCII, space excluded - the same rule the two forms apply.
 63:  *
 64:  * The login packet carries the password one byte per character and the game
 65:  * server reads it back as UTF-8, so a byte of 0x80 or over does not survive
 66:  * the trip. An account signed up with one exists and can never be logged
 67:  * into, so it must not be created in the first place.
 68:  */
 69: const PASSWORD_RE = /^[!-~]+$/;
 70: 
 71: const USERNAME_RE = /^[A-Za-z0-9]+$/;
 72: 
 73: /**
 74:  * Origins allowed to post a signup from a browser, comma separated, matched
 75:  * exactly. As the cash shop's, and for the same reason: the standalone page is
 76:  * same-origin and needs none of this, but the client's login window is served
 77:  * from the world's play host and is not.
 78:  *
 79:  * Exact origins only, never `*`: this endpoint writes accounts, and a wildcard
 80:  * is an open invitation for any page anywhere to drive it.
 81:  */
 82: const ALLOWED_ORIGINS = new Set(
 83:   (process.env.CORS_ORIGIN ?? '')
 84:     .split(',')
 85:     .map(origin => origin.trim())
 86:     .filter(Boolean)
 87: );
 88: 
 89: const sql = postgres(DATABASE_URL);
 90: 
 91: /** Rows outside the window prove nothing; drop them hourly. */
 92: setInterval(
 93:   () => forgetSignupsBefore(Date.now() - RATE_WINDOW_MS),
 94:   60 * 60 * 1000
 95: ).unref();
 96: 
 97: /** Has this network already used its allowance for the window? */
 98: function quotaSpent(bucket: string): boolean {
 99:   return signupsSince(bucket, Date.now() - RATE_WINDOW_MS) >= RATE_LIMIT;
100: }
101: 
102: const bursts = new BurstLimit(BURST_LIMIT, BURST_WINDOW_MS);
103: 
104: /**
105:  * Everything the form checks, checked again. The form's copy exists to save a
106:  * round trip; this one is the one that counts, because anything can POST here.
107:  */
108: function validate(body: {
109:   username?: unknown;
110:   password?: unknown;
111: }): string | null {
112:   const { username, password } = body;
113: 
114:   if (typeof username !== 'string' || typeof password !== 'string') {
115:     return 'Malformed request.';
116:   }
117: 
118:   if (
119:     username.length < MIN_USERNAME_LENGTH ||
120:     username.length > MAX_USERNAME_LENGTH
121:   ) {
122:     return `ID must be ${MIN_USERNAME_LENGTH}-${MAX_USERNAME_LENGTH} characters.`;
123:   }
124: 
125:   if (!USERNAME_RE.test(username)) {
126:     return 'ID may contain only letters and numbers.';
127:   }
128: 
129:   if (isReservedName(username)) {
130:     return 'That ID is reserved.';
131:   }
132: 
133:   if (
134:     password.length < MIN_PASSWORD_LENGTH ||
135:     password.length > MAX_PASSWORD_LENGTH
136:   ) {
137:     return `Password must be ${MIN_PASSWORD_LENGTH}-${MAX_PASSWORD_LENGTH} characters.`;
138:   }
139: 
140:   if (!PASSWORD_RE.test(password)) {
141:     return 'Password may contain only letters, numbers and basic symbols.';
142:   }
143: 
144:   return null;
145: }
146: 
147: /**
148:  * OpenMU stores a bare BCrypt string - variant `2a` at cost 11, no wrapper.
149:  * Both are matched exactly below, because a hash OpenMU cannot verify produces
150:  * an account that exists but cannot log in, which is far more confusing than a
151:  * failed registration.
152:  *
153:  * To re-confirm this against a live server (after an OpenMU upgrade, say),
154:  * read the prefix off any existing account - `$2a$11$` is algorithm and cost:
155:  *
156:  *   docker exec -i database psql -U postgres -d openmu \
157:  *     -c 'SELECT "LoginName", left("PasswordHash", 7) FROM data."Account";'
158:  *
159:  * `left(...)` deliberately: the prefix answers the question, and the rest is
160:  * the hash of somebody's password and does not belong in a terminal, a log, or
161:  * a comment.
162:  */
163: const BCRYPT_COST = 11;
164: const BCRYPT_VARIANT = '$2a$';
165: 
166: /**
167:  * Async, not `hashSync`: BCrypt at cost 11 takes ~100-300 ms on a shared vCPU,
168:  * and the sync call would stall every other request in the process for that
169:  * long. `bcryptjs` chunks the async path so the loop keeps turning.
170:  */
171: async function hashPassword(password: string): Promise<string> {
172:   const hash = await bcrypt.hash(password, BCRYPT_COST);
173: 
174:   if (hash.startsWith(BCRYPT_VARIANT)) return hash;
175: 
176:   // Some `bcryptjs` versions emit `$2b$`. The variants differ only in how
177:   // passwords of 256 bytes or more are handled, and `validate` caps them at
178:   // ten characters - so for anything reaching here the digests are identical
179:   // and only the label differs. Rewrite it so what we store is byte-identical
180:   // to what OpenMU writes itself.
181:   return BCRYPT_VARIANT + hash.slice(hash.indexOf('$', 1) + 1);
182: }
183: 
184: /** Postgres `unique_violation`: the name was taken between the check and the write. */
185: const UNIQUE_VIOLATION = '23505';
186: 
187: /** Creates the account, or returns why it could not be. */
188: async function createAccount(
189:   username: string,
190:   password: string
191: ): Promise<string | null> {
192:   const existing = await sql`
193:     SELECT 1 FROM data."Account" WHERE lower("LoginName") = lower(${username}) LIMIT 1
194:   `;
195: 
196:   if (existing.length > 0) return 'That ID is already taken.';
197: 
198:   try {
199:     const passwordHash = await hashPassword(password);
200: 
201:     // Column list mirrors every NOT NULL column on `data."Account"` that has no
202:     // default. `VaultId` stays null: OpenMU creates the vault storage itself on
203:     // first use, and inventing one here would mean writing `ItemStorage` too.
204:     // `EMail` is NOT NULL but the form does not ask for one, so it takes the
205:     // empty string.
206:     await sql`
207:       INSERT INTO data."Account" (
208:         "Id", "LoginName", "PasswordHash", "SecurityCode", "EMail",
209:         "RegistrationDate", "State", "TimeZone", "VaultPassword", "IsVaultExtended"
210:       ) VALUES (
211:         gen_random_uuid(), ${username}, ${passwordHash}, '', '',
212:         now(), 0, 0, '', false
213:       )
214:     `;
215:   } catch (err) {
216:     // The unique index on `LoginName` is what actually prevents duplicates: the
217:     // check above races, and loses to two submissions of the same name landing
218:     // together. The loser gets the same answer the check would have given it.
219:     if ((err as { code?: string }).code === UNIQUE_VIOLATION) {
220:       return 'That ID is already taken.';
221:     }
222: 
223:     throw err;
224:   }
225: 
226:   return null;
227: }
228: 
229: /** The CORS headers for this caller, or nothing when it is same-origin. */
230: function corsHeaders(req: Request): Record<string, string> {
231:   const origin = req.headers.get('origin');
232: 
233:   if (!origin || !ALLOWED_ORIGINS.has(origin)) return {};
234: 
235:   return {
236:     'Access-Control-Allow-Origin': origin,
237:     // The answer differs by origin, so a shared cache must not reuse one for
238:     // another.
239:     Vary: 'Origin',
240:     'Access-Control-Allow-Methods': 'POST, OPTIONS',
241:     'Access-Control-Allow-Headers': 'Content-Type',
242:     'Access-Control-Max-Age': '86400',
243:   };
244: }
245: 
246: function json(
247:   body: unknown,
248:   status = 200,
249:   extra: Record<string, string> = {}
250: ): Response {
251:   return new Response(JSON.stringify(body), {
252:     status,
253:     headers: { 'Content-Type': 'application/json', ...extra },
254:   });
255: }
256: 
257: Bun.serve({
258:   port: PORT,
259:   hostname: HOSTNAME,
260:   async fetch(req, server) {
261:     const url = new URL(req.url);
262:     const cors = corsHeaders(req);
263: 
264:     if (url.pathname !== '/api/register') {
265:       return json({ error: 'Not found' }, 404, cors);
266:     }
267: 
268:     // The preflight a browser sends before a cross-origin POST. An origin that
269:     // is not on the list is refused here rather than after the work.
270:     if (req.method === 'OPTIONS') {
271:       const allowed = cors['Access-Control-Allow-Origin'] !== undefined;
272:       return new Response(null, { status: allowed ? 204 : 403, headers: cors });
273:     }
274: 
275:     if (req.method !== 'POST') {
276:       return json({ error: 'Method not allowed' }, 405, cors);
277:     }
278: 
279:     // Caddy is in front, so the socket address is always loopback - the real
280:     // client is in the forwarded header, which `clientIp` believes for exactly
281:     // that reason and no other.
282:     const ip = clientIp(req, server);
283:     const bucket = bucketFor(ip);
284: 
285:     if (bursts.hammering(bucket)) {
286:       return json({ error: 'Too many requests. Please slow down.' }, 429, cors);
287:     }
288: 
289:     // Checked before the work, so a spent quota costs a lookup rather than a
290:     // BCrypt round.
291:     if (quotaSpent(bucket)) {
292:       return json(
293:         { error: 'An account has already been created from this network today.' },
294:         429,
295:         cors
296:       );
297:     }
298: 
299:     let body: Record<string, unknown>;
300: 
301:     try {
302:       body = await req.json();
303:     } catch {
304:       return json({ error: 'Malformed request.' }, 400, cors);
305:     }
306: 
307:     const problem = validate(body);
308: 
309:     if (problem) return json({ error: problem }, 400, cors);
310: 
311:     try {
312:       const rejection = await createAccount(
313:         body.username as string,
314:         body.password as string
315:       );
316: 
317:       if (rejection) return json({ error: rejection }, 409, cors);
318: 
319:       recordSignup(bucket);
320:       // The account exists in OpenMU's database by now, so this log lists
321:       // accounts that were made rather than attempts that were tried.
322:       recordAccount(body.username as string, bucket);
323:       console.log(`registered ${body.username} from ${ip}`);
324:       return json({ ok: true }, 200, cors);
325:     } catch (err) {
326:       // Never surface the database error itself: it would leak the schema, and
327:       // the player can do nothing with it either way.
328:       console.error('registration failed:', err);
329:       return json({ error: 'Registration failed. Please try again.' }, 500, cors);
330:     }
331:   },
332: });
333: 
334: console.log(`register api listening on ${HOSTNAME}:${PORT}`);
335: // As the cash shop's boot lines: the client's register window is refused
336: // without this, and the only sign of it is a CORS error in the player's
337: // console, which nobody is looking at.
338: console.info(
339:   `  cors            ${
340:     ALLOWED_ORIGINS.size ? [...ALLOWED_ORIGINS].join(', ') : 'same-origin only'
341:   }`
342: );
