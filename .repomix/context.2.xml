  8:   type SignupProblem,
  9: } from '../../src/common/registerRules';
 10: import { MuSpriteFrame } from './muSprite';
 11: import { MuButton } from './muButton';
 12: 
 13: /**
 14:  * Account registration, drawn with the game's own interface art so it reads as
 15:  * part of MU rather than a web form bolted onto it.
 16:  *
 17:  * The window is `login_back.OZT` - the same frame the client's login screen
 18:  * uses - because a register box is the login box with two more rows. MU's UI is
 19:  * authored at fixed pixel sizes, so everything here is absolutely positioned
 20:  * against the art and must never reflow.
 21:  *
 22:  * The coordinates below were derived from the client's login window
 23:  * (`ui/pages/loginPage`, inputs at y=106/131) and re-spaced to fit three rows.
 24:  * They are a starting point: nudge them against the actual art rather than
 25:  * trusting the arithmetic.
 26:  */
 27: 
 28: const WIN_WIDTH = 329;
 29: const WIN_HEIGHT = 245;
 30: 
 31: const INPUT_WIDTH = 156;
 32: const INPUT_HEIGHT = 23;
 33: const INPUT_X = 109;
 34: const LABEL_X = 22;
 35: 
 36: /** First row, then one row every `ROW_STEP` px. */
 37: const FIRST_ROW_Y = 100;
 38: const ROW_STEP = 24;
 39: 
 40: /** The label sits a few px below the input's top edge to look centred. */
 41: const LABEL_OFFSET_Y = 7;
 42: 
 43: const TEXT_INSET_X = 6;
 44: const TEXT_INSET_Y = 6;
 45: 
 46: const BUTTON_WIDTH = 54;
 47: const BUTTON_HEIGHT = 30;
 48: const BUTTON_Y = 192;
 49: const OK_X = 150;
 50: const CANCEL_X = 211;
 51: 
 52: /** Where the account actually gets created. See `register/server/main.ts`. */
 53: const API = import.meta.env.VITE_REGISTER_API || '/api/register';
 54: 
 55: /**
 56:  * The login window's two rows, plus the confirmation a password needs when it
 57:  * is being set rather than typed back. No e-mail: nothing sends one, and a
 58:  * field the server stores as the empty string is a field that asks for a
 59:  * stranger's address for nothing.
 60:  */
 61: const ROWS = [
 62:   { key: 'username', label: 'ID', type: 'text' },
 63:   { key: 'password', label: 'Password', type: 'password' },
 64:   { key: 'confirm', label: 'Confirm', type: 'password' },
 65: ] as const;
 66: 
 67: type Field = (typeof ROWS)[number]['key'];
 68: 
 69: type Status =
 70:   | { kind: 'idle' }
 71:   | { kind: 'sending' }
 72:   | { kind: 'error'; message: string }
 73:   | { kind: 'done' };
 74: 
 75: const EMPTY: Record<Field, string> = {
 76:   username: '',
 77:   password: '',
 78:   confirm: '',
 79: };
 80: 
 81: /**
 82:  * The shared reasons, said in the English this page is written in. The client's
 83:  * own register window says the same things through `t()`; the service says them
 84:  * again for anything that POSTs without a form.
 85:  */
 86: const PROBLEM_TEXT: Record<SignupProblem, string> = {
 87:   empty: 'Please fill in every field.',
 88:   idShort: `ID must be at least ${MIN_ACCOUNT_LENGTH} characters.`,
 89:   idChars: 'ID may contain only letters and numbers.',
 90:   passwordShort: `Password must be at least ${MIN_ACCOUNT_PASSWORD_LENGTH} characters.`,
 91:   passwordChars: 'Password may contain only letters, numbers and basic symbols.',
 92:   mismatch: 'Passwords do not match.',
 93: };
 94: 
 95: export const RegisterPage = () => {
 96:   const [values, setValues] = useState<Record<Field, string>>(EMPTY);
 97:   const [status, setStatus] = useState<Status>({ kind: 'idle' });
 98: 
 99:   const set = (field: Field, value: string) =>
100:     setValues(current => ({ ...current, [field]: value }));
101: 
102:   const submit = async () => {
103:     if (status.kind === 'sending') return;
104: 
105:     const problem = validateSignup(values);
106: 
107:     if (problem) {
108:       setStatus({ kind: 'error', message: PROBLEM_TEXT[problem] });
109:       return;
110:     }
111: 
112:     setStatus({ kind: 'sending' });
113: 
114:     try {
115:       const response = await fetch(API, {
116:         method: 'POST',
117:         headers: { 'Content-Type': 'application/json' },
118:         body: JSON.stringify({
119:           username: values.username,
120:           password: values.password,
121:         }),
122:       });
123: 
124:       const body = await response.json().catch(() => ({}));
125: 
126:       if (!response.ok) {
127:         setStatus({
128:           kind: 'error',
129:           message: body.error || `Registration failed (${response.status}).`,
130:         });
131:         return;
132:       }
133: 
134:       setStatus({ kind: 'done' });
135:       setValues(EMPTY);
136:     } catch {
137:       // Offline, DNS, CORS - none of which the player can act on beyond
138:       // trying again.
139:       setStatus({ kind: 'error', message: 'Could not reach the server.' });
140:     }
141:   };
142: 
143:   return (
144:     <div className="register-page">
145:       <MuSpriteFrame
146:         file="login_back.OZT"
147:         width={WIN_WIDTH}
148:         height={WIN_HEIGHT}
149:         className="register-win"
150:       >
151:         <form
152:           onSubmit={e => {
153:             e.preventDefault();
154:             submit();
155:           }}
156:         >
157:           {ROWS.map((row, i) => {
158:             const top = FIRST_ROW_Y + i * ROW_STEP;
159: 
160:             return (
161:               <div key={row.key}>
162:                 <span
163:                   className="register-label"
164:                   style={{ left: LABEL_X, top: top + LABEL_OFFSET_Y }}
165:                 >
166:                   {row.label}
167:                 </span>
168: 
169:                 <MuSpriteFrame
170:                   file="login_me.OZT"
171:                   width={INPUT_WIDTH}
172:                   height={INPUT_HEIGHT}
173:                   style={{ position: 'absolute', left: INPUT_X, top }}
174:                 >
175:                   <input
176:                     className="register-input"
177:                     type={row.type}
178:                     autoFocus={i === 0}
179:                     autoComplete="off"
180:                     value={values[row.key]}
181:                     onChange={e => set(row.key, e.target.value)}
182:                     maxLength={
183:                       row.key === 'username'
184:                         ? MAX_ACCOUNT_LENGTH
185:                         : MAX_ACCOUNT_PASSWORD_LENGTH
186:                     }
187:                     style={{
188:                       paddingLeft: TEXT_INSET_X,
189:                       paddingTop: TEXT_INSET_Y,
190:                     }}
191:                   />
192:                 </MuSpriteFrame>
193:               </div>
194:             );
195:           })}
196: 
197:           <MuButton
198:             file="message_ok_b_all.OZT"
199:             width={BUTTON_WIDTH}
200:             height={BUTTON_HEIGHT}
201:             frames={{ up: 0, active: 1, down: 2 }}
202:             disabled={status.kind === 'sending'}
203:             onClick={submit}
204:             style={{ position: 'absolute', left: OK_X, top: BUTTON_Y }}
205:           />
206:           <MuButton
207:             file="loding_cancel_b_all.OZT"
208:             width={BUTTON_WIDTH}
209:             height={BUTTON_HEIGHT}
210:             frames={{ up: 0, active: 1, down: 2 }}
211:             onClick={() => {
212:               setValues(EMPTY);
213:               setStatus({ kind: 'idle' });
214:             }}
215:             style={{ position: 'absolute', left: CANCEL_X, top: BUTTON_Y }}
216:           />
217: 
218:           {/* Enter submits; the visible OK button is a sprite, not a submit. */}
219:           <button type="submit" className="register-submit" tabIndex={-1} />
220:         </form>
221: 
222:         {status.kind === 'error' && (
223:           <p className="register-message register-error">{status.message}</p>
224:         )}
225:         {status.kind === 'done' && (
226:           <p className="register-message register-ok">
227:             Account created. You can log in now.
228:           </p>
229:         )}
230:       </MuSpriteFrame>
231:     </div>
232:   );
233: };
