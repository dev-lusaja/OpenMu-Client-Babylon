<file path="register/server/migrations/001_signups.sql">
 1: -- The rate limiter's memory, which this service has always created for itself
 2: -- at startup, written down so the production database can be reproduced by
 3: -- hand rather than by booting the service and hoping.
 4: --
 5: -- Apply with:
 6: --   sqlite3 /var/lib/mu-register/signups.sqlite < 001_signups.sql
 7: --
 8: -- Idempotent: safe to re-apply.
 9: 
10: -- `bucket` is a network, never an address: an IPv6 caller is counted by its
11: -- /64, an IPv4 caller whole. No account name here - this table only answers
12: -- "has this network had its allowance".
13: CREATE TABLE IF NOT EXISTS signups (
14:   bucket TEXT NOT NULL,
15:   at     INTEGER NOT NULL
16: );
17: 
18: CREATE INDEX IF NOT EXISTS signups_bucket_at ON signups (bucket, at);
</file>

<file path="register/server/migrations/002_account_log.sql">
 1: -- The account creation log.
 2: --
 3: -- Until now the only record that an account was created was a line on stdout
 4: -- (`registered <name> from <ip>`), which lives in journald, rolls
 5: -- away, and cannot be asked a question. This table is the answer to "who
 6: -- signed up and when" - the one an operator actually asks.
 7: --
 8: -- Apply with:
 9: --   sqlite3 /var/lib/mu-register/signups.sqlite < 002_account_log.sql
10: --
11: -- Idempotent: safe to re-apply.
12: 
13: -- `bucket` is the same network form the rate limiter uses, not an address:
14: -- an IPv6 caller by its /64, an IPv4 caller whole. Storing the full address
15: -- would make this a list of who lives where, which is not what it is for.
16: CREATE TABLE IF NOT EXISTS account_log (
17:   id           INTEGER PRIMARY KEY AUTOINCREMENT,
18:   login_name   TEXT NOT NULL,
19:   bucket       TEXT NOT NULL,
20:   at           INTEGER NOT NULL
21: );
22: 
23: CREATE INDEX IF NOT EXISTS account_log_at ON account_log (at DESC);
24: CREATE INDEX IF NOT EXISTS account_log_name ON account_log (login_name);
</file>

<file path="register/server/db.ts">
 1: import { Database } from 'bun:sqlite';
 2: import { join } from 'node:path';
 3: import { migrate } from '../../tools/sqliteMigrate';
 4: 
 5: /**
 6:  * The register service's own storage: the signup log the rate limiter reads,
 7:  * and the account creation log an operator can query.
 8:  *
 9:  * Deliberately *not* OpenMU's database. Nothing here is game state - it is the
10:  * gate in front of account creation, and the record of what came through it -
11:  * and keeping it separate means this service never adds tables to a schema
12:  * OpenMU owns and migrates.
13:  *
14:  * The schema lives in `migrations/`, not in this file: those are the exact
15:  * statements to run against the production database, and running them here too
16:  * means a fresh box and a live one end up with the same thing.
17:  */
18: 
19: const DB_PATH =
20:   process.env.RATE_DB_PATH || '/var/lib/mu-register/signups.sqlite';
21: 
22: export const db = new Database(DB_PATH, { create: true });
23: 
24: // WAL so a reader can look at the log while the server is serving.
25: db.run('PRAGMA journal_mode = WAL');
26: 
27: const applied = migrate(db, join(import.meta.dir, 'migrations'));
28: if (applied.length > 0) {
29:   console.info(`applied ${applied.length} migration(s): ${applied.join(', ')}`);
30: }
31: 
32: /* ------------------------------------------------------------------ signups */
33: 
34: const countRecent = db.query<{ n: number }, [string, number]>(
35:   'SELECT COUNT(*) AS n FROM signups WHERE bucket = ? AND at > ?'
36: );
37: const insertSignup = db.query<unknown, [string, number]>(
38:   'INSERT INTO signups (bucket, at) VALUES (?, ?)'
39: );
40: const deleteExpired = db.query<unknown, [number]>(
41:   'DELETE FROM signups WHERE at <= ?'
42: );
43: 
44: export function signupsSince(bucket: string, since: number): number {
45:   return countRecent.get(bucket, since)?.n ?? 0;
46: }
47: 
48: export function recordSignup(bucket: string): void {
49:   insertSignup.run(bucket, Date.now());
50: }
51: 
52: export function forgetSignupsBefore(cutoff: number): void {
53:   deleteExpired.run(cutoff);
54: }
55: 
56: /* -------------------------------------------------------------- account log */
57: 
58: export type AccountLogEntry = {
59:   id: number;
60:   login_name: string;
61:   bucket: string;
62:   at: number;
63: };
64: 
65: const insertAccount = db.query<unknown, [string, string, number]>(
66:   'INSERT INTO account_log (login_name, bucket, at) VALUES (?, ?, ?)'
67: );
68: 
69: const recentAccounts = db.query<AccountLogEntry, [number]>(
70:   'SELECT id, login_name, bucket, at FROM account_log ORDER BY at DESC LIMIT ?'
71: );
72: 
73: const accountsSince = db.query<AccountLogEntry, [number, number]>(
74:   'SELECT id, login_name, bucket, at FROM account_log WHERE at > ? ORDER BY at DESC LIMIT ?'
75: );
76: 
77: /**
78:  * One created account. Never called before the row exists in OpenMU's own
79:  * database, so this log lists accounts that were made, not attempts.
80:  */
81: export function recordAccount(loginName: string, bucket: string): void {
82:   insertAccount.run(loginName, bucket, Date.now());
83: }
84: 
85: export function readAccountLog(limit: number, since?: number): AccountLogEntry[] {
86:   return since === undefined
87:     ? recentAccounts.all(limit)
88:     : accountsSince.all(since, limit);
89: }
</file>

