 4: /**
 5:  * The client's `ui/components/muButton`, minus `libs/sfx` - this page has no
 6:  * audio engine and a register form does not need click sounds. Frame layout is
 7:  * the same: the sheet stacks states vertically, so frame *n* sits at `y = n *
 8:  * height`.
 9:  */
10: 
11: export type MuButtonFrames = {
12:   up: number;
13:   active?: number;
14:   down?: number;
15: };
16: 
17: type MuButtonProps = {
18:   file: string;
19:   width: number;
20:   height: number;
21:   frames: MuButtonFrames;
22:   label?: string;
23:   color?: string;
24:   activeColor?: string;
25:   disabled?: boolean;
26:   onClick?: () => void;
27:   style?: CSSProperties;
28: };
29: 
30: export const MuButton = ({
31:   file,
32:   width,
33:   height,
34:   frames,
35:   label,
36:   color = '#e2e2e2',
37:   activeColor = '#ffffff',
38:   disabled = false,
39:   onClick,
40:   style,
41: }: MuButtonProps) => {
42:   const [hovered, setHovered] = useState(false);
43:   const [pressed, setPressed] = useState(false);
44: 
45:   let frame = frames.up;
46: 
47:   if (!disabled && hovered && frames.active !== undefined) frame = frames.active;
48:   if (!disabled && pressed && frames.down !== undefined) frame = frames.down;
49: 
50:   return (
51:     <MuSpriteFrame
52:       file={file}
53:       y={frame * height}
54:       width={width}
55:       height={height}
56:       style={{
57:         position: 'relative',
58:         pointerEvents: 'auto',
59:         cursor: disabled ? 'default' : 'pointer',
60:         opacity: disabled ? 0.5 : 1,
61:         ...style,
62:       }}
63:       onClick={disabled ? undefined : onClick}
64:     >
65:       <div
66:         onMouseEnter={() => setHovered(true)}
67:         onMouseLeave={() => {
68:           setHovered(false);
69:           setPressed(false);
70:         }}
71:         onMouseDown={() => setPressed(true)}
72:         onMouseUp={() => setPressed(false)}
73:         style={{
74:           position: 'absolute',
75:           inset: 0,
76:           display: 'flex',
77:           alignItems: 'center',
78:           justifyContent: 'center',
79:           fontSize: 11,
80:           // MU's buttons sink a pixel or two when held.
81:           paddingTop: pressed && !disabled ? 2 : 0,
82:           color: hovered && !disabled ? activeColor : color,
83:         }}
84:       >
85:         {label}
86:       </div>
87:     </MuSpriteFrame>
88:   );
89: };
